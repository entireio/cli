 not found.\n    26→func isNotFoundError(err error) bool {\n    27→\treturn errors.Is(err, object.ErrEntryNotFound) ||\n    28→\t\terrors.Is(err, object.ErrFileNotFound) ||\n    29→\t\terrors.Is(err, object.ErrDirectoryNotFound) ||\n    30→\t\terrors.Is(err, plumbing.ErrObjectNotFound) ||\n    31→\t\terrors.Is(err, plumbing.ErrReferenceNotFound)\n    32→}\n    33→\n    34→// commitOrHead attempts to create a commit. If the commit would be empty (files already\n    35→// committed), it returns HEAD hash instead. This handles the case where files were\n    36→// modified during a session but already committed by the user before the hook runs.\n    37→func commitOrHead(repo *git.Repository, worktree *git.Worktree, msg string, author *object.Signature) (plumbing.Hash, error) {\n    38→\tcommitHash, err := worktree.Commit(msg, &git.CommitOptions{Author: author})\n    39→\tif errors.Is(err, git.ErrEmptyCommit) {\n    40→\t\tfmt.Fprintf(os.Stderr, \"No changes to commit (files already committed)\\n\")\n    41→\t\thead, err := repo.Head()\n    42→\t\tif err != nil {\n    43→\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get HEAD: %w\", err)\n    44→\t\t}\n    45→\t\treturn head.Hash(), nil\n    46→\t}\n    47→\tif err != nil {\n    48→\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to commit: %w\", err)\n    49→\t}\n    50→\treturn commitHash, nil\n    51→}\n    52→\n    53→// AutoCommitStrategy implements the auto-commit strategy:\n    54→// - Code changes are committed to the active branch (like commit strategy)\n    55→// - Session logs are committed to a shadow branch (like manual-commit strategy)\n    56→// - Code commits can reference the shadow branch via trailers\n    57→type AutoCommitStrategy struct {\n    58→\t// checkpointStore manages checkpoint data on entire/sessions branch\n    59→\tcheckpointStore *checkpoint.GitStore\n    60→\t// checkpointStoreOnce ensures thread-safe lazy initialization\n    61→\tcheckpointStoreOnce sync.Once\n    62→\t// checkpointStoreErr captures any error during initialization\n    63→\tcheckpointStoreErr error\n    64→}\n    65→\n    66→// getCheckpointStore returns the checkpoint store, initializing it lazily if needed.\n    67→// Thread-safe via sync.Once.\n    68→func (s *AutoCommitStrategy) getCheckpointStore() (*checkpoint.GitStore, error) {\n    69→\ts.checkpointStoreOnce.Do(func() {\n    70→\t\trepo, err := OpenRepository()\n    71→\t\tif err != nil {\n    72→\t\t\ts.checkpointStoreErr = fmt.Errorf(\"failed to open repository: %w\", err)\n    73→\t\t\treturn\n    74→\t\t}\n    75→\t\ts.checkpointStore = checkpoint.NewGitStore(repo)\n    76→\t})\n    77→\treturn s.checkpointStore, s.checkpointStoreErr\n    78→}\n    79→\n    80→// NewAutoCommitStrategy creates a new AutoCommitStrategy instance\n    81→//\n    82→\n    83→func NewAutoCommitStrategy() Strategy {\n    84→\treturn &AutoCommitStrategy{}\n    85→}\n    86→\n    87→// NewDualStrategy creates a new auto-commit strategy instance.\n    88→// This legacy constructor delegates to NewAutoCommitStrategy.\n    89→//\n    90→\n    91→func NewDualStrategy() Strategy {\n    92→\treturn NewAutoCommitStrategy()\n    93→}\n    94→\n    95→func (s *AutoCommitStrategy) Name() string {\n    96→\treturn StrategyNameAutoCommit\n    97→}\n    98→\n    99→func (s *AutoCommitStrategy) Description() string {\n   100→\treturn \"Auto-commits code to active branch with metadata on entire/sessions\"\n   101→}\n   102→\n   103→// AllowsMainBranch returns true to allow auto-commit strategy on main branch.\n   104→// The strategy creates clean commits with Entire-Checkpoint trailers, and detailed\n   105→// metadata is stored on the separate entire/sessions orphan branch.\n   106→func (s *AutoCommitStrategy) AllowsMainBranch() bool {\n   107→\treturn true\n   108→}\n   109→\n   110→func (s *AutoCommitStrategy) ValidateRepository() error {\n   111→\trepo, err := OpenRepository()\n   112→\tif err != nil {\n   113→\t\treturn fmt.Errorf(\"not a git re