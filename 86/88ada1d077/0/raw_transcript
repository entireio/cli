cription() string {\n   100→\treturn \"Auto-commits code to active branch with metadata on entire/sessions\"\n   101→}\n   102→\n   103→// AllowsMainBranch returns true to allow auto-commit strategy on main branch.\n   104→// The strategy creates clean commits with Entire-Checkpoint trailers, and detailed\n   105→// metadata is stored on the separate entire/sessions orphan branch.\n   106→func (s *AutoCommitStrategy) AllowsMainBranch() bool {\n   107→\treturn true\n   108→}\n   109→\n   110→func (s *AutoCommitStrategy) ValidateRepository() error {\n   111→\trepo, err := OpenRepository()\n   112→\tif err != nil {\n   113→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   114→\t}\n   115→\n   116→\t_, err = repo.Worktree()\n   117→\tif err != nil {\n   118→\t\treturn fmt.Errorf(\"failed to access worktree: %w\", err)\n   119→\t}\n   120→\n   121→\treturn nil\n   122→}\n   123→\n   124→// PrePush is called by the git pre-push hook before pushing to a remote.\n   125→// It pushes the entire/sessions branch alongside the user's push.\n   126→// Configuration options (stored in .entire/settings.json under strategy_options.push_sessions):\n   127→//   - \"auto\": always push automatically\n   128→//   - \"prompt\" (default): ask user with option to enable auto\n   129→//   - \"false\"/\"off\"/\"no\": never push\n   130→func (s *AutoCommitStrategy) PrePush(remote string) error {\n   131→\treturn pushSessionsBranchCommon(remote, paths.MetadataBranchName)\n   132→}\n   133→\n   134→func (s *AutoCommitStrategy) SaveChanges(ctx SaveContext) error {\n   135→\trepo, err := OpenRepository()\n   136→\tif err != nil {\n   137→\t\treturn fmt.Errorf(\"failed to open git repository: %w\", err)\n   138→\t}\n   139→\n   140→\t// Generate checkpoint ID for this commit\n   141→\tcheckpointID := paths.GenerateCheckpointID()\n   142→\n   143→\t// Step 1: Commit code changes to active branch with checkpoint ID trailer\n   144→\t// We do code first to avoid orphaned metadata if this 