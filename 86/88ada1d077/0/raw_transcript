or listing checkpoints.\n   335→// This is the generic checkpoint info type.\n   336→type Info struct {\n   337→\t// ID is the checkpoint identifier\n   338→\tID string\n   339→\n   340→\t// SessionID identifies the session\n   341→\tSessionID string\n   342→\n   343→\t// Type indicates temporary or committed\n   344→\tType Type\n   345→\n   346→\t// CreatedAt is when the checkpoint was created\n   347→\tCreatedAt time.Time\n   348→\n   349→\t// Message is a summary description\n   350→\tMessage string\n   351→}\n   352→\n   353→// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n   354→// Task checkpoints are created when a subagent completes and contain both\n   355→// code changes and task-specific metadata.\n   356→type WriteTemporaryTaskOptions struct {\n   357→\t// SessionID is the session identifier\n   358→\tSessionID string\n   359→\n   360→\t// BaseCommit is the commit hash this session is based on\n   361→\tBaseCommit string\n   362→\n   363→\t// ToolUseID is the unique identifier for this Task tool invocation\n   364→\tToolUseID string\n   365→\n   366→\t// AgentID is the subagent identifier\n   367→\tAgentID string\n   368→\n   369→\t// ModifiedFiles are files that have been modified (relative paths)\n   370→\tModifiedFiles []string\n   371→\n   372→\t// NewFiles are files that have been created (relative paths)\n   373→\tNewFiles []string\n   374→\n   375→\t// DeletedFiles are files that have been deleted (relative paths)\n   376→\tDeletedFiles []string\n   377→\n   378→\t// TranscriptPath is the path to the main session transcript\n   379→\tTranscriptPath string\n   380→\n   381→\t// SubagentTranscriptPath is the path to the subagent's transcript\n   382→\tSubagentTranscriptPath string\n   383→\n   384→\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n   385→\tCheckpointUUID string\n   386→\n   387→\t// CommitMessage is the commit message (already formatted)\n   388→\tCommitMessage string\n   389→\n   