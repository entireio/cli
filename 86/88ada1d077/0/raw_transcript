Commit == \"\" {\n   132→\t\t// Initialize if needed (including if BaseCommit is empty from partial warning state)\n   133→\t\t// Preserve existing AgentType if we have a partial state, otherwise use default\n   134→\t\tagentType := DefaultAgentType\n   135→\t\tif state != nil && state.AgentType != \"\" {\n   136→\t\t\tagentType = state.AgentType\n   137→\t\t}\n   138→\t\tstate, err = s.initializeSession(repo, ctx.SessionID, agentType)\n   139→\t\tif err != nil {\n   140→\t\t\treturn fmt.Errorf(\"failed to initialize session for task checkpoint: %w\", err)\n   141→\t\t}\n   142→\t}\n   143→\n   144→\t// Get checkpoint store\n   145→\tstore, err := s.getCheckpointStore()\n   146→\tif err != nil {\n   147→\t\treturn fmt.Errorf(\"failed to get checkpoint store: %w\", err)\n   148→\t}\n   149→\n   150→\t// Check if shadow branch exists to report whether we created it\n   151→\tshadowBranchName := checkpoint.ShadowBranchNameForCommit(state.BaseCommit)\n   152→\tbranchExisted := store.ShadowBranchExists(state.BaseCommit)\n   153→\n   154→\t// Compute metadata paths for commit message\n   155→\tsessionMetadataDir := paths.SessionMetadataDirFromEntireID(ctx.SessionID)\n   156→\ttaskMetadataDir := TaskMetadataDir(sessionMetadataDir, ctx.ToolUseID)\n   157→\n   158→\t// Generate commit message\n   159→\tshortToolUseID := ctx.ToolUseID\n   160→\tif len(shortToolUseID) > 12 {\n   161→\t\tshortToolUseID = shortToolUseID[:12]\n   162→\t}\n   163→\n   164→\tvar messageSubject string\n   165→\tif ctx.IsIncremental {\n   166→\t\tmessageSubject = FormatIncrementalSubject(\n   167→\t\t\tctx.IncrementalType,\n   168→\t\t\tctx.SubagentType,\n   169→\t\t\tctx.TaskDescription,\n   170→\t\t\tctx.TodoContent,\n   171→\t\t\tctx.IncrementalSequence,\n   172→\t\t\tshortToolUseID,\n   173→\t\t)\n   174→\t} else {\n   175→\t\tmessageSubject = FormatSubagentEndMessage(ctx.SubagentType, ctx.TaskDescription, shortToolUseID)\n   176→\t}\n   177→\tcommitMsg := paths.FormatShadowTaskCommitMessage(\n  