kpoint\n    31→\tMessage string\n    32→}\n    33→\n    34→// Type indicates the storage location and lifecycle of a checkpoint.\n    35→type Type int\n    36→\n    37→const (\n    38→\t// Temporary checkpoints contain full state (code + metadata) and are stored\n    39→\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n    40→\tTemporary Type = iota\n    41→\n    42→\t// Committed checkpoints contain metadata + commit reference and are stored\n    43→\t// on the entire/sessions branch. They are the permanent record.\n    44→\tCommitted\n    45→)\n    46→\n    47→// Store provides low-level primitives for reading and writing checkpoints.\n    48→// This is used by strategies to implement their storage approach.\n    49→//\n    50→// The interface matches the GitStore implementation signatures directly:\n    51→// - WriteTemporary takes WriteTemporaryOptions and returns the commit hash\n    52→// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n    53→// - List methods return implementation-specific info types for richer data\n    54→type Store interface {\n    55→\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n    56→\t// Shadow branches are named entire/<base-commit-short-hash>.\n    57→\t// Returns the commit hash of the created checkpoint.\n    58→\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (plumbing.Hash, error)\n    59→\n    60→\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n    61→\t// baseCommit is the commit hash the session is based on.\n    62→\t// Returns nil, nil if the shadow branch doesn't exist.\n    63→\tReadTemporary(ctx context.Context, baseCommit string) (*ReadTemporaryResult, error)\n    64→\n    65→\t// ListTemporary lists all shadow branches with their checkpoint info.\n    66→\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n    67→\n    68→\t// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n    69→\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n    70→\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n    71→\n    72→\t// ReadCommitted reads a committed checkpoint by ID.\n    73→\t// Returns nil, nil if the checkpoint does not exist.\n    74→\tReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error)\n    75→\n    76→\t// ListCommitted lists all committed checkpoints.\n    77→\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n    78→}\n    79→\n    80→// WriteTemporaryOptions contains options for writing a temporary checkpoint.\n    81→type WriteTemporaryOptions struct {\n    82→\t// SessionID is the session identifier\n    83→\tSessionID string\n    84→\n    85→\t// BaseCommit is the commit hash this session is based on\n    86→\tBaseCommit string\n    87→\n    88→\t// ModifiedFiles are files that have been modified (relative paths)\n    89→\tModifiedFiles []string\n    90→\n    91→\t// NewFiles are files that have been created (relative paths)\n    92→\tNewFiles []string\n    93→\n    94→\t// DeletedFiles are files that have been deleted (relative paths)\n    95→\tDeletedFiles []string\n    96→\n    97→\t// MetadataDir is the relative path to the metadata directory\n    98→\tMetadataDir string\n    99→\n   100→\t// MetadataDirAbs is the absolute path to the metadata directory\n   101→\tMetadataDirAbs string\n   102→\n   103→\t// CommitMessage is the commit subject line\n   104→\tCommitMessage string\n   105→\n   106→\t// AuthorName is the name to use for commits\n   107→\tAuthorName string\n   108→\n   109→\t// AuthorEmail is the email to use for commits\n   110→\tAuthorEmail string\n   111→\n   112→\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n   113→\t// When true, all working directory files are captured (not just modified)\n   114→\tIsFirstCheckpoint bool\n   115→}\n   116→\n   117→// ReadTemporaryResult contains the result of reading a temporary checkpoint.\n   118→type ReadTemporaryResult struct {\n   119→\t// CommitHash is the hash of the checkpoint commit\n   120→\tCommitHash plumbing.Hash\n   121→\n   122→\t// TreeHash is the hash of the tree containing the checkpoint state\n   123→\tTreeHash plumbing.Hash\n   124→\n   125→\t// SessionID is the session identifier from the commit trailer\n   126→\tSessionID string\n   127→\n   128→\t// MetadataDir is the metadata directory path from the commit trailer\n   129→\tMetadataDir string\n   130→\n   131→\t// Timestamp is when the checkpoint was created\n   132→\tTimestamp time.Time\n   133→}\n   134→\n   135→// TemporaryInfo contains summary information about a shadow branch.\n   136→type TemporaryInfo struct {\n   137→\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n   138→\tBranchName string\n   139→\n   140→\t// BaseCommit is the short commit hash this branch is based on\n   141→\tBaseCommit string\n   142→\n   143→\t// LatestCommit is the hash of the latest commit on the branch\n   144→\tLatestCommit plumbing.Hash\n   145→\n   146→\t// SessionID is the session identifier from the latest commit\n   147→\tSessionID string\n   148→\n   149→\t// Timestamp is when the latest checkpoint was created\n   150→\tTimestamp time.Time\n   151→}\n   152→\n   153→// WriteCommittedOptions contains options for writing a committed checkpoint.\n   154→type WriteCommittedOptions struct {\n   155→\t// CheckpointID is the stable 12-hex-char identifier\n   156→\tCheckpointID string\n   157→\n   158→\t// SessionID is the session identifier\n   159→\tSessionID string\n   160→\n   161→\t// Strategy is the name of the strategy that created this checkpoint\n   162→\tStrategy string\n   163→\n   164→\t// Transcript is the session transcript content (full.jsonl)\n   165→\tTranscript []byte\n   166→\n   167→\t// Prompts contains user prompts from the session\n   168→\tPrompts []string\n   169→\n   170→\t// Context is the generated context.md content\n   171→\tContext []byte\n   172→\n   173→\t// FilesTouched are files modified during the session\n   174→\tFilesTouched []string\n   175→\n   176→\t// CheckpointsCount is the number of checkpoints in this session\n   177→\tCheckpointsCount int\n   178→\n   179→\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n   180→\tEphemeralBranch string\n   181→\n   182→\t// AuthorName is the name to use for commits\n   183→\tAuthorName string\n   184→\n   185→\t// AuthorEmail is the email to use for commits\n   186→\tAuthorEmail string\n   187→\n   188→\t// MetadataDir is a directory containing additional metadata files to copy\n   189→\t// If set, all files in this directory will be copied to the checkpoint path\n   190→\t// This is useful for copying task metadata files, subagent transcripts, etc.\n   191→\tMetadataDir string\n   192→\n   193→\t// Task checkpoint fields (for auto-commit strategy task checkpoints)\n   194→\tIsTask    bool   // Whether this is a task checkpoint\n   195→\tToolUseID string // Tool use ID for task checkpoints\n   196→\n   197→\t// Additional task checkpoint fields for subagent checkpoints\n   198→\tAgentID                string // Subagent identifier\n   199→\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n   200→\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n   201→\tSubagentTranscriptPath string // Path to subagent's transcript file\n   202→\n   203→\t// Incremental checkpoint fields\n   204→\tIsIncremental       bool   // Whether this is an incremental checkpoint\n   205→\tIncrementalSequence int    // Checkpoint sequence number\n   206→\tIncrementalType     string // Tool type that triggered this checkpoint\n   207→\tIncrementalData     []byte // Tool input payload for this checkpoint\n   208→\n   209→\t// Commit message fields (used for task checkpoints)\n   210→\tCommitSubject string // Subject line for the metadata commit (overrides default)\n   211→\n   212→\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n   213→\tAgent string\n   214→\n   215→\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n   216→\tTranscriptUUIDAtStart  string // Last UUID when checkpoint started\n   217→\tTranscriptLinesAtStart int    // Line count when checkpoint started\n   218→\n   219→\t// TokenUsage contains the token usage for this checkpoint\n   220→\tTokenUsage *TokenUsage\n   221→}\n   222→\n   223→// ReadCommittedResult contains the result of reading a committed checkpoint.\n   224→type ReadCommittedResult struct {\n   225→\t// Metadata contains the checkpoint metadata\n   226→\tMetadata CommittedMetadata\n   227→\n   228→\t// Transcript is the session transcript content (most recent session)\n   229→\tTranscript []byte\n   230→\n   231→\t// Prompts contains user prompts (most recent session)\n   232→\tPrompts string\n   233→\n   234→\t// Context is the context.md content\n   235→\tContext string\n   236→\n   237→\t// ArchivedSessions contains transcripts from previous sessions when multiple\n   238→\t// sessions were condensed to the same checkpoint. Ordered from oldest to newest\n   239→\t// (1/, 2/, etc.). The root-level Transcript is the most recent session.\n   240→\tArchivedSessions []ArchivedSession\n   241→}\n   242→\n   243→// ArchivedSession contains transcript data from a previous session\n   244→// that was archived when multiple sessions contributed to the same checkpoint.\n   245→type ArchivedSession struct {\n   246→\t// SessionID is the session identifier for this archived session\n   247→\tSessionID string\n   248→\n   249→\t// Transcript is the session transcript content\n   250→\tTranscript []byte\n   251→\n   252→\t// Prompts contains user prompts from this session\n   253→\tPrompts string\n   254→\n   255→\t// FolderIndex is the archive folder number (1, 2, etc.)\n   256→\tFolderIndex int\n   257→}\n   258→\n   259→// CommittedInfo contains summary information about a committed checkpoint.\n   260→type CommittedInfo struct {\n   261→\t// CheckpointID is the stable 12-hex-char identifier\n   262→\tCheckpointID string\n   263→\n   264→\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n   265→\tSessionID string\n   266→\n   267→\t// CreatedAt is when the checkpoint was created\n   268→\tCreatedAt time.Time\n   269→\n   270→\t// CheckpointsCount is the total number of checkpoints across all sessions\n   271→\tCheckpointsCount int\n   272→\n   273→\t// FilesTouched are files modified during all sessions\n   274→\tFilesTouched []string\n   275→\n   276→\t// Agent identifies the agent that created this checkpoint\n   277→\tAgent string\n   278→\n   279→\t// IsTask indicates if this is a task checkpoint\n   280→\tIsTask bool\n   281→\n   282→\t// ToolUseID is the tool use ID for task checkpoints\n   283→\tToolUseID string\n   284→\n   285→\t// Multi-session support\n   286→\tSessionCount int      // Number of sessions (1 if single session)\n   287→\tSessionIDs   []string // All session IDs that contributed\n   288→}\n   289→\n   290→// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\n   291→type CommittedMetadata struct {\n   292→\tCheckpointID     string    `json:\"checkpoint_id\"`\n   293→\tSessionID        string    `json:\"session_id\"`\n   294→\tStrategy         string    `json:\"strategy\"`\n   295→\tCreatedAt        time.Time `json:\"created_at\"`\n   296→\tCheckpointsCount int       `json:\"checkpoints_count\"`\n   297→\tFilesTouched     []string  `json:\"files_touched\"`\n   298→\n   299→\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n   300→\tAgent string `json:\"agent,omitempty\"`\n   301→\n   302→\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n   303→\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n   304→\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n   305→\n   306→\t// Task checkpoint fields (only populated for task checkpoints)\n   307→\tIsTask    bool   `json:\"is_task,omitempty\"`\n   308→\tToolUseID string `json:\"tool_use_id,omitempty\"`\n   309→\n   310→\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n   311→\tTranscriptUUIDAtStart  string `json:\"transcript_uuid_at_start,omitempty\"`  // Last UUID when checkpoint started\n   312→\tTranscriptLinesAtStart int    `json:\"transcript_lines_at_start,omitempty\"` // Line count when checkpoint started\n   313→\n   314→\t// Token usage for this checkpoint\n   315→\tTokenUsage *TokenUsage `json:\"token_usage,omitempty\"`\n   316→}\n   317→\n   318→// TokenUsage represents aggregated token usage for a checkpoint\n   319→type TokenUsage struct {\n   320→\t// Input tokens (fresh, not from cache)\n   321→\tInputTokens int `json:\"input_tokens\"`\n   322→\t// Tokens written to cache (billable at cache write rate)\n   323→\tCacheCreationTokens int `json:\"cache_creation_tokens\"`\n   324→\t// Tokens read from cache (discounted rate)\n   325→\tCacheReadTokens int `json:\"cache_read_tokens\"`\n   326→\t// Output tokens generated\n   327→\tOutputTokens int `json:\"output_tokens\"`\n   328→\t// Number of API calls made\n   329→\tAPICallCount int `json:\"api_call_count\"`\n   330→\t// Subagent token usage (if any agents were spawned)\n   331→\tSubagentTokens *TokenUsage `json:\"subagent_tokens,omitempty\"`\n   332→}\n   333→\n   334→// Info provides summary information for listing checkpoints.\n   335→// This is the generic checkpoint info type.\n   336→type Info struct {\n   337→\t// ID is the checkpoint identifier\n   338→\tID string\n   339→\n   340→\t// SessionID identifies the session\n   341→\tSessionID string\n   342→\n   343→\t// Type indicates temporary or committed\n   344→\tType Type\n   345→\n   346→\t// CreatedAt is when the checkpoint was created\n   347→\tCreatedAt time.Time\n   348→\n   349→\t// Message is a summary description\n   350→\tMessage string\n   351→}\n   352→\n   353→// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n   354→// Task checkpoints are created when a subagent completes and contain both\n   355→// code changes and task-specific metadata.\n   356→type WriteTemporaryTaskOptions struct {\n   357→\t// SessionID is the session identifier\n   358→\tSessionID string\n   359→\n   360→\t// BaseCommit is the commit hash this session is based on\n   361→\tBaseCommit string\n   362→\n   363→\t// ToolUseID is the unique identifier for this Task tool invocation\n   364→\tToolUseID string\n   365→\n   366→\t// AgentID is the subagent identifier\n   367→\tAgentID string\n   368→\n   369→\t// ModifiedFiles are files that have been modified (relative paths)\n   370→\tModifiedFiles []string\n   371→\n   372→\t// NewFiles are files that have been created (relative paths)\n   373→\tNewFiles []string\n   374→\n   375→\t// DeletedFiles are files that have been deleted (relative paths)\n   376→\tDeletedFiles []string\n   377→\n   378→\t// TranscriptPath is the path to the main session transcript\n   379→\tTranscriptPath string\n   380→\n   381→\t// SubagentTranscriptPath is the path to the subagent's transcript\n   382→\tSubagentTranscriptPath string\n   383→\n   384→\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n   385→\tCheckpointUUID string\n   386→\n   387→\t// CommitMessage is the commit message (already formatted)\n   388→\tCommitMessage string\n   389→\n   390→\t// AuthorName is the name to use for commits\n   391→\tAuthorName string\n   392→\n   393→\t// AuthorEmail is the email to use for commits\n   394→\tAuthorEmail string\n   395→\n   396→\t// IsIncremental indicates this is an incremental checkpoint\n   397→\tIsIncremental bool\n   398→\n   399→\t// IncrementalSequence is the checkpoint sequence number\n   400→\tIncrementalSequence int\n   401→\n   402→\t// IncrementalType is the tool that triggered this checkpoint\n   403→\tIncrementalType string\n   404→\n   405→\t// IncrementalData is the tool_input payload for this checkpoint\n   406→\tIncrementalData []byte\n   407→}\n   408→\n   409→// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n   410→// Used by ListTemporaryCheckpoints to provide rewind point data.\n   411→type TemporaryCheckpointInfo struct {\n   412→\t// CommitHash is the hash of the checkpoint commit\n   413→\tCommitHash plumbing.Hash\n   414→\n   415→\t// Message is the first line of the commit message\n   416→\tMessage string\n   417→\n   418→\t// SessionID is the session identifier from the Entire-Session trailer\n   419→\tSessionID string\n   420→\n   421→\t// MetadataDir is the metadata directory path from trailers\n   422→\tMetadataDir string\n   423→\n   424→\t// IsTaskCheckpoint indicates if this is a task checkpoint\n   425→\tIsTaskCheckpoint bool\n   426→\n   427→\t// ToolUseID is the tool use ID for task checkpoints\n   428→\tToolUseID string\n   429→\n   430→\t// Timestamp is when the checkpoint was created\n   431→\tTimestamp time.Time\n   432→}\n   433→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"c4fe9375-6e31-419b-873a-44d32f246554","timestamp":"2026-01-20T05:16:06.458Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gtrrz-victor/wks/cli/cmd/entire/cli/checkpoint/checkpoint.go","content":"// Package checkpoint provides types and interfaces for checkpoint storage.\n//\n// A Checkpoint captures a point-in-time within a session, containing either\n// full state (Temporary) or metadata with a commit reference (Committed).\n//\n// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\npackage checkpoint\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/go-git/go-git/v5/plumbing\"\n)\n\n// Checkpoint represents a save point within a session.\ntype Checkpoint struct {\n\t// ID is the unique checkpoint identifier\n\tID string\n\n\t// SessionID is the session this checkpoint belongs to\n\tSessionID string\n\n\t// Timestamp is when this checkpoint was created\n\tTimestamp time.Time\n\n\t// Type indicates temporary (full state) or committed (metadata only)\n\tType Type\n\n\t// Message is a human-readable description of the checkpoint\n\tMessage string\n}\n\n// Type indicates the storage location and lifecycle of a checkpoint.\ntype Type int\n\nconst (\n\t// Temporary checkpoints contain full state (code + metadata) and are stored\n\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n\tTemporary Type = iota\n\n\t// Committed checkpoints contain metadata + commit reference and are stored\n\t// on the entire/sessions branch. They are the permanent record.\n\tCommitted\n)\n\n// Store provides low-level primitives for reading and writing checkpoints.\n// This is used by strategies to implement their storage approach.\n//\n// The interface matches the GitStore implementation signatures directly:\n// - WriteTemporary takes WriteTemporaryOptions and returns the commit hash\n// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n// - List methods return implementation-specific info types for richer data\ntype Store interface {\n\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n\t// Shadow branches are named entire/<base-commit-short-hash>.\n\t// Returns the commit hash of the created checkpoint.\n\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (plumbing.Hash, error)\n\n\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n\t// baseCommit is the commit hash the session is based on.\n\t// Returns nil, nil if the shadow branch doesn't exist.\n\tReadTemporary(ctx context.Context, baseCommit string) (*ReadTemporaryResult, error)\n\n\t// ListTemporary lists all shadow branches with their checkpoint info.\n\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n\n\t// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n\n\t// ReadCommitted reads a committed checkpoint by ID.\n\t// Returns nil, nil if the checkpoint does not exist.\n\tReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error)\n\n\t// ListCommitted lists all committed checkpoints.\n\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n}\n\n// WriteTemporaryOptions contains options for writing a temporary checkpoint.\ntype WriteTemporaryOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// MetadataDir is the relative path to the metadata directory\n\tMetadataDir string\n\n\t// MetadataDirAbs is the absolute path to the metadata directory\n\tMetadataDirAbs string\n\n\t// CommitMessage is the commit subject line\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n\t// When true, all working directory files are captured (not just modified)\n\tIsFirstCheckpoint bool\n}\n\n// ReadTemporaryResult contains the result of reading a temporary checkpoint.\ntype ReadTemporaryResult struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// TreeHash is the hash of the tree containing the checkpoint state\n\tTreeHash plumbing.Hash\n\n\t// SessionID is the session identifier from the commit trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from the commit trailer\n\tMetadataDir string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n\n// TemporaryInfo contains summary information about a shadow branch.\ntype TemporaryInfo struct {\n\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n\tBranchName string\n\n\t// BaseCommit is the short commit hash this branch is based on\n\tBaseCommit string\n\n\t// LatestCommit is the hash of the latest commit on the branch\n\tLatestCommit plumbing.Hash\n\n\t// SessionID is the session identifier from the latest commit\n\tSessionID string\n\n\t// Timestamp is when the latest checkpoint was created\n\tTimestamp time.Time\n}\n\n// WriteCommittedOptions contains options for writing a committed checkpoint.\ntype WriteCommittedOptions struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// Strategy is the name of the strategy that created this checkpoint\n\tStrategy string\n\n\t// Transcript is the session transcript content (full.jsonl)\n\tTranscript []byte\n\n\t// Prompts contains user prompts from the session\n\tPrompts []string\n\n\t// Context is the generated context.md content\n\tContext []byte\n\n\t// FilesTouched are files modified during the session\n\tFilesTouched []string\n\n\t// CheckpointsCount is the number of checkpoints in this session\n\tCheckpointsCount int\n\n\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n\tEphemeralBranch string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// MetadataDir is a directory containing additional metadata files to copy\n\t// If set, all files in this directory will be copied to the checkpoint path\n\t// This is useful for copying task metadata files, subagent transcripts, etc.\n\tMetadataDir string\n\n\t// Task checkpoint fields (for auto-commit strategy task checkpoints)\n\tIsTask    bool   // Whether this is a task checkpoint\n\tToolUseID string // Tool use ID for task checkpoints\n\n\t// Additional task checkpoint fields for subagent checkpoints\n\tAgentID                string // Subagent identifier\n\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n\tSubagentTranscriptPath string // Path to subagent's transcript file\n\n\t// Incremental checkpoint fields\n\tIsIncremental       bool   // Whether this is an incremental checkpoint\n\tIncrementalSequence int    // Checkpoint sequence number\n\tIncrementalType     string // Tool type that triggered this checkpoint\n\tIncrementalData     []byte // Tool input payload for this checkpoint\n\n\t// Commit message fields (used for task checkpoints)\n\tCommitSubject string // Subject line for the metadata commit (overrides default)\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string\n\n\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n\tTranscriptUUIDAtStart  string // Last UUID when checkpoint started\n\tTranscriptLinesAtStart int    // Line count when checkpoint started\n\n\t// TokenUsage contains the token usage for this checkpoint\n\tTokenUsage *TokenUsage\n}\n\n// ReadCommittedResult contains the result of reading a committed checkpoint.\ntype ReadCommittedResult struct {\n\t// Metadata contains the checkpoint metadata\n\tMetadata CommittedMetadata\n\n\t// Transcript is the session transcript content (most recent session)\n\tTranscript []byte\n\n\t// Prompts contains user prompts (most recent session)\n\tPrompts string\n\n\t// Context is the context.md content\n\tContext string\n\n\t// ArchivedSessions contains transcripts from previous sessions when multiple\n\t// sessions were condensed to the same checkpoint. Ordered from oldest to newest\n\t// (1/, 2/, etc.). The root-level Transcript is the most recent session.\n\tArchivedSessions []ArchivedSession\n}\n\n// ArchivedSession contains transcript data from a previous session\n// that was archived when multiple sessions contributed to the same checkpoint.\ntype ArchivedSession struct {\n\t// SessionID is the session identifier for this archived session\n\tSessionID string\n\n\t// Transcript is the session transcript content\n\tTranscript []byte\n\n\t// Prompts contains user prompts from this session\n\tPrompts string\n\n\t// FolderIndex is the archive folder number (1, 2, etc.)\n\tFolderIndex int\n}\n\n// CommittedInfo contains summary information about a committed checkpoint.\ntype CommittedInfo struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n\tSessionID string\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// CheckpointsCount is the total number of checkpoints across all sessions\n\tCheckpointsCount int\n\n\t// FilesTouched are files modified during all sessions\n\tFilesTouched []string\n\n\t// Agent identifies the agent that created this checkpoint\n\tAgent string\n\n\t// IsTask indicates if this is a task checkpoint\n\tIsTask bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Multi-session support\n\tSessionCount int      // Number of sessions (1 if single session)\n\tSessionIDs   []string // All session IDs that contributed\n}\n\n// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\ntype CommittedMetadata struct {\n\tCheckpointID     string    `json:\"checkpoint_id\"`\n\tSessionID        string    `json:\"session_id\"`\n\tStrategy         string    `json:\"strategy\"`\n\tCreatedAt        time.Time `json:\"created_at\"`\n\tCheckpointsCount int       `json:\"checkpoints_count\"`\n\tFilesTouched     []string  `json:\"files_touched\"`\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string `json:\"agent,omitempty\"`\n\n\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n\n\t// Task checkpoint fields (only populated for task checkpoints)\n\tIsTask    bool   `json:\"is_task,omitempty\"`\n\tToolUseID string `json:\"tool_use_id,omitempty\"`\n\n\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n\tTranscriptUUIDAtStart  string `json:\"transcript_uuid_at_start,omitempty\"`  // Last UUID when checkpoint started\n\tTranscriptLinesAtStart int    `json:\"transcript_lines_at_start,omitempty\"` // Line count when checkpoint started\n\n\t// Token usage for this checkpoint\n\tTokenUsage *TokenUsage `json:\"token_usage,omitempty\"`\n}\n\n// TokenUsage represents aggregated token usage for a checkpoint\ntype TokenUsage struct {\n\t// Input tokens (fresh, not from cache)\n\tInputTokens int `json:\"input_tokens\"`\n\t// Tokens written to cache (billable at cache write rate)\n\tCacheCreationTokens int `json:\"cache_creation_tokens\"`\n\t// Tokens read from cache (discounted rate)\n\tCacheReadTokens int `json:\"cache_read_tokens\"`\n\t// Output tokens generated\n\tOutputTokens int `json:\"output_tokens\"`\n\t// Number of API calls made\n\tAPICallCount int `json:\"api_call_count\"`\n\t// Subagent token usage (if any agents were spawned)\n\tSubagentTokens *TokenUsage `json:\"subagent_tokens,omitempty\"`\n}\n\n// Info provides summary information for listing checkpoints.\n// This is the generic checkpoint info type.\ntype Info struct {\n\t// ID is the checkpoint identifier\n\tID string\n\n\t// SessionID identifies the session\n\tSessionID string\n\n\t// Type indicates temporary or committed\n\tType Type\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// Message is a summary description\n\tMessage string\n}\n\n// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n// Task checkpoints are created when a subagent completes and contain both\n// code changes and task-specific metadata.\ntype WriteTemporaryTaskOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// ToolUseID is the unique identifier for this Task tool invocation\n\tToolUseID string\n\n\t// AgentID is the subagent identifier\n\tAgentID string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// TranscriptPath is the path to the main session transcript\n\tTranscriptPath string\n\n\t// SubagentTranscriptPath is the path to the subagent's transcript\n\tSubagentTranscriptPath string\n\n\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n\tCheckpointUUID string\n\n\t// CommitMessage is the commit message (already formatted)\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsIncremental indicates this is an incremental checkpoint\n\tIsIncremental bool\n\n\t// IncrementalSequence is the checkpoint sequence number\n\tIncrementalSequence int\n\n\t// IncrementalType is the tool that triggered this checkpoint\n\tIncrementalType string\n\n\t// IncrementalData is the tool_input payload for this checkpoint\n\tIncrementalData []byte\n}\n\n// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n// Used by ListTemporaryCheckpoints to provide rewind point data.\ntype TemporaryCheckpointInfo struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// Message is the first line of the commit message\n\tMessage string\n\n\t// SessionID is the session identifier from the Entire-Session trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from trailers\n\tMetadataDir string\n\n\t// IsTaskCheckpoint indicates if this is a task checkpoint\n\tIsTaskCheckpoint bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n","numLines":433,"startLine":1,"totalLines":433}}},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014eyEdAqMUSP9utanQVorQW","type":"tool_result","content":"     1→// Package strategy provides an interface for different git strategies\n     2→// that can be used to save and manage Claude Code session changes.\n     3→package strategy\n     4→\n     5→import (\n     6→\t\"encoding/json\"\n     7→\t\"errors\"\n     8→\t\"os\"\n     9→\t\"strings\"\n    10→\t\"time\"\n    11→\n    12→\t\"entire.io/cli/cmd/entire/cli/checkpoint\"\n    13→)\n    14→\n    15→// ErrNoMetadata is returned when a commit does not have an Entire metadata trailer.\n    16→var ErrNoMetadata = errors.New(\"commit has no entire metadata\")\n    17→\n    18→// ErrNoSession is returned when no session info is available.\n    19→var ErrNoSession = errors.New(\"no session info available\")\n    20→\n    21→// ErrNotTaskCheckpoint is returned when a rewind point is not a task checkpoint.\n    22→var ErrNotTaskCheckpoint = errors.New(\"not a task checkpoint\")\n    23→\n    24→// ErrNotImplemented is returned when a feature is not yet implemented.\n    25→var ErrNotImplemented = errors.New(\"not implemented\")\n    26→\n    27→// IncrementalTypeTaskStart is the incremental type for the starting checkpoint\n    28→// created during PreToolUse[Task] hook before a subagent begins execution.\n    29→const IncrementalTypeTaskStart = \"TaskStart\"\n    30→\n    31→// ShadowBranchConflictError is returned when a shadow branch already exists\n    32→// with activity from a different session or worktree.\n    33→type ShadowBranchConflictError struct {\n    34→\tBranch           string    // The shadow branch name (e.g., \"entire/abc1234\")\n    35→\tExistingSession  string    // Session ID of the existing session\n    36→\tExistingWorktree string    // Worktree path of the existing session\n    37→\tLastActivity     time.Time // When the existing session was last active\n    38→\tCurrentSession   string    // Session ID of the current session attempting to start\n    39→\tCurrentWorktree  string    // Worktree path of the current session\n    40→}\n    41→\n    42→func (e *ShadowBranchConflictError) Error() string {\n    43→\treturn \"shadow branch conflict: existing session from different worktree\"\n    44→}\n    45→\n    46→// SessionIDConflictError is returned when trying to start a new session\n    47→// but the shadow branch already has commits from a different session ID.\n    48→// This prevents orphaning existing session work.\n    49→type SessionIDConflictError struct {\n    50→\tExistingSession string // Session ID found in the shadow branch\n    51→\tNewSession      string // Session ID being initialized\n    52→\tShadowBranch    string // The shadow branch name (e.g., \"entire/abc1234\")\n    53→}\n    54→\n    55→func (e *SessionIDConflictError) Error() string {\n    56→\treturn \"session ID conflict: shadow branch has commits from a different session\"\n    57→}\n    58→\n    59→// ExtractToolUseIDFromTaskMetadataDir extracts the ToolUseID from a task metadata directory path.\n    60→// Task metadata dirs have format: .entire/metadata/<session>/tasks/<toolUseID>\n    61→// Returns empty string if not a task metadata directory.\n    62→func ExtractToolUseIDFromTaskMetadataDir(metadataDir string) string {\n    63→\tparts := strings.Split(metadataDir, \"/\")\n    64→\tif len(parts) >= 2 && parts[len(parts)-2] == \"tasks\" {\n    65→\t\treturn parts[len(parts)-1]\n    66→\t}\n    67→\treturn \"\"\n    68→}\n    69→\n    70→// SessionInfo contains information about the current session state.\n    71→// This is used to generate trailers for linking commits to their AI session.\n    72→type SessionInfo struct {\n    73→\t// SessionID is the session identifier extracted from the latest commit's metadata\n    74→\tSessionID string\n    75→\n    76→\t// Reference is a strategy-specific reference string.\n    77→\t// For manual-commit strategy: \"entire/abc1234\" (the shadow branch name)\n    78→\t// Empty for commit strategy (metadata is in the same commit).\n    79→\tReference string\n    80→\n    81→\t// CommitHash is the full SHA of the commit containing the session metadata.\n    82→\t// Empty for commit strategy.\n    83→\tCommitHash string\n    84→}\n    85→\n    86→// RewindPoint represents a point to which the user can rewind.\n    87→// This abstraction allows different strategies to use different\n    88→// identifiers (commit hashes, branch names, stash refs, etc.)\n    89→type RewindPoint struct {\n    90→\t// ID is the unique identifier for this rewind point\n    91→\t// (commit hash, branch name, stash ref, etc.)\n    92→\tID string\n    93→\n    94→\t// Message is the human-readable description/summary\n    95→\tMessage string\n    96→\n    97→\t// MetadataDir is the path to the metadata directory\n    98→\tMetadataDir string\n    99→\n   100→\t// Date is when this rewind point was created\n   101→\tDate time.Time\n   102→\n   103→\t// IsTaskCheckpoint indicates if this is a task checkpoint (vs a session checkpoint)\n   104→\tIsTaskCheckpoint bool\n   105→\n   106→\t// ToolUseID is the tool use ID for task checkpoints (empty for session checkpoints)\n   107→\tToolUseID string\n   108→\n   109→\t// IsLogsOnly indicates this is a commit with session logs but no shadow branch state.\n   110→\t// The logs can be restored from entire/sessions, but file state requires git checkout.\n   111→\tIsLogsOnly bool\n   112→\n   113→\t// CheckpointID is the stable 12-hex-char identifier for logs-only points.\n   114→\t// Used to retrieve logs from entire/sessions/<id[:2]>/<id[2:]>/full.jsonl\n   115→\tCheckpointID string\n   116→\n   117→\t// Agent is the human-readable name of the agent that created this checkpoint\n   118→\t// (e.g., \"Claude Code\", \"Cursor\")\n   119→\tAgent string\n   120→\n   121→\t// SessionID is the session identifier for this checkpoint.\n   122→\t// Used to distinguish checkpoints from different concurrent sessions.\n   123→\tSessionID string\n   124→\n   125→\t// SessionPrompt is the initial prompt that started this session.\n   126→\t// Used to help users identify which session a checkpoint belongs to.\n   127→\tSessionPrompt string\n   128→\n   129→\t// SessionCount is the number of sessions in this checkpoint (1 for single-session).\n   130→\t// Only populated for logs-only points with multi-session checkpoints.\n   131→\tSessionCount int\n   132→\n   133→\t// SessionIDs contains all session IDs when this is a multi-session checkpoint.\n   134→\t// The last entry is the most recent session (same as SessionID).\n   135→\t// Only populated for logs-only points with multi-session checkpoints.\n   136→\tSessionIDs []string\n   137→\n   138→\t// SessionPrompts contains the first prompt for each session (parallel to SessionIDs).\n   139→\t// Used to display context when showing resume commands for multi-session checkpoints.\n   140→\tSessionPrompts []string\n   141→}\n   142→\n   143→// RewindPreview describes what will happen when rewinding to a checkpoint.\n   144→// Used to warn users about files that will be modified or deleted.\n   145→type RewindPreview struct {\n   146→\t// FilesToRestore are files from the checkpoint that will be written/restored.\n   147→\tFilesToRestore []string\n   148→\n   149→\t// FilesToDelete are untracked files that will be removed.\n   150→\t// These are files created after the checkpoint that aren't in the checkpoint tree\n   151→\t// and weren't present at session start.\n   152→\tFilesToDelete []string\n   153→\n   154→\t// TrackedChanges are tracked files with uncommitted changes that will be reverted.\n   155→\t// These come from the existing CanRewind() warning.\n   156→\tTrackedChanges []string\n   157→}\n   158→\n   159→// SaveContext contains all information needed for saving changes.\n   160→// All file paths should be pre-filtered and normalized by the CLI layer.\n   161→type SaveContext struct {\n   162→\t// SessionID is the Claude Code session identifier\n   163→\tSessionID string\n   164→\n   165→\t// ModifiedFiles is the list of files modified during the session\n   166→\t// (extracted from the transcript, already filtered and relative)\n   167→\tModifiedFiles []string\n   168→\n   169→\t// NewFiles is the list of new files created during the session\n   170→\t// (pre-computed by CLI from pre-prompt state comparison)\n   171→\tNewFiles []string\n   172→\n   173→\t// DeletedFiles is the list of files deleted during the session\n   174→\t// (tracked files that no longer exist)\n   175→\tDeletedFiles []string\n   176→\n   177→\t// MetadataDir is the path to the session metadata directory\n   178→\tMetadataDir string\n   179→\n   180→\t// MetadataDirAbs is the absolute path to the session metadata directory\n   181→\tMetadataDirAbs string\n   182→\n   183→\t// CommitMessage is the generated commit message\n   184→\tCommitMessage string\n   185→\n   186→\t// TranscriptPath is the path to the transcript file\n   187→\tTranscriptPath string\n   188→\n   189→\t// AuthorName is the name to use for commits\n   190→\tAuthorName string\n   191→\n   192→\t// AuthorEmail is the email to use for commits\n   193→\tAuthorEmail string\n   194→\n   195→\t// AgentType is the human-readable agent name (e.g., \"Claude Code\", \"Cursor\")\n   196→\tAgentType string\n   197→\n   198→\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n   199→\tTranscriptUUIDAtStart  string // Last UUID when checkpoint started\n   200→\tTranscriptLinesAtStart int    // Line count when checkpoint started\n   201→\n   202→\t// TokenUsage contains the token usage for this checkpoint\n   203→\tTokenUsage *checkpoint.TokenUsage\n   204→}\n   205→\n   206→// TaskCheckpointContext contains all information needed for saving a task checkpoint.\n   207→// This is called by the PostToolUse[Task] hook when a subagent completes.\n   208→// The strategy is responsible for creating metadata structures and storing them\n   209→// according to its storage approach.\n   210→type TaskCheckpointContext struct {\n   211→\t// SessionID is the Claude Code session identifier\n   212→\tSessionID string\n   213→\n   214→\t// ToolUseID is the unique identifier for this Task tool invocation\n   215→\tToolUseID string\n   216→\n   217→\t// AgentID is the subagent identifier (from tool_response.agentId)\n   218→\tAgentID string\n   219→\n   220→\t// ModifiedFiles is the list of files modified by the subagent\n   221→\t// (extracted from the subagent's transcript)\n   222→\tModifiedFiles []string\n   223→\n   224→\t// NewFiles is the list of new files created by the subagent\n   225→\t// (computed from pre-task state comparison)\n   226→\tNewFiles []string\n   227→\n   228→\t// DeletedFiles is the list of files deleted by the subagent\n   229→\tDeletedFiles []string\n   230→\n   231→\t// TranscriptPath is the path to the main session transcript\n   232→\tTranscriptPath string\n   233→\n   234→\t// SubagentTranscriptPath is the path to the subagent's transcript (if available)\n   235→\tSubagentTranscriptPath string\n   236→\n   237→\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n   238→\tCheckpointUUID string\n   239→\n   240→\t// AuthorName is the name to use for commits\n   241→\tAuthorName string\n   242→\n   243→\t// AuthorEmail is the email to use for commits\n   244→\tAuthorEmail string\n   245→\n   246→\t// IsIncremental indicates this is an incremental checkpoint during task execution,\n   247→\t// not a final task completion checkpoint. When true:\n   248→\t// - Writes to checkpoints/NNN-{tool-use-id}.json instead of checkpoint.json\n   249→\t// - Skips transcript handling\n   250→\t// - Uses incremental commit message\n   251→\tIsIncremental bool\n   252→\n   253→\t// IncrementalSequence is the checkpoint sequence number (1, 2, 3, ...)\n   254→\t// Only used when IsIncremental is true\n   255→\tIncrementalSequence int\n   256→\n   257→\t// IncrementalType is the tool that triggered this checkpoint (\"TodoWrite\", \"Edit\", etc.)\n   258→\t// Only used when IsIncremental is true\n   259→\tIncrementalType string\n   260→\n   261→\t// IncrementalData is the tool_input payload for this checkpoint\n   262→\t// Only used when IsIncremental is true\n   263→\tIncrementalData json.RawMessage\n   264→\n   265→\t// SubagentType is the type of subagent (e.g., \"dev\", \"reviewer\")\n   266→\t// Extracted from tool_input.subagent_type in Task tool\n   267→\t// Used for descriptive commit messages\n   268→\tSubagentType string\n   269→\n   270→\t// TaskDescription is the task description provided to the subagent\n   271→\t// Extracted from tool_input.description in Task tool\n   272→\t// Used for descriptive commit messages\n   273→\tTaskDescription string\n   274→\n   275→\t// TodoContent is the content of the in-progress todo item\n   276→\t// Extracted from tool_input.todos where status == \"in_progress\"\n   277→\t// Used for descriptive incremental checkpoint messages\n   278→\tTodoContent string\n   279→\n   280→\t// AgentType is the human-readable agent name (e.g., \"Claude Code\", \"Cursor\")\n   281→\tAgentType string\n   282→}\n   283→\n   284→// TaskCheckpoint contains the checkpoint information written to checkpoint.json\n   285→type TaskCheckpoint struct {\n   286→\tSessionID      string `json:\"session_id\"`\n   287→\tToolUseID      string `json:\"tool_use_id\"`\n   288→\tCheckpointUUID string `json:\"checkpoint_uuid\"`\n   289→\tAgentID        string `json:\"agent_id,omitempty\"`\n   290→}\n   291→\n   292→// SubagentCheckpoint represents an intermediate checkpoint created during subagent execution.\n   293→// These are created by PostToolUse hooks for tools like TodoWrite, Edit, Write.\n   294→type SubagentCheckpoint struct {\n   295→\tType      string          `json:\"type\"`        // Tool name: \"TodoWrite\", \"Edit\", \"Write\"\n   296→\tToolUseID string          `json:\"tool_use_id\"` // The tool use ID that created this checkpoint\n   297→\tTimestamp time.Time       `json:\"timestamp\"`   // When the checkpoint was created\n   298→\tData      json.RawMessage `json:\"data\"`        // Type-specific payload (tool_input)\n   299→}\n   300→\n   301→// TaskMetadataDir returns the path to a task's metadata directory\n   302→// within the session metadata directory.\n   303→func TaskMetadataDir(sessionMetadataDir, toolUseID string) string {\n   304→\treturn sessionMetadataDir + \"/tasks/\" + toolUseID\n   305→}\n   306→\n   307→// ReadTaskCheckpoint reads the checkpoint.json file from a task metadata directory.\n   308→// This is used during rewind to get the checkpoint UUID for transcript truncation.\n   309→func ReadTaskCheckpoint(taskMetadataDir string) (*TaskCheckpoint, error) {\n   310→\tcheckpointFile := taskMetadataDir + \"/checkpoint.json\"\n   311→\n   312→\tdata, err := os.ReadFile(checkpointFile) //nolint:gosec // Reading from controlled git metadata path\n   313→\tif err != nil {\n   314→\t\treturn nil, err\n   315→\t}\n   316→\n   317→\tvar checkpoint TaskCheckpoint\n   318→\tif err := json.Unmarshal(data, &checkpoint); err != nil {\n   319→\t\treturn nil, err\n   320→\t}\n   321→\n   322→\treturn &checkpoint, nil\n   323→}\n   324→\n   325→// Strategy defines the interface for git operation strategies.\n   326→// Different implementations can use commits, branches, stashes, etc.\n   327→//\n   328→// Note: State capture (tracking untracked files before a session) is handled\n   329→// by the CLI layer, not the strategy. The strategy receives pre-computed\n   330→// file lists in SaveContext.\n   331→type Strategy interface {\n   332→\t// Name returns the strategy identifier (e.g., \"commit\", \"branch\", \"stash\")\n   333→\tName() string\n   334→\n   335→\t// Description returns a human-readable description for the setup wizard\n   336→\tDescription() string\n   337→\n   338→\t// AllowsMainBranch returns true if this strategy can safely operate on the\n   339→\t// default branch (main/master). Strategies that don't modify the working\n   340→\t// branch's commit history (like manual-commit strategies) can return true.\n   341→\t// Strategies that create commits on the working branch should return false\n   342→\t// to prevent polluting main branch history.\n   343→\tAllowsMainBranch() bool\n   344→\n   345→\t// ValidateRepository checks if the repository is in a valid state\n   346→\t// for this strategy to operate. Returns an error if validation fails.\n   347→\tValidateRepository() error\n   348→\n   349→\t// SaveChanges is called on Stop to save all session changes\n   350→\t// using this strategy's approach (commit, branch, stash, etc.)\n   351→\tSaveChanges(ctx SaveContext) error\n   352→\n   353→\t// SaveTaskCheckpoint is called by PostToolUse[Task] hook when a subagent completes.\n   354→\t// Creates a checkpoint commit with task metadata for later rewind.\n   355→\t// Different strategies may handle this differently:\n   356→\t// - Commit strategy: commits to active branch\n   357→\t// - Manual-commit strategy: commits to shadow branch\n   358→\t// - Auto-commit strategy: commits logs to shadow only (code deferred to Stop)\n   359→\tSaveTaskCheckpoint(ctx TaskCheckpointContext) error\n   360→\n   361→\t// GetRewindPoints returns available points to rewind to.\n   362→\t// The limit parameter controls the maximum number of points to return.\n   363→\tGetRewindPoints(limit int) ([]RewindPoint, error)\n   364→\n   365→\t// Rewind restores the repository to the given rewind point.\n   366→\t// The metadataDir in the point is used to restore the session transcript.\n   367→\tRewind(point RewindPoint) error\n   368→\n   369→\t// CanRewind checks if rewinding is currently possible.\n   370→\t// Returns (canRewind, reason if not, error)\n   371→\tCanRewind() (bool, string, error)\n   372→\n   373→\t// PreviewRewind returns what will happen if rewinding to the given point.\n   374→\t// This allows showing warnings about files that will be deleted before the rewind.\n   375→\t// Returns nil if preview is not supported (e.g., auto-commit strategy).\n   376→\tPreviewRewind(point RewindPoint) (*RewindPreview, error)\n   377→\n   378→\t// GetSessionLog returns the raw session log (full.log) and session ID for a given commit.\n   379→\t// Returns ErrNoMetadata if the commit doesn't have an Entire metadata trailer.\n   380→\t// The session ID is extracted from the commit trailers or metadata directory.\n   381→\tGetSessionLog(checkpointID string) (logContent []byte, sessionID string, err error)\n   382→\n   383→\t// GetTaskCheckpoint returns the task checkpoint for a given rewind point.\n   384→\t// For strategies that store checkpoints in git (auto-commit), this reads from the branch.\n   385→\t// For strategies that store checkpoints on disk (commit, manual-commit), this reads from the filesystem.\n   386→\t// Returns nil, nil if not a task checkpoint or checkpoint not found.\n   387→\tGetTaskCheckpoint(point RewindPoint) (*TaskCheckpoint, error)\n   388→\n   389→\t// GetTaskCheckpointTranscript returns the session transcript for a task checkpoint.\n   390→\t// For strategies that store transcripts in git (auto-commit), this reads from the branch.\n   391→\t// For strategies that store transcripts on disk (commit, manual-commit), this reads from the filesystem.\n   392→\tGetTaskCheckpointTranscript(point RewindPoint) ([]byte, error)\n   393→\n   394→\t// GetSessionInfo returns session information for linking commits.\n   395→\t// This is used by the context command to generate trailers.\n   396→\t// Returns ErrNoSession if no session info is available.\n   397→\tGetSessionInfo() (*SessionInfo, error)\n   398→\n   399→\t// EnsureSetup ensures the strategy's required setup is in place,\n   400→\t// installing any missing pieces (git hooks, gitignore entries, etc.).\n   401→\t// Returns nil if setup is complete or was successfully installed.\n   402→\tEnsureSetup() error\n   403→\n   404→\t// NOTE: ListSessions and GetSession are standalone functions in session.go.\n   405→\t// They read from entire/sessions and merge with SessionSource if implemented.\n   406→\n   407→\t// GetMetadataRef returns a reference to the metadata commit for the given checkpoint.\n   408→\t// Format: \"<branch>@<commit-sha>\" (e.g., \"entire/sessions@abc123\").\n   409→\t// Returns empty string if not applicable (e.g., commit strategy with filesystem metadata).\n   410→\tGetMetadataRef(checkpoint Checkpoint) string\n   411→\n   412→\t// GetSessionMetadataRef returns a reference to the most recent metadata commit for a session.\n   413→\t// Format: \"<branch>@<commit-sha>\" (e.g., \"entire/sessions@abc123\").\n   414→\t// Returns empty string if not applicable or session not found.\n   415→\tGetSessionMetadataRef(sessionID string) string\n   416→\n   417→\t// GetSessionContext returns the context.md content for a session.\n   418→\t// Returns empty string if not available.\n   419→\tGetSessionContext(sessionID string) string\n   420→\n   421→\t// GetCheckpointLog returns the session transcript for a specific checkpoint.\n   422→\t// For strategies that store transcripts in git branches (auto-commit, manual-commit),\n   423→\t// this reads from the checkpoint's commit tree.\n   424→\t// For strategies that store on disk (commit), reads from the filesystem.\n   425→\t// Returns ErrNoMetadata if transcript is not available.\n   426→\tGetCheckpointLog(checkpoint Checkpoint) ([]byte, error)\n   427→}\n   428→\n   429→// SessionInitializer is an optional interface for strategies that need to\n   430→// initialize session state when a user prompt is submitted.\n   431→// Strategies like manual-commit use this to create session state files that\n   432→// the git prepare-commit-msg hook can detect.\n   433→type SessionInitializer interface {\n   434→\t// InitializeSession creates session state for a new session.\n   435→\t// Called during UserPromptSubmit hook before any checkpoints are created.\n   436→\t// agentType is the human-readable name of the agent (e.g., \"Claude Code\").\n   437→\tInitializeSession(sessionID string, agentType string) error\n   438→}\n   439→\n   440→// PrepareCommitMsgHandler is an optional interface for strategies that need to\n   441→// handle the git prepare-commit-msg hook.\n   442→type PrepareCommitMsgHandler interface {\n   443→\t// PrepareCommitMsg is called by the git prepare-commit-msg hook.\n   444→\t// It can modify the commit message file to add trailers, etc.\n   445→\t// The source parameter indicates how the commit was initiated:\n   446→\t//   - \"\" or \"template\": normal editor flow\n   447→\t//   - \"message\": using -m or -F flag\n   448→\t//   - \"merge\": merge commit\n   449→\t//   - \"squash\": squash merge\n   450→\t//   - \"commit\": amend with -c/-C\n   451→\t// Should return nil on errors to not block commits (log warnings to stderr).\n   452→\tPrepareCommitMsg(commitMsgFile string, source string) error\n   453→}\n   454→\n   455→// PostCommitHandler is an optional interface for strategies that need to\n   456→// handle the git post-commit hook.\n   457→type PostCommitHandler interface {\n   458→\t// PostCommit is called by the git post-commit hook after a commit is created.\n   459→\t// Used to perform actions like condensing session data after commits.\n   460→\t// Should return nil on errors to not block subsequent operations (log warnings to stderr).\n   461→\tPostCommit() error\n   462→}\n   463→\n   464→// CommitMsgHandler is an optional interface for strategies that need to\n   465→// handle the git commit-msg hook.\n   466→type CommitMsgHandler interface {\n   467→\t// CommitMsg is called by the git commit-msg hook after the user edits the message.\n   468→\t// Used to validate or modify the final commit message before the commit is created.\n   469→\t// If this returns an error, the commit is aborted.\n   470→\tCommitMsg(commitMsgFile string) error\n   471→}\n   472→\n   473→// PrePushHandler is an optional interface for strategies that need to\n   474→// handle the git pre-push hook.\n   475→type PrePushHandler interface {\n   476→\t// PrePush is called by the git pre-push hook before pushing to a remote.\n   477→\t// Used to push session branches (e.g., entire/sessions) alongside user pushes.\n   478→\t// The remote parameter is the name of the remote being pushed to.\n   479→\t// Should return nil on errors to not block pushes (log warnings to stderr).\n   480→\tPrePush(remote string) error\n   481→}\n   482→\n   483→// LogsOnlyRestorer is an optional interface for strategies that support\n   484→// restoring session logs without file state restoration.\n   485→// This is used for \"logs-only\" rewind points where only the session transcript\n   486→// can be restored (file state requires git checkout).\n   487→type LogsOnlyRestorer interface {\n   488→\t// RestoreLogsOnly restores session logs from a logs-only rewind point.\n   489→\t// Does not modify the working directory - only restores the transcript\n   490→\t// to Claude's project directory.\n   491→\t// If force is false, prompts for confirmation when local logs have newer timestamps.\n   492→\tRestoreLogsOnly(point RewindPoint, force bool) error\n   493→}\n   494→\n   495→// SessionResetter is an optional interface for strategies that support\n   496→// resetting session state and shadow branches.\n   497→// This is used by the \"rewind reset\" command to clean up shadow branches\n   498→// and session state when a user wants to start fresh.\n   499→type SessionResetter interface {\n   500→\t// Reset deletes the shadow branch and session state for the current HEAD.\n   501→\t// Returns nil if there's nothing to reset (no shadow branch).\n   502→\t// The force parameter suppresses confirmation prompts.\n   503→\tReset(force bool) error\n   504→}\n   505→\n   506→// ConcurrentSessionChecker is an optional interface for strategies that support\n   507→// detecting and warning about concurrent sessions with uncommitted changes.\n   508→// This is used by the UserPromptSubmit hook to block the first prompt when\n   509→// another session has uncommitted checkpoints on the same base commit.\n   510→type ConcurrentSessionChecker interface {\n   511→\t// HasOtherActiveSessionsWithCheckpoints returns a session state if there's another\n   512→\t// active session with uncommitted checkpoints on the same base commit.\n   513→\t// Returns nil, nil if no such session exists.\n   514→\tHasOtherActiveSessionsWithCheckpoints(currentSessionID string) (*SessionState, error)\n   515→}\n   516→\n   517→// SessionSource is an optional interface for strategies that provide additional\n   518→// sessions beyond those stored on the entire/sessions branch.\n   519→// For example, manual-commit strategy provides active sessions from .git/entire-sessions/\n   520→// that haven't yet been condensed to entire/sessions.\n   521→//\n   522→// ListSessions() automatically discovers all registered strategies, checks if they\n   523→// implement SessionSource, and merges their additional sessions by ID.\n   524→type SessionSource interface {\n   525→\t// GetAdditionalSessions returns sessions not yet on entire/sessions branch.\n   526→\tGetAdditionalSessions() ([]*Session, error)\n   527→}\n   528→\n   529→// OrphanedItemsLister is an optional interface for strategies that can identify\n   530→// orphaned items (shadow branches, session states, checkpoints) that should be\n   531→// cleaned up. This is used by the \"entire session cleanup\" command.\n   532→//\n   533→// ListAllCleanupItems() automatically discovers all registered strategies, checks\n   534→// if they implement OrphanedItemsLister, and combines their orphaned items.\n   535→type OrphanedItemsLister interface {\n   536→\t// ListOrphanedItems returns items created by this strategy that are now orphaned.\n   537→\t// Each strategy defines what \"orphaned\" means for its own data structures.\n   538→\tListOrphanedItems() ([]CleanupItem, error)\n   539→}\n   540→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"e18b140f-cd5b-4dc3-9cfe-8b396fe540d9","timestamp":"2026-01-20T05:16:06.458Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gtrrz-victor/wks/cli/cmd/entire/cli/strategy/strategy.go","content":"// Package strategy provides an interface for different git strategies\n// that can be used to save and manage Claude Code session changes.\npackage strategy\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"os\"\n\t\"strings\"\n\t\"time\"\n\n\t\"entire.io/cli/cmd/entire/cli/checkpoint\"\n)\n\n// ErrNoMetadata is returned when a commit does not have an Entire metadata trailer.\nvar ErrNoMetadata = errors.New(\"commit has no entire metadata\")\n\n// ErrNoSession is returned when no session info is available.\nvar ErrNoSession = errors.New(\"no session info available\")\n\n// ErrNotTaskCheckpoint is returned when a rewind point is not a task checkpoint.\nvar ErrNotTaskCheckpoint = errors.New(\"not a task checkpoint\")\n\n// ErrNotImplemented is returned when a feature is not yet implemented.\nvar ErrNotImplemented = errors.New(\"not implemented\")\n\n// IncrementalTypeTaskStart is the incremental type for the starting checkpoint\n// created during PreToolUse[Task] hook before a subagent begins execution.\nconst IncrementalTypeTaskStart = \"TaskStart\"\n\n// ShadowBranchConflictError is returned when a shadow branch already exists\n// with activity from a different session or worktree.\ntype ShadowBranchConflictError struct {\n\tBranch           string    // The shadow branch name (e.g., \"entire/abc1234\")\n\tExistingSession  string    // Session ID of the existing session\n\tExistingWorktree string    // Worktree path of the existing session\n\tLastActivity     time.Time // When the existing session was last active\n\tCurrentSession   string    // Session ID of the current session attempting to start\n\tCurrentWorktree  string    // Worktree path of the current session\n}\n\nfunc (e *ShadowBranchConflictError) Error() string {\n\treturn \"shadow branch conflict: existing session from different worktree\"\n}\n\n// SessionIDConflictError is returned when trying to start a new session\n// but the shadow branch already has commits from a different session ID.\n// This prevents orphaning existing session work.\ntype SessionIDConflictError struct {\n\tExistingSession string // Session ID found in the shadow branch\n\tNewSession      string // Session ID being initialized\n\tShadowBranch    string // The shadow branch name (e.g., \"entire/abc1234\")\n}\n\nfunc (e *SessionIDConflictError) Error() string {\n\treturn \"session ID conflict: shadow branch has commits from a different session\"\n}\n\n// ExtractToolUseIDFromTaskMetadataDir extracts the ToolUseID from a task metadata directory path.\n// Task metadata dirs have format: .entire/metadata/<session>/tasks/<toolUseID>\n// Returns empty string if not a task metadata directory.\nfunc ExtractToolUseIDFromTaskMetadataDir(metadataDir string) string {\n\tparts := strings.Split(metadataDir, \"/\")\n\tif len(parts) >= 2 && parts[len(parts)-2] == \"tasks\" {\n\t\treturn parts[len(parts)-1]\n\t}\n\treturn \"\"\n}\n\n// SessionInfo contains information about the current session state.\n// This is used to generate trailers for linking commits to their AI session.\ntype SessionInfo struct {\n\t// SessionID is the session identifier extracted from the latest commit's metadata\n\tSessionID string\n\n\t// Reference is a strategy-specific reference string.\n\t// For manual-commit strategy: \"entire/abc1234\" (the shadow branch name)\n\t// Empty for commit strategy (metadata is in the same commit).\n\tReference string\n\n\t// CommitHash is the full SHA of the commit containing the session metadata.\n\t// Empty for commit strategy.\n\tCommitHash string\n}\n\n// RewindPoint represents a point to which the user can rewind.\n// This abstraction allows different strategies to use different\n// identifiers (commit hashes, branch names, stash refs, etc.)\ntype RewindPoint struct {\n\t// ID is the unique identifier for this rewind point\n\t// (commit hash, branch name, stash ref, etc.)\n\tID string\n\n\t// Message is the human-readable description/summary\n\tMessage string\n\n\t// MetadataDir is the path to the metadata directory\n\tMetadataDir string\n\n\t// Date is when this rewind point was created\n\tDate time.Time\n\n\t// IsTaskCheckpoint indicates if this is a task checkpoint (vs a session checkpoint)\n\tIsTaskCheckpoint bool\n\n\t// ToolUseID is the tool use ID for task checkpoints (empty for session checkpoints)\n\tToolUseID string\n\n\t// IsLogsOnly indicates this is a commit with session logs but no shadow branch state.\n\t// The logs can be restored from entire/sessions, but file state requires git checkout.\n\tIsLogsOnly bool\n\n\t// CheckpointID is the stable 12-hex-char identifier for logs-only points.\n\t// Used to retrieve logs from entire/sessions/<id[:2]>/<id[2:]>/full.jsonl\n\tCheckpointID string\n\n\t// Agent is the human-readable name of the agent that created this checkpoint\n\t// (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string\n\n\t// SessionID is the session identifier for this checkpoint.\n\t// Used to distinguish checkpoints from different concurrent sessions.\n\tSessionID string\n\n\t// SessionPrompt is the initial prompt that started this session.\n\t// Used to help users identify which session a checkpoint belongs to.\n\tSessionPrompt string\n\n\t// SessionCount is the number of sessions in this checkpoint (1 for single-session).\n\t// Only populated for logs-only points with multi-session checkpoints.\n\tSessionCount int\n\n\t// SessionIDs contains all session IDs when this is a multi-session checkpoint.\n\t// The last entry is the most recent session (same as SessionID).\n\t// Only populated for logs-only points with multi-session checkpoints.\n\tSessionIDs []string\n\n\t// SessionPrompts contains the first prompt for each session (parallel to SessionIDs).\n\t// Used to display context when showing resume commands for multi-session checkpoints.\n\tSessionPrompts []string\n}\n\n// RewindPreview describes what will happen when rewinding to a checkpoint.\n// Used to warn users about files that will be modified or deleted.\ntype RewindPreview struct {\n\t// FilesToRestore are files from the checkpoint that will be written/restored.\n\tFilesToRestore []string\n\n\t// FilesToDelete are untracked files that will be removed.\n\t// These are files created after the checkpoint that aren't in the checkpoint tree\n\t// and weren't present at session start.\n\tFilesToDelete []string\n\n\t// TrackedChanges are tracked files with uncommitted changes that will be reverted.\n\t// These come from the existing CanRewind() warning.\n\tTrackedChanges []string\n}\n\n// SaveContext contains all information needed for saving changes.\n// All file paths should be pre-filtered and normalized by the CLI layer.\ntype SaveContext struct {\n\t// SessionID is the Claude Code session identifier\n\tSessionID string\n\n\t// ModifiedFiles is the list of files modified during the session\n\t// (extracted from the transcript, already filtered and relative)\n\tModifiedFiles []string\n\n\t// NewFiles is the list of new files created during the session\n\t// (pre-computed by CLI from pre-prompt state comparison)\n\tNewFiles []string\n\n\t// DeletedFiles is the list of files deleted during the session\n\t// (tracked files that no longer exist)\n\tDeletedFiles []string\n\n\t// MetadataDir is the path to the session metadata directory\n\tMetadataDir string\n\n\t// MetadataDirAbs is the absolute path to the session metadata directory\n\tMetadataDirAbs string\n\n\t// CommitMessage is the generated commit message\n\tCommitMessage string\n\n\t// TranscriptPath is the path to the transcript file\n\tTranscriptPath string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// AgentType is the human-readable agent name (e.g., \"Claude Code\", \"Cursor\")\n\tAgentType string\n\n\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n\tTranscriptUUIDAtStart  string // Last UUID when checkpoint started\n\tTranscriptLinesAtStart int    // Line count when checkpoint started\n\n\t// TokenUsage contains the token usage for this checkpoint\n\tTokenUsage *checkpoint.TokenUsage\n}\n\n// TaskCheckpointContext contains all information needed for saving a task checkpoint.\n// This is called by the PostToolUse[Task] hook when a subagent completes.\n// The strategy is responsible for creating metadata structures and storing them\n// according to its storage approach.\ntype TaskCheckpointContext struct {\n\t// SessionID is the Claude Code session identifier\n\tSessionID string\n\n\t// ToolUseID is the unique identifier for this Task tool invocation\n\tToolUseID string\n\n\t// AgentID is the subagent identifier (from tool_response.agentId)\n\tAgentID string\n\n\t// ModifiedFiles is the list of files modified by the subagent\n\t// (extracted from the subagent's transcript)\n\tModifiedFiles []string\n\n\t// NewFiles is the list of new files created by the subagent\n\t// (computed from pre-task state comparison)\n\tNewFiles []string\n\n\t// DeletedFiles is the list of files deleted by the subagent\n\tDeletedFiles []string\n\n\t// TranscriptPath is the path to the main session transcript\n\tTranscriptPath string\n\n\t// SubagentTranscriptPath is the path to the subagent's transcript (if available)\n\tSubagentTranscriptPath string\n\n\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n\tCheckpointUUID string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsIncremental indicates this is an incremental checkpoint during task execution,\n\t// not a final task completion checkpoint. When true:\n\t// - Writes to checkpoints/NNN-{tool-use-id}.json instead of checkpoint.json\n\t// - Skips transcript handling\n\t// - Uses incremental commit message\n\tIsIncremental bool\n\n\t// IncrementalSequence is the checkpoint sequence number (1, 2, 3, ...)\n\t// Only used when IsIncremental is true\n\tIncrementalSequence int\n\n\t// IncrementalType is the tool that triggered this checkpoint (\"TodoWrite\", \"Edit\", etc.)\n\t// Only used when IsIncremental is true\n\tIncrementalType string\n\n\t// IncrementalData is the tool_input payload for this checkpoint\n\t// Only used when IsIncremental is true\n\tIncrementalData json.RawMessage\n\n\t// SubagentType is the type of subagent (e.g., \"dev\", \"reviewer\")\n\t// Extracted from tool_input.subagent_type in Task tool\n\t// Used for descriptive commit messages\n\tSubagentType string\n\n\t// TaskDescription is the task description provided to the subagent\n\t// Extracted from tool_input.description in Task tool\n\t// Used for descriptive commit messages\n\tTaskDescription string\n\n\t// TodoContent is the content of the in-progress todo item\n\t// Extracted from tool_input.todos where status == \"in_progress\"\n\t// Used for descriptive incremental checkpoint messages\n\tTodoContent string\n\n\t// AgentType is the human-readable agent name (e.g., \"Claude Code\", \"Cursor\")\n\tAgentType string\n}\n\n// TaskCheckpoint contains the checkpoint information written to checkpoint.json\ntype TaskCheckpoint struct {\n\tSessionID      string `json:\"session_id\"`\n\tToolUseID      string `json:\"tool_use_id\"`\n\tCheckpointUUID string `json:\"checkpoint_uuid\"`\n\tAgentID        string `json:\"agent_id,omitempty\"`\n}\n\n// SubagentCheckpoint represents an intermediate checkpoint created during subagent execution.\n// These are created by PostToolUse hooks for tools like TodoWrite, Edit, Write.\ntype SubagentCheckpoint struct {\n\tType      string          `json:\"type\"`        // Tool name: \"TodoWrite\", \"Edit\", \"Write\"\n\tToolUseID string          `json:\"tool_use_id\"` // The tool use ID that created this checkpoint\n\tTimestamp time.Time       `json:\"timestamp\"`   // When the checkpoint was created\n\tData      json.RawMessage `json:\"data\"`        // Type-specific payload (tool_input)\n}\n\n// TaskMetadataDir returns the path to a task's metadata directory\n// within the session metadata directory.\nfunc TaskMetadataDir(sessionMetadataDir, toolUseID string) string {\n\treturn sessionMetadataDir + \"/tasks/\" + toolUseID\n}\n\n// ReadTaskCheckpoint reads the checkpoint.json file from a task metadata directory.\n// This is used during rewind to get the checkpoint UUID for transcript truncation.\nfunc ReadTaskCheckpoint(taskMetadataDir string) (*TaskCheckpoint, error) {\n\tcheckpointFile := taskMetadataDir + \"/checkpoint.json\"\n\n\tdata, err := os.ReadFile(checkpointFile) //nolint:gosec // Reading from controlled git metadata path\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tvar checkpoint TaskCheckpoint\n\tif err := json.Unmarshal(data, &checkpoint); err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn &checkpoint, nil\n}\n\n// Strategy defines the interface for git operation strategies.\n// Different implementations can use commits, branches, stashes, etc.\n//\n// Note: State capture (tracking untracked files before a session) is handled\n// by the CLI layer, not the strategy. The strategy receives pre-computed\n// file lists in SaveContext.\ntype Strategy interface {\n\t// Name returns the strategy identifier (e.g., \"commit\", \"branch\", \"stash\")\n\tName() string\n\n\t// Description returns a human-readable description for the setup wizard\n\tDescription() string\n\n\t// AllowsMainBranch returns true if this strategy can safely operate on the\n\t// default branch (main/master). Strategies that don't modify the working\n\t// branch's commit history (like manual-commit strategies) can return true.\n\t// Strategies that create commits on the working branch should return false\n\t// to prevent polluting main branch history.\n\tAllowsMainBranch() bool\n\n\t// ValidateRepository checks if the repository is in a valid state\n\t// for this strategy to operate. Returns an error if validation fails.\n\tValidateRepository() error\n\n\t// SaveChanges is called on Stop to save all session changes\n\t// using this strategy's approach (commit, branch, stash, etc.)\n\tSaveChanges(ctx SaveContext) error\n\n\t// SaveTaskCheckpoint is called by PostToolUse[Task] hook when a subagent completes.\n\t// Creates a checkpoint commit with task metadata for later rewind.\n\t// Different strategies may handle this differently:\n\t// - Commit strategy: commits to active branch\n\t// - Manual-commit strategy: commits to shadow branch\n\t// - Auto-commit strategy: commits logs to shadow only (code deferred to Stop)\n\tSaveTaskCheckpoint(ctx TaskCheckpointContext) error\n\n\t// GetRewindPoints returns available points to rewind to.\n\t// The limit parameter controls the maximum number of points to return.\n\tGetRewindPoints(limit int) ([]RewindPoint, error)\n\n\t// Rewind restores the repository to the given rewind point.\n\t// The metadataDir in the point is used to restore the session transcript.\n\tRewind(point RewindPoint) error\n\n\t// CanRewind checks if rewinding is currently possible.\n\t// Returns (canRewind, reason if not, error)\n\tCanRewind() (bool, string, error)\n\n\t// PreviewRewind returns what will happen if rewinding to the given point.\n\t// This allows showing warnings about files that will be deleted before the rewind.\n\t// Returns nil if preview is not supported (e.g., auto-commit strategy).\n\tPreviewRewind(point RewindPoint) (*RewindPreview, error)\n\n\t// GetSessionLog returns the raw session log (full.log) and session ID for a given commit.\n\t// Returns ErrNoMetadata if the commit doesn't have an Entire metadata trailer.\n\t// The session ID is extracted from the commit trailers or metadata directory.\n\tGetSessionLog(checkpointID string) (logContent []byte, sessionID string, err error)\n\n\t// GetTaskCheckpoint returns the task checkpoint for a given rewind point.\n\t// For strategies that store checkpoints in git (auto-commit), this reads from the branch.\n\t// For strategies that store checkpoints on disk (commit, manual-commit), this reads from the filesystem.\n\t// Returns nil, nil if not a task checkpoint or checkpoint not found.\n\tGetTaskCheckpoint(point RewindPoint) (*TaskCheckpoint, error)\n\n\t// GetTaskCheckpointTranscript returns the session transcript for a task checkpoint.\n\t// For strategies that store transcripts in git (auto-commit), this reads from the branch.\n\t// For strategies that store transcripts on disk (commit, manual-commit), this reads from the filesystem.\n\tGetTaskCheckpointTranscript(point RewindPoint) ([]byte, error)\n\n\t// GetSessionInfo returns session information for linking commits.\n\t// This is used by the context command to generate trailers.\n\t// Returns ErrNoSession if no session info is available.\n\tGetSessionInfo() (*SessionInfo, error)\n\n\t// EnsureSetup ensures the strategy's required setup is in place,\n\t// installing any missing pieces (git hooks, gitignore entries, etc.).\n\t// Returns nil if setup is complete or was successfully installed.\n\tEnsureSetup() error\n\n\t// NOTE: ListSessions and GetSession are standalone functions in session.go.\n\t// They read from entire/sessions and merge with SessionSource if implemented.\n\n\t// GetMetadataRef returns a reference to the metadata commit for the given checkpoint.\n\t// Format: \"<branch>@<commit-sha>\" (e.g., \"entire/sessions@abc123\").\n\t// Returns empty string if not applicable (e.g., commit strategy with filesystem metadata).\n\tGetMetadataRef(checkpoint Checkpoint) string\n\n\t// GetSessionMetadataRef returns a reference to the most recent metadata commit for a session.\n\t// Format: \"<branch>@<commit-sha>\" (e.g., \"entire/sessions@abc123\").\n\t// Returns empty string if not applicable or session not found.\n\tGetSessionMetadataRef(sessionID string) string\n\n\t// GetSessionContext returns the context.md content for a session.\n\t// Returns empty string if not available.\n\tGetSessionContext(sessionID string) string\n\n\t// GetCheckpointLog returns the session transcript for a specific checkpoint.\n\t// For strategies that store transcripts in git branches (auto-commit, manual-commit),\n\t// this reads from the checkpoint's commit tree.\n\t// For strategies that store on disk (commit), reads from the filesystem.\n\t// Returns ErrNoMetadata if transcript is not available.\n\tGetCheckpointLog(checkpoint Checkpoint) ([]byte, error)\n}\n\n// SessionInitializer is an optional interface for strategies that need to\n// initialize session state when a user prompt is submitted.\n// Strategies like manual-commit use this to create session state files that\n// the git prepare-commit-msg hook can detect.\ntype SessionInitializer interface {\n\t// InitializeSession creates session state for a new session.\n\t// Called during UserPromptSubmit hook before any checkpoints are created.\n\t// agentType is the human-readable name of the agent (e.g., \"Claude Code\").\n\tInitializeSession(sessionID string, agentType string) error\n}\n\n// PrepareCommitMsgHandler is an optional interface for strategies that need to\n// handle the git prepare-commit-msg hook.\ntype PrepareCommitMsgHandler interface {\n\t// PrepareCommitMsg is called by the git prepare-commit-msg hook.\n\t// It can modify the commit message file to add trailers, etc.\n\t// The source parameter indicates how the commit was initiated:\n\t//   - \"\" or \"template\": normal editor flow\n\t//   - \"message\": using -m or -F flag\n\t//   - \"merge\": merge commit\n\t//   - \"squash\": squash merge\n\t//   - \"commit\": amend with -c/-C\n\t// Should return nil on errors to not block commits (log warnings to stderr).\n\tPrepareCommitMsg(commitMsgFile string, source string) error\n}\n\n// PostCommitHandler is an optional interface for strategies that need to\n// handle the git post-commit hook.\ntype PostCommitHandler interface {\n\t// PostCommit is called by the git post-commit hook after a commit is created.\n\t// Used to perform actions like condensing session data after commits.\n\t// Should return nil on errors to not block subsequent operations (log warnings to stderr).\n\tPostCommit() error\n}\n\n// CommitMsgHandler is an optional interface for strategies that need to\n// handle the git commit-msg hook.\ntype CommitMsgHandler interface {\n\t// CommitMsg is called by the git commit-msg hook after the user edits the message.\n\t// Used to validate or modify the final commit message before the commit is created.\n\t// If this returns an error, the commit is aborted.\n\tCommitMsg(commitMsgFile string) error\n}\n\n// PrePushHandler is an optional interface for strategies that need to\n// handle the git pre-push hook.\ntype PrePushHandler interface {\n\t// PrePush is called by the git pre-push hook before pushing to a remote.\n\t// Used to push session branches (e.g., entire/sessions) alongside user pushes.\n\t// The remote parameter is the name of the remote being pushed to.\n\t// Should return nil on errors to not block pushes (log warnings to stderr).\n\tPrePush(remote string) error\n}\n\n// LogsOnlyRestorer is an optional interface for strategies that support\n// restoring session logs without file state restoration.\n// This is used for \"logs-only\" rewind points where only the session transcript\n// can be restored (file state requires git checkout).\ntype LogsOnlyRestorer interface {\n\t// RestoreLogsOnly restores session logs from a logs-only rewind point.\n\t// Does not modify the working directory - only restores the transcript\n\t// to Claude's project directory.\n\t// If force is false, prompts for confirmation when local logs have newer timestamps.\n\tRestoreLogsOnly(point RewindPoint, force bool) error\n}\n\n// SessionResetter is an optional interface for strategies that support\n// resetting session state and shadow branches.\n// This is used by the \"rewind reset\" command to clean up shadow branches\n// and session state when a user wants to start fresh.\ntype SessionResetter interface {\n\t// Reset deletes the shadow branch and session state for the current HEAD.\n\t// Returns nil if there's nothing to reset (no shadow branch).\n\t// The force parameter suppresses confirmation prompts.\n\tReset(force bool) error\n}\n\n// ConcurrentSessionChecker is an optional interface for strategies that support\n// detecting and warning about concurrent sessions with uncommitted changes.\n// This is used by the UserPromptSubmit hook to block the first prompt when\n// another session has uncommitted checkpoints on the same base commit.\ntype ConcurrentSessionChecker interface {\n\t// HasOtherActiveSessionsWithCheckpoints returns a session state if there's another\n\t// active session with uncommitted checkpoints on the same base commit.\n\t// Returns nil, nil if no such session exists.\n\tHasOtherActiveSessionsWithCheckpoints(currentSessionID string) (*SessionState, error)\n}\n\n// SessionSource is an optional interface for strategies that provide additional\n// sessions beyond those stored on the entire/sessions branch.\n// For example, manual-commit strategy provides active sessions from .git/entire-sessions/\n// that haven't yet been condensed to entire/sessions.\n//\n// ListSessions() automatically discovers all registered strategies, checks if they\n// implement SessionSource, and merges their additional sessions by ID.\ntype SessionSource interface {\n\t// GetAdditionalSessions returns sessions not yet on entire/sessions branch.\n\tGetAdditionalSessions() ([]*Session, error)\n}\n\n// OrphanedItemsLister is an optional interface for strategies that can identify\n// orphaned items (shadow branches, session states, checkpoints) that should be\n// cleaned up. This is used by the \"entire session cleanup\" command.\n//\n// ListAllCleanupItems() automatically discovers all registered strategies, checks\n// if they implement OrphanedItemsLister, and combines their orphaned items.\ntype OrphanedItemsLister interface {\n\t// ListOrphanedItems returns items created by this strategy that are now orphaned.\n\t/