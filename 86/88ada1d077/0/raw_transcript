  24→// isNotFoundError checks if an error represents a \"not found\" condition in go-git.\n    25→// This includes entry not found, file not found, directory not found, and object not found.\n    26→func isNotFoundError(err error) bool {\n    27→\treturn errors.Is(err, object.ErrEntryNotFound) ||\n    28→\t\terrors.Is(err, object.ErrFileNotFound) ||\n    29→\t\terrors.Is(err, object.ErrDirectoryNotFound) ||\n    30→\t\terrors.Is(err, plumbing.ErrObjectNotFound) ||\n    31→\t\terrors.Is(err, plumbing.ErrReferenceNotFound)\n    32→}\n    33→\n    34→// commitOrHead attempts to create a commit. If the commit would be empty (files already\n    35→// committed), it returns HEAD hash instead. This handles the case where files were\n    36→// modified during a session but already committed by the user before the hook runs.\n    37→func commitOrHead(repo *git.Repository, worktree *git.Worktree, msg string, author *object.Signature) (plumbing.Hash, error) {\n    38→\tcommitHash, err := worktree.Commit(msg, &git.CommitOptions{Author: author})\n    39→\tif errors.Is(err, git.ErrEmptyCommit) {\n    40→\t\tfmt.Fprintf(os.Stderr, \"No changes to commit (files already committed)\\n\")\n    41→\t\thead, err := repo.Head()\n    42→\t\tif err != nil {\n    43→\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get HEAD: %w\", err)\n    44→\t\t}\n    45→\t\treturn head.Hash(), nil\n    46→\t}\n    47→\tif err != nil {\n    48→\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to commit: %w\", err)\n    49→\t}\n    50→\treturn commitHash, nil\n    51→}\n    52→\n    53→// AutoCommitStrategy implements the auto-commit strategy:\n    54→// - Code changes are committed to the active branch (like commit strategy)\n    55→// - Session logs are committed to a shadow branch (like manual-commit strategy)\n    56→// - Code commits can reference the shadow branch via trailers\n    57→type AutoCommitStrategy struct {\n    58→\t// checkpointStore manages checkpoint data on entire/sessions branc