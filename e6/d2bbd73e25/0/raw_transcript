ontain no Entire data message\")\n   468→\t}\n   469→}\n   470→\n   471→func TestFormatCommitInfo_WithEntireData(t *testing.T) {\n   472→\tnow := time.Now()\n   473→\tinfo := &commitInfo{\n   474→\t\tSHA:       \"abc1234567890abcdef1234567890abcdef123456\",\n   475→\t\tShortSHA:  \"abc1234\",\n   476→\t\tMessage:   \"Test commit message\",\n   477→\t\tAuthor:    \"Test Author\",\n   478→\t\tEmail:     \"test@example.com\",\n   479→\t\tDate:      now,\n   480→\t\tFiles:     []string{\"file1.go\"},\n   481→\t\tHasEntire: true,\n   482→\t\tSessionID: \"2025-12-09-test-session\",\n   483→\t}\n   484→\n   485→\toutput := formatCommitInfo(info)\n   486→\n   487→\t// Verify output contains expected sections\n   488→\tif !strings.Contains(output, \"Session:\") {\n   489→\t\tt.Error(\"expected output to contain 'Session:'\")\n   490→\t}\n   491→\tif !strings.Contains(output, info.SessionID) {\n   492→\t\tt.Error(\"expected output to contain session ID\")\n   493→\t}\n   494→\tif strings.Contains(output, \"No Entire session data\") {\n   495→\t\tt.Error(\"expected output to NOT contain no Entire data message\")\n   496→\t}\n   497→}\n   498→\n   499→// Helper to verify common session functions work with SessionSource interface\n   500→func TestStrategySessionSourceInterface(t *testing.T) {\n   501→\t// This ensures manual-commit strategy implements SessionSource\n   502→\tvar s = strategy.NewManualCommitStrategy()\n   503→\n   504→\t// Cast to SessionSource - manual-commit strategy should implement it\n   505→\tsource, ok := s.(strategy.SessionSource)\n   506→\tif !ok {\n   507→\t\tt.Fatal(\"ManualCommitStrategy should implement SessionSource interface\")\n   508→\t}\n   509→\n   510→\t// GetAdditionalSessions should exist and be callable\n   511→\t_, err := source.GetAdditionalSessions()\n   512→\tif err != nil {\n   513→\t\tt.Logf(\"GetAdditionalSessions returned error: %v\", err)\n   514→\t}\n   515→}\n   516→\n   517→func TestFormatSessionInfo_CheckpointNumberingReversed(