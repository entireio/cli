ool_result","content":"     1→// Package checkpoint provides types and interfaces for checkpoint storage.\n     2→//\n     3→// A Checkpoint captures a point-in-time within a session, containing either\n     4→// full state (Temporary) or metadata with a commit reference (Committed).\n     5→//\n     6→// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\n     7→package checkpoint\n     8→\n     9→import (\n    10→\t\"context\"\n    11→\t\"time\"\n    12→\n    13→\t\"github.com/go-git/go-git/v5/plumbing\"\n    14→)\n    15→\n    16→// Checkpoint represents a save point within a session.\n    17→type Checkpoint struct {\n    18→\t// ID is the unique checkpoint identifier\n    19→\tID string\n    20→\n    21→\t// SessionID is the session this checkpoint belongs to\n    22→\tSessionID string\n    23→\n    24→\t// Timestamp is when this checkpoint was created\n    25→\tTimestamp time.Time\n    26→\n    27→\t// Type indicates temporary (full state) or committed (metadata only)\n    28→\tType Type\n    29→\n    30→\t// Message is a human-readable description of the checkpoint\n    31→\tMessage string\n    32→}\n    33→\n    34→// Type indicates the storage location and lifecycle of a checkpoint.\n    35→type Type int\n    36→\n    37→const (\n    38→\t// Temporary checkpoints contain full state (code + metadata) and are stored\n    39→\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n    40→\tTemporary Type = iota\n    41→\n    42→\t// Committed checkpoints contain metadata + commit reference and are stored\n    43→\t// on the entire/sessions branch. They are the permanent record.\n    44→\tCommitted\n    45→)\n    46→\n    47→// Store provides low-level primitives for reading and writing checkpoints.\n    48→// This is used by strategies to implement their storage approach.\n    49→//\n    50→// The interface matches the GitStore implementation signatures directly:\n    51→// - WriteTemporary takes WriteTemporaryOptions and returns the commit hash\n    52→// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n    53→// - List methods return implementation-specific info types for richer data\n    54→type Store interface {\n    55→\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n    56→\t// Shadow branches are named entire/<base-commit-short-hash>.\n    57→\t// Returns the commit hash of the created checkpoint.\n    58→\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (plumbing.Hash, error)\n    59→\n    60→\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n    61→\t// baseCommit is the commit hash the session is based on.\n    62→\t// Returns nil, nil if the shadow branch doesn't exist.\n    63→\tReadTemporary(ctx context.Context, baseCommit string) (*ReadTemporaryResult, error)\n    64→\n    65→\t// ListTemporary lists all shadow branches with their checkpoint info.\n    66→\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n    67→\n    68→\t// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n    69→\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n    70→\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n    71→\n    72→\t// ReadCommitted reads a committed checkpoint by ID.\n    73→\t// Returns nil, nil if the checkpoint does not exist.\n    74→\tReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error)\n    75→\n    76→\t// ListCommitted lists all committed checkpoints.\n    77→\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n    78→}\n    79→\n    80→// WriteTemporaryOptions contains options for writing a temporary checkpoint.\n    81→type WriteTemporaryOptions struct {\n    82→\t// SessionID is the session identifier\n    83→\tSessionID string\n    84→\n    85→\t// BaseCommit is the commit hash this session is based on\n    86→\tBaseCommit string\n    87→\n    88→\t// ModifiedFiles are files that have been modified (relative paths)\n    89→\tModifiedFiles []string\n    90→\n    91→\t// NewFiles are files that have been created (relative paths)\n    92→\tNewFiles []string\n    93→\n    94→\t// DeletedFiles are files that have been deleted (relative paths)\n    95→\tDeletedFiles []string\n    96→\n    97→\t// MetadataDir is the relative path to the metadata directory\n    98→\tMetadataDir string\n    99→\n   100→\t// MetadataDirAbs is the absolute path to the metadata directory\n   101→\tMetadataDirAbs string\n   102→\n   103→\t// CommitMessage is the commit subject line\n   104→\tCommitMessage string\n   105→\n   106→\t// AuthorName is the name to use for commits\n   107→\tAuthorName string\n   108→\n   109→\t// AuthorEmail is the email to use for commits\n   110→\tAuthorEmail string\n   111→\n   112→\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n   113→\t// When true, all working directory files are captured (not just modified)\n   114→\tIsFirstCheckpoint bool\n   115→}\n   116→\n   117→// ReadTemporaryResult contains the result of reading a temporary checkpoint.\n   118→type ReadTemporaryResult struct {\n   119→\t// CommitHash is the hash of the checkpoint commit\n   120→\tCommitHash plumbing.Hash\n   121→\n   122→\t// TreeHash is the hash of the tree containing the checkpoint state\n   123→\tTreeHash plumbing.Hash\n   124→\n   125→\t// SessionID is the session identifier from the commit trailer\n   126→\tSessionID string\n   127→\n   128→\t// MetadataDir is the metadata directory path from the commit trailer\n   129→\tMetadataDir string\n   130→\n   131→\t// Timestamp is when the checkpoint was created\n   132→\tTimestamp time.Time\n   133→}\n   134→\n   135→// TemporaryInfo contains summary information about a shadow branch.\n   136→type TemporaryInfo struct {\n   137→\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n   138→\tBranchName string\n   139→\n   140→\t// BaseCommit is the short commit hash this branch is based on\n   141→\tBaseCommit string\n   142→\n   143→\t// LatestCommit is the hash of the latest commit on the branch\n   144→\tLatestCommit plumbing.Hash\n   145→\n   146→\t// SessionID is the session identifier from the latest commit\n   147→\tSessionID string\n   148→\n   149→\t// Timestamp is when the latest checkpoint was created\n   150→\tTimestamp time.Time\n   151→}\n   152→\n   153→// WriteCommittedOptions contains options for writing a committed checkpoint.\n   154→type WriteCommittedOptions struct {\n   155→\t// CheckpointID is the stable 12-hex-char identifier\n   156→\tCheckpointID string\n   157→\n   158→\t// SessionID is the session identifier\n   159→\tSessionID string\n   160→\n   161→\t// Strategy is the name of the strategy that created this checkpoint\n   162→\tStrategy string\n   163→\n   164→\t// Transcript is the session transcript content (full.jsonl)\n   165→\tTranscript []byte\n   166→\n   167→\t// Prompts contains user prompts from the session\n   168→\tPrompts []string\n   169→\n   170→\t// Context is the generated context.md content\n   171→\tContext []byte\n   172→\n   173→\t// FilesTouched are files modified during the session\n   174→\tFilesTouched []string\n   175→\n   176→\t// CheckpointsCount is the number of checkpoints in this session\n   177→\tCheckpointsCount int\n   178→\n   179→\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n   180→\tEphemeralBranch string\n   181→\n   182→\t// AuthorName is the name to use for commits\n   183→\tAuthorName string\n   184→\n   185→\t// AuthorEmail is the email to use for commits\n   186→\tAuthorEmail string\n   187→\n   188→\t// MetadataDir is a directory containing additional metadata files to copy\n   189→\t// If set, all files in this directory will be copied to the checkpoint path\n   190→\t// This is useful for copying task metadata files, subagent transcripts, etc.\n   191→\tMetadataDir string\n   192→\n   193→\t// Task checkpoint fields (for auto-commit strategy task checkpoints)\n   194→\tIsTask    bool   // Whether this is a task checkpoint\n   195→\tToolUseID string // Tool use ID for task checkpoints\n   196→\n   197→\t// Additional task checkpoint fields for subagent checkpoints\n   198→\tAgentID                string // Subagent identifier\n   199→\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n   200→\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n   201→\tSubagentTranscriptPath string // Path to subagent's transcript file\n   202→\n   203→\t// Incremental checkpoint fields\n   204→\tIsIncremental       bool   // Whether this is an incremental checkpoint\n   205→\tIncrementalSequence int    // Checkpoint sequence number\n   206→\tIncrementalType     string // Tool type that triggered this checkpoint\n   207→\tIncrementalData     []byte // Tool input payload for this checkpoint\n   208→\n   209→\t// Commit message fields (used for task checkpoints)\n   210→\tCommitSubject string // Subject line for the metadata commit (overrides default)\n   211→\n   212→\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n   213→\tAgent string\n   214→}\n   215→\n   216→// ReadCommittedResult contains the result of reading a committed checkpoint.\n   217→type ReadCommittedResult struct {\n   218→\t// Metadata contains the checkpoint metadata\n   219→\tMetadata CommittedMetadata\n   220→\n   221→\t// Transcript is the session transcript content (most recent session)\n   222→\tTranscript []byte\n   223→\n   224→\t// Prompts contains user prompts (most recent session)\n   225→\tPrompts string\n   226→\n   227→\t// Context is the context.md content\n   228→\tContext string\n   229→\n   230→\t// ArchivedSessions contains transcripts from previous sessions when multiple\n   231→\t// sessions were condensed to the same checkpoint. Ordered from oldest to newest\n   232→\t// (1/, 2/, etc.). The root-level Transcript is the most recent session.\n   233→\tArchivedSessions []ArchivedSession\n   234→}\n   235→\n   236→// ArchivedSession contains transcript data from a previous session\n   237→// that was archived when multiple sessions contributed to the same checkpoint.\n   238→type ArchivedSession struct {\n   239→\t// SessionID is the session identifier for this archived session\n   240→\tSessionID string\n   241→\n   242→\t// Transcript is the session transcript content\n   243→\tTranscript []byte\n   244→\n   245→\t// Prompts contains user prompts from this session\n   246→\tPrompts string\n   247→\n   248→\t// FolderIndex is the archive folder number (1, 2, etc.)\n   249→\tFolderIndex int\n   250→}\n   251→\n   252→// CommittedInfo contains summary information about a committed checkpoint.\n   253→type CommittedInfo struct {\n   254→\t// CheckpointID is the stable 12-hex-char identifier\n   255→\tCheckpointID string\n   256→\n   257→\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n   258→\tSessionID string\n   259→\n   260→\t// CreatedAt is when the checkpoint was created\n   261→\tCreatedAt time.Time\n   262→\n   263→\t// CheckpointsCount is the total number of checkpoints across all sessions\n   264→\tCheckpointsCount int\n   265→\n   266→\t// FilesTouched are files modified during all sessions\n   267→\tFilesTouched []string\n   268→\n   269→\t// Agent identifies the agent that created this checkpoint\n   270→\tAgent string\n   271→\n   272→\t// IsTask indicates if this is a task checkpoint\n   273→\tIsTask bool\n   274→\n   275→\t// ToolUseID is the tool use ID for task checkpoints\n   276→\tToolUseID string\n   277→\n   278→\t// Multi-session support\n   279→\tSessionCount int      // Number of sessions (1 if single session)\n   280→\tSessionIDs   []string // All session IDs that contributed\n   281→}\n   282→\n   283→// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\n   284→type CommittedMetadata struct {\n   285→\tCheckpointID     string    `json:\"checkpoint_id\"`\n   286→\tSessionID        string    `json:\"session_id\"`\n   287→\tStrategy         string    `json:\"strategy\"`\n   288→\tCreatedAt        time.Time `json:\"created_at\"`\n   289→\tCheckpointsCount int       `json:\"checkpoints_count\"`\n   290→\tFilesTouched     []string  `json:\"files_touched\"`\n   291→\n   292→\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n   293→\tAgent string `json:\"agent,omitempty\"`\n   294→\n   295→\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n   296→\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n   297→\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n   298→\n   299→\t// Task checkpoint fields (only populated for task checkpoints)\n   300→\tIsTask    bool   `json:\"is_task,omitempty\"`\n   301→\tToolUseID string `json:\"tool_use_id,omitempty\"`\n   302→\n   303→\t// Summary fields for explain output (lazily generated, may be empty)\n   304→\tIntent         string   `json:\"intent,omitempty\"`          // What the user was trying to accomplish\n   305→\tOutcome        string   `json:\"outcome,omitempty\"`         // What was actually achieved\n   306→\tLearnings      []string `json:\"learnings,omitempty\"`       // Key insights discovered during the session\n   307→\tFrictionPoints []string `json:\"friction_points,omitempty\"` // Difficulties or blockers encountered\n   308→}\n   309→\n   310→// Info provides summary information for listing checkpoints.\n   311→// This is the generic checkpoint info type.\n   312→type Info struct {\n   313→\t// ID is the checkpoint identifier\n   314→\tID string\n   315→\n   316→\t// SessionID identifies the session\n   317→\tSessionID string\n   318→\n   319→\t// Type indicates temporary or committed\n   320→\tType Type\n   321→\n   322→\t// CreatedAt is when the checkpoint was created\n   323→\tCreatedAt time.Time\n   324→\n   325→\t// Message is a summary description\n   326→\tMessage string\n   327→}\n   328→\n   329→// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n   330→// Task checkpoints are created when a subagent completes and contain both\n   331→// code changes and task-specific metadata.\n   332→type WriteTemporaryTaskOptions struct {\n   333→\t// SessionID is the session identifier\n   334→\tSessionID string\n   335→\n   336→\t// BaseCommit is the commit hash this session is based on\n   337→\tBaseCommit string\n   338→\n   339→\t// ToolUseID is the unique identifier for this Task tool invocation\n   340→\tToolUseID string\n   341→\n   342→\t// AgentID is the subagent identifier\n   343→\tAgentID string\n   344→\n   345→\t// ModifiedFiles are files that have been modified (relative paths)\n   346→\tModifiedFiles []string\n   347→\n   348→\t// NewFiles are files that have been created (relative paths)\n   349→\tNewFiles []string\n   350→\n   351→\t// DeletedFiles are files that have been deleted (relative paths)\n   352→\tDeletedFiles []string\n   353→\n   354→\t// TranscriptPath is the path to the main session transcript\n   355→\tTranscriptPath string\n   356→\n   357→\t// SubagentTranscriptPath is the path to the subagent's transcript\n   358→\tSubagentTranscriptPath string\n   359→\n   360→\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n   361→\tCheckpointUUID string\n   362→\n   363→\t// CommitMessage is the commit message (already formatted)\n   364→\tCommitMessage string\n   365→\n   366→\t// AuthorName is the name to use for commits\n   367→\tAuthorName string\n   368→\n   369→\t// AuthorEmail is the email to use for commits\n   370→\tAuthorEmail string\n   371→\n   372→\t// IsIncremental indicates this is an incremental checkpoint\n   373→\tIsIncremental bool\n   374→\n   375→\t// IncrementalSequence is the checkpoint sequence number\n   376→\tIncrementalSequence int\n   377→\n   378→\t// IncrementalType is the tool that triggered this checkpoint\n   379→\tIncrementalType string\n   380→\n   381→\t// IncrementalData is the tool_input payload for this checkpoint\n   382→\tIncrementalData []byte\n   383→}\n   384→\n   385→// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n   386→// Used by ListTemporaryCheckpoints to provide rewind point data.\n   387→type TemporaryCheckpointInfo struct {\n   388→\t// CommitHash is the hash of the checkpoint commit\n   389→\tCommitHash plumbing.Hash\n   390→\n   391→\t// Message is the first line of the commit message\n   392→\tMessage string\n   393→\n   394→\t// SessionID is the session identifier from the Entire-Session trailer\n   395→\tSessionID string\n   396→\n   397→\t// MetadataDir is the metadata directory path from trailers\n   398→\tMetadataDir string\n   399→\n   400→\t// IsTaskCheckpoint indicates if this is a task checkpoint\n   401→\tIsTaskCheckpoint bool\n   402→\n   403→\t// ToolUseID is the tool use ID for task checkpoints\n   404→\tToolUseID string\n   405→\n   406→\t// Timestamp is when the checkpoint was created\n   407→\tTimestamp time.Time\n   408→}\n   409→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"ac732e13-a462-47f2-a117-f5a7bd487bfa","timestamp":"2026-01-19T23:59:18.898Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/alex/workspace/cli/cmd/entire/cli/checkpoint/checkpoint.go","content":"// Package checkpoint provides types and interfaces for checkpoint storage.\n//\n// A Checkpoint captures a point-in-time within a session, containing either\n// full state (Temporary) or metadata with a commit reference (Committed).\n//\n// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\npackage checkpoint\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/go-git/go-git/v5/plumbing\"\n)\n\n// Checkpoint represents a save point within a session.\ntype Checkpoint struct {\n\t// ID is the unique checkpoint identifier\n\tID string\n\n\t// SessionID is the session this checkpoint belongs to\n\tSessionID string\n\n\t// Timestamp is when this checkpoint was created\n\tTimestamp time.Time\n\n\t// Type indicates temporary (full state) or committed (metadata only)\n\tType Type\n\n\t// Message is a human-readable description of the checkpoint\n\tMessage string\n}\n\n// Type indicates the storage location and lifecycle of a checkpoint.\ntype Type int\n\nconst (\n\t// Temporary checkpoints contain full state (code + metadata) and are stored\n\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n\tTemporary Type = iota\n\n\t// Committed checkpoints contain metadata + commit reference and are stored\n\t// on the entire/sessions branch. They are the permanent record.\n\tCommitted\n)\n\n// Store provides low-level primitives for reading and writing checkpoints.\n// This is used by strategies to implement their storage approach.\n//\n// The interface matches the GitStore implementation signatures directly:\n// - WriteTemporary takes WriteTemporaryOptions and returns the commit hash\n// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n// - List methods return implementation-specific info types for richer data\ntype Store interface {\n\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n\t// Shadow branches are named entire/<base-commit-short-hash>.\n\t// Returns the commit hash of the created checkpoint.\n\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (plumbing.Hash, error)\n\n\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n\t// baseCommit is the commit hash the session is based on.\n\t// Returns nil, nil if the shadow branch doesn't exist.\n\tReadTemporary(ctx context.Context, baseCommit string) (*ReadTemporaryResult, error)\n\n\t// ListTemporary lists all shadow branches with their checkpoint info.\n\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n\n\t// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n\n\t// ReadCommitted reads a committed checkpoint by ID.\n\t// Returns nil, nil if the checkpoint does not exist.\n\tReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error)\n\n\t// ListCommitted lists all committed checkpoints.\n\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n}\n\n// WriteTemporaryOptions contains options for writing a temporary checkpoint.\ntype WriteTemporaryOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// MetadataDir is the relative path to the metadata directory\n\tMetadataDir string\n\n\t// MetadataDirAbs is the absolute path to the metadata directory\n\tMetadataDirAbs string\n\n\t// CommitMessage is the commit subject line\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n\t// When true, all working directory files are captured (not just modified)\n\tIsFirstCheckpoint bool\n}\n\n// ReadTemporaryResult contains the result of reading a temporary checkpoint.\ntype ReadTemporaryResult struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// TreeHash is the hash of the tree containing the checkpoint state\n\tTreeHash plumbing.Hash\n\n\t// SessionID is the session identifier from the commit trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from the commit trailer\n\tMetadataDir string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n\n// TemporaryInfo contains summary information about a shadow branch.\ntype TemporaryInfo struct {\n\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n\tBranchName string\n\n\t// BaseCommit is the short commit hash this branch is based on\n\tBaseCommit string\n\n\t// LatestCommit is the hash of the latest commit on the branch\n\tLatestCommit plumbing.Hash\n\n\t// SessionID is the session identifier from the latest commit\n\tSessionID string\n\n\t// Timestamp is when the latest checkpoint was created\n\tTimestamp time.Time\n}\n\n// WriteCommittedOptions contains options for writing a committed checkpoint.\ntype WriteCommittedOptions struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// Strategy is the name of the strategy that created this checkpoint\n\tStrategy string\n\n\t// Transcript is the session transcript content (full.jsonl)\n\tTranscript []byte\n\n\t// Prompts contains user prompts from the session\n\tPrompts []string\n\n\t// Context is the generated context.md content\n\tContext []byte\n\n\t// FilesTouched are files modified during the session\n\tFilesTouched []string\n\n\t// CheckpointsCount is the number of checkpoints in this session\n\tCheckpointsCount int\n\n\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n\tEphemeralBranch string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// MetadataDir is a directory containing additional metadata files to copy\n\t// If set, all files in this directory will be copied to the checkpoint path\n\t// This is useful for copying task metadata files, subagent transcripts, etc.\n\tMetadataDir string\n\n\t// Task checkpoint fields (for auto-commit strategy task checkpoints)\n\tIsTask    bool   // Whether this is a task checkpoint\n\tToolUseID string // Tool use ID for task checkpoints\n\n\t// Additional task checkpoint fields for subagent checkpoints\n\tAgentID                string // Subagent identifier\n\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n\tSubagentTranscriptPath string // Path to subagent's transcript file\n\n\t// Incremental checkpoint fields\n\tIsIncremental       bool   // Whether this is an incremental checkpoint\n\tIncrementalSequence int    // Checkpoint sequence number\n\tIncrementalType     string // Tool type that triggered this checkpoint\n\tIncrementalData     []byte // Tool input payload for this checkpoint\n\n\t// Commit message fields (used for task checkpoints)\n\tCommitSubject string // Subject line for the metadata commit (overrides default)\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string\n}\n\n// ReadCommittedResult contains the result of reading a committed checkpoint.\ntype ReadCommittedResult struct {\n\t// Metadata contains the checkpoint metadata\n\tMetadata CommittedMetadata\n\n\t// Transcript is the session transcript content (most recent session)\n\tTranscript []byte\n\n\t// Prompts contains user prompts (most recent session)\n\tPrompts string\n\n\t// Context is the context.md content\n\tContext string\n\n\t// ArchivedSessions contains transcripts from previous sessions when multiple\n\t// sessions were condensed to the same checkpoint. Ordered from oldest to newest\n\t// (1/, 2/, etc.). The root-level Transcript is the most recent session.\n\tArchivedSessions []ArchivedSession\n}\n\n// ArchivedSession contains transcript data from a previous session\n// that was archived when multiple sessions contributed to the same checkpoint.\ntype ArchivedSession struct {\n\t// SessionID is the session identifier for this archived session\n\tSessionID string\n\n\t// Transcript is the session transcript content\n\tTranscript []byte\n\n\t// Prompts contains user prompts from this session\n\tPrompts string\n\n\t// FolderIndex is the archive folder number (1, 2, etc.)\n\tFolderIndex int\n}\n\n// CommittedInfo contains summary information about a committed checkpoint.\ntype CommittedInfo struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n\tSessionID string\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// CheckpointsCount is the total number of checkpoints across all sessions\n\tCheckpointsCount int\n\n\t// FilesTouched are files modified during all sessions\n\tFilesTouched []string\n\n\t// Agent identifies the agent that created this checkpoint\n\tAgent string\n\n\t// IsTask indicates if this is a task checkpoint\n\tIsTask bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Multi-session support\n\tSessionCount int      // Number of sessions (1 if single session)\n\tSessionIDs   []string // All session IDs that contributed\n}\n\n// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\ntype CommittedMetadata struct {\n\tCheckpointID     string    `json:\"checkpoint_id\"`\n\tSessionID        string    `json:\"session_id\"`\n\tStrategy         string    `json:\"strategy\"`\n\tCreatedAt        time.Time `json:\"created_at\"`\n\tCheckpointsCount int       `json:\"checkpoints_count\"`\n\tFilesTouched     []string  `json:\"files_touched\"`\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string `json:\"agent,omitempty\"`\n\n\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n\n\t// Task checkpoint fields (only populated for task checkpoints)\n\tIsTask    bool   `json:\"is_task,omitempty\"`\n\tToolUseID string `json:\"tool_use_id,omitempty\"`\n\n\t// Summary fields for explain output (lazily generated, may be empty)\n\tIntent         string   `json:\"intent,omitempty\"`          // What the user was trying to accomplish\n\tOutcome        string   `json:\"outcome,omitempty\"`         // What was actually achieved\n\tLearnings      []string `json:\"learnings,omitempty\"`       // Key insights discovered during the session\n\tFrictionPoints []string `json:\"friction_points,omitempty\"` // Difficulties or blockers encountered\n}\n\n// Info provides summary information for listing checkpoints.\n// This is the generic checkpoint info type.\ntype Info struct {\n\t// ID is the checkpoint identifier\n\tID string\n\n\t// SessionID identifies the session\n\tSessionID string\n\n\t// Type indicates temporary or committed\n\tType Type\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// Message is a summary description\n\tMessage string\n}\n\n// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n// Task checkpoints are created when a subagent completes and contain both\n// code changes and task-specific metadata.\ntype WriteTemporaryTaskOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// ToolUseID is the unique identifier for this Task tool invocation\n\tToolUseID string\n\n\t// AgentID is the subagent identifier\n\tAgentID string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// TranscriptPath is the path to the main session transcript\n\tTranscriptPath string\n\n\t// SubagentTranscriptPath is the path to the subagent's transcript\n\tSubagentTranscriptPath string\n\n\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n\tCheckpointUUID string\n\n\t// CommitMessage is the commit message (already formatted)\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsIncremental indicates this is an incremental checkpoint\n\tIsIncremental bool\n\n\t// IncrementalSequence is the checkpoint sequence number\n\tIncrementalSequence int\n\n\t// IncrementalType is the tool that triggered this checkpoint\n\tIncrementalType string\n\n\t// IncrementalData is the tool_input payload for this checkpoint\n\tIncrementalData []byte\n}\n\n// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n// Used by ListTemporaryCheckpoints to provide rewind point data.\ntype TemporaryCheckpointInfo struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// Message is the first line of the commit message\n\tMessage string\n\n\t// SessionID is the session identifier from