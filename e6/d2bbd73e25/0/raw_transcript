ame\")\n   374→\t}\n   375→\tif !strings.Contains(output, \"Checkpoints: 2\") {\n   376→\t\tt.Error(\"expected output to contain 'Checkpoints: 2'\")\n   377→\t}\n   378→\t// Check checkpoint details\n   379→\tif !strings.Contains(output, \"Checkpoint 1\") {\n   380→\t\tt.Error(\"expected output to contain 'Checkpoint 1'\")\n   381→\t}\n   382→\tif !strings.Contains(output, \"## Prompt\") {\n   383→\t\tt.Error(\"expected output to contain '## Prompt'\")\n   384→\t}\n   385→\tif !strings.Contains(output, \"## Responses\") {\n   386→\t\tt.Error(\"expected output to contain '## Responses'\")\n   387→\t}\n   388→\tif !strings.Contains(output, \"Files Modified\") {\n   389→\t\tt.Error(\"expected output to contain 'Files Modified'\")\n   390→\t}\n   391→}\n   392→\n   393→func TestFormatSessionInfo_WithSourceRef(t *testing.T) {\n   394→\tnow := time.Now()\n   395→\tsession := &strategy.Session{\n   396→\t\tID:          \"2025-12-09-test-session-abc\",\n   397→\t\tDescription: \"Test description\",\n   398→\t\tStrategy:    \"auto-commit\",\n   399→\t\tStartTime:   now,\n   400→\t\tCheckpoints: []strategy.Checkpoint{\n   401→\t\t\t{\n   402→\t\t\t\tCheckpointID: \"abc1234567890\",\n   403→\t\t\t\tMessage:      \"First checkpoint\",\n   404→\t\t\t\tTimestamp:    now,\n   405→\t\t\t},\n   406→\t\t},\n   407→\t}\n   408→\n   409→\tcheckpointDetails := []checkpointDetail{\n   410→\t\t{\n   411→\t\t\tIndex:     1,\n   412→\t\t\tShortID:   \"abc1234\",\n   413→\t\t\tTimestamp: now,\n   414→\t\t\tMessage:   \"First checkpoint\",\n   415→\t\t},\n   416→\t}\n   417→\n   418→\t// Test with source ref provided\n   419→\tsourceRef := \"entire/metadata@abc123def456\"\n   420→\toutput := formatSessionInfo(session, sourceRef, checkpointDetails)\n   421→\n   422→\t// Verify source ref is displayed\n   423→\tif !strings.Contains(output, \"Source Ref:\") {\n   424→\t\tt.Error(\"expected output to contain 'Source Ref:'\")\n   425→\t}\n   426→\tif !strings.Contains(output, sourceRef) {\n   427→\t\tt.Errorf(\"expected output to contain source ref %q, got:\\n%s\", sourceRef, output)\n   428→\t}\n   429→}\n   430→\n   431→func TestFormatCommitInfo(t *testing.T) {\n   432→\tnow := time.Now()\n   433→\tinfo := &commitInfo{\n   434→\t\tSHA:       \"abc1234567890abcdef1234567890abcdef123456\",\n   435→\t\tShortSHA:  \"abc1234\",\n   436→\t\tMessage:   \"Test commit message\",\n   437→\t\tAuthor:    \"Test Author\",\n   438→\t\tEmail:     \"test@example.com\",\n   439→\t\tDate:      now,\n   440→\t\tFiles:     []string{\"file1.go\", \"file2.go\"},\n   441→\t\tHasEntire: false,\n   442→\t\tSessionID: \"\",\n   443→\t}\n   444→\n   445→\toutput := formatCommitInfo(info)\n   446→\n   447→\t// Verify output contains expected sections\n   448→\tif !strings.Contains(output, \"Commit:\") {\n   449→\t\tt.Error(\"expected output to contain 'Commit:'\")\n   450→\t}\n   451→\tif !strings.Contains(output, info.ShortSHA) {\n   452→\t\tt.Error(\"expected output to contain short SHA\")\n   453→\t}\n   454→\tif !strings.Contains(output, info.SHA) {\n   455→\t\tt.Error(\"expected output to contain full SHA\")\n   456→\t}\n   457→\tif !strings.Contains(output, \"Message:\") {\n   458→\t\tt.Error(\"expected output to contain 'Message:'\")\n   459→\t}\n   460→\tif !strings.Contains(output, info.Message) {\n   461→\t\tt.Error(\"expected output to contain commit message\")\n   462→\t}\n   463→\tif !strings.Contains(output, \"Files Modified\") {\n   464→\t\tt.Error(\"expected output to contain 'Files Modified'\")\n   465→\t}\n   466→\tif !strings.Contains(output, \"No Entire session data\") {\n   467→\t\tt.Error(\"expected output to contain no Entire data message\")\n   468→\t}\n   469→}\n   470→\n   471→func TestFormatCommitInfo_WithEntireData(t *testing.T) {\n   472→\tnow := time.Now()\n   473→\tinfo := &commitInfo{\n   474→\t\tSHA:       \"abc1234567890abcdef1234567890abcdef123456\",\n   475→\t\tShortSHA:  \"abc1234\",\n   476→\t\tMessage:   \"Test commit message\",\n   477→\t\tAuthor:    \"Test Author\",\n   478→\t\tEmail:     \"test@example.com\",\n   479→\t\tDate:      now,\n   480→\t\tFiles:     []string{\"file1.go\"},\n   481→\t\tHasEntire: true,\n   482→\t\tSessionID: \"2025-12-09-test-session\",\n   483→\t}\n   484→\n   485→\toutput := formatCommitInfo(info)\n   486→\n   487→\t// Verify output contains expected sections\n   488→\tif !strings.Contains(output, \"Session:\") {\n   489→\t\tt.Error(\"expected output to contain 'Session:'\")\n   490→\t}\n   491→\tif !strings.Contains(output, info.SessionID) {\n   492→\t\tt.Error(\"expected output to contain session ID\")\n   493→\t}\n   494→\tif strings.Contains(output, \"No Entire session data\") {\n   495→\t\tt.Error(\"expected output to NOT contain no Entire data message\")\n   496→\t}\n   497→}\n   498→\n   499→// Helper to verify common session functions work with SessionSource interface\n   500→func TestStrategySessionSourceInterface(t *testing.T) {\n   501→\t// This ensures manual-commit strategy implements SessionSource\n   502→\tvar s = strategy.NewManualCommitStrategy()\n   503→\n   504→\t// Cast to SessionSource - manual-commit strategy should implement it\n   505→\tsource, ok := s.(strategy.SessionSource)\n   506→\tif !ok {\n   507→\t\tt.Fatal(\"ManualCommitStrategy should implement SessionSource interface\")\n   508→\t}\n   509→\n   510→\t// GetAdditionalSessions should exist and be callable\n   511→\t_, err := source.GetAdditionalSessions()\n   512→\tif err != nil {\n   513→\t\tt.Logf(\"GetAdditionalSessions returned error: %v\", err)\n   514→\t}\n   515→}\n   516→\n   517→func TestFormatSessionInfo_CheckpointNumberingReversed(t *testing.T) {\n   518→\tnow := time.Now()\n   519→\tsession := &strategy.Session{\n   520→\t\tID:          \"2025-12-09-test-session\",\n   521→\t\tStrategy:    \"auto-commit\",\n   522→\t\tStartTime:   now.Add(-2 * time.Hour),\n   523→\t\tCheckpoints: []strategy.Checkpoint{}, // Not used for format test\n   524→\t}\n   525→\n   526→\t// Simulate checkpoints coming in newest-first order from ListSessions\n   527→\t// but numbered with oldest=1, newest=N\n   528→\tcheckpointDetails := []checkpointDetail{\n   529→\t\t{\n   530→\t\t\tIndex:     3, // Newest checkpoint should have highest number\n   531→\t\t\tShortID:   \"ccc3333\",\n   532→\t\t\tTimestamp: now,\n   533→\t\t\tMessage:   \"Third (newest) checkpoint\",\n   534→\t\t\tInteractions: []interaction{{\n   535→\t\t\t\tPrompt:    \"Latest change\",\n   536→\t\t\t\tResponses: []string{},\n   537→\t\t\t}},\n   538→\t\t},\n   539→\t\t{\n   540→\t\t\tIndex:     2,\n   541→\t\t\tShortID:   \"bbb2222\",\n   542→\t\t\tTimestamp: now.Add(-time.Hour),\n   543→\t\t\tMessage:   \"Second checkpoint\",\n   544→\t\t\tInteractions: []interaction{{\n   545→\t\t\t\tPrompt:    \"Middle change\",\n   546→\t\t\t\tResponses: []string{},\n   547→\t\t\t}},\n   548→\t\t},\n   549→\t\t{\n   550→\t\t\tIndex:     1, // Oldest checkpoint should be #1\n   551→\t\t\tShortID:   \"aaa1111\",\n   552→\t\t\tTimestamp: now.Add(-2 * time.Hour),\n   553→\t\t\tMessage:   \"First (oldest) checkpoint\",\n   554→\t\t\tInteractions: []interaction{{\n   555→\t\t\t\tPrompt:    \"Initial change\",\n   556→\t\t\t\tResponses: []string{},\n   557→\t\t\t}},\n   558→\t\t},\n   559→\t}\n   560→\n   561→\toutput := formatSessionInfo(session, \"\", checkpointDetails)\n   562→\n   563→\t// Verify checkpoint ordering in output\n   564→\t// Checkpoint 3 should appear before Checkpoint 2 which should appear before Checkpoint 1\n   565→\tidx3 := strings.Index(output, \"Checkpoint 3\")\n   566→\tidx2 := strings.Index(output, \"Checkpoint 2\")\n   567→\tidx1 := strings.Index(output, \"Checkpoint 1\")\n   568→\n   569→\tif idx3 == -1 || idx2 == -1 || idx1 == -1 {\n   570→\t\tt.Fatalf(\"expected all checkpoints to be in output, got:\\n%s\", output)\n   571→\t}\n   572→\n   573→\t// In the output, they should appear in the order they're in the slice (newest first)\n   574→\tif idx3 > idx2 || idx2 > idx1 {\n   575→\t\tt.Erro