.\n//\n// A Checkpoint captures a point-in-time within a session, containing either\n// full state (Temporary) or metadata with a commit reference (Committed).\n//\n// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\npackage checkpoint\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/go-git/go-git/v5/plumbing\"\n)\n\n// Checkpoint represents a save point within a session.\ntype Checkpoint struct {\n\t// ID is the unique checkpoint identifier\n\tID string\n\n\t// SessionID is the session this checkpoint belongs to\n\tSessionID string\n\n\t// Timestamp is when this checkpoint was created\n\tTimestamp time.Time\n\n\t// Type indicates temporary (full state) or committed (metadata only)\n\tType Type\n\n\t// Message is a human-readable description of the checkpoint\n\tMessage string\n}\n\n// Type indicates the storage location and lifecycle of a checkpoint.\ntype Type int\n\nconst (\n\t// Temporary checkpoints contain full state (code + metadata) and are stored\n\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n\tTemporary Type = iota\n\n\t// Committed checkpoints contain metadata + commit reference and are stored\n\t// on the entire/sessions branch. They are the permanent record.\n\tCommitted\n)\n\n// Store provides low-level primitives for reading and writing checkpoints.\n// This is used by strategies to implement their storage approach.\n//\n// The interface matches the GitStore implementation signatures directly:\n// - WriteTemporary takes WriteTemporaryOptions and returns the commit hash\n// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n// - List methods return implementation-specific info types for richer data\ntype Store interface {\n\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n\t// Shadow branches are named entire/<base-commit-short-hash>.\n\t// Returns the commit hash of the created checkpoint.\n\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (plumbing.Hash, error)\n\n\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n\t// baseCommit is the commit hash the session is based on.\n\t// Returns nil, nil if the shadow branch doesn't exist.\n\tReadTemporary(ctx context.Context, baseCommit string) (*ReadTemporaryResult, error)\n\n\t// ListTemporary lists all shadow branches with their checkpoint info.\n\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n\n\t// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n\n\t// ReadCommitted reads a committed checkpoint by ID.\n\t// Returns nil, nil if the checkpoint does not exist.\n\tReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error)\n\n\t// ListCommitted lists all committed checkpoints.\n\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n}\n\n// WriteTemporaryOptions contains options for writing a temporary checkpoint.\ntype WriteTemporaryOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// MetadataDir is the relative path to the metadata directory\n\tMetadataDir string\n\n\t// MetadataDirAbs is the absolute path to the metadata directory\n\tMetadataDirAbs string\n\n\t// CommitMessage is the commit subject line\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n\t// When true, all working directory files are captured (not just modified)\n\tIsFirstCheckpoint bool\n}\n\n// ReadTemporaryResult contains the result of reading a temporary checkpoint.\ntype ReadTemporaryResult struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// TreeHash is the hash of the tree containing the checkpoint state\n\tTreeHash plumbing.Hash\n\n\t// SessionID is the session identifier from the commit trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from the commit trailer\n\tMetadataDir string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n\n// TemporaryInfo contains summary information about a shadow branch.\ntype TemporaryInfo struct {\n\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n\tBranchName string\n\n\t// BaseCommit is the short commit hash this branch is based on\n\tBaseCommit string\n\n\t// LatestCommit is the hash of the latest commit on the branch\n\tLatestCommit plumbing.Hash\n\n\t// SessionID is the session identifier from the latest commit\n\tSessionID string\n\n\t// Timestamp is when the latest checkpoint was created\n\tTimestamp time.Time\n}\n\n// WriteCommittedOptions contains options for writing a committed checkpoint.\ntype WriteCommittedOptions struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// Strategy is the name of the strategy that created this checkpoint\n\tStrategy string\n\n\t// Transcript is the session transcript content (full.jsonl)\n\tTranscript []byte\n\n\t// Prompts contains user prompts from the session\n\tPrompts []string\n\n\t// Context is the generated context.md content\n\tContext []byte\n\n\t// FilesTouched are files modified during the session\n\tFilesTouched []string\n\n\t// CheckpointsCount is the number of checkpoints in this session\n\tCheckpointsCount int\n\n\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n\tEphemeralBranch string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// MetadataDir is a directory containing additional metadata files to copy\n\t// If set, all files in this directory will be copied to the checkpoint path\n\t// This is useful for copying task metadata files, subagent transcripts, etc.\n\tMetadataDir string\n\n\t// Task checkpoint fields (for auto-commit strategy task checkpoints)\n\tIsTask    bool   // Whether this is a task checkpoint\n\tToolUseID string // Tool use ID for task checkpoints\n\n\t// Additional task checkpoint fields for subagent checkpoints\n\tAgentID                string // Subagent identifier\n\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n\tSubagentTranscriptPath string // Path to subagent's transcript file\n\n\t// Incremental checkpoint fields\n\tIsIncremental       bool   // Whether this is an incremental checkpoint\n\tIncrementalSequence int    // Checkpoint sequence number\n\tIncrementalType     string // Tool type that triggered this checkpoint\n\tIncrementalData     []byte // Tool input payload for this checkpoint\n\n\t// Commit message fields (used for task checkpoints)\n\tCommitSubject string // Subject line for the metadata commit (overrides default)\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string\n}\n\n// ReadCommittedResult contains the result of reading a committed checkpoint.\ntype ReadCommittedResult struct {\n\t// Metadata contains the checkpoint metadata\n\tMetadata CommittedMetadata\n\n\t// Transcript is the session transcript content (most recent session)\n\tTranscript []byte\n\n\t// Prompts contains user prompts (most recent session)\n\tPrompts string\n\n\t// Context is the context.md content\n\tContext string\n\n\t// ArchivedSessions contains transcripts from previous sessions when multiple\n\t// sessions were condensed to the same checkpoint. Ordered from oldest to newest\n\t// (1/, 2/, etc.). The root-level Transcript is the most recent session.\n\tArchivedSessions []ArchivedSession\n}\n\n// ArchivedSession contains transcript data from a previous session\n// that was archived when multiple sessions contributed to the same checkpoint.\ntype ArchivedSession struct {\n\t// SessionID is the session identifier for this archived session\n\tSessionID string\n\n\t// Transcript is the session transcript content\n\tTranscript []byte\n\n\t// Prompts contains user prompts from this session\n\tPrompts string\n\n\t// FolderIndex is the archive folder number (1, 2, etc.)\n\tFolderIndex int\n}\n\n// CommittedInfo contains summary information about a committed checkpoint.\ntype CommittedInfo struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n\tSessionID string\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// CheckpointsCount is the total number of checkpoints across all sessions\n\tCheckpointsCount int\n\n\t// FilesTouched are files modified during all sessions\n\tFilesTouched []string\n\n\t// Agent identifies the agent that created this checkpoint\n\tAgent string\n\n\t// IsTask indicates if this is a task checkpoint\n\tIsTask bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Multi-session support\n\tSessionCount int      // Number of sessions (1 if single session)\n\tSessionIDs   []string // All session IDs that contributed\n}\n\n// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\ntype CommittedMetadata struct {\n\tCheckpointID     string    `json:\"checkpoint_id\"`\n\tSessionID        string    `json:\"session_id\"`\n\tStrategy         string    `json:\"strategy\"`\n\tCreatedAt        time.Time `json:\"created_at\"`\n\tCheckpointsCount int       `json:\"checkpoints_count\"`\n\tFilesTouched     []string  `json:\"files_touched\"`\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string `json:\"agent,omitempty\"`\n\n\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n\n\t// Task checkpoint fields (only populated for task checkpoints)\n\tIsTask    bool   `json:\"is_task,omitempty\"`\n\tToolUseID string `json:\"tool_use_id,omitempty\"`\n\n\t// Summary fields for explain output (lazily generated, may be empty)\n\tIntent         string   `json:\"intent,omitempty\"`          // What the user was trying to accomplish\n\tOutcome        string   `json:\"outcome,omitempty\"`         // What was actually achieved\n\tLearnings      []string `json:\"learnings,omitempty\"`       // Key insights discovered during the session\n\tFrictionPoints []string `json:\"friction_points,omitempty\"` // Difficulties or blockers encountered\n}\n\n// Info provides summary information for listing checkpoints.\n// This is the generic checkpoint info type.\ntype Info struct {\n\t// ID is the checkpoint identifier\n\tID string\n\n\t// SessionID identifies the session\n\tSessionID string\n\n\t// Type indicates temporary or committed\n\tType Type\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// Message is a summary description\n\tMessage string\n}\n\n// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n// Task checkpoints are created when a subagent completes and contain both\n// code changes and task-specific metadata.\ntype WriteTemporaryTaskOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// ToolUseID is the unique identifier for this Task tool invocation\n\tToolUseID string\n\n\t// AgentID is the subagent identifier\n\tAgentID string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// TranscriptPath is the path to the main session transcript\n\tTranscriptPath string\n\n\t// SubagentTranscriptPath is the path to the subagent's transcript\n\tSubagentTranscriptPath string\n\n\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n\tCheckpointUUID string\n\n\t// CommitMessage is the commit message (already formatted)\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsIncremental indicates this is an incremental checkpoint\n\tIsIncremental bool\n\n\t// IncrementalSequence is the checkpoint sequence number\n\tIncrementalSequence int\n\n\t// IncrementalType is the tool that triggered this checkpoint\n\tIncrementalType string\n\n\t// IncrementalData is the tool_input payload for this checkpoint\n\tIncrementalData []byte\n}\n\n// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n// Used by ListTemporaryCheckpoints to provide rewind point data.\ntype TemporaryCheckpointInfo struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// Message is the first line of the commit message\n\tMessage string\n\n\t// SessionID is the session identifier from the Entire-Session trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from trailers\n\tMetadataDir string\n\n\t// IsTaskCheckpoint indicates if this is a task checkpoint\n\tIsTaskCheckpoint bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n","numLines":409,"startLine":1,"totalLines":409}}},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BGPNsD8SGmoF6gQihGmu9i","type":"tool_result","content":"     1→package checkpoint\n     2→\n     3→import (\n     4→\t\"context\"\n     5→\t\"crypto/sha256\"\n     6→\t\"encoding/json\"\n     7→\t\"fmt\"\n     8→\t\"os\"\n     9→\t\"path/filepath\"\n    10→\t\"sort\"\n    11→\t\"strconv\"\n    12→\t\"strings\"\n    13→\t\"time\"\n    14→\n    15→\t\"entire.io/cli/cmd/entire/cli/jsonutil\"\n    16→\t\"entire.io/cli/cmd/entire/cli/paths\"\n    17→\n    18→\t\"github.com/go-git/go-git/v5\"\n    19→\t\"github.com/go-git/go-git/v5/plumbing\"\n    20→\t\"github.com/go-git/go-git/v5/plumbing/filemode\"\n    21→\t\"github.com/go-git/go-git/v5/plumbing/object\"\n    22→)\n    23→\n    24→// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n    25→// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n    26→//\n    27→// For task checkpoints (IsTask=true), additional files are written under tasks/<tool-use-id>/:\n    28→//   - For incremental checkpoints: checkpoints/NNN-<tool-use-id>.json\n    29→//   - For final checkpoints: checkpoint.json and agent-<agent-id>.jsonl\n    30→func (s *GitStore) WriteCommitted(ctx context.Context, opts WriteCommittedOptions) error {\n    31→\t_ = ctx // Reserved for future use\n    32→\n    33→\t// Validate identifiers to prevent path traversal and malformed data\n    34→\tif err := paths.ValidateCheckpointID(opts.CheckpointID); err != nil {\n    35→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    36→\t}\n    37→\tif err := paths.ValidateSessionID(opts.SessionID); err != nil {\n    38→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    39→\t}\n    40→\tif err := paths.ValidateToolUseID(opts.ToolUseID); err != nil {\n    41→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    42→\t}\n    43→\tif err := paths.ValidateAgentID(opts.AgentID); err != nil {\n    44→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    45→\t}\n    46→\n    47→\t// Ensure sessions branch exists\n    48→\tif err := s.ensureSessionsBranch(); err != nil {\n    49→\t\treturn fmt.Errorf(\"failed to ensure sessions branch: %w\", err)\n    50→\t}\n    51→\n    52→\t// Get current branch tip and flatten tree\n    53→\tref, entries, err := s.getSessionsBranchEntries()\n    54→\tif err != nil {\n    55→\t\treturn err\n    56→\t}\n    57→\n    58→\t// Use sharded path: <id[:2]>/<id[2:]>/\n    59→\tbasePath := paths.CheckpointPath(opts.CheckpointID) + \"/\"\n    60→\n    61→\t// Track task metadata path for commit trailer\n    62→\tvar taskMetadataPath string\n    63→\n    64→\t// Handle task checkpoints\n    65→\tif opts.IsTask && opts.ToolUseID != \"\" {\n    66→\t\ttaskMetadataPath, err = s.writeTaskCheckpointEntries(opts, basePath, entries)\n    67→\t\tif err != nil {\n    68→\t\t\treturn err\n    69→\t\t}\n    70→\t}\n    71→\n    72→\t// Write standard checkpoint entries (transcript, prompts, context, metadata)\n    73→\tif err := s.writeStandardCheckpointEntries(opts, basePath, entries); err != nil {\n    74→\t\treturn err\n    75→\t}\n    76→\n    77→\t// Build and commit\n    78→\tnewTreeHash, err := BuildTreeFromEntries(s.repo, entries)\n    79→\tif err != nil {\n    80→\t\treturn err\n    81→\t}\n    82→\n    83→\tcommitMsg := s.buildCommitMessage(opts, taskMetadataPath)\n    84→\tnewCommitHash, err := s.createCommit(newTreeHash, ref.Hash(), commitMsg, opts.AuthorName, opts.AuthorEmail)\n    85→\tif err != nil {\n    86→\t\treturn err\n    87→\t}\n    88→\n    89→\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n    90→\tnewRef := plumbing.NewHashReference(refName, newCommitHash)\n    91→\tif err := s.repo.Storer.SetReference(newRef); err != nil {\n    92→\t\treturn fmt.Errorf(\"failed to set branch reference: %w\", err)\n    93→\t}\n    94→\n    95→\treturn nil\n    96→}\n    97→\n    98→// getSessionsBranchEntries returns the sessions branch reference and flattened tree entries.\n    99→func (s *GitStore) getSessionsBranchEntries() (*plumbing.Reference, map[string]object.TreeEntry, error) {\n   100→\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n   101→\tref, err := s.repo.Reference(refName, true)\n   102→\tif err != nil {\n   103→\t\treturn nil, nil, fmt.Errorf(\"failed to get sessions branch reference: %w\", err)\n   104→\t}\n   105→\n   106→\tparentCommit, err := s.repo.CommitObject(ref.Hash())\n   107→\tif err != nil {\n   108→\t\treturn nil, nil, fmt.Errorf(\"failed to get commit object: %w\", err)\n   109→\t}\n   110→\n   111→\tbaseTree, err := parentCommit.Tree()\n   112→\tif err != nil {\n   113→\t\treturn nil, nil, fmt.Errorf(\"failed to get commit tree: %w\", err)\n   114→\t}\n   115→\n   116→\tentries := make(map[string]object.TreeEntry)\n   117→\tif err := FlattenTree(s.repo, baseTree, \"\", entries); err != nil {\n   118→\t\treturn nil, nil, err\n   119→\t}\n   120→\n   121→\treturn ref, entries, nil\n   122→}\n   123→\n   124→// writeTaskCheckpointEntries writes task-specific checkpoint entries and returns the task metadata path.\n   125→func (s *GitStore) writeTaskCheckpointEntries(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry) (string, error) {\n   126→\ttaskPath := basePath + \"tasks/\" + opts.ToolUseID + \"/\"\n   127→\n   128→\tif opts.IsIncremental {\n   129→\t\treturn s.writeIncrementalTaskCheckpoint(opts, taskPath, entries)\n   130→\t}\n   131→\treturn s.writeFinalTaskCheckpoint(opts, taskPath, entries)\n   132→}\n   133→\n   134→// writeIncrementalTaskCheckpoint writes an incremental checkpoint file during task execution.\n   135→func (s *GitStore) writeIncrementalTaskCheckpoint(opts WriteCommittedOptions, taskPath string, entries map[string]object.TreeEntry) (string, error) {\n   136→\tcheckpoint := incrementalCheckpointData{\n   137→\t\tType:      opts.IncrementalType,\n   138→\t\tToolUseID: opts.ToolUseID,\n   139→\t\tTimestamp: time.Now().UTC(),\n   140→\t\tData:      opts.IncrementalData,\n   141→\t}\n   142→\tcpData, err := jsonutil.MarshalIndentWithNewline(checkpoint, \"\", \"  \")\n   143→\tif err != nil {\n   144→\t\treturn \"\", fmt.Errorf(\"failed to marshal incremental checkpoint: %w\", err)\n   145→\t}\n   146→\tcpBlobHash, err := CreateBlobFromContent(s.repo, cpData)\n   147→\tif err != nil {\n   148→\t\treturn \"\", fmt.Errorf(\"failed to create incremental checkpoint blob: %w\", err)\n   149→\t}\n   150→\n   151→\tcpFilename := fmt.Sprintf(\"%03d-%s.json\", opts.IncrementalSequence, opts.ToolUseID)\n   152→\tcpPath := taskPath + \"checkpoints/\" + cpFilename\n   153→\tentries[cpPath] = object.TreeEntry{\n   154→\t\tName: cpPath,\n   155→\t\tMode: filemode.Regular,\n   156→\t\tHash: cpBlobHash,\n   157→\t}\n   158→\treturn cpPath, nil\n   159→}\n   160→\n   161→// writeFinalTaskCheckpoint writes the final checkpoint.json and subagent transcript.\n   162→func (s *GitStore) writeFinalTaskCheckpoint(opts WriteCommittedOptions, taskPath string, entries map[string]object.TreeEntry) (string, error) {\n   163→\tcheckpoint := taskCheckpointData{\n   164→\t\tSessionID:      opts.SessionID,\n   165→\t\tToolUseID:      opts.ToolUseID,\n   166→\t\tCheckpointUUID: opts.CheckpointUUID,\n   167→\t\tAgentID:        opts.AgentID,\n   168→\t}\n   169→\tcheckpointData, err := jsonutil.MarshalIndentWithNewline(checkpoint, \"\", \"  \")\n   170→\tif err != nil {\n   171→\t\treturn \"\", fmt.Errorf(\"failed to marshal task checkpoint: %w\", err)\n   172→\t}\n   173→\tblobHash, err := CreateBlobFromContent(s.repo, checkpointData)\n   174→\tif err != nil {\n   175→\t\treturn \"\", fmt.Errorf(\"failed to create task checkpoint blob: %w\", err)\n   176→\t}\n   177→\n   178→\tcheckpointFile := taskPath + \"checkpoint.json\"\n   179→\tentries[checkpointFile] = object.TreeEntry{\n   180→\t\tName: checkpointFile,\n   181→\t\tMode: filemode.Regular,\n   182→\t\tHash: blobHash,\n   183→\t}\n   184→\n   185→\t// Write subagent transcript if available\n   186→\tif opts.SubagentTranscriptPath != \"\" && opts.AgentID != \"\" {\n   187→\t\tagentContent, readErr := os.ReadFile(opts.SubagentTranscriptPath)\n   188→\t\tif readErr == nil {\n   189→\t\t\tagentBlobHash, agentBlobErr := CreateBlobFromContent(s.repo, agentContent)\n   190→\t\t\tif agentBlobErr == nil {\n   191→\t\t\t\tagentPath := taskPath + \"agent-\" + opts.AgentID + \".jsonl\"\n   192→\t\t\t\tentries[agentPath] = object.TreeEntry{\n   193→\t\t\t\t\tName: agentPath,\n   194→\t\t\t\t\tMode: filemode.Regular,\n   195→\t\t\t\t\tHash: agentBlobHash,\n   196→\t\t\t\t}\n   197→\t\t\t}\n   198→\t\t}\n   199→\t}\n   200→\n   201→\t// Return task path without trailing slash\n   202→\treturn taskPath[:len(taskPath)-1], nil\n   203→}\n   204→\n   205→// writeStandardCheckpointEntries writes transcript, prompts, context, metadata.json and any additional files.\n   206→// If the checkpoint already exists (from a previous session), archives the existing files to a numbered subfolder.\n   207→func (s *GitStore) writeStandardCheckpointEntries(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry) error {\n   208→\t// Check if checkpoint already exists (multi-session support)\n   209→\tvar existingMetadata *CommittedMetadata\n   210→\tmetadataPath := basePath + paths.MetadataFileName\n   211→\tif entry, exists := entries[metadataPath]; exists {\n   212→\t\t// Read existing metadata to get session count\n   213→\t\texisting, err := s.readMetadataFromBlob(entry.Hash)\n   214→\t\tif err == nil {\n   215→\t\t\texistingMetadata = existing\n   216→\t\t\t// Archive existing session files to numbered subfolder\n   217→\t\t\ts.archiveExistingSession(basePath, existingMetadata, entries)\n   218→\t\t}\n   219→\t}\n   220→\n   221→\t// Write transcript (from in-memory content or file path)\n   222→\tif err := s.writeTranscript(opts, basePath, entries); err != nil {\n   223→\t\treturn err\n   224→\t}\n   225→\n   226→\t// Write prompts\n   227→\tif len(opts.Prompts) > 0 {\n   228→\t\tpromptContent := strings.Join(opts.Prompts, \"\\n\\n---\\n\\n\")\n   229→\t\tblobHash, err := CreateBlobFromContent(s.repo, []byte(promptContent))\n   230→\t\tif err != nil {\n   231→\t\t\treturn err\n   232→\t\t}\n   233→\t\tentries[basePath+paths.PromptFileName] = object.TreeEntry{\n   234→\t\t\tName: basePath + paths.PromptFileName,\n   235→\t\t\tMode: filemode.Regular,\n   236→\t\t\tHash: blobHash,\n   237→\t\t}\n   238→\t}\n   239→\n   240→\t// Write context\n   241→\tif len(opts.Context) > 0 {\n   242→\t\tblobHash, err := CreateBlobFromContent(s.repo, opts.Context)\n   243→\t\tif err != nil {\n   244→\t\t\treturn err\n   245→\t\t}\n   246→\t\tentries[basePath+paths.ContextFileName] = object.TreeEntry{\n   247→\t\t\tName: basePath + paths.ContextFileName,\n   248→\t\t\tMode: filemode.Regular,\n   249→\t\t\tHash: blobHash,\n   250→\t\t}\n   251→\t}\n   252→\n   253→\t// Copy additional metadata files from directory if specified\n   254→\tif opts.MetadataDir != \"\" {\n   255→\t\tif err := s.copyMetadataDir(opts.MetadataDir, basePath, entries); err != nil {\n   256→\t\t\treturn fmt.Errorf(\"failed to copy metadata directory: %w\", err)\n   257→\t\t}\n   258→\t}\n   259→\n   260→\t// Write metadata.json (with merged info if existing metadata present)\n   261→\treturn s.writeMetadataJSON(opts, basePath, entries, existingMetadata)\n   262→}\n   263→\n   264→// writeTranscript writes the transcript file from in-memory content or file path.\n   265→func (s *GitStore) writeTranscript(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry) error {\n   266→\ttranscript := opts.Transcript\n   267→\tif len(transcript) == 0 && opts.TranscriptPath != \"\" {\n   268→\t\tvar readErr error\n   269→\t\ttranscript, readErr = os.ReadFile(opts.TranscriptPath)\n   270→\t\tif readErr != nil {\n   271→\t\t\t// Non-fatal: transcript may not exist yet\n   272→\t\t\ttranscript = nil\n   273→\t\t}\n   274→\t}\n   275→\tif len(transcript) == 0 {\n   276→\t\treturn nil\n   277→\t}\n   278→\n   279→\tblobHash, err := CreateBlobFromContent(s.repo, transcript)\n   280→\tif err != nil {\n   281→\t\treturn err\n   282→\t}\n   283→\tentries[basePath+paths.TranscriptFileName] = object.TreeEntry{\n   284→\t\tName: basePath + paths.TranscriptFileName,\n   285→\t\tMode: filemode.Regular,\n   286→\t\tHash: blobHash,\n   287→\t}\n   288→\n   289→\t// Content hash for deduplication\n   290→\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n   291→\thashBlob, err := CreateBlobFromContent(s.repo, []byte(contentHash))\n   292→\tif err != nil {\n   293→\t\treturn err\n   294→\t}\n   295→\tentries[basePath+paths.ContentHashFileName] = object.TreeEntry{\n   296→\t\tName: basePath + paths.ContentHashFileName,\n   297→\t\tMode: filemode.Regular,\n   298→\t\tHash: hashBlob,\n   299→\t}\n   300→\treturn nil\n   301→}\n   302→\n   303→// writeMetadataJSON writes the metadata.json file for the checkpoint.\n   304→// If existingMetadata is provided, merges session info from the previous session(s).\n   305→func (s *GitStore) writeMetadataJSON(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry, existingMetadata *CommittedMetadata) error {\n   306→\tmetadata := CommittedMetadata{\n   307→\t\tCheckpointID:     opts.CheckpointID,\n   308→\t\tSessionID:        opts.SessionID,\n   309→\t\tStrategy:         opts.Strategy,\n   310→\t\tCreatedAt:        time.Now(),\n   311→\t\tCheckpointsCount: opts.CheckpointsCount,\n   312→\t\tFilesTouched:     opts.FilesTouched,\n   313→\t\tAgent:            opts.Agent,\n   314→\t\tIsTask:           opts.IsTask,\n   315→\t\tToolUseID:        opts.ToolUseID,\n   316→\t\tSessionCount:     1,\n   317→\t\tSessionIDs:       []string{opts.SessionID},\n   318→\t}\n   319→\n   320→\t// Merge with existing metadata if present (multi-session checkpoint)\n   321→\tif existingMetadata != nil {\n   322→\t\t// Get existing session count (default to 1 for backwards compat)\n   323→\t\texistingCount := existingMetadata.SessionCount\n   324→\t\tif existingCount == 0 {\n   325→\t\t\texistingCount = 1\n   326→\t\t}\n   327→\t\tmetadata.SessionCount = existingCount + 1\n   328→\n   329→\t\t// Merge session IDs\n   330→\t\texistingIDs := existingMetadata.SessionIDs\n   331→\t\tif len(existingIDs) == 0 {\n   332→\t\t\t// Backwards compat: old metadata only had SessionID\n   333→\t\t\texistingIDs = []string{existingMetadata.SessionID}\n   334→\t\t}\n   335→\t\tmetadata.SessionIDs = append(metadata.SessionIDs[:0], existingIDs...)\n   336→\t\tmetadata.SessionIDs = append(metadata.SessionIDs, opts.SessionID)\n   337→\n   338→\t\t// Merge files touched (deduplicated)\n   339→\t\tmetadata.FilesTouched = mergeFilesTouched(existingMetadata.FilesTouched, opts.FilesTouched)\n   340→\n   341→\t\t// Sum checkpoint counts\n   342→\t\tmetadata.CheckpointsCount = existingMetadata.CheckpointsCount + opts.CheckpointsCount\n   343→\t}\n   344→\n   345→\tmetadataJSON, err := jsonutil.MarshalIndentWithNewline(metadata, \"\", \"  \")\n   346→\tif err != nil {\n   347→\t\treturn fmt.Errorf(\"failed to marshal metadata: %w\", err)\n   348→\t}\n   349→\tmetadataHash, err := CreateBlobFromContent(s.repo, metadataJSON)\n   350→\tif err != nil {\n   351→\t\treturn err\n   352→\t}\n   353→\tentries[basePath+paths.MetadataFileName] = object.TreeEntry{\n   354→\t\tName: basePath + paths.MetadataFileName,\n   355→\t\tMode: filemode.Regular,\n   356→\t\tHash: metadataHash,\n   357→\t}\n   358→\treturn nil\n   359→}\n   360→\n   361→// mergeFilesTouched combines two file lists, removing duplicates.\n   362→func mergeFilesTouched(existing, additional []string) []string {\n   363→\tseen := make(map[string]bool)\n   364→\tvar result []string\n   365→\n   366→\tfor _, f := range existing {\n   367→\t\tif !seen[f] {\n   368→\t\t\tseen[f] = true\n   369→\t\t\tresult = append(result, f)\n   370→\t\t}\n   371→\t}\n   372→\tfor _, f := range additional {\n   373→\t\tif !seen[f] {\n   374→\t\t\tseen[f] = true\n   375→\t\t\tresult = append(result, f)\n   376→\t\t}\n   377→\t}\n   378→\n   379→\tsort.Strings(result)\n   380→\treturn result\n   381→}\n   382→\n   383→// readMetadataFromBlob reads CommittedMetadata from a blob hash.\n   384→func (s *GitStore) readMetadataFromBlob(hash plumbing.Hash) (*CommittedMetadata, error) {\n   385→\tblob, err := s.repo.BlobObject(hash)\n   386→\tif err != nil {\n   387→\t\treturn nil, fmt.Errorf(\"failed to get blob: %w\", err)\n   388→\t}\n   389→\n   390→\treader, err := blob.Reader()\n   391→\tif err != nil {\n   392→\t\treturn nil, fmt.Errorf(\"failed to get blob reader: %w\", err)\n   393→\t}\n   394→\tdefer reader.Close()\n   395→\n   396→\tvar metadata CommittedMetadata\n   397→\tif err := json.NewDecoder(reader).Decode(&metadata); err != nil {\n   398→\t\treturn nil, fmt.Errorf(\"failed to decode metadata: %w\", err)\n   399→\t}\n   400→\n   401→\treturn &metadata, nil\n   402→}\n   403→\n   404→// archiveExistingSession moves existing session files to a numbered subfolder.\n   405→// The subfolder number is based on the current session count (so first archived session goes to \"1/\").\n   406→func (s *GitStore) archiveExistingSession(basePath string, existingMetadata *CommittedMetadata, entries map[string]object.TreeEntry) {\n   407→\t// Determine archive folder number\n   408→\tsessionCount := existingMetadata.SessionCount\n   409→\tif sessionCount == 0 {\n   410→\t\tsessionCount = 1 // backwards compat\n   411→\t}\n   412→\tarchivePath := fmt.Sprintf(\"%s%d/\", basePath, sessionCount)\n   413→\n   414→\t// Files to archive (standard checkpoint files at basePath, excluding tasks/ subfolder)\n   415→\tfilesToArchive := []string{\n   416→\t\tpaths.MetadataFileName,\n   417→\t\tpaths.TranscriptFileName,\n   418→\t\tpaths.PromptFileName,\n   419→\t\tpaths.ContextFileName,\n   420→\t\tpaths.ContentHashFileName,\n   421→\t}\n   422→\n   423→\t// Move each file to archive folder\n   424→\tfor _, filename := range filesToArchive {\n   425→\t\tsrcPath := basePath + filename\n   426→\t\tif entry, exists := entries[srcPath]; exists {\n   427→\t\t\t// Add to archive location\n   428→\t\t\tdstPath := archivePath + filename\n   429→\t\t\tentries[dstPath] = object.TreeEntry{\n   430→\t\t\t\tName: dstPath,\n   431→\t\t\t\tMode: entry.Mode,\n   432→\t\t\t\tHash: entry.Hash,\n   433→\t\t\t}\n   434→\t\t\t// Remove from original location (will be overwritten by new session)\n   435→\t\t\tdelete(entries, srcPath)\n   436→\t\t}\n   437→\t}\n   438→}\n   439→\n   440→// readArchivedSessions reads transcript data from archived session subfolders (1/, 2/, etc.).\n   441→// Returns sessions ordered by folder index (oldest first).\n   442→func (s *GitStore) readArchivedSessions(checkpointTree *object.Tree, sessionCount int) []ArchivedSession {\n   443→\tvar archived []ArchivedSession\n   444→\n   445→\t// Archived sessions are in numbered folders: 1/, 2/, etc.\n   446→\t// The most recent session is at the root level (not archived).\n   447→\t// Session count N means there are N-1 archived sessions.\n   448→\tfor i := 1; i < sessionCount; i++ {\n   449→\t\tfolderName := strconv.Itoa(i)\n   450→\n   451→\t\t// Try to get the archived session subtree\n   452→\t\tsubTree, err := checkpointTree.Tree(folderName)\n   453→\t\tif err != nil {\n   454→\t\t\tcontinue // Folder doesn't exist, skip\n   455→\t\t}\n   456→\n   457→\t\tsession := ArchivedSession{\n   458→\t\t\tFolderIndex: i,\n   459→\t\t}\n   460→\n   461→\t\t// Read metadata to get session ID\n   462→\t\tif metadataFile, fileErr := subTree.File(paths.MetadataFileName); fileErr == nil {\n   463→\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   464→\t\t\t\tvar metadata CommittedMetadata\n   465→\t\t\t\tif jsonErr := json.Unmarshal([]byte(content), &metadata); jsonErr == nil {\n   466→\t\t\t\t\tsession.SessionID = metadata.SessionID\n   467→\t\t\t\t}\n   468→\t\t\t}\n   469→\t\t}\n   470→\n   471→\t\t// Read transcript (try current format first, then legacy)\n   472→\t\tif file, fileErr := subTree.File(paths.TranscriptFileName); fileErr == nil {\n   473→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   474→\t\t\t\tsession.Transcript = []byte(content)\n   475→\t\t\t}\n   476→\t\t} else if file, fileErr := subTree.File(paths.TranscriptFileNameLegacy); fileErr == nil {\n   477→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   478→\t\t\t\tsession.Transcript = []byte(content)\n   479→\t\t\t}\n   480→\t\t}\n   481→\n   482→\t\t// Read prompts\n   483→\t\tif file, fileErr := subTree.File(paths.PromptFileName); fileErr == nil {\n   484→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   485→\t\t\t\tsession.Prompts = content\n   486→\t\t\t}\n   487→\t\t}\n   488→\n   489→\t\t// Only add if we got a transcript\n   490→\t\tif len(session.Transcript) > 0 {\n   491→\t\t\tarchived = append(archived, session)\n   492→\t\t}\n   493→\t}\n   494→\n   495→\treturn archived\n   496→}\n   497→\n   498→// buildCommitMessage constructs the commit message with proper trailers.\n   499→func (s *GitStore) buildCommitMessage(opts WriteCommittedOptions, taskMetadataPath string) string {\n   500→\tvar commitMsg strings.Builder\n   501→\n   502→\t// Use custom subject if provided\n   503→\tif opts.CommitSubject != \"\" {\n   504→\t\tcommitMsg.WriteString(opts.CommitSubject + \"\\n\\n\")\n   505→\t}\n   506→\tcommitMsg.Write