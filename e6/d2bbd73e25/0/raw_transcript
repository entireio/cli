\n   174→\ttmpDir := t.TempDir()\n   175→\tt.Chdir(tmpDir)\n   176→\n   177→\t// Initialize git repo\n   178→\trepo, err := git.PlainInit(tmpDir, false)\n   179→\tif err != nil {\n   180→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   181→\t}\n   182→\n   183→\tw, err := repo.Worktree()\n   184→\tif err != nil {\n   185→\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   186→\t}\n   187→\n   188→\t// Create session metadata directory first\n   189→\tsessionID := \"2025-12-09-test-session-xyz789\"\n   190→\tsessionDir := filepath.Join(tmpDir, \".entire\", \"metadata\", sessionID)\n   191→\tif err := os.MkdirAll(sessionDir, 0o750); err != nil {\n   192→\t\tt.Fatalf(\"failed to create session dir: %v\", err)\n   193→\t}\n   194→\n   195→\t// Create prompt file\n   196→\tpromptContent := \"Add new feature\"\n   197→\tif err := os.WriteFile(filepath.Join(sessionDir, paths.PromptFileName), []byte(promptContent), 0o644); err != nil {\n   198→\t\tt.Fatalf(\"failed to create prompt file: %v\", err)\n   199→\t}\n   200→\n   201→\t// Create a commit with Entire metadata trailer\n   202→\ttestFile := filepath.Join(tmpDir, \"test.txt\")\n   203→\tif err := os.WriteFile(testFile, []byte(\"feature content\"), 0o644); err != nil {\n   204→\t\tt.Fatalf(\"failed to write test file: %v\", err)\n   205→\t}\n   206→\tif _, err := w.Add(\"test.txt\"); err != nil {\n   207→\t\tt.Fatalf(\"failed to add test file: %v\", err)\n   208→\t}\n   209→\n   210→\t// Commit with Entire-Metadata trailer\n   211→\tmetadataDir := \".entire/metadata/\" + sessionID\n   212→\tcommitMessage := paths.FormatMetadataTrailer(\"Add new feature\", metadataDir)\n   213→\tcommitHash, err := w.Commit(commitMessage, &git.CommitOptions{\n   214→\t\tAuthor: &object.Signature{\n   215→\t\t\tName:  \"Test\",\n   216→\t\t\tEmail: \"test@example.com\",\n   217→\t\t},\n   218→\t})\n   219→\tif err != nil {\n   220→\t\tt.Fatalf(\"failed to create commit: %v\", err)\n   221→\t}\n   222→\n   223→\tvar stdout bytes.Buffer\n   224→\terr = runExplainCommit(&stdout, commitHash.String())\n   225→\tif err != nil {\n   226→\t\tt.Fatalf(\"runExplainCommit() error = %v\", err)\n   227→\t}\n   228→\n   229→\toutput := stdout.String()\n   230→\n   231→\t// Should show commit info\n   232→\tif !strings.Contains(output, commitHash.String()[:7]) {\n   233→\t\tt.Errorf(\"expected output to contain short commit hash, got: %s\", output)\n   234→\t}\n   235→\t// Should show session info - the session ID is extracted from the metadata path\n   236→\t// The format is test-session-xyz789 (extracted from the full path)\n   237→\tif !strings.Contains(output, \"Session:\") {\n   238→\t\tt.Errorf(\"expected output to contain 'Session:', got: %s\", output)\n   239→\t}\n   240→}\n   241→\n   242→// setupExplainTestRepo creates a git repo with an initial commit and .entire directory.\n   243→// It sets the working directory to the temp directory via t.Chdir.\n   244→func setupExplainTestRepo(t *testing.T) {\n   245→\tt.Helper()\n   246→\ttmpDir := t.TempDir()\n   247→\tt.Chdir(tmpDir)\n   248→\n   249→\trepo, err := git.PlainInit(tmpDir, false)\n   250→\tif err != nil {\n   251→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   252→\t}\n   253→\n   254→\tw, err := repo.Worktree()\n   255→\tif err != nil {\n   256→\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   257→\t}\n   258→\ttestFile := filepath.Join(tmpDir, \"test.txt\")\n   259→\tif err := os.WriteFile(testFile, []byte(\"test\"), 0o644); err != nil {\n   260→\t\tt.Fatalf(\"failed to write test file: %v\", err)\n   261→\t}\n   262→\tif _, err := w.Add(\"test.txt\"); err != nil {\n   263→\t\tt.Fatalf(\"failed to add file: %v\", err)\n   264→\t}\n   265→\t_, err = w.Commit(\"initial commit\", &git.CommitOptions{\n   266→\t\tAuthor: &object.Signature{Name: \"Test\", Email: \"test@example.com\"},\n   267→\t})\n   268→\tif err != nil {\n   269→\t\tt.Fatalf(\"failed to commit: %v\", err)\n   270→\t}\n   271→\n   272→\tif err := os.MkdirAll(\".entire\", 0o750); err != nil {\n   273→\t\tt.Fatalf(\"failed to create .entire dir: %v\", err)\n   274→\t}\n   275→}\n   276→\n   277→func TestExplainDefault_NoCurrentSession(t *testing.T) {\n   278→\tsetupExplainTestRepo(t)\n   279→\n   280→\tvar stdout bytes.Buffer\n   281→\t// With the new branch-centric view, no current session should show branch info instead of error\n   282→\terr := runExplainDefault(&stdout, true, false, false, false, 0)\n   283→\n   284→\t// Should NOT error - just show branch-level info\n   285→\tif err != nil {\n   286→\t\tt.Fatalf(\"runExplainDefault() should not error with no session, got: %v\", err)\n   287→\t}\n   288→\n   289→\t// Should show branch info\n   290→\toutput := stdout.String()\n   291→\tif !strings.Contains(output, \"Branch:\") {\n   292→\t\tt.Errorf(\"expected output to contain 'Branch:', got:\\n%s\", output)\n   293→\t}\n   294→}\n   295→\n   296→func TestExplainBothFlagsError(t *testing.T) {\n   297→\t// Test that providing both --session and --commit returns an error\n   298→\tvar stdout bytes.Buffer\n   299→\terr := runExplain(&stdout, \"session-id\", \"commit-sha\", false, false, false, false, 0)\n   300→\n   301→\tif err == nil {\n   302→\t\tt.Error(\"expected error when both flags provided, got nil\")\n   303→\t}\n   304→\t// Case-insensitive check for \"cannot specify both\"\n   305→\terrLower := strings.ToLower(err.Error())\n   306→\tif !strings.Contains(errLower, \"cannot specify both\") {\n   307→\t\tt.Errorf(\"expected 'cannot specify both' in error, got: %v\", err)\n   308→\t}\n   309→}\n   310→\n   311→func TestFormatSessionInfo(t *testing.T) {\n   312→\tnow := time.Now()\n   313→\tsession := &strategy.Session{\n   314→\t\tID:          \"2025-12-09-test-session-abc\",\n   315→\t\tDescription: \"Test description\",\n   316→\t\tStrategy:    \"manual-commit\",\n   317→\t\tStartTime:   now,\n   318→\t\tCheckpoints: []strategy.Checkpoint{\n   319→\t\t\t{\n   320→\t\t\t\tCheckpointID: \"abc1234567890\",\n   321→\t\t\