ts.Transcript\n   267→\tif len(transcript) == 0 && opts.TranscriptPath != \"\" {\n   268→\t\tvar readErr error\n   269→\t\ttranscript, readErr = os.ReadFile(opts.TranscriptPath)\n   270→\t\tif readErr != nil {\n   271→\t\t\t// Non-fatal: transcript may not exist yet\n   272→\t\t\ttranscript = nil\n   273→\t\t}\n   274→\t}\n   275→\tif len(transcript) == 0 {\n   276→\t\treturn nil\n   277→\t}\n   278→\n   279→\tblobHash, err := CreateBlobFromContent(s.repo, transcript)\n   280→\tif err != nil {\n   281→\t\treturn err\n   282→\t}\n   283→\tentries[basePath+paths.TranscriptFileName] = object.TreeEntry{\n   284→\t\tName: basePath + paths.TranscriptFileName,\n   285→\t\tMode: filemode.Regular,\n   286→\t\tHash: blobHash,\n   287→\t}\n   288→\n   289→\t// Content hash for deduplication\n   290→\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n   291→\thashBlob, err := CreateBlobFromContent(s.repo, []byte(contentHash))\n   292→\tif err != nil {\n   293→\t\treturn err\n   294→\t}\n   295→\tentries[basePath+paths.ContentHashFileName] = object.TreeEntry{\n   296→\t\tName: basePath + paths.ContentHashFileName,\n   297→\t\tMode: filemode.Regular,\n   298→\t\tHash: hashBlob,\n   299→\t}\n   300→\treturn nil\n   301→}\n   302→\n   303→// writeMetadataJSON writes the metadata.json file for the checkpoint.\n   304→// If existingMetadata is provided, merges session info from the previous session(s).\n   305→func (s *GitStore) writeMetadataJSON(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry, existingMetadata *CommittedMetadata) error {\n   306→\tmetadata := CommittedMetadata{\n   307→\t\tCheckpointID:     opts.CheckpointID,\n   308→\t\tSessionID:        opts.SessionID,\n   309→\t\tStrategy:         opts.Strategy,\n   310→\t\tCreatedAt:        time.Now(),\n   311→\t\tCheckpointsCount: opts.CheckpointsCount,\n   312→\t\tFilesTouched:     opts.FilesTouched,\n   313→\t\tAgent:            opts.Agent,\n   314→\t\tIsTask:           opts.IsTask,\n   315→\t\tToolUseID:        opts.ToolUseID,\n   316→\t\tSessionCount:     1,\n   317→\t\tSessionIDs:       []string{opts.SessionID},\n   318→\t}\n   319→\n   320→\t// Merge with existing metadata if present (multi-session checkpoint)\n   321→\tif existingMetadata != nil {\n   322→\t\t// Get existing session count (default to 1 for backwards compat)\n   323→\t\texistingCount := existingMetadata.SessionCount\n   324→\t\tif existingCount == 0 {\n   325→\t\t\texistingCount = 1\n   326→\t\t}\n   327→\t\tmetadata.SessionCount = existingCount + 1\n   328→\n   329→\t\t// Merge session IDs\n   330→\t\texistingIDs := existingMetadata.SessionIDs\n   331→\t\tif len(existingIDs) == 0 {\n   332→\t\t\t// Backwards compat: old metadata only had SessionID\n   333→\t\t\texistingIDs = []string{existingMetadata.SessionID}\n   334→\t\t}\n   335→\t\tmetadata.SessionIDs = append(metadata.SessionIDs[:0], existingIDs...)\n   336→\t\tmetadata.SessionIDs = append(metadata.SessionIDs, opts.SessionID)\n   337→\n   338→\t\t// Merge files touched (deduplicated)\n   339→\t\tmetadata.FilesTouched = mergeFilesTouched(existingMetadata.FilesTouched, opts.FilesTouched)\n   340→\n   341→\t\t// Sum checkpoint counts\n   342→\t\tmetadata.CheckpointsCount = existingMetadata.CheckpointsCount + opts.CheckpointsCount\n   343→\t}\n   344→\n   345→\tmetadataJSON, err := jsonutil.MarshalIndentWithNewline(metadata, \"\", \"  \")\n   346→\tif err != nil {\n   347→\t\treturn fmt.Errorf(\"failed to marshal metadata: %w\", err)\n   348→\t}\n   349→\tmetadataHash, err := CreateBlobFromContent(s.repo, metadataJSON)\n   350→\tif err != nil {\n   351→\t\treturn err\n   352→\t}\n   353→\tentries[basePath+paths.MetadataFileName] = object.TreeEntry{\n   354→\t\tName: basePath + paths.MetadataFileName,\n   355→\t\tMode: filemode.Regular,\n   356→\t\tHash: metadataHash,\n   357→\t}\n   358→\treturn nil\n   359→}\n   360→\n   361→// mergeFilesTouched combines two file lists, removing duplicates.\n   362→func mergeFilesTouched(existing, additional []string) []string {\n   363→\tseen := make(map[string]bool)\n   364→\tvar result []string\n   365→\n   366→\tfor _, f := range existing {\n   367→\t\tif !seen[f] {\n   368→\t\t\tseen[f] = true\n   369→\t\t\tresult = append(result, f)\n   370→\t\t}\n   371→\t}\n   372→\tfor _, f := range additional {\n   373→\t\tif !seen[f] {\n   374→\t\t\tseen[f] = true\n   375→\t\t\tresult = append(result, f)\n   376→\t\t}\n   377→\t}\n   378→\n   379→\tsort.Strings(result)\n   380→\treturn result\n   381→}\n   382→\n   383→// readMetadataFromBlob reads CommittedMetadata from a blob hash.\n   384→func (s *GitStore) readMetadataFromBlob(hash plumbing.Hash) (*CommittedMetadata, error) {\n   385→\tblob, err := s.repo.BlobObject(hash)\n   386→\tif err != nil {\n   387→\t\treturn nil, fmt.Errorf(\"failed to get blob: %w\", err)\n   388→\t}\n   389→\n   390→\treader, err := blob.Reader()\n   391→\tif err != nil {\n   392→\t\treturn nil, fmt.Errorf(\"failed to get blob reader: %w\", err)\n   393→\t}\n   394→\tdefer reader.Close()\n   395→\n   396→\tvar metadata CommittedMetadata\n   397→\tif err := json.NewDecoder(reader).Decode(&metadata); err != nil {\n   398→\t\treturn nil, fmt.Errorf(\"failed to decode metadata: %w\", err)\n   399→\t}\n   400→\n   401→\treturn &metadata, nil\n   402→}\n   403→\n   404→// archiveExistingSession moves existing session files to a numbered subfolder.\n   405→// The subfolder number is based on the current session count (so first archived session goes to \"1/\").\n   406→func (s *GitStore) archiveExistingSession(basePath string, existingMetadata *CommittedMetadata, entries map[string]object.TreeEntry) {\n   407→\t// Determine archive folder number\n   408→\tsessionCount := existingMetadata.SessionCount\n   409→\tif sessionCount == 0 {\n   410→\t\tsessionCount = 1 // backwards compat\n   411→\t}\n   412→\tarchivePath := fmt.Sprintf(\"%s%d/\", basePath, sessionCount)\n   413→\n   414→\t// Files to archive (standard checkpoint files at basePath, excluding tasks/ subfolder)\n   415→\tfilesToArchive := []string{\n   416→\t\tpaths.MetadataFileName,\n   417→\t\tpaths.TranscriptFileName,\n   418→\t\tpaths.PromptFileName,\n   419→\t\tpaths.ContextFileName,\n   420→\t\tpaths.ContentHashFileName,\n   421→\t}\n   422→\n   423→\t// Move each file to archive folder\n   424→\tfor _, filename := range filesToArchive {\n   425→\t\tsrcPath := basePath + filename\n   426→\t\tif entry, exists := entries[srcPath]; exists {\n   427→\t\t\t// Add to archive location\n   428→\t\t\tdstPath := archivePath + filename\n   429→\t\t\tentries[dstPath] = object.TreeEntry{\n   430→\t\t\t\tName: dstPath,\n   431→\t\t\t\tMode: entry.Mode,\n   432→\t\t\t\tHash: entry.Hash,\n   433→\t\t\t}\n   434→\t\t\t// Remove from original location (will be overwritten by new session)\n   435→\t\t\tdelete(entries, srcPath)\n   436→\t\t}\n   437→\t}\n   438→}\n   439→\n   440→// readArchivedSessions reads transcript data from archived session subfolders (1/, 2/, etc.).\n   441→// Returns sessions ordered by folder index (oldest first).\n   442→func (s *GitStore) readArchivedSessions(checkpointTree *object.Tree, sessionCount int) []ArchivedSession {\n   443→\tvar archived []ArchivedSession\n   444→\n   445→\t// Archived sessions are in numbered folders: 1/, 2/, etc.\n   446→\t// The most recent session is at the root level (not archived).\n   447→\t// Session count N means there are N-1 archived sessions.\n   448→\tfor i := 1; i < sessionCount; i++ {\n   449→\t\tfolderName := strconv.Itoa(i)\n   450→\n   451→\t\t// Try to get the archived session subtree\n   452→\t\tsubTree, err := checkpointTree.Tree(folderName)\n   453→\t\tif err != nil {\n   454→\t\t\tcontinue // Folder doesn't exist, skip\n   455→\t\t}\n   456→\n   457→\t\tsession := ArchivedSession{\n   458→\t\t\tFolderIndex: i,\n   459→\t\t}\n   460→\n   461→\t\t// Read metadata to get session ID\n   462→\t\tif metadataFile, fileErr := subTree.File(paths.MetadataFileName); fileErr == nil {\n   463→\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   464→\t\t\t\tvar metadata CommittedMetadata\n   465→\t\t\t\tif jsonErr := json.Unmarshal([]byte(content), &metadata); jsonErr == nil {\n   466→\t\t\t\t\tsession.SessionID = metadata.SessionID\n   467→\t\t\t\t}\n   468→\t\t\t}\n   469→\t\t}\n   470→\n   471→\t\t// Read transcript (try current format first, then legacy)\n   472→\t\tif file, fileErr := subTree.File(paths.TranscriptFileName); fileErr == nil {\n   473→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   474→\t\t\t\tsession.Transcript = []byte(content)\n   475→\t\t\t}\n   476→\t\t} else if file, fileErr := subTree.File(paths.TranscriptFileNameLegacy); fileErr == nil {\n   477→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   478→\t\t\t\tsession.Transcript = []byte(content)\n   479→\t\t\t}\n   480→\t\t}\n   481→\n   482→\t\t// Read prompts\n   483→\t\tif file, fileErr := subTree.File(paths.PromptFileName); fileErr == nil {\n   484→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   485→\t\t\t\tsession.Prompts = content\n   486→\t\t\t}\n   487→\t\t}\n   488→\n   489→\t\t// Only add if we got a transcript\n   490→\t\tif len(session.Transcript) > 0 {\n   491→\t\t\tarchived = append(archived, session)\n   492→\t\t}\n   493→\t}\n   494→\n   495→\treturn archived\n   496→}\n   497→\n   498→// buildCommitMessage constructs the commit message with proper trailers.\n   499→func (s *GitStore) buildCommitMessage(opts WriteCommittedOptions, taskMetadataPath string) string {\n   500→\tvar commitMsg strings.Builder\n   501→\n   502→\t// Use custom subject if provided\n   503→\tif opts.CommitSubject != \"\" {\n   504→\t\tcommitMsg.WriteString(opts.CommitSubject + \"\\n\\n\")\n   505→\t}\n   506→\tcommitMsg.WriteString(fmt.Sprintf(\"Checkpoint: %s\\n\\n\", opts.CheckpointID))\n   507→\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", paths.SessionTrailerKey, opts.SessionID))\n   508→\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", paths.StrategyTrailerKey, opts.Strategy))\n   509→\tif opts.Agent != \"\" {\n   510→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", paths.AgentTrailerKey, opts.Agent))\n   511→\t}\n   512→\tif opts.EphemeralBranch != \"\" {\n   513→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", paths.EphemeralBranchTrailerKey, opts.EphemeralBranch))\n   514→\t}\n   515→\tif taskMetadataPath != \"\" {\n   516→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", paths.MetadataTaskTrailerKey, taskMetadataPath))\n   517→\t}\n   518→\n   519→\treturn commitMsg.String()\n   520→}\n   521→\n   522→// incrementalCheckpointData represents an incremental checkpoint during subagent execution.\n   523→// This mirrors strategy.SubagentCheckpoint but avoids import cycles.\n   524→type incrementalCheckpointData struct {\n   525→\tType      string          `json:\"type\"`\n   526→\tToolUseID string          `json:\"tool_use_id\"`\n   527→\tTimestamp time.Time       `json:\"timestamp\"`\n   528→\tData      json.RawMessage `json:\"data\"`\n   529→}\n   530→\n   531→// taskCheckpointData represents a final task checkpoint.\n   532→// This mirrors strategy.TaskCheckpoint but avoids import cycles.\n   533→type taskCheckpointData struct {\n   534→\tSessionID      string `json:\"session_id\"`\n   535→\tToolUseID      string `json:\"tool_use_id\"`\n   536→\tCheckpointUUID string `json:\"checkpoint_uuid\"`\n   537→\tAgentID        string `json:\"agent_id,omitempty\"`\n   538→}\n   539→\n   540→// ReadCommitted reads a committed checkpoint by ID from the entire/sessions branch.\n   541→// Returns nil, nil if the checkpoint doesn't exist.\n   542→//\n   543→\n   544→func (s *GitStore) ReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error) {\n   545→\t_ = ctx // Reserved for future use\n   546→\n   547→\ttree, err := s.getSessionsBranchTree()\n   548→\tif err != nil {\n   549→\t\treturn nil, nil /