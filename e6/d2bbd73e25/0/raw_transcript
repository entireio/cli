o.EOF {\n   140→\t\t\tbreak\n   141→\t\t}\n   142→\t}\n   143→\n   144→\treturn lines, nil\n   145→}\n   146→\n   147→// PromptResponsePair represents a user prompt and the assistant's responses.\n   148→// Used for extracting all interactions from a transcript.\n   149→type PromptResponsePair struct {\n   150→\tPrompt    string\n   151→\tResponses []string // Multiple responses can occur between tool calls\n   152→\tFiles     []string\n   153→}\n   154→\n   155→// ExtractAllPromptResponses extracts all user prompt and assistant response pairs from a transcript.\n   156→// Returns pairs in chronological order (oldest first).\n   157→// Each pair contains the user's prompt, assistant's text response, and files modified.\n   158→func ExtractAllPromptResponses(transcript []transcriptLine) []PromptResponsePair {\n   159→\tvar pairs []PromptResponsePair\n   160→\n   161→\t// Find all user prompts (messages with string content, not tool results)\n   162→\tvar userIndices []int\n   163→\tfor i, line := range transcript {\n   164→\t\tif line.Type == transcriptTypeUser {\n   165→\t\t\tvar msg userMessage\n   166→\t\t\tif err := json.Unmarshal(line.Message, &msg); err != nil {\n   167→\t\t\t\tcontinue\n   168→\t\t\t}\n   169→\t\t\t// Only count messages with string content (real user prompts)\n   170→\t\t\tif _, ok := msg.Content.(string); ok {\n   171→\t\t\t\tuserIndices = append(userIndices, i)\n   172→\t\t\t} else if arr, ok := msg.Content.([]interface{}); ok {\n   173→\t\t\t\t// Check if array has text blocks (also a real user prompt)\n   174→\t\t\t\tfor _, item := range arr {\n   175→\t\t\t\t\tif m, ok := item.(map[string]interface{}); ok {\n   176→\t\t\t\t\t\tif m[\"type\"] == contentTypeText {\n   177→\t\t\t\t\t\t\tuserIndices = append(userIndices, i)\n   178→\t\t\t\t\t\t\tbreak\n   179→\t\t\t\t\t\t}\n   180→\t\t\t\t\t}\n   181→\t\t\t\t}\n   182→\t\t\t}\n   183→\t\t}\n   184→\t}\n   185→\n   186→\t// For each user prompt, extract the prompt text, following assistant response, and files\n   187→\tfor idx, userIdx := range userIndices {\n   188→\t\t// Determine the range for this prompt's conversation\n   189→\t\tendIdx := len(transcript)\n   190→\t\tif idx < len(userIndices)-1 {\n   191→\t\t\tendIdx = userIndices[idx+1]\n   192→\t\t}\n   193→\n   194→\t\t// Extract prompt text\n   195→\t\tprompt := extractUserPromptAt(transcript, userIdx)\n   196→\t\tif prompt == \"\" {\n   197→\t\t\tcontinue\n   198→\t\t}\n   199→\n   200→\t\t// Extract assistant responses and files from this range\n   201→\t\tslice := transcript[userIdx:endIdx]\n   202→\t\tresponses := extractAssistantResponses(slice)\n   203→\t\tfiles := extractModifiedFiles(slice)\n   204→\n   205→\t\tpairs = append(pairs, PromptResponsePair{\n   206→\t\t\tPrompt:    prompt,\n   207→\t\t\tResponses: responses,\n   208→\t\t\tFiles:     files,\n   209→\t\t})\n   210→\t}\n   211→\n   212→\treturn pairs\n   213→}\n   214→\n   215→// extractUserPromptAt extracts the user prompt at the given index.\n   216→// IDE-injected context tags (like <ide_opened_file>) are stripped from the result.\n   217→func extractUserPromptAt(transcript []transcriptLine, idx int) string {\n   218→\tif idx >= len(transcript) || transcript[idx].Type != transcriptTypeUser {\n   219→\t\treturn \"\"\n   220→\t}\n   221→\n   222→\tvar msg userMessage\n   223→\tif err := json.Unmarshal(transcript[idx].Message, &msg); err != nil {\n   224→\t\treturn \"\"\n   225→\t}\n   226→\n   227→\t// Handle string content\n   228→\tif str, ok := msg.Content.(string); ok {\n   229→\t\treturn textutil.StripIDEContextTags(str)\n   230→\t}\n   231→\n   232→\t// Handle array content (only if it contains text blocks)\n   233→\tif arr, ok := msg.Content.([]interface{}); ok {\n   234→\t\tvar texts []string\n   235→\t\tfor _, item := range arr {\n   236→\t\t\tif m, ok := item.(map[string]interface{}); ok {\n   237→\t\t\t\tif m[\"type\"] == contentTypeText {\n   238→\t\t\t\t\tif text, ok := m[\"text\"].(string); ok {\n   239→\t\t\t\t\t\ttexts = append(texts, text)\n   240→\t\t\t\t\t}\n   241→\t\t\t\t}\n   242→\t\t\t}\n   243→\t\t}\n   244→\t\tif len(texts) > 0 {\n   245→\t\t\treturn textutil.StripIDEContextTags(strings.Join(texts, \"\\n\\n\"))\n   246→\t\t}\n   247→\t}\n   248→\n   249→\treturn \"\"\n   250→}\n   251→\n   252→// extractAssistantResponses collects all assistant text blocks from the given transcript slice.\n   253→// A single prompt can trigger multiple assistant responses interspersed with tool calls.\n   254→func extractAssistantResponses(transcript []transcriptLine) []string {\n   255→\tvar texts []string\n   256→\tfor _, line := range transcript {\n   257→\t\tif line.Type == transcriptTypeAssistant {\n   258→\t\t\tvar msg assistantMessage\n   259→\t\t\tif err := json.Unmarshal(line.Message, &msg); err != nil {\n   260→\t\t\t\tcontinue\n   261→\t\t\t}\n   262→\n   263→\t\t\tfor _, block := range msg.Content {\n   264→\t\t\t\tif block.Type == contentTypeText && block.Text != \"\" {\n   265→\t\t\t\t\ttexts = append(texts, block.Text)\n   266→\t\t\t\t}\n   267→\t\t\t}\n   268→\t\t}\n   269→\t}\n   270→\treturn texts\n   271→}\n   272→\n   273→// extractUserPrompts extracts all user messages from the transcript in order.\n   274→// Only considers messages with string content (not tool results).\n   275→// IDE-injected context tags (like <ide_opened_file>) are stripped from the results.\n   276→func extractUserPrompts(transcript []transcriptLine) []string {\n   277→\tvar prompts []string\n   278→\tfor i := range transcript {\n   279→\t\tif transcript[i].Type != transcriptTypeUser {\n   280→\t\t\tcontinue\n   281→\t\t}\n   282→\t\tvar msg userMessage\n   283→\t\tif err := json.Unmarshal(transcript[i].Message, &msg); err != nil {\n   284→\t\t\tcontinue\n   285→\t\t}\n   286→\n   287→\t\t// Handle string content\n   288→\t\tif str, ok := msg.Content.(string); ok {\n   289→\t\t\tprompts = append(prompts, textutil.StripIDEContextTags(str))\n   290→\t\t\tcontinue\n   291→\t\t}\n   292→\n   293→\t\t// Handle array content (only if it contains text blocks)\n   294→\t\tif arr, ok := msg.Content.([]interface{}); ok {\n   295→\t\t\tvar texts []string\n   296→\t\t\tfor _, item := range arr {\n   297→\t\t\t\tif m, ok := item.(map[string]interface{}); ok {\n   298→\t\t\t\t\tif m[\"type\"] == contentTypeText {\n   299→\t\t\t\t\t\tif text, ok := m[\"text\"].(string); ok {\n   300→\t\t\t\t\t\t\ttexts = append(texts, text)\n   301→\t\t\t\t\t\t}\n   302→\t\t\t\t\t}\n   303→\t\t\t\t}\n   304→\t\t\t}\n   305→\t\t\tif len(texts) > 0 {\n   306→\t\t\t\tprompts = append(prompts, textutil.StripIDEContextTags(strings.Join(texts, \"\\n\\n\")))\n   307→\t\t\t}\n   308→\t\t}\n   309→\t}\n   310→\treturn prompts\n   311→}\n   312→\n   313→// extractLastUserPrompt extracts the last user message from the transcript.\n   314→// Only considers messages with string content (not tool results).\n   315→// IDE-injected context tags (like <ide_opened_file>) are stripped from the result.\n   316→func extractLastUserPrompt(transcript []transcriptLine) string {\n   317→\tprompts := extractUserPrompts(transcript)\n   318→\tif len(prompts) == 0 {\n   319→\t\treturn \"\"\n   320→\t}\n   321→\treturn prompts[len(prompts)-1]\n   322→}\n   323→\n   324→// extractLastAssistantMessage extracts the last text message from the assistant\n   325→func extractLastAssistantMessage(transcript []transcriptLine) string {\n   326→\tfor i := len(transcript) - 1; i >= 0; i-- {\n   327→\t\tif transcript[i].Type == transcriptTypeAssistant {\n   328→\t\t\tvar msg assistantMessage\n   329→\t\t\tif err := json.Unmarshal(transcript[i].Message, &msg); err != nil {\n   330→\t\t\t\tcontinue\n   331→\t\t\t}\n   332→\n   333→\t\t\tfor _, block := range msg.Content {\n   334→\t\t\t\tif block.Type == contentTypeText && block.Text != \"\" {\n   335→\t\t\t\t\treturn block.Text\n   336→\t\t\t\t}\n   337→\t\t\t}\n   338→\t\t}\n   339→\t}\n   340→\treturn \"\"\n   341→}\n   342→\n   343→// findLastUserUUID finds the UUID of the last user message (that has string content)\n   344→func findLastUserUUID(transcript []transcriptLine) string {\n   345→\tfor i := len(transcript) - 1; i >= 0; i-- {\n   346→\t\tif transcript[i].Type == transcriptTypeUser {\n   347→\t\t\tvar msg userMessage\n   348→\t\t\tif err := json.Unmarshal(transcript[i].Message, &msg); err != nil {\n   349→\t\t\t\tcontinue\n   350→\t\t\t}\n   351→\t\t\t// Only count messages with string content (not tool results)\n   352→\t\t\tif _, ok := msg.Content.(string); ok {\n   353→\t\t\t\treturn transcript[i].UUID\n   354→\t\t\t}\n   355→\t\t}\n   356→\t}\n   357→\treturn \"\"\n   358→}\n   359→\n   360→// filterTranscriptAfterUUID returns transcript lines after the given UUID\n   361→func filterTranscriptAfterUUID(transcript []transcriptLine, uuid string) []transcriptLine {\n   362→\tif uuid == \"\" {\n   363→\t\treturn transcript\n   364→\t}\n   365→\n   366→\tfoundIndex := -1\n   367→\tfor i, line := range transcript {\n   368→\t\tif line.UUID == uuid {\n   369→\t\t\tfoundIndex = i\n   370→\t\t\tbreak\n   371→\t\t}\n   372→\t}\n   373→\n   374→\tif foundIndex == -1 || foundIndex == len(transcript)-1 {\n   375→\t\treturn transcript\n   376→\t}\n   377→\n   378→\treturn transcript[foundIndex+1:]\n   379→}\n   380→\n   381→// extractModifiedFiles extracts the list of files modified by tool calls\n   382→func extractModifiedFiles(transcript []transcriptLine) []string {\n   383→\tfileSet := make(map[string]bool)\n   384→\tvar files []string\n   385→\n   386→\tfor _, line := range transcript {\n   387→\t\tif line.Type == transcriptTypeAssistant {\n   388→\t\t\tvar msg assistantMessage\n   389→\t\t\tif err := json.Unmarshal(line.Message, &msg); err != nil {\n   390→\t\t\t\tcontinue\n   391→\t\t\t}\n   392→\n   393→\t\t\tfor _, block := range msg.Content {\n   394→\t\t\t\tif block.Type == \"tool_use\" {\n   395→\t\t\t\t\tisModifyTool := false\n   396→\t\t\t\t\tfor _, name := range claudecode.FileModificationTools {\n   397→\t\t\t\t\t\tif block.Name == name {\n   398→\t\t\t\t\t\t\tisModifyTool = true\n   399→\t\t\t\t\t\t\tbreak\n   400→\t\t\t\t\t\t}\n   401→\t\t\t\t\t}\n   402→\n   403→\t\t\t\t\tif isModifyTool {\n   404→\t\t\t\t\t\tvar input toolInput\n   405→\t\t\t\t\t\tif err := json.Unmarshal(block.Input, &input); err != nil {\n   406→\t\t\t\t\t\t\tcontinue\n   407→\t\t\t\t\t\t}\n   408→\n   409→\t\t\t\t\t\tfile := input.FilePath\n   410→\t\t\t\t\t\tif file == \"\" {\n   411→\t\t\t\t\t\t\tfile = input.NotebookPath\n   412→\t\t\t\t\t\t}\n   413→\n   414→\t\t\t\t\t\tif file != \"\" && !fileSet[file] {\n   415→\t\t\t\t\t\t\tfileSet[file] = true\n   416→\t\t\t\t\t\t\tfiles = append(files, file)\n   417→\t\t\t\t\t\t}\n   418→\t\t\t\t\t}\n   419→\t\t\t\t}\n   420→\t\t\t}\n   421→\t\t}\n   422→\t}\n   423→\n   424→\treturn files\n   425→}\n   426→\n   427→// extractKeyActions extracts key actions from the transcript for context file\n   428→func extractKeyActions(transcript []transcriptLine, maxActions int) []string {\n   429→\tvar keyActions []string\n   430→\n   431→\tfor _, line := range transcript {\n   432→\t\tif line.Type == transcriptTypeAssistant {\n   433→\t\t\tvar msg assistantMessage\n   434→\t\t\tif err := json.Unmarshal(line.Message, &msg); err != nil {\n   435→\t\t\t\tcontinue\n   436→\t\t\t}\n   437→\n   438→\t\t\tfor _, block := range msg.Content {\n   439→\t\t\t\tif block.Type == \"tool_use\" {\n   440→\t\t\t\t\tvar input toolInput\n   441→\t\t\t\t\t_ = json.Unmarshal(block.Input, &input) //nolint:errcheck // Best-effort parsing for display purposes\n   442→\n   443→\t\t\t\t\tdetail := input.Description\n   444→\t\t\t\t\tif detail == \"\" {\n   445→\t\t\t\t\t\tdetail = input.Command\n   446→\t\t\t\t\t}\n   447→\t\t\t\t\tif detail == \"\" {\n   448→\t\t\t\t\t\tdetail = input.FilePath\n   449→\t\t\t\t\t}\n   450→\t\t\t\t\tif detail == \"\" {\n   451→\t\t\t\t\t\tdetail = input.Pattern\n   452→\t\t\t\t\t}\n   453→\n   454→\t\t\t\t\taction := \"- **\" + block.Name + \"**: \" + detail\n  