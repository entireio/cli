nscript reads and parses a Claude Code transcript file.\n    25→// Uses bufio.Reader to handle arbitrarily long lines.\n    26→func parseTranscript(path string) ([]transcriptLine, error) {\n    27→\tfile, err := os.Open(path) //nolint:gosec // Reading from controlled git metadata path\n    28→\tif err != nil {\n    29→\t\treturn nil, err\n    30→\t}\n    31→\tdefer func() { _ = file.Close() }()\n    32→\n    33→\tvar lines []transcriptLine\n    34→\treader := bufio.NewReader(file)\n    35→\n    36→\tfor {\n    37→\t\tlineBytes, err := reader.ReadBytes('\\n')\n    38→\t\tif err != nil && err != io.EOF {\n    39→\t\t\treturn nil, fmt.Errorf(\"failed to read transcript: %w\", err)\n    40→\t\t}\n    41→\n    42→\t\t// Handle empty line or EOF without content\n    43→\t\tif len(lineBytes) == 0 {\n    44→\t\t\tif err == io.EOF {\n    45→\t\t\t\tbreak\n    46→\t\t\t}\n    47→\t\t\tcontinue\n    48→\t\t}\n    49→\n    50→\t\tvar line transcriptLine\n    51→\t\tif err := json.Unmarshal(lineBytes, &line); err == nil {\n    52→\t\t\tlines = append(lines, line)\n    53→\t\t}\n    54→\n    55→\t\tif err == io.EOF {\n    56→\t\t\tbreak\n    57→\t\t}\n    58→\t}\n    59→\n    60→\treturn lines, nil\n    61→}\n    62→\n    63→// parseTranscriptFromLine reads and parses a transcript file starting from a specific line.\n    64→// Uses bufio.Reader to handle arbitrarily long lines.\n    65→// Returns:\n    66→//   - lines: parsed transcript lines from startLine onwards (malformed lines skipped)\n    67→//   - totalLines: total number of lines in the file (including malformed ones)\n    68→//   - error: any error encountered during reading\n    69→//\n    70→// The startLine parameter is 0-indexed (startLine=0 reads from the beginning).\n    71→// This is useful for incremental parsing when you've already processed some lines.\n    72→func parseTranscriptFromLine(path string, startLine int) ([]transcriptLine, int, error) {\n    73→\tfile, err := os.Open(path) //nolint:gosec // path is