ts(ctx context.Context, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, info checkpoint.CommittedInfo, v2Summary *checkpoint.CheckpointSummary) (int, error) {\n1097\t\t// Find sessions missing transcript.jsonl\n1098\t\tvar needsBackfill []int\n1099\t\tfor i, session := range v2Summary.Sessions {\n1100\t\t\tif session.Transcript == \"\" {\n1101\t\t\t\tneedsBackfill = append(needsBackfill, i)\n1102\t\t\t}\n1103\t\t}\n1104\t\n1105\t\tif len(needsBackfill) == 0 {\n1106\t\t\treturn 0, errAlreadyMigrated\n1107\t\t}\n1108\t\n1109\t\tbackfilled := 0\n1110\t\tvar lastAgent string\n1111\t\n1112\t\tfor _, sessionIdx := range needsBackfill {\n1113\t\t\t// Sessions with no agent type recorded in v2 are permanently\n1114\t\t\t// unrecoverable; skip without reading v1 to keep reruns cheap.\n1115\t\t\tif v2Meta, metaErr := v2Store.ReadSessionMetadataAndPrompts(ctx, info.CheckpointID, sessionIdx); metaErr == nil && v2Meta != nil && v2Meta.Metadata.Agent == \"\" {\n1116\t\t\t\tcontinue\n1117\t\t\t}\n1118\t\n1119\t\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, info.CheckpointID, sessionIdx)\n1120\t\t\tif readErr != nil {\n1121\t\t\t\tlogging.Warn(ctx, \"transcript.jsonl backfill: could not read v1 session\",\n1122\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n1123\t\t\t\t\tslog.Int(\"session_index\", sessionIdx),\n1124\t\t\t\t\tslog.String(\"error\", readErr.Error()),\n1125\t\t\t\t)\n1126\t\t\t\tcontinue\n1127\t\t\t}\n1128\t\n1129\t\t\tif content.Metadata.Agent != \"\" {\n1130\t\t\t\tlastAgent = string(content.Metadata.Agent)\n1131\t\t\t}\n1132\t\n1133\t\t\tcompacted := tryCompactTranscript(ctx, content.Transcript, content.Metadata)\n1134\t\t\tif compacted == nil {\n1135\t\t\t\t// tryCompactTranscript already logs for no-agent and compact-error cases;\n1136\t\t\t\t// log the empty-transcript case here.\n1137\t\t\t\tif len(content.Transcript) == 0 {\n1138\t\t\t\t\tlogging.Warn(ctx, \"transcript.jsonl backfill: empty transcript in v1\",\n1139\t\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n1140\t\t\t\t\t\tslog.Int(\"session_index\", sessionIdx),\n1141\t\t\t\t\t)\n1142\t\t\t\t}\n1143\t\t\t\tcontinue\n1144\t\t\t}\n1145\t\n1146\t\t\tupdateErr := v2Store.UpdateCommitted(ctx, checkpoint.UpdateCommittedOptions{\n1147\t\t\t\tCheckpointID:      info.CheckpointID,\n1148\t\t\t\tSessionID:         content.Metadata.SessionID,\n1149\t\t\t\tCompactTranscript: compacted,\n1150\t\t\t})\n1151\t\t\tif updateErr != nil {\n1152\t\t\t\tlogging.Warn(ctx, \"transcript.jsonl backfill: failed to write to v2\",\n1153\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n1154\t\t\t\t\tslog.Int(\"session_index\", sessionIdx),\n1155\t\t\t\t\tslog.String(\"error\", updateErr.Error()),\n1156\t\t\t\t)\n1157\t\t\t\tcontinue\n1158\t\t\t}\n1159\t\n1160\t\t\tbackfilled++\n1161\t\t}\n1162\t\n1163\t\tif backfilled == 0 {\n1164\t\t\tif lastAgent != \"\" {\n1165\t\t\t\treturn 0, fmt.Errorf(\"%w: agent %q\", errTranscriptNotGeneratable, lastAgent)\n1166\t\t\t}\n1167\t\t\treturn 0, fmt.Errorf(\"%w: no agent type in metadata\", errTranscriptNotGeneratable)\n1168\t\t}\n1169\t\n1170\t\treturn backfilled, nil\n1171\t}\n1172\t\n1173\tfunc buildMigrateWriteOpts(content *checkpoint.SessionContent, info checkpoint.CommittedInfo, combinedAttribution *checkpoint.InitialAttribution) checkpoint.WriteCommittedOptions {\n1174\t\tm := content.Metadata\n1175\t\n1176\t\tprompts := checkpoint.SplitPromptContent(content.Prompts)\n1177\t\n1178\t\treturn checkpoint.WriteCommittedOptions{\n1179\t\t\tCheckpointID: info.CheckpointID,\n1180\t\t\tSessionID:    m.SessionID,\n1181\t\t\tCreatedAt:    m.CreatedAt,\n1182\t\t\tStrategy:     m.Strategy,\n1183\t\t\tBranch:       m.Branch,\n1184\t\t\t// content.Transcript comes from persisted checkpoint storage and is\n1185\t\t\t// already redacted.\n1186\t\t\tTranscript:                  redact.AlreadyRedacted(content.Transcript),\n1187\t\t\tPrompts:                     prompts,\n1188\t\t\