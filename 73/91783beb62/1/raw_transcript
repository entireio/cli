etails for skipped, missing, incomplete, or failed checkpoints were logged to %s.\\n\", migrationLogFile)\n138\t\t}\n139\t\n140\t\tfmt.Fprintln(out)\n141\t}\n142\t\n143\tfunc (r *migrateResult) hasLoggedDetails() bool {\n144\t\treturn r.skipped > 0 || r.failed > 0 || r.missingSessions > 0 || r.compactTranscriptSkipped > 0\n145\t}\n146\t\n147\tfunc printV2GenerationRepairResult(out, errOut io.Writer, result *strategy.RepairV2GenerationMetadataResult) {\n148\t\tif result == nil {\n149\t\t\treturn\n150\t\t}\n151\t\n152\t\tfor _, warning := range result.Warnings {\n153\t\t\tfmt.Fprintf(errOut, \"Warning: %s\\n\", warning)\n154\t\t}\n155\t\n156\t\tif len(result.Repaired) == 0 && len(result.Failed) == 0 {\n157\t\t\treturn\n158\t\t}\n159\t\n160\t\tfmt.Fprintf(out, \"Archived generation metadata repair: %d repaired, %d skipped, %d failed\\n\",\n161\t\t\tlen(result.Repaired), len(result.Skipped), len(result.Failed))\n162\t}\n163\t\n164\tvar (\n165\t\terrAlreadyMigrated          = errors.New(\"already migrated\")\n166\t\terrTranscriptNotGeneratable = errors.New(\"transcript.jsonl could not be generated\")\n167\t\terrNoMigratableSessions     = errors.New(\"no migratable v1 sessions\")\n168\t\terrNoFullPackingNeeded      = errors.New(\"no full packing needed\")\n169\t)\n170\t\n171\tconst (\n172\t\tmigrateRemoteName  = \"origin\"\n173\t\tmigrateAuthorName  = \"Entire Migration\"\n174\t\tmigrateAuthorEmail = \"migration@entire.dev\"\n175\t)\n176\t\n177\tvar migrateMaxCheckpointsPerGeneration = checkpoint.DefaultMaxCheckpointsPerGeneration\n178\t\n179\ttype migratedFullCheckpoint struct {\n180\t\tcheckpointID id.CheckpointID\n181\t\tsessions     []migratedFullSession\n182\t\ttaskTrees    map[int][]plumbing.Hash\n183\t}\n184\t\n185\ttype migratedFullSession struct {\n186\t\tsessionIndex int\n187\t\tcontent      *checkpoint.SessionContent\n188\t}\n189\t\n190\tfunc migrateCheckpointsV2(ctx context.Context, repo *git.Repository, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitS