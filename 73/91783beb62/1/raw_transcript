ct) == 0 {\n1276\t\t\treturn 0\n1277\t\t}\n1278\t\n1279\t\tfullLines := bytes.Count(fullCompact, []byte{'\\n'})\n1280\t\tscopedLines := bytes.Count(scopedCompact, []byte{'\\n'})\n1281\t\toffset := fullLines - scopedLines\n1282\t\tif offset < 0 {\n1283\t\t\tlogging.Warn(ctx, \"compact transcript offset was negative during migration, defaulting to 0\",\n1284\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n1285\t\t\t\tslog.Int(\"full_lines\", fullLines),\n1286\t\t\t\tslog.Int(\"scoped_lines\", scopedLines),\n1287\t\t\t)\n1288\t\t\treturn 0\n1289\t\t}\n1290\t\treturn offset\n1291\t}\n1292\t\n1293\tfunc collectTaskMetadataForMigratedFullGeneration(repo *git.Repository, cpID id.CheckpointID, summary *checkpoint.CheckpointSummary, v1ToV2SessionIdx map[int]int) (map[int][]plumbing.Hash, error) {\n1294\t\trootTaskV2SessionIdx, attachRootTasks := latestMigratedV2SessionIndex(v1ToV2SessionIdx)\n1295\t\treturn collectTaskMetadataForMigratedFullGenerationWithRootSession(repo, cpID, summary, v1ToV2SessionIdx, rootTaskV2SessionIdx, attachRootTasks)\n1296\t}\n1297\t\n1298\tfunc collectTaskMetadataForMigratedFullGenerationWithRootSession(\n1299\t\trepo *git.Repository,\n1300\t\tcpID id.CheckpointID,\n1301\t\tsummary *checkpoint.CheckpointSummary,\n1302\t\tv1ToV2SessionIdx map[int]int,\n1303\t\trootTaskV2SessionIdx int,\n1304\t\tattachRootTasks bool,\n1305\t) (map[int][]plumbing.Hash, error) {\n1306\t\tv1Tree, err := resolveV1CheckpointTree(repo, cpID)\n1307\t\tif err != nil {\n1308\t\t\treturn nil, err\n1309\t\t}\n1310\t\n1311\t\ttaskTrees := make(map[int][]plumbing.Hash)\n1312\t\n1313\t\t// Legacy v1 layout stores task metadata at checkpoint root: <cp>/tasks/<tool-use-id>/...\n1314\t\t// Prefer attaching this tree to the latest session in v2.\n1315\t\tif rootTasksTree, rootTasksErr := v1Tree.Tree(\"tasks\"); rootTasksErr == nil {\n1316\t\t\tif attachRootTasks {\n1317\t\t\t\ttaskTrees[rootTaskV2SessionIdx] = append(taskTrees[rootTaskV2SessionIdx], rootTasksTree.Hash)