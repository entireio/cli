eeded):\n234\t\t\t\t\tresult.migrated++\n235\t\t\t\tdefault:\n236\t\t\t\t\tlogging.Error(ctx, \"checkpoint migration failed\",\n237\t\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n238\t\t\t\t\t\tslog.String(\"error\", migrateErr.Error()),\n239\t\t\t\t\t)\n240\t\t\t\t\tresult.failed++\n241\t\t\t\t}\n242\t\t\t\tprogress.Increment()\n243\t\t\t\tcontinue\n244\t\t\t}\n245\t\n246\t\t\tif fullCheckpoint != nil {\n247\t\t\t\tif packErr := packer.add(ctx, *fullCheckpoint); packErr != nil {\n248\t\t\t\t\treturn result, fmt.Errorf(\"failed to pack migrated raw transcripts: %w\", packErr)\n249\t\t\t\t}\n250\t\t\t}\n251\t\t\tresult.migrated++\n252\t\t\tprogress.Increment()\n253\t\t}\n254\t\n255\t\tstopFinalize := startSpinner(progressOut, \"Packing migrated raw transcripts\")\n256\t\tif err := packer.finalize(ctx, !fullCurrentExistsBefore); err != nil {\n257\t\t\tstopFinalize(\"\")\n258\t\t\treturn result, fmt.Errorf(\"failed to pack migrated raw transcripts: %w\", err)\n259\t\t}\n260\t\tstopFinalize(\"\")\n261\t\n262\t\treturn result, nil\n263\t}\n264\t\n265\tfunc logCheckpointMigrationSkip(ctx context.Context, checkpointID id.CheckpointID, reason string, err error) {\n266\t\tlogging.Info(ctx, \"checkpoint migration skipped\",\n267\t\t\tslog.String(\"checkpoint_id\", string(checkpointID)),\n268\t\t\tslog.String(\"reason\", reason),\n269\t\t\tslog.String(\"error\", err.Error()),\n270\t\t)\n271\t}\n272\t\n273\tfunc sortMigratableCheckpoints(checkpoints []checkpoint.CommittedInfo) {\n274\t\tsort.SliceStable(checkpoints, func(i, j int) bool {\n275\t\t\tleft := checkpoints[i].CreatedAt\n276\t\t\tright := checkpoints[j].CreatedAt\n277\t\t\tswitch {\n278\t\t\tcase left.IsZero() && right.IsZero():\n279\t\t\t\treturn checkpoints[i].CheckpointID.String() < checkpoints[j].CheckpointID.String()\n280\t\t\tcase left.IsZero():\n281\t\t\t\treturn false\n282\t\t\tcase right.IsZero():\n283\t\t\t\treturn true\n284\t\t\tcase left.Equal(right):\n285\t\t\t\treturn checkpoints[i].CheckpointID.String() < checkpoints[j].CheckpointID.String()\n286\t\t\tdefault:\n287\t\t\t\treturn left.Before(right)\n288\t\t\t}\n289\t\t})\n290\t}\n291\t\n292\ttype migrateCheckpointOutcome struct {\n293\t\tmissingSessions              int\n294\t\tcompactTranscriptSkipped     bool\n295\t\tbackfilledCompactTranscripts int\n296\t\trepaired                     bool\n297\t}\n298\t\n299\tfunc migrateOneCheckpoint(ctx context.Context, repo *git.Repository, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, info checkpoint.CommittedInfo, force bool) (*migratedFullCheckpoint, migrateCheckpointOutcome, error) {\n300\t\tvar outcome migrateCheckpointOutcome\n301\t\n302\t\texisting, err := v2Store.ReadCommitted(ctx, info.CheckpointID)\n303\t\tif err != nil {\n304\t\t\treturn nil, outcome, fmt.Errorf(\"failed to check v2 for checkpoint %s: %w\", info.CheckpointID, err)\n305\t\t}\n306\t\n307\t\tif existing != nil && !force {\n308\t\t\t// Fast-path: when every session already has a compact transcript and\n309\t\t\t// /full/<n> artifacts, the repair branch below is a guaranteed no-op.\n310\t\t\tif v2CheckpointFullyMigrated(v2Store, info, existing) {\n311\t\t\t\treturn nil, outcome, errAlreadyMigrated\n312\t\t\t}\n313\t\n314\t\t\tfullCheckpoint, queuedFullRepair, repairErr := collectMissingFullCheckpointForPacking(ctx, repo, v1Store, v2Store, info, existing)\n315\t\t\tif repairErr != nil {\n316\t\t\t\treturn nil, outcome, repairErr\n317\t\t\t}\n318\t\t\toutcome.repaired = queuedFullRepair\n319\t\n320\t\t\tcurrentV2, readCurrentErr := v2Store.ReadCommitted(ctx, info.CheckpointID)\n321\t\t\tif readCurrentErr != nil {\n322\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to re-read v2 checkpoint %s: %w\", info.CheckpointID, readCurrentErr)\n323\t\t\t}\n324\t\t\tif currentV2 == nil {\n325\t\t\t\treturn nil, outcome, fmt.Errorf(\"v2 checkpoint %s disappeared during migration\", info.CheckpointID)\n326\t\t\t}\n327\t\n328\t\t\t// Clean up v1-named transcript files (full.jsonl, content_hash.txt) that older\n329\t\t\t// CLI versions may have written to /full/current before the rename to raw_transcript.\n330\t\t\tcleanupV1TranscriptFiles(ctx, repo, v2Store, info.CheckpointID, len(currentV2.Sessions))\n331\t\n332\t\t\tbackfilled, backfillErr := backfillCompactTranscripts(ctx, v1Store, v2Store, info, currentV2)\n333\t\t\toutcome.backfilledCompactTranscripts = backfilled\n334\t\t\tif !queuedFullRepair {\n335\t\t\t\tif backfillErr != nil {\n336\t\t\t\t\treturn nil, outcome, backfillErr\n337\t\t\t\t}\n338\t\t\t\treturn nil, outcome, errNoFullPackingNeeded\n339\t\t\t}\n340\t\t\tif errors.Is(backfillErr, errTranscriptNotGeneratable) {\n341\t\t\t\toutcome.compactTranscriptSkipped = true\n342\t\t\t}\n343\t\t\tif backfillErr != nil &&\n344\t\t\t\t!errors.Is(backfillErr, errAlreadyMigrated) &&\n345\t\t\t\t!errors.Is(backfillErr, errTranscriptNotGeneratable) {\n346\t\t\t\treturn nil, outcome, backfillErr\n347\t\t\t}\n348\t\t\treturn fullCheckpoint, outcome, nil\n349\t\t}\n350\t\n351\t\tif existing != nil && force {\n352\t\t\tif pruneErr := pruneV2CheckpointForForce(ctx, repo, v2Store, info.CheckpointID); pruneErr != nil {\n353\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to reset existing v2 checkpoint %s before force migration: %w\", info.CheckpointID, pruneErr)\n354\t\t\t}\n355\t\t}\n356\t\n357\t\tsummary, err := v1Store.ReadCommitted(ctx, info.CheckpointID)\n358\t\tif err != nil {\n359\t\t\treturn nil, outcome, fmt.Errorf(\"failed to read v1 summary: %w\", err)\n360\t\t}\n361\t\tif summary == nil {\n362\t\t\treturn nil, outcome, fmt.Errorf(\"v1 checkpoint %s has no summary\", info.CheckpointID)\n363\t\t}\n364\t\n365\t\tcompactFailed := false\n366\t\tshouldCopyTaskMetadata := false\n367\t\tskippedMissingSessions := 0\n368\t\tmigratedSessions := 0\n369\t\tv1ToV2SessionIdx := make(map[int]int, len(summary.Sessions))\n370\t\tfullCheckpoint := &migratedFullCheckpoint{\n371\t\t\tcheckpointID: info.CheckpointID,\n372\t\t}\n373\t\n374\t\tfor sessionIdx := range len(summary.Sessions) {\n375\t\t\tcontent, skipped, readErr := readV1SessionForMigration(ctx, v1Store, info.CheckpointID, sessionIdx)\n376\t\t\tif skipped {\n377\t\t\t\tskippedMissingSessions++\n378\t\t\t\toutcome.missingSessions++\n379\t\t\t\tcontinue\n380\t\t\t}\n381\t\t\tif readErr != nil {\n382\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to read v1 session %d: %w\", sessionIdx, readErr)\n383\t\t\t}\n384\t\t\tif content.Metadata.IsTask {\n385\t\t\t\tshouldCopyTaskMetadata = true\n386\t\t\t}\n387\t\n388\t\t\topts := buildMigrateWriteOpts(content, info, summary.CombinedAttribution)\n389\t\n390\t\t\tcompacted := tryCompactTranscript(ctx, content.Transcript, content.Metadata)\n391\t\t\tif compacted != nil {\n392\t\t\t\topts.CompactTranscript = compacted\n393\t\t\t\topts.CompactTranscriptStart = computeCompactOffset(ctx, content.Transcript, compacted, content.Metadata)\n394\t\t\t} else if len(content.Transcript) > 0 {\n395\t\t\t\tcompactFailed = true\n396\t\t\t}\n397\t\n398\t\t\tmainOpts := opts\n399\t\t\tmainOpts.Transcript = redact.AlreadyRedacted(nil)\n400\t\t\tv2SessionIdx, writeErr := v2Store.WriteCommittedWithSessionIndex(ctx, mainOpts)\n401\t\t\tif writeErr != nil {\n402\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to write v2 session %d: %w\", sessionIdx, writeErr)\n403\t\t\t}\n404\t\t\tv1ToV2SessionIdx[sessionIdx] = v2SessionIdx\n405\t\t\tfullCheckpoint.sessions = append(fullCheckpoint.sessions, migratedFullSession{\n406\t\t\t\tsessionIndex: v2SessionIdx,\n407\t\t\t\tcontent:      content,\n408\t\t\t})\n409\t\t\tmigratedSessions++\n410\t\t}\n411\t\n412\t\tif migratedSessions == 0 {\n413\t\t\treturn nil, outcome, fmt.Errorf(\"%w: v1 metadata lists %d session(s), but no transcript/session content exists for any of them\", errNoMigratableSessions, len(summary.Sessions))\n414\t\t}\n415\t\n416\t\tif shouldCopyTaskMetadata {\n417\t\t\ttaskTrees, taskErr := collectTaskMetadataForMigratedFullGeneration(repo, info.CheckpointID, summary, v1ToV2SessionIdx)\n418\t\t\tif taskErr != nil {\n419\t\t\t\tlogging.Warn(ctx, \"failed to copy task metadata to v2\",\n420\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n421\t\t\t\t\tslog.String(\"error\", taskErr.Error()),\n422\t\t\t\t)\n423\t\t\t} else {\n424\t\t\t\tfullCheckpoint.taskTrees = taskTrees\n425\t\t\t}\n426\t\t}\n427\t\n428\t\tif compactFailed {\n429\t\t\toutcome.compactTranscriptSkipped = true\n430\t\t\tlogging.Warn(ctx, \"compact transcript not generated during checkpoint migration\",\n431\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n432\t\t\t\tslog.Int(\"migrated_sessions\", migratedSessions),\n433\t\t\t)\n434\t\t}\n435\t\tif skippedMissingSessions > 0 {\n436\t\t\tlogging.Warn(ctx, \"checkpoint migration skipped v1 sessions with missing transcript/session content\",\n437\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n438\t\t\t\tslog.Int(\"missing_sessions\", skippedMissingSessions),\n439\t\t\t)\n440\t\t}\n441\t\n442\t\treturn fullCheckpoint, outcome, nil\n443\t}\n444\t\n445\t// generationPacker buffers up to batchSize migrated checkpoints and flushes\n446\t// them into a single archived /full/<n> ref each time the buffer fills, so\n447\t// peak heap stays bounded by one batch worth of transcripts instead of\n448\t// growing with the total v1 list. The next generation number is resolved\n449\t// lazily on first flush so force-migration prune steps that remove existing\n450\t// archived refs are visible before we pick the next slot.\n451\ttype generationPacker struct {\n452\t\trepo           *git.Repository\n453\t\tv2Store        *checkpoint.V2GitStore\n454\t\tbatchSize      int\n455\t\tnextGeneration int\n456\t\tnumbered       bool\n457\t\tpending        []migratedFullCheckpoint\n458\t\tflushed        bool\n459\t}\n460\t\n461\tfunc newGenerationPacker(repo *git.Repository, v2Store *checkpoint.V2GitStore) *generationPacker {\n462\t\tbatchSize := migrateMaxCheckpointsPerGeneration\n463\t\tif batchSize <= 0 {\n464\t\t\tbatchSize = checkpoint.DefaultMaxCheckpointsPerGeneration\n465\t\t}\n466\t\treturn &generationPacker{\n467\t\t\trepo:      repo,\n468\t\t\tv2Store:   v2Store,\n469\t\t\tbatchSize: batchSize,\n470\t\t}\n471\t}\n472\t\n473\tfunc (p *generationPacker) add(ctx context.Context, cp migratedFullCheckpoint) error {\n474\t\tp.pending = append(p.pending, cp)\n475\t\tif len(p.pending) >= p.batchSize {\n476\t\t\treturn p.flush(ctx)\n477\t\t}\n478\t\treturn nil\n479\t}\n480\t\n481\tfunc (p *generationPacker) flush(ctx context.Context) error {\n482\t\tif len(p.pending) == 0 {\n483\t\t\treturn nil\n484\t\t}\n485\t\tif !p.numbered {\n486\t\t\tnext, err := p.v2Store.NextGenerationNumber()\n487\t\t\tif err != nil {\n488\t\t\t\treturn fmt.Errorf(\"list archived v2 generations: %w\", err)\n489\t\t\t}\n490\t\t\tp.nextGeneration = next\n491\t\t\tp.numbered = true\n492\t\t}\n493\t\trefName := plumbing.ReferenceName(fmt.Sprintf(\"%s%013d\", paths.V2FullRefPrefix, p.nextGeneration))\n494\t\tif err := writeMigratedFullGeneration(ctx, p.repo, refName, p.pending); err != nil {\n495\t\t\treturn err\n496\t\t}\n497\t\tp.nextGeneration++\n498\t\tp.pending = nil\n499\t\tp.flushed = true\n500\t\treturn nil\n501\t}\n502\t\n503\tfunc (p *generationPacker) finalize(ctx context.Context, ensureEmptyCurrent bool) error {\n504\t\tif err := p.flush(ctx); err != nil {\n505\t\t\treturn err\n506\t\t}\n507\t\tif p.flushed && ensureEmptyCurrent {\n508\t\t\treturn ensureEmptyV2FullCurrent(ctx, p.repo)\n509\t\t}\n510\t\treturn nil\n511\t}\n512\t\n513\tfunc writeMigratedFullGeneration(ctx context.Context, repo *git.Repository, refName plumbing.ReferenceName, checkpoints []migratedFullCheckpoint) error {\n514\t\tentries := make(map[string]object.TreeEntry)\n515\t\n516\t\tfor _, cp := range checkpoints {\n517\t\t\tfor _, session := range cp.sessions {\n518\t\t\t\tif err := writeMigratedFullSessionEntries(ctx, repo, cp, session, entries); err != nil {\n519\t\t\t\t\treturn fmt.Errorf(\"write full session entries for checkpoint %s session %d: %w\", cp.checkpointID, session.sessionIndex, err)\n520\t\t\t\t}\n521\t\t\t}\n522\t\t}\n523\t\n524\t\ttreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, entries)\n525\t\tif err != nil {\n526\t\t\treturn fmt.Errorf(\"build migrated generation tree: %w\", err)\n527\t\t}\n528\t\n529\t\tv2Store := checkpoint.NewV2GitStore(repo, migrateRemoteName)\n530\t\t// Prefer the in-memory transcripts we already loaded during migration —\n531\t\t// it produces the same first-event/last-event range as walking the just-\n532\t\t// written /full/<n> tree, but skips the redundant git blob reads that\n533\t\t// dominated runtime when this called ComputeGenerationTimestampsFromTrees.\n534\t\tgen, found := checkpoint.AggregateTranscriptTimestamps(migratedTranscripts(checkpoints))\n535\t\tif !found {\n536\t\t\tvar err error\n537\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n538\t\t\tif err != nil {\n539\t\t\t\treturn fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n540\t\t\t}\n541\t\t}\n542\t\tif !found {\n543\t\t\tgen, found = generationMetadataFromMigratedSessions(checkpoints)\n544\t\t}\n545\t\tif !found {\n546\t\t\treturn fmt.Errorf(\"no timestamps found for migrated generation %s\", refName)\n547\t\t}\n548\t\n549\t\ttreeHash, err = v2Store.AddGenerationJSONToTree(treeHash, gen)\n550\t\tif err != nil {\n551\t\t\treturn fmt.Errorf(\"add generation metadata: %w\", err)\n552\t\t}\n553\t\n554\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, treeHash, plumbing.ZeroHash,\n555\t\t\tfmt.Sprintf(\"Archive migrated generation: %s\\n\", refName),\n556\t\t\tmigrateAuthorName, migrateAuthorEmail)\n557\t\tif err != nil {\n558\t\t\treturn fmt.Errorf(\"create migrated generation commit: %w\", err)\n559\t\t}\n560\t\n561\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n562\t\t\treturn fmt.Errorf(\"update migrated generation ref %s: %w\", refName, err)\n563\t\t}\n564\t\treturn nil\n565\t}\n566\t\n567\t// migratedTranscripts returns the in-memory transcript bytes for every session\n568\t// already loaded during this migration run, in iteration order.\n569\tfunc migratedTranscripts(checkpoints []migratedFullCheckpoint) [][]byte {\n570\t\tvar transcripts [][]byte\n571\t\tfor _, cp := range checkpoints {\n572\t\t\tfor _, session := range cp.sessions {\n573\t\t\t\tif len(session.content.Transcript) == 0 {\n574\t\t\t\t\tcontinue\n575\t\t\t\t}\n576\t\t\t\ttranscripts = append(transcripts, session.content.Transcript)\n577\t\t\t}\n578\t\t}\n579\t\treturn transcripts\n580\t}\n581\t\n582\tfunc generationMetadataFromMigratedSessions(checkpoints []migratedFullCheckpoint) (checkpoint.GenerationMetadata, bool) {\n583\t\tvar gen checkpoint.GenerationMetadata\n584\t\tfound := false\n585\t\tfor _, cp := range checkpoints {\n586\t\t\tfor _, session := range cp.sessions {\n587\t\t\t\tcheckpoint.MergeGenerationTime(&gen, &found, session.content.Metadata.CreatedAt)\n588\t\t\t}\n589\t\t}\n590\t\treturn gen, found\n591\t}\n592\t\n593\tfunc writeMigratedFullSessionEntries(ctx context.Context, repo *git.Repository, cp migratedFullCheckpoint, session migratedFullSession, entries map[string]object.TreeEntry) error {\n594\t\tsessionPath := fmt.Sprintf(\"%s/%d/\", cp.checkpointID.Path(), session.sessionIndex)\n595\t\ttranscript := session.content.Transcript\n596\t\n597\t\tchunks, err := agent.ChunkTranscript(ctx, transcript, session.content.Metadata.Agent)\n598\t\tif err != nil {\n599\t\t\treturn fmt.Errorf(\"chunk transcript: %w\", err)\n600\t\t}\n601\t\tfor i, chunk := range chunks {\n602\t\t\tblobHash, blobErr := checkpoint.CreateBlobFromContent(repo, chunk)\n603\t\t\tif blobErr != nil {\n604\t\t\t\treturn fmt.Errorf(\"create transcript blob: %w\", blobErr)\n605\t\t\t}\n606\t\t\tpath := sessionPath + agent.ChunkFileName(paths.V2RawTranscriptFileName, i)\n607\t\t\tentries[path] = object.TreeEntry{\n608\t\t\t\tName: path,\n609\t\t\t\tMode: filemode.Regular,\n610\t\t\t\tHash: blobHash,\n611\t\t\t}\n612\t\t}\n613\t\n614\t\thashPath := sessionPath + paths.V2RawTranscriptHashFileName\n615\t\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n616\t\thashBlob, err := checkpoint.CreateBlobFromContent(repo, []byte(contentHash))\n617\t\tif err != nil {\n618\t\t\treturn fmt.Errorf(\"create transcript hash blob: %w\", err)\n619\t\t}\n620\t\tentries[hashPath] = object.TreeEntry{\n621\t\t\tName: hashPath,\n622\t\t\tMode: filemode.Regular,\n623\t\t\tHash: hashBlob,\n624\t\t}\n625\t\n626\t\tfor _, taskTreeHash := range cp.taskTrees[session.sessionIndex] {\n627\t\t\ttaskTree, treeErr := repo.TreeObject(taskTreeHash)\n628\t\t\tif treeErr != nil {\n629\t\t\t\treturn fmt.Errorf(\"read task metadata tree: %w\", treeErr)\n630\t\t\t}\n631\t\t\ttaskEntries := make(map[string]object.TreeEntry)\n632\t\t\tif flattenErr := checkpoint.FlattenTree(repo, taskTree, sessionPath+\"tasks\", taskEntries); flattenErr != nil {\n633\t\t\t\treturn fmt.Errorf(\"flatten task metadata tree: %w\", flattenErr)\n634\t\t\t}\n635\t\t\tfor path, entry := range taskEntries {\n636\t\t\t\tif _, exists := entries[path]; exists {\n637\t\t\t\t\tcontinue\n638\t\t\t\t}\n639\t\t\t\tentries[path] = entry\n640\t\t\t}\n641\t\t}\n642\t\n643\t\treturn nil\n644\t}\n645\t\n646\tfunc ensureEmptyV2FullCurrent(ctx context.Context, repo *git.Repository) error {\n647\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n648\t\tif _, err := repo.Reference(refName, true); err == nil {\n649\t\t\treturn nil\n650\t\t}\n651\t\n652\t\temptyTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, map[string]object.TreeEntry{})\n653\t\tif err != nil {\n654\t\t\treturn fmt.Errorf(\"build empty v2 full/current tree: %w\", err)\n655\t\t}\n656\t\n657\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, emptyTreeHash, plumbing.ZeroHash,\n658\t\t\t\"Start generation\\n\",\n659\t\t\tmigrateAuthorName, migrateAuthorEmail)\n660\t\tif err != nil {\n661\t\t\treturn fmt.Errorf(\"create empty v2 full/current commit: %w\", err)\n662\t\t}\n663\t\n664\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n665\t\t\treturn fmt.Errorf(\"update %s: %w\", refName, err)\n666\t\t}\n667\t\treturn nil\n668\t}\n669\t\n670\tfunc readV1SessionForMigration(ctx context.Context, v1Store *checkpoint.GitStore, checkpointID id.CheckpointID, sessionIdx int) (*checkpoint.SessionContent, bool, error) {\n671\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, checkpointID, sessionIdx)\n672\t\tif readErr != nil {\n673\t\t\tif errors.Is(readErr, checkpoint.ErrNoTranscript) || errors.Is(readErr, checkpoint.ErrCheckpointNotFound) {\n674\t\t\t\twarnMissingV1Session(ctx, checkpointID, sessionIdx, readErr)\n675\t\t\t\treturn nil, true, nil\n676\t\t\t}\n677\t\t\treturn nil, false, fmt.Errorf(\"read v1 session content: %w\", readErr)\n678\t\t}\n679\t\treturn content, false, nil\n680\t}\n681\t\n682\tfunc warnMissingV1Session(ctx context.Context, checkpointID id.CheckpointID, sessionIdx int, err error) {\n683\t\tlogging.Warn(ctx, \"skipping v1 session with missing transcript during checkpoint migration\",\n684\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n685\t\t\tslog.Int(\"session_index\", sessionIdx),\n686\t\t\tslog.String(\"error\", err.Error()),\n687\t\t)\n688\t}\n689\t\n690\tfunc pruneV2CheckpointForForce(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID) error {\n691\t\tfor _, refName := range []plumbing.ReferenceName{\n692\t\t\tplumbing.ReferenceName(paths.V2MainRefName),\n693\t\t\tplumbing.ReferenceName(paths.V2FullCurrentRefName),\n694\t\t} {\n695\t\t\tif err := pruneV2CheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n696\t\t\t\treturn err\n697\t\t\t}\n698\t\t}\n699\t\n700\t\tarchived, err := v2Store.ListArchivedGenerations()\n701\t\tif err != nil {\n702\t\t\treturn fmt.Errorf(\"failed to list archived v2 generations while pr