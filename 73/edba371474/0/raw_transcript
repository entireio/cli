n51\t// UpdateSubtree replaces or creates a subtree at the given path within an existing tree.\n52\t// It walks the tree path, replacing only the entries along the modified path.\n53\t// All sibling entries at each level retain their original hashes — no re-reading needed.\n54\t//\n55\t// pathSegments is the directory path split into segments (e.g., [\"a3\", \"b2c4d5e6f7\"]).\n56\t// newEntries are the files/dirs to place at the leaf directory.\n57\t// Returns the new root tree hash.\n58\tfunc UpdateSubtree(\n59\t\trepo *git.Repository,\n60\t\trootTreeHash plumbing.Hash,\n61\t\tpathSegments []string,\n62\t\tnewEntries []object.TreeEntry,\n63\t\topts UpdateSubtreeOptions,\n64\t) (plumbing.Hash, error) {\n65\t\tif len(pathSegments) == 0 {\n66\t\t\treturn buildLeafTree(repo, rootTreeHash, newEntries, opts)\n67\t\t}\n68\t\n69\t\t// Read the current tree at this level\n70\t\t// Get all entries in the tree and add them to the currentEntries slice\n71\t\tvar currentEntries []object.TreeEntry\n72\t\tif rootTreeHash != plumbing.ZeroHash {\n73\t\t\ttree, err := repo.TreeObject(rootTreeHash)\n74\t\t\tif err != nil {\n75\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to read tree %s: %w\", rootTreeHash, err)\n76\t\t\t}\n77\t\t\tcurrentEntries = tree.Entries\n78\t\t}\n79\t\n80\t\ttargetDir := pathSegments[0]\n81\t\tremainingPath := pathSegments[1:]\n82\t\n83\t\t// Find the existing subtree entry for targetDir\n84\t\tvar existingSubtreeHash plumbing.Hash\n85\t\tfound := false\n86\t\tfor _, entry := range currentEntries {\n87\t\t\tif entry.Name == targetDir && entry.Mode == filemode.Dir {\n88\t\t\t\texistingSubtreeHash = entry.Hash\n89\t\t\t\tfound = true\n90\t\t\t\tbreak\n91\t\t\t}\n92\t\t}\n93\t\n94\t\t// Recurse into the subtree\n95\t\tnewSubtreeHash, err := UpdateSubtree(repo, existingSubtreeHash, remainingPath, newEntries, opts)\n96\t\tif err != nil {\n97\t\t\treturn plumbing.ZeroHash, err\n98\t\t}\n99\t\n100\t\t// Build a new tree at this level with the updated subtree