{"parentUuid":"e453e3aa-eee8-4d34-a64e-014b0a3134f4","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/ninawork/entire/devenv/cli/cmd/entire/cli/checkpoint/v2_store.go","snippet":"1\tpackage checkpoint\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"log/slog\"\n7\t\t\"os/exec\"\n8\t\t\"strings\"\n9\t\t\"sync\"\n10\t\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n12\t\n13\t\t\"github.com/go-git/go-git/v6\"\n14\t\t\"github.com/go-git/go-git/v6/plumbing\"\n15\t\t\"github.com/go-git/go-git/v6/plumbing/object\"\n16\t)\n17\t\n18\t// V2GitStore provides checkpoint storage operations for the v2 ref layout.\n19\t// It writes to two custom refs under refs/entire/:\n20\t//   - /main: permanent metadata + compact transcripts\n21\t//   - /full/current: active generation of raw transcripts\n22\t//\n23\t// V2GitStore is separate from GitStore (v1) to keep concerns isolated\n24\t// and simplify future v1 removal. It composes GitStore internally to\n25\t// reuse ref-agnostic entry-building helpers (tree surgery, session\n26\t// indexing, summary aggregation).\n27\ttype V2GitStore struct {\n28\t\trepo *git.Repository\n29\t\tgs   *GitStore // shared entry-building helpers (same package)\n30\t\n31\t\t// maxCheckpointsPerGeneration overrides the rotation threshold for testing.\n32\t\t// Zero means use DefaultMaxCheckpointsPerGeneration.\n33\t\tmaxCheckpointsPerGeneration int\n34\t\n35\t\t// FetchRemote is the git remote used for fetch-on-demand operations (e.g.,\n36\t\t// fetching /full/* refs during entire resume). Defaults to \"origin\".\n37\t\t// Set to the checkpoint remote URL when checkpoint_remote is configured.\n38\t\tFetchRemote string\n39\t\n40\t\t// blobFetcher fetches missing blobs by hash. When set, read paths wrap\n41\t\t// trees with FetchingTree so missing blobs are auto-recovered (and the\n42\t\t// cat-file fallback covers partial-clone-filtered blobs that go-git's\n43\t\t// storer can't see).\n44\t\tblobFetcher BlobFetchFunc\n45\t\n46\t\tcommonDirOnce sync.Once\n47\t\tcommonDir     string\n48\t\tcommonDirErr  error\n49\t}\n50\t\n51\t// maxCheckpoints returns the effective rotation threshold.\n52\tfunc (s *V2GitStore) maxCheckpoints() int {\n53\t\tif s.maxCheckpointsPerGeneration > 0 {\n54\t\t\treturn s.maxCheckpointsPerGeneration\n55\t\t}\n56\t\treturn DefaultMaxCheckpointsPerGeneration\n57\t}\n58\t\n59\t// NewV2GitStore creates a new v2 checkpoint store backed by the given git repository.\n60\t// fetchRemote is the git remote used for fetch-on-demand operations (e.g., fetching\n61\t// /full/* refs during entire resume). Pass \"origin\" or the checkpoint remote URL.\n62\tfunc NewV2GitStore(repo *git.Repository, fetchRemote string) *V2GitStore {\n63\t\tif fetchRemote == \"\" {\n64\t\t\tfetchRemote = \"origin\"\n65\t\t}\n66\t\treturn &V2GitStore{\n67\t\t\trepo:        repo,\n68\t\t\tgs:          &GitStore{repo: repo},\n69\t\t\tFetchRemote: fetchRemote,\n70\t\t}\n71\t}\n72\t\n73\t// SetBlobFetcher configures the store to automatically fetch missing blobs\n74\t// on demand when reading from /main trees. Mirrors GitStore.SetBlobFetcher.\n75\t// Required for reads against partial-clone repos where blobs may be absent\n76\t// or invisible to go-git's cached packfile index.\n77\tfunc (s *V2GitStore) SetBlobFetcher(f BlobFetchFunc) {\n78\t\ts.blobFetcher = f\n79\t}\n80\t\n81\t// wrapWithFetcher returns the input tree wrapped in a FetchingTree using\n82\t// the configured blob fetcher. Callers use the returned tree's File() /\n83\t// Tree() methods instead of the raw go-git ones so missing blobs are\n84\t// recovered via the fetcher and the cat-file fallback.\n85\tfunc (s *V2GitStore) wrapWithFetcher(ctx context.Context, tree *object.Tree) *FetchingTree {\n86\t\treturn NewFetchingTree(ctx, tree, s.repo.Storer, s.blobFetcher)\n87\t}\n88\t\n89\t// ensureRef ensures that a custom ref exists, creating an orphan commit\n90\t// with an empty tree if it does not.\n91\tfunc (s *V2GitStore) ensureRef(ctx context.Context, refName plumbing.ReferenceName) error {\n92\t\t_, err := s.repo.Reference(refName, true)\n93\t\tif err == nil {\n94\t\t\treturn nil // Already exists\n95\t\t}\n96\t\n97\t\temptyTreeHash, err := BuildTreeFromEntries(ctx, s.repo, make(map[string]object.TreeEntry))\n98\t\tif err != nil {\n99\t\t\treturn fmt.Errorf(\"failed to build empty tree: %w\", err)\n100\t\t}\n101\t\n102\t\tauthorName, authorEmail := GetGitAuthorFromRepo(s.repo)\n103\t\tcommitHash, err := CreateCommit(ctx, s.repo, emptyTreeHash, plumbing.ZeroHash, \"Initialize v2 ref\", authorName, authorEmail)\n104\t\tif err != nil {\n105\t\t\treturn fmt.Errorf(\"failed to create initial commit: %w\", err)\n106\t\t}\n107\t\n108\t\tref := plumbing.NewHashReference(refName, commitHash)\n109\t\tif err := s.repo.Storer.SetReference(ref); err != nil {\n110\t\t\treturn fmt.Errorf(\"failed to set ref %s: %w\", refName, err)\n111\t\t}\n112\t\n113\t\treturn nil\n114\t}\n115\t\n116\t// GetRefState returns the parent commit hash and root tree hash for a ref.\n117\t// Falls back to `git rev-parse <hash>^{tree}` when go-git can't load the\n118\t// commit object — same partial-clone / stale-packfile-cache reason as\n119\t// readTreeEntriesViaCLI in parse_tree.go.\n120\tfunc (s *V2GitStore) GetRefState(refName plumbing.ReferenceName) (parentHash, treeHash plumbing.Hash, err error) {\n121\t\tref, err := s.repo.Reference(refName, true)\n122\t\tif err != nil {\n123\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"ref %s not found: %w\", refName, err)\n124\t\t}\n125\t\n126\t\tcommit, err := s.repo.CommitObject(ref.Hash())\n127\t\tif err != nil {\n128\t\t\tcliTreeHash, cliErr := commitTreeHashViaCLI(context.Background(), ref.Hash())\n129\t\t\tif cliErr != nil {\n130\t\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get commit for ref %s: %w (CLI fallback also failed: %w)\", refName, err, cliErr)\n131\t\t\t}\n132\t\t\tlogging.Warn(context.Background(), \"GetRefState: go-git commit read failed, used git rev-parse fallback\",\n133\t\t\t\tslog.String(\"ref\", refName.String()),\n134\t\t\t\tslog.String(\"commit\", ref.Hash().String()[:12]),\n135\t\t\t\tslog.String(\"gogit_error\", err.Error()),\n136\t\t\t)\n137\t\t\treturn ref.Hash(), cliTreeHash, nil\n138\t\t}\n139\t\n140\t\treturn ref.Hash(), commit.TreeHash, nil\n141\t}\n142\t\n143\t// commitTreeHashViaCLI resolves the tree hash of a commit via\n144\t// `git rev-parse <hash>^{tree}`. See GetRefState for the rationale.\n145\tfunc commitTreeHashViaCLI(ctx context.Context, commitHash plumbing.Hash) (plumbing.Hash, error) {\n146\t\tcmd := exec.CommandContext(ctx, \"git\", \"rev-parse\", commitHash.String()+\"^{tree}\")\n147\t\toutput, err := cmd.Output()\n148\t\tif err != nil {\n149\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"git rev-parse %s^{tree}: %w\", commitHash.String()[:12], err)\n150\t\t}\n151\t\thex := strings.TrimSpace(string(output))\n152\t\tif hex == \"\" {\n153\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"git rev-parse %s^{tree}: empty output\", commitHash.String()[:12])\n154\t\t}\n155\t\treturn plumbing.NewHash(hex), nil\n156\t}\n157\t\n158\t// updateRef creates a new commit on a ref with the given tree, updating the ref to point to it.\n159\tfunc (s *V2GitStore) updateRef(ctx context.Context, refName plumbing.ReferenceName, treeHash, parentHash plumbing.Hash, message, authorName, authorEmail string) error {\n160\t\tcommitHash, err := CreateCommit(ctx, s.repo, treeHash, parentHash, message, authorName, authorEmail)\n161\t\tif err != nil {\n162\t\t\treturn fmt.Errorf(\"failed to create commit: %w\", err)\n163\t\t}\n164\t\n165\t\tref := plumbing.NewHashReference(refName, commitHash)\n166\t\tif err := s.repo.Storer.SetReference(ref); err != nil {\n167\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n168\t\t}\n169\t\n170\t\treturn nil\n171\t}"},"type":"attachment","uuid":"7350e351-cccf-4059-8b3d-bf7550a5d736","timestamp":"2026-05-11T23:08:13.975Z","userType