s(out, \"q/Esc/Enter\") {\n   459\t\t\tt.Errorf(\"post-finish footer should list q/Esc/Enter as exit keys:\\n%s\", out)\n   460\t\t}\n   461\t}\n   462\t\n   463\t// TestTUIModel_CtrlCMarksAgentsCancelling pins that the first Ctrl+C while\n   464\t// agents are still running sets m.cancelling and renderRow reflects an\n   465\t// in-flight cancellation indicator (distinct from the terminal Cancelled\n   466\t// state).\n   467\tfunc TestTUIModel_CtrlCMarksAgentsCancelling(t *testing.T) {\n   468\t\tt.Parallel()\n   469\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n   470\t\t// Stamp runStart so the row is in the running branch of renderRow.\n   471\t\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Started{}})\n   472\t\tm = mustModel(t, updated)\n   473\t\tm.termWidth = 120\n   474\t\n   475\t\t// Before Ctrl+C the running row should say \"running\".\n   476\t\tif status := m.renderRow(m.rows[0]); !strings.Contains(status, \"running\") {\n   477\t\t\tt.Fatalf(\"setup: expected running indicator pre-Ctrl+C; got %q\", status)\n   478\t\t}\n   479\t\n   480\t\tupdated, _ = m.Update(testCtrlKey('c'))\n   481\t\tm = mustModel(t, updated)\n   482\t\tif !m.cancelling {\n   483\t\t\tt.Fatal(\"expected m.cancelling=true after first Ctrl+C\")\n   484\t\t}\n   485\t\n   486\t\tgot := m.renderRow(m.rows[0])\n   487\t\tif strings.Contains(got, \"running\") {\n   488\t\t\tt.Errorf(\"renderRow should drop the 'running' indicator once cancelling; got %q\", got)\n   489\t\t}\n   490\t\tif !strings.Contains(got, \"cancel\") {\n   491\t\t\tt.Errorf(\"renderRow should show a cancelling indicator; got %q\", got)\n   492\t\t}\n   493\t}\n   494\t\n   495\t// TestTUIModel_FooterDuringCancellation pins that the dashboard footer changes\n   496\t// while a cancel is in flight (cancelling && !finished) to signal the user\n   497\t// that draining is in progress and a second Ctrl+C will force quit.\n   498\tfunc TestTUIModel_FooterDuringCancellation(t *test