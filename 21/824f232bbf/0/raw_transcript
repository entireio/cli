{"timestamp":"2026-05-12T02:23:35.902Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_Ej0m7KgUKgrCA53nLsDcTCtn","output":"Chunk ID: 16937c\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 4452\nOutput:\n     1\t// Package review — see env.go for package-level rationale.\n     2\t//\n     3\t// tui_model.go provides reviewTUIModel, the Bubble Tea Model for the\n     4\t// review dashboard. The model renders a per-agent status table\n     5\t// during the run and supports Ctrl+O drill-in mode for inspecting one agent's\n     6\t// live event buffer on the alt screen.\n     7\tpackage review\n     8\t\n     9\timport (\n    10\t\t\"context\"\n    11\t\t\"fmt\"\n    12\t\t\"strconv\"\n    13\t\t\"strings\"\n    14\t\t\"sync\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"charm.land/bubbles/v2/spinner\"\n    18\t\t\"charm.land/bubbles/v2/viewport\"\n    19\t\ttea \"charm.land/bubbletea/v2\"\n    20\t\t\"charm.land/lipgloss/v2\"\n    21\t\n    22\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n    23\t\t\"github.com/entireio/cli/cmd/entire/cli/stringutil\"\n    24\t)\n    25\t\n    26\t// agentRow holds per-agent live state during the TUI run.\n    27\ttype agentRow struct {\n    28\t\tname     string\n    29\t\tstatus   reviewtypes.AgentStatus\n    30\t\trunStart time.Time          // stamped on first event from this agent\n    31\t\trunEnd   time.Time          // stamped on Finished/RunError event\n    32\t\ttokens   reviewtypes.Tokens // cumulative\n    33\t\tpreview  string             // latest AssistantText preview, capped by display width\n    34\t\tbuffer   []reviewtypes.Event\n    35\t\terr      error\n    36\t}\n    37\t\n    38\t// agentEventMsg is sent to the Bubble Tea program when an agent emits an event.\n    39\ttype agentEventMsg struct {\n    40\t\tagent string\n    41\t\tev    reviewtypes.Event\n    42\t}\n    43\t\n    44\t// runFinishedMsg is sent when the orchestrator calls RunFinished.\n    45\ttype runFinishedMsg struct {\n    46\t\tsummary reviewtypes.RunSummary\n    47\t}\n    48\t\n    49\t// tickMsg triggers spinner and duration column updates.\n    50\ttype tickMsg time.Time\n    51\t\n    52\t// reviewTUIModel is the Bubble Tea model for the review dashboard.\n    53\ttype reviewTUIModel struct {\n    54\t\trows       []agentRow\n    55\t\trowIdx     map[string]int // agent name → row index (O(1) lookup)\n    56\t\tdetailMode bool\n    57\t\tdetailIdx  int // which agent is shown in drill-in\n    58\t\t// detail is the pager backing the drill-in body. Width/Height are kept\n    59\t\t// in sync with termWidth/termHeight (minus header+footer). Scroll\n    60\t\t// position is internal state; AtBottom drives auto-tail.\n    61\t\tdetail viewport.Model\n    62\t\n    63\t\tcancel     context.CancelFunc\n    64\t\tcancelOnce *sync.Once\n    65\t\n    66\t\tspinner    spinner.Model\n    67\t\ttermWidth  int\n    68\t\ttermHeight int\n    69\t\n    70\t\tfinished bool\n    71\t\tsummary  reviewtypes.RunSummary\n    72\t\n    73\t\t// cancelling tracks whether a Ctrl+C-initiated cancellation is in flight.\n    74\t\t// Set true on the first Ctrl+C (in tandem with cancelOnce firing the shared\n    75\t\t// CancelFunc); the dashboard switches to a \"cancelling\" indicator and the\n    76\t\t// footer offers a force-quit hint. A second Ctrl+C while cancelling=true\n    77\t\t// force-quits without waiting for agents to drain.\n    78\t\tcancelling bool\n    79\t}\n    80\t\n    81\t// newReviewTUIModel builds an initial model pre-populated with one row per\n    82\t// agent. cancel is the shared CancelFunc; it must be the same one passed to\n    83\t// NewTUISink.\n    84\tfunc newReviewTUIModel(agents []string, cancel context.CancelFunc) reviewTUIModel {\n    85\t\tsp := spinner.New()\n    86\t\tsp.Spinner = spinner.Dot\n    87\t\tsp.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n    88\t\n    89\t\trows := make([]agentRow, len(agents))\n    90\t\trowIdx := make(map[string]int, len(agents))\n    91\t\tfor i, name := range agents {\n    92\t\t\trows[i] = agentRow{\n    93\t\t\t\tname:   name,\n    94\t\t\t\tstatus: reviewtypes.AgentStatusUnknown,\n    95\t\t\t}\n    96\t\t\trowIdx[name] = i\n    97\t\t}\n    98\t\t// Seed viewport with defaults that match termWidth/termHeight so an\n    99\t\t// immediate Ctrl+O before any WindowSizeMsg still renders.\n   100\t\tconst (\n   101\t\t\tdefaultTermWidth  = 80\n   102\t\t\tdefaultTermHeight = 24\n   103\t\t)\n   104\t\tvp := viewport.New(\n   105\t\t\tviewport.WithWidth(defaultTermWidth),\n   106\t\t\tviewport.WithHeight(defaultTermHeight-2),\n   107\t\t)\n   108\t\treturn reviewTUIModel{\n   109\t\t\trows:       rows,\n   110\t\t\trowIdx:     rowIdx,\n   111\t\t\tdetail:     vp,\n   112\t\t\tcancel:     cancel,\n   113\t\t\tcancelOnce: &sync.Once{},\n   114\t\t\tspinner:    sp,\n   115\t\t\ttermWidth:  defaultTermWidth,\n   116\t\t\ttermHeight: defaultTermHeight,\n   117\t\t}\n   118\t}\n   119\t\n   120\t// tickCmd schedules the next tick for duration/spinner refresh.\n   121\tfunc tickCmd() tea.Cmd {\n   122\t\treturn tea.Tick(100*time.Millisecond, func(t time.Time) tea.Msg {\n   123\t\t\treturn tickMsg(t)\n   124\t\t})\n   125\t}\n   126\t\n   127\t// Init returns the initial spinner tick command.\n   128\tfunc (m reviewTUIModel) Init() tea.Cmd {\n   129\t\treturn tea.Batch(m.spinner.Tick, tickCmd())\n   130\t}\n   131\t\n   132\t// Update handles all incoming messages.\n   133\tfunc (m reviewTUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n   134\t\tswitch msg := msg.(type) {\n   135\t\tcase agentEventMsg:\n   136\t\t\treturn m.handleAgentEvent(msg)\n   137\t\n   138\t\tcase runFinishedMsg:\n   139\t\t\tm.finished = true\n   140\t\t\tm.summary = msg.summary\n   141\t\t\t// Sync each row's status from the orchestrator's summary. The\n   142\t\t\t// in-stream events (Finished / RunError) update status as they\n   143\t\t\t// arrive, but the orchestrator's classifyStatus has access to\n   144\t\t\t// process-level signals (Wait error, ctx cancellation) that the\n   145\t\t\t// event stream never surfaces. Without this sync, an agent that\n   146\t\t\t// the orchestrator classified Cancelled (Ctrl+C path, no Finished\n   147\t\t\t// emitted) or Failed (process exit non-zero, no Finished emitted)\n   148\t\t\t// would still render as \"running\" in the final frame.\n   149\t\t\t//\n   150\t\t\t// Preserve any already-set status from the event stream — if the\n   151\t\t\t// stream said Failed (RunError), the summary may say Succeeded\n   152\t\t\t// (process exit 0); RunError stickiness wins. Only overwrite when\n   153\t\t\t// the row is still in AgentStatusUnknown.\n   154\t\t\tnow := time.Now()\n   155\t\t\tfor i, run := range msg.summary.AgentRuns {\n   156\t\t\t\tif i >= len(m.rows) {\n   157\t\t\t\t\tbreak\n   158\t\t\t\t}\n   159\t\t\t\tif m.rows[i].status == reviewtypes.AgentStatusUnknown {\n   160\t\t\t\t\tm.rows[i].status = run.Status\n   161\t\t\t\t}\n   162\t\t\t\tif m.rows[i].runEnd.IsZero() && !m.rows[i].runStart.IsZero() {\n   163\t\t\t\t\tm.rows[i].runEnd = now\n   164\t\t\t\t}\n   165\t\t\t}\n   166\t\t\treturn m, nil\n   167\t\n   168\t\tcase tickMsg:\n   169\t\t\tvar spinCmd tea.Cmd\n   170\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n   171\t\t\treturn m, tea.Batch(spinCmd, tickCmd())\n   172\t\n   173\t\tcase spinner.TickMsg:\n   174\t\t\tvar spinCmd tea.Cmd\n   175\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n   176\t\t\treturn m, spinCmd\n   177\t\n   178\t\tcase tea.WindowSizeMsg:\n   179\t\t\tm.termWidth = msg.Width\n   180\t\t\tm.termHeight = msg.Height\n   181\t\t\tm.detail.SetWidth(m.detailViewportWidth())\n   182\t\t\tm.detail.SetHeight(m.detailViewportHeight())\n   183\t\t\tm = m.refreshDetailContent()\n   184\t\t\treturn m, nil\n   185\t\n   186\t\tcase tea.KeyPressMsg:\n   187\t\t\treturn m.handleKey(msg)\n   188\t\n   189\t\tcase tea.MouseWheelMsg, tea.MouseClickMsg, tea.MouseReleaseMsg, tea.MouseMotionMsg:\n   190\t\t\t// Mouse events: only meaningful inside the drill-in viewport, which\n   191\t\t\t// reads tea.MouseWheelMsg natively (see bubbles/v2/viewport.go:696).\n   192\t\t\t// Without this delegation the events arrive at the Program (because\n   193\t\t\t// View.MouseMode = MouseModeCellMotion is set during detail mode)\n   194\t\t\t// but fall through Update unhandled — the user sees no scroll\n   195\t\t\t// response to the wheel.\n   196\t\t\tif m.detailMode {\n   197\t\t\t\tvar cmd tea.Cmd\n   198\t\t\t\tm.detail, cmd = m.detail.Update(msg)\n   199\t\t\t\treturn m, cmd\n   200\t\t\t}\n   201\t\t\treturn m, nil\n   202\t\t}\n   203\t\treturn m, nil\n   204\t}\n   205\t\n   206\t// detailViewportWidth returns the viewport's width, mirroring termWidth.\n   207\tfunc (m reviewTUIModel) detailViewportWidth() int {\n   208\t\tif m.termWidth < 1 {\n   209\t\t\treturn 1\n   210\t\t}\n   211\t\treturn m.termWidth\n   212\t}\n   213\t\n   214\t// detailViewportHeight returns the viewport's body height, reserving one line\n   215\t// for the header and one for the footer.\n   216\tfunc (m reviewTUIModel) detailViewportHeight() int {\n   217\t\th := m.termHeight - 2\n   218\t\tif h < 1 {\n   219\t\t\treturn 1\n   220\t\t}\n   221\t\treturn h\n   222\t}\n   223\t\n   224\t// refreshDetailContent re-renders the focused agent's events into the\n   225\t// viewport. It preserves auto-tail: if the viewport was sitting at the bottom\n   226\t// (or has no scrollable content), it jumps to the new bottom after the content\n   227\t// is replaced; otherwise the user's scroll position is left untouched.\n   228\t//\n   229\t// reviewTUIModel uses value receivers throughout (matching the Bubble Tea\n   230\t// idiom of returning an updated tea.Model from Update); the viewport is\n   231\t// mutated in place on the returned copy and the caller assigns the result\n   232\t// back.\n   233\tfunc (m reviewTUIModel) refreshDetailContent() reviewTUIModel {\n   234\t\tif len(m.rows) == 0 || m.detailIdx < 0 || m.detailIdx >= len(m.rows) {\n   235\t\t\tm.detail.SetContent(\"\")\n   236\t\t\treturn m\n   237\t\t}\n   238\t\twasAtBottom := m.detail.AtBottom()\n   239\t\tlines := buildEventLines(m.rows[m.detailIdx].buffer, m.detailViewportWidth())\n   240\t\tm.detail.SetContentLines(lines)\n   241\t\tif wasAtBottom {\n   242\t\t\tm.detail.GotoBottom()\n   243\t\t}\n   244\t\treturn m\n   245\t}\n   246\t\n   247\t// handleAgentEvent processes an agentEventMsg, updating the relevant row.\n   248\tfunc (m reviewTUIModel) handleAgentEvent(msg agentEventMsg) (tea.Model, tea.Cmd) {\n   249\t\tidx, ok := m.rowIdx[msg.agent]\n   250\t\tif !ok {\n   251\t\t\treturn m, nil\n   252\t\t}\n   253\t\trow := &m.rows[idx]\n   254\t\n   255\t\t// Stamp run-start on the first event from this agent (per-row, not\n   256\t\t// TUI-start; prevents inflated durations for late-starting agents).\n   257\t\tif row.runStart.IsZero() {\n   258\t\t\trow.runStart = time.Now()\n   259\t\t}\n   260\t\n   261\t\trow.buffer = append(row.buffer, msg.ev)\n   262\t\n   263\t\tswitch e := msg.ev.(type) {\n   264\t\tcase reviewtypes.Started:\n   265\t\t\t// runStart already set; no other state update needed.\n   266\t\tcase reviewtypes.AssistantText:\n   267\t\t\tcollapsed := stringutil.CollapseWhitespace(sanitizeDisplayText(e.Text))\n   268\t\t\trow.preview = truncateDisplayWidth(collapsed, 80)\n   269\t\tcase reviewtypes.Tokens:\n   270\t\t\trow.tokens = e // cumulative: overwrite, not sum\n   271\t\tcase reviewtypes.Finished:\n   272\t\t\t// RunError is sticky: if a prior RunError event already classified\n   273\t\t\t// this row as Failed, a subsequent Finished{Success: true} must NOT\n   274\t\t\t// flip it back to Succeeded. CU3's parser-fix-loop guarantees that\n   275\t\t\t// RunError + Finished{Success:false} both accompany torn streams;\n   276\t\t\t// matching that contract here keeps the TUI consistent with\n   277