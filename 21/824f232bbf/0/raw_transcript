etailMode {\n   365\t\t\tt.Error(\"expected Ctrl+O post-finish to enter detail mode\")\n   366\t\t}\n   367\t\t// Ctrl+O must NOT quit post-finish.\n   368\t\tif cmd != nil {\n   369\t\t\tif msg := cmd(); msg != nil {\n   370\t\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n   371\t\t\t\t\tt.Error(\"Ctrl+O post-finish must not produce a quit command\")\n   372\t\t\t\t}\n   373\t\t\t}\n   374\t\t}\n   375\t}\n   376\t\n   377\t// TestTUIModel_PostFinishQuitsOnExplicitKeys pins that q, Esc, Enter, and Ctrl+C\n   378\t// each produce tea.QuitMsg when finished and in dashboard mode.\n   379\tfunc TestTUIModel_PostFinishQuitsOnExplicitKeys(t *testing.T) {\n   380\t\tt.Parallel()\n   381\t\tcases := []struct {\n   382\t\t\tname string\n   383\t\t\tkey  tea.KeyPressMsg\n   384\t\t}{\n   385\t\t\t{\"q\", testKey('q')},\n   386\t\t\t{\"Esc\", testKey(tea.KeyEscape)},\n   387\t\t\t{\"Enter\", testKey(tea.KeyEnter)},\n   388\t\t\t{\"Ctrl+C\", testCtrlKey('c')},\n   389\t\t}\n   390\t\tfor _, tc := range cases {\n   391\t\t\tt.Run(tc.name, func(t *testing.T) {\n   392\t\t\t\tt.Parallel()\n   393\t\t\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n   394\t\t\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n   395\t\t\t\tm = mustModel(t, updated)\n   396\t\n   397\t\t\t\t_, cmd := m.Update(tc.key)\n   398\t\t\t\tif cmd == nil {\n   399\t\t\t\t\tt.Fatalf(\"expected a command for explicit-exit key %q post-finish\", tc.name)\n   400\t\t\t\t}\n   401\t\t\t\tmsg := cmd()\n   402\t\t\t\tif _, ok := msg.(tea.QuitMsg); !ok {\n   403\t\t\t\t\tt.Errorf(\"expected tea.QuitMsg for key %q post-finish, got %T\", tc.name, msg)\n   404\t\t\t\t}\n   405\t\t\t})\n   406\t\t}\n   407\t}\n   408\t\n   409\t// TestTUIModel_PostFinishIgnoresRandomKeys pins that non-exit keys (e.g. 'x',\n   410\t// arrow keys) do NOT quit when finished on the dashboard. They fall through to\n   411\t// normal handling instead of the old any-key-quits shortcut.\n   412\tfunc TestTUIModel_