itHook(false) // not silent - show output during setup\n   812→\tif err != nil {\n   813→\t\treturn fmt.Errorf(\"failed to install git hook: %w\", err)\n   814→\t}\n   815→\treturn nil\n   816→}\n   817→\n   818→// newSetupGitHookCmd creates the standalone git-hook setup command\n   819→func newSetupGitHookCmd() *cobra.Command {\n   820→\tcmd := &cobra.Command{\n   821→\t\tUse:    \"git-hook\",\n   822→\t\tShort:  \"Install git hook for session context trailers\",\n   823→\t\tHidden: true, // Hidden as it's mainly for testing\n   824→\t\tRunE: func(_ *cobra.Command, _ []string) error {\n   825→\t\t\treturn setupGitHook()\n   826→\t\t},\n   827→\t}\n   828→\n   829→\treturn cmd\n   830→}\n   831→\n   832→// shellCompletionComment is the comment preceding the completion line\n   833→const shellCompletionComment = \"# Entire CLI shell completion\"\n   834→\n   835→// promptShellCompletion offers to add shell completion to the user's rc file.\n   836→// Only prompts if completion is not already configured.\n   837→func promptShellCompletion(w io.Writer) error {\n   838→\t// Get user's home directory\n   839→\thome, err := os.UserHomeDir()\n   840→\tif err != nil {\n   841→\t\t//nolint:nilerr // Skip silently if we can't determine home - not a fatal error\n   842→\t\treturn nil\n   843→\t}\n   844→\n   845→\t// Determine shell and rc file\n   846→\tshell := os.Getenv(\"SHELL\")\n   847→\tvar rcFile string\n   848→\tvar completionLine string\n   849→\n   850→\tswitch {\n   851→\tcase strings.Contains(shell, \"zsh\"):\n   852→\t\trcFile = filepath.Join(home, \".zshrc\")\n   853→\t\tcompletionLine = \"source <(entire completion zsh)\"\n   854→\tcase strings.Contains(shell, \"bash\"):\n   855→\t\trcFile = filepath.Join(home, \".bashrc\")\n   856→\t\tcompletionLine = \"source <(entire completion bash)\"\n   857→\tdefault:\n   858→\t\treturn nil // Unsupported shell, skip silently\n   859→\t}\n   860→\n   861→\t// Check if completion is already configured\n   862→\tif isCompletionConfigured(rcFile) {\n   863→\t\treturn nil // Already configured, skip silently\n   864→\t}\n   865→\n   866→\t// Prompt user with select-style picker (matching other prompts)\n   867→\tvar selected string\n   868→\tform := NewAccessibleForm(\n   869→\t\thuh.NewGroup(\n   870→\t\t\thuh.NewSelect[string]().\n   871→\t\t\t\tTitle(\"Enable shell completion?\").\n   872→\t\t\t\tOptions(\n   873→\t\t\t\t\thuh.NewOption(\"Yes\", \"yes\"),\n   874→\t\t\t\t\thuh.NewOption(\"No\", \"no\"),\n   875→\t\t\t\t).\n   876→\t\t\t\tValue(&selected),\n   877→\t\t),\n   878→\t)\n   879→\n   880→\tif err := form.Run(); err != nil {\n   881→\t\t//nolint:nilerr // User cancelled - not a fatal error, just skip\n   882→\t\treturn nil\n   883→\t}\n   884→\n   885→\tif selected != \"yes\" {\n   886→\t\treturn nil\n   887→\t}\n   888→\n   889→\t// Append completion to rc file\n   890→\tif err := appendShellCompletion(rcFile, completionLine); err != nil {\n   891→\t\treturn fmt.Errorf(\"failed to update %s: %w\", rcFile, err)\n   892→\t}\n   893→\n   894→\tfmt.Fprintf(w, \"✓ Shell completion added to %s\\n\", rcFile)\n   895→\tfmt.Fprintln(w, \"  Run `source \"+rcFile+\"` or restart your shell to activate\")\n   896→\n   897→\treturn nil\n   898→}\n   899→\n   900→// isCompletionConfigured checks if shell completion is already in the rc file.\n   901→func isCompletionConfigured(rcFile string) bool {\n   902→\t//nolint:gosec // G304: rcFile is constructed from home dir + known filename, not user input\n   903→\tcontent, err := os.ReadFile(rcFile)\n   904→\tif err != nil {\n   905→\t\treturn false // File doesn't exist or can't read, treat as not configured\n   906→\t}\n   907→\treturn strings.Contains(string(content), \"entire completion\")\n   908→}\n   909→\n   910→// appendShellCompletion adds the completion line to the rc file.\n   911→func appendShellCompletion(rcFile, completionLine string) error {\n   912→\t//nolint:gosec // G302: Shell rc files need 0644 for user readability\n   913→\tf, err := os.OpenFile(rcFile, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)\n   914→\tif err != nil {\n   915→\t\treturn fmt.Errorf(\"opening file: %w\", err)\n   916→\t}\n   917→\tdefer f.Close()\n   918→\n   919→\t// Add newline, comment, and completion line\n   920→\t_, err = f.WriteString(\"\\n\" + shellCompletionComment + \"\\n\" + completionLine + \"\\n\")\n   921→\tif err != nil {\n   922→\t\treturn fmt.Errorf(\"writing completion: %w\", err)\n   923→\t}\n   924→\treturn nil\n   925→}\n   926→\n   927→// setupShellCompletionNonInteractive adds shell completion without prompting.\n   928→// Used when --setup-shell flag is provided.\n   929→func setupShellCompletionNonInteractive(w io.Writer) error {\n   930→\t// Get user's home directory\n   931→\thome, err := os.UserHomeDir()\n   932→\tif err != nil {\n   933→\t\treturn fmt.Errorf(\"cannot determine home directory: %w\", err)\n   934→\t}\n   935→\n   936→\t// Determine shell and rc file\n   937→\tshell := os.Getenv(\"SHELL\")\n   938→\tvar rcFile string\n   939→\tvar completionLine string\n   940→\n   941→\tswitch {\n   942→\tcase strings.Contains(shell, \"zsh\"):\n   943→\t\trcFile = filepath.Join(home, \".zshrc\")\n   944→\t\tcompletionLine = \"source <(entire completion zsh)\"\n   945→\tcase strings.Contains(shell, \"bash\"):\n   946→\t\trcFile = filepath.Join(home, \".bashrc\")\n   947→\t\tcompletionLine = \"source <(entire completion bash)\"\n   948→\tdefault:\n   949→\t\treturn fmt.Errorf(\"unsupported shell: %s (supported: zsh, bash)\", shell)\n   950→\t}\n   951→\n   952→\t// Check if completion is already configured\n   953→\tif isCompletionConfigured(rcFile) {\n   954→\t\tfmt.Fprintf(w, \"✓ Shell completion already configured in %s\\n\", rcFile)\n   955→\t\treturn nil\n   956→\t}\n   957→\n   958→\t// Append completion to rc file\n   959→\tif err := appendShellCompletion(rcFile, completionLine); err != nil {\n   960→\t\treturn fmt.Errorf(\"failed to update %s: %w\", rcFile, err)\n   961→\t}\n   96