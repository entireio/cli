se manual-commit or auto-commit)\", strategyName)\n   664→\t\t}\n   665→\t\tsettings.Strategy = internalStrategy\n   666→\t}\n   667→\n   668→\t// Handle telemetry for non-interactive mode\n   669→\t// Note: if telemetry is nil (not configured), it defaults to disabled\n   670→\tif !telemetry || os.Getenv(\"ENTIRE_TELEMETRY_OPTOUT\") != \"\" {\n   671→\t\tf := false\n   672→\t\tsettings.Telemetry = &f\n   673→\t}\n   674→\n   675→\tif err := SaveEntireSettings(settings); err != nil {\n   676→\t\treturn fmt.Errorf(\"failed to save settings: %w\", err)\n   677→\t}\n   678→\n   679→\t// Install git hooks (always reinstall to ensure they're up-to-date)\n   680→\tif _, err := strategy.InstallGitHook(true); err != nil {\n   681→\t\treturn fmt.Errorf(\"failed to install git hooks: %w\", err)\n   682→\t}\n   683→\n   684→\t// Let the strategy handle its own setup requirements (creates entire/sessions branch, etc.)\n   685→\tstrat, err := strategy.Get(settings.Strategy)\n   686→\tif err != nil {\n   687→\t\treturn fmt.Errorf(\"failed to get strategy: %w\", err)\n   688→\t}\n   689→\tif err := strat.EnsureSetup(); err != nil {\n   690→\t\treturn fmt.Errorf(\"failed to setup strategy: %w\", err)\n   691→\t}\n   692→\n   693→\treturn nil\n   694→}\n   695→\n   696→// validateSetupFlags checks that --local and --project flags are not both specified.\n   697→func validateSetupFlags(useLocal, useProject bool) error {\n   698→\tif useLocal && useProject {\n   699→\t\treturn errors.New(\"cannot specify both --project and --local\")\n   700→\t}\n   701→\treturn nil\n   702→}\n   703→\n   704→// determineSettingsTarget decides whether to write to settings.local.json based on:\n   705→// - Whether settings.json already exists\n   706→// - The --local and --project flags\n   707→// Returns (useLocal, showNotification).\n   708→func determineSettingsTarget(entireDir string, useLocal, useProject bool) (bool, bool) {\n   709→\t// Explicit --local flag always uses local settings\n   710→\tif useLocal {\n   711→\t\treturn true, false\n   712→\t}\n   713→\n   714→\t// Explicit --project flag always uses project settings\n   715→\tif useProject {\n   716→\t\treturn false, false\n   717→\t}\n   718→\n   719→\t// No flags specified - check if settings file exists\n   720→\tsettingsPath := filepath.Join(entireDir, paths.SettingsFileName)\n   721→\tif _, err := os.Stat(settingsPath); err == nil {\n   722→\t\t// Settings file exists - auto-redirect to local with notification\n   723→\t\treturn true, true\n   724→\t}\n   725→\n   726→\t// Settings file doesn't exist - create it\n   727→\treturn false, false\n   728→}\n   729→\n   730→// Settings target options for interactive prompt\n   731→const (\n   732→\tsettingsTargetProject = \"project\"\n   733→\tsettingsTargetLocal   = \"local\"\n   734→)\n   735→\n   736→// promptSettingsTarget interactively asks the user where to save settings\n   737→// when settings.json already exists and no flags were provided.\n   738→// Returns (useLocal, error).\n   739→func promptSettingsTarget(entireDir string, useLocal, useProject bool) (bool, error) {\n   740→\t// Explicit --local flag always uses local settings\n   741→\tif useLocal {\n   742→\t\treturn true, nil\n   743→\t}\n   744→\n   745→\t// Explicit --project flag always uses project settings\n   746→\tif useProject {\n   747→\t\treturn false, nil\n   748→\t}\n   749→\n   750→\t// Check if settings file exists\n   751→\tsettingsPath := filepath.Join(entireDir, paths.SettingsFileName)\n   752→\tif _, err := os.Stat(settingsPath); os.IsNotExist(err) {\n   753→\t\t// Settings file doesn't exist - create it (no prompt needed)\n   754→\t\treturn false, nil\n   755→\t}\n   756→\n   757→\t// Settings file exists - prompt user\n   758→\tvar selected string\n   759→\tform := NewAccessibleForm(\n   760→\t\thuh.NewGroup(\n   761→\t\t\thuh.NewSelect[string]().\n   762→\t\t\t\tTitle(\"Project settings already exist. Where should settings be saved?\").\n   763→\t\t\t\tOptions(\n 