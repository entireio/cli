{"parentUuid":"6df91443-abfd-4d17-8b75-4e1b61244166","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/tmp/test-cursor-xfold.sh","snippet":"1\t#!/usr/bin/env bash\n2\t# Manual E2E test: cursor export/import across different folders.\n3\t#\n4\t# Scenario:\n5\t#   1. Folder A: entire enable, run cursor turn, commit (condense to metadata branch)\n6\t#   2. Folder B: clone A, fetch checkpoints branch, entire resume\n7\t#   3. Verify cursor-agent --resume in B finds the session and loads prior state\n8\t#\n9\t# Proves the CheckpointRestorer path works when cwd changes (different md5 hash\n10\t# and different slug than where the session was originally recorded).\n11\t#\n12\t# Prereqs:\n13\t#   - cursor-agent installed and authenticated\n14\t#   - tmux\n15\t#   - run from the cli repo root (where /cmd/entire lives)\n16\t\n17\tset -euo pipefail\n18\t\n19\tREPO_ROOT=$(git rev-parse --show-toplevel)\n20\tENTIRE_BIN=/tmp/entire\n21\tSUFFIX=$$\n22\tA=/tmp/cursor-xfold-A-$SUFFIX\n23\tB=/tmp/cursor-xfold-B-$SUFFIX\n24\t\n25\tcleanup() {\n26\t  tmux kill-server 2>/dev/null || true\n27\t  # Wipe cursor caches for these test dirs so reruns are clean\n28\t  for dir in \"$A\" \"$B\"; do\n29\t    [ -z \"$dir\" ] && continue\n30\t    real=${dir/#\\/tmp/\\/private\\/tmp}\n31\t    hash=$(printf \"%s\" \"$real\" | md5 2>/dev/null | awk '{print $NF}')\n32\t    slug=$(printf \"%s\" \"${real#/}\" | sed 's|/|-|g')\n33\t    rm -rf \"$HOME/.cursor/chats/$hash\" \"$HOME/.cursor/projects/$slug\" 2>/dev/null || true\n34\t  done\n35\t  rm -rf \"$A\" \"$B\"\n36\t}\n37\t# trap cleanup EXIT\n38\t\n39\tsay() { printf \"\\n\\033[1;34m==> %s\\033[0m\\n\" \"$*\"; }\n40\t\n41\twrite_hooks() {\n42\t  # Override .cursor/hooks.json to call our test binary directly instead of\n43\t  # relying on PATH (cursor may spawn hooks with a pruned env on some systems).\n44\t  cat >\"$1/.cursor/hooks.json\" <<EOF\n45\t{\"hooks\":{\n46\t  \"beforeSubmitPrompt\":[{\"command\":\"$ENTIRE_BIN hooks cursor before-submit-prompt\"}],\n47\t  \"preCompact\":[{\"command\":\"$ENTIRE_BIN hooks cursor pre-compact\"}],\n48\t  \"sessionEnd\":[{\"command\":\"$ENTIRE_BIN hooks cursor session-end\"}],\n49\t  \"sessionStart\":[{\"command\":\"$ENTIRE_BIN hooks cursor session-start\"}],\n50\t  \"stop\":[{\"command\":\"$ENTIRE_BIN hooks cursor stop\"}],\n51\t  \"subagentStart\":[{\"command\":\"$ENTIRE_BIN hooks cursor subagent-start\"}],\n52\t  \"subagentStop\":[{\"command\":\"$ENTIRE_BIN hooks cursor subagent-stop\"}]\n53\t},\"version\":1}\n54\tEOF\n55\t}\n56\t\n57\twait_for_prompt() {\n58\t  # Poll the tmux pane until the cursor-agent prompt is idle (no \"ctrl+c to stop\")\n59\t  # AND the expected marker appears on screen. $1=tmux session, $2=marker, $3=max iters\n60\t  local sess=$1 marker=$2 max=${3:-20}\n61\t  for i in $(seq 1 \"$max\"); do\n62\t    sleep 3\n63\t    local s\n64\t    s=$(tmux capture-pane -t \"$sess\" -p -S -80)\n65\t    if echo \"$s\" | grep -q \"$marker\" && ! echo \"$s\" | grep -q \"ctrl+c to stop\"; then\n66\t      echo \"  done (iteration $i)\"\n67\t      return 0\n68\t    fi\n69\t  done\n70\t  echo \"  TIMEOUT waiting for: $marker\"\n71\t  return 1\n72\t}\n73\t\n74\taccept_trust_if_needed() {\n75\t  local sess=$1\n76\t  sleep 3\n77\t  local screen\n78\t  screen=$(tmux capture-pane -t \"$sess\" -p)\n79\t  if echo \"$screen\" | grep -q \"Trust this workspace\"; then\n80\t    tmux send-keys -t \"$sess\" a\n81\t    sleep 4\n82\t  fi\n83\t}\n84\t\n85\tsend_prompt() {\n86\t  local sess=$1 text=$2 marker=$3\n87\t  tmux send-keys -t \"$sess\" \"$text\"\n88\t  sleep 1\n89\t  tmux send-keys -t \"$sess\" Enter\n90\t  wait_for_prompt \"$sess\" \"$marker\"\n91\t}\n92\t\n93\t# ---------------------------------------------------------------------------\n94\tsay \"Building entire binary\"\n95\tcd \"$REPO_ROOT\"\n96\tgo build -o \"$ENTIRE_BIN\" ./cmd/entire\n97\t\"$ENTIRE_BIN\" --version | head -1\n98\t\n99\t# ---------------------------------------------------------------------------\n100\tsay \"Folder A: init repo + entire enable --agent cursor\"\n101\trm -rf \"$A\" \"$B\"\n102\tmkdir -p \"$A\"\n103\tcd \"$A\"\n104\tgit init -q\n105\tgit config user.email t@t\n106\tgit config user.name t\n107\tgit config commit.gpgsign false\n108\techo \"# seed\" >README.md\n109\tgit add README.md\n110\tgit commit -q -m init\n111\t\n112\t\"$ENTIRE_BIN\" enable --agent cursor | tail -2\n113\twrite_hooks \"$A\"\n114\t\n115\t# ---------------------------------------------------------------------------\n116\tsay \"Folder A: drive one cursor turn via tmux (interactive — -p headless skips hooks)\"\n117\ttmux kill-server 2>/dev/null || true\n118\ttmux new-session -d -s ct -x 200 -y 50 -c \"$A\" \"cursor-agent --force; sleep 3600\"\n119\taccept_trust_if_needed ct\n120\tsend_prompt ct \"Create alpha.txt with content 'first-in-folder-a'.\" \"alpha.txt\"\n121\t[ -f \"$A/alpha.txt\" ] || { echo \"alpha.txt not created\"; exit 1; }\n122\ttmux send-keys -t ct C-c; sleep 1; tmux send-keys -t ct C-c; sleep 2\n123\ttmux kill-session -t ct 2>/dev/null || true\n124\t\n125\t# ---------------------------------------------------------------------------\n126\tsay \"Folder A: commit → condensation writes to entire/checkpoints/v1\"\n127\tcd \"$A\"\n128\tgit add alpha.txt\n129\tgit commit -m \"Add alpha\" | tail -3\n130\tCKPT=$(git log -1 --format=%B | grep -oE 'Entire-Checkpoint: [a-f0-9]+' | awk '{print $2}')\n131\techo \"  checkpoint id: $CKPT\"\n132\tgit ls-tree -r entire/checkpoints/v1 | grep -E \"cursor-chat|metadata.json|prompt.txt\" | head\n133\t\n134\t# ---------------------------------------------------------------------------\n135\tsay \"Folder B: clone A + fetch checkpoints branch\"\n136\tgit clone --branch master \"$A\" \"$B\" 2>&1 | tail -2\n137\tcd \"$B\"\n138\tgit fetch origin '+refs/heads/entire/checkpoints/v1:refs/heads/entire/checkpoints/v1' 2>&1 | tail -2\n139\tgit config user.email t@t\n140\tgit config user.name t\n141\tgit config commit.gpgsign false\n142\techo \"  branches in B:\"; git branch -a | sed 's/^/    /'\n143\t\n144\t# ---------------------------------------------------------------------------\n145\tsay \"Folder B: entire enable + entire resume master\"\n146\t\"$ENTIRE_BIN\" enable --agent cursor | tail -2\n147\twrite_hooks \"$B\"\n148\t\n149\t# Capture paths before resume so we can assert against restored files\n150\tHASH_B=$(python3 -c \"import hashlib,sys;print(hashlib.md5(sys.argv[1].encode()).hexdigest())\" \"/private${B}\")\n151\tSLUG_B=\"private${B}\"; SLUG_B=\"${SLUG_B#/}\"; SLUG_B=\"${SLUG_B//\\//-}\"\n152\t\n153\techo \"  wiping any prior cursor state for B (hash=$HASH_B slug=$SLUG_B)\"\n154\trm -rf \"$HOME/.cursor/chats/$HASH_B\" \"$HOME/.cursor/projects/$SLUG_B\" 2>/dev/null || true\n155\t\n156\t\"$ENTIRE_BIN\" resume master 2>&1 | tail -10\n157\t\n158\tsay \"Folder B: assert restored files in ~/.cursor\"\n159\tAGENT_ID=$(find \"$HOME/.cursor/chats/$HASH_B\" -maxdepth 1 -mindepth 1 -type d | head -1 | xargs -n1 basename)\n160\techo \"  agent_id: $AGENT_ID\"\n161\tls -la \"$HOME/.cursor/chats/$HASH_B/$AGENT_ID/\" | tail -5\n162\tfind \"$HOME/.cursor/projects/$SLUG_B/agent-transcripts/$AGENT_ID/\" -type f\n163\t\n164\t# ---------------------------------------------------------------------------\n165\tsay \"Folder B: cursor-agent --resume should list + load the session\"\n166\t# Must accept trust dialog first-time-in-workspace, then reopen with --resume\n167\ttmux new-session -d -s ct -x 200 -y 50 -c \"$B\" \"cursor-agent --force; sleep 3600\"\n168\taccept_trust_if_needed ct\n169\ttmux send-keys -t ct C-c; sleep 1; tmux send-keys -t ct C-c; sleep 2\n170\ttmux kill-session -t ct 2>/dev/null || true\n171\t\n172\ttmux new-session -d -s ct -x 200 -y 50 -c \"$B\" \"cursor-agent --resume --force; sleep 3600\"\n173\tsleep 4\n174\techo \"  --- session picker ---\"\n175\ttmux capture-pane -t ct -p -S -40 | sed -e 's/[[:space:]]*$//' | grep -E \"Alpha|Create|Today|Sessions\" | head -5\n176\t\n177\ttmux send-keys -t ct Enter\n178\tsleep 5\n179\techo \"\"\n180\techo \"  --- restored session content ---\"\n181\ttmux capture-pane -t ct -p -S -200 | sed -e 's/[[:space:]]*$//' | \\\n182\t  grep -E \"first-in-folder-a|alpha.txt|Create alpha\" | head -6\n183\t\n184\t# ---------------------------------------------------------------------------\n185\tsay \"Folder B: send follow-up; cursor should remember prior state + know cwd changed\"\n186\tsend_prompt ct \"What file did you just create?\" \"alpha\" 20\n187\t\n188\techo \"\"\n189\techo \"  --- agent's response (last transcript line) ---\"\n190\ttail -1 \"$HOME/.cursor/projects/$SLUG_B/agent-transcripts/$AGENT_ID/$AGENT_ID.jsonl\" | head -c 400\n191\techo \"\"\n192\t\n193\tsay \"PASS: cross-folder resume verified end-to-end\""},"type":"attachment","uuid":"daf85d72-bf96-46f4-ba37-cde42dee919b","timestamp":"2026-04-24T06:49:37.091Z","userType":"external","entrypoint":"cli","cwd":"/Users/gtrrz-victor/wks/cli/cursor-export-import-sessions","sessionId":"4b7bf3d3-0d31-4237-918f-b56804225f2c","version":"2.1.117","gitBranch":"gtrrz-victor/cursor-export-import-sessions","slug":"great-i-did-see-swirling-honey"}
