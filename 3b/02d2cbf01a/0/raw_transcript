\t\tt.Fatalf(\"expected trailing %q stdin sentinel, got %v\", \"-\", args)\n46\t\t\t\t\t}\n47\t\t\t\t},\n48\t\t\t},\n49\t\t\t{\n50\t\t\t\tname:          \"copilot\",\n51\t\t\t\tagent:         &copilotcli.CopilotCLIAgent{},\n52\t\t\t\trequiredFlags: []string{\"--allow-all-tools\", \"--disable-builtin-mcps\"},\n53\t\t\t},\n54\t\t\t{\n55\t\t\t\tname:          \"cursor\",\n56\t\t\t\tagent:         &cursor.CursorAgent{},\n57\t\t\t\trequiredFlags: []string{\"--print\", \"--force\", \"--trust\", \"--workspace\"},\n58\t\t\t},\n59\t\t\t{\n60\t\t\t\tname:          \"gemini\",\n61\t\t\t\tagent:         &geminicli.GeminiCLIAgent{},\n62\t\t\t\trequiredFlags: []string{\"-p\"},\n63\t\t\t\textraCheck: func(t *testing.T, args []string) {\n64\t\t\t\t\tt.Helper()\n65\t\t\t\t\tpIdx := slices.Index(args, \"-p\")\n66\t\t\t\t\tif pIdx < 0 || pIdx+1 >= len(args) || args[pIdx+1] != \" \" {\n67\t\t\t\t\t\tt.Fatalf(\"expected -p followed by space placeholder, got %v\", args)\n68\t\t\t\t\t}\n69\t\t\t\t},\n70\t\t\t},\n71\t\t\t{\n72\t\t\t\tname:          \"antigravity\",\n73\t\t\t\tagent:         &antigravity.AntigravityAgent{},\n74\t\t\t\trequiredFlags: []string{\"-p\"},\n75\t\t\t\textraCheck: func(t *testing.T, args []string) {\n76\t\t\t\t\tt.Helper()\n77\t\t\t\t\tpIdx := slices.Index(args, \"-p\")\n78\t\t\t\t\tif pIdx < 0 || pIdx+1 >= len(args) || args[pIdx+1] != \" \" {\n79\t\t\t\t\t\tt.Fatalf(\"expected -p followed by space placeholder, got %v\", args)\n80\t\t\t\t\t}\n81\t\t\t\t},\n82\t\t\t},\n83\t\t}\n84\t\n85\t\tfor _, tt := range tests {\n86\t\t\tt.Run(tt.name, func(t *testing.T) {\n87\t\t\t\tt.Parallel()\n88\t\n89\t\t\t\tvar capturedArgs []string\n90\t\t\t\tsetRunner(tt.agent, catRunner(&capturedArgs))\n91\t\n92\t\t\t\tprompt := \"this prompt must arrive via stdin, not argv\"\n93\t\t\t\tresult, err := tt.agent.GenerateText(context.Background(), prompt, \"\")\n94\t\t\t\tif err != nil {\n95\t\t\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n96\t\t\t\t}\n97\t\t\t\tif result != prompt {\n98\