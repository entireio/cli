{"parentUuid":"0ab80caf-4d84-432c-8e3a-c2a18da60706","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/checkpoint/committed_reader_resolve.go","snippet":"1\tpackage checkpoint\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"log/slog\"\n8\t\t\"slices\"\n9\t\n10\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n14\t\n15\t\tgit \"github.com/go-git/go-git/v6\"\n16\t\t\"github.com/go-git/go-git/v6/plumbing\"\n17\t)\n18\t\n19\t// CommittedReader provides read access to committed checkpoint data.\n20\t// Both GitStore (v1) and V2GitStore (v2) implement this interface.\n21\ttype CommittedReader interface {\n22\t\tReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*CheckpointSummary, error)\n23\t\tReadSessionContent(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error)\n24\t}\n25\t\n26\t// CommittedListReader provides read and list access to committed checkpoint data.\n27\t// GitStore, V2GitStore, and DualCheckpointReader implement this interface.\n28\ttype CommittedListReader interface {\n29\t\tCommittedReader\n30\t\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n31\t\tReadSessionMetadata(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*CommittedMetadata, error)\n32\t\tReadSessionMetadataAndPrompts(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error)\n33\t\tReadSessionPrompts(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (string, error)\n34\t}\n35\t\n36\t// CommittedStore provides read/list access plus committed checkpoint metadata updates.\n37\t// NewCommittedReader returns this abstraction so callers do not need to know which\n38\t// backing checkpoint format was selected.\n39\ttype CommittedStore interface {\n40\t\tCommittedListReader\n41\t\tUpdateSummary(ctx context.Context, checkpointID id.CheckpointID, summary *Summary) error\n42\t\tGetCheckpointAuthor(ctx context.Context, checkpointID id.CheckpointID) (Author, error)\n43\t}\n44\t\n45\ttype committedReadMode int\n46\t\n47\tconst (\n48\t\tcommittedReadV1 committedReadMode = iota\n49\t\tcommittedReadDual\n50\t\tcommittedReadV2\n51\t)\n52\t\n53\t// CommittedReaderOptions configures NewCommittedReader.\n54\ttype CommittedReaderOptions struct {\n55\t\tBlobFetcher BlobFetchFunc\n56\t}\n57\t\n58\tfunc NewCommittedReader(ctx context.Context, repo *git.Repository, opts CommittedReaderOptions) (CommittedStore, error) {\n59\t\tif repo == nil {\n60\t\t\treturn nil, errors.New(\"git repository is required\")\n61\t\t}\n62\t\n63\t\tv1Store := NewGitStore(repo)\n64\t\tif opts.BlobFetcher != nil {\n65\t\t\tv1Store.SetBlobFetcher(opts.BlobFetcher)\n66\t\t}\n67\t\n68\t\tv2Enabled := settings.IsCheckpointsV2Enabled(ctx)\n69\t\tversion := settings.CheckpointsVersion(ctx)\n70\t\tlocalV2MainRef := false\n71\t\tif version != 2 && !v2Enabled {\n72\t\t\tlocalV2MainRef = hasLocalV2MainRef(repo)\n73\t\t}\n74\t\tmode := resolveCommittedReadMode(v2Enabled, version, localV2MainRef)\n75\t\n76\t\tvar v2Store *V2GitStore\n77\t\tif mode != committedReadV1 {\n78\t\t\tv2Store = NewV2GitStore(repo)\n79\t\t\tif opts.BlobFetcher != nil {\n80\t\t\t\tv2Store.SetBlobFetcher(opts.BlobFetcher)\n81\t\t\t}\n82\t\t}\n83\t\n84\t\tswitch mode {\n85\t\tcase committedReadV2:\n86\t\t\treturn v2Store, nil\n87\t\tcase committedReadDual:\n88\t\t\treturn &DualCheckpointReader{v2: v2Store, v1: v1Store}, nil\n89\t\tcase committedReadV1:\n90\t\t\treturn v1Store, nil\n91\t\tdefault:\n92\t\t\treturn nil, fmt.Errorf(\"unknown committed checkpoint read mode: %d\", mode)\n93\t\t}\n94\t}\n95\t\n96\tfunc resolveCommittedReadMode(checkpointsV2Enabled bool, checkpointsVersion int, localV2MainRef