{"parentUuid":"00f1c4f0-a320-454d-80ec-496848c2ed2c","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/strategy/manual_commit.go","snippet":"1\tpackage strategy\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"sync\"\n7\t\n8\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n9\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n10\t)\n11\t\n12\t// ManualCommitStrategy implements the manual-commit strategy for session management.\n13\t// It stores checkpoints on shadow branches and condenses session logs to a\n14\t// permanent sessions branch when the user commits.\n15\ttype ManualCommitStrategy struct {\n16\t\t// stateStore manages session state files in .git/entire-sessions/\n17\t\tstateStore *session.StateStore\n18\t\t// stateStoreOnce ensures thread-safe lazy initialization\n19\t\tstateStoreOnce sync.Once\n20\t\t// stateStoreErr captures any error during initialization\n21\t\tstateStoreErr error\n22\t\n23\t\t// checkpointStore manages checkpoint data in git\n24\t\tcheckpointStore *checkpoint.GitStore\n25\t\t// checkpointStoreOnce ensures thread-safe lazy initialization\n26\t\tcheckpointStoreOnce sync.Once\n27\t\t// checkpointStoreErr captures any error during initialization\n28\t\tcheckpointStoreErr error\n29\t\n30\t\t// blobFetcher, when set, is passed to the checkpoint store to enable\n31\t\t// on-demand blob fetching after treeless fetches. Set via SetBlobFetcher.\n32\t\tblobFetcher checkpoint.BlobFetchFunc\n33\t}\n34\t\n35\t// getStateStore returns the session state store, initializing it lazily if needed.\n36\t// Thread-safe via sync.Once.\n37\tfunc (s *ManualCommitStrategy) getStateStore(_ context.Context) (*session.StateStore, error) {\n38\t\ts.stateStoreOnce.Do(func() {\n39\t\t\tstore, err := session.NewStateStore(context.Background()) //nolint:contextcheck // sync.Once must use background context to avoid caching errors from a cancelled caller context\n40\t\t\tif err != nil {\n41\t\t\t\ts.stateStoreErr = fmt.Errorf(\"failed to create state store: %w\", err)\n42\t\t\t\treturn\n43\t\t\t}\n44\t\t\ts.stateStore = store\n45\t\t})\n46\t\treturn s.stateStore, s.stateStoreErr\n47\t}\n48\t\n49\t// getCheckpointStore returns the checkpoint store, initializing it lazily if needed.\n50\t// Thread-safe via sync.Once.\n51\tfunc (s *ManualCommitStrategy) getCheckpointStore() (*checkpoint.GitStore, error) {\n52\t\ts.checkpointStoreOnce.Do(func() {\n53\t\t\trepo, err := OpenRepository(context.Background())\n54\t\t\tif err != nil {\n55\t\t\t\ts.checkpointStoreErr = fmt.Errorf(\"failed to open repository: %w\", err)\n56\t\t\t\treturn\n57\t\t\t}\n58\t\t\tWarnIfMetadataDisconnected()\n59\t\t\tstore := checkpoint.NewGitStore(repo)\n60\t\t\tif s.blobFetcher != nil {\n61\t\t\t\tstore.SetBlobFetcher(s.blobFetcher)\n62\t\t\t}\n63\t\t\ts.checkpointStore = store\n64\t\t})\n65\t\treturn s.checkpointStore, s.checkpointStoreErr\n66\t}\n67\t\n68\tfunc (s *ManualCommitStrategy) committedCheckpointStore(ctx context.Context) (checkpoint.CommittedListReader, error) {\n69\t\trepo, err := OpenRepository(ctx)\n70\t\tif err != nil {\n71\t\t\treturn nil, err\n72\t\t}\n73\t\n74\t\tWarnIfMetadataDisconnected()\n75\t\tstore, err := checkpoint.NewCommittedReader(ctx, repo, checkpoint.CommittedReaderOptions{\n76\t\t\tBlobFetcher: s.blobFetcher,\n77\t\t})\n78\t\tif err != nil {\n79\t\t\treturn nil, fmt.Errorf(\"prepare checkpoint store: %w\", err)\n80\t\t}\n81\t\treturn store, nil\n82\t}\n83\t\n84\t// NewManualCommitStrategy creates a new manual-commit strategy instance.\n85\tfunc NewManualCommitStrategy() *ManualCommitStrategy {\n86\t\treturn &ManualCommitStrategy{}\n87\t}\n88\t\n89\t// SetBlobFetcher configures on-demand blob fetching for the checkpoint store.\n90\t// Must be called before the first checkpoint store access (e.g., before RestoreLogsOnly).\n91\tfunc (s *ManualCommitStrategy) SetBlobFetcher(f checkpoint.BlobFetchFunc) {\n92\t\ts.blobFetcher = f\n93\t}\n94\t\n95\t// HasBlobFetcher reports whether a blob fetcher is configured.\n96\t// Used in tests to verify the strategy is properly wired for treeless fetch support.\n97\tfunc (s *ManualCommitStrategy) HasBlobFetcher() bool {\n98\t\treturn s.blobFetcher != nil\n99\t}\n100\t\n101\t// ValidateRepository validates that the repository is suitable for this strategy.\n102\tfunc (s *ManualCommitStrategy) ValidateRepository() error {\n103\t\trepo, err := OpenRepository(context.Background())\n104\t\tif err != nil {\n105\t\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n106\t\t}\n107\t\n108\t\t_, err = repo.Worktree()\n109\t\tif err != nil {\n110\t\t\treturn fmt.Errorf(\"failed to access worktree: %w\", err)\n111\t\t}\n112\t\n113\t\treturn nil\n114\t}\n115\t\n116\t// ListOrphanedItems returns orphaned items created by the manual-commit strategy.\n117\t// This includes:\n118\t//   - Shadow branches that weren't auto-cleaned during commit condensation\n119\t//   - Session state files with no corresponding checkpoints or shadow branches\n120\tfunc (s *ManualCommitStrategy) ListOrphanedItems(ctx context.Context) ([]CleanupItem, error) {\n121\t\tvar items []CleanupItem\n122\t\n123\t\t// Shadow branches (should have been auto-cleaned after condensation)\n124\t\tbranches, err := ListShadowBranches(ctx)\n125\t\tif err != nil {\n126\t\t\treturn nil, err\n127\t\t}\n128\t\tfor _, branch := range branches {\n129\t\t\titems = append(items, CleanupItem{\n130\t\t\t\tType:   CleanupTypeShadowBranch,\n131\t\t\t\tID:     branch,\n132\t\t\t\tReason: \"shadow branch (should have been auto-cleaned)\",\n133\t\t\t})\n134\t\t}\n135\t\n136\t\t// Orphaned session states are detected by ListOrphanedSessionStates\n137\t\t// which is strategy-agnostic (checks both shadow branches and checkpoints)\n138\t\n139\t\treturn items, nil\n140\t}"},"type":"attachment","uuid":"0ab80caf-4d84-432c-8e3a-c2a18da60706","timestamp":"2026-05-20T23:06:47.196Z","userType":"external","entrypoint":"