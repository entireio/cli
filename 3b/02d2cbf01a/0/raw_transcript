  PostToolUse    []EventMatcher `json:\"PostToolUse,omitempty\"`\n    PreInvocation  []HookHandler  `json:\"PreInvocation,omitempty\"`  // direct list, matcher ignored\n    PostInvocation []HookHandler  `json:\"PostInvocation,omitempty\"`\n    Stop           []HookHandler  `json:\"Stop,omitempty\"`\n}\n\ntype EventMatcher struct {\n    Matcher string        `json:\"matcher,omitempty\"` // regex over tool name; \"\" or \"*\" = all\n    Hooks   []HookHandler `json:\"hooks\"`\n}\n\ntype HookHandler struct {\n    Type    string `json:\"type,omitempty\"`    // default \"command\"\n    Command string `json:\"command\"`\n    Timeout int    `json:\"timeout,omitempty\"` // seconds; Antigravity default 30\n}\n\n// === stdin payloads (camelCase, per /tmp/ag-hooks.md) ===\n\ntype CommonPayload struct {\n    ConversationID        string   `json:\"conversationId\"`\n    WorkspacePaths        []string `json:\"workspacePaths\"`\n    TranscriptPath        string   `json:\"transcriptPath\"`\n    ArtifactDirectoryPath string   `json:\"artifactDirectoryPath\"`\n}\n\ntype ToolCall struct {\n    Name string          `json:\"name\"`\n    Args json.RawMessage `json:\"args\"`\n}\n\ntype PreToolUsePayload struct {\n    CommonPayload\n    ToolCall ToolCall `json:\"toolCall\"`\n    StepIdx  int      `json:\"stepIdx\"`\n}\n\ntype PostToolUsePayload struct {\n    CommonPayload\n    StepIdx int    `json:\"stepIdx\"`\n    Error   string `json:\"error,omitempty\"`\n}\n\ntype PreInvocationPayload struct {\n    CommonPayload\n    InvocationNum   int `json:\"invocationNum\"`\n    InitialNumSteps int `json:\"initialNumSteps\"`\n}\n\n// PostInvocation has identical fields per the doc.\ntype PostInvocationPayload = PreInvocationPayload\n\ntype StopPayload struct {\n    CommonPayload\n    ExecutionNum      int    `json:\"executionNum\"`\n    TerminationReason string `json:\"terminationReason\"`\n    Error             string `json:\"error,omitempty\"`\n    FullyIdle         bool   `json:\"fullyIdle\"`\n}\n