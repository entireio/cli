cho \"--- checkpoints ---\"\n$ENTIRE checkpoint list\necho \"--- status ---\"\n$ENTIRE status\n```\n\nThis time we should see:\n- `files_touched` containing `final-test.md` in the session state\n- `Entire-Checkpoint: <id>` trailer on the commit\n- `checkpoint list` shows ≥ 1\n- `status` shows the recent antigravity session\n\nIf all four pop, the full integration works end-to-end and we're truly done with smoke testing."}],"stop_reason":"end_turn","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1178,"cache_read_input_tokens":849589,"output_tokens":863,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1178,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":1,"output_tokens":863,"cache_read_input_tokens":849589,"cache_creation_input_tokens":1178,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1178},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CbGAWvz5n364kbe9zMxEZ","type":"assistant","uuid":"38d02b7b-0c34-4119-a532-f85d5cba5414","timestamp":"2026-05-21T18:11:34.375Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"27c10fbd-3055-4d96-8e88-8a95ee2d9e1e","version":"2.1.145","gitBranch":"feat/antigravity-agent"}
