e message routing\n\n**Files:**\n- Create: `redact/opf_progress.go`\n- Test: `redact/opf_progress_test.go`\n- Modify: `redact/opf.go` (call into progress on success/failure)\n\n- [ ] **Step 1: Write failing tests**\n\nCreate `redact/opf_progress_test.go`:\n\n```go\npackage redact\n\nimport (\n\t\"bytes\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestProgressMessage_TTY(t *testing.T) {\n\tt.Parallel()\n\tvar out bytes.Buffer\n\tp := newProgressWriter(&out, true /* tty */, false /* accessible */)\n\tp.Start(\"scanning transcript\")\n\tp.Finish(1800 * time.Millisecond) // 1.8s\n\tgot := out.String()\n\tif !strings.Contains(got, \"→ OpenAI Privacy Filter: scanning transcript\") {\n\t\tt.Errorf(\"missing start line: %q\", got)\n\t}\n\tif !strings.Contains(got, \"✓ OpenAI Privacy Filter: done (1.8s)\") {\n\t\tt.Errorf(\"missing done line: %q\", got)\n\t}\n}\n\nfunc TestProgressMessage_NonTTY(t *testing.T) {\n\tt.Parallel()\n\tvar out bytes.Buffer\n\tp := newProgressWriter(&out, false, false)\n\tp.Start(\"scanning transcript\")\n\tp.Finish(1800 * time.Millisecond)\n\tgot := out.String()\n\tif !strings.Contains(got, \"[entire] redaction: openai privacy filter scanning transcript\") {\n\t\tt.Errorf(\"missing non-tty start: %q\", got)\n\t}\n}\n\nfunc TestProgressMessage_Accessible(t *testing.T) {\n\tt.Parallel()\n\tvar out bytes.Buffer\n\tp := newProgressWriter(&out, true, true /* accessible */)\n\tp.Start(\"scanning\")\n\tp.Finish(1 * time.Second)\n\tgot := out.String()\n\tif strings.ContainsAny(got, \"\\r→✓\") {\n\t\tt.Errorf(\"accessible mode contains terminal control chars: %q\", got)\n\t}\n}\n\nfunc TestFailureMessage_NotOnPath(t *testing.T) {\n\tt.Parallel()\n\tgot := formatOPFFailure(opfErrNotFound, \"opf\")\n\tif !strings.Contains(got, \"'opf' not found on PATH\") {\n\t\tt.Errorf(\"missing not-found phrase: %q\", got)\n\t}\n\tif !strings.Contains(got, \"pip install opf\") {\n\t\tt.Errorf(\"missing install instruction: %q\", got)\n\t}\n\tif !strings.Contains(got, \"Falling back to default redaction layers.\") {\n\t\tt.Errorf(\"missing fallback receipt: %q\", got)\n\t}\n}\n\nfunc TestFailureMessage_Timeout(t *testing.T) {\n\tt.Parallel()\n\tgot := formatOPFFailure(opfErrTimeout(45), \"opf\")\n\tif !strings.Contains(got, \"exceeded 45s timeout\") {\n\t\tt.Errorf(\"missing timeout phrasing: %q\", got)\n\t}\n}\n```\n\n- [ ] **Step 2: Run tests to verify failure**\n\nRun: `go test ./redact/ -run TestProgressMessage -v -run TestFailureMessage -v`\nExpected: FAIL.\n\n- [ ] **Step 3: Implement the progress writer + failure formatter**\n\nCreate `redact/opf_progress.go`:\n\n```go\npackage redact\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\t\"time\"\n)\n\ntype progressWriter struct {\n\tw          io.Writer\n\ttty        bool\n\taccessible bool\n}\n\nfunc newProgressWriter(w io.Writer, tty, accessible bool) *progressWriter {\n\treturn &progressWriter{w: w, tty: tty, accessible: accessible}\n}\n\nfunc (p *progressWriter) Start(detail string) {\n\tswitch {\n\tcase p.accessible || !p.tty:\n\t\tfmt.Fprintf(p.w, \"[entire] redaction: openai privacy filter %s (this may take a few seconds)\\n\", detail)\n\tdefault:\n\t\tfmt.Fprintf(p.w, \"→ OpenAI Privacy Filter: %s…\\n\", detail)\n\t}\n}\n\nfunc (p *progressWriter) Finish(elapsed time.Duration) {\n\tsecs := elapsed.Seconds()\n\tswitch {\n\tcase p.accessible || !p.tty:\n\t\tfmt.Fprintf(p.w, \"[entire] redaction: openai privacy filter completed in %.1fs\\n\", secs)\n\tdefault:\n\t\tfmt.Fprintf(p.w, \"✓ OpenAI Privacy Filter: done (%.1fs)\\n\", secs)\n\t}\n}\n\n// Typed errors for failure-message routing.\nvar opfErrNotFound = errors.New(\"not found on PATH\")\n\ntype opfErrTimeoutDuration int\n\nfunc opfErrTimeout(seconds int) error { return opfErrTimeoutDuration(seconds) }\nfunc (e opfErrTimeoutDuration) Error() string {\n\treturn fmt.Sprintf(\"exceeded %ds timeout\", int(e))\n}\n\nfunc formatOPFFailure(err error, command string) string {\n\tvar b strings.Builder\n\tb.WriteString(\"× OpenAI Privacy Filter: \")\n\tswitch {\n\tcase errors.Is(err, opfErrNotFound):\n\t\tfmt.Fprintf(&b, \"'%s' not found on PATH. Install with 'pip install opf' (see https://github.com/openai/privacy-filter) or set 'redaction.openai_privacy_filter.command' in .entire/settings.json. \", command)\n\tcase isTimeoutErr(err):\n\t\tfmt.Fprintf(&b, \"%s. Consider raising 'redaction.openai_privacy_filter.timeout_seconds' or disabling the filter. \", err.Error())\n\tdefault:\n\t\tfmt.Fprintf(&b, \"%s. \", err.Error())\n\t}\n\tb.WriteString(\"Falling back to default redaction layers.\")\n\treturn b.String()\n}\n\nfunc isTimeoutErr(err error) bool {\n\tvar t opfErrTimeoutDuration\n\treturn errors.As(err, &t)\n}\n```\n\n- [ ] **Step 4: Wire failure formatter into `handleOPFFailure`**\n\nIn `redact/opf.go`, update `handleOPFFailure`:\n\n```go\nfunc handleOPFFailure(ctx context.Context, cfg *OPFConfig, err error) {\n\tslog.Warn(\"OpenAI Privacy Filter call failed\",\n\t\tcomponentAttr,\n\t\tslog.String(\"command\", cfg.Command),\n\t\tslog.String(\"on_failure\", cfg.OnFailure),\n\t\tslog.String(\"error\", err.Error()),\n\t)\n\t// Surface the user-facing message on stderr exactly once per failure.\n\t// In tests, opfStderr is overridden by a buffer.\n\tif opfStderr != nil {\n\t\tfmt.Fprintln(opfStderr, formatOPFFailure(err, cfg.Command))\n\t}\n}\n\n// opfStderr is the destination for user-facing OPF failure messages.\n// Production sets this to os.Stderr in package init; tests override.\nvar opfStderr io.Writer = os.Stderr\n```\n\n- [ ] **Step 5: Run tests to verify passing**\n\nRun: `go test ./redact/ -count=1 -v`\nExpected: all PASS.\n\n- [ ] **Step 6: Run full unit-test sweep across affected packages**\n\nRun: `mise run test`\nExpected: PASS.\n\n- [ ] **Step 7: Lint + format**\n\nRun: `mise run fmt && mise run lint`\nExpected: clean.\n\n- [ ] **Step 8: Commit Chunk 3**\n\n```bash\ngit add redact/\ngit commit -m \"feat(redact): add OPF detector, entry points, and progress UX\"\n```\n\n---\n\n## Chunk 4: Callsite migration + benchmark + live integration\n\nThis chunk wires OPF into production by migrating the condensation and export callsites to the new entry points, while explicitly leaving temporary-write callsites on the plain entry points (per the §Data flow audit in the spec). Then it adds the fake-runtime benchmark for regression tracking and a build-tagged live integration test for protocol drift detection. After this chunk, OPF is functional end-to-end and the runtime decision (shell-out vs daemon) can be revisited with real numbers.\n\n### Task 8: Migrate condensation callsites\n\n**Files:**\n- Modify: `cmd/entire/cli/strategy/manual_commit_hooks.go:2749, 2759`\n- Modify: `cmd/entire/cli/strategy/manual_commit_condensation.go:379`\n- Modify: `cmd/entire/cli/checkpoint/committed.go:205, 264, 422, 729, 840, 841, 859, 875, 1405, 1776`\n- Modify: `cmd/entire/cli/checkpoint/v2_committed.go:612, 906, 1018`\n\n**Do NOT modify:**\n- `cmd/entire/cli/checkpoint/temporary.go:319, 390` (per-turn writes stay on plain)\n- `cmd/entire/cli/migrate.go:744, 1377, 1497, 1534` (`AlreadyRedacted` wrappers)\n\n- [ ] **Step 1: Write an end-to-end migration test**\n\nCreate or extend `cmd/entire/cli/strategy/condensation_opf_test.go`:\n\n```go\n//go:build integration\n\npackage strategy\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\t\"github.com/entireio/cli/redact\"\n\t\"github.com/entireio/cli/redact/opf_runtime\"\n)\n\n// TestCondensation_AppliesOPF wires a fake OPF runtime, runs a real\n// condensation against a temp repo, and verifies the resulting committed\n// metadata has [REDACTED_PERSON] where OPF said to redact.\nfunc TestCondensation_AppliesOPF(t *testing.T) {\n\tt.Parallel()\n\tfake := &recordingRuntime{\n\t\tspans: []opf_runtime.Span{{Start: 0, End: 5, Label: \"private_person\"}},\n\t}\n\tredact.ConfigurePrivacyFilterWithRuntime(redact.OPFConfig{\n\t\tEnabled:    true,\n\t\tCategories: map[string]bool{\"private_person\": true},