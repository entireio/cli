estutil.PatchSettings(t, s.Dir, map[string]any{\n\t\t\t\"redaction\": map[string]any{\n\t\t\t\t\"openai_privacy_filter\": map[string]any{\n\t\t\t\t\t\"enabled\":         true,\n\t\t\t\t\t\"categories\":      map[string]any{\"private_person\": true},\n\t\t\t\t\t\"command\":         \"opf\",\n\t\t\t\t\t\"timeout_seconds\": 120,\n\t\t\t\t\t\"on_failure\":      \"warn\",\n\t\t\t\t},\n\t\t\t},\n\t\t})\n\n\t\ts.Git(t, \"checkout\", \"-b\", \"feature\")\n\n\t\t// Minimal transcript: 1 user message + 1 assistant message, both\n\t\t// mention \"Alice Smith\" so OPF has something to redact.\n\t\tsessionID := \"opf-smoke-session\"\n\t\t_, writeErr := vogon.WriteSessionTranscript(ctx, s.Dir, extraEnv, sessionID,\n\t\t\t\"Help Alice Smith write a greeting\",\n\t\t\t\"Hello Alice Smith, here is your greeting.\")\n\t\trequire.NoError(t, writeErr, \"prepare vogon session\")\n\n\t\t// `entire attach` creates a checkpoint from the transcript on the\n\t\t// shadow branch. Then the commit below condenses to entire/checkpoints/v1\n\t\t// which runs OPF.\n\t\tout, err := entire.AttachWithEnv(s.Dir, extraEnv, sessionID, s.Agent.EntireAgent())\n\t\trequire.NoError(t, err, \"entire attach failed: %s\", out)\n\n\t\tcheckpointID := testutil.AssertHasCheckpointTrailer(t, s.Dir, \"HEAD\")\n\t\tt.Logf(\"checkpoint id: %s\", checkpointID)\n\n\t\t// Read back the condensed transcript via `entire explain`.\n\t\texplainOut := entire.Explain(t, s.Dir, checkpointID)\n\t\tt.Logf(\"=== explain output ===\\n%s\\n=== end explain ===\", explainOut)\n\n\t\t// The literal name should be gone, replaced with the OPF token.\n\t\tif strings.Contains(explainOut, \"Alice Smith\") {\n\t\t\tt.Errorf(\"FAIL: 'Alice Smith' was NOT redacted in condensed transcript\")\n\t\t}\n\t\tassert.Contains(t, explainOut, \"REDACTED_PERSON\", \"want OPF to redact Alice Smith to [REDACTED_PERSON]\")\n\t})\n}\n","structuredPatch":[{"oldStart":15,"oldLines":14,"newStart":15,"newLines":21,"lines":[" )"," "," // TestOPFSmoke is a one-of