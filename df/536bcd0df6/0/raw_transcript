{"parentUuid":"45960114-f272-4703-bee6-f5c2c40dc00c","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact/redact/opf_runtime/shellout_test.go","snippet":"1\tpackage opf_runtime\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"os/exec\"\n7\t\t\"strings\"\n8\t\t\"sync\"\n9\t\t\"testing\"\n10\t\t\"time\"\n11\t)\n12\t\n13\t// shCmd returns a Cmd that runs the given shell snippet via `sh -c`.\n14\t// Matches the claudecode test pattern.\n15\tfunc shCmd(ctx context.Context, script string) *exec.Cmd {\n16\t\treturn exec.CommandContext(ctx, \"sh\", \"-c\", script)\n17\t}\n18\t\n19\tfunc TestShellOut_Success(t *testing.T) {\n20\t\tt.Parallel()\n21\t\trt := &shellOut{\n22\t\t\tcommand:        \"opf\",\n23\t\t\ttimeoutSeconds: 5,\n24\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n25\t\t\t\tout := `{\"detected_spans\":[{\"label\":\"private_person\",\"start\":0,\"end\":5,\"text\":\"Alice\"}]}`\n26\t\t\t\treturn shCmd(ctx, \"printf '%s' '\"+out+\"'\")\n27\t\t\t},\n28\t\t}\n29\t\tspans, err := rt.Redact(context.Background(), \"Alice is here.\", []string{\"private_person\"})\n30\t\tif err != nil {\n31\t\t\tt.Fatalf(\"Redact: %v\", err)\n32\t\t}\n33\t\tif len(spans) != 1 {\n34\t\t\tt.Fatalf(\"spans: want 1, got %d\", len(spans))\n35\t\t}\n36\t\tif spans[0].Label != \"private_person\" || spans[0].Start != 0 || spans[0].End != 5 {\n37\t\t\tt.Errorf(\"span mismatch: %+v\", spans[0])\n38\t\t}\n39\t}\n40\t\n41\tfunc TestShellOut_NonZeroExit(t *testing.T) {\n42\t\tt.Parallel()\n43\t\trt := &shellOut{\n44\t\t\tcommand:        \"opf\",\n45\t\t\ttimeoutSeconds: 5,\n46\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n47\t\t\t\treturn shCmd(ctx, \"echo boom >&2; exit 2\")\n48\t\t\t},\n49\t\t}\n50\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n51\t\tif err == nil {\n52\t\t\tt.Fatalf(\"want error, got nil\")\n53\t\t}\n54\t\tif !strings.Contains(err.Error(), \"boom\") {\n55\t\t\tt.Errorf(\"err: want stderr passthrough, got %q\", err)\n56\t\t}\n57\t}\n58\t\n59\tfunc TestShellOut_GarbledOutput(t *testing.T) {\n60\t\tt.Parallel()\n61\t\trt := &shellOut{\n62\t\t\tcommand:        \"opf\",\n63\t\t\ttimeoutSeconds: 5,\n64\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n65\t\t\t\treturn shCmd(ctx, \"printf 'not json'\")\n66\t\t\t},\n67\t\t}\n68\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n69\t\tif err == nil {\n70\t\t\tt.Fatalf(\"want error, got nil\")\n71\t\t}\n72\t}\n73\t\n74\tfunc TestShellOut_Timeout(t *testing.T) {\n75\t\tt.Parallel()\n76\t\trt := &shellOut{\n77\t\t\tcommand:        \"opf\",\n78\t\t\ttimeoutSeconds: 1,\n79\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n80\t\t\t\treturn shCmd(ctx, \"sleep 5\")\n81\t\t\t},\n82\t\t}\n83\t\tstart := time.Now()\n84\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n85\t\tif err == nil {\n86\t\t\tt.Fatalf(\"want timeout error, got nil\")\n87\t\t}\n88\t\tif elapsed := time.Since(start); elapsed > 3*time.Second {\n89\t\t\tt.Errorf(\"timeout did not cancel quickly enough: %v\", elapsed)\n90\t\t}\n91\t\tif !errors.Is(err, context.DeadlineExceeded) && !strings.Contains(err.Error(), \"timeout\") {\n92\t\t\tt.Errorf(\"err: want timeout, got %q\", err)\n93\t\t}\n94\t}\n95\t\n96\tfunc TestShellOut_CommandNotFound(t *testing.T) {\n97\t\tt.Parallel()\n98\t\t// Use real NewShellOut (no injection) so we exercise exec.CommandContext\n99\t\t// against a non-existent path.\n100\t\trt := NewShellOut(\"/nonexistent/opf-binary\", 5)\n101\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n102\t\tif err == nil {\n103\t\t\tt.Fatalf(\"want error, got nil\")\n104\t\t}\n105\t}\n106\t\n107\tfunc TestShellOut_ParentContextCanceled(t *testing.T) {\n108\t\tt.Parallel()\n109\t\t// Parent-context cancellation must produce a clear \"canceled\" message,\n110\t\t// not be misreported as a generic \"opf exited with error\" (the bug we\n111\t\t// fixed). The child callCtx will surface context.Canceled via cascade,\n112\t\t// not context.DeadlineExceeded, so the timeout branch alone is insufficient.\n113\t\trt := &shellOut{\n114\t\t\tcommand:        \"opf\",\n115\t\t\ttimeoutSeconds: 30,\n116\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n117\t\t\t\treturn shCmd(ctx, \"sleep 5\")\n118\t\t\t},\n119\t\t}\n120\t\tctx, cancel := context.WithCancel(context.Background())\n121\t\tgo func() {\n122\t\t\ttime.Sleep(50 * time.Millisecond)\n123\t\t\tcancel()\n124\t\t}()\n125\t\t_, err := rt.Redact(ctx, \"x\", []string{\"private_person\"})\n126\t\tif err == nil {\n127\t\t\tt.Fatalf(\"want cancellation error, got nil\")\n128\t\t}\n129\t\tif !errors.Is(err, context.Canceled) {\n130\t\t\tt.Errorf(\"err: want context.Canceled in chain, got %q\", err)\n131\t\t}\n132\t\tif !strings.Contains(err.Error(), \"canceled\") {\n133\t\t\tt.Errorf(\"err: want 'canceled' message, got %q\", err)\n134\t\t}\n135\t}\n136\t\n137\t// TestShellOut_RedactBatch_PartitionsSpansByInput verifies that batched\n138\t// calls correctly partition opf's single JSON output back to per-input\n139\t// span slices. The concatenated batch input has known boundaries; spans\n140\t// returned by opf are mapped to whichever input contains them.\n141\t//\n142\t// Inputs: [\"Alice here\", \"no match\", \"secret abc\"]\n143\t// Concatenation: \"Alice here\" + sep + \"no match\" + sep + \"secret abc\"\n144\t//   - \"Alice here\"  starts at 0, ends at 10\n145\t//   - sep at        10\n146\t//   - \"no match\"    starts at 11 (sep is 1 byte), ends at 19\n147\t//   - sep at        19\n148\t//   - \"secret abc\"  starts at 20, ends at 30\n149\t//\n150\t// Simulate opf returning spans at 0-5 (Alice) and 27-30 (abc).\n151\tfunc TestShellOut_RedactBatch_PartitionsSpansBy