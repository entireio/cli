lls[0].Name = %q, want /pr-review-toolkit:review-pr\", skills[0].Name)\n59\t\t}\n60\t\tif skills[0].Description != \"Full PR review\" {\n61\t\t\tt.Errorf(\"skills[0].Description = %q\", skills[0].Description)\n62\t\t}\n63\t}\n64\t\n65\tfunc TestDiscoverReviewSkills_SkipsNonReviewSkill(t *testing.T) {\n66\t\thome := withFakeHome(t)\n67\t\tskillDir := filepath.Join(home, \".claude\", \"plugins\", \"cache\",\n68\t\t\t\"fake-market\", \"unrelated-plugin\", \"1.0.0\", \"skills\", \"format-code\")\n69\t\tif err := os.MkdirAll(skillDir, 0o755); err != nil {\n70\t\t\tt.Fatal(err)\n71\t\t}\n72\t\tcontent := `---\n73\tname: format-code\n74\tdescription: Reformat code according to project style\n75\t---\n76\t`\n77\t\tif err := os.WriteFile(filepath.Join(skillDir, \"SKILL.md\"), []byte(content), 0o644); err != nil {\n78\t\t\tt.Fatal(err)\n79\t\t}\n80\t\n81\t\tskills, err := claudecode.DiscoverReviewSkills(context.Background())\n82\t\tif err != nil {\n83\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n84\t\t}\n85\t\tif len(skills) != 0 {\n86\t\t\tt.Errorf(\"non-review skill should be skipped, got %+v\", skills)\n87\t\t}\n88\t}\n89\t\n90\tfunc TestDiscoverReviewSkills_MalformedSkillSkipped(t *testing.T) {\n91\t\thome := withFakeHome(t)\n92\t\tgoodDir := filepath.Join(home, \".claude\", \"plugins\", \"cache\",\n93\t\t\t\"fake-market\", \"good-plugin\", \"1.0.0\", \"skills\", \"review-pr\")\n94\t\tbadDir := filepath.Join(home, \".claude\", \"plugins\", \"cache\",\n95\t\t\t\"fake-market\", \"bad-plugin\", \"1.0.0\", \"skills\", \"audit\")\n96\t\tif err := os.MkdirAll(goodDir, 0o755); err != nil {\n97\t\t\tt.Fatal(err)\n98\t\t}\n99\t\tif err := os.MkdirAll(badDir, 0o755); err != nil {\n100\t\t\tt.Fatal(err)\n101\t\t}\n102\t\tif err := os.WriteFile(filepath.Join(goodDir, \"SKILL.md\"),\n103\t\t\t[]byte(\"---\\nname: review-pr\\ndescription: PR review\\n---\\n\"), 0o644); err != nil {\n104\t\t\tt.Fatal(err)\n105\t\t}\n106\t\t// Malformed: no closing frontmatter delimiter.\n107\t\tif err := os.WriteFile(filepath.Join(badDir, \"SKILL.md\"),\n108\t\t\t[]byte(\"---\\nname: audit\\ndescription: uh oh\"), 0o644); err != nil {\n109\t\t\tt.Fatal(err)\n110\t\t}\n111\t\n112\t\tskills, err := claudecode.DiscoverReviewSkills(context.Background())\n113\t\tif err != nil {\n114\t\t\tt.Fatalf(\"malformed SKILL.md should not abort discovery; got err=%v\", err)\n115\t\t}\n116\t\tif len(skills) != 1 {\n117\t\t\tt.Errorf(\"good skill should still appear, got %+v\", skills)\n118\t\t}\n119\t}\n120\t\n121\t// TestDiscoverReviewSkills_FindsPluginCommand covers the pr-review-toolkit\n122\t// shape: slash commands live as flat *.md files under <plugin>/commands/,\n123\t// with description in YAML frontmatter and the invocation name derived\n124\t// from the filename (no `name:` field).\n125\tfunc TestDiscoverReviewSkills_FindsPluginCommand(t *testing.T) {\n126\t\thome := withFakeHome(t)\n127\t\tcmdDir := filepath.Join(home, \".claude\", \"plugins\", \"cache\",\n128\t\t\t\"fake-market\", \"pr-review-toolkit\", \"unknown\", \"commands\")\n129\t\tif err := os.MkdirAll(cmdDir, 0o755); err != nil {\n130\t\t\tt.Fatal(err)\n131\t\t}\n132\t\t// Frontmatter with quoted description and no `name:` field — exactly\n133\t\t// the shape pr-review-toolkit ships (verified on-disk).\n134\t\tcontent := `---\n135\tdescription: \"Comprehensive PR review using specialized agents\"\n136\targument-hint: \"[review-aspects]\"\n137\tallowed-tools: [\"Bash\", \"Read\"]\n138\t---\n139\t\n140\t# Comprehensive PR Review\n141\t`\n142\t\tif err := os.WriteFile(filepath.Join(cmdDir, \"review-pr.md\"), []byte(content), 0o644); err != nil {\n143\t\t\tt.Fatal(err)\n144\t\t}\n145\t\n146\t\tskills, err := claudecode.DiscoverReviewSkills(context.Background())\n147\t\tif err != nil {\n148\t\t\tt.Fatal(err)\n149\t\t}\n150\t\tif len(skills) != 1 {\n151\t\t\tt.Fatalf(\"expected 1 plugin command, got %d: %+v\", len(skills), skills)\n152\t\t}\n153\t\tif skills[0].Name != \"/pr-review-toolkit:review-pr\" {\n154\t\t\tt.Errorf(\"Name = %q, want /pr-review-toolkit:review-pr\", skills[0].Name)\n155\t\t}\n156\t\tif skills[0].Description != \"Comprehensive PR review using specialized agents\" {\n157\t\t\tt.Errorf(\"Description = %q\", skills[0].Description)\n158\t\t}\n159\t}\n160\t\n161\t// TestDiscoverReviewSkills_FindsPluginAgent covers the same shape for\n162\t// <plugin>/agents/ — pr-review-toolkit ships subagents (code-reviewer,\n163\t// silent-failure-hunter, etc.) there. Same flat .md file format.\n164\tfunc TestDiscoverReviewSkills_FindsPluginAgent(t *testing.T) {\n165\t\thome := withFakeHome(t)\n166\t\tagentDir := filepath.Join(home, \".claude\", \"plugins\", \"cache\",\n167\t\t\t\"fake-market\", \"pr-review-toolkit\", \"unknown\", \"agents\")\n168\t\tif err := os.MkdirAll(agentDir, 0o755); err != nil {\n169\t\t\tt.Fatal(err)\n170\t\t}\n171\t\tcontent := `---\n172\tdescription: \"Audit code against project style\"\n173\t---\n174\t`\n175\t\tif err := os.WriteFile(filepath.Join(agentDir, \"code-reviewer.md\"), []byte(content), 0o644); err != nil {\n176\t\t\tt.Fatal(err)\n177\t\t}\n178\t\n179\t\tskills, err := claudecode.DiscoverReviewSkills(context.Background())\n180\t\tif err != nil {\n181\t\t\tt.Fatal(err)\n182\t\t}\n183\t\tif len(skills) != 1 {\n184\t\t\tt.Fatalf(\"expected 1 plugin agent, got %d: %+v\", len(skills), skills)\n185\t\t}\n186\t\tif skills[0].Name != \"/pr-review-toolkit:code-reviewer\" {\n187\t\t\tt.Errorf(\"Name = %q, want /pr-review-toolkit:code-reviewer\", skills[0].Name)\n188\t\t}\n189\t}\n190\t\n191\t// TestDiscoverReviewSkills_SkipsNonReviewCommand verifies that commands\n192\t// whose filename doesn't match keywords (and whose plugin prefix doesn't\n193\t// either) are dropped by the name-only Matches filter.\n194\tfunc TestDiscoverReviewSkills_SkipsNonReviewCommand(t *testing.T) {\n195\t\thome := withFakeHome(t)\n196\t\tcmdDir := filepath.Join(home, \".claude\", \"plugins\", \"cache\",\n197\t\t\t\"fake-market\", \"unrelated-plugin\", \"1.0.0\", \"commands\")\n198\t\tif err := os.MkdirAll(cmdDir, 0o755); err != nil {\n199\t\t\tt.Fatal(err)\n200\t\t}\n201\t\tcontent := `---\n202\tdescription: \"Format your code nicely\"\n203\t---\n204\t`\n205\t\tif err := os.WriteFile(filepath.Join(cmdDir, \"format.md\"), []byte(content), 0o644); err != nil {\n206\t\t\tt.Fatal(err)\n207\t\t}\n208\t\n209\t\tskills, err := claudecode.DiscoverReviewSkills(context.Background())\n210\t\tif err != nil {\n211\t\t\tt.Fatal(err)\n212\t\t}\n213\t\tif len(skills) != 0 {\n214\t\t\tt.Errorf(\"unrelated command should be skipped, got %+v\", skills)\n215\t\t}\n216\t}\n217\t\n218\t// TestDiscoverReviewSkills_SkipsReadme verifies README.md files sitting\n219\t// alongside commands/agents don't get parsed as skills (pr-review-toolkit\n220\t// and several other plugins ship a README.md next to commands/).\n221\tfunc TestDiscoverReviewSkills_SkipsReadme(t *testing.T) {\n222\t\thome := withFakeHome(t)\n223\t\tcmdDir := filepath.Join(home, \".claude\", \"plugins\", \"cache\",\n224\t\t\t\"fake-market\", \"pr-review-toolkit\", \"unknown\", \"commands\")\n225\t\tif err := os.MkdirAll(cmdDir, 0o755); err != nil {\n226\t\t\tt.Fatal(err)\n227\t\t}\n228\t\t// README has no frontmatter and would otherwise trigger parse errors.\n229\t\tif err := os.WriteFile(filepath.Join(cmdDir, \"README.md\"),\n\n... [36 lines truncated] ..."},"type":"attachment","uuid":"02ea7395-8f0a-4382-820d-84db7dcd5247","timestamp":"2026-04-23T07:10:32.253Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-review","sessionId":"32ff705a-db92-4346-a9c8-70b631ba581d","version":"2.1.117","gitBranch":"feat/entire-review-simplify"}
{"parentUuid":"02ea7395-8f0a-4382-820d-84db7dcd5247","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-review/cmd/entire/cli/agent/claudecode/discovery.go","snippet":"1\tpackage claudecode\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"log/slog\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n12\t)\n13\t\n14\t// reviewKeywords are the substrings that mark a skill as review-adjacent.\n15\t// Kept narrow on purpose — \"lint\" is deliberately NOT here because lint\n16\t// skills aren't review-adjacent in practice.\n17\tvar reviewKeywords = []string{\n18\t\t\"review\",\n19\t\t\"audit\",\n20\t\t\"inspect\",\n21\t\t\"critique\",\n22\t\t\"assess\",\n23\t\t\"security-scan\",\n24\t}\n25\t\n26\t// matchesReviewKeyword reports whether the given skill invocation name\n27\t// contains any review-adjacent keyword (case-insensitive). Descriptions are\n28\t// intentionally not matched against — they pull in unrelated skills like\n29\t// \"review the plan\" or \"inspect recent sessions\". Legitimate review skills\n30\t// either have the keyword in their name (e.g. /test-auditor) or live under a\n31\t// plugin whose prefix contains it (e.g. /pr-review-toolkit:silent-failure-hunter\n32\t// matches via \"review\" in \"pr-review-toolkit\").\n33\tfunc matchesReviewKeyword(name string) bool {\n34\t\tlname := strings.ToLower(name)\n35\t\tfor _, kw := range reviewKeywords {\n36\t\t\tif strings.Contains(lname, kw) {\n37\t\t\t\treturn true\n38\t\t\t}\n39\t\t}\n40\t\treturn false\n41\t}\n42\t\n43\t// DiscoveredSkill describes one review-adjacent skill found on disk. Name is\n44\t// the agent-native invocation form (e.g. a slash-prefixed command);\n45\t// Description is scraped from on-disk metadata if available; SourcePath is\n46\t// kept for debug logging and is not shown to the user.\n47\ttype DiscoveredSkill struct {\n48\t\tName        string\n49\t\tDescription string\n50\t\tSourcePath  string\n51\t}\n52\t\n53\t// DiscoverReviewSkills walks Claude Code's on-disk plugin layout and user-\n54\t// level directories looking for review-adjacent invocations. Returns\n55\t// (nil, nil) when HOME is unreadable or directories are missing — discovery\n56\t// is best-effort.\n57\t//\n58\t// Claude Code exposes three kinds of invocable content per plugin:\n59\t//   - skills:   <plugin>/skills/<name>/SKILL.md   (YAML frontmatter with name + description)\n60\t//   - commands: <plugin>/commands/<name>.md       (YAML frontmatter with description; name = filename)\n61\t//   - agents:   <plugin>/agents/<name>.md         (YAML frontmatter with description; name = filename)\n62\t//\n63\t// All three are walked because users invoke them via the same slash-prefix\n64\t// syntax (`/plugin:name`) and any of them can be a review tool. The\n65\t// pr-review-toolkit plugin, for example, ships its review skills as\n66\t// commands/agents (not skills/), and was silently missed by a skills-only\n67\t// walker.\n68\tfunc DiscoverReviewSkills(ctx context.Context) ([]DiscoveredSkill, error) {\n69\t\thome, err := os.UserHomeDir()\n70\t\tif err != nil {\n71\t\t\tlogging.Debug(ctx, \"claude-code discovery: UserHomeDir failed\", slog.String(\"error\", err.Error()))\n72\t\t\treturn nil, nil //nolint:nilnil // best-effort: no home dir means no discovery\n73\t\t}\n74\t\n75\t\tvar found []DiscoveredSkill\n76\t\tfound = append(found, scanPluginCache(ctx, filepath.Join(home, \".claude\", \"plugins\", \"cache\"))...)\n77\t\tfound = append(found, scanUserSkills(ctx, filepath.Join(home, \".claude\", \"skills\"))...)\n78\t\tfound = append(found, scanFlatMarkdownDir(ctx, filepath.Join(home, \".claude\", \"commands\"), \"\")...)\n79\t\tfound = append(found, scanFlatMarkdownDir(ctx, filepath.Join(home, \".claude\", \"agents\"), \"\")...)\n80\t\tif len(found) == 0 {\n81\t\t\treturn nil, nil //nolint:nilnil // best-effort: no matches is an expected outcome, not an error\n82\t\t}\n83\t\treturn found, nil\n84\t}\n85\t\n86\t// scanPluginCache walks <root>/<marketplace>/<plugin>/<version>/{skills,commands,agents}/\n87\t// One plugin can contribute through any or all three directories.\n88\tfunc scanPluginCache(ctx context.Context, root string) []DiscoveredSkill {\n89\t\tentries, err := os.ReadDir(root)\n90\t\tif err != nil {\n91\t\t\tlogging.Debug(ctx, \"claude-code discovery: plugin cache unreadable\",\n92\t\t\t\tslog.String(\"root\", root), slog.String(\"error\", err.Error()))\n93\t\t\treturn nil\n94\t\t}\n95\t\tvar found []DiscoveredSkill\n96\t\tfor _, marketEntry := range entries {\n97\t\t\tif !marketEntry.IsDir() {\n98\t\t\t\tcontinue\n99\t\t\t}\n100\t\t\tmarketRoot := filepath.Join(root, marketEntry.Name())\n101\t\t\tpluginEntries, err := os.ReadDir(marketRoot)\n102\t\t\tif err != nil {\n103\t\t\t\tcontinue\n104\t\t\t}\n105\t\t\tfor _, pluginEntry := range pluginEntries {\n106\t\t\t\tif !pluginEntry.IsDir() {\n107\t\t\t\t\tcontinue\n108\t\t\t\t}\n109\t\t\t\tpluginName := pluginEntry.Name()\n110\t\t\t\tpluginRoot := filepath.Join(marketRoot, pluginName)\n111\t\t\t\tversionEntries, err := os.ReadDir(pluginRoot)\n112\t\t\t\tif err != nil {\n113\t\t\t\t\tcontinue\n114\t\t\t\t}\n115\t\t\t\tfor _, verEntry := range versionEntries {\n116\t\t\t\t\tif !verEntry.IsDir() {\n117\t\t\t\t\t\tcontinue\n118\t\t\t\t\t}\n119\t\t\t\t\tversionRoot := filepath.Join(pluginRoot, verEntry.Name())\n120\t\t\t\t\tfound = append(found, readSkillsDir(ctx, filepath.Join(versionRoot, \"skills\"), pluginName)...)\n121\t\t\t\t\tfound = append(found, scanFlatMarkdownDir(ctx, filepath.Join(versionRoot, \"commands\"), pluginName)...)\n122\t\t\t\t\tfound = append(found, scanFlatMarkdownDir(ctx, filepath.Join(versionRoot, \"agents\"), pluginName)...)\n123\t\t\t\t}\n124\t\t\t}\n125\t\t}\n126\t\treturn found\n127\t}\n128\t\n129\t// scanUserSkills walks ~/.claude/skills/<skill>/SKILL.md.\n130\tfunc scanUserSkills(ctx context.Context, root string) []DiscoveredSkill {\n131\t\treturn readSkillsDir(ctx, root, \"\" /* no plugin prefix */)\n132\t}\n133\t\n134\t// readSkillsDir reads each skill subdirectory's SKILL.md, parses frontmatter,\n135\t// and emits a DiscoveredSkill if Matches() returns true.\n136\tfunc readSkillsDir(ctx context.Context, dir, pluginName string) []DiscoveredSkill {\n137\t\tentries, err := os.ReadDir(dir)\n138\t\tif err != nil {\n139\t\t\treturn nil\n140\t\t}\n141\t\tvar found []DiscoveredSkill\n142\t\tfor _, skillEntry := range entries {\n143\t\t\tif !skillEntry.IsDir() {\n144\t\t\t\tcontinue\n145\t\t\t}\n146\t\t\tskillDir := filepath.Join(dir, skillEntry.Name())\n147\t\t\tskillFile := filepath.Join(skillDir, \"SKILL.md\")\n148\t\t\tdata, err := os.ReadFile(skillFile) //nolint:gosec // G304: skillFile is constructed from a ReadDir walk under HOME, not user input\n149\t\t\tif err != nil {\n150\t\t\t\tcontinue\n151\t\t\t}\n152\t\t\tname, description, parseErr := parseSkillFrontmatter(data)\n153\t\t\tif parseErr != nil {\n154\t\t\t\tlogging.Debug(ctx, \"claude-code discovery: skipping malformed SKILL.md\",\n155\t\t\t\t\tslog.String(\"path\", skillFile), slog.String(\"error\", parseErr.Error()))\n156\t\t\t\tcontinue\n157\t\t\t}\n158\t\t\tif name == \"\" {\n159\t\t\t\tname = skillEntry.Name()\n160\t\t\t}\n161\t\t\tinvocation := invocationName(name, pluginName)\n162\t\t\tif !matchesReviewKeyword(invocation) {\n163\t\t\t\tcontinue\n164\t\t\t}\n165\t\t\t_ = description // kept only for the DiscoveredSkill.Description below\n166\t\t\tfound = append(found, DiscoveredSkill{\n167\t\t\t\tName:        invocation,\n168\t\t\t\tDescription: description,\n169\t\t\t\tSourcePath:  skillFile,\n170\t\t\t})\n171\t\t}\n172\t\treturn found\n173\t}\n174\t\n175\t// scanFlatMarkdownDir reads *.md files directly under dir (no nesting), parses\n176\t// their YAML frontmatter for `description:`, and derives the invocation name\n177\t// from the filename (stripping the .md suffix). Used for both 