one is closed, then exits cleanly.\ntype slowFakeAgent struct {\n\tagent.Agent\n\tname string\n\tdone <-chan struct{}\n}\n\nfunc (s *slowFakeAgent) Name() agent.Name { return agent.Name(s.name) }\nfunc (s *slowFakeAgent) LaunchHeadlessCmd(ctx context.Context, _ string) (*exec.Cmd, error) {\n\t// Use a script that tails a fifo or waits for ctx. Simpler: use sleep\n\t// that respects ctx cancellation.\n\treturn exec.CommandContext(ctx, \"sh\", \"-c\", `sleep 10; printf \"done\"`), nil\n}\n// NOTE: slowFakeAgent is simplified — real impl of the above test needs\n// tighter orchestration. The plan's test is illustrative; implementer\n// should replace blockUntil with a proper synchronization primitive if\n// time.Sleep(50ms) is flaky.\n\n// Per-agent failure independent.\nfunc TestOrchestrator_FailurePerAgentIndependent(t *testing.T) {\n\tt.Parallel()\n\tenv := setupReviewTestRepoWithCommit(t)\n\n\ttasks := []MultiAgentTask{\n\t\t{Name: \"fake-ok\", Prompt: \"r\", Agent: &fakeHeadlessAgent{name: \"fake-ok\", output: \"OK\\n\"}},\n\t\t{Name: \"fake-fail\", Prompt: \"r\", Agent: &fakeHeadlessAgent{name: \"fake-fail\", output: \"\", exitCode: 1}},\n\t}\n\n\torch := newMultiReviewOrchestrator(env.WorktreePath)\n\tresult, err := orch.Run(context.Background(), tasks, io.Discard)\n\tif err != nil {\n\t\tt.Fatalf(\"Run should return non-nil result even with failures: %v\", err)\n\t}\n\tvar ok, fail int\n\tfor _, r := range result.Runs {\n\t\tif r.Status == AgentRunDone {\n\t\t\tok++\n\t\t}\n\t\tif r.Status == AgentRunFailed {\n\t\t\tfail++\n\t\t}\n\t}\n\tif ok != 1 || fail != 1 {\n\t\tt.Errorf(\"got %d ok, %d fail; want 1 and 1\", ok, fail)\n\t}\n}\n\n// Cancel via context should clean up marker + SIGTERM all subprocesses.\nfunc TestOrchestrator_CancelCleansMarker(t *testing.T) {\n\t// Can't t.Parallel — reads marker.\n\tenv := setupReviewTestRepoWithCommit(t)\n\n\ttasks := []MultiAgentTask{\n\t\t{Name: \"slow\", Prompt: \"r\", Agent: &fakeHeadlessAgent{name: \"slow\", output: 