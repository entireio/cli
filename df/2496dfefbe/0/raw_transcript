.ExitError); ok {\n\t\t\t\t\texitCode = exitErr.ExitCode()\n\t\t\t\t\tstatus = AgentRunFailed\n\t\t\t\t} else if errors.Is(runCtx.Err(), context.Canceled) {\n\t\t\t\t\tstatus = AgentRunCancelled\n\t\t\t\t} else {\n\t\t\t\t\tstatus = AgentRunFailed\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Resolve transcript path + token usage post-exit.\n\t\t\tvar transcriptPath string\n\t\t\tvar tokenUsage *agent.TokenUsage\n\t\t\tif status == AgentRunDone {\n\t\t\t\tif sbp, ok := task.Agent.(agent.SessionBaseDirProvider); ok {\n\t\t\t\t\tdir, _ := sbp.GetSessionBaseDir()\n\t\t\t\t\ttranscriptPath = resolveLatestTranscript(dir) // best-effort\n\t\t\t\t\tif transcriptPath != \"\" {\n\t\t\t\t\t\tdata, err := os.ReadFile(transcriptPath) //nolint:gosec // derived from agent's own dir\n\t\t\t\t\t\tif err == nil {\n\t\t\t\t\t\t\ttokenUsage, _ = task.Agent.CalculateTokenUsage(data, 0)\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tresults[i] = AgentRunResult{\n\t\t\t\tName:           task.Name,\n\t\t\t\tStatus:         status,\n\t\t\t\tExitCode:       exitCode,\n\t\t\t\tDuration:       duration,\n\t\t\t\tFinalOutput:    buf.Bytes(),\n\t\t\t\tErr:            runErr,\n\t\t\t\tTokenUsage:     tokenUsage,\n\t\t\t\tTranscriptPath: transcriptPath,\n\t\t\t}\n\t\t}()\n\t}\n\n\twg.Wait()\n\n\t// 6. Dump per-agent final outputs.\n\tdumpMultiAgentResults(out, tasks, results, cancelled.load())\n\n\treturn MultiRunResult{\n\t\tRuns:      results,\n\t\tDuration:  computeTotalDuration(results),\n\t\tCancelled: cancelled.load(),\n\t}, nil\n}\n\n// dumpMultiAgentResults prints per-agent headers + FinalOutput, then a\n// summary line, then transcript paths for successful agents.\nfunc dumpMultiAgentResults(out io.Writer, tasks []MultiAgentTask, results []AgentRunResult, cancelled bool) {\n\tfor i, r := range results {\n\t\tfmt.Fprintf(out, \"\\n─────── %s review ───────\\n\", tasks[i].Name)\n\t\tswitch r.Status {\n\t\tcase AgentRunFailed:\n\t\t\tfmt.Fprintf(out, \"(failed — exit %d)\\n\", r.ExitCode)\n\t\t\tif r.Err != nil {\n\t\t\t\tfmt.Fprintf(out, \"%v\\n\\n\", r.Err)\n\t\t\t}\n\t\tcase AgentRunCancelled:\n\t\t\tfmt.Fprintln(out, \"(cancelled)\\n\")\n\t\t}\n\t\tout.Write(r.FinalOutput)\n\t}\n\n\t// Summary line.\n\tvar nSucc, nFail, nCancel int\n\tfor _, r := range results {\n\t\tswitch r.Status {\n\t\tcase AgentRunDone:\n\t\t\tnSucc++\n\t\tcase AgentRunFailed:\n\t\t\tnFail++\n\t\tcase AgentRunCancelled:\n\t\t\tnCancel++\n\t\t}\n\t}\n\tfmt.Fprintln(out)\n\tfmt.Fprintf(out, \"✓ %d agents done in %s (%d succeeded, %d failed, %d cancelled)\\n\",\n\t\tlen(results), computeTotalDuration(results), nSucc, nFail, nCancel)\n\tif !cancelled && nSucc > 0 {\n\t\tfmt.Fprintln(out, \"  Run `git commit` to attach the review to the next checkpoint.\")\n\t}\n\n\t// Transcript paths (where known).\n\tanyPath := false\n\tfor _, r := range results {\n\t\tif r.TranscriptPath != \"\" {\n\t\t\tif !anyPath {\n\t\t\t\tfmt.Fprintln(out, \"\\n  Full transcripts (including tool calls + reasoning):\")\n\t\t\t\tanyPath = true\n\t\t\t}\n\t\t\tfmt.Fprintf(out, \"    %-12s → %s\\n\", r.Name, r.TranscriptPath)\n\t\t}\n\t}\n}\n\nfunc computeTotalDuration(results []AgentRunResult) time.Duration {\n\tvar max time.Duration\n\tfor _, r := range results {\n\t\tif r.Duration > max {\n\t\t\tmax = r.Duration\n\t\t}\n\t}\n\treturn max\n}\n\nfunc forceKillAll(cmds []*exec.Cmd) {\n\tfor _, cmd := range cmds {\n\t\tif cmd == nil || cmd.Process == nil {\n\t\t\tcontinue\n\t\t}\n\t\t_ = cmd.Process.Kill()\n\t}\n}\n\nfunc resolveLatestTranscript(baseDir string) string {\n\tif baseDir == \"\" {\n\t\treturn \"\"\n\t}\n\tentries, err := os.ReadDir(baseDir)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\t// Best-effort: find newest .jsonl file in baseDir recursively. Could\n\t// also use agent.ResolveSessionFile if available. For Chunk 3 a simple\n\t// newest-file approach is sufficient; tests use a known fixture path.\n\t_ = entries\n\treturn \"\" // Chunk 4 can refine; Chunk 3 leaves transcripts unresolved if ambiguous\