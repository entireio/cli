view messages per second per agent.\nconst previewRateWindow = 100 * time.Millisecond\n\n// multiReviewOrchestrator owns the lifecycle of an N-agent parallel review:\n// writes the shared pending marker, spawns goroutines per agent, drives\n// cancellation, cleans up on exit. The TUI (Chunk 4) is separate — this\n// orchestrator signals state changes via an output channel the TUI consumes.\n//\n// Chunk 3 implements the logic with io.Writer-based output dump; Chunk 4\n// swaps in the tea.Program. See the spec's §Runtime orchestration for the\n// full message shape.\ntype multiReviewOrchestrator struct {\n\tworktreePath string\n\t// tea-program hook for Chunk 4; nil here in Chunk 3 means \"dump\n\t// directly to out at end\".\n\tteaProgram interface {\n\t\tSend(msg interface{})\n\t\tRun() (interface{}, error)\n\t}\n}\n\nfunc newMultiReviewOrchestrator(worktreePath string) *multiReviewOrchestrator {\n\treturn &multiReviewOrchestrator{worktreePath: worktreePath}\n}\n\n// Run spawns all tasks, waits for completion or cancellation, cleans up the\n// marker, and dumps final per-agent responses to out.\nfunc (o *multiReviewOrchestrator) Run(ctx context.Context, tasks []MultiAgentTask, out io.Writer) (MultiRunResult, error) {\n\tif len(tasks) == 0 {\n\t\treturn MultiRunResult{}, errors.New(\"orchestrator: no tasks\")\n\t}\n\n\t// 1. Write shared marker.\n\theadSHA, _ := currentHeadSHA() // best-effort\n\tagentNames := make([]string, len(tasks))\n\tfor i, t := range tasks {\n\t\tagentNames[i] = t.Name\n\t}\n\tif err := WritePendingReviewMarker(ctx, PendingReviewMarker{\n\t\tAgentNames:   agentNames,\n\t\tSkills:       nil, // per-agent Skills are on their own Config; marker is informational\n\t\tPrompt:       \"\", // per-agent\n\t\tStartingSHA:  headSHA,\n\t\tStartedAt:    time.Now(),\n\t\tWorktreePath: o.worktreePath,\n\t}); err != nil {\n\t\treturn MultiRunResult{}, fmt.Errorf(\"write marker: %w\", err)\n\t}\n\n\t// 2. Defer marker cleanup — regardless of exit path.\n\tdefer func() {\n\t\tif err := ClearPendingReviewMarker(context.Background()); err != nil {\n\t\t\tlogging.Debug(ctx, \"orchestrator: marker cleanup failed\", \"err\", err.Error())\n\t\t}\n\t}()\n\n\t// 3. Cancel-aware context for the signal cascade.\n\trunCtx, cancelRun := context.WithCancel(ctx)\n\tdefer cancelRun()\n\n\t// 4. Signal handler for Ctrl+C cascade (SIGTERM → 5s watchdog → SIGKILL).\n\tsigCh := make(chan os.Signal, 2)\n\tsignal.Notify(sigCh, syscall.SIGINT)\n\tdefer signal.Stop(sigCh)\n\n\tcancelled := &atomicBool{}\n\tgo func() {\n\t\tselect {\n\t\tcase <-sigCh:\n\t\t\tcancelled.store(true)\n\t\t\tcancelRun() // SIGTERM to subprocesses via exec.CommandContext\n\t\t\twatchdog := time.NewTimer(5 * time.Second)\n\t\t\tdefer watchdog.Stop()\n\t\t\tselect {\n\t\t\tcase <-sigCh:\n\t\t\t\t// Second Ctrl+C — immediate SIGKILL below via process.Kill\n\t\t\t\tforceKillAll(tasksCmds)\n\t\t\tcase <-watchdog.C:\n\t\t\t\t// First-press window expired — SIGKILL.\n\t\t\t\tforceKillAll(tasksCmds)\n\t\t\tcase <-runCtx.Done():\n\t\t\t\t// All done naturally.\n\t\t\t}\n\t\tcase <-runCtx.Done():\n\t\t}\n\t}()\n\n\t// 5. Spawn one goroutine per task. Capture *exec.Cmd pointers for\n\t// the watchdog's SIGKILL escalation.\n\ttasksCmds := make([]*exec.Cmd, len(tasks))\n\tvar wg sync.WaitGroup\n\tresults := make([]AgentRunResult, len(tasks))\n\n\tfor i, task := range tasks {\n\t\ti, task := i, task // capture\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tstartTime := time.Now()\n\n\t\t\tcmd, err := task.Agent.LaunchHeadlessCmd(runCtx, task.Prompt)\n\t\t\tif err != nil {\n\t\t\t\tresults[i] = AgentRunResult{\n\t\t\t\t\tName:     task.Name,\n\t\t\t\t\tStatus:   AgentRunFailed,\n\t\t\t\t\tDuration: time.Since(startTime),\n\t\t\t\t\tErr:      fmt.Errorf(\"launch %s: %w\", task.Name, err),\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\ttasksCmds[i] = cmd\n\n\t\t\tvar buf bytes.Buffer\n\t\t\t// Preview tee: line-oriented, rate-limited. Chunk 4 wires this\n\t\t\t// to the TUI; Chunk 3 only buffers for the final dump.\n\t\t\tcmd.Stdout = &buf\n\t\t\tcmd.Stderr = &buf\n\n\t\t\trunErr := cmd.Run()\n\t\t\tduration := time.Since(startTime)\n\n\t\t\tstatus := AgentRunDone\n\t\t\texitCode := 0\n\t\t\tif runErr != nil {\n\t\t\t\tif exitErr, ok := runErr.(*exec.ExitError); ok {\n\t\t\t\t\texitCode = exitErr.ExitCode()\n\t\t\t\t\tstatus = AgentRunFailed\n\t\t\t\t} else if errors.Is(runCtx.Err(), context.Canceled) {\n\t\t\t\t\tstatus = AgentRunCancelled\n\t\t\t\t} else {\n\t\t\t\t\tstatus = AgentRunFailed\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Resolve transcript path + token usage post-exit.\n\t\t\tvar transcriptPath string\n\t\t\tvar tokenUsage *agent.TokenUsage\n\t\t\tif status == AgentRunDone {\n\t\t\t\tif sbp, ok := task.Agent.(agent.SessionBaseDirProvider); ok {\n\t\t\t\t\tdir, _ := sbp.GetSessionBaseDir()\n\t\t\t\t\ttranscriptPath = resolveLatestTranscript(dir) // best-effort\n\t\t\t\t\tif transcriptPath != \"\" {\n\t\t\t\t\t\tdata, err := os.ReadFile(transcriptPath) //nolint:gosec // derived from agent's own dir\n\t\t\t\t\t\tif err == nil {\n\t\t\t\t\t\t\ttokenUsage, _ = task.Agent.CalculateTokenUsage(data, 0)\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tresults[i] = AgentRunResult{\n\t\t\t\tName:           task.Name,\n\t\t\t\tStatus:         status,\n\t\t\t\tExitCode:       exitCode,\n\t\t\t\tDuration:       duration,\n\t\t\t\tFinalOutput:    buf.Bytes(),\n\t\t\t\tErr:            runErr,\n\t\t\t\tTokenUsage:     tokenUsage,\n\t\t\t\tTranscriptPath: transcriptPath,\n\t\t\t}\n\t\t}()\n\t}\n\n\twg.Wait()\n\n\t// 6. Dump per-agent final outputs.\n\tdumpMultiAgentResults(out, tasks, results, cancelled.load())\n\n\treturn MultiRunResult{\n\t\tRuns:      results,\n\t\tDuration:  computeTotalDuration(results),\n\t\tCancelled: cancelled.load(),\n\t}, nil\n}\n\n// dumpMultiAgentResults prints per-agent headers + FinalOutput, then a\n// summary line, then transcript paths for successful agents.\nfunc dumpMultiAgentResults(out io.Writer, tasks 