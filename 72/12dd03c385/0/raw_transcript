{"parentUuid":"67d76e9e-2774-45d6-b119-818cec783d2c","isSidechain":false,"promptId":"a88855a5-7f38-4cd0-bf54-44ecd740fdd5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JiwYHsosqGqd9Nt3AnwcQ6","type":"tool_result","content":"1\t// lifecycle.go implements the generic lifecycle event dispatcher.\n2\t// It routes normalized events from any agent to the appropriate framework actions.\n3\t//\n4\t// The dispatcher inverts the current flow from \"agent handler calls framework functions\"\n5\t// to \"framework dispatcher calls agent methods.\" Agents are passive data providers;\n6\t// the dispatcher handles all orchestration: state transitions, strategy calls,\n7\t// file change detection, metadata generation.\n8\tpackage cli\n9\t\n10\timport (\n11\t\t\"context\"\n12\t\t\"errors\"\n13\t\t\"fmt\"\n14\t\t\"log/slog\"\n15\t\t\"os\"\n16\t\t\"path/filepath\"\n17\t\t\"strings\"\n18\t\t\"time\"\n19\t\n20\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n21\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n22\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n23\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n24\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n25\t\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n26\t\t\"github.com/entireio/cli/cmd/entire/cli/transcript\"\n27\t\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n28\t\t\"github.com/entireio/cli/perf\"\n29\t)\n30\t\n31\t// DispatchLifecycleEvent routes a normalized lifecycle event to the appropriate handler.\n32\t// Returns nil if the event was handled successfully.\n33\tfunc DispatchLifecycleEvent(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n34\t\tif ag == nil {\n35\t\t\treturn errors.New(\"agent cannot be nil\")\n36\t\t}\n37\t\tif event == nil {\n38\t\t\treturn errors.New(\"event cannot be nil\")\n39\t\t}\n40\t\n41\t\tswitch event.Type {\n42\t\tcase agent.SessionStart:\n43\t\t\treturn handleLifecycleSessionStart(ctx, ag, event)\n44\t\tcase agent.TurnStart:\n45\t\t\treturn handleLifecycleTurnStart(ctx, ag, event)\n46\t\tcase agent.TurnEnd:\n47\t\t\treturn handleLifecycleTurnEnd(ctx, ag, event)\n48\t\tcase agent.Compaction:\n49\t\t\treturn handleLifecycleCompaction(ctx, ag, event)\n50\t\tcase agent.SessionEnd:\n51\t\t\treturn handleLifecycleSessionEnd(ctx, ag, event)\n52\t\tcase agent.SubagentStart:\n53\t\t\treturn handleLifecycleSubagentStart(ctx, ag, event)\n54\t\tcase agent.SubagentEnd:\n55\t\t\treturn handleLifecycleSubagentEnd(ctx, ag, event)\n56\t\tcase agent.ModelUpdate:\n57\t\t\treturn handleLifecycleModelUpdate(ctx, ag, event)\n58\t\tdefault:\n59\t\t\treturn fmt.Errorf(\"unknown lifecycle event type: %d\", event.Type)\n60\t\t}\n61\t}\n62\t\n63\t// handleLifecycleSessionStart handles session start: shows banner, checks concurrent sessions,\n64\t// fires state machine transition.\n65\tfunc handleLifecycleSessionStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n66\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n67\t\tlogging.Info(logCtx, \"session-start\",\n68\t\t\tslog.String(\"event\", event.Type.String()),\n69\t\t\tslog.String(\"session_id\", event.SessionID),\n70\t\t\tslog.String(\"session_ref\", event.SessionRef),\n71\t\t\tslog.String(\"model\", event.Model),\n72\t\t)\n73\t\n74\t\tif event.SessionID == \"\" {\n75\t\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n76\t\t}\n77\t\tif err := validation.ValidateSessionID(event.SessionID); err != nil {\n78\t\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n79\t\t}\n80\t\n81\t\t// Build informational message — warn early if repo has no commits yet,\n82\t\t// since checkpoints require at least one commit to work.\n83\t\tmessage := sessionStartMessage(ag.Name(), false)\n84\t\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n85\t\t\tmessage = sessionStartMessage(ag.Name(), true)\n86\t\t}\n87\t\n88\t\t// Check for concurrent sessions and append count if any\n89\t\t_, countSessionsSpan := perf.Start(ctx, \"count_active_sessions\")\n90\t\tstrat := GetStrategy(ctx)\n91\t\tif count, err := strat.CountOtherActiveSessionsWithCheckpoints(ctx, event.SessionID); err == nil && count > 0 {\n92\t\t\tif ag.Name() == agent.AgentNameCodex {\n93\t\t\t\tmessage += fmt.Sprintf(\" %d other active conversation(s) in this workspace will also be included. Use 'entire status' for more information.\", count)\n94\t\t\t} else {\n95\t\t\t\tmessage += fmt.Sprintf(\"\\n  %d other active conversation(s) in this workspace will also be included.\\n  Use 'entire status' for more information.\", count)\n96\t\t\t}\n97\t\t}\n98\t\tcountSessionsSpan.End()\n99\t\n100\t\t// Output informational message if the agent supports hook responses.\n101\t\t// Claude Code reads JSON from stdout; agents that don't implement\n102\t\t// HookResponseWriter silently skip (avoids raw JSON in their terminal).\n103\t\t_, hookResponseSpan := perf.Start(ctx, \"write_hook_response\")\n104\t\tif event.ResponseMessage != \"\" {\n105\t\t\tmessage = event.ResponseMessage\n106\t\t}\n107\t\tif writer, ok := agent.AsHookResponseWriter(ag); ok {\n108\t\t\tif err := writer.WriteHookResponse(message); err != nil {\n109\t\t\t\thookResponseSpan.RecordError(err)\n110\t\t\t\thookResponseSpan.End()\n111\t\t\t\treturn fmt.Errorf(\"failed to write hook response: %w\", err)\n112\t\t\t}\n113\t\t}\n114\t\thookResponseSpan.End()\n115\t\n116\t\t// Store model hint if the agent provided model info on SessionStart\n117\t\tif event.Model != \"\" {\n118\t\t\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n119\t\t\t\tlogging.Warn(logCtx, \"failed to store model hint on session start\",\n120\t\t\t\t\tslog.String(\"error\", err.Error()))\n121\t\t\t}\n122\t\t}\n123\t\n124\t\t// Fire EventSessionStart for the current session (if state exists).\n125\t\tif state, loadErr := strategy.LoadSessionState(ctx, event.SessionID); loadErr != nil {\n126\t\t\tlogging.Warn(logCtx, \"failed to load session state on start\",\n127\t\t\t\tslog.String(\"error\", loadErr.Error()))\n128\t\t} else if state != nil {\n129\t\t\tpersistEventMetadataToState(event, state)\n130\t\t\tif transErr := strategy.TransitionAndLog(ctx, state, session.EventSessionStart, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n131\t\t\t\tlogging.Warn(logCtx, \"session start transition failed\",\n132\t\t\t\t\tslog.String(\"error\", transErr.Error()))\n133\t\t\t}\n134\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n135\t\t\t\tlogging.Warn(logCtx, \"failed to update session state on start\",\n136\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n137\t\t\t}\n138\t\t}\n139\t\n140\t\treturn nil\n141\t}\n142\t\n143\tfunc sessionStartMessage(agentName types.AgentName, emptyRepo bool) string {\n144\t\tif agentName == agent.AgentNameCodex {\n145\t\t\tif emptyRepo {\n146\t\t\t\treturn \"Entire CLI found no commits yet — checkpoints will activate after your first commit.\"\n147\t\t\t}\n148\t\t\treturn \"Entire CLI will link this conversation to your next commit.\"\n149\t\t}\n150\t\n151\t\tif emptyRepo {\n152\t\t\treturn \"\\n\\nEntire CLI found no commits yet — checkpoints will activate after your first commit.\"\n153\t\t}\n154\t\treturn \"\\n\\nEntire CLI will link this conversation to your next commit.\"\n155\t}\n156\t\n157\t// handleLifecycleModelUpdate persists the model name for the current session.\n158\t//\n159\t// If the session state file already exists (e.g., Gemini's BeforeModel fires\n160\t// after TurnStart), the model is written directly to state.ModelName — no hint\n161\t// file needed. Otherwise falls back to StoreModelHint for cross-process\n162\t// persistence (see its doc comment for the full rationale).\n163\tfunc handleLifecycleModelUpdate(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n164\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n165\t\tlogging.Info(logCtx, \"model-update\",\n166\t\t\tslog.String(\"session_id\", event.SessionID),\n167\t\t\tslog.String(\"model\", event.Model),\n168\t\t)\n169\t\n170\t\tif event.SessionID == \"\" || event.Model == \"\" {\n171\t\t\treturn nil\n172\t\t}\n173\t\n174\t\t// Prefer writing directly to session state when it exists\n175\t\tstate, loadErr := strategy.LoadSessionState(ctx, event.SessionID)\n176\t\tif loadErr != nil {\n177\t\t\tlogging.Debug(logCtx, \"could not load session state for model update, using hint file\",\n178\t\t\t\tslog.String(\"error\", loadErr.Error()))\n179\t\t}\n180\t\tif loadErr == nil && state != nil {\n181\t\t\tstate.ModelName = event.Model\n182\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n183\t\t\t\tlogging.Warn(logCtx, \"failed to update session state with model\",\n184\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n185\t\t\t}\n186\t\t\treturn nil\n187\t\t}\n188\t\n189\t\t// State doesn't exist yet (or failed to load) — use hint file (see StoreModelHint doc)\n190\t\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n191\t\t\tlogging.Warn(logCtx, \"failed to store model hint\",\n192\t\t\t\tslog.String(\"error\", err.Error()))\n193\t\t}\n194\t\n195\t\treturn nil\n196\t}\n197\t\n198\t// handleLifecycleTurnStart handles turn start: captures pre-prompt state,\n199\t// ensures strategy setup, initializes session.\n200\tfunc handleLifecycleTurnStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n201\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n202\t\tlogging.Info(logCtx, \"turn-start\",\n203\t\t\tslog.String(\"event\", event.Type.String()),\n204\t\t\tslog.String(\"session_id\", event.SessionID),\n205\t\t\tslog.String(\"session_ref\", event.SessionRef),\n206\t\t\tslog.String(\"model\", event.Model),\n207\t\t)\n208\t\n209\t\tsessionID := event.SessionID\n210\t\tif sessionID == \"\" {\n211\t\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n212\t\t}\n213\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n214\t\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n215\t\t}\n216\t\n217\t\t// Fill model from hint file if the agent didn't provide it on this hook\n218\t\tif event.Model == \"\" {\n219\t\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n220\t\t\t\tevent.Model = hint\n221\t\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n222\t\t\t\t\tslog.String(\"model\", hint))\n223\t\t\t}\n224\t\t}\n225\t\n226\t\t// Capture pre-prompt state (including transcript position via TranscriptAnalyzer)\n227\t\t_, captureSpan := perf.Start(ctx, \"capture_pre_prompt_state\")\n228\t\tif err := CapturePrePromptState(ctx, ag, sessionID, event.SessionRef); err != nil {\n229\t\t\tcaptureSpan.RecordError(err)\n230\t\t\tcaptureSpan.End()\n231\t\t\treturn err\n232\t\t}\n233\t\tcaptureSpan.End()\n234\t\n235\t\t// Append prompt to prompt.txt on filesystem so it's available for\n236\t\t// mid-turn commits (before SaveStep writes it to the shadow branch).\n237\t\t// Prompts are separated by \"\\n\\n---\\n\\n\" to support multiple turns.\n238\t\tif event.Prompt != \"\" {\n239\t\t\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n240\t\t\tif sessionDirAbs, absErr := paths.AbsPath(ctx, sessionDir); absErr == nil {\n241\t\t\t\tif mkErr := os.MkdirAll(sessionDirAbs, 0o750); mkErr == nil {\n242\t\t\t\t\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n243\t\t\t\t\texisting, readErr := os.ReadFile(promptPath) //nolint:gosec // session metadata path\n244\t\t\t\t\tvar content string\n245\t\t\t\t\tif readErr == nil && len(existing) > 0 {\n246\t\t\t\t\t\tcontent = string(existing) + \"\\n\\n---\\n\\n\" + event.Prompt\n247\t\t\t\t\t} else {\n248\t\t\t\t\t\tcontent = event.Prompt\n249\t\t\t\t\t}\n250\t\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil { //nolint:gosec // path from internal metadata, not user input\n251\t\t\t\t\t\tlogging.Warn(logCtx, \"failed to write prompt.txt\",\n252\t\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n253\t\t\t\t\t}\n254\t\t\t\t}\n255\t\t\t}\n256\t\t}\n257\t\n258\t\t// Ensure strategy setup and initialize session\n259\t\t_, initSpan := perf.Start(ctx, \"init_session\")\n260\t\tif err := strategy.EnsureSetup(ctx); err != nil {\n261\t\t\tlogging.Warn(logCtx, \"failed to ensure strategy setup\",\n262\t\t\t\tslog.String(\"error\", err.Error()))\n263\t\t}\n264\t\n265\t\tstrat := GetStrategy(ctx)\n266\t\tif err := strat.InitializeSession(ctx, sessionID, ag.Type(), event.SessionRef, event.Prompt, event.Model); err != nil {\n267\t\t\tlogging.Warn(logCtx, \"failed to initialize session state\",\n268\t\t\t\tslog.String(\"error\", err.Error()))\n269\t\t}\n270\t\tinitSpan.End()\n271\t\n272\t\treturn nil\n273\t}\n274\t\n275\t// handleLifecycleTurnEnd handles turn end: validates transcript, extracts metadata,\n276\t// detects file changes, saves step + checkpoint, transitions phase.\n277\t//\n278\t//nolint:maintidx // high complexity due to sequential orchestration of 8 steps (validation, extraction, file detection, filtering, token calc, step save, phase transition, cleanup) - splitting would obscure the flow\n279\tfunc handleLifecycleTurnEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n280\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n281\t\tlogging.Info(logCtx, \"turn-end\",\n282\t\t\tslog.String(\"event\", event.Type.String()),\n283\t\t\tslog.String(\"session_id\", event.SessionID),\n284\t\t\tslog.String(\"session_ref\", event.SessionRef),\n285\t\t\tslog.String(\"model\", event.Model),\n286\t\t)\n287\t\n288\t\tsessionID := event.SessionID\n289\t\tif sessionID == \"\" {\n290\t\t\tsessionID = unknownSessionID\n291\t\t}\n292\t\n293\t\t// Fill model from hint file if the agent didn't provide it on this hook\n294\t\tif event.Model == \"\" && sessionID != unknownSessionID {\n295\t\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n296\t\t\t\tevent.Model = hint\n297\t\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n298\t\t\t\t\tslog.String(\"model\", hint))\n299\t\t\t}\n300\t\t}\n301\t\n302\t\ttranscriptRef := event.SessionRef\n303\t\tif transcriptRef == \"\" {\n304\t\t\treturn errors.New(\"transcript file not specified\")\n305\t\t}\n306\t\n307\t\t// If agent implements TranscriptPreparer, materialize the transcript file.\n308\t\t// This must run BEFORE fileExists: agents like OpenCode lazily fetch transcripts\n309\t\t// via `opencode export`, so the file doesn't exist until PrepareTranscript creates it.\n310\t\t// Claude Code's PrepareTranscript just flushes (always succeeds). Agents without\n311\t\t// TranscriptPreparer (Gemini, Droid) are unaffected.\n312\t\t_, prepareSpan := perf.Start(ctx, \"prepare_and_validate_transcript\")\n313\t\tif preparer, ok := agent.AsTranscriptPreparer(ag); ok {\n314\t\t\tif err := preparer.PrepareTranscript(ctx, transcriptRef); err != nil {\n315\t\t\t\tlogging.Warn(logCtx, \"failed to prepare transcript\",\n316\t\t\t\t\tslog.String(\"error\", err.Error()))\n317\t\t\t}\n318\t\t}\n319\t\n320\t\tif !fileExists(transcriptRef) {\n321\t\t\tprepareSpan.RecordError(fmt.Errorf(\"transcript file not found: %s\", transcriptRef))\n322\t\t\tprepareSpan.End()\n323\t\t\treturn fmt.Errorf(\"transcript file not found: %s\", transcriptRef)\n324\t\t}\n325\t\n326\t\t// Early check: bail out quickly if the repo has no commits yet.\n327\t\t// Return nil (not an error) so the hook exits 0 — agents treat non-zero\n328\t\t// exit codes as hook failures. The user was already warned at session start.\n329\t\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n330\t\t\tprepareSpan.End()\n331\t\t\tlogging.Info(logCtx, \"skipping checkpoint - will activate after first commit\")\n332\t\t\treturn nil\n333\t\t}\n334\t\tprepareSpan.End()\n335\t\n336\t\t// Create session metadata directory\n337\t\t_, copySpan := perf.Start(ctx, \"copy_transcript\")\n338\t\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n339\t\tsessionDirAbs, err := paths.AbsPath(ctx, sessionDir)\n340\t\tif err != nil {\n341\t\t\tsessionDirAbs = sessionDir\n342\t\t}\n343\t\tif err := os.MkdirAll(sessionDirAbs, 0o750); err != nil {\n344\t\t\tcopySpan.RecordError(err)\n345\t\t\tcopySpan.End()\n346\t\t\treturn fmt.Errorf(\"failed to create session directory: %w\", err)\n347\t\t}\n348\t\n349\t\t// Copy transcript to session directory\n350\t\ttranscriptData, err := ag.ReadTranscript(transcriptRef)\n351\t\tif err != nil {\n352\t\t\tcopySpan.RecordError(err)\n353\t\t\tcopySpan.End()\n354\t\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n355\t\t}\n356\t\tlogFile := filepath.Join(sessionDirAbs, paths.TranscriptFileName)\n357\t\tif err := os.WriteFile(logFile, transcriptData, 0o600); err != nil {\n358\t\t\tcopySpan.RecordError(err)\n359\t\t\tcopySpan.End()\n360\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n361\t\t}\n362\t\tlogging.Debug(logCtx, \"copied transcript\",\n363\t\t\tslog.String(\"path\", sessionDir+\"/\"+paths.TranscriptFileName))\n364\t\tcopySpan.End()\n365\t\n366\t\t// Load pre-prompt state (captured on TurnStart)\n367\t\t_, extractSpan := perf.Start(ctx, \"extract_metadata\")\n368\t\tpreState, err := LoadPrePromptState(ctx, sessionID)\n369\t\tif err != nil {\n370\t\t\tlogging.Warn(logCtx, \"failed to load pre-prompt state\",\n371\t\t\t\tslog.String(\"error\", err.Error()))\n372\t\t}\n373\t\n374\t\t// Determine transcript offset\n375\t\ttranscriptOffset := resolveTranscriptOffset(ctx, preState, sessionID)\n376\t\n377\t\t// Backfill prompt.txt from transcript when prompt data is missing.\n378\t\t// This handles agents whose exec mode doesn't fire UserPromptSubmit (e.g., Factory AI\n379\t\t// Droid). The transcript is the source of truth — if ExtractPrompts returns nothing,\n380\t\t// there genuinely were no prompts. We track whether backfill occurred so we can\n381\t\t// update session state after SaveStep (which may reinitialize state).\n382\t\tvar backfilledPrompt string\n383\t\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n384\t\texistingPrompt, readPromptErr := os.ReadFile(promptPath) //nolint:gosec // file content is safe session metadata\n385\t\tif readPromptErr != nil && !os.IsNotExist(readPromptErr) {\n386\t\t\tlogging.Warn(logCtx, \"failed to read prompt.txt, skipping backfill\",\n387\t\t\t\tslog.String(\"error\", readPromptErr.Error()))\n388\t\t} else if len(existingPrompt) == 0 {\n389\t\t\tif extractor, ok := agent.AsPromptExtractor(ag); ok {\n390\t\t\t\tprompts, extractErr := extractor.ExtractPrompts(transcriptRef, transcriptOffset)\n391\t\t\t\tif extractErr != nil {\n392\t\t\t\t\tlogging.Warn(logCtx, \"failed to extract prompts from transcript\",\n393\t\t\t\t\t\tslog.String(\"error\", extractErr.Error()))\n394\t\t\t\t} else if len(prompts) > 0 {\n395\t\t\t\t\tcontent := strings.Join(prompts, \"\\n\\n---\\n\\n\")\n396\t\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil {\n397\t\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill prompt.txt from transcript\",\n398\t\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n399\t\t\t\t\t} else {\n400\t\t\t\t\t\tlogging.Debug(logCtx, \"backfilled prompt.txt from transcript\",\n401\t\t\t\t\t\t\tslog.Int(\"prompt_count\", len(prompts)))\n402\t\t\t\t\t\tbackfilledPrompt = prompts[len(prompts)-1]\n403\t\t\t\t\t}\n404\t\t\t\t}\n405\t\t\t}\n406\t\t}\n407\t\n408\t\t// Compute subagents directory for agents that support subagent extraction.\n409\t\t// Subagent transcripts live in <transcriptDir>/<modelSessionID>/subagents/\n410\t\tsubagentsDir := filepath.Join(filepath.Dir(transcriptRef), event.SessionID, \"subagents\")\n411\t\n412\t\t// Extract metadata via agent interface (modified files)\n413\t\tvar modifiedFiles []string\n414\t\n415\t\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n416\t\t\t// Extract modified files - prefer SubagentAwareExtractor if available to include subagent files\n417\t\t\tif subagentExtractor, subOk := agent.AsSubagentAwareExtractor(ag); subOk {\n418\t\t\t\tif files, fileErr := subagentExtractor.ExtractAllModifiedFiles(transcriptData, transcriptOffset, subagentsDir); fileErr != nil {\n419\t\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files (with subagents)\",\n420\t\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n421\t\t\t\t} else {\n422\t\t\t\t\tmodifiedFiles = files\n423\t\t\t\t}\n424\t\t\t} else {\n425\t\t\t\t// Fall back to basic extraction (main transcript only)\n426\t\t\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptRef, transcriptOffset); fileErr != nil {\n427\t\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files\",\n428\t\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n429\t\t\t\t} else {\n430\t\t\t\t\tmodifiedFiles = files\n431\t\t\t\t}\n432\t\t\t}\n433\t\t}\n434\t\textractSpan.End()\n435\t\n436\t\t// Generate commit message from last prompt (read from session state, set at TurnStart).\n437\t\t// In exec mode, session state LastPrompt may be empty because UserPromptSubmit never fires.\n438\t\t// Fall back to backfilledPrompt extracted from the transcript.\n439\t\t// Single load serves both prompt retrieval and backfill.\n440\t\t_, commitMsgSpan := perf.Start(ctx, \"generate_commit_message\")\n441\t\tlastPrompt := \"\"\n442\t\tif sessionState, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && sessionState != nil {\n443\t\t\tlastPrompt = sessionState.LastPrompt\n444\t\t\t// Backfill LastPrompt so `entire status` shows the prompt even when\n445\t\t\t// no files were modified (before the early return below).\n446\t\t\tif lastPrompt == \"\" && backfilledPrompt != \"\" {\n447\t\t\t\tlastPrompt = backfilledPrompt\n448\t\t\t\tsessionState.LastPrompt = backfilledPrompt\n449\t\t\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n450\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n451\t\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n452\t\t\t\t}\n453\t\t\t}\n454\t\t} else if backfilledPrompt != \"\" {\n455\t\t\tlastPrompt = backfilledPrompt\n456\t\t}\n457\t\tcommitMessage := generateCommitMessage(lastPrompt, ag.Type())\n458\t\tlogging.Debug(logCtx, \"using commit message\",\n459\t\t\tslog.Int(\"message_length\", len(commitMessage)))\n460\t\tcommitMsgSpan.End()\n461\t\n462\t\t// Get worktree root for path normalization\n463\t\t_, detectSpan := perf.Start(ctx, \"detect_file_changes\")\n464\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n465\t\tif err != nil {\n466\t\t\tdetectSpan.RecordError(err)\n467\t\t\tdetectSpan.End()\n468\t\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n469\t\t}\n470\t\n471\t\tvar preUntrackedFiles []string\n472\t\tif preState != nil {\n473\t\t\tlogging.Debug(logCtx, \"pre-prompt state\",\n474\t\t\t\tslog.Int(\"pre_existing_untracked_files\", len(preState.UntrackedFiles)))\n475\t\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n476\t\t}\n477\t\n478\t\t// Detect file changes via git status\n479\t\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n480\t\tif err != nil {\n481\t\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n482\t\t\t\tslog.String(\"error\", err.Error()))\n483\t\t}\n484\t\tdetectSpan.End()\n485\t\n486\t\t// Filter and normalize all paths\n487\t\t_, normalizeSpan := perf.Start(ctx, \"filter_and_normalize_paths\")\n488\t\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n489\t\tvar relNewFiles, relDeletedFiles []string\n490\t\tif changes != nil {\n491\t\t\trelNewFiles = FilterAndNormalizePaths(changes.New, repoRoot)\n492\t\t\trelDeletedFiles = FilterAndNormalizePaths(changes.Deleted, repoRoot)\n493\t\n494\t\t\t// Merge git-status modified files as a fallback for transcript parsing.\n495\t\t\t// Transcript parsing is the primary source for modified files, but it can miss\n496\t\t\t// files if the agent uses an unrecognized tool or the transcript format changes.\n497\t\t\t// Git status catches any tracked file with working-tree changes.\n498\t\t\trelModifiedFiles = mergeUnique(relModifiedFiles, FilterAndNormalizePaths(changes.Modified, repoRoot))\n499\t\t}\n500\t\n501\t\t// Filter transcript-extracted files to exclude files already committed to HEAD.\n502\t\t// When an agent commits files mid-turn, those files are condensed by PostCommit\n503\t\t// and should not be re-added to FilesTouched by SaveStep. A file is \"committed\"\n504\t\t// if it exists in HEAD with the same content as the working tree.\n505\t\trelModifiedFiles = filterToUncommittedFiles(ctx, relModifiedFiles, repoRoot)\n506\t\tnormalizeSpan.End()\n507\t\n508\t\t// Check if there are any changes\n509\t\ttotalChanges := len(relModifiedFiles) + len(relNewFiles) + len(relDeletedFiles)\n510\t\tif totalChanges == 0 {\n511\t\t\tlogging.Info(logCtx, \"no files modified during session, skipping checkpoint\")\n512\t\t\ttransitionSessionTurnEnd(ctx, sessionID, event)\n513\t\t\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n514\t\t\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n515\t\t\t\t\tslog.String(\"error\", cleanupErr.Error()))\n516\t\t\t}\n517\t\t\treturn nil\n518\t\t}\n519\t\n520\t\t// Log file changes\n521\t\tlogFileChanges(ctx, relModifiedFiles, relNewFiles, relDeletedFiles)\n522\t\n523\t\t// Get git author\n524\t\tauthor, err := GetGitAuthor(ctx)\n525\t\tif err != nil {\n526\t\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n527\t\t}\n528\t\n529\t\t// Get strategy and agent type\n530\t\tstrat := GetStrategy(ctx)\n531\t\tagentType := ag.Type()\n532\t\n533\t\t// Get transcript position/identifier from pre-prompt state\n534\t\tvar transcriptIdentifierAtStart string\n535\t\tvar transcriptLinesAtStart int\n536\t\tif preState != nil {\n537\t\t\ttranscriptIdentifierAtStart = preState.LastTranscriptIdentifier\n538\t\t\ttranscriptLinesAtStart = preState.TranscriptOffset\n539\t\t}\n540\t\n541\t\t// Calculate token usage - prefer SubagentAwareExtractor to include subagent tokens\n542\t\ttokenUsage := agent.CalculateTokenUsage(ctx, ag, transcriptData, transcriptLinesAtStart, subagentsDir)\n543\t\n544\t\t// Build fully-populated step context and delegate to strategy\n545\t\tstepCtx := strategy.StepContext{\n546\t\t\tSessionID:                sessionID,\n547\t\t\tModifiedFiles:            relModifiedFiles,\n548\t\t\tNewFiles:                 relNewFiles,\n549\t\t\tDeletedFiles:             relDeletedFiles,\n550\t\t\tMetadataDir:              sessionDir,\n551\t\t\tMetadataDirAbs:           sessionDirAbs,\n552\t\t\tCommitMessage:            commitMessage,\n553\t\t\tTranscriptPath:           transcriptRef,\n554\t\t\tAuthorName:               author.Name,\n555\t\t\tAuthorEmail:              author.Email,\n556\t\t\tAgentType:                agentType,\n557\t\t\tStepTranscriptIdentifier: transcriptIdentifierAtStart,\n558\t\t\tStepTranscriptStart:      transcriptLinesAtStart,\n559\t\t\tTokenUsage:               tokenUsage,\n560\t\t}\n561\t\n562\t\tif err := strat.SaveStep(ctx, stepCtx); err != nil {\n563\t\t\treturn fmt.Errorf(\"failed to save step: %w\", err)\n564\t\t}\n565\t\n566\t\t// Update session state with backfilled prompt after SaveStep.\n567\t\t// Done after SaveStep because SaveStep may reinitialize session state,\n568\t\t// which would overwrite an earlier LastPrompt update.\n569\t\tif backfilledPrompt != \"\" {\n570\t\t\tif state, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && state != nil && state.LastPrompt == \"\" {\n571\t\t\t\tstate.LastPrompt = backfilledPrompt\n572\t\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n573\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n574\t\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n575\t\t\t\t}\n576\t\t\t}\n577\t\t}\n578\t\n579\t\t// Transition session phase and cleanup\n580\t\ttransitionSessionTurnEnd(ctx, sessionID, event)\n581\t\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n582\t\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n583\t\t\t\tslog.String(\"error\", cleanupErr.Error()))\n584\t\t}\n585\t\n586\t\treturn nil\n587\t}\n588\t\n589\t// handleLifecycleCompaction handles context compaction: saves current progress\n590\t// but stays in ACTIVE phase (unlike TurnEnd which transitions to IDLE).\n591\t// Also resets the transcript offset since the transcript may be truncated.\n592\tfunc handleLifecycleCompaction(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n593\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n594\t\tlogging.Info(logCtx, \"compaction\",\n595\t\t\tslog.String(\"event\", event.Type.String()),\n596\t\t\tslog.String(\"session_id\", event.SessionID),\n597\t\t)\n598\t\n599\t\t// Fire EventCompaction to trigger ActionCondenseIfFilesTouched (stays in ACTIVE)\n600\t\tsessionID := event.SessionID\n601\t\tsessionState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n602\t\tif loadErr != nil {\n603\t\t\tlogging.Warn(logCtx, \"failed to load session state for compaction\",\n604\t\t\t\tslog.String(\"error\", loadErr.Error()))\n605\t\t}\n606\t\tif sessionState != nil {\n607\t\t\tpersistEventMetadataToState(event, sessionState)\n608\t\n609\t\t\tif transErr := strategy.TransitionAndLog(ctx, sessionState, session.EventCompaction, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n610\t\t\t\tlogging.Warn(logCtx, \"compaction transition failed\",\n611\t\t\t\t\tslog.String(\"error\", transErr.Error()))\n612\t\t\t}\n613\t\n614\t\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n615\t\t\t\tlogging.Warn(logCtx, \"failed to save session state after compaction\",\n616\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n617\t\t\t}\n618\t\t}\n619\t\n620\t\tlogging.Info(logCtx, \"context compaction detected\")\n621\t\treturn nil\n622\t}\n623\t\n624\t// handleLifecycleSessionEnd handles session end: marks the session as ended.\n625\tfunc handleLifecycleSessionEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n626\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n627\t\tlogging.Info(logCtx, \"session-end\",\n628\t\t\tslog.String(\"event\", event.Type.String()),\n629\t\t\tslog.String(\"session_id\", event.SessionID),\n630\t\t)\n631\t\n632\t\tif event.SessionID == \"\" {\n633\t\t\treturn nil // No session to update\n634\t\t}\n635\t\n636\t\t// Note: We intentionally don't clean up cached transcripts here.\n637\t\t// Post-session commits (carry-forward in ENDED phase) may still need\n638\t\t// the transcript to extract file changes. Cleanup is handled by\n639\t\t// `entire clean` or when the session state is fully removed.\n640\t\n641\t\tif err := markSessionEnded(ctx, event, event.SessionID); err != nil {\n642\t\t\tlogging.Warn(logCtx, \"failed to mark session ended\",\n643\t\t\t\tslog.String(\"error\", err.Error()))\n644\t\t\t// Don't attempt eager condense if we couldn't even mark the session ended —\n645\t\t\t// the session state may be in an inconsistent state.\n646\t\t\treturn nil\n647\t\t}\n648\t\n649\t\t// Eagerly condense session data so PostCommit doesn't have to process it.\n650\t\t// This prevents zombie ENDED sessions from accumulating and causing O(N)\n651\t\t// overhead on every future commit (GitHub issue #591).\n652\t\t// Fail-open: if this fails, PostCommit will still process it on the next commit.\n653\t\tstrat := GetStrategy(ctx)\n654\t\tif err := strat.CondenseAndMarkFullyCondensed(ctx, event.SessionID); err != nil {\n655\t\t\tlogging.Warn(logCtx, \"eager condense on session stop failed\",\n656\t\t\t\tslog.String(\"session_id\", event.SessionID),\n657\t\t\t\tslog.String(\"error\", err.Error()))\n658\t\t}\n659\t\n660\t\treturn nil\n661\t}\n662\t\n663\t// handleLifecycleSubagentStart handles subagent start: captures pre-task state.\n664\tfunc handleLifecycleSubagentStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n665\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n666\t\tlogging.Info(logCtx, \"subagent started\",\n667\t\t\tslog.String(\"event\", event.Type.String()),\n668\t\t\tslog.String(\"session_id\", event.SessionID),\n669\t\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n670\t\t\tslog.String(\"transcript\", event.SessionRef),\n671\t\t)\n672\t\n673\t\t// Capture pre-task state\n674\t\tif err := CapturePreTaskState(ctx, event.ToolUseID); err != nil {\n675\t\t\treturn fmt.Errorf(\"failed to capture pre-task state: %w\", err)\n676\t\t}\n677\t\n678\t\treturn nil\n679\t}\n680\t\n681\t// handleLifecycleSubagentEnd handles subagent end: detects changes, saves task checkpoint.\n682\tfunc handleLifecycleSubagentEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n683\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n684\t\tif event.SubagentType == \"\" && event.TaskDescription == \"\" {\n685\t\t\t// Extract subagent type and description from tool input\n686\t\t\tevent.SubagentType, event.TaskDescription = ParseSubagentTypeAndDescription(event.ToolInput)\n687\t\t}\n688\t\n689\t\t// Determine subagent transcript path\n690\t\ttranscriptDir := filepath.Dir(event.SessionRef)\n691\t\tvar subagentTranscriptPath string\n692\t\tif event.SubagentID != \"\" {\n693\t\t\tsubagentTranscriptPath = AgentTranscriptPath(transcriptDir, event.SubagentID)\n694\t\t\tif !fileExists(subagentTranscriptPath) {\n695\t\t\t\tsubagentTranscriptPath = \"\"\n696\t\t\t}\n697\t\t}\n698\t\n699\t\t// Log context\n700\t\tsubagentEndAttrs := []any{\n701\t\t\tslog.String(\"event\", event.Type.String()),\n702\t\t\tslog.String(\"session_id\", event.SessionID),\n703\t\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n704\t\t}\n705\t\tif event.SubagentID != \"\" {\n706\t\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"agent_id\", event.SubagentID))\n707\t\t}\n708\t\tif subagentTranscriptPath != \"\" {\n709\t\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"subagent_transcript\", subagentTranscriptPath))\n710\t\t}\n711\t\tlogging.Info(logCtx, \"subagent completed\", subagentEndAttrs...)\n712\t\n713\t\t// Extract modified files from hook payload and/or subagent transcript\n714\t\tvar modifiedFiles []string\n715\t\tmodifiedFiles = append(modifiedFiles, event.ModifiedFiles...)\n716\t\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n717\t\t\ttranscriptToScan := event.SessionRef\n718\t\t\tif subagentTranscriptPath != \"\" {\n719\t\t\t\ttranscriptToScan = subagentTranscriptPath\n720\t\t\t}\n721\t\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptToScan, 0); fileErr != nil {\n722\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files from subagent\",\n723\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n724\t\t\t} else {\n725\t\t\t\tmodifiedFiles = mergeUnique(modifiedFiles, files)\n726\t\t\t}\n727\t\t}\n728\t\n729\t\t// Load pre-task state and detect file changes.\n730\t\t// If no pre-task state exists (agent doesn't support pre-task hook), fall back\n731\t\t// to the session's pre-prompt state. Without either, DetectFileChanges receives\n732\t\t// nil and treats ALL untracked files as new — which would create spurious task\n733\t\t// checkpoints for pre-existing untracked files (e.g., .github/hooks/entire.json).\n734\t\tpreState, err := LoadPreTaskState(ctx, event.ToolUseID)\n735\t\tif err != nil {\n736\t\t\tlogging.Warn(logCtx, \"failed to load pre-task state\",\n737\t\t\t\tslog.String(\"error\", err.Error()))\n738\t\t}\n739\t\tvar preUntrackedFiles []string\n740\t\tif preState != nil {\n741\t\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n742\t\t}\n743\t\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n744\t\tif err != nil {\n745\t\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n746\t\t\t\tslog.String(\"error\", err.Error()))\n747\t\t}\n748\t\n749\t\t// Get worktree root and normalize paths\n750\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n751\t\tif err != nil {\n752\t\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n753\t\t}\n754\t\n755\t\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n756\t\tvar relNewFiles, relDeletedFiles []string\n757\t\tif changes != nil {\n758\t\t\trelNewFiles = FilterAndNormalizePaths(changes.New, repoRoot)\n759\t\t\trelDeletedFiles = FilterAndNormalizePaths(changes.Deleted, repoRoot)\n760\t\t\trelModifiedFiles = mergeUnique(relModifiedFiles, FilterAndNormalizePaths(changes.Modified, repoRoot))\n761\t\t}\n762\t\n763\t\t// If no changes, skip\n764\t\tif len(relModifiedFiles) == 0 && len(relNewFiles) == 0 && len(relDeletedFiles) == 0 {\n765\t\t\tlogging.Info(logCtx, \"no file changes detected, skipping task checkpoint\")\n766\t\t\t_ = CleanupPreTaskState(ctx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n767\t\t\treturn nil\n768\t\t}\n769\t\n770\t\t// Find checkpoint UUID from main transcript (best-effort)\n771\t\tvar checkpointUUID string\n772\t\t// Use the existing CLI-level checkpoint UUID finder\n773\t\tmainLines, _ := parseTranscriptForCheckpointUUID(event.SessionRef) //nolint:errcheck // best-effort\n774\t\tif mainLines != nil {\n775\t\t\tcheckpointUUID, _ = FindCheckpointUUID(mainLines, event.ToolUseID)\n776\t\t}\n777\t\n778\t\t// Get git author\n779\t\tauthor, err := GetGitAuthor(ctx)\n780\t\tif err != nil {\n781\t\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n782\t\t}\n783\t\n784\t\t// Build task checkpoint context\n785\t\tstrat := GetStrategy(ctx)\n786\t\tagentType := ag.Type()\n787\t\n788\t\ttaskStepCtx := strategy.TaskStepContext{\n789\t\t\tSessionID:              event.SessionID,\n790\t\t\tToolUseID:              event.ToolUseID,\n791\t\t\tAgentID:                event.SubagentID,\n792\t\t\tModifiedFiles:          relModifiedFiles,\n793\t\t\tNewFiles:               relNewFiles,\n794\t\t\tDeletedFiles:           relDeletedFiles,\n795\t\t\tTranscriptPath:         event.SessionRef,\n796\t\t\tSubagentTranscriptPath: subagentTranscriptPath,\n797\t\t\tCheckpointUUID:         checkpointUUID,\n798\t\t\tAuthorName:             author.Name,\n799\t\t\tAuthorEmail:            author.Email,\n800\t\t\tSubagentType:           event.SubagentType,\n801\t\t\tTaskDescription:        event.TaskDescription,\n802\t\t\tAgentType:              agentType,\n803\t\t}\n804\t\n805\t\tif err := strat.SaveTaskStep(ctx, taskStepCtx); err != nil {\n806\t\t\treturn fmt.Errorf(\"failed to save task step: %w\", err)\n807\t\t}\n808\t\n809\t\t_ = CleanupPreTaskState(ctx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n810\t\treturn nil\n811\t}\n812\t\n813\t// --- Helper functions ---\n814\t\n815\t// resolveTranscriptOffset determines the transcript offset to use for parsing.\n816\t// Prefers pre-prompt state, falls back to session state.\n817\tfunc resolveTranscriptOffset(ctx context.Context, preState *PrePromptState, sessionID string) int {\n818\t\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n819\t\tif preState != nil && preState.TranscriptOffset > 0 {\n820\t\t\tlogging.Debug(logCtx, \"pre-prompt state found, parsing transcript from offset\",\n821\t\t\t\tslog.Int(\"offset\", preState.TranscriptOffset))\n822\t\t\treturn preState.TranscriptOffset\n823\t\t}\n824\t\n825\t\t// Fall back to session state\n826\t\tsessionState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n827\t\tif loadErr != nil {\n828\t\t\tlogging.Warn(logCtx, \"failed to load session state\",\n829\t\t\t\tslog.String(\"error\", loadErr.Error()))\n830\t\t\treturn 0\n831\t\t}\n832\t\tif sessionState != nil && sessionState.CheckpointTranscriptStart > 0 {\n833\t\t\tlogging.Debug(logCtx, \"session state found, parsing transcript from offset\",\n834\t\t\t\tslog.Int(\"offset\", sessionState.CheckpointTranscriptStart))\n835\t\t\treturn sessionState.CheckpointTranscriptStart\n836\t\t}\n837\t\n838\t\treturn 0\n839\t}\n840\t\n841\t// parseTranscriptForCheckpointUUID is a thin wrapper around transcript parsing for checkpoint UUID lookup.\n842\t// Returns parsed transcript lines for use with FindCheckpointUUID.\n843\tfunc parseTranscriptForCheckpointUUID(transcriptPath string) ([]transcriptLine, error) {\n844\t\tlines, err := transcript.ParseFromFileAtLine(transcriptPath, 0)\n845\t\tif err != nil {\n846\t\t\treturn nil, fmt.Errorf(\"parsing transcript for checkpoint UUID: %w\", err)\n847\t\t}\n848\t\treturn lines, nil\n849\t}\n850\t\n851\t// transitionSessionTurnEnd transitions the session phase to IDLE and dispatches turn-end actions.\n852\tfunc transitionSessionTurnEnd(ctx context.Context, sessionID string, event *agent.Event) {\n853\t\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n854\t\tturnState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n855\t\tif loadErr != nil {\n856\t\t\tlogging.Warn(logCtx, \"failed to load session state for turn end\",\n857\t\t\t\tslog.String(\"error\", loadErr.Error()))\n858\t\t\treturn\n859\t\t}\n860\t\tif turnState == nil {\n861\t\t\treturn\n862\t\t}\n863\t\n864\t\tpersistEventMetadataToState(event, turnState)\n865\t\n866\t\tif err := strategy.TransitionAndLog(ctx, turnState, session.EventTurnEnd, session.TransitionContext{}, session.NoOpActionHandler{}); err != nil {\n867\t\t\tlogging.Warn(logCtx, \"turn-end transition failed\",\n868\t\t\t\tslog.String(\"error\", err.Error()))\n869\t\t}\n870\t\n871\t\t// Always dispatch to strategy for turn-end handling. The strategy reads\n872\t\t// work items from state (e.g. TurnCheckpointIDs), not the action list.\n873\t\tstrat := GetStrategy(ctx)\n874\t\tif err := strat.HandleTurnEnd(ctx, turnState); err != nil {\n875\t\t\tlogging.Warn(logCtx, \"turn-end action dispatch failed\",\n876\t\t\t\tslog.String(\"error\", err.Error()))\n877\t\t}\n878\t\n879\t\tif updateErr := strategy.SaveSessionState(ctx, turnState); updateErr != nil {\n880\t\t\tlogging.Warn(logCtx, \"failed to update session phase on turn end\",\n881\t\t\t\tslog.String(\"error\", updateErr.Error()))\n882\t\t}\n883\t}\n884\t\n885\t// markSessionEnded transitions the session to ENDED phase via the state machine.\n886\t// If event is non-nil, hook-provided metrics are persisted to state before saving.\n887\tfunc markSessionEnded(ctx context.Context, event *agent.Event, sessionID string) error {\n888\t\tstate, err := strategy.LoadSessionState(ctx, sessionID)\n889\t\tif err != nil {\n890\t\t\treturn fmt.Errorf(\"failed to load session state: %w\", err)\n891\t\t}\n892\t\tif state == nil {\n893\t\t\treturn nil // No state file, nothing to update\n894\t\t}\n895\t\n896\t\tif event != nil {\n897\t\t\tpersistEventMetadataToState(event, state)\n898\t\t}\n899\t\n900\t\tif transErr := strategy.TransitionAndLog(ctx, state, session.EventSessionStop, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n901\t\t\tlogging.Warn(logging.WithComponent(ctx, \"lifecycle\"), \"session stop transition failed\",\n902\t\t\t\tslog.String(\"error\", transErr.Error()))\n903\t\t}\n904\t\n905\t\tnow := time.Now()\n906\t\tstate.EndedAt = &now\n907\t\n908\t\tif err := strategy.SaveSessionState(ctx, state); err != nil {\n909\t\t\treturn fmt.Errorf(\"failed to save session state: %w\", err)\n910\t\t}\n911\t\treturn nil\n912\t}\n913\t\n914\t// logFileChanges logs the files modified, created, and deleted during a session.\n915\tfunc logFileChanges(ctx context.Context, modified, newFiles, deleted []string) {\n916\t\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n917\t\tlogging.Debug(logCtx, \"files changed during session\",\n918\t\t\tslog.Int(\"modified\", len(modified)),\n919\t\t\tslog.Int(\"new\", len(newFiles)),\n920\t\t\tslog.Int(\"deleted\", len(deleted)))\n921\t}\n922\t\n923\tfunc persistEventMetadataToState(event *agent.Event, state *strategy.SessionState) {\n924\t\t// Update ModelName if provided (model is known by turn-end even on first turn)\n925\t\tif event.Model != \"\" {\n926\t\t\tstate.ModelName = event.Model\n927\t\t}\n928\t\n929\t\t// Persist hook-provided session metrics (e.g., from Cursor hooks)\n930\t\tif event.DurationMs > 0 {\n931\t\t\tstate.SessionDurationMs = event.DurationMs\n932\t\t}\n933\t\t// Use hook-reported turn count if available (take max); otherwise\n934\t\t// increment on each TurnEnd event to count turns ourselves.\n935\t\tif event.TurnCount > 0 {\n936\t\t\tif event.TurnCount > state.SessionTurnCount {\n937\t\t\t\tstate.SessionTurnCount = event.TurnCount\n938\t\t\t}\n939\t\t} else if event.Type == agent.TurnEnd {\n940\t\t\tstate.SessionTurnCount++\n941\t\t}\n942\t\tif event.ContextTokens > 0 {\n943\t\t\tstate.ContextTokens = event.ContextTokens\n944\t\t}\n945\t\tif event.ContextWindowSize > 0 {\n946\t\t\tstate.ContextWindowSize = event.ContextWindowSize\n947\t\t}\n948\t}\n949\t"}]},"uuid":"47c742d2-97d2-44e5-9401-dedc157e834a","timestamp":"2026-05-04T07:50:37.711Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/lifecycle.go","content":"// lifecycle.go implements the generic lifecycle event dispatcher.\n// It routes normalized events from any agent to the appropriate framework actions.\n//\n// The dispatcher inverts the current flow from \"agent handler calls framework functions\"\n// to \"framework dispatcher calls agent methods.\" Agents are passive data providers;\n// the dispatcher handles all orchestration: state transitions, strategy calls,\n// file change detection, metadata generation.\npackage cli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n\t\"github.com/entireio/cli/cmd/entire/cli/transcript\"\n\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n\t\"github.com/entireio/cli/perf\"\n)\n\n// DispatchLifecycleEvent routes a normalized lifecycle event to the appropriate handler.\n// Returns nil if the event was handled successfully.\nfunc DispatchLifecycleEvent(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tif ag == nil {\n\t\treturn errors.New(\"agent cannot be nil\")\n\t}\n\tif event == nil {\n\t\treturn errors.New(\"event cannot be nil\")\n\t}\n\n\tswitch event.Type {\n\tcase agent.SessionStart:\n\t\treturn handleLifecycleSessionStart(ctx, ag, event)\n\tcase agent.TurnStart:\n\t\treturn handleLifecycleTurnStart(ctx, ag, event)\n\tcase agent.TurnEnd:\n\t\treturn handleLifecycleTurnEnd(ctx, ag, event)\n\tcase agent.Compaction:\n\t\treturn handleLifecycleCompaction(ctx, ag, event)\n\tcase agent.SessionEnd:\n\t\treturn handleLifecycleSessionEnd(ctx, ag, event)\n\tcase agent.SubagentStart:\n\t\treturn handleLifecycleSubagentStart(ctx, ag, event)\n\tcase agent.SubagentEnd:\n\t\treturn handleLifecycleSubagentEnd(ctx, ag, event)\n\tcase agent.ModelUpdate:\n\t\treturn handleLifecycleModelUpdate(ctx, ag, event)\n\tdefault:\n\t\treturn fmt.Errorf(\"unknown lifecycle event type: %d\", event.Type)\n\t}\n}\n\n// handleLifecycleSessionStart handles session start: shows banner, checks concurrent sessions,\n// fires state machine transition.\nfunc handleLifecycleSessionStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"session-start\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"session_ref\", event.SessionRef),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tif event.SessionID == \"\" {\n\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n\t}\n\tif err := validation.ValidateSessionID(event.SessionID); err != nil {\n\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n\t}\n\n\t// Build informational message — warn early if repo has no commits yet,\n\t// since checkpoints require at least one commit to work.\n\tmessage := sessionStartMessage(ag.Name(), false)\n\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n\t\tmessage = sessionStartMessage(ag.Name(), true)\n\t}\n\n\t// Check for concurrent sessions and append count if any\n\t_, countSessionsSpan := perf.Start(ctx, \"count_active_sessions\")\n\tstrat := GetStrategy(ctx)\n\tif count, err := strat.CountOtherActiveSessionsWithCheckpoints(ctx, event.SessionID); err == nil && count > 0 {\n\t\tif ag.Name() == agent.AgentNameCodex {\n\t\t\tmessage += fmt.Sprintf(\" %d other active conversation(s) in this workspace will also be included. Use 'entire status' for more information.\", count)\n\t\t} else {\n\t\t\tmessage += fmt.Sprintf(\"\\n  %d other active conversation(s) in this workspace will also be included.\\n  Use 'entire status' for more information.\", count)\n\t\t}\n\t}\n\tcountSessionsSpan.End()\n\n\t// Output informational message if the agent supports hook responses.\n\t// Claude Code reads JSON from stdout; agents that don't implement\n\t// HookResponseWriter silently skip (avoids raw JSON in their terminal).\n\t_, hookResponseSpan := perf.Start(ctx, \"write_hook_response\")\n\tif event.ResponseMessage != \"\" {\n\t\tmessage = event.ResponseMessage\n\t}\n\tif writer, ok := agent.AsHookResponseWriter(ag); ok {\n\t\tif err := writer.WriteHookResponse(message); err != nil {\n\t\t\thookResponseSpan.RecordError(err)\n\t\t\thookResponseSpan.End()\n\t\t\treturn fmt.Errorf(\"failed to write hook response: %w\", err)\n\t\t}\n\t}\n\thookResponseSpan.End()\n\n\t// Store model hint if the agent provided model info on SessionStart\n\tif event.Model != \"\" {\n\t\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to store model hint on session start\",\n\t\t\t\tslog.String(\"error\", err.Error()))\n\t\t}\n\t}\n\n\t// Fire EventSessionStart for the current session (if state exists).\n\tif state, loadErr := strategy.LoadSessionState(ctx, event.SessionID); loadErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state on start\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t} else if state != nil {\n\t\tpersistEventMetadataToState(event, state)\n\t\tif transErr := strategy.TransitionAndLog(ctx, state, session.EventSessionStart, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n\t\t\tlogging.Warn(logCtx, \"session start transition failed\",\n\t\t\t\tslog.String(\"error\", transErr.Error()))\n\t\t}\n\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to update session state on start\",\n\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t}\n\t}\n\n\treturn nil\n}\n\nfunc sessionStartMessage(agentName types.AgentName, emptyRepo bool) string {\n\tif agentName == agent.AgentNameCodex {\n\t\tif emptyRepo {\n\t\t\treturn \"Entire CLI found no commits yet — checkpoints will activate after your first commit.\"\n\t\t}\n\t\treturn \"Entire CLI will link this conversation to your next commit.\"\n\t}\n\n\tif emptyRepo {\n\t\treturn \"\\n\\nEntire CLI found no commits yet — checkpoints will activate after your first commit.\"\n\t}\n\treturn \"\\n\\nEntire CLI will link this conversation to your next commit.\"\n}\n\n// handleLifecycleModelUpdate persists the model name for the current session.\n//\n// If the session state file already exists (e.g., Gemini's BeforeModel fires\n// after TurnStart), the model is written directly to state.ModelName — no hint\n// file needed. Otherwise falls back to StoreModelHint for cross-process\n// persistence (see its doc comment for the full rationale).\nfunc handleLifecycleModelUpdate(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"model-update\",\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tif event.SessionID == \"\" || event.Model == \"\" {\n\t\treturn nil\n\t}\n\n\t// Prefer writing directly to session state when it exists\n\tstate, loadErr := strategy.LoadSessionState(ctx, event.SessionID)\n\tif loadErr != nil {\n\t\tlogging.Debug(logCtx, \"could not load session state for model update, using hint file\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t}\n\tif loadErr == nil && state != nil {\n\t\tstate.ModelName = event.Model\n\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to update session state with model\",\n\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t}\n\t\treturn nil\n\t}\n\n\t// State doesn't exist yet (or failed to load) — use hint file (see StoreModelHint doc)\n\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to store model hint\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleTurnStart handles turn start: captures pre-prompt state,\n// ensures strategy setup, initializes session.\nfunc handleLifecycleTurnStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"turn-start\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"session_ref\", event.SessionRef),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tsessionID := event.SessionID\n\tif sessionID == \"\" {\n\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n\t}\n\tif err := validation.ValidateSessionID(sessionID); err != nil {\n\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n\t}\n\n\t// Fill model from hint file if the agent didn't provide it on this hook\n\tif event.Model == \"\" {\n\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n\t\t\tevent.Model = hint\n\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n\t\t\t\tslog.String(\"model\", hint))\n\t\t}\n\t}\n\n\t// Capture pre-prompt state (including transcript position via TranscriptAnalyzer)\n\t_, captureSpan := perf.Start(ctx, \"capture_pre_prompt_state\")\n\tif err := CapturePrePromptState(ctx, ag, sessionID, event.SessionRef); err != nil {\n\t\tcaptureSpan.RecordError(err)\n\t\tcaptureSpan.End()\n\t\treturn err\n\t}\n\tcaptureSpan.End()\n\n\t// Append prompt to prompt.txt on filesystem so it's available for\n\t// mid-turn commits (before SaveStep writes it to the shadow branch).\n\t// Prompts are separated by \"\\n\\n---\\n\\n\" to support multiple turns.\n\tif event.Prompt != \"\" {\n\t\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n\t\tif sessionDirAbs, absErr := paths.AbsPath(ctx, sessionDir); absErr == nil {\n\t\t\tif mkErr := os.MkdirAll(sessionDirAbs, 0o750); mkErr == nil {\n\t\t\t\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n\t\t\t\texisting, readErr := os.ReadFile(promptPath) //nolint:gosec // session metadata path\n\t\t\t\tvar content string\n\t\t\t\tif readErr == nil && len(existing) > 0 {\n\t\t\t\t\tcontent = string(existing) + \"\\n\\n---\\n\\n\" + event.Prompt\n\t\t\t\t} else {\n\t\t\t\t\tcontent = event.Prompt\n\t\t\t\t}\n\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil { //nolint:gosec // path from internal metadata, not user input\n\t\t\t\t\tlogging.Warn(logCtx, \"failed to write prompt.txt\",\n\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\t// Ensure strategy setup and initialize session\n\t_, initSpan := perf.Start(ctx, \"init_session\")\n\tif err := strategy.EnsureSetup(ctx); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to ensure strategy setup\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\tstrat := GetStrategy(ctx)\n\tif err := strat.InitializeSession(ctx, sessionID, ag.Type(), event.SessionRef, event.Prompt, event.Model); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to initialize session state\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\tinitSpan.End()\n\n\treturn nil\n}\n\n// handleLifecycleTurnEnd handles turn end: validates transcript, extracts metadata,\n// detects file changes, saves step + checkpoint, transitions phase.\n//\n//nolint:maintidx // high complexity due to sequential orchestration of 8 steps (validation, extraction, file detection, filtering, token calc, step save, phase transition, cleanup) - splitting would obscure the flow\nfunc handleLifecycleTurnEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"turn-end\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"session_ref\", event.SessionRef),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tsessionID := event.SessionID\n\tif sessionID == \"\" {\n\t\tsessionID = unknownSessionID\n\t}\n\n\t// Fill model from hint file if the agent didn't provide it on this hook\n\tif event.Model == \"\" && sessionID != unknownSessionID {\n\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n\t\t\tevent.Model = hint\n\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n\t\t\t\tslog.String(\"model\", hint))\n\t\t}\n\t}\n\n\ttranscriptRef := event.SessionRef\n\tif transcriptRef == \"\" {\n\t\treturn errors.New(\"transcript file not specified\")\n\t}\n\n\t// If agent implements TranscriptPreparer, materialize the transcript file.\n\t// This must run BEFORE fileExists: agents like OpenCode lazily fetch transcripts\n\t// via `opencode export`, so the file doesn't exist until PrepareTranscript creates it.\n\t// Claude Code's PrepareTranscript just flushes (always succeeds). Agents without\n\t// TranscriptPreparer (Gemini, Droid) are unaffected.\n\t_, prepareSpan := perf.Start(ctx, \"prepare_and_validate_transcript\")\n\tif preparer, ok := agent.AsTranscriptPreparer(ag); ok {\n\t\tif err := preparer.PrepareTranscript(ctx, transcriptRef); err != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to prepare transcript\",\n\t\t\t\tslog.String(\"error\", err.Error()))\n\t\t}\n\t}\n\n\tif !fileExists(transcriptRef) {\n\t\tprepareSpan.RecordError(fmt.Errorf(\"transcript file not found: %s\", transcriptRef))\n\t\tprepareSpan.End()\n\t\treturn fmt.Errorf(\"transcript file not found: %s\", transcriptRef)\n\t}\n\n\t// Early check: bail out quickly if the repo has no commits yet.\n\t// Return nil (not an error) so the hook exits 0 — agents treat non-zero\n\t// exit codes as hook failures. The user was already warned at session start.\n\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n\t\tprepareSpan.End()\n\t\tlogging.Info(logCtx, \"skipping checkpoint - will activate after first commit\")\n\t\treturn nil\n\t}\n\tprepareSpan.End()\n\n\t// Create session metadata directory\n\t_, copySpan := perf.Start(ctx, \"copy_transcript\")\n\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n\tsessionDirAbs, err := paths.AbsPath(ctx, sessionDir)\n\tif err != nil {\n\t\tsessionDirAbs = sessionDir\n\t}\n\tif err := os.MkdirAll(sessionDirAbs, 0o750); err != nil {\n\t\tcopySpan.RecordError(err)\n\t\tcopySpan.End()\n\t\treturn fmt.Errorf(\"failed to create session directory: %w\", err)\n\t}\n\n\t// Copy transcript to session directory\n\ttranscriptData, err := ag.ReadTranscript(transcriptRef)\n\tif err != nil {\n\t\tcopySpan.RecordError(err)\n\t\tcopySpan.End()\n\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\tlogFile := filepath.Join(sessionDirAbs, paths.TranscriptFileName)\n\tif err := os.WriteFile(logFile, transcriptData, 0o600); err != nil {\n\t\tcopySpan.RecordError(err)\n\t\tcopySpan.End()\n\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n\t}\n\tlogging.Debug(logCtx, \"copied transcript\",\n\t\tslog.String(\"path\", sessionDir+\"/\"+paths.TranscriptFileName))\n\tcopySpan.End()\n\n\t// Load pre-prompt state (captured on TurnStart)\n\t_, extractSpan := perf.Start(ctx, \"extract_metadata\")\n\tpreState, err := LoadPrePromptState(ctx, sessionID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load pre-prompt state\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\t// Determine transcript offset\n\ttranscriptOffset := resolveTranscriptOffset(ctx, preState, sessionID)\n\n\t// Backfill prompt.txt from transcript when prompt data is missing.\n\t// This handles agents whose exec mode doesn't fire UserPromptSubmit (e.g., Factory AI\n\t// Droid). The transcript is the source of truth — if ExtractPrompts returns nothing,\n\t// there genuinely were no prompts. We track whether backfill occurred so we can\n\t// update session state after SaveStep (which may reinitialize state).\n\tvar backfilledPrompt string\n\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n\texistingPrompt, readPromptErr := os.ReadFile(promptPath) //nolint:gosec // file content is safe session metadata\n\tif readPromptErr != nil && !os.IsNotExist(readPromptErr) {\n\t\tlogging.Warn(logCtx, \"failed to read prompt.txt, skipping backfill\",\n\t\t\tslog.String(\"error\", readPromptErr.Error()))\n\t} else if len(existingPrompt) == 0 {\n\t\tif extractor, ok := agent.AsPromptExtractor(ag); ok {\n\t\t\tprompts, extractErr := extractor.ExtractPrompts(transcriptRef, transcriptOffset)\n\t\t\tif extractErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to extract prompts from transcript\",\n\t\t\t\t\tslog.String(\"error\", extractErr.Error()))\n\t\t\t} else if len(prompts) > 0 {\n\t\t\t\tcontent := strings.Join(prompts, \"\\n\\n---\\n\\n\")\n\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil {\n\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill prompt.txt from transcript\",\n\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n\t\t\t\t} else {\n\t\t\t\t\tlogging.Debug(logCtx, \"backfilled prompt.txt from transcript\",\n\t\t\t\t\t\tslog.Int(\"prompt_count\", len(prompts)))\n\t\t\t\t\tbackfilledPrompt = prompts[len(prompts)-1]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\t// Compute subagents directory for agents that support subagent extraction.\n\t// Subagent transcripts live in <transcriptDir>/<modelSessionID>/subagents/\n\tsubagentsDir := filepath.Join(filepath.Dir(transcriptRef), event.SessionID, \"subagents\")\n\n\t// Extract metadata via agent interface (modified files)\n\tvar modifiedFiles []string\n\n\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n\t\t// Extract modified files - prefer SubagentAwareExtractor if available to include subagent files\n\t\tif subagentExtractor, subOk := agent.AsSubagentAwareExtractor(ag); subOk {\n\t\t\tif files, fileErr := subagentExtractor.ExtractAllModifiedFiles(transcriptData, transcriptOffset, subagentsDir); fileErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files (with subagents)\",\n\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n\t\t\t} else {\n\t\t\t\tmodifiedFiles = files\n\t\t\t}\n\t\t} else {\n\t\t\t// Fall back to basic extraction (main transcript only)\n\t\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptRef, transcriptOffset); fileErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files\",\n\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n\t\t\t} else {\n\t\t\t\tmodifiedFiles = files\n\t\t\t}\n\t\t}\n\t}\n\textractSpan.End()\n\n\t// Generate commit message from last prompt (read from session state, set at TurnStart).\n\t// In exec mode, session state LastPrompt may be empty because UserPromptSubmit never fires.\n\t// Fall back to backfilledPrompt extracted from the transcript.\n\t// Single load serves both prompt retrieval and backfill.\n\t_, commitMsgSpan := perf.Start(ctx, \"generate_commit_message\")\n\tlastPrompt := \"\"\n\tif sessionState, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && sessionState != nil {\n\t\tlastPrompt = sessionState.LastPrompt\n\t\t// Backfill LastPrompt so `entire status` shows the prompt even when\n\t\t// no files were modified (before the early return below).\n\t\tif lastPrompt == \"\" && backfilledPrompt != \"\" {\n\t\t\tlastPrompt = backfilledPrompt\n\t\t\tsessionState.LastPrompt = backfilledPrompt\n\t\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t\t}\n\t\t}\n\t} else if backfilledPrompt != \"\" {\n\t\tlastPrompt = backfilledPrompt\n\t}\n\tcommitMessage := generateCommitMessage(lastPrompt, ag.Type())\n\tlogging.Debug(logCtx, \"using commit message\",\n\t\tslog.Int(\"message_length\", len(commitMessage)))\n\tcommitMsgSpan.End()\n\n\t// Get worktree root for path normalization\n\t_, detectSpan := perf.Start(ctx, \"detect_file_changes\")\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\tdetectSpan.RecordError(err)\n\t\tdetectSpan.End()\n\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n\t}\n\n\tvar preUntrackedFiles []string\n\tif preState != nil {\n\t\tlogging.Debug(logCtx, \"pre-prompt state\",\n\t\t\tslog.Int(\"pre_existing_untracked_files\", len(preState.UntrackedFiles)))\n\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n\t}\n\n\t// Detect file changes via git status\n\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\tdetectSpan.End()\n\n\t// Filter and normalize all paths\n\t_, normalizeSpan := perf.Start(ctx, \"filter_and_normalize_paths\")\n\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n\tvar relNewFiles, relDeletedFiles []string\n\tif changes != nil {\n\t\trelNewFiles = FilterAndNormalizePaths(changes.New, repoRoot)\n\t\trelDeletedFiles = FilterAndNormalizePaths(changes.Deleted, repoRoot)\n\n\t\t// Merge git-status modified files as a fallback for transcript parsing.\n\t\t// Transcript parsing is the primary source for modified files, but it can miss\n\t\t// files if the agent uses an unrecognized tool or the transcript format changes.\n\t\t// Git status catches any tracked file with working-tree changes.\n\t\trelModifiedFiles = mergeUnique(relModifiedFiles, FilterAndNormalizePaths(changes.Modified, repoRoot))\n\t}\n\n\t// Filter transcript-extracted files to exclude files already committed to HEAD.\n\t// When an agent commits files mid-turn, those files are condensed by PostCommit\n\t// and should not be re-added to FilesTouched by SaveStep. A file is \"committed\"\n\t// if it exists in HEAD with the same content as the working tree.\n\trelModifiedFiles = filterToUncommittedFiles(ctx, relModifiedFiles, repoRoot)\n\tnormalizeSpan.End()\n\n\t// Check if there are any changes\n\ttotalChanges := len(relModifiedFiles) + len(relNewFiles) + len(relDeletedFiles)\n\tif totalChanges == 0 {\n\t\tlogging.Info(logCtx, \"no files modified during session, skipping checkpoint\")\n\t\ttransitionSessionTurnEnd(ctx, sessionID, event)\n\t\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n\t\t\t\tslog.String(\"error\", cleanupErr.Error()))\n\t\t}\n\t\treturn nil\n\t}\n\n\t// Log file changes\n\tlogFileChanges(ctx, relModifiedFiles, relNewFiles, relDeletedFiles)\n\n\t// Get git author\n\tauthor, err := GetGitAuthor(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n\t}\n\n\t// Get strategy and agent type\n\tstrat := GetStrategy(ctx)\n\tagentType := ag.Type()\n\n\t// Get transcript position/identifier from pre-prompt state\n\tvar transcriptIdentifierAtStart string\n\tvar transcriptLinesAtStart int\n\tif preState != nil {\n\t\ttranscriptIdentifierAtStart = preState.LastTranscriptIdentifier\n\t\ttranscriptLinesAtStart = preState.TranscriptOffset\n\t}\n\n\t// Calculate token usage - prefer SubagentAwareExtractor to include subagent tokens\n\ttokenUsage := agent.CalculateTokenUsage(ctx, ag, transcriptData, transcriptLinesAtStart, subagentsDir)\n\n\t// Build fully-populated step context and delegate to strategy\n\tstepCtx := strategy.StepContext{\n\t\tSessionID:                sessionID,\n\t\tModifiedFiles:            relModifiedFiles,\n\t\tNewFiles:                 relNewFiles,\n\t\tDeletedFiles:             relDeletedFiles,\n\t\tMetadataDir:              sessionDir,\n\t\tMetadataDirAbs:           sessionDirAbs,\n\t\tCommitMessage:            commitMessage,\n\t\tTranscriptPath:           transcriptRef,\n\t\tAuthorName:               author.Name,\n\t\tAuthorEmail:              author.Email,\n\t\tAgentType:                agentType,\n\t\tStepTranscriptIdentifier: transcriptIdentifierAtStart,\n\t\tStepTranscriptStart:      transcriptLinesAtStart,\n\t\tTokenUsage:               tokenUsage,\n\t}\n\n\tif err := strat.SaveStep(ctx, stepCtx); err != nil {\n\t\treturn fmt.Errorf(\"failed to save step: %w\", err)\n\t}\n\n\t// Update session state with backfilled prompt after SaveStep.\n\t// Done after SaveStep because SaveStep may reinitialize session state,\n\t// which would overwrite an earlier LastPrompt update.\n\tif backfilledPrompt != \"\" {\n\t\tif state, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && state != nil && state.LastPrompt == \"\" {\n\t\t\tstate.LastPrompt = backfilledPrompt\n\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t\t}\n\t\t}\n\t}\n\n\t// Transition session phase and cleanup\n\ttransitionSessionTurnEnd(ctx, sessionID, event)\n\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n\t\t\tslog.String(\"error\", cleanupErr.Error()))\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleCompaction handles context compaction: saves current progress\n// but stays in ACTIVE phase (unlike TurnEnd which transitions to IDLE).\n// Also resets the transcript offset since the transcript may be truncated.\nfunc handleLifecycleCompaction(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"compaction\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t)\n\n\t// Fire EventCompaction to trigger ActionCondenseIfFilesTouched (stays in ACTIVE)\n\tsessionID := event.SessionID\n\tsessionState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n\tif loadErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for compaction\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t}\n\tif sessionState != nil {\n\t\tpersistEventMetadataToState(event, sessionState)\n\n\t\tif transErr := strategy.TransitionAndLog(ctx, sessionState, session.EventCompaction, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n\t\t\tlogging.Warn(logCtx, \"compaction transition failed\",\n\t\t\t\tslog.String(\"error\", transErr.Error()))\n\t\t}\n\n\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to save session state after compaction\",\n\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t}\n\t}\n\n\tlogging.Info(logCtx, \"context compaction detected\")\n\treturn nil\n}\n\n// handleLifecycleSessionEnd handles session end: marks the session as ended.\nfunc handleLifecycleSessionEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"session-end\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t)\n\n\tif event.SessionID == \"\" {\n\t\treturn nil // No session to update\n\t}\n\n\t// Note: We intentionally don't clean up cached transcripts here.\n\t// Post-session commits (carry-forward in ENDED phase) may still need\n\t// the transcript to extract file changes. Cleanup is handled by\n\t// `entire clean` or when the session state is fully removed.\n\n\tif err := markSessionEnded(ctx, event, event.SessionID); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to mark session ended\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t\t// Don't attempt eager condense if we couldn't even mark the session ended —\n\t\t// the session state may be in an inconsistent state.\n\t\treturn nil\n\t}\n\n\t// Eagerly condense session data so PostCommit doesn't have to process it.\n\t// This prevents zombie ENDED sessions from accumulating and causing O(N)\n\t// overhead on every future commit (GitHub issue #591).\n\t// Fail-open: if this fails, PostCommit will still process it on the next commit.\n\tstrat := GetStrategy(ctx)\n\tif err := strat.CondenseAndMarkFullyCondensed(ctx, event.SessionID); err != nil {\n\t\tlogging.Warn(logCtx, \"eager condense on session stop failed\",\n\t\t\tslog.String(\"session_id\", event.SessionID),\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleSubagentStart handles subagent start: captures pre-task state.\nfunc handleLifecycleSubagentStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"subagent started\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n\t\tslog.String(\"transcript\", event.SessionRef),\n\t)\n\n\t// Capture pre-task state\n\tif err := CapturePreTaskState(ctx, event.ToolUseID); err != nil {\n\t\treturn fmt.Errorf(\"failed to capture pre-task state: %w\", err)\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleSubagentEnd handles subagent end: detects changes, saves task checkpoint.\nfunc handleLifecycleSubagentEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tif event.SubagentType == \"\" && event.TaskDescription == \"\" {\n\t\t// Extract subagent type and description from tool input\n\t\tevent.SubagentType, event.TaskDescription = ParseSubagentTypeAndDescription(event.ToolInput)\n\t}\n\n\t// Determine subagent transcript path\n\ttranscriptDir := filepath.Dir(event.SessionRef)\n\tvar subagentTranscriptPath string\n\tif event.SubagentID != \"\" {\n\t\tsubagentTranscriptPath = AgentTranscriptPath(transcriptDir, event.SubagentID)\n\t\tif !fileExists(subagentTranscriptPath) {\n\t\t\tsubagentTranscriptPath = \"\"\n\t\t}\n\t}\n\n\t// Log context\n\tsubagentEndAttrs := []any{\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n\t}\n\tif event.SubagentID != \"\" {\n\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"agent_id\", event.SubagentID))\n\t}\n\tif subagentTranscriptPath != \"\" {\n\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"subagent_transcript\", subagentTranscriptPath))\n\t}\n\tlogging.Info(logCtx, \"subagent completed\", subagentEndAttrs...)\n\n\t// Extract modified files from hook payload and/or subagent transcript\n\tvar modifiedFiles []string\n\tmodifiedFiles = append(modifiedFiles, event.ModifiedFiles...)\n\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n\t\ttranscriptToScan := event.SessionRef\n\t\tif subagentTranscriptPath != \"\" {\n\t\t\ttranscriptToScan = subagentTranscriptPath\n\t\t}\n\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptToScan, 0); fileErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to extract modified files from subagent\",\n\t\t\t\tslog.String(\"error\", fileErr.Error()))\n\t\t} else {\n\t\t\tmodifiedFiles = mergeUnique(modifiedFiles, files)\n\t\t}\n\t}\n\n\t// Load pre-task state and detect file changes.\n\t// If no pre-task state exists (agent doesn't support pre-task hook), fall back\n\t// to the session's pre-prompt state. Without either, DetectFileChanges receives\n\t// nil and treats ALL untracked files as new — which would create spurious task\n\t// checkpoints for pre-existing untracked files (e.g., .github/hooks/entire.json).\n\tpreState, err := LoadPreTaskState(ctx, event.ToolUseID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load pre-task state\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\tvar preUntrackedFiles []string\n\tif preState != nil {\n\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n\t}\n\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\t// Get worktree root and normalize paths\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n\t}\n\n\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n\tvar relNewFiles, relDeletedFiles []string\n\tif changes != nil {\n\t\trelNewFiles = Filt