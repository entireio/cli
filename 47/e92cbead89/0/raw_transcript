{"parentUuid":"f9bab222-cf15-4465-b9dd-694bf7e4e225","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/auth.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"net/http\"\n10\t\t\"sort\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/charmbracelet/lipgloss\"\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/api\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/auth\"\n17\t\t\"github.com/spf13/cobra\"\n18\t)\n19\t\n20\t// authStatusStore reads the current bearer token from the OS keyring.\n21\ttype authStatusStore interface {\n22\t\tGetToken(baseURL string) (string, error)\n23\t}\n24\t\n25\t// authTokenLister lists API tokens for the authenticated user.\n26\ttype authTokenLister func(ctx context.Context, token string) ([]api.Token, error)\n27\t\n28\t// authTokenRevoker revokes a single API token by id.\n29\ttype authTokenRevoker func(ctx context.Context, callerToken, id string) error\n30\t\n31\tfunc newAuthCmd() *cobra.Command {\n32\t\tcmd := &cobra.Command{\n33\t\t\tUse:   \"auth\",\n34\t\t\tShort: \"Manage authentication and API tokens\",\n35\t\t\tLong:  \"Authentication subcommands. Includes login, logout, status, listing tokens, and revoking tokens.\",\n36\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n37\t\t\t\treturn cmd.Help()\n38\t\t\t},\n39\t\t}\n40\t\n41\t\tcmd.AddCommand(newLoginCmd())\n42\t\tcmd.AddCommand(newLogoutCmd())\n43\t\tcmd.AddCommand(newAuthStatusCmd())\n44\t\tcmd.AddCommand(newAuthListCmd())\n45\t\tcmd.AddCommand(newAuthRevokeCmd())\n46\t\treturn cmd\n47\t}\n48\t\n49\t// --- status -----------------------------------------------------------------\n50\t\n51\tfunc newAuthStatusCmd() *cobra.Command {\n52\t\treturn &cobra.Command{\n53\t\t\tUse:   \"status\",\n54\t\t\tShort: \"Show authentication status\",\n55\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n56\t\t\t\treturn runAuthStatus(cmd.Context(), cmd.OutOrStdout(),\n57\t\t\t\t\tauth.NewStore(), defaultListTokens, api.BaseURL())\n58\t\t\t},\n59\t\t}\n60\t}\n61\t\n62\tfunc defaultListTokens(ctx context.Context, token string) ([]api.Token, error) {\n63\t\ttokens, err := api.NewClient(token).ListTokens(ctx)\n64\t\tif err != nil {\n65\t\t\treturn nil, fmt.Errorf(\"list tokens: %w\", err)\n66\t\t}\n67\t\treturn tokens, nil\n68\t}\n69\t\n70\tfunc runAuthStatus(ctx context.Context, w io.Writer, store authStatusStore, list authTokenLister, baseURL string) error {\n71\t\ttoken, err := store.GetToken(baseURL)\n72\t\tif err != nil {\n73\t\t\treturn fmt.Errorf(\"read keychain: %w\", err)\n74\t\t}\n75\t\tif token == \"\" {\n76\t\t\tfmt.Fprintf(w, \"Not logged in to %s\\n\", baseURL)\n77\t\t\tfmt.Fprintln(w, \"Run 'entire login' to authenticate.\")\n78\t\t\treturn nil\n79\t\t}\n80\t\n81\t\ttokens, err := list(ctx, token)\n82\t\tif err != nil {\n83\t\t\tif api.IsHTTPErrorStatus(err, http.StatusUnauthorized) {\n84\t\t\t\tfmt.Fprintf(w, \"Token in keychain for %s is no longer valid.\\n\", baseURL)\n85\t\t\t\tfmt.Fprintln(w, \"Run 'entire login' to re-authenticate.\")\n86\t\t\t\treturn nil\n87\t\t\t}\n88\t\t\treturn fmt.Errorf(\"validate token: %w\", err)\n89\t\t}\n90\t\n91\t\tfmt.Fprintf(w, \"Logged in to %s\\n\", baseURL)\n92\t\tfmt.Fprintln(w, \"  Token: stored in OS keychain\")\n93\t\tfmt.Fprintf(w, \"  Active tokens on this account: %d\\n\", len(tokens))\n94\t\treturn nil\n95\t}\n96\t\n97\t// --- list -------------------------------------------------------------------\n98\t\n99\tfunc newAuthListCmd() *cobra.Command {\n100\t\tvar jsonOut bool\n101\t\tcmd := &cobra.Command{\n102\t\t\tUse:   \"list\",\n103\t\t\tShort: \"List active API tokens for the authenticated user\",\n104\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n105\t\t\t\treturn runAuthList(cmd.Context(), cmd.OutOrStdout(),\n106\t\t\t\t\tauth.NewStore(), defaultListTokens, api.BaseURL(), jsonOut)\n107\t\t\t},\n108\t\t}\n109\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Print tokens as JSON\")\n110\t\treturn cmd\n111\t}\n112\t\n113\tfunc runAuthList(ctx context.Context, w io.Writer, store authStatusStore, list authTokenLister, baseURL string, jsonOut bool) error {\n114\t\ttoken, err := store.GetToken(baseURL)\n115\t\tif err != nil {\n116\t\t\treturn fmt.Errorf(\"read keychain: %w\", err)\n117\t\t}\n118\t\tif token == \"\" {\n119\t\t\treturn fmt.Errorf(\"not logged in to %s; run 'entire login' first\", baseURL)\n120\t\t}\n121\t\n122\t\ttokens, err := list(ctx, token)\n123\t\tif err != nil {\n124\t\t\treturn err\n125\t\t}\n126\t\n127\t\tif jsonOut {\n128\t\t\tenc := json.NewEncoder(w)\n129\t\t\tenc.SetIndent(\"\", \"  \")\n130\t\t\tif err := enc.Encode(tokens); err != nil {\n131\t\t\t\treturn fmt.Errorf(\"encode JSON: %w\", err)\n132\t\t\t}\n133\t\t\treturn nil\n134\t\t}\n135\t\n136\t\tif len(tokens) == 0 {\n137\t\t\tfmt.Fprintln(w, \"No active tokens.\")\n138\t\t\treturn nil\n139\t\t}\n140\t\n141\t\t// Stable order: most recently used first, then created.\n142\t\tsort.Slice(tokens, func(i, j int) bool {\n143\t\t\tli := lastUsedSortKey(tokens[i])\n144\t\t\tlj := lastUsedSortKey(tokens[j])\n145\t\t\tif li != lj {\n146\t\t\t\treturn li > lj\n147\t\t\t}\n148\t\t\treturn tokens[i].CreatedAt > tokens[j].CreatedAt\n149\t\t})\n150\t\n151\t\tsty := newAuthListStyles(w)\n152\t\trenderAuthListTable(w, sty, tokens, time.Now())\n153\t\treturn nil\n154\t}\n155\t\n156\t// authListStyles holds the lipgloss styles for `entire auth list`. Mirrors the\n157\t// approach in activity_render.go: keep style construction tied to color\n158\t// detection, and render plain text when color is disabled.\n159\ttype authListStyles struct {\n160\t\tcolorEnabled bool\n161\t\n162\t\theader  lipgloss.Style // bold + dim, used for column headers\n163\t\tid      lipgloss.Style // yellow accent\n164\t\tname    lipgloss.Style // bold\n165\t\tvalue   lipgloss.Style // default fg for scope/dates (no color)\n166\t\tdim     lipgloss.Style // \"never\", \"-\"\n167\t\twarning lipgloss.Style // expires-soon\n168\t\texpired lipgloss.Style // already expired\n169\t}\n170\t\n171\tfunc newAuthListStyles(w io.Writer) authListStyles {\n172\t\tuseColor := shouldUseColor(w)\n173\t\ts := authListStyles{colorEnabled: useColor}\n174\t\tif !useColor {\n175\t\t\treturn s\n176\t\t}\n177\t\ts.header = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")).Bold(true)\n178\t\ts.id = lipgloss.NewStyle().Foreground(lipgloss.Color(\"3\")) // yellow\n179\t\ts.name = lipgloss.NewStyle().Bold(true)\n180\t\ts.value = lipgloss.NewStyle() // default fg\n181\t\ts.dim = lipgloss.NewStyle().Faint(true)\n182\t\ts.warning = lipgloss.NewStyle().Foreground(lipgloss.Color(\"3\")) // yellow\n183\t\ts.expired = lipgloss.NewStyle().Foreground(lipgloss.Color(\"1\")) // red\n184\t\treturn s\n185\t}\n186\t\n187\tfunc (s authListStyles) render(style lipgloss.Style, text string) string {\n188\t\tif !s.colorEnabled {\n189\t\t\treturn text\n190\t\t}\n191\t\treturn style.Render(text)\n192\t}\n193\t\n194\t// renderAuthListTable prints a styled, column-aligned table of tokens. We\n195\t// compute column widths from plain text and pad with spaces using\n196\t// lipgloss.Width — tabwriter doesn't understand ANSI escapes so it can't be\n197\t// used here once cells are styled.\n198\tfunc renderAuthListTable(w io.Writer, sty authListStyles, tokens []api.Token, now time.Time) {\n199\t\theaders := []string{\"ID\", \"NAME\", \"SCOPE\", \"CREATED\", \"LAST USED\", \"EXPIRES\"}\n200\t\n201\t\ttype cell struct {\n202\t\t\tstyled string // rendered (may contain ANSI)\n203\t\t\tplain  string // plain text used for width calculation\n204\t\t}\n205\t\n206\t\trows := make([][]cell, 0, len(tokens))\n207\t\tfor _, t := range tokens {\n208\t\t\tidPlain := t.ID\n209\t\t\tnamePlain := fallback(t.Name, \"-\")\n210\t\t\tscopePlain := fallback(t.Scope, \"-\")\n211\t\t\tcreatedPlain := formatAuthDate(t.CreatedAt)\n212\t\t\tlastUsedPlain := formatAuthLastUsed(t.LastUsedAt, now)\n213\t\t\texpiresPlain := formatAuthDate(t.ExpiresAt)\n214\t\n215\t\t\tvar nameStyled string\n216\t\t\tif t.Name != \"\" {\n217\t\t\t\tnameStyled = sty.render(sty.name, namePlain)\n218\t\t\t} else {\n219\t\t\t\tnameStyled = sty.render(sty.dim, namePlain)\n220\t\t\t}\n221\t\t\tvar lastUsedStyled string\n222\t\t\tif t.LastUsedAt == nil {\n223\t\t\t\tlastUsedStyled = sty.render(sty.dim, lastUsedPlain)\n224\t\t\t} else {\n225\t\t\t\tlastUsedStyled = sty.render(sty.value, lastUsedPlain)\n226\t\t\t}\n227\t\t\tvar expiresStyled string\n228\t\t\tswitch expiresState(t.ExpiresAt, now) {\n229\t\t\tcase expiresStateExpired:\n230\t\t\t\texpiresStyled = sty.render(sty.expired, expiresPlain)\n231\t\t\tcase expiresStateSoon:\n232\t\t\t\texpiresStyled = sty.render(sty.warning, expiresPlain)\n233\t\t\tcase expiresStateNormal:\n234\t\t\t\texpiresStyled = sty.render(sty.value, expiresPlain)\n235\t\t\t}\n236\t\n237\t\t\trows = append(rows, []cell{\n238\t\t\t\t{styled: sty.render(sty.id, idPlain), plain: idPlain},\n239\t\t\t\t{styled: nameStyled, plain: namePlain},\n240\t\t\t\t{styled: sty.render(sty.value, scopePlain), plain: scopePlain},\n241\t\t\t\t{styled: sty.render(sty.value, createdPlain), plain: createdPlain},\n\n... [190 lines truncated] ..."},"type":"attachment","uuid":"817335c6-cd2e-4354-998f-78dfd1667d68","timestamp":"2026-04-27T18:31:22.836Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli","sessionId":"b8f6d643-d50f-43cc-b9e7-b5dfa6939c04","version":"2.1.119","gitBranch":"soph/token-improvements"}
