{"parentUuid":"0ea2ecad-28a3-407c-9eaf-8ca10f99b31b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/agent/pi/hooks.go","snippet":"1\tpackage pi\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n15\t)\n16\t\n17\tconst (\n18\t\textensionDir      = \".pi/extensions/entire\"\n19\t\textensionFile     = \".pi/extensions/entire/index.ts\"\n20\t\tactiveSessionFile = \"pi-active-session\"\n21\t)\n22\t\n23\t// Pi hook names — these become subcommands under `entire hooks pi`.\n24\t// Names match Pi's native event names (snake_case) so the TypeScript\n25\t// extension can pass them through verbatim.\n26\tconst (\n27\t\tHookNameSessionStart     = \"session_start\"\n28\t\tHookNameBeforeAgentStart = \"before_agent_start\"\n29\t\tHookNameAgentEnd         = \"agent_end\"\n30\t\tHookNameSessionShutdown  = \"session_shutdown\"\n31\t)\n32\t\n33\t// piHookPayload is the JSON the TypeScript extension sends to\n34\t// `entire hooks pi <event>`.\n35\ttype piHookPayload struct {\n36\t\tType         string `json:\"type\"`\n37\t\tCwd          string `json:\"cwd,omitempty\"`\n38\t\tSessionFile  string `json:\"session_file,omitempty\"`\n39\t\tSessionID    string `json:\"session_id,omitempty\"`\n40\t\tPrompt       string `json:\"prompt,omitempty\"`\n41\t\tMessageCount int    `json:\"message_count,omitempty\"`\n42\t\tTurnIndex    int    `json:\"turn_index,omitempty\"`\n43\t}\n44\t\n45\t// HookNames returns the hook verbs Pi supports.\n46\tfunc (p *PiAgent) HookNames() []string {\n47\t\treturn []string{\n48\t\t\tHookNameSessionStart,\n49\t\t\tHookNameBeforeAgentStart,\n50\t\t\tHookNameAgentEnd,\n51\t\t\tHookNameSessionShutdown,\n52\t\t}\n53\t}\n54\t\n55\t// ParseHookEvent translates a Pi hook into a normalized lifecycle Event.\n56\t// Returns nil if the hook has no lifecycle significance.\n57\tfunc (p *PiAgent) ParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n58\t\tconst maxHookBytes = 10 * 1024 * 1024\n59\t\tdata, err := io.ReadAll(io.LimitReader(stdin, maxHookBytes))\n60\t\tif err != nil {\n61\t\t\treturn nil, fmt.Errorf(\"read hook input: %w\", err)\n62\t\t}\n63\t\tif len(data) == 0 {\n64\t\t\treturn nil, nil //nolint:nilnil // empty input → no event\n65\t\t}\n66\t\n67\t\tvar payload piHookPayload\n68\t\tif err := json.Unmarshal(data, &payload); err != nil {\n69\t\t\treturn nil, fmt.Errorf(\"parse hook payload: %w\", err)\n70\t\t}\n71\t\n72\t\tsessionID := payload.SessionID\n73\t\tif sessionID == \"\" {\n74\t\t\tsessionID = extractSessionIDFromPath(payload.SessionFile)\n75\t\t}\n76\t\n77\t\trepoRoot := repoRootForCtx(ctx)\n78\t\tnow := time.Now().UTC()\n79\t\n80\t\tswitch hookName {\n81\t\tcase HookNameSessionStart:\n82\t\t\tcacheSessionID(repoRoot, sessionID)\n83\t\t\treturn &agent.Event{\n84\t\t\t\tType:      agent.SessionStart,\n85\t\t\t\tSessionID: sessionID,\n86\t\t\t\tTimestamp: now,\n87\t\t\t}, nil\n88\t\n89\t\tcase HookNameBeforeAgentStart:\n90\t\t\tif sessionID == \"\" {\n91\t\t\t\tsessionID = readCachedSessionID(repoRoot)\n92\t\t\t} else {\n93\t\t\t\tcacheSessionID(repoRoot, sessionID)\n94\t\t\t}\n95\t\t\t// Provide the live Pi session file as SessionRef so state.TranscriptPath\n96\t\t\t// is populated before any mid-turn commits — without it, the post-commit\n97\t\t\t// hook can't condense when no shadow branch exists yet.\n98\t\t\treturn &agent.Event{\n99\t\t\t\tType:       agent.TurnStart,\n100\t\t\t\tSessionID:  sessionID,\n101\t\t\t\tSessionRef: payload.SessionFile,\n102\t\t\t\tPrompt:     payload.Prompt,\n103\t\t\t\tTimestamp:  now,\n104\t\t\t}, nil\n105\t\n106\t\tcase HookNameAgentEnd:\n107\t\t\tif sessionID == \"\" {\n108\t\t\t\tsessionID = readCachedSessionID(repoRoot)\n109\t\t\t}\n110\t\t\tsess