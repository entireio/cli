/ ---------------------------------------------------------------------------\n384\t// resolveActiveBranch unit tests\n385\t// ---------------------------------------------------------------------------\n386\t\n387\tfunc TestResolveActiveBranch_LinearChain(t *testing.T) {\n388\t\tdata := []byte(`{\"type\":\"session\",\"id\":\"s1\"}\n389\t{\"type\":\"model_change\",\"id\":\"mc1\",\"parentId\":null}\n390\t{\"type\":\"message\",\"id\":\"m1\",\"parentId\":\"mc1\"}\n391\t{\"type\":\"message\",\"id\":\"m2\",\"parentId\":\"m1\"}\n392\t{\"type\":\"message\",\"id\":\"m3\",\"parentId\":\"m2\"}\n393\t`)\n394\t\tactive := resolveActiveBranch(data)\n395\t\tfor _, id := range []string{\"m3\", \"m2\", \"m1\", \"mc1\"} {\n396\t\t\tif !active[id] {\n397\t\t\t\tt.Errorf(\"expected %q in active set\", id)\n398\t\t\t}\n399\t\t}\n400\t\t// session entry is not in the tree chain\n401\t\tif active[\"s1\"] {\n402\t\t\tt.Error(\"session entry should not be in active set\")\n403\t\t}\n404\t}\n405\t\n406\tfunc TestResolveActiveBranch_EmptyData(t *testing.T) {\n407\t\tactive := resolveActiveBranch(nil)\n408\t\tif active != nil {\n409\t\t\tt.Errorf(\"expected nil for empty data, got %v\", active)\n410\t\t}\n411\t}\n412\t\n413\tfunc TestResolveActiveBranch_SessionOnly(t *testing.T) {\n414\t\tdata := []byte(`{\"type\":\"session\",\"id\":\"s1\"}\n415\t`)\n416\t\tactive := resolveActiveBranch(data)\n417\t\tif active != nil {\n418\t\t\tt.Errorf(\"expected nil when no message entries, got %v\", active)\n419\t\t}\n420\t}\n421\t\n422\tfunc TestResolveActiveBranch_CycleProtection(t *testing.T) {\n423\t\t// a → b → a (cycle). Should terminate, not infinite loop.\n424\t\tdata := []byte(`{\"type\":\"message\",\"id\":\"a\",\"parentId\":\"b\"}\n425\t{\"type\":\"message\",\"id\":\"b\",\"parentId\":\"a\"}\n426\t`)\n427\t\tactive := resolveActiveBranch(data)\n428\t\t// Should contain both but not hang.\n429\t\tif !active[\"a\"] || !active[\"b\"] {\n430\t\t\tt.Errorf(\"active = %v, want both a and b\", active)\n431\t\t}\n432\t}\n433\t\n434\tfunc TestResolveActiveBranch_SelfReferentialParent(t *testing.T) {\n435\t\tdata := []byte(`{\"type\":\"message\",\"id\":\"m1\",\"parentId\":\"m1\"}\n436\t`)\n437\t\tactive := resolveActiveBranch(data)\n438\t\tif !active[\"m1\"] {\n439\t\t\tt.Error(\"expected m1 in active set\")\n440\t\t}\n441\t\tif len(active) != 1 {\n442\t\t\tt.Errorf(\"expected 1 entry in active set, got %d\", len(active))\n443\t\t}\n444\t}\n445\t\n446\tfunc TestResolveActiveBranch_TwoBranches_PicksLast(t *testing.T) {\n447\t\t// Two branches from a: b (earlier) and c (later, last in file).\n448\t\t// Active branch should be c's path.\n449\t\tdata := []byte(`{\"type\":\"message\",\"id\":\"a\",\"parentId\":\"root\"}\n450\t{\"type\":\"message\",\"id\":\"root\",\"parentId\":null}\n451\t{\"type\":\"message\",\"id\":\"b\",\"parentId\":\"a\"}\n452\t{\"type\":\"message\",\"id\":\"c\",\"parentId\":\"a\"}\n453\t`)\n454\t\n455\t\tactive := resolveActiveBranch(data)\n456\t\tif !active[\"c\"] || !active[\"a\"] {\n457\t\t\tt.Errorf(\"expected c and a in active set, got %v\", active)\n458\t\t}\n459\t\tif active[\"b\"] {\n460\t\t\tt.Error(\"b should not be in active set\")\n461\t\t}\n462\t}\n463\t\n464\tfunc TestResolveActiveBranch_FlatReturnsNil(t *testing.T) {\n465\t\t// No parentId at all — should skip tree resolution.\n466\t\tdata := []byte(`{\"type\":\"message\",\"id\":\"m1\"}\n467\t{\"type\":\"message\",\"id\":\"m2\"}\n468\t`)\n469\t\tactive := resolveActiveBranch(data)\n470\t\tif active != nil {\n471\t\t\tt.Errorf(\"expected nil for flat transcript, got %v\", active)\n472\t\t}\n473\t}\n474\t\n475\tfunc TestResolveActiveBranch_NullParentIDOnly(t *testing.T) {\n476\t\t// All entries have parentId:null — no real tree.\n477\t\tdata := []byte(`{\"type\":\"message\",\"id\":\"m1\",\"parentId\":null}\n478\t{\"type\":\"message\",\"id\":\"m2\",\"parentId\":null}\n479\t`)\n480\t\tactive := resolveActiveBranch(data)\n481\t\tif active != nil {\n482\t\t\tt.Errorf(\"expected nil when only n