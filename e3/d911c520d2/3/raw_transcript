ror{Err: err}\n\t\t\tch <- reviewtypes.Finished{Success: false}\n\t\t\treturn\n\t\t}\n\t\tch <- reviewtypes.Finished{Success: true}\n\t}()\n\treturn ch\n}\n","numLines":261,"startLine":1,"totalLines":261}},"sourceToolAssistantUUID":"84436978-1e33-431a-afbd-77b975875caf","userType":"external","entrypoint":"sdk-cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream","sessionId":"84a291c5-d6c4-42f7-bd6f-10430fbbd582","version":"2.1.139","gitBranch":"review-fix-progress-stream"}
