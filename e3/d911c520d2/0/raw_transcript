rator lines: \"─────── codex ───────\", \"─────────────────────\"\n38\t//   - Version header lines:   \"version 0.1.0 (linux)\"\n39\t//\n40\t// The version alternative is anchored at both ends and allows an optional patch\n41\t// segment and a parenthesized platform suffix so that narrative text like\n42\t// \"version 1.2.3 of go-git fixes the issue\" is NOT dropped.\n43\tvar bannerRegex = regexp.MustCompile(`^[─\\-\\s]+(?:codex|version)[─\\-\\s]*$|^[─\\-]+$|^version\\s+\\d+\\.\\d+(?:\\.\\d+)?\\s*(?:\\([^)]+\\))?\\s*$`)\n44\t\n45\t// FilterLine applies all codex-specific chrome filters to a single line.\n46\t// It returns the cleaned line and true if the line should be emitted, or\n47\t// (\"\", false) if the line is chrome and must be dropped.\n48\t//\n49\t// Filtering order:\n50\t//  1. Strip CSI/ANSI escape sequences.\n51\t//  2. Drop blank lines after stripping.\n52\t//  3. Drop banner/header lines.\n53\t//  4. Drop exec-block lines (anchored to avoid false positives).\n54\t//  5. Drop hook-firing notice lines.\n55\t//  6. Drop timestamped error/log lines.\n56\tfunc FilterLine(line string) (string, bool) {\n57\t\t// 1. Strip CSI sequences.\n58\t\tcleaned := csiRegex.ReplaceAllString(line, \"\")\n59\t\n60\t\t// 2. Drop blank after stripping. Use TrimSpace ONLY for the empty-check;\n61\t\t// the returned line preserves leading whitespace so markdown/code-block\n62\t\t// indentation in narrative output is not flattened.\n63\t\tif strings.TrimSpace(cleaned) == \"\" {\n64\t\t\treturn \"\", false\n65\t\t}\n66\t\n67\t\t// Use the trim-right form for chrome-pattern matching (so trailing\n68\t\t// whitespace doesn't break anchored regexes) while keeping the leading\n69\t\t// whitespace on the returned value.\n70\t\ttrimmedRight := strings.TrimRight(cleaned, \" \\t\")\n71\t\n72\t\t// 3. Drop banner/separator lines.\n73\t\tif bannerRegex.MatchString(trimmedRight) {\n74\t\t\treturn \"\", false\n75\t\t}\n76\t\n77\t\t// 4. Drop exec-block lines.\n78\t\tif execBlockRegex.Match