(ctx, RunConfig{})\n\tif err != nil {\n\t\tt.Fatalf(\"Start() error: %v\", err)\n\t}\n\tfor ev := range proc.Events() {\n\t\t_ = ev\n\t}\n\tcancel()\n\n\twaitErr := proc.Wait()\n\tif !errors.Is(waitErr, context.Canceled) {\n\t\tt.Fatalf(\"Wait() = %T %v, want context.Canceled\", waitErr, waitErr)\n\t}\n}\n\nfunc TestReviewerTemplate_WaitIncludesStderrOnFailure(t *testing.T) {\n\tskipOnWindows(t, \"test uses POSIX shell\")\n\tt.Parallel()\n\n\ttmpl := &ReviewerTemplate{\n\t\tAgentName: \"stderr-agent\",\n\t\tBuildCmd: func(ctx context.Context, _ RunConfig) *exec.Cmd {\n\t\t\treturn exec.CommandContext(ctx, \"sh\", \"-c\", \"echo 'auth failed: login required' >&2; exit 7\")\n\t\t},\n\t\tParser: func(_ io.Reader) <-chan Event {\n\t\t\tch := make(chan Event)\n\t\t\tclose(ch)\n\t\t\treturn ch\n\t\t},\n\t}\n\n\tproc, err := tmpl.Start(context.Background(), RunConfig{})\n\tif err != nil {\n\t\tt.Fatalf(\"Start() error: %v\", err)\n\t}\n\tfor ev := range proc.Events() {\n\t\t_ = ev\n\t}\n\n\twaitErr := proc.Wait()\n\tif waitErr == nil {\n\t\tt.Fatal(\"Wait() returned nil, want failure\")\n\t}\n\tvar exitErr *exec.ExitError\n\tif !errors.As(waitErr, &exitErr) {\n\t\tt.Fatalf(\"Wait() = %T %v, want error wrapping *exec.ExitError\", waitErr, waitErr)\n\t}\n\tif !strings.Contains(waitErr.Error(), \"auth failed: login required\") {\n\t\tt.Fatalf(\"Wait() error missing stderr diagnostics: %v\", waitErr)\n\t}\n}\n\n// TestReviewerTemplate_UsePTYPipesLinesEndToEnd pins the PTY plumbing:\n// when UsePTY is true, lines a real subprocess prints to its stdout reach\n// the parser via the PTY master and surface as events. Also checks the\n// EIO-to-EOF translation kicks in cleanly when the child exits — without\n// it Linux ptmx reads would surface as scanner errors.\nfunc TestReviewerTemplate_UsePTYPipesLinesEndToEnd(t *testing.T) {\n\tskipOnWindows(t, \"PTY unsupported on Windows; falls back to pipe and is covered by other tests\")\n\tt.Parallel()\n\n\t// Line parser: emit Started, one AssistantText per line, Finished on EOF.\n\tlineParser := func(r io.Reader) <-chan Event {\n\t\tch := make(chan Event, 16)\n\t\tgo func() {\n\t\t\tdefer close(ch)\n\t\t\tch <- Started{}\n\t\t\ts := bufio.NewScanner(r)\n\t\t\tfor s.Scan() {\n\t\t\t\tline := strings.TrimRight(s.Text(), \"\\r\")\n\t\t\t\tif line == \"\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tch <- AssistantText{Text: line}\n\t\t\t}\n\t\t\tif err := s.Err(); err != nil {\n\t\t\t\tch <- RunError{Err: err}\n\t\t\t\tch <- Finished{Success: false}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tch <- Finished{Success: true}\n\t\t}()\n\t\treturn ch\n\t}\n\n\ttmpl := &ReviewerTemplate{\n\t\tAgentName: \"pty-test\",\n\t\tBuildCmd: func(ctx context.Context, _ RunConfig) *exec.Cmd {\n\t\t\t// Three short lines, flushed individually so PTY mode is the\n\t\t\t// only way they arrive before exit on stdio-buffering platforms.\n\t\t\treturn exec.CommandContext(ctx, \"sh\", \"-c\", \"printf 'a\\\\n'; printf 'b\\\\n'; printf 'c\\\\n'\")\n\t\t},\n\t\tParser: lineParser,\n\t\tUsePTY: true,\n\t}\n\n\tproc, err := tmpl.Start(context.Background(), RunConfig{})\n\tif err != nil {\n\t\tt.Fatalf(\"Start() error: %v\", err)\n\t}\n\n\tvar got []Event\n\ttimeout := time.After(5 * time.Second)\n\tfor {\n\t\tselect {\n\t\tcase ev, ok := <-proc.Events():\n\t\t\tif !ok {\n\t\t\t\tgoto done\n\t\t\t}\n\t\t\tgot = append(got, ev)\n\t\tcase <-timeout:\n\t\t\tt.Fatalf(\"timed out collecting events (got %d so far)\", len(got))\n\t\t}\n\t}\ndone:\n\tif err := proc.Wait(); err != nil {\n\t\tt.Fatalf(\"Wait() error: %v\", err)\n\t}\n\n\t// Expect: Started, AssistantText{a}, AssistantText{b}, AssistantText{c}, Finished{true}.\n\tif len(got) != 5 {\n\t\tt.Fatalf(\"got %d events, want 5: %v\", len(got), got)\n\t}\n\tif _, ok := got[0].(Started); !ok {\n\t\tt.Errorf(\"events[0] = %T, want Started\", got[0])\n\t}\n\tfor i, want := range []string{\"a\", \"b\", \"c\"} {\n\t\tat, ok := got[i+1].(AssistantText)\n\t\tif !ok {\n\t\t\tt.Errorf(\"events[%d] = %T, want AssistantText\", i+1, got[i+1])\n\t\t\tcontinue\n\t\t}\n\t\tif at.Text != want {\n\t\t\tt.Errorf(\"events[%d].Text = %q, want %q\", i+1, at.Text, want)\n\t\t}\n\t}\n\tfin, ok := got[4].(Finished)\n\tif !ok {\n\t\tt.Fatalf(\"events[4] = %T, want Finished\", got[4])\n\t}\n\tif !fin.Success {\n\t\tt.Error(\"Finished.Success = false, want true\")\n\t}\n}\n\n// TestReviewerTemplate_UsePTYAppendsNoDecorationEnv pins that PTY mode\n// sets NO_COLOR/FORCE_COLOR/TERM=dumb on the child env to suppress\n// terminal decoration the agent might emit now that isatty(stdout) is true.\n// The test sniffs the child's env via /usr/bin/env to avoid relying on\n// shell built-in behaviour.\nfunc TestReviewerTemplate_UsePTYAppendsNoDecorationEnv(t *testing.T) {\n\tskipOnWindows(t, \"PTY unsupported on Windows\")\n\tt.Parallel()\n\n\tlineParser := func(r io.Reader) <-chan Event {\n\t\tch := make(chan Event, 16)\n\t\tgo func() {\n\t\t\tdefer close(ch)\n\t\t\tch <- Started{}\n\t\t\ts := bufio.NewScanner(r)\n\t\t\tfor s.Scan() {\n\t\t\t\tch <- AssistantText{Text: strings.TrimRight(s.Text(), \"\\r\")}\n\t\t\t}\n\t\t\tch <- Finished{Success: true}\n\t\t}()\n\t\treturn ch\n\t}\n\n\ttmpl := &ReviewerTemplate{\n\t\tAgentName: \"pty-env-test\",\n\t\tBuildCmd: func(ctx context.Context, _ RunConfig) *exec.Cmd {\n\t\t\tc := exec.CommandContext(ctx, \"sh\", \"-c\", \"echo NO_COLOR=$NO_COLOR; echo TERM=$TERM; echo FORCE_COLOR=$FORCE_COLOR\")\n\t\t\tc.Env = []string{\"PATH=/usr/bin:/bin\"} // start minimal so appended vars are detectable\n\t\t\treturn c\n\t\t},\n\t\tParser: lineParser,\n\t\tUsePTY: true,\n\t}\n\n\tproc, err := tmpl.Start(context.Background(), RunConfig{})\n\tif err != nil {\n\t\tt.Fatalf(\"Start() error: %v\", err)\n\t}\n\n\tvar combined strings.Builder\n\tfor ev := range proc.Events() {\n\t\tif at, ok := ev.(AssistantText); ok {\n\t\t\tcombined.WriteString(at.Text)\n\t\t\tcombined.WriteString(\"\\n\")\n\t\t}\n\t}\n\t_ = proc.Wait() //nolint:errcheck // status irrelevant; we only inspect output\n\n\tout := combined.String()\n\tfor _, want := range []string{\"NO_COLOR=1\", \"TERM=dumb\", \"FORCE_COLOR=0\"} {\n\t\tif !strings.Contains(out, want) {\n\t\t\tt.Errorf(\"PTY mode did not export %s; output was:\\n%s\", want, out)\n\t\t}\n\t}\n}\n\n// TestReviewerTemplate_StartReturnsErrTemplateMisconfigured pins the typed\n// validation errors Start returns when required fields are missing. The\n// previous behaviour panicked here, which would crash a whole multi-agent\n// fan-out (CU8) when one agent's template is misconfigured. Returning a\n// typed error lets callers skip that agent and continue.\nfunc TestReviewerTemplate_StartReturnsErrTemplateMisconfigured(t *testing.T) {\n\tt.Parallel()\n\tcases := []struct {\n\t\tname string\n\t\ttmpl ReviewerTemplate\n\t}{\n\t\t{\n\t\t\tname: \"empty AgentName\",\n\t\t\ttmpl: ReviewerTemplate{\n\t\t\t\tBuildCmd: func(ctx context.Context, _ RunConfig) *exec.Cmd { return exec.CommandContext(ctx, \"true\") },\n\t\t\t\tParser:   func(_ io.Reader) <-chan Event { c := make(chan Event); close(c); return c },\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname: \"nil BuildCmd\",\n\t\t\ttmpl: ReviewerTemplate{\n\t\t\t\tAgentName: \"test\",\n\t\t\t\tParser:    func(_ io.Reader) <-chan Event { c := make(chan Event); close(c); return c },\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname: \"nil Parser\",\n\t\t\ttmpl: ReviewerTemplate{\n\t\t\t\tAgentName: \"test\",\n\t\t\t\tBuildCmd:  func(ctx context.Context, _ RunConfig) *exec.Cmd { return exec.CommandContext(ctx, \"true\") },\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname: \"BuildCmd returns nil\",\n\t\t\ttmpl: ReviewerTemplate{\n\t\t\t\tAgentName: \"test\",\n\t\t\t\tBuildCmd:  func(_ context.Context, _ RunConfig) *exec.Cmd { return nil },\n\t\t\t\tParser:    func(_ io.Reader) <-chan Event { c := make(chan Event); close(c); return c },\n\t\t\t},\n\t\t},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\ttmpl := tc.tmpl\n\t\t\t_, err := tmpl.Start(context.Background(), RunConfig{})\n\t\t\tif err == nil {\n\t\t\t\tt.Fatal(\"expected error, got nil\")\n\t\t\t}\n\t\t\tif !errors.Is(err, ErrTemplateMisconfigured) {\n\t\t\t\tt.Errorf(\"expected ErrTemplateMisconfigured, got %v\", err)\n\t\t\t}\n\t\t})\n\t}\n}\n","numLines":401,"startLine":1,"totalLines":401}},"sourceToolAssistantUUID":"2bdc4bf1-98bb-4954-bbe4-f6d43932b09d","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream","sessionId":"29e905db-df81-4eac-9e54-265c4e180a9c","version":"2.1.139","gitBranch":"review-fix-progress-stream"}
