"(0 events)\" until the agent exits.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"context\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/mattn/go-isatty\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/review\"\n\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n)\n\nconst probeFlag = \"--probe\"\n\nfunc main() {\n\t// Self-spawn pattern: re-exec the same binary with --probe to act as\n\t// the fake \"buffering agent\". Lets the whole smoke test live in one\n\t// file the user can run with `go run ./e2e/streaming-smoke`.\n\tif len(os.Args) > 1 && os.Args[1] == probeFlag {\n\t\trunProbe(os.Args[2:])\n\t\treturn\n\t}\n\n\tuseTUI := flag.Bool(\"tui\", false, \"boot the real review TUI with UsePTY=true (the fix)\")\n\tuseTUIBuggy := flag.Bool(\"tui-buggy\", false, \"boot the real review TUI with UsePTY=false (the bug)\")\n\tflag.Parse()\n\n\tvar err error\n\tswitch {\n\tcase *useTUI:\n\t\terr = runTUI(true)\n\tcase *useTUIBuggy:\n\t\terr = runTUI(false)\n\tdefault:\n\t\terr = runTimeline()\n\t}\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, \"streaming-smoke:\", err)\n\t\tos.Exit(1)\n\t}\n}\n\n// runProbe is the fake-agent side. When stdout is a pipe (not a TTY)\n// it wraps stdout in a bufio.Writer with a libc-typical 64KB buffer so\n// per-line writes accumulate until exit — the same pattern that causes\n// real agents to \"burst at the end\". When stdout IS a TTY it writes\n// directly so the natural per-line flushing happens.\n//\n// Args (parsed from the probe sub-command's argv):\n//\n//\t--lines N    how many lines to emit (default 5)\n//\t--delay D    sleep between lines (default 150ms)\n//\t--label S    prefix for each line so two probes are distinguishable\nfunc runProbe(args []string) {\n\tfs := flag.NewFlagSet(\"probe\", flag.ExitOnError)\n\tlines := fs.Int(\"lines\", 5, \"number of lines\")\n\tdelay := fs.Duration(\"delay\", 150*time.Millisecond, \"sleep between lines\")\n\tlabel :