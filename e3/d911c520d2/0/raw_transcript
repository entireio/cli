{"parentUuid":"c14ab690-fb1c-4cba-bfb4-c22b3a4f37b8","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream/e2e/streaming-smoke/main.go","snippet":"1\t// streaming-smoke is a self-contained verifier for the per-agent live\n2\t// streaming fix in `entire review`. It does NOT call any agent API.\n3\t//\n4\t// # What it proves\n5\t//\n6\t// The fix routes each agent's stdout through a pseudo-terminal so the\n7\t// child's isatty(stdout) returns true and its runtime (libc / Rust / Node)\n8\t// reverts to line-buffered flushing instead of block-buffering until exit.\n9\t// To exercise that mechanism without burning tokens, this binary spawns\n10\t// ITSELF as a child in \"probe\" mode — and the probe deliberately\n11\t// block-buffers stdout when stdout is a pipe. So:\n12\t//\n13\t//   - With UsePTY=false: the probe sees a pipe, fills its 64KB buffer,\n14\t//     and only flushes at exit. The runner observes one big burst.\n15\t//   - With UsePTY=true:  the probe sees a TTY, line-buffers, and the\n16\t//     runner observes events arriving as each line is written.\n17\t//\n18\t// The two passes print event timestamps side-by-side so the difference\n19\t// is visible at a glance.\n20\t//\n21\t// Usage:\n22\t//\n23\t//\tgo run ./e2e/streaming-smoke\n24\t//\n25\t// Expected output (timestamps approximate):\n26\t//\n27\t//\t=== Pass 1: UsePTY=false (simulates the bug) ===\n28\t//\t  +    0ms  Started{}\n29\t//\t  +  830ms  AssistantText  \"probe line 1\"\n30\t//\t  +  830ms  AssistantText  \"probe line 2\"\n31\t//\t  +  830ms  AssistantText  \"probe line 3\"\n32\t//\t  +  830ms  AssistantText  \"probe line 4\"\n33\t//\t  +  830ms  AssistantText  \"probe line 5\"\n34\t//\t  +  830ms  Finished{Success:true}\n35\t//\n36\t//\t=== Pass 2: UsePTY=true (the fix) ===\n37\t//\t  +    0ms  Started{}\n38\t//\t  +    1ms  AssistantText  \"probe line 1\"\n39\t//\t  +  160ms  AssistantText  \"probe line 2\"\n40\t//\t  +  320ms  AssistantText  \"probe line 3\"\n41\t//\t  +  480ms  AssistantText  \"probe line 4\"\n42\t//\t  +  640ms  AssistantText  \"probe line 5\"\n43\t//\t  +  640ms  Finished{Success:true}\n44\t//\n45\t// Notice how Pass 1 clusters all events at end-of-run, while Pass 2\n46\t// staggers them at ~150ms intervals (the probe's sleep between lines).\n47\tpackage main\n48\t\n49\timport (\n50\t\t\"bufio\"\n51\t\t\"context\"\n52\t\t\"fmt\"\n53\t\t\"io\"\n54\t\t\"os\"\n55\t\t\"os/exec\"\n56\t\t\"strings\"\n57\t\t\"time\"\n58\t\n59\t\t\"github.com/mattn/go-isatty\"\n60\t\n61\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n62\t)\n63\t\n64\tconst probeFlag = \"--probe\"\n65\t\n66\tfunc main() {\n67\t\t// Self-spawn pattern: re-exec the same binary with --probe to act as\n68\t\t// the fake \"buffering agent\". Keeps the smoke test in a single file\n69\t\t// the user can run with `go run ./e2e/streaming-smoke`.\n70\t\tif len(os.Args) > 1 && os.Args[1] == probeFlag {\n71\t\t\trunProbe()\n72\t\t\treturn\n73\t\t}\n74\t\tif err := runHarness(); err != nil {\n75\t\t\tfmt.Fprintln(os.Stderr, \"streaming-smoke:\", err)\n76\t\t\tos.Exit(1)\n77\t\t}\n78\t}\n79\t\n80\t// runProbe is the fake-agent side. When stdout is a pipe (not a TTY)\n81\t// it wraps stdout in a bufio.Writer with a libc-typical 64KB buffer so\n82\t// per-line writes accumulate until exit — the same pattern that causes\n83\t// real agents to \"burst at the end\". When stdout IS a TTY it writes\n84\t// directly so the natural per-line flushing happens.\n85\tfunc runProbe() {\n86\t\tconst lineCount = 5\n87\t\tconst between = 150 * time.Millisecond\n88\t\n89\t\tif isatty.IsTerminal(os.Stdout.Fd()) {\n90\t\t\t// TTY path: writes flush per line; the runner sees them stagger.\n91\t\t\tfor i := 1; i <= lineCount; i++ {\n92\t\t\t\tfmt.Fprintf(os.Stdout, \"probe line %d\\n\", i)\n93\t\t\t\ttime.Sleep(between)\n94\t\t\t}\n95\t\t\treturn\n96\t\t}\n97\t\n98\t\t// Pipe path: simulate libc/Rust/Node block buffering. All lines stay\n99\t\t// in the buffer until Flush() at exit — even though the same loop\n100\t\t// sleeps between writes, the runner sees them as one burst.\n101\t\tw := bufio.NewWriterSize(os.Stdout, 64*1024)\n102\t\tfor i := 1; i <= lineCount; i++ {\n103\t\t\tfmt.Fprintf(w, \"probe line %d\\n\", i)\n104\t\t\ttime.Sleep(between)\n105\t\t}\n106\t\t_ = w.Flush()\n107\t}\n108\t\n109\t// runHarness spawns the probe twice — once without PTY (bug), once with\n110\t// PTY (fix) — and prints per-event timing for each pass.\n111\tfunc runHarness() error {\n112\t\tself, err := os.Executable()\n113\t\tif err != nil {\n114\t\t\treturn fmt.Errorf(\"locate self: %w\", err)\n115\t\t}\n116\t\n117\t\tfmt.Println(\"streaming-smoke: spawning probe twice to compare buffering behaviour.\")\n118\t\tfmt.Println(\"look for events clustered at end (Pass 1) vs staggered (Pass 2).\")\n119\t\tfmt.Println()\n120\t\n121\t\tif err := runOnce(\"Pass 1: UsePTY=false (simulates the bug)\", self, false); err != nil {\n122\t\t\treturn err\n123\t\t}\n124\t\tfmt.Println()\n125\t\tif err := runOnce(\"Pass 2: UsePTY=true (the fix)\", self, true); err != nil {\n126\t\t\treturn err\n127\t\t}\n128\t\treturn nil\n129\t}\n130\t\n131\tfunc runOnce(label, selfPath string, usePTY bool) error {\n132\t\ttmpl := &reviewtypes.ReviewerTemplate{\n133\t\t\tAgentName: \"smoke-probe\",\n134\t\t\tBuildCmd: func(ctx context.Context, _ reviewtypes.RunConfig) *exec.Cmd {\n135\t\t\t\treturn exec.CommandContext(ctx, selfPath, probeFlag)\n136\t\t\t},\n137\t\t\tParser: lineParser,\n138\t\t\tUsePTY: usePTY,\n139\t\t}\n140\t\n141\t\tstarted := time.Now()\n142\t\tproc, err := tmpl.Start(context.Background(), reviewtypes.RunConfig{})\n143\t\tif err != nil {\n144\t\t\treturn fmt.Errorf(\"%s: start: %w\", label, err)\n145\t\t}\n146\t\n147\t\tfmt.Printf(\"=== %s ===\\n\", label)\n148\t\tfor ev := range proc.Events() {\n149\t\t\telapsed := time.Since(started)\n150\t\t\tprintEvent(elapsed, ev)\n151\t\t}\n152\t\tif err := proc.Wait(); err != nil {\n153\t\t\treturn fmt.Errorf(\"%s: wait: %w\", label, err)\n154\t\t}\n155\t\treturn nil\n156\t}\n157\t\n158\tfunc printEvent(elapsed time.Duration, ev reviewtypes.Event) {\n159\t\tprefix := fmt.Sprintf(\"  + %4dms  \", elapsed.Milliseconds())\n160\t\tswitch e := ev.(type) {\n161\t\tcase reviewtypes.AssistantText:\n162\t\t\tfmt.Printf(\"%sAssistantText  %q\\n\", prefix, e.Text)\n163\t\tcase reviewtypes.Started:\n164\t\t\tfmt.Printf(\"%sStarted{}\\n\", prefix)\n165\t\tcase reviewtypes.Finished:\n166\t\t\tfmt.Printf(\"%sFinished{Success:%v}\\n\", prefix, e.Success)\n167\t\tdefault:\n168\t\t\tfmt.Printf(\"%s%T\\n\", prefix, ev)\n169\t\t}\n170\t}\n171\t\n172\tfunc lineParser(r io.Reader) <-chan reviewtypes.Event {\n173\t\tch := make(chan reviewtypes.Event, 16)\n174\t\tgo func() {\n175\t\t\tdefer close(ch)\n176\t\t\tch <- reviewtypes.Started{}\n177\t\t\ts := bufio.NewScanner(r)\n178\t\t\tfor s.Scan() {\n179\t\t\t\tline := strings.TrimRight(s.Text(), \"\\r\")\n180\t\t\t\tif line == \"\" {\n181\t\t\t\t\tcontinue\n182\t\t\t\t}\n183\t\t\t\tch <- reviewtypes.AssistantText{Text: line}\n184\t\t\t}\n185\t\t\tif err := s.Err(); err != nil {\n186\t\t\t\tch <- reviewtypes.RunError{Err: err}\n187\t\t\t\tch <- reviewtypes.Finished{Success: false}\n188\t\t\t\treturn\n189\t\t\t}\n190\t\t\tch <- reviewtypes.Finished{Success: true}\n191\t\t}()\n192\t\treturn ch\n193\t}"},"type":"attachment","uuid":"40a0510d-50c4-46c8-a269-90576d6228d1","timestamp":"2026-05-12T02:44:52.440Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream","sessionId":"29e905db-df81-4eac-9e54-265c4e180a9c","version":"2.1.139","gitBranch":"review-fix-progress-stream"}
