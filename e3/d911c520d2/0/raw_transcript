{"parentUuid":"a17f976c-29ba-4c98-8690-2fd3ecba56a6","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream/e2e/streaming-smoke/main.go","snippet":"1\t// streaming-smoke is a self-contained verifier for the per-agent live\n2\t// streaming fix in `entire review`. It does NOT call any agent API.\n3\t//\n4\t// # What it proves\n5\t//\n6\t// The fix routes each agent's stdout through a pseudo-terminal so the\n7\t// child's isatty(stdout) returns true and its runtime (libc / Rust / Node)\n8\t// reverts to line-buffered flushing instead of block-buffering until exit.\n9\t// To exercise that mechanism without burning tokens, this binary spawns\n10\t// ITSELF as a child in \"probe\" mode — and the probe deliberately\n11\t// block-buffers stdout when stdout is a pipe.\n12\t//\n13\t// # Three ways to run\n14\t//\n15\t// 1) Default (timeline comparison, ~2s, non-interactive):\n16\t//\n17\t//\t\tgo run ./e2e/streaming-smoke\n18\t//\n19\t//\t   Spawns one probe with UsePTY=false (the bug) then one with\n20\t//\t   UsePTY=true (the fix), printing event timestamps side-by-side.\n21\t//\t   Pass 1's events cluster at end; pass 2's stagger by ~150ms.\n22\t//\n23\t// 2) Real review TUI with the fix on (interactive, ~12s):\n24\t//\n25\t//\t\tgo run ./e2e/streaming-smoke --tui\n26\t//\n27\t//\t   Boots the same Bubble Tea dashboard the real `entire review`\n28\t//\t   multi-agent run uses, with two fake \"agents\" wired through\n29\t//\t   ReviewerTemplate (UsePTY=true). Press Ctrl+O during the run to\n30\t//\t   drill into one agent's event buffer — you should see the buffer\n31\t//\t   grow while the agent is still working.\n32\t//\n33\t// 3) Real review TUI with the bug on (interactive, ~12s):\n34\t//\n35\t//\t\tgo run ./e2e/streaming-smoke --tui-buggy\n36\t//\n37\t//\t   Same as --tui but with UsePTY=false. Use this to A/B against\n38\t//\t   --tui: drill-in stays at \"(0 events)\" until the agent exits.\n39\tpackage main\n40\t\n41\timport (\n42\t\t\"bufio\"\n43\t\t\"context\"\n44\t\t\"flag\"\n45\t\t\"fmt\"\n46\t\t\"io\"\n47\t\t\"os\"\n48\t\t\"os/exec\"\n49\t\t\"strings\"\n50\t\t\"time\"\n51\t\n52\t\t\"github.com/mattn/go-isatty\"\n53\t\n54\t\t\"github.com/entireio/cli/cmd/entire/cli/review\"\n55\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n56\t)\n57\t\n58\tconst probeFlag = \"--probe\"\n59\t\n60\tfunc main() {\n61\t\t// Self-spawn pattern: re-exec the same binary with --probe to act as\n62\t\t// the fake \"buffering agent\". Lets the whole smoke test live in one\n63\t\t// file the user can run with `go run ./e2e/streaming-smoke`.\n64\t\tif len(os.Args) > 1 && os.Args[1] == probeFlag {\n65\t\t\trunProbe(os.Args[2:])\n66\t\t\treturn\n67\t\t}\n68\t\n69\t\tuseTUI := flag.Bool(\"tui\", false, \"boot the real review TUI with UsePTY=true (the fix)\")\n70\t\tuseTUIBuggy := flag.Bool(\"tui-buggy\", false, \"boot the real review TUI with UsePTY=false (the bug)\")\n71\t\tflag.Parse()\n72\t\n73\t\tvar err error\n74\t\tswitch {\n75\t\tcase *useTUI:\n76\t\t\terr = runTUI(true)\n77\t\tcase *useTUIBuggy:\n78\t\t\terr = runTUI(false)\n79\t\tdefault:\n80\t\t\terr = runTimeline()\n81\t\t}\n82\t\tif err != nil {\n83\t\t\tfmt.Fprintln(os.Stderr, \"streaming-smoke:\", err)\n84\t\t\tos.Exit(1)\n85\t\t}\n86\t}\n87\t\n88\t// runProbe is the fake-agent side. When stdout is a pipe (not a TTY)\n89\t// it wraps stdout in a bufio.Writer with a libc-typical 64KB buffer so\n90\t// per-line writes accumulate until exit — the same pattern that causes\n91\t// real agents to \"burst at the end\". When stdout IS a TTY it writes\n92\t// directly so the natural per-line flushing happens.\n93\t//\n94\t// Args (parsed from the probe sub-command's argv):\n95\t//\n96\t//\t--lines N    how many lines to emit (default 5)\n97\t//\t--delay D    sleep between lines (default 150ms)\n98\t//\t--label S    prefix for each line so two probes are distinguishable\n99\tfunc runProbe(args []string) {\n100\t\tfs := flag.NewFlagSet(\"probe\", flag.ExitOnError)\n101\t\tlines := fs.Int(\"lines\", 5, \"number of lines\")\n102\t\tdelay := fs.Duration(\"delay\", 150*time.Millisecond, \"sleep between lines\")\n103\t\tlabel := fs.String(\"label\", \"probe\", \"per-line label\")\n104\t\t_ = fs.Parse(args)\n105\t\n106\t\tif isatty.IsTerminal(os.Stdout.Fd()) {\n107\t\t\tfor i := 1; i <= *lines; i++ {\n108\t\t\t\tfmt.Fprintf(os.Stdout, \"%s line %d/%d\\n\", *label, i, *lines)\n109\t\t\t\ttime.Sleep(*delay)\n110\t\t\t}\n111\t\t\treturn\n112\t\t}\n113\t\n114\t\t// Pipe path: simulate libc/Rust/Node block buffering. All lines stay\n115\t\t// in the buffer until Flush() at exit — even though the loop sleeps\n116\t\t// between writes, the runner sees them as one burst.\n117\t\tw := bufio.NewWriterSize(os.Stdout, 64*1024)\n118\t\tfor i := 1; i <= *lines; i++ {\n119\t\t\tfmt.Fprintf(w, \"%s line %d/%d\\n\", *label, i, *lines)\n120\t\t\ttime.Sleep(*delay)\n121\t\t}\n122\t\t_ = w.Flush()\n123\t}\n124\t\n125\t// runTimeline spawns the probe twice — once without PTY (bug), once with\n126\t// PTY (fix) — and prints per-event timing for each pass.\n127\tfunc runTimeline() error {\n128\t\tself, err := os.Executable()\n129\t\tif err != nil {\n130\t\t\treturn fmt.Errorf(\"locate self: %w\", err)\n131\t\t}\n132\t\n133\t\tfmt.Println(\"streaming-smoke: spawning probe twice to compare buffering behaviour.\")\n134\t\tfmt.Println(\"look for events clustered at end (Pass 1) vs staggered (Pass 2).\")\n135\t\tfmt.Println()\n136\t\n137\t\tif err := timelinePass(\"Pass 1: UsePTY=false (simulates the bug)\", self, false); err != nil {\n138\t\t\treturn err\n139\t\t}\n140\t\tfmt.Println()\n141\t\tif err := timelinePass(\"Pass 2: UsePTY=true (the fix)\", self, true); err != nil {\n142\t\t\treturn err\n143\t\t}\n144\t\tfmt.Println()\n145\t\tfmt.Println(\"for an interactive demo: `go run ./e2e/streaming-smoke --tui`\")\n146\t\treturn nil\n147\t}\n148\t\n149\tfunc timelinePass(label, selfPath string, usePTY bool) error {\n150\t\ttmpl := buildProbeReviewer(\"smoke-probe\", selfPath, []string{\"--lines\", \"5\"}, usePTY)\n151\t\tstarted := time.Now()\n152\t\tproc, err := tmpl.Start(context.Background(), reviewtypes.RunConfig{})\n153\t\tif err != nil {\n154\t\t\treturn fmt.Errorf(\"%s: start: %w\", label, err)\n155\t\t}\n156\t\n157\t\tfmt.Printf(\"=== %s ===\\n\", label)\n158\t\tfor ev := range proc.Events() {\n159\t\t\tprintEvent(time.Since(started), ev)\n160\t\t}\n161\t\tif err := proc.Wait(); err != nil {\n162\t\t\treturn fmt.Errorf(\"%s: wait: %w\", label, err)\n163\t\t}\n164\t\treturn nil\n165\t}\n166\t\n167\t// runTUI boots the real review Bubble Tea dashboard with two fake probes\n168\t// so the user can press Ctrl+O during the run and see drill-in streaming\n169\t// (when usePTY=true) or batched-at-EOF behaviour (when usePTY=false).\n170\tfunc runTUI(usePTY bool) error {\n171\t\tself, err := os.Executable()\n172\t\tif err != nil {\n173\t\t\treturn fmt.Errorf(\"locate self: %w\", err)\n174\t\t}\n175\t\tif !isatty.IsTerminal(os.Stdout.Fd()) {\n176\t\t\treturn errors.New(\"--tui requires a real terminal; rerun without --tui for a non-interactive demo\")\n177\t\t}\n178\t\n179\t\t// Two probes with different cadence so the dashboard rows visibly\n180\t\t// diverge. ~12s total — long enough to comfortably hit Ctrl+O,\n181\t\t// switch agents, and watch the buffer grow before the run ends.\n182\t\treviewers := []reviewtypes.AgentReviewer{\n183\t\t\tbuildProbeReviewer(\"fast-probe\", self, []string{\"--lines\", \"20\", \"--delay\", \"300ms\", \"--label\", \"fast\"}, usePTY),\n184\t\t\tbuildProbeReviewer(\"slow-probe\", self, []string{\"--lines\", \"12\", \"--delay\", \"1s\", \"--label\", \"slow\"}, usePTY),\n185\t\t}\n186\t\n187\t\tmode := \"UsePTY=true (the fix)\"\n188\t\tif !usePTY {\n189\t\t\tmode = \"UsePTY=false (the bug)\"\n190\t\t}\n191\t\tfmt.Printf(\"streaming-smoke TUI demo (%s)\\n\", mode)\n192\t\tfmt.Println(\"press Ct