\\n'; printf 'c\\\\n'\")\n\t\t},\n\t\tParser: lineParser,\n\t\tUsePTY: true,\n\t}\n\n\tproc, err := tmpl.Start(context.Background(), RunConfig{})\n\tif err != nil {\n\t\tt.Fatalf(\"Start() error: %v\", err)\n\t}\n\n\tvar got []Event\n\ttimeout := time.After(5 * time.Second)\n\tfor {\n\t\tselect {\n\t\tcase ev, ok := <-proc.Events():\n\t\t\tif !ok {\n\t\t\t\tgoto done\n\t\t\t}\n\t\t\tgot = append(got, ev)\n\t\tcase <-timeout:\n\t\t\tt.Fatalf(\"timed out collecting events (got %d so far)\", len(got))\n\t\t}\n\t}\ndone:\n\tif err := proc.Wait(); err != nil {\n\t\tt.Fatalf(\"Wait() error: %v\", err)\n\t}\n\n\t// Expect: Started, AssistantText{a}, AssistantText{b}, AssistantText{c}, Finished{true}.\n\tif len(got) != 5 {\n\t\tt.Fatalf(\"got %d events, want 5: %v\", len(got), got)\n\t}\n\tif _, ok := got[0].(Started); !ok {\n\t\tt.Errorf(\"events[0] = %T, want Started\", got[0])\n\t}\n\tfor i, want := range []string{\"a\", \"b\", \"c\"} {\n\t\tat, ok := got[i+1].(AssistantText)\n\t\tif !ok {\n\t\t\tt.Errorf(\"events[%d] = %T, want AssistantText\", i+1, got[i+1])\n\t\t\tcontinue\n\t\t}\n\t\tif at.Text != want {\n\t\t\tt.Errorf(\"events[%d].Text = %q, want %q\", i+1, at.Text, want)\n\t\t}\n\t}\n\tfin, ok := got[4].(Finished)\n\tif !ok {\n\t\tt.Fatalf(\"events[4] = %T, want Finished\", got[4])\n\t}\n\tif !fin.Success {\n\t\tt.Error(\"Finished.Success = false, want true\")\n\t}\n}\n\n// TestReviewerTemplate_UsePTYAppendsNoDecorationEnv pins that PTY mode\n// sets NO_COLOR/FORCE_COLOR/TERM=dumb on the child env to suppress\n// terminal decoration the agent might emit now that isatty(stdout) is true.\n// The test sniffs the child's env via /usr/bin/env to avoid relying on\n// shell built-in behaviour.\nfunc TestReviewerTemplate_UsePTYAppendsNoDecorationEnv(t *testing.T) {\n\tskipOnWindows(t, \"PTY unsupported on Windows\")\n\tt.Parallel()\n\n\tlineParser := func(r io.Reader) <-chan Event {\n\t\tch := make(chan Event, 16)\n\t\tgo func() {\n\t\t\tdefer close(ch)\n\t\t\tch <- Start