"look for events clustered at end (Pass 1) vs staggered (Pass 2).\")\n\tfmt.Println()\n\n\tif err := timelinePass(\"Pass 1: UsePTY=false (simulates the bug)\", self, false); err != nil {\n\t\treturn err\n\t}\n\tfmt.Println()\n\tif err := timelinePass(\"Pass 2: UsePTY=true (the fix)\", self, true); err != nil {\n\t\treturn err\n\t}\n\tfmt.Println()\n\tfmt.Println(\"for an interactive demo: `go run ./e2e/streaming-smoke --tui`\")\n\treturn nil\n}\n\nfunc timelinePass(label, selfPath string, usePTY bool) error {\n\ttmpl := buildProbeReviewer(\"smoke-probe\", selfPath, []string{\"--lines\", \"5\"}, usePTY)\n\tstarted := time.Now()\n\tproc, err := tmpl.Start(context.Background(), reviewtypes.RunConfig{})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"%s: start: %w\", label, err)\n\t}\n\n\tfmt.Printf(\"=== %s ===\\n\", label)\n\tfor ev := range proc.Events() {\n\t\tprintEvent(time.Since(started), ev)\n\t}\n\tif err := proc.Wait(); err != nil {\n\t\treturn fmt.Errorf(\"%s: wait: %w\", label, err)\n\t}\n\treturn nil\n}\n\n// runTUI boots the real review Bubble Tea dashboard with two fake probes\n// so the user can press Ctrl+O during the run and see drill-in streaming\n// (when usePTY=true) or batched-at-EOF behaviour (when usePTY=false).\nfunc runTUI(usePTY bool) error {\n\tself, err := os.Executable()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"locate self: %w\", err)\n\t}\n\tif !isatty.IsTerminal(os.Stdout.Fd()) {\n\t\treturn errors.New(\"--tui requires a real terminal; rerun without --tui for a non-interactive demo\")\n\t}\n\n\t// Two probes with different cadence so the dashboard rows visibly\n\t// diverge. ~12s total — long enough to comfortably hit Ctrl+O,\n\t// switch agents, and watch the buffer grow before the run ends.\n\treviewers := []reviewtypes.AgentReviewer{\n\t\tbuildProbeReviewer(\"fast-probe\", self, []string{\"--lines\", \"20\", \"--delay\", \"300ms\", \"--label\", \"fast\"}, usePTY),\n\t\tbuildProbeReviewer(\"slow-probe\", self, []string{\"--lines\", \"12\", \"--delay\", \"1s\", \"--label\", \"slow\"}, usePTY),\n\t}\n\n\tmode := \"UsePTY=true (the fix)\"\n\tif !usePTY {\n\t\tmode = \"UsePTY=false (the bug)\"\n\t}\n\tfmt.Printf(\"streaming-smoke TUI demo (%s)\\n\", mode)\n\tfmt.Println(\"press Ctrl+O during the run to drill into an agent's event buffer.\")\n\tfmt.Println(\"press Ctrl+C to cancel. press any key to dismiss after both finish.\")\n\tfmt.Println()\n\ttime.Sleep(800 * time.Millisecond) // let the user read before the TUI takes over\n\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\n\tagentNames := []string{reviewers[0].Name(), reviewers[1].Name()}\n\ttui := review.NewTUISink(agentNames, cancel, os.Stdout, os.Stdin)\n\ttui.Start()\n\n\tsinks := []reviewtypes.Sink{tui}\n\tif _, err := review.RunMulti(ctx, reviewers, reviewtypes.RunConfig{}, sinks); err != nil {\n\t\t// Non-fatal: a probe exit error shouldn't drown the demo's main point.\n\t\tfmt.Fprintln(os.Stderr, \"streaming-smoke: RunMulti returned:\", err)\n\t}\n\treturn nil\n}\n\nfunc buildProbeReviewer(name, selfPath string, probeArgs []string, usePTY bool) *reviewtypes.ReviewerTemplate {\n\treturn &reviewtypes.ReviewerTemplate{\n\t\tAgentName: name,\n\t\tBuildCmd: func(ctx context.Context, _ reviewtypes.RunConfig) *exec.Cmd {\n\t\t\targs := append([]string{probeFlag}, probeArgs...)\n\t\t\treturn exec.CommandContext(ctx, selfPath, args...)\n\t\t},\n\t\tParser: lineParser,\n\t\tUsePTY: usePTY,\n\t}\n}\n\nfunc printEvent(elapsed time.Duration, ev reviewtypes.Event) {\n\tprefix := fmt.Sprintf(\"  + %4dms  \", elapsed.Milliseconds())\n\tswitch e := ev.(type) {\n\tcase reviewtypes.AssistantText:\n\t\tfmt.Printf(\"%sAssistantText  %q\\n\", prefix, e.Text)\n\tcase reviewtypes.Started:\n\t\tfmt.Printf(\"%sStarted{}\\n\", prefix)\n\tcase reviewtypes.Finished:\n\t\tfmt.Printf(\"%sFinished{Success:%v}\\n\", prefix, e.Success)\n\tdefault:\n\t\tfmt.Printf(\"%s%T\\n\", prefix, ev)\n\t}\n}\n\nfunc lineParser(r io.Reader) <-chan reviewtypes.Event {\n\tch := make(chan reviewtypes.Event, 16)\n\tgo func() {\n\t\tdefer close(ch)\n\t\tch <- reviewtypes.Started{}\n\t\ts := bufio.NewScanner(r)\n\t\tfor s.Scan() {\n\t\t\tline := strings.TrimRight(s.Text(), \"\\r\")\n\t\t\tif line == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tch <- reviewtypes.AssistantText{Text: line}\n\t\t}\n\t\tif err := s.Err(); err != nil {\n\t\t\tch <- reviewtypes.RunError{Err: err}\n\t\t\tch <- reviewtypes.Finished{Success: false}\n\t\t\treturn\n\t\t}\n\t\tch <- reviewtypes.Finished{Success: true}\n\t}()\n\treturn ch\n}\n","structuredPatch":[{"oldStart":41,"oldLines":6,"newStart":41,"newLines":7,"lines":[" import (","   \"bufio\"","   \"context\"","+  \"errors\"","   \"flag\"","   \"fmt\"","   \"io\""]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"f1546d5b-922c-46dd-8a1c-716c40272dfc","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream","sessionId":"29e905db-df81-4eac-9e54-265c4e180a9c","version":"2.1.139","gitBranch":"review-fix-progress-stream"}
