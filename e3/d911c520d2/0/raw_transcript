{"parentUuid":"ec5a4e9a-c792-4d52-8932-bad6da3d091b","isSidechain":false,"promptId":"b5e59c4e-e426-4c46-a27b-ce6dfc92fdb0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZJ44WCNYuE2bAsiytUa9h","type":"tool_result","content":"1\t// Package types — see reviewer.go for package-level rationale.\n2\t//\n3\t// template.go provides ReviewerTemplate, a struct that implements\n4\t// AgentReviewer using two caller-supplied functions: BuildCmd (per-agent\n5\t// argv/env construction) and Parser (per-agent stdout-to-Event stream).\n6\t//\n7\t// All three currently-supported agents (claude-code, codex, gemini-cli)\n8\t// share the Start/Process/Wait/Events scaffolding. Only the build-cmd\n9\t// step and the stdout parser genuinely differ. The template owns the\n10\t// shared lifecycle (spawn → pipe stdout → run parser → forward events\n11\t// → close on exit); each agent supplies the two unique pieces.\n12\tpackage types\n13\t\n14\timport (\n15\t\t\"context\"\n16\t\t\"errors\"\n17\t\t\"fmt\"\n18\t\t\"io\"\n19\t\t\"os\"\n20\t\t\"os/exec\"\n21\t\t\"strings\"\n22\t\t\"syscall\"\n23\t\n24\t\t\"github.com/creack/pty\"\n25\t)\n26\t\n27\tconst maxProcessStderrBytes = 64 * 1024\n28\t\n29\t// ReviewerTemplate implements AgentReviewer for agents whose only per-agent\n30\t// quirks are argv/env construction and stdout parsing. Both fields must be\n31\t// set before Start is called; nil values cause Start to panic immediately.\n32\ttype ReviewerTemplate struct {\n33\t\t// AgentName is returned by Name(). Stable identifier per agent.\n34\t\tAgentName string\n35\t\n36\t\t// BuildCmd constructs the *exec.Cmd to spawn the agent process,\n37\t\t// including argv, stdin (if any), and ENTIRE_REVIEW_* env vars.\n38\t\t// The command MUST NOT have started yet; the template will call Start.\n39\t\tBuildCmd func(ctx context.Context, cfg RunConfig) *exec.Cmd\n40\t\n41\t\t// Parser converts the agent's stdout stream into a sequence of Events.\n42\t\t// The returned channel must close when stdout closes. Implementations\n43\t\t// must emit Started first, Finished{Success: ...} or RunError last,\n44\t\t// and check scanner.Err() before emitting Finished{Success: true}.\n45\t\tParser func(stdout io.Reader) <-chan Event\n46\t\n47\t\t// UsePTY routes the agent's stdout through a pseudo-terminal so the\n48\t\t// child's isatty(STDOUT_FILENO) check returns true. Most CLI tools\n49\t\t// (libc, Rust, Node) default to block-buffered stdout when not a TTY,\n50\t\t// which makes their output arrive in one burst at end-of-run instead\n51\t\t// of streaming as the agent works. PTY mode restores line-buffered\n52\t\t// flushing so live progress reaches our parser.\n53\t\t//\n54\t\t// Stderr remains on a separate pipe regardless, so the bounded-stderr\n55\t\t// diagnostics in Wait() still work. On platforms where pty.Open returns\n56\t\t// ErrUnsupported (Windows), Start falls back to the regular stdout pipe\n57\t\t// rather than failing — the streaming benefit is lost but the run\n58\t\t// completes normally.\n59\t\tUsePTY bool\n60\t}\n61\t\n62\t// Compile-time check.\n63\tvar _ AgentReviewer = (*ReviewerTemplate)(nil)\n64\t\n65\t// Name returns the agent's stable identifier.\n66\tfunc (t *ReviewerTemplate) Name() string { return t.AgentName }\n67\t\n68\t// Start spawns the agent process, wires stdout through the parser, and\n69\t// returns a Process whose Events channel streams the parsed event sequence.\n70\t//\n71\t// Returns ErrTemplateMisconfigured if AgentName, BuildCmd, or Parser is unset,\n72\t// or if BuildCmd returns nil. These are programmer errors but failing fast\n73\t// with a typed error is friendlier than a downstream nil deref — and it\n74\t// keeps Start from panicking inside a multi-agent fan-out (CU8) where one\n75\t// misconfigured template would otherwise kill the whole run.\n76\tfunc (t *ReviewerTemplate) Start(ctx context.Context, cfg RunConfig) (Process, error) {\n77\t\tif t.AgentName == \"\" {\n78\t\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (empty AgentName)\", ErrTemplateMisconfigured)\n79\t\t}\n80\t\tif t.BuildCmd == nil {\n81\t\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (nil BuildCmd for agent %q)\", ErrTemplateMisconfigured, t.AgentName)\n82\t\t}\n83\t\tif t.Parser == nil {\n84\t\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (nil Parser for agent %q)\", ErrTemplateMisconfigured, t.AgentName)\n85\t\t}\n86\t\tcmd := t.BuildCmd(ctx, cfg)\n87\t\tif cmd == nil {\n88\t\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (BuildCmd returned nil for agent %q)\", ErrTemplateMisconfigured, t.AgentName)\n89\t\t}\n90\t\tstdout, ptmx, ttySlave, err := t.openStdout(cmd)\n91\t\tif err != nil {\n92\t\t\treturn nil, fmt.Errorf(\"%s: stdout: %w\", t.AgentName, err)\n93\t\t}\n94\t\tstderr, err := cmd.StderrPipe()\n95\t\tif err != nil {\n96\t\t\tclosePTY(ptmx, ttySlave)\n97\t\t\treturn nil, fmt.Errorf(\"%s: stderr pipe: %w\", t.AgentName, err)\n98\t\t}\n99\t\tif err := cmd.Start(); err != nil {\n100\t\t\tclosePTY(ptmx, ttySlave)\n101\t\t\treturn nil, fmt.Errorf(\"%s: start: %w\", t.AgentName, err)\n102\t\t}\n103\t\t// In PTY mode the parent's copy of the slave fd is no longer needed —\n104\t\t// the child has already dup'd it during fork/exec, so closing here lets\n105\t\t// the master see EOF/EIO when the child eventually closes its side.\n106\t\tif ttySlave != nil {\n107\t\t\t_ = ttySlave.Close()\n108\t\t}\n109\t\tp := &templateProcess{\n110\t\t\tctx:        ctx,\n111\t\t\tagentName:  t.AgentName,\n112\t\t\tcmd:        cmd,\n113\t\t\tevents:     make(chan Event, 32),\n114\t\t\tstderr:     &boundedStderrBuffer{limit: maxProcessStderrBytes},\n115\t\t\tstderrDone: make(chan struct{}),\n116\t\t\tptmx:       ptmx,\n117\t\t}\n118\t\tgo p.run(stdout, t.Parser)\n119\t\tgo p.captureStderr(stderr)\n120\t\treturn p, nil\n121\t}\n122\t\n123\t// openStdout returns the reader the parser will consume, plus the PTY master\n124\t// and slave handles when PTY mode is active (nil otherwise). On platforms\n125\t// where pty.Open returns ErrUnsupported (e.g., Windows), it transparently\n126\t// falls back to cmd.StdoutPipe so the run still completes — just without\n127\t// live streaming.\n128\tfunc (t *ReviewerTemplate) openStdout(cmd *exec.Cmd) (io.Reader, *os.File, *os.File, error) {\n129\t\tif !t.UsePTY {\n130\t\t\tstdout, err := cmd.StdoutPipe()\n131\t\t\tif err != nil {\n132\t\t\t\treturn nil, nil, nil, fmt.Errorf(\"pipe: %w\", err)\n133\t\t\t}\n134\t\t\treturn stdout, nil, nil, nil\n135\t\t}\n136\t\tptmx, tty, err := pty.Open()\n137\t\tif err != nil {\n138\t\t\tif errors.Is(err, pty.ErrUnsupported) {\n139\t\t\t\tstdout, pipeErr := cmd.StdoutPipe()\n140\t\t\t\tif pipeErr != nil {\n141\t\t\t\t\treturn nil, nil, nil, fmt.Errorf(\"pipe (pty unsupported): %w\", pipeErr)\n142\t\t\t\t}\n143\t\t\t\treturn stdout, nil, nil, nil\n144\t\t\t}\n145\t\t\treturn nil, nil, nil, fmt.Errorf(\"open pty: %w\", err)\n146\t\t}\n147\t\t// A reasonable winsize keeps width-aware tools from wrapping at 80 cols.\n148\t\t_ = pty.Setsize(ptmx, &pty.Winsize{Rows: 50, Cols: 200}) //nolint:errcheck // best-effort sizing; failure does not affect streaming\n149\t\tcmd.Stdout = tty\n150\t\t// Suppress decoration the agent might now produce because isatty(stdout)\n151\t\t// is true: colour codes, spinners, in-place updates. The parsers already\n152\t\t// strip ANSI in some cases (codex) but defending up-front keeps every\n153\t\t// agent's event stream clean.\n154\t\tcmd.Env = appendNoDecorationEnv(cmd.Env)\n155\t\treturn &ptyReader{r: ptmx}, ptmx, tty, nil\n156\t}\n157\t\n158\tfunc closePTY(ptmx, tty *os.File) {\n159\t\tif tty != nil {\n160\t\t\t_ = tty.Close()\n161\t\t}\n162\t\tif ptmx != nil {\n163\t\t\t_ = ptmx.Close()\n164\t\t}\n165\t}\n166\t\n167\t// appendNoDecorationEnv adds env vars that tell the agent not to emit\n168\t// terminal decoration even though it now thinks stdout is a TTY.\n169\t// Values already set on the parent env are preserved — we only append\n170\t// the keys when missing.\n171\tfunc appendNoDecorationEnv(env []string) []string {\n172\t\twant := map[string]string{\n173\t\t\t\"NO_COLOR\":    \"1\",\n174\t\t\t\"FORCE_COLOR\": \"0\",\n175\t\t\t\"TERM\":        \"dumb\",\n176\t\t}\n177\t\tfor _, e := range env {\n178\t\t\tidx := strings.IndexByte(e, '=')\n179\t\t\tif idx < 0 {\n180\t\t\t\tcontinue\n181\t\t\t}\n182\t\t\tdelete(want, e[:idx])\n183\t\t}\n184\t\tfor k, v := range want {\n185\t\t\tenv = append(env, k+\"=\"+v)\n186\t\t}\n187\t\treturn env\n188\t}\n189\t\n190\t// ptyReader translates the Linux ptmx behaviour of returning EIO when the\n191\t// child closes its slave side into a normal EOF. macOS already reports EOF\n192\t// in that situation; the wrapper makes both platforms look the same to the\n193\t// parser's bufio.Scanner.\n194\ttype ptyReader struct {\n195\t\tr io.Reader\n196\t}\n197\t\n198\tfunc (p *ptyReader) Read(b []byte) (int, error) {\n199\t\tn, err := p.r.Read(b)\n200\t\tif err != nil && isEIO(err) {\n201\t\t\treturn n, io.EOF\n202\t\t}\n203\t\treturn n, err //nolint:wrapcheck // passthrough preserves Reader contract\n204\t}\n205\t\n206\tfunc isEIO(err error) bool {\n207\t\tif errors.Is(err, syscall.EIO) {\n208\t\t\treturn true\n209\t\t}\n210\t\tvar pathErr *os.PathError\n211\t\tif errors.As(err, &pathErr) {\n212\t\t\treturn errors.Is(pathErr.Err, syscall.EIO)\n213\t\t}\n214\t\treturn false\n215\t}\n216\t\n217\t// ErrTemplateMisconfigured is returned by ReviewerTemplate.Start when one of\n218\t// the required fields (AgentName, BuildCmd, Parser) is unset, or when\n219\t// BuildCmd returns nil. Use errors.Is to detect this in tests or higher\n220\t// layers (e.g., a multi-agent orchestrator that needs to skip a misconfigured\n221\t// agent rather than crashing the whole run).\n222\tvar ErrTemplateMisconfigured = errors.New(\"ReviewerTemplate misconfigured\")\n223\t\n224\t// templateProcess is the shared Process implementation for ReviewerTemplate.\n225\ttype templateProcess struct {\n226\t\tctx        context.Context\n227\t\tagentName  string\n228\t\tcmd        *exec.Cmd\n229\t\tevents     chan Event\n230\t\tstderr     *boundedStderrBuffer\n231\t\tstderrDone chan struct{}\n232\t\t// ptmx is the PTY master when UsePTY=true, nil otherwise. The parser\n233\t\t// goroutine in run() closes it once the parser's event channel drains —\n234\t\t// closing earlier would interrupt streaming, closing later would leak\n235\t\t// the fd if the consumer ignores Wait.\n236\t\tptmx *os.File\n237\t}\n238\t\n239\t// Events returns the channel that streams parsed events from the agent process.\n240\tfunc (p *templateProcess) Events() <-chan Event { return p.events }\n241\t\n242\t// Wait returns the agent process's exit error with bounded stderr diagnostics.\n243\t//\n244\t// Per CU2's Process contract: nil on clean exit (exit code 0); ctx.Err()\n245\t// on cancellation; ProcessError wrapping *exec.ExitError on non-zero exit\n246\t// with stderr; other types for I/O or pipe failures. ProcessError implements\n247\t// Unwrap so callers can use errors.As and errors.Is to classify.\n248\tfunc (p *templateProcess) Wait() error {\n249\t\tif p.stderrDone != nil {\n250\t\t\t<-p.stderrDone\n251\t\t}\n252\t\terr := p.cmd.Wait()\n253\t\tif err != nil && p.ctx.Err() != nil {\n254\t\t\treturn p.ctx.Err() //nolint:wrapcheck // preserve Process cancellation contract\n255\t\t}\n256\t\tif err != nil {\n257\t\t\tif stderr := p.stderr.String(); stderr != \"\" {\n258\t\t\t\treturn &ProcessError{AgentName: p.agentName, Err: err, Stderr: stderr}\n259\t\t\t}\n260\t\t}\n261\t\treturn err //nolint:wrapcheck // interface boundary; classifyStatus needs raw type\n262\t}\n263\t\n264\tfunc (p *templateProcess) run(stdout io.Reader, parser func(io.Reader) <-chan Event) {\n265\t\tdefer close(p.events)\n266\t\tif p.ptmx != nil {\n267\t\t\tdefer func() { _ = p.ptmx.Close() }()\n268\t\t}\n269\t\tfor ev := range parser(stdout) {\n270\t\t\tp.events <- ev\n271\t\t}\n272\t}\n273\t\n274\tfunc (p *templateProcess) captureStderr(stderr io.Reader) {\n275\t\tdefer close(p.stderrDone)\n276\t\t_, _ = io.Copy(p.stderr, stderr) //nolint:errcheck // stderr is best-effort diagnostic context\n277\t}\n278\t\n279\t// ProcessError wraps a process failure with bounded stderr diagnostics.\n280\t// Unwrap preserves the underlying error, so callers can still use errors.As\n281\t// for *exec.ExitError or errors.Is for lower-level sentinels.\n282\ttype ProcessError struct {\n283\t\tAgentName string\n284\t\tErr       error\n285\t\tStderr    string\n286\t}\n287\t\n288\tfunc (e *ProcessError) Error() string {\n289\t\tif e.Stderr == \"\" {\n290\t\t\treturn fmt.Sprintf(\"%s: %v\", e.AgentName, e.Err)\n291\t\t}\n292\t\treturn fmt.Sprintf(\"%s: %v: stderr: %s\", e.AgentName, e.Err, e.Stderr)\n293\t}\n294\t\n295\tfunc (e *ProcessError) Unwrap() error { return e.Err }\n296\t\n297\ttype boundedStderrBuffer struct {\n298\t\tlimit     int\n299\t\tbuf       []byte\n300\t\ttruncated bool\n301\t}\n302\t\n303\tfunc (b *boundedStderrBuffer) Write(p []byte) (int, error) {\n304\t\tif b.limit <= 0 {\n305\t\t\tb.truncated = true\n306\t\t\treturn len(p), nil\n307\t\t}\n308\t\tremaining := b.limit - len(b.buf)\n309\t\tif remaining > 0 {\n310\t\t\tif len(p) <= remaining {\n311\t\t\t\tb.buf = append(b.buf, p...)\n312\t\t\t} else {\n313\t\t\t\tb.buf = append(b.buf, p[:remaining]...)\n314\t\t\t\tb.truncated = true\n315\t\t\t}\n316\t\t} else if len(p) > 0 {\n317\t\t\tb.truncated = true\n318\t\t}\n319\t\treturn len(p), nil\n320\t}\n321\t\n322\tfunc (b *boundedStderrBuffer) String() string {\n323\t\tout := strings.TrimSpace(string(b.buf))\n324\t\tif out == \"\" {\n325\t\t\treturn \"\"\n326\t\t}\n327\t\tif b.truncated {\n328\t\t\treturn out + \"\\n[stderr truncated]\"\n329\t\t}\n330\t\treturn out\n331\t}\n332\t"}]},"uuid":"f32ab08d-22f9-44ec-b50e-29514042535a","timestamp":"2026-05-12T03:21:33.227Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream/cmd/entire/cli/review/types/template.go","content":"// Package types — see reviewer.go for package-level rationale.\n//\n// template.go provides ReviewerTemplate, a struct that implements\n// AgentReviewer using two caller-supplied functions: BuildCmd (per-agent\n// argv/env construction) and Parser (per-agent stdout-to-Event stream).\n//\n// All three currently-supported agents (claude-code, codex, gemini-cli)\n// share the Start/Process/Wait/Events scaffolding. Only the build-cmd\n// step and the stdout parser genuinely differ. The template owns the\n// shared lifecycle (spawn → pipe stdout → run parser → forward events\n// → close on exit); each agent supplies the two unique pieces.\npackage types\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/creack/pty\"\n)\n\nconst maxProcessStderrBytes = 64 * 1024\n\n// ReviewerTemplate implements AgentReviewer for agents whose only per-agent\n// quirks are argv/env construction and stdout parsing. Both fields must be\n// set before Start is called; nil values cause Start to panic immediately.\ntype ReviewerTemplate struct {\n\t// AgentName is returned by Name(). Stable identifier per agent.\n\tAgentName string\n\n\t// BuildCmd constructs the *exec.Cmd to spawn the agent process,\n\t// including argv, stdin (if any), and ENTIRE_REVIEW_* env vars.\n\t// The command MUST NOT have started yet; the template will call Start.\n\tBuildCmd func(ctx context.Context, cfg RunConfig) *exec.Cmd\n\n\t// Parser converts the agent's stdout stream into a sequence of Events.\n\t// The returned channel must close when stdout closes. Implementations\n\t// must emit Started first, Finished{Success: ...} or RunError last,\n\t// and check scanner.Err() before emitting Finished{Success: true}.\n\tParser func(stdout io.Reader) <-chan Event\n\n\t// UsePTY routes the agent's stdout through a pseudo-terminal so the\n\t// child's isatty(STDOUT_FILENO) check returns true. Most CLI tools\n\t// (libc, Rust, Node) default to block-buffered stdout when not a TTY,\n\t// which makes their output arrive in one burst at end-of-run instead\n\t// of streaming as the agent works. PTY mode restores line-buffered\n\t// flushing so live progress reaches our parser.\n\t//\n\t// Stderr remains on a separate pipe regardless, so the bounded-stderr\n\t// diagnostics in Wait() still work. On platforms where pty.Open returns\n\t// ErrUnsupported (Windows), Start falls back to the regular stdout pipe\n\t// rather than failing — the streaming benefit is lost but the run\n\t// completes normally.\n\tUsePTY bool\n}\n\n// Compile-time check.\nvar _ AgentReviewer = (*ReviewerTemplate)(nil)\n\n// Name returns the agent's stable identifier.\nfunc (t *ReviewerTemplate) Name() string { return t.AgentName }\n\n// Start spawns the agent process, wires stdout through the parser, and\n// returns a Process whose Events channel streams the parsed event sequence.\n//\n// Returns ErrTemplateMisconfigured if AgentName, BuildCmd, or Parser is unset,\n// or if BuildCmd returns nil. These are programmer errors but failing fast\n// with a typed error is friendlier than a downstream nil deref — and it\n// keeps Start from panicking inside a multi-agent fan-out (CU8) where one\n// misconfigured template would otherwise kill the whole run.\nfunc (t *ReviewerTemplate) Start(ctx context.Context, cfg RunConfig) (Process, error) {\n\tif t.AgentName == \"\" {\n\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (empty AgentName)\", ErrTemplateMisconfigured)\n\t}\n\tif t.BuildCmd == nil {\n\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (nil BuildCmd for agent %q)\", ErrTemplateMisconfigured, t.AgentName)\n\t}\n\tif t.Parser == nil {\n\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (nil Parser for agent %q)\", ErrTemplateMisconfigured, t.AgentName)\n\t}\n\tcmd := t.BuildCmd(ctx, cfg)\n\tif cmd == nil {\n\t\treturn nil, fmt.Errorf(\"ReviewerTemplate.Start: %w (BuildCmd returned nil for agent %q)\", ErrTemplateMisconfigured, t.AgentName)\n\t}\n\tstdout, ptmx, ttySlave, err := t.openStdout(cmd)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"%s: stdout: %w\", t.AgentName, err)\n\t}\n\tstderr, err := cmd.StderrPipe()\n\tif err != nil {\n\t\tclosePTY(ptmx, ttySlave)\n\t\treturn nil, fmt.Errorf(\"%s: stderr pipe: %w\", t.AgentName, err)\n\t}\n\tif err := cmd.Start(); err != nil {\n\t\tclosePTY(ptmx, ttySlave)\n\t\treturn nil, fmt.Errorf(\"%s: start: %w\", t.AgentName, err)\n\t}\n\t// In PTY mode the parent's copy of the slave fd is no longer needed —\n\t// the child has already dup'd it during fork/exec, so closing here lets\n\t// the master see EOF/EIO when the child eventually closes its side.\n\tif ttySlave != nil {\n\t\t_ = ttySlave.Close()\n\t}\n\tp := &templateProcess{\n\t\tctx:        ctx,\n\t\tagentName:  t.AgentName,\n\t\tcmd:        cmd,\n\t\tevents:     make(chan Event, 32),\n\t\tstderr:     &boundedStderrBuffer{limit: maxProcessStderrBytes},\n\t\tstderrDone: make(chan struct{}),\n\t\tptmx:       ptmx,\n\t}\n\tgo p.run(stdout, t.Parser)\n\tgo p.captureStderr(stderr)\n\treturn p, nil\n}\n\n// openStdout returns the reader the parser will consume, plus the PTY master\n// and slave handles when PTY mode is active (nil otherwise). On platforms\n// where pty.Open returns ErrUnsupported (e.g., Windows), it transparently\n// falls back to cmd.StdoutPipe so the run still completes — just without\n// live streaming.\nfunc (t *ReviewerTemplate) openStdout(cmd *exec.Cmd) (io.Reader, *os.File, *os.File, error) {\n\tif !t.UsePTY {\n\t\tstdout, err := cmd.StdoutPipe()\n\t\tif err != nil {\n\t\t\treturn nil, nil, nil, fmt.Errorf(\"pipe: %w\", err)\n\t\t}\n\t\treturn stdout, nil, nil, nil\n\t}\n\tptmx, tty, err := pty.Open()\n\tif err != nil {\n\t\tif errors.Is(err, pty.ErrUnsupported) {\n\t\t\tstdout, pipeErr := cmd.StdoutPipe()\n\t\t\tif pipeErr != nil {\n\t\t\t\treturn nil, nil, nil, fmt.Errorf(\"pipe (pty unsupported): %w\", pipeErr)\n\t\t\t}\n\t\t\treturn stdout, nil, nil, nil\n\t\t}\n\t\treturn nil, nil, nil, fmt.Errorf(\"open pty: %w\", err)\n\t}\n\t// A reasonable winsize keeps width-aware tools from wrapping at 80 cols.\n\t_ = pty.Setsize(ptmx, &pty.Winsize{Rows: 50, Cols: 200}) //nolint:errcheck // best-effort sizing; failure does not affect streaming\n\tcmd.Stdout = tty\n\t// Suppress decoration the agent might now produce because isatty(stdout)\n\t// is true: colour codes, spinners, in-place updates. The parsers already\n\t// strip ANSI in some cases (codex) but defending up-front keeps every\n\t// agent's event stream clean.\n\tcmd.Env = appendNoDecorationEnv(cmd.Env)\n\treturn &ptyReader{r: ptmx}, ptmx, tty, nil\n}\n\nfunc closePTY(ptmx, tty *os.File) {\n\tif tty != nil {\n\t\t_ = tty.Close()\n\t}\n\tif ptmx != nil {\n\t\t_ = ptmx.Close()\n\t}\n}\n\n// appendNoDecorationEnv adds env vars that tell the agent not to emit\n// terminal decoration even though it now thinks stdout is a TTY.\n// Values already set on the parent env are preserved — we only append\n// the keys when missing.\nfunc appendNoDecorationEnv(env []string) []string {\n\twant := map[string]string{\n\t\t\"NO_COLOR\":    \"1\",\n\t\t\"FORCE_COLOR\": \"0\",\n\t\t\"TERM\":        \"dumb\",\n\t}\n\tfor _, e := range env {\n\t\tidx := strings.IndexByte(e, '=')\n\t\tif idx < 0 {\n\t\t\tcontinue\n\t\t}\n\t\tdelete(want, e[:idx])\n\t}\n\tfor k, v := range want {\n\t\tenv = append(env, k+\"=\"+v)\n\t}\n\treturn env\n}\n\n// ptyReader translates the Linux ptmx behaviour of returning EIO when the\n// child closes its slave side into a normal EOF. macOS already reports EOF\n// in that situation; the wrapper makes both platforms look the same to the\n// parser's bufio.Scanner.\ntype ptyReader struct {\n\tr io.Reader\n}\n\nfunc (p *ptyReader) Read(b []byte) (int, error) {\n\tn, err := p.r.Read(b)\n\tif err != nil && isEIO(err) {\n\t\treturn n, io.EOF\n\t}\n\treturn n, err //nolint:wrapcheck // passthrough preserves Reader contract\n}\n\nfunc isEIO(err error) bool {\n\tif errors.Is(err, syscall.EIO) {\n\t\treturn true\n\t}\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn errors.Is(pathErr.Err, syscall.EIO)\n\t}\n\treturn false\n}\n\n// ErrTemplateMisconfigured is returned by ReviewerTemplate.Start when one of\n// the required fields (AgentName, BuildCmd, Parser) is unset, or when\n// BuildCmd returns nil. Use errors.Is to detect this in tests or higher\n// layers (e.g., a multi-agent orchestrator that needs to skip a misconfigured\n// agent rather than crashing the whole run).\nvar ErrTemplateMisconfigured = errors.New(\"ReviewerTemplate misconfigured\")\n\n// templateProcess is the shared Process implementation for ReviewerTemplate.\ntype templateProcess struct {\n\tctx        context.Context\n\tagentName  string\n\tcmd        *exec.Cmd\n\tevents     chan Event\n\tstderr     *boundedStderrBuffer\n\tstderrDone chan struct{}\n\t// ptmx is the PTY master when UsePTY=true, nil otherwise. The parser\n\t// goroutine in run() closes it once the parser's event channel drains —\n\t// closing earlier would interrupt streaming, closing later would leak\n\t// the fd if the consumer ignores Wait.\n\tptmx *os.File\n}\n\n// Events returns the channel that streams parsed events from the agent process.\nfunc (p *templateProcess) Events() <-chan Event { return p.events }\n\n// Wait returns the agent process's exit error with bounded stderr diagnostics.\n//\n// Per CU2's Process contract: nil on clean exit (exit code 0); ctx.Err()\n// on cancellation; ProcessError wrapping *exec.ExitError on non-zero exit\n// with stderr; other types for I/O or pipe failures. ProcessError implements\n// Unwrap so callers can use errors.As and errors.Is to classify.\nfunc (p *templateProcess) Wait() error {\n\tif p.stderrDone != nil {\n\t\t<-p.stderrDone\n\t}\n\terr := p.cmd.Wait()\n\tif err != nil && p.ctx.Err() != nil {\n\t\treturn p.ctx.Err() //nolint:wrapcheck // preserve Process cancellation contract\n\t}\n\tif err != nil {\n\t\tif stderr := p.stderr.String(); stderr != \"\" {\n\t\t\treturn &ProcessError{AgentName: p.agentName, Err: err, Stderr: stderr}\n\t\t}\n\t}\n\treturn err //nolint:wrapcheck // interface boundary; classifyStatus needs raw type\n}\n\nfunc (p *templateProcess) run(stdout io.Reader, parser func(io.Reader) <-chan Event) {\n\tdefer close(p.events)\n\tif p.ptmx != nil {\n\t\tdefer func() { _ = p.ptmx.Close() }()\n\t}\n\tfor ev := range parser(stdout) {\n\t\tp.events <- ev\n\t}\n}\n\nfunc (p *templateProcess) captureStderr(stderr io.Reader) {\n\tdefer close(p.stderrDone)\n\t_, _ = io.Copy(p.stderr, stderr) //nolint:errcheck // stderr is best-effort diagnostic context\n}\n\n// ProcessError wraps a process failure with bounded stderr diagnostics.\n// Unwrap preserves the underlying error, so callers can still use errors.As\n// for *exec.ExitError or errors.Is for lower-level sentinels.\ntype ProcessError struct {\n\tAgentName string\n\tErr       error\n\tStderr    string\n}\n\nfunc (e *ProcessError) Error() string {\n\tif e.Stderr == \"\" {\n\t\treturn fmt.Sprintf(\"%s: %v\", e.AgentName, e.Err)\n\t}\n\treturn fmt.Sprintf(\"%s: %v: stderr: %s\", e.AgentName, e.Err, e.Stderr)\n}\n\nfunc (e *ProcessError) Unwrap() error { return e.Err }\n\ntype boundedStderrBuffer struct {\n\tlimit     int\n\tbuf       []byte\n\ttruncated bool\n}\n\nfunc (b *boundedStderrBuffer) Write(p []byte) (int, error) {\n\tif b.limit <= 0 {\n\t\tb.truncated = true\n\t\treturn len(p), nil\n\t}\n\tremaining := b.limit - len(b.buf)\n\tif remaining > 0 {\n\t\tif len(p) <= remaining {\n\t\t\tb.buf = append(b.buf, p...)\n\t\t} else {\n\t\t\tb.buf = append(b.buf, p[:remaining]...)\n\t\t\tb.truncated = true\n\t\t}\n\t} else if len(p) > 0 {\n\t\tb.truncated = true\n\t}\n\treturn len(p), nil\n}\n\nfunc (b *boundedStderrBuffer) String() string {\n\tout := strings.TrimSpace(string(b.buf))\n\tif out == \"\" {\n\t\treturn \"\"\n\t}\n\tif b.truncated {\n\t\treturn out + \"\\n[stderr truncated]\"\n\t}\n\treturn out\n}\n","numLines":332,"startLine":1,"totalLines":332}},"sourceToolAssistantUUID":"ec5a4e9a-c792-4d52-8932-bad6da3d091b","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream","sessionId":"29e905db-df81-4eac-9e54-265c4e180a9c","version":"2.1.139","gitBranch":"review-fix-progress-stream"}
