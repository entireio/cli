lse: the probe sees a pipe, fills its 64KB buffer,\n//     and only flushes at exit. The runner observes one big burst.\n//   - With UsePTY=true:  the probe sees a TTY, line-buffers, and the\n//     runner observes events arriving as each line is written.\n//\n// The two passes print event timestamps side-by-side so the difference\n// is visible at a glance.\n//\n// Usage:\n//\n//\tgo run ./e2e/streaming-smoke\n//\n// Expected output (timestamps approximate):\n//\n//\t=== Pass 1: UsePTY=false (simulates the bug) ===\n//\t  +    0ms  Started{}\n//\t  +  830ms  AssistantText  \"probe line 1\"\n//\t  +  830ms  AssistantText  \"probe line 2\"\n//\t  +  830ms  AssistantText  \"probe line 3\"\n//\t  +  830ms  AssistantText  \"probe line 4\"\n//\t  +  830ms  AssistantText  \"probe line 5\"\n//\t  +  830ms  Finished{Success:true}\n//\n//\t=== Pass 2: UsePTY=true (the fix) ===\n//\t  +    0ms  Started{}\n//\t  +    1ms  AssistantText  \"probe line 1\"\n//\t  +  160ms  AssistantText  \"probe line 2\"\n//\t  +  320ms  AssistantText  \"probe line 3\"\n//\t  +  480ms  AssistantText  \"probe line 4\"\n//\t  +  640ms  AssistantText  \"probe line 5\"\n//\t  +  640ms  Finished{Success:true}\n//\n// Notice how Pass 1 clusters all events at end-of-run, while Pass 2\n// staggers them at ~150ms intervals (the probe's sleep between lines).\npackage main\n\nimport (\n\t\"bufio\"\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/mattn/go-isatty\"\n\n\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n)\n\nconst probeFlag = \"--probe\"\n\nfunc main() {\n\t// Self-spawn pattern: re-exec the same binary with --probe to act as\n\t// the fake \"buffering agent\". Keeps the smoke test in a single file\n\t// the user can run with `go run ./e2e/streaming-smoke`.\n\tif len(os.Args) > 1 && os.Args[1] == probeFlag {\n\t\trunProbe()\n\t\treturn\n\t}\n\tif err := runHarness(); err != nil {\n\t\tfmt.Fprintln(os.Stderr, \"streaming-smoke:\", err)\n\t\tos.Exit(1)\n\t}\n}\n\n// runProbe is the fake-agent side. When stdout is a pipe (not a TTY)\n// it wraps stdout in a bufio.Writer with a libc-typical 64KB buffer so\n// per-line writes accumulate until exit — the same pattern that causes\n// real agents to \"burst at the end\". When stdout IS a TTY it writes\n// directly so the natural per-line flushing happens.\nfunc runProbe() {\n\tconst lineCount = 5\n\tconst between = 150 * time.Millisecond\n\n\tif isatty.IsTerminal(os.Stdout.Fd()) {\n\t\t// TTY path: writes flush per line; the runner sees them stagger.\n\t\tfor i := 1; i <= lineCount; i++ {\n\t\t\tfmt.Fprintf(os.Stdout, \"probe line %d\\n\", i)\n\t\t\ttime.Sleep(between)\n\t\t}\n\t\treturn\n\t}\n\n\t// Pipe path: simulate libc/Rust/Node block buffering. All lines stay\n\t// in the buffer until Flush() at exit — even though the same loop\n\t// sleeps between writes, the runner sees them as one burst.\n\tw := bufio.NewWriterSize(os.Stdout, 64*1024)\n\tfor i := 1; i <= lineCount; i++ {\n\t\tfmt.Fprintf(w, \"probe line %d\\n\", i)\n\t\ttime.Sleep(between)\n\t}\n\t_ = w.Flush()\n}\n\n// runHarness spawns the probe twice — once without PTY (bug), once with\n// PTY (fix) — and prints per-event timing for each pass.\nfunc runHarness() error {\n\tself, err := os.Executable()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"locate self: %w\", err)\n\t}\n\n\tfmt.Println(\"streaming-smoke: spawning probe twice to compare buffering behaviour.\")\n\tfmt.Println(\"look for events clustered at end (Pass 1) vs staggered (Pass 2).\")\n\tfmt.Println()\n\n\tif err := runOnce(\"Pass 1: UsePTY=false (simulates the bug)\", self, false); err != nil {\n\t\treturn err\n\t}\n\tfmt.Println()\n\tif err := runOnce(\"Pass 2: UsePTY=true (the fix)\", self, true); err != nil {\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc runOnce(label, selfPath string, usePTY bool) error {\n\ttmpl := &reviewtypes.ReviewerTemplate{\n\t\tAgentName: \"smoke-probe\",\n\t\tBuildCmd: func(ctx context.Context, _ reviewtypes.RunConfig) *exec.Cmd {\n\t\t\treturn exec.CommandContext(ctx, selfPath, probeFlag)\n\t\t},\n\t\tParser: lineParser,\n\t\tUsePTY: usePTY,\n\t}\n\n\tstarted := time.Now()\n\tproc, err := tmpl.Start(context.Background(), reviewtypes.RunConfig{})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"%s: start: %w\", label, err)\n\t}\n\n\tfmt.Printf(\"=== %s ===\\n\", label)\n\tfor ev := range proc.Events() {\n\t\telapsed := time.Since(started)\n\t\tprintEvent(elapsed, ev)\n\t}\n\tif err := proc.Wait(); err != nil {\n\t\treturn fmt.Errorf(\"%s: wait: %w\", label, err)\n\t}\n\treturn nil\n}\n\nfunc printEvent(elapsed time.Duration, ev reviewtypes.Event) {\n\tprefix := fmt.Sprintf(\"  + %4dms  \", elapsed.Milliseconds())\n\tswitch e := ev.(type) {\n\tcase reviewtypes.AssistantText:\n\t\tfmt.Printf(\"%sAssistantText  %q\\n\", prefix, e.Text)\n\tcase reviewtypes.Started:\n\t\tfmt.Printf(\"%sStarted{}\\n\", prefix)\n\tcase reviewtypes.Finished:\n\t\tfmt.Printf(\"%sFinished{Success:%v}\\n\", prefix, e.Success)\n\tdefault:\n\t\tfmt.Printf(\"%s%T\\n\", prefix, ev)\n\t}\n}\n\nfunc lineParser(r io.Reader) <-chan reviewtypes.Event {\n\tch := make(chan reviewtypes.Event, 16)\n\tgo func() {\n\t\tdefer close(ch)\n\t\tch <- reviewtypes.Started{}\n\t\ts := bufio.NewScanner(r)\n\t\tfor s.Scan() {\n\t\t\tline := strings.TrimRight(s.Text(), \"\\r\")\n\t\t\tif line == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tch <- reviewtypes.AssistantText{Text: line}\n\t\t}\n\t\tif err := s.Err(); err != nil {\n\t\t\tch <- reviewtypes.RunError{Err: err}\n\t\t\tch <- reviewtypes.Finished{Success: false}\n\t\t\treturn\n\t\t}\n\t\tch <- reviewtypes.Finished{Success: true}\n\t}()\n\treturn ch\n}\n","userModified":false},"sourceToolAssistantUUID":"109cc36f-5a7c-4f2b-bb9f-e07532a7aab5","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-progress-stream","sessionId":"29e905db-df81-4eac-9e54-265c4e180a9c","version":"2.1.139"