{"timestamp":"2026-05-11T23:08:34.615Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_LzlrTBH54aKJpjh4uPvVcIlf","output":"Chunk ID: 993cee\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1482\nOutput:\n     1\t// Package review — see env.go for package-level rationale.\n     2\t//\n     3\t// tui_sink.go provides TUISink, a Sink implementation that renders a Bubble\n     4\t// Tea status dashboard during a review run and supports Ctrl+O\n     5\t// drill-in mode for inspecting one agent's live event buffer. Used in\n     6\t// interactive (TTY) runs; non-TTY runs use DumpSink instead.\n     7\tpackage review\n     8\t\n     9\timport (\n    10\t\t\"context\"\n    11\t\t\"io\"\n    12\t\t\"sync\"\n    13\t\n    14\t\ttea \"charm.land/bubbletea/v2\"\n    15\t\n    16\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n    17\t)\n    18\t\n    19\t// TUISink is a Sink that renders a Bubble Tea dashboard. The orchestrator\n    20\t// calls AgentEvent/RunFinished from a single goroutine (CU4 serial-dispatch\n    21\t// contract); the sink translates each event into a tea.Msg and sends it via\n    22\t// Program.Send. Bubble Tea's Send is thread-safe, but we never rely on that\n    23\t// property — the serial-dispatch promise means Send is only called from the\n    24\t// orchestrator's dispatch goroutine.\n    25\t//\n    26\t// Cancellation: cancel is the same context.CancelFunc that controls the\n    27\t// orchestrator's run context. KeyCtrlC in the dashboard calls this function\n    28\t// (gated by a sync.Once in the model). Out-of-TUI SIGINT routes through the\n    29\t// cobra root's context, which cancels the same function — no parallel\n    30\t// signal.Notify goroutine is needed here.\n    31\ttype TUISink struct {\n    32\t\tprogram *tea.Program\n    33\t\n    34\t\tmu       sync.Mutex\n    35\t\tstarted  bool\n    36\t\tfinished bool\n    37\t\n    38\t\tdone chan struct{} // closed when the tea.Program exits\n    39\t}\n    40\t\n    41\t// Compile-time interface check.\n    42\tvar _ reviewtypes.Sink = (*TUISink)(nil)\n    43\t\n    44\t// NewTUISink creates a TUISink wired to cancel for Ctrl+C handling. agents is\n    45\t// the ordered list of agent names that will run; the dashboard pre-renders one\n    46\t// row per agent so the user sees the full run shape from the first frame.\n    47\t// output is the writer the Bubble Tea program renders into (typically\n    48\t// cmd.OutOrStdout()). input is the reader Bubble Tea reads keypresses from\n    49\t// (typically os.Stdin in production); tests must pass a non-TTY reader (e.g.\n    50\t// bytes.NewReader(nil)) so Bubble Tea does not put the inherited terminal\n    51\t// into raw mode and corrupt sibling test output.\n    52\t//\n    53\t// tea.WithoutSignalHandler keeps SIGINT routing on the cobra root's existing\n    54\t// handler (which cancels the run context), so the TUI's KeyCtrlC path and the\n    55\t// OS signal path share a single cancel function with no race.\n    56\tfunc NewTUISink(agents []string, cancel context.CancelFunc, output io.Writer, input io.Reader) *TUISink {\n    57\t\tmodel := newReviewTUIModel(agents, cancel)\n    58\t\tprog := tea.NewProgram(\n    59\t\t\tmodel,\n    60\t\t\ttea.WithOutput(output),\n    61\t\t\ttea.WithInput(input),\n    62\t\t\ttea.WithoutSignalHandler(), // SIGINT handled by cobra root; KeyCtrlC calls cancel directly\n    63\t\t)\n    64\t\treturn &TUISink{\n    65\t\t\tprogram: prog,\n    66\t\t\tdone:    make(chan struct{}),\n    67\t\t}\n    68\t}\n    69\t\n    70\t// Start spawns the Bubble Tea program in its own goroutine. Must be called\n    71\t// before any AgentEvent calls. Subsequent calls are no-ops.\n    72\tfunc (s *TUISink) Start() {\n    73\t\ts.mu.Lock()\n    74\t\tif s.started {\n    75\t\t\ts.mu.Unlock()\n    76\t\t\treturn\n    77\t\t}\n    78\t\ts.started = true\n    79\t\ts.mu.Unlock()\n    80\t\n    81\t\tgo func() {\n    82\t\t\tdefer close(s.done)\n    83\t\t\tif _, err := s.program.Run(); err != nil {\n    84\t\t\t\t// Bubble Tea program errors are non-actionable in a background\n    85\t\t\t\t// goroutine (e.g., terminal resize race on exit). Log nothing —\n    86\t\t\t\t// the run result is available via RunSummary and the sink's\n    87\t\t\t\t// finished state. Swallowing is intentional.\n    88\t\t\t\t_ = err\n    89\t\t\t}\n    90\t\t}()\n    91\t}\n    92\t\n    93\t// Wait blocks until the Bubble Tea program exits. Safe to call after Start.\n    94\t// If Start was never called, Wait returns immediately.\n    95\tfunc (s *TUISink) Wait() {\n    96\t\ts.mu.Lock()\n    97\t\tstarted := s.started\n    98\t\ts.mu.Unlock()\n    99\t\tif !started {\n   100\t\t\treturn\n   101\t\t}\n   102\t\t<-s.done\n   103\t}\n   104\t\n   105\t// AgentEvent (Sink interface): translate ev into a tea.Msg and Send it to the\n   106\t// Bubble Tea program. Implements the serial-dispatch contract: the orchestrator\n   107\t// calls this from a single goroutine.\n   108\t//\n   109\t// Note: Send is safe to call from goroutines other than the TUI's update loop;\n   110\t// Bubble Tea's implementation queues the message internally.\n   111\tfunc (s *TUISink) AgentEvent(agent string, ev reviewtypes.Event) {\n   112\t\ts.mu.Lock()\n   113\t\tok := s.started && !s.finished\n   114\t\ts.mu.Unlock()\n   115\t\tif !ok {\n   116\t\t\treturn\n   117\t\t}\n   118\t\ts.program.Send(agentEventMsg{agent: agent, ev: ev})\n   119\t}\n   120\t\n   121\t// RunFinished (Sink interface): mark the run complete and send the final\n   122\t// summary message. The TUI shows the dashboard one more frame with the\n   123\t// terminal statuses and waits for the user to press any key to dismiss.\n   124\t//\n   125\t// IMPORTANT: RunFinished blocks until the user dismisses (presses any key)\n   126\t// so that post-run sinks (e.g. DumpSink) render their narrative AFTER the\n   127\t// TUI has exited and the terminal is back in normal mode.\n   128\tfunc (s *TUISink) RunFinished(summary reviewtypes.RunSummary) {\n   129\t\ts.mu.Lock()\n   130\t\tif s.finished {\n   131\t\t\ts.mu.Unlock()\n   132\t\t\treturn\n   133\t\t}\n   134\t\ts.finished = true\n   135\t\ts.mu.Unlock()\n   136\t\n   137\t\ts.program.Send(runFinishedMsg{summary: summary})\n   138\t\t// Block until the Bubble Tea program exits (user presses any key after\n   139\t\t// seeing the final dashboard, or Ctrl+C was already received and the\n   140\t\t// program already quit).\n   141\t\ts.Wait()\n   142\t}\n"}}
