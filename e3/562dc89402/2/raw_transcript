{"parentUuid":"6a40603e-39d4-4faf-ba35-238fcdf2ceed","isSidechain":false,"promptId":"de430c43-b0fc-42e4-ad8d-e0e0a5a9a6b0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L2jZ4sqZbWsnayXVuaprNz","type":"tool_result","content":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// tui_model.go provides reviewTUIModel, the Bubble Tea Model for the\n4\t// review dashboard. The model renders a per-agent status table\n5\t// during the run and supports Ctrl+O drill-in mode for inspecting one agent's\n6\t// live event buffer on the alt screen.\n7\tpackage review\n8\t\n9\timport (\n10\t\t\"context\"\n11\t\t\"fmt\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"sync\"\n15\t\t\"time\"\n16\t\n17\t\t\"charm.land/bubbles/v2/spinner\"\n18\t\t\"charm.land/bubbles/v2/viewport\"\n19\t\ttea \"charm.land/bubbletea/v2\"\n20\t\t\"charm.land/lipgloss/v2\"\n21\t\n22\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n23\t\t\"github.com/entireio/cli/cmd/entire/cli/stringutil\"\n24\t)\n25\t\n26\t// agentRow holds per-agent live state during the TUI run.\n27\ttype agentRow struct {\n28\t\tname     string\n29\t\tstatus   reviewtypes.AgentStatus\n30\t\trunStart time.Time          // stamped on first event from this agent\n31\t\trunEnd   time.Time          // stamped on Finished/RunError event\n32\t\ttokens   reviewtypes.Tokens // cumulative\n33\t\tpreview  string             // latest AssistantText preview, capped by display width\n34\t\tbuffer   []reviewtypes.Event\n35\t\terr      error\n36\t}\n37\t\n38\t// agentEventMsg is sent to the Bubble Tea program when an agent emits an event.\n39\ttype agentEventMsg struct {\n40\t\tagent string\n41\t\tev    reviewtypes.Event\n42\t}\n43\t\n44\t// runFinishedMsg is sent when the orchestrator calls RunFinished.\n45\ttype runFinishedMsg struct {\n46\t\tsummary reviewtypes.RunSummary\n47\t}\n48\t\n49\t// tickMsg triggers spinner and duration column updates.\n50\ttype tickMsg time.Time\n51\t\n52\t// reviewTUIModel is the Bubble Tea model for the review dashboard.\n53\ttype reviewTUIModel struct {\n54\t\trows       []agentRow\n55\t\trowIdx     map[string]int // agent name → row index (O(1) lookup)\n56\t\tdetailMode bool\n57\t\tdetailIdx  int // which agent is shown in drill-in\n58\t\t// detail is the pager backing the drill-in body. Width/Height are kept\n59\t\t// in sync with termWidth/termHeight (minus header+footer). Scroll\n60\t\t// position is internal state; AtBottom drives auto-tail.\n61\t\tdetail viewport.Model\n62\t\n63\t\tcancel     context.CancelFunc\n64\t\tcancelOnce *sync.Once\n65\t\n66\t\tspinner    spinner.Model\n67\t\ttermWidth  int\n68\t\ttermHeight int\n69\t\n70\t\tfinished bool\n71\t\tsummary  reviewtypes.RunSummary\n72\t\n73\t\t// cancelling tracks whether a Ctrl+C-initiated cancellation is in flight.\n74\t\t// Set true on the first Ctrl+C (in tandem with cancelOnce firing the shared\n75\t\t// CancelFunc); the dashboard switches to a \"cancelling\" indicator and the\n76\t\t// footer offers a force-quit hint. A second Ctrl+C while cancelling=true\n77\t\t// force-quits without waiting for agents to drain.\n78\t\tcancelling bool\n79\t}\n80\t\n81\t// newReviewTUIModel builds an initial model pre-populated with one row per\n82\t// agent. cancel is the shared CancelFunc; it must be the same one passed to\n83\t// NewTUISink.\n84\tfunc newReviewTUIModel(agents []string, cancel context.CancelFunc) reviewTUIModel {\n85\t\tsp := spinner.New()\n86\t\tsp.Spinner = spinner.Dot\n87\t\tsp.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n88\t\n89\t\trows := make([]agentRow, len(agents))\n90\t\trowIdx := make(map[string]int, len(agents))\n91\t\tfor i, name := range agents {\n92\t\t\trows[i] = agentRow{\n93\t\t\t\tname:   name,\n94\t\t\t\tstatus: reviewtypes.AgentStatusUnknown,\n95\t\t\t}\n96\t\t\trowIdx[name] = i\n97\t\t}\n98\t\t// Seed viewport with defaults that match termWidth/termHeight so an\n99\t\t// immediate Ctrl+O before any WindowSizeMsg still renders.\n100\t\tconst (\n101\t\t\tdefaultTermWidth  = 80\n102\t\t\tdefaultTermHeight = 24\n103\t\t)\n104\t\tvp := viewport.New(\n105\t\t\tviewport.WithWidth(defaultTermWidth),\n106\t\t\tviewport.WithHeight(defaultTermHeight-2),\n107\t\t)\n108\t\treturn reviewTUIModel{\n109\t\t\trows:       rows,\n110\t\t\trowIdx:     rowIdx,\n111\t\t\tdetail:     vp,\n112\t\t\tcancel:     cancel,\n113\t\t\tcancelOnce: &sync.Once{},\n114\t\t\tspinner:    sp,\n115\t\t\ttermWidth:  defaultTermWidth,\n116\t\t\ttermHeight: defaultTermHeight,\n117\t\t}\n118\t}\n119\t\n120\t// tickCmd schedules the next tick for duration/spinner refresh.\n121\tfunc tickCmd() tea.Cmd {\n122\t\treturn tea.Tick(100*time.Millisecond, func(t time.Time) tea.Msg {\n123\t\t\treturn tickMsg(t)\n124\t\t})\n125\t}\n126\t\n127\t// Init returns the initial spinner tick command.\n128\tfunc (m reviewTUIModel) Init() tea.Cmd {\n129\t\treturn tea.Batch(m.spinner.Tick, tickCmd())\n130\t}\n131\t\n132\t// Update handles all incoming messages.\n133\tfunc (m reviewTUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n134\t\tswitch msg := msg.(type) {\n135\t\tcase agentEventMsg:\n136\t\t\treturn m.handleAgentEvent(msg)\n137\t\n138\t\tcase runFinishedMsg:\n139\t\t\tm.finished = true\n140\t\t\tm.summary = msg.summary\n141\t\t\t// Sync each row's status from the orchestrator's summary. The\n142\t\t\t// in-stream events (Finished / RunError) update status as they\n143\t\t\t// arrive, but the orchestrator's classifyStatus has access to\n144\t\t\t// process-level signals (Wait error, ctx cancellation) that the\n145\t\t\t// event stream never surfaces. Without this sync, an agent that\n146\t\t\t// the orchestrator classified Cancelled (Ctrl+C path, no Finished\n147\t\t\t// emitted) or Failed (process exit non-zero, no Finished emitted)\n148\t\t\t// would still render as \"running\" in the final frame.\n149\t\t\t//\n150\t\t\t// Preserve any already-set status from the event stream — if the\n151\t\t\t// stream said Failed (RunError), the summary may say Succeeded\n152\t\t\t// (process exit 0); RunError stickiness wins. Only overwrite when\n153\t\t\t// the row is still in AgentStatusUnknown.\n154\t\t\tnow := time.Now()\n155\t\t\tfor i, run := range msg.summary.AgentRuns {\n156\t\t\t\tif i >= len(m.rows) {\n157\t\t\t\t\tbreak\n158\t\t\t\t}\n159\t\t\t\tif m.rows[i].status == reviewtypes.AgentStatusUnknown {\n160\t\t\t\t\tm.rows[i].status = run.Status\n161\t\t\t\t}\n162\t\t\t\tif m.rows[i].runEnd.IsZero() && !m.rows[i].runStart.IsZero() {\n163\t\t\t\t\tm.rows[i].runEnd = now\n164\t\t\t\t}\n165\t\t\t}\n166\t\t\treturn m, nil\n167\t\n168\t\tcase tickMsg:\n169\t\t\tvar spinCmd tea.Cmd\n170\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n171\t\t\treturn m, tea.Batch(spinCmd, tickCmd())\n172\t\n173\t\tcase spinner.TickMsg:\n174\t\t\tvar spinCmd tea.Cmd\n175\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n176\t\t\treturn m, spinCmd\n177\t\n178\t\tcase tea.WindowSizeMsg:\n179\t\t\tm.termWidth = msg.Width\n180\t\t\tm.termHeight = msg.Height\n181\t\t\tm.detail.SetWidth(m.detailViewportWidth())\n182\t\t\tm.detail.SetHeight(m.detailViewportHeight())\n183\t\t\tm = m.refreshDetailContent()\n184\t\t\treturn m, nil\n185\t\n186\t\tcase tea.KeyPressMsg:\n187\t\t\treturn m.handleKey(msg)\n188\t\t}\n189\t\treturn m, nil\n190\t}\n191\t\n192\t// detailViewportWidth returns the viewport's width, mirroring termWidth.\n193\tfunc (m reviewTUIModel) detailViewportWidth() int {\n194\t\tif m.termWidth < 1 {\n195\t\t\treturn 1\n196\t\t}\n197\t\treturn m.termWidth\n198\t}\n199\t\n200\t// detailViewportHeight returns the viewport's body height, reserving one line\n201\t// for the header and one for the footer.\n202\tfunc (m reviewTUIModel) detailViewportHeight() int {\n203\t\th := m.termHeight - 2\n204\t\tif h < 1 {\n205\t\t\treturn 1\n206\t\t}\n207\t\treturn h\n208\t}\n209\t\n210\t// refreshDetailContent re-renders the focused agent's events into the\n211\t// viewport. It preserves auto-tail: if the viewport was sitting at the bottom\n212\t// (or has no scrollable content), it jumps to the new bottom after the content\n213\t// is replaced; otherwise the user's scroll position is left untouched.\n214\t//\n215\t// reviewTUIModel uses value receivers throughout (matching the Bubble Tea\n216\t// idiom of returning an updated tea.Model from Update); the viewport is\n217\t// mutated in place on the returned copy and the caller assigns the result\n218\t// back.\n219\tfunc (m reviewTUIModel) refreshDetailContent() reviewTUIModel {\n220\t\tif len(m.rows) == 0 || m.detailIdx < 0 || m.detailIdx >= len(m.rows) {\n221\t\t\tm.detail.SetContent(\"\")\n222\t\t\treturn m\n223\t\t}\n224\t\twasAtBottom := m.detail.AtBottom()\n225\t\tlines := buildEventLines(m.rows[m.detailIdx].buffer, m.detailViewportWidth())\n226\t\tm.detail.SetContentLines(lines)\n227\t\tif wasAtBottom {\n228\t\t\tm.detail.GotoBottom()\n229\t\t}\n230\t\treturn m\n231\t}\n232\t\n233\t// handleAgentEvent processes an agentEventMsg, updating the relevant row.\n234\tfunc (m reviewTUIModel) handleAgentEvent(msg agentEventMsg) (tea.Model, tea.Cmd) {\n235\t\tidx, ok := m.rowIdx[msg.agent]\n236\t\tif !ok {\n237\t\t\treturn m, nil\n238\t\t}\n239\t\trow := &m.rows[idx]\n240\t\n241\t\t// Stamp run-start on the first event from this agent (per-row, not\n242\t\t// TUI-start; prevents inflated durations for late-starting agents).\n243\t\tif row.runStart.IsZero() {\n244\t\t\trow.runStart = time.Now()\n245\t\t}\n246\t\n247\t\trow.buffer = append(row.buffer, msg.ev)\n248\t\n249\t\tswitch e := msg.ev.(type) {\n250\t\tcase reviewtypes.Started:\n251\t\t\t// runStart already set; no other state update needed.\n252\t\tcase reviewtypes.AssistantText:\n253\t\t\tcollapsed := stringutil.CollapseWhitespace(sanitizeDisplayText(e.Text))\n254\t\t\trow.preview = truncateDisplayWidth(collapsed, 80)\n255\t\tcase reviewtypes.Tokens:\n256\t\t\trow.tokens = e // cumulative: overwrite, not sum\n257\t\tcase reviewtypes.Finished:\n258\t\t\t// RunError is sticky: if a prior RunError event already classified\n259\t\t\t// this row as Failed, a subsequent Finished{Success: true} must NOT\n260\t\t\t// flip it back to Succeeded. CU3's parser-fix-loop guarantees that\n261\t\t\t// RunError + Finished{Success:false} both accompany torn streams;\n262\t\t\t// matching that contract here keeps the TUI consistent with\n263\t\t\t// classifyStatus from CU4 (which honors sawRunError).\n264\t\t\tif row.status != reviewtypes.AgentStatusFailed {\n265\t\t\t\tif e.Success {\n266\t\t\t\t\trow.status = reviewtypes.AgentStatusSucceeded\n267\t\t\t\t} else {\n268\t\t\t\t\trow.status = reviewtypes.AgentStatusFailed\n269\t\t\t\t}\n270\t\t\t}\n271\t\t\trow.runEnd = time.Now()\n272\t\tcase reviewtypes.RunError:\n273\t\t\trow.status = reviewtypes.AgentStatusFailed\n274\t\t\trow.err = e.Err\n275\t\t\tif row.runEnd.IsZero() {\n276\t\t\t\trow.runEnd = time.Now()\n277\t\t\t}\n278\t\tcase reviewtypes.ToolCall:\n279\t\t\t// No visible state update for tool calls in the dashboard.\n280\t\t}\n281\t\n282\t\t// Re-render the focused agent's viewport content when a new event lands\n283\t\t// for it. refreshDetailContent's AtBottom check preserves user scroll if\n284\t\t// they've scrolled up; auto-tails otherwise.\n285\t\tif m.detailMode && m.detailIdx == idx {\n286\t\t\tm = m.refreshDetailContent()\n287\t\t}\n288\t\n289\t\treturn m, nil\n290\t}\n291\t\n292\t// handleKey processes keyboard input.\n293\tfunc (m reviewTUIModel) handleKey(msg tea.KeyPressMsg) (tea.Model, tea.Cmd) {\n294\t\t// Post-finish dashboard: only explicit exit keys dismiss. Any other key\n295\t\t// (including Ctrl+O) falls through to normal handling so the user can\n296\t\t// still drill into completed agent output. Ctrl+C also quits immediately\n297\t\t// — there are no agents left to drain.\n298\t\tif m.finished && !m.detailMode {\n299\t\t\tif isPostFinishExitKey(msg) || (msg.Code == 'c' && msg.Mod == tea.ModCtrl) {\n300\t\t\t\treturn m, tea.Quit\n301\t\t\t}\n302\t\t}\n303\t\n304\t\tswitch {\n305\t\tcase msg.Code == 'c' && msg.Mod == tea.ModCtrl:\n306\t\t\tif m.detailMode {\n307\t\t\t\t// In drill-in: Ctrl+C is intentionally ignored; Esc first.\n308\t\t\t\treturn m, nil\n309\t\t\t}\n310\t\t\t// Second Ctrl+C while a cancellation is already in flight force-quits\n311\t\t\t// without waiting for agents to drain. The shared CancelFunc is\n312\t\t\t// guarded by cancelOnce, so the second press doesn't double-cancel.\n313\t\t\tif m.cancelling {\n314\t\t\t\treturn m, tea.Quit\n315\t\t\t}\n316\t\t\tm.cancelling = true\n317\t\t\tm.cancelOnce.Do(m.cancel)\n318\t\t\t// Do NOT quit on the first Ctrl+C: leave the TUI up so the user sees\n319\t\t\t// the cancelling indicator while agents drain. Natural finish\n320\t\t\t// (runFinishedMsg) or a second Ctrl+C dismisses the TUI.\n321\t\t\treturn m, nil\n322\t\n323\t\tcase msg.Code == 'o' && msg.Mod == tea.ModCtrl:\n324\t\t\tif m.detailMode {\n325\t\t\t\tm.detailMode = false\n326\t\t\t\treturn m, nil\n327\t\t\t}\n328\t\t\tm.detailMode = true\n329\t\t\tif len(m.rows) > 0 && (m.detailIdx < 0 || m.detailIdx >= len(m.rows)) {\n330\t\t\t\tm.detailIdx = 0\n331\t\t\t}\n332\t\t\t// Resize viewport in case termWidth/termHeight have changed since\n333\t\t\t// last detail-mode entry, then load the focused agent's events and\n334\t\t\t// tail to the bottom.\n335\t\t\tm.detail.SetWidth(m.detailViewportWidth())\n336\t\t\tm.detail.SetHeight(m.detailViewportHeight())\n337\t\t\tm = m.refreshDetailContent()\n338\t\t\tm.detail.GotoBottom()\n339\t\t\treturn m, nil\n340\t\n341\t\tcase msg.Code == tea.KeyEscape || msg.Code == tea.KeyEsc:\n342\t\t\tif m.detailMode {\n343\t\t\t\tm.detailMode = false\n344\t\t\t\treturn m, nil\n345\t\t\t}\n346\t\t\treturn m, nil\n347\t\n348\t\tcase msg.Code == tea.KeyLeft:\n349\t\t\tif m.detailMode && len(m.rows) > 0 {\n350\t\t\t\tm.detailIdx = (m.detailIdx - 1 + len(m.rows)) % len(m.rows)\n351\t\t\t\tm = m.refreshDetailContent()\n352\t\t\t\tm.detail.GotoBottom()\n353\t\t\t}\n354\t\t\treturn m, nil\n355\t\n356\t\tcase msg.Code == tea.KeyRight:\n357\t\t\tif m.detailMode && len(m.rows) > 0 {\n358\t\t\t\tm.detailIdx = (m.detailIdx + 1) % len(m.rows)\n359\t\t\t\tm = m.refreshDetailContent()\n360\t\t\t\tm.detail.GotoBottom()\n361\t\t\t}\n362\t\t\treturn m, nil\n363\t\t}\n364\t\n365\t\t// Delegate any unhandled key to the viewport so PgUp/PgDn/Home/End/↑/↓\n366\t\t// reach its internal keymap. Only meaningful in detail mode — on the\n367\t\t// dashboard the viewport is inert.\n368\t\tif m.detailMode {\n369\t\t\tvar cmd tea.Cmd\n370\t\t\tm.detail, cmd = m.detail.Update(msg)\n371\t\t\treturn m, cmd\n372\t\t}\n373\t\treturn m, nil\n374\t}\n375\t\n376\t// isPostFinishExitKey reports whether msg is one of the explicit exit keys\n377\t// honored on the post-finish dashboard. Ctrl+C is handled separately in the\n378\t// normal switch so duplicate-press semantics (cancelling → force-quit) still\n379\t// apply; here we only need q/Esc/Enter without modifiers.\n380\tfunc isPostFinishExitKey(msg tea.KeyPressMsg) bool {\n381\t\tif msg.Mod != 0 {\n382\t\t\treturn false\n383\t\t}\n384\t\tswitch msg.Code {\n385\t\tcase 'q', tea.KeyEnter, tea.KeyEscape:\n386\t\t\treturn true\n387\t\t}\n388\t\treturn false\n389\t}\n390\t\n391\t// View renders the current state.\n392\tfunc (m reviewTUIModel) View() tea.View {\n393\t\tvar content string\n394\t\tif m.detailMode && len(m.rows) > 0 {\n395\t\t\tcontent = detailFrame(m.rows[m.detailIdx], m.detail.View(), m.termWidth, m.termHeight)\n396\t\t} else {\n397\t\t\tcontent = m.dashboardView()\n398\t\t}\n399\t\tv := tea.NewView(content)\n400\t\tv.AltScreen = m.detailMode\n401\t\treturn v\n402\t}\n403\t\n404\t// dashboardView renders the summary table.\n405\tfunc (m reviewTUIModel) dashboardView() string {\n406\t\tvar b strings.Builder\n407\t\n408\t\tm.writeDashboardLine(&b, m.headerLine())\n409\t\n410\t\tfor _, row := range m.rows {\n411\t\t\tm.writeDashboardLine(&b, m.renderRow(row))\n412\t\t}\n413\t\tb.WriteString(\"\\n\")\n414\t\n415\t\tswitch {\n416\t\tcase m.finished:\n417\t\t\tm.writeDashboardLine(&b, m.countsLine())\n418\t\t\tm.writeDashboardLine(&b, \"Ctrl+O: drill in · q/Esc/Enter: exit\")\n419\t\tcase m.cancelling:\n420\t\t\tm.writeDashboardLine(&b, \"Cancelling agents... · Ctrl+C again: force quit\")\n421\t\tdefault:\n422\t\t\tm.writeDashboardLine(&b, \"Ctrl+O: drill in · Ctrl+C: cancel\")\n423\t\t}\n424\t\treturn b.String()\n425\t}\n426\t\n427\tfunc (m reviewTUIModel) writeDashboardLine(b *strings.Builder, line string) {\n428\t\tb.WriteString(truncateDisplayWidth(line, m.dashboardWidth()))\n429\t\tb.WriteString(\"\\n\")\n430\t}\n431\t\n432\tfunc (m reviewTUIModel) dashboardWidth() int {\n433\t\tif m.termWidth <= 0 {\n434\t\t\treturn 80\n435\t\t}\n436\t\treturn m.termWidth\n437\t}\n438\t\n439\t// headerLine returns the column header row.\n440\tfunc (m reviewTUIModel) headerLine() string {\n441\t\treturn m.renderTableLine(\"AGENT\", \"STATUS\", \"DURATION\", \"TOKENS\", \"PREVIEW\")\n442\t}\n443\t\n444\t// renderRow renders one agent row.\n445\tfunc (m reviewTUIModel) renderRow(row agentRow) string {\n446\t\tname := row.name\n447\t\n448\t\tvar statusStr string\n449\t\tswitch row.status {\n450\t\tcase reviewtypes.AgentStatusSucceeded:\n451\t\t\tstatusStr = \"✓ done\"\n452\t\tcase reviewtypes.AgentStatusFailed:\n453\t\t\tstatusStr = \"✗ failed\"\n454\t\tcase reviewtypes.AgentStatusCancelled:\n455\t\t\tstatusStr = \"— cancel\"\n456\t\tcase reviewtypes.AgentStatusUnknown:\n457\t\t\tswitch {\n458\t\t\tcase m.cancelling:\n459\t\t\t\t// In-flight cancellation: distinct from the terminal Cancelled\n460\t\t\t\t// state (\"— cancel\") so the user can see that the cancel signal\n461\t\t\t\t// has been sent but the agent is still draining.\n462\t\t\t\tstatusStr = \"cancelling\"\n463\t\t\tcase row.runStart.IsZero():\n464\t\t\t\tstatusStr = \"queued\"\n465\t\t\tdefault:\n466\t\t\t\tstatusStr = m.spinner.View() + \" running\"\n467\t\t\t}\n468\t\t}\n469\t\n470\t\tdurStr := \"\"\n471\t\tif !row.runStart.IsZero() {\n472\t\t\tif !row.runEnd.IsZero() {\n473\t\t\t\tdurStr = formatDuration(row.runEnd.Sub(row.runStart))\n474\t\t\t} else {\n475\t\t\t\tdurStr = formatDuration(time.Since(row.runStart))\n476\t\t\t}\n477\t\t}\n478\t\n479\t\ttokStr := \"\"\n480\t\tif row.tokens.In > 0 || row.tokens.Out > 0 {\n481\t\t\ttokStr = fmt.Sprintf(\"%s/%s\", formatCompact(row.tokens.In), formatCompact(row.tokens.Out))\n482\t\t}\n483\t\n484\t\treturn m.renderTableLine(name, statusStr, durStr, tokStr, row.preview)\n485\t}\n486\t\n487\tfunc (m reviewTUIModel) renderTableLine(agent, status, duration, tokens, preview string) string {\n488\t\tconst (\n489\t\t\tagentWidth    = 20\n490\t\t\tstatusWidth   = 10\n491\t\t\tdurationWidth = 8\n492\t\t\ttokensWidth   = 8\n493\t\t\tminWidth      = agentWidth + statusWidth + durationWidth + tokensWidth + 8 // four two-space separators\n494\t\t)\n495\t\ttermWidth := m.dashboardWidth()\n496\t\n497\t\tpreviewWidth := termWidth - minWidth\n498\t\tif previewWidth < 0 {\n499\t\t\tpreviewWidth = 0\n500\t\t}\n501\t\n502\t\tline := fmt.Sprintf(\"%s  %s  %s  %s  %s\",\n503\t\t\tpadDisplayWidth(agent, agentWidth),\n504\t\t\tpadDisplayWidth(status, statusWidth),\n505\t\t\tpadDisplayWidth(duration, durationWidth),\n506\t\t\tpadDisplayWidth(tokens, tokensWidth),\n507\t\t\ttruncateDisplayWidth(preview, previewWidth))\n508\t\treturn truncateDisplayWidth(line, termWidth)\n509\t}\n510\t\n511\t// countsLine produces the summary line shown after the run finishes.\n512\tfunc (m reviewTUIModel) countsLine() string {\n513\t\tsucc, fail, canc := 0, 0, 0\n514\t\tfor _, r := range m.summary.AgentRuns {\n515\t\t\tswitch r.Status {\n516\t\t\tcase reviewtypes.AgentStatusSucceeded:\n517\t\t\t\tsucc++\n518\t\t\tcase reviewtypes.AgentStatusFailed:\n519\t\t\t\tfail++\n520\t\t\tcase reviewtypes.AgentStatusCancelled:\n521\t\t\t\tcanc++\n522\t\t\tcase reviewtypes.AgentStatusUnknown:\n523\t\t\t\t// not counted\n524\t\t\t}\n525\t\t}\n526\t\treturn fmt.Sprintf(\"%d agent(s) done — %d succeeded, %d failed, %d cancelled\",\n527\t\t\tlen(m.summary.AgentRuns), succ, fail, canc)\n528\t}\n529\t\n530\t// formatDuration formats a duration compactly for the table column.\n531\tfunc formatDuration(d time.Duration) string {\n532\t\tif d < time.Second {\n533\t\t\treturn fmt.Sprintf(\"%dms\", d.Milliseconds())\n534\t\t}\n535\t\tif d < time.Minute {\n536\t\t\treturn fmt.Sprintf(\"%.1fs\", d.Seconds())\n537\t\t}\n538\t\treturn fmt.Sprintf(\"%dm%ds\", int(d.Minutes()), int(d.Seconds())%60)\n539\t}\n540\t\n541\t// formatCompact formats a token count as e.g. \"1.2k\" or \"450\".\n542\tfunc formatCompact(n int) string {\n543\t\tif n >= 1000 {\n544\t\t\treturn fmt.Sprintf(\"%.1fk\", float64(n)/1000)\n545\t\t}\n546\t\treturn strconv.Itoa(n)\n547\t}\n548\t"}]},"uuid":"9ee1ad40-4c3c-4d74-b697-15d1c27d7e3b","timestamp":"2026-05-11T23:05:43.755Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/tui_model.go","content":"// Package review — see env.go for package-level rationale.\n//\n// tui_model.go provides reviewTUIModel, the Bubble Tea Model for the\n// review dashboard. The model renders a per-agent status table\n// during the run and supports Ctrl+O drill-in mode for inspecting one agent's\n// live event buffer on the alt screen.\npackage review\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"charm.land/bubbles/v2/spinner\"\n\t\"charm.land/bubbles/v2/viewport\"\n\ttea \"charm.land/bubbletea/v2\"\n\t\"charm.land/lipgloss/v2\"\n\n\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/stringutil\"\n)\n\n// agentRow holds per-agent live state during the TUI run.\ntype agentRow struct {\n\tname     string\n\tstatus   reviewtypes.AgentStatus\n\trunStart time.Time          // stamped on first event from this agent\n\trunEnd   time.Time          // stamped on Finished/RunError event\n\ttokens   reviewtypes.Tokens // cumulative\n\tpreview  string             // latest AssistantText preview, capped by display width\n\tbuffer   []reviewtypes.Event\n\terr      error\n}\n\n// agentEventMsg is sent to the Bubble Tea program when an agent emits an event.\ntype agentEventMsg struct {\n\tagent string\n\tev    reviewtypes.Event\n}\n\n// runFinishedMsg is sent when the orchestrator calls RunFinished.\ntype runFinishedMsg struct {\n\tsummary reviewtypes.RunSummary\n}\n\n// tickMsg triggers spinner and duration column updates.\ntype tickMsg time.Time\n\n// reviewTUIModel is the Bubble Tea model for the review dashboard.\ntype reviewTUIModel struct {\n\trows       []agentRow\n\trowIdx     map[string]int // agent name → row index (O(1) lookup)\n\tdetailMode bool\n\tdetailIdx  int // which agent is shown in drill-in\n\t// detail is the pager backing the drill-in body. Width/Height are kept\n\t// in sync with termWidth/termHeight (minus header+footer). Scroll\n\t// position is internal state; AtBottom drives auto-tail.\n\tdetail viewport.Model\n\n\tcancel     context.CancelFunc\n\tcancelOnce *sync.Once\n\n\tspinner    spinner.Model\n\ttermWidth  int\n\ttermHeight int\n\n\tfinished bool\n\tsummary  reviewtypes.RunSummary\n\n\t// cancelling tracks whether a Ctrl+C-initiated cancellation is in flight.\n\t// Set true on the first Ctrl+C (in tandem with cancelOnce firing the shared\n\t// CancelFunc); the dashboard switches to a \"cancelling\" indicator and the\n\t// footer offers a force-quit hint. A second Ctrl+C while cancelling=true\n\t// force-quits without waiting for agents to drain.\n\tcancelling bool\n}\n\n// newReviewTUIModel builds an initial model pre-populated with one row per\n// agent. cancel is the shared CancelFunc; it must be the same one passed to\n// NewTUISink.\nfunc newReviewTUIModel(agents []string, cancel context.CancelFunc) reviewTUIModel {\n\tsp := spinner.New()\n\tsp.Spinner = spinner.Dot\n\tsp.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n\n\trows := make([]agentRow, len(agents))\n\trowIdx := make(map[string]int, len(agents))\n\tfor i, name := range agents {\n\t\trows[i] = agentRow{\n\t\t\tname:   name,\n\t\t\tstatus: reviewtypes.AgentStatusUnknown,\n\t\t}\n\t\trowIdx[name] = i\n\t}\n\t// Seed viewport with defaults that match termWidth/termHeight so an\n\t// immediate Ctrl+O before any WindowSizeMsg still renders.\n\tconst (\n\t\tdefaultTermWidth  = 80\n\t\tdefaultTermHeight = 24\n\t)\n\tvp := viewport.New(\n\t\tviewport.WithWidth(defaultTermWidth),\n\t\tviewport.WithHeight(defaultTermHeight-2),\n\t)\n\treturn reviewTUIModel{\n\t\trows:       rows,\n\t\trowIdx:     rowIdx,\n\t\tdetail:     vp,\n\t\tcancel:     cancel,\n\t\tcancelOnce: &sync.Once{},\n\t\tspinner:    sp,\n\t\ttermWidth:  defaultTermWidth,\n\t\ttermHeight: defaultTermHeight,\n\t}\n}\n\n// tickCmd schedules the next tick for duration/spinner refresh.\nfunc tickCmd() tea.Cmd {\n\treturn tea.Tick(100*time.Millisecond, func(t time.Time) tea.Msg {\n\t\treturn tickMsg(t)\n\t})\n}\n\n// Init returns the initial spinner tick command.\nfunc (m reviewTUIModel) Init() tea.Cmd {\n\treturn tea.Batch(m.spinner.Tick, tickCmd())\n}\n\n// Update handles all incoming messages.\nfunc (m reviewTUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n\tswitch msg := msg.(type) {\n\tcase agentEventMsg:\n\t\treturn m.handleAgentEvent(msg)\n\n\tcase runFinishedMsg:\n\t\tm.finished = true\n\t\tm.summary = msg.summary\n\t\t// Sync each row's status from the orchestrator's summary. The\n\t\t// in-stream events (Finished / RunError) update status as they\n\t\t// arrive, but the orchestrator's classifyStatus has access to\n\t\t// process-level signals (Wait error, ctx cancellation) that the\n\t\t// event stream never surfaces. Without this sync, an agent that\n\t\t// the orchestrator classified Cancelled (Ctrl+C path, no Finished\n\t\t// emitted) or Failed (process exit non-zero, no Finished emitted)\n\t\t// would still render as \"running\" in the final frame.\n\t\t//\n\t\t// Preserve any already-set status from the event stream — if the\n\t\t// stream said Failed (RunError), the summary may say Succeeded\n\t\t// (process exit 0); RunError stickiness wins. Only overwrite when\n\t\t// the row is still in AgentStatusUnknown.\n\t\tnow := time.Now()\n\t\tfor i, run := range msg.summary.AgentRuns {\n\t\t\tif i >= len(m.rows) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif m.rows[i].status == reviewtypes.AgentStatusUnknown {\n\t\t\t\tm.rows[i].status = run.Status\n\t\t\t}\n\t\t\tif m.rows[i].runEnd.IsZero() && !m.rows[i].runStart.IsZero() {\n\t\t\t\tm.rows[i].runEnd = now\n\t\t\t}\n\t\t}\n\t\treturn m, nil\n\n\tcase tickMsg:\n\t\tvar spinCmd tea.Cmd\n\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n\t\treturn m, tea.Batch(spinCmd, tickCmd())\n\n\tcase spinner.TickMsg:\n\t\tvar spinCmd tea.Cmd\n\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n\t\treturn m, spinCmd\n\n\tcase tea.WindowSizeMsg:\n\t\tm.termWidth = msg.Width\n\t\tm.termHeight = msg.Height\n\t\tm.detail.SetWidth(m.detailViewportWidth())\n\t\tm.detail.SetHeight(m.detailViewportHeight())\n\t\tm = m.refreshDetailContent()\n\t\treturn m, nil\n\n\tcase tea.KeyPressMsg:\n\t\treturn m.handleKey(msg)\n\t}\n\treturn m, nil\n}\n\n// detailViewportWidth returns the viewport's width, mirroring termWidth.\nfunc (m reviewTUIModel) detailViewportWidth() int {\n\tif m.termWidth < 1 {\n\t\treturn 1\n\t}\n\treturn m.termWidth\n}\n\n// detailViewportHeight returns the viewport's body height, reserving one line\n// for the header and one for the footer.\nfunc (m reviewTUIModel) detailViewportHeight() int {\n\th := m.termHeight - 2\n\tif h < 1 {\n\t\treturn 1\n\t}\n\treturn h\n}\n\n// refreshDetailContent re-renders the focused agent's events into the\n// viewport. It preserves auto-tail: if the viewport was sitting at the bottom\n// (or has no scrollable content), it jumps to the new bottom after the content\n// is replaced; otherwise the user's scroll position is left untouched.\n//\n// reviewTUIModel uses value receivers throughout (matching the Bubble Tea\n// idiom of returning an updated tea.Model from Update); the viewport is\n// mutated in place on the returned copy and the caller assigns the result\n// back.\nfunc (m reviewTUIModel) refreshDetailContent() reviewTUIModel {\n\tif len(m.rows) == 0 || m.detailIdx < 0 || m.detailIdx >= len(m.rows) {\n\t\tm.detail.SetContent(\"\")\n\t\treturn m\n\t}\n\twasAtBottom := m.detail.AtBottom()\n\tlines := buildEventLines(m.rows[m.detailIdx].buffer, m.detailViewportWidth())\n\tm.detail.SetContentLines(lines)\n\tif wasAtBottom {\n\t\tm.detail.GotoBottom()\n\t}\n\treturn m\n}\n\n// handleAgentEvent processes an agentEventMsg, updating the relevant row.\nfunc (m reviewTUIModel) handleAgentEvent(msg agentEventMsg) (tea.Model, tea.Cmd) {\n\tidx, ok := m.rowIdx[msg.agent]\n\tif !ok {\n\t\treturn m, nil\n\t}\n\trow := &m.rows[idx]\n\n\t// Stamp run-start on the first event from this agent (per-row, not\n\t// TUI-start; prevents inflated durations for late-starting agents).\n\tif row.runStart.IsZero() {\n\t\trow.runStart = time.Now()\n\t}\n\n\trow.buffer = append(row.buffer, msg.ev)\n\n\tswitch e := msg.ev.(type) {\n\tcase reviewtypes.Started:\n\t\t// runStart already set; no other state update needed.\n\tcase reviewtypes.AssistantText:\n\t\tcollapsed := stringutil.CollapseWhitespace(sanitizeDisplayText(e.Text))\n\t\trow.preview = truncateDisplayWidth(collapsed, 80)\n\tcase reviewtypes.Tokens:\n\t\trow.tokens = e // cumulative: overwrite, not sum\n\tcase reviewtypes.Finished:\n\t\t// RunError is sticky: if a prior RunError event already classified\n\t\t// this row as Failed, a subsequent Finished{Success: true} must NOT\n\t\t// flip it back to Succeeded. CU3's parser-fix-loop guarantees that\n\t\t// RunError + Finished{Success:false} both accompany torn streams;\n\t\t// matching that contract here keeps the TUI consistent with\n\t\t// classifyStatus from CU4 (which honors sawRunError).\n\t\tif row.status != reviewtypes.AgentStatusFailed {\n\t\t\tif e.Success {\n\t\t\t\trow.status = reviewtypes.AgentStatusSucceeded\n\t\t\t} else {\n\t\t\t\trow.status = reviewtypes.AgentStatusFailed\n\t\t\t}\n\t\t}\n\t\trow.runEnd = time.Now()\n\tcase reviewtypes.RunError:\n\t\trow.status = reviewtypes.AgentStatusFailed\n\t\trow.err = e.Err\n\t\tif row.runEnd.IsZero() {\n\t\t\trow.runEnd = time.Now()\n\t\t}\n\tcase reviewtypes.ToolCall:\n\t\t// No visible state update for tool calls in the dashboard.\n\t}\n\n\t// Re-render the focused agent's viewport content when a new event lands\n\t// for it. refreshDetailContent's AtBottom check preserves user scroll if\n\t// they've scrolled up; auto-tails otherwise.\n\tif m.detailMode && m.detailIdx == idx {\n\t\tm = m.refreshDetailContent()\n\t}\n\n\treturn m, nil\n}\n\n// handleKey processes keyboard input.\nfunc (m reviewTUIModel) handleKey(msg tea.KeyPressMsg) (tea.Model, tea.Cmd) {\n\t// Post-finish dashboard: only explicit exit keys dismiss. Any other key\n\t// (including Ctrl+O) falls through to normal handling so the user can\n\t// still drill into completed agent output. Ctrl+C also quits immediately\n\t// — there are no agents left to drain.\n\tif m.finished && !m.detailMode {\n\t\tif isPostFinishExitKey(msg) || (msg.Code == 'c' && msg.Mod == tea.ModCtrl) {\n\t\t\treturn m, tea.Quit\n\t\t}\n\t}\n\n\tswitch {\n\tcase msg.Code == 'c' && msg.Mod == tea.ModCtrl:\n\t\tif m.detailMode {\n\t\t\t// In drill-in: Ctrl+C is intentionally ignored; Esc first.\n\t\t\treturn m, nil\n\t\t}\n\t\t// Second Ctrl+C while a cancellation is already in flight force-quits\n\t\t// without waiting for agents to drain. The shared CancelFunc is\n\t\t// guarded by cancelOnce, so the second press doesn't double-cancel.\n\t\tif m.cancelling {\n\t\t\treturn m, tea.Quit\n\t\t}\n\t\tm.cancelling = true\n\t\tm.cancelOnce.Do(m.cancel)\n\t\t// Do NOT quit on the first Ctrl+C: leave the TUI up so the user sees\n\t\t// the cancelling indicator while agents drain. Natural finish\n\t\t// (runFinishedMsg) or a second Ctrl+C dismisses the TUI.\n\t\treturn m, nil\n\n\tcase msg.Code == 'o' && msg.Mod == tea.ModCtrl:\n\t\tif m.detailMode {\n\t\t\tm.detailMode = false\n\t\t\treturn m, nil\n\t\t}\n\t\tm.detailMode = true\n\t\tif len(m.rows) > 0 && (m.detailIdx < 0 || m.detailIdx >= len(m.rows)) {\n\t\t\tm.detailIdx = 0\n\t\t}\n\t\t// Resize viewport in case termWidth/termHeight have changed since\n\t\t// last detail-mode entry, then load the focused agent's events and\n\t\t// tail to the bottom.\n\t\tm.detail.SetWidth(m.detailViewportWidth())\n\t\tm.detail.SetHeight(m.detailViewportHeight())\n\t\tm = m.refreshDetailContent()\n\t\tm.detail.GotoBottom()\n\t\treturn m, nil\n\n\tcase msg.Code == tea.KeyEscape || msg.Code == tea.KeyEsc:\n\t\tif m.detailMode {\n\t\t\tm.detailMode = false\n\t\t\treturn m, nil\n\t\t}\n\t\treturn m, nil\n\n\tcase msg.Code == tea.KeyLeft:\n\t\tif m.detailMode && len(m.rows) > 0 {\n\t\t\tm.detailIdx = (m.detailIdx - 1 + len(m.rows)) % len(m.rows)\n\t\t\tm = m.refreshDetailContent()\n\t\t\tm.detail.GotoBottom()\n\t\t}\n\t\treturn m, nil\n\n\tcase msg.Code == tea.KeyRight:\n\t\tif m.detailMode && len(m.rows) > 0 {\n\t\t\tm.detailIdx = (m.detailIdx + 1) % len(m.rows)\n\t\t\tm = m.refreshDetailContent()\n\t\t\tm.detail.GotoBottom()\n\t\t}\n\t\treturn m, nil\n\t}\n\n\t// Delegate any unhandled key to the viewport so PgUp/PgDn/Home/End/↑/↓\n\t// reach its internal keymap. Only meaningful in detail mode — on the\n\t// dashboard the viewport is inert.\n\tif m.detailMode {\n\t\tvar cmd tea.Cmd\n\t\tm.detail, cmd = m.detail.Update(msg)\n\t\treturn m, cmd\n\t}\n\treturn m, nil\n}\n\n// isPostFinishExitKey reports whether msg is one of the explicit exit keys\n// honored on the post-finish dashboard. Ctrl+C is handled separately in the\n// normal switch so duplicate-press semantics (cancelling → force-quit) still\n// apply; here we only need q/Esc/Enter without modifiers.\nfunc isPostFinishExitKey(msg tea.KeyPressMsg) bool {\n\tif msg.Mod != 0 {\n\t\treturn false\n\t}\n\tswitch msg.Code {\n\tcase 'q', tea.KeyEnter, tea.KeyEscape:\n\t\treturn true\n\t}\n\treturn false\n}\n\n// View renders the current state.\nfunc (m reviewTUIModel) View() tea.View {\n\tvar content string\n\tif m.detailMode && len(m.rows) > 0 {\n\t\tcontent = detailFrame(m.rows[m.detailIdx], m.detail.View(), m.termWidth, m.termHeight)\n\t} else {\n\t\tcontent = m.dashboardView()\n\t}\n\tv := tea.NewView(content)\n\tv.AltScreen = m.detailMode\n\treturn v\n}\n\n// dashboardView renders the summary table.\nfunc (m reviewTUIModel) dashboardView() string {\n\tvar b strings.Builder\n\n\tm.writeDashboardLine(&b, m.headerLine())\n\n\tfor _, row := range m.rows {\n\t\tm.writeDashboardLine(&b, m.renderRow(row))\n\t}\n\tb.WriteString(\"\\n\")\n\n\tswitch {\n\tcase m.finished:\n\t\tm.writeDashboardLine(&b, m.countsLine())\n\t\tm.writeDashboardLine(&b, \"Ctrl+O: drill in · q/Esc/Enter: exit\")\n\tcase m.cancelling:\n\t\tm.writeDashboardLine(&b, \"Cancelling agents... · Ctrl+C again: force quit\")\n\tdefault:\n\t\tm.writeDashboardLine(&b, \"Ctrl+O: drill in · Ctrl+C: cancel\")\n\t}\n\treturn b.String()\n}\n\nfunc (m reviewTUIModel) writeDashboardLine(b *strings.Builder, line string) {\n\tb.WriteString(truncateDisplayWidth(line, m.dashboardWidth()))\n\tb.WriteString(\"\\n\")\n}\n\nfunc (m reviewTUIModel) dashboardWidth() int {\n\tif m.termWidth <= 0 {\n\t\treturn 80\n\t}\n\treturn m.termWidth\n}\n\n// headerLine returns the column header row.\nfunc (m reviewTUIModel) headerLine() string {\n\treturn m.renderTableLine(\"AGENT\", \"STATUS\", \"DURATION\", \"TOKENS\", \"PREVIEW\")\n}\n\n// renderRow renders one agent row.\nfunc (m reviewTUIModel) renderRow(row agentRow) string {\n\tname := row.name\n\n\tvar statusStr string\n\tswitch row.status {\n\tcase reviewtypes.AgentStatusSucceeded:\n\t\tstatusStr = \"✓ done\"\n\tcase reviewtypes.AgentStatusFailed:\n\t\tstatusStr = \"✗ failed\"\n\tcase reviewtypes.AgentStatusCancelled:\n\t\tstatusStr = \"— cancel\"\n\tcase reviewtypes.AgentStatusU