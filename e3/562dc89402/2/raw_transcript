{"parentUuid":"1b4d768c-17c3-485f-aebb-e200dd929d0e","isSidechain":false,"promptId":"de430c43-b0fc-42e4-ad8d-e0e0a5a9a6b0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M2E3iChwTg1RyK8dA7WH2P","type":"tool_result","content":"1\tpackage review\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"strings\"\n7\t\t\"sync/atomic\"\n8\t\t\"testing\"\n9\t\t\"time\"\n10\t\n11\t\ttea \"charm.land/bubbletea/v2\"\n12\t\t\"github.com/charmbracelet/x/ansi\"\n13\t\n14\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n15\t)\n16\t\n17\t// newTestModel returns a reviewTUIModel wired to the provided cancel stub.\n18\tfunc newTestModel(agents []string, cancel func()) reviewTUIModel {\n19\t\treturn newReviewTUIModel(agents, cancel)\n20\t}\n21\t\n22\tfunc testKey(code rune) tea.KeyPressMsg {\n23\t\treturn tea.KeyPressMsg{Code: code}\n24\t}\n25\t\n26\tfunc testCtrlKey(code rune) tea.KeyPressMsg {\n27\t\treturn tea.KeyPressMsg{Code: code, Mod: tea.ModCtrl}\n28\t}\n29\t\n30\t// mustModel extracts a reviewTUIModel from a tea.Model, failing the test if\n31\t// the assertion fails.\n32\tfunc mustModel(t *testing.T, m tea.Model) reviewTUIModel {\n33\t\tt.Helper()\n34\t\ttm, ok := m.(reviewTUIModel)\n35\t\tif !ok {\n36\t\t\tt.Fatalf(\"expected reviewTUIModel, got %T\", m)\n37\t\t}\n38\t\treturn tm\n39\t}\n40\t\n41\tfunc TestTUIModel_AgentEvent_StampsRunStartOnFirstEvent(t *testing.T) {\n42\t\tt.Parallel()\n43\t\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n44\t\n45\t\tbefore := time.Now()\n46\t\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Started{}})\n47\t\tafter := time.Now()\n48\t\n49\t\tm2 := mustModel(t, updated)\n50\t\trow := m2.rows[m2.rowIdx[\"agent-a\"]]\n51\t\tif row.runStart.IsZero() {\n52\t\t\tt.Fatal(\"runStart should be stamped after first event; got zero\")\n53\t\t}\n54\t\tif row.runStart.Before(before) || row.runStart.After(after) {\n55\t\t\tt.Errorf(\"runStart %v not in expected range [%v, %v]\", row.runStart, before, after)\n56\t\t}\n57\t\t// Second event should NOT update runStart.\n58\t\tfirstStart := row.runStart\n59\t\tupdated2, _ := m2.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Started{}})\n60\t\tm3 := mustModel(t, updated2)\n61\t\tif m3.rows[m3.rowIdx[\"agent-a\"]].runStart != firstStart {\n62\t\t\tt.Error(\"runStart should not be overwritten on subsequent events\")\n63\t\t}\n64\t}\n65\t\n66\tfunc TestTUIModel_AgentEvent_TokensOverwrite(t *testing.T) {\n67\t\tt.Parallel()\n68\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n69\t\n70\t\tupdated1, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Tokens{In: 100, Out: 50}})\n71\t\tm1 := mustModel(t, updated1)\n72\t\tupdated2, _ := m1.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Tokens{In: 200, Out: 80}})\n73\t\tm2 := mustModel(t, updated2)\n74\t\n75\t\trow := m2.rows[0]\n76\t\tif row.tokens.In != 200 || row.tokens.Out != 80 {\n77\t\t\tt.Errorf(\"expected tokens {200 80} after overwrite, got {%d %d}\", row.tokens.In, row.tokens.Out)\n78\t\t}\n79\t}\n80\t\n81\tfunc TestTUIModel_AgentEvent_FinishedSuccess(t *testing.T) {\n82\t\tt.Parallel()\n83\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n84\t\n85\t\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Finished{Success: true}})\n86\t\trow := mustModel(t, updated).rows[0]\n87\t\tif row.status != reviewtypes.AgentStatusSucceeded {\n88\t\t\tt.Errorf(\"expected Succeeded, got %v\", row.status)\n89\t\t}\n90\t\tif row.runEnd.IsZero() {\n91\t\t\tt.Error(\"runEnd should be stamped on Finished\")\n92\t\t}\n93\t}\n94\t\n95\tfunc TestTUIModel_AgentEvent_FinishedFailure(t *testing.T) {\n96\t\tt.Parallel()\n97\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n98\t\n99\t\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Finished{Success: false}})\n100\t\trow := mustModel(t, updated).rows[0]\n101\t\tif row.status != reviewtypes.AgentStatusFailed {\n102\t\t\tt.Errorf(\"expected Failed, got %v\", row.status)\n103\t\t}\n104\t}\n105\t\n106\tfunc TestTUIModel_AgentEvent_RunError(t *testing.T) {\n107\t\tt.Parallel()\n108\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n109\t\n110\t\ttheErr := errors.New(\"agent crashed\")\n111\t\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.RunError{Err: theErr}})\n112\t\trow := mustModel(t, updated).rows[0]\n113\t\tif row.status != reviewtypes.AgentStatusFailed {\n114\t\t\tt.Errorf(\"expected Failed on RunError, got %v\", row.status)\n115\t\t}\n116\t\tif row.err == nil {\n117\t\t\tt.Error(\"row.err should be set after RunError\")\n118\t\t}\n119\t}\n120\t\n121\tfunc TestTUIModel_KeyCtrlC_NotDetailMode_CancelsAndMarksCancelling(t *testing.T) {\n122\t\tt.Parallel()\n123\t\tvar called atomic.Bool\n124\t\tcancel := func() { called.Store(true) }\n125\t\n126\t\tm := newTestModel([]string{\"agent-a\"}, cancel)\n127\t\tupdated, cmd := m.Update(testCtrlKey('c'))\n128\t\tif !called.Load() {\n129\t\t\tt.Error(\"expected cancel to be called on Ctrl+C outside detail mode\")\n130\t\t}\n131\t\tm2 := mustModel(t, updated)\n132\t\tif !m2.cancelling {\n133\t\t\tt.Error(\"expected m.cancelling=true after first Ctrl+C\")\n134\t\t}\n135\t\t// First Ctrl+C must NOT quit — the TUI stays up so agents can drain\n136\t\t// visibly. Only a second Ctrl+C (or natural finish) dismisses.\n137\t\tif cmd != nil {\n138\t\t\tif msg := cmd(); msg != nil {\n139\t\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n140\t\t\t\t\tt.Error(\"first Ctrl+C must NOT send a quit command; it should wait for agents to drain\")\n141\t\t\t\t}\n142\t\t\t}\n143\t\t}\n144\t}\n145\t\n146\tfunc TestTUIModel_KeyCtrlC_DetailMode_Ignored(t *testing.T) {\n147\t\tt.Parallel()\n148\t\tvar called atomic.Bool\n149\t\tcancel := func() { called.Store(true) }\n150\t\n151\t\tm := newTestModel([]string{\"agent-a\"}, cancel)\n152\t\tm.detailMode = true\n153\t\n154\t\t_, cmd := m.Update(testCtrlKey('c'))\n155\t\tif called.Load() {\n156\t\t\tt.Error(\"cancel must NOT be called when Ctrl+C is pressed in detail mode\")\n157\t\t}\n158\t\tif cmd != nil {\n159\t\t\t// Command should be nil (no quit).\n160\t\t\tif msg := cmd(); msg != nil {\n161\t\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n162\t\t\t\t\tt.Error(\"Ctrl+C in detail mode must not send a quit command\")\n163\t\t\t\t}\n164\t\t\t}\n165\t\t}\n166\t}\n167\t\n168\tfunc TestTUIModel_CancelOnce_DuplicateKeyCtrlC(t *testing.T) {\n169\t\tt.Parallel()\n170\t\tvar count atomic.Int32\n171\t\tcancel := func() { count.Add(1) }\n172\t\n173\t\tm := newTestModel([]string{\"agent-a\"}, cancel)\n174\t\t_, _ = m.Update(testCtrlKey('c'))\n175\t\t_, _ = m.Update(testCtrlKey('c'))\n176\t\tif count.Load() != 1 {\n177\t\t\tt.Errorf(\"cancel should fire exactly once even on duplicate Ctrl+C; called %d time(s)\", count.Load())\n178\t\t}\n179\t}\n180\t\n181\tfunc TestTUIModel_KeyCtrlO_EntersDrillIn(t *testing.T) {\n182\t\tt.Parallel()\n183\t\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n184\t\n185\t\tupdated, cmd := m.Update(testCtrlKey('o'))\n186\t\tm2 := mustModel(t, updated)\n187\t\tif !m2.detailMode {\n188\t\t\tt.Error(\"expected detailMode=true after Ctrl+O\")\n189\t\t}\n190\t\tif cmd != nil {\n191\t\t\tt.Error(\"Ctrl+O should not return an alt-screen command in Bubble Tea v2\")\n192\t\t}\n193\t\tif !m2.View().AltScreen {\n194\t\t\tt.Error(\"expected View().AltScreen=true in detail mode\")\n195\t\t}\n196\t}\n197\t\n198\tfunc TestTUIModel_KeyEsc_ExitsDrillIn(t *testing.T) {\n199\t\tt.Parallel()\n200\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n201\t\tm.detailMode = true\n202\t\n203\t\tupdated, cmd := m.Update(testKey(tea.KeyEscape))\n204\t\tm2 := mustModel(t, updated)\n205\t\tif m2.detailMode {\n206\t\t\tt.Error(\"expected detailMode=false after Esc\")\n207\t\t}\n208\t\tif cmd != nil {\n209\t\t\tt.Error(\"Esc should not return an alt-screen command in Bubble Tea v2\")\n210\t\t}\n211\t\tif m2.View().AltScreen {\n212\t\t\tt.Error(\"expected View().AltScreen=false outside detail mode\")\n213\t\t}\n214\t}\n215\t\n216\tfunc TestTUIModel_LeftRight_CycleDetailIdx(t *testing.T) {\n217\t\tt.Parallel()\n218\t\tagents := []string{\"a\", \"b\", \"c\"}\n219\t\tm := newTestModel(agents, func() {})\n220\t\tm.detailMode = true\n221\t\tm.detailIdx = 0\n222\t\n223\t\t// Right: 0 → 1 → 2 → 0 (wrap).\n224\t\tfor _, wantIdx := range []int{1, 2, 0} {\n225\t\t\tupdated, _ := m.Update(testKey(tea.KeyRight))\n226\t\t\tm = mustModel(t, updated)\n227\t\t\tif m.detailIdx != wantIdx {\n228\t\t\t\tt.Errorf(\"after Right: want detailIdx=%d, got %d\", wantIdx, m.detailIdx)\n229\t\t\t}\n230\t\t}\n231\t\n232\t\t// Left: 0 → 2 (wrap).\n233\t\tupdated, _ := m.Update(testKey(tea.KeyLeft))\n234\t\tm = mustModel(t, updated)\n235\t\tif m.detailIdx != 2 {\n236\t\t\tt.Errorf(\"after Left from 0: want detailIdx=2, got %d\", m.detailIdx)\n237\t\t}\n238\t}\n239\t\n240\t// TestTUIModel_InitializesDetailViewport pins that the viewport widget on the\n241\t// model starts with non-zero default dimensions so that an immediate Ctrl+O\n242\t// before a WindowSizeMsg still renders without panicking.\n243\tfunc TestTUIModel_InitializesDetailViewport(t *testing.T) {\n244\t\tt.Parallel()\n245\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n246\t\tif w := m.detail.Width(); w <= 0 {\n247\t\t\tt.Errorf(\"expected detail viewport width > 0, got %d\", w)\n248\t\t}\n249\t\tif h := m.detail.Height(); h <= 0 {\n250\t\t\tt.Errorf(\"expected detail viewport height > 0, got %d\", h)\n251\t\t}\n252\t}\n253\t\n254\t// TestTUIModel_DelegatesScrollKeysToViewport pins that pager keys (PgDn) in\n255\t// detail mode reach the viewport's internal keymap and advance YOffset rather\n256\t// than being swallowed by the model's switch.\n257\tfunc TestTUIModel_DelegatesScrollKeysToViewport(t *testing.T) {\n258\t\tt.Parallel()\n259\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n260\t\t// Size the window so the viewport has a sensible height.\n261\t\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 40, Height: 10})\n262\t\tm = mustModel(t, updated)\n263\t\t// Populate enough content to scroll. AssistantText with long text wraps\n264\t\t// to many viewport lines.\n265\t\tlong := strings.Repeat(\"paragraph of text \", 20)\n266\t\tfor range 5 {\n267\t\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n268\t\t\tm = mustModel(t, updated)\n269\t\t}\n270\t\t// Enter detail mode (auto-tails to bottom).\n271\t\tupdated, _ = m.Update(testCtrlKey('o'))\n272\t\tm = mustModel(t, updated)\n273\t\t// Jump to top so PgDn has somewhere to scroll into.\n274\t\tm.detail.GotoTop()\n275\t\tstartOffset := m.detail.YOffset()\n276\t\n277\t\tupdated, _ = m.Update(tea.KeyPressMsg{Code: tea.KeyPgDown})\n278\t\tm = mustModel(t, updated)\n279\t\tif m.detail.YOffset() <= startOffset {\n280\t\t\tt.Errorf(\"expected PgDn to advance viewport YOffset beyond %d; got %d\", startOffset, m.detail.YOffset())\n281\t\t}\n282\t}\n283\t\n284\tfunc TestTUIModel_WindowSizeMsg_UpdatesDimensions(t *testing.T) {\n285\t\tt.Parallel()\n286\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n287\t\n288\t\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 120, Height: 40})\n289\t\tm2 := mustModel(t, updated)\n290\t\tif m2.termWidth != 120 || m2.termHeight != 40 {\n291\t\t\tt.Errorf(\"expected 120×40, got %d×%d\", m2.termWidth, m2.termHeight)\n292\t\t}\n293\t}\n294\t\n295\tfunc TestTUIModel_TickMsg_ReSchedulesTick(t *testing.T) {\n296\t\tt.Parallel()\n297\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n298\t\n299\t\t_, cmd := m.Update(tickMsg(time.Now()))\n300\t\tif cmd == nil {\n301\t\t\tt.Error(\"tickMsg should return a non-nil command (re-tick)\")\n302\t\t}\n303\t}\n304\t\n305\tfunc TestTUIModel_RunFinishedMsg_MarksFinished(t *testing.T) {\n306\t\tt.Parallel()\n307\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n308\t\n309\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n310\t\tm2 := mustModel(t, updated)\n311\t\tif !m2.finished {\n312\t\t\tt.Error(\"model should be finished after runFinishedMsg\")\n313\t\t}\n314\t}\n315\t\n316\t// TestTUIModel_PostFinishCtrlOEntersDetailMode pins that Ctrl+O still enters\n317\t// drill-in after both agents finish so the user can inspect completed output.\n318\t// Previously any-key-quits behavior swallowed Ctrl+O on the post-finish frame.\n319\tfunc TestTUIModel_PostFinishCtrlOEntersDetailMode(t *testing.T) {\n320\t\tt.Parallel()\n321\t\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n322\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n323\t\tm = mustModel(t, updated)\n324\t\tif !m.finished {\n325\t\t\tt.Fatal(\"setup: expected model finished after runFinishedMsg\")\n326\t\t}\n327\t\n328\t\tupdated, cmd := m.Update(testCtrlKey('o'))\n329\t\tm2 := mustModel(t, updated)\n330\t\tif !m2.detailMode {\n331\t\t\tt.Error(\"expected Ctrl+O post-finish to enter detail mode\")\n332\t\t}\n333\t\t// Ctrl+O must NOT quit post-finish.\n334\t\tif cmd != nil {\n335\t\t\tif msg := cmd(); msg != nil {\n336\t\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n337\t\t\t\t\tt.Error(\"Ctrl+O post-finish must not produce a quit command\")\n338\t\t\t\t}\n339\t\t\t}\n340\t\t}\n341\t}\n342\t\n343\t// TestTUIModel_PostFinishQuitsOnExplicitKeys pins that q, Esc, Enter, and Ctrl+C\n344\t// each produce tea.QuitMsg when finished and in dashboard mode.\n345\tfunc TestTUIModel_PostFinishQuitsOnExplicitKeys(t *testing.T) {\n346\t\tt.Parallel()\n347\t\tcases := []struct {\n348\t\t\tname string\n349\t\t\tkey  tea.KeyPressMsg\n350\t\t}{\n351\t\t\t{\"q\", testKey('q')},\n352\t\t\t{\"Esc\", testKey(tea.KeyEscape)},\n353\t\t\t{\"Enter\", testKey(tea.KeyEnter)},\n354\t\t\t{\"Ctrl+C\", testCtrlKey('c')},\n355\t\t}\n356\t\tfor _, tc := range cases {\n357\t\t\tt.Run(tc.name, func(t *testing.T) {\n358\t\t\t\tt.Parallel()\n359\t\t\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n360\t\t\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n361\t\t\t\tm = mustModel(t, updated)\n362\t\n363\t\t\t\t_, cmd := m.Update(tc.key)\n364\t\t\t\tif cmd == nil {\n365\t\t\t\t\tt.Fatalf(\"expected a command for explicit-exit key %q post-finish\", tc.name)\n366\t\t\t\t}\n367\t\t\t\tmsg := cmd()\n368\t\t\t\tif _, ok := msg.(tea.QuitMsg); !ok {\n369\t\t\t\t\tt.Errorf(\"expected tea.QuitMsg for key %q post-finish, got %T\", tc.name, msg)\n370\t\t\t\t}\n371\t\t\t})\n372\t\t}\n373\t}\n374\t\n375\t// TestTUIModel_PostFinishIgnoresRandomKeys pins that non-exit keys (e.g. 'x',\n376\t// arrow keys) do NOT quit when finished on the dashboard. They fall through to\n377\t// normal handling instead of the old any-key-quits shortcut.\n378\tfunc TestTUIModel_PostFinishIgnoresRandomKeys(t *testing.T) {\n379\t\tt.Parallel()\n380\t\tcases := []struct {\n381\t\t\tname string\n382\t\t\tkey  tea.KeyPressMsg\n383\t\t}{\n384\t\t\t{\"x\", testKey('x')},\n385\t\t\t{\"Right\", testKey(tea.KeyRight)},\n386\t\t\t{\"Left\", testKey(tea.KeyLeft)},\n387\t\t}\n388\t\tfor _, tc := range cases {\n389\t\t\tt.Run(tc.name, func(t *testing.T) {\n390\t\t\t\tt.Parallel()\n391\t\t\t\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n392\t\t\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n393\t\t\t\tm = mustModel(t, updated)\n394\t\n395\t\t\t\t_, cmd := m.Update(tc.key)\n396\t\t\t\tif cmd != nil {\n397\t\t\t\t\tif msg := cmd(); msg != nil {\n398\t\t\t\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n399\t\t\t\t\t\t\tt.Errorf(\"key %q must not quit post-finish on dashboard\", tc.name)\n400\t\t\t\t\t\t}\n401\t\t\t\t\t}\n402\t\t\t\t}\n403\t\t\t})\n404\t\t}\n405\t}\n406\t\n407\t// TestTUIModel_PostFinishFooterUsesExplicitExitKeys pins the dashboard footer\n408\t// switches from the old \"Press any key to exit.\" prompt to an explicit-keys\n409\t// hint that mentions Ctrl+O and the named exit keys.\n410\tfunc TestTUIModel_PostFinishFooterUsesExplicitExitKeys(t *testing.T) {\n411\t\tt.Parallel()\n412\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n413\t\tm.termWidth = 120\n414\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n415\t\tm = mustModel(t, updated)\n416\t\n417\t\tout := m.dashboardView()\n418\t\tif strings.Contains(out, \"Press any key to exit.\") {\n419\t\t\tt.Errorf(\"post-finish footer must not show legacy 'Press any key to exit.' line:\\n%s\", out)\n420\t\t}\n421\t\tif !strings.Contains(out, \"Ctrl+O\") {\n422\t\t\tt.Errorf(\"post-finish footer should mention Ctrl+O for drill-in:\\n%s\", out)\n423\t\t}\n424\t\tif !strings.Contains(out, \"q/Esc/Enter\") {\n425\t\t\tt.Errorf(\"post-finish footer should list q/Esc/Enter as exit keys:\\n%s\", out)\n426\t\t}\n427\t}\n428\t\n429\t// TestTUIModel_CtrlCMarksAgentsCancelling pins that the first Ctrl+C while\n430\t// agents are still running sets m.cancelling and renderRow reflects an\n431\t// in-flight cancellation indicator (distinct from the terminal Cancelled\n432\t// state).\n433\tfunc TestTUIModel_CtrlCMarksAgentsCancelling(t *testing.T) {\n434\t\tt.Parallel()\n435\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n436\t\t// Stamp runStart so the row is in the running branch of renderRow.\n437\t\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Started{}})\n438\t\tm = mustModel(t, updated)\n439\t\tm.termWidth = 120\n440\t\n441\t\t// Before Ctrl+C the running row should say \"running\".\n442\t\tif status := m.renderRow(m.rows[0]); !strings.Contains(status, \"running\") {\n443\t\t\tt.Fatalf(\"setup: expected running indicator pre-Ctrl+C; got %q\", status)\n444\t\t}\n445\t\n446\t\tupdated, _ = m.Update(testCtrlKey('c'))\n447\t\tm = mustModel(t, updated)\n448\t\tif !m.cancelling {\n449\t\t\tt.Fatal(\"expected m.cancelling=true after first Ctrl+C\")\n450\t\t}\n451\t\n452\t\tgot := m.renderRow(m.rows[0])\n453\t\tif strings.Contains(got, \"running\") {\n454\t\t\tt.Errorf(\"renderRow should drop the 'running' indicator once cancelling; got %q\", got)\n455\t\t}\n456\t\tif !strings.Contains(got, \"cancel\") {\n457\t\t\tt.Errorf(\"renderRow should show a cancelling indicator; got %q\", got)\n458\t\t}\n459\t}\n460\t\n461\t// TestTUIModel_FooterDuringCancellation pins that the dashboard footer changes\n462\t// while a cancel is in flight (cancelling && !finished) to signal the user\n463\t// that draining is in progress and a second Ctrl+C will force quit.\n464\tfunc TestTUIModel_FooterDuringCancellation(t *testing.T) {\n465\t\tt.Parallel()\n466\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n467\t\tm.termWidth = 120\n468\t\tupdated, _ := m.Update(testCtrlKey('c'))\n469\t\tm = mustModel(t, updated)\n470\t\n471\t\tout := m.dashboardView()\n472\t\tif !strings.Contains(out, \"Cancelling agents\") {\n473\t\t\tt.Errorf(\"expected footer to announce cancellation in progress; got:\\n%s\", out)\n474\t\t}\n475\t\tif !strings.Contains(out, \"Ctrl+C again\") {\n476\t\t\tt.Errorf(\"expected footer to mention force-quit hint; got:\\n%s\", out)\n477\t\t}\n478\t}\n479\t\n480\t// TestTUIModel_SecondCtrlCForceQuits pins that once cancelling is in flight,\n481\t// a second Ctrl+C emits tea.QuitMsg immediately rather than waiting for\n482\t// agents to drain.\n483\tfunc TestTUIModel_SecondCtrlCForceQuits(t *testing.T) {\n484\t\tt.Parallel()\n485\t\tvar count atomic.Int32\n486\t\tcancel := func() { count.Add(1) }\n487\t\n488\t\tm := newTestModel([]string{\"agent-a\"}, cancel)\n489\t\tupdated, _ := m.Update(testCtrlKey('c'))\n490\t\tm = mustModel(t, updated)\n491\t\tif !m.cancelling {\n492\t\t\tt.Fatal(\"setup: expected cancelling=true after first Ctrl+C\")\n493\t\t}\n494\t\n495\t\t_, cmd := m.Update(testCtrlKey('c'))\n496\t\tif cmd == nil {\n497\t\t\tt.Fatal(\"expected a command from second Ctrl+C\")\n498\t\t}\n499\t\tmsg := cmd()\n500\t\tif _, ok := msg.(tea.QuitMsg); !ok {\n501\t\t\tt.Errorf(\"expected tea.QuitMsg from second Ctrl+C, got %T\", msg)\n502\t\t}\n503\t\t// Shared CancelFunc still fires at most once thanks to cancelOnce.\n504\t\tif got := count.Load(); got != 1 {\n505\t\t\tt.Errorf(\"CancelFunc should fire exactly once across both Ctrl+Cs; got %d\", got)\n506\t\t}\n507\t}\n508\t\n509\t// TestTUIModel_AutoFollow_DetailMode pins that when the viewport is sitting\n510\t// at the bottom and a new event arrives, the model snaps back to bottom so\n511\t// the user keeps seeing the tail. The viewport's AtBottom() drives this.\n512\tfunc TestTUIModel_AutoFollow_DetailMode(t *testing.T) {\n513\t\tt.Parallel()\n514\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n515\t\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 40, Height: 8})\n516\t\tm = mustModel(t, updated)\n517\t\tupdated, _ = m.Update(testCtrlKey('o'))\n518\t\tm = mustModel(t, updated)\n519\t\n520\t\t// Send events that produce content taller than the viewport so a tail\n521\t\t// exists below the visible window.\n522\t\tlong := strings.Repeat(\"review finding \", 10)\n523\t\tfor range 6 {\n524\t\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n525\t\t\tm = mustModel(t, updated)\n526\t\t}\n527\t\tif !m.detail.AtBottom() {\n528\t\t\tt.Errorf(\"expected viewport to track bottom after each event (auto-follow); YOffset=%d, total=%d\",\n529\t\t\t\tm.detail.YOffset(), m.detail.TotalLineCount())\n530\t\t}\n531\t}\n532\t\n533\tfunc TestTUIModel_View_DashboardMode(t *testing.T) {\n534\t\tt.Parallel()\n535\t\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n536\t\n537\t\tv := m.View()\n538\t\tif v.Content == \"\" {\n539\t\t\tt.Error(\"View() should not return empty string\")\n540\t\t}\n541\t\t// Should contain agent names.\n542\t\tfor _, name := range []string{\"agent-a\", \"agent-b\"} {\n543\t\t\tif !strings.Contains(v.Content, name) {\n544\t\t\t\tt.Errorf(\"View() missing agent %q\", name)\n545\t\t\t}\n546\t\t}\n547\t}\n548\t\n549\tfunc TestTUIModel_DashboardLinesFitTerminalWidth(t *testing.T) {\n550\t\tt.Parallel()\n551\t\n552\t\tfor _, width := range []int{1, 2, 10, 20, 24, 30, 40, 53, 54, 55, 60, 80, 120} {\n553\t\t\tt.Run(fmt.Sprintf(\"running width %d\", width), func(t *testing.T) {\n554\t\t\t\tt.Parallel()\n555\t\t\t\tm := runningDashboardModel(t, width)\n556\t\t\t\tassertDashboardFitsWidth(t, m)\n557\t\t\t})\n558\t\t\tt.Run(fmt.Sprintf(\"finished width %d\", width), func(t *testing.T) {\n559\t\t\t\tt.Parallel()\n560\t\t\t\tm := runningDashboardModel(t, width)\n561\t\t\t\tfor _, name := range []string{\"claude-code-with-a-long-name\", \"codex\"} {\n562\t\t\t\t\tupdated, _ := m.Update(agentEventMsg{agent: name, ev: reviewtypes.Finished{Success: true}})\n563\t\t\t\t\tm = mustModel(t, updated)\n564\t\t\t\t}\n565\t\t\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{\n566\t\t\t\t\tAgentRuns: []reviewtypes.AgentRun{\n567\t\t\t\t\t\t{Name: \"claude-code-with-a-long-name\", Status: reviewtypes.AgentStatusSucceeded},\n568\t\t\t\t\t\t{Name: \"codex\", Status: reviewtypes.AgentStatusSucceeded},\n569\t\t\t\t\t},\n570\t\t\t\t}})\n571\t\t\t\tm = mustModel(t, updated)\n572\t\t\t\tassertDashboardFitsWidth(t, m)\n573\t\t\t})\n574\t\t}\n575\t}\n576\t\n577\tfunc TestTUIModel_DashboardPreviewStripsControlSequences(t *testing.T) {\n578\t\tt.Parallel()\n579\t\tm := newReviewTUIModel([]string{\"codex\"}, nil)\n580\t\tm.termWidth = 80\n581\t\n582\t\tupdated, _ := m.Update(agentEventMsg{\n583\t\t\tagent: \"codex\",\n584\t\t\tev:    reviewtypes.AssistantText{Text: \"hello\\x1b[?25lworld\\x1b[?25h\"},\n585\t\t})\n586\t\tm = mustModel(t, updated)\n587\t\tout := m.dashboardView()\n588\t\n589\t\tif strings.Contains(out, \"\\x1b[?25\") {\n590\t\t\tt.Fatalf(\"dashboard preview leaked control sequence:\\n%q\", out)\n591\t\t}\n592\t\tif !strings.Contains(out, \"helloworld\") {\n593\t\t\tt.Fatalf(\"dashboard preview missing stripped text:\\n%s\", out)\n594\t\t}\n595\t}\n596\t\n597\tfunc TestTUIModel_WindowResizeKeepsDashboardWithinNewWidth(t *testing.T) {\n598\t\tt.Parallel()\n599\t\tm := runningDashboardModel(t, 120)\n600\t\n601\t\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 30, Height: 24})\n602\t\tm = mustModel(t, updated)\n603\t\n604\t\tassertDashboardFitsWidth(t, m)\n605\t}\n606\t\n607\tfunc runningDashboardModel(t *testing.T, width int) reviewTUIModel {\n608\t\tt.Helper()\n609\t\tm := newReviewTUIModel([]string{\"claude-code-with-a-long-name\", \"codex\"}, nil)\n610\t\tm.termWidth = width\n611\t\n612\t\tlongPreview := strings.Repeat(\"review finding with enough text to overflow \", 4)\n613\t\tfor _, name := range []string{\"claude-code-with-a-long-name\", \"codex\"} {\n614\t\t\tupdated, _ := m.Update(agentEventMsg{agent: name, ev: reviewtypes.Started{}})\n615\t\t\tm = mustModel(t, updated)\n616\t\t\tupdated, _ = m.Update(agentEventMsg{agent: name, ev: reviewtypes.Tokens{In: 1_234_567, Out: 987_654}})\n617\t\t\tm = mustModel(t, updated)\n618\t\t\tupdated, _ = m.Update(agentEventMsg{agent: name, ev: reviewtypes.AssistantText{Text: longPreview}})\n619\t\t\tm = mustModel(t, updated)\n620\t\t}\n621\t\treturn m\n622\t}\n623\t\n624\tfunc assertDashboardFitsWidth(t *testing.T, m reviewTUIModel) {\n625\t\tt.Helper()\n626\t\tfor _, line := range strings.Split(strings.TrimSuffix(m.dashboardView(), \"\\n\"), \"\\n\") {\n627\t\t\tif got := ansi.StringWidth(line); got > m.termWidth {\n628\t\t\t\tt.Fatalf(\"dashboard line width = %d, want <= %d:\\n%s\", got, m.termWidth, line)\n629\t\t\t}\n630\t\t}\n631\t}\n632\t\n633\t// TestTUIModel_AutoFollow_PreservesUserScroll pins the contract that new\n634\t// agent events must NOT yank the user back to the tail when they have\n635\t// scrolled up to inspect older events. Auto-follow only re-engages when\n636\t// the viewport is already at the bottom.\n637\tfunc TestTUIModel_AutoFollow_PreservesUserScroll(t *testing.T) {\n638\t\tt.Parallel()\n639\t\tm := newReviewTUIModel([]string{\"agent-a\"}, nil)\n640\t\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 40, Height: 10})\n641\t\tm = mustModel(t, updated)\n642\t\tupdated, _ = m.Update(testCtrlKey('o'))\n643\t\tm = mustModel(t, updated)\n644\t\n645\t\t// Build up enough wrapped content to overflow the viewport several times.\n646\t\tlong := strings.Repeat(\"line of review text \", 10)\n647\t\tfor range 20 {\n648\t\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n649\t\t\tm = mustModel(t, updated)\n650\t\t}\n651\t\n652\t\t// Scroll up away from the bottom.\n653\t\tm.detail.GotoTop()\n654\t\tstartOffset := m.detail.YOffset()\n655\t\tif m.detail.AtBottom() {\n656\t\t\tt.Fatal(\"test setup: viewport unexpectedly at bottom after GotoTop\")\n657\t\t}\n658\t\n659\t\t// Send another event — the user is NOT at the bottom, so YOffset must not move.\n660\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n661\t\tm = mustModel(t, updated)\n662\t\tif m.detail.YOffset() != startOffset {\n663\t\t\tt.Errorf(\"expected viewport YOffset to stay at %d (user scrolled up); got %d (auto-follow yanked back)\",\n664\t\t\t\tstartOffset, m.detail.YOffset())\n665\t\t}\n666\t\n667\t\t// Now jump to bottom and send another event — should auto-follow.\n668\t\tm.detail.GotoBottom()\n669\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n670\t\tm = mustModel(t, updated)\n671\t\tif !m.detail.AtBottom() {\n672\t\t\tt.Errorf(\"expected auto-follow to track bottom after event; YOffset=%d, total=%d\",\n673\t\t\t\tm.detail.YOffset(), m.detail.TotalLineCount())\n674\t\t}\n675\t}\n676\t\n677\t// TestTUIModel_RunFinishedMsg_SyncsStatusFromSummary pins the contract\n678\t// that the final dashboard frame reflects the orchestrator's classified\n679\t// status, not the in-stream event status alone. Without this sync, an\n680\t// agent the orchestrator classified Cancelled (Ctrl+C, no Finished\n681\t// emitted) would still appear \"running\" in the final frame.\n682\tfunc TestTUIModel_RunFinishedMsg_SyncsStatusFromSummary(t *testing.T) {\n683\t\tt.Parallel()\n684\t\tm := newReviewTUIModel([]string{\"agent-a\", \"agent-b\"}, nil)\n685\t\n686\t\t// Stamp runStart for both via a Started event each.\n687\t\tfor _, name := range []string{\"agent-a\", \"agent-b\"} {\n688\t\t\tupdated, _ := m.Update(agentEventMsg{agent: name, ev: reviewtypes.Started{}})\n689\t\t\tm = mustModel(t, updated)\n690\t\t}\n691\t\n692\t\t// Both rows should still be Unknown (no Finished/RunError seen).\n693\t\tif m.rows[0].status != reviewtypes.AgentStatusUnknown {\n694\t\t\tt.Fatalf(\"expected agent-a Unknown pre-finish, got %v\", m.rows[0].status)\n695\t\t}\n696\t\n697\t\t// Send runFinishedMsg with summary that classifies a=Cancelled, b=Failed.\n698\t\tsummary := reviewtypes.RunSummary{\n699\t\t\tAgentRuns: []reviewtypes.AgentRun{\n700\t\t\t\t{Name: \"agent-a\", Status: reviewtypes.AgentStatusCancelled},\n701\t\t\t\t{Name: \"agent-b\", Status: reviewtypes.AgentStatusFailed},\n702\t\t\t},\n703\t\t}\n704\t\tupdated, _ := m.Update(runFinishedMsg{summary: summary})\n705\t\tm = mustModel(t, updated)\n706\t\n707\t\tif m.rows[0].status != reviewtypes.AgentStatusCancelled {\n708\t\t\tt.Errorf(\"expected agent-a synced to Cancelled, got %v\", m.rows[0].status)\n709\t\t}\n710\t\tif m.rows[1].status != reviewtypes.AgentStatusFailed {\n711\t\t\tt.Errorf(\"expected agent-b synced to Failed, got %v\", m.rows[1].status)\n712\t\t}\n713\t}\n714\t\n715\t// TestTUIModel_RunErrorSticky_FinishedDoesNotFlipToSucceeded pins the\n716\t// CU3-fix-loop contract that RunError implies Failed and is sticky against\n717\t// a subsequent Finished{Success: true}. Mirrors classifyStatus from CU4\n718\t// which honors sawRunError → Failed.\n719\tfunc TestTUIModel_RunErrorSticky_FinishedDoesNotFlipToSucceeded(t *testing.T) {\n720\t\tt.Parallel()\n721\t\tm := newReviewTUIModel([]string{\"agent-a\"}, nil)\n722\t\n723\t\t// RunError → Finished{Success: true}. Status should stay Failed.\n724\t\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.RunError{Err: errors.New(\"torn\")}})\n725\t\tm = mustModel(t, updated)\n726\t\tif m.rows[0].status != reviewtypes.AgentStatusFailed {\n727\t\t\tt.Fatalf(\"expected Failed after RunError, got %v\", m.rows[0].status)\n728\t\t}\n729\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Finished{Success: true}})\n730\t\tm = mustModel(t, updated)\n731\t\tif m.rows[0].status != reviewtypes.AgentStatusFailed {\n732\t\t\tt.Errorf(\"expected Failed to stick (RunError is sticky), got %v\", m.rows[0].status)\n733\t\t}\n734\t}\n735\t"}]},"uuid":"5fd71e65-decd-42bb-8fad-1402d0de240e","timestamp":"2026-05-11T23:05:56.493Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/tui_model_test.go","content":"package review\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\ttea \"charm.land/bubbletea/v2\"\n\t\"github.com/charmbracelet/x/ansi\"\n\n\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n)\n\n// newTestModel returns a reviewTUIModel wired to the provided cancel stub.\nfunc newTestModel(agents []string, cancel func()) reviewTUIModel {\n\treturn newReviewTUIModel(agents, cancel)\n}\n\nfunc testKey(code rune) tea.KeyPressMsg {\n\treturn tea.KeyPressMsg{Code: code}\n}\n\nfunc testCtrlKey(code rune) tea.KeyPressMsg {\n\treturn tea.KeyPressMsg{Code: code, Mod: tea.ModCtrl}\n}\n\n// mustModel extracts a reviewTUIModel from a tea.Model, failing the test if\n// the assertion fails.\nfunc mustModel(t *testing.T, m tea.Model) reviewTUIModel {\n\tt.Helper()\n\ttm, ok := m.(reviewTUIModel)\n\tif !ok {\n\t\tt.Fatalf(\"expected reviewTUIModel, got %T\", m)\n\t}\n\treturn tm\n}\n\nfunc TestTUIModel_AgentEvent_StampsRunStartOnFirstEvent(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n\n\tbefore := time.Now()\n\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Started{}})\n\tafter := time.Now()\n\n\tm2 := mustModel(t, updated)\n\trow := m2.rows[m2.rowIdx[\"agent-a\"]]\n\tif row.runStart.IsZero() {\n\t\tt.Fatal(\"runStart should be stamped after first event; got zero\")\n\t}\n\tif row.runStart.Before(before) || row.runStart.After(after) {\n\t\tt.Errorf(\"runStart %v not in expected range [%v, %v]\", row.runStart, before, after)\n\t}\n\t// Second event should NOT update runStart.\n\tfirstStart := row.runStart\n\tupdated2, _ := m2.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Started{}})\n\tm3 := mustModel(t, updated2)\n\tif m3.rows[m3.rowIdx[\"agent-a\"]].runStart != firstStart {\n\t\tt.Error(\"runStart should not be overwritten on subsequent events\")\n\t}\n}\n\nfunc TestTUIModel_AgentEvent_TokensOverwrite(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\n\tupdated1, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Tokens{In: 100, Out: 50}})\n\tm1 := mustModel(t, updated1)\n\tupdated2, _ := m1.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Tokens{In: 200, Out: 80}})\n\tm2 := mustModel(t, updated2)\n\n\trow := m2.rows[0]\n\tif row.tokens.In != 200 || row.tokens.Out != 80 {\n\t\tt.Errorf(\"expected tokens {200 80} after overwrite, got {%d %d}\", row.tokens.In, row.tokens.Out)\n\t}\n}\n\nfunc TestTUIModel_AgentEvent_FinishedSuccess(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\n\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Finished{Success: true}})\n\trow := mustModel(t, updated).rows[0]\n\tif row.status != reviewtypes.AgentStatusSucceeded {\n\t\tt.Errorf(\"expected Succeeded, got %v\", row.status)\n\t}\n\tif row.runEnd.IsZero() {\n\t\tt.Error(\"runEnd should be stamped on Finished\")\n\t}\n}\n\nfunc TestTUIModel_AgentEvent_FinishedFailure(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\n\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Finished{Success: false}})\n\trow := mustModel(t, updated).rows[0]\n\tif row.status != reviewtypes.AgentStatusFailed {\n\t\tt.Errorf(\"expected Failed, got %v\", row.status)\n\t}\n}\n\nfunc TestTUIModel_AgentEvent_RunError(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\n\ttheErr := errors.New(\"agent crashed\")\n\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.RunError{Err: theErr}})\n\trow := mustModel(t, updated).rows[0]\n\tif row.status != reviewtypes.AgentStatusFailed {\n\t\tt.Errorf(\"expected Failed on RunError, got %v\", row.status)\n\t}\n\tif row.err == nil {\n\t\tt.Error(\"row.err should be set after RunError\")\n\t}\n}\n\nfunc TestTUIModel_KeyCtrlC_NotDetailMode_CancelsAndMarksCancelling(t *testing.T) {\n\tt.Parallel()\n\tvar called atomic.Bool\n\tcancel := func() { called.Store(true) }\n\n\tm := newTestModel([]string{\"agent-a\"}, cancel)\n\tupdated, cmd := m.Update(testCtrlKey('c'))\n\tif !called.Load() {\n\t\tt.Error(\"expected cancel to be called on Ctrl+C outside detail mode\")\n\t}\n\tm2 := mustModel(t, updated)\n\tif !m2.cancelling {\n\t\tt.Error(\"expected m.cancelling=true after first Ctrl+C\")\n\t}\n\t// First Ctrl+C must NOT quit — the TUI stays up so agents can drain\n\t// visibly. Only a second Ctrl+C (or natural finish) dismisses.\n\tif cmd != nil {\n\t\tif msg := cmd(); msg != nil {\n\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n\t\t\t\tt.Error(\"first Ctrl+C must NOT send a quit command; it should wait for agents to drain\")\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc TestTUIModel_KeyCtrlC_DetailMode_Ignored(t *testing.T) {\n\tt.Parallel()\n\tvar called atomic.Bool\n\tcancel := func() { called.Store(true) }\n\n\tm := newTestModel([]string{\"agent-a\"}, cancel)\n\tm.detailMode = true\n\n\t_, cmd := m.Update(testCtrlKey('c'))\n\tif called.Load() {\n\t\tt.Error(\"cancel must NOT be called when Ctrl+C is pressed in detail mode\")\n\t}\n\tif cmd != nil {\n\t\t// Command should be nil (no quit).\n\t\tif msg := cmd(); msg != nil {\n\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n\t\t\t\tt.Error(\"Ctrl+C in detail mode must not send a quit command\")\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc TestTUIModel_CancelOnce_DuplicateKeyCtrlC(t *testing.T) {\n\tt.Parallel()\n\tvar count atomic.Int32\n\tcancel := func() { count.Add(1) }\n\n\tm := newTestModel([]string{\"agent-a\"}, cancel)\n\t_, _ = m.Update(testCtrlKey('c'))\n\t_, _ = m.Update(testCtrlKey('c'))\n\tif count.Load() != 1 {\n\t\tt.Errorf(\"cancel should fire exactly once even on duplicate Ctrl+C; called %d time(s)\", count.Load())\n\t}\n}\n\nfunc TestTUIModel_KeyCtrlO_EntersDrillIn(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n\n\tupdated, cmd := m.Update(testCtrlKey('o'))\n\tm2 := mustModel(t, updated)\n\tif !m2.detailMode {\n\t\tt.Error(\"expected detailMode=true after Ctrl+O\")\n\t}\n\tif cmd != nil {\n\t\tt.Error(\"Ctrl+O should not return an alt-screen command in Bubble Tea v2\")\n\t}\n\tif !m2.View().AltScreen {\n\t\tt.Error(\"expected View().AltScreen=true in detail mode\")\n\t}\n}\n\nfunc TestTUIModel_KeyEsc_ExitsDrillIn(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\tm.detailMode = true\n\n\tupdated, cmd := m.Update(testKey(tea.KeyEscape))\n\tm2 := mustModel(t, updated)\n\tif m2.detailMode {\n\t\tt.Error(\"expected detailMode=false after Esc\")\n\t}\n\tif cmd != nil {\n\t\tt.Error(\"Esc should not return an alt-screen command in Bubble Tea v2\")\n\t}\n\tif m2.View().AltScreen {\n\t\tt.Error(\"expected View().AltScreen=false outside detail mode\")\n\t}\n}\n\nfunc TestTUIModel_LeftRight_CycleDetailIdx(t *testing.T) {\n\tt.Parallel()\n\tagents := []string{\"a\", \"b\", \"c\"}\n\tm := newTestModel(agents, func() {})\n\tm.detailMode = true\n\tm.detailIdx = 0\n\n\t// Right: 0 → 1 → 2 → 0 (wrap).\n\tfor _, wantIdx := range []int{1, 2, 0} {\n\t\tupdated, _ := m.Update(testKey(tea.KeyRight))\n\t\tm = mustModel(t, updated)\n\t\tif m.detailIdx != wantIdx {\n\t\t\tt.Errorf(\"after Right: want detailIdx=%d, got %d\", wantIdx, m.detailIdx)\n\t\t}\n\t}\n\n\t// Left: 0 → 2 (wrap).\n\tupdated, _ := m.Update(testKey(tea.KeyLeft))\n\tm = mustModel(t, updated)\n\tif m.detailIdx != 2 {\n\t\tt.Errorf(\"after Left from 0: want detailIdx=2, got %d\", m.detailIdx)\n\t}\n}\n\n// TestTUIModel_InitializesDetailViewport pins that the viewport widget on the\n// model starts with non-zero default dimensions so that an immediate Ctrl+O\n// before a WindowSizeMsg still renders without panicking.\nfunc TestTUIModel_InitializesDetailViewport(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\tif w := m.detail.Width(); w <= 0 {\n\t\tt.Errorf(\"expected detail viewport width > 0, got %d\", w)\n\t}\n\tif h := m.detail.Height(); h <= 0 {\n\t\tt.Errorf(\"expected detail viewport height > 0, got %d\", h)\n\t}\n}\n\n// TestTUIModel_DelegatesScrollKeysToViewport pins that pager keys (PgDn) in\n// detail mode reach the viewport's internal keymap and advance YOffset rather\n// than being swallowed by the model's switch.\nfunc TestTUIModel_DelegatesScrollKeysToViewport(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\t// Size the window so the viewport has a sensible height.\n\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 40, Height: 10})\n\tm = mustModel(t, updated)\n\t// Populate enough content to scroll. AssistantText with long text wraps\n\t// to many viewport lines.\n\tlong := strings.Repeat(\"paragraph of text \", 20)\n\tfor range 5 {\n\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n\t\tm = mustModel(t, updated)\n\t}\n\t// Enter detail mode (auto-tails to bottom).\n\tupdated, _ = m.Update(testCtrlKey('o'))\n\tm = mustModel(t, updated)\n\t// Jump to top so PgDn has somewhere to scroll into.\n\tm.detail.GotoTop()\n\tstartOffset := m.detail.YOffset()\n\n\tupdated, _ = m.Update(tea.KeyPressMsg{Code: tea.KeyPgDown})\n\tm = mustModel(t, updated)\n\tif m.detail.YOffset() <= startOffset {\n\t\tt.Errorf(\"expected PgDn to advance viewport YOffset beyond %d; got %d\", startOffset, m.detail.YOffset())\n\t}\n}\n\nfunc TestTUIModel_WindowSizeMsg_UpdatesDimensions(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\n\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 120, Height: 40})\n\tm2 := mustModel(t, updated)\n\tif m2.termWidth != 120 || m2.termHeight != 40 {\n\t\tt.Errorf(\"expected 120×40, got %d×%d\", m2.termWidth, m2.termHeight)\n\t}\n}\n\nfunc TestTUIModel_TickMsg_ReSchedulesTick(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\n\t_, cmd := m.Update(tickMsg(time.Now()))\n\tif cmd == nil {\n\t\tt.Error(\"tickMsg should return a non-nil command (re-tick)\")\n\t}\n}\n\nfunc TestTUIModel_RunFinishedMsg_MarksFinished(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\n\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n\tm2 := mustModel(t, updated)\n\tif !m2.finished {\n\t\tt.Error(\"model should be finished after runFinishedMsg\")\n\t}\n}\n\n// TestTUIModel_PostFinishCtrlOEntersDetailMode pins that Ctrl+O still enters\n// drill-in after both agents finish so the user can inspect completed output.\n// Previously any-key-quits behavior swallowed Ctrl+O on the post-finish frame.\nfunc TestTUIModel_PostFinishCtrlOEntersDetailMode(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n\tm = mustModel(t, updated)\n\tif !m.finished {\n\t\tt.Fatal(\"setup: expected model finished after runFinishedMsg\")\n\t}\n\n\tupdated, cmd := m.Update(testCtrlKey('o'))\n\tm2 := mustModel(t, updated)\n\tif !m2.detailMode {\n\t\tt.Error(\"expected Ctrl+O post-finish to enter detail mode\")\n\t}\n\t// Ctrl+O must NOT quit post-finish.\n\tif cmd != nil {\n\t\tif msg := cmd(); msg != nil {\n\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n\t\t\t\tt.Error(\"Ctrl+O post-finish must not produce a quit command\")\n\t\t\t}\n\t\t}\n\t}\n}\n\n// TestTUIModel_PostFinishQuitsOnExplicitKeys pins that q, Esc, Enter, and Ctrl+C\n// each produce tea.QuitMsg when finished and in dashboard mode.\nfunc TestTUIModel_PostFinishQuitsOnExplicitKeys(t *testing.T) {\n\tt.Parallel()\n\tcases := []struct {\n\t\tname string\n\t\tkey  tea.KeyPressMsg\n\t}{\n\t\t{\"q\", testKey('q')},\n\t\t{\"Esc\", testKey(tea.KeyEscape)},\n\t\t{\"Enter\", testKey(tea.KeyEnter)},\n\t\t{\"Ctrl+C\", testCtrlKey('c')},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\t\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n\t\t\tm = mustModel(t, updated)\n\n\t\t\t_, cmd := m.Update(tc.key)\n\t\t\tif cmd == nil {\n\t\t\t\tt.Fatalf(\"expected a command for explicit-exit key %q post-finish\", tc.name)\n\t\t\t}\n\t\t\tmsg := cmd()\n\t\t\tif _, ok := msg.(tea.QuitMsg); !ok {\n\t\t\t\tt.Errorf(\"expected tea.QuitMsg for key %q post-finish, got %T\", tc.name, msg)\n\t\t\t}\n\t\t})\n\t}\n}\n\n// TestTUIModel_PostFinishIgnoresRandomKeys pins that non-exit keys (e.g. 'x',\n// arrow keys) do NOT quit when finished on the dashboard. They fall through to\n// normal handling instead of the old any-key-quits shortcut.\nfunc TestTUIModel_PostFinishIgnoresRandomKeys(t *testing.T) {\n\tt.Parallel()\n\tcases := []struct {\n\t\tname string\n\t\tkey  tea.KeyPressMsg\n\t}{\n\t\t{\"x\", testKey('x')},\n\t\t{\"Right\", testKey(tea.KeyRight)},\n\t\t{\"Left\", testKey(tea.KeyLeft)},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n\t\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n\t\t\tm = mustModel(t, updated)\n\n\t\t\t_, cmd := m.Update(tc.key)\n\t\t\tif cmd != nil {\n\t\t\t\tif msg := cmd(); msg != nil {\n\t\t\t\t\tif _, ok := msg.(tea.QuitMsg); ok {\n\t\t\t\t\t\tt.Errorf(\"key %q must not quit post-finish on dashboard\", tc.name)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n\n// TestTUIModel_PostFinishFooterUsesExplicitExitKeys pins the dashboard footer\n// switches from the old \"Press any key to exit.\" prompt to an explicit-keys\n// hint that mentions Ctrl+O and the named exit keys.\nfunc TestTUIModel_PostFinishFooterUsesExplicitExitKeys(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\tm.termWidth = 120\n\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{}})\n\tm = mustModel(t, updated)\n\n\tout := m.dashboardView()\n\tif strings.Contains(out, \"Press any key to exit.\") {\n\t\tt.Errorf(\"post-finish footer must not show legacy 'Press any key to exit.' line:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"Ctrl+O\") {\n\t\tt.Errorf(\"post-finish footer should mention Ctrl+O for drill-in:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"q/Esc/Enter\") {\n\t\tt.Errorf(\"post-finish footer should list q/Esc/Enter as exit keys:\\n%s\", out)\n\t}\n}\n\n// TestTUIModel_CtrlCMarksAgentsCancelling pins that the first Ctrl+C while\n// agents are still running sets m.cancelling and renderRow reflects an\n// in-flight cancellation indicator (distinct from the terminal Cancelled\n// state).\nfunc TestTUIModel_CtrlCMarksAgentsCancelling(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\t// Stamp runStart so the row is in the running branch of renderRow.\n\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Started{}})\n\tm = mustModel(t, updated)\n\tm.termWidth = 120\n\n\t// Before Ctrl+C the running row should say \"running\".\n\tif status := m.renderRow(m.rows[0]); !strings.Contains(status, \"running\") {\n\t\tt.Fatalf(\"setup: expected running indicator pre-Ctrl+C; got %q\", status)\n\t}\n\n\tupdated, _ = m.Update(testCtrlKey('c'))\n\tm = mustModel(t, updated)\n\tif !m.cancelling {\n\t\tt.Fatal(\"expected m.cancelling=true after first Ctrl+C\")\n\t}\n\n\tgot := m.renderRow(m.rows[0])\n\tif strings.Contains(got, \"running\") {\n\t\tt.Errorf(\"renderRow should drop the 'running' indicator once cancelling; got %q\", got)\n\t}\n\tif !strings.Contains(got, \"cancel\") {\n\t\tt.Errorf(\"renderRow should show a cancelling indicator; got %q\", got)\n\t}\n}\n\n// TestTUIModel_FooterDuringCancellation pins that the dashboard footer changes\n// while a cancel is in flight (cancelling && !finished) to signal the user\n// that draining is in progress and a second Ctrl+C will force quit.\nfunc TestTUIModel_FooterDuringCancellation(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\tm.termWidth = 120\n\tupdated, _ := m.Update(testCtrlKey('c'))\n\tm = mustModel(t, updated)\n\n\tout := m.dashboardView()\n\tif !strings.Contains(out, \"Cancelling agents\") {\n\t\tt.Errorf(\"expected footer to announce cancellation in progress; got:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"Ctrl+C again\") {\n\t\tt.Errorf(\"expected footer to mention force-quit hint; got:\\n%s\", out)\n\t}\n}\n\n// TestTUIModel_SecondCtrlCForceQuits pins that once cancelling is in flight,\n// a second Ctrl+C emits tea.QuitMsg immediately rather than waiting for\n// agents to drain.\nfunc TestTUIModel_SecondCtrlCForceQuits(t *testing.T) {\n\tt.Parallel()\n\tvar count atomic.Int32\n\tcancel := func() { count.Add(1) }\n\n\tm := newTestModel([]string{\"agent-a\"}, cancel)\n\tupdated, _ := m.Update(testCtrlKey('c'))\n\tm = mustModel(t, updated)\n\tif !m.cancelling {\n\t\tt.Fatal(\"setup: expected cancelling=true after first Ctrl+C\")\n\t}\n\n\t_, cmd := m.Update(testCtrlKey('c'))\n\tif cmd == nil {\n\t\tt.Fatal(\"expected a command from second Ctrl+C\")\n\t}\n\tmsg := cmd()\n\tif _, ok := msg.(tea.QuitMsg); !ok {\n\t\tt.Errorf(\"expected tea.QuitMsg from second Ctrl+C, got %T\", msg)\n\t}\n\t// Shared CancelFunc still fires at most once thanks to cancelOnce.\n\tif got := count.Load(); got != 1 {\n\t\tt.Errorf(\"CancelFunc should fire exactly once across both Ctrl+Cs; got %d\", got)\n\t}\n}\n\n// TestTUIModel_AutoFollow_DetailMode pins that when the viewport is sitting\n// at the bottom and a new event arrives, the model snaps back to bottom so\n// the user keeps seeing the tail. The viewport's AtBottom() drives this.\nfunc TestTUIModel_AutoFollow_DetailMode(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\"}, func() {})\n\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 40, Height: 8})\n\tm = mustModel(t, updated)\n\tupdated, _ = m.Update(testCtrlKey('o'))\n\tm = mustModel(t, updated)\n\n\t// Send events that produce content taller than the viewport so a tail\n\t// exists below the visible window.\n\tlong := strings.Repeat(\"review finding \", 10)\n\tfor range 6 {\n\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n\t\tm = mustModel(t, updated)\n\t}\n\tif !m.detail.AtBottom() {\n\t\tt.Errorf(\"expected viewport to track bottom after each event (auto-follow); YOffset=%d, total=%d\",\n\t\t\tm.detail.YOffset(), m.detail.TotalLineCount())\n\t}\n}\n\nfunc TestTUIModel_View_DashboardMode(t *testing.T) {\n\tt.Parallel()\n\tm := newTestModel([]string{\"agent-a\", \"agent-b\"}, func() {})\n\n\tv := m.View()\n\tif v.Content == \"\" {\n\t\tt.Error(\"View() should not return empty string\")\n\t}\n\t// Should contain agent names.\n\tfor _, name := range []string{\"agent-a\", \"agent-b\"} {\n\t\tif !strings.Contains(v.Content, name) {\n\t\t\tt.Errorf(\"View() missing agent %q\", name)\n\t\t}\n\t}\n}\n\nfunc TestTUIModel_DashboardLinesFitTerminalWidth(t *testing.T) {\n\tt.Parallel()\n\n\tfor _, width := range []int{1, 2, 10, 20, 24, 30, 40, 53, 54, 55, 60, 80, 120} {\n\t\tt.Run(fmt.Sprintf(\"running width %d\", width), func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tm := runningDashboardModel(t, width)\n\t\t\tassertDashboardFitsWidth(t, m)\n\t\t})\n\t\tt.Run(fmt.Sprintf(\"finished width %d\", width), func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tm := runningDashboardModel(t, width)\n\t\t\tfor _, name := range []string{\"claude-code-with-a-long-name\", \"codex\"} {\n\t\t\t\tupdated, _ := m.Update(agentEventMsg{agent: name, ev: reviewtypes.Finished{Success: true}})\n\t\t\t\tm = mustModel(t, updated)\n\t\t\t}\n\t\t\tupdated, _ := m.Update(runFinishedMsg{summary: reviewtypes.RunSummary{\n\t\t\t\tAgentRuns: []reviewtypes.AgentRun{\n\t\t\t\t\t{Name: \"claude-code-with-a-long-name\", Status: reviewtypes.AgentStatusSucceeded},\n\t\t\t\t\t{Name: \"codex\", Status: reviewtypes.AgentStatusSucceeded},\n\t\t\t\t},\n\t\t\t}})\n\t\t\tm = mustModel(t, updated)\n\t\t\tassertDashboardFitsWidth(t, m)\n\t\t})\n\t}\n}\n\nfunc TestTUIModel_DashboardPreviewStripsControlSequences(t *testing.T) {\n\tt.Parallel()\n\tm := newReviewTUIModel([]string{\"codex\"}, nil)\n\tm.termWidth = 80\n\n\tupdated, _ := m.Update(agentEventMsg{\n\t\tagent: \"codex\",\n\t\tev:    reviewtypes.AssistantText{Text: \"hello\\x1b[?25lworld\\x1b[?25h\"},\n\t})\n\tm = mustModel(t, updated)\n\tout := m.dashboardView()\n\n\tif strings.Contains(out, \"\\x1b[?25\") {\n\t\tt.Fatalf(\"dashboard preview leaked control sequence:\\n%q\", out)\n\t}\n\tif !strings.Contains(out, \"helloworld\") {\n\t\tt.Fatalf(\"dashboard preview missing stripped text:\\n%s\", out)\n\t}\n}\n\nfunc TestTUIModel_WindowResizeKeepsDashboardWithinNewWidth(t *testing.T) {\n\tt.Parallel()\n\tm := runningDashboardModel(t, 120)\n\n\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 30, Height: 24})\n\tm = mustModel(t, updated)\n\n\tassertDashboardFitsWidth(t, m)\n}\n\nfunc runningDashboardModel(t *testing.T, width int) reviewTUIModel {\n\tt.Helper()\n\tm := newReviewTUIModel([]string{\"claude-code-with-a-long-name\", \"codex\"}, nil)\n\tm.termWidth = width\n\n\tlongPreview := strings.Repeat(\"review finding with enough text to overflow \", 4)\n\tfor _, name := range []string{\"claude-code-with-a-long-name\", \"codex\"} {\n\t\tupdated, _ := m.Update(agentEventMsg{agent: name, ev: reviewtypes.Started{}})\n\t\tm = mustModel(t, updated)\n\t\tupdated, _ = m.Update(agentEventMsg{agent: name, ev: reviewtypes.Tokens{In: 1_234_567, Out: 987_654}})\n\t\tm = mustModel(t, updated)\n\t\tupdated, _ = m.Update(agentEventMsg{agent: name, ev: reviewtypes.AssistantText{Text: longPreview}})\n\t\tm = mustModel(t, updated)\n\t}\n\treturn m\n}\n\nfunc assertDashboardFitsWidth(t *testing.T, m reviewTUIModel) {\n\tt.Helper()\n\tfor _, line := range strings.Split(strings.TrimSuffix(m.dashboardView(), \"\\n\"), \"\\n\") {\n\t\tif got := ansi.StringWidth(line); got > m.termWidth {\n\t\t\tt.Fatalf(\"dashboard line width = %d, want <= %d:\\n%s\", got, m.termWidth, line)\n\t\t}\n\t}\n}\n\n// TestTUIModel_AutoFollow_PreservesUserScroll pins the contract that new\n// agent events must NOT yank the user back to the tail when they have\n// scrolled up to inspect older events. Auto-follow only re-engages when\n// the viewport is already at the bottom.\nfunc TestTUIModel_AutoFollow_PreservesUserScroll(t *testing.T) {\n\tt.Parallel()\n\tm := newReviewTUIModel([]string{\"agent-a\"}, nil)\n\tupdated, _ := m.Update(tea.WindowSizeMsg{Width: 40, Height: 10})\n\tm = mustModel(t, updated)\n\tupdated, _ = m.Update(testCtrlKey('o'))\n\tm = mustModel(t, updated)\n\n\t// Build up enough wrapped content to overflow the viewport several times.\n\tlong := strings.Repeat(\"line of review text \", 10)\n\tfor range 20 {\n\t\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n\t\tm = mustModel(t, updated)\n\t}\n\n\t// Scroll up away from the bottom.\n\tm.detail.GotoTop()\n\tstartOffset := m.detail.YOffset()\n\tif m.detail.AtBottom() {\n\t\tt.Fatal(\"test setup: viewport unexpectedly at bottom after GotoTop\")\n\t}\n\n\t// Send another event — the user is NOT at the bottom, so YOffset must not move.\n\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n\tm = mustModel(t, updated)\n\tif m.detail.YOffset() != startOffset {\n\t\tt.Errorf(\"expected viewport YOffset to stay at %d (user scrolled up); got %d (auto-follow yanked back)\",\n\t\t\tstartOffset, m.detail.YOffset())\n\t}\n\n\t// Now jump to bottom and send another event — should auto-follow.\n\tm.detail.GotoBottom()\n\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.AssistantText{Text: long}})\n\tm = mustModel(t, updated)\n\tif !m.detail.AtBottom() {\n\t\tt.Errorf(\"expected auto-follow to track bottom after event; YOffset=%d, total=%d\",\n\t\t\tm.detail.YOffset(), m.detail.TotalLineCount())\n\t}\n}\n\n// TestTUIModel_RunFinishedMsg_SyncsStatusFromSummary pins the contract\n// that the final dashboard frame reflects the orchestrator's classified\n// status, not the in-stream event status alone. Without this sync, an\n// agent the orchestrator classified Cancelled (Ctrl+C, no Finished\n// emitted) would still appear \"running\" in the final frame.\nfunc TestTUIModel_RunFinishedMsg_SyncsStatusFromSummary(t *testing.T) {\n\tt.Parallel()\n\tm := newReviewTUIModel([]string{\"agent-a\", \"agent-b\"}, nil)\n\n\t// Stamp runStart for both via a Started event each.\n\tfor _, name := range []string{\"agent-a\", \"agent-b\"} {\n\t\tupdated, _ := m.Update(agentEventMsg{agent: name, ev: reviewtypes.Started{}})\n\t\tm = mustModel(t, updated)\n\t}\n\n\t// Both rows should still be Unknown (no Finished/RunError seen).\n\tif m.rows[0].status != reviewtypes.AgentStatusUnknown {\n\t\tt.Fatalf(\"expected agent-a Unknown pre-finish, got %v\", m.rows[0].status)\n\t}\n\n\t// Send runFinishedMsg with summary that classifies a=Cancelled, b=Failed.\n\tsummary := reviewtypes.RunSummary{\n\t\tAgentRuns: []reviewtypes.AgentRun{\n\t\t\t{Name: \"agent-a\", Status: reviewtypes.AgentStatusCancelled},\n\t\t\t{Name: \"agent-b\", Status: reviewtypes.AgentStatusFailed},\n\t\t},\n\t}\n\tupdated, _ := m.Update(runFinishedMsg{summary: summary})\n\tm = mustModel(t, updated)\n\n\tif m.rows[0].status != reviewtypes.AgentStatusCancelled {\n\t\tt.Errorf(\"expected agent-a synced to Cancelled, got %v\", m.rows[0].status)\n\t}\n\tif m.rows[1].status != reviewtypes.AgentStatusFailed {\n\t\tt.Errorf(\"expected agent-b synced to Failed, got %v\", m.rows[1].status)\n\t}\n}\n\n// TestTUIModel_RunErrorSticky_FinishedDoesNotFlipToSucceeded pins the\n// CU3-fix-loop contract that RunError implies Failed and is sticky against\n// a subsequent Finished{Success: true}. Mirrors classifyStatus from CU4\n// which honors sawRunError → Failed.\nfunc TestTUIModel_RunErrorSticky_FinishedDoesNotFlipToSucceeded(t *testing.T) {\n\tt.Parallel()\n\tm := newReviewTUIModel([]string{\"agent-a\"}, nil)\n\n\t// RunError → Finished{Success: true}. Status should stay Failed.\n\tupdated, _ := m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.RunError{Err: errors.New(\"torn\")}})\n\tm = mustModel(t, updated)\n\tif m.rows[0].status != reviewtypes.AgentStatusFailed {\n\t\tt.Fatalf(\"expected Failed after RunError, got %v\", m.rows[0].status)\n\t}\n\tupdated, _ = m.Update(agentEventMsg{agent: \"agent-a\", ev: reviewtypes.Finished{Success: true}})\n\tm = mustModel(t, updated)\n\tif m.rows[0].status != reviewtypes.AgentStatusFailed {\n\t\tt.Errorf(\"expected Failed to stick (RunError is sticky), got %v\", m.rows[0].status)\n\t}\n}\n","numLines":735,"startLine":1,"totalLines":735}},"sourceToolAssistantUUID":"1b4d768c-17c3-485f-aebb-e200dd929d0e","userType":"external","entrypoint":"sdk-cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"e6c78e76-4cd8-406c-b7a5-5f3306b4be04","version":"2.1.139","gitBranch":"feat/review-detail-viewport"}
