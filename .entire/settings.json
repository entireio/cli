{
  "enabled": true,
  "local_dev": true,
  "strategy_options": {
    "checkpoint_remote": {
      "provider": "github",
      "repo": "entireio/cli-checkpoints"
    },
    "filtered_fetches": true
  },
  "review": {
    "claude-code": {
      "skills": [
        "/review",
        "/pr-review-toolkit:review-pr"
      ]
    },
    "codex": {
      "skills": [
        "$code-reviewer"
      ]
    },
    "gemini": {},
    "opencode": {}
  },
  "review_fix_agent": "claude-code",
  "strategy": "manual-commit"
}
