onState for empty session failed: %v\", err)\n\t}\n\tif emptyState != nil {\n\t\tt.Fatalf(\"Ephemeral session should not have registered state, got %+v\", emptyState)\n\t}"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1317,"cache_read_input_tokens":472539,"output_tokens":1735,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1317,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":1,"output_tokens":1735,"cache_read_input_tokens":472539,"cache_creation_input_tokens":1317,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1317},"type":"message"}],"speed":"standard"}},"requestId":"req_011CaNdFmcJYb69wcrBLqPhY","type":"assistant","uuid":"d9d46191-1c0b-455b-96b4-5c4329658d4b","timestamp":"2026-04-24T12:51:21.418Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"c2a51e7d-ab7f-4f50-9349-537240c8648f","version":"2.1.118","gitBranch":"soph/skip-ephemeral-codex-session"}
