modify test.txt\", &git.CommitOptions{})\n100\t\trequire.NoError(t, err)\n101\t\n102\t\tstate := &SessionState{\n103\t\t\tSessionID:    \"test-files-no-transcript\",\n104\t\t\tAgentType:    \"Claude Code\",\n105\t\t\tBaseCommit:   commitHash.String(),\n106\t\t\tPhase:        session.PhaseActive,\n107\t\t\tFilesTouched: []string{\"test.txt\"},\n108\t\t}\n109\t\n110\t\tcommittedFiles := map[string]struct{}{\"test.txt\": {}}\n111\t\tresult, err := s.CondenseSession(context.Background(), repo, checkpointID, state, committedFiles)\n112\t\trequire.NoError(t, err)\n113\t\tassert.False(t, result.Skipped, \"should not skip when files are touched even without transcript\")\n114\t}\n115\t\n116\t// Regression: a session whose tracked files don't overlap with this commit AND\n117\t// whose transcript is dropped by redaction (malformed JSONL) must be skipped\n118\t// instead of writing a metadata-only stub. The post-redaction skip gate is the\n119\t// safety net for this combination — line 165 doesn't catch it because both\n120\t// pre-filter Transcript and pre-filter FilesTouched are non-empty.\n121\tfunc TestCondenseSession_SkipsWhenNoOverlapAndRedactionFails(t *testing.T) {\n122\t\tdir := setupGitRepo(t)\n123\t\tt.Chdir(dir)\n124\t\n125\t\trepo, err := git.PlainOpen(dir)\n126\t\trequire.NoError(t, err)\n127\t\n128\t\t// Commit a file so committedFiles is non-empty.\n129\t\tcommittedTestFile := filepath.Join(dir, \"committed.txt\")\n130\t\trequire.NoError(t, os.WriteFile(committedTestFile, []byte(\"committed change\"), 0o644))\n131\t\twt, err := repo.Worktree()\n132\t\trequire.NoError(t, err)\n133\t\t_, err = wt.Add(\"committed.txt\")\n134\t\trequire.NoError(t, err)\n135\t\tcommitHash, err := wt.Commit(\"modify committed.txt\", &git.CommitOptions{})\n136\t\trequire.NoError(t, err)\n137\t\n138\t\t// Session tracks an UNRELATED file so the intersect in filterFilesTouched\n139\t\t// produces an empty result. Transcript is readable so the pre-redaction\n140\t\t// skip gate at line 