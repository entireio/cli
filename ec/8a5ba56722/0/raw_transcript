d agents, this counts lines.\n1031\t// For Gemini CLI, OpenCode, and JSON-based agents, this counts messages.\n1032\t// Returns 0 if the content is empty or malformed.\n1033\tfunc countTranscriptItems(agentType types.AgentType, content string) int {\n1034\t\tif content == \"\" {\n1035\t\t\treturn 0\n1036\t\t}\n1037\t\n1038\t\t// OpenCode uses export JSON format with {\"info\": {...}, \"messages\": [...]}\n1039\t\tif agentType == agent.AgentTypeOpenCode {\n1040\t\t\tsession, err := opencode.ParseExportSession([]byte(content))\n1041\t\t\tif err == nil && session != nil {\n1042\t\t\t\treturn len(session.Messages)\n1043\t\t\t}\n1044\t\t\treturn 0\n1045\t\t}\n1046\t\n1047\t\t// Try Gemini format first if agentType is Gemini, or as fallback if Unknown\n1048\t\tif agentType == agent.AgentTypeGemini || agentType == agent.AgentTypeUnknown {\n1049\t\t\ttranscript, err := geminicli.ParseTranscript([]byte(content))\n1050\t\t\tif err == nil && transcript != nil && len(transcript.Messages) > 0 {\n1051\t\t\t\treturn len(transcript.Messages)\n1052\t\t\t}\n1053\t\t\t// If agentType is explicitly Gemini but parsing failed, return 0\n1054\t\t\tif agentType == agent.AgentTypeGemini {\n1055\t\t\t\treturn 0\n1056\t\t\t}\n1057\t\t\t// Otherwise fall through to JSONL parsing for Unknown type\n1058\t\t}\n1059\t\n1060\t\t// Claude Code and other JSONL-based agents\n1061\t\tallLines := strings.Split(content, \"\\n\")\n1062\t\t// Trim trailing empty lines (from final \\n in JSONL)\n1063\t\tfor len(allLines) > 0 && strings.TrimSpace(allLines[len(allLines)-1]) == \"\" {\n1064\t\t\tallLines = allLines[:len(allLines)-1]\n1065\t\t}\n1066\t\treturn len(allLines)\n1067\t}\n1068\t\n1069\t// extractUserPrompts extracts all user prompts from transcript content.\n1070\t// Returns prompts with IDE context tags stripped (e.g., <ide_opened_file>).\n1071\tfunc extractUserPrompts(agentType types.AgentType, content string) []string {\n1072\t\tif content == \"\" {\n1073\t\t\treturn nil\n1074\t\t}\n1075\t\n1076\