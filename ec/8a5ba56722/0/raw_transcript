{"parentUuid":"936b2dc8-72b2-44da-9eee-9f775d46804b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/integration_test/read_only_session_test.go","snippet":"1\t//go:build integration\n2\t\n3\tpackage integration\n4\t\n5\timport (\n6\t\t\"encoding/json\"\n7\t\t\"testing\"\n8\t\n9\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n10\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n12\t)\n13\t\n14\t// TestReadOnlySession_NotCondensed verifies that a session which never touched\n15\t// any files is NOT condensed into a checkpoint when the user commits.\n16\t//\n17\t// This reproduces the \"summarize\" bug where tools like steipete/summarize spawn\n18\t// many rapid-fire Codex exec sessions that only read/analyze content without\n19\t// modifying files. Each session creates a full lifecycle (SessionStart →\n20\t// UserPromptSubmit → Stop) but never calls SaveStep and never modifies files.\n21\t// When the user later commits, these read-only sessions should be silently\n22\t// skipped — not condensed into the checkpoint.\n23\t//\n24\t// State machine transitions tested:\n25\t//   - IDLE + GitCommit → should NOT condense when FilesTouched is empty\n26\t//   - Only the session that actually touched files should appear in the checkpoint\n27\tfunc TestReadOnlySession_NotCondensed(t *testing.T) {\n28\t\tt.Parallel()\n29\t\n30\t\tenv := NewFeatureBranchEnv(t)\n31\t\n32\t\t// ========================================\n33\t\t// Phase 1: Create a read-only session (no file changes)\n34\t\t// ========================================\n35\t\tt.Log(\"Phase 1: Simulate a read-only session (e.g., codex exec from summarize)\")\n36\t\n37\t\treadOnlySess := env.NewSession()\n38\t\n39\t\t// Start the session — this creates session state\n40\t\tif err := env.SimulateUserPromptSubmit(readOnlySess.ID); err != nil {\n41\t\t\tt.Fatalf(\"read-only session user-prompt-submit failed: %v\", err)\n42\t\t}\n43\t\n44\t\t// Create a transcript with NO file changes — just a question and answer\n45\t\treadOnlySess.TranscriptBuilder.AddUserMessage(\"Summarize the README for this project\")\n46\t\treadOnlySess.TranscriptBuilder.AddAssistantMessage(\"This project is a CLI tool for managing checkpoints.\")\n47\t\tif err := readOnlySess.TranscriptBuilder.WriteToFile(readOnlySess.TranscriptPath); err != nil {\n48\t\t\tt.Fatalf(\"failed to write read-only transcript: %v\", err)\n49\t\t}\n50\t\n51\t\t// Stop the session — NO files were touched, NO SaveStep was called\n52\t\tif err := env.SimulateStop(readOnlySess.ID, readOnlySess.TranscriptPath); err != nil {\n53\t\t\tt.Fatalf(\"read-only session stop failed: %v\", err)\n54\t\t}\n55\t\n56\t\t// Verify: session is IDLE with empty FilesTouched\n57\t\troState, err := env.GetSessionState(readOnlySess.ID)\n58\t\tif err != nil {\n59\t\t\tt.Fatalf(\"GetSessionState for read-only session failed: %v\", err)\n60\t\t}\n61\t\tif roState.Phase != session.PhaseIdle {\n62\t\t\tt.Fatalf(\"Read-only session should be IDLE, got %s\", roState.Phase)\n63\t\t}\n64\t\tif len(roState.FilesTouched) != 0 {\n65\t\t\tt.Fatalf(\"Read-only session should have empty FilesTouched, got %v\", roState.FilesTouched)\n66\t\t}\n67\t\n68\t\t// ========================================\n69\t\t// Phase 2: Create a normal session that DOES touch files\n70\t\t// ========================================\n71\t\tt.Log(\"Phase 2: Simulate a normal coding session that modifies files\")\n72\t\n73\t\tcodingSess := env.NewSession()\n74\t\n75\t\tif err := env.SimulateUserPromptSubmit(codingSess.ID); err != nil {\n76\t\t\tt.Fatalf(\"coding session user-prompt-submit failed: %v\", err)\n77\t\t}\n78\t\n79\t\t// Create a file and a transcript that records the change\n80\t\tenv.WriteFile(\"feature.go\", \"package main\\n\\nfunc Feature() {}\\n\")\n81\t\tcodingSess.CreateTranscript(\"Create feature function\", []FileChange{\n82\t\t\t{Path: \"feature.go\", Content: \"package main\\n\\nfunc Feature() {}\\n\"},\n83\t\t})\n84\t\n85\t\tif err := env.SimulateStop(codingSess.ID, codingSess.TranscriptPath); err != nil {\n86\t\t\tt.Fatalf(\"coding session stop failed: %v\", err)\n87\t\t}\n88\t\n89\t\t// Verify: coding session has files touched\n90\t\tcsState, err := env.GetSessionState(codingSess.ID)\n91\t\tif err != nil {\n92\t\t\tt.Fatalf(\"GetSessionState for coding session failed: %v\", err)\n93\t\t}\n94\t\tif len(csState.FilesTouched) == 0 {\n95\t\t\tt.Fatal(\"Coding session should have non-empty FilesTouched\")\n96\t\t}\n97\t\n98\t\t// ========================================\n99\t\t// Phase 3: User commits — only the coding session should be condensed\n100\t\t// ========================================\n101\t\tt.Log(\"Phase 3: User commits; read-only session should NOT be condensed\")\n102\t\n103\t\tenv.GitCommitWithShadowHooks(\"Add feature\", \"feature.go\")\n104\t\n105\t\t// Get the checkpoint ID from the commit\n106\t\tcommitHash := env.GetHeadHash()\n107\t\tcpID := env.GetCheckpointIDFromCommitMessage(commitHash)\n108\t\tif cpID == \"\" {\n109\t\t\tt.Fatal(\"Commit should have an Entire-Checkpoint trailer\")\n110\t\t}\n111\t\n112\t\t// ========================================\n113\t\t// Phase 4: Verify the read-only session was NOT included in the checkpoint\n114\t\t// ========================================\n115\t\tt.Log(\"Phase 4: Verify checkpoint contains only the coding session\")\n116\t\n117\t\t// Read the checkpoint summary from entire/checkpoints/v1\n118\t\tsummaryPath := CheckpointSummaryPath(cpID)\n119\t\tsummaryContent, found := env.ReadFileFromBranch(paths.MetadataBranchName, summaryPath)\n120\t\tif !found {\n121\t\t\tt.Fatalf(\"CheckpointSummary not found at %s\", summaryPath)\n122\t\t}\n123\t\n124\t\tvar summary checkpoint.CheckpointSummary\n125\t\tif err := json.Unmarshal([]byte(summaryContent), &summary); err != nil {\n126\t\t\tt.Fatalf(\"Failed to parse CheckpointSummary: %v\", err)\n127\t\t}\n128\t\n129\t\t// The checkpoint should contain exactly 1 session (the coding session)\n130\t\tif len(summary.Sessions) != 1 {\n131\t\t\tt.Errorf(\"Checkpoint should contain exactly 1 session (the coding session), got %d sessions\", len(summary.Sessions))\n132\t\t\tfor i, s := range summary.Sessions {\n133\t\t\t\tt.Logf(\"  Session %d: %s\", i, s.Metadata)\n134\t\t\t}\n135\t\t}\n136\t\n137\t\t// Verify the included session is the coding session, not the read-only one\n138\t\tenv.AssertCheckpointContainsSession(t, summary, codingSess.ID)\n139\t\tenv.AssertCheckpointExcludesSession(t, summary, readOnlySess.ID)\n140\t\n141\t\t// The read-only session should NOT have been condensed — verify that none of\n142\t\t// the session fields updated by condensation changed.\n143\t\troStateAfter, err := env.GetSessionState(readOnlySess.ID)\n144\t\tif err != nil {\n145\t\t\tt.Fatalf(\"GetSessionState for read-only session after commit failed: %v\", err)\n146\t\t}\n147\t\tif roStateAfter.LastCheckpointID != roState.LastCheckpointID {\n148\t\t\tt.Errorf(\"Read-only session LastCheckpointID changed from %q to %q — it was incorrectly condensed\",\n149\t\t\t\troState.LastCheckpointID, roStateAfter.LastCheckpointID)\n150\t\t}\n151\t\tif roStateAfter.FullyCondensed != roState.FullyCondensed {\n152\t\t\tt.Errorf(\"Read-only session FullyCondensed changed from %t to %t — it was incorrectly condensed\",\n153\t\t\t\troState.FullyCondensed, roStateAfter.FullyCondensed)\n154\t\t}\n155\t\tif roStateAfter.CheckpointTranscriptStart != roState.CheckpointTranscriptStart {\n156\t\t\tt.Errorf(\"Read-only session CheckpointTranscriptStart changed from %d to %d — it was incorrectly condensed\",\n157\t\t\t\troState.CheckpointTranscriptStart, roStateAfter.CheckpointTranscriptStart)\n158\t\t}\n159\t}\n160\t\n161\t// TestReadOnlySession_ActiveDuringCommit_NotCondensed verifies that a session\n162\t// which is still ACTIVE (between UserPromptSubmit and Stop) but has not touched\n163\t// any files is NOT condensed when a commit happens mid-turn.\n164\t//\n165\t// This is the more realistic scenario for the summarize bug: the read-only session\n166\t// fires UserPromptSubmit and the commit happens before Stop. The session is ACTIVE\n167\t// with recent interaction, which normally bypasses the overlap check. But since\n168\t// no files were touched, it should still not be condensed.\n169\tfunc TestReadOnlySession_ActiveDuringCommit_NotCondensed(t *testing.T) {\n170\t\tt.Parallel()\n171\t\n172\t\tenv := NewFeatureBranchEnv(t)\n173\t\n174\t\t// ========================================\n175\t\t// Phase 1: Create a coding session, do work, stop\n176\t\t// ========================================\n177\t\tt.Log(\"Phase 1: Create a coding session with file changes\")\n178\t\n179\t\tcodingSess := env.NewSession()\n180\t\n181\t\tif err := env.SimulateUserPromptSubmitWithTranscriptPath(codingSess.ID, codingSess.TranscriptPath); err != nil {\n182\t\t\tt.Fatalf(\"coding session user-prompt-submit failed: %v\", err)\n\n... [601 lines truncated] ..."},"type":"attachment","uuid":"157fd61f-89a7-4bf1-baa3-c5153d701900","timestamp":"2026-04-24T13:16:15.346Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"c2a51e7d-ab7f-4f50-9349-537240c8648f","version":"2.1.118","gitBranch":"soph/skip-ephemeral-codex-session"}
