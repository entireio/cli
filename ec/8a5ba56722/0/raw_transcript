{"parentUuid":"80726755-15ec-42d7-ba4f-419e3b6f232c","isSidechain":false,"promptId":"a4f5cad1-499a-4db8-8e81-10d7a66fd642","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Um1A1x8xBRiph1BcBnKmnN","type":"tool_result","content":"2000\t//\n2001\t// The fast path activates when an ACTIVE session exists and either:\n2002\t//   - No TTY is available (agent subprocess, CI), or\n2003\t//   - commit_linking=\"always\" (user opted into auto-linking — needed because\n2004\t//     some agents like Gemini subagents commit mid-turn from processes that\n2005\t//     have /dev/tty but can't respond to prompts, and content detection fails\n2006\t//     since the shadow branch doesn't exist yet).\n2007\tfunc (s *ManualCommitStrategy) tryAgentCommitFastPath(ctx context.Context, commitMsgFile string, sessions []*SessionState, source string) bool {\n2008\t\tnoTTY := !interactive.CanPromptInteractively()\n2009\t\tskipContentDetection := noTTY\n2010\t\tif !skipContentDetection {\n2011\t\t\tif stngs, err := settings.Load(ctx); err == nil {\n2012\t\t\t\tskipContentDetection = stngs.GetCommitLinking() == settings.CommitLinkingAlways\n2013\t\t\t}\n2014\t\t}\n2015\t\tif !skipContentDetection {\n2016\t\t\treturn false\n2017\t\t}\n2018\t\tlogCtx := logging.WithComponent(ctx, \"checkpoint\")\n2019\t\tactiveSessions := 0\n2020\t\temptyActiveSessions := 0\n2021\t\tfor _, state := range sessions {\n2022\t\t\tif !state.Phase.IsActive() {\n2023\t\t\t\tcontinue\n2024\t\t\t}\n2025\t\t\tactiveSessions++\n2026\t\t\t// Skip sessions that have no condensable content: no transcript path,\n2027\t\t\t// no tracked files, and no shadow branch data (StepCount == 0). These\n2028\t\t\t// would produce a Skipped result in CondenseSession, leaving the\n2029\t\t\t// Entire-Checkpoint trailer pointing to nothing on the metadata branch.\n2030\t\t\t// NOTE: conservative approximation of the skip gate in CondenseSession\n2031\t\t\t// (which checks extracted data, not raw state). Keep aligned.\n2032\t\t\tif state.TranscriptPath == \"\" && len(state.FilesTouched) == 0 && state.StepCount == 0 {\n2033\t\t\t\temptyActiveSessions++\n2034\t\t\t\tlogging.Debug(logCtx, \"prepare-commit-msg: fast path skipping empty session\",\n2035\t\t\t\t\tslog.String(\"session_id\", state.SessionID),\n2036\t\t\t\t\tslog.String(\"agent_type\", string(state.AgentType)),\n2037\t\t\t\t)\n2038\t\t\t\tcontinue\n2039\t\t\t}\n2040\t\t\t_ = s.addTrailerForAgentCommit(logCtx, commitMsgFile, state, source) //nolint:errcheck // always returns nil; kept for signature stability\n2041\t\t\treturn true\n2042\t\t}\n2043\t\t// Log why fast path didn't fire — collect session phases for diagnostics.\n2044\t\tphases := make([]string, 0, len(sessions))\n2045\t\tfor _, state := range sessions {\n2046\t\t\tphases = append(phases, string(state.Phase))\n2047\t\t}\n2048\t\tmessage := \"prepare-commit-msg: fast path found no ACTIVE sessions\"\n2049\t\tif activeSessions > 0 && emptyActiveSessions == activeSessions {\n2050\t\t\tmessage = \"prepare-commit-msg: fast path skipped all ACTIVE sessions as empty\"\n2051\t\t}\n2052\t\tlogging.Debug(logCtx, message,\n2053\t\t\tslog.Bool(\"no_tty\", noTTY),\n2054\t\t\tslog.Int(\"sessions\", len(sessions)),\n2055\t\t\tslog.Int(\"active_sessions\", activeSessions),\n2056\t\t\tslog.Int(\"empty_active_sessions\", emptyActiveSessions),\n2057\t\t\tslog.Any(\"session_phases\", phases),\n2058\t\t)\n2059\t\treturn false\n2060\t}\n2061\t\n2062\t// addTrailerForAgentCommit handles the fast path when an agent is committing\n2063\t// (ACTIVE session + no TTY). Generates a checkpoint ID and adds the trailer\n2064\t// directly, bypassing content detection and interactive prompts.\n2065\tfunc (s *ManualCommitStrategy) addTrailerForAgentCommit(logCtx context.Context, commitMsgFile string, state *SessionState, source string) error { //nolint:unparam // kept for signature stability\n2066\t\tcpID, err := id.Generate()\n2067\t\tif err != nil {\n2068\t\t\treturn nil //nolint:nilerr // Hook must be silent on failure\n2069\t\t}\n2070\t\n2071\t\tcontent, err := os.ReadFile(commitMsgFile) //nolint:gosec // commitMsgFile is provided by git hook\n2072\t\tif err != nil {\n2073\t\t\treturn nil //nolint:nilerr // Hook must be silent on failure\n2074\t\t}\n2075\t\n2076\t\tmessage := string(content)\n2077\t\n2078\t\t// Don't add if trailer already exists\n2079\t\tif _, found := trailers.ParseCheckpoint(message); found {\n2080\t\t\treturn nil\n2081\t\t}\n2082\t\n2083\t\tmessage = addCheckpointTrailer(message, cpID)\n2084\t\n2085\t\tlogging.Info(logCtx, \"prepare-commit-msg: agent commit trailer added\",\n2086\t\t\tslog.String(\"strategy\", \"manual-commit\"),\n2087\t\t\tslog.String(\"source\", source),\n2088\t\t\tslog.String(\"checkpoint_id\", cpID.String()),\n2089\t\t\tslog.String(\"session_id\", state.SessionID),\n2090\t\t)\n2091\t\n2092\t\tif err := os.WriteFile(commitMsgFile, []byte(message), 0o600); err != nil { //nolint:gosec // path from git hook arg\n2093\t\t\treturn nil //nolint:nilerr // Hook must be silent on failure\n2094\t\t}\n2095\t\treturn nil\n2096\t}\n2097\t\n2098\t// addCheckpointTrailer adds the Entire-Checkpoint trailer to a commit message.\n2099\t// Delegates to trailers.AppendCheckpointTrailer for trailer-aware formatting.\n2100\tfunc addCheckpointTrailer(message string, checkpointID id.CheckpointID) string {\n2101\t\treturn trailers.AppendCheckpointTrailer(message, checkpointID.String())\n2102\t}\n2103\t\n2104\t// addCheckpointTrailerWithComment adds the Entire-Checkpoint trailer with an explanatory comment.\n2105\t// The trailer is placed above the git comment block but below the user's message area,\n2106\t// with a comment explaining that the user can remove it if they don't want to link the commit\n2107\t// to the agent session. If prompt is non-empty, it's shown as context.\n2108\tfunc addCheckpointTrailerWithComment(message string, checkpointID id.CheckpointID, agentName, prompt string) string {\n2109\t\ttrailer := trailers.Checkpoint