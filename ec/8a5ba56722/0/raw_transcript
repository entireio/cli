riptRef)\n351\t\tif err != nil {\n352\t\t\tcopySpan.RecordError(err)\n353\t\t\tcopySpan.End()\n354\t\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n355\t\t}\n356\t\tlogFile := filepath.Join(sessionDirAbs, paths.TranscriptFileName)\n357\t\tif err := os.WriteFile(logFile, transcriptData, 0o600); err != nil {\n358\t\t\tcopySpan.RecordError(err)\n359\t\t\tcopySpan.End()\n360\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n361\t\t}\n362\t\tlogging.Debug(logCtx, \"copied transcript\",\n363\t\t\tslog.String(\"path\", sessionDir+\"/\"+paths.TranscriptFileName))\n364\t\tcopySpan.End()\n365\t\n366\t\t// Load pre-prompt state (captured on TurnStart)\n367\t\t_, extractSpan := perf.Start(ctx, \"extract_metadata\")\n368\t\tpreState, err := LoadPrePromptState(ctx, sessionID)\n369\t\tif err != nil {\n370\t\t\tlogging.Warn(logCtx, \"failed to load pre-prompt state\",\n371\t\t\t\tslog.String(\"error\", err.Error()))\n372\t\t}\n373\t\n374\t\t// Determine transcript offset\n375\t\ttranscriptOffset := resolveTranscriptOffset(ctx, preState, sessionID)\n376\t\n377\t\t// Backfill prompt.txt from transcript when prompt data is missing.\n378\t\t// This handles agents whose exec mode doesn't fire UserPromptSubmit (e.g., Factory AI\n379\t\t// Droid). The transcript is the source of truth — if ExtractPrompts returns nothing,\n380\t\t// there genuinely were no prompts. We track whether backfill occurred so we can\n381\t\t// update session state after SaveStep (which may reinitialize state).\n382\t\tvar backfilledPrompt string\n383\t\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n384\t\texistingPrompt, readPromptErr := os.ReadFile(promptPath) //nolint:gosec // file content is safe session metadata\n385\t\tif readPromptErr != nil && !os.IsNotExist(readPromptErr) {\n386\t\t\tlogging.Warn(logCtx, \"failed to read prompt.txt, skipping backfill\",\n387\t\t\t\tslog.String(\"error\", readPromptErr.Error()))\n388\t\t} else if len(existingPrompt) == 0 {\