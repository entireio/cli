inedOutput(); err != nil {\n\t\tt.Fatalf(\"stop hook failed: %v\\nOutput: %s\", err, output)\n\t}\n\n\t// Verify .entire was NOT created in subdirectory\n\tsubdirEntire := filepath.Join(subdirPath, \".entire\")\n\tif _, err := os.Stat(subdirEntire); !os.IsNotExist(err) {\n\t\tt.Errorf(\".entire directory should NOT exist in subdirectory %s\", subdirName)\n\t}\n\n\t// Verify we can get rewind points (this uses ListSessions/GetRewindPoints)\n\tpoints := env.GetRewindPoints()\n\t// Shadow strategy should have at least one rewind point\n\tif len(points) == 0 {\n\t\tt.Error(\"expected at least one rewind point after save\")\n\t}\n}\n","structuredPatch":[{"oldStart":92,"oldLines":15,"newStart":92,"newLines":9,"lines":["   // Create a session and files","   session := env.NewSession()"," ","-  // Create a file in the subdirectory (as if Claude wrote it there)","-  env.WriteFile(filepath.Join(subdirName, \"app.js\"), \"console.log('hello');\")","-","-  // Create transcript","-  session.CreateTranscript(\"Create app.js\", []FileChange{","-    {Path: filepath.Join(subdirName, \"app.js\"), Content: \"console.log('hello');\"},","-  })","-","-  // Simulate user-prompt-submit FROM subdirectory","+  // Simulate user-prompt-submit FROM subdirectory. Order matches the real","+  // lifecycle: UserPromptSubmit fires first (before the agent does anything),","+  // then the agent writes files and the transcript, then Stop.","   input := map[string]string{","     \"session_id\":      session.ID,","     \"transcript_path\": session.TranscriptPath,"]},{"oldStart":117,"oldLines":6,"newStart":111,"newLines":12,"lines":["     t.Fatalf(\"user-prompt-submit hook failed: %v\\nOutput: %s\", err, output)","   }"," ","+  // Agent writes a file in the subdirectory and appends to the transcript.","+  env.WriteFile(filepath.Join(subdirName, \"app.js\"), \"console.log('hello');\")","+  session.CreateTranscript(\"Create app.js\", []FileChange{","+    {Path: filepath.Join(subdirName, \"app.js\"), Content