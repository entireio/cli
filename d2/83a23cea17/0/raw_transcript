ntFullSessionArtifactsForTest(t, repo, v2Store, cpID, 0),\n  1534\t\t\t\"migration rerun must not copy archived artifacts back into /full/current\")\n  1535\t}\n  1536\t\n  1537\tfunc v2FullTreeForCheckpoint(t *testing.T, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID) *object.Tree {\n  1538\t\tt.Helper()\n  1539\t\n  1540\t\tfor _, refName := range v2FullRefSearchOrderForTest(t, v2Store) {\n  1541\t\t\t_, rootTreeHash, err := v2Store.GetRefState(refName)\n  1542\t\t\tif err != nil {\n  1543\t\t\t\tcontinue\n  1544\t\t\t}\n  1545\t\t\trootTree, err := repo.TreeObject(rootTreeHash)\n  1546\t\t\trequire.NoError(t, err)\n  1547\t\t\tif _, treeErr := rootTree.Tree(cpID.Path()); treeErr == nil {\n  1548\t\t\t\treturn rootTree\n  1549\t\t\t}\n  1550\t\t}\n  1551\t\n  1552\t\tt.Fatalf(\"checkpoint %s not found in any v2 /full/* ref\", cpID)\n  1553\t\treturn nil\n  1554\t}\n  1555\t\n  1556\tfunc v2FullFileExistsForCheckpoint(t *testing.T, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID, relPath string) bool {\n  1557\t\tt.Helper()\n  1558\t\n  1559\t\tfor _, refName := range v2FullRefSearchOrderForTest(t, v2Store) {\n  1560\t\t\t_, rootTreeHash, err := v2Store.GetRefState(refName)\n  1561\t\t\tif err != nil {\n  1562\t\t\t\tcontinue\n  1563\t\t\t}\n  1564\t\t\trootTree, err := repo.TreeObject(rootTreeHash)\n  1565\t\t\trequire.NoError(t, err)\n  1566\t\t\tif _, err := rootTree.File(cpID.Path() + \"/\" + relPath); err == nil {\n  1567\t\t\t\treturn true\n  1568\t\t\t}\n  1569\t\t}\n  1570\t\treturn false\n  1571\t}\n  1572\t\n  1573\t// removeV2SessionTranscriptFiles deletes raw_transcript[/.NNN] and\n  1574\t// raw_transcript_hash.txt for the given session from every /full/* ref —\n  1575\t// simulating the partial state of an interrupted migration.\n  1576\tfunc removeV2SessionTranscriptFiles(t *testing.T, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID, sessionIdx int) {\n  1577\t\tt.Helpe