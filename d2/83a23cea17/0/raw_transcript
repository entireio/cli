16\t\trefs, err := s.repo.References()\n   417\t\tif err != nil {\n   418\t\t\treturn nil, fmt.Errorf(\"failed to list references: %w\", err)\n   419\t\t}\n   420\t\n   421\t\tvar archived []string\n   422\t\terr = refs.ForEach(func(ref *plumbing.Reference) error {\n   423\t\t\tname := ref.Name().String()\n   424\t\t\tif !strings.HasPrefix(name, paths.V2FullRefPrefix) {\n   425\t\t\t\treturn nil\n   426\t\t\t}\n   427\t\t\tsuffix := strings.TrimPrefix(name, paths.V2FullRefPrefix)\n   428\t\t\tif suffix == \"current\" || !GenerationRefPattern.MatchString(suffix) {\n   429\t\t\t\treturn nil\n   430\t\t\t}\n   431\t\t\tarchived = append(archived, suffix)\n   432\t\t\treturn nil\n   433\t\t})\n   434\t\tif err != nil {\n   435\t\t\treturn nil, fmt.Errorf(\"failed to iterate references: %w\", err)\n   436\t\t}\n   437\t\n   438\t\tsort.Strings(archived)\n   439\t\treturn archived, nil\n   440\t}\n   441\t\n   442\t// NextGenerationNumber returns the next sequential generation number for archiving.\n   443\t// Scans existing archived refs and returns max+1. Returns 1 if no archives exist.\n   444\tfunc (s *V2GitStore) NextGenerationNumber() (int, error) {\n   445\t\tarchived, err := s.ListArchivedGenerations()\n   446\t\tif err != nil {\n   447\t\t\treturn 0, err\n   448\t\t}\n   449\t\n   450\t\tvar maxNum int64\n   451\t\tfor _, name := range archived {\n   452\t\t\tn, parseErr := strconv.ParseInt(name, 10, 64)\n   453\t\t\tif parseErr != nil {\n   454\t\t\t\tcontinue // skip unparseable entries\n   455\t\t\t}\n   456\t\t\tif n > maxNum {\n   457\t\t\t\tmaxNum = n\n   458\t\t\t}\n   459\t\t}\n   460\t\treturn int(maxNum) + 1, nil\n   461\t}\n   462\t\n   463\t// RotateCurrentGenerationIfNeeded archives /full/current when it has reached\n   464\t// maxCheckpoints. It returns the archived ref name when this call completes\n   465\t// a rotation.\n   466\tfunc (s *V2GitStore) RotateCurrentGenerationIfNeeded(ctx context.Context, maxCheckpoints int) (plumbing.ReferenceName, bool, error) {\n   467\t\tif maxCheckpoints <= 0 {\n   468\t\t\tmaxCheckpoints = s.maxCheckpoints()\n   469\t\t}\n   470\t\n   471\t\t// This is a 2-phase operation:\n   472\t\t//\n   473\t\t//  1. Archive: determine the next generation number, create a new ref pointing\n   474\t\t//     to the current /full/current commit.\n   475\t\t//  2. Reset: create a fresh orphan commit with an empty tree, point\n   476\t\t//     /full/current at it.\n   477\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n   478\t\n   479\t\t// Guard against concurrent rotation: re-read /full/current and check if\n   480\t\t// it's still above the threshold. If not, another instance already rotated.\n   481\t\t_, currentTreeHash, err := s.GetRefState(refName)\n   482\t\tif err != nil {\n   483\t\t\treturn \"\", false, fmt.Errorf(\"rotation: failed to read /full/current: %w\", err)\n   484\t\t}\n   485\t\tcheckpointCount, err := s.CountCheckpointsInTree(currentTreeHash)\n   486\t\tif err != nil {\n   487\t\t\treturn \"\", false, fmt.Errorf(\"rotation: failed to count checkpoints: %w\", err)\n   488\t\t}\n   489\t\tif checkpointCount < maxCheckpoints {\n   490\t\t\treturn \"\", false, nil\n   491\t\t}\n   492\t\n   493\t\tcurrentRef, err := s.repo.Reference(refName, true)\n   494\t\tif err != nil {\n   495\t\t\treturn \"\", false, fmt.Errorf(\"rotation: failed to read /full/current ref: %w\", err)\n   496\t\t}\n   497\t\n   498\t\tarchiveNumber, err := s.NextGenerationNumber()\n   499\t\tif err != nil {\n   500\t\t\treturn \"\", false, fmt.Errorf(\"rotation: failed to determine next generation number: %w\", err)\n   501\t\t}\n   502\t\n   503\t\t// Phase 1: Archive — create ref pointing to the current commit.\n   504\t\t// If the archive ref already exists, another instance already rotated — skip.\n   505\t\tarchiveRefName := plumbing.ReferenceName(fmt.Sprintf(\"%s%0*d\", paths.V2FullRefPrefix, generationRefWidth, archiveNumber))\n   506\t\tif _, refErr := s.repo.Reference(arc