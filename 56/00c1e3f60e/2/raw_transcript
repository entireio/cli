{"parentUuid":"76b493e5-f2d5-4ec6-a1ba-cbdc12f5c3b5","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/cmd.go","snippet":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// cmd.go provides NewCommand(), the cobra entry point for `entire review`.\n4\t// It routes through the new AgentReviewer / Sink / Run architecture for\n5\t// launchable agents (claude-code, codex, gemini-cli) and falls back to\n6\t// RunMarkerFallback for non-launchable agents (cursor, opencode,\n7\t// factoryai-droid, copilot-cli).\n8\tpackage review\n9\t\n10\timport (\n11\t\t\"context\"\n12\t\t\"errors\"\n13\t\t\"fmt\"\n14\t\t\"io\"\n15\t\t\"log/slog\"\n16\t\t\"strings\"\n17\t\n18\t\t\"charm.land/huh/v2\"\n19\t\tgit \"github.com/go-git/go-git/v6\"\n20\t\t\"github.com/spf13/cobra\"\n21\t\n22\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n23\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/external\"\n24\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n25\t\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n26\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n27\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n28\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n29\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n30\t)\n31\t\n32\t// Deps collects the runtime-injectable hooks NewCommand needs from the\n33\t// parent cli package. Tests stub fields to drive branches that would\n34\t// otherwise require a real TTY or enabled repo. Production wiring is\n35\t// provided by buildReviewDeps in cmd/entire/cli/review_bridge.go and\n36\t// passed to NewCommand from root.go.\n37\ttype Deps struct {\n38\t\t// GetAgentsWithHooksInstalled returns the registry names of all agents\n39\t\t// whose lifecycle hooks are installed in the current repo.\n40\t\tGetAgentsWithHooksInstalled func(ctx context.Context) []types.AgentName\n41\t\n42\t\t// NewSilentError wraps an error so the cobra root does not double-print it.\n43\t\tNewSilentError func(err error) error\n44\t\n45\t\t// PromptForAgentFn overrides the interactive agent picker. Nil means\n46\t\t// PromptForAgent is used (the real huh form). Tests inject a stub.\n47\t\tPromptForAgentFn func(ctx context.Context, eligible []AgentChoice) (string, error)\n48\t\n49\t\t// MultiPickerFn overrides PickAgents for the multi-agent picker. Nil\n50\t\t// means PickAgents is used (the real huh form). Tests inject a stub.\n51\t\tMultiPickerFn func(ctx context.Context, eligible []AgentChoice) (PickedAgents, error)\n52\t\n53\t\t// HeadHasReviewCheckpoint checks whether HEAD's checkpoint metadata\n54\t\t// includes a review session. Returns (true, infoString) if HasReview is set.\n55\t\t// Injected to avoid an import cycle: review → checkpoint → codex → review.\n56\t\tHeadHasReviewCheckpoint func(ctx context.Context) (bool, string)\n57\t\n58\t\t// ReviewCheckpointContext returns best-effort checkpoint context for the\n59\t\t// branch review scope. Injected from the cli package because checkpoint\n60\t\t// readers cannot be imported here without cycling through agent reviewers.\n61\t\tReviewCheckpointContext func(ctx context.Context, worktreeRoot string, scopeBaseRef string) string\n62\t\n63\t\t// ReviewerFor maps an agent registry name to its AgentReviewer\n64\t\t// implementation. Returns nil for non-launchable agents (cursor, opencode,\n65\t\t// factoryai-droid, copilot-cli). Injected to break the import cycle:\n66\t\t// per-agent reviewer packages import review (for ComposeReviewPrompt /\n67\t\t// AppendReviewEnv), so review/cmd.go cannot import them back.\n68\t\tReviewerFor func(agentName string) reviewtypes.AgentReviewer\n69\t\n70\t\t// AttachCmd, when non-nil, is registered as the `review attach`\n71\t\t// subcommand. Callers in the cli package pass newReviewAttachCmd() here;\n72\t\t// tests pass nil to skip the subcommand.\n73\t\tAttachCmd *cobra.Command\n74\t\n75\t\t// SynthesisProvider, when non-nil, enables the synthesis sink in TTY mode.\n76\t\t// Production wiring resolves the same provider entire explain uses.\n77\t\t// When nil, the synthesis sink is not appended and synthesis is unavailable.\n78\t\tSynthesisProvider SynthesisProvider\n79\t\n80\t\t// PromptYN overrides the y/N confirmation form used by SynthesisSink.\n81\t\t// Nil means the real huh form is used (realPromptYN in synthesis_sink.go).\n82\t\t// Tests inject a stub to avoid TTY interactions.\n83\t\tPromptYN func(ctx context.Context, question string, def bool) (bool, error)\n84\t}\n85\t\n86\t// runReviewDeps carries the subset of Deps that runReview itself reads\n87\t// directly (vs. NewCommand's wiring). Kept unexported so tests construct a\n88\t// Deps value at the package boundary; runReview unpacks the relevant fields.\n89\ttype runReviewDeps struct {\n90\t\tpromptForAgentFn func(ctx context.Context, eligible []AgentChoice) (string, error)\n91\t\tmultiPickerFn    func(ctx context.Context, eligible []AgentChoice) (PickedAgents, error)\n92\t}\n93\t\n94\t// NewCommand returns the `entire review` cobra command wired with the\n95\t// provided deps. Callers in the cli package pass a fully-populated Deps;\n96\t// tests pass a Deps with stub fields.\n97\tfunc NewCommand(deps Deps) *cobra.Command {\n98\t\tvar edit bool\n99\t\tvar agentOverride string\n100\t\tvar baseOverride string\n101\t\tvar findings bool\n102\t\tvar fix bool\n103\t\tvar all bool\n104\t\n105\t\tcmd := &cobra.Command{\n106\t\t\tUse: \"review\",\n107\t\t\t// Hidden from `entire help` while the feature is still maturing —\n108\t\t\t// users who know about it can still run `entire review` / `entire\n109\t\t\t// review --help` and the command works normally.\n110\t\t\tHidden: true,\n111\t\t\tShort:  \"Run configured review skills against the current branch\",\n112\t\t\tLong: `Run the review skills configured in .entire/settings.json against\n113\tthe current branch. On first run, an int