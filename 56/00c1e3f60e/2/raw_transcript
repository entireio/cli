{"parentUuid":"cef04caa-e54f-44a7-8639-d9a672a89cd3","isSidechain":false,"promptId":"6c97c9b9-7a57-42e2-a1b4-f48a4620b50a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RQ3aXoXgmwJ7J8UVz2PDeB","type":"tool_result","content":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// scope.go implements scope detection for `entire review`. The scope is the\n4\t// git ref the review is bounded by: \"commits unique to this branch vs\n5\t// <baseRef>\". Pinning the scope at launch time prevents the divergent-default\n6\t// problem where different agents default to different comparison points (e.g.\n7\t// codex used origin/main...HEAD, claude used working-tree-only) on the same\n8\t// invocation.\n9\tpackage review\n10\t\n11\timport (\n12\t\t\"context\"\n13\t\t\"errors\"\n14\t\t\"fmt\"\n15\t\t\"os/exec\"\n16\t\t\"strconv\"\n17\t\t\"strings\"\n18\t\t\"time\"\n19\t\n20\t\t\"github.com/go-git/go-git/v6\"\n21\t\t\"github.com/go-git/go-git/v6/plumbing\"\n22\t\t\"github.com/go-git/go-git/v6/plumbing/object\"\n23\t\t\"github.com/go-git/go-git/v6/plumbing/storer\"\n24\t)\n25\t\n26\t// ScopeStats summarises the scope of a review for the banner.\n27\ttype ScopeStats struct {\n28\t\tBaseRef       string\n29\t\tCurrentBranch string // empty for detached HEAD\n30\t\tCommits       int    // commits unique to current branch vs BaseRef\n31\t\tFilesChanged  int    // files changed across those commits\n32\t\tUncommitted   int    // uncommitted file changes in the working tree\n33\t}\n34\t\n35\t// formatScopeBanner produces the line printed before agent launch:\n36\t//\n37\t//\t\"Reviewing feat/X vs main: 3 commits, 7 files changed, 2 uncommitted\"\n38\t//\n39\t// Pluralisation: \"1 commit\" / \"2 commits\", \"1 file\" / \"N files\",\n40\t// always \"uncommitted\" (a count, not a noun phrase).\n41\tfunc formatScopeBanner(stats ScopeStats) string {\n42\t\tsubject := stats.CurrentBranch\n43\t\tif subject == \"\" {\n44\t\t\tsubject = \"detached HEAD\"\n45\t\t}\n46\t\n47\t\tcommitWord := \"commits\"\n48\t\tif stats.Commits == 1 {\n49\t\t\tcommitWord = \"commit\"\n50\t\t}\n51\t\tfileWord := \"files\"\n52\t\tif stats.FilesChanged == 1 {\n53\t\t\tfileWord = \"file\"\n54\t\t}\n55\t\n56\t\treturn fmt.Sprintf(\n57\t\t\t\"Reviewing %s vs %s: %d %s, %d %s changed, %d uncommitted\",\n58\t\t\tsubject,\n59\t\t\tstats.BaseRef,\n60\t\t\tstats.Commits,\n61\t\t\tcommitWord,\n62\t\t\tstats.FilesChanged,\n63\t\t\tfileWord,\n64\t\t\tstats.Uncommitted,\n65\t\t)\n66\t}\n67\t\n68\t// ComputeScopeStats gathers the data formatScopeBanner needs.\n69\t// Used by CU6 to build the banner before launching agents.\n70\tfunc ComputeScopeStats(ctx context.Context, repo *git.Repository) (ScopeStats, error) {\n71\t\tbaseRef, err := detectScopeBaseRef(ctx, repo)\n72\t\tif err != nil {\n73\t\t\treturn ScopeStats{}, fmt.Errorf(\"detect scope base ref: %w\", err)\n74\t\t}\n75\t\n76\t\trepoRoot, err := repoWorktreePath(repo)\n77\t\tif err != nil {\n78\t\t\treturn ScopeStats{}, fmt.Errorf(\"get repo root: %w\", err)\n79\t\t}\n80\t\n81\t\tcurrentBranch := currentBranchName(repo)\n82\t\n83\t\tcommits, err := countCommits(ctx, repoRoot, baseRef)\n84\t\tif err != nil {\n85\t\t\treturn ScopeStats{}, fmt.Errorf(\"count commits: %w\", err)\n86\t\t}\n87\t\n88\t\tfilesChanged, err := countFilesChanged(ctx, repoRoot, baseRef)\n89\t\tif err != nil {\n90\t\t\treturn ScopeStats{}, fmt.Errorf(\"count files changed: %w\", err)\n91\t\t}\n92\t\n93\t\tuncommitted, err := countUncommitted(ctx, repoRoot)\n94\t\tif err != nil {\n95\t\t\treturn ScopeStats{}, fmt.Errorf(\"count uncommitted: %w\", err)\n96\t\t}\n97\t\n98\t\treturn ScopeStats{\n99\t\t\tBaseRef:       baseRef,\n100\t\t\tCurrentBranch: currentBranch,\n101\t\t\tCommits:       commits,\n102\t\t\tFilesChanged:  filesChanged,\n103\t\t\tUncommitted:   uncommitted,\n104\t\t}, nil\n105\t}\n106\t\n107\t// detectScopeBaseRef finds the closest non-self ancestor branch the\n108\t// review should be scoped against. Strategy:\n109\t//\n110\t//  1. Find local + remote branches whose tips are ancestors of HEAD\n111\t//     (i.e., branches the current branch is descended from). Exclude\n112\t//     the current branch itself.\n113\t//  2. Pick the one with the most recent commit timestamp at its tip.\n114\t//     This handles stacked PRs where a feature branches off another\n115\t//     feature: prefer the immediate parent over a more distant one.\n116\t//  3. Fallback chain when no ancestor is found:\n117\t//     origin/HEAD → origin/main → origin/master → main → master\n118\t//  4. If none of those exist either, return an error.\n119\t//\n120\t// Returns the ref name (e.g., \"main\", \"origin/main\", \"feat/parent\")\n121\t// suitable for use in `git diff <ref>...HEAD`.\n122\tfunc detectScopeBaseRef(ctx context.Context, repo *git.Repository) (string, error) {\n123\t\thead, err := repo.Head()\n124\t\tif err != nil {\n125\t\t\treturn fallbackScopeRef(repo)\n126\t\t}\n127\t\theadHash := head.Hash()\n128\t\n129\t\t// Determine the current branch's symbolic ref name (empty for detached HEAD).\n130\t\tcurrentBranchShort := \"\"\n131\t\tif head.Name().IsBranch() {\n132\t\t\tcurrentBranchShort = head.Name().Short() // e.g. \"feat/x\"\n133\t\t}\n134\t\n135\t\trepoRoot, rootErr := repoWorktreePath(repo)\n136\t\tif rootErr != nil {\n137\t\t\treturn fallbackScopeRef(repo)\n138\t\t}\n139\t\n140\t\t// Enumerate ancestor branches in a single git invocation. for-each-ref\n141\t\t// --merged HEAD lets git use its commit-graph index to answer \"is this\n142\t\t// ref an ancestor of HEAD?\" in O(1) per ref via packed reachability\n143\t\t// rather than the previous O(branches × commits) repo.Log walks.\n144\t\ttype candidate struct {\n145\t\t\tname    string\n146\t\t\ttipUnix int64\n147\t\t}\n148\t\tvar candidates []candidate\n149\t\n150\t\tout, runErr := runGit(ctx, repoRoot,\n151\t\t\t\"for-each-ref\",\n152\t\t\t\"--merged\", \"HEAD\",\n153\t\t\t\"--format=%(refname:short)%09%(committerdate:unix)\",\n154\t\t\t\"refs/heads/\", \"refs/remotes/\",\n155\t\t)\n156\t\tif runErr != nil {\n157\t\t\t// git for-each-ref unavailable or repo state confused — fall back\n158\t\t\t// to a slow walk via go-git, mirroring the prior behaviour rather\n159\t\t\t// than failing the review launch.\n160\t\t\treturn slowDetectScopeBaseRef(ctx, repo, headHash, currentBranchShort)\n161\t\t}\n162\t\n163\t\tfor _, line := range strings.Split(out, \"\\n\") {\n164\t\t\tif ctx.Err() != nil {\n165\t\t\t\treturn \"\", ctx.Err() //nolint:wrapcheck // propagate context cancellation\n166\t\t\t}\n167\t\t\tline = strings.TrimSpace(line)\n168\t\t\tif line == \"\" {\n169\t\t\t\tcontinue\n170\t\t\t}\n171\t\t\tparts := strings.SplitN(line, \"\\t\", 2)\n172\t\t\tif len(parts) != 2 {\n173\t\t\t\tcontinue\n174\t\t\t}\n175\t\t\tname := parts[0]\n176\t\t\t// Skip the current branch itself (and its full ref form, both shapes\n177\t\t\t// for-each-ref might emit).\n178\t\t\tif name == currentBranchShort {\n179\t\t\t\tcontinue\n180\t\t\t}\n181\t\t\t// Skip refs that resolve to the same commit as HEAD — same hash,\n182\t\t\t// different name (e.g. an unmoved freshly-merged feature).\n183\t\t\tif hash, lookupErr := repo.ResolveRevision(plumbing.Revision(name)); lookupErr == nil && hash != nil && *hash == headHash {\n184\t\t\t\tcontinue\n185\t\t\t}\n186\t\t\tunix, parseErr := strconv.ParseInt(parts[1], 10, 64)\n187\t\t\tif parseErr != nil {\n188\t\t\t\tcontinue\n189\t\t\t}\n190\t\t\tcandidates = append(candidates, candidate{name: name, tipUnix: unix})\n191\t\t}\n192\t\n193\t\tif len(candidates) > 0 {\n194\t\t\t// Pick the candidate with the most recent tip (closest ancestor).\n195\t\t\tbest := candidates[0]\n196\t\t\tfor _, c := range candidates[1:] {\n197\t\t\t\tif c.tipUnix > best.tipUnix {\n198\t\t\t\t\tbest = c\n199\t\t\t\t}\n200\t\t\t}\n201\t\t\treturn best.name, nil\n202\t\t}\n203\t\n204\t\treturn fallbackScopeRef(repo)\n205\t}\n206\t\n207\t// slowDetectScopeBaseRef is the pre-optimization fallback used only when the\n208\t// `git for-each-ref --merged` shell-out fails. It walks all refs and checks\n209\t// ancestry via repo.Log per ref (O(branches × commits)). Kept as a defense\n210\t// against environments where git CLI is unavailable but go-git can still\n211\t// resolve refs.\n212\tfunc slowDetectScopeBaseRef(ctx context.Context, repo *git.Repository, headHash plumbing.Hash, currentBranchShort string) (string, error) {\n213\t\trefs, err := repo.References()\n214\t\tif err != nil {\n215\t\t\treturn fallbackScopeRef(repo)\n216\t\t}\n217\t\n218\t\ttype candidate struct {\n219\t\t\tname    string\n220\t\t\ttipTime time.Time\n221\t\t}\n222\t\tvar candidates []candidate\n223\t\n224\t\t_ = refs.ForEach(func(ref *plumbing.Reference) error { //nolint:errcheck // best-effort search\n225\t\t\tif ctx.Err() != nil {\n226\t\t\t\treturn ctx.Err()\n227\t\t\t}\n228\t\t\tif !ref.Name().IsBranch() && !ref.Name().IsRemote() {\n229\t\t\t\treturn nil\n230\t\t\t}\n231\t\t\tif ref.Name().Short() == currentBranchShort {\n232\t\t\t\treturn nil\n233\t\t\t}\n234\t\t\ttipHash := ref.Hash()\n235\t\t\tif tipHash == headHash {\n236\t\t\t\treturn nil\n237\t\t\t}\n238\t\t\tisAnc, ancErr := isAncestorOf(ctx, repo, tipHash, headHash)\n239\t\t\tif ancErr != nil {\n240\t\t\t\treturn nil //nolint:nilerr // best-effort: skip unresolvable refs\n241\t\t\t}\n242\t\t\tif !isAnc {\n243\t\t\t\treturn nil\n244\t\t\t}\n245\t\t\tcommit, cErr := repo.CommitObject(tipHash)\n246\t\t\tif cErr != nil {\n247\t\t\t\treturn nil //nolint:nilerr // best-effort: skip refs with no commit object\n248\t\t\t}\n249\t\t\tcandidates = append(candidates, candidate{\n250\t\t\t\tname:    ref.Name().Short(),\n251\t\t\t\ttipTime: commit.Committer.When,\n252\t\t\t})\n253\t\t\treturn nil\n254\t\t})\n255\t\tif ctx.Err() != nil {\n256\t\t\treturn \"\", ctx.Err() //nolint:wrapcheck // propagate context cancellation\n257\t\t}\n258\t\tif len(candidates) > 0 {\n259\t\t\tbest := candidates[0]\n260\t\t\tfor _, c := range candidates[1:] {\n261\t\t\t\tif c.tipTime.After(best.tipTime) {\n262\t\t\t\t\tbest = c\n263\t\t\t\t}\n264\t\t\t}\n265\t\t\treturn best.name, nil\n266\t\t}\n267\t\treturn fallbackScopeRef(repo)\n268\t}\n269\t\n270\t// repoWorktreePath returns the working-tree path for repo, or an error if the\n271\t// repo is bare or its worktree can't be resolved. detectScopeBaseRef needs\n272\t// this to invoke `git for-each-ref` with the right working directory.\n273\tfunc repoWorktreePath(repo *git.Repository) (string, error) {\n274\t\twt, err := repo.Worktree()\n275\t\tif err != nil {\n276\t\t\treturn \"\", fmt.Errorf(\"resolve worktree: %w\", err)\n277\t\t}\n278\t\treturn wt.Filesystem().Root(), nil\n279\t}\n280\t\n281\t// fallbackScopeRef returns the first existing ref from the fallback chain:\n282\t// origin/HEAD → origin/main → origin/master → main → master.\n283\t// Returns an error if none exist.\n284\tfunc fallbackScopeRef(repo *git.Repository) (string, error) {\n285\t\tchain := []string{\"origin/HEAD\", \"origin/main\", \"origin/master\", \"main\", \"master\"}\n286\t\tfor _, name := range chain {\n287\t\t\tif refExists(repo, name) {\n288\t\t\t\treturn name, nil\n289\t\t\t}\n290\t\t}\n291\t\treturn \"\", errors.New(\"no suitable ancestor branch found; configure a base ref explicitly\")\n292\t}\n293\t\n294\t// refExists reports whether a ref with the given short name exists in repo.\n295\tfunc refExists(repo *git.Repository, shortName string) bool {\n296\t\trefs, err := repo.References()\n297\t\tif err != nil {\n298\t\t\treturn false\n299\t\t}\n300\t\tfound := false\n301\t\t_ = refs.ForEach(func(ref *plumbing.Reference) error { //nolint:errcheck // best-effort search\n302\t\t\tif ref.Name().Short() == shortName {\n303\t\t\t\tfound = true\n304\t\t\t\treturn storer.ErrStop\n305\t\t\t}\n306\t\t\treturn nil\n307\t\t})\n308\t\treturn found\n309\t}\n310\t\n311\t// isAncestorOf checks if candidate is an ancestor of (or equal to) target\n312\t// by walking the commit graph from target backwards.\n313\tfunc isAncestorOf(ctx context.Context, repo *git.Repository, candidate, target plumbing.Hash) (bool, error) {\n314\t\tif candidate == target {\n315\t\t\treturn true, nil\n316\t\t}\n317\t\n318\t\titer, err := repo.Log(&git.LogOptions{From: target})\n319\t\tif err != nil {\n320\t\t\treturn false, fmt.Errorf(\"log from target: %w\", err)\n321\t\t}\n322\t\tdefer iter.Close()\n323\t\n324\t\tfound := false\n325\t\t_ = iter.ForEach(func(c *object.Commit) error { //nolint:errcheck // storer.ErrStop is expected\n326\t\t\tif ctx.Err() != nil {\n327\t\t\t\treturn ctx.Err()\n328\t\t\t}\n329\t\t\tif c.Hash == candidate {\n330\t\t\t\tfound = true\n331\t\t\t\treturn storer.ErrStop\n332\t\t\t}\n333\t\t\treturn nil\n334\t\t})\n335\t\t// Context cancellation: surface. storer.ErrStop or log exhaustion: ignore.\n336\t\tif ctx.Err() != nil {\n337\t\t\treturn false, ctx.Err() //nolint:wrapcheck // propagate context cancellation\n338\t\t}\n339\t\treturn found, nil\n340\t}\n341\t\n342\t// currentBranchName returns the short branch name for the current HEAD,\n343\t// or \"\" for detached HEAD.\n344\tfunc currentBranchName(repo *git.Repository) string {\n345\t\thead, err := repo.Head()\n346\t\tif err != nil {\n347\t\t\treturn \"\"\n348\t\t}\n349\t\tif !head.Name().IsBranch() {\n350\t\t\treturn \"\" // detached HEAD\n351\t\t}\n352\t\treturn head.Name().Short()\n353\t}\n354\t\n355\t// countCommits returns the number of commits in <baseRef>..HEAD\n356\t// (commits on the current branch not in baseRef).\n357\tfunc countCommits(ctx context.Context, repoRoot, baseRef string) (int, error) {\n358\t\tout, err := runGit(ctx, repoRoot, \"rev-list\", \"--count\", baseRef+\"..HEAD\")\n359\t\tif err != nil {\n360\t\t\treturn 0, err\n361\t\t}\n362\t\tn, err := strconv.Atoi(strings.TrimSpace(out))\n363\t\tif err != nil {\n364\t\t\treturn 0, fmt.Errorf(\"parse commit count: %w\", err)\n365\t\t}\n366\t\treturn n, nil\n367\t}\n368\t\n369\t// countFilesChanged returns the number of unique files changed in <baseRef>..HEAD.\n370\tfunc countFilesChanged(ctx context.Context, repoRoot, baseRef string) (int, error) {\n371\t\tout, err := runGit(ctx, repoRoot, \"diff\", \"--name-only\", baseRef+\"..HEAD\")\n372\t\tif err != nil {\n373\t\t\treturn 0, err\n374\t\t}\n375\t\ttrimmed := strings.TrimSpace(out)\n376\t\tif trimmed == \"\" {\n377\t\t\treturn 0, nil\n378\t\t}\n379\t\treturn len(strings.Split(trimmed, \"\\n\")), nil\n380\t}\n381\t\n382\t// countUncommitted returns the number of lines in `git status --porcelain`\n383\t// (each line corresponds to one changed or untracked file).\n384\tfunc countUncommitted(ctx context.Context, repoRoot string) (int, error) {\n385\t\tout, err := runGit(ctx, repoRoot, \"status\", \"--porcelain\")\n386\t\tif err != nil {\n387\t\t\treturn 0, err\n388\t\t}\n389\t\ttrimmed := strings.TrimSpace(out)\n390\t\tif trimmed == \"\" {\n391\t\t\treturn 0, nil\n392\t\t}\n393\t\treturn len(strings.Split(trimmed, \"\\n\")), nil\n394\t}\n395\t\n396\t// runGit runs `git <args>` in repoDir and returns stdout as a string.\n397\t// stderr is captured separately and surfaced in the error wrap on non-zero\n398\t// exit. Stdout and stderr are NOT combined — git emits warnings on stderr\n399\t// even on successful commands (shallow-clone notices, safe.directory\n400\t// advisories, etc.) and merging them would corrupt parsed output (e.g.,\n401\t// strconv.Atoi on the result of `rev-list --count` would fail).\n402\tfunc runGit(ctx context.Context, repoRoot string, args ...string) (string, error) {\n403\t\tcmd := exec.CommandContext(ctx, \"git\", args...)\n404\t\tcmd.Dir = repoRoot\n405\t\tvar stderr strings.Builder\n406\t\tcmd.Stderr = &stderr\n407\t\tout, err := cmd.Output()\n408\t\tif err != nil {\n409\t\t\t// Surface stderr so callers see why git rejected the command,\n410\t\t\t// not just \"exit status 128\".\n411\t\t\tstderrTxt := strings.TrimSpace(stderr.String())\n412\t\t\tif stderrTxt != \"\" {\n413\t\t\t\treturn \"\", fmt.Errorf(\"git %s: %w (stderr: %s)\", args[0], err, stderrTxt)\n414\t\t\t}\n415\t\t\treturn \"\", fmt.Errorf(\"git %s: %w\", args[0], err)\n416\t\t}\n417\t\treturn string(out), nil\n418\t}\n419\t"}]},"uuid":"7b448533-e4f9-48dd-82ed-adc4a206abd7","timestamp":"2026-05-08T19:32:16.633Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/scope.go","content":"// Package review — see env.go for package-level rationale.\n//\n// scope.go implements scope detection for `entire review`. The scope is the\n// git ref the review is bounded by: \"commits unique to this branch vs\n// <baseRef>\". Pinning the scope at launch time prevents the divergent-default\n// problem where different agents default to different comparison points (e.g.\n// codex used origin/main...HEAD, claude used working-tree-only) on the same\n// invocation.\npackage review\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/go-git/go-git/v6\"\n\t\"github.com/go-git/go-git/v6/plumbing\"\n\t\"github.com/go-git/go-git/v6/plumbing/object\"\n\t\"github.com/go-git/go-git/v6/plumbing/storer\"\n)\n\n// ScopeStats summarises the scope of a review for the banner.\ntype ScopeStats struct {\n\tBaseRef       string\n\tCurrentBranch string // empty for detached HEAD\n\tCommits       int    // commits unique to current branch vs BaseRef\n\tFilesChanged  int    // files changed across those commits\n\tUncommitted   int    // uncommitted file changes in the working tree\n}\n\n// formatScopeBanner produces the line printed before agent launch:\n//\n//\t\"Reviewing feat/X vs main: 3 commits, 7 files changed, 2 uncommitted\"\n//\n// Pluralisation: \"1 commit\" / \"2 commits\", \"1 file\" / \"N files\",\n// always \"uncommitted\" (a count, not a noun phrase).\nfunc formatScopeBanner(stats ScopeStats) string {\n\tsubject := stats.CurrentBranch\n\tif subject == \"\" {\n\t\tsubject = \"detached HEAD\"\n\t}\n\n\tcommitWord := \"commits\"\n\tif stats.Commits == 1 {\n\t\tcommitWord = \"commit\"\n\t}\n\tfileWord := \"files\"\n\tif stats.FilesChanged == 1 {\n\t\tfileWord = \"file\"\n\t}\n\n\treturn fmt.Sprintf(\n\t\t\"Reviewing %s vs %s: %d %s, %d %s changed, %d uncommitted\",\n\t\tsubject,\n\t\tstats.BaseRef,\n\t\tstats.Commits,\n\t\tcommitWord,\n\t\tstats.FilesChanged,\n\t\tfileWord,\n\t\tstats.Uncommitted,\n\t)\n}\n\n// ComputeScopeStats gathers the data formatScopeBanner needs.\n// Used by CU6 to build the banner before launching agents.\nfunc ComputeScopeStats(ctx context.Context, repo *git.Repository) (ScopeStats, error) {\n\tbaseRef, err := detectScopeBaseRef(ctx, repo)\n\tif err != nil {\n\t\treturn ScopeStats{}, fmt.Errorf(\"detect scope base ref: %w\", err)\n\t}\n\n\trepoRoot, err := repoWorktreePath(repo)\n\tif err != nil {\n\t\treturn ScopeStats{}, fmt.Errorf(\"get repo root: %w\", err)\n\t}\n\n\tcurrentBranch := currentBranchName(repo)\n\n\tcommits, err := countCommits(ctx, repoRoot, baseRef)\n\tif err != nil {\n\t\treturn ScopeStats{}, fmt.Errorf(\"count commits: %w\", err)\n\t}\n\n\tfilesChanged, err := countFilesChanged(ctx, repoRoot, baseRef)\n\tif err != nil {\n\t\treturn ScopeStats{}, fmt.Errorf(\"count files changed: %w\", err)\n\t}\n\n\tuncommitted, err := countUncommitted(ctx, repoRoot)\n\tif err != nil {\n\t\treturn ScopeStats{}, fmt.Errorf(\"count uncommitted: %w\", err)\n\t}\n\n\treturn ScopeStats{\n\t\tBaseRef:       baseRef,\n\t\tCurrentBranch: currentBranch,\n\t\tCommits:       commits,\n\t\tFilesChanged:  filesChanged,\n\t\tUncommitted:   uncommitted,\n\t}, nil\n}\n\n// detectScopeBaseRef finds the closest non-self ancestor branch the\n// review should be scoped against. Strategy:\n//\n//  1. Find local + remote branches whose tips are ancestors of HEAD\n//     (i.e., branches the current branch is descended from). Exclude\n//     the current branch itself.\n//  2. Pick the one with the most recent commit timestamp at its tip.\n//     This handles stacked P