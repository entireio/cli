— it's a terse status summary that benefits\n47\t// from staying on a single uncolored line for grep-ability.\n48\t//\n49\t// Markdown structure per agent:\n50\t//\n51\t//\t# <name> review\n52\t//\t(optional status line for cancelled / failed)\n53\t//\t(optional blockquote for RunError events on failure)\n54\t//\t(narrative — agent's AssistantText events joined)\n55\tfunc (s DumpSink) dumpAgent(run reviewtypes.AgentRun) {\n56\t\tvar b strings.Builder\n57\t\tfmt.Fprintf(&b, \"# %s review\\n\\n\", run.Name)\n58\t\n59\t\tswitch run.Status {\n60\t\tcase reviewtypes.AgentStatusCancelled:\n61\t\t\tb.WriteString(\"_cancelled_\\n\")\n62\t\tcase reviewtypes.AgentStatusFailed:\n63\t\t\t// Surface the wait error if any (process exit failure), then any\n64\t\t\t// agent-level RunError events the parser emitted (typically a torn\n65\t\t\t// stdout stream — caught at the orchestrator level by classifyStatus\n66\t\t\t// even when the process itself exited 0).\n67\t\t\twriteFailureHeader(&b, run.Err)\n68\t\t\tfor _, ev := range run.Buffer {\n69\t\t\t\tre, ok := ev.(reviewtypes.RunError)\n70\t\t\t\tif !ok || re.Err == nil {\n71\t\t\t\t\tcontinue\n72\t\t\t\t}\n73\t\t\t\t// Skip the synthetic RunError that the orchestrator emits to drive\n74\t\t\t\t// live TUI updates: it carries the same error as run.Err, which\n75\t\t\t\t// the failure header already rendered. Without this the same\n76\t\t\t\t// error text appears twice in adjacent output blocks.\n77\t\t\t\tif run.Err != nil && errors.Is(re.Err, run.Err) {\n78\t\t\t\t\tcontinue\n79\t\t\t\t}\n80\t\t\t\tfmt.Fprintf(&b, \"> agent error: `%v`\\n\\n\", re.Err)\n81\t\t\t}\n82\t\t\t// Render any narrative text the agent produced before the failure\n83\t\t\t// surfaced — useful when the parser tore mid-response so reviewers\n84\t\t\t// can see partial output instead of a bare \"(failed)\" line.\n85\t\t\tif narrative := joinAssistantText(run.Buffer); narrative != \"\" {\n86\t\t\t\tb.WriteString(narrative)\n87\t\t\t\tb.WriteString(\"\\n\")\n8