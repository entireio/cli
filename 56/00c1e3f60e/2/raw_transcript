{"parentUuid":"b9bc11cb-c96b-41cf-bb0a-74e99197735c","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/tui_model.go","snippet":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// tui_model.go provides reviewTUIModel, the Bubble Tea Model for the\n4\t// review dashboard. The model renders a per-agent status table\n5\t// during the run and supports Ctrl+O drill-in mode for inspecting one agent's\n6\t// live event buffer on the alt screen.\n7\tpackage review\n8\t\n9\timport (\n10\t\t\"context\"\n11\t\t\"fmt\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"sync\"\n15\t\t\"time\"\n16\t\n17\t\t\"charm.land/bubbles/v2/spinner\"\n18\t\ttea \"charm.land/bubbletea/v2\"\n19\t\t\"charm.land/lipgloss/v2\"\n20\t\n21\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n22\t\t\"github.com/entireio/cli/cmd/entire/cli/stringutil\"\n23\t)\n24\t\n25\t// agentRow holds per-agent live state during the TUI run.\n26\ttype agentRow struct {\n27\t\tname     string\n28\t\tstatus   reviewtypes.AgentStatus\n29\t\trunStart time.Time          // stamped on first event from this agent\n30\t\trunEnd   time.Time          // stamped on Finished/RunError event\n31\t\ttokens   reviewtypes.Tokens // cumulative\n32\t\tpreview  string             // latest AssistantText preview, capped by display width\n33\t\tbuffer   []reviewtypes.Event\n34\t\terr      error\n35\t}\n36\t\n37\t// agentEventMsg is sent to the Bubble Tea program when an agent emits an event.\n38\ttype agentEventMsg struct {\n39\t\tagent string\n40\t\tev    reviewtypes.Event\n41\t}\n42\t\n43\t// runFinishedMsg is sent when the orchestrator calls RunFinished.\n44\ttype runFinishedMsg struct {\n45\t\tsummary reviewtypes.RunSummary\n46\t}\n47\t\n48\t// tickMsg triggers spinner and duration column updates.\n49\ttype tickMsg time.Time\n50\t\n51\t// reviewTUIModel is the Bubble Tea model for the review dashboard.\n52\ttype reviewTUIModel struct {\n53\t\trows         []agentRow\n54\t\trowIdx       map[string]int // agent name → row index (O(1) lookup)\n55\t\tdetailMode   bool\n56\t\tdetailIdx    int // which agent is shown in drill-in\n57\t\tdetailScroll int\n58\t\n59\t\tcancel     context.CancelFunc\n60\t\tcancelOnce *sync.Once\n61\t\n62\t\tspinner    spinner.Model\n63\t\ttermWidth  int\n64\t\ttermHeight int\n65\t\n66\t\tfinished bool\n67\t\tsummary  reviewtypes.RunSummary\n68\t}\n69\t\n70\t// newReviewTUIModel builds an initial model pre-populated with one row per\n71\t// agent. cancel is the shared CancelFunc; it must be the same one passed to\n72\t// NewTUISink.\n73\tfunc newReviewTUIModel(agents []string, cancel context.CancelFunc) reviewTUIModel {\n74\t\tsp := spinner.New()\n75\t\tsp.Spinner = spinner.Dot\n76\t\tsp.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n77\t\n78\t\trows := make([]agentRow, len(agents))\n79\t\trowIdx := make(map[string]int, len(agents))\n80\t\tfor i, name := range agents {\n81\t\t\trows[i] = agentRow{\n82\t\t\t\tname:   name,\n83\t\t\t\tstatus: reviewtypes.AgentStatusUnknown,\n84\t\t\t}\n85\t\t\trowIdx[name] = i\n86\t\t}\n87\t\treturn reviewTUIModel{\n88\t\t\trows:       rows,\n89\t\t\trowIdx:     rowIdx,\n90\t\t\tcancel:     cancel,\n91\t\t\tcancelOnce: &sync.Once{},\n92\t\t\tspinner:    sp,\n93\t\t\ttermWidth:  80,\n94\t\t\ttermHeight: 24,\n95\t\t}\n96\t}\n97\t\n98\t// tickCmd schedules the next tick for duration/spinner refresh.\n99\tfunc tickCmd() tea.Cmd {\n100\t\treturn tea.Tick(100*time.Millisecond, func(t time.Time) tea.Msg {\n101\t\t\treturn tickMsg(t)\n102\t\t})\n103\t}\n104\t\n105\t// Init returns the initial spinner tick command.\n106\tfunc (m reviewTUIModel) Init() tea.Cmd {\n107\t\treturn tea.Batch(m.spinner.Tick, tickCmd())\n108\t}\n109\t\n110\t// Update handles all incoming messages.\n111\tfunc (m reviewTUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n112\t\tswitch msg := msg.(type) {\n113\t\tcase agentEventMsg:\n114\t\t\treturn m.handleAgentEvent(msg)\n115\t\n116\t\tcase runFinishedMsg:\n117\t\t\tm.finished = true\n118\t\t\tm.summary = msg.summary\n119\t\t\t// Sync each row's status from the orchestrator's summary. The\n120\t\t\t// in-stream events (Finished / RunError) update status as they\n121\t\t\t// arrive, but the orchestrator's classifyStatus has access to\n122\t\t\t// process-level signals (Wait error, ctx cancellation) that the\n123\t\t\t// event stream never surfaces. Without this sync, an agent that\n124\t\t\t// the orchestrator classified Cancelled (Ctrl+C path, no Finished\n125\t\t\t// emitted) or Failed (process exit non-zero, no Finished emitted)\n126\t\t\t// would still render as \"running\" in the final frame.\n127\t\t\t//\n128\t\t\t// Preserve any already-set status from the event stream — if the\n129\t\t\t// stream said Failed (RunError), the summary may say Succeeded\n130\t\t\t// (process exit 0); RunError stickiness wins. Only overwrite when\n131\t\t\t// the row is still in AgentStatusUnknown.\n132\t\t\tnow := time.Now()\n133\t\t\tfor i, run := range msg.summary.AgentRuns {\n134\t\t\t\tif i >= len(m.rows) {\n135\t\t\t\t\tbreak\n136\t\t\t\t}\n137\t\t\t\tif m.rows[i].status == reviewtypes.AgentStatusUnknown {\n138\t\t\t\t\tm.rows[i].status = run.Status\n139\t\t\t\t}\n140\t\t\t\tif m.rows[i].runEnd.IsZero() && !m.rows[i].runStart.IsZero() {\n141\t\t\t\t\tm.rows[i].runEnd = now\n142\t\t\t\t}\n143\t\t\t}\n144\t\t\treturn m, nil\n145\t\n146\t\tcase tickMsg:\n147\t\t\tvar spinCmd tea.Cmd\n148\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n149\t\t\treturn m, tea.Batch(spinCmd, tickCmd())\n150\t\n151\t\tcase spinner.TickMsg:\n152\t\t\tvar spinCmd tea.Cmd\n153\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n154\t\t\treturn m, spinCmd\n155\t\n156\t\tcase tea.WindowSizeMsg:\n157\t\t\tm.termWidth = msg.Width\n158\t\t\tm.termHeight = msg.Height\n159\t\t\tm = m.clampScroll()\n160\t\t\treturn m, nil\n161\t\n162\t\tcase tea.KeyPressMsg:\n163\t\t\treturn m.handleKey(msg)\n164\t\t}\n165\t\treturn m, nil\n166\t}\n167\t\n168\t// handleAgentEvent processes an agentEventMsg, updating the relevant row.\n169\tfunc (m reviewTUIModel) handleAgentEvent(msg agentEventMsg) (tea.Model, tea.Cmd) {\n170\t\tidx, ok := m.rowIdx[msg.agent]\n171\t\tif !ok {\n172\t\t\treturn m, nil\n173\t\t}\n174\t\trow := &m.rows[idx]\n175\t\n176\t\t// Stamp run-start on the first event from this agent (per-row, not\n177\t\t// TUI-start; prevents inflated durations for late-starting agents).\n178\t\tif row.runStart.IsZero() {\n179\t\t\trow.runStart = time.Now()\n180\t\t}\n181\t\n182\t\trow.buffer = append(row.buffer, msg.ev)\n183\t\n184\t\tswitch e := msg.ev.(type) {\n185\t\tcase reviewtypes.Started:\n186\t\t\t// runStart already set; no other state update needed.\n187\t\tcase reviewtypes.AssistantText:\n188\t\t\tcollapsed := stringutil.CollapseWhitespace(sanitizeDisplayText(e.Text))\n189\t\t\trow.preview = truncateDisplayWidth(collapsed, 80)\n190\t\tcase reviewtypes.Tokens:\n191\t\t\trow.tokens = e // cumulative: overwrite, not sum\n192\t\tcase reviewtypes.Finished:\n193\t\t\t// RunError is sticky: if a prior RunError event already classified\n194\t\t\t// this row as Failed, a subsequent Finished{Success: true} must NOT\n195\t\t\t// flip it back to Succeeded. CU3's parser-fix-loop guarantees that\n196\t\t\t// RunError + Finished{Success:false} both accompany torn streams;\n197\t\t\t// matching that contract here keeps the TUI consistent with\n198\t\t\t// classifyStatus from CU4 (which honors sawRunError).\n199\t\t\tif row.status != reviewtypes.AgentStatusFailed {\n200\t\t\t\tif e.Success {\n201\t\t\t\t\trow.status = reviewtypes.AgentStatusSucceeded\n202\t\t\t\t} else {\n203\t\t\t\t\trow.status = reviewtypes.AgentStatusFailed\n204\t\t\t\t}\n205\t\t\t}\n206\t\t\trow.runEnd = time.Now()\n207\t\tcase reviewtypes.RunError:\n208\t\t\trow.status = reviewtypes.AgentStatusFailed\n209\t\t\trow.err = e.Err\n210\t\t\tif row.runEnd.IsZero() {\n211\t\t\t\trow.runEnd = time.Now()\n212\t\t\t}\n213\t\tcase reviewtypes.ToolCall:\n214\t\t\t// No visible state update for tool calls in the dashboard.\n215\t\t}\n216\t\n217\t\t// Auto-follow ONLY when the user is already at the bottom. This lets a\n218\t\t// user scroll up to inspect older events without each new event yanking\n219\t\t// them back to the tail. The pre-append max-scroll was for buffer\n220\t\t// length-1; if detailScroll was at-or-past that, the user was tailing.\n221\t\tif m.detailMode && m.detailIdx == idx {\n222\t\t\tpreAppendMax := len(row.buffer) - 2 // -1 for the just-appended event, -1 for max-index\n223\t\t\tif preAppendMax < 0 || m.detailScroll >= preAppendMax {\n224\t\t\t\tm.detailScroll = m.maxDetailScroll()\n225\t\t\t}\n226\t\t}\n227\t\n228\t\treturn m, nil\n229\t}\n230\t\n231\t// handleKey processes keyboard input.\n232\tfunc (m reviewTUIModel) handleKey(msg tea.KeyPressMsg) (tea.Model, tea.Cmd) {\n233\t\t// Any key after finished dismisses.\n234\t\tif m.finished {\n235\t\t\treturn m, tea.Quit\n236\t\t}\n237\t\n238\t\tswitch {\n239\t\tcase msg.Code == 'c' && msg.Mod == tea.ModCtrl:\n240\t\t\tif m.detailMode {\n\n... [229 lines truncated] ..."},"type":"attachment","uuid":"0cb1dd2a-3e5b-4df2-9ab1-069adeb9b998","timestamp":"2026-05-08T21:05:51.901Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"802b09ab-4617-4518-902c-87ed5837e8f3","version":"2.1.133","gitBranch":"main"}
{"parentUuid":"0cb1dd2a-3e5b-4df2-9ab1-069adeb9b998","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/run_multi_test.go","snippet":"1\tpackage review\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"sync/atomic\"\n7\t\t\"testing\"\n8\t\t\"time\"\n9\t\n10\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n11\t)\n12\t\n13\t// TestRunMulti_BothSucceed verifies that two agents that complete cleanly\n14\t// produce two AgentRuns with status Succeeded, that all events from both\n15\t// agents reach the sink, and that sinks see RunFinished exactly once.\n16\tfunc TestRunMulti_BothSucceed(t *testing.T) {\n17\t\tt.Parallel()\n18\t\teventsA := []reviewtypes.Event{\n19\t\t\treviewtypes.Started{},\n20\t\t\treviewtypes.AssistantText{Text: \"agent-a review\"},\n21\t\t\treviewtypes.Finished{Success: true},\n22\t\t}\n23\t\teventsB := []reviewtypes.Event{\n24\t\t\treviewtypes.Started{},\n25\t\t\treviewtypes.AssistantText{Text: \"agent-b review\"},\n26\t\t\treviewtypes.Finished{Success: true},\n27\t\t}\n28\t\tra := &stubReviewer{name: \"agent-a\", events: eventsA}\n29\t\trb := &stubReviewer{name: \"agent-b\", events: eventsB}\n30\t\trec := &stubSinkRecorder{}\n31\t\n32\t\tsummary, err := RunMulti(context.Background(), []reviewtypes.AgentReviewer{ra, rb}, reviewtypes.RunConfig{}, []reviewtypes.Sink{rec})\n33\t\tif err != nil {\n34\t\t\tt.Fatalf(\"expected nil error, got %v\", err)\n35\t\t}\n36\t\tif summary.Cancelled {\n37\t\t\tt.Error(\"expected Cancelled=false\")\n38\t\t}\n39\t\tif len(summary.AgentRuns) != 2 {\n40\t\t\tt.Fatalf(\"expected 2 AgentRuns, got %d\", len(summary.AgentRuns))\n41\t\t}\n42\t\tfor _, run := range summary.AgentRuns {\n43\t\t\tif run.Status != reviewtypes.AgentStatusSucceeded {\n44\t\t\t\tt.Errorf(\"agent %s: expected Succeeded, got %v\", run.Name, run.Status)\n45\t\t\t}\n46\t\t}\n47\t\t// Total events from both agents: 3 + 3 = 6.\n48\t\tif len(rec.agentEvents) != 6 {\n49\t\t\tt.Errorf(\"expected 6 AgentEvent calls total, got %d\", len(rec.agentEvents))\n50\t\t}\n51\t\t// RunFinished called exactly once.\n52\t\tif len(rec.finishedCalls) != 1 {\n53\t\t\tt.Errorf(\"expected 1 RunFinished call, got %d\", len(rec.finishedCalls))\n54\t\t}\n55\t}\n56\t\n57\t// TestRunMulti_OneSucceedsOneFails verifies that an agent failure does not\n58\t// block the other agent, firstErr is non-nil, and both AgentRuns are\n59\t// populated.\n60\tfunc TestRunMulti_OneSucceedsOneFails(t *testing.T) {\n61\t\tt.Parallel()\n62\t\tfakeErr := errors.New(\"exit status 1\")\n63\t\tra := &stubReviewer{\n64\t\t\tname:   \"ok-agent\",\n65\t\t\tevents: []reviewtypes.Event{reviewtypes.Started{}, reviewtypes.Finished{Success: true}},\n66\t\t}\n67\t\trb := &stubReviewer{\n68\t\t\tname:    \"fail-agent\",\n69\t\t\tevents:  []reviewtypes.Event{reviewtypes.Started{}, reviewtypes.Finished{Success: false}},\n70\t\t\twaitErr: fakeErr,\n71\t\t}\n72\t\trec := &stubSinkRecorder{}\n73\t\n74\t\tsummary, err := RunMulti(context.Background(), []reviewtypes.AgentReviewer{ra, rb}, reviewtypes.RunConfig{}, []reviewtypes.Sink{rec})\n75\t\tif err == nil {\n76\t\t\tt.Fatal(\"expected non-nil firstErr\")\n77\t\t}\n78\t\tif len(summary.AgentRuns) != 2 {\n79\t\t\tt.Fatalf(\"expected 2 AgentRuns, got %d\", len(summary.AgentRuns))\n80\t\t}\n81\t\t// Both agents delivered events to the sink.\n82\t\tif len(rec.agentEvents) != 4 {\n83\t\t\tt.Errorf(\"expected 4 AgentEvent calls (2 per agent), got %d\", len(rec.agentEvents))\n84\t\t}\n85\t\t// Verify per-agent statuses.\n86\t\tstatusFor := func(name string) reviewtypes.AgentStatus {\n87\t\t\tfor _, r := range summary.AgentRuns {\n88\t\t\t\tif r.Name == name {\n89\t\t\t\t\treturn r.Status\n90\t\t\t\t}\n91\t\t\t}\n92\t\t\treturn reviewtypes.AgentStatusUnknown\n93\t\t}\n94\t\tif got := statusFor(\"ok-agent\"); got != reviewtypes.AgentStatusSucceeded {\n95\t\t\tt.Errorf(\"ok-agent: expected Succeeded, got %v\", got)\n96\t\t}\n97\t\tif got := statusFor(\"fail-agent\"); got != reviewtypes.AgentStatusFailed {\n98\t\t\tt.Errorf(\"fail-agent: expected Failed, got %v\", got)\n99\t\t}\n100\t}\n101\t\n102\t// TestRunMulti_StartErrorForOneAgent verifies that an agent that fails to\n103\t// start produces an AgentRun with startErr and Failed status, while the other\n104\t// agent's events are still delivered normally.\n105\tfunc TestRunMulti_StartErrorForOneAgent(t *testing.T) {\n106\t\tt.Parallel()\n107\t\tstartErr := errors.New(\"binary not on PATH\")\n108\t\tra := &stubReviewer{\n109\t\t\tname:   \"good-agent\",\n110\t\t\tevents: []reviewtypes.Event{reviewtypes.Started{}, reviewtypes.Finished{Success: true}},\n111\t\t}\n112\t\trb := &stubReviewer{\n113\t\t\tname:     \"bad-start-agent\",\n114\t\t\tstartErr: startErr,\n115\t\t}\n116\t\trec := &stubSinkRecorder{}\n117\t\n118\t\tsummary, err := RunMulti(context.Background(), []reviewtypes.AgentReviewer{ra, rb}, reviewtypes.RunConfig{}, []reviewtypes.Sink{rec})\n119\t\tif !errors.Is(err, startErr) {\n120\t\t\tt.Errorf(\"expected startErr in firstErr, got %v\", err)\n121\t\t}\n122\t\tif len(summary.AgentRuns) != 2 {\n123\t\t\tt.Fatalf(\"expected 2 AgentRuns, got %d\", len(summary.AgentRuns))\n124\t\t}\n125\t\t// The agent that started successfully still delivers its events.\n126\t\tif len(rec.agentEvents) != 2 {\n127\t\t\tt.Errorf(\"expected 2 AgentEvent calls from good-agent, got %d\", len(rec.agentEvents))\n128\t\t}\n129\t\t// RunFinished still called once.\n130\t\tif len(rec.finishedCalls) != 1 {\n131\t\t\tt.Errorf(\"expected 1 RunFinished call, got %d\", len(rec.finishedCalls))\n132\t\t}\n133\t\t// Bad-start agent has the start error on its run.\n134\t\tfor _, r := range summary.AgentRuns {\n135\t\t\tif r.Name == \"bad-start-agent\" {\n136\t\t\t\tif r.Status != reviewtypes.AgentStatusFailed {\n137\t\t\t\t\tt.Errorf(\"bad-start-agent: expected Failed, got %v\", r.Status)\n138\t\t\t\t}\n139\t\t\t\tif !errors.Is(r.Err, startErr) {\n140\t\t\t\t\tt.Errorf(\"bad-start-agent: Err = %v, want startErr\", r.Err)\n141\t\t\t\t}\n142\t\t\t}\n143\t\t}\n144\t}\n145\t\n146\t// TestRunMulti_ContextCancellation verifies that context cancellation causes\n147\t// summary.Cancelled=true and all AgentRuns to have status Cancelled.\n148\tfunc TestRunMulti_ContextCancellation(t *testing.T) {\n149\t\tt.Parallel()\n150\t\tctx, cancel := context.WithCancel(context.Background())\n151\t\tcancel() // cancel before starting\n152\t\n153\t\tra := &stubReviewer{\n154\t\t\tname:     \"agent-a\",\n155\t\t\tstartErr: context.Canceled,\n156\t\t}\n157\t\trb := &stubReviewer{\n158\t\t\tname:     \"agent-b\",\n159\t\t\tstartErr: context.Canceled,\n160\t\t}\n161\t\trec := &stubSinkRecorder{}\n162\t\n163\t\tsummary, err := RunMulti(ctx, []reviewtypes.AgentReviewer{ra, rb}, reviewtypes.RunConfig{}, []reviewtypes.Sink{rec})\n164\t\tif err != nil && ctx.Err() == nil {\n165\t\t\tt.Logf(\"RunMulti returned non-nil error (may be cancellation-related): %v\", err)\n166\t\t}\n167\t\tif !summary.Cancelled {\n168\t\t\tt.Error(\"expected summary.Cancelled=true\")\n169\t\t}\n170\t\tfor _, r := range summary.AgentRuns {\n171\t\t\tif r.Status != reviewtypes.AgentStatusCancelled {\n172\t\t\t\tt.Errorf(\"agent %s: expected Cancelled, got %v\", r.Name, r.Status)\n173\t\t\t}\n174\t\t}\n175\t\tif len(rec.finishedCalls) != 1 {\n176\t\t\tt.Errorf(\"sinks must receive RunFinished even on cancellation: got %d calls\", len(rec.finishedCalls))\n177\t\t}\n178\t}\n179\t\n180\t// TestRunMulti_EmptyReviewers verifies that passing no reviewers returns an\n181\t// empty RunSummary and still calls RunFinished once on each sink.\n182\tfunc TestRunMulti_EmptyReviewers(t *testing.T) {\n183\t\tt.Parallel()\n184\t\trec := &stubSinkRecorder{}\n185\t\n186\t\tsummary, err := RunMulti(context.Background(), nil, reviewtypes.RunConfig{}, []reviewtypes.Sink{rec})\n187\t\tif err != nil {\n188\t\t\tt.Fatalf(\"expected nil error for empty reviewers, got %v\", err)\n189\t\t}\n190\t\tif len(summary.AgentRuns) != 0 {\n191\t\t\tt.Errorf(\"expected 0 AgentRuns, got %d\", len(summary.AgentRuns))\n192\t\t}\n193\t\tif len(rec.finishedCalls) != 1 {\n194\t\t\tt.Errorf(\"expected 1 RunFinished call even for empty reviewers, got %d\", len(rec.finishedCalls))\n195\t\t}\n196\t}\n197\t\n198\t// TestRunMulti_WithinAgentEventOrder verifies that events within a single\n199\t// agent's stream are delivered to the sink in the order emitted. Order across\n200\t// agents is non-deterministic (concurrent goroutines), but within-agent\n201\t// ordering is guaranteed by the channel + serial dispatch loop.\n202\tfunc TestRunMulti_WithinAgentEventOrder(t *testing.T) {\n203\t\tt.Parallel()\n204\t\teventsA := []reviewtypes.Event{\n205\t\t\treviewtypes.Started{},\n206\t\t\treviewtypes.AssistantText{Text: \"a1\"},\n207\t\t\treviewtypes.AssistantText{Text: \"a2\"},\n208\t\t\treviewtypes.Finished{Success: true},\n209\t\t}\n210\t\teventsB := []reviewtypes.Event{\n211\t\t\treviewtypes.Started{},\n212\t\t\treviewtypes.AssistantText{Text: \"b1\"},\n213\t\t\treviewtypes.Finished{Success: true},\n214\t\t}\n215\t\tra := &stubReviewer{name: \"alpha\", events: eventsA}\n\n... [166 lines truncated] ..."},"type":"attachment","uuid":"8004ce9d-ec57-40a6-beb2-530cf970ed57","timestamp":"2026-05-08T21:05:51.901Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"802b09ab-4617-4518-902c-87ed5837e8f3","version":"2.1.133","gitBranch":"main"}
{"parentUuid":"8004ce9d-ec57-40a6-beb2-530cf970ed57","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/run_multi.go","snippet":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// run_multi.go implements RunMulti, the N-agent orchestrator. It runs each\n4\t// AgentReviewer in its own goroutine under a shared context, fans their\n5\t// event streams into a single dispatch loop that calls each Sink serially\n6\t// (preserving the serial-dispatch contract from CU4), and aggregates the\n7\t// per-agent results into a single RunSummary.\n8\t//\n9\t// Cancellation: when ctx is cancelled (typically by the cobra command's\n10\t// SIGINT handling), all per-agent reviewers see ctx.Err() via their\n11\t// individual Process implementations and exit. RunMulti waits for every\n12\t// goroutine to drain before returning, ensuring no AgentEvent calls fire\n13\t// after RunFinished.\n14\t//\n15\t// Goroutine accounting for N agents:\n16\t//   - N forwarding goroutines: one per agent that started successfully,\n17\t//     reads proc.Events() and sends tagged events to the fan-in channel.\n18\t//   - 1 channel-close goroutine: waits for all N forwarders via WaitGroup\n19\t//     then closes the fan-in channel so the dispatch loop terminates.\n20\t//   - 1 dispatch goroutine (the caller's): ranges over fan-in, updates\n21\t//     per-agent state, calls sinks serially. RunMulti does NOT spawn a\n22\t//     separate dispatch goroutine — the fan-in loop runs on the RunMulti\n23\t//     call stack, keeping the goroutine count low.\n24\tpackage review\n25\t\n26\timport (\n27\t\t\"context\"\n28\t\t\"sync\"\n29\t\t\"time\"\n30\t\n31\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n32\t)\n33\t\n34\t// perAgentState tracks the mutable accumulation for one agent during a\n35\t// multi-agent run.\n36\t//\n37\t// Write paths (no mutex; the close-after-wait protocol below provides\n38\t// happens-before for both):\n39\t//   - waitErr and finishedAt are written by the per-agent forwarding\n40\t//     goroutine after its proc.Events range loop exits, immediately before\n41\t//     wg.Done.\n42\t//   - All other mutable fields (events buffer, tokens, finishedSeen,\n43\t//     finishedOk, sawRunError) are written from the single dispatch loop\n44\t//     reading the fan-in channel.\n45\t//\n46\t// Read path: the main RunMulti goroutine reads every field only after\n47\t// `for ev := range fanIn` returns, which is sequenced after wg.Wait →\n48\t// close(fanIn) by the close goroutine. That sequencing is the\n49\t// happens-before for both write paths.\n50\t//\n51\t// DO NOT add new writers from goroutines outside this protocol — adding\n52\t// a third write path would require a mutex (or a redesign).\n53\ttype perAgentState struct {\n54\t\tname         string\n55\t\tproc         reviewtypes.Process\n56\t\tstartErr     error\n57\t\tstartedAt    time.Time\n58\t\tfinishedAt   time.Time\n59\t\tbuffer       []reviewtypes.Event\n60\t\ttokens       reviewtypes.Tokens\n61\t\tfinishedSeen bool\n62\t\tfinishedOk   bool\n63\t\tsawRunError  bool\n64\t\twaitErr      error\n65\t}\n66\t\n67\t// taggedEvent associates a fan-in event with its originating agent index.\n68\ttype taggedEvent struct {\n69\t\tagentIdx int\n70\t\tev       reviewtypes.Event\n71\t}\n72\t\n73\t// RunMulti executes a multi-agent review. Each reviewer runs concurrently;\n74\t// events from N agents are funneled into a single dispatch loop that calls\n75\t// every sink's AgentEvent in arrival order from a single goroutine\n76\t// (serial-dispatch guarantee).\n77\t//\n78\t// Returns the aggregated RunSummary plus the FIRST non-cancellation\n79\t// per-agent error encountered. Callers that want individual errors should\n80\t// inspect summary.AgentRuns[i].Err. The returned summary is always\n81\t// populated, even on error; sinks are always notified via RunFinished.\n82\t//\n83\t// Cancellation propagates through ctx; each reviewer's Process honors it.\n84\t// When ctx is cancelled all per-agent goroutines will eventually drain and\n85\t// the channel will close; RunMulti waits for all before calling RunFinished.\n86\tfunc RunMulti(\n87\t\tctx context.Context,\n88\t\treviewers []reviewtypes.AgentReviewer,\n89\t\tcfg reviewtypes.RunConfig,\n90\t\tsinks []reviewtypes.Sink,\n91\t) (reviewtypes.RunSummary, error) {\n92\t\tstarted := time.Now()\n93\t\n94\t\tif len(reviewers) == 0 {\n95\t\t\tsummary := reviewtypes.RunSummary{\n96\t\t\t\tStartedAt:  started,\n97\t\t\t\tFinishedAt: started,\n98\t\t\t\tCancelled:  ctx.Err() != nil,\n99\t\t\t}\n100\t\t\tfor _, sink := range sinks {\n101\t\t\t\tsink.RunFinished(summary)\n102\t\t\t}\n103\t\t\treturn summary, nil\n104\t\t}\n105\t\n106\t\tstates := make([]*perAgentState, len(reviewers))\n107\t\tfor i, r := range reviewers {\n108\t\t\tstates[i] = &perAgentState{\n109\t\t\t\tname:      r.Name(),\n110\t\t\t\tstartedAt: time.Now(),\n111\t\t\t}\n112\t\t}\n113\t\n114\t\t// fanIn carries tagged events from N agent goroutines into the single\n115\t\t// dispatch loop. Buffer of len(reviewers)*16 amortises goroutine\n116\t\t// scheduling jitter without holding an unbounded queue.\n117\t\tfanIn := make(chan taggedEvent, len(reviewers)*16)\n118\t\n119\t\tvar wg sync.WaitGroup\n120\t\tfor i, r := range reviewers {\n121\t\t\tproc, err := r.Start(ctx, cfg)\n122\t\t\tif err != nil {\n123\t\t\t\tstates[i].startErr = err\n124\t\t\t\tstates[i].finishedAt = time.Now()\n125\t\t\t\tcontinue\n126\t\t\t}\n127\t\t\tstates[i].proc = proc\n128\t\t\twg.Add(1)\n129\t\t\tgo func(idx int, p reviewtypes.Process) {\n130\t\t\t\tdefer wg.Done()\n131\t\t\t\tfor ev := range p.Events() {\n132\t\t\t\t\tfanIn <- taggedEvent{agentIdx: idx, ev: ev}\n133\t\t\t\t}\n134\t\t\t\tstates[idx].waitErr = p.Wait()\n135\t\t\t\tstates[idx].finishedAt = time.Now()\n136\t\t\t}(i, proc)\n137\t\t}\n138\t\n139\t\t// Close fanIn after all forwarding goroutines finish. This goroutine\n140\t\t// must be launched AFTER all wg.Add calls above so the WaitGroup\n141\t\t// counter is correct before Wait is called.\n142\t\tgo func() {\n143\t\t\twg.Wait()\n144\t\t\tclose(fanIn)\n145\t\t}()\n146\t\n147\t\t// Dispatch loop: runs on the caller's goroutine (no extra goroutine).\n148\t\t// Ranges over fanIn until it is closed, updating per-agent state and\n149\t\t// forwarding to sinks serially — the serial-dispatch contract holds\n150\t\t// even though N agent goroutines emit concurrently.\n151\t\tfor tagged := range fanIn {\n152\t\t\tst := states[tagged.agentIdx]\n153\t\t\tst.buffer = append(st.buffer, tagged.ev)\n154\t\t\tswitch e := tagged.ev.(type) {\n155\t\t\tcase reviewtypes.Tokens:\n156\t\t\t\tst.tokens = e // Tokens is cumulative — overwrite, don't sum.\n157\t\t\tcase reviewtypes.Finished:\n158\t\t\t\tst.finishedSeen = true\n159\t\t\t\tst.finishedOk = e.Success\n160\t\t\tcase reviewtypes.RunError:\n161\t\t\t\tst.sawRunError = true\n162\t\t\tdefault:\n163\t\t\t\t// Started, AssistantText, ToolCall — no state to update.\n164\t\t\t}\n165\t\t\tfor _, sink := range sinks {\n166\t\t\t\tsink.AgentEvent(st.name, tagged.ev)\n167\t\t\t}\n168\t\t}\n169\t\n170\t\t// All goroutines have exited; all waitErr fields are set.\n171\t\tfinished := time.Now()\n172\t\tcancelled := ctx.Err() != nil\n173\t\n174\t\tagentRuns := make([]reviewtypes.AgentRun, len(states))\n175\t\tvar firstErr error\n176\t\tfor i, st := range states {\n177\t\t\tvar status reviewtypes.AgentStatus\n178\t\t\tif st.startErr != nil {\n179\t\t\t\tstatus = classifyStatus(ctx, st.startErr, eventOutcome{})\n180\t\t\t} else {\n181\t\t\t\tstatus = classifyStatus(ctx, st.waitErr, eventOutcome{\n182\t\t\t\t\tfinishedSeen: st.finishedSeen,\n183\t\t\t\t\tfinishedOk:   st.finishedOk,\n184\t\t\t\t\tsawRunError:  st.sawRunError,\n185\t\t\t\t})\n186\t\t\t}\n187\t\t\tagentErr := st.startErr\n188\t\t\tif agentErr == nil {\n189\t\t\t\tagentErr = st.waitErr\n190\t\t\t}\n191\t\t\tagentRuns[i] = reviewtypes.AgentRun{\n192\t\t\t\tName:      st.name,\n193\t\t\t\tStatus:    status,\n194\t\t\t\tTokens:    st.tokens,\n195\t\t\t\tBuffer:    st.buffer,\n196\t\t\t\tStartedAt: st.startedAt,\n197\t\t\t\tDuration:  st.finishedAt.Sub(st.startedAt),\n198\t\t\t\tErr:       agentErr,\n199\t\t\t}\n200\t\t\tif firstErr == nil && agentErr != nil && status != reviewtypes.AgentStatusCancelled {\n201\t\t\t\tfirstErr = agentErr\n202\t\t\t}\n203\t\t}\n204\t\n205\t\tsummary := reviewtypes.RunSummary{\n206\t\t\tStartedAt:  started,\n207\t\t\tFinishedAt: finished,\n208\t\t\tCancelled:  cancelled,\n209\t\t\tAgentRuns:  agentRuns,\n210\t\t}\n211\t\tfor _, sink := range sinks {\n212\t\t\tsink.RunFinished(summary)\n213\t\t}\n214\t\n215\t\treturn summary, firstErr\n216\t}"},"type":"attachment","uuid":"8d6e481f-7719-46fd-a42a-e48ed04e9974","timestamp":"2026-05-08T21:05:51.901Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"802b09ab-4617-4518-902c-87ed5837e8f3","version":"2.1.133","gitBranch":"main"}
