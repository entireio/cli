h markdown — it's a terse status summary that benefits\n46\t// from staying on a single uncolored line for grep-ability.\n47\t//\n48\t// Markdown structure per agent:\n49\t//\n50\t//\t# <name> review\n51\t//\t(optional status line for cancelled / failed)\n52\t//\t(optional blockquote for RunError events on failure)\n53\t//\t(narrative — agent's AssistantText events joined)\n54\tfunc (s DumpSink) dumpAgent(run reviewtypes.AgentRun) {\n55\t\tvar b strings.Builder\n56\t\tfmt.Fprintf(&b, \"# %s review\\n\\n\", run.Name)\n57\t\n58\t\tswitch run.Status {\n59\t\tcase reviewtypes.AgentStatusCancelled:\n60\t\t\tb.WriteString(\"_cancelled_\\n\")\n61\t\tcase reviewtypes.AgentStatusFailed:\n62\t\t\t// Surface the wait error if any (process exit failure), then any\n63\t\t\t// agent-level RunError events the parser emitted (typically a torn\n64\t\t\t// stdout stream — caught at the orchestrator level by classifyStatus\n65\t\t\t// even when the process itself exited 0).\n66\t\t\tif run.Err != nil {\n67\t\t\t\tfmt.Fprintf(&b, \"**Failed:** `%v`\\n\\n\", run.Err)\n68\t\t\t} else {\n69\t\t\t\tb.WriteString(\"**Failed**\\n\\n\")\n70\t\t\t}\n71\t\t\tfor _, ev := range run.Buffer {\n72\t\t\t\tif re, ok := ev.(reviewtypes.RunError); ok && re.Err != nil {\n73\t\t\t\t\tfmt.Fprintf(&b, \"> agent error: `%v`\\n\\n\", re.Err)\n74\t\t\t\t}\n75\t\t\t}\n76\t\t\t// Render any narrative text the agent produced before the failure\n77\t\t\t// surfaced — useful when the parser tore mid-response so reviewers\n78\t\t\t// can see partial output instead of a bare \"(failed)\" line.\n79\t\t\tif narrative := joinAssistantText(run.Buffer); narrative != \"\" {\n80\t\t\t\tb.WriteString(narrative)\n81\t\t\t\tb.WriteString(\"\\n\")\n82\t\t\t}\n83\t\tcase reviewtypes.AgentStatusSucceeded, reviewtypes.AgentStatusUnknown:\n84\t\t\tif narrative := joinAssistantText(run.Buffer); narrative != \"\" {\n85\t\t\t\tb.WriteString(narrative)\n86\t\t\t\tb.WriteString(\"\\n\")\n87\t\t\t}\n88\t\t}\n89\t\n90\t\t// RenderForWrit