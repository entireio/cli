{"parentUuid":"5df17606-f058-4a67-8c01-fe1c78b982d5","isSidechain":false,"promptId":"51ea0482-b527-4584-8e1a-f0c389c2a06e","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A8Yaoo4UpdSZoJqMmQTS5W","type":"tool_result","content":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// prompt.go implements the shared prompt composer used by all per-agent\n4\t// reviewers. The scope clause pins agents to \"commits unique to this branch\n5\t// vs the closest ancestor\" — preventing the divergent-default problem where\n6\t// codex defaulted to origin/main...HEAD and claude defaulted to\n7\t// working-tree-only on the same invocation (regression class from #1018\n8\t// commit b9ed9c074; enforced structurally here).\n9\tpackage review\n10\t\n11\timport (\n12\t\t\"strings\"\n13\t\n14\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n15\t)\n16\t\n17\t// ComposeReviewPrompt assembles the prompt sent to the agent. It joins\n18\t// the configured skill invocations, the always-prompt, the per-run\n19\t// prompt, and a scope clause that pins the agent to commits unique\n20\t// to the current branch vs the closest ancestor.\n21\t//\n22\t// Empty sections are skipped (no triple-newline gaps). The scope clause\n23\t// is only added when cfg.ScopeBaseRef is non-empty.\n24\tfunc ComposeReviewPrompt(cfg reviewtypes.RunConfig) string {\n25\t\tif cfg.PromptOverride != \"\" {\n26\t\t\treturn cfg.PromptOverride\n27\t\t}\n28\t\n29\t\tvar sections []string\n30\t\n31\t\t// Skills: one per line, joined as a single section.\n32\t\tif len(cfg.Skills) > 0 {\n33\t\t\tsections = append(sections, strings.Join(cfg.Skills, \"\\n\"))\n34\t\t}\n35\t\n36\t\t// AlwaysPrompt and PerRunPrompt: each is its own section if non-empty after trim.\n37\t\tif trimmed := strings.TrimRight(cfg.AlwaysPrompt, \"\\n\\r \"); trimmed != \"\" {\n38\t\t\tsections = append(sections, trimmed)\n39\t\t}\n40\t\tif trimmed := strings.TrimRight(cfg.PerRunPrompt, \"\\n\\r \"); trimmed != \"\" {\n41\t\t\tsections = append(sections, trimmed)\n42\t\t}\n43\t\n44\t\t// Scope clause: only when a base ref was detected.\n45\t\tif cfg.ScopeBaseRef != \"\" {\n46\t\t\tsections = append(sections, \"Scope: review only the commits unique to this branch vs \"+cfg.ScopeBaseRef+\".\")\n47\t\t}\n48\t\tif trimmed := strings.TrimRight(cfg.CheckpointContext, \"\\n\\r \"); trimmed != \"\" {\n49\t\t\tsections = append(sections, trimmed)\n50\t\t}\n51\t\n52\t\treturn strings.Join(sections, \"\\n\\n\")\n53\t}\n54\t"}]},"uuid":"8be575c8-2036-45ad-8b57-131d6e500abe","timestamp":"2026-05-08T21:40:13.822Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/prompt.go","content":"// Package review — see env.go for package-level rationale.\n//\n// prompt.go implements the shared prompt composer used by all per-agent\n// reviewers. The scope clause pins agents to \"commits unique to this branch\n// vs the closest ancestor\" — preventing the divergent-default problem where\n// codex defaulted to origin/main...HEAD and claude defaulted to\n// working-tree-only on the same invocation (regression class from #1018\n// commit b9ed9c074; enforced structurally here).\npackage review\n\nimport (\n\t\"strings\"\n\n\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n)\n\n// ComposeReviewPrompt assembles the prompt sent to the agent. It joins\n// the configured skill invocations, the always-prompt, the per-run\n// prompt, and a scope clause that pins the agent to commits unique\n// to the current branch vs the closest ancestor.\n//\n// Empty sections are skipped (no triple-newline gaps). The scope clause\n// is only added when cfg.ScopeBaseRef is non-empty.\nfunc ComposeReviewPrompt(cfg reviewtypes.RunConfig) string {\n\tif cfg.PromptOverride != \"\" {\n\t\treturn cfg.PromptOverride\n\t}\n\n\tvar sections []string\n\n\t// Skills: one per line, joined as a single section.\n\tif len(cfg.Skills) > 0 {\n\t\tsections = append(sections, strings.Join(cfg.Skills, \"\\n\"))\n\t}\n\n\t// AlwaysPrompt and PerRunPrompt: each is its own section if non-empty after trim.\n\tif trimmed := strings.TrimRight(cfg.AlwaysPrompt, \"\\n\\r \"); trimmed != \"\" {\n\t\tsections = append(sections, trimmed)\n\t}\n\tif trimmed := strings.TrimRight(cfg.PerRunPrompt, \"\\n\\r \"); trimmed != \"\" {\n\t\tsections = append(sections, trimmed)\n\t}\n\n\t// Scope clause: only when a base ref was detected.\n\tif cfg.ScopeBaseRef != \"\" {\n\t\tsections = append(sections, \"Scope: review only the commits unique to this branch vs \"+cfg.ScopeBaseRef+\".\")\n\t}\n\tif trimmed := strings.TrimRight(cfg.CheckpointContext, \"\\n\\r \"); trimmed != \"\" {\n\t\tsections = append(sections, trimmed)\n\t}\n\n\treturn strings.Join(sections, \"\\n\\n\")\n}\n","numLines":54,"startLine":1,"totalLines":54}},"sourceToolAssistantUUID":"5df17606-f058-4a67-8c01-fe1c78b982d5","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"802b09ab-4617-4518-902c-87ed5837e8f3","version":"2.1.133","gitBranch":"feat/review-surface-agent-errors"}
