\t\t\tUse: \"review\",\n   107\t\t\t// Hidden from `entire help` while the feature is still maturing —\n   108\t\t\t// users who know about it can still run `entire review` / `entire\n   109\t\t\t// review --help` and the command works normally.\n   110\t\t\tHidden: true,\n   111\t\t\tShort:  \"Run configured review skills against the current branch\",\n   112\t\t\tLong: `Run the review skills configured in .entire/settings.json against\n   113\tthe current branch. On first run, an interactive picker writes the config.\n   114\t\n   115\tLabs entry: review is experimental. We are actively refining it based on user\n   116\tfeedback.\n   117\t\n   118\tThe review session is recorded as part of the next checkpoint, so the\n   119\treview metadata is permanently attached to the commit it covers.\n   120\t\n   121\tFlags:\n   122\t  --edit         re-open the review config picker\n   123\t  --findings     browse local review findings\n   124\t  --fix          apply review findings in a normal agent session\n   125\t  --all          with --fix, apply all sources/findings without selectors\n   126\t  --agent NAME   select a specific configured agent when more than one is\n   127\t                 configured (default: alphabetically first)\n   128\t  --base REF     scope the review against REF instead of mainline. Useful\n   129\t                 for stacked PRs where the review base is the parent feature\n   130\t                 branch, not main. Default: first existing of origin/main,\n   131\t                 origin/master, main, master.\n   132\t\n   133\tSubcommands:\n   134\t  attach <id>    tag an existing session as a review (equivalent to\n   135\t                 'entire attach --review <id>')`,\n   136\t\t\tArgs: func(_ *cobra.Command, args []string) error {\n   137\t\t\t\tif len(args) > 1 {\n   138\t\t\t\t\treturn fmt.Errorf(\"accepts at most one review session id, received %d\", len(args))\n   139\t\t\t\t}\n   140\t\t\t\tif len(args) == 1 && !fix {\n   141\t\t\t\t\treturn errors.New(\"review session id is only valid with --fix\")\n   142\t\t\t\t}\n   143\t\t\t\treturn nil\n   144\t\t\t},\n   145\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n   146\t\t\t\tctx := cmd.Context()\n   147\t\t\t\t// Discover external agents so review configs that target them\n   148\t\t\t\t// resolve correctly — without this, GetAgentsWithHooksInstalled\n   149\t\t\t\t// and agent.Get can't see them.\n   150\t\t\t\texternal.DiscoverAndRegister(ctx)\n   151\t\n   152\t\t\t\tif all && !fix {\n   153\t\t\t\t\treturn errors.New(\"--all requires --fix\")\n   154\t\t\t\t}\n   155\t\t\t\tmodes := 0\n   156\t\t\t\tfor _, enabled := range []bool{edit, findings, fix} {\n   157\t\t\t\t\tif enabled {\n   158\t\t\t\t\t\tmodes++\n   159\t\t\t\t\t}\n   160\t\t\t\t}\n   161\t\t\t\tif modes > 1 {\n   162\t\t\t\t\treturn errors.New(\"--edit, --findings, and --fix are mutually exclusive\")\n   163\t\t\t\t}\n   164\t\t\t\tif edit {\n   165\t\t\t\t\t_, err := RunReviewConfigPicker(ctx, cmd.OutOrStdout(), deps.GetAgentsWithHooksInstalled)\n   166\t\t\t\t\treturn err\n   167\t\t\t\t}\n   168\t\t\t\tif findings {\n   169\t\t\t\t\treturn runReviewFindings(ctx, cmd, deps.NewSilentError)\n   170\t\t\t\t}\n   171\t\t\t\tif fix {\n   172\t\t\t\t\ttarget := \"\"\n   173\t\t\t\t\tif len(args) == 1 {\n   174\t\t\t\t\t\ttarget = args[0]\n   175\t\t\t\t\t}\n   176\t\t\t\t\treturn runReviewFix(ctx, cmd, target, all, agentOverride, deps.NewSilentError)\n   177\t\t\t\t}\n   178\t\t\t\tinnerDeps := runReviewDeps{\n   179\t\t\t\t\tpromptForAgentFn: deps.PromptForAgentFn,\n   180\t\t\t\t\tmultiPickerFn:    deps.MultiPickerFn,\n   181\t\t\t\t}\n   182\t\t\t\treturn runReview(ctx, cmd, agentOverride, baseOverride, deps, innerDeps)\n   183\t\t\t},\n   184\t\t}\n   185\t\tcmd.Flags().BoolVar(&edit, \"edit\", false, \"re-open the review config picker\")\n   186\t\tcmd.Flags().BoolVar(&findings, \"findings\", false, \"browse local review findings\")\n   187\t\tcmd.Flags().BoolVar(&fix, \"fix\", false, \"apply review findings in a normal agent session\")\n   188\t\tcmd.Flags().BoolVar(&all, \"all\", false, \"with --fix, apply all sources/findings without selectors\")\n   189\t\tcmd.Flags().StringVar(&agentOverride, \"agent\", \"\", \"select a specific configured agent (default: alphabetically first)\")\n   190\t\tcmd.Flags().StringVar(&baseOverride, \"base\", \"\", \"git ref to scope the review against (default: origin/main → main → master)\")\n   191\t\tif deps.AttachCmd != nil {\n   192\t\t\tcmd.AddCommand(deps.AttachCmd)\n   193\t\t}\n   194\t\treturn cmd\n   195\t}\n   196\t\n   197\t// runReview executes the main review flow.\n   198\tfunc runReview(ctx context.Context, cmd *cobra.Command, agentOverride, baseOverride string, deps Deps, innerDeps runReviewDeps) error {\n   199\t\tout := cmd.OutOrStdout()\n   200\t\tsilentErr := deps.NewSilentError\n   201\t\n   202\t\t// 1. Pre-flight: must be in a git repo.\n   203\t\tif _, err := paths.WorktreeRoot(ctx); err != nil {\n   204\t\t\tcmd.SilenceUsage = true\n   205\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Run `entire enable` first.\")\n   206\t\t\treturn silentErr(errors.New(\"not a git repository\"))\n   207\t\t}\n   208\t\n   209\t\t// 2. Load config. A load error means the settings file exists but is\n   210\t\t// malformed (Load returns a default-filled object when the file is\n   211\t\t// missing). Surface the error instead of silently opening the picker,\n   212\t\t// which would cause SaveReviewConfig to write over the user's other\n   213\t\t// settings with an empty EntireSettings{}.\n   214\t\ts, err := settings.Load(ctx)\n   215\t\tif err != nil {\n   216\t\t\tcmd.SilenceUsage = true\n   217\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Failed to load settings: %v\\n\", err)\n   218\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Fix `.entire/settings.json` and re-run `entire review`.\")\n   219\t\t\treturn silentErr(err)\n   220\t\t}\n   221\t\tif s == nil || len(s.Review) == 0 {\n   222\t\t\tif !ConfirmFirstRunSetup(ctx, out) {\n   223\t\t\t\treturn nil\n   224\t\t\t}\n   225\t\t\tpicked, pickErr := RunReviewConfigPicker(ctx, out, deps.GetAgentsWithHooksInstalled)\n   226\t\t\tif pickErr != nil {\n   227\t\t\t\treturn pickErr\n   228\t\t\t}\n   229\t\t\tif s == nil {\n   230\t\t\t\ts = &settings.EntireSettings{}\n   231\t\t\t}\n   232\t\t\ts.Review = picked\n   233\t\t\tfmt.Fprintln(out)\n   234\t\t\tfmt.Fprintln(out, \"Setup complete — running review now.\")\n   235\t\t}\n   236\t\n   237\t\t// 3. Resolve installed agents and determine the dispatch path.\n   238\t\t//\n   239\t\t// Three paths:\n   240\t\t//   - Multi-agent: 2+ launchable eligible agents AND no --agent override →\n   241\t\t//     show multi-select picker then RunMulti. Steps 3.5, 3.6, and the\n   242\t\t//     single-agent skill-verify guard are skipped; each reviewer pulls\n   243\t\t//     its own skills from settings at spawn time via RunConfig.\n   244\t\t//   - Single-agent (default): 1 or fewer launchable eligible agents, OR\n   245\t\t//     --agent override set. Falls through to the full agent-selection and\n   246\t\t//     validation path below (steps 3–3.6).\n   247\t\tinstalled := deps.GetAgentsWithHooksInstalled(ctx)\n   248\t\tif agentOverride == \"\" {\n   249\t\t\tlaunchableEligible := computeLaunchableEligible(s, installed, deps.ReviewerFor)\n   250\t\t\tif len(launchableEligible) >= 2 {\n   251\t\t\t\treturn runMultiAgentPath(ctx, cmd, launchableEligible, baseOverride, s, innerDeps, deps, out)\n   252\t\t\t}\n   253\t\t}\n   254\t\n   255\t\t// Single-agent path: pick agent, verify hooks + skills, scope, run.\n   256\t\n   257\t\t// 3a. Base selection on the eligible set (configured AND installed):\n   258\t\t//   - 0 eligible: fall through; SelectReviewAgent below errors with the\n   259\t\t//     full configured map (clearer \"no installed agent\" diagnostic than\n   260\t\t//     a silent fail).\n   261\t\t//   - 1 eligible: use it directly. This matters when the alphabetically-\n   262\t\t//     first configured agent isn't installed but exactly one other is —\n   263\t\t//     without this, SelectReviewAgent would default to the alphabetical\n   264\t\t//     first and the verify-hooks check below would error needlessly.\n   265\t\t//   - 2+ eligible: prompt with single-select (non-launchable agents reach\n   266\t\t//     this branch since computeLaunchableEligible filtered them out above).\n   267\t\tif agentOverride == \"\" {\n   268\t\t\teligible := ComputeEligibleConfigured(s, installed)\n   269\t\t\tswitch {\n   270\t\t\tcase len(eligible) == 1:\n   271\t\t\t\tagentOverride = eligible[0].Name\n   272\t\t\tcase len(eligible) > 1:\n   273\t\t\t\tfn := innerDeps.promptForAgentFn\n   274\t\t\t\tif fn == nil {\n   275\t\t\t\t\tfn = PromptForAgent\n   276\t\t\t\t}\n   277\t\t\t\tpicked, pickErr := fn(ctx, eligible)\n   278\t\t\t\tif pickErr != nil {\n   279\t\t\t\t\tcmd.SilenceUsage = true\n   280\t\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), pickErr.Error())\n   281\t\t\t\t\treturn silentErr(pickErr)\n   282\t\t\t\t}\n   283\t\t\t\tif picked == \"\" {\n   284\t\t\t\t\t// Defensive: empty picker return must not fall through to\n   285\t\t\t\t\t// alphabetical-first default.\n   286\t\t\t\t\tcmd.SilenceUsage = true\n   287\t\t\t\t\temptyErr := errors.New(\"agent picker returned empty agent name\")\n   288\t\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), emptyErr.Error())\n   289\t\t\t\t\treturn silentErr(emptyErr)\n   290\t\t\t\t}\n   291\t\t\t\tagentOverride = picked\n   292\t\t\t}\n   293\t\t}\n   294\t\n   295\t\tagentName, cfg, err := SelectReviewAgent(s.Review, agentOverride)\n   296\t\tif err != nil {\n   297\t\t\tcmd.SilenceUsage = true\n   298\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n   299\t\t\treturn silentErr(err)\n   300\t\t}\n   301\t\n   302\t\treturn runSingleAgentPath(ctx, cmd, agentName, baseOverride, cfg, installed, deps, out)\n   303\t}\n   304\t\n   305\t// runSingleAgentPath completes a single-agent review: verifies hooks + skills,\n   306\t// guards against re-review, resolves scope, then dispatches via Run or\n   307\t// RunMarkerFallback.\n   308\tfunc runSingleAgentPath(\n   309\t\tctx context.Context,\n   310\t\tcmd *cobra.Command,\n   311\t\tagentName, baseOverride string,\n   312\t\tcfg settings.ReviewConfig,\n   313\t\tinstalled []types.AgentName,\n   314\t\tdeps Deps,\n   315\t\tout io.Writer,\n   316\t) error {\n   317\t\tsilentErr := deps.NewSilentError\n   318\t\n   319\t\t// 3.5. Verify hooks are installed for the selected agent.\n   320\t\tfound := false\n   321\t\tfor _, n := range installed {\n   322\t\t\tif string(n) == agentName {\n   323\t\t\t\tfound = true\n   324\t\t\t\tbreak\n   325\t\t\t}\n   326\t\t}\n   327\t\tif !found {\n   328\t\t\tcmd.SilenceUsage = true\n   329\t\t\tfmt.Fprintf(cmd.ErrOrStderr(),\n   330\t\t\t\t\"Hooks are not installed for %q. Run `entire configure --agent %s` first, \"+\n   331\t\t\t\t\t\"or remove %q from review settings.\\n\",\n   332\t\t\t\tagentName, agentName, agentName)\n   333\t\t\treturn silentErr(fmt.Errorf(\"hooks not installed for %s\", agentName))\n   334\t\t}\n   335\t\n   336\t\t// 3.6. Verify configured skills are actually installed on disk.\n   337\t\tag, agErr := agent.Get(types.AgentName(agentName))\n   338\t\tif agErr != nil {\n   339\t\t\treturn fmt.Errorf(\"resolve agent %s: %w\", agentName, agErr)\n   340\t\t}\n   341\t\tif err := VerifyConfiguredSkillsInstalled(ctx, ag, cfg); err != nil {\n   342\t\t\tcmd.SilenceUsage = true\n   343\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n   344\t\t\treturn silentErr(err)\n   345\t\t}\n   346\t\n   347\t\t// 4. Re-run guard: check if HEAD's checkpoint already has a review.\n   348\t\tif reviewed, meta := deps.HeadHasReviewCheckpoint(ctx); reviewed {\n   349\t\t\tvar proceed bool\n   350\t\t\tform := newAccessibleForm(huh.NewGroup(\n   351\t\t\t\thuh.NewConfirm().\n   352\t\t\t\t\tTitle(fmt.Sprintf(\"Already reviewed: %s. Proceed anyway?\", meta)).\n   353\t\t\t\t\tValue(&proceed),\n   354\t\t\t))\n   355\t\t\tif err := form.RunWithContext(ctx); err != nil {\n   356\t\t\t\tfmt.Fprintln(out, \"prompt cancelled\")\n   357\t\t\t\treturn err //nolint:wrapcheck // propagate huh cancellation\n   358\t\t\t}\n   359\t\t\tif !proceed {\n   360\t\t\t\tfmt.Fprintln(out, \"Review cancelled.\")\n   361\t\t\t\treturn nil\n   362\t\t\t}\n   363\t\t}\n   364\t\n   365\t\t// 5. Resolve HEAD SHA and worktree root.\n   366\t\tworktreeRoot, err := paths.WorktreeRoot(ctx)\n   367\t\tif err != nil {\n   368\t\t\treturn fmt.Errorf(\"resolve worktree root: %w\", err)\n   369\t\t}\n   370\t\n   371\t\t// 6. Resolve HEAD SHA and detect scope.\n   372\t\theadSHA, shaErr := currentHeadSHA(ctx, worktreeRoot)\n   373\t\tif shaErr != nil {\n   374\t\t\treturn fmt.Errorf(\"resolve HEAD: %w\", shaErr)\n   375\t\t}\n   376\t\tscopeBaseRef, scopeErr := detectScope(ctx, worktreeRoot, baseOverride, out)\n   377\t\tif scopeErr != nil {\n   378\t\t\tcmd.SilenceUsage = true\n   379\t\t\treturn scopeErr\n   380\t\t}\n   381\t\tcheckpointContext := \"\"\n   382\t\tif deps.ReviewCheckpointContext != nil {\n   383\t\t\tcheckpointContext = deps.ReviewCheckpointContext(ctx, worktreeRoot, scopeBaseRef)\n   384\t\t}\n   385\t\n   386\t\trunCfg := reviewtypes.RunConfig{\n   387\t\t\tScopeBaseRef:      scopeBaseRef,\n   388\t\t\tCheckpointContext: checkpointContext,\n   389\t\t\tStartingSHA:       headSHA,\n   390\t\t}\n   391\t\tapplyReviewConfig(&runCfg, cfg)\n   392\t\n   393\t\t// 7. Branch on launchability.\n   394\t\treviewer := deps.ReviewerFor(agentName)\n   395\t\tif reviewer == nil {\n   396\t\t\t// Non-launchable: write marker (with scope-aware prompt) and print guidance.\n   397\t\t\treturn RunMarkerFallback(ctx, agentName, runCfg, worktreeRoot, out)\n   398\t\t}\n   399\t\n   400\t\trunCtx, cancelRun := context.WithCancel(ctx)\n   401\t\tdefer cancelRun()\n   402\t\n   403\t\tcanPrompt := interactive.CanPromptInteractively()\n   404\t\tsinks := composeSingleAgentSinks(singleAgentSinkInputs{\n   405\t\t\tout:       out,\n   406\t\t\tisTTY:     interactive.IsTerminalWriter(out) && canPrompt,\n   407\t\t\tcanPrompt: canPrompt,\n   408\t\t\tagentName: agentName,\n   409\t\t\tcancelRun: cancelRun,\n   410\t\t})\n   411\t\tif tuiSink, ok := findTUISink(sinks); ok {\n   412\t\t\ttuiSink.Start()\n   413\t\t\tdefer tuiSink.Wait()\n   414\t\t}\n   415\t\n   416\t\tsummary, waitErr := Run(runCtx, reviewer, runCfg, sinks)\n   417\t\twritePostReviewManifest(ctx, out, worktreeRoot, headSHA, summary, \"\")\n   418\t\tif waitErr != nil && runCtx.Err() == nil && ctx.Err() == nil {\n   419\t\t\t// Non-cancellation error: surface to caller.\n   420\t\t\treturn fmt.Errorf(\"review run: %w\", waitErr)\n   421\t\t}\n   422\t\treturn nil\n   423\t}\n   424\t\n   425\t// detectScope computes the scope base ref for the current repo and prints\n   426\t// a scope banner to out on success. baseOverride, when non-empty, comes from\n   427\t// the `--base <ref>` flag and bypasses mainline auto-detection.\n   428\t//\n   429\t// Failure handling: when baseOverride is set and the ref is invalid,\n   430\t// returns (\"\", err) so the caller can fail-loudly before spawning agents.\n   431\t// Otherwise (auto-detection failed): returns \"\" and the caller proceeds in\n   432\t// degraded mode without a scope banner.\n   433\tfunc detectScope(ctx context.Context, worktreeRoot, baseOverride string, out io.Writer) (string, error) {\n   434\t\trepo, openErr := git.PlainOpen(worktreeRoot)\n   435\t\tif openErr != nil {\n   436\t\t\tlogging.Debug(ctx, \"review repo open failed\", slog.String(\"error\", openErr.Error()))\n   437\t\t\treturn \"\", nil\n   438\t\t}\n   439\t\tstats, statsErr := ComputeScopeStats(ctx, repo, baseOverride)\n   440\t\tif statsErr != nil {\n   441\t\t\t// With an override, the user explicitly asked for a specific base.\n   442\t\t\t// A bad ref must abort before agents spawn so the user learns about\n   443\t\t\t// the typo immediately, not after a long review run.\n   444\t\t\tif baseOverride != \"\" {\n   445\t\t\t\treturn \"\", statsErr\n   446\t\t\t}\n   447\t\t\tlogging.Debug(ctx, \"review scope detection failed\", slog.String(\"error\", statsErr.Error()))\n   448\t\t\treturn \"\", nil\n   449\t\t}\n   450\t\tfmt.Fprintln(out, formatScopeBanner(stats))\n   451\t\treturn stats.BaseRef, nil\n   452\t}\n   453\t\n   454\t// runMultiAgentPath handles the multi-agent review flow: shows the multi-select\n   455\t// picker, collects an optional per-run prompt, builds per-agent RunConfigs,\n   456\t// then runs all selected agents concurrently via RunMulti.\n   457\t//\n   458\t// This path skips the single-agent validation steps (3.5 hooks, 3.6 skills,\n   459\t// re-run guard) for brevity — computeLaunchableEligible has already ensured\n   460\t// each eligible agent has hooks installed and a Reviewer available.\n   461\tfunc runMultiAgentPath(\n   462\t\tctx context.Context,\n   463\t\tcmd *cobra.Command,\n   464\t\tlaunchableEligible []AgentChoice,\n   465\t\tbaseOverride string,\n   466\t\ts *settings.EntireSettings,\n   467\t\tinnerDeps runReviewDeps,\n   468\t\tdeps Deps,\n   469\t\tout io.Writer,\n   470\t) error {\n   471\t\t// Note: skill verification is intentionally skipped here. The\n   472\t\t// computeLaunchableEligible filter in the dispatch fork already\n   473\t\t// guarantees every agent in launchableEligible has hooks installed\n   474\t\t// AND a non-nil ReviewerFor mapping, so a per-agent verify pass would\n   475\t\t// be redundant.\n   476\t\tsilentErr := deps.NewSilentError\n   477\t\n   478\t\t// Show multi-select picker (or use injected stub in tests).\n   479\t\tpickerFn := innerDeps.multiPickerFn\n   480\t\tif pickerFn == nil {\n   481\t\t\tpickerFn = PickAgents\n   482\t\t}\n   483\t\tpicked, pickErr := pickerFn(ctx, launchableEligible)\n   484\t\tif pickErr != nil {\n   485\t\t\treturn handlePickerError(cmd, silentErr, pickErr)\n   486\t\t}\n   487\t\n   488\t\t// Resolve worktree root and HEAD SHA for scope detection.\n   489\t\tworktreeRoot, err := paths.WorktreeRoot(ctx)\n   490\t\tif err != nil {\n   491\t\t\treturn fmt.Errorf(\"resolve worktree root: %w\", err)\n   492\t\t}\n   493\t\theadSHA, shaErr := currentHeadSHA(ctx, worktreeRoot)\n   494\t\tif shaErr != nil {\n   495\t\t\treturn fmt.Errorf(\"resolve HEAD: %w\", shaErr)\n   496\t\t}\n   497\t\n   498\t\tscopeBaseRef, scopeErr := detectScope(ctx, worktreeRoot, baseOverride, out)\n   499\t\tif scopeErr != nil {\n   500\t\t\tcmd.SilenceUsage = true\n   501\t\t\treturn scopeErr\n   502\t\t}\n   503\t\tcheckpointContext := \"\"\n   504\t\tif deps.ReviewCheckpointContext != nil {\n   505\t\t\tcheckpointContext = deps.ReviewCheckpointContext(ctx, worktreeRoot, scopeBaseRef)\n   506\t\t}\n   507\t\n   508\t\t// Build per-agent reviewers with individual RunConfigs (each agent has\n   509\t\t// its own skills + always-prompt from s.Review[name]).\n   510\t\treviewers := make([]reviewtypes.AgentReviewer, 0, len(picked.Names))\n   511\t\tfor _, name := range picked.Names {\n   512\t\t\tagentCfg := s.Review[name] // zero value is safe (empty skills/prompt)\n   513\t\t\treviewer := deps.ReviewerFor(name)\n   514\t\t\tif reviewer == nil {\n   515\t\t\t\t// Shouldn't happen given launchableEligible was filtered for\n   516\t\t\t\t// ReviewerFor != nil, but be defensive.\n   517\t\t\t\tcmd.SilenceUsage = true\n   518\t\t\t\treturn silentErr(fmt.Errorf(\"agent %q is not launchable but appeared in eligible list\", name))\n   519\t\t\t}\n   520\t\t\t// Wrap the reviewer so it sees the per-agent RunConfig at Start time.\n   521\t\t\t// We cannot pass a different RunConfig per reviewer in RunMulti's\n   522\t\t\t// current API (all reviewers share one RunConfig). Instead, build a\n   523\t\t\t// configuredReviewer adapter that injects per-agent skills into\n   524\t\t\t// RunConfig before forwarding to the underlying reviewer.\n   525\t\t\treviewers = append(reviewers, &perAgentConfiguredReviewer{\n   526\t\t\t\tinner: reviewer,\n   527\t\t\t\tcfg: runConfigWithReviewConfig(reviewtypes.RunConfig{\n   528\t\t\t\t\tPerRunPrompt:      picked.PerRun,\n   529\t\t\t\t\tScopeBaseRef:      scopeBaseRef,\n   530\t\t\t\t\tCheckpointContext: checkpointContext,\n   531\t\t\t\t\tStartingSHA:       headSHA,\n   532\t\t\t\t}, agentCfg),\n   533\t\t\t})\n   534\t\t}\n   535\t\n   536\t\t// Compose sinks based on TTY detection.\n   537\t\t// TTY mode: [TUISink, DumpSink] — TUI owns the live dashboard; DumpSink\n   538\t\t// renders the post-run narrative after TUI dismisses (RunFinished is called\n   539\t\t// on each sink in order, and TUISink.RunFinished blocks until user dismisses).\n   540\t\t// Non-TTY mode: [DumpSink] alone.\n   541\t\t//\n   542\t\t// A derived context is used so the TUI's Ctrl+C handler can cancel the run\n   543\t\t// via the same cancelRun function that the orchestrator's context is built on.\n   544\t\trunCtx, cancelRun := context.WithCancel(ctx)\n   545\t\tdefer cancelRun()\n   546\t\n   547\t\tagentNames := make([]string, len(reviewers))\n   548\t\tfor i, r := range reviewers {\n   549\t\t\tagentNames[i] = r.Name()\n   550\t\t}\n   551\t\taggregateOutput := \"\"\n   552\t\n   553\t\t// TUI requires both:\n   554\t\t//   - terminal stdout (otherwise ANSI codes corrupt redirected output)\n   555\t\t//   - a promptable stdin (otherwise the post-run dismissal loop blocks\n   556\t\t//     forever — happens when entire review is invoked from inside an\n   557\t\t//     agent like Claude Code or Gemini CLI, where stdout is a TTY but\n   558\t\t//     keypresses are never delivered)\n   559\t\tsinks := composeMultiAgentSinks(multiAgentSinkInputs{\n   560\t\t\tout:               out,\n"}}
