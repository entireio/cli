rride, vErr)\n    86\t\t\t}\n    87\t\t\tbaseRef = baseOverride\n    88\t\t} else {\n    89\t\t\tbaseRef, err = detectScopeBaseRef(ctx, repo)\n    90\t\t\tif err != nil {\n    91\t\t\t\treturn ScopeStats{}, fmt.Errorf(\"detect scope base ref: %w\", err)\n    92\t\t\t}\n    93\t\t}\n    94\t\n    95\t\tcurrentBranch := currentBranchName(repo)\n    96\t\n    97\t\tcommits, err := countCommits(ctx, repoRoot, baseRef)\n    98\t\tif err != nil {\n    99\t\t\treturn ScopeStats{}, fmt.Errorf(\"count commits: %w\", err)\n   100\t\t}\n   101\t\n   102\t\tfilesChanged, err := countFilesChanged(ctx, repoRoot, baseRef)\n   103\t\tif err != nil {\n   104\t\t\treturn ScopeStats{}, fmt.Errorf(\"count files changed: %w\", err)\n   105\t\t}\n   106\t\n   107\t\tuncommitted, err := countUncommitted(ctx, repoRoot)\n   108\t\tif err != nil {\n   109\t\t\treturn ScopeStats{}, fmt.Errorf(\"count uncommitted: %w\", err)\n   110\t\t}\n   111\t\n   112\t\treturn ScopeStats{\n   113\t\t\tBaseRef:       baseRef,\n   114\t\t\tCurrentBranch: currentBranch,\n   115\t\t\tCommits:       commits,\n   116\t\t\tFilesChanged:  filesChanged,\n   117\t\t\tUncommitted:   uncommitted,\n   118\t\t}, nil\n   119\t}\n   120\t\n   121\t// detectScopeBaseRef returns the mainline ref the review should be scoped\n   122\t// against, walking the fallback chain origin/HEAD → origin/main →\n   123\t// origin/master → main → master and returning the first that exists.\n   124\t//\n   125\t// A previous implementation tried to be clever: it picked the merged-into-HEAD\n   126\t// branch with the most recent committerdate, on the theory that stacked PRs\n   127\t// (feature B branched off feature A while A is still open) would benefit\n   128\t// from reviewing against the immediate parent rather than mainline. In\n   129\t// practice the heuristic routinely picked unrelated recently-merged feature\n   130\t// branches — `git fetch` mirrors all of origin's branches by default, and\n   131\t// any branch whose tip is newer than mainline AND merged into mainline\n   132\t// (i.e., every recently-merged PR branch not yet deleted on origin) was a\n   133\t// candidate. Reviews ended up scoped against random PR branches, dragging\n   134\t// in 30+ commits of unrelated upstream work and producing reviews with\n   135\t// nothing to do with the current branch.\n   136\t//\n   137\t// Stacked PR review is now served by the explicit `--base <ref>` flag at\n   138\t// the command surface, not an inference. The default stays predictable\n   139\t// (always mainline); the override is explicit when users actually want it.\n   140\tfunc detectScopeBaseRef(_ context.Context, repo *git.Repository) (string, error) {\n   141\t\treturn fallbackScopeRef(repo)\n   142\t}\n   143\t\n   144\t// repoWorktreePath returns the working-tree path for repo, or an error if the\n   145\t// repo is bare or its worktree can't be resolved. detectScopeBaseRef needs\n   146\t// this to invoke `git for-each-ref` with the right working directory.\n   147\tfunc repoWorktreePath(repo *git.Repository) (string, error) {\n   148\t\twt, err := repo.Worktree()\n   149\t\tif err != nil {\n   150\t\t\treturn \"\", fmt.Errorf(\"resolve worktree: %w\", err)\n   151\t\t}\n   152\t\treturn wt.Filesystem().Root(), nil\n   153\t}\n   154\t\n   155\t// fallbackScopeRef returns the first existing ref from the fallback chain:\n   156\t// origin/HEAD → origin/main → origin/master → main → master.\n   157\t// Returns an error if none exist.\n   158\tfunc fallbackScopeRef(repo *git.Repository) (string, error) {\n   159\t\tchain := []string{\"origin/HEAD\", \"origin/main\", \"origin/master\", \"main\", \"master\"}\n   160\t\tfor _, name := range chain {\n   161\t\t\tif refExists(repo, name) {\n   162\t\t\t\treturn name, nil\n   163\t\t\t}\n   164\t\t}\n   165\t\treturn \"\", errors.New(\"no suitable ancestor branch found; configure a base ref explicitly\")\n   166\t}\n   167\t\n   168\t// refExists reports whether a ref with the given short name exists in repo.\n   169\tfunc refExists(repo *git.Repository, shortName string) bool {\n   170\t\trefs, err := repo.References()\n   171\t\tif err != nil {\n   172\t\t\treturn false\n   173\t\t}\n   174\t\tfound := false\n   175\t\t_ = refs.ForEach(func(ref *plumbing.Reference) error { //nolint:errcheck // best-effort search\n   176\t\t\tif ref.Name().Short() == shortName {\n   177\t\t\t\tfound = true\n   178\t\t\t\treturn storer.ErrStop\n   179\t\t\t}\n   180\t\t\treturn nil\n   181\t\t})\n   182\t\treturn found\n   183\t}\n   184\t\n   185\t// currentBranchName returns the short branch name for the current HEAD,\n   186\t// or \"\" for detached HEAD.\n   187\tfunc currentBranchName(repo *git.Repository) string {\n   188\t\thead, err := repo.Head()\n   189\t\tif err != nil {\n   190\t\t\treturn \"\"\n   191\t\t}\n   192\t\tif !head.Name().IsBranch() {\n   193\t\t\treturn \"\" // detached HEAD\n   194\t\t}\n   195\t\treturn head.Name().Short()\n   196\t}\n   197\t\n   198\t// countCommits returns the number of commits in <baseRef>..HEAD\n   199\t// (commits on the current branch not in baseRef).\n   200\tfunc countCommits(ctx context.Context, repoRoot, baseRef string) (int, error) {\n   201\t\tout, err := runGit(ctx, repoRoot, \"rev-list\", \"--count\", baseRef+\"..HEAD\")\n   202\t\tif err != nil {\n   203\t\t\treturn 0, err\n   204\t\t}\n   205\t\tn, err := strconv.Atoi(strings.TrimSpace(out))\n   206\t\tif err != nil {\n   207\t\t\treturn 0, fmt.Errorf(\"parse commit count: %w\", err)\n   208\t\t}\n   209\t\treturn n, nil\n   210\t}\n   211\t\n   212\t// countFilesChanged returns the number of unique files changed in <baseRef>..HEAD.\n   213\tfunc countFilesChanged(ctx context.Context, repoRoot, baseRef string) (int, error) {\n   214\t\tout, err := runGit(ctx, repoRoot, \"diff\", \"--name-only\", baseRef+\"..HEAD\")\n   215\t\tif err != nil {\n   216\t\t\treturn 0, err\n   217\t\t}\n   218\t\ttrimmed := strings.TrimSpace(out)\n   219\t\tif trimmed == \"\