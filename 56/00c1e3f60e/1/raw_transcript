nil {\n   230\t\t\tt.Fatalf(\"detectScopeBaseRef: %v\", err)\n   231\t\t}\n   232\t\t// With no ancestor branches (detached HEAD, no origin), falls back to \"main\".\n   233\t\tif baseRef != defaultBranchName {\n   234\t\t\tt.Errorf(\"baseRef = %q, want one of the fallback refs (e.g. %s)\", baseRef, defaultBranchName)\n   235\t\t}\n   236\t\n   237\t\t// Banner should show \"detached HEAD\".\n   238\t\tstats := ScopeStats{\n   239\t\t\tBaseRef:       baseRef,\n   240\t\t\tCurrentBranch: \"\",\n   241\t\t\tCommits:       0,\n   242\t\t\tFilesChanged:  0,\n   243\t\t\tUncommitted:   0,\n   244\t\t}\n   245\t\tbanner := formatScopeBanner(stats)\n   246\t\tif !strings.Contains(banner, \"detached HEAD\") {\n   247\t\t\tt.Errorf(\"banner %q does not mention 'detached HEAD'\", banner)\n   248\t\t}\n   249\t}\n   250\t\n   251\t// TestDetectScopeBaseRef_CleanDefaultBranch verifies that checking out main\n   252\t// produces 0 commits vs itself.\n   253\t// Cannot use t.Parallel because it modifies the repo state.\n   254\tfunc TestDetectScopeBaseRef_CleanDefaultBranch(t *testing.T) {\n   255\t\tdir := t.TempDir()\n   256\t\tinitRepoOnMain(t, dir)\n   257\t\n   258\t\t// Single commit on main.\n   259\t\tcommitFile(t, dir, \"file.go\", \"package main\", \"init\")\n   260\t\n   261\t\tctx := context.Background()\n   262\t\trepo := openTestRepo(t, dir)\n   263\t\n   264\t\tbaseRef, err := detectScopeBaseRef(ctx, repo)\n   265\t\tif err != nil {\n   266\t\t\tt.Fatalf(\"detectScopeBaseRef: %v\", err)\n   267\t\t}\n   268\t\n   269\t\tcommits, err := countCommits(ctx, dir, baseRef)\n   270\t\tif err != nil {\n   271\t\t\tt.Fatalf(\"countCommits: %v\", err)\n   272\t\t}\n   273\t\tif commits != 0 {\n   274\t\t\tt.Errorf(\"commits = %d, want 0 (main vs itself)\", commits)\n   275\t\t}\n   276\t\n   277\t\tstats := ScopeStats{\n   278\t\t\tBaseRef:       baseRef,\n   279\t\t\tCurrentBranch: currentBranchName(repo),\n   280\t\t\tCommits:       commits,\n   281\t\t\tFilesChanged:  0,\n   282\t\t\tUncommitted:   0,\n   283\t\t}\n   284\t\tbanner := formatScopeBanner(stats)\n   285\t\twantBanner := \"Reviewing main vs main: 0 commits, 0 files changed, 0 uncommitted\"\n   286\t\tif banner != wantBanner {\n   287\t\t\tt.Errorf(\"banner = %q, want %q\", banner, wantBanner)\n   288\t\t}\n   289\t}\n   290\t\n   291\t// TestDetectScopeBaseRef_UncommittedChanges verifies that uncommitted file\n   292\t// changes are counted correctly.\n   293\t// Cannot use t.Parallel because it modifies disk state.\n   294\tfunc TestDetectScopeBaseRef_UncommittedChanges(t *testing.T) {\n   295\t\tdir := t.TempDir()\n   296\t\tinitRepoOnMain(t, dir)\n   297\t\n   298\t\t// Initial commit on main.\n   299\t\tcommitFile(t, dir, \"tracked.go\", \"package main\", \"init\")\n   300\t\n   301\t\t// Branch off main.\n   302\t\ttestutil.GitCheckoutNewBranch(t, dir, \"feat/dirty\")\n   303\t\n   304\t\t// Modify a tracked file (not committed).\n   305\t\ttestutil.WriteFile(t, dir, \"tracked.go\", \"package main\\n// modified\")\n   306\t\t// Add an untracked file.\n   307\t\ttestutil.WriteFile(t, dir, \"untracked.go\", \"package main\")\n   308\t\n   309\t\tctx := context.Background()\n   310\t\n   311\t\tuncommitted, err := countUncommitted(ctx, dir)\n   312\t\tif err != nil {\n   313\t\t\tt.Fatalf(\"countUncommitted: %v\", err)\n   314\t\t}\n   315\t\tif uncommitted != 2 {\n   316\t\t\tt.Errorf(\"uncommitted = %d, want 2 (1 modified tracked + 1 untracked)\", uncommitted)\n   317\t\t}\n   318\t}\n   319\t\n   320\t// TestDetectScopeBaseRef_NoSuitableAncestor verifies that a fresh repo with\n   321\t// no main/master/origin returns an error.\n   322\t// Cannot use t.Parallel because it modifies the repo state.\n   323\tfunc TestDetectScopeBaseRef_NoSuitableAncestor(t *testing.T) {\n   324\t\tdir := t.TempDir()\n   325\t\ttestutil.InitRepo(t, dir) // intentionally NOT initRepoOnMain — we rename below\n   326\t\n   327\t\t// Commit so HEAD resolves (git init sets default branch to