t review configuration. Both fields are\n   195\t// optional; together they describe what `entire review` should ask the\n   196\t// agent to do.\n   197\t//\n   198\t// Precedence when composing the review prompt sent to the agent:\n   199\t//   - If Prompt is non-empty, it is used verbatim.\n   200\t//   - Otherwise, Skills are composed into a default template\n   201\t//     (\"Please run these review skills in order: 1. /X 2. /Y\").\n   202\t//\n   203\t// Skills are always recorded on the checkpoint metadata regardless of\n   204\t// which path composed the prompt — they're the structured, queryable\n   205\t// tag alongside ReviewPrompt (which is the ground truth).\n   206\ttype ReviewConfig struct {\n   207\t\t// Skills is the list of slash-prefixed skill invocations configured\n   208\t\t// for this agent. May be empty when Prompt carries the full request.\n   209\t\tSkills []string `json:\"skills,omitempty\"`\n   210\t\n   211\t\t// Prompt, when non-empty, carries saved review instructions. When\n   212\t\t// Skills is non-empty it is appended after the selected skills; when\n   213\t\t// Skills is empty it is the full prompt for prompt-only review configs.\n   214\t\tPrompt string `json:\"prompt,omitempty\"`\n   215\t}\n   216\t\n   217\t// IsZero reports whether the config is effectively unset.\n   218\tfunc (c ReviewConfig) IsZero() bool {\n   219\t\treturn len(c.Skills) == 0 && c.Prompt == \"\"\n   220\t}\n   221\t\n   222\t// ReviewConfigFor returns the configured review config for the given agent.\n   223\t// Returns a zero-value config when the agent has no entry; callers should\n   224\t// check IsZero (or the individual fields) to decide whether configuration\n   225\t// is present.\n   226\tfunc (s *EntireSettings) ReviewConfigFor(agentName string) ReviewConfig {\n   227\t\tif s == nil {\n   228\t\t\treturn ReviewConfig{}\n   229\t\t}\n   230\t\treturn s.Review[agentName]\n   231\t}\n   232\t\n   233\t// Load loads the Entire settings from .entire