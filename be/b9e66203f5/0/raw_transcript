the same line). Verified during planning:\n\n- `LoadedCheckpointTranscript.sessions: SessionTranscript[]` at `api/src/lib/checkpoint-transcript.ts:308`\n- `SessionTranscript { sessionId, agent, messages: TranscriptMessage[], ... }` at `api/src/types.ts:437-455`\n- Every parser that produces tool calls (Claude/Codex/Gemini/OpenCode/Droid/Copilot) populates `TranscriptMessage.toolCalls` — Cursor doesn't (out of scope, see context)\n\nExisting tests at `analysis-queue.test.ts:139-169` test the OLD signature. They use a `buildTranscript()` helper at `:127` that synthesizes Claude JSONL. After the refactor, both the helper and the old-shape tests are obsolete — the new tests run real parsers against real inputs.\n\n- [ ] **Step 1: Write failing tests covering Claude + Codex paths through the new function**\n\nReplace the existing `describe(\"extractToolMetrics\", ...)` block in `analysis-queue.test.ts` (lines 139-169) and the `buildTranscript()` helper (lines 127-137) with:\n\n```ts\nimport { ClaudeCodeParser } from \"./transcript-parsers/claude-code-parser\"\nimport { CodexParser } from \"./transcript-parsers/codex-parser\"\nimport { extractToolMetricsFromSessions } from \"./analysis-queue\"\n\ndescribe(\"extractToolMetricsFromSessions — agent-aware\", () => {\n  it(\"returns null toolProfile when sessions have no tool calls\", () => {\n    expect(\n      extractToolMetricsFromSessions([{ agent: \"Claude Code\", messages: [] }]).toolProfile,\n    ).toBeNull()\n  })\n\n  it(\"classifies Claude tool calls under Claude rules\", () => {\n    const claudeJsonl = [\n      JSON.stringify({\n        type: \"assistant\",\n        message: {\n          content: [\n            { type: \"tool_use\", id: \"1\", name: \"Bash\", input: { command: \"ls\" } },\n            { type: \"tool_use\", id: \"2\", name: \"Read\", input: { file: \"x.ts\" } },\n            { type: \"tool_use\", id: \"3\", name: \"mcp__github__list_issues\", input: {} },\n            { type: \"tool_use\", id: \"4\", name: \"Skill\", input: { skill: \"debugging\" } },\n          ],\n        },\n        timestamp: \"2026-04-30T00:00:00Z\",\n      }),\n    ].join(\"\\n\")\n    const messages = new ClaudeCodeParser().parse(claudeJsonl).messages\n    const m = extractToolMetricsFromSessions([{ agent: \"Claude Code\", messages }])\n\n    expect(m.toolProfile?.categories.shell.count).toBe(1)\n    expect(m.toolProfile?.categories.fileOps.count).toBe(1)\n    expect(m.toolProfile?.categories.mcp.count).toBe(1)\n    expect(m.toolProfile?.categories.agent.count).toBe(1)\n    expect(m.skillsUsed).toEqual([\"debugging\"])\n    expect(m.mcpServersUsed).toEqual([{ name: \"github\", count: 1 }])\n  })\n\n  it(\"classifies Codex tool calls under Codex rules (regression test for the all-zeros bug)\", () => {\n    const codexJsonl = [\n      JSON.stringify({\n        timestamp: \"2026-04-30T00:00:00Z\",\n        type: \"response_item\",\n        payload: {\n          type: \"function_call\",\n          name: \"exec_command\",\n          call_id: \"c1\",\n          arguments: JSON.stringify({ command: \"ls\" }),\n        },\n      }),\n      JSON.stringify({\n        timestamp: \"2026-04-30T00:00:01Z\",\n        type: \"response_item\",\n        payload: {\n          type: \"function_call\",\n          name: \"apply_patch\",\n          call_id: \"c2\",\n          arguments: JSON.stringify({}),\n        },\n      }),\n      JSON.stringify({\n        timestamp: \"2026-04-30T00:00:02Z\",\n        type: \"response_item\",\n        payload: {\n          type: \"function_call\",\n          name: \"_list_pull_request_review_threads\",\n          call_id: \"c3\",\n          arguments: JSON.stringify({}),\n        },\n      }),\n    ].join(\"\\n\")\n    const messages = new CodexParser().parse(codexJsonl).messages\n    const m = extractToolMetricsFromSessions([{ agent: \"Codex\", messages }])\n\n    // Real Codex tool names produce real bucket counts. Pre-refactor this\n    // returned all zeros because e