l classification\", () => {\n  const make = (name: string) =>\n    ({ id: \"\", name, input: {}, timestamp: \"\" }) as ToolCall\n\n  it(\"returns the Claude classifier for 'Claude Code' (Bash → shell)\", () => {\n    expect(getParserForAgent(\"Claude Code\").classifyTool?.(make(\"Bash\"))).toBe(\"shell\")\n  })\n  it(\"returns the Codex classifier for 'Codex' (exec_command → shell)\", () => {\n    expect(getParserForAgent(\"Codex\").classifyTool?.(make(\"exec_command\"))).toBe(\"shell\")\n  })\n  it(\"returns the Gemini classifier for 'Gemini CLI' (run_shell_command → shell)\", () => {\n    expect(getParserForAgent(\"Gemini CLI\").classifyTool?.(make(\"run_shell_command\"))).toBe(\n      \"shell\",\n    )\n  })\n  it(\"falls back to default classifier for unknown agents (everything → other)\", () => {\n    expect(getParserForAgent(\"DefinitelyNotARealAgent\").classifyTool?.(make(\"Bash\"))).toBe(\n      \"other\",\n    )\n  })\n})\n```\n\n- [ ] **Step 2: Run the test**\n\nRun: `cd api && pnpm vitest run src/lib/transcript-parsers/registry.test.ts`\nExpected: PASS — Tasks 3, 5, 6, 7 already supply the classifier methods; this task only pins the integration.\n\n(Note: this is intentionally not a red→green TDD cycle. The task name and structure are honest about that — verification, not implementation. Skipping the \"watch it fail\" step here is correct because the failure was already exercised on each parser test individually.)\n\n- [ ] **Step 3: Commit**\n\n```bash\ngit add api/src/lib/transcript-parsers/registry.test.ts\ngit commit -m \"test(recap-tools): pin agent → classifier dispatch through registry\"\n```"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1485,"cache_read_input_tokens":779346,"output_tokens":2236,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1485,"epheme