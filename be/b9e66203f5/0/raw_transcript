)),\n    transcriptTokens: analysis.total_transcript_tokens ?? 0,\n    filesChanged: analysis.totalFilesChanged ?? 0,\n  }\n}\n\n// runBackfill is the testable core of the script: it walks pages of\n// analysis rows and either writes facet aggregates (real run) or just\n// counts what would be written (dry run). Everything bootstrappy\n// (process.argv parsing, DB connection, exit codes) lives in main()\n// so this function is mock-driveable.\nexport async function runBackfill(\n  deps: BackfillDeps,\n  options: BackfillOptions,\n): Promise<BackfillResult> {\n  const { db, analyses } = deps\n  const { max, dryRun } = options\n\n  let cursor: { repo_id: string; checkpoint_id: string } | null = null\n  let processed = 0\n  let skipped = 0\n  let wouldUpsert = 0\n\n  while (processed < max) {\n    let q = db\n      .selectFrom(\"repo_checkpoint_analyses\")\n      .select([\"repo_id\", \"checkpoint_id\", \"analysis_json\"])\n      .where(\"status\", \"=\", \"complete\")\n      .where(\"analysis_json\", \"is not\", null)\n      .orderBy(\"repo_id\")\n      .orderBy(\"checkpoint_id\")\n      .limit(BATCH_SIZE)\n\n    if (cursor) {\n      const c = cursor\n      q = q.where(({ eb, or, and }) =>\n        or([\n          eb(\"repo_id\", \">\", c.repo_id),\n          and([eb(\"repo_id\", \"=\", c.repo_id), eb(\"checkpoint_id\", \">\", c.checkpoint_id)]),\n        ]),\n      )\n    }\n\n    const batch = await q.execute()\n    if (batch.length === 0) break\n\n    for (const row of batch) {\n      // Parse analysis_json. Only SyntaxError is the expected\n      // \"skip-and-continue\" case — all other errors (DB errors, schema\n      // mismatches, infrastructure flaps) MUST propagate so a flap during\n      // backfill doesn't silently leave thousands of rows un-denormalized\n      // while the script reports \"done\".\n      let analysis: AnalysisJsonShape\n      try {\n        analysis =\n          typeof row.analysis_json === \"string\"\n            ? (JSON.parse(row.analysis_json) as AnalysisJsonShape)\n            : (row.analysis_json as AnalysisJsonShape)\n      } catch (err) {\n        if (err instanceof SyntaxError) {\n          skipped++\n          console.warn(`skip repo=${row.repo_id} cp=${row.checkpoint_id}: ${err.message}`)\n          processed++\n          continue\n        }\n        throw err\n      }\n\n      const facets = extractFacetsFromAnalysis(analysis)\n\n      if (dryRun) {\n        wouldUpsert++\n      } else {\n        // Single transaction matching the worker's write path so a partial\n        // failure can't leave fresh facets next to stale 0 scalars.\n        await analyses.persistAnalysisAggregates(\n          row.repo_id,\n          row.checkpoint_id,\n          facets.labels,\n          facets.skills,\n          facets.toolMix,\n          facets.mcpServers,\n          facets.transcriptTokens,\n          facets.filesChanged,\n        )\n      }\n      // Drives the `processed < max` loop guard regardless of dry-run vs\n      // write — without this, --dry-run silently ignored --limit because\n      // only `wouldUpsert` was incremented in the dry-run branch.\n      processed++\n    }\n\n    cursor = {\n      repo_id: batch[batch.length - 1]!.repo_id,\n      checkpoint_id: batch[batch.length - 1]!.checkpoint_id,\n    }\n    if (dryRun) {\n      console.log(\n        `would-upsert=${wouldUpsert} skipped=${skipped} cursor=${cursor.repo_id}/${cursor.checkpoint_id}`,\n      )\n    } else {\n      console.log(\n        `processed=${processed} skipped=${skipped} cursor=${cursor.repo_id}/${cursor.checkpoint_id}`,\n      )\n    }\n  }\n\n  return { processed, skipped, wouldUpsert }\n}\n\nasync function main(): Promise<void> {\n  const db = createDb()\n  const analyses = createAnalysesNamespace(db)\n\n  const limitFlag = process.argv.find((a) => a.startsWith(\"--limit=\"))?.split(\"=\")[1]\n  const max = limitFlag ? parseInt(limitFlag, 10) : Infinity\n  const dryRun = process.argv.includes(\"--dry-run\")\n\n  const