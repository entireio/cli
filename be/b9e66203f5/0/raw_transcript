\t\trangeKey RangeKey\n40\t\tresult   FetcherResult\n41\t}\n42\t\n43\t// prefetchAllMsg fires once at startup (emitted from Init) to seed the\n44\t// cache with the initial fetch's data and kick off background prefetches\n45\t// of the remaining ranges in parallel. After this round-trip, every range\n46\t// toggle is a cache hit — no network on the keypress.\n47\ttype prefetchAllMsg struct{}\n48\t\n49\t// TUIModel backs the interactive recap view. It keeps the raw sessions,\n50\t// cached server data, and the Fetcher callback so range toggles can\n51\t// trigger an async re-fetch — without that, server-derived fields (team\n52\t// counts, server me-side counts, daily activity for week+ ranges) stay\n53\t// frozen at whatever range the CLI was launched with.\n54\t//\n55\t// Rendered output regularly exceeds the visible terminal height (summary +\n56\t// activity + agents card stack), so the body is wrapped in a bubbles\n57\t// viewport that handles scroll keys (↑/↓, j/k, page up/down). The help\n58\t// line stays pinned outside the viewport so users can always see how to\n59\t// quit / change range / cycle agents.\n60\ttype TUIModel struct {\n61\t\tctx          context.Context\n62\t\tfetch        Fetcher\n63\t\tsessions     []RecapSession\n64\t\tview         View\n65\t\tagentFilter  string\n66\t\tagents       []string          // agents present in sessions, for cycling\n67\t\tmode         ViewMode          // me / contributors / both\n68\t\tserverMe     *ContributorsData // server me-side, swapped on range change\n69\t\tcontributors *ContributorsData // server team-side, swapped on range change\n70\t\tserverDaily  []DailyCount      // server per-day activity, swapped on range change\n71\t\tnotes        []string          // diagnostic notes from the initial fetch\n72\t\tstyles       Styles\n73\t\twidth        int\n74\t\theight       int\n75\t\tviewport     viewport.Model\n76\t\tready        bool // true once we've received a WindowSizeMsg and sized the viewport\n77\t\tloading      bool // true while the user's currently-displayed range has no cached data and a Fetcher call is in flight\n78\t\t// cache stores prior fetch results keyed by range so toggling between\n79\t\t// ranges hits the network at most once per range, per session.\n80\t\tcache map[RangeKey]FetcherResult\n81\t\t// inFlight tracks ranges with an outstanding Fetcher call to avoid\n82\t\t// double-issuing requests when the user toggles into a range that's\n83\t\t// already being prefetched in the background.\n84\t\tinFlight map[RangeKey]bool\n85\t}\n86\t\n87\t// NewTUIModel wraps a pre-built View with the state bubbletea needs for\n88\t// interactive toggles. agentFilter is the initial filter (\"\" = all agents).\n89\t// fetch may be nil — when nil, range toggles only re-bucket local sessions\n90\t// and the cached server data stays frozen (offline/test mode).\n91\tfunc NewTUIModel(\n92\t\tctx context.Context,\n93\t\tfetch Fetcher,\n94\t\tsessions []RecapSession,\n95\t\tinitial View,\n96\t\tagentFilter string,\n97\t\tserverMe *ContributorsData,\n98\t\tcontributors *ContributorsData,\n99\t\tserverDaily []DailyCount,\n100\t) TUIModel {\n101\t\tmode := initial.Mode\n102\t\tif mode == \"\" {\n103\t\t\tmode = ViewBoth\n104\t\t}\n105\t\treturn TUIModel{\n106\t\t\tctx:          ctx,\n107\t\t\tfetch:        fetch,\n108\t\t\tsessions:     sessions,\n109\t\t\tview:         initial,\n110\t\t\tagentFilter:  agentFilter,\n111\t\t\tagents:       distinctAgents(sessions),\n112\t\t\tmode:         mode,\n113\t\t\tserverMe:     serverMe,\n114\t\t\tcontributors: contributors,\n115\t\t\tserverDaily:  serverDaily,\n116\t\t\tnotes:        append([]string(nil), initial.Notes...),\n117\t\t\tstyles:       NewStyles(true),\n118\t\t\twidth:        100,\n119\t\t\theight:       24,\n120\t\t\tcache:        map[RangeKey]FetcherResult{},\n121\t\t\tinFlight:     map[RangeKey]bool{},\n122\t\t}\n123\t}\n124\t\n125\t// Init seeds the cache with the initial fetch's data (already on the model)\n126\t// and emits prefetchAllMsg so Update can fire background fetches for the\n127\t// other ranges in parallel. After the prefetch round-trip completes, every\n128\t// range toggle is an instant cache hit instead of a 1-5s network round-trip.\n129\tfunc (m TUIModel) Init() tea.Cmd {\n130\t\treturn func() tea.Msg { return prefetchAllMsg{} }\n131\t}\n132\t\n133\t// Update dispatches on keyboard, window-resize, and async fetch-result\n134\t// messages. Range/agent/view-mode toggles rebuild the View; range toggles\n135\t// additionally fire a Fetcher to refresh server-side fields; the rendered\n136\t// body is then handed to the viewport so its scroll position resets to the\n137\t// top on each rebuild. Unhandled keys (arrows, page up/down, j/k) fall\n138\t// through to the viewport so users can scroll the rendered output.\n139\tfunc (m TUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) { //nolint:ireturn // tea.Model is required by bubbletea's interface contract\n140\t\tswitch msg := msg.(type) {\n141\t\tcase tea.WindowSizeMsg:\n142\t\t\tm.width, m.height = msg.Width, msg.Height\n143\t\t\tm = m.resizeViewport()\n144\t\t\treturn m, nil\n145\t\tcase prefetchAllMsg:\n146\t\t\t// Seed the cache with the initial fetch's data so we don't refetch\n147\t\t\t// the range we already have, then issue background fetches for every\n148\t\t\t// other range in parallel. Once those land, range toggles never hit\n149\t\t\t// the network again in this session.\n150\t\t\tm.cache[m.view.Range] = FetcherResult{\n151\t\t\t\tServerMe:     m.serverMe,\n152\t\t\t\tContributors: m.contributors,\n153\t\t\t\tDaily:        m.serverDaily,\n154\t\t\t\tDiag:         append([]string(nil), m.notes...),\n155\t\t\t}\n156\t\t\tif m.fetch == nil {\n157\t\t\t\treturn m, nil\n158\t\t\t}\n159\t\t\tvar cmds []tea.Cmd\n160\t\t\tfor _, r := range []RangeKey{RangeDay, RangeWeek, RangeMonth, Range90d} {\n161\t\t\t\tif r == m.view.Range || m.inFlight[r] {\n162\t\t\t\t\tcontinue\n163\t\t\t\t}\n164\t\t\t\tm.inFlight[r] = true\n165\t\t\t\tcmds = append(cmds, m.fetchCmd(r))\n166\t\t\t}\n167\t\t\treturn m, tea.Batch(cmds...)\n168\t\tcase recapDataMsg:\n169\t\t\t// Always cache the result and clear the in-flight flag, even if\n170\t\t\t// the user has since navigated to a different range — the data is\n171\t\t\t// useful for the next time they toggle back.\n172\t\t\tm.cache[msg.rangeKey] = msg.result\n173\t\t\tdelete(m.inFlight, msg.rangeKey)\n174\t\t\t// Apply to the visible view only when the user is still on this\n175\t\t\t// range. If they pressed w → 4 before w arrived, the w response\n176\t\t\t// silently caches itself; the visible view stays on 4.\n177\t\t\tif msg.rangeKey != m.view.Range {\n178\t\t\t\treturn m, nil\n179\t\t\t}\n180\t\t\tm.serverMe = msg.result.ServerMe\n181\t\t\tm.contributors = msg.result.Contributors\n182\t\t\tm.serverDaily = msg.result.Daily\n183\t\t\tm.notes = append(m.notes[:0], msg.result.Diag...)\n184\t\t\tm.loading = false\n\n... [212 lines truncated] ..."},"type":"attachment","uuid":"39798934-bb64-45a1-a1f7-b6d144b54f3e","timestamp":"2026-04-28T15:00:53.839Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity"}
