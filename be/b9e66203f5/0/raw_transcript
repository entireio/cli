{"parentUuid":"2c96a66d-f510-4188-92da-24293565739b","isSidechain":false,"promptId":"9cc2e5a9-f145-47b7-b367-ba67f2e3443a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018P99rEyWjrAqwSTTAtseG1","type":"tool_result","content":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n6\t//     labels + skills + mcpServers + toolMix\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo. Only populated when ?repo=org/name is supplied;\n9\t//     otherwise both per-agent contributors and the top-level contributors\n10\t//     summary are null (cross-repo team aggregation has no coherent\n11\t//     \"everyone else\" set without a single repo as the reference frame).\n12\t//\n13\t// This endpoint consolidates three CLI operations into one request:\n14\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n15\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n16\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n17\t//\n18\t// Without this endpoint the CLI has to do all three itself and attribute\n19\t// analyses to agents via the commits endpoint — a lot of round trips and\n20\t// brittle client-side joining. Centralizing on the server matches the\n21\t// pattern established by /me/activity (PR #1590).\n22\t\n23\timport type { Context } from \"hono\"\n24\timport { Hono } from \"hono\"\n25\timport { describeRoute, resolver } from \"hono-openapi\"\n26\timport { z } from \"zod\"\n27\t\n28\timport type { Env, Variables } from \"../env\"\n29\timport { getDb } from \"../lib/db\"\n30\timport { recordSpanError } from \"../lib/telemetry\"\n31\timport { parseTimeframeParams } from \"./cache\"\n32\t\n33\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n34\t// me and contributors sides so the CLI renderer can treat them uniformly.\n35\tinterface AgentAggregate {\n36\t  checkpoints: number\n37\t  tokens: number\n38\t  transcriptTokens: number\n39\t  filesChanged: number\n40\t  labels: Array<{ label: string; count: number }>\n41\t  skills: Array<{ skill: string; count: number }>\n42\t  mcpServers: Array<{ name: string; count: number }>\n43\t  toolMix: {\n44\t    shell: number\n45\t    fileOps: number\n46\t    search: number\n47\t    mcp: number\n48\t    agent: number\n49\t    other: number\n50\t  }\n51\t}\n52\t\n53\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n54\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n55\t// would double-execute the middleware.\n56\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n57\t\n58\tconst errorSchema = z.object({ error: z.string() })\n59\t\n60\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n61\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n62\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n63\tconst toolMixSchema = z.object({\n64\t  shell: z.number(),\n65\t  fileOps: z.number(),\n66\t  search: z.number(),\n67\t  mcp: z.number(),\n68\t  agent: z.number(),\n69\t  other: z.number(),\n70\t})\n71\t\n72\tconst agentAggregateSchema = z.object({\n73\t  checkpoints: z.number(),\n74\t  tokens: z.number(),\n75\t  transcriptTokens: z.number(),\n76\t  filesChanged: z.number(),\n77\t  labels: z.array(labelCountSchema),\n78\t  skills: z.array(skillCountSchema),\n79\t  mcpServers: z.array(mcpCountSchema),\n80\t  toolMix: toolMixSchema,\n81\t})\n82\t\n83\tconst perAgentEntrySchema = z.object({\n84\t  me: agentAggregateSchema,\n85\t  contributors: agentAggregateSchema.nullable(),\n86\t})\n87\t\n88\tconst recapResponseSchema = z.object({\n89\t  timeframe: z.string(),\n90\t  repo: z.string().nullable(),\n91\t  since: z.string(),\n92\t  until: z.string(),\n93\t  agents: z.record(z.string(), perAgentEntrySchema),\n94\t  contributors: z\n95\t    .object({\n96\t      distinctUsers: z.number(),\n97\t      totalTokens: z.number(),\n98\t      totalCheckpoints: z.number(),\n99\t    })\n100\t    .nullable(),\n101\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n102\t  updated_at: z.string(),\n103\t})\n104\t\n105\trecapRoutes.get(\n106\t  \"/\",\n107\t  describeRoute({\n108\t    tags: [\"Me\"],\n109\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n110\t    description:\n111\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n112\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n113\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n114\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n115\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n116\t    parameters: [\n117\t      {\n118\t        name: \"timeframe\",\n119\t        in: \"query\",\n120\t        required: false,\n121\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n122\t        schema: {\n123\t          type: \"string\",\n124\t          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n125\t        },\n126\t      },\n127\t      {\n128\t        name: \"repo\",\n129\t        in: \"query\",\n130\t        required: false,\n131\t        description:\n132\t          \"Restrict me-side aggregates and enable the contributors side. \" +\n133\t          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n134\t          \"the user has checkpoints on and the contributors side is null.\",\n135\t        schema: { type: \"string\" },\n136\t      },\n137\t      {\n138\t        name: \"limit\",\n139\t        in: \"query\",\n140\t        required: false,\n141\t        description: \"Max checkpoints to consider (1-1000, default 500).\",\n142\t        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n143\t      },\n144\t      {\n145\t        name: \"since\",\n146\t        in: \"query\",\n147\t        required: false,\n148\t        description:\n149\t          \"ISO-8601 lower bound for the activity window. When provided \" +\n150\t          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n151\t          \"uses this so its --day / --week / --month ranges line up exactly \" +\n152\t          \"with the server's aggregation window.\",\n153\t        schema: { type: \"string\", format: \"date-time\" },\n154\t      },\n155\t      {\n156\t        name: \"until\",\n157\t        in: \"query\",\n158\t        required: false,\n159\t        description:\n160\t          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n161\t          \"alongside `since` to override the `timeframe` enum.\",\n162\t        schema: { type: \"string\", format: \"date-time\" },\n163\t      },\n164\t    ],\n165\t    responses: {\n166\t      200: {\n167\t        description: \"Per-agent recap aggregates\",\n168\t        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n169\t      },\n170\t      401: {\n171\t        description: \"Not authenticated\",\n172\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n173\t      },\n174\t      404: {\n175\t        description: \"User or repo not found\",\n176\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n177\t      },\n178\t      500: {\n179\t        description: \"Failed to build recap\",\n180\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n181\t      },\n182\t    },\n183\t  }),\n184\t  async (c) => {\n185\t    const userId = c.get(\"userId\") as string\n186\t    const { limit, startDate, endDate } = parseRecapWindow(c)\n187\t    const repoParam = c.req.query(\"repo\")?.trim() || null\n188\t\n189\t    try {\n190\t      const db = getDb(c.env)\n191\t      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n192\t      if (!user) return c.json({ error: \"User not found\" }, 404)\n193\t\n194\t      // Pull me-side from repo_checkpoints filtered to the user's commits.\n195\t      // Team-side is only meaningful when the request scopes to a single\n196\t      // repo — without that, \"everyone else\" has no coherent reference\n197\t      // frame across all the user's repos. Skipping the team query when\n198\t      // ?repo= is absent saves a heavy join and matches the documented\n199\t      // contract that contributors is null in the cross-repo case.\n200\t      const since = startDate.toISOString()\n201\t      const until = endDate.toISOString()\n202\t      const [myCheckpoints, teamCheckpoints] = await Promise.all([\n203\t        db.checkpoints.getByUser(\n204\t          userId,\n205\t          user.github_id,\n206\t          since,\n207\t          until,\n208\t          limit,\n209\t          repoParam ?? undefined,\n210\t        ),\n211\t        repoParam\n212\t          ? db.checkpoints.getTeamOnUserRepos(\n213\t              userId,\n214\t              user.github_id,\n215\t              since,\n216\t              until,\n217\t              limit,\n218\t              repoParam,\n219\t            )\n220\t          : Promise.resolve([]),\n221\t      ])\n222\t\n223\t      // Base per-agent counts + tokens come straight off the checkpoint\n224\t      // rows (input_tokens + output_tokens). No custom aggregator needed.\n225\t      const meByAgent = aggregateCheckpointsByAgent(myCheckpoints)\n226\t      const teamByAgent = aggregateCheckpointsByAgent(teamCheckpoints)\n227\t\n228\t      // Merge analysis-derived fields (labels, skills, mcpServers, toolMix,\n229\t      // transcriptTokens, filesChanged) for both sides. Analyses live on\n230\t      // repo_checkpoint_analyses keyed by (repo_id, checkpoint_id). The two\n231\t      // sides are disjoint (different checkpoint sets) so parallelizing is\n232\t      // safe — saves one full set of analysis round trips.\n233\t      await Promise.all([\n234\t        mergeAnalysesInto(db, meByAgent, myCheckpoints),\n235\t        mergeAnalysesInto(db, teamByAgent, teamCheckpoints),\n236\t      ])\n237\t\n238\t      // Daily activity from the user's own checkpoints — powers the CLI\n239\t      // activity strip. Computed here so CLI doesn't need a second call.\n240\t      const daily = buildDailyActivity(myCheckpoints, startDate, endDate)\n241\t\n242\t      // Contributors summary is only meaningful for a scoped repo. Count\n243\t      // distinct *authors* (commit_author_github_id) — counting commit_sha\n244\t      // would conflate \"team has 50 commits this week\" with \"50 distinct\n245\t      // contributors\", which is wrong. The +1 for distinctUsers includes\n246\t      // the requesting user themselves alongside team authors.\n247\t      let contribSummary: {\n248\t        distinctUsers: number\n249\t        totalTokens: number\n250\t        totalCheckpoints: number\n251\t      } | null = null\n252\t      if (repoParam) {\n253\t        const teamAuthorIds = new Set<number>()\n254\t        for (const cp of teamCheckpoints) {\n255\t          if (typeof cp.commit_author_github_id === \"number\") {\n256\t            teamAuthorIds.add(cp.commit_author_github_id)\n257\t          }\n258\t        }\n259\t        contribSummary = {\n260\t          distinctUsers: teamAuthorIds.size + 1,\n261\t          totalTokens: sumTokens(myCheckpoints) + sumTokens(teamCheckpoints),\n262\t          totalCheckpoints: myCheckpoints.length + teamCheckpoints.length,\n263\t        }\n264\t      }\n265\t\n266\t      // Assemble final per-agent map. Agents that appear on either side.\n267\t      // Each agent's contributors field is null when ?repo= is absent\n268\t      // (no team data was fetched), matching the top-level contributors null.\n269\t      const allAgents = new Set<string>([...Object.keys(meByAgent), ...Object.keys(teamByAgent)])\n270\t      const agents: Record<string, { me: AgentAggregate; contributors: AgentAggregate | null }> = {}\n271\t      for (const name of allAgents) {\n272\t        agents[name] = {\n273\t          me: meByAgent[name] ?? emptyAggregate(),\n274\t          contributors: repoParam ? (teamByAgent[name] ?? null) : null,\n275\t        }\n276\t      }\n277\t\n278\t      return c.json({\n279\t        timeframe: c.req.query(\"timeframe\") ?? \"last-6-months\",\n280\t        repo: repoParam,\n281\t        since,\n282\t        until,\n283\t        agents,\n284\t        contributors: contribSummary,\n285\t        daily,\n286\t        updated_at: new Date().toISOString(),\n287\t      })\n288\t    } catch (err) {\n289\t      console.error(\"Failed to build recap:\", err)\n290\t      recordSpanError(err)\n291\t      return c.json({ error: \"Failed to build recap\" }, 500)\n292\t    }\n293\t  },\n294\t)\n295\t\n296\t// parseRecapWindow accepts either explicit `since`/`until` ISO8601 params\n297\t// or falls back to the timeframe enum (last-month / last-3-months /\n298\t// last-6-months). Explicit dates give the CLI precise control so its\n299\t// --day / --week / --month ranges line up exactly with the server's\n300\t// aggregation boundaries.\n301\tfunction parseRecapWindow(c: Context<{ Bindings: Env; Variables: Variables }>) {\n302\t  const sinceParam = c.req.query(\"since\")\n303\t  const untilParam = c.req.query(\"until\")\n304\t  if (sinceParam && untilParam) {\n305\t    const startDate = new Date(sinceParam)\n306\t    const endDate = new Date(untilParam)\n307\t    const limitParam = c.req.query(\"limit\")\n308\t    const parsedLimit = limitParam ? parseInt(limitParam, 10) : 500\n309\t    const limit = Number.isNaN(parsedLimit) || parsedLimit <= 0 ? 500 : Math.min(parsedLimit, 1000)\n310\t    if (!Number.isNaN(startDate.getTime()) && !Number.isNaN(endDate.getTime())) {\n311\t      return { limit, startDate, endDate }\n312\t    }\n313\t  }\n314\t  return parseTimeframeParams(c)\n315\t}\n316\t\n317\t// aggregateCheckpointsByAgent groups UserCheckpoint rows by their agent\n318\t// field and sums checkpoint counts + tokens. Token sum uses input_tokens\n319\t// + output_tokens from the checkpoint row directly — no analyses required.\n320\tfunction aggregateCheckpointsByAgent(\n321\t  cps: Array<{ agent: string | null; input_tokens: number | null; output_tokens: number | null }>,\n322\t): Record<string, AgentAggregate> {\n323\t  const out: Record<string, AgentAggregate> = {}\n324\t  for (const cp of cps) {\n325\t    const key = cp.agent ?? \"unknown\"\n326\t    let agg = out[key]\n327\t    if (!agg) {\n328\t      agg = emptyAggregate()\n329\t      out[key] = agg\n330\t    }\n331\t    agg.checkpoints += 1\n332\t    agg.tokens += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n333\t  }\n334\t  return out\n335\t}\n336\t\n337\tfunction sumTokens(\n338\t  cps: Array<{ input_tokens: number | null; output_tokens: number | null }>,\n339\t): number {\n340\t  let total = 0\n341\t  for (const cp of cps) {\n342\t    total += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n343\t  }\n344\t  return total\n345\t}\n346\t\n347\t// buildDailyActivity produces one entry per day in the window [start, end).\n348\t// Days with no checkpoints return count=0 so the CLI renders a continuous\n349\t// strip without gaps.\n350\tfunction buildDailyActivity(\n351\t  cps: Array<{ commit_date: string | null; agent: string | null }>,\n352\t  start: Date,\n353\t  end: Date,\n354\t): Array<{ date: string; count: number }> {\n355\t  const days: string[] = []\n356\t  const cursor = new Date(start)\n357\t  cursor.setUTCHours(0, 0, 0, 0)\n358\t  const endDay = new Date(end)\n359\t  endDay.setUTCHours(0, 0, 0, 0)\n360\t  while (cursor <= endDay) {\n361\t    days.push(cursor.toISOString().slice(0, 10))\n362\t    cursor.setUTCDate(cursor.getUTCDate() + 1)\n363\t  }\n364\t  const counts: Record<string, number> = Object.fromEntries(days.map((d) => [d, 0]))\n365\t  for (const cp of cps) {\n366\t    if (!cp.commit_date) continue\n367\t    const day = cp.commit_date.slice(0, 10)\n368\t    if (counts[day] !== undefined) counts[day] += 1\n369\t  }\n370\t  return days.map((date) => ({ date, count: counts[date] ?? 0 }))\n371\t}\n372\t\n373\t// mergeAnalysesInto fetches analysis rows for the given checkpoints and\n374\t// merges their labels, skills, mcpServers, toolMix, transcriptTokens, and\n375\t// filesChanged onto the existing per-agent aggregate. Groups analysis\n376\t// lookups by repo_id so one query per repo (N+1 by repo, not by checkpoint).\n377\tasync function mergeAnalysesInto(\n378\t  db: ReturnType<typeof getDb>,\n379\t  byAgent: Record<string, AgentAggregate>,\n380\t  cps: Array<{\n381\t    checkpoint_id: string\n382\t    repo_id: string\n383\t    agent: string | null\n384\t  }>,\n385\t): Promise<void> {\n386\t  if (cps.length === 0) return\n387\t  const byRepo = new Map<string, string[]>()\n388\t  for (const cp of cps) {\n389\t    if (!cp.repo_id || !cp.checkpoint_id) continue\n390\t    const arr = byRepo.get(cp.repo_id) ?? []\n391\t    arr.push(cp.checkpoint_id)\n392\t    byRepo.set(cp.repo_id, arr)\n393\t  }\n394\t  // Key by `${repo_id}:${checkpoint_id}` rather than checkpoint_id alone —\n395\t  // checkpoint_id is only unique inside a repo (DB has a uniqueness\n396\t  // constraint on (repo_id, checkpoint_id)), so cross-repo aggregation\n397\t  // could otherwise overwrite an analysis with one from a different repo\n398\t  // that happens to share the same checkpoint_id.\n399\t  const analysisKey = (repoId: string, cpId: string) => `${repoId}:${cpId}`\n400\t  const analysesById = new Map<string, import(\"../types\").StoredCheckpointAnalysis>()\n401\t  for (const [rid, ids] of byRepo) {\n402\t    const rows = await db.analyses.getByCheckpointIds(rid, ids)\n403\t    for (const row of rows) {\n404\t      if (row.status !== \"complete\" || !row.analysis_json) continue\n405\t      try {\n406\t        analysesById.set(analysisKey(rid, row.checkpoint_id), JSON.parse(row.analysis_json))\n407\t      } catch {\n408\t        // ignore malformed analysis JSON\n409\t      }\n410\t    }\n411\t  }\n412\t  // Accumulate label / skill / mcp counts per agent then flatten.\n413\t  const labelCounts: Record<string, Record<string, number>> = {}\n414\t  const skillCounts: Record<string, Record<string, number>> = {}\n415\t  const mcpCounts: Record<string, Record<string, number>> = {}\n416\t  for (const cp of cps) {\n417\t    const agent = cp.agent ?? \"unknown\"\n418\t    const agg = byAgent[agent]\n419\t    if (!agg) continue\n420\t    const analysis = analysesById.get(analysisKey(cp.repo_id, cp.checkpoint_id))\n421\t    if (!analysis) continue\n422\t    agg.transcriptTokens += analysis.total_transcript_tokens ?? 0\n423\t    agg.filesChanged += analysis.totalFilesChanged ?? 0\n424\t    for (const lbl of analysis.extraction?.labels ?? []) {\n425\t      const m = (labelCounts[agent] ??= {})\n426\t      m[lbl] = (m[lbl] ?? 0) + 1\n427\t    }\n428\t    for (const sk of analysis.skillsUsed ?? []) {\n429\t      const m = (skillCounts[agent] ??= {})\n430\t      m[sk] = (m[sk] ?? 0) + 1\n431\t    }\n432\t    for (const mcp of analysis.mcpServersUsed ?? []) {\n433\t      const m = (mcpCounts[agent] ??= {})\n434\t      m[mcp.name] = (m[mcp.name] ?? 0) + (mcp.count ?? 1)\n435\t    }\n436\t    if (analysis.toolProfile?.categories) {\n437\t      const cats = analysis.toolProfile.categories\n438\t      agg.toolMix.shell += cats.shell?.count ?? 0\n439\t      agg.toolMix.fileOps += cats.fileOps?.count ?? 0\n440\t      agg.toolMix.search += cats.search?.count ?? 0\n441\t      agg.toolMix.mcp += cats.mcp?.count ?? 0\n442\t      agg.toolMix.agent += cats.agent?.count ?? 0\n443\t      agg.toolMix.other += cats.other?.count ?? 0\n444\t    }\n445\t  }\n446\t  for (const [agent, m] of Object.entries(labelCounts)) {\n447\t    byAgent[agent]!.labels = Object.entries(m).map(([label, count]) => ({ label, count }))\n448\t  }\n449\t  for (const [agent, m] of Object.entries(skillCounts)) {\n450\t    byAgent[agent]!.skills = Object.entries(m).map(([skill, count]) => ({ skill, count }))\n451\t  }\n452\t  for (const [agent, m] of Object.entries(mcpCounts)) {\n453\t    byAgent[agent]!.mcpServers = Object.entries(m).map(([name, count]) => ({ name, count }))\n454\t  }\n455\t}\n456\t\n457\tfunction emptyAggregate(): AgentAggregate {\n458\t  return {\n459\t    checkpoints: 0,\n460\t    tokens: 0,\n461\t    transcriptTokens: 0,\n462\t    filesChanged: 0,\n463\t    labels: [],\n464\t    skills: [],\n465\t    mcpServers: [],\n466\t    toolMix: { shell: 0, fileOps: 0, search: 0, mcp: 0, agent: 0, other: 0 },\n467\t  }\n468\t}\n469\t\n470\texport { recapRoutes }\n471\t"}]},"uuid":"d589da9b-63f9-48e8-a425-f503512c4f42","timestamp":"2026-04-29T15:26:22.431Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","content":"// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n//\n// Returns, for every agent the user has used in the window (and optionally\n// every agent any contributor used on a scoped repo):\n//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n//     labels + skills + mcpServers + toolMix\n//   - contributors side: the same shape aggregated across all contributors\n//     to the specified repo. Only populated when ?repo=org/name is supplied;\n//     otherwise both per-agent contributors and the top-level contributors\n//     summary are null (cross-repo team aggregation has no coherent\n//     \"everyone else\" set without a single repo as the reference frame).\n//\n// This endpoint consolidates three CLI operations into one request:\n//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n//   2. POST /checkpoints/analyses/batch → analyses for each cp\n//   3. GET /:org/:repo/overview/*       → contributor aggregates\n//\n// Without this endpoint the CLI has to do all three itself and attribute\n// analyses to agents via the commits endpoint — a lot of round trips and\n// brittle client-side joining. Centralizing on the server matches the\n// pattern established by /me/activity (PR #1590).\n\nimport type { Context } from \"hono\"\nimport { Hono } from \"hono\"\nimport { describeRoute, resolver } from \"hono-openapi\"\nimport { z } from \"zod\"\n\nimport type { Env, Variables } from \"../env\"\nimport { getDb } from \"../lib/db\"\nimport { recordSpanError } from \"../lib/telemetry\"\nimport { parseTimeframeParams } from \"./cache\"\n\n// AgentAggregate is the per-side per-agent payload. Same shape on both\n// me and contributors sides so the CLI renderer can treat them uniformly.\ninterface AgentAggregate {\n  checkpoints: number\n  tokens: number\n  transcriptTokens: number\n  filesChanged: number\n  labels: Array<{ label: string; count: number }>\n  skills: Array<{ skill: string; count: number }>\n  mcpServers: Array<{ name: string; count: number }>\n  toolMix: {\n    shell: number\n    fileOps: number\n    search: number\n    mcp: number\n    agent: number\n    other: number\n  }\n}\n\n// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n// applied at the meRoutes level (requireBearerAuth); duplicating it here\n// would double-execute the middleware.\nconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n\nconst errorSchema = z.object({ error: z.string() })\n\nconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\nconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\nconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\nconst toolMixSchema = z.object({\n  shell: z.number(),\n  fileOps: z.number(),\n  search: z.number(),\n  mcp: z.number(),\n  agent: z.number(),\n  other: z.number(),\n})\n\nconst agentAggregateSchema = z.object({\n  checkpoints: z.number(),\n  tokens: z.number(),\n  transcriptTokens: z.number(),\n  filesChanged: z.number(),\n  labels: z.array(labelCountSchema),\n  skills: z.array(skillCountSchema),\n  mcpServers: z.array(mcpCountSchema),\n  toolMix: toolMixSchema,\n})\n\nconst perAgentEntrySchema = z.object({\n  me: agentAggregateSchema,\n  contributors: agentAggregateSchema.nullable(),\n})\n\nconst recapResponseSchema = z.object({\n  timeframe: z.string(),\n  repo: z.string().nullable(),\n  since: z.string(),\n  until: z.string(),\n  agents: z.record(z.string(), perAgentEntrySchema),\n  contributors: z\n    .object({\n      distinctUsers: z.number(),\n      totalTokens: z.number(),\n      totalCheckpoints: z.number(),\n    })\n    .nullable(),\n  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n  updated_at: z.string(),\n})\n\nrecapRoutes.get(\n  \"/\",\n  describeRoute({\n    tags: [\"Me\"],\n    summary: \"Per-agent recap aggregates for the authenticated user\",\n    description:\n      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n      \"`contributors` counterpart aggregated across every contributor on the \" +\n      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n    parameters: [\n      {\n        name: \"timeframe\",\n        in: \"query\",\n        required: false,\n        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n        schema: {\n          type: \"string\",\n          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n        },\n      },\n      {\n        name: \"repo\",\n        in: \"query\",\n        required: false,\n        description:\n          \"Restrict me-side aggregates and enable the contributors side. \" +\n          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n          \"the user has checkpoints on and the contributors side is null.\",\n        schema: { type: \"string\" },\n      },\n      {\n        name: \"limit\",\n        in: \"query\",\n        required: false,\n        description: \"Max checkpoints to consider (1-1000, default 500).\",\n        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n      },\n      {\n        name: \"since\",\n        in: \"query\",\n        required: false,\n        description:\n          \"ISO-8601 lower bound for the activity window. When provided \" +\n          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n          \"uses this so its --day / --week / --month ranges line up exactly \" +\n          \"with the server's aggregation window.\",\n        schema: { type: \"string\", format: \"date-time\" },\n      },\n      {\n        name: \"until\",\n        in: \"query\",\n        required: false,\n        description:\n          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n          \"alongside `since` to override the `timeframe` enum.\",\n        schema: { type: \"string\", format: \"date-time\" },\n      },\n    ],\n    responses: {\n      200: {\n        description: \"Per-agent recap aggregates\",\n        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n      },\n      401: {\n        description: \"Not authenticated\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      404: {\n        description: \"User or repo not found\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      500: {\n        description: \"Failed to build recap\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n    },\n  }),\n  async (c) => {\n    const userId = c.get(\"userId\") as string\n    const { limit, startDate, endDate } = parseRecapWindow(c)\n    const repoParam = c.req.query(\"repo\")?.trim() || null\n\n    try {\n      const db = getDb(c.env)\n      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n      if (!user) return c.json({ error: \"User not found\" }, 404)\n\n      // Pull me-side from repo_checkpoints filtered to the user's commits.\n      // Team-side is only meaningful when the request scopes to a single\n      // repo — without that, \"everyone else\" has no coherent reference\n      // frame across all the user's repos. Skipping the team query when\n      // ?repo= is absent saves a heavy join and matches the documented\n      // contract that contributors is null in the cross-repo case.\n      const since = startDate.toISOString()\n      const until = endDate.toISOString()\n      const [myCheckpoints, teamCheckpoints] = await Promise.all([\n        db.checkpoints.getByUser(\n          userId,\n          user.github_id,\n          since,\n          until,\n          limit,\n          repoParam ?? undefined,\n        ),\n        repoParam\n          ? db.checkpoints.getTeamOnUserRepos(\n              userId,\n              user.github_id,\n              since,\n              until,\n              limit,\n              repoParam,\n            )\n          : Promise.resolve([]),\n      ])\n\n      // Base per-agent counts + tokens come straight off the checkpoint\n      // rows (input_tokens + output_tokens). No custom aggregator needed.\n      const meByAgent = aggregateCheckpointsByAgent(myCheckpoints)\n      const teamByAgent = aggregateCheckpointsByAgent(teamCheckpoints)\n\n      // Merge analysis-derived fields (labels, skills, mcpServers, toolMix,\n      // transcriptTokens, filesChanged) for both sides. Analyses live on\n      // repo_checkpoint_analyses keyed by (repo_id, checkpoint_id). The two\n      // sides are disjoint (different checkpoint sets) so parallelizing is\n      // safe — saves one full set of analysis round trips.\n      await Promise.all([\n        mergeAnalysesInto(db, meByAgent, myCheckpoints),\n        mergeAnalysesInto(db, teamByAgent, teamCheckpoints),\n      ])\n\n      // Daily activity from the user's own checkpoints — powers the CLI\n      // activity strip. Computed here so CLI doesn't need a second call.\n      const daily = buildDailyActivity(myCheckpoints, startDate, endDate)\n\n      // Contributors summary is only meaningful for a scoped repo. Count\n      // distinct *authors* (commit_author_github_id) — counting commit_sha\n      // would conflate \"team has 50 commits this week\" with \"50 distinct\n      // contributors\", which is wrong. The +1 for distinctUsers includes\n      // the requesting user themselves alongside team authors.\n      let contribSummary: {\n        distinctUsers: number\n        totalTokens: number\n        totalCheckpoints: number\n      } | null = null\n      if (repoParam) {\n        const teamAuthorIds = new Set<number>()\n        for (const cp of teamCheckpoints) {\n          if (typeof cp.commit_author_github_id === \"number\") {\n            teamAuthorIds.add(cp.commit_author_github_id)\n          }\n        }\n        contribSummary = {\n          distinctUsers: teamAuthorIds.size + 1,\n          totalTokens: sumTokens(myCheckpoints) + sumTokens(teamCheckpoints),\n          totalCheckpoints: myCheckpoints.length + teamCheckpoints.length,\n        }\n      }\n\n      // Assemble final per-agent map. Agents that appear on either side.\n      // Each agent's contributors field is null when ?repo= is absent\n      // (no team data was fetched), matching the top-level contributors null.\n      const allAgents = new Set<string>([...Object.keys(meByAgent), ...Object.keys(teamByAgent)])\n      const agents: Record<string, { me: AgentAggregate; contributors: AgentAggregate | null }> = {}\n      for (const name of allAgents) {\n        agents[name] = {\n          me: meByAgent[name] ?? emptyAggregate(),\n          contributors: repoParam ? (teamByAgent[name] ?? null) : null,\n        }\n      }\n\n      return c.json({\n        timeframe: c.req.query(\"timeframe\") ?? \"last-6-months\",\n        repo: repoParam,\n        since,\n        until,\n        agents,\n        contributors: contribSummary,\n        daily,\n        updated_at: new Date().toISOString(),\n      })\n    } catch (err) {\n      console.error(\"Failed to build recap:\", err)\n      recordSpanError(err)\n      return c.json({ error: \"Failed to build recap\" }, 500)\n    }\n  },\n)\n\n// parseRecapWindow accepts either explicit `since`/`until` ISO8601 params\n// or falls back to the timeframe enum (last-month / last-3-months /\n// last-6-months). Explicit dates give the CLI precise control so its\n// --day / --week / --month ranges line up exactly with the server's\n// aggregation boundaries.\nfunction parseRecapWindow(c: Context<{ Bindings: Env; Variables: Variables }>) {\n  const sinceParam = c.req.query(\"since\")\n  const untilParam = c.req.query(\"until\")\n  if (sinceParam && untilParam) {\n    const startDate = new Date(sinceParam)\n    const endDate = new Date(untilParam)\n    const limitParam = c.req.query(\"limit\")\n    const parsedLimit = limitParam ? parseInt(limitParam, 10) : 500\n    const limit = Number.isNaN(parsedLimit) || parsedLimit <= 0 ? 500 : Math.min(parsedLimit, 1000)\n    if (!Number.isNaN(startDate.getTime()) && !Number.isNaN(endDate.getTime())) {\n      return { limit, startDate, endDate }\n    }\n  }\n  return parseTimeframeParams(c)\n}\n\n// aggregateCheckpointsByAgent groups UserCheckpoint rows by their agent\n// field and sums checkpoint counts + tokens. Token sum uses input_tokens\n// + output_tokens from the checkpoint row directly — no analyses required.\nfunction aggregateCheckpointsByAgent(\n  cps: Array<{ agent: string | null; input_tokens: number | null; output_tokens: number | null }>,\n): Record<string, AgentAggregate> {\n  const out: Record<string, AgentAggregate> = {}\n  for (const cp of cps) {\n    const key = cp.agent ?? \"unknown\"\n    let agg = out[key]\n    if (!agg) {\n      agg = emptyAggregate()\n      out[key] = agg\n    }\n    agg.checkpoints += 1\n    agg.tokens += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n  }\n  return out\n}\n\nfunction sumTokens(\n  cps: Array<{ input_tokens: number | null; output_tokens: number | null }>,\n): number {\n  let total = 0\n  for (const cp of cps) {\n    total += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n  }\n  return total\n}\n\n// buildDailyActivity produces one entry per day in the window [start, end).\n// Days with no checkpoints return count=0 so the CLI renders a continuous\n// strip without gaps.\nfunction buildDailyActivity(\n  cps: Array<{ commit_date: string | null; agent: string | null }>,\n  start: Date,\n  end: Date,\n): Array<{ date: string; count: number }> {\n  const days: string[] = []\n  const cursor = new Date(start)\n  cursor.setUTCHours(0, 0, 0, 0)\n  const endDay = new Date(end)\n  endDay.setUTCHours(0, 0, 0, 0)\n  while (cursor <= endDay) {\n    days.push(cursor.toISOString().slice(0, 10))\n    cursor.setUTCDate(cursor.getUTCDate() + 1)\n  }\n  const counts: Record<string, number> = Object.fromEntries(days.map((d) => [d, 0]))\n  for (const cp of cps) {\n    if (!cp.commit_date) continue\n    const day = cp.commit_date.slice(0, 10)\n    if (counts[day] !== undefined) counts[day] += 1\n  }\n  return days.map((date) => ({ date, count: counts[date] ?? 0 }))\n}\n\n// mergeAnalysesInto fetches analysis rows for the given checkpoints and\n// merges their labels, skills, mcpServers, toolMix, transcriptTokens, and\n// filesChanged onto the existing per-agent aggregate. Groups analysis\n// lookups by repo_id so one query per repo (N+1 by repo, not by checkpoint).\nasync function mergeAnalysesInto(\n  db: ReturnType<typeof getDb>,\n  byAgent: Record<string, AgentAggregate>,\n  cps: Array<{\n    checkpoint_id: string\n    repo_id: