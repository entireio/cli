{"parentUuid":"305a5d2d-d681-4cbe-b409-42956b9136aa","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts","snippet":"1\timport { Hono } from \"hono\"\n2\timport { beforeEach, describe, expect, it, vi } from \"vitest\"\n3\t\n4\timport type { Env, Variables } from \"../env\"\n5\t\n6\tvi.mock(\"../lib/middleware\", () => ({\n7\t  requireBearerAuth: vi.fn((_c, next) => next()),\n8\t  requireAuth: vi.fn((_c, next) => next()),\n9\t  requireAdmin: vi.fn((_c, next) => next()),\n10\t  optionalAuth: vi.fn((_c, next) => next()),\n11\t  rateLimitUnauthenticated: vi.fn((_c, next) => next()),\n12\t}))\n13\t\n14\tconst mockRecordSpanError = vi.fn()\n15\tvi.mock(\"../lib/telemetry\", () => ({\n16\t  recordSpanError: (...args: unknown[]) => mockRecordSpanError(...args),\n17\t}))\n18\t\n19\tconst mockGetWithCache = vi.fn()\n20\tconst mockGetByUser = vi.fn()\n21\tconst mockGetTeamOnUserRepos = vi.fn()\n22\tconst mockGetByCheckpointIds = vi.fn()\n23\tconst mockAggregateFacetsByAgent = vi.fn()\n24\t\n25\tvi.mock(\"../lib/db\", () => ({\n26\t  getDb: () => ({\n27\t    users: { getWithCache: (...args: unknown[]) => mockGetWithCache(...args) },\n28\t    checkpoints: {\n29\t      getByUser: (...args: unknown[]) => mockGetByUser(...args),\n30\t      getTeamOnUserRepos: (...args: unknown[]) => mockGetTeamOnUserRepos(...args),\n31\t    },\n32\t    analyses: {\n33\t      getByCheckpointIds: (...args: unknown[]) => mockGetByCheckpointIds(...args),\n34\t      aggregateFacetsByAgent: (...args: unknown[]) => mockAggregateFacetsByAgent(...args),\n35\t    },\n36\t  }),\n37\t}))\n38\t\n39\timport { recapRoutes } from \"./recap\"\n40\t\n41\t// recapRoutes is mounted under /me/recap inside the parent router; in\n42\t// production the bearer auth middleware sets userId on the context. For\n43\t// these unit tests we mount the routes inside a wrapper that injects a\n44\t// constant userId so the handler can run.\n45\tfunction makeApp() {\n46\t  const app = new Hono<{ Bindings: Env; Variables: Variables }>()\n47\t  app.use(\"/*\", async (c, next) => {\n48\t    c.set(\"userId\", \"user-1\")\n49\t    await next()\n50\t  })\n51\t  app.route(\"/\", recapRoutes)\n52\t  return app\n53\t}\n54\t\n55\tconst mockEnv = { ENTIRE_CACHE: {} } as unknown as Env\n56\tconst mockExecutionCtx = { waitUntil: vi.fn(), passThroughOnException: vi.fn() }\n57\t\n58\tfunction makeCheckpoint(overrides: Partial<Record<string, unknown>> = {}) {\n59\t  return {\n60\t    checkpoint_id: \"cp-1\",\n61\t    commit_sha: \"sha-1\",\n62\t    commit_message: \"feat: stuff\",\n63\t    commit_date: \"2026-04-20T12:00:00Z\",\n64\t    commit_author_github_id: 99,\n65\t    additions: 1,\n66\t    deletions: 0,\n67\t    files_changed: 1,\n68\t    repo_id: \"repo-1\",\n69\t    repo_full_name: \"org/app\",\n70\t    branch: \"main\",\n71\t    is_private: false,\n72\t    agent: \"Claude Code\",\n73\t    steps: 1,\n74\t    session_count: 1,\n75\t    input_tokens: 100,\n76\t    output_tokens: 50,\n77\t    ...overrides,\n78\t  }\n79\t}\n80\t\n81\tdescribe(\"GET /me/recap\", () => {\n82\t  beforeEach(() => {\n83\t    vi.clearAllMocks()\n84\t    mockGetWithCache.mockResolvedValue({ id: \"user-1\", github_id: 12345 })\n85\t    mockGetByUser.mockResolvedValue([])\n86\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n87\t    mockGetByCheckpointIds.mockResolvedValue([])\n88\t    mockAggregateFacetsByAgent.mockResolvedValue(new Map())\n89\t  })\n90\t\n91\t  function get(path: string) {\n92\t    return makeApp().request(path, { headers: {} }, { ...mockEnv, ...mockExecutionCtx })\n93\t  }\n94\t\n95\t  it(\"returns null contributors and skips the team query when ?repo= is omitted\", async () => {\n96\t    const res = await get(\"/\")\n97\t\n98\t    expect(res.status).toBe(200)\n99\t    const body = (await res.json()) as Record<string, unknown>\n100\t\n101\t    expect(body.contributors).toBeNull()\n102\t    expect(body.repo).toBeNull()\n103\t    expect(mockGetTeamOnUserRepos).not.toHaveBeenCalled()\n104\t  })\n105\t\n106\t  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n107\t    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n108\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n109\t\n110\t    const res = await get(\"/?repo=org/app\")\n111\t    expect(res.status).toBe(200)\n112\t\n113\t    expect(mockGetByUser).toHaveBeenCalledWith(\n114\t      \"user-1\",\n115\t      12345,\n116\t      expect.any(String),\n117\t      expect.any(String),\n118\t      expect.any(Number),\n119\t      \"org/app\",\n120\t    )\n121\t    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n122\t      \"user-1\",\n123\t      12345,\n124\t      expect.any(String),\n125\t      expect.any(String),\n126\t      expect.any(Number),\n127\t      \"org/app\",\n128\t    )\n129\t  })\n130\t\n131\t  it(\"counts distinct contributors by author id, not by commit_sha\", async () => {\n132\t    mockGetByUser.mockResolvedValue([makeCheckpoint({ commit_author_github_id: 12345 })])\n133\t    mockGetTeamOnUserRepos.mockResolvedValue([\n134\t      // Author A makes two team commits — should count as ONE contributor,\n135\t      // not two as the previous commit_sha-based count would have done.\n136\t      makeCheckpoint({\n137\t        checkpoint_id: \"cp-2\",\n138\t        commit_sha: \"sha-team-a-1\",\n139\t        commit_author_github_id: 200,\n140\t      }),\n141\t      makeCheckpoint({\n142\t        checkpoint_id: \"cp-3\",\n143\t        commit_sha: \"sha-team-a-2\",\n144\t        commit_author_github_id: 200,\n145\t      }),\n146\t      makeCheckpoint({\n147\t        checkpoint_id: \"cp-4\",\n148\t        commit_sha: \"sha-team-b-1\",\n149\t        commit_author_github_id: 300,\n150\t      }),\n151\t    ])\n152\t\n153\t    const res = await get(\"/?repo=org/app\")\n154\t    const body = (await res.json()) as { contributors: { distinctUsers: number } }\n155\t\n156\t    // Two team authors (200, 300) plus the requesting user = 3.\n157\t    expect(body.contributors.distinctUsers).toBe(3)\n158\t  })\n159\t\n160\t  it(\"honours since/until query params over the timeframe enum\", async () => {\n161\t    const since = \"2026-04-20T00:00:00.000Z\"\n162\t    const until = \"2026-04-21T00:00:00.000Z\"\n163\t\n164\t    const res = await get(`/?since=${since}&until=${until}`)\n165\t    expect(res.status).toBe(200)\n166\t    const body = (await res.json()) as { since: string; until: string }\n167\t    expect(body.since).toBe(since)\n168\t    expect(body.until).toBe(until)\n169\t  })\n170\t\n171\t  it(\"attributes analyses to checkpoints scoped by repo_id, not just checkpoint_id\", async () => {\n172\t    // Two repos, two checkpoints sharing the same checkpoint_id \"shared\".\n173\t    // Each repo's analysis is unique. With the previous bug (key by\n174\t    // checkpoint_id alone), one analysis would clobber the other.\n175\t    mockGetByUser.mockResolvedValue([\n176\t      makeCheckpoint({\n177\t        repo_id: \"repo-A\",\n178\t        checkpoint_id: \"shared\",\n179\t        agent: \"Claude Code\",\n180\t      }),\n181\t      makeCheckpoint({\n182\t        repo_id: \"repo-B\",\n183\t        checkpoint_id: \"shared\",\n184\t        agent: \"Codex\",\n185\t      }),\n186\t    ])\n187\t    // Under the SQL facet aggregator the (repo_id, checkpoint_id) scoping is\n188\t    // enforced server-side: the route hands the full (repo_id, checkpoint_id,\n189\t    // agent) triple to aggregateFacetsByAgent and trusts the resulting\n190\t    // per-agent map verbatim. Mock that map directly here.\n191\t    mockAggregateFacetsByAgent.mockResolvedValue(\n192\t      new Map([\n193\t        [\n194\t          \"Claude Code\",\n195\t          {\n196\t            labels: [{ name: \"bug_fix\", count: 1 }],\n197\t            skills: [],\n198\t            toolMix: [],\n199\t          },\n200\t        ],\n201\t        [\n202\t          \"Codex\",\n203\t          {\n204\t            labels: [{ name: \"refactor\", count: 1 }],\n205\t            skills: [],\n206\t            toolMix: [],\n207\t          },\n208\t        ],\n209\t      ]),\n210\t    )\n211\t\n212\t    const res = await get(\"/\")\n213\t    expect(res.status).toBe(200)\n214\t    const body = (await res.json()) as {\n215\t      agents: Record<string, { me: { labels: Array<{ label: string }> } }>\n216\t    }\n217\t\n218\t    const claude = body.agents[\"Claude Code\"]\n219\t    const codex = body.agents.Codex\n220\t    expect(claude.me.labels.map((l) => l.label)).toEqual([\"bug_fix\"])\n221\t    expect(codex.me.labels.map((l) => l.label)).toEqual([\"refactor\"])\n222\t\n223\t    // The route must pass the full (repo_id, checkpoint_id, agent) triple so\n224\t    // the SQL aggregator can scope correctly. Verify the call shape.\n225\t    expect(mockAggregateFacetsByAgent).toHaveBeenCalledWith([\n\n... [138 lines truncated] ..."},"type":"attachment","uuid":"6ab0bf95-e9f6-4ad7-bfa5-21a1ca9d71d9","timestamp":"2026-04-30T10:02:31.961Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"6ab0bf95-e9f6-4ad7-bfa5-21a1ca9d71d9","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","snippet":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n6\t//     labels + skills + mcpServers + toolMix\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo. Only populated when ?repo=org/name is supplied;\n9\t//     otherwise both per-agent contributors and the top-level contributors\n10\t//     summary are null (cross-repo team aggregation has no coherent\n11\t//     \"everyone else\" set without a single repo as the reference frame).\n12\t//\n13\t// This endpoint consolidates three CLI operations into one request:\n14\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n15\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n16\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n17\t//\n18\t// Without this endpoint the CLI has to do all three itself and attribute\n19\t// analyses to agents via the commits endpoint — a lot of round trips and\n20\t// brittle client-side joining. Centralizing on the server matches the\n21\t// pattern established by /me/activity (PR #1590).\n22\t\n23\timport type { Context } from \"hono\"\n24\timport { Hono } from \"hono\"\n25\timport { describeRoute, resolver } from \"hono-openapi\"\n26\timport { z } from \"zod\"\n27\t\n28\timport type { Env, Variables } from \"../env\"\n29\timport { LEGACY_FALLBACK_AGENT_NAME } from \"../lib/constants\"\n30\timport { getDb } from \"../lib/db\"\n31\timport type { UserCheckpoint } from \"../lib/db/checkpoints\"\n32\timport type { AnalysisFacetsByAgent } from \"../lib/db/db-types\"\n33\timport { recordSpanError } from \"../lib/telemetry\"\n34\timport { parseTimeframeParams } from \"./cache\"\n35\t\n36\t// Toggle this off to revert to the legacy mergeAnalysesInto JS aggregator\n37\t// without redeploying. Read on every request — Cloudflare Workers env\n38\t// vars are statically configured so the flag should be replaced with a\n39\t// proper KV-backed config eventually, but for the initial rollout this\n40\t// constant + redeploy is fine. Removed after a 24h production soak.\n41\tconst USE_FACET_AGGREGATOR = true\n42\t\n43\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n44\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n45\t// would double-execute the middleware.\n46\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n47\t\n48\tconst errorSchema = z.object({ error: z.string() })\n49\t\n50\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n51\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n52\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n53\tconst toolMixSchema = z.object({\n54\t  shell: z.number(),\n55\t  fileOps: z.number(),\n56\t  search: z.number(),\n57\t  mcp: z.number(),\n58\t  agent: z.number(),\n59\t  other: z.number(),\n60\t})\n61\t\n62\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n63\t// me and contributors sides so the CLI renderer can treat them uniformly.\n64\t// Derived from the Zod schema so the response contract and the TS type\n65\t// can't drift — there's a single source of truth.\n66\tconst agentAggregateSchema = z.object({\n67\t  checkpoints: z.number(),\n68\t  tokens: z.number(),\n69\t  transcriptTokens: z.number(),\n70\t  filesChanged: z.number(),\n71\t  labels: z.array(labelCountSchema),\n72\t  skills: z.array(skillCountSchema),\n73\t  mcpServers: z.array(mcpCountSchema),\n74\t  toolMix: toolMixSchema,\n75\t})\n76\ttype AgentAggregate = z.infer<typeof agentAggregateSchema>\n77\t\n78\tconst perAgentEntrySchema = z.object({\n79\t  me: agentAggregateSchema,\n80\t  contributors: agentAggregateSchema.nullable(),\n81\t})\n82\t\n83\tconst recapResponseSchema = z.object({\n84\t  timeframe: z.string(),\n85\t  repo: z.string().nullable(),\n86\t  since: z.string(),\n87\t  until: z.string(),\n88\t  agents: z.record(z.string(), perAgentEntrySchema),\n89\t  contributors: z\n90\t    .object({\n91\t      distinctUsers: z.number(),\n92\t      totalTokens: z.number(),\n93\t      totalCheckpoints: z.number(),\n94\t    })\n95\t    .nullable(),\n96\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n97\t  updated_at: z.string(),\n98\t})\n99\t\n100\trecapRoutes.get(\n101\t  \"/\",\n102\t  describeRoute({\n103\t    tags: [\"Me\"],\n104\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n105\t    description:\n106\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n107\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n108\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n109\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n110\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n111\t    parameters: [\n112\t      {\n113\t        name: \"timeframe\",\n114\t        in: \"query\",\n115\t        required: false,\n116\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n117\t        schema: {\n118\t          type: \"string\",\n119\t          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n120\t        },\n121\t      },\n122\t      {\n123\t        name: \"repo\",\n124\t        in: \"query\",\n125\t        required: false,\n126\t        description:\n127\t          \"Restrict me-side aggregates and enable the contributors side. \" +\n128\t          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n129\t          \"the user has checkpoints on and the contributors side is null.\",\n130\t        schema: { type: \"string\" },\n131\t      },\n132\t      {\n133\t        name: \"limit\",\n134\t        in: \"query\",\n135\t        required: false,\n136\t        description: \"Max checkpoints to consider (1-1000, default 500).\",\n137\t        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n138\t      },\n139\t      {\n140\t        name: \"since\",\n141\t        in: \"query\",\n142\t        required: false,\n143\t        description:\n144\t          \"ISO-8601 lower bound for the activity window. When provided \" +\n145\t          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n146\t          \"uses this so its --day / --week / --month ranges line up exactly \" +\n147\t          \"with the server's aggregation window.\",\n148\t        schema: { type: \"string\", format: \"date-time\" },\n149\t      },\n150\t      {\n151\t        name: \"until\",\n152\t        in: \"query\",\n153\t        required: false,\n154\t        description:\n155\t          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n156\t          \"alongside `since` to override the `timeframe` enum.\",\n157\t        schema: { type: \"string\", format: \"date-time\" },\n158\t      },\n159\t    ],\n160\t    responses: {\n161\t      200: {\n162\t        description: \"Per-agent recap aggregates\",\n163\t        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n164\t      },\n165\t      400: {\n166\t        description:\n167\t          \"Invalid since/until (must be supplied together as ISO-8601, with since <= until)\",\n168\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n169\t      },\n170\t      401: {\n171\t        description: \"Not authenticated\",\n172\t        c