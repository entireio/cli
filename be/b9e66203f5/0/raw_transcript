{"parentUuid":"0effcd55-cd4c-475a-9c22-79a7c6fa3e8c","isSidechain":false,"promptId":"33bf94a9-7ccb-4708-9012-cad3a43ee533","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0161QuGSjmGxhmzHNSMxPVr6","type":"tool_result","content":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + labels + skills + mcpServers + toolMix\n6\t//     (tokens intentionally omitted — the CLI sums metadata.json locally)\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo (requires ?repo=org/name)\n9\t//\n10\t// This endpoint consolidates three CLI operations into one request:\n11\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n12\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n13\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n14\t//\n15\t// Without this endpoint the CLI has to do all three itself and attribute\n16\t// analyses to agents via the commits endpoint — a lot of round trips and\n17\t// brittle client-side joining. Centralizing on the server matches the\n18\t// pattern established by /me/activity (PR #1590).\n19\t\n20\timport type { Context } from \"hono\"\n21\timport { Hono } from \"hono\"\n22\timport { describeRoute, resolver } from \"hono-openapi\"\n23\timport { z } from \"zod\"\n24\t\n25\timport type { Env, Variables } from \"../env\"\n26\timport { getDb } from \"../lib/db\"\n27\timport { recordSpanError } from \"../lib/telemetry\"\n28\timport { parseTimeframeParams } from \"./cache\"\n29\t\n30\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n31\t// me and contributors sides so the CLI renderer can treat them uniformly.\n32\tinterface AgentAggregate {\n33\t  checkpoints: number\n34\t  tokens: number\n35\t  transcriptTokens: number\n36\t  filesChanged: number\n37\t  labels: Array<{ label: string; count: number }>\n38\t  skills: Array<{ skill: string; count: number }>\n39\t  mcpServers: Array<{ name: string; count: number }>\n40\t  toolMix: {\n41\t    shell: number\n42\t    fileOps: number\n43\t    search: number\n44\t    mcp: number\n45\t    agent: number\n46\t    other: number\n47\t  }\n48\t}\n49\t\n50\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n51\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n52\t// would double-execute the middleware.\n53\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n54\t\n55\tconst errorSchema = z.object({ error: z.string() })\n56\t\n57\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n58\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n59\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n60\tconst toolMixSchema = z.object({\n61\t  shell: z.number(),\n62\t  fileOps: z.number(),\n63\t  search: z.number(),\n64\t  mcp: z.number(),\n65\t  agent: z.number(),\n66\t  other: z.number(),\n67\t})\n68\t\n69\tconst agentAggregateSchema = z.object({\n70\t  checkpoints: z.number(),\n71\t  tokens: z.number(),\n72\t  transcriptTokens: z.number(),\n73\t  filesChanged: z.number(),\n74\t  labels: z.array(labelCountSchema),\n75\t  skills: z.array(skillCountSchema),\n76\t  mcpServers: z.array(mcpCountSchema),\n77\t  toolMix: toolMixSchema,\n78\t})\n79\t\n80\tconst perAgentEntrySchema = z.object({\n81\t  me: agentAggregateSchema,\n82\t  contributors: agentAggregateSchema.nullable(),\n83\t})\n84\t\n85\tconst recapResponseSchema = z.object({\n86\t  timeframe: z.string(),\n87\t  repo: z.string().nullable(),\n88\t  since: z.string(),\n89\t  until: z.string(),\n90\t  agents: z.record(z.string(), perAgentEntrySchema),\n91\t  contributors: z\n92\t    .object({\n93\t      distinctUsers: z.number(),\n94\t      totalTokens: z.number(),\n95\t      totalCheckpoints: z.number(),\n96\t    })\n97\t    .nullable(),\n98\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n99\t  updated_at: z.string(),\n100\t})\n101\t\n102\trecapRoutes.get(\n103\t  \"/\",\n104\t  describeRoute({\n105\t    tags: [\"Me\"],\n106\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n107\t    description:\n108\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n109\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n110\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n111\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n112\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n113\t    parameters: [\n114\t      {\n115\t        name: \"timeframe\",\n116\t        in: \"query\",\n117\t        required: false,\n118\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n119\t        schema: {\n120\t          type: \"string\",\n121\t          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n122\t        },\n123\t      },\n124\t      {\n125\t        name: \"repo\",\n126\t        in: \"query\",\n127\t        required: false,\n128\t        description:\n129\t          \"Restrict me-side aggregates and enable the contributors side. \" +\n130\t          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n131\t          \"the user has checkpoints on and the contributors side is null.\",\n132\t        schema: { type: \"string\" },\n133\t      },\n134\t      {\n135\t        name: \"limit\",\n136\t        in: \"query\",\n137\t        required: false,\n138\t        description: \"Max checkpoints to consider (1-1000, default 500).\",\n139\t        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n140\t      },\n141\t    ],\n142\t    responses: {\n143\t      200: {\n144\t        description: \"Per-agent recap aggregates\",\n145\t        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n146\t      },\n147\t      401: {\n148\t        description: \"Not authenticated\",\n149\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n150\t      },\n151\t      404: {\n152\t        description: \"User or repo not found\",\n153\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n154\t      },\n155\t      500: {\n156\t        description: \"Failed to build recap\",\n157\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n158\t      },\n159\t    },\n160\t  }),\n161\t  async (c) => {\n162\t    const userId = c.get(\"userId\") as string\n163\t    const { limit, startDate, endDate } = parseRecapWindow(c)\n164\t    const repoParam = c.req.query(\"repo\")?.trim() || null\n165\t\n166\t    try {\n167\t      const db = getDb(c.env)\n168\t      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n169\t      if (!user) return c.json({ error: \"User not found\" }, 404)\n170\t\n171\t      // Pull both sides from the same source (repo_checkpoints) with disjoint\n172\t      // author filters: me = user's github_id, team = everyone else on repos\n173\t      // the user has commit activity in. Cross-repo by default; repoParam\n174\t      // narrows both sides to the same repo when provided.\n175\t      const since = startDate.toISOString()\n176\t      const until = endDate.toISOString()\n177\t      const [myCheckpointsAll, teamCheckpointsAll] = await Promise.all([\n178\t        db.checkpoints.getByUser(userId, user.github_id, since, until, limit),\n179\t        db.checkpoints.getTeamOnUserRepos(userId, user.github_id, since, until, limit),\n180\t      ])\n181\t\n182\t      const myCheckpoints = repoParam\n183\t        ? myCheckpointsAll.filter((cp) => cp.repo_full_name === repoParam)\n184\t        : myCheckpointsAll\n185\t      const teamCheckpoints = repoParam\n186\t        ? teamCheckpointsAll.filter((cp) => cp.repo_full_name === repoParam)\n187\t        : teamCheckpointsAll\n188\t\n189\t      // Base per-agent counts + tokens come straight off the checkpoint\n190\t      // rows (input_tokens + output_tokens). No custom aggregator needed.\n191\t      const meByAgent = aggregateCheckpointsByAgent(myCheckpoints)\n192\t      const teamByAgent = aggregateCheckpointsByAgent(teamCheckpoints)\n193\t\n194\t      // Merge analysis-derived fields (labels, skills, mcpServers, toolMix,\n195\t      // transcriptTokens, filesChanged) for both sides. Analyses live on\n196\t      // repo_checkpoint_analyses keyed by (repo_id, checkpoint_id). The two\n197\t      // sides are disjoint (different checkpoint sets) so parallelizing is\n198\t      // safe — saves one full set of analysis round trips.\n199\t      await Promise.all([\n200\t        mergeAnalysesInto(db, meByAgent, myCheckpoints),\n201\t        mergeAnalysesInto(db, teamByAgent, teamCheckpoints),\n202\t      ])\n203\t\n204\t      // Daily activity from the user's own checkpoints — powers the CLI\n205\t      // activity strip. Computed here so CLI doesn't need a second call.\n206\t      const daily = buildDailyActivity(myCheckpoints, startDate, endDate)\n207\t\n208\t      // Summary across both sides (used by the CLI's context line).\n209\t      const distinctOthers = new Set(\n210\t        teamCheckpoints.map((cp) => cp.commit_sha ?? \"\").filter((s) => s !== \"\"),\n211\t      )\n212\t      const contribSummary = {\n213\t        distinctUsers: distinctOthers.size > 0 ? distinctOthers.size + 1 : 1,\n214\t        totalTokens: sumTokens(myCheckpoints) + sumTokens(teamCheckpoints),\n215\t        totalCheckpoints: myCheckpoints.length + teamCheckpoints.length,\n216\t      }\n217\t\n218\t      // Assemble final per-agent map. Agents that appear on either side.\n219\t      const allAgents = new Set<string>([...Object.keys(meByAgent), ...Object.keys(teamByAgent)])\n220\t      const agents: Record<string, { me: AgentAggregate; contributors: AgentAggregate | null }> = {}\n221\t      for (const name of allAgents) {\n222\t        agents[name] = {\n223\t          me: meByAgent[name] ?? emptyAggregate(),\n224\t          contributors: teamByAgent[name] ?? null,\n225\t        }\n226\t      }\n227\t\n228\t      return c.json({\n229\t        timeframe: c.req.query(\"timeframe\") ?? \"last-6-months\",\n230\t        repo: repoParam,\n231\t        since,\n232\t        until,\n233\t        agents,\n234\t        contributors: contribSummary,\n235\t        daily,\n236\t        updated_at: new Date().toISOString(),\n237\t      })\n238\t    } catch (err) {\n239\t      console.error(\"Failed to build recap:\", err)\n240\t      recordSpanError(err)\n241\t      return c.json({ error: \"Failed to build recap\" }, 500)\n242\t    }\n243\t  },\n244\t)\n245\t\n246\t// parseRecapWindow accepts either explicit `since`/`until` ISO8601 params\n247\t// or falls back to the timeframe enum (last-month / last-3-months /\n248\t// last-6-months). Explicit dates give the CLI precise control so its\n249\t// --day / --week / --month ranges line up exactly with the server's\n250\t// aggregation boundaries.\n251\tfunction parseRecapWindow(c: Context<{ Bindings: Env; Variables: Variables }>) {\n252\t  const sinceParam = c.req.query(\"since\")\n253\t  const untilParam = c.req.query(\"until\")\n254\t  if (sinceParam && untilParam) {\n255\t    const startDate = new Date(sinceParam)\n256\t    const endDate = new Date(untilParam)\n257\t    const limitParam = c.req.query(\"limit\")\n258\t    const parsedLimit = limitParam ? parseInt(limitParam, 10) : 500\n259\t    const limit = Number.isNaN(parsedLimit) || parsedLimit <= 0 ? 500 : Math.min(parsedLimit, 1000)\n260\t    if (!Number.isNaN(startDate.getTime()) && !Number.isNaN(endDate.getTime())) {\n261\t      return { limit, startDate, endDate }\n262\t    }\n263\t  }\n264\t  return parseTimeframeParams(c)\n265\t}\n266\t\n267\t// aggregateCheckpointsByAgent groups UserCheckpoint rows by their agent\n268\t// field and sums checkpoint counts + tokens. Token sum uses input_tokens\n269\t// + output_tokens from the checkpoint row directly — no analyses required.\n270\tfunction aggregateCheckpointsByAgent(\n271\t  cps: Array<{ agent: string | null; input_tokens: number | null; output_tokens: number | null }>,\n272\t): Record<string, AgentAggregate> {\n273\t  const out: Record<string, AgentAggregate> = {}\n274\t  for (const cp of cps) {\n275\t    const key = cp.agent ?? \"unknown\"\n276\t    let agg = out[key]\n277\t    if (!agg) {\n278\t      agg = emptyAggregate()\n279\t      out[key] = agg\n280\t    }\n281\t    agg.checkpoints += 1\n282\t    agg.tokens += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n283\t  }\n284\t  return out\n285\t}\n286\t\n287\tfunction sumTokens(\n288\t  cps: Array<{ input_tokens: number | null; output_tokens: number | null }>,\n289\t): number {\n290\t  let total = 0\n291\t  for (const cp of cps) {\n292\t    total += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n293\t  }\n294\t  return total\n295\t}\n296\t\n297\t// buildDailyActivity produces one entry per day in the window [start, end).\n298\t// Days with no checkpoints return count=0 so the CLI renders a continuous\n299\t// strip without gaps.\n300\tfunction buildDailyActivity(\n301\t  cps: Array<{ commit_date: string | null; agent: string | null }>,\n302\t  start: Date,\n303\t  end: Date,\n304\t): Array<{ date: string; count: number }> {\n305\t  const days: string[] = []\n306\t  const cursor = new Date(start)\n307\t  cursor.setUTCHours(0, 0, 0, 0)\n308\t  const endDay = new Date(end)\n309\t  endDay.setUTCHours(0, 0, 0, 0)\n310\t  while (cursor <= endDay) {\n311\t    days.push(cursor.toISOString().slice(0, 10))\n312\t    cursor.setUTCDate(cursor.getUTCDate() + 1)\n313\t  }\n314\t  const counts: Record<string, number> = Object.fromEntries(days.map((d) => [d, 0]))\n315\t  for (const cp of cps) {\n316\t    if (!cp.commit_date) continue\n317\t    const day = cp.commit_date.slice(0, 10)\n318\t    if (counts[day] !== undefined) counts[day] += 1\n319\t  }\n320\t  return days.map((date) => ({ date, count: counts[date] ?? 0 }))\n321\t}\n322\t\n323\t// mergeAnalysesInto fetches analysis rows for the given checkpoints and\n324\t// merges their labels, skills, mcpServers, toolMix, transcriptTokens, and\n325\t// filesChanged onto the existing per-agent aggregate. Groups analysis\n326\t// lookups by repo_id so one query per repo (N+1 by repo, not by checkpoint).\n327\tasync function mergeAnalysesInto(\n328\t  db: ReturnType<typeof getDb>,\n329\t  byAgent: Record<string, AgentAggregate>,\n330\t  cps: Array<{\n331\t    checkpoint_id: string\n332\t    repo_id: string\n333\t    agent: string | null\n334\t  }>,\n335\t): Promise<void> {\n336\t  if (cps.length === 0) return\n337\t  const byRepo = new Map<string, string[]>()\n338\t  for (const cp of cps) {\n339\t    if (!cp.repo_id || !cp.checkpoint_id) continue\n340\t    const arr = byRepo.get(cp.repo_id) ?? []\n341\t    arr.push(cp.checkpoint_id)\n342\t    byRepo.set(cp.repo_id, arr)\n343\t  }\n344\t  const analysesById = new Map<string, import(\"../types\").StoredCheckpointAnalysis>()\n345\t  for (const [rid, ids] of byRepo) {\n346\t    const rows = await db.analyses.getByCheckpointIds(rid, ids)\n347\t    for (const row of rows) {\n348\t      if (row.status !== \"complete\" || !row.analysis_json) continue\n349\t      try {\n350\t        analysesById.set(row.checkpoint_id, JSON.parse(row.analysis_json))\n351\t      } catch {\n352\t        // ignore malformed analysis JSON\n353\t      }\n354\t    }\n355\t  }\n356\t  // Accumulate label / skill / mcp counts per agent then flatten.\n357\t  const labelCounts: Record<string, Record<string, number>> = {}\n358\t  const skillCounts: Record<string, Record<string, number>> = {}\n359\t  const mcpCounts: Record<string, Record<string, number>> = {}\n360\t  for (const cp 