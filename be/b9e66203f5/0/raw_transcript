{"parentUuid":"e44e4fb4-8213-4d5e-bb0d-b21effd215f7","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts","snippet":"1\timport { Hono } from \"hono\"\n2\timport { beforeEach, describe, expect, it, vi } from \"vitest\"\n3\t\n4\timport type { Env, Variables } from \"../env\"\n5\t\n6\tvi.mock(\"../lib/middleware\", () => ({\n7\t  requireBearerAuth: vi.fn((_c, next) => next()),\n8\t  requireAuth: vi.fn((_c, next) => next()),\n9\t  requireAdmin: vi.fn((_c, next) => next()),\n10\t  optionalAuth: vi.fn((_c, next) => next()),\n11\t  rateLimitUnauthenticated: vi.fn((_c, next) => next()),\n12\t}))\n13\t\n14\tconst mockRecordSpanError = vi.fn()\n15\tvi.mock(\"../lib/telemetry\", () => ({\n16\t  recordSpanError: (...args: unknown[]) => mockRecordSpanError(...args),\n17\t}))\n18\t\n19\tconst mockGetWithCache = vi.fn()\n20\tconst mockGetByUser = vi.fn()\n21\tconst mockGetTeamOnUserRepos = vi.fn()\n22\tconst mockGetByCheckpointIds = vi.fn()\n23\t\n24\tvi.mock(\"../lib/db\", () => ({\n25\t  getDb: () => ({\n26\t    users: { getWithCache: (...args: unknown[]) => mockGetWithCache(...args) },\n27\t    checkpoints: {\n28\t      getByUser: (...args: unknown[]) => mockGetByUser(...args),\n29\t      getTeamOnUserRepos: (...args: unknown[]) => mockGetTeamOnUserRepos(...args),\n30\t    },\n31\t    analyses: {\n32\t      getByCheckpointIds: (...args: unknown[]) => mockGetByCheckpointIds(...args),\n33\t    },\n34\t  }),\n35\t}))\n36\t\n37\timport { recapRoutes } from \"./recap\"\n38\t\n39\t// recapRoutes is mounted under /me/recap inside the parent router; in\n40\t// production the bearer auth middleware sets userId on the context. For\n41\t// these unit tests we mount the routes inside a wrapper that injects a\n42\t// constant userId so the handler can run.\n43\tfunction makeApp() {\n44\t  const app = new Hono<{ Bindings: Env; Variables: Variables }>()\n45\t  app.use(\"/*\", async (c, next) => {\n46\t    c.set(\"userId\", \"user-1\")\n47\t    await next()\n48\t  })\n49\t  app.route(\"/\", recapRoutes)\n50\t  return app\n51\t}\n52\t\n53\tconst mockEnv = { ENTIRE_CACHE: {} } as unknown as Env\n54\tconst mockExecutionCtx = { waitUntil: vi.fn(), passThroughOnException: vi.fn() }\n55\t\n56\tfunction makeCheckpoint(overrides: Partial<Record<string, unknown>> = {}) {\n57\t  return {\n58\t    checkpoint_id: \"cp-1\",\n59\t    commit_sha: \"sha-1\",\n60\t    commit_message: \"feat: stuff\",\n61\t    commit_date: \"2026-04-20T12:00:00Z\",\n62\t    commit_author_github_id: 99,\n63\t    additions: 1,\n64\t    deletions: 0,\n65\t    files_changed: 1,\n66\t    repo_id: \"repo-1\",\n67\t    repo_full_name: \"org/app\",\n68\t    branch: \"main\",\n69\t    is_private: false,\n70\t    agent: \"Claude Code\",\n71\t    steps: 1,\n72\t    session_count: 1,\n73\t    input_tokens: 100,\n74\t    output_tokens: 50,\n75\t    ...overrides,\n76\t  }\n77\t}\n78\t\n79\tdescribe(\"GET /me/recap\", () => {\n80\t  beforeEach(() => {\n81\t    vi.clearAllMocks()\n82\t    mockGetWithCache.mockResolvedValue({ id: \"user-1\", github_id: 12345 })\n83\t    mockGetByUser.mockResolvedValue([])\n84\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n85\t    mockGetByCheckpointIds.mockResolvedValue([])\n86\t  })\n87\t\n88\t  function get(path: string) {\n89\t    return makeApp().request(path, { headers: {} }, { ...mockEnv, ...mockExecutionCtx })\n90\t  }\n91\t\n92\t  it(\"returns null contributors and skips the team query when ?repo= is omitted\", async () => {\n93\t    const res = await get(\"/\")\n94\t\n95\t    expect(res.status).toBe(200)\n96\t    const body = (await res.json()) as Record<string, unknown>\n97\t\n98\t    expect(body.contributors).toBeNull()\n99\t    expect(body.repo).toBeNull()\n100\t    expect(mockGetTeamOnUserRepos).not.toHaveBeenCalled()\n101\t  })\n102\t\n103\t  it(\"nulls every per-agent contributors entry when the top-level summary is null\", async () => {\n104\t    // When ?repo= is omitted the response has no coherent \"everyone else\"\n105\t    // frame across the user's repos, so the contributors block must be\n106\t    // null at every level. The two nullables (top-level + per-agent) MUST\n107\t    // move together — a half-populated response would be a contract bug\n108\t    // for both the CLI and the web consumers.\n109\t    mockGetByUser.mockResolvedValueOnce([\n110\t      makeCheckpoint({ checkpoint_id: \"cp-a\", agent: \"Claude Code\" }),\n111\t      makeCheckpoint({ checkpoint_id: \"cp-b\", agent: \"Codex\" }),\n112\t    ])\n113\t\n114\t    const res = await get(\"/\")\n115\t    expect(res.status).toBe(200)\n116\t    const body = (await res.json()) as {\n117\t      contributors: unknown\n118\t      agents: Record<string, { me: unknown; contributors: unknown }>\n119\t    }\n120\t    expect(body.contributors).toBeNull()\n121\t    for (const [agent, entry] of Object.entries(body.agents)) {\n122\t      expect(entry.contributors, `agents[${agent}].contributors`).toBeNull()\n123\t    }\n124\t  })\n125\t\n126\t  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n127\t    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n128\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n129\t\n130\t    const res = await get(\"/?repo=org/app\")\n131\t    expect(res.status).toBe(200)\n132\t\n133\t    expect(mockGetByUser).toHaveBeenCalledWith(\n134\t      \"user-1\",\n135\t      12345,\n136\t      expect.any(String),\n137\t      expect.any(String),\n138\t      expect.any(Number),\n139\t      \"org/app\",\n140\t    )\n141\t    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n142\t      \"user-1\",\n143\t      12345,\n144\t      expect.any(String),\n145\t      expect.any(String),\n146\t      expect.any(Number),\n147\t      \"org/app\",\n148\t    )\n149\t  })\n150\t\n151\t  it(\"counts distinct contributors by author id, not by commit_sha\", async () => {\n152\t    mockGetByUser.mockResolvedValue([makeCheckpoint({ commit_author_github_id: 12345 })])\n153\t    mockGetTeamOnUserRepos.mockResolvedValue([\n154\t      // Author A makes two team commits — should count as ONE contributor,\n155\t      // not two as the previous commit_sha-based count would have done.\n156\t      makeCheckpoint({\n157\t        checkpoint_id: \"cp-2\",\n158\t        commit_sha: \"sha-team-a-1\",\n159\t        commit_author_github_id: 200,\n160\t      }),\n161\t      makeCheckpoint({\n162\t        checkpoint_id: \"cp-3\",\n163\t        commit_sha: \"sha-team-a-2\",\n164\t        commit_author_github_id: 200,\n165\t      }),\n166\t      makeCheckpoint({\n167\t        checkpoint_id: \"cp-4\",\n168\t        commit_sha: \"sha-team-b-1\",\n169\t        commit_author_github_id: 300,\n170\t      }),\n171\t    ])\n172\t\n173\t    const res = await get(\"/?repo=org/app\")\n174\t    const body = (await res.json()) as { contributors: { distinctUsers: number } }\n175\t\n176\t    // Two team authors (200, 300) plus the requesting user = 3.\n177\t    expect(body.contributors.distinctUsers).toBe(3)\n178\t  })\n179\t\n180\t  it(\"honours since/until query params over the timeframe enum\", async () => {\n181\t    const since = \"2026-04-20T00:00:00.000Z\"\n182\t    const until = \"2026-04-21T00:00:00.000Z\"\n183\t\n184\t    const res = await get(`/?since=${since}&until=${until}`)\n185\t    expect(res.status).toBe(200)\n186\t    const body = (await res.json()) as { since: string; until: string }\n187\t    expect(body.since).toBe(since)\n188\t    expect(body.until).toBe(until)\n189\t  })\n190\t\n191\t  it(\"attributes analyses to checkpoints scoped by repo_id, not just checkpoint_id\", async () => {\n192\t    // Two repos, two checkpoints sharing the same checkpoint_id \"shared\".\n193\t    // Each repo's analysis is unique. With the previous bug (key by\n194\t    // checkpoint_id alone), one analysis would clobber the other.\n195\t    mockGetByUser.mockResolvedValue([\n196\t      makeCheckpoint({\n197\t        repo_id: \"repo-A\",\n198\t        checkpoint_id: \"shared\",\n199\t        agent: \"Claude Code\",\n200\t      }),\n201\t      makeCheckpoint({\n202\t        repo_id: \"repo-B\",\n203\t        checkpoint_id: \"shared\",\n204\t        agent: \"Codex\",\n205\t      }),\n206\t    ])\n207\t    // First call (repo-A) returns labels=[bug_fix]; second (repo-B) returns\n208\t    // labels=[refactor]. Both should land on the right agent's card.\n209\t    mockGetByCheckpointIds.mockImplementation(async (repoId: string, _ids: string[]) => {\n210\t      if (repoId === \"repo-A\") {\n211\t        return [\n212\t          {\n213\t            checkpoint_id: \"shared\",\n214\t            status: \"complete\",\n215\t            analysis_json: JSON.stringify({ extraction: { labels: [\"bug_fix\"] } }),\n216\t          },\n217\t        ]\n218\t      }\n219\t      if (repoId === \"repo-B\") {\n220\t        return [\n221\t          {\n222\t            checkpoint_id: \"shared\",\n\n... [143 lines truncated] ..."},"type":"attachment","uuid":"1367f17f-d711-4814-adea-3e97ac00160e","timestamp":"2026-04-30T09:29:14.073Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"1367f17f-d711-4814-adea-3e97ac00160e","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","snippet":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n6\t//     labels + skills + mcpServers + toolMix\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo. Only populated when ?repo=org/name is supplied;\n9\t//     otherwise both per-agent contributors and the top-level contributors\n10\t//     summary are null (cross-repo team aggregation has no coherent\n11\t//     \"everyone else\" set without a single repo as the reference frame).\n12\t//\n13\t// This endpoint consolidates three CLI operations into one request:\n14\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n15\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n16\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n17\t//\n18\t// Without this endpoint the CLI has to do all three itself and attribute\n19\t// analyses to agents via the commits endpoint — a lot of round trips and\n20\t// brittle client-side joining. Centralizing on the server matches the\n21\t// pattern established by /me/activity (PR #1590).\n22\t\n23\timport type { Context } from \"hono\"\n24\timport { Hono } from \"hono\"\n25\timport { describeRoute, resolver } from \"hono-openapi\"\n26\timport { z } from \"zod\"\n27\t\n28\timport type { Env, Variables } from \"../env\"\n29\timport { LEGACY_FALLBACK_AGENT_NAME } from \"../lib/constants\"\n30\timport { getDb } from \"../lib/db\"\n31\timport type { UserCheckpoint } from \"../lib/db/checkpoints\"\n32\timport { recordSpanError } from \"../lib/telemetry\"\n33\timport { parseTimeframeParams } from \"./cache\"\n34\t\n35\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n36\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n37\t// would double-execute the middleware.\n38\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n39\t\n40\tconst errorSchema = z.object({ error: z.string() })\n41\t\n42\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n43\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n44\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n45\tconst toolMixSchema = z.object({\n46\t  shell: z.number(),\n47\t  fileOps: z.number(),\n48\t  search: z.number(),\n49\t  mcp: z.number(),\n50\t  agent: z.number(),\n51\t  other: z.number(),\n52\t})\n53\t\n54\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n55\t// me and contributors sides so the CLI renderer can treat them uniformly.\n56\t// Derived from the Zod schema so the response contract and the TS type\n57\t// can't drift — there's a single source of truth.\n58\tconst agentAggregateSchema = z.object({\n59\t  checkpoints: z.number(),\n60\t  tokens: z.number(),\n61\t  transcriptTokens: z.number(),\n62\t  filesChanged: z.number(),\n63\t  labels: z.array(labelCountSchema),\n64\t  skills: z.array(skillCountSchema),\n65\t  mcpServers: z.array(mcpCountSchema),\n66\t  toolMix: toolMixSchema,\n67\t})\n68\ttype AgentAggregate = z.infer<typeof agentAggregateSchema>\n69\t\n70\tconst perAgentEntrySchema = z.object({\n71\t  me: agentAggregateSchema,\n72\t  contributors: agentAggregateSchema.nullable(),\n73\t})\n74\t\n75\tconst recapResponseSchema = z.object({\n76\t  timeframe: z.string(),\n77\t  repo: z.string().nullable(),\n78\t  since: z.string(),\n79\t  until: z.string(),\n80\t  agents: z.record(z.string(), perAgentEntrySchema),\n81\t  contributors: z\n82\t    .object({\n83\t      distinctUsers: z.number(),\n84\t      totalTokens: z.number(),\n85\t      totalCheckpoints: z.number(),\n86\t    })\n87\t    .nullable(),\n88\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n89\t  updated_at: z.string(),\n90\t})\n91\t\n92\trecapRoutes.get(\n93\t  \"/\",\n94\t  describeRoute({\n95\t    tags: [\"Me\"],\n96\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n97\t    description:\n98\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n99\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n100\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n101\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n102\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n103\t    parameters: [\n104\t      {\n105\t        name: \"timeframe\",\n106\t        in: \"query\",\n107\t        required: false,\n108\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n109\t        schema: {\n110\t          type: \"string\",\n111\t          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n112\t        },\n113\t      },\n114\t      {\n115\t        name: \"repo\",\n116\t        in: \"query\",\n117\t        required: false,\n118\t        description:\n119\t          \"Restrict me-side aggregates and enable the contributors side. \" +\n120\t          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n121\t          \"the user has checkpoints on and the contributors side is null.\",\n122\t        schema: { type: \"string\" },\n123\t      },\n124\t      {\n125\t        name: \"limit\",\n126\t        in: \"query\",\n127\t        required: false,\n128\t        description: \"Max checkpoints to consider (1-1000, default 500).\",\n129\t        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n130\t      },\n131\t      {\n132\t        name: \"since\",\n133\t        in: \"query\",\n134\t        required: false,\n135\t        description:\n136\t          \"ISO-8601 lower bound for the activity window. When provided \" +\n137\t          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n138\t          \"uses this so its --day / --week / --month ranges line up exactly \" +\n139\t          \"with the server's aggregation window.\",\n140\t        schema: { type: \"string\", format: \"date-time\" },\n141\t      },\n142\t      {\n143\t        name: \"until\",\n144\t        in: \"query\",\n145\t        required: false,\n146\t        description:\n147\t          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n148\t          \"alongside `since` to override the `timeframe` enum.\",\n149\t        schema: { type: \"string\", format: \"date-time\" },\n150\t      },\n151\t    ],\n152\t    responses: {\n153\t      200: {\n154\t        description: \"Per-agent recap aggregates\",\n155\t        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n156\t      },\n157\t      400: {\n158\t        description:\n159\t          \"Invalid since/until (must be supplied together as ISO-8601, with since <= until)\",\n160\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n161\t      },\n162\t      401: {\n163\t        description: \"Not authenticated\",\n164\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n165\t      },\n166\t      404: {\n167\t        description: \"Authenticated user record not found\",\n168\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n169\t      },\n170\t      500: {\n171\t        description: \"Failed to build recap\",\n172\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n173\t      },\n174\t    },\n175\t  }),\n176\t  async (c) => {\n177\t    const userId = c.get(\"userId\") as string\n178\t    const window = parseRecapWindow(c)\n179\t    if (!window.ok) {\n180\t      return c.json({ error: window.error }, 400)\n181\t    }\n182\t    const { limit, startDate, endDate } = window\n183\t    const repoParam = c.req.query(\"repo\")?.trim() || null\n184\t\n185\t    try {\n186\t      const db = getDb(c.env)\n187\t      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n188\t      if (!user) return c.json({ error: \"User not found\" }, 404)\n189\t\n190\t      // Pull me-side from repo_checkpoints filtered to the user's commits.\n191\t      // Team-side is only meaningful when the request scopes to a single\n192\t      // repo — without that, \"everyone else\" has no coherent reference\n193\t      // frame across all the user's repos. Skipping the team query when\n194\t      // ?repo= is absent saves a heavy join and matches the documented\n\n... [434 lines truncated] ..."},"type":"attachment","uuid":"31531542-f4cb-4bf9-98a0-30945725ecd4","timestamp":"2026-04-30T09:29:14.073Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"31531542-f4cb-4bf9-98a0-30945725ecd4","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/lib/planetscale/analyses.ts","snippet":"1\timport { sql, type Kysely, type Selectable } from \"kysely\"\n2\t\n3\timport type { DB, RepoCheckpointAnalyses } from \"../../../db/types\"\n4\timport type { AnalysesNamespace, AnalysisRow } from \"../db/db-types\"\n5\timport { generateId } from \"../uuid\"\n6\timport { dateToStr } from \"./row-helpers\"\n7\t\n8\tfunction mapAnalysisRow(row: Selectable<RepoCheckpointAnalyses>): AnalysisRow {\n9\t  return {\n10\t    id: row.id,\n11\t    repo_id: row.repo_id,\n12\t    checkpoint_id: row.checkpoint_id,\n13\t    status: row.status as \"pending\" | \"generating\" | \"complete\" | \"failed\",\n14\t    analysis_json: row.analysis_json\n15\t      ? typeof row.analysis_json === \"string\"\n16\t        ? row.analysis_json\n17\t        : JSON.stringify(row.analysis_json)\n18\t      : null,\n19\t    error_message: row.error_message,\n20\t    attempt_count: row.attempt_count,\n21\t    queued_at: row.queued_at.toISOString(),\n22\t    started_at: dateToStr(row.started_at),\n23\t    completed_at: dateToStr(row.completed_at),\n24\t  }\n25\t}\n26\t\n27\texport function createAnalysesNamespace(db: Kysely<DB>): AnalysesNamespace {\n28\t  return {\n29\t    async getByCheckpointId(repoId, checkpointId) {\n30\t      const row = await db\n31\t        .selectFrom(\"repo_checkpoint_analyses\")\n32\t        .selectAll()\n33\t        .where(\"repo_id\", \"=\", repoId)\n34\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n35\t        .executeTakeFirst()\n36\t\n37\t      if (!row) return null\n38\t\n39\t      return mapAnalysisRow(row)\n40\t    },\n41\t\n42\t    async getByCheckpointIds(repoId, checkpointIds) {\n43\t      if (checkpointIds.length === 0) return []\n44\t\n45\t      const rows = await db\n46\t        .selectFrom(\"repo_checkpoint_analyses\")\n47\t        .selectAll()\n48\t        .where(\"repo_id\", \"=\", repoId)\n49\t        .where(\"checkpoint_id\", \"in\", checkpointIds)\n50\t        .execute()\n51\t\n52\t      return rows.map(mapAnalysisRow)\n53\t    },\n54\t\n55\t    async upsertPending(repoId, checkpointId, queuedAt) {\n56\t      const now = new Date()\n57\t      const queuedDate = new Date(queuedAt)\n58\t      await db\n59\t        .insertInto(\"repo_checkpoint_analyses\")\n60\t        .values({\n61\t          id: generateId(),\n62\t          repo_id: repoId,\n63\t          checkpoint_id: checkpointId,\n64\t          status: \"pending\",\n65\t          queued_at: queuedDate,\n66\t          created_at: now,\n67\t          updated_at: now,\n68\t        })\n69\t        .onDuplicateKeyUpdate({\n70\t          // Skip if already complete — prevents duplicate messages from\n71\t          // triggering regeneration loops\n72\t          status: sql`CASE WHEN status = 'complete' THEN status ELSE 'pending' END`,\n73\t          queued_at: sql`CASE WHEN status = 'complete' THEN queued_at ELSE ${queuedDate} END`,\n74\t          error_message: sql`CASE WHEN status = 'complete' THEN error_message ELSE NULL END`,\n75\t          analysis_json: sql`CASE WHEN status = 'complete' THEN analysis_json ELSE NULL END`,\n76\t          started_at: sql`CASE WHEN status = 'complete' THEN started_at ELSE NULL END`,\n77\t          completed_at: sql`CASE WHEN status = 'complete' THEN completed_at ELSE NULL END`,\n78\t          updated_at: now,\n79\t        })\n80\t        .execute()\n81\t    },\n82\t\n83\t    async markGenerating(repoId, checkpointId, queuedAt) {\n84\t      const now = new Date()\n85\t      const result = await db\n86\t        .updateTable(\"repo_checkpoint_analyses\")\n87\t        .set({\n88\t          status: \"generating\",\n89\t          started_at: now,\n90\t          attempt_count: sql`attempt_count + 1`,\n91\t          updated_at: now,\n92\t        })\n93\t        .where(\"repo_id\", \"=\", repoId)\n94\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n95\t        .where(\"queued_at\", \"=\", new Date(queuedAt))\n96\t        .where(\"status\", \"in\", [\"pending\", \"failed\"])\n97\t        .executeTakeFirst()\n98\t\n99\t      return BigInt(result.numUpdatedRows) > 0n\n100\t    },\n101\t\n102\t    async markComplete(repoId, checkpointId, analysisJson, queuedAt) {\n103\t      const now = new Date()\n104\t      const result = await db\n105\t        .updateTable(\"repo_checkpoint_analyses\")\n106\t        .set({\n107\t          status: \"complete\",\n108\t          analysis_json: analysisJson,\n109\t          completed_at: now,\n110\t          error_message: null,\n111\t          updated_at: now,\n112\t        })\n113\t        .where(\"repo_id\", \"=\", repoId)\n114\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n115\t        .where(\"queued_at\", \"=\", new Date(queuedAt))\n116\t        .where(\"status\", \"=\", \"generating\")\n117\t        .executeTakeFirst()\n118\t\n119\t      return BigInt(result.numUpdatedRows) > 0n\n120\t    },\n121\t\n122\t    async markFailed(repoId, checkpointId, errorMessage, queuedAt) {\n123\t      const now = new Date()\n124\t      const result = await db\n125\t        .updateTable(\"repo_checkpoint_analyses\")\n126\t        .set({\n127\t          status: \"failed\",\n128\t          error_message: errorMessage,\n129\t          updated_at: now,\n130\t        })\n131\t        .where(\"repo_id\", \"=\", repoId)\n132\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n133\t        .where(\"queued_at\", \"=\", new Date(queuedAt))\n134\t        .where(\"status\", \"=\", \"generating\")\n135\t        .executeTakeFirst()\n136\t\n137\t      return BigInt(result.numUpdatedRows) > 0n\n138\t    },\n139\t\n140\t    async delete(repoId, checkpointId, queuedAt) {\n141\t      let query = db\n142\t        .deleteFrom(\"repo_checkpoint_analyses\")\n143\t        .where(\"repo_id\", \"=\", repoId)\n144\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n145\t\n146\t      if (queuedAt) {\n147\t        // When scoped to a specific enqueue attempt, only delete if the row\n148\t        // is still pending — a fast consumer may have already moved it to\n149\t        // `generating`, in which case we must not remove it.\n150\t        query = query.where(\"queued_at\", \"=\", new Date(queuedAt)).where(\"status\", \"=\", \"pending\")\n151\t      }\n152\t\n153\t      await query.execute()\n154\t    },\n155\t  }\n156\t}"},"type":"attachment","uuid":"4ae8afd5-273e-4c6d-b463-eb7425aab4e7","timestamp":"2026-04-30T09:29:14.073Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
