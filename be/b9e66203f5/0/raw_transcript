AIN\nSELECT cc.repo_id, cc.checkpoint_id, cc.commit_sha,\n       COALESCE(bc.branch, cc.branch) AS branch,\n       cp.created_at,\n       ROW_NUMBER() OVER (PARTITION BY cc.repo_id, cc.checkpoint_id\n                          ORDER BY (bc.branch IS NOT NULL) DESC) AS rn\nFROM repo_checkpoint_commits cc\nINNER JOIN repo_checkpoints cp\n  ON cp.repo_id = cc.repo_id AND cp.checkpoint_id = cc.checkpoint_id\nINNER JOIN repo_commits rc\n  ON rc.repo_id = cc.repo_id AND rc.commit_sha = cc.commit_sha\nINNER JOIN repos\n  ON repos.id = cc.repo_id\nINNER JOIN user_repos ur\n  ON ur.repo_id = cc.repo_id AND ur.user_id = ?\nLEFT JOIN repo_branch_commits bc\n  ON bc.repo_id = cc.repo_id AND bc.commit_sha = cc.commit_sha\n  AND bc.branch = repos.default_branch\nWHERE rc.commit_author_github_id = ?\n  AND cp.created_at >= ?\n  AND cp.created_at <= ?\n`, [userId, githubId, since, until])\n\n// 3) The team-side query\nawait show(\"EXPLAIN — team-side dedup CTE (7d)\", `\nEXPLAIN\nSELECT cc.repo_id, cc.checkpoint_id\nFROM repo_checkpoint_commits cc\nINNER JOIN repo_checkpoints cp\n  ON cp.repo_id = cc.repo_id AND cp.checkpoint_id = cc.checkpoint_id\nINNER JOIN repo_commits rc\n  ON rc.repo_id = cc.repo_id AND rc.commit_sha = cc.commit_sha\nINNER JOIN repos\n  ON repos.id = cc.repo_id\nINNER JOIN user_repos ur\n  ON ur.repo_id = cc.repo_id AND ur.user_id = ?\nLEFT JOIN repo_branch_commits bc\n  ON bc.repo_id = cc.repo_id AND bc.commit_sha = cc.commit_sha\n  AND bc.branch = repos.default_branch\nWHERE cp.repo_id IN (\n  SELECT DISTINCT repo_id FROM repo_commits\n  WHERE commit_author_github_id = ? AND commit_date >= ? AND commit_date <= ?\n)\nAND rc.commit_author_github_id != ?\nAND rc.commit_author_github_id IS NOT NULL\nAND cp.created_at >= ? AND cp.created_at <= ?\n`, [userId, githubId, since, until, githubId, since, until])\n\n// 4) ANALYZE form (real timing)\nawait show(\"ANALYZE — me-side actual timing (7d)\", `\nANALYZE\nSELECT cc.repo_id, cc.checkpoint_id, cc.commit_sha,\n     