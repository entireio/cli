\n      \"cc.checkpoint_id\",\n      \"cc.commit_sha\",\n      sql<string>`COALESCE(bc.branch, cc.branch)`.as(\"branch\"),\n      \"cp.created_at\",\n      // ROW_NUMBER() assigns 1, 2, 3... within each (repo_id, checkpoint_id) group.\n      // ORDER BY (bc.branch IS NOT NULL) DESC puts the default-branch row first (1=true, 0=false).\n      // The outer query filters WHERE rn = 1 to keep one row per checkpoint,\n      // preferring the default branch. If the checkpoint isn't on the default branch,\n      // an arbitrary branch is picked.\n      sql<number>`ROW_NUMBER() OVER (PARTITION BY cc.repo_id, cc.checkpoint_id ORDER BY (bc.branch IS NOT NULL) DESC)`.as(\n        \"rn\",\n      ),\n    ])\n    .where(\"rc.commit_author_github_id\", \"=\", githubId)\n    .where(\"cp.created_at\", \">=\", new Date(startDate))\n    .where(\"cp.created_at\", \"<=\", new Date(endDate))\n    .as(\"ranked\")\n\n  const commits = await db\n    .selectFrom(ranked)\n    .innerJoin(\"repo_commits as rc\", (join) =>\n      join\n        .onRef(\"rc.repo_id\", \"=\", \"ranked.repo_id\")\n        .onRef(\"rc.commit_sha\", \"=\", \"ranked.commit_sha\"),\n    )\n    .innerJoin(\"repos\", \"repos.id\", \"ranked.repo_id\")\n    .leftJoin(\"repo_checkpoints as cp\", (join) =>\n      join\n        .onRef(\"cp.repo_id\", \"=\", \"ranked.repo_id\")\n        .onRef(\"cp.checkpoint_id\", \"=\", \"ranked.checkpoint_id\"),\n    )\n    .select([\n      \"ranked.checkpoint_id\",\n      \"ranked.branch\",\n      \"rc.commit_sha\",\n      \"rc.commit_message\",\n      \"rc.commit_date\",\n      \"rc.additions\",\n      \"rc.deletions\",\n      \"rc.files_changed\",\n      \"ranked.repo_id\",\n      \"repos.full_name as repo_full_name\",\n      \"repos.default_branch\",\n      \"repos.is_private\",\n      \"cp.agent\",\n      \"cp.steps\",\n      \"cp.session_count\",\n      \"cp.input_tokens\",\n      \"cp.output_tokens\",\n    ])\n    .where(\"ranked.rn\", \"=\", 1)\n    .orderBy(\"rc.commit_date\", \"desc