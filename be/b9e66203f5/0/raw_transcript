veRepo.id, {\n        checkpoint_id: myCheckpointId,\n        branch: \"main\",\n      })\n      await createTestCommit(db, activeRepo.id, myCheckpointId, \"main\", {\n        commit_author_github_id: userGithubId,\n        commit_date: new Date(),\n      })\n\n      // Repo B: user is linked via user_repos but has NO commits in the\n      // window. A teammate's checkpoint here MUST NOT come back, because\n      // the function scopes team activity to repos where the user has\n      // authored a commit in the window — not just repos they're linked to.\n      const inactiveRepo = await createTestRepo(db, { default_branch: \"main\" })\n      await linkUserToRepo(db, user.id, inactiveRepo.id)\n      const offRepoCheckpointId = `cp-off-${Date.now()}`\n      await createTestCheckpoint(db, inactiveRepo.id, {\n        checkpoint_id: offRepoCheckpointId,\n        branch: \"main\",\n      })\n      await createTestCommit(db, inactiveRepo.id, offRepoCheckpointId, \"main\", {\n        commit_author_github_id: teammateGithubId,\n        commit_date: new Date(),\n      })\n\n      const startDate = new Date(Date.now() - 86400000).toISOString()\n      const endDate = new Date(Date.now() + 86400000).toISOString()\n\n      const results = await getTeamCheckpointsOnUserRepos(\n        db,\n        user.id,\n        userGithubId,\n        startDate,\n        endDate,\n      )\n\n      const ids = results.map((r) => r.checkpoint_id)\n      expect(ids).not.toContain(offRepoCheckpointId)\n    })\n  })\n})"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1703,"cache_read_input_tokens":166245,"output_tokens":2082,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1703,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":1,"output_tokens":2082,"cache_read_input_tokens":166