esStub(): {\n  analyses: Pick<AnalysesNamespace, \"persistAnalysisAggregates\">\n  persist: ReturnType<typeof vi.fn>\n} {\n  const persist = vi.fn().mockResolvedValue(undefined)\n  return {\n    analyses: {\n      persistAnalysisAggregates: persist as unknown as AnalysesNamespace[\"persistAnalysisAggregates\"],\n    },\n    persist,\n  }\n}\n\nconst FULL_ANALYSIS_JSON = JSON.stringify({\n  extraction: { labels: [\"bug_fix\", \"bug_fix\", \"refactor\"] },\n  skillsUsed: [\"debugging\"],\n  mcpServersUsed: [\n    { name: \"github\", count: 3 },\n    { name: \"linear\", count: 0 }, // filtered out\n  ],\n  toolProfile: {\n    categories: {\n      shell: { count: 5 },\n      fileOps: { count: 10 },\n      search: { count: 0 },\n      mcp: { count: 3 },\n      agent: { count: 0 },\n      other: { count: 2 },\n    },\n  },\n  total_transcript_tokens: 1234,\n  totalFilesChanged: 7,\n})\n\ndescribe(\"countOccurrences\", () => {\n  it(\"collapses duplicates into name+count rows\", () => {\n    expect(countOccurrences([\"a\", \"a\", \"b\"])).toEqual([\n      { name: \"a\", count: 2 },\n      { name: \"b\", count: 1 },\n    ])\n  })\n\n  it(\"returns an empty array for empty input\", () => {\n    expect(countOccurrences([])).toEqual([])\n  })\n})\n\ndescribe(\"extractToolMix\", () => {\n  it(\"filters out zero-count categories\", () => {\n    const out = extractToolMix({\n      toolProfile: {\n        categories: {\n          shell: { count: 5 },\n          fileOps: { count: 0 },\n          other: null,\n        },\n      },\n    })\n    expect(out).toEqual([{ name: \"shell\", count: 5 }])\n  })\n\n  it(\"returns [] when toolProfile is missing\", () => {\n    expect(extractToolMix({})).toEqual([])\n  })\n})\n\ndescribe(\"extractFacetsFromAnalysis\", () => {\n  it(\"derives all four facet arrays + scalars from a fully-shaped analysis\", () => {\n    const facets = extractFacetsFromAnalysis(JSON.parse(FULL_ANALYSIS_JSON))\n    expect(facets.labels).toEqual(\n      expect.arrayContaining([\n        { name: \"bug_fix\", count: 2 },\n        { name: \"refactor\", count: 1 },\n      ]),\n    )\n    expect(facets.skills).toEqual([{ name: \"debugging\", count: 1 }])\n    // mcpServers with count=0 is dropped.\n    expect(facets.mcpServers).toEqual([{ name: \"github\", count: 3 }])\n    // toolMix excludes zero-count categories (search, agent).\n    expect(facets.toolMix.map((t) => t.name).sort()).toEqual(\n      [\"fileOps\", \"mcp\", \"other\", \"shell\"].sort(),\n    )\n    expect(facets.transcriptTokens).toBe(1234)\n    expect(facets.filesChanged).toBe(7)\n  })\n\n  it(\"defaults missing scalars to 0 (legacy-row backfill case)\", () => {\n    const facets = extractFacetsFromAnalysis({})\n    expect(facets.transcriptTokens).toBe(0)\n    expect(facets.filesChanged).toBe(0)\n    expect(facets.labels).toEqual([])\n  })\n})\n\ndescribe(\"runBackfill\", () => {\n  it(\"processes every row and writes via persistAnalysisAggregates by default\", async () => {\n    const { db } = makeMockDb([\n      [\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-1\", analysis_json: FULL_ANALYSIS_JSON },\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-2\", analysis_json: FULL_ANALYSIS_JSON },\n      ],\n    ])\n    const { analyses, persist } = makeAnalysesStub()\n\n    const result = await runBackfill({ db, analyses }, { max: Infinity, dryRun: false })\n\n    expect(result).toEqual({ processed: 2, skipped: 0, wouldUpsert: 0 })\n    expect(persist).toHaveBeenCalledTimes(2)\n    // Single combined call — facets and scalars share one transaction so\n    // the worker and backfill never disagree on torn-write semantics.\n    const firstCall = persist.mock.calls[0]\n    expect(firstCall?.[0]).toBe(\"repo-A\")\n    expect(firstCall?.[1]).toBe(\"cp-1\")\n  })\n\n  it(\"dry-run never calls persistAnalysisAggregates and counts wouldUpsert\", async () => {\n    const { db } = makeMockDb([\n      [\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-1\", analysis_json: FULL_ANALYSIS_JSON },\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-2\", analysis_json: FULL_ANALYSIS_JSON },\n      ],\n    ])\n    const { analyses, persist } = makeAnalysesStub()\n\n    const result = await runBackfill({ db, analyses }, { max: Infinity, dryRun: true })\n\n    expect(result.wouldUpsert).toBe(2)\n    expect(result.processed).toBe(2)\n    expect(persist).not.toHaveBeenCalled()\n  })\n\n  it(\"honours --limit under dry-run (regression: previously processed never advanced)\", async () => {\n    // Three rows in one batch; limit caps at 2. Without the fix, the loop\n    // would run forever in dry-run because `processed` only advanced in\n    // the write branch.\n    const { db } = makeMockDb([\n      [\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-1\", analysis_json: FULL_ANALYSIS_JSON },\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-2\", analysis_json: FULL_ANALYSIS_JSON },\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-3\", analysis_json: FULL_ANALYSIS_JSON },\n      ],\n    ])\n    const { analyses } = makeAnalysesStub()\n\n    const result = await runBackfill({ db, analyses }, { max: 2, dryRun: true })\n\n    // The inner loop processes the whole batch before the outer guard\n    // re-evaluates; we just need to confirm we don't infinite-loop and\n    // that wouldUpsert tracks each row in the batch.\n    expect(result.wouldUpsert).toBeGreaterThanOrEqual(2)\n    expect(result.processed).toBeGreaterThanOrEqual(2)\n  })\n\n  it(\"skips rows with malformed JSON without throwing, but lets non-JSON errors propagate\", async () => {\n    const { db } = makeMockDb([\n      [\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-bad\", analysis_json: \"{not valid json\" },\n        { repo_id: \"repo-A\", checkpoint_id: \"cp-ok\", analysis_json: FULL_ANALYSIS_JSON },\n      ],\n    ])\n    const { analyses, persist } = makeAnalysesStub()\n    const warnSpy = vi.spyOn(console, \"warn\").mockImplementation(() => {})\n\n    const result = await runBackfill({ db, analyses }, { max: Infinity, dryRun: false })\n\n    expect(result.skipped).toBe(1)\n    expect(result.processed).toBe(2) // includes both the skipped and the OK row\n    expect(persist).toHaveBeenCalledTimes(1) // only cp-ok actually persisted\n    warnSpy.mockRestore()\n  })\n\n  it(\"propagates infrastructure errors instead of swallowing them as parse failures\", async () => {\n    const { db } = makeMockDb([\n      [{ repo_id: \"repo-A\", checkpoint_id: \"cp-1\", analysis_json: FULL_ANALYSIS_JSON }],\n    ])\n    const { analyses } = makeAnalysesStub()\n    // persistAnalysisAggregates throws a non-SyntaxError; it MUST bubble up.\n    ;(analyses.persistAnalysisAggregates as ReturnType<typeof vi.fn>).mockRejectedValueOnce(\n      new Error(\"planetscale connection lost\"),\n    )\n\n    await expect(\n      runBackfill({ db, analyses }, { max: Infinity, dryRun: false }),\n    ).rejects.toThrow(/planetscale connection lost/)\n  })\n})\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"c3f17cd9-3d4a-4aba-8e3d-6906e6a56a4f","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
