n\n\n```bash\nls api/scripts/ | grep -i backfill\ncat api/scripts/backfill-trail-sequential-numbers.ts 2>/dev/null | head -40\n```\n\nUse the same connection/db setup pattern.\n\n- [ ] **Step 2:** Create the script\n\n```typescript\n#!/usr/bin/env tsx\n/**\n * Backfill repo_checkpoint_analysis_{labels,skills,tool_mix} from existing\n * repo_checkpoint_analyses.analysis_json rows. Idempotent — safe to re-run.\n *\n * Usage: pnpm exec tsx scripts/backfill-analysis-facets.ts [--limit N]\n */\nimport { /* same imports as a peer backfill script */ } from \"...\"\nimport type { Db } from \"../src/lib/db/db-types\"\n\nconst BATCH_SIZE = 500\n\nasync function main() {\n  const db: Db = /* connect — mirror sibling script */\n  const limitFlag = process.argv.find(a => a.startsWith(\"--limit=\"))?.split(\"=\")[1]\n  const max = limitFlag ? parseInt(limitFlag, 10) : Infinity\n\n  let cursor: { repo_id: string; checkpoint_id: string } | null = null\n  let processed = 0\n  while (processed < max) {\n    let q = db\n      .selectFrom(\"repo_checkpoint_analyses\")\n      .select([\"repo_id\", \"checkpoint_id\", \"analysis_json\"])\n      .where(\"status\", \"=\", \"complete\")\n      .where(\"analysis_json\", \"is not\", null)\n      .orderBy(\"repo_id\")\n      .orderBy(\"checkpoint_id\")\n      .limit(BATCH_SIZE)\n    if (cursor) {\n      q = q.where(({ or, and, cmpr }) =>\n        or([\n          cmpr(\"repo_id\", \">\", cursor.repo_id),\n          and([\n            cmpr(\"repo_id\", \"=\", cursor.repo_id),\n            cmpr(\"checkpoint_id\", \">\", cursor.checkpoint_id),\n          ]),\n        ]),\n      )\n    }\n    const batch = await q.execute()\n    if (batch.length === 0) break\n\n    for (const row of batch) {\n      try {\n        const analysis = typeof row.analysis_json === \"string\"\n          ? JSON.parse(row.analysis_json)\n          : row.analysis_json\n        const labels  = countOccurrences(analysis?.extraction?.labels ?? [])\n        const skills  = countOccurrences(analysis?.skillsUsed ?? [])\n        const toolMix = extractToolMix(analysis)\n        await db.analyses.upsertFacets(row.repo_id, row.checkpoint_id, labels, skills, toolMix)\n        processed++\n      } catch (err) {\n        console.warn(`skipped repo=${row.repo_id} cp=${row.checkpoint_id}: ${err}`)\n      }\n    }\n    cursor = batch[batch.length - 1]\n    console.log(`processed ${processed} (cursor: ${cursor.repo_id}/${cursor.checkpoint_id})`)\n  }\n  console.log(`done. processed=${processed}`)\n}\n\nfunction countOccurrences(items: string[]): Array<{ name: string; count: number }> {\n  const m = new Map<string, number>()\n  for (const i of items) m.set(i, (m.get(i) ?? 0) + 1)\n  return Array.from(m, ([name, count]) => ({ name, count }))\n}\n\nfunction extractToolMix(analysis: any): Array<{ name: string; count: number }> {\n  const cats = analysis?.toolProfile?.categories\n  if (!cats || typeof cats !== \"object\") return []\n  const out: Array<{ name: string; count: number }> = []\n  for (const [name, v] of Object.entries(cats)) {\n    const count = (v as { count?: number } | null)?.count ?? 0\n    if (count > 0) out.push({ name, count })\n  }\n  return out\n}\n\nmain().catch((err) => {\n  console.error(err)\n  process.exit(1)\n})\n```\n\n- [ ] **Step 3:** Smoke test against local DB — first ensure local DB has at least one `repo_checkpoint_analyses` row with non-null `analysis_json`. Then:\n\n```bash\ncd api\npnpm exec tsx scripts/backfill-analysis-facets.ts --limit=10\n```\n\nExpected: prints progress, exits cleanly.\n\n- [ ] **Step 4:** Verify rows landed\n\n```bash\ndocker exec -i $(docker ps -qf name=mysql) mysql -uentire -pentire entire -e \"SELECT COUNT(*) FROM repo_checkpoint_analysis_labels\"\n```\n\nExpected: > 0.\n\n- [ ] **Step 5:** Commit\n\n```bash\ngit add api/scripts/backfill-analysis-facets.ts\ngit commit -m \"chore(recap): add backfill script for analysis facet tables\n\nIterates repo_checkpoint_analyses where status='complete' and