{"parentUuid":"8048805f-87dc-498f-bdda-58f248ed0c8f","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/lib/analysis-queue.ts","snippet":"1\timport type { Env } from \"../env\"\n2\timport type {\n3\t  SessionAttribution,\n4\t  SessionInfo,\n5\t  SessionTranscript,\n6\t  StoredCheckpointAnalysis,\n7\t  ToolProfile,\n8\t} from \"../types\"\n9\timport {\n10\t  type AttemptId,\n11\t  completeAttempt,\n12\t  failAttempt,\n13\t  runAttemptWithTimeout,\n14\t  tryAcquireAttempt,\n15\t} from \"./analysis-attempt\"\n16\timport { type AnthropicRateLimiterStub, RateLimitedError } from \"./anthropic-rate-limiter\"\n17\timport { buildCheckpointAnalysisBlockChunks } from \"./checkpoint-analysis-indexer\"\n18\timport { generateCheckpointAnalysis } from \"./checkpoint-analysis-pipeline\"\n19\timport {\n20\t  buildSessionsFromStrippedTranscript,\n21\t  type LoadedCheckpointTranscript,\n22\t  loadCheckpointTranscript,\n23\t  parseSessionMetadata,\n24\t  type StrippedSessionMetadata,\n25\t} from \"./checkpoint-transcript\"\n26\timport { FLAG_CHECKPOINT_ANALYSIS_API } from \"./constants\"\n27\timport { getBackgroundDb } from \"./db\"\n28\timport type { CheckpointWithCommit } from \"./db/checkpoints\"\n29\timport type { Db } from \"./db/db-types\"\n30\timport { getCheckpointRepoName } from \"./entire-settings\"\n31\timport { invalidateCheckpointCaches } from \"./kv\"\n32\timport { getOrCreatePostHogClient, isFeatureEnabled } from \"./posthog\"\n33\timport { type StoredTranscriptSession } from \"./stored-transcript\"\n34\timport { avgMs, errorString, generateBatchId } from \"./telemetry\"\n35\timport { getInstallationToken } from \"./token\"\n36\t\n37\texport interface AnalysisQueueMessage {\n38\t  repoId: string\n39\t  checkpointId: string\n40\t  queuedAt: string\n41\t}\n42\t\n43\texport function isAnalysisQueueMessage(msg: unknown): msg is AnalysisQueueMessage {\n44\t  return (\n45\t    typeof msg === \"object\" &&\n46\t    msg !== null &&\n47\t    \"repoId\" in msg &&\n48\t    \"checkpointId\" in msg &&\n49\t    \"queuedAt\" in msg &&\n50\t    typeof (msg as AnalysisQueueMessage).repoId === \"string\" &&\n51\t    typeof (msg as AnalysisQueueMessage).checkpointId === \"string\" &&\n52\t    typeof (msg as AnalysisQueueMessage).queuedAt === \"string\" &&\n53\t    !(\"checkpointIds\" in msg)\n54\t  )\n55\t}\n56\t\n57\tfunction log(event: string, data: Record<string, unknown>): void {\n58\t  console.log(`[analysis-queue] ${event}`, JSON.stringify(data))\n59\t}\n60\t\n61\tconst MAX_ANALYSIS_RETRIES = 3\n62\tconst CHECKPOINT_ANALYSIS_TIMEOUT_MS = 10 * 60_000\n63\t\n64\t// Errors where retrying won't help because the input is missing or malformed.\n65\t// Matched by substring against the error message.\n66\t//\n67\t// \"Checkpoint not found in database\" and \"No transcript data available\" used\n68\t// to live here, but both are prerequisite-race signals: a sibling writer\n69\t// (the other webhook, or repo-sync-service) fills the missing half shortly\n70\t// after and will re-call dispatchAnalysis. Letting the existing 60s → 300s\n71\t// backoff retry them recovers the race without the noisy permanent log.\n72\tconst PERMANENT_ERROR_PATTERNS = [\"No transcript chunks available for analysis\"] as const\n73\t\n74\texport function isPermanentAnalysisError(error: unknown): boolean {\n75\t  const message = errorString(error)\n76\t  return PERMANENT_ERROR_PATTERNS.some((pattern) => message.includes(pattern))\n77\t}\n78\t\n79\tfunction getAnthropicRateLimiterStub(env: Env): AnthropicRateLimiterStub | undefined {\n80\t  const ns = env.ANTHROPIC_RATE_LIMITER\n81\t  if (!ns) return undefined\n82\t  return ns.get(ns.idFromName(\"global\"))\n83\t}\n84\t\n85\tfunction retryDelaySeconds(attempts: number): number {\n86\t  // 1st retry after 60s, 2nd after 300s (5 min). Gives transient upstream\n87\t  // failures room to clear without hammering the API