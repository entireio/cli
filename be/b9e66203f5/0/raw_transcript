),\n    }),\n  })\n}\n\nasync function main(): Promise<void> {\n  const db = createDb()\n  const analyses = createAnalysesNamespace(db)\n\n  const limitFlag = process.argv.find((a) => a.startsWith(\"--limit=\"))?.split(\"=\")[1]\n  const max = limitFlag ? parseInt(limitFlag, 10) : Infinity\n  const dryRun = process.argv.includes(\"--dry-run\")\n\n  let cursor: { repo_id: string; checkpoint_id: string } | null = null\n  let processed = 0\n  let skipped = 0\n  let wouldUpsert = 0\n\n  while (processed < max) {\n    let q = db\n      .selectFrom(\"repo_checkpoint_analyses\")\n      .select([\"repo_id\", \"checkpoint_id\", \"analysis_json\"])\n      .where(\"status\", \"=\", \"complete\")\n      .where(\"analysis_json\", \"is not\", null)\n      .orderBy(\"repo_id\")\n      .orderBy(\"checkpoint_id\")\n      .limit(BATCH_SIZE)\n\n    if (cursor) {\n      const c = cursor\n      q = q.where(({ eb, or, and }) =>\n        or([\n          eb(\"repo_id\", \">\", c.repo_id),\n          and([eb(\"repo_id\", \"=\", c.repo_id), eb(\"checkpoint_id\", \">\", c.checkpoint_id)]),\n        ]),\n      )\n    }\n\n    const batch = await q.execute()\n    if (batch.length === 0) break\n\n    for (const row of batch) {\n      try {\n        const analysis: AnalysisJsonShape =\n          typeof row.analysis_json === \"string\"\n            ? JSON.parse(row.analysis_json)\n            : (row.analysis_json as AnalysisJsonShape)\n        const labels = countOccurrences(analysis.extraction?.labels ?? [])\n        const skills = countOccurrences(analysis.skillsUsed ?? [])\n        const toolMix = extractToolMix(analysis)\n        // mcpServersUsed in the analysis JSON is already {name, count}-shaped\n        // (extractToolMetrics in analysis-queue.ts produces it that way).\n        // Filter zero/negative counts so the backfill never plants dead rows.\n        const mcpServers = (analysis.mcpServersUsed ?? [])\n          .filter((m) => (m.count ?? 0) > 0)\n          .map((m) => ({ name: m.name, count: m.count ?? 0 }))\n\n        if (dryRun) {\n          wouldUpsert++\n        } else {\n          await analyses.upsertFacets(\n            row.repo_id,\n            row.checkpoint_id,\n            labels,\n            skills,\n            toolMix,\n            mcpServers,\n          )\n          await analyses.updateScalarAggregates(\n            row.repo_id,\n            row.checkpoint_id,\n            analysis.total_transcript_tokens ?? 0,\n            analysis.totalFilesChanged ?? 0,\n          )\n          processed++\n        }\n      } catch (err) {\n        skipped++\n        console.warn(`skip repo=${row.repo_id} cp=${row.checkpoint_id}: ${err}`)\n      }\n    }\n\n    cursor = {\n      repo_id: batch[batch.length - 1].repo_id,\n      checkpoint_id: batch[batch.length - 1].checkpoint_id,\n    }\n    if (dryRun) {\n      console.log(\n        `would-upsert=${wouldUpsert} skipped=${skipped} cursor=${cursor.repo_id}/${cursor.checkpoint_id}`,\n      )\n    } else {\n      console.log(\n        `processed=${processed} skipped=${skipped} cursor=${cursor.repo_id}/${cursor.checkpoint_id}`,\n      )\n    }\n  }\n\n  if (dryRun) {\n    console.log(`done (dry-run). would_upsert=${wouldUpsert} skipped=${skipped}`)\n  } else {\n    console.log(`done. processed=${processed} skipped=${skipped}`)\n  }\n  await db.destroy()\n}\n\nfunction countOccurrences(items: string[]): Array<{ name: string; count: number }> {\n  const m = new Map<string, number>()\n  for (const i of items) m.set(i, (m.get(i) ?? 0) + 1)\n  return Array.from(m, ([name, count]) => ({ name, count }))\n}\n\nfunction extractToolMix(analysis: AnalysisJsonShape): Array<{ name: string; count: number }> {\n  const cats = analysis.toolProfile?.categories\n  if (!cats || typeof cats !== \"object\") return []\n  const out: Array<{ name: string; count: number }> = []\n  for (const [name, v] of Object.entries(cats)) {\n    const count = v?.count ?? 0\n    if (count > 0) out.push({ name, count })\n  }\n  return out\n}\n\nmain().catch((err) => {\n  console.error(err)\n  process.exit(1)\n})\n","structuredPatch":[{"oldStart":83,"oldLines":49,"newStart":83,"newLines":62,"lines":["     if (batch.length === 0) break"," ","     for (const row of batch) {","+      // Parse analysis_json. Only SyntaxError is the expected","+      // \"skip-and-continue\" case — all other errors (DB errors, schema","+      // mismatches, infrastructure flaps) MUST propagate so a flap during","+      // backfill doesn't silently leave thousands of rows un-denormalized","+      // while the script reports \"done\".","+      let analysis: AnalysisJsonShape","       try {","-        const analysis: AnalysisJsonShape =","+        analysis =","           typeof row.analysis_json === \"string\"","-            ? JSON.parse(row.analysis_json)","+            ? (JSON.parse(row.analysis_json) as AnalysisJsonShape)","             : (row.analysis_json as AnalysisJsonShape)","-        const labels = countOccurrences(analysis.extraction?.labels ?? [])","-        const skills = countOccurrences(analysis.skillsUsed ?? [])","-        const toolMix = extractToolMix(analysis)","-        // mcpServersUsed in the analysis JSON is already {name, count}-shaped","-        // (extractToolMetrics in analysis-queue.ts produces it that way).","-        // Filter zero/negative counts so the backfill never plants dead rows.","-        const mcpServers = (analysis.mcpServersUsed ?? [])","-          .filter((m) => (m.count ?? 0) > 0)","-          .map((m) => ({ name: m.name, count: m.count ?? 0 }))","-","-        if (dryRun) {","-          wouldUpsert++","-        } else {","-          await analyses.upsertFacets(","-            row.repo_id,","-            row.checkpoint_id,","-            labels,","-            skills,","-            toolMix,","-            mcpServers,","-          )","-          await analyses.updateScalarAggregates(","-            row.repo_id,","-            row.checkpoint_id,","-            analysis.total_trans