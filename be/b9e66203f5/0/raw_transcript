s.map((cp) => ({\n              repo_id: cp.repo_id,\n              checkpoint_id: cp.checkpoint_id,\n              agent: cp.agent,\n            })),\n          ),\n          // teamCheckpoints is empty when repoParam is null (the upstream\n          // getTeamOnUserRepos call is skipped in that case), so the\n          // aggregator would just return an empty Map. Short-circuiting\n          // here saves one no-op DB round trip.\n          repoParam\n            ? db.analyses.aggregateFacetsByAgent(\n                teamCheckpoints.map((cp) => ({\n                  repo_id: cp.repo_id,\n                  checkpoint_id: cp.checkpoint_id,\n                  agent: cp.agent,\n                })),\n              )\n            : Promise.resolve(new Map<string, AnalysisFacetsByAgent>()),\n        ])\n        mergeFacetsIntoAggregates(meByAgent, meFacets)\n        mergeFacetsIntoAggregates(teamByAgent, teamFacets)\n      } else {\n        await Promise.all([\n          mergeAnalysesInto(db, meByAgent, myCheckpoints),\n          mergeAnalysesInto(db, teamByAgent, teamCheckpoints),\n        ])\n      }\n\n      // Daily activity from the user's own checkpoints — powers the CLI\n      // activity strip. Computed here so CLI doesn't need a second call.\n      const daily = buildDailyActivity(myCheckpoints, startDate, endDate)\n","numLines":75,"startLine":200,"totalLines":562}},"sourceToolAssistantUUID":"d434d884-d150-42e6-aaf0-aded06a996c5","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
