ed: number\n  checkpoints: CheckpointListItem[]\n}\n\n// Result type for getRepoWithCheckpoints\nexport interface RepoWithCheckpointsResult {\n  repo: Repo\n  checkpoints: CheckpointWithCommit[]\n}\n\n// Find a checkpoint by ID across all branches (for redirect when original branch is deleted)\n// Returns the checkpoint data and list of branches it exists on\nexport interface CheckpointLocation {\n  checkpoint_id: string\n  branches: string[]\n  default_branch: string | null // If checkpoint exists on default branch\n  commit: CheckpointWithCommit | null // Checkpoint data from preferred branch\n}\n\nexport interface CommitLocation {\n  commit_sha: string\n  branches: string[]\n  default_branch: string | null\n  commit: CommitWithCheckpoints | null\n}\n\n// --- Webhook Data Types ---\n\nexport interface CheckpointWebhookData {\n  checkpoint_id: string\n  prompt: string | null\n  agent: string | null\n  model: string | null\n  steps: number | null\n  session_count: number | null\n  strategy: string | null\n  created_at: string | null\n  branch: string | null\n  session_id: string | null\n  files_touched: string[] | null\n  session_ids: string[] | null\n  transcript_uuid_at_start: string | null\n  transcript_lines_at_start: number | null\n  checkpoint_transcript_start: number | null\n  input_tokens: number | null\n  cache_creation_tokens: number | null\n  cache_read_tokens: number | null\n  output_tokens: number | null\n  api_call_count: number | null\n  attribution_agent_lines: number | null\n  attribution_human_added: number | null\n  attribution_human_modified: number | null\n  attribution_human_removed: number | null\n  attribution_total_committed: number | null\n  attribution_agent_percentage: number | null\n  attribution_calculated_at: string | null\n  sessions: Json | null\n  payload_hydration_state?: CheckpointPayloadHydrationState\n  storage_version?: CheckpointStorageVersion\n}\n\nexport interface CommitWebhookData {\n  checkpoint_id: string\n  commit_sha: string\n}\n\nexport interface RepoCommitData {\n  commit_sha: string\n  commit_message: string\n  commit_author: string\n  commit_author_username: string | null\n  commit_author_github_id: number | null\n  commit_date: string\n  additions: number\n  deletions: number\n  files_changed: number\n  file_stats: FileStats[] | null\n  html_url?: string | null\n}\n\n// --- User Checkpoints (for dashboard) ---\n\nexport interface UserCheckpoint {\n  checkpoint_id: string\n  commit_sha: string | null\n  commit_message: string | null\n  commit_date: string | null\n  commit_author_github_id: number | null\n  additions: number\n  deletions: number\n  files_changed: number\n  repo_id: string\n  repo_full_name: string\n  branch: string\n  is_private: boolean\n  agent: string | null\n  steps: number | null\n  session_count: number | null\n  input_tokens: number | null\n  output_tokens: number | null\n}\n\nexport interface UserCommitListItem extends CommitListItem {\n  repo_full_name: string\n  is_private: boolean\n  // Repo where checkpoint data lives (null when checkpoints are stored in the source repo)\n  checkpoint_repo_full_name: string | null\n}\n\n// Activity data for a repo\nexport interface RepoCommitActivity {\n  repo_full_name: string\n  weeks: number[]\n  week_start?: number\n}\n","numLines":301,"startLine":1,"totalLines":301}},"displayPath":"../../../entire.io/.worktrees/recap-endpoint/api/src/lib/db/checkpoints.ts"},"type":"attachment","uuid":"ad4e9963-bad6-4344-a49c-74f8a32128ed","timestamp":"2026-04-29T15:18:46.458Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"ad4e9963-bad6-4344-a49c-74f8a32128ed","isSidechain":false,"attachment":{"type":"file","filename":"/tmp/perf-check.sh","content":{"type":"text","file":{"filePath":"/tmp/perf-check.sh","content":"#!/usr/bin/env bash\n# Time /me/recap against any preview/prod URL.\n# Usage:\n#   PREVIEW=<url> bash /tmp/perf-check.sh\n#   bash /tmp/perf-check.sh <url>\n#   TOKEN=ent_... bash /tmp/perf-check.sh <url>     # bypass keychain\n#\n# Prefers a pre-set TOKEN env var. Falls back to known entire-cli keychain\n# entries if TOKEN is unset.\n\nset -u\n\nPREVIEW=\"${PREVIEW:-${1:-}}\"\nif [ -z \"$PREVIEW\" ]; then\n  echo \"usage: PREVIEW=<url> bash $0   OR   bash $0 <url>\"\n  exit 2\nfi\n\n# Preserve any pre-set TOKEN (caller's choice wins). Only consult keychain\n# when TOKEN is unset/empty.\nif [ -z \"${TOKEN:-}\" ]; then\n  RAW=\"\"\n  for ACCT in \"https://partial.to\" \"https://entire.io\" \"http://localhost:8787\"; do\n    R=\"$(security find-generic-password -s entire-cli -a \"$ACCT\" -w 2>/dev/null || true)\"\n    if [ -n \"$R\" ]; then\n      RAW=\"$R\"\n      echo \"# using keychain entry for: $ACCT\"\n      break\n    fi\n  done\n  if [ -z \"$RAW\" ]; then\n    echo \"no keychain token found and TOKEN env var unset\"\n    exit 3\n  fi\n  TOKEN=\"$(printf '%s' \"${RAW#go-keyring-base64:}\" | base64 -d)\"\nelse\n  echo \"# using TOKEN from env var (len=${#TOKEN})\"\nfi\n\nUNTIL=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"\n\nfor range in 1d 7d 30d 90d; do\n  SINCE=\"$(date -u -v-${range} +'%Y-%m-%dT%H:%M:%SZ')\"\n  echo \"=== ${range} ===\"\n  for i in 1 2 3; do\n    curl -s --max-time 30 \\\n      -H \"Authorization: Bearer ${TOKEN}\" \\\n      \"${PREVIEW}/api/v1/me/recap?repo=entirehq/entire.io&since=${SINCE}&until=${UNTIL}&limit=1000\" \\\n      -o /dev/null \\\n      -w \"  hit${i}: t=%{time_total} http=%{http_code}\\n\"\n  done\ndone\n","numLines":53,"startLine":1,"totalLines":53}},"displayPath":"../../../../../../../../../tmp/perf-check.sh"},"type":"attachment","uuid":"a4390a30-5e73-45b0-adcb-8acdffbbfb85","timestamp":"2026-04-29T15:18:46.074Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"a4390a30-5e73-45b0-adcb-8acdffbbfb85","isSidechain":false,"attachment":{"type":"file","filename":"/tmp/seed-local-token.sh","content":{"type":"text","file":{"filePath":"/tmp/seed-local-token.sh","content":"#!/usr/bin/env bash\n# Seed local Docker MySQL with the current user's token so wrangler dev's\n# bearer-auth middleware can validate against it.\n# - Uses real user_id + github_id from production so all per-user queries work.\n# - Computes SHA-256 hex of the keychain token to match middleware.ts:199.\n\nset -euo pipefail\n\nUSER_ID=\"6f65f811-6ce3-472a-9b59-30fa485acd1a\"\nGITHUB_ID=\"249787869\"\nGITHUB_LOGIN=\"peyton-alt\"\n\n# Pull the token from keychain and decode the go-keyring base64 wrapper.\nRAW=\"$(security find-generic-password -s entire-cli -a \"https://entire.io\" -w 2>/dev/null || true)\"\nif [ -z \"$RAW\" ]; then\n  echo \"no keychain token found at https://entire.io\"\n  exit 2\nfi\nTOKEN=\"$(printf '%s' \"${RAW#go-keyring-base64:}\" | base64 -d)\"\nTOKEN_HASH=\"$(printf '%s' \"$TOKEN\" | shasum -a 256 | awk '{print $1}')\"\nTOKEN_ID=\"$(uuidgen | tr '[:upper:]' '[:lower:]')\"\n\necho \"user_id:    $USER_ID\"\necho \"github_id:  $GITHUB_ID\"\necho \"token len:  ${#TOKEN}\"\necho \"token hash: ${TOKEN_HASH:0:16}…\"\necho \"token row:  $TOKEN_ID\"\n\nMYSQL_CID=\"$(docker ps -qf name=mysql)\"\nif [ -z \"$MYSQL_CID\" ]; then\n  echo \"no mysql container running — start with 'mise run api-db-start'\"\n  exit 3\nfi\n\n# Insert (or update) user + api_token rows. Idempotent: rerunning replaces\n# the prior row by primary key.\ndocker exec -i \"$MYSQL_CID\" mysql -uentire -pentire entire <<SQL\nINSERT INTO users (id, github_id, github_login, created_at)\nVALUES ('$USER_ID', $GITHUB_ID, '$GITHUB_LOGIN', NOW(3))\nON DUPLICATE KEY UPDATE github_id = VALUES(github_id), github_login = VALUES(github_login);\n\nINSERT INTO api_tokens (id, user_id, name, scope, token_hash, expires_at, created_at)\nVALUES (\n  '$TOKEN_ID',\n  '$USER_ID',\n  'local-dev seed',\n  'cli',\n  '$TOKEN_HASH',\n  DATE_ADD(NOW(3), INTERVAL 365 DAY),\n  NOW(3)\n)\nON DUPLICATE KEY UPDATE token_hash = VALUES(token_hash), expires_at = VALUES(expires_at);\n\nSELECT id, user_id, name, scope, expires_at FROM api_tokens WHERE token_hash = '$TOKEN_HASH';\nSQL\n\necho\necho \"✓ seeded. local wrangler should now accept your keychain bearer token.\"\n","numLines":59,"startLine":1,"totalLines":59}},"displayPath":"../../../../../../../../../tmp/seed-local-token.sh"},"type":"attachment","uuid":"53722e3e-36ff-4ed6-be86-cb93f9dc323c","timestamp":"2026-04-29T15:18:46.075Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"53722e3e-36ff-4ed6-be86-cb93f9dc323c","isSidechain":false,"attachment":{"type":"file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts","content":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts","content":"import { Hono } from \"hono\"\nimport { beforeEach, describe, expect, it, vi } from \"vitest\"\n\nimport type { Env, Variables } from \"../env\"\n\nvi.mock(\"../lib/middleware\", () => ({\n  requireBearerAuth: vi.fn((_c, next) => next()),\n  requireAuth: vi.fn((_c, next) => next()),\n  requireAdmin: vi.fn((_c, next) => next()),\n  optionalAuth: vi.fn((_c, next) => next()),\n  rateLimitUnauthenticated: vi.fn((_c, next) => next()),\n}))\n\nvi.mock(\"../lib/telemetry\", () => ({\n  recordSpanError: vi.fn(),\n}))\n\nconst mockGetWithCache = vi.fn()\nconst mockGetByUser = vi.fn()\nconst mockGetTeamOnUserRepos = vi.fn()\nconst mockGetByCheckpointIds = vi.fn()\n\nvi.mock(\"../lib/db\", () => ({\n  getDb: () => ({\n    users: { getWithCache: (...args: unknown[]) => mockGetWithCache(...args) },\n    checkpoints: {\n      getByUser: (...args: unknown[]) => mockGetByUser(...args),\n      getTeamOnUserRepos: (...args: unknown[]) => mockGetTeamOnUserRepos(...args),\n    },\n    analyses: {\n      getByCheckpointIds: (...args: unknown[]) => mockGetByCheckpointIds(...args),\n    },\n  }),\n}))\n\nimport { recapRoutes } from \"./recap\"\n\n// recapRoutes is mounted under /me/recap inside the parent router; in\n// production the bearer auth middleware sets userId on the context. For\n// these unit tests we mount the routes inside a wrapper that injects a\n// constant userId so the handler can run.\nfunction makeApp() {\n  const app = new Hono<{ Bindings: Env; Variables: Variables }>()\n  app.use(\"/*\", async (c, next) => {\n    c.set(\"userId\", \"user-1\")\n    await next()\n  })\n  app.route(\"/\", recapRoutes)\n  return app\n}\n\nconst mockEnv = { ENTIRE_CACHE: {} } as unknown as Env\nconst mockExecutionCtx = { waitUntil: vi.fn(), passThroughOnException: vi.fn() }\n\nfunction makeCheckpoint(overrides: Partial<Record<string, unknown>> = {}) {\n  return {\n    checkpoint_id: \"cp-1\",\n    commit_sha: \"sha-1\",\n    commit_message: \"feat: stuff\",\n    commit_date: \"2026-04-20T12:00:00Z\",\n    commit_author_github_id: 99,\n    additions: 1,\n    deletions: 0,\n    files_changed: 1,\n    repo_id: \"repo-1\",\n    repo_full_name: \"org/app\",\n    branch: \"main\",\n    is_private: false,\n    agent: \"Claude Code\",\n    steps: 1,\n    session_count: 1,\n    input_tokens: 100,\n    output_tokens: 50,\n    ...overrides,\n  }\n}\n\ndescribe(\"GET /me/recap\", () => {\n  beforeEach(() => {\n    vi.clearAllMocks()\n    mockGetWithCache.mockResolvedValue({ id: \"user-1\", github_id: 12345 })\n    mockGetByUser.mockResolvedValue([])\n    mockGetTeamOnUserRepos.mockResolvedValue([])\n    mockGetByCheckpointIds.mockResolvedValue([])\n  })\n\n  function get(path: string) {\n    return makeApp().request(path, { headers: {} }, { ...mockEnv, ...mockExecutionCtx })\n  }\n\n  it(\"returns null contributors and skips the team query when ?repo= is omitted\", async () => {\n    const res = await get(\"/\")\n\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as Record<string, unknown>\n\n    expect(body.contributors).toBeNull()\n    expect(body.repo).toBeNull()\n    expect(mockGetTeamOnUserRepos).not.toHaveBeenCalled()\n  })\n\n  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n    mockGetTeamOnUserRepos.mockResolvedValue([])\n\n    const res = await get(\"/?repo=org/app\")\n    expect(res.status).toBe(200)\n\n    expect(mockGetByUser).toHaveBeenCalledWith(\n      \"user-1\",\n      12345,\n      expect.any(String),\n      expect.any(String),\n      expect.any(Number),\n      \"org/app\",\n    )\n    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n      \"user-1\",\n      12345,\n      expect.any(String),\n      expect.any(String),\n      expect.any(Number),\n      \"org/app\",\n    )\n  })\n\n  it(\"counts distinct contributors by author id, not by commit_sha\", async () => {\n    mockGetByUser.mockResolvedValue([makeCheckpoint({ commit_author_github_id: 12345 })])\n    mockGetTeamOnUserRepos.mockResolvedValue([\n      // Author A makes two team commits — should count as ONE contributor,\n      // not two as the previous commit_sha-based count would have done.\n      makeCheckpoint({\n        checkpoint_id: \"cp-2\",\n        commit_sha: \"sha-team-a-1\",\n        commit_author_github_id: 200,\n      }),\n      makeCheckpoint({\n        checkpoint_id: \"cp-3\",\n        commit_sha: \"sha-team-a-2\",\n        commit_author_github_id: 200,\n      }),\n      makeCheckpoint({\n        checkpoint_id: \"cp-4\",\n        commit_sha: \"sha-team-b-1\",\n        commit_author_github_id: 300,\n      }),\n    ])\n\n    const res = await get(\"/?repo=org/app\")\n    const body = (await res.json()) as { contributors: { distinctUsers: number } }\n\n    // Two team authors (200, 300) plus the requesting user = 3.\n    expect(body.contributors.distinctUsers).toBe(3)\n  })\n\n  it(\"honours since/until query params over the timeframe enum\", async () => {\n    const since = \"2026-04-20T00:00:00.000Z\"\n    const until = \"2026-04-21T00:00:00.000Z\"\n\n    const res = await get(`/?since=${since}&until=${until}`)\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as { since: string; until: string }\n    expect(body.since).toBe(since)\n    expect(body.until).toBe(until)\n  })\n\n  it(\"attributes analyses to checkpoints scoped by repo_id, not just checkpoint_id\", async () => {\n    // Two repos, two checkpoints sharing the same checkpoint_id \"shared\".\n    // Each repo's analysis is unique. With the previous bug (key by\n    // checkpoint_id alone), one analysis would clobber the other.\n    mockGetByUser.mockResolvedValue([\n      makeCheckpoint({\n        repo_id: \"repo-A\",\n        checkpoint_id: \"shared\",\n        agent: \"Claude Code\",\n      }),\n      makeCheckpoint({\n        repo_id: \"repo-B\",\n        checkpoint_id: \"shared\",\n        agent: \"Codex\",\n      }),\n    ])\n    // First call (repo-A) returns labels=[bug_fix]; second (repo-B) returns\n    // labels=[refactor]. Both should land on the right agent's card.\n    mockGetByCheckpointIds.mockImplementation(async (repoId: string, _ids: string[]) => {\n      if (repoId === \"repo-A\") {\n        return [\n          {\n            checkpoint_id: \"shared\",\n            status: \"complete\",\n            analysis_json: JSON.stringify({ extraction: { labels: [\"bug_fix\"] } }),\n          },\n        ]\n      }\n      if (repoId === \"repo-B\") {\n        return [\n          {\n            checkpoint_id: \"shared\",\n            status: \"complete\",\n            analysis_json: JSON.stringify({ extraction: { labels: [\"refactor\"] } }),\n          },\n        ]\n      }\n      return []\n    })\n\n    const res = await get(\"/\")\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as {\n      agents: Record<string, { me: { labels: Array<{ label: string }> } }>\n    }\n\n    const claude = body.agents[\"Claude Code\"]\n    const codex = body.agents.Codex\n    expect(claude.me.labels.map((l) => l.label)).toEqual([\"bug_fix\"])\n    expect(codex.me.labels.map((l) => l.label)).toEqual([\"refactor\"])\n  })\n})\n","numLines":219,"startLine":1,"totalLines":219}},"displayPath":"../../../entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts"},"type":"attachment","uuid":"068241e2-3b4d-49fc-81f4-655c692b0e2c","timestamp":"2026-04-29T15:18:46.847Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
