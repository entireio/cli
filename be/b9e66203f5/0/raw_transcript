{"parentUuid":"a26f17ce-6b76-424e-80a9-136804b1e2df","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts","snippet":"1\timport { Hono } from \"hono\"\n2\timport { beforeEach, describe, expect, it, vi } from \"vitest\"\n3\t\n4\timport type { Env, Variables } from \"../env\"\n5\t\n6\tvi.mock(\"../lib/middleware\", () => ({\n7\t  requireBearerAuth: vi.fn((_c, next) => next()),\n8\t  requireAuth: vi.fn((_c, next) => next()),\n9\t  requireAdmin: vi.fn((_c, next) => next()),\n10\t  optionalAuth: vi.fn((_c, next) => next()),\n11\t  rateLimitUnauthenticated: vi.fn((_c, next) => next()),\n12\t}))\n13\t\n14\tconst mockRecordSpanError = vi.fn()\n15\tvi.mock(\"../lib/telemetry\", () => ({\n16\t  recordSpanError: (...args: unknown[]) => mockRecordSpanError(...args),\n17\t}))\n18\t\n19\tconst mockGetWithCache = vi.fn()\n20\tconst mockGetByUser = vi.fn()\n21\tconst mockGetTeamOnUserRepos = vi.fn()\n22\tconst mockGetByCheckpointIds = vi.fn()\n23\t\n24\tvi.mock(\"../lib/db\", () => ({\n25\t  getDb: () => ({\n26\t    users: { getWithCache: (...args: unknown[]) => mockGetWithCache(...args) },\n27\t    checkpoints: {\n28\t      getByUser: (...args: unknown[]) => mockGetByUser(...args),\n29\t      getTeamOnUserRepos: (...args: unknown[]) => mockGetTeamOnUserRepos(...args),\n30\t    },\n31\t    analyses: {\n32\t      getByCheckpointIds: (...args: unknown[]) => mockGetByCheckpointIds(...args),\n33\t    },\n34\t  }),\n35\t}))\n36\t\n37\timport { recapRoutes } from \"./recap\"\n38\t\n39\t// recapRoutes is mounted under /me/recap inside the parent router; in\n40\t// production the bearer auth middleware sets userId on the context. For\n41\t// these unit tests we mount the routes inside a wrapper that injects a\n42\t// constant userId so the handler can run.\n43\tfunction makeApp() {\n44\t  const app = new Hono<{ Bindings: Env; Variables: Variables }>()\n45\t  app.use(\"/*\", async (c, next) => {\n46\t    c.set(\"userId\", \"user-1\")\n47\t    await next()\n48\t  })\n49\t  app.route(\"/\", recapRoutes)\n50\t  return app\n51\t}\n52\t\n53\tconst mockEnv = { ENTIRE_CACHE: {} } as unknown as Env\n54\tconst mockExecutionCtx = { waitUntil: vi.fn(), passThroughOnException: vi.fn() }\n55\t\n56\tfunction makeCheckpoint(overrides: Partial<Record<string, unknown>> = {}) {\n57\t  return {\n58\t    checkpoint_id: \"cp-1\",\n59\t    commit_sha: \"sha-1\",\n60\t    commit_message: \"feat: stuff\",\n61\t    commit_date: \"2026-04-20T12:00:00Z\",\n62\t    commit_author_github_id: 99,\n63\t    additions: 1,\n64\t    deletions: 0,\n65\t    files_changed: 1,\n66\t    repo_id: \"repo-1\",\n67\t    repo_full_name: \"org/app\",\n68\t    branch: \"main\",\n69\t    is_private: false,\n70\t    agent: \"Claude Code\",\n71\t    steps: 1,\n72\t    session_count: 1,\n73\t    input_tokens: 100,\n74\t    output_tokens: 50,\n75\t    ...overrides,\n76\t  }\n77\t}\n78\t\n79\tdescribe(\"GET /me/recap\", () => {\n80\t  beforeEach(() => {\n81\t    vi.clearAllMocks()\n82\t    mockGetWithCache.mockResolvedValue({ id: \"user-1\", github_id: 12345 })\n83\t    mockGetByUser.mockResolvedValue([])\n84\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n85\t    mockGetByCheckpointIds.mockResolvedValue([])\n86\t  })\n87\t\n88\t  function get(path: string) {\n89\t    return makeApp().request(path, { headers: {} }, { ...mockEnv, ...mockExecutionCtx })\n90\t  }\n91\t\n92\t  it(\"returns null contributors and skips the team query when ?repo= is omitted\", async () => {\n93\t    const res = await get(\"/\")\n94\t\n95\t    expect(res.status).toBe(200)\n96\t    const body = (await res.json()) as Record<string, unknown>\n97\t\n98\t    expect(body.contributors).toBeNull()\n99\t    expect(body.repo).toBeNull()\n100\t    expect(mockGetTeamOnUserRepos).not.toHaveBeenCalled()\n101\t  })\n102\t\n103\t  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n104\t    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n105\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n106\t\n107\t    const res = await get(\"/?repo=org/app\")\n108\t    expect(res.status).toBe(200)\n109\t\n110\t    expect(mockGetByUser).toHaveBeenCalledWith(\n111\t      \"user-1\",\n112\t      12345,\n113\t      expect.any(String),\n114\t      expect.any(String),\n115\t      expect.any(Number),\n116\t      \"org/app\",\n117\t    )\n118\t    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n119\t      \"user-1\",\n120\t      12345,\n121\t      expect.any(String),\n122\t      expect.any(String),\n123\t      expect.any(Number),\n124\t      \"org/app\",\n125\t    )\n126\t  })\n127\t\n128\t  it(\"counts distinct contributors by author id, not by commit_sha\", async () => {\n129\t    mockGetByUser.mockResolvedValue([makeCheckpoint({ commit_author_github_id: 12345 })])\n130\t    mockGetTeamOnUserRepos.mockResolvedValue([\n131\t      // Author A makes two team commits — should count as ONE contributor,\n132\t      // not two as the previous commit_sha-based count would have done.\n133\t      makeCheckpoint({\n134\t        checkpoint_id: \"cp-2\",\n135\t        commit_sha: \"sha-team-a-1\",\n136\t        commit_author_github_id: 200,\n137\t      }),\n138\t      makeCheckpoint({\n139\t        checkpoint_id: \"cp-3\",\n140\t        commit_sha: \"sha-team-a-2\",\n141\t        commit_author_github_id: 200,\n142\t      }),\n143\t      makeCheckpoint({\n144\t        checkpoint_id: \"cp-4\",\n145\t        commit_sha: \"sha-team-b-1\",\n146\t        commit_author_github_id: 300,\n147\t      }),\n148\t    ])\n149\t\n150\t    const res = await get(\"/?repo=org/app\")\n151\t    const body = (await res.json()) as { contributors: { distinctUsers: number } }\n152\t\n153\t    // Two team authors (200, 300) plus the requesting user = 3.\n154\t    expect(body.contributors.distinctUsers).toBe(3)\n155\t  })\n156\t\n157\t  it(\"honours since/until query params over the timeframe enum\", async () => {\n158\t    const since = \"2026-04-20T00:00:00.000Z\"\n159\t    const until = \"2026-04-21T00:00:00.000Z\"\n160\t\n161\t    const res = await get(`/?since=${since}&until=${until}`)\n162\t    expect(res.status).toBe(200)\n163\t    const body = (await res.json()) as { since: string; until: string }\n164\t    expect(body.since).toBe(since)\n165\t    expect(body.until).toBe(until)\n166\t  })\n167\t\n168\t  it(\"attributes analyses to checkpoints scoped by repo_id, not just checkpoint_id\", async () => {\n169\t    // Two repos, two checkpoints sharing the same checkpoint_id \"shared\".\n170\t    // Each repo's analysis is unique. With the previous bug (key by\n171\t    // checkpoint_id alone), one analysis would clobber the other.\n172\t    mockGetByUser.mockResolvedValue([\n173\t      makeCheckpoint({\n174\t        repo_id: \"repo-A\",\n175\t        checkpoint_id: \"shared\",\n176\t        agent: \"Claude Code\",\n177\t      }),\n178\t      makeCheckpoint({\n179\t        repo_id: \"repo-B\",\n180\t        checkpoint_id: \"shared\",\n181\t        agent: \"Codex\",\n182\t      }),\n183\t    ])\n184\t    // First call (repo-A) returns labels=[bug_fix]; second (repo-B) returns\n185\t    // labels=[refactor]. Both should land on the right agent's card.\n186\t    mockGetByCheckpointIds.mockImplementation(async (repoId: string, _ids: string[]) => {\n187\t      if (repoId === \"repo-A\") {\n188\t        return [\n189\t          {\n190\t            checkpoint_id: \"shared\",\n191\t            status: \"complete\",\n192\t            analysis_json: JSON.stringify({ extraction: { labels: [\"bug_fix\"] } }),\n193\t          },\n194\t        ]\n195\t      }\n196\t      if (repoId === \"repo-B\") {\n197\t        return [\n198\t          {\n199\t            checkpoint_id: \"shared\",\n200\t            status: \"complete\",\n201\t            analysis_json: JSON.stringify({ extraction: { labels: [\"refactor\"] } }),\n202\t          },\n203\t        ]\n204\t      }\n205\t      return []\n206\t    })\n207\t\n208\t    const res = await get(\"/\")\n209\t    expect(res.status).toBe(200)\n210\t    const body = (await res.json()) as {\n211\t      agents: Record<string, { me: { labels: Array<{ label: string }> } }>\n212\t    }\n213\t\n214\t    const claude = body.agents[\"Claude Code\"]\n215\t    const codex = body.agents.Codex\n216\t    expect(claude.me.labels.map((l) => l.label)).toEqual([\"bug_fix\"])\n217\t    expect(codex.me.labels.map((l) => l.label)).toEqual([\"refactor\"])\n218\t  })\n219\t\n220\t  it.each([\n221\t    {\n222\t      label: \"since provided without until\",\n223\t      url: \"/?since=2026-04-20T00:00:00Z\",\n224\t      pattern: /since and until/i,\n225\t    },\n226\t    {\n227\t      label: \"unparseable since/until\",\n228\t      url: \"/?since=yesterday&until=2026-04-21T00:00:00Z\",\n229\t      pattern: /valid ISO-8601/i,\n230\t    },\n231\t    {\n232\t      label: \"since after until (inverted range)\",\n\n... [52 lines truncated] ..."},"type":"attachment","uuid":"bc47a0ac-6a3e-44c2-b45e-ee93643a4048","timestamp":"2026-04-29T17:04:59.294Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"bc47a0ac-6a3e-44c2-b45e-ee93643a4048","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/types.ts","snippet":"1\t// Database types\n2\t\n3\texport interface User {\n4\t  id: string\n5\t  github_id: number\n6\t  github_login: string | null\n7\t  github_token_enc: string | null\n8\t  github_refresh_token_enc: string | null\n9\t  github_token_expires_at: string | null\n10\t  discovery_enabled: boolean\n11\t  is_admin: boolean\n12\t  created_at: string\n13\t  repos_synced_at: string | null\n14\t  last_visited_at: string | null\n15\t}\n16\t\n17\texport interface RefreshState {\n18\t  user_id: string\n19\t  last_refreshed_at: string | null\n20\t  next_refresh_at: string | null\n21\t}\n22\t\n23\t// Session types\n24\t\n25\texport interface Session {\n26\t  userId: string\n27\t  expiresAt: number\n28\t}\n29\t\n30\t// API response types\n31\t\n32\texport interface GitHubUser {\n33\t  id: number\n34\t  login: string\n35\t  name: string | null\n36\t  avatar_url: string\n37\t  email: string | null\n38\t}\n39\t\n40\t// Cache types\n41\t\n42\texport interface CachedUser {\n43\t  id: string\n44\t  github_id: number\n45\t  github_login: string | null\n46\t  github_token_enc: string | null\n47\t  github_refresh_token_enc: string | null\n48\t  github_token_expires_at: string | null\n49\t  repos_synced_at: string | null\n50\t  cached_at: string\n51\t}\n52\t\n53\texport interface CachedFollowers {\n54\t  followers: Array<{\n55\t    login: string\n56\t    avatar_url: string\n57\t    html_url: string\n58\t  }>\n59\t  following: Array<{\n60\t    login: string\n61\t    avatar_url: string\n62\t    html_url: string\n63\t  }>\n64\t  updated_at: string\n65\t}\n66\t\n67\texport interface CachedStarred {\n68\t  starred: Array<{\n69\t    name: string\n70\t    full_name: string\n71\t    description: string | null\n72\t    html_url: string\n73\t    stargazers_count: number\n74\t    language: string | null\n75\t  }>\n76\t  updated_at: string\n77\t}\n78\t\n79\texport interface CachedWatched {\n80\t  watched: Array<{\n81\t    name: string\n82\t    full_name: string\n83\t    description: string | null\n84\t    html_url: string\n85\t  }>\n86\t  updated_at: string\n87\t}\n88\t\n89\texport interface CachedRepos {\n90\t  repos: Array<{\n91\t    name: string\n92\t    full_name: string\n93\t    description: string | null\n94\t    html_url: string\n95\t    stargazers_count: number\n96\t    language: string | null\n97\t    private: boolean\n98\t    updated_at: string\n99\t  }>\n100\t  updated_at: string\n101\t}\n102\t\n103\texport interface CachedContributions {\n104\t  total_count: number\n105\t  contributions: Array<{\n106\t    date: string\n107\t    count: number\n108\t  }>\n109\t  updated_at: string\n110\t}\n111\t\n112\texport interface CachedPRs {\n113\t  prs: Array<{\n114\t    id: number\n115\t    number: number\n116\t    title: string\n117\t    html_url: string\n118\t    state: string\n119\t    repo_full_name: string\n120\t    created_at: string\n121\t    updated_at: string\n122\t    draft: boolean\n123\t    merged_at: string | null\n124\t    body: string | null\n125\t    head_branch: string | null\n126\t    user_login: string | null\n127\t  }>\n128\t  updated_at: string\n129\t}\n130\t\n131\texport interface RepoCommitActivity {\n132\t  repo_full_name: string\n133\t  // Weekly totals for the last 52 weeks (oldest to newest)\n134\t  weeks: number[]\n135\t  // Unix timestamp of the first week (for week rollover calculation)\n136\t  week_start?: number\n137\t}\n138\t\n139\texport interface CachedCommitActivity {\n140\t  activity: RepoCommitActivity[]\n141\t  updated_at: string\n142\t}\n143\t\n144\texport interface CommitInfo {\n145\t  sha: string\n146\t  message: string\n147\t  author: string\n148\t  authorUsername: string | null\n149\t  authorId: number | null\n150\t  date: string\n151\t  url: string\n152\t}\n153\t\n154\texport interface CachedRepoCommits {\n155\t  commits: RepoCommitListItem[]\n156\t  repo_full_name: string\n157\t  updated_at: string\n158\t  app_has_access?: boolean | null\n159\t  session_branch_exists?: boolean | null\n160\t  history_status?: \"pending\" | \"syncing\" | \"complete\" | \"error\" | null\n161\t  history_complete?: boolean\n162\t  history_pages_fetched?: number\n163\t  checkpoints_v2_enabled?: boolean\n164\t}\n165\t\n166\texport interface RepoCommitListItem {\n167\t  commitSha: string\n168\t  commitMessage: string | null\n169\t  commitAuthor: string | null\n170\t  commitAuthorUsername: string | null\n171\t  commitDate: string | null\n172\t  additions: number | null\n173\t  deletions: number | null\n174\t  filesChanged: number | null\n175\t  filesTouched: string[] | null\n176\t  fileStats: FileStats[] | null\n177\t  url: string | null\n178\t  checkpoints: CheckpointInfo[]\n179\t}\n180\t\n181\texport interface SessionInfo {\n182\t  prompt: string | null\n183\t  agent: string\n184\t  model?: string\n185\t  steps: number\n186\t  // V1 fields\n187\t  sessionId?: string\n188\t  createdAt?: string\n189\t  isTask?: boolean\n190\t  toolUseId?: string\n191\t  transcriptIdentifierAtStart?: string\n192\t  checkpointTranscriptStart?: number\n193\t  summary?: SessionSummary\n194\t  // Per-session token usage\n195\t  tokenUsage?: {\n196\t    inputTokens: number\n197\t    cacheCreationTokens: number\n198\t    cacheReadTokens: number\n199\t    outputTokens: number\n200\t    apiCallCount: number\n201\t  }\n202\t  // Per-session attribution\n203\t  attribution?: {\n204\t    calculatedAt: string\n205\t    agentLines: number\n206\t    humanAdded: number\n207\t    humanModified: number\n208\t    humanRemoved: number\n209\t    totalCommitted: number\n210\t    agentPercentage: number\n211\t  }\n212\t}\n213\t\n214\t// V1 format types for parsing checkpoint data\n215\t\n216\t/** V1 root metadata (CheckpointSummary) - stored at checkpoint root */\n217\texport interface CheckpointSummary {\n218\t  checkpoint_id: string\n219\t  strategy: string\n220\t  branch?: string\n221\t  checkpoints_count: number\n222\t  files_touched: string[]\n223\t  sessions: SessionFilePaths[]\n224\t  token_usage?: TokenUsage\n225\t  /** Aggregated attribution across all sessions in this checkpoint. Present only for multi-session checkpoints. Prefer this over per-session attribution when available. */\n226\t  combined_attribution?: InitialAttribution\n227\t}\n228\t\n229\t/** Paths to session files within a checkpoint folder */\n230\texport interface SessionFilePaths {\n231\t  metadata: string\n232\t  transcript: string\n233\t  content_hash: string\n234\t  prompt: string\n235\t}\n236\t\n237\t/** Aggregated token usage metrics */\n238\texport interface TokenUsage {\n239\t  input_tokens: number\n240\t  cache_creation_tokens: number\n241\t  cache_read_tokens: number\n242\t  output_tokens: number\n243\t  api_call_count: number\n244\t}\n245\t\n246\t/** V1 session metadata (CommittedMetadata) - stored per-session */\n247\texport interface CommittedMetadata {\n248\t  checkpoint_id: string\n249\t  session_id: string\n250\t  strategy: string\n251\t  created_at: string\n252\t  branch?: string\n253\t  checkpoints_count: number\n254\t  files_touched: string[]\n255\t  agent: string\n256\t  is_task?: boolean\n257\t  tool_use_id?: string\n258\t  transcript_identifier_at_start?: string\n259\t  /** @deprecated Use checkpoint_transcript_start instead */\n260\t  transcript_lines_at_start?: number\n261\t  checkpoint_transcript_start?: number\n262\t  model?: string\n263\t  token_usage?: TokenUsage\n264\t  summary?: SessionSummary\n265\t  initial_attribution?: InitialAttribution\n266\t}\n267\t\n268\t/** Session summary from AI analysis */\n269\texport interface SessionSummary {\n270\t  intent: string\n271\t  outcome: string\n272\t  learnings: {\n273\t    repo: string[]\n274\t    code: Array<{ path: string; line: number; finding: string }>\n275\t    workflow: string[]\n276\t  }\n277\t  friction: string[]\n278\t  open_items: string[]\n279\t}\n280\t\n281\t/** Attribution metrics calculated at checkpoint time */\n282\texport interface InitialAttribution {\n283\t  calculated_at: string\n284\t  agent_lines: number\n285\t  human_added: number\n286\t  human_modified: number\n287\t  human_removed: number\n288\t  total_committed: number\n289\t  agent_percentage: number\n290\t}\n291\t\n292\t// Per-file stats for a commit\n293\texport interface FileStats {\n294\t  filename: string\n295\t  status: \"added\" | \"removed\" | \"modified\" | \"renamed\" | \"copied\" | \"changed\" | \"unchanged\"\n296\t  additions: number\n297\t  deletions: number\n298\t  patch?: string | null // Unified diff for this file\n299\t  patchTruncated?: boolean // True if patch was truncated due to size limits\n300\t}\n301\t\n302\texport interface CheckpointInfo {\n303\t  // The commit on the branch (may be null if branch push webhook hasn't arrived yet)\n304\t  commitSha: string | null\n305\t  commitMessage: string | null\n306\t  commitAuthor: string | null\n\n... [412 lines truncated] ..."},"type":"attachment","uuid":"086dfd9e-06ec-40a0-bad2-311a73bf9e6d","timestamp":"2026-04-29T17:04:59.294Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"086dfd9e-06ec-40a0-bad2-311a73bf9e6d","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/lib/planetscale/analyses.ts","snippet":"1\timport { sql, type Kysely, type Selectable } from \"kysely\"\n2\t\n3\timport type { DB, RepoCheckpointAnalyses } from \"../../../db/types\"\n4\timport type { AnalysesNamespace, AnalysisRow } from \"../db/db-types\"\n5\timport { generateId } from \"../uuid\"\n6\timport { dateToStr } from \"./row-helpers\"\n7\t\n8\tfunction mapAnalysisRow(row: Selectable<RepoCheckpointAnalyses>): AnalysisRow {\n9\t  return {\n10\t    id: row.id,\n11\t    repo_id: row.repo_id,\n12\t    checkpoint_id: row.checkpoint_id,\n13\t    status: row.status as \"pending\" | \"generating\" | \"complete\" | \"failed\",\n14\t    analysis_json: row.analysis_json\n15\t      ? typeof row.analysis_json === \"string\"\n16\t        ? row.analysis_json\n17\t        : JSON.stringify(row.analysis_json)\n18\t      : null,\n19\t    error_message: row.error_message,\n20\t    attempt_count: row.attempt_count,\n21\t    queued_at: row.queued_at.toISOString(),\n22\t    started_at: dateToStr(row.started_at),\n23\t    completed_at: dateToStr(row.completed_at),\n24\t  }\n25\t}\n26\t\n27\texport function createAnalysesNamespace(db: Kysely<DB>): AnalysesNamespace {\n28\t  return {\n29\t    async getByCheckpointId(repoId, checkpointId) {\n30\t      const row = await db\n31\t        .selectFrom(\"repo_checkpoint_analyses\")\n32\t        .selectAll()\n33\t        .where(\"repo_id\", \"=\", repoId)\n34\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n35\t        .executeTakeFirst()\n36\t\n37\t      if (!row) return null\n38\t\n39\t      return mapAnalysisRow(row)\n40\t    },\n41\t\n42\t    async getByCheckpointIds(repoId, checkpointIds) {\n43\t      if (checkpointIds.length === 0) return []\n44\t\n45\t      const rows = await db\n46\t        .selectFrom(\"repo_checkpoint_analyses\")\n47\t        .selectAll()\n48\t        .where(\"repo_id\", \"=\", repoId)\n49\t        .where(\"checkpoint_id\", \"in\", checkpointIds)\n50\t        .execute()\n51\t\n52\t      return rows.map(mapAnalysisRow)\n53\t    },\n54\t\n55\t    async upsertPending(repoId, checkpointId, queuedAt) {\n56\t      const now = new Date()\n57\t      const queuedDate = new Date(queuedAt)\n58\t      await db\n59\t        .insertInto(\"repo_checkpoint_analyses\")\n60\t        .values({\n61\t          id: generateId(),\n62\t          repo_id: repoId,\n63\t          checkpoint_id: checkpointId,\n64\t          status: \"pending\",\n65\t          queued_at: queuedDate,\n66\t          created_at: now,\n67\t          updated_at: now,\n68\t        })\n69\t        .onDuplicateKeyUpdate({\n70\t          // Skip if already complete — prevents duplicate messages from\n71\t          // triggering regeneration loops\n72\t          status: sql`CASE WHEN status = 'complete' THEN status ELSE 'pending' END`,\n73\t          queued_at: sql`CASE WHEN status = 'complete' THEN queued_at ELSE ${queuedDate} END`,\n74\t          error_message: sql`CASE WHEN status = 'complete' THEN error_message ELSE NULL END`,\n75\t          analysis_json: sql`CASE WHEN status = 'complete' THEN analysis_json ELSE NULL END`,\n76\t          started_at: sql`CASE WHEN status = 'complete' THEN started_at ELSE NULL END`,\n77\t          completed_at: sql`CASE WHEN status = 'complete' THEN completed_at ELSE NULL END`,\n78\t          updated_at: now,\n79\t        })\n80\t        .execute()\n81\t    },\n82\t\n83\t    async markGenerating(repoId, checkpointId, queuedAt) {\n84\t      const now = new Date()\n85\t      const result = await db\n86\t        .updateTable(\"repo_checkpoint_analyses\")\n87\t        .set({\n88\t          status: \"generating\",\n89\t          started_at: now,\n90\t          attempt_count: sql`attempt_count + 1`,\n91\t          updated_at: now,\n92\t        })\n93\t        .where(\"repo_id\", \"=\", repoId)\n94\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n95\t        .where(\"queued_at\", \"=\", new Date(queuedAt))\n96\t        .where(\"status\", \"in\", [\"pending\", \"failed\"])\n97\t        .executeTakeFirst()\n98\t\n99\t      return BigInt(result.numUpdatedRows) > 0n\n100\t    },\n101\t\n102\t    async markComplete(repoId, checkpointId, analysisJson, queuedAt) {\n103\t      const now = new Date()\n104\t      const result = await db\n105\t        .updateTable(\"repo_checkpoint_analyses\")\n106\t        .set({\n107\t          status: \"complete\",\n108\t          analysis_json: analysisJson,\n109\t          completed_at: now,\n110\t          error_message: null,\n111\t          updated_at: now,\n112\t        })\n113\t        .where(\"repo_id\", \"=\", repoId)\n114\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n115\t        .where(\"queued_at\", \"=\", new Date(queuedAt))\n116\t        .where(\"status\", \"=\", \"generating\")\n117\t        .executeTakeFirst()\n118\t\n119\t      return BigInt(result.numUpdatedRows) > 0n\n120\t    },\n121\t\n122\t    async markFailed(repoId, checkpointId, errorMessage, queuedAt) {\n123\t      const now = new Date()\n124\t      const result = await db\n125\t        .updateTable(\"repo_checkpoint_analyses\")\n126\t        .set({\n127\t          status: \"failed\",\n128\t          error_message: errorMessage,\n129\t          updated_at: now,\n130\t        })\n131\t        .where(\"repo_id\", \"=\", repoId)\n132\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n133\t        .where(\"queued_at\", \"=\", new Date(queuedAt))\n134\t        .where(\"status\", \"=\", \"generating\")\n135\t        .executeTakeFirst()\n136\t\n137\t      return BigInt(result.numUpdatedRows) > 0n\n138\t    },\n139\t\n140\t    async delete(repoId, checkpointId, queuedAt) {\n141\t      let query = db\n142\t        .deleteFrom(\"repo_checkpoint_analyses\")\n143\t        .where(\"repo_id\", \"=\", repoId)\n144\t        .where(\"checkpoint_id\", \"=\", checkpointId)\n145\t\n146\t      if (queuedAt) {\n147\t        // When scoped to a specific enqueue attempt, only delete if the row\n148\t        // is still pending — a fast consumer may have already moved it to\n149\t        // `generating`, in which case we must not remove it.\n150\t        query = query.where(\"queued_at\", \"=\", new Date(queuedAt)).where(\"status\", \"=\", \"pending\")\n151\t      }\n152\t\n153\t      await query.execute()\n154\t    },\n155\t  }\n156\t}"},"type":"attachment","uuid":"532fded7-b87f-48b6-8206-5361a0fc42b0","timestamp":"2026-04-29T17:04:59.294Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
