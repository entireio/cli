     \"cc.commit_sha\",\n1651\t      sql<string>`COALESCE(bc.branch, cc.branch)`.as(\"branch\"),\n1652\t      \"cp.created_at\",\n1653\t      // ROW_NUMBER() assigns 1, 2, 3... within each (repo_id, checkpoint_id) group.\n1654\t      // ORDER BY (bc.branch IS NOT NULL) DESC puts the default-branch row first (1=true, 0=false).\n1655\t      // The outer query filters WHERE rn = 1 to keep one row per checkpoint,\n1656\t      // preferring the default branch. If the checkpoint isn't on the default branch,\n1657\t      // an arbitrary branch is picked.\n1658\t      sql<number>`ROW_NUMBER() OVER (PARTITION BY cc.repo_id, cc.checkpoint_id ORDER BY (bc.branch IS NOT NULL) DESC)`.as(\n1659\t        \"rn\",\n1660\t      ),\n1661\t    ])\n1662\t    .where(\"rc.commit_author_github_id\", \"=\", githubId)\n1663\t    .where(\"cp.created_at\", \">=\", new Date(startDate))\n1664\t    .where(\"cp.created_at\", \"<=\", new Date(endDate))\n1665\t    .as(\"ranked\")\n1666\t\n1667\t  const commits = await db\n1668\t    .selectFrom(ranked)\n1669\t    .innerJoin(\"repo_commits as rc\", (join) =>\n1670\t      join\n1671\t        .onRef(\"rc.repo_id\", \"=\", \"ranked.repo_id\")\n1672\t        .onRef(\"rc.commit_sha\", \"=\", \"ranked.commit_sha\"),\n1673\t    )\n1674\t    .innerJoin(\"repos\", \"repos.id\", \"ranked.repo_id\")\n1675\t    .leftJoin(\"repo_checkpoints as cp\", (join) =>\n1676\t      join\n1677\t        .onRef(\"cp.repo_id\", \"=\", \"ranked.repo_id\")\n1678\t        .onRef(\"cp.checkpoint_id\", \"=\", \"ranked.checkpoint_id\"),\n1679\t    )\n1680\t    .select([\n1681\t      \"ranked.checkpoint_id\",\n1682\t      \"ranked.branch\",\n1683\t      \"rc.commit_sha\",\n1684\t      \"rc.commit_message\",\n1685\t      \"rc.commit_date\",\n1686\t      \"rc.additions\",\n1687\t      \"rc.deletions\",\n1688\t      \"rc.files_changed\",\n1689\t      \"ranked.repo_id\",\n1690\t      \"repos.full_name as repo_full_name\",\n1691\t      \"repos.default_branch\",\n1692\t      \"repos.is_priv