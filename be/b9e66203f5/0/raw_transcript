reBearerAuth: vi.fn((_c, next) => next()),\n  requireAuth: vi.fn((_c, next) => next()),\n  requireAdmin: vi.fn((_c, next) => next()),\n  optionalAuth: vi.fn((_c, next) => next()),\n  rateLimitUnauthenticated: vi.fn((_c, next) => next()),\n}))\n\nvi.mock(\"../lib/telemetry\", () => ({\n  recordSpanError: vi.fn(),\n}))\n\nconst mockGetWithCache = vi.fn()\nconst mockGetByUser = vi.fn()\nconst mockGetTeamOnUserRepos = vi.fn()\nconst mockGetByCheckpointIds = vi.fn()\n\nvi.mock(\"../lib/db\", () => ({\n  getDb: () => ({\n    users: { getWithCache: (...args: unknown[]) => mockGetWithCache(...args) },\n    checkpoints: {\n      getByUser: (...args: unknown[]) => mockGetByUser(...args),\n      getTeamOnUserRepos: (...args: unknown[]) => mockGetTeamOnUserRepos(...args),\n    },\n    analyses: {\n      getByCheckpointIds: (...args: unknown[]) => mockGetByCheckpointIds(...args),\n    },\n  }),\n}))\n\nimport { recapRoutes } from \"./recap\"\n\n// recapRoutes is mounted under /me/recap inside the parent router; in\n// production the bearer auth middleware sets userId on the context. For\n// these unit tests we mount the routes inside a wrapper that injects a\n// constant userId so the handler can run.\nfunction makeApp() {\n  const app = new Hono<{ Bindings: Env; Variables: Variables }>()\n  app.use(\"/*\", async (c, next) => {\n    c.set(\"userId\", \"user-1\")\n    await next()\n  })\n  app.route(\"/\", recapRoutes)\n  return app\n}\n\nconst mockEnv = { ENTIRE_CACHE: {} } as unknown as Env\nconst mockExecutionCtx = { waitUntil: vi.fn(), passThroughOnException: vi.fn() }\n\nfunction makeCheckpoint(overrides: Partial<Record<string, unknown>> = {}) {\n  return {\n    checkpoint_id: \"cp-1\",\n    commit_sha: \"sha-1\",\n    commit_message: \"feat: stuff\",\n    commit_date: \"2026-04-20T12:00:00Z\",\n    commit_author_github_id: 99,\n    additions: 1,\n    deletions: 0,\n    files_changed: 1,\n    repo_id: \"repo-1\",\n    repo_full_name: \"org/app\",\n    branch: \"main\",\n    is_private: false,\n    agent: \"Claude Code\",\n    steps: 1,\n    session_count: 1,\n    input_tokens: 100,\n    output_tokens: 50,\n    ...overrides,\n  }\n}\n\ndescribe(\"GET /me/recap\", () => {\n  beforeEach(() => {\n    vi.clearAllMocks()\n    mockGetWithCache.mockResolvedValue({ id: \"user-1\", github_id: 12345 })\n    mockGetByUser.mockResolvedValue([])\n    mockGetTeamOnUserRepos.mockResolvedValue([])\n    mockGetByCheckpointIds.mockResolvedValue([])\n  })\n\n  function get(path: string) {\n    return makeApp().request(path, { headers: {} }, { ...mockEnv, ...mockExecutionCtx })\n  }\n\n  it(\"returns null contributors and skips the team query when ?repo= is omitted\", async () => {\n    const res = await get(\"/\")\n\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as Record<string, unknown>\n\n    expect(body.contributors).toBeNull()\n    expect(body.repo).toBeNull()\n    expect(mockGetTeamOnUserRepos).not.toHaveBeenCalled()\n  })\n\n  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n    mockGetTeamOnUserRepos.mockResolvedValue([])\n\n    const res = await get(\"/?repo=org/app\")\n    expect(res.status).toBe(200)\n\n    expect(mockGetByUser).toHaveBeenCalledWith(\n      \"user-1\",\n      12345,\n      expect.any(String),\n      expect.any(String),\n      expect.any(Number),\n      \"org/app\",\n    )\n    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n      \"user-1\",\n      12345,\n      expect.any(String),\n      expect.any(String),\n      expect.any(Number),\n      \"org/app\",\n    )\n  })\n\n  it(\"counts distinct contributors by author id, not by commit_sha\", async () => {\n    mockGetByUser.mockResolvedValue([makeCheckpoint({ commit_author_github_id: 12345 })])\n    mockGetTeamOnUserRepos.mockResolvedValue([\n      // Author A makes two team commits — should count as ONE contributor,\n      // not two as the previous commit_sha-based count would have done.\n      makeCheckpoint({\n        checkpoint_id: \"cp-2\",\n        commit_sha: \"sha-team-a-1\",\n        commit_author_github_id: 200,\n      }),\n      makeCheckpoint({\n        checkpoint_id: \"cp-3\",\n        commit_sha: \"sha-team-a-2\",\n        commit_author_github_id: 200,\n      }),\n      makeCheckpoint({\n        checkpoint_id: \"cp-4\",\n        commit_sha: \"sha-team-b-1\",\n        commit_author_github_id: 300,\n      }),\n    ])\n\n    const res = await get(\"/?repo=org/app\")\n    const body = (await res.json()) as { contributors: { distinctUsers: number } }\n\n    // Two team authors (200, 300) plus the requesting user = 3.\n    expect(body.contributors.distinctUsers).toBe(3)\n  })\n\n  it(\"honours since/until query params over the timeframe enum\", async () => {\n    const since = \"2026-04-20T00:00:00.000Z\"\n    const until = \"2026-04-21T00:00:00.000Z\"\n\n    const res = await get(`/?since=${since}&until=${until}`)\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as { since: string; until: string }\n    expect(body.since).toBe(since)\n    expect(body.until).toBe(until)\n  })\n\n  it(\"attributes analyses to checkpoints scoped by repo_id, not just checkpoint_id\", async () => {\n    // Two repos, two checkpoints sharing the same checkpoint_id \"shared\".\n    // Each repo's analysis is unique. With the previous bug (key by\n    // checkpoint_id alone), one analysis would clobber the other.\n    mockGetByUser.mockResolvedValue([\n      makeCheckpoint({\n        repo_id: \"repo-A\",\n        checkpoint_id: \"shared\",\n        agent: \"Claude Code\",\n      }),\n      makeCheckpoint({\n        repo_id: \"repo-B\",\n        checkpoint_id: \"shared\",\n        agent: \"Codex\",\n      }),\n    ])\n    // First call (repo-A) returns labels=[bug_fix]; second (repo-B) returns\n    // labels=[refactor]. Both should land on the right agent's card.\n    mockGetByCheckpointIds.mockImplementation(async (repoId: string, _ids: string[]) => {\n      if (repoId === \"repo-A\") {\n        return [\n          {\n            checkpoint_id: \"shared\",\n            status: \"complete\",\n            analysis_json: JSON.stringify({ extraction: { labels: [\"bug_fix\"] } }),\n          },\n        ]\n      }\n      if (repoId === \"repo-B\") {\n        return [\n          {\n            checkpoint_id: \"shared\",\n            status: \"complete\",\n            analysis_json: JSON.stringify({ extraction: { labels: [\"refactor\"] } }),\n          },\n        ]\n      }\n      return []\n    })\n\n    const res = await get(\"/\")\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as {\n      agents: Record<string, { me: { labels: Array<{ label: string }> } }>\n    }\n\n    const claude = body.agents[\"Claude Code\"]\n    const codex = body.agents.Codex\n    expect(claude.me.labels.map((l) => l.label)).toEqual([\"bug_fix\"])\n    expect(codex.me.labels.map((l) => l.label)).toEqual([\"refactor\"])\n  })\n})\n","structuredPatch":[{"oldStart":11,"oldLines":8,"newStart":11,"newLines":9,"lines":["   rateLimitUnauthenticated: vi.fn((_c, next) => next()),"," }))"," ","+const mockRecordSpanError = vi.fn()"," vi.mock(\"../lib/telemetry\", () => ({","-  recordSpanError: vi.fn(),","+  recordSpanError: (...args: unknown[]) => mockRecordSpanError(...args),"," }))"," "," const mockGetWithCache = vi.fn()"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"28f74eaf-87bc-4677-a567-cba3067eb716","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
