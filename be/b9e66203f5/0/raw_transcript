{"parentUuid":"7c46b0ee-7e8d-4c16-949f-2cc56bb123b1","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","snippet":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n6\t//     labels + skills + mcpServers + toolMix\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo. Only populated when ?repo=org/name is supplied;\n9\t//     otherwise both per-agent contributors and the top-level contributors\n10\t//     summary are null (cross-repo team aggregation has no coherent\n11\t//     \"everyone else\" set without a single repo as the reference frame).\n12\t//\n13\t// This endpoint consolidates three CLI operations into one request:\n14\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n15\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n16\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n17\t//\n18\t// Without this endpoint the CLI has to do all three itself and attribute\n19\t// analyses to agents via the commits endpoint — a lot of round trips and\n20\t// brittle client-side joining. Centralizing on the server matches the\n21\t// pattern established by /me/activity (PR #1590).\n22\t\n23\timport type { Context } from \"hono\"\n24\timport { Hono } from \"hono\"\n25\timport { describeRoute, resolver } from \"hono-openapi\"\n26\timport { z } from \"zod\"\n27\t\n28\timport type { Env, Variables } from \"../env\"\n29\timport { getDb } from \"../lib/db\"\n30\timport type { AnalysisFacetsByAgent } from \"../lib/db/db-types\"\n31\timport { recordSpanError } from \"../lib/telemetry\"\n32\timport { parseTimeframeParams } from \"./cache\"\n33\t\n34\t// REMOVE AFTER 24h PRODUCTION SOAK along with the legacy mergeAnalysesInto\n35\t// path it gates. Toggle this off to revert to the JS aggregator without\n36\t// redeploying — kept as a fast-rollback escape hatch for the initial\n37\t// rollout. Cloudflare Workers env vars are statically configured so the\n38\t// flag should be replaced with KV-backed config if it ever needs to live\n39\t// longer than 24h.\n40\tconst USE_FACET_AGGREGATOR = true\n41\t\n42\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n43\t// me and contributors sides so the CLI renderer can treat them uniformly.\n44\tinterface AgentAggregate {\n45\t  checkpoints: number\n46\t  tokens: number\n47\t  transcriptTokens: number\n48\t  filesChanged: number\n49\t  labels: Array<{ label: string; count: number }>\n50\t  skills: Array<{ skill: string; count: number }>\n51\t  mcpServers: Array<{ name: string; count: number }>\n52\t  toolMix: {\n53\t    shell: number\n54\t    fileOps: number\n55\t    search: number\n56\t    mcp: number\n57\t    agent: number\n58\t    other: number\n59\t  }\n60\t}\n61\t\n62\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n63\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n64\t// would double-execute the middleware.\n65\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n66\t\n67\tconst errorSchema = z.object({ error: z.string() })\n68\t\n69\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n70\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n71\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n72\tconst toolMixSchema = z.object({\n73\t  shell: z.number(),\n74\t  fileOps: z.number(),\n75\t  search: z.number(),\n76\t  mcp: z.number(),\n77\t  agent: z.number(),\n78\t  other: z.number(),\n79\t})\n80\t\n81\tconst agentAggregateSchema = z.object({\n82\t  checkpoints: z.number(),\n83\t  tokens: z.number(),\n84\t  transcriptTokens: z.number(),\n85\t  filesChanged: z.number(),\n86\t  labels: z.array(labelCountSchema),\n87\t  skills: z.array(skillCountSchema),\n88\t  mcpServers: z.array(mcpCountSchema),\n89\t  toolMix: toolMixSchema,\n90\t})\n91\t\n92\tconst perAgentEntrySchema = z.object({\n93\t  me: agentAggregateSchema,\n94\t  contributors: agentAggregateSchema.nullable(),\n95\t})\n96\t\n97\tconst recapResponseSchema = z.object({\n98\t  timeframe: z.string(),\n99\t  repo: z.string().nullable(),\n100\t  since: z.string(),\n101\t  until: z.string(),\n102\t  agents: z.record(z.string(), perAgentEntrySchema),\n103\t  contributors: z\n104\t    .object({\n105\t      distinctUsers: z.number(),\n106\t      totalTokens: z.number(),\n107\t      totalCheckpoints: z.number(),\n108\t    })\n109\t    .nullable(),\n110\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n111\t  updated_at: z.string(),\n112\t})\n113\t\n114\trecapRoutes.get(\n115\t  \"/\",\n116\t  describeRoute({\n117\t    tags: [\"Me\"],\n118\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n119\t    description:\n120\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n121\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n122\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n123\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n124\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n125\t    parameters: [\n126\t      {\n127\t        name: \"timeframe\",\n128\t        in: \"query\",\n129\t        required: false,\n130\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n131\t        schema: {\n132\t          type: \"string\",\n133\t          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n134\t        },\n135\t      },\n136\t      {\n137\t        name: \"repo\",\n138\t        in: \"query\",\n139\t        required: false,\n140\t        description:\n141\t          \"Restrict me-side aggregates and enable the contributors side. \" +\n142\t          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n143\t          \"the user has checkpoints on and the contributors side is null.\",\n144\t        schema: { type: \"string\" },\n145\t      },\n146\t      {\n147\t        name: \"limit\",\n148\t        in: \"query\",\n149\t        required: false,\n150\t        description: \"Max checkpoints to consider (1-1000, default 500).\",\n151\t        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n152\t      },\n153\t      {\n154\t        name: \"since\",\n155\t        in: \"query\",\n156\t        required: false,\n157\t        description:\n158\t          \"ISO-8601 lower bound for the activity window. When provided \" +\n159\t          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n160\t          \"uses this so its --day / --week / --month ranges line up exactly \" +\n161\t          \"with the server's aggregation window.\",\n162\t        schema: { type: \"string\", format: \"date-time\" },\n163\t      },\n164\t      {\n165\t        name: \"until\",\n166\t        in: \"query\",\n167\t        required: false,\n168\t        description:\n169\t          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n170\t          \"alongside `since` to override the `timeframe` enum.\",\n171\t        schema: { type: \"string\", format: \"date-time\" },\n172\t      },\n173\t    ],\n174\t    responses: {\n175\t      200: {\n176\t        description: \"Per-agent recap aggregates\",\n177\t        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n178\t      },\n179\t      401: {\n180\t        description: \"Not authenticated\",\n181\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n182\t      },\n183\t      404: {\n184\t        description: \"User or repo not found\",\n185\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n186\t      },\n187\t      500: {\n188\t        description: \"Failed to build recap\",\n189\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n190\t      },\n191\t    },\n192\t  }),\n193\t  async (c) => {\n194\t    const userId = c.get(\"userId\") as string\n195\t    const { limit, startDate, endDate } = parseRecapWindow(c)\n196\t    const repoParam = c.req.query(\"repo\")?.trim() || null\n197\t\n198\t    try {\n199\t      const db = getDb(c.env)\n200\t      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n201\t      if (!user) return c.json({ error: \"User not found\" }, 404)\n202\t\n203\t      // Pull me-side from repo_checkpoints filtered to the user's commits.\n\n... [334 lines truncated] ..."},"type":"attachment","uuid":"efd8d333-61e9-47eb-b524-77b6a21d1b48","timestamp":"2026-04-29T10:06:53.751Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity"}
{"parentUuid":"efd8d333-61e9-47eb-b524-77b6a21d1b48","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts","snippet":"1\timport { Hono } from \"hono\"\n2\timport { beforeEach, describe, expect, it, vi } from \"vitest\"\n3\t\n4\timport type { Env, Variables } from \"../env\"\n5\t\n6\tvi.mock(\"../lib/middleware\", () => ({\n7\t  requireBearerAuth: vi.fn((_c, next) => next()),\n8\t  requireAuth: vi.fn((_c, next) => next()),\n9\t  requireAdmin: vi.fn((_c, next) => next()),\n10\t  optionalAuth: vi.fn((_c, next) => next()),\n11\t  rateLimitUnauthenticated: vi.fn((_c, next) => next()),\n12\t}))\n13\t\n14\tvi.mock(\"../lib/telemetry\", () => ({\n15\t  recordSpanError: vi.fn(),\n16\t}))\n17\t\n18\tconst mockGetWithCache = vi.fn()\n19\tconst mockGetByUser = vi.fn()\n20\tconst mockGetTeamOnUserRepos = vi.fn()\n21\tconst mockGetByCheckpointIds = vi.fn()\n22\tconst mockAggregateFacetsByAgent = vi.fn()\n23\t\n24\tvi.mock(\"../lib/db\", () => ({\n25\t  getDb: () => ({\n26\t    users: { getWithCache: (...args: unknown[]) => mockGetWithCache(...args) },\n27\t    checkpoints: {\n28\t      getByUser: (...args: unknown[]) => mockGetByUser(...args),\n29\t      getTeamOnUserRepos: (...args: unknown[]) => mockGetTeamOnUserRepos(...args),\n30\t    },\n31\t    analyses: {\n32\t      getByCheckpointIds: (...args: unknown[]) => mockGetByCheckpointIds(...args),\n33\t      aggregateFacetsByAgent: (...args: unknown[]) => mockAggregateFacetsByAgent(...args),\n34\t    },\n35\t  }),\n36\t}))\n37\t\n38\timport { recapRoutes } from \"./recap\"\n39\t\n40\t// recapRoutes is mounted under /me/recap inside the parent router; in\n41\t// production the bearer auth middleware sets userId on the context. For\n42\t// these unit tests we mount the routes inside a wrapper that injects a\n43\t// constant userId so the handler can run.\n44\tfunction makeApp() {\n45\t  const app = new Hono<{ Bindings: Env; Variables: Variables }>()\n46\t  app.use(\"/*\", async (c, next) => {\n47\t    c.set(\"userId\", \"user-1\")\n48\t    await next()\n49\t  })\n50\t  app.route(\"/\", recapRoutes)\n51\t  return app\n52\t}\n53\t\n54\tconst mockEnv = { ENTIRE_CACHE: {} } as unknown as Env\n55\tconst mockExecutionCtx = { waitUntil: vi.fn(), passThroughOnException: vi.fn() }\n56\t\n57\tfunction makeCheckpoint(overrides: Partial<Record<string, unknown>> = {}) {\n58\t  return {\n59\t    checkpoint_id: \"cp-1\",\n60\t    commit_sha: \"sha-1\",\n61\t    commit_message: \"feat: stuff\",\n62\t    commit_date: \"2026-04-20T12:00:00Z\",\n63\t    commit_author_github_id: 99,\n64\t    additions: 1,\n65\t    deletions: 0,\n66\t    files_changed: 1,\n67\t    repo_id: \"repo-1\",\n68\t    repo_full_name: \"org/app\",\n69\t    branch: \"main\",\n70\t    is_private: false,\n71\t    agent: \"Claude Code\",\n72\t    steps: 1,\n73\t    session_count: 1,\n74\t    input_tokens: 100,\n75\t    output_tokens: 50,\n76\t    ...overrides,\n77\t  }\n78\t}\n79\t\n80\tdescribe(\"GET /me/recap\", () => {\n81\t  beforeEach(() => {\n82\t    vi.clearAllMocks()\n83\t    mockGetWithCache.mockResolvedValue({ id: \"user-1\", github_id: 12345 })\n84\t    mockGetByUser.mockResolvedValue([])\n85\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n86\t    mockGetByCheckpointIds.mockResolvedValue([])\n87\t    mockAggregateFacetsByAgent.mockResolvedValue(new Map())\n88\t  })\n89\t\n90\t  function get(path: string) {\n91\t    return makeApp().request(path, { headers: {} }, { ...mockEnv, ...mockExecutionCtx })\n92\t  }\n93\t\n94\t  it(\"returns null contributors and skips the team query when ?repo= is omitted\", async () => {\n95\t    const res = await get(\"/\")\n96\t\n97\t    expect(res.status).toBe(200)\n98\t    const body = (await res.json()) as Record<string, unknown>\n99\t\n100\t    expect(body.contributors).toBeNull()\n101\t    expect(body.repo).toBeNull()\n102\t    expect(mockGetTeamOnUserRepos).not.toHaveBeenCalled()\n103\t  })\n104\t\n105\t  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n106\t    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n107\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n108\t\n109\t    const res = await get(\"/?repo=org/app\")\n110\t    expect(res.status).toBe(200)\n111\t\n112\t    expect(mockGetByUser).toHaveBeenCalledWith(\n113\t      \"user-1\",\n114\t      12345,\n115\t      expect.any(String),\n116\t      expect.any(String),\n117\t      expect.any(Number),\n118\t      \"org/app\",\n119\t    )\n120\t    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n121\t      \"user-1\",\n122\t      12345,\n123\t      expect.any(String),\n124\t      expect.any(String),\n125\t      expect.any(Number),\n126\t      \"org/app\",\n127\t    )\n128\t  })\n129\t\n130\t  it(\"counts distinct contributors by author id, not by commit_sha\", async () => {\n131\t    mockGetByUser.mockResolvedValue([makeCheckpoint({ commit_author_github_id: 12345 })])\n132\t    mockGetTeamOnUserRepos.mockResolvedValue([\n133\t      // Author A makes two team commits — should count as ONE contributor,\n134\t      // not two as the previous commit_sha-based count would have done.\n135\t      makeCheckpoint({\n136\t        checkpoint_id: \"cp-2\",\n137\t        commit_sha: \"sha-team-a-1\",\n138\t        commit_author_github_id: 200,\n139\t      }),\n140\t      makeCheckpoint({\n141\t        checkpoint_id: \"cp-3\",\n142\t        commit_sha: \"sha-team-a-2\",\n143\t        commit_author_github_id: 200,\n144\t      }),\n145\t      makeCheckpoint({\n146\t        checkpoint_id: \"cp-4\",\n147\t        commit_sha: \"sha-team-b-1\",\n148\t        commit_author_github_id: 300,\n149\t      }),\n150\t    ])\n151\t\n152\t    const res = await get(\"/?repo=org/app\")\n153\t    const body = (await res.json()) as { contributors: { distinctUsers: number } }\n154\t\n155\t    // Two team authors (200, 300) plus the requesting user = 3.\n156\t    expect(body.contributors.distinctUsers).toBe(3)\n157\t  })\n158\t\n159\t  it(\"honours since/until query params over the timeframe enum\", async () => {\n160\t    const since = \"2026-04-20T00:00:00.000Z\"\n161\t    const until = \"2026-04-21T00:00:00.000Z\"\n162\t\n163\t    const res = await get(`/?since=${since}&until=${until}`)\n164\t    expect(res.status).toBe(200)\n165\t    const body = (await res.json()) as { since: string; until: string }\n166\t    expect(body.since).toBe(since)\n167\t    expect(body.until).toBe(until)\n168\t  })\n169\t\n170\t  it(\"passes (repo_id, checkpoint_id, agent) triple to aggregator and applies result per-agent\", async () => {\n171\t    // Originally written to catch a bug where analysesById was keyed only\n172\t    // by checkpoint_id, causing cross-repo leakage in the JS-side merge.\n173\t    // With the SQL aggregator the route hands the full triple to\n174\t    // aggregateFacetsByAgent and applies the result verbatim — that\n175\t    // contract is what's pinned here. The original cross-repo regression\n176\t    // is now structurally impossible without the SQL aggregator itself\n177\t    // being broken (covered by the aggregator's own tests).\n178\t    mockGetByUser.mockResolvedValue([\n179\t      makeCheckpoint({\n180\t        repo_id: \"repo-A\",\n181\t        checkpoint_id: \"shared\",\n182\t        agent: \"Claude Code\",\n183\t      }),\n184\t      makeCheckpoint({\n185\t        repo_id: \"repo-B\",\n186\t        checkpoint_id: \"shared\",\n187\t        agent: \"Codex\",\n188\t      }),\n189\t    ])\n190\t    // Under the SQL facet aggregator the (repo_id, checkpoint_id) scoping is\n191\t    // enforced server-side: the route hands the full (repo_id, checkpoint_id,\n192\t    // agent) triple to aggregateFacetsByAgent and trusts the resulting\n193\t    // per-agent map verbatim. Mock that map directly here.\n194\t    mockAggregateFacetsByAgent.mockResolvedValue(\n195\t      new Map([\n196\t        [\n197\t          \"