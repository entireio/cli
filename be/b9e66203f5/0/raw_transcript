data.get(\"agents\") or {}).items():\n        team = (agent or {}).get(\"contributors\") or {}\n        labels = sorted(\n            [{\"label\": l[\"label\"], \"count\": l[\"count\"]} for l in team.get(\"labels\") or []],\n            key=lambda x: -x[\"count\"],\n        )\n        skills = sorted(\n            [{\"skill\": s[\"skill\"], \"count\": s[\"count\"]} for s in team.get(\"skills\") or []],\n            key=lambda x: -x[\"count\"],\n        )\n        out[name] = {\n            \"checkpoints\": team.get(\"checkpoints\"),\n            \"labels_top5\": [l[\"label\"] for l in labels[:5]],\n            \"labels_full\": {l[\"label\"]: l[\"count\"] for l in labels},\n            \"skills_top5\": [s[\"skill\"] for s in skills[:5]],\n            \"skills_full\": {s[\"skill\"]: s[\"count\"] for s in skills},\n            \"toolMix\": team.get(\"toolMix\") or {},\n        }\n    return out\n\n\ndef jaccard(a: list[str], b: list[str]) -> float:\n    sa, sb = set(a), set(b)\n    if not sa and not sb:\n        return 1.0\n    return len(sa & sb) / len(sa | sb)\n\n\ndef normalize_toolmix(mix: dict) -> dict:\n    total = sum(mix.values()) or 1\n    return {k: v / total for k, v in mix.items()}\n\n\ndef toolmix_mad(mix_a: dict, mix_b: dict) -> float:\n    \"\"\"Mean absolute deviation between two normalized toolmix dicts.\"\"\"\n    na, nb = normalize_toolmix(mix_a), normalize_toolmix(mix_b)\n    keys = set(na.keys()) | set(nb.keys())\n    if not keys:\n        return 0.0\n    return sum(abs(na.get(k, 0) - nb.get(k, 0)) for k in keys) / len(keys)\n\n\ndef main():\n    repo = sys.argv[1] if len(sys.argv) > 1 else \"entirehq/entire.io\"\n    days = int(sys.argv[2]) if len(sys.argv) > 2 else 30\n\n    token = auth_token()\n    until = datetime.now(timezone.utc)\n    since = until - timedelta(days=days)\n    until_s = until.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    since_s = since.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    print(f\"=== repo={repo} window={days}d ===\")\n    sampled = hit(token, repo, since_s, until_s, 200)\n    full = hit(token, repo, since_s, until_s, 1000)\n    print(f\"  limit=200:  {sampled['elapsed']:.2f}s\")\n    print(f\"  limit=1000: {full['elapsed']:.2f}s\")\n    print()\n\n    sa = per_agent_qualitative(sampled[\"data\"])\n    fa = per_agent_qualitative(full[\"data\"])\n\n    agents = sorted(set(sa.keys()) | set(fa.keys()))\n    print(f\"=== qualitative divergence per agent (team side) ===\")\n    print(f\"{'agent':<22}{'lbl-jacc':>10}{'skl-jacc':>10}{'mix-mad':>10}{'cp200':>8}{'cp1k':>8}\")\n    print(\"-\" * 68)\n    fails = 0\n    for name in agents:\n        s = sa.get(name) or {}\n        f = fa.get(name) or {}\n        if not s and not f:\n            continue\n        lbl_j = jaccard(s.get(\"labels_top5\") or [], f.get(\"labels_top5\") or [])\n        skl_j = jaccard(s.get(\"skills_top5\") or [], f.get(\"skills_top5\") or [])\n        mix_mad = toolmix_mad(s.get(\"toolMix\") or {}, f.get(\"toolMix\") or {})\n        flag = \"\"\n        if lbl_j < 0.6 or skl_j < 0.6 or mix_mad > 0.10:\n            flag = \"  ← diverge\"\n            fails += 1\n        print(f\"{name[:22]:<22}{lbl_j:>10.2f}{skl_j:>10.2f}{mix_mad:>10.3f}\"\n              f\"{(s.get('checkpoints') or 0):>8}{(f.get('checkpoints') or 0):>8}{flag}\")\n    print()\n    print(f\"=== verdict ===\")\n    print(f\"  agents diverging: {fails}/{len([a for a in agents if (sa.get(a) or fa.get(a))])}\")\n    print(f\"  threshold: jaccard<0.6 (top-5 label/skill set similarity) OR toolmix MAD>0.10\")\n    print(f\"  → {'SAMPLING SAFE' if fails == 0 else 'SAMPLING REGRESSES — consider denormalized labels (Variant 3)'}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"097d2a85-bc22-4227-b84c-6acaae060beb","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c