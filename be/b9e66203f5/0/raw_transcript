{"parentUuid":"a7bc2c1b-603c-4414-88df-da9241023a67","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/scripts/backfill-analysis-facets.ts","snippet":"1\t#!/usr/bin/env tsx\n2\t/**\n3\t * Backfill repo_checkpoint_analysis_{labels,skills,tool_mix} from existing\n4\t * repo_checkpoint_analyses.analysis_json rows. Idempotent — safe to re-run\n5\t * after partial completion.\n6\t *\n7\t * Usage: pnpm exec tsx scripts/backfill-analysis-facets.ts [--limit=N] [--dry-run]\n8\t *\n9\t * Environment:\n10\t *   DATABASE_URL  MySQL connection string (defaults to local Docker MySQL)\n11\t */\n12\t\n13\timport { Kysely, MysqlDialect } from \"kysely\"\n14\timport { createPool } from \"mysql2\"\n15\t\n16\timport type { DB } from \"../db/types\"\n17\timport type { AnalysesNamespace } from \"../src/lib/db/db-types\"\n18\timport { createAnalysesNamespace } from \"../src/lib/planetscale/analyses\"\n19\t\n20\tconst BATCH_SIZE = 500\n21\tconst SKIP_RATIO_THRESHOLD = 0.01\n22\t\n23\texport interface AnalysisJsonShape {\n24\t  extraction?: { labels?: string[] }\n25\t  skillsUsed?: string[]\n26\t  mcpServersUsed?: Array<{ name: string; count?: number }>\n27\t  toolProfile?: { categories?: Record<string, { count?: number } | null> }\n28\t  total_transcript_tokens?: number\n29\t  totalFilesChanged?: number\n30\t}\n31\t\n32\texport interface BackfillOptions {\n33\t  max: number\n34\t  dryRun: boolean\n35\t}\n36\t\n37\texport interface BackfillResult {\n38\t  processed: number\n39\t  skipped: number\n40\t  wouldUpsert: number\n41\t}\n42\t\n43\tinterface BackfillDeps {\n44\t  db: Kysely<DB>\n45\t  analyses: Pick<AnalysesNamespace, \"persistAnalysisAggregates\">\n46\t}\n47\t\n48\tfunction createDb(): Kysely<DB> {\n49\t  const url = process.env.DATABASE_URL ?? \"REDACTED\"\n50\t  const parsed = new URL(url)\n51\t  const isLocalhost = parsed.hostname === \"localhost\" || parsed.hostname === \"127.0.0.1\"\n52\t\n53\t  return new Kysely<DB>({\n54\t    dialect: new MysqlDialect({\n55\t      pool: createPool({\n56\t        host: parsed.hostname,\n57\t        port: Number(parsed.port) || 3306,\n58\t        user: decodeURIComponent(parsed.username),\n59\t        password: decodeURIComponent(parsed.password),\n60\t        database: parsed.pathname.replace(\"/\", \"\"),\n61\t        ssl: isLocalhost ? undefined : { rejectUnauthorized: true },\n62\t      }),\n63\t    }),\n64\t  })\n65\t}\n66\t\n67\t// extractFacetsFromAnalysis derives the four facet arrays + two scalars\n68\t// the SQL aggregator reads at recap time. Pulled out of the loop body\n69\t// so unit tests can pin the count/filter semantics without spinning up\n70\t// a database.\n71\texport function extractFacetsFromAnalysis(analysis: AnalysisJsonShape): {\n72\t  labels: Array<{ name: string; count: number }>\n73\t  skills: Array<{ name: string; count: number }>\n74\t  toolMix: Array<{ name: string; count: number }>\n75\t  mcpServers: Array<{ name: string; count: number }>\n76\t  transcriptTokens: number\n77\t  filesChanged: number\n78\t} {\n79\t  return {\n80\t    labels: countOccurrences(analysis.extraction?.labels ?? []),\n81\t    skills: countOccurrences(analysis.skillsUsed ?? []),\n82\t    toolMix: extractToolMix(analysis),\n83\t    // mcpServersUsed in the analysis JSON is already {name, count}-shaped\n84\t    // (extractToolMetrics in analysis-queue.ts produces it that way).\n85\t    // Filter zero/negative counts so the backfill never plants dead rows.\n86\t    mcpServers: (analysis.mcpServersUsed ?? [])\n87\t      .filter((m) => (m.count ?? 0) > 0)\n88\t      .map((m) => ({ name: m.name, count: m.count ?? 0 })),\n89\t    transcriptTokens: analysis.total_transcript_tokens ?? 0,\n90\t    filesChanged: analysis.totalFilesChanged ?? 0,\n91\t  }\n92\t}\n93\t\n94\t// runBackfill is the testable core of the script: it walks pages of\n95\t// analysis rows and either writes facet aggregates (real run) or just\n96\t// counts what would be written (dry run). Everything bootstrappy\n97\t// (process.argv parsing, DB connection, exit codes) lives in main()\n98\t// so this function is mock-driveable.\n99\texport async function runBackfill(\n100\t  deps: BackfillDeps,\n101\t  options: BackfillOptions,\n102\t): Promise<BackfillResult> {\n103\t  const { db, analyses } = deps\n104\t  const { max, dryRun } = options\n105\t\n106\t  let cursor: { repo_id: string; checkpoint_id: string } | null = null\n107\t  let processed = 0\n108\t  let skipped = 0\n109\t  let wouldUpsert = 0\n110\t\n111\t  while (processed < max) {\n112\t    let q = db\n113\t      .selectFrom(\"repo_checkpoint_analyses\")\n114\t      .select([\"repo_id\", \"checkpoint_id\", \"analysis_json\"])\n115\t      .where(\"status\", \"=\", \"complete\")\n116\t      .where(\"analysis_json\", \"is not\", null)\n117\t      .orderBy(\"repo_id\")\n118\t      .orderBy(\"checkpoint_id\")\n119\t      .limit(BATCH_SIZE)\n120\t\n121\t    if (cursor) {\n122\t      const c = cursor\n123\t      q = q.where(({ eb, or, and }) =>\n124\t        or([\n125\t          eb(\"repo_id\", \">\", c.repo_id),\n126\t          and([eb(\"repo_id\", \"=\", c.repo_id), eb(\"checkpoint_id\", \">\", c.checkpoint_id)]),\n127\t        ]),\n128\t      )\n129\t    }\n130\t\n131\t    const batch = await q.execute()\n132\t    if (batch.length === 0) break\n133\t\n134\t    for (const row of batch) {\n135\t      // Parse analysis_json. Only SyntaxError is the expected\n136\t      // \"skip-and-continue\" case — all other errors (DB errors, schema\n137\t      // mismatches, infrastructure flaps) MUST propagate so a flap during\n138\t      // backfill doesn't silently leave thousands of rows un-denormalized\n139\t      // while the script reports \"done\".\n140\t      let analysis: AnalysisJsonShape\n141\t      try {\n142\t        analysis =\n143\t          typeof row.analysis_json === \"string\"\n144\t            ? (JSON.parse(row.analysis_json) as AnalysisJsonShape)\n145\t            : (row.analysis_json as AnalysisJsonShape)\n146\t      } catch (err) {\n147\t        if (err instanceof SyntaxError) {\n148\t          skipped++\n149\t          console.warn(`skip repo=${row.repo_id} cp=${row.checkpoint_id}: ${err.message}`)\n150\t          processed++\n151\t          continue\n152\t        }\n153\t        throw err\n154\t      }\n155\t\n156\t      const facets = extractFacetsFromAnalysis(analysis)\n157\t\n158\t      if (dryRun) {\n159\t        wouldUpsert++\n160\t      } else {\n161\t        // Single transaction matching the worker's write path so a partial\n162\t        // failure can't leave fresh facets next to stale 0 scalars.\n163\t        await analyses.persistAnalysisAggregates(\n164\t          row.repo_id,\n165\t          row.checkpoint_id,\n166\t          facets.labels,\n167\t          facets.skills,\n168\t          facets.toolMix,\n169\t          facets.mcpServers,\n170\t          facets.transcriptTokens,\n171\t          facets.filesChanged,\n172\t        )\n173\t      }\n174\t      // Drives the `processed < max` loop guard regardless of dry-run vs\n175\t      // write — without this, --dry-run silently ignored --limit because\n176\t      // only `wouldUpsert` was incremented in the dry-run branch.\n177\t      processed++\n178\t    }\n179\t\n180\t    cursor = {\n181\t      repo_id: batch[batch.length - 1]!.repo_id,\n182\t      checkpoint_id: batch[batch.length - 1]!.checkpoint_id,\n183\t    }\n184\t    if (dryRun) {\n185\t      console.log(\n186\t        `would-upsert=${wouldUpsert} skipped=${skipped} cursor=${cursor.repo_id}/${cursor.checkpoint_id}`,\n187\t      )\n188\t    } else {\n189\t      console.log(\n190\t        `processed=${processed} skipped=${skipped} cursor=${cursor.repo_id}/${cursor.checkpoint_id}`,\n191\t      )\n192\t    }\n193\t  }\n194\t\n195\t  return { processed, skipped, wouldUpsert }\n196\t}\n197\t\n198\tasync function main(): Promise<void> {\n199\t  const db = createDb()\n200\t  const analyses = createAnalysesNamespace(db)\n201\t\n202\t  const limitFlag = process.argv.find((a) => a.startsWith(\"--limit=\"))?.split(\"=\")[1]\n203\t  const max = limitFlag ? parseInt(limitFlag, 10) : Infinity\n204\t  const dryRun = process.argv.includes(\"--dry-run\")\n205\t\n206\t  const { processed, skipped, wouldUpsert } = await runBackfill({ db, analyses }, { max, dryRun })\n207\t\n208\t  // High skip ratios (>1%) signal something other than an isolated row\n209\t  // with bad JSON — a producer schema regression or a systemic problem\n210\t  // worth alerting on. Exit non-zero so an operator notices instead of\n211\t  // assuming a clean run.\n212\t  const skipRatio = processed > 0 ? skipped / processed : 0\n213\t  if (dryRun) {\n214\t    console.log(`done (dry-run). would_upsert=${wouldUpsert} skipped=${skipped}`)\n215\t  } else {\n\n... [42 lines truncated] ..."},"type":"attachment","uuid":"f5af5abc-e76d-4c8f-a54c-01906f062401","timestamp":"2026-04-30T09:00:26.265Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"f5af5abc-e76d-4c8f-a54c-01906f062401","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/scripts/backfill-analysis-facets.test.ts","snippet":"1\timport type { Kysely } from \"kysely\"\n2\timport { describe, expect, it, vi } from \"vitest\"\n3\t\n4\timport type { DB } from \"../db/types\"\n5\timport type { AnalysesNamespace } from \"../src/lib/db/db-types\"\n6\timport {\n7\t  countOccurrences,\n8\t  extractFacetsFromAnalysis,\n9\t  extractToolMix,\n10\t  runBackfill,\n11\t} from \"./backfill-analysis-facets\"\n12\t\n13\t// Build a fake Kysely DB whose select chain ends with `.execute()` returning\n14\t// the supplied batches in order. The backfill script only uses selectFrom +\n15\t// select + where + orderBy + limit + execute, so we don't need a full Kysely.\n16\tfunction makeMockDb(\n17\t  batches: Array<\n18\t    Array<{\n19\t      repo_id: string\n20\t      checkpoint_id: string\n21\t      analysis_json: string\n22\t    }>\n23\t  >,\n24\t): { db: Kysely<DB>; executeMock: ReturnType<typeof vi.fn> } {\n25\t  const executeMock = vi.fn()\n26\t  for (const batch of batches) executeMock.mockResolvedValueOnce(batch)\n27\t  // Backfill keeps paging until execute() returns an empty array.\n28\t  executeMock.mockResolvedValue([])\n29\t\n30\t  const chain = {\n31\t    selectFrom: vi.fn().mockReturnThis(),\n32\t    select: vi.fn().mockReturnThis(),\n33\t    where: vi.fn().mockReturnThis(),\n34\t    orderBy: vi.fn().mockReturnThis(),\n35\t    limit: vi.fn().mockReturnThis(),\n36\t    execute: executeMock,\n37\t  }\n38\t  return { db: chain as unknown as Kysely<DB>, executeMock }\n39\t}\n40\t\n41\tfunction makeAnalysesStub(): {\n42\t  analyses: Pick<AnalysesNamespace, \"persistAnalysisAggregates\">\n43\t  persist: ReturnType<typeof vi.fn>\n44\t} {\n45\t  const persist = vi.fn().mockResolvedValue(undefined)\n46\t  return {\n47\t    analyses: {\n48\t      persistAnalysisAggregates:\n49\t        persist as unknown as AnalysesNamespace[\"persistAnalysisAggregates\"],\n50\t    },\n51\t    persist,\n52\t  }\n53\t}\n54\t\n55\tconst FULL_ANALYSIS_JSON = JSON.stringify({\n56\t  extraction: { labels: [\"bug_fix\", \"bug_fix\", \"refactor\"] },\n57\t  skillsUsed: [\"debugging\"],\n58\t  mcpServersUsed: [\n59\t    { name: \"github\", count: 3 },\n60\t    { name: \"linear\", count: 0 }, // filtered out\n61\t  ],\n62\t  toolProfile: {\n63\t    categories: {\n64\t      shell: { count: 5 },\n65\t      fileOps: { count: 10 },\n66\t      search: { count: 0 },\n67\t      mcp: { count: 3 },\n68\t      agent: { count: 0 },\n69\t      other: { count: 2 },\n70\t    },\n71\t  },\n72\t  total_transcript_tokens: 1234,\n73\t  totalFilesChanged: 7,\n74\t})\n75\t\n76\tdescribe(\"countOccurrences\", () => {\n77\t  it(\"collapses duplicates into name+count rows\", () => {\n78\t    expect(countOccurrences([\"a\", \"a\", \"b\"])).toEqual([\n79\t      { name: \"a\", count: 2 },\n80\t      { name: \"b\", count: 1 },\n81\t    ])\n82\t  })\n83\t\n84\t  it(\"returns an empty array for empty input\", () => {\n85\t    expect(countOccurrences([])).toEqual([])\n86\t  })\n87\t})\n88\t\n89\tdescribe(\"extractToolMix\", () => {\n90\t  it(\"filters out zero-count categories\", () => {\n91\t    const out = extractToolMix({\n92\t      toolProfile: {\n93\t        categories: {\n94\t          shell: { count: 5 },\n95\t          fileOps: { count: 0 },\n96\t          other: null,\n97\t        },\n98\t      },\n99\t    })\n100\t    expect(out).toEqual([{ name: \"shell\", count: 5 }])\n101\t  })\n102\t\n103\t  it(\"returns [] when toolProfile is missing\", () => {\n104\t    expect(extractToolMix({})).toEqual([])\n105\t  })\n106\t})\n107\t\n108\tdescribe(\"extractFacetsFromAnalysis\", () => {\n109\t  it(\"derives all four facet arrays + scalars from a fully-shaped analysis\", () => {\n110\t    const facets = extractFacetsFromAnalysis(JSON.parse(FULL_ANALYSIS_JSON))