{"parentUuid":"ae38c473-2f27-4306-b6c2-9166f794b48d","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","snippet":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n6\t//     labels + skills + mcpServers + toolMix\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo. Only populated when ?repo=org/name is supplied;\n9\t//     otherwise both per-agent contributors and the top-level contributors\n10\t//     summary are null (cross-repo team aggregation has no coherent\n11\t//     \"everyone else\" set without a single repo as the reference frame).\n12\t//\n13\t// This endpoint consolidates three CLI operations into one request:\n14\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n15\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n16\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n17\t//\n18\t// Without this endpoint the CLI has to do all three itself and attribute\n19\t// analyses to agents via the commits endpoint — a lot of round trips and\n20\t// brittle client-side joining. Centralizing on the server matches the\n21\t// pattern established by /me/activity (PR #1590).\n22\t\n23\timport type { Context } from \"hono\"\n24\timport { Hono } from \"hono\"\n25\timport { describeRoute, resolver } from \"hono-openapi\"\n26\timport { z } from \"zod\"\n27\t\n28\timport type { Env, Variables } from \"../env\"\n29\timport { getDb } from \"../lib/db\"\n30\timport type { AnalysisFacetsByAgent } from \"../lib/db/db-types\"\n31\timport { recordSpanError } from \"../lib/telemetry\"\n32\timport { parseTimeframeParams } from \"./cache\"\n33\t\n34\t// REMOVE AFTER 24h PRODUCTION SOAK along with the legacy mergeAnalysesInto\n35\t// path it gates. Toggle this off to revert to the JS aggregator without\n36\t// redeploying — kept as a fast-rollback escape hatch for the initial\n37\t// rollout. Cloudflare Workers env vars are statically configured so the\n38\t// flag should be replaced with KV-backed config if it ever needs to live\n39\t// longer than 24h.\n40\tconst USE_FACET_AGGREGATOR = true\n41\t\n42\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n43\t// me and contributors sides so the CLI renderer can treat them uniformly.\n44\tinterface AgentAggregate {\n45\t  checkpoints: number\n46\t  tokens: number\n47\t  transcriptTokens: number\n48\t  filesChanged: number\n49\t  labels: Array<{ label: string; count: number }>\n50\t  skills: Array<{ skill: string; count: number }>\n51\t  mcpServers: Array<{ name: string; count: number }>\n52\t  toolMix: {\n53\t    shell: number\n54\t    fileOps: number\n55\t    search: number\n56\t    mcp: number\n57\t    agent: number\n58\t    other: number\n59\t  }\n60\t}\n61\t\n62\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n63\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n64\t// would double-execute the middleware.\n65\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n66\t\n67\tconst errorSchema = z.object({ error: z.string() })\n68\t\n69\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n70\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n71\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n72\tconst toolMixSchema = z.object({\n73\t  shell: z.number(),\n74\t  fileOps: z.number(),\n75\t  search: z.number(),\n76\t  mcp: z.number(),\n77\t  agent: z.number(),\n78\t  other: z.number(),\n79\t})\n80\t\n81\tconst agentAggregateSchema = z.object({\n82\t  checkpoints: z.number(),\n83\t  tokens: z.number(),\n84\t  transcriptTokens: z.number(),\n85\t  filesChanged: z.number(),\n86\t  labels: z.array(labelCountSchema),\n87\t  skills: z.array(skillCountSchema),\n88\t  mcpServers: z.array(mcpCountSchema),\n89\t  toolMix: toolMixSchema,\n90\t})\n91\t\n92\tconst perAgentEntrySchema = z.object({\n93\t  me: agentAggregateSchema,\n94\t  contributors: agentAggregateSchema.nullable(),\n95\t})\n96\t\n97\tconst recapResponseSchema = z.object({\n98\t  timeframe: z.string(),\n99\t  repo: z.string().nullable(),\n100\t  since: z.string(),\n101\t  until: z.string(),\n102\t  agents: z.record(z.string(), perAgentEntrySchema),\n103\t  contributors: z\n104\t    .object({\n105\t      distinctUsers: z.number(),\n106\t      totalTokens: z.number(),\n107\t      totalCheckpoints: z.number(),\n108\t    })\n109\t    .nullable(),\n110\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n111\t  updated_at: z.string(),\n112\t})\n113\t\n114\trecapRoutes.get(\n115\t  \"/\",\n116\t  describeRoute({\n117\t    tags: [\"Me\"],\n118\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n119\t    description:\n120\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n121\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n122\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n123\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n124\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n125\t    parameters: [\n126\t      {\n127\t        name: \"timeframe\",\n128\t        in: \"query\",\n129\t        required: false,\n130\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n131\t        schema: {\n132\t          type: \"string\",\n133\t          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n134\t        },\n135\t      },\n136\t      {\n137\t        name: \"repo\",\n138\t        in: \"query\",\n139\t        required: false,\n140\t        description:\n141\t          \"Restrict me-side aggregates and enable the contributors side. \" +\n142\t          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n143\t          \"the user has checkpoints on and the contributors side is null.\",\n144\t        schema: { type: \"string\" },\n145\t      },\n146\t      {\n147\t        name: \"limit\",\n148\t        in: \"query\",\n149\t        required: false,\n150\t        description: \"Max checkpoints to consider (1-1000, default 500).\",\n151\t        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n152\t      },\n153\t      {\n154\t        name: \"since\",\n155\t        in: \"query\",\n156\t        required: false,\n157\t        description:\n158\t          \"ISO-8601 lower bound for the activity window. When provided \" +\n159\t          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n160\t          \"uses this so its --day / --week / --month ranges line up exactly \" +\n161\t          \"with the server's aggregation window.\",\n162\t        schema: { type: \"string\", format: \"date-time\" },\n163\t      },\n164\t      {\n165\t        name: \"until\",\n166\t        in: \"query\",\n167\t        required: false,\n168\t        description:\n169\t          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n170\t          \"alongside `since` to override the `timeframe` enum.\",\n171\t        schema: { type: \"string\", format: \"date-time\" },\n172\t      },\n173\t    ],\n174\t    responses: {\n175\t      200: {\n176\t        description: \"Per-agent recap aggregates\",\n177\t        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n178\t      },\n179\t      400: {\n180\t        description:\n181\t          \"Invalid since/until (must be supplied together as ISO-8601, with since <= until)\",\n182\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n183\t      },\n184\t      401: {\n185\t        description: \"Not authenticated\",\n186\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n187\t      },\n188\t      404: {\n189\t        description: \"Authenticated user record not found\",\n190\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n191\t      },\n192\t      500: {\n193\t        description: \"Failed to build recap\",\n194\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n195\t      },\n196\t    },\n197\t  }),\n198\t  async (c) => {\n199\t    const userId = c.get(\"userId\") as string\n200\t    const window = parseRecapWindow(c)\n201\t    if (!window.ok) {\n202\t      return c.json({ error: window.error }, 400)\n203\t    }\n204\t    const { limit, startDate, endDate } = window\n\n... [378 lines truncated] ..."},"type":"attachment","uuid":"4069d6fa-de81-4fa6-9b90-ba627fa513f6","timestamp":"2026-04-29T15:45:45.557Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
{"parentUuid":"4069d6fa-de81-4fa6-9b90-ba627fa513f6","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.test.ts","snippet":"1\timport { Hono } from \"hono\"\n2\timport { beforeEach, describe, expect, it, vi } from \"vitest\"\n3\t\n4\timport type { Env, Variables } from \"../env\"\n5\t\n6\tvi.mock(\"../lib/middleware\", () => ({\n7\t  requireBearerAuth: vi.fn((_c, next) => next()),\n8\t  requireAuth: vi.fn((_c, next) => next()),\n9\t  requireAdmin: vi.fn((_c, next) => next()),\n10\t  optionalAuth: vi.fn((_c, next) => next()),\n11\t  rateLimitUnauthenticated: vi.fn((_c, next) => next()),\n12\t}))\n13\t\n14\tconst mockRecordSpanError = vi.fn()\n15\tvi.mock(\"../lib/telemetry\", () => ({\n16\t  recordSpanError: (...args: unknown[]) => mockRecordSpanError(...args),\n17\t}))\n18\t\n19\tconst mockGetWithCache = vi.fn()\n20\tconst mockGetByUser = vi.fn()\n21\tconst mockGetTeamOnUserRepos = vi.fn()\n22\tconst mockGetByCheckpointIds = vi.fn()\n23\tconst mockAggregateFacetsByAgent = vi.fn()\n24\t\n25\tvi.mock(\"../lib/db\", () => ({\n26\t  getDb: () => ({\n27\t    users: { getWithCache: (...args: unknown[]) => mockGetWithCache(...args) },\n28\t    checkpoints: {\n29\t      getByUser: (...args: unknown[]) => mockGetByUser(...args),\n30\t      getTeamOnUserRepos: (...args: unknown[]) => mockGetTeamOnUserRepos(...args),\n31\t    },\n32\t    analyses: {\n33\t      getByCheckpointIds: (...args: unknown[]) => mockGetByCheckpointIds(...args),\n34\t      aggregateFacetsByAgent: (...args: unknown[]) => mockAggregateFacetsByAgent(...args),\n35\t    },\n36\t  }),\n37\t}))\n38\t\n39\timport { recapRoutes } from \"./recap\"\n40\t\n41\t// recapRoutes is mounted under /me/recap inside the parent router; in\n42\t// production the bearer auth middleware sets userId on the context. For\n43\t// these unit tests we mount the routes inside a wrapper that injects a\n44\t// constant userId so the handler can run.\n45\tfunction makeApp() {\n46\t  const app = new Hono<{ Bindings: Env; Variables: Variables }>()\n47\t  app.use(\"/*\", async (c, next) => {\n48\t    c.set(\"userId\", \"user-1\")\n49\t    await next()\n50\t  })\n51\t  app.route(\"/\", recapRoutes)\n52\t  return app\n53\t}\n54\t\n55\tconst mockEnv = { ENTIRE_CACHE: {} } as unknown as Env\n56\tconst mockExecutionCtx = { waitUntil: vi.fn(), passThroughOnException: vi.fn() }\n57\t\n58\tfunction makeCheckpoint(overrides: Partial<Record<string, unknown>> = {}) {\n59\t  return {\n60\t    checkpoint_id: \"cp-1\",\n61\t    commit_sha: \"sha-1\",\n62\t    commit_message: \"feat: stuff\",\n63\t    commit_date: \"2026-04-20T12:00:00Z\",\n64\t    commit_author_github_id: 99,\n65\t    additions: 1,\n66\t    deletions: 0,\n67\t    files_changed: 1,\n68\t    repo_id: \"repo-1\",\n69\t    repo_full_name: \"org/app\",\n70\t    branch: \"main\",\n71\t    is_private: false,\n72\t    agent: \"Claude Code\",\n73\t    steps: 1,\n74\t    session_count: 1,\n75\t    input_tokens: 100,\n76\t    output_tokens: 50,\n77\t    ...overrides,\n78\t  }\n79\t}\n80\t\n81\tdescribe(\"GET /me/recap\", () => {\n82\t  beforeEach(() => {\n83\t    vi.clearAllMocks()\n84\t    mockGetWithCache.mockResolvedValue({ id: \"user-1\", github_id: 12345 })\n85\t    mockGetByUser.mockResolvedValue([])\n86\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n87\t    mockGetByCheckpointIds.mockResolvedValue([])\n88\t    mockAggregateFacetsByAgent.mockResolvedValue(new Map())\n89\t  })\n90\t\n91\t  function get(path: string) {\n92\t    return makeApp().request(path, { headers: {} }, { ...mockEnv, ...mockExecutionCtx })\n93\t  }\n94\t\n95\t  it(\"returns null contributors and skips the team query when ?repo= is omitted\", async () => {\n96\t    const res = await get(\"/\")\n97\t\n98\t    expect(res.status).toBe(200)\n99\t    const body = (await res.json()) as Record<string, unknown>\n100\t\n101\t    expect(body.contributors).toBeNull()\n102\t    expect(body.repo).toBeNull()\n103\t    expect(mockGetTeamOnUserRepos).not.toHaveBeenCalled()\n104\t  })\n105\t\n106\t  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n107\t    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n108\t    mockGetTeamOnUserRepos.mockResolvedValue([])\n109\t\n110\t    const res = await get(\"/?repo=org/app\")\n111\t    expect(res.status).toBe(200)\n112\t\n113\t    expect(mockGetByUser).toHaveBeenCalledWith(\n114\t      \"user-1\",\n115\t      12345,\n116\t      expect.any(String),\n117\t      expect.any(String),\n118\t      expect.any(Number),\n119\t      \"org/app\",\n120\t    )\n121\t    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n122\t      \"user-1\",\n123\t      12345,\n124\t      expect.any(String),\n125\t      expect.any(String),\n126\t      expect.any(Number),\n127\t      \"org/app\",\n128\t    )\n129\t  })\n130\t\n131\t  it(\"counts distinct contributors by author id, not by commit_sha\", async () => {\n132\t    mockGetByUser.mockResolvedValue([makeCheckpoint({ commit_author_github_id: 12345 })])\n133\t    mockGetTeamOnUserRepos.mockResolvedValue([\n134\t      // Author A makes two team commits — should count as ONE contributor,\n135\t      // not two as the previous commit_sha-based count would have done.\n136\t      makeCheckpoint({\n137\t        checkpoint_id: \"cp-2\",\n138\t        commit_sha: \"sha-team-a-1\",\n139\t        commit_author_github_id: 200,\n140\t      }),\n141\t      makeCheckpoint({\n142\t        checkpoint_id: \"cp-3\",\n143\t        commit_sha: \"sha-team-a-2\",\n144\t        commit_author_github_id: 200,\n145\t      }),\n146\t      makeCheckpoint({\n147\t        checkpoint_id: \"cp-4\",\n148\t        commit_sha: \"sha-team-b-1\",\n149\t        commit_author_github_id: 300,\n150\t      }),\n151\t    ])\n152\t\n153\t    const res = await get(\"/?repo=org/app\")\n154\t    const body = (await res.json()) as { contributors: { distinctUsers: number } }\n155\t\n156\t    // Two team authors (200, 300) plus the requesting user = 3.\n157\t    expect(body.contributors.distinctUsers).toBe(3)\n158\t  })\n159\t\n160\t  it(\"honours since/until query params over the timeframe enum\", async () => {\n161\t    const since = \"2026-04-20T00:00:00.000Z\"\n162\t    const until = \"2026-04-21T00:00:00.000Z\"\n163\t\n164\t    const res = await get(`/?since=${since}&until=${until}`)\n165\t    expect(res.status).toBe(200)\n166\t    const body = (await res.json()) as { since: string; until: string }\n167\t    expect(body.since).toBe(since)\n168\t    expect(body.until).toBe(until)\n169\t  })\n170\t\n171\t  it(\"passes (repo_id, checkpoint_id, agent) triple to aggregator and applies result per-agent\", async () => {\n172\t    // Originally written to catch a bug where analysesById was keyed only\n173\t    // by checkpoint_id, causing cross-repo leakage in the JS-side merge.\n174\t    // With the SQL aggregator the route hands the full triple to\n175\t    // aggregateFacetsByAgent and applies the result verbatim — that\n176\t    // contract is what's pinned here. The original cross-repo regression\n177\t    // is now structurally impossible without the SQL aggregator itself\n178\t    // being broken (covered by the aggregator's own tests).\n179\t    mockGetByUser.mockResolvedValue([\n180\t      makeCheckpoint({\n181\t        repo_id: \"repo-A\",\n182\t        checkpoint_id: \"shared\",\n183\t        agent: \"Claude Code\",\n184\t      }),\n185\t      makeCheckpoint({\n186\t        repo_id: \"repo-B\",\n187\t        checkpoint_id: \"shared\",\n188\t        agent: \"Codex\",\n189\t      }),\n190\t    ])\n191\t    // Under the SQL facet aggregator the (repo_id, checkpoint_id) scoping is\n192\t    // enforced server-side: the route hands the full (repo_id, checkpoint_id,\n193\t    // agent) triple to aggregateFacetsByAgent and trusts the resulting\n194\t    // per-agent map verbatim. Mock that map directly here.\n195\t    mockAggregateFacetsByAgent.mockResolvedValue(\n196\t      new Map([\n197\t        [\n198\t          \"Claude Code\",\n199\t          {\n200\t            labels: [{ name: \"bug_fix\", count: 1 }],\n201\t            skills: [],\n202\t            toolMix: [],\n203\t            mcpServers: [],\n204\t            transcriptTokens: 0,\n205\t            filesChanged: 0,\n206\t          },\n207\t        ],\n208\t        [\n209\t          \"Codex\",\n210\t          {\n211\t            labels: [{ name: \"refactor\", count: 1 }],\n212\t            skills: [],\n213\t            toolMix: [],\n214\t            mcpServers: [],\n215\t            transcriptTokens: 0,\n216\t            filesChanged: 0,\n217\t          },\n218\t        ],\n219\t      ]),\n220\t    )\n221\t\n222\t    const res = await get(\"/\")\n223\t    expect(res.status).toBe(200)\n224\t    const body = (await res.json()) as {\n225\t      agents: Record<string, { me: { labels: Array<{ label: string }> } }>\n226\t    }\n227\t\n\n... [203 lines truncated] ..."},"type":"attachment","uuid":"97bb613e-50e9-4982-a210-9e65fc73a970","timestamp":"2026-04-29T15:45:45.557Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
