().mockResolvedValue({ numUpdatedRows: 1n })\n685\t  const setSpy = vi.fn().mockReturnThis()\n686\t  const chain = {\n687\t    selectFrom: vi.fn().mockReturnThis(),\n688\t    select: vi.fn().mockReturnThis(),\n689\t    where: vi.fn().mockReturnThis(),\n690\t    orderBy: vi.fn().mockReturnThis(),\n691\t    limit: vi.fn().mockReturnThis(),\n692\t    execute: selectExec,\n693\t    updateTable: vi.fn().mockReturnThis(),\n694\t    set: setSpy,\n695\t  }\n696\t  // updateTable's chain: updateTable -> set -> where -> where -> execute\n697\t  chain.set.mockImplementation(() => ({\n698\t    where: vi.fn().mockReturnThis().mockReturnValue({\n699\t      where: vi.fn().mockReturnValue({ execute: updateExec }),\n700\t    }),\n701\t  }))\n702\t  return { db: chain as unknown as Kysely<DB>, setSpy, updateExec }\n703\t}\n704\t\n705\tconst fakeAnalysisJson = JSON.stringify({\n706\t  // Pre-existing labels and scalars must NOT be touched\n707\t  extraction: { labels: [\"bug_fix\", \"refactor\"] },\n708\t  total_transcript_tokens: 1234,\n709\t  totalFilesChanged: 7,\n710\t  // Stale Claude-shaped tool metrics — backfill should overwrite\n711\t  toolProfile: { categories: { shell: { count: 0 } }, total: 0 },\n712\t  skillsUsed: [],\n713\t  mcpServersUsed: [],\n714\t})\n715\t\n716\tconst codexSession: SessionTranscript = {\n717\t  sessionId: \"s1\",\n718\t  agent: \"Codex\",\n719\t  messages: [\n720\t    {\n721\t      id: \"m1\",\n722\t      role: \"assistant\",\n723\t      content: \"\",\n724\t      timestamp: \"2026-04-30T00:00:00Z\",\n725\t      toolCalls: [\n726\t        { id: \"1\", name: \"exec_command\", input: {}, timestamp: \"\" },\n727\t        { id: \"2\", name: \"apply_patch\", input: {}, timestamp: \"\" },\n728\t      ],\n729\t    },\n730\t  ],\n731\t  transcriptIdentifierAtStart: null,\n732\t  checkpointTranscriptStart: null,\n733\t}\n734\t\n735\tdescribe(\"runBackfill (tool metrics)\", () => {\n736\t  it(\"merges corrected metrics into analysis_json without dropping label