: 3 }], [], [])\n\n    const out = await analyses.aggregateFacetsByAgent([\n      { repo_id: repoId, checkpoint_id: checkpointId,             agent: \"Claude Code\" },\n      { repo_id: repoId, checkpoint_id: cpCodex.checkpoint_id,    agent: \"Codex\" },\n    ])\n\n    expect(out.get(\"Claude Code\")?.labels).toEqual([{ name: \"bug_fix\",  count: 2 }])\n    expect(out.get(\"Codex\")?.labels).toEqual(      [{ name: \"refactor\", count: 3 }])\n  })\n\n  it(\"groups null agent under 'unknown'\", async () => {\n    await analyses.upsertFacets(repoId, checkpointId, [{ name: \"x\", count: 1 }], [], [])\n    const out = await analyses.aggregateFacetsByAgent([\n      { repo_id: repoId, checkpoint_id: checkpointId, agent: null },\n    ])\n    expect(out.get(\"unknown\")?.labels).toEqual([{ name: \"x\", count: 1 }])\n  })\n\n  it(\"returns empty map for empty input\", async () => {\n    const out = await analyses.aggregateFacetsByAgent([])\n    expect(out.size).toBe(0)\n  })\n})\n```\n\nRun tests — must fail.\n\n### Task 2.8: Implement aggregateFacetsByAgent\n\nAdd to `ns` after `aggregateFacetsByCheckpointSet`:\n\n```typescript\n    async aggregateFacetsByAgent(checkpoints) {\n      if (checkpoints.length === 0) return new Map()\n\n      const byAgent = new Map<string, AnalysisFacetCheckpointRef[]>()\n      for (const cp of checkpoints) {\n        const agent = cp.agent ?? \"unknown\"\n        const arr = byAgent.get(agent) ?? []\n        arr.push({ repo_id: cp.repo_id, checkpoint_id: cp.checkpoint_id })\n        byAgent.set(agent, arr)\n      }\n\n      const result = new Map<string, AnalysisFacetsByAgent>()\n\n      // Per-agent fan-out: each agent's 3 facet kinds run via Promise.all.\n      // All agents run in parallel. For typical ~5-agent recap responses\n      // this is 15 queries fired in parallel.\n      await Promise.all(\n        Array.from(byAgent.entries()).map(async ([agent, cps]) => {\n          const [labels, skills, toolMix] = await Promise.all([\n            ns.aggregateFacetsByCheckpointSet(\"labels\", cps),\n            ns.aggregateFacetsByCheckpointSet(\"skills\", cps),\n            ns.aggregateFacetsByCheckpointSet(\"tool_mix\", cps),\n          ])\n          result.set(agent, {\n            labels:  labels.map((r)  => ({ name: r.name, count: r.total })),\n            skills:  skills.map((r)  => ({ name: r.name, count: r.total })),\n            toolMix: toolMix.map((r) => ({ name: r.name, count: r.total })),\n          })\n        }),\n      )\n\n      return result\n    },\n```\n\nYou'll need to import `AnalysisFacetCheckpointRef` and `AnalysisFacetsByAgent` from db-types if not already imported:\n\n```typescript\nimport type { AnalysisFacetCheckpointRef, AnalysisFacetsByAgent } from \"../db/db-types\"\n```\n\nRun tests — must pass.\n\nCommit:\n\n```bash\ngit add api/src/lib/planetscale/analyses.ts api/src/lib/planetscale/analyses.test.ts\ngit commit -m \"feat(recap): aggregateFacetsByAgent groups facets per agent\n\nPer-agent fan-out via Promise.all over the agent set. Each agent runs\n3 facet aggregates in parallel (one per facet kind). For typical\n~5-agent recap responses this is 15 queries fired in 5 parallel\nbatches of 3.\"\n```\n\n## Final verification\n\nAfter all three commits land:\n\n```bash\npnpm --dir api typecheck\npnpm --dir api test:unit -- analyses.test 2>&1 | tail -10\n```\n\nExpected: typecheck clean, all `analyses.test.ts` tests pass (existing + your new ones).\n\nDO NOT push. We'll batch pushes at the end.\n\n## Before You Begin\n\nIf anything is unclear, ask. The TDD progression is strict: each method gets red → green → commit before moving to the next. Don't batch them.\n\n## When You're Done\n\nReport DONE / DONE_WITH_CONCERNS / NEEDS_CONTEXT / BLOCKED with:\n- The 3 commit hashes (one per method)\n- Confirmation all tests pass\n- Confirmation typecheck is clean\n- Anything unexpected\n\nDO NOT proceed beyond Chunk 2.","agentId":"aabb5714d624276fd","agentType":"general-purpose","content"