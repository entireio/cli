{"parentUuid":"e9aef6a2-0cc0-45fc-8e7c-ca0790bb20f0","isSidechain":false,"promptId":"9cc2e5a9-f145-47b7-b367-ba67f2e3443a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017dHmFW975tgaLzFFMFypLb","type":"tool_result","content":"1660\t  return activities\n1661\t}\n1662\t\n1663\texport async function getCheckpointsByUser(\n1664\t  db: Kysely<DB>,\n1665\t  userId: string,\n1666\t  githubId: number,\n1667\t  startDate: string,\n1668\t  endDate: string,\n1669\t  limit: number = 500,\n1670\t  repoFullName?: string,\n1671\t): Promise<UserCheckpoint[]> {\n1672\t  // Subquery: deduplicate checkpoint commits in SQL using ROW_NUMBER so the\n1673\t  // LIMIT applies to unique (repo_id, checkpoint_id) pairs. Prefers the row\n1674\t  // on the default branch. Uses repo_checkpoints.created_at as the primary\n1675\t  // time axis — this comes from checkpoint session metadata and is available\n1676\t  // even without commit resolution. When repoFullName is supplied, filter\n1677\t  // at the join so LIMIT applies inside that repo only — fixes the bug\n1678\t  // where cross-repo activity could push the requested repo's checkpoints\n1679\t  // out of the result set before the JS post-filter saw them.\n1680\t  let rankedBuilder = db\n1681\t    .selectFrom(\"repo_checkpoint_commits as cc\")\n1682\t    .innerJoin(\"repo_checkpoints as cp\", (join) =>\n1683\t      join\n1684\t        .onRef(\"cp.repo_id\", \"=\", \"cc.repo_id\")\n1685\t        .onRef(\"cp.checkpoint_id\", \"=\", \"cc.checkpoint_id\"),\n1686\t    )\n1687\t    .innerJoin(\"repo_commits as rc\", (join) =>\n1688\t      join.onRef(\"rc.repo_id\", \"=\", \"cc.repo_id\").onRef(\"rc.commit_sha\", \"=\", \"cc.commit_sha\"),\n1689\t    )\n1690\t    .innerJoin(\"repos\", \"repos.id\", \"cc.repo_id\")\n1691\t    .innerJoin(\"user_repos\", (join) =>\n1692\t      join.onRef(\"user_repos.repo_id\", \"=\", \"cc.repo_id\").on(\"user_repos.user_id\", \"=\", userId),\n1693\t    )\n1694\t    .leftJoin(\"repo_branch_commits as bc\", (join) =>\n1695\t      join\n1696\t        .onRef(\"bc.repo_id\", \"=\", \"cc.repo_id\")\n1697\t        .onRef(\"bc.commit_sha\", \"=\", \"cc.commit_sha\")\n1698\t        .onRef(\"bc.branch\", \"=\", \"repos.default_branch\"),\n1699\t    )\n1700\t    .where(\"rc.commit_author_github_id\", \"=\", githubId)\n1701\t    .where(\"cp.created_at\", \">=\", new Date(startDate))\n1702\t    .where(\"cp.created_at\", \"<=\", new Date(endDate))\n1703\t  if (repoFullName) {\n1704\t    rankedBuilder = rankedBuilder.where(\"repos.full_name\", \"=\", repoFullName)\n1705\t  }\n1706\t  const ranked = rankedBuilder\n1707\t    .select([\n1708\t      \"cc.repo_id\",\n1709\t      \"cc.checkpoint_id\",\n1710\t      \"cc.commit_sha\",\n1711\t      sql<string>`COALESCE(bc.branch, cc.branch)`.as(\"branch\"),\n1712\t      \"cp.created_at\",\n1713\t      // ROW_NUMBER() assigns 1, 2, 3... within each (repo_id, checkpoint_id) group.\n1714\t      // ORDER BY (bc.branch IS NOT NULL) DESC puts the default-branch row first (1=true, 0=false).\n1715\t      // The outer query filters WHERE rn = 1 to keep one row per checkpoint,\n1716\t      // preferring the default branch. If the checkpoint isn't on the default branch,\n1717\t      // an arbitrary branch is picked.\n1718\t      sql<number>`ROW_NUMBER() OVER (PARTITION BY cc.repo_id, cc.checkpoint_id ORDER BY (bc.branch IS NOT NULL) DESC)`.as(\n1719\t        \"rn\",\n1720\t      ),\n1721\t    ])\n1722\t    .as(\"ranked\")\n1723\t\n1724\t  const commits = await db\n1725\t    .selectFrom(ranked)\n1726\t    .innerJoin(\"repo_commits as rc\", (join) =>\n1727\t      join\n1728\t        .onRef(\"rc.repo_id\", \"=\", \"ranked.repo_id\")\n1729\t        .onRef(\"rc.commit_sha\", \"=\", \"ranked.commit_sha\"),\n1730\t    )\n1731\t    .innerJoin(\"repos\", \"repos.id\", \"ranked.repo_id\")\n1732\t    .leftJoin(\"repo_checkpoints as cp\", (join) =>\n1733\t      join\n1734\t        .onRef(\"cp.repo_id\", \"=\", \"ranked.repo_id\")\n1735\t        .onRef(\"cp.checkpoint_id\", \"=\", \"ranked.checkpoint_id\"),\n1736\t    )\n1737\t    .select([\n1738\t      \"ranked.checkpoint_id\",\n1739\t      \"ranked.branch\",\n1740\t      \"rc.commit_sha\",\n1741\t      \"rc.commit_message\",\n1742\t      \"rc.commit_date\",\n1743\t      \"rc.commit_author_github_id\",\n1744\t      \"rc.additions\",\n1745\t      \"rc.deletions\",\n1746\t      \"rc.files_changed\",\n1747\t      \"ranked.repo_id\",\n1748\t      \"repos.full_name as repo_full_name\",\n1749\t      \"repos.default_branch\",\n1750\t      \"repos.is_private\",\n1751\t      \"cp.agent\",\n1752\t      \"cp.steps\",\n1753\t      \"cp.session_count\",\n1754\t      \"cp.input_tokens\",\n1755\t      \"cp.output_tokens\",\n1756\t    ])\n1757\t    .where(\"ranked.rn\", \"=\", 1)\n1758\t    .orderBy(\"rc.commit_date\", \"desc\")\n1759\t    .limit(limit)\n1760\t    .execute()\n1761\t\n1762\t  return commits.map((commit) => ({\n1763\t    checkpoint_id: commit.checkpoint_id,\n1764\t    commit_sha: commit.commit_sha,\n1765\t    commit_message: commit.commit_message,\n1766\t    commit_date: dateToStr(commit.commit_date),\n1767\t    commit_author_github_id: commit.commit_author_github_id ?? null,\n1768\t    additions: commit.additions ?? 0,\n1769\t    deletions: commit.deletions ?? 0,\n1770\t    files_changed: commit.files_changed ?? 0,\n1771\t    repo_id: commit.repo_id ?? \"\",\n1772\t    repo_full_name: commit.repo_full_name ?? \"\",\n1773\t    branch: commit.branch,\n1774\t    is_private: toBool(commit.is_private),\n1775\t    agent: commit.agent ?? null,\n1776\t    steps: commit.steps ?? null,\n1777\t    session_count: commit.session_count ?? null,\n1778\t    input_tokens: commit.input_tokens ?? null,\n1779\t    output_tokens: commit.output_tokens ?? null,\n1780\t  }))\n1781\t}\n1782\t\n1783\t// getTeamCheckpointsOnUserRepos returns checkpoints on repos where the user\n1784\t// has commit activity in the window, authored by OTHER contributors\n1785\t// (commit_author_github_id != githubId). This powers the \"team\" column in\n1786\t// recap — \"everyone else working on repos you're active in\" — so the CLI\n1787\t// me/team split has coherent semantics: both sides are real activity on\n1788\t// the same set of repos, with clean disjoint authorship.\n1789\t//\n1790\t// Same shape as getCheckpointsByUser so callers can aggregate the same way.\n1791\texport async function getTeamCheckpointsOnUserRepos(\n1792\t  db: Kysely<DB>,\n1793\t  userId: string,\n1794\t  githubId: number,\n1795\t  startDate: string,\n1796\t  endDate: string,\n1797\t  limit: number = 1000,\n1798\t  repoFullName?: string,\n1799\t): Promise<UserCheckpoint[]> {\n1800\t  // Subquery: find distinct repo_ids where the user has commit activity\n1801\t  // in the window. This is the \"repos I'm actively working in\" set.\n1802\t  const userRepoIds = db\n1803\t    .selectFrom(\"repo_commits\")\n1804\t    .select(\"repo_id\")\n1805\t    .where(\"commit_author_github_id\", \"=\", githubId)\n1806\t    .where(\"commit_date\", \">=\", new Date(startDate))\n1807\t    .where(\"commit_date\", \"<=\", new Date(endDate))\n1808\t    .distinct()\n1809\t\n1810\t  // Now: team checkpoints on those repos, authored by non-user.\n1811\t  // Same dedup-by-ROW_NUMBER pattern as getCheckpointsByUser so the same\n1812\t  // aggregator downstream can handle both shapes. When repoFullName is\n1813\t  // supplied, scope the query to that repo at the SQL level so LIMIT\n1814\t  // applies inside the requested repo only.\n1815\t  let rankedBuilder = db\n1816\t    .selectFrom(\"repo_checkpoint_commits as cc\")\n1817\t    .innerJoin(\"repo_checkpoints as cp\", (join) =>\n1818\t      join\n1819\t        .onRef(\"cp.repo_id\", \"=\", \"cc.repo_id\")\n1820\t        .onRef(\"cp.checkpoint_id\", \"=\", \"cc.checkpoint_id\"),\n1821\t    )\n1822\t    .innerJoin(\"repo_commits as rc\", (join) =>\n1823\t      join.onRef(\"rc.repo_id\", \"=\", \"cc.repo_id\").onRef(\"rc.commit_sha\", \"=\", \"cc.commit_sha\"),\n1