nd decorate it with the metrics\n145\t * derived from the loaded transcript (skills used, MCP servers, tool profile,\n146\t * models, agents). Centralises the derivation so the orchestrator doesn't\n147\t * need to thread three separate helper calls and an object spread.\n148\t */\n149\tfunction decorateReviewWithMetrics(\n150\t  review: Omit<\n151\t    StoredCheckpointAnalysis,\n152\t    \"skillsUsed\" | \"mcpServersUsed\" | \"modelsUsed\" | \"agentsUsed\" | \"toolProfile\"\n153\t  >,\n154\t  loaded: { sessionsMap: Record<string, StoredTranscriptSession> | null } & Pick<\n155\t    LoadedCheckpointTranscript,\n156\t    \"sessions\" | \"sessionMetadata\"\n157\t  >,\n158\t): StoredCheckpointAnalysis {\n159\t  const metrics = loaded.sessionsMap\n160\t    ? extractToolMetrics(loaded.sessionsMap)\n161\t    : { skillsUsed: [], mcpServersUsed: [], toolProfile: null }\n162\t  const modelsUsed = extractModelsUsedFromSessionMetadata(loaded.sessionMetadata)\n163\t  const agentsUsed = [...new Set(loaded.sessions.map((session) => session.agent))]\n164\t  return {\n165\t    ...review,\n166\t    skillsUsed: metrics.skillsUsed,\n167\t    mcpServersUsed: metrics.mcpServersUsed,\n168\t    modelsUsed,\n169\t    agentsUsed,\n170\t    toolProfile: metrics.toolProfile ?? undefined,\n171\t  }\n172\t}\n173\t\n174\t/**\n175\t * Single-pass extraction of tool usage stats (skills, MCP servers) and\n176\t * tool profile (category counts) from parsed session JSONL.\n177\t */\n178\texport function extractToolMetrics(sessionsMap: Record<string, string | StoredTranscriptSession>): {\n179\t  skillsUsed: string[]\n180\t  mcpServersUsed: { name: string; count: number }[]\n181\t  toolProfile: ToolProfile | null\n182\t} {\n183\t  const skills = new Set<string>()\n184\t  const mcpCounts = new Map<string, number>()\n185\t  const counts = { shell: 0, fileOps: 0, search: 0, mcp: 0, agent: 0, other: 0 }\n186\t  let total = 0\n187\t\n188\t  for (const storedSession of Object.values(sessionsMap)) {\n189\t    