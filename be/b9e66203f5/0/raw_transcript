{"parentUuid":"2b9477e0-573d-4aab-9890-104e5ad47c7b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","snippet":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n6\t//     labels + skills + mcpServers + toolMix\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo. Only populated when ?repo=org/name is supplied;\n9\t//     otherwise both per-agent contributors and the top-level contributors\n10\t//     summary are null (cross-repo team aggregation has no coherent\n11\t//     \"everyone else\" set without a single repo as the reference frame).\n12\t//\n13\t// This endpoint consolidates three CLI operations into one request:\n14\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n15\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n16\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n17\t//\n18\t// Without this endpoint the CLI has to do all three itself and attribute\n19\t// analyses to agents via the commits endpoint — a lot of round trips and\n20\t// brittle client-side joining. Centralizing on the server matches the\n21\t// pattern established by /me/activity (PR #1590).\n22\t\n23\timport type { Context } from \"hono\"\n24\timport { Hono } from \"hono\"\n25\timport { describeRoute, resolver } from \"hono-openapi\"\n26\timport { z } from \"zod\"\n27\t\n28\timport type { Env, Variables } from \"../env\"\n29\timport { LEGACY_FALLBACK_AGENT_NAME } from \"../lib/constants\"\n30\timport { getDb } from \"../lib/db\"\n31\timport type { UserCheckpoint } from \"../lib/db/checkpoints\"\n32\timport type { AnalysisFacetsByAgent } from \"../lib/db/db-types\"\n33\timport { recordSpanError } from \"../lib/telemetry\"\n34\timport { TOOL_MIX_CATEGORY_KEYS } from \"../types\"\n35\timport { parseTimeframeParams } from \"./cache\"\n36\t\n37\t// Operational rollback: when ENTIRE_RECAP_LEGACY_AGGREGATOR is set to\n38\t// \"1\" or \"true\", /me/recap falls back to the legacy in-JS analysis\n39\t// aggregator. Default (unset) uses the SQL facet aggregator. Read from\n40\t// env on every request so flipping the binding takes effect without a\n41\t// code redeploy. Remove once the SQL path soaks long enough to drop\n42\t// the legacy mergeAnalysesInto helper entirely.\n43\tfunction isLegacyAggregatorEnabled(env: Env): boolean {\n44\t  const raw = env.ENTIRE_RECAP_LEGACY_AGGREGATOR\n45\t  return raw === \"1\" || raw === \"true\"\n46\t}\n47\t\n48\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n49\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n50\t// would double-execute the middleware.\n51\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n52\t\n53\tconst errorSchema = z.object({ error: z.string() })\n54\t\n55\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n56\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n57\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n58\tconst toolMixSchema = z.object({\n59\t  shell: z.number(),\n60\t  fileOps: z.number(),\n61\t  search: z.number(),\n62\t  mcp: z.number(),\n63\t  agent: z.number(),\n64\t  other: z.number(),\n65\t})\n66\t\n67\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n68\t// me and contributors sides so the CLI renderer can treat them uniformly.\n69\t// Derived from the Zod schema so the response contract and the TS type\n70\t// can't drift — there's a single source of truth.\n71\tconst agentAggregateSchema = z.object({\n72\t  checkpoints: z.number(),\n73\t  tokens: z.number(),\n74\t  transcriptTokens: z.number(),\n75\t  filesChanged: z.number(),\n76\t  labels: z.array(labelCountSchema),\n77\t  skills: z.array(skillCountSchema),\n78\t  mcpServers: z.array(mcpCountSchema),\n79\t  toolMix: toolMixSchema,\n80\t})\n81\ttype AgentAggregate = z.infer<typeof agentAggregateSchema>\n82\t\n83\tconst perAgentEntrySchema = z.object({\n84\t  me: agentAggregateSchema,\n85\t  contributors: agentAggregateSchema.nullable(),\n86\t})\n87\t\n88\tconst recapResponseSchema = z.object({\n89\t  timeframe: z.string(),\n90\t  repo: z.string().nullable(),\n91\t  since: z.string(),\n92\t  until: z.string(),\n93\t  agents: z.record(z.string(), perAgentEntrySchema),\n94\t  contributors: z\n95\t    .object({\n96\t      distinctUsers: z.number(),\n97\t      totalTokens: z.number(),\n98\t      totalCheckpoints: z.number(),\n99\t    })\n100\t    .nullable(),\n101\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n102\t  updated_at: z.string(),\n103\t})\n104\t\n105\trecapRoutes.get(\n106\t  \"/\",\n107\t  describeRoute({\n108\t    tags: [\"Me\"],\n109\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n110\t    description:\n111\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n112\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n113\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n114\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n115\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n116\t    parameters: [\n117\t      {\n118\t        name: \"timeframe\",\n119\t        in: \"query\",\n120\t        required: false,\n121\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n122\t        schema: {\n123\t          type: \"string\",\n124\t          enum: [\"last-month\", \"last-3-months\", \"las