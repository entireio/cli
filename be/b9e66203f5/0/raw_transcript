null\n584\t} {\n585\t  const skills = new Set<string>()\n586\t  const mcpCounts = new Map<string, number>()\n587\t  const counts: Record<ToolMixCategoryKey, number> = {\n588\t    shell: 0,\n589\t    fileOps: 0,\n590\t    search: 0,\n591\t    mcp: 0,\n592\t    agent: 0,\n593\t    other: 0,\n594\t  }\n595\t  let total = 0\n596\t\n597\t  for (const session of sessions) {\n598\t    const parser = getParserForAgent(session.agent)\n599\t    for (const message of session.messages) {\n600\t      for (const call of message.toolCalls ?? []) {\n601\t        total++\n602\t        const cat = parser.classifyTool?.(call) ?? \"other\"\n603\t        counts[cat]++\n604\t\n605\t        const skill = parser.extractSkillFromTool?.(call)\n606\t        if (skill) skills.add(skill)\n607\t\n608\t        const mcpServer = parser.extractMcpServerFromTool?.(call)\n609\t        if (mcpServer) {\n610\t          mcpCounts.set(mcpServer, (mcpCounts.get(mcpServer) ?? 0) + 1)\n611\t        }\n612\t      }\n613\t    }\n614\t  }\n615\t\n616\t  let toolProfile: ToolProfile | null = null\n617\t  if (total > 0) {\n618\t    const categories = Object.fromEntries(\n619\t      TOOL_MIX_CATEGORY_KEYS.map((k) => [k, { count: counts[k] }]),\n620\t    ) as Record<ToolMixCategoryKey, { count: number }>\n621\t    toolProfile = { categories, total }\n622\t  }\n623\t\n624\t  return {\n625\t    skillsUsed: Array.from(skills),\n626\t    mcpServersUsed: Array.from(mcpCounts.entries())\n627\t      .map(([name, count]) => ({ name, count }))\n628\t      .sort((a, b) => b.count - a.count),\n629\t    toolProfile,\n630\t  }\n631\t}\n632\t```\n633\t\n634\t- [ ] **Step 4: Update the single in-tree caller**\n635\t\n636\tFind the existing `extractToolMetrics(loaded.sessionsMap)` call at `analysis-queue.ts:161-163` (a few lines after the line number drifted from \"159\" — grep for the call to be sure) and replace with:\n637\t\n638\t```ts\n639\tconst metrics =\n640\t  loaded.sessions.length > 0\n641\t    ? extractToolMetricsFromS