ord<ToolMixCategory, number> = {\n    shell: 0,\n    fileOps: 0,\n    search: 0,\n    mcp: 0,\n    agent: 0,\n    other: 0,\n  }\n  let total = 0\n\n  for (const session of sessions) {\n    const parser = getParserForAgent(session.agent)\n    for (const message of session.messages) {\n      for (const call of message.toolCalls ?? []) {\n        total++\n        const cat = parser.classifyTool?.(call) ?? \"other\"\n        counts[cat]++\n\n        const skill = parser.extractSkillFromTool?.(call)\n        if (skill) skills.add(skill)\n\n        const mcpServer = parser.extractMcpServerFromTool?.(call)\n        if (mcpServer) {\n          mcpCounts.set(mcpServer, (mcpCounts.get(mcpServer) ?? 0) + 1)\n        }\n      }\n    }\n  }\n\n  let toolProfile: ToolProfile | null = null\n  if (total > 0) {\n    const categories = Object.fromEntries(\n      TOOL_MIX_CATEGORY_KEYS.map((k) => [k, { count: counts[k] }]),\n    ) as Record<ToolMixCategory, { count: number }>\n    toolProfile = { categories, total }\n  }\n\n  return {\n    skillsUsed: Array.from(skills),\n    mcpServersUsed: Array.from(mcpCounts.entries())\n      .map(([name, count]) => ({ name, count }))\n      .sort((a, b) => b.count - a.count),\n    toolProfile,\n  }\n}\n```\n\n- [ ] **Step 4: Update the single in-tree caller**\n\nFind `analysis-queue.ts:159` (`extractToolMetrics(loaded.sessionsMap)`) and replace with:\n\n```ts\nconst metrics =\n  loaded.sessions.length > 0\n    ? extractToolMetricsFromSessions(\n        loaded.sessions.map((s) => ({ agent: s.agent, messages: s.messages })),\n      )\n    : { skillsUsed: [], mcpServersUsed: [], toolProfile: null }\n```\n\nThe old `loaded.sessionsMap !== null` guard becomes `loaded.sessions.length > 0`. Equivalent in practice — both go empty when no parser yielded usable messages.\n\n- [ ] **Step 5: Run all analysis-queue tests**\n\nRun: `cd api && pnpm vitest run src/lib/analysis-queue.test.ts`\nExpected: PASS — old tests are gone (deleted in Step 1), new tests pa