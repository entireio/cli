orAgent } from \"./transcript-parsers/registry\"\nimport { TOOL_MIX_CATEGORY_KEYS } from \"../types\"\n\nexport interface ParsedSessionForMetrics {\n  agent: string\n  messages: TranscriptMessage[]\n}\n\nexport function extractToolMetricsFromSessions(sessions: ParsedSessionForMetrics[]): {\n  skillsUsed: string[]\n  mcpServersUsed: { name: string; count: number }[]\n  toolProfile: ToolProfile | null\n} {\n  const skills = new Set<string>()\n  const mcpCounts = new Map<string, number>()\n  const counts: Record<ToolMixCategoryKey, number> = {\n    shell: 0,\n    fileOps: 0,\n    search: 0,\n    mcp: 0,\n    agent: 0,\n    other: 0,\n  }\n  let total = 0\n\n  for (const session of sessions) {\n    const parser = getParserForAgent(session.agent)\n    for (const message of session.messages) {\n      const toolCalls = message.toolCalls ?? []\n      for (const call of toolCalls) {\n        total++\n        const cat = parser.classifyTool?.(call) ?? \"other\"\n        counts[cat]++\n\n        const skill = parser.extractSkillFromTool?.(call)\n        if (skill) skills.add(skill)\n\n        const mcpServer = parser.extractMcpServerFromTool?.(call)\n        if (mcpServer) {\n          mcpCounts.set(mcpServer, (mcpCounts.get(mcpServer) ?? 0) + 1)\n        }\n      }\n    }\n  }\n\n  let toolProfile: ToolProfile | null = null\n  if (total > 0) {\n    const categories = Object.fromEntries(\n      TOOL_MIX_CATEGORY_KEYS.map((k) => [k, { count: counts[k] }]),\n    ) as Record<ToolMixCategoryKey, { count: number }>\n    toolProfile = { categories, total }\n  }\n\n  return {\n    skillsUsed: Array.from(skills),\n    mcpServersUsed: Array.from(mcpCounts.entries())\n      .map(([name, count]) => ({ name, count }))\n      .sort((a, b) => b.count - a.count),\n    toolProfile,\n  }\n}\n\n/**\n * @deprecated Use extractToolMetricsFromSessions. Kept for two release cycles\n * so any external caller (none in-tree) doesn't break.\n */\nexport function extractToolMetrics(\n  sessionsMap: Record<string, string | StoredTranscriptSession>,\n): { skillsUsed: string[]; mcpServersUsed: { name: string; count: number }[]; toolProfile: ToolProfile | null } {\n  // Bridge: assume Claude shape (the historical default). New callers should\n  // use extractToolMetricsFromSessions with parsed sessions.\n  const claudeParser = getParserForAgent(\"Claude Code\")\n  const sessions: ParsedSessionForMetrics[] = []\n  for (const stored of Object.values(sessionsMap)) {\n    const jsonl = typeof stored === \"string\" ? stored : stored?.content\n    if (typeof jsonl !== \"string\") continue\n    sessions.push({ agent: \"Claude Code\", messages: claudeParser.parse(jsonl).messages })\n  }\n  return extractToolMetricsFromSessions(sessions)\n}\n```\n\n- [ ] **Step 4: Update `decorateReviewWithMetrics` callsite**\n\nFind the existing call in `analysis-queue.ts:159` (`extractToolMetrics(loaded.sessionsMap)`) and replace with:\n\n```ts\nconst sessions: ParsedSessionForMetrics[] = loaded.sessions.map((s) => ({\n  agent: s.agent,\n  messages: s.messages,\n}))\nconst metrics =\n  sessions.length > 0\n    ? extractToolMetricsFromSessions(sessions)\n    : { skillsUsed: [], mcpServersUsed: [], toolProfile: null }\n```\n\n- [ ] **Step 5: Run tests to verify they pass**\n\nRun: `cd api && pnpm vitest run src/lib/analysis-queue.test.ts`\nExpected: PASS — all existing tests still green, new agent-aware tests pass.\n\n- [ ] **Step 6: Commit**\n\n```bash\ngit add api/src/lib/analysis-queue.ts api/src/lib/analysis-queue.test.ts\ngit commit -m \"refactor(recap-tools): extractToolMetrics consumes parsed sessions, dispatches per-agent\"\n```\n\n## Chunk 4: Backfill script for existing analyses\n\n### Task 11: Scaffold `backfill-analysis-tool-metrics.ts`\n\n**Files:**\n- Create: `api/scripts/backfill-analysis-tool-metrics.ts`\n\nMirrors `backfill-analysis-facets.ts` in shape (cursor-paginated, idempotent, `--dry-run`, `--limit=N`, narrow JSON-parse catch). The difference: this one does NOT touch the