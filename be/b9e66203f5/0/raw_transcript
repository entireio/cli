{"parentUuid":"2cd91e99-002c-41f6-8228-fe67ecb65e35","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","snippet":"1\t// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n2\t//\n3\t// Returns, for every agent the user has used in the window (and optionally\n4\t// every agent any contributor used on a scoped repo):\n5\t//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n6\t//     labels + skills + mcpServers + toolMix\n7\t//   - contributors side: the same shape aggregated across all contributors\n8\t//     to the specified repo. Only populated when ?repo=org/name is supplied;\n9\t//     otherwise both per-agent contributors and the top-level contributors\n10\t//     summary are null (cross-repo team aggregation has no coherent\n11\t//     \"everyone else\" set without a single repo as the reference frame).\n12\t//\n13\t// This endpoint consolidates three CLI operations into one request:\n14\t//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n15\t//   2. POST /checkpoints/analyses/batch → analyses for each cp\n16\t//   3. GET /:org/:repo/overview/*       → contributor aggregates\n17\t//\n18\t// Without this endpoint the CLI has to do all three itself and attribute\n19\t// analyses to agents via the commits endpoint — a lot of round trips and\n20\t// brittle client-side joining. Centralizing on the server matches the\n21\t// pattern established by /me/activity (PR #1590).\n22\t\n23\timport type { Context } from \"hono\"\n24\timport { Hono } from \"hono\"\n25\timport { describeRoute, resolver } from \"hono-openapi\"\n26\timport { z } from \"zod\"\n27\t\n28\timport type { Env, Variables } from \"../env\"\n29\timport { LEGACY_FALLBACK_AGENT_NAME } from \"../lib/constants\"\n30\timport { getDb } from \"../lib/db\"\n31\timport type { UserCheckpoint } from \"../lib/db/checkpoints\"\n32\timport { recordSpanError } from \"../lib/telemetry\"\n33\timport { parseTimeframeParams } from \"./cache\"\n34\t\n35\t// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n36\t// applied at the meRoutes level (requireBearerAuth); duplicating it here\n37\t// would double-execute the middleware.\n38\tconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n39\t\n40\tconst errorSchema = z.object({ error: z.string() })\n41\t\n42\tconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\n43\tconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\n44\tconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\n45\tconst toolMixSchema = z.object({\n46\t  shell: z.number(),\n47\t  fileOps: z.number(),\n48\t  search: z.number(),\n49\t  mcp: z.number(),\n50\t  agent: z.number(),\n51\t  other: z.number(),\n52\t})\n53\t\n54\t// AgentAggregate is the per-side per-agent payload. Same shape on both\n55\t// me and contributors sides so the CLI renderer can treat them uniformly.\n56\t// Derived from the Zod schema so the response contract and the TS type\n57\t// can't drift — there's a single source of truth.\n58\tconst agentAggregateSchema = z.object({\n59\t  checkpoints: z.number(),\n60\t  tokens: z.number(),\n61\t  transcriptTokens: z.number(),\n62\t  filesChanged: z.number(),\n63\t  labels: z.array(labelCountSchema),\n64\t  skills: z.array(skillCountSchema),\n65\t  mcpServers: z.array(mcpCountSchema),\n66\t  toolMix: toolMixSchema,\n67\t})\n68\ttype AgentAggregate = z.infer<typeof agentAggregateSchema>\n69\t\n70\tconst perAgentEntrySchema = z.object({\n71\t  me: agentAggregateSchema,\n72\t  contributors: agentAggregateSchema.nullable(),\n73\t})\n74\t\n75\tconst recapResponseSchema = z.object({\n76\t  timeframe: z.string(),\n77\t  repo: z.string().nullable(),\n78\t  since: z.string(),\n79\t  until: z.string(),\n80\t  agents: z.record(z.string(), perAgentEntrySchema),\n81\t  contributors: z\n82\t    .object({\n83\t      distinctUsers: z.number(),\n84\t      totalTokens: z.number(),\n85\t      totalCheckpoints: z.number(),\n86\t    })\n87\t    .nullable(),\n88\t  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n89\t  updated_at: z.string(),\n90\t})\n91\t\n92\trecapRoutes.get(\n93\t  \"/\",\n94\t  describeRoute({\n95\t    tags: [\"Me\"],\n96\t    summary: \"Per-agent recap aggregates for the authenticated user\",\n97\t    description:\n98\t      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n99\t      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n100\t      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n101\t      \"`contributors` counterpart aggregated across every contributor on the \" +\n102\t      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n103\t    parameters: [\n104\t      {\n105\t        name: \"timeframe\",\n106\t        in: \"query\",\n107\t        required: false,\n108\t        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n109\t        schema: {\n110\t          type: \"string\",\n111\t          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n112\t        },\n113\t      },\n114\t      {\n115\t        name: \"repo\",\n116\t        in: \"query\",\n117\t        required: false,\n118\t        description:\n119\t          \"Restrict me-side aggregates and enable the contributors side. \" +\n120\t          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n121\t          \"the user has checkpoints on and the contributors side is null.\",\n122\t        schema: { type: \"string\" },\n123\t      },\n124\t      {\n125\t        name: \"limit\",\n126\t        in: \"query\",\n127\t        required: false,\n128\t        description: \"Max checkpoints to consider (1-1000, default 500).\",\n129\t        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n130\t      },\n131\t      {\n132\t        name: \"since\",\n133\t        in: \"query\",\n134\t        required: false,\n135\t        description:\n136\t          \"ISO-8601 lower bound for the activity window. When provided \" +\n137\t          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n138\t          \"uses this so its --day / --week / --month ranges line up exactly \" +\n139\t          \"with the server's aggregation window.\",\n140\t        schema: { type: \"string\", format: \"date-time\" },\n141\t      },\n142\t      {\n143\t        name: \"until\",\n144\t        in: \"query\",\n145\t        required: false,\n146\t        description:\n147\t          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n148\t          \"alongside `since` to override the `timeframe` enum.\",\n149\t        schema: { type: \"string\", format: \"date-time\" },\n150\t      },\n151\t    ],\n152\t    responses: {\n153\t      200: {\n154\t        description: \"Per-agent recap aggregates\",\n155\t        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n156\t      },\n157\t      400: {\n158\t        description:\n159\t          \"Invalid since/until (must be supplied together as ISO-8601, with since <= until)\",\n160\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n161\t      },\n162\t      401: {\n163\t        description: \"Not authenticated\",\n164\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n165\t      },\n166\t      404: {\n167\t        description: \"Authenticated user record not found\",\n168\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n169\t      },\n170\t      500: {\n171\t        description: \"Failed to build recap\",\n172\t        content: { \"application/json\": { schema: resolver(errorSchema) } },\n173\t      },\n174\t    },\n175\t  }),\n176\t  async (c) => {\n177\t    const userId = c.get(\"userId\") as string\n178\t    const window = parseRecapWindow(c)\n179\t    if (!window.ok) {\n180\t      return c.json({ error: window.error }, 400)\n181\t    }\n182\t    const { limit, startDate, endDate } = window\n183\t    const repoParam = c.req.query(\"repo\")?.trim() || null\n184\t\n185\t    try {\n186\t      const db = getDb(c.env)\n187\t      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n188\t      if (!user) return c.json({ error: \"User not found\" }, 404)\n189\t\n190\t      // Pull me-side from repo_checkpoints filtered to the user's commits.\n191\t      // Team-side is only meaningful when the request scopes to a single\n192\t      // repo — without that, \"everyone else\" has no coherent reference\n193\t      // frame across all the user's repos. Skipping the team query when\n194\t      // ?repo= is absent saves a heavy join and matches the documented\n\n... [434 lines truncated] ..."},"type":"attachment","uuid":"d28ef7c1-b5dd-4425-a70f-b55fa0fffb37","timestamp":"2026-04-30T08:23:35.813Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"a654b6ca-4957-4d7c-8c99-62db313ff0a0","version":"2.1.119","gitBranch":"entire-activity","slug":"vectorized-whistling-bonbon"}
