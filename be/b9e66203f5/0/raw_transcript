t_issues\",\n              input: {},\n            },\n            { type: \"tool_use\", id: \"4\", name: \"Skill\", input: { skill: \"debugging\" } },\n          ],\n        },\n        timestamp: \"2026-04-30T00:00:00Z\",\n      }),\n    ].join(\"\\n\")\n    const claudeMessages = new ClaudeCodeParser().parse(claudeJsonl).messages\n    const m = extractToolMetricsFromSessions([{ agent: \"Claude Code\", messages: claudeMessages }])\n\n    expect(m.toolProfile?.categories.shell.count).toBe(1)\n    expect(m.toolProfile?.categories.fileOps.count).toBe(1)\n    expect(m.toolProfile?.categories.mcp.count).toBe(1)\n    expect(m.toolProfile?.categories.agent.count).toBe(1)\n    expect(m.skillsUsed).toEqual([\"debugging\"])\n    expect(m.mcpServersUsed).toEqual([{ name: \"github\", count: 1 }])\n  })\n\n  it(\"classifies Codex tool calls under Codex rules (real fixture lines, exact bucket counts)\", () => {\n    // Real Codex transcript shape — based on the fixture captured in Task 4.\n    // Each line is a Codex rollout entry with `payload.type` of `function_call`,\n    // `custom_tool_call`, or `local_shell_call`. The fields below are the\n    // smallest set the CodexParser needs to produce a synthesized ToolCall.\n    const codexJsonl = [\n      JSON.stringify({\n        timestamp: \"2026-04-30T00:00:00Z\",\n        type: \"response_item\",\n        payload: {\n          type: \"function_call\",\n          name: \"exec_command\",\n          call_id: \"c1\",\n          arguments: JSON.stringify({ command: \"ls\" }),\n        },\n      }),\n      JSON.stringify({\n        timestamp: \"2026-04-30T00:00:01Z\",\n        type: \"response_item\",\n        payload: {\n          type: \"function_call\",\n          name: \"apply_patch\",\n          call_id: \"c2\",\n          arguments: JSON.stringify({}),\n        },\n      }),\n      JSON.stringify({\n        timestamp: \"2026-04-30T00:00:02Z\",\n        type: \"response_item\",\n        payload: {\n          type: \"function_call\",\n          name: \"update_plan\",\n          call_id: \"c3\",\n          arguments: JSON.stringify({}),\n        },\n      }),\n      JSON.stringify({\n        timestamp: \"2026-04-30T00:00:03Z\",\n        type: \"response_item\",\n        payload: {\n          type: \"function_call\",\n          name: \"_list_pull_request_review_threads\",\n          call_id: \"c4\",\n          arguments: JSON.stringify({}),\n        },\n      }),\n    ].join(\"\\n\")\n    const codexMessages = new CodexParser().parse(codexJsonl).messages\n    expect(codexMessages.flatMap((m) => m.toolCalls ?? [])).toHaveLength(4)\n\n    const m = extractToolMetricsFromSessions([{ agent: \"Codex\", messages: codexMessages }])\n\n    expect(m.toolProfile?.categories.shell.count).toBe(1) // exec_command\n    expect(m.toolProfile?.categories.fileOps.count).toBe(1) // apply_patch\n    expect(m.toolProfile?.categories.agent.count).toBe(1) // update_plan\n    expect(m.toolProfile?.categories.mcp.count).toBe(1) // _list_pull_request_review_threads\n    expect(m.toolProfile?.categories.other.count).toBe(0)\n    expect(m.skillsUsed).toEqual([])\n    expect(m.mcpServersUsed).toEqual([])\n  })\n})\n```\n\nIf `CodexParser.parse()` doesn't synthesize `ToolCall` for the JSONL shape above, the planning-time assumption was wrong — drop into the parser source (`api/src/lib/transcript-parsers/codex-parser.ts`, the `function_call` handling around line 208) and confirm the actual payload shape. Adjust the fixture lines until `codexMessages.flatMap((m) => m.toolCalls ?? []).length === 4` before proceeding.\n\n- [ ] **Step 2: Run tests to verify they fail**\n\nRun: `cd api && pnpm vitest run src/lib/analysis-queue.test.ts -t \"agent-aware\"`\nExpected: FAIL — symbol `extractToolMetricsFromSessions` not exported.\n\n- [ ] **Step 3: Replace `extractToolMetrics` with `extractToolMetricsFromSessions`**\n\nIn `api/src/lib/analysis-queue.ts`:\n\n1. Add the imports (verify these aren't already imported):\n\n```ts\nimport { TOOL_MIX_CATEGORY_KEYS, type ToolMixCategoryKey } from \"../types\"\nimport { getParserForAgent } from \"./transcript-parsers/registry\"\n// `TranscriptMessage` is already imported via existing types in this file\n// (used by extractToolMetrics's parsing path). If not, add:\n// import type { TranscriptMessage } from \"../types\"\n```\n\n2. Replace the existing `export function extractToolMetrics` with the new function and a small input type:\n\n```ts\nexport interface ParsedSessionForMetrics {\n  agent: string\n  messages: TranscriptMessage[]\n}\n\nexport function extractToolMetricsFromSessions(sessions: ParsedSessionForMetrics[]): {\n  skillsUsed: string[]\n  mcpServersUsed: { name: string; count: number }[]\n  toolProfile: ToolProfile | null\n} {\n  const skills = new Set<string>()\n  const mcpCounts = new Map<string, number>()\n  const counts: Record<ToolMixCategoryKey, number> = {\n    shell: 0,\n    fileOps: 0,\n    search: 0,\n    mcp: 0,\n    agent: 0,\n    other: 0,\n  }\n  let total = 0\n\n  for (const session of sessions) {\n    const parser = getParserForAgent(session.agent)\n    for (const message of session.messages) {\n      const toolCalls = message.toolCalls ?? []\n      for (const call of toolCalls) {\n        total++\n        const cat = parser.classifyTool?.(call) ?? \"other\"\n        counts[cat]++\n\n        const skill = parser.extractSkillFromTool?.(call)\n        if (skill) skills.add(skill)\n\n        const mcpServer = parser.extractMcpServerFromTool?.(call)\n        if (mcpServer) {\n          mcpCounts.set(mcpServer, (mcpCounts.get(mcpServer) ?? 0) + 1)\n        }\n      }\n    }\n  }\n\n  let toolProfile: ToolProfile | null = null\n  if (total > 0) {\n    const categories = Object.fromEntries(\n      TOOL_MIX_CATEGORY_KEYS.map((k) => [k, { count: counts[k] }]),\n    ) as Record<ToolMixCategoryKey, { count: number }>\n    toolProfile = { categories, total }\n  }\n\n  return {\n    skillsUsed: Array.from(skills),\n    mcpServersUsed: Array.from(mcpCounts.entries())\n      .map(([name, count]) => ({ name, count }))\n      .sort((a, b) => b.count - a.count),\n    toolProfile,\n  }\n}\n```\n\nThe old `export function extractToolMetrics(sessionsMap: ...)` body and any usage of `StoredTranscriptSession` in this file go away.\n\n- [ ] **Step 4: Update the `decorateReviewWithMetrics` callsite**\n\nIn `api/src/lib/analysis-queue.ts` around line 159, the existing call is:\n\n```ts\nconst metrics = loaded.sessionsMap\n  ? extractToolMetrics(loaded.sessionsMap)\n  : { skillsUsed: [], mcpServersUsed: [], toolProfile: null }\n```\n\nReplace with:\n\n```ts\nconst metrics =\n  loaded.sessions.length > 0\n    ? extractToolMetricsFromSessions(\n        loaded.sessions.map((s) => ({ agent: s.agent, messages: s.messages })),\n      )\n    : { skillsUsed: [], mcpServersUsed: [], toolProfile: null }\n```\n\nThe `loaded.sessionsMap !== null` check becomes `loaded.sessions.length > 0`. These are equivalent in practice — the cascade in `loadCheckpointTranscript` produces empty `sessions` when no parser yielded usable messages, which is the same condition the old check guarded.\n\n- [ ] **Step 5: Update the existing `extractToolMetrics` test cases**\n\nIf `analysis-queue.test.ts` has tests for the old `extractToolMetrics(sessionsMap)` shape, port them to the new shape (parse the JSONL via the parser, pass the parsed sessions). If any existing test only verified the JSONL-scanning behavior (not the metric output), delete it — that behavior moved.\n\n- [ ] **Step 6: Run the full file**\n\nRun: `cd api && pnpm vitest run src/lib/analysis-queue.test.ts`\nExpected: PASS — all existing tests adapted, new agent-aware tests pass.\n\n- [ ] **Step 7: Commit**\n\n```bash\ngit add api/src/lib/analysis-queue.ts api/src/lib/analysis-queue.test.ts\ngit commit -m \"refactor(recap-tools): extractToolMetricsFromSessions consumes parsed sessions, dispatches per-agent\"\n```","originalFile":null,"structuredPatch":[{"oldStart":705,"oldLines":