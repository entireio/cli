t>\n  // … rest from the script above\n}\n```\n\n- [ ] **Step 3: Commit**\n\n```bash\ngit add api/test/transcript-parsers/codex-tool-names.fixtures.json\ngit commit -m \"test(recap-tools): capture Codex tool-name fixture from real transcript\"\n```\n\n### Task 5: Implement Codex classifier\n\n**Files:**\n- Modify: `api/src/lib/transcript-parsers/codex-parser.ts`\n- Modify: `api/src/lib/transcript-parsers/codex-parser.test.ts`\n\n- [ ] **Step 1: Write failing tests using the fixture**\n\n```ts\n// add to api/src/lib/transcript-parsers/codex-parser.test.ts\nimport fixture from \"../../../test/transcript-parsers/codex-tool-names.fixtures.json\"\n\ndescribe(\"CodexParser tool classification\", () => {\n  const parser = new CodexParser()\n  const make = (name: string, input: Record<string, unknown> = {}) =>\n    ({ id: \"x\", name, input, timestamp: \"\" }) as ToolCall\n\n  it(\"classifies bash as shell\", () => {\n    expect(parser.classifyTool!(make(\"bash\"))).toBe(\"shell\")\n  })\n  it.each([\"read_file\", \"apply_patch\"])(\"classifies %s as fileOps\", (name) => {\n    expect(parser.classifyTool!(make(name))).toBe(\"fileOps\")\n  })\n  it(\"returns 'other' for unrecognized Codex tools instead of dropping silently\", () => {\n    expect(parser.classifyTool!(make(\"definitely_not_a_codex_tool\"))).toBe(\"other\")\n  })\n  it(\"classifies every tool name in the captured Codex fixture into a non-empty bucket\", () => {\n    for (const name of Object.keys(fixture)) {\n      const cat = parser.classifyTool!(make(name))\n      expect(cat).toMatch(/^(shell|fileOps|search|mcp|agent|other)$/)\n    }\n  })\n  it(\"returns null for Codex skill / mcp extraction (Codex has no equivalent)\", () => {\n    expect(parser.extractSkillFromTool!(make(\"bash\"))).toBeNull()\n    expect(parser.extractMcpServerFromTool!(make(\"bash\"))).toBeNull()\n  })\n})\n```\n\n- [ ] **Step 2: Run tests to verify they fail**\n\nRun: `cd api && pnpm vitest run src/lib/transcript-parsers/codex-parser.te