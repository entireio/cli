ctToolMetrics(sessionsMap: ...)` body in its entirety.\n\n3. Add the new function:\n\n```ts\nexport interface ParsedSessionForMetrics {\n  agent: string\n  messages: TranscriptMessage[]\n}\n\nexport function extractToolMetricsFromSessions(sessions: ParsedSessionForMetrics[]): {\n  skillsUsed: string[]\n  mcpServersUsed: { name: string; count: number }[]\n  toolProfile: ToolProfile | null\n} {\n  const skills = new Set<string>()\n  const mcpCounts = new Map<string, number>()\n  const counts: Record<ToolMixCategoryKey, number> = {\n    shell: 0,\n    fileOps: 0,\n    search: 0,\n    mcp: 0,\n    agent: 0,\n    other: 0,\n  }\n  let total = 0\n\n  for (const session of sessions) {\n    const parser = getParserForAgent(session.agent)\n    for (const message of session.messages) {\n      for (const call of message.toolCalls ?? []) {\n        total++\n        const cat = parser.classifyTool?.(call) ?? \"other\"\n        counts[cat]++\n\n        const skill = parser.extractSkillFromTool?.(call)\n        if (skill) skills.add(skill)\n\n        const mcpServer = parser.extractMcpServerFromTool?.(call)\n        if (mcpServer) {\n          mcpCounts.set(mcpServer, (mcpCounts.get(mcpServer) ?? 0) + 1)\n        }\n      }\n    }\n  }\n\n  let toolProfile: ToolProfile | null = null\n  if (total > 0) {\n    const categories = Object.fromEntries(\n      TOOL_MIX_CATEGORY_KEYS.map((k) => [k, { count: counts[k] }]),\n    ) as Record<ToolMixCategoryKey, { count: number }>\n    toolProfile = { categories, total }\n  }\n\n  return {\n    skillsUsed: Array.from(skills),\n    mcpServersUsed: Array.from(mcpCounts.entries())\n      .map(([name, count]) => ({ name, count }))\n      .sort((a, b) => b.count - a.count),\n    toolProfile,\n  }\n}\n```\n\n- [ ] **Step 4: Update the single in-tree caller**\n\nFind the existing `extractToolMetrics(loaded.sessionsMap)` call at `analysis-queue.ts:161-163` (a few lines after the line number drifted from \"159\" — grep for the call to be sure) and repl