{"parentUuid":"856d354a-381b-4185-a61b-23d46ae4beb0","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/agent/pi/lifecycle.go","snippet":"1\tpackage pi\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"log/slog\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n18\t)\n19\t\n20\t// Hook names — these match Pi's native event names exactly (snake_case),\n21\t// because the embedded TypeScript extension forwards `pi.on(<event>)` events\n22\t// directly. Keeping the names identical avoids a translation layer in the\n23\t// extension.\n24\tconst (\n25\t\tHookNameSessionStart     = \"session_start\"\n26\t\tHookNameBeforeAgentStart = \"before_agent_start\"\n27\t\tHookNameAgentEnd         = \"agent_end\"\n28\t\tHookNameSessionShutdown  = \"session_shutdown\"\n29\t)\n30\t\n31\t// HookNames returns the verbs registered as `entire hooks pi <name>`.\n32\tfunc (a *PiAgent) HookNames() []string {\n33\t\treturn []string{\n34\t\t\tHookNameSessionStart,\n35\t\t\tHookNameBeforeAgentStart,\n36\t\t\tHookNameAgentEnd,\n37\t\t\tHookNameSessionShutdown,\n38\t\t}\n39\t}\n40\t\n41\t// GetSupportedHooks maps Pi's native events to normalised lifecycle types.\n42\t//\n43\t//   - session_start       → SessionStart\n44\t//   - before_agent_start  → TurnStart\n45\t//   - agent_end           → TurnEnd\n46\t//   - session_shutdown    → SessionEnd\n47\tfunc (a *PiAgent) GetSupportedHooks() []agent.HookType {\n48\t\treturn []agent.HookType{\n49\t\t\tagent.HookSessionStart,\n50\t\t\tagent.HookSessionEnd,\n51\t\t\tagent.HookUserPromptSubmit,\n52\t\t\tagent.HookStop,\n53\t\t}\n54\t}\n55\t\n56\t// piHookPayload is the JSON the embedded TypeScript extension pipes to\n57\t// `entire hooks pi <event>` on stdin.\n58\ttype piHookPayload struct {\n59\t\tType        string `json:\"type\"`\n60\t\tCwd         string `json:\"cwd,omitempty\"`\n61\t\tSessionFile string `json:\"session_file,omitempty\"`\n62\t\tSessionID   string `json:\"session_id,omitempty\"`\n63\t\tPrompt      string `json:\"prompt,omitempty\"`\n64\t}\n65\t\n66\t// ParseHookEvent translates a Pi hook invocation into a normalised lifecycle\n67\t// event. Implements agent.HookSupport.\n68\tfunc (a *PiAgent) ParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n69\t\tdata, err := io.ReadAll(stdin)\n70\t\tif err != nil {\n71\t\t\treturn nil, fmt.Errorf(\"read pi hook input: %w\", err)\n72\t\t}\n73\t\tif len(data) == 0 {\n74\t\t\treturn nil, errors.New(\"empty pi hook input\")\n75\t\t}\n76\t\n77\t\tvar payload piHookPayload\n78\t\tif err := json.Unmarshal(data, &payload); err != nil {\n79\t\t\treturn nil, fmt.Errorf(\"parse pi hook payload: %w\", err)\n80\t\t}\n81\t\n82\t\tsessionID := payload.SessionID\n83\t\tif sessionID == \"\" {\n84\t\t\tsessionID = extractSessionIDFromPath(payload.SessionFile)\n85\t\t}\n86\t\n87\t\tnow := time.Now()\n88\t\n89\t\tswitch hookName {\n90\t\tcase HookNameSessionStart:\n91\t\t\tcacheSessionID(ctx, sessionID)\n92\t\t\treturn &agent.Event{\n93\t\t\t\tType:      agent.SessionStart,\n94\t\t\t\tSessionID: sessionID,\n95\t\t\t\tTimestamp: now,\n96\t\t\t}, nil\n97\t\n98\t\tcase HookNameBeforeAgentStart:\n99\t\t\t// Pi emits before_agent_start with a fully-populated session ID, but\n100\t\t\t// we cache it anyway to support the agent_end fallback below.\n101\t\t\tif sessionID == \"\" {\n102\t\t\t\tsessionID = readCachedSessionID(ctx)\n103\t\t\t} else {\n104\t\t\t\tcacheSessionID(ctx, sessionID)\n105\t\t\t}\n106\t\t\t// Provide the live Pi session file as SessionRef so state.TranscriptPath\n107\t\t\t// is populated before any mid-turn commits. Without this, the\n108\t\t\t// post-commit hook cannot condense when no shadow branch exists yet.\n109\t\t\treturn &agent.Event{\n110\t\t\t\tType:       agent.TurnStart,\n111\t\t\t\tSessionID:  sessionID,\n112\t\t\t\tSessionRef: payload.SessionFile,\n113\t\t\t\tPrompt:     payload.Prompt,\n114\t\t\t\tTimestamp:  now,\n115\t\t\t}, nil\n116\t\n117\t\tcase HookNameAgentEnd:\n118\t\t\tif sessionID == \"\" {\n119\t\t\t\tsessionID = readCachedSessionID(ctx)\n120\t\t\t}\n121\t\t\t// Capture the Pi JSONL into <repo>/.entire/tmp/pi/<id>.json so the\n122\t\t\t// strategy has a stable transcript reference even if the user later\n123\t\t\t// deletes Pi sessions. The pi/ subdir avoids colliding with paths\n124\t\t\t// other agents (or test harnesses) stage under .entire/tmp/.\n125\t\t\tsessionRef := captureTranscript(ctx, sessionID, payload.SessionFile)\n126\t\t\treturn &agent.Event{\n127\t\t\t\tType:       agent.TurnEnd,\n128\t\t\t\tSessionID:  sessionID,\n129\t\t\t\tSessionRef: sessionRef,\n130\t\t\t\tTimestamp:  now,\n131\t\t\t}, nil\n132\t\n133\t\tcase HookNameSessionShutdown:\n134\t\t\t// The TS extension's session_shutdown payload carries no session_id /\n135\t\t\t// session_file, so recover the active session ID from the cache before\n136\t\t\t// clearing it. Without this the SessionEnd event would have empty\n137\t\t\t// SessionID and the strategy couldn't identify which session ended.\n138\t\t\tif sessionID == \"\" {\n139\t\t\t\tsessionID = readCachedSessionID(ctx)\n140\t\t\t}\n141\t\t\tclearCachedSessionID(ctx)\n142\t\t\treturn &agent.Event{\n143\t\t\t\tType:      agent.SessionEnd,\n144\t\t\t\tSessionID: sessionID,\n145\t\t\t\tTimestamp: now,\n146\t\t\t}, nil\n147\t\n148\t\tdefault:\n149\t\t\t// Unknown / future hooks have no lifecycle significance.\n150\t\t\treturn nil, nil //nolint:nilnil // unknown hook = no lifecycle event (acceptable)\n151\t\t}\n152\t}\n153\t\n154\t// --- session ID cache ---\n155\t//\n156\t// Pi's `before_agent_start` event sometimes fires before `session_start` has\n157\t// completed cacheing the session ID (race during early extension load), and\n158\t// `agent_end` may fire after Pi has torn down its session manager. We cache\n159\t// the active session ID at session_start time so subsequent hooks can recover\n160\t// it.\n161\t\n162\tconst activeSessionFile = \"pi-active-session\"\n163\t\n164\t// resolveSessionDir returns the per-repo Pi staging directory.\n165\t// Mirrors GetSessionDir: <repo>/.entire/tmp/pi.\n166\tfunc resolveSessionDir(ctx context.Context) string {\n167\t\troot, err := paths.WorktreeRoot(ctx)\n168\t\tif err != nil {\n169\t\t\t//nolint:forbidigo // fallback when no git repo (tests run outside repos)\n170\t\t\twd, wdErr := os.Getwd()\n171\t\t\tif wdErr != nil {\n172\t\t\t\treturn filepath.Join(paths.EntireTmpDir, piSessionSubdir)\n173\t\t\t}\n174\t\t\troot = wd\n175\t\t}\n176\t\treturn filepath.Join(root, paths.EntireTmpDir, piSessionSubdir)\n177\t}\n178\t\n179\tfunc cacheSessionID(ctx context.Context, id string) {\n180\t\tif id == \"\" {\n181\t\t\treturn\n182\t\t}\n183\t\tdir := resolveSessionDir(ctx)\n184\t\tif err := os.MkdirAll(dir, 0o750); err != nil {\n185\t\t\tlogging.Debug(ctx, \"pi: cache session id mkdir\", slog.String(\"err\", err.Error()))\n186\t\t\treturn\n187\t\t}\n188\t\n189\t\tif err := os.WriteFile(filepath.Join(dir, activeSessionFile), []byte(id), 0o600); err != nil {\n190\t\t\tlogging.Debug(ctx, \"pi: cache session id write\", slog.String(\"err\", err.Error()))\n191\t\t}\n192\t}\n193\t\n194\tfunc readCachedSessionID(ctx context.Context) string {\n195\t\tdir := resolveSessionDir(ctx)\n196\t\t//nolint:gosec // path constructed from validated repo root\n197\t\tdata, err := os.ReadFile(filepath.Join(dir, activeSessionFile))\n198\t\tif err != nil {\n199\t\t\treturn \"\"\n200\t\t}\n201\t\treturn strings.TrimSpace(string(data))\n202\t}\n203\t\n204\tfunc clearCachedSessionID(ctx context.Context) {\n205\t\tdir := resolveSessionDir(ctx)\n206\t\t_ = os.Remove(filepath.Join(dir, activeSessionFile))\n207\t}\n208\t\n209\t// captureTranscript copies the Pi JSONL session file to\n210\t// <repo>/.entire/tmp/pi/<id>.json so Entire has a stable transcript\n211\t// reference. Returns the path to the cached file, or \"\" if either input is\n212\t// missing. The pi/ namespace under .entire/tmp/ is intentional — see\n213\t// GetSessionDir / piSessionSubdir for the rationale.\n214\tfunc captureTranscript(ctx context.Context, sessionID, piSessionFile string) string {\n215\t\tif sessionID == \"\" || piSessionFile == \"\" {\n216\t\t\treturn \"\"\n217\t\t}\n218\t\tdir := resolveSessionDir(ctx)\n219\t\tif err := os.MkdirAll(dir, 0o750); err != nil {\n220\t\t\tlogging.Warn(ctx, \"pi: capture transcript mkdir failed\",\n221\t\t\t\tslog.String(\"dir\", dir), slog.String(\"err\", err.Error()))\n222\t\t\treturn \"\"\n223\t\t}\n224\t\tdst := filepath.Join(dir, sessionID+\".json\")\n225\t\t//nolint:gosec // G703: piSessionFile from trusted Pi extension stdin payload\n226\t\tdata, err := os.ReadFile(piSessionFile)\n227\t\tif err != nil {\n228\t\t\tlogging.Warn(ctx, \"pi: capture transcript read failed\",\n229\t\t\t\tslog.String(\"src\", piSessionFile), slog.String(\"err\", err.Error()))\n230\t\t\treturn \"\"\n231\t\t}\n\n... [24 lines truncated] ..."},"type":"attachment","uuid":"01cb81e4-9ab5-41ed-a812-6a977ae39996","timestamp":"2026-05-09T21:48:19.924Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli","sessionId":"824c9ef4-e4d5-49d7-ad05-c34c07511466","version":"2.1.136","gitBranch":"soph/pi-cold-attach-and-e2e"}
{"parentUuid":"01cb81e4-9ab5-41ed-a812-6a977ae39996","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/agent/pi/lifecycle_test.go","snippet":"1\tpackage pi\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t\n10\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n11\t)\n12\t\n13\tfunc TestParseHookEvent_SessionStart(t *testing.T) {\n14\t\tt.Parallel()\n15\t\ta := &PiAgent{}\n16\t\tstdin := strings.NewReader(`{\"type\":\"session_start\",\"cwd\":\"/repo\",\"session_file\":\"/tmp/2026-05-09T12-00-00-000Z_abc-123.jsonl\"}`)\n17\t\tev, err := a.ParseHookEvent(context.Background(), HookNameSessionStart, stdin)\n18\t\tif err != nil {\n19\t\t\tt.Fatalf(\"ParseHookEvent: %v\", err)\n20\t\t}\n21\t\tif ev.Type != agent.SessionStart {\n22\t\t\tt.Errorf(\"Type = %v\", ev.Type)\n23\t\t}\n24\t\tif ev.SessionID != \"abc-123\" {\n25\t\t\tt.Errorf(\"SessionID = %q (want abc-123 extracted from filename)\", ev.SessionID)\n26\t\t}\n27\t}\n28\t\n29\tfunc TestParseHookEvent_BeforeAgentStart(t *testing.T) {\n30\t\tt.Parallel()\n31\t\ta := &PiAgent{}\n32\t\tstdin := strings.NewReader(`{\"type\":\"before_agent_start\",\"session_file\":\"/tmp/2026-05-09T12-00-00-000Z_abc-123.jsonl\",\"prompt\":\"do thing\"}`)\n33\t\tev, err := a.ParseHookEvent(context.Background(), HookNameBeforeAgentStart, stdin)\n34\t\tif err != nil {\n35\t\t\tt.Fatalf(\"ParseHookEvent: %v\", err)\n36\t\t}\n37\t\tif ev.Type != agent.TurnStart {\n38\t\t\tt.Errorf(\"Type = %v, want TurnStart\", ev.Type)\n39\t\t}\n40\t\tif ev.Prompt != \"do thing\" {\n41\t\t\tt.Errorf(\"Prompt = %q\", ev.Prompt)\n42\t\t}\n43\t\tif ev.SessionRef != \"/tmp/2026-05-09T12-00-00-000Z_abc-123.jsonl\" {\n44\t\t\tt.Errorf(\"SessionRef = %q\", ev.SessionRef)\n45\t\t}\n46\t}\n47\t\n48\tfunc TestParseHookEvent_SessionShutdown(t *testing.T) {\n49\t\tt.Parallel()\n50\t\ta := &PiAgent{}\n51\t\tstdin := strings.NewReader(`{\"