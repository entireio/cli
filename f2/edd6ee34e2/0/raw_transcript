rseHookEvent(context.Background(), HookNameSessionStart, strings.NewReader(\"\"))\n101\t\tif err == nil {\n102\t\t\tt.Error(\"expected error on empty stdin\")\n103\t\t}\n104\t}\n105\t\n106\tfunc TestParseHookEvent_UnknownHookYieldsNoEvent(t *testing.T) {\n107\t\tt.Parallel()\n108\t\ta := &PiAgent{}\n109\t\t// Anything not in HookNames() is treated as a no-op.\n110\t\tev, err := a.ParseHookEvent(context.Background(), \"some_unknown_event\", strings.NewReader(`{\"type\":\"unknown\"}`))\n111\t\tif err != nil {\n112\t\t\tt.Fatalf(\"err: %v\", err)\n113\t\t}\n114\t\tif ev != nil {\n115\t\t\tt.Errorf(\"expected nil event for unknown hook, got %+v\", ev)\n116\t\t}\n117\t}\n118\t\n119\tfunc TestExtractSessionIDFromPath(t *testing.T) {\n120\t\tt.Parallel()\n121\t\tcases := map[string]string{\n122\t\t\t\"\": \"\",\n123\t\t\t\"/tmp/2026-05-09T12-00-00-000Z_abc-123.jsonl\": \"abc-123\",\n124\t\t\t\"abc-123.jsonl\":                             \"abc-123\",\n125\t\t\t\"/tmp/no-underscore-here.jsonl\":             \"no-underscore-here\",\n126\t\t\t\"/path/with/multiple_under_scores_id.jsonl\": \"id\",\n127\t\t}\n128\t\tfor in, want := range cases {\n129\t\t\tif got := extractSessionIDFromPath(in); got != want {\n130\t\t\t\tt.Errorf(\"extractSessionIDFromPath(%q) = %q, want %q\", in, got, want)\n131\t\t\t}\n132\t\t}\n133\t}\n134\t\n135\tfunc TestSessionIDCacheRoundtrip(t *testing.T) {\n136\t\t// Cannot use t.Parallel — t.Chdir mutates process state.\n137\t\tdir := t.TempDir()\n138\t\tt.Chdir(dir)\n139\t\n140\t\tctx := context.Background()\n141\t\tif got := readCachedSessionID(ctx); got != \"\" {\n142\t\t\tt.Errorf(\"expected empty cache initially, got %q\", got)\n143\t\t}\n144\t\tcacheSessionID(ctx, \"abc-123\")\n145\t\tif got := readCachedSessionID(ctx); got != \"abc-123\" {\n146\t\t\tt.Errorf(\"readCachedSessionID = %q, want abc-123\", got)\n147\t\t}\n148\t\tclearCachedSessionID(ctx)\n149\t\tif got := readCachedSessionID(ctx); got != \"\" {\n150\t\t\tt.Errorf(\"after clear, got %