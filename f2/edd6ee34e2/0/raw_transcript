ayload := `{\"type\":\"session_start\",\"cwd\":\"/test\",\"session_file\":\"/tmp/2026-01-01T00-00-00-000Z_test-uuid.jsonl\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameSessionStart, strings.NewReader(payload))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif event == nil {\n\t\tt.Fatal(\"expected non-nil event\")\n\t}\n\tif event.Type != agent.SessionStart {\n\t\tt.Errorf(\"Type = %v, want SessionStart\", event.Type)\n\t}\n\tif event.SessionID != \"test-uuid\" {\n\t\tt.Errorf(\"SessionID = %q, want %q\", event.SessionID, \"test-uuid\")\n\t}\n}\n\nfunc TestParseHookEvent_TurnStart(t *testing.T) {\n\tt.Parallel()\n\tag := newTestAgent(t)\n\tpayload := `{\"type\":\"before_agent_start\",\"cwd\":\"/test\",\"session_file\":\"/tmp/2026-01-01T00-00-00-000Z_test-uuid.jsonl\",\"prompt\":\"hello\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameBeforeAgentStart, strings.NewReader(payload))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif event == nil {\n\t\tt.Fatal(\"expected non-nil event\")\n\t}\n\tif event.Type != agent.TurnStart {\n\t\tt.Errorf(\"Type = %v, want TurnStart\", event.Type)\n\t}\n\tif event.Prompt != \"hello\" {\n\t\tt.Errorf(\"Prompt = %q, want %q\", event.Prompt, \"hello\")\n\t}\n}\n\nfunc TestParseHookEvent_TurnEnd(t *testing.T) {\n\tt.Parallel()\n\tag := newTestAgent(t)\n\tpayload := `{\"type\":\"agent_end\",\"cwd\":\"/test\",\"session_file\":\"/tmp/2026-01-01T00-00-00-000Z_test-uuid.jsonl\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameAgentEnd, strings.NewReader(payload))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif event == nil {\n\t\tt.Fatal(\"expected non-nil event\")\n\t}\n\tif event.Type != agent.TurnEnd {\n\t\tt.Errorf(\"Type = %v, want TurnEnd\", event.Type)\n\t}\n}\n\nfunc TestParseHookEvent_SessionShutdown(t *testing.T) {\n\tt.Parallel()\n\tag := newTestAgent(t)\n\tpayload := `{\"type\":\"session_shutdown\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameS