gent_end\"\n\tHookNameSessionShutdown  = \"session_shutdown\"\n)\n\n// piHookPayload is the JSON the TypeScript extension sends to\n// `entire hooks pi <event>`.\ntype piHookPayload struct {\n\tType         string `json:\"type\"`\n\tCwd          string `json:\"cwd,omitempty\"`\n\tSessionFile  string `json:\"session_file,omitempty\"`\n\tSessionID    string `json:\"session_id,omitempty\"`\n\tPrompt       string `json:\"prompt,omitempty\"`\n\tMessageCount int    `json:\"message_count,omitempty\"`\n\tTurnIndex    int    `json:\"turn_index,omitempty\"`\n}\n\n// HookNames returns the hook verbs Pi supports.\nfunc (p *PiAgent) HookNames() []string {\n\treturn []string{\n\t\tHookNameSessionStart,\n\t\tHookNameBeforeAgentStart,\n\t\tHookNameAgentEnd,\n\t\tHookNameSessionShutdown,\n\t}\n}\n\n// ParseHookEvent translates a Pi hook into a normalized lifecycle Event.\n// Returns nil if the hook has no lifecycle significance.\nfunc (p *PiAgent) ParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n\tconst maxHookBytes = 10 * 1024 * 1024\n\tdata, err := io.ReadAll(io.LimitReader(stdin, maxHookBytes))\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read hook input: %w\", err)\n\t}\n\tif len(data) == 0 {\n\t\treturn nil, nil //nolint:nilnil // empty input → no event\n\t}\n\n\tvar payload piHookPayload\n\tif err := json.Unmarshal(data, &payload); err != nil {\n\t\treturn nil, fmt.Errorf(\"parse hook payload: %w\", err)\n\t}\n\n\tsessionID := payload.SessionID\n\tif sessionID == \"\" {\n\t\tsessionID = extractSessionIDFromPath(payload.SessionFile)\n\t}\n\n\trepoRoot := repoRootForCtx(ctx)\n\tnow := time.Now().UTC()\n\n\tswitch hookName {\n\tcase HookNameSessionStart:\n\t\tcacheSessionID(repoRoot, sessionID)\n\t\treturn &agent.Event{\n\t\t\tType:      agent.SessionStart,\n\t\t\tSessionID: sessionID,\n\t\t\tTimestamp: now,\n\t\t}, nil\n\n\tcase HookNameBeforeAgentStart:\n\t\tif sessionID == \"\" {\n\t\t\tsessionID = readCachedSessionID(repoRoot)\n\t\t} else {\n\t\t\tcacheSessionID(repoRoot, sessionID)\n\t\t}\n\t\t// Provide the live Pi session file as SessionRef so state.TranscriptPath\n\t\t// is populated before any mid-turn commits — without it, the post-commit\n\t\t// hook can't condense when no shadow branch exists yet.\n\t\treturn &agent.Event{\n\t\t\tType:       agent.TurnStart,\n\t\t\tSessionID:  sessionID,\n\t\t\tSessionRef: payload.SessionFile,\n\t\t\tPrompt:     payload.Prompt,\n\t\t\tTimestamp:  now,\n\t\t}, nil\n\n\tcase HookNameAgentEnd:\n\t\tif sessionID == \"\" {\n\t\t\tsessionID = readCachedSessionID(repoRoot)\n\t\t}\n\t\tsessionRef := captureTranscript(repoRoot, sessionID, payload.SessionFile)\n\t\treturn &agent.Event{\n\t\t\tType:       agent.TurnEnd,\n\t\t\tSessionID:  sessionID,\n\t\t\tSessionRef: sessionRef,\n\t\t\tTimestamp:  now,\n\t\t}, nil\n\n\tcase HookNameSessionShutdown:\n\t\tclearCachedSessionID(repoRoot)\n\t\treturn nil, nil //nolint:nilnil // shutdown → cleanup only, no lifecycle event\n\n\tdefault:\n\t\treturn nil, nil //nolint:nilnil // unknown hooks have no lifecycle action\n\t}\n}\n\n// InstallHooks writes a TypeScript extension that forwards Pi lifecycle events\n// to `entire hooks pi <event>`.\nfunc (p *PiAgent) InstallHooks(ctx context.Context, _ bool, force bool) (int, error) {\n\troot, err := repoRoot(ctx)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\tif !force && hooksInstalledAt(root) {\n\t\treturn 0, nil\n\t}\n\n\tdir := filepath.Join(root, extensionDir)\n\tif err := os.MkdirAll(dir, 0o750); err != nil {\n\t\treturn 0, fmt.Errorf(\"create extension dir: %w\", err)\n\t}\n\n\tpath := filepath.Join(root, extensionFile)\n\tif err := os.WriteFile(path, []byte(generateExtension()), 0o600); err != nil {\n\t\treturn 0, fmt.Errorf(\"write extension: %w\", err)\n\t}\n\n\treturn 4, nil\n}\n\n// UninstallHooks removes the Entire extension directory.\nfunc (p *PiAgent) UninstallHooks(ctx context.Context) error {\n\troot, err := repoRoot(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.RemoveAll(filepath.Join(root, extensionDir))\n}\n\n// AreHooksInstalled checks whether the Entire extension file exists.\nfunc (p *PiAgent) AreHooksInstalled(ctx context.Context) bool {\n\troot, err := repoRoot(ctx)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn hooksInstalledAt(root)\n}\n\nfunc hooksInstalledAt(root string) bool {\n\t_, err := os.Stat(filepath.Join(root, extensionFile))\n\treturn err == nil\n}\n\nfunc repoRoot(ctx context.Context) (string, error) {\n\troot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\tcwd, gwErr := os.Getwd() //nolint:forbidigo // intentional fallback when WorktreeRoot fails\n\t\tif gwErr != nil {\n\t\t\treturn \"\", fmt.Errorf(\"resolve repo root: %w\", errors.Join(err, gwErr))\n\t\t}\n\t\treturn cwd, nil\n\t}\n\treturn root, nil\n}\n\n// repoRootForCtx returns the repo root, falling back to cwd silently. Used by\n// hook parsers that should never fail outright if WorktreeRoot fails.\nfunc repoRootForCtx(ctx context.Context) string {\n\troot, err := repoRoot(ctx)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\treturn root\n}\n\nfunc sessionCacheDir(root string) string {\n\treturn filepath.Join(root, \".entire\", \"tmp\")\n}\n\nfunc cacheSessionID(root, id string) {\n\tif id == \"\" || root == \"\" {\n\t\treturn\n\t}\n\tdir := sessionCacheDir(root)\n\t_ = os.MkdirAll(dir, 0o750)\n\t_ = os.WriteFile(filepath.Join(dir, activeSessionFile), []byte(id), 0o600)\n}\n\nfunc readCachedSessionID(root string) string {\n\tif root == \"\" {\n\t\treturn \"\"\n\t}\n\tdata, err := os.ReadFile(filepath.Join(sessionCacheDir(root), activeSessionFile))\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\treturn string(data)\n}\n\nfunc clearCachedSessionID(root string) {\n\tif root == \"\" {\n\t\treturn\n\t}\n\t_ = os.Remove(filepath.Join(sessionCacheDir(root), activeSessionFile))\n}\n\n// captureTranscript copies the Pi JSONL session file to .entire/tmp/<id>.json\n// so that Entire can read the transcript. Returns the cached path