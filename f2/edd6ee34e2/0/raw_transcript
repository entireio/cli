review() bool { return true }\n\n// DetectPresence checks whether the Pi binary is on PATH.\nfunc (p *PiAgent) DetectPresence(_ context.Context) (bool, error) {\n\t_, err := exec.LookPath(\"pi\")\n\treturn err == nil, nil\n}\n\n// ProtectedDirs returns directories that Pi uses for config/state.\nfunc (p *PiAgent) ProtectedDirs() []string { return []string{\".pi\"} }\n\n// GetSessionID extracts the session ID from hook input.\nfunc (p *PiAgent) GetSessionID(input *agent.HookInput) string {\n\tif input != nil && input.SessionID != \"\" {\n\t\treturn input.SessionID\n\t}\n\treturn \"\"\n}\n\n// GetSessionDir returns the directory where Entire caches Pi session data.\n// Pi stores native sessions under ~/.pi/agent/sessions, but Entire keeps a\n// per-repo cache at .entire/tmp so attach/rewind has a stable location.\nfunc (p *PiAgent) GetSessionDir(repoPath string) (string, error) {\n\treturn filepath.Join(repoPath, \".entire\", \"tmp\"), nil\n}\n\n// ResolveSessionFile returns the cached transcript path for a session ID.\nfunc (p *PiAgent) ResolveSessionFile(sessionDir, sessionID string) string {\n\treturn filepath.Join(sessionDir, sessionID+\".json\")\n}\n\n// ReadSession reads a session from Pi's storage (JSONL session file).\nfunc (p *PiAgent) ReadSession(input *agent.HookInput) (*agent.AgentSession, error) {\n\tif input == nil || input.SessionRef == \"\" {\n\t\treturn nil, errors.New(\"session reference (transcript path) is required\")\n\t}\n\n\tdata, err := os.ReadFile(input.SessionRef)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read session file: %w\", err)\n\t}\n\n\tsessionID := input.SessionID\n\tif sessionID == \"\" {\n\t\tsessionID = extractSessionIDFromPath(input.SessionRef)\n\t}\n\n\tstartTime, _ := parseSessionStartTime(data)\n\n\treturn &agent.AgentSession{\n\t\tSessionID:  sessionID,\n\t\tAgentName:  p.Name(),\n\t\tSessionRef: input.SessionRef,\n\t\tStartTime:  startTime,\n\t\tNativeData: data,\n\t}, nil\n}\n\n// WriteSession writes a session to Pi's storage.\nfunc (p *PiAgent) WriteSession(_ context.Context, session *agent.AgentSession) error {\n\tif session == nil {\n\t\treturn errors.New(\"session is nil\")\n\t}\n\tif session.AgentName != \"\" && session.AgentName != p.Name() {\n\t\treturn fmt.Errorf(\"session belongs to agent %q, not %q\", session.AgentName, p.Name())\n\t}\n\tif session.SessionRef == \"\" {\n\t\treturn errors.New(\"session reference (transcript path) is required\")\n\t}\n\tif err := os.MkdirAll(filepath.Dir(session.SessionRef), 0o700); err != nil {\n\t\treturn fmt.Errorf(\"create session dir: %w\", err)\n\t}\n\tif err := os.WriteFile(session.SessionRef, session.NativeData, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"write session file: %w\", err)\n\t}\n\treturn nil\n}\n\n// FormatResumeCommand returns the command to resume a Pi session.\nfunc (p *PiAgent) FormatResumeCommand(_ string) string {\n\treturn \"pi --continue\"\n}\n\n// ReadTranscript reads the raw JSONL transcript bytes for a session.\nfunc (p *PiAgent) ReadTranscript(sessionRef string) ([]byte, error) {\n\tdata, err := os.ReadFile(sessionRef) //nolint:gosec // path comes from agent hook input\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read transcript: %w\", err)\n\t}\n\treturn data, nil\n}\n\n// ChunkTranscript splits a JSONL transcript at line boundaries.\nfunc (p *PiAgent) ChunkTranscript(_ context.Context, content []byte, maxSize int) ([][]byte, error) {\n\tchunks, err := agent.ChunkJSONL(content, maxSize)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"chunk JSONL transcript: %w\", err)\n\t}\n\treturn chunks, nil\n}\n\n// ReassembleTranscript concatenates JSONL chunks with newlines.\nfunc (p *PiAgent) ReassembleTranscript(chunks [][]byte) ([]byte, error) {\n\treturn agent.ReassembleJSONL(chunks), nil\n}\n","structuredPatch":[{"oldStart":91,"oldLines":7,"newStart":91,"newLines":7,"lines":["     sessionID = extractSessionIDFromPath(input.SessionRef)","   }"," ","-  startTime, _ := parseSessionStartTime(data)","+  sta