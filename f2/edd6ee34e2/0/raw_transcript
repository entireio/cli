{"parentUuid":"3b2621e6-0831-4a66-af03-15fb6b233045","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/agent/pi/lifecycle.go","snippet":"1\tpackage pi\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"log/slog\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n18\t)\n19\t\n20\t// Hook names — these match Pi's native event names exactly (snake_case),\n21\t// because the embedded TypeScript extension forwards `pi.on(<event>)` events\n22\t// directly. Keeping the names identical avoids a translation layer in the\n23\t// extension.\n24\tconst (\n25\t\tHookNameSessionStart     = \"session_start\"\n26\t\tHookNameBeforeAgentStart = \"before_agent_start\"\n27\t\tHookNameAgentEnd         = \"agent_end\"\n28\t\tHookNameSessionShutdown  = \"session_shutdown\"\n29\t)\n30\t\n31\t// HookNames returns the verbs registered as `entire hooks pi <name>`.\n32\tfunc (a *PiAgent) HookNames() []string {\n33\t\treturn []string{\n34\t\t\tHookNameSessionStart,\n35\t\t\tHookNameBeforeAgentStart,\n36\t\t\tHookNameAgentEnd,\n37\t\t\tHookNameSessionShutdown,\n38\t\t}\n39\t}\n40\t\n41\t// GetSupportedHooks maps Pi's native events to normalised lifecycle types.\n42\t//\n43\t//   - session_start       → SessionStart\n44\t//   - before_agent_start  → TurnStart\n45\t//   - agent_end           → TurnEnd\n46\t//   - session_shutdown    → (cleanup-only, no lifecycle event — see ParseHookEvent)\n47\tfunc (a *PiAgent) GetSupportedHooks() []agent.HookType {\n48\t\treturn []agent.HookType{\n49\t\t\tagent.HookSessionStart,\n50\t\t\tagent.HookUserPromptSubmit,\n51\t\t\tagent.HookStop,\n52\t\t}\n53\t}\n54\t\n55\t// piHookPayload is the JSON the embedded TypeScript extension pipes to\n56\t// `entire hooks pi <event>` on stdin.\n57\ttype piHookPayload struct {\n58\t\tType        string `json:\"type\"`\n59\t\tCwd         string `json:\"cwd,omitempty\"`\n60\t\tSessionFile string `json:\"session_file,omitempty\"`\n61\t\tSessionID   string `json:\"session_id,omitempty\"`\n62\t\tPrompt      string `json:\"prompt,omitempty\"`\n63\t}\n64\t\n65\t// ParseHookEvent translates a Pi hook invocation into a normalised lifecycle\n66\t// event. Implements agent.HookSupport.\n67\tfunc (a *PiAgent) ParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n68\t\tdata, err := io.ReadAll(stdin)\n69\t\tif err != nil {\n70\t\t\treturn nil, fmt.Errorf(\"read pi hook input: %w\", err)\n71\t\t}\n72\t\tif len(data) == 0 {\n73\t\t\treturn nil, errors.New(\"empty pi hook input\")\n74\t\t}\n75\t\n76\t\tvar payload piHookPayload\n77\t\tif err := json.Unmarshal(data, &payload); err != nil {\n78\t\t\treturn nil, fmt.Errorf(\"parse pi hook payload: %w\", err)\n79\t\t}\n80\t\n81\t\tsessionID := payload.SessionID\n82\t\tif sessionID == \"\" {\n83\t\t\tsessionID = extractSessionIDFromPath(payload.SessionFile)\n84\t\t}\n85\t\n86\t\tnow := time.Now()\n87\t\n88\t\tswitch hookName {\n89\t\tcase HookNameSessionStart:\n90\t\t\tcacheSessionID(ctx, sessionID)\n91\t\t\treturn &agent.Event{\n92\t\t\t\tType:      agent.SessionStart,\n93\t\t\t\tSessionID: sessionID,\n94\t\t\t\tTimestamp: now,\n95\t\t\t}, nil\n96\t\n97\t\tcase HookNameBeforeAgentStart:\n98\t\t\t// Pi emits before_agent_start with a fully-populated session ID, but\n99\t\t\t// we cache it anyway to support the agent_end fallback below.\n100\t\t\tif sessionID == \"\" {\n101\t\t\t\tsessionID = readCachedSessionID(ctx)\n102\t\t\t} else {\n103\t\t\t\tcacheSessionID(ctx, sessionID)\n104\t\t\t}\n105\t\t\t// Provide the live Pi session file as SessionRef so state.TranscriptPath\n106\t\t\t// is populated before any mid-turn commits. Without this, the\n107\t\t\t// post-commit hook cannot condense whe