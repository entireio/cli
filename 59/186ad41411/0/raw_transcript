/modify action.\n   428\tfunc interleaveCommits(actions []action) []action {\n   429\t\tvar result []action\n   430\t\tfor _, a := range actions {\n   431\t\t\tresult = append(result, a)\n   432\t\t\tif a.kind == \"create\" || a.kind == \"modify\" {\n   433\t\t\t\tresult = append(result, action{kind: \"commit\"})\n   434\t\t\t}\n   435\t\t}\n   436\t\treturn result\n   437\t}\n   438\t\n   439\tfunc extractTopic(prompt string) string {\n   440\t\tif m := topicRe.FindStringSubmatch(prompt); m != nil {\n   441\t\t\treturn strings.TrimSpace(m[1])\n   442\t\t}\n   443\t\treturn \"the topic\"\n   444\t}\n   445\t\n   446\tfunc executeActions(dir string, actions []action) {\n   447\t\tvar pendingFiles []string\n   448\t\tfor _, a := range actions {\n   449\t\t\tswitch a.kind {\n   450\t\t\tcase \"create\":\n   451\t\t\t\tcreateFile(dir, a.path, a.content)\n   452\t\t\t\tpendingFiles = append(pendingFiles, a.path)\n   453\t\t\tcase \"modify\":\n   454\t\t\t\tmodifyFile(dir, a.path, a.content)\n   455\t\t\t\tpendingFiles = append(pendingFiles, a.path)\n   456\t\t\tcase \"delete\":\n   457\t\t\t\tdeleteFile(dir, a.path)\n   458\t\t\t\tpendingFiles = append(pendingFiles, a.path)\n   459\t\t\tcase \"commit\":\n   460\t\t\t\tgitCommit(dir, pendingFiles)\n   461\t\t\t\tpendingFiles = nil\n   462\t\t\t}\n   463\t\t}\n   464\t}\n   465\t\n   466\tfunc createFile(dir, path, content string) {\n   467\t\tabs := filepath.Join(dir, path)\n   468\t\tif err := os.MkdirAll(filepath.Dir(abs), 0o755); err != nil {\n   469\t\t\tfmt.Fprintf(os.Stderr, \"mkdir %s: %v\\n\", filepath.Dir(abs), err)\n   470\t\t\treturn\n   471\t\t}\n   472\t\tif err := os.WriteFile(abs, []byte(content), 0o644); err != nil {\n   473\t\t\tfmt.Fprintf(os.Stderr, \"write %s: %v\\n\", abs, err)\n   474\t\t}\n   475\t}\n   476\t\n   477\tfunc modifyFile(dir, path, appendContent string) {\n   478\t\tabs := filepath.Join(dir, path)\n   479\t\texisting, _ := os.ReadFile(abs)\n   480\t\tcontent := string(existing) + \"\\n\" + appendContent\n   481\t\tif err := os.WriteFile(abs, []byte(content), 0o644); err != nil {\n   482\t\t\tfmt.Fprintf(os.Stderr, \"write %s: %v\\n\", abs, err)\n   483\t\t}\n   484\t}\n   485\t\n   486\tfunc deleteFile(dir, path string) {\n   487\t\tabs := filepath.Join(dir, path)\n   488\t\tif err := os.Remove(abs); err != nil {\n   489\t\t\tfmt.Fprintf(os.Stderr, \"remove %s: %v\\n\", abs, err)\n   490\t\t}\n   491\t}\n   492\t\n   493\tfunc gitCommit(dir string, files []string) {\n   494\t\tif len(files) == 0 {\n   495\t\t\tgitRun(dir, \"add\", \".\")\n   496\t\t} else {\n   497\t\t\tgitRun(dir, append([]string{\"add\", \"--\"}, files...)...)\n   498\t\t}\n   499\t\tgitRun(dir, \"commit\", \"-m\", \"Vogon agent commit\")\n   500\t}\n   501\t\n   502\tfunc gitRun(dir string, args ...string) {\n   503\t\tcmd := exec.Command(\"git\", args...)\n   504\t\tcmd.Dir = dir\n   505\t\tcmd.Stdout = os.Stdout\n   506\t\tcmd.Stderr = os.Stderr\n   507\t\t// Signal that this is a non-interactive agent — git hooks should not\n   508\t\t// attempt TTY prompts. GIT_TERMINAL_PROMPT is the standard git env var\n   509\t\t// for this (same approach used by Factory AI Droid).\n   510\t\tcmd.Env = append(os.Environ(), \"GIT_TERMINAL_PROMPT=0\")\n   511\t\tif err := cmd.Run(); err != nil {\n   512\t\t\tfmt.Fprintf(os.Stderr, \"git %s: %v\\n\", strings.Join(args, \" \"), err)\n   513\t\t}\n   514\t}\n   515\t\n   516\t// --- Hook Firing ---\n   517\t\n   518\tfunc fireHook(dir, hookName string, payload any) {\n   519\t\tdata, err := json.Marshal(payload)\n   520\t\tif err != nil {\n   521\t\t\tfmt.Fprintf(os.Stderr, \"marshal hook payload: %v\\n\", err)\n   522\t\t\treturn\n   523\t\t}\n   524\t\n   525\t\tcmd := exec.Command(\"entire\", \"hooks\", \"vogon\", hookName)\n   526\t\tcmd.Dir = dir\n   527\t\tcmd.Stdin = bytes.NewReader(data)\n   528\t\tcmd.Env = append(os.Environ(), \"ENTIRE_TEST_TTY=0\")\n   529\t\t// Capture output but don't show it — hooks may output banners\n   530\t\tout, err := cmd.CombinedOutput()\n   531\t\tif err != nil {\n   532\t\t\tfmt.Fprintf(os.Stderr, \"hook %s failed: %v\\n%s\\n\", hookName, err, out)\n   533\t\t}\n   534\t}\n   535\t\n   536\t// --- Transcript ---\n   537\t\n   538\tfunc setupTranscript(sessionID string) string {\n   539\t\thome, err := os.UserHomeDir()\n   540\t\tif err != nil {\n   541\t\t\tfatal(\"home dir: %v\", err)\n   542\t\t}\n   543\t\ttranscriptDir := filepath.Join(home, \".vogon\", \"sessions\")\n   544\t\tif err := os.MkdirAll(transcriptDir, 0o755); err != nil {\n   545\t\t\tfatal(\"mkdir transcript dir: %v\", err)\n   546\t\t}\n   547\t\tpath := filepath.Join(transcriptDir, sessionID+\".jsonl\")\n   548\t\t// Create empty file\n   549\t\tif err := os.WriteFile(path, nil, 0o644); err != nil {\n   550\t\t\tfatal(\"create transcript: %v\", err)\n   551\t\t}\n   552\t\treturn path\n   553\t}\n   554\t\n   555\ttype transcriptEntry struct {\n   556\t\tType      string `json:\"type\"`\n   557\t\tTimestamp string `json:\"timestamp\"`\n   558\t\tMessage   string `json:\"message\"`\n   559\t}\n   560\t\n"}}
