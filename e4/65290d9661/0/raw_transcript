ckpointID(points []strategy.RewindPoint) []checkpointGroup {\n  1358→\tif len(points) == 0 {\n  1359→\t\treturn nil\n  1360→\t}\n  1361→\n  1362→\t// Build map of checkpoint ID -> group\n  1363→\tgroupMap := make(map[string]*checkpointGroup)\n  1364→\tvar order []string // Track insertion order for stable iteration\n  1365→\n  1366→\tfor _, point := range points {\n  1367→\t\t// Determine the checkpoint ID to use for grouping\n  1368→\t\tcpID := point.CheckpointID.String()\n  1369→\t\tif cpID == \"\" {\n  1370→\t\t\t// Temporary checkpoints: group by session ID to preserve per-session prompts\n  1371→\t\t\t// Use session ID prefix for readability (format: YYYY-MM-DD-uuid)\n  1372→\t\t\tcpID = point.SessionID\n  1373→\t\t\tif cpID == \"\" {\n  1374→\t\t\t\tcpID = \"temporary\" // Fallback if no session ID\n  1375→\t\t\t}\n  1376→\t\t}\n  1377→\n  1378→\t\tgroup, exists := groupMap[cpID]\n  1379→\t\tif !exists {\n  1380→\t\t\tgroup = &checkpointGroup{\n  1381→\t\t\t\tcheckpointID: cpID,\n  1382→\t\t\t\tprompt:       point.SessionPrompt,\n  1383→\t\t\t\tisTemporary:  !point.IsLogsOnly,\n  1384→\t\t\t\tisTask:       point.IsTaskCheckpoint,\n  1385→\t\t\t}\n  1386→\t\t\tgroupMap[cpID] = group\n  1387→\t\t\torder = append(order, cpID)\n  1388→\t\t}\n  1389→\n  1390→\t\t// Short git SHA (7 chars)\n  1391→\t\tgitSHA := point.ID\n  1392→\t\tif len(gitSHA) > 7 {\n  1393→\t\t\tgitSHA = gitSHA[:7]\n  1394→\t\t}\n  1395→\n  1396→\t\tgroup.commits = append(group.commits, commitEntry{\n  1397→\t\t\tdate:    point.Date,\n  1398→\t\t\tgitSHA:  gitSHA,\n  1399→\t\t\tmessage: point.Message,\n  1400→\t\t})\n  1401→\n  1402→\t\t// Update flags - if any commit is temporary/task, the group is too\n  1403→\t\tif !point.IsLogsOnly {\n  1404→\t\t\tgroup.isTemporary = true\n  1405→\t\t}\n  1406→\t\tif point.IsTaskCheckpoint {\n  1407→\t\t\tgroup.isTask = true\n  1408→\t\t}\n  1409→\t\t// Update prompt if the group's prompt is empty but this point has one\n  1410→\t\tif group.prompt == \"\" &&