son:\"branch,omitempty\"` // Branch where checkpoint was created (empty if detached HEAD)\n   333→\tCheckpointsCount int             `json:\"checkpoints_count\"`\n   334→\tFilesTouched     []string        `json:\"files_touched\"`\n   335→\n   336→\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n   337→\t// For multi-session checkpoints, this is the first agent (see Agents for all)\n   338→\tAgent  agent.AgentType   `json:\"agent,omitempty\"`\n   339→\tAgents []agent.AgentType `json:\"agents,omitempty\"` // All agents that contributed (multi-session, deduplicated)\n   340→\n   341→\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n   342→\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n   343→\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n   344→\n   345→\t// Task checkpoint fields (only populated for task checkpoints)\n   346→\tIsTask    bool   `json:\"is_task,omitempty\"`\n   347→\tToolUseID string `json:\"tool_use_id,omitempty\"`\n   348→\n   349→\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n   350→\tTranscriptIdentifierAtStart string `json:\"transcript_identifier_at_start,omitempty\"` // Last identifier when checkpoint started (UUID for Claude, message ID for Gemini)\n   351→\tTranscriptLinesAtStart      int    `json:\"transcript_lines_at_start,omitempty\"`      // Line/message count when checkpoint started\n   352→\n   353→\t// Token usage for this checkpoint\n   354→\tTokenUsage *agent.TokenUsage `json:\"token_usage,omitempty\"`\n   355→\n   356→\t// AI-generated summary of the checkpoint\n   357→\tSummary *Summary `json:\"summary,omitempty\"`\n   358→\n   359→\t// InitialAttribution is line-level attribution calculated at commit time\n   360→\tInitialAttribution *InitialAttribution `json:\"initial_attribution,omitempty\"`\n   361→}\n   362→\n   363→// Summary contains AI-generated summary of a checkpoint.\n   364→type Summary struct {\n   365→\tIntent    string           `json:\"intent\"`     // What user wanted to accomplish\n   366→\tOutcome   string           `json:\"outcome\"`    // What was achieved\n   367→\tLearnings LearningsSummary `json:\"learnings\"`  // Categorized learnings\n   368→\tFriction  []string         `json:\"friction\"`   // Problems/annoyances encountered\n   369→\tOpenItems []string         `json:\"open_items\"` // Tech debt, unfinished work\n   370→}\n   371→\n   372→// LearningsSummary contains learnings grouped by scope.\n   373→type LearningsSummary struct {\n   374→\tRepo     []string       `json:\"repo\"`     // Codebase-specific patterns/conventions\n   375→\tCode     []CodeLearning `json:\"code\"`     // File/module specific findings\n   376→\tWorkflow []string       `json:\"workflow\"` // General dev practices\n   377→}\n   378→\n   379→// CodeLearning captures a learning tied to a specific code location.\n   380→type CodeLearning struct {\n   381→\tPath    string `json:\"path\"`               // File path\n   382→\tLine    int    `json:\"line,omitempty\"`     // Start line number\n   383→\tEndLine int    `json:\"end_line,omitempty\"` // End line for ranges (optional)\n   384→\tFinding string `json:\"finding\"`            // What was learned\n   385→}\n   386→\n   387→// InitialAttribution captures line-level attribution metrics at commit time.\n   388→// This is a point-in-time snapshot comparing the checkpoint tree (agent work)\n   389→// against the committed tree (may include human edits).\n   390→//\n   391→// Attribution Metrics:\n   392→//   - TotalCommitted measures \"net additions\" (lines added that remain in the commit)\n   393→//   - AgentPercentage represents \"of the new code added, what percentage came from the agent\"\n   394→//   - Deletion work is tracked separately in HumanRemoved (not included in percentage)\n   395→//\n\n<