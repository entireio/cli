 1409→\treturn sb.String()\n  1410→}\n  1411→\n  1412→// checkpointGroup represents a group of commits sharing the same checkpoint ID.\n  1413→type checkpointGroup struct {\n  1414→\tcheckpointID string\n  1415→\tprompt       string\n  1416→\tisTemporary  bool // true if any commit is not logs-only (can be rewound)\n  1417→\tisTask       bool // true if this is a task checkpoint\n  1418→\tcommits      []commitEntry\n  1419→}\n  1420→\n  1421→// commitEntry represents a single git commit within a checkpoint.\n  1422→type commitEntry struct {\n  1423→\tdate    time.Time\n  1424→\tgitSHA  string // short git SHA\n  1425→\tmessage string\n  1426→}\n  1427→\n  1428→// groupByCheckpointID groups rewind points by their checkpoint ID.\n  1429→// Returns groups sorted by latest commit timestamp (most recent first).\n  1430→func groupByCheckpointID(points []strategy.RewindPoint) []checkpointGroup {\n  1431→\tif len(points) == 0 {\n  1432→\t\treturn nil\n  1433→\t}\n  1434→\n  1435→\t// Build map of checkpoint ID -> group\n  1436→\tgroupMap := make(map[string]*checkpointGroup)\n  1437→\tvar order []string // Track insertion order for stable iteration\n  1438→\n  1439→\tfor _, point := range points {\n  1440→\t\t// Determine the checkpoint ID to use for grouping\n  1441→\t\tcpID := point.CheckpointID.String()\n  1442→\t\tif cpID == \"\" {\n  1443→\t\t\t// Temporary checkpoints: group by session ID to preserve per-session prompts\n  1444→\t\t\t// Use session ID prefix for readability (format: YYYY-MM-DD-uuid)\n  1445→\t\t\tcpID = point.SessionID\n  1446→\t\t\tif cpID == \"\" {\n  1447→\t\t\t\tcpID = \"temporary\" // Fallback if no session ID\n  1448→\t\t\t}\n  1449→\t\t}\n  1450→\n  1451→\t\tgroup, exists := groupMap[cpID]\n  1452→\t\tif !exists {\n  1453→\t\t\tgroup = &checkpointGroup{\n  1454→\t\t\t\tcheckpointID: cpID,\n  1455→\t\t\t\tprompt:       point.SessionPrompt,\n  1456→\t\t\t\tisTemporary:  !point.IsLogsOnly,\n  1457→\t\t\t\tisTask:       point.IsTaskCheckpoint,\n  14