{"parentUuid":"9a0007ce-4327-4392-8c50-59f4bcc9fbe9","isSidechain":false,"userType":"external","cwd":"/Users/alex/workspace/cli/.worktrees/2","sessionId":"ac8a4f1a-1917-46bf-b8c1-0c3bab0fbc16","version":"2.1.30","gitBranch":"alex/improve-explain-2","slug":"floating-coalescing-dusk","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018B1q2JwmD1SHSvbcfjHBfu","type":"tool_result","content":"     1→package cli\n     2→\n     3→import (\n     4→\t\"context\"\n     5→\t\"errors\"\n     6→\t\"fmt\"\n     7→\t\"io\"\n     8→\t\"os\"\n     9→\t\"os/exec\"\n    10→\t\"sort\"\n    11→\t\"strings\"\n    12→\t\"time\"\n    13→\n    14→\t\"entire.io/cli/cmd/entire/cli/agent\"\n    15→\t\"entire.io/cli/cmd/entire/cli/checkpoint\"\n    16→\t\"entire.io/cli/cmd/entire/cli/checkpoint/id\"\n    17→\t\"entire.io/cli/cmd/entire/cli/logging\"\n    18→\t\"entire.io/cli/cmd/entire/cli/strategy\"\n    19→\t\"entire.io/cli/cmd/entire/cli/summarise\"\n    20→\t\"entire.io/cli/cmd/entire/cli/trailers\"\n    21→\t\"entire.io/cli/cmd/entire/cli/transcript\"\n    22→\n    23→\t\"github.com/go-git/go-git/v5\"\n    24→\t\"github.com/go-git/go-git/v5/plumbing\"\n    25→\t\"github.com/go-git/go-git/v5/plumbing/object\"\n    26→\t\"github.com/spf13/cobra\"\n    27→\t\"golang.org/x/term\"\n    28→)\n    29→\n    30→// commitInfo holds information about a commit for display purposes.\n    31→type commitInfo struct {\n    32→\tSHA       string\n    33→\tShortSHA  string\n    34→\tMessage   string\n    35→\tAuthor    string\n    36→\tEmail     string\n    37→\tDate      time.Time\n    38→\tFiles     []string\n    39→\tHasEntire bool\n    40→\tSessionID string\n    41→}\n    42→\n    43→// interaction holds a single prompt and its responses for display.\n    44→type interaction struct {\n    45→\tPrompt    string\n    46→\tResponses []string // Multiple responses can occur between tool calls\n    47→\tFiles     []string\n    48→}\n    49→\n    50→// checkpointDetail holds detailed information about a checkpoint for display.\n    51→type checkpointDetail struct {\n    52→\tIndex            int\n    53→\tShortID          string\n    54→\tTimestamp        time.Time\n    55→\tIsTaskCheckpoint bool\n    56→\tMessage          string\n    57→\t// Interactions contains all prompt/response pairs in this checkpoint.\n    58→\t// Most strategies have one, but shadow condensations may have multiple.\n    59→\tInteractions []interaction\n    60→\t// Files is the aggregate list of all files modified (for backwards compat)\n    61→\tFiles []string\n    62→}\n    63→\n    64→func newExplainCmd() *cobra.Command {\n    65→\tvar sessionFlag string\n    66→\tvar commitFlag string\n    67→\tvar checkpointFlag string\n    68→\tvar noPagerFlag bool\n    69→\tvar shortFlag bool\n    70→\tvar fullFlag bool\n    71→\tvar rawTranscriptFlag bool\n    72→\tvar generateFlag bool\n    73→\tvar forceFlag bool\n    74→\n    75→\tcmd := &cobra.Command{\n    76→\t\tUse:   \"explain\",\n    77→\t\tShort: \"Explain a session, commit, or checkpoint\",\n    78→\t\tLong: `Explain provides human-readable context about sessions, commits, and checkpoints.\n    79→\n    80→Use this command to understand what happened during agent-driven development,\n    81→either for self-review or to understand a teammate's work.\n    82→\n    83→By default, shows checkpoints on the current branch. Use flags to explain a specific\n    84→session, commit, or checkpoint.\n    85→\n    86→Output verbosity levels (for --checkpoint):\n    87→  Default:         Detailed view with scoped prompts (ID, session, tokens, intent, prompts, files)\n    88→  --short:         Summary only (ID, session, timestamp, tokens, intent)\n    89→  --full:          Parsed full transcript (all prompts/responses from entire session)\n    90→  --raw-transcript: Raw transcript file (JSONL format)\n    91→\n    92→Summary generation (for --checkpoint):\n    93→  --generate    Generate an AI summary for the checkpoint\n    94→  --force       Regenerate even if a summary already exists (requires --generate)\n    95→\n    96→Only one of --session, --commit, or --checkpoint can be specified at a time.`,\n    97→\t\tArgs: func(_ *cobra.Command, args []string) error {\n    98→\t\t\tif len(args) > 0 {\n    99→\t\t\t\treturn fmt.Errorf(\"unexpected argument %q\\nHint: use --checkpoint, --session, or --commit to specify what to explain\", args[0])\n   100→\t\t\t}\n   101→\t\t\treturn nil\n   102→\t\t},\n   103→\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n   104→\t\t\t// Check if Entire is disabled\n   105→\t\t\tif checkDisabledGuard(cmd.OutOrStdout()) {\n   106→\t\t\t\treturn nil\n   107→\t\t\t}\n   108→\n   109→\t\t\t// Validate flag dependencies\n   110→\t\t\tif generateFlag && checkpointFlag == \"\" {\n   111→\t\t\t\treturn errors.New(\"--generate requires --checkpoint/-c flag\")\n   112→\t\t\t}\n   113→\t\t\tif forceFlag && !generateFlag {\n   114→\t\t\t\treturn errors.New(\"--force requires --generate flag\")\n   115→\t\t\t}\n   116→\t\t\tif rawTranscriptFlag && checkpointFlag == \"\" {\n   117→\t\t\t\treturn errors.New(\"--raw-transcript requires --checkpoint/-c flag\")\n   118→\t\t\t}\n   119→\n   120→\t\t\t// Convert short flag to verbose (verbose = !short)\n   121→\t\t\tverbose := !shortFlag\n   122→\t\t\treturn runExplain(cmd.OutOrStdout(), cmd.ErrOrStderr(), sessionFlag, commitFlag, checkpointFlag, noPagerFlag, verbose, fullFlag, rawTranscriptFlag, generateFlag, forceFlag)\n   123→\t\t},\n   124→\t}\n   125→\n   126→\tcmd.Flags().StringVar(&sessionFlag, \"session\", \"\", \"Explain a specific session (ID or prefix)\")\n   127→\tcmd.Flags().StringVar(&commitFlag, \"commit\", \"\", \"Explain a specific commit (SHA or ref)\")\n   128→\tcmd.Flags().StringVarP(&checkpointFlag, \"checkpoint\", \"c\", \"\", \"Explain a specific checkpoint (ID or prefix)\")\n   129→\tcmd.Flags().BoolVar(&noPagerFlag, \"no-pager\", false, \"Disable pager output\")\n   130→\tcmd.Flags().BoolVarP(&shortFlag, \"short\", \"s\", false, \"Show summary only (omit prompts and files)\")\n   131→\tcmd.Flags().BoolVar(&fullFlag, \"full\", false, \"Show parsed full transcript (all prompts/responses)\")\n   132→\tcmd.Flags().BoolVar(&rawTranscriptFlag, \"raw-transcript\", false, \"Show raw transcript file (JSONL format)\")\n   133→\tcmd.Flags().BoolVar(&generateFlag, \"generate\", false, \"Generate an AI summary for the checkpoint\")\n   134→\tcmd.Flags().BoolVar(&forceFlag, \"force\", false, \"Regenerate summary even if one already exists (requires --generate)\")\n   135→\n   136→\t// Make --short, --full, and --raw-transcript mutually exclusive\n   137→\tcmd.MarkFlagsMutuallyExclusive(\"short\", \"full\", \"raw-transcript\")\n   138→\t// --generate and --raw-transcript are incompatible (summary would be generated but not shown)\n   139→\tcmd.MarkFlagsMutuallyExclusive(\"generate\", \"raw-transcript\")\n   140→\n   141→\treturn cmd\n   142→}\n   143→\n   144→// runExplain routes to the appropriate explain function based on flags.\n   145→func runExplain(w, errW io.Writer, sessionID, commitRef, checkpointID string, noPager, verbose, full, rawTranscript, generate, force bool) error {\n   146→\t// Count mutually exclusive flags\n   147→\tflagCount := 0\n   148→\tif sessionID != \"\" {\n   149→\t\tflagCount++\n   150→\t}\n   151→\tif commitRef != \"\" {\n   152→\t\tflagCount++\n   153→\t}\n   154→\tif checkpointID != \"\" {\n   155→\t\tflagCount++\n   156→\t}\n   157→\tif flagCount > 1 {\n   158→\t\treturn errors.New(\"cannot specify multiple of --session, --commit, --checkpoint\")\n   159→\t}\n   160→\n   161→\t// Route to appropriate handler\n   162→\tif sessionID != \"\" {\n   163→\t\treturn runExplainSession(w, sessionID, noPager)\n   164→\t}\n   165→\tif commitRef != \"\" {\n   166→\t\treturn runExplainCommit(w, commitRef)\n   167→\t}\n   168→\tif checkpointID != \"\" {\n   169→\t\treturn runExplainCheckpoint(w, errW, checkpointID, noPager, verbose, full, rawTranscript, generate, force)\n   170→\t}\n   171→\n   172→\t// Default: explain current session\n   173→\treturn runExplainDefault(w, noPager)\n   174→}\n   175→\n   176→// runExplainCheckpoint explains a specific checkpoint.\n   177→// Supports both committed checkpoints (by checkpoint ID) and temporary checkpoints (by git SHA).\n   178→// First tries to match committed checkpoints, then falls back to temporary checkpoints.\n   179→// When generate is true, generates an AI summary for the checkpoint.\n   180→// When force is true, regenerates even if a summary already exists.\n   181→// When rawTranscript is true, outputs only the raw transcript file (JSONL format).\n   182→func runExplainCheckpoint(w, errW io.Writer, checkpointIDPrefix string, noPager, verbose, full, rawTranscript, generate, force bool) error {\n   183→\trepo, err := openRepository()\n   184→\tif err != nil {\n   185→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   186→\t}\n   187→\n   188→\tstore := checkpoint.NewGitStore(repo)\n   189→\n   190→\t// First, try to find in committed checkpoints by checkpoint ID prefix\n   191→\tcommitted, err := store.ListCommitted(context.Background())\n   192→\tif err != nil {\n   193→\t\treturn fmt.Errorf(\"failed to list checkpoints: %w\", err)\n   194→\t}\n   195→\n   196→\t// Collect all matching checkpoint IDs to detect ambiguity\n   197→\tvar matches []id.CheckpointID\n   198→\tfor _, info := range committed {\n   199→\t\tif strings.HasPrefix(info.CheckpointID.String(), checkpointIDPrefix) {\n   200→\t\t\tmatches = append(matches, info.CheckpointID)\n   201→\t\t}\n   202→\t}\n   203→\n   204→\tvar fullCheckpointID id.CheckpointID\n   205→\tswitch len(matches) {\n   206→\tcase 0:\n   207→\t\t// Not found in committed, try temporary checkpoints by git SHA\n   208→\t\tif generate {\n   209→\t\t\treturn fmt.Errorf(\"cannot generate summary for temporary checkpoint %s (only committed checkpoints supported)\", checkpointIDPrefix)\n   210→\t\t}\n   211→\t\toutput, found := explainTemporaryCheckpoint(w, repo, store, checkpointIDPrefix, verbose, full, rawTranscript)\n   212→\t\tif found {\n   213→\t\t\toutputExplainContent(w, output, noPager)\n   214→\t\t\treturn nil\n   215→\t\t}\n   216→\t\t// If output is non-empty, it contains an error message (e.g., ambiguous prefix)\n   217→\t\tif output != \"\" {\n   218→\t\t\treturn errors.New(output)\n   219→\t\t}\n   220→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", checkpointIDPrefix)\n   221→\tcase 1:\n   222→\t\tfullCheckpointID = matches[0]\n   223→\tdefault:\n   224→\t\t// Ambiguous prefix - show up to 5 examples\n   225→\t\texamples := make([]string, 0, 5)\n   226→\t\tfor i := 0; i < len(matches) && i < 5; i++ {\n   227→\t\t\texamples = append(examples, matches[i].String())\n   228→\t\t}\n   229→\t\treturn fmt.Errorf(\"ambiguous checkpoint prefix %q matches %d checkpoints: %s\", checkpointIDPrefix, len(matches), strings.Join(examples, \", \"))\n   230→\t}\n   231→\n   232→\t// Load checkpoint data\n   233→\tresult, err := store.ReadCommitted(context.Background(), fullCheckpointID)\n   234→\tif err != nil {\n   235→\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   236→\t}\n   237→\tif result == nil {\n   238→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", fullCheckpointID)\n   239→\t}\n   240→\n   241→\t// Handle summary generation\n   242→\tif generate {\n   243→\t\tif err := generateCheckpointSummary(w, errW, store, fullCheckpointID, result, force); err != nil {\n   244→\t\t\treturn err\n   245→\t\t}\n   246→\t\t// Reload the result to get the updated summary\n   247→\t\tresult, err = store.ReadCommitted(context.Background(), fullCheckpointID)\n   248→\t\tif err != nil {\n   249→\t\t\treturn fmt.Errorf(\"failed to reload checkpoint: %w\", err)\n   250→\t\t}\n   251→\t\tif result == nil {\n   252→\t\t\treturn fmt.Errorf(\"checkpoint not found after save: %s\", fullCheckpointID)\n   253→\t\t}\n   254→\t}\n   255→\n   256→\t// Handle raw transcript output\n   257→\tif rawTranscript {\n   258→\t\tif len(result.Transcript) == 0 {\n   259→\t\t\treturn fmt.Errorf(\"checkpoint %s has no transcript\", fullCheckpointID)\n   260→\t\t}\n   261→\t\t// Output raw transcript directly (no pager, no formatting)\n   262→\t\tif _, err = w.Write(result.Transcript); err != nil {\n   263→\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n   264→\t\t}\n   265→\t\treturn nil\n   266→\t}\n   267→\n   268→\t// Look up the commit message for this checkpoint\n   269→\tcommitMessage := findCommitMessageForCheckpoint(repo, fullCheckpointID)\n   270→\n   271→\t// Format and output\n   272→\toutput := formatCheckpointOutput(result, fullCheckpointID, commitMessage, verbose, full)\n   273→\toutputExplainContent(w, output, noPager)\n   274→\treturn nil\n   275→}\n   276→\n   277→// generateCheckpointSummary generates an AI summary for a checkpoint and persists it.\n   278→// The summary is generated from the scoped transcript (only this checkpoint's portion),\n   279→// not the entire session transcript.\n   280→func generateCheckpointSummary(w, _ io.Writer, store *checkpoint.GitStore, checkpointID id.CheckpointID, result *checkpoint.ReadCommittedResult, force bool) error {\n   281→\t// Check if summary already exists\n   282→\tif result.Metadata.Summary != nil && !force {\n   283→\t\treturn fmt.Errorf(\"checkpoint %s already has a summary (use --force to regenerate)\", checkpointID)\n   284→\t}\n   285→\n   286→\t// Check if transcript exists\n   287→\tif len(result.Transcript) == 0 {\n   288→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript to summarise\", checkpointID)\n   289→\t}\n   290→\n   291→\t// Scope the transcript to only this checkpoint's portion\n   292→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   293→\tif len(scopedTranscript) == 0 {\n   294→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript content for this checkpoint (scoped)\", checkpointID)\n   295→\t}\n   296→\n   297→\t// Build condensed transcript for summarisation from the scoped portion\n   298→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(scopedTranscript)\n   299→\tif err != nil {\n   300→\t\treturn fmt.Errorf(\"failed to parse transcript: %w\", err)\n   301→\t}\n   302→\tif len(condensed) == 0 {\n   303→\t\treturn fmt.Errorf(\"checkpoint %s transcript has no content to summarise\", checkpointID)\n   304→\t}\n   305→\n   306→\tinput := summarise.Input{\n   307→\t\tTranscript:   condensed,\n   308→\t\tFilesTouched: result.Metadata.FilesTouched,\n   309→\t}\n   310→\n   311→\t// Generate summary using Claude CLI\n   312→\tctx := context.Background()\n   313→\tlogging.Info(ctx, \"generating checkpoint summary\")\n   314→\n   315→\tvar generator summarise.Generator = &summarise.ClaudeGenerator{}\n   316→\tsummary, err := generator.Generate(ctx, input)\n   317→\tif err != nil {\n   318→\t\treturn fmt.Errorf(\"failed to generate summary: %w\", err)\n   319→\t}\n   320→\n   321→\t// Persist the summary\n   322→\tif err := store.UpdateSummary(ctx, checkpointID, summary); err != nil {\n   323→\t\treturn fmt.Errorf(\"failed to save summary: %w\", err)\n   324→\t}\n   325→\n   326→\tfmt.Fprintln(w, \"✓ Summary generated and saved\")\n   327→\treturn nil\n   328→}\n   329→\n   330→// explainTemporaryCheckpoint finds and formats a temporary checkpoint by shadow commit hash prefix.\n   331→// Returns the formatted output and whether the checkpoint was found.\n   332→// Searches ALL shadow branches, not just the one for current HEAD, to find checkpoints\n   333→// created from different base commits (e.g., if HEAD advanced since session start).\n   334→// The writer w is used for raw transcript output to bypass the pager.\n   335→func explainTemporaryCheckpoint(w io.Writer, repo *git.Repository, store *checkpoint.GitStore, shaPrefix string, verbose, full, rawTranscript bool) (string, bool) {\n   336→\t// List temporary checkpoints from ALL shadow branches\n   337→\t// This ensures we find checkpoints even if HEAD has advanced since the session started\n   338→\ttempCheckpoints, err := store.ListAllTemporaryCheckpoints(context.Background(), \"\", branchCheckpointsLimit)\n   339→\tif err != nil {\n   340→\t\treturn \"\", false\n   341→\t}\n   342→\n   343→\t// Find checkpoints matching the SHA prefix - check for ambiguity\n   344→\tvar matches []checkpoint.TemporaryCheckpointInfo\n   345→\tfor _, tc := range tempCheckpoints {\n   346→\t\tif strings.HasPrefix(tc.CommitHash.String(), shaPrefix) {\n   347→\t\t\tmatches = append(matches, tc)\n   348→\t\t}\n   349→\t}\n   350→\n   351→\tif len(matches) == 0 {\n   352→\t\treturn \"\", false\n   353→\t}\n   354→\n   355→\tif len(matches) > 1 {\n   356→\t\t// Multiple matches - return ambiguous error (consistent with committed checkpoint behavior)\n   357→\t\tvar sb strings.Builder\n   358→\t\tfmt.Fprintf(&sb, \"ambiguous checkpoint prefix %q matches %d temporary checkpoints:\\n\", shaPrefix, len(matches))\n   359→\t\tfor _, m := range matches {\n   360→\t\t\tshortID := m.CommitHash.String()[:7]\n   361→\t\t\tfmt.Fprintf(&sb, \"  %s  %s  session %s\\n\",\n   362→\t\t\t\tshortID,\n   363→\t\t\t\tm.Timestamp.Format(\"2006-01-02 15:04:05\"),\n   364→\t\t\t\tm.SessionID)\n   365→\t\t}\n   366→\t\t// Return as \"not found\" with error message - caller will use this as error\n   367→\t\treturn sb.String(), false\n   368→\t}\n   369→\n   370→\ttc := matches[0]\n   371→\n   372→\t// Handle raw transcript output\n   373→\tif rawTranscript {\n   374→\t\ttranscriptBytes, transcriptErr := store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown)\n   375→\t\tif transcriptErr != nil || len(transcriptBytes) == 0 {\n   376→\t\t\t// Return specific error message (consistent with committed checkpoints)\n   377→\t\t\treturn fmt.Sprintf(\"checkpoint %s has no transcript\", tc.CommitHash.String()[:7]), false\n   378→\t\t}\n   379→\t\t// Write directly to writer (no pager, no formatting) - matches committed checkpoint behavior\n   380→\t\tif _, writeErr := fmt.Fprint(w, string(transcriptBytes)); writeErr != nil {\n   381→\t\t\treturn fmt.Sprintf(\"failed to write transcript: %v\", writeErr), false\n   382→\t\t}\n   383→\t\treturn \"\", true\n   384→\t}\n   385→\n   386→\t// Found exactly one match - read metadata from shadow branch commit tree\n   387→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   388→\tif commitErr != nil {\n   389→\t\treturn \"\", false\n   390→\t}\n   391→\n   392→\tshadowTree, treeErr := shadowCommit.Tree()\n   393→\tif treeErr != nil {\n   394→\t\treturn \"\", false\n   395→\t}\n   396→\n   397→\t// Read prompts from shadow branch\n   398→\tsessionPrompt := strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   399→\n   400→\t// Build output similar to formatCheckpointOutput but for temporary\n   401→\tvar sb strings.Builder\n   402→\tshortID := tc.CommitHash.String()[:7]\n   403→\tfmt.Fprintf(&sb, \"Checkpoint: %s [temporary]\\n\", shortID)\n   404→\tfmt.Fprintf(&sb, \"Session: %s\\n\", tc.SessionID)\n   405→\tfmt.Fprintf(&sb, \"Created: %s\\n\", tc.Timestamp.Format(\"2006-01-02 15:04:05\"))\n   406→\tsb.WriteString(\"\\n\")\n   407→\n   408→\t// Intent from prompt\n   409→\tintent := \"(not available)\"\n   410→\tif sessionPrompt != \"\" {\n   411→\t\tlines := strings.Split(sessionPrompt, \"\\n\")\n   412→\t\tif len(lines) > 0 && lines[0] != \"\" {\n   413→\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   414→\t\t}\n   415→\t}\n   416→\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   417→\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   418→\n   419→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   420→\t// For temporary checkpoints, load transcript and compute scope from parent commit\n   421→\tvar fullTranscript []byte\n   422→\tvar scopedTranscript []byte\n   423→\tif full || verbose {\n   424→\t\tfullTranscript, _ = store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   425→\n   426→\t\tif verbose && len(fullTranscript) > 0 {\n   427→\t\t\t// Compute scoped transcript by finding where parent's transcript ended\n   428→\t\t\t// Each shadow branch commit has the full transcript up to that point,\n   429→\t\t\t// so we diff against parent to get just this checkpoint's activity\n   430→\t\t\tscopedTranscript = fullTranscript // Default to full if no parent\n   431→\t\t\tif shadowCommit.NumParents() > 0 {\n   432→\t\t\t\tif parent, parentErr := shadowCommit.Parent(0); parentErr == nil {\n   433→\t\t\t\t\tparentTranscript, _ := store.GetTranscriptFromCommit(parent.Hash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   434→\t\t\t\t\tif len(parentTranscript) > 0 {\n   435→\t\t\t\t\t\t// Count lines in parent transcript to know where to slice from\n   436→\t\t\t\t\t\tparentLineCount := countLines(parentTranscript)\n   437→\t\t\t\t\t\tscopedTranscript = transcript.SliceFromLine(fullTranscript, parentLineCount)\n   438→\t\t\t\t\t}\n   439→\t\t\t\t}\n   440→\t\t\t}\n   441→\t\t}\n   442→\t}\n   443→\tappendTranscriptSection(&sb, verbose, full, fullTranscript, scopedTranscript, sessionPrompt)\n   444→\n   445→\treturn sb.String(), true\n   446→}\n   447→\n   448→// findCommitMessageForCheckpoint searches git history for a commit with the\n   449→// Entire-Checkpoint trailer matching the given checkpoint ID, and returns\n   450→// the first line of the commit message. Returns empty string if not found.\n   451→func findCommitMessageForCheckpoint(repo *git.Repository, checkpointID id.CheckpointID) string {\n   452→\t// Get HEAD reference\n   453→\thead, err := repo.Head()\n   454→\tif err != nil {\n   455→\t\treturn \"\"\n   456→\t}\n   457→\n   458→\t// Iterate through commit history (limit to recent commits for performance)\n   459→\tcommitIter, err := repo.Log(&git.LogOptions{\n   460→\t\tFrom: head.Hash(),\n   461→\t})\n   462→\tif err != nil {\n   463→\t\treturn \"\"\n   464→\t}\n   465→\tdefer commitIter.Close()\n   466→\n   467→\tcount := 0\n   468→\n   469→\tfor {\n   470→\t\tcommit, iterErr := commitIter.Next()\n   471→\t\tif iterErr != nil {\n   472→\t\t\tbreak\n   473→\t\t}\n   474→\t\tcount++\n   475→\t\tif count > commitScanLimit {\n   476→\t\t\tbreak\n   477→\t\t}\n   478→\n   479→\t\t// Check if this commit has our checkpoint ID\n   480→\t\tfoundID, hasTrailer := trailers.ParseCheckpoint(commit.Message)\n   481→\t\tif hasTrailer && foundID == checkpointID {\n   482→\t\t\t// Return first line of commit message (without trailing newline)\n   483→\t\t\tfirstLine := strings.Split(commit.Message, \"\\n\")[0]\n   484→\t\t\treturn strings.TrimSpace(firstLine)\n   485→\t\t}\n   486→\t}\n   487→\n   488→\treturn \"\"\n   489→}\n   490→\n   491→// scopeTranscriptForCheckpoint slices a transcript to include only the lines\n   492→// relevant to a specific checkpoint, starting from linesAtStart.\n   493→// This allows showing only what happened during a checkpoint, not the entire session.\n   494→func scopeTranscriptForCheckpoint(fullTranscript []byte, linesAtStart int) []byte {\n   495→\treturn transcript.SliceFromLine(fullTranscript, linesAtStart)\n   496→}\n   497→\n   498→// extractPromptsFromTranscript extracts user prompts from transcript bytes.\n   499→// Returns a slice of prompt strings.\n   500→func extractPromptsFromTranscript(transcriptBytes []byte) []string {\n   501→\tif len(transcriptBytes) == 0 {\n   502→\t\treturn nil\n   503→\t}\n   504→\n   505→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   506→\tif err != nil {\n   507→\t\treturn nil\n   508→\t}\n   509→\n   510→\tvar prompts []string\n   511→\tfor _, entry := range condensed {\n   512→\t\tif entry.Type == summarise.EntryTypeUser && entry.Content != \"\" {\n   513→\t\t\tprompts = append(prompts, entry.Content)\n   514→\t\t}\n   515→\t}\n   516→\treturn prompts\n   517→}\n   518→\n   519→// formatCheckpointOutput formats checkpoint data based on verbosity level.\n   520→// When verbose is false: summary only (ID, session, timestamp, tokens, intent).\n   521→// When verbose is true: adds files, commit message, and scoped transcript for this checkpoint.\n   522→// When full is true: shows parsed full session transcript instead of scoped transcript.\n   523→//\n   524→// Transcript scope is controlled by TranscriptLinesAtStart in metadata, which indicates\n   525→// where this checkpoint's content begins in the full session transcript.\n   526→func formatCheckpointOutput(result *checkpoint.ReadCommittedResult, checkpointID id.CheckpointID, commitMessage string, verbose, full bool) string {\n   527→\tvar sb strings.Builder\n   528→\tmeta := result.Metadata\n   529→\n   530→\t// Scope the transcript to this checkpoint's portion\n   531→\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   532→\t// lines from that point onwards (excluding earlier checkpoint content)\n   533→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, meta.TranscriptLinesAtStart)\n   534→\n   535→\t// Extract prompts from the scoped transcript for intent extraction\n   536→\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   537→\n   538→\t// Header - always shown\n   539→\t// Note: CheckpointID is always exactly 12 characters, matching checkpointIDDisplayLength\n   540→\tfmt.Fprintf(&sb, \"Checkpoint: %s\\n\", checkpointID)\n   541→\tfmt.Fprintf(&sb, \"Session: %s\\n\", meta.SessionID)\n   542→\tfmt.Fprintf(&sb, \"Created: %s\\n\", meta.CreatedAt.Format(\"2006-01-02 15:04:05\"))\n   543→\n   544→\t// Token usage\n   545→\tif meta.TokenUsage != nil {\n   546→\t\ttotalTokens := meta.TokenUsage.InputTokens + meta.TokenUsage.CacheCreationTokens +\n   547→\t\t\tmeta.TokenUsage.CacheReadTokens + meta.TokenUsage.OutputTokens\n   548→\t\tfmt.Fprintf(&sb, \"Tokens: %d\\n\", totalTokens)\n   549→\t}\n   550→\n   551→\tsb.WriteString(\"\\n\")\n   552→\n   553→\t// Intent and Outcome from AI summary, or fallback to prompt text\n   554→\tif meta.Summary != nil {\n   555→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", meta.Summary.Intent)\n   556→\t\tfmt.Fprintf(&sb, \"Outcome: %s\\n\", meta.Summary.Outcome)\n   557→\t} else {\n   558→\t\t// Fallback: use first line of scoped prompts for intent,\n   559→\t\t// or fall back to result.Prompts for backwards compatibility with older checkpoints\n   560→\t\tintent := \"(not generated)\"\n   561→\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   562→\t\t\tintent = strategy.TruncateDescription(scopedPrompts[0], maxIntentDisplayLength)\n   563→\t\t} else if result.Prompts != \"\" {\n   564→\t\t\t// Backwards compatibility: use stored prompts if no transcript available\n   565→\t\t\tlines := strings.Split(result.Prompts, \"\\n\")\n   566→\t\t\tif len(lines) > 0 && lines[0] != \"\" {\n   567→\t\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   568→\t\t\t}\n   569→\t\t}\n   570→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   571→\t\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   572→\t}\n   573→\n   574→\t// Verbose: add commit message, learnings, friction, files, and scoped transcript\n   575→\tif verbose || full {\n   576→\t\t// AI Summary details (learnings, friction, open items)\n   577→\t\tif meta.Summary != nil {\n   578→\t\t\tformatSummaryDetails(&sb, meta.Summary)\n   579→\t\t}\n   580→\n   581→\t\t// Commit message section (only if available)\n   582→\t\tif commitMessage != \"\" {\n   583→\t\t\tsb.WriteString(\"\\n\")\n   584→\t\t\tfmt.Fprintf(&sb, \"Commit: %s\\n\", commitMessage)\n   585→\t\t}\n   586→\n   587→\t\tsb.WriteString(\"\\n\")\n   588→\n   589→\t\t// Files section\n   590→\t\tif len(meta.FilesTouched) > 0 {\n   591→\t\t\tfmt.Fprintf(&sb, \"Files: (%d)\\n\", len(meta.FilesTouched))\n   592→\t\t\tfor _, file := range meta.FilesTouched {\n   593→\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n   594→\t\t\t}\n   595→\t\t} else {\n   596→\t\t\tsb.WriteString(\"Files: (none)\\n\")\n   597→\t\t}\n   598→\t}\n   599→\n   600→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   601→\tappendTranscriptSection(&sb, verbose, full, result.Transcript, scopedTranscript, result.Prompts)\n   602→\n   603→\treturn sb.String()\n   604→}\n   605→\n   606→// appendTranscriptSection appends the appropriate transcript section to the builder\n   607→// based on verbosity level. Full mode shows the entire session, verbose shows checkpoint scope.\n   608→// fullTranscript is the entire session transcript, scopedContent is either scoped transcript bytes\n   609→// or a pre-formatted string (for backwards compat), and scopedFallback is used when scoped parsing fails.\n   610→func appendTranscriptSection(sb *strings.Builder, verbose, full bool, fullTranscript, scopedTranscript []byte, scopedFallback string) {\n   611→\tswitch {\n   612→\tcase full:\n   613→\t\tsb.WriteString(\"\\n\")\n   614→\t\tsb.WriteString(\"Transcript (full session):\\n\")\n   615→\t\tsb.WriteString(formatTranscriptBytes(fullTranscript, \"\"))\n   616→\n   617→\tcase verbose:\n   618→\t\tsb.WriteString(\"\\n\")\n   619→\t\tsb.WriteString(\"Transcript (checkpoint scope):\\n\")\n   620→\t\tsb.WriteString(formatTranscriptBytes(scopedTranscript, scopedFallback))\n   621→\t}\n   622→}\n   623→\n   624→// formatTranscriptBytes formats transcript bytes into a human-readable string.\n   625→// It parses the JSONL transcript and formats it using the condensed format.\n   626→// The fallback is used for backwards compatibility when transcript parsing fails or is empty.\n   627→func formatTranscriptBytes(transcriptBytes []byte, fallback string) string {\n   628→\tif len(transcriptBytes) == 0 {\n   629→\t\tif fallback != \"\" {\n   630→\t\t\treturn fallback + \"\\n\"\n   631→\t\t}\n   632→\t\treturn \"  (none)\\n\"\n   633→\t}\n   634→\n   635→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   636→\tif err != nil || len(condensed) == 0 {\n   637→\t\tif fallback != \"\" {\n   638→\t\t\treturn fallback + \"\\n\"\n   639→\t\t}\n   640→\t\treturn \"  (failed to parse transcript)\\n\"\n   641→\t}\n   642→\n   643→\tinput := summarise.Input{Transcript: condensed}\n   644→\treturn summarise.FormatCondensedTranscript(input)\n   645→}\n   646→\n   647→// formatSummaryDetails formats the detailed sections of an AI summary.\n   648→func formatSummaryDetails(sb *strings.Builder, summary *checkpoint.Summary) {\n   649→\t// Learnings section\n   650→\thasLearnings := len(summary.Learnings.Repo) > 0 ||\n   651→\t\tlen(summary.Learnings.Code) > 0 ||\n   652→\t\tlen(summary.Learnings.Workflow) > 0\n   653→\n   654→\tif hasLearnings {\n   655→\t\tsb.WriteString(\"\\nLearnings:\\n\")\n   656→\n   657→\t\tif len(summary.Learnings.Repo) > 0 {\n   658→\t\t\tsb.WriteString(\"  Repository:\\n\")\n   659→\t\t\tfor _, learning := range summary.Learnings.Repo {\n   660→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   661→\t\t\t}\n   662→\t\t}\n   663→\n   664→\t\tif len(summary.Learnings.Code) > 0 {\n   665→\t\t\tsb.WriteString(\"  Code:\\n\")\n   666→\t\t\tfor _, learning := range summary.Learnings.Code {\n   667→\t\t\t\tif learning.Line > 0 {\n   668→\t\t\t\t\tif learning.EndLine > 0 {\n   669→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d-%d: %s\\n\", learning.Path, learning.Line, learning.EndLine, learning.Finding)\n   670→\t\t\t\t\t} else {\n   671→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d: %s\\n\", learning.Path, learning.Line, learning.Finding)\n   672→\t\t\t\t\t}\n   673→\t\t\t\t} else {\n   674→\t\t\t\t\tfmt.Fprintf(sb, \"    - %s: %s\\n\", learning.Path, learning.Finding)\n   675→\t\t\t\t}\n   676→\t\t\t}\n   677→\t\t}\n   678→\n   679→\t\tif len(summary.Learnings.Workflow) > 0 {\n   680→\t\t\tsb.WriteString(\"  Workflow:\\n\")\n   681→\t\t\tfor _, learning := range summary.Learnings.Workflow {\n   682→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   683→\t\t\t}\n   684→\t\t}\n   685→\t}\n   686→\n   687→\t// Friction section\n   688→\tif len(summary.Friction) > 0 {\n   689→\t\tsb.WriteString(\"\\nFriction:\\n\")\n   690→\t\tfor _, item := range summary.Friction {\n   691→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   692→\t\t}\n   693→\t}\n   694→\n   695→\t// Open items section\n   696→\tif len(summary.OpenItems) > 0 {\n   697→\t\tsb.WriteString(\"\\nOpen Items:\\n\")\n   698→\t\tfor _, item := range summary.OpenItems {\n   699→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   700→\t\t}\n   701→\t}\n   702→}\n   703→\n   704→// runExplainDefault shows all checkpoints on the current branch.\n   705→// This is the default view when no flags are provided.\n   706→func runExplainDefault(w io.Writer, noPager bool) error {\n   707→\treturn runExplainBranchDefault(w, noPager)\n   708→}\n   709→\n   710→// branchCheckpointsLimit is the max checkpoints to show in branch view\n   711→const branchCheckpointsLimit = 100\n   712→\n   713→// commitScanLimit is how far back to scan git history for checkpoints\n   714→const commitScanLimit = 500\n   715→\n   716→// consecutiveMainLimit stops scanning after this many consecutive commits on main\n   717→// (indicates we've likely exhausted feature branch commits)\n   718→const consecutiveMainLimit = 100\n   719→\n   720→// errStopIteration is used to stop commit iteration early\n   721→var errStopIteration = errors.New(\"stop iteration\")\n   722→\n   723→// getBranchCheckpoints returns checkpoints relevant to the current branch.\n   724→// This is strategy-agnostic - it queries checkpoints directly from the checkpoint store.\n   725→//\n   726→// Behavior:\n   727→//   - On feature branches: only show checkpoints unique to this branch (not in main)\n   728→//   - On default branch (main/master): show all checkpoints in history (up to limit)\n   729→//   - Includes both committed checkpoints (entire/sessions) and temporary checkpoints (shadow branches)\n   730→func getBranchCheckpoints(repo *git.Repository, limit int) ([]strategy.RewindPoint, error) {\n   731→\tstore := checkpoint.NewGitStore(repo)\n   732→\n   733→\t// Get all committed checkpoints for lookup\n   734→\tcommittedInfos, err := store.ListCommitted(context.Background())\n   735→\tif err != nil {\n   736→\t\tcommittedInfos = nil // Continue without committed checkpoints\n   737→\t}\n   738→\n   739→\t// Build map of checkpoint ID -> committed info\n   740→\tcommittedByID := make(map[id.CheckpointID]checkpoint.CommittedInfo)\n   741→\tfor _, info := range committedInfos {\n   742→\t\tif !info.CheckpointID.IsEmpty() {\n   743→\t\t\tcommittedByID[info.CheckpointID] = info\n   744→\t\t}\n   745→\t}\n   746→\n   747→\thead, err := repo.Head()\n   748→\tif err != nil {\n   749→\t\t// Unborn HEAD (no commits yet) - return empty list instead of erroring\n   750→\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n   751→\t\t\treturn []strategy.RewindPoint{}, nil\n   752→\t\t}\n   753→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   754→\t}\n   755→\n   756→\t// Check if we're on the default branch (use repo-aware version)\n   757→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   758→\tvar mainBranchHash plumbing.Hash\n   759→\tif !isOnDefault {\n   760→\t\t// Prefer the actual default branch name (which may not be main/master)\n   761→\t\tif defaultBranchName := strategy.GetDefaultBranchName(repo); defaultBranchName != \"\" {\n   762→\t\t\t// Try local default branch first: refs/heads/<name>\n   763→\t\t\tref, refErr := repo.Reference(plumbing.ReferenceName(\"refs/heads/\"+defaultBranchName), true)\n   764→\t\t\tif refErr != nil {\n   765→\t\t\t\t// Fall back to remote default branch: refs/remotes/origin/<name>\n   766→\t\t\t\tref, refErr = repo.Reference(plumbing.ReferenceName(\"refs/remotes/origin/\"+defaultBranchName), true)\n   767→\t\t\t}\n   768→\t\t\tif refErr == nil {\n   769→\t\t\t\tmainBranchHash = ref.Hash()\n   770→\t\t\t}\n   771→\t\t}\n   772→\n   773→\t\t// Fall back to main/master detection if default branch resolution failed\n   774→\t\tif mainBranchHash == plumbing.ZeroHash {\n   775→\t\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   776→\t\t}\n   777→\t}\n   778→\n   779→\t// Precompute commits reachable from main (for O(1) filtering instead of O(N) per commit)\n   780→\t// This changes the filtering from O(N*M) to O(N+M) where N=commits scanned, M=main history depth\n   781→\treachableFromMain := make(map[plumbing.Hash]bool)\n   782→\tif mainBranchHash != plumbing.ZeroHash {\n   783→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   784→\t\tif mainErr == nil {\n   785→\t\t\tmainCount := 0\n   786→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   787→\t\t\t\tmainCount++\n   788→\t\t\t\tif mainCount > 1000 { // Same depth limit as before\n   789→\t\t\t\t\treturn errStopIteration\n   790→\t\t\t\t}\n   791→\t\t\t\treachableFromMain[c.Hash] = true\n   792→\t\t\t\treturn nil\n   793→\t\t\t})\n   794→\t\t\tmainIter.Close()\n   795→\t\t}\n   796→\t}\n   797→\n   798→\t// Walk git history and collect checkpoints\n   799→\titer, err := repo.Log(&git.LogOptions{\n   800→\t\tFrom:  head.Hash(),\n   801→\t\tOrder: git.LogOrderCommitterTime,\n   802→\t})\n   803→\tif err != nil {\n   804→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   805→\t}\n   806→\tdefer iter.Close()\n   807→\n   808→\tvar points []strategy.RewindPoint\n   809→\tcount := 0\n   810→\tconsecutiveMainCount := 0\n   811→\n   812→\terr = iter.ForEach(func(c *object.Commit) error {\n   813→\t\tif count >= commitScanLimit {\n   814→\t\t\treturn errStopIteration\n   815→\t\t}\n   816→\t\tcount++\n   817→\n   818→\t\t// On feature branches, skip commits that are reachable from main\n   819→\t\t// (but continue scanning - there may be more feature branch commits)\n   820→\t\tif len(reachableFromMain) > 0 {\n   821→\t\t\tif reachableFromMain[c.Hash] {\n   822→\t\t\t\tconsecutiveMainCount++\n   823→\t\t\t\tif consecutiveMainCount >= consecutiveMainLimit {\n   824→\t\t\t\t\treturn errStopIteration // Likely exhausted feature branch commits\n   825→\t\t\t\t}\n   826→\t\t\t\treturn nil // Skip this commit, continue scanning\n   827→\t\t\t}\n   828→\t\t\tconsecutiveMainCount = 0 // Reset on feature branch commit\n   829→\t\t}\n   830→\n   831→\t\t// Extract checkpoint ID from Entire-Checkpoint trailer\n   832→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   833→\t\tif !found {\n   834→\t\t\treturn nil // No checkpoint trailer, continue\n   835→\t\t}\n   836→\n   837→\t\t// Look up checkpoint info\n   838→\t\tcpInfo, found := committedByID[cpID]\n   839→\t\tif !found {\n   840→\t\t\treturn nil // Checkpoint not in store, continue\n   841→\t\t}\n   842→\n   843→\t\t// Create rewind point from committed info\n   844→\t\tmessage := strings.Split(c.Message, \"\\n\")[0]\n   845→\t\tpoint := strategy.RewindPoint{\n   846→\t\t\tID:               c.Hash.String(),\n   847→\t\t\tMessage:          message,\n   848→\t\t\tDate:             c.Committer.When,\n   849→\t\t\tIsLogsOnly:       true, // Committed checkpoints are logs-only\n   850→\t\t\tCheckpointID:     cpID,\n   851→\t\t\tSessionID:        cpInfo.SessionID,\n   852→\t\t\tIsTaskCheckpoint: cpInfo.IsTask,\n   853→\t\t\tToolUseID:        cpInfo.ToolUseID,\n   854→\t\t\tAgent:            cpInfo.Agent,\n   855→\t\t}\n   856→\t\t// Read session prompt from metadata branch (best-effort)\n   857→\t\tresult, _ := store.ReadCommitted(context.Background(), cpID) //nolint:errcheck  // Best-effort\n   858→\t\tif result != nil {\n   859→\t\t\t// Scope the transcript to this checkpoint's portion\n   860→\t\t\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   861→\t\t\t// lines from that point onwards (excluding earlier checkpoint content)\n   862→\t\t\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   863→\t\t\t// Extract prompts from the scoped transcript (not the full session's prompts)\n   864→\t\t\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   865→\t\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   866→\t\t\t\tpoint.SessionPrompt = scopedPrompts[0]\n   867→\t\t\t}\n   868→\t\t}\n   869→\n   870→\t\tpoints = append(points, point)\n   871→\t\treturn nil\n   872→\t})\n   873→\n   874→\tif err != nil && !errors.Is(err, errStopIteration) {\n   875→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   876→\t}\n   877→\n   878→\t// Get temporary checkpoints from ALL shadow branches whose base commit is reachable from HEAD.\n   879→\ttempPoints := getReachableTemporaryCheckpoints(repo, store, head.Hash(), isOnDefault, limit)\n   880→\tpoints = append(points, tempPoints...)\n   881→\n   882→\t// Sort by date, most recent first\n   883→\tsort.Slice(points, func(i, j int) bool {\n   884→\t\treturn points[i].Date.After(points[j].Date)\n   885→\t})\n   886→\n   887→\t// Apply limit\n   888→\tif len(points) > limit {\n   889→\t\tpoints = points[:limit]\n   890→\t}\n   891→\n   892→\treturn points, nil\n   893→}\n   894→\n   895→// getReachableTemporaryCheckpoints returns temporary checkpoints from shadow branches\n   896→// whose base commit is reachable from the given HEAD hash.\n   897→// For default branches, all shadow branches are included.\n   898→// For feature branches, only shadow branches whose base commit is in HEAD's history are included.\n   899→func getReachableTemporaryCheckpoints(repo *git.Repository, store *checkpoint.GitStore, headHash plumbing.Hash, isOnDefault bool, limit int) []strategy.RewindPoint {\n   900→\tvar points []strategy.RewindPoint\n   901→\n   902→\tshadowBranches, _ := store.ListTemporary(context.Background()) //nolint:errcheck // Best-effort\n   903→\tfor _, sb := range shadowBranches {\n   904→\t\t// Check if this shadow branch's base commit is reachable from current HEAD\n   905→\t\tif !isShadowBranchReachable(repo, sb.BaseCommit, headHash, isOnDefault) {\n   906→\t\t\tcontinue\n   907→\t\t}\n   908→\n   909→\t\t// List checkpoints from this shadow branch\n   910→\t\ttempCheckpoints, _ := store.ListCheckpointsForBranch(context.Background(), sb.BranchName, \"\", limit) //nolint:errcheck // Best-effort\n   911→\t\tfor _, tc := range tempCheckpoints {\n   912→\t\t\tpoint := convertTemporaryCheckpoint(repo, tc)\n   913→\t\t\tif point != nil {\n   914→\t\t\t\tpoints = append(points, *point)\n   915→\t\t\t}\n   916→\t\t}\n   917→\t}\n   918→\n   919→\treturn points\n   920→}\n   921→\n   922→// isShadowBranchReachable checks if a shadow branch's base commit is reachable from HEAD.\n   923→// For default branches, all shadow branches are considered reachable.\n   924→// For feature branches, we check if any commit with the base commit prefix is in HEAD's history.\n   925→func isShadowBranchReachable(repo *git.Repository, baseCommit string, headHash plumbing.Hash, isOnDefault bool) bool {\n   926→\t// For default branch: all shadow branches are potentially relevant\n   927→\tif isOnDefault {\n   928→\t\treturn true\n   929→\t}\n   930→\n   931→\t// Check if base commit hash prefix matches any commit in HEAD's history\n   932→\tbaseCommitIter, baseErr := repo.Log(&git.LogOptions{From: headHash})\n   933→\tif baseErr != nil {\n   934→\t\treturn false\n   935→\t}\n   936→\tdefer baseCommitIter.Close()\n   937→\n   938→\tbaseCount := 0\n   939→\tfound := false\n   940→\t_ = baseCommitIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   941→\t\tbaseCount++\n   942→\t\tif baseCount > commitScanLimit {\n   943→\t\t\treturn errStopIteration\n   944→\t\t}\n   945→\t\tif strings.HasPrefix(c.Hash.String(), baseCommit) {\n   946→\t\t\tfound = true\n   947→\t\t\treturn errStopIteration\n   948→\t\t}\n   949→\t\treturn nil\n   950→\t})\n   951→\n   952→\treturn found\n   953→}\n   954→\n   955→// convertTemporaryCheckpoint converts a TemporaryCheckpointInfo to a RewindPoint.\n   956→// Returns nil if the checkpoint should be skipped (no code changes or can't be read).\n   957→func convertTemporaryCheckpoint(repo *git.Repository, tc checkpoint.TemporaryCheckpointInfo) *strategy.RewindPoint {\n   958→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   959→\tif commitErr != nil {\n   960→\t\treturn nil\n   961→\t}\n   962→\n   963→\t// Filter out checkpoints with no code changes (only .entire/ metadata changed)\n   964→\t// This also filters out the first checkpoint which is just a baseline copy\n   965→\tif !hasCodeChanges(shadowCommit) {\n   966→\t\treturn nil\n   967→\t}\n   968→\n   969→\t// Read session prompt from the shadow branch commit's tree (not from entire/sessions)\n   970→\t// Temporary checkpoints store their metadata in the shadow branch, not in entire/sessions\n   971→\tvar sessionPrompt string\n   972→\tshadowTree, treeErr := shadowCommit.Tree()\n   973→\tif treeErr == nil {\n   974→\t\tsessionPrompt = strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   975→\t}\n   976→\n   977→\treturn &strategy.RewindPoint{\n   978→\t\tID:               tc.CommitHash.String(),\n   979→\t\tMessage:          tc.Message,\n   980→\t\tMetadataDir:      tc.MetadataDir,\n   981→\t\tDate:             tc.Timestamp,\n   982→\t\tIsTaskCheckpoint: tc.IsTaskCheckpoint,\n   983→\t\tToolUseID:        tc.ToolUseID,\n   984→\t\tSessionID:        tc.SessionID,\n   985→\t\tSessionPrompt:    sessionPrompt,\n   986→\t\tIsLogsOnly:       false, // Temporary checkpoints can be fully rewound\n   987→\t}\n   988→}\n   989→\n   990→// runExplainBranchDefault shows all checkpoints on the current branch grouped by date.\n   991→// This is strategy-agnostic - it queries checkpoints directly.\n   992→func runExplainBranchDefault(w io.Writer, noPager bool) error {\n   993→\trepo, err := openRepository()\n   994→\tif err != nil {\n   995→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   996→\t}\n   997→\n   998→\t// Get current branch name\n   999→\tbranchName := strategy.GetCurrentBranchName(repo)\n  1000→\tif branchName == \"\" {\n  1001→\t\t// Detached HEAD state or unborn HEAD - try to use short commit hash if possible\n  1002→\t\thead, headErr := repo.Head()\n  1003→\t\tif headErr != nil {\n  1004→\t\t\t// Unborn HEAD (no commits yet) - treat as empty history instead of erroring\n  1005→\t\t\tif errors.Is(headErr, plumbing.ErrReferenceNotFound) {\n  1006→\t\t\t\tbranchName = \"HEAD (no commits yet)\"\n  1007→\t\t\t} else {\n  1008→\t\t\t\treturn fmt.Errorf(\"failed to get HEAD: %w\", headErr)\n  1009→\t\t\t}\n  1010→\t\t} else {\n  1011→\t\t\tbranchName = \"HEAD (\" + head.Hash().String()[:7] + \")\"\n  1012→\t\t}\n  1013→\t}\n  1014→\n  1015→\t// Get checkpoints for this branch (strategy-agnostic)\n  1016→\tpoints, err := getBranchCheckpoints(repo, branchCheckpointsLimit)\n  1017→\tif err != nil {\n  1018→\t\t// Log the error but continue with empty list so user sees helpful message\n  1019→\t\tlogging.Warn(context.Background(), \"failed to get branch checkpoints\", \"error\", err)\n  1020→\t\tpoints = nil\n  1021→\t}\n  1022→\n  1023→\t// Format output\n  1024→\toutput := formatBranchCheckpoints(branchName, points)\n  1025→\n  1026→\toutputExplainContent(w, output, noPager)\n  1027→\treturn nil\n  1028→}\n  1029→\n  1030→// outputExplainContent outputs content with optional pager support.\n  1031→func outputExplainContent(w io.Writer, content string, noPager bool) {\n  1032→\tif noPager {\n  1033→\t\tfmt.Fprint(w, content)\n  1034→\t} else {\n  1035→\t\toutputWithPager(w, content)\n  1036→\t}\n  1037→}\n  1038→\n  1039→// runExplainSession explains a specific session.\n  1040→func runExplainSession(w io.Writer, sessionID string, noPager bool) error {\n  1041→\tstrat := GetStrategy()\n  1042→\n  1043→\t// Get session details\n  1044→\tsession, err := strategy.GetSession(sessionID)\n  1045→\tif err != nil {\n  1046→\t\tif errors.Is(err, strategy.ErrNoSession) {\n  1047→\t\t\treturn fmt.Errorf(\"session not found: %s\", sessionID)\n  1048→\t\t}\n  1049→\t\treturn fmt.Errorf(\"failed to get session: %w\", err)\n  1050→\t}\n  1051→\n  1052→\t// Get source ref (metadata branch + commit) for this session\n  1053→\tsourceRef := strat.GetSessionMetadataRef(session.ID)\n  1054→\n  1055→\t// Gather checkpoint details\n  1056→\tcheckpointDetails := gatherCheckpointDetails(strat, session)\n  1057→\n  1058→\t// For strategies like shadow where active sessions may not have checkpoints,\n  1059→\t// try to get the current session transcript directly\n  1060→\tif len(checkpointDetails) == 0 && len(session.Checkpoints) == 0 {\n  1061→\t\tcheckpointDetails = gatherCurrentSessionDetails(strat, session)\n  1062→\t}\n  1063→\n  1064→\t// Format output\n  1065→\toutput := formatSessionInfo(session, sourceRef, checkpointDetails)\n  1066→\n  1067→\t// Output with pager if appropriate\n  1068→\tif noPager {\n  1069→\t\tfmt.Fprint(w, output)\n  1070→\t} else {\n  1071→\t\toutputWithPager(w, output)\n  1072→\t}\n  1073→\n  1074→\treturn nil\n  1075→}\n  1076→\n  1077→// gatherCurrentSessionDetails attempts to get transcript info for sessions without checkpoints.\n  1078→// This handles strategies like shadow where active sessions may not have checkpoint commits.\n  1079→func gatherCurrentSessionDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n  1080→\t// Try to get transcript via GetSessionContext which reads from metadata branch\n  1081→\t// For shadow, we can read the transcript from the same location pattern\n  1082→\tcontextContent := strat.GetSessionContext(session.ID)\n  1083→\tif contextContent == \"\" {\n  1084→\t\treturn nil\n  1085→\t}\n  1086→\n  1087→\t// Parse the context.md to extract the last prompt/summary\n  1088→\t// Context.md typically has sections like \"# Prompt\\n...\\n## Summary\\n...\"\n  1089→\tdetail := checkpointDetail{\n  1090→\t\tIndex:     1,\n  1091→\t\tTimestamp: session.StartTime,\n  1092→\t\tMessage:   \"Current session\",\n  1093→\t}\n  1094→\n  1095→\t// Try to extract prompt and summary from context.md\n  1096→\tlines := strings.Split(contextContent, \"\\n\")\n  1097→\tvar inPrompt, inSummary bool\n  1098→\tvar promptLines, summaryLines []string\n  1099→\n  1100→\tfor _, line := range lines {\n  1101→\t\ttrimmed := strings.TrimSpace(line)\n  1102→\t\tif strings.HasPrefix(trimmed, \"# \") && strings.Contains(strings.ToLower(trimmed), \"prompt\") {\n  1103→\t\t\tinPrompt = true\n  1104→\t\t\tinSummary = false\n  1105→\t\t\tcontinue\n  1106→\t\t}\n  1107→\t\tif strings.HasPrefix(trimmed, \"## \") && strings.Contains(strings.ToLower(trimmed), \"summary\") {\n  1108→\t\t\tinPrompt = false\n  1109→\t\t\tinSummary = true\n  1110→\t\t\tcontinue\n  1111→\t\t}\n  1112→\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"# \") {\n  1113→\t\t\tinPrompt = false\n  1114→\t\t\tinSummary = false\n  1115→\t\t\tcontinue\n  1116→\t\t}\n  1117→\n  1118→\t\tif inPrompt {\n  1119→\t\t\tpromptLines = append(promptLines, line)\n  1120→\t\t} else if inSummary {\n  1121→\t\t\tsummaryLines = append(summaryLines, line)\n  1122→\t\t}\n  1123→\t}\n  1124→\n  1125→\tvar inter interaction\n  1126→\tif len(promptLines) > 0 {\n  1127→\t\tinter.Prompt = strings.TrimSpace(strings.Join(promptLines, \"\\n\"))\n  1128→\t}\n  1129→\tif len(summaryLines) > 0 {\n  1130→\t\tinter.Responses = []string{strings.TrimSpace(strings.Join(summaryLines, \"\\n\"))}\n  1131→\t}\n  1132→\n  1133→\t// If we couldn't parse structured content, show the raw context\n  1134→\tif inter.Prompt == \"\" && len(inter.Responses) == 0 {\n  1135→\t\tinter.Responses = []string{contextContent}\n  1136→\t}\n  1137→\n  1138→\tif inter.Prompt != \"\" || len(inter.Responses) > 0 {\n  1139→\t\tdetail.Interactions = []interaction{inter}\n  1140→\t}\n  1141→\n  1142→\treturn []checkpointDetail{detail}\n  1143→}\n  1144→\n  1145→// gatherCheckpointDetails extracts detailed information for each checkpoint.\n  1146→// Checkpoints come in newest-first order, but we number them oldest=1, newest=N.\n  1147→func gatherCheckpointDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n  1148→\tdetails := make([]checkpointDetail, 0, len(session.Checkpoints))\n  1149→\ttotal := len(session.Checkpoints)\n  1150→\n  1151→\tfor i, cp := range session.Checkpoints {\n  1152→\t\tdetail := checkpointDetail{\n  1153→\t\t\tIndex:            total - i, // Reverse numbering: oldest=1, newest=N\n  1154→\t\t\tTimestamp:        cp.Timestamp,\n  1155→\t\t\tIsTaskCheckpoint: cp.IsTaskCheckpoint,\n  1156→\t\t\tMessage:          cp.Message,\n  1157→\t\t}\n  1158→\n  1159→\t\t// Use checkpoint ID for display (truncate long IDs)\n  1160→\t\tdetail.ShortID = cp.CheckpointID.String()\n  1161→\t\tif len(detail.ShortID) > 12 {\n  1162→\t\t\tdetail.ShortID = detail.ShortID[:12]\n  1163→\t\t}\n  1164→\n  1165→\t\t// Try to get transcript for this checkpoint\n  1166→\t\ttranscriptContent, err := strat.GetCheckpointLog(cp)\n  1167→\t\tif err == nil {\n  1168→\t\t\ttranscript, parseErr := parseTranscriptFromBytes(transcriptContent)\n  1169→\t\t\tif parseErr == nil {\n  1170→\t\t\t\t// Extract all prompt/response pairs from the transcript\n  1171→\t\t\t\tpairs := ExtractAllPromptResponses(transcript)\n  1172→\t\t\t\tfor _, pair := range pairs {\n  1173→\t\t\t\t\tdetail.Interactions = append(detail.Interactions, interaction(pair))\n  1174→\t\t\t\t}\n  1175→\n  1176→\t\t\t\t// Aggregate all files for the checkpoint\n  1177→\t\t\t\tfileSet := make(map[string]bool)\n  1178→\t\t\t\tfor _, pair := range pairs {\n  1179→\t\t\t\t\tfor _, f := range pair.Files {\n  1180→\t\t\t\t\t\tif !fileSet[f] {\n  1181→\t\t\t\t\t\t\tfileSet[f] = true\n  1182→\t\t\t\t\t\t\tdetail.Files = append(detail.Files, f)\n  1183→\t\t\t\t\t\t}\n  1184→\t\t\t\t\t}\n  1185→\t\t\t\t}\n  1186→\t\t\t}\n  1187→\t\t}\n  1188→\n  1189→\t\tdetails = append(details, detail)\n  1190→\t}\n  1191→\n  1192→\treturn details\n  1193→}\n  1194→\n  1195→// runExplainCommit explains a specific commit.\n  1196→func runExplainCommit(w io.Writer, commitRef string) error {\n  1197→\trepo, err := openRepository()\n  1198→\tif err != nil {\n  1199→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1200→\t}\n  1201→\n  1202→\t// Resolve the commit reference\n  1203→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1204→\tif err != nil {\n  1205→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1206→\t}\n  1207→\n  1208→\tcommit, err := repo.CommitObject(*hash)\n  1209→\tif err != nil {\n  1210→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1211→\t}\n  1212→\n  1213→\t// Get files changed in this commit (diff from parent to current)\n  1214→\tvar files []string\n  1215→\tcommitTree, err := commit.Tree()\n  1216→\tif err == nil && commit.NumParents() > 0 {\n  1217→\t\tparent, parentErr := commit.Parent(0)\n  1218→\t\tif parentErr == nil {\n  1219→\t\t\tparentTree, treeErr := parent.Tree()\n  1220→\t\t\tif treeErr == nil {\n  1221→\t\t\t\t// Diff from parent to current commit to show what changed\n  1222→\t\t\t\tchanges, diffErr := parentTree.Diff(commitTree)\n  1223→\t\t\t\tif diffErr == nil {\n  1224→\t\t\t\t\tfor _, change := range changes {\n  1225→\t\t\t\t\t\tname := change.To.Name\n  1226→\t\t\t\t\t\tif name == \"\" {\n  1227→\t\t\t\t\t\t\tname = change.From.Name\n  1228→\t\t\t\t\t\t}\n  1229→\t\t\t\t\t\tfiles = append(files, name)\n  1230→\t\t\t\t\t}\n  1231→\t\t\t\t}\n  1232→\t\t\t}\n  1233→\t\t}\n  1234→\t}\n  1235→\n  1236→\t// Check for Entire metadata - try multiple trailer types\n  1237→\tmetadataDir, hasMetadata := trailers.ParseMetadata(commit.Message)\n  1238→\tsessionID, hasSession := trailers.ParseSession(commit.Message)\n  1239→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1240→\n  1241→\t// If no session trailer, try to extract from metadata path.\n  1242→\t// Note: extractSessionIDFromMetadata is defined in rewind.go as it's used\n  1243→\t// by both the rewind and explain commands for parsing metadata paths.\n  1244→\tif !hasSession && hasMetadata {\n  1245→\t\tsessionID = extractSessionIDFromMetadata(metadataDir)\n  1246→\t\thasSession = sessionID != \"\"\n  1247→\t}\n  1248→\n  1249→\t// Build commit info\n  1250→\tfullSHA := hash.String()\n  1251→\tshortSHA := fullSHA\n  1252→\tif len(fullSHA) >= 7 {\n  1253→\t\tshortSHA = fullSHA[:7]\n  1254→\t}\n  1255→\n  1256→\tinfo := &commitInfo{\n  1257→\t\tSHA:       fullSHA,\n  1258→\t\tShortSHA:  shortSHA,\n  1259→\t\tMessage:   strings.Split(commit.Message, \"\\n\")[0], // First line only\n  1260→\t\tAuthor:    commit.Author.Name,\n  1261→\t\tEmail:     commit.Author.Email,\n  1262→\t\tDate:      commit.Author.When,\n  1263→\t\tFiles:     files,\n  1264→\t\tHasEntire: hasMetadata || hasSession || hasCheckpoint,\n  1265→\t\tSessionID: sessionID,\n  1266→\t}\n  1267→\n  1268→\t// If we have a checkpoint ID but no session, try to look up session from metadata\n  1269→\tif hasCheckpoint && sessionID == \"\" {\n  1270→\t\tif result, err := checkpoint.NewGitStore(repo).ReadCommitted(context.Background(), checkpointID); err == nil && result != nil {\n  1271→\t\t\tinfo.SessionID = result.Metadata.SessionID\n  1272→\t\t}\n  1273→\t}\n  1274→\n  1275→\t// Format and output\n  1276→\toutput := formatCommitInfo(info)\n  1277→\tfmt.Fprint(w, output)\n  1278→\n  1279→\treturn nil\n  1280→}\n  1281→\n  1282→// formatSessionInfo formats session information for display.\n  1283→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1284→\tvar sb strings.Builder\n  1285→\n  1286→\t// Session header\n  1287→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1288→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1289→\n  1290→\tif !session.StartTime.IsZero() {\n  1291→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1292→\t}\n  1293→\n  1294→\tif sourceRef != \"\" {\n  1295→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1296→\t}\n  1297→\n  1298→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1299→\n  1300→\t// Checkpoint details\n  1301→\tfor _, cp := range checkpoints {\n  1302→\t\tsb.WriteString(\"\\n\")\n  1303→\n  1304→\t\t// Checkpoint header\n  1305→\t\ttaskMarker := \"\"\n  1306→\t\tif cp.IsTaskCheckpoint {\n  1307→\t\t\ttaskMarker = \" [Task]\"\n  1308→\t\t}\n  1309→\t\tfmt.Fprintf(&sb, \"─── Checkpoint %d [%s] %s%s ───\\n\",\n  1310→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker)\n  1311→\t\tsb.WriteString(\"\\n\")\n  1312→\n  1313→\t\t// Display all interactions in this checkpoint\n  1314→\t\tfor i, inter := range cp.Interactions {\n  1315→\t\t\t// For multiple interactions, add a sub-header\n  1316→\t\t\tif len(cp.Interactions) > 1 {\n  1317→\t\t\t\tfmt.Fprintf(&sb, \"### Interaction %d\\n\\n\", i+1)\n  1318→\t\t\t}\n  1319→\n  1320→\t\t\t// Prompt section\n  1321→\t\t\tif inter.Prompt != \"\" {\n  1322→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n  1323→\t\t\t\tsb.WriteString(inter.Prompt)\n  1324→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1325→\t\t\t}\n  1326→\n  1327→\t\t\t// Response section\n  1328→\t\t\tif len(inter.Responses) > 0 {\n  1329→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n  1330→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n  1331→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1332→\t\t\t}\n  1333→\n  1334→\t\t\t// Files modified for this interaction\n  1335→\t\t\tif len(inter.Files) > 0 {\n  1336→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(inter.Files))\n  1337→\t\t\t\tfor _, file := range inter.Files {\n  1338→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1339→\t\t\t\t}\n  1340→\t\t\t\tsb.WriteString(\"\\n\")\n  1341→\t\t\t}\n  1342→\t\t}\n  1343→\n  1344→\t\t// If no interactions, show message and/or files\n  1345→\t\tif len(cp.Interactions) == 0 {\n  1346→\t\t\t// Show commit message as summary when no transcript available\n  1347→\t\t\tif cp.Message != \"\" {\n  1348→\t\t\t\tsb.WriteString(cp.Message)\n  1349→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1350→\t\t\t}\n  1351→\t\t\t// Show aggregate files if available\n  1352→\t\t\tif len(cp.Files) > 0 {\n  1353→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(cp.Files))\n  1354→\t\t\t\tfor _, file := range cp.Files {\n  1355→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1356→\t\t\t\t}\n  1357→\t\t\t}\n  1358→\t\t}\n  1359→\t}\n  1360→\n  1361→\treturn sb.String()\n  1362→}\n  1363→\n  1364→// formatCommitInfo formats commit information for display.\n  1365→func formatCommitInfo(info *commitInfo) string {\n  1366→\tvar sb strings.Builder\n  1367→\n  1368→\tfmt.Fprintf(&sb, \"Commit: %s (%s)\\n\", info.SHA, info.ShortSHA)\n  1369→\tfmt.Fprintf(&sb, \"Date: %s\\n\", info.Date.Format(\"2006-01-02 15:04:05\"))\n  1370→\n  1371→\tif info.HasEntire && info.SessionID != \"\" {\n  1372→\t\tfmt.Fprintf(&sb, \"Session: %s\\n\", info.SessionID)\n  1373→\t}\n  1374→\n  1375→\tsb.WriteString(\"\\n\")\n  1376→\n  1377→\t// Message\n  1378→\tsb.WriteString(\"Message:\\n\")\n  1379→\tfmt.Fprintf(&sb, \"  %s\\n\", info.Message)\n  1380→\tsb.WriteString(\"\\n\")\n  1381→\n  1382→\t// Files modified\n  1383→\tif len(info.Files) > 0 {\n  1384→\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(info.Files))\n  1385→\t\tfor _, file := range info.Files {\n  1386→\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1387→\t\t}\n  1388→\t\tsb.WriteString(\"\\n\")\n  1389→\t}\n  1390→\n  1391→\t// Note for non-Entire commits\n  1392→\tif !info.HasEntire {\n  1393→\t\tsb.WriteString(\"Note: No Entire session data available for this commit.\\n\")\n  1394→\t}\n  1395→\n  1396→\treturn sb.String()\n  1397→}\n  1398→\n  1399→// outputWithPager outputs content through a pager if stdout is a terminal and content is long.\n  1400→func outputWithPager(w io.Writer, content string) {\n  1401→\t// Check if we're writing to stdout and it's a terminal\n  1402→\tif f, ok := w.(*os.File); ok && f == os.Stdout && term.IsTerminal(int(f.Fd())) {\n  1403→\t\t// Get terminal height\n  1404→\t\t_, height, err := term.GetSize(int(f.Fd()))\n  1405→\t\tif err != nil {\n  1406→\t\t\theight = 24 // Default fallback\n  1407→\t\t}\n  1408→\n  1409→\t\t// Count lines in content\n  1410→\t\tlineCount := strings.Count(content, \"\\n\")\n  1411→\n  1412→\t\t// Use pager if content exceeds terminal height\n  1413→\t\tif lineCount > height-2 {\n  1414→\t\t\tpager := os.Getenv(\"PAGER\")\n  1415→\t\t\tif pager == \"\" {\n  1416→\t\t\t\tpager = \"less\"\n  1417→\t\t\t}\n  1418→\n  1419→\t\t\tcmd := exec.CommandContext(context.Background(), pager) //nolint:gosec // pager from env is expected\n  1420→\t\t\tcmd.Stdin = strings.NewReader(content)\n  1421→\t\t\tcmd.Stdout = f\n  1422→\t\t\tcmd.Stderr = os.Stderr\n  1423→\n  1424→\t\t\tif err := cmd.Run(); err != nil {\n  1425→\t\t\t\t// Fallback to direct output if pager fails\n  1426→\t\t\t\tfmt.Fprint(w, content)\n  1427→\t\t\t}\n  1428→\t\t\treturn\n  1429→\t\t}\n  1430→\t}\n  1431→\n  1432→\t// Direct output for non-terminal or short content\n  1433→\tfmt.Fprint(w, content)\n  1434→}\n  1435→\n  1436→// Constants for formatting output\n  1437→const (\n  1438→\t// maxIntentDisplayLength is the maximum length for intent text before truncation\n  1439→\tmaxIntentDisplayLength = 80\n  1440→\t// maxMessageDisplayLength is the maximum length for checkpoint messages before truncation\n  1441→\tmaxMessageDisplayLength = 80\n  1442→\t// maxPromptDisplayLength is the maximum length for session prompts before truncation\n  1443→\tmaxPromptDisplayLength = 60\n  1444→\t// checkpointIDDisplayLength is the number of characters to show from checkpoint IDs\n  1445→\tcheckpointIDDisplayLength = 12\n  1446→)\n  1447→\n  1448→// formatBranchCheckpoints formats checkpoint information for a branch.\n  1449→// Groups commits by checkpoint ID and shows the prompt for each checkpoint.\n  1450→func formatBranchCheckpoints(branchName string, points []strategy.RewindPoint) string {\n  1451→\tvar sb strings.Builder\n  1452→\n  1453→\t// Branch header\n  1454→\tfmt.Fprintf(&sb, \"Branch: %s\\n\", branchName)\n  1455→\n  1456→\tif len(points) == 0 {\n  1457→\t\tsb.WriteString(\"Checkpoints: 0\\n\")\n  1458→\t\tsb.WriteString(\"\\nNo checkpoints found on this branch.\\n\")\n  1459→\t\tsb.WriteString(\"Checkpoints will appear here after you save changes during a Claude session.\\n\")\n  1460→\t\treturn sb.String()\n  1461→\t}\n  1462→\n  1463→\t// Group by checkpoint ID\n  1464→\tgroups := groupByCheckpointID(points)\n  1465→\n  1466→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(groups))\n  1467→\tsb.WriteString(\"\\n\")\n  1468→\n  1469→\t// Output each checkpoint group\n  1470→\tfor _, group := range groups {\n  1471→\t\tformatCheckpointGroup(&sb, group)\n  1472→\t\tsb.WriteString(\"\\n\")\n  1473→\t}\n  1474→\n  1475→\treturn sb.String()\n  1476→}\n  1477→\n  1478→// checkpointGroup represents a group of commits sharing the same checkpoint ID.\n  1479→type checkpointGroup struct {\n  1480→\tcheckpointID string\n  1481→\tprompt       string\n  1482→\tisTemporary  bool // true if any commit is not logs-only (can be rewound)\n  1483→\tisTask       bool // true if this is a task checkpoint\n  1484→\tcommits      []commitEntry\n  1485→}\n  1486→\n  1487→// commitEntry represents a single git commit within a checkpoint.\n  1488→type commitEntry struct {\n  1489→\tdate    time.Time\n  1490→\tgitSHA  string // short git SHA\n  1491→\tmessage string\n  1492→}\n  1493→\n  1494→// groupByCheckpointID groups rewind points by their checkpoint ID.\n  1495→// Returns groups sorted by latest commit timestamp (most recent first).\n  1496→func groupByCheckpointID(points []strategy.RewindPoint) []checkpointGroup {\n  1497→\tif len(points) == 0 {\n  1498→\t\treturn nil\n  1499→\t}\n  1500→\n  1501→\t// Build map of checkpoint ID -> group\n  1502→\tgroupMap := make(map[string]*checkpointGroup)\n  1503→\tvar order []string // Track insertion order for stable iteration\n  1504→\n  1505→\tfor _, point := range points {\n  1506→\t\t// Determine the checkpoint ID to use for grouping\n  1507→\t\tcpID := point.CheckpointID.String()\n  1508→\t\tif cpID == \"\" {\n  1509→\t\t\t// Temporary checkpoints: group by session ID to preserve per-session prompts\n  1510→\t\t\t// Use session ID prefix for readability (format: YYYY-MM-DD-uuid)\n  1511→\t\t\tcpID = point.SessionID\n  1512→\t\t\tif cpID == \"\" {\n  1513→\t\t\t\tcpID = \"temporary\" // Fallback if no session ID\n  1514→\t\t\t}\n  1515→\t\t}\n  1516→\n  1517→\t\tgroup, exists := groupMap[cpID]\n  1518→\t\tif !exists {\n  1519→\t\t\tgroup = &checkpointGroup{\n  1520→\t\t\t\tcheckpointID: cpID,\n  1521→\t\t\t\tprompt:       point.SessionPrompt,\n  1522→\t\t\t\tisTemporary:  !point.IsLogsOnly,\n  1523→\t\t\t\tisTask:       point.IsTaskCheckpoint,\n  1524→\t\t\t}\n  1525→\t\t\tgroupMap[cpID] = group\n  1526→\t\t\torder = append(order, cpID)\n  1527→\t\t}\n  1528→\n  1529→\t\t// Short git SHA (7 chars)\n  1530→\t\tgitSHA := point.ID\n  1531→\t\tif len(gitSHA) > 7 {\n  1532→\t\t\tgitSHA = gitSHA[:7]\n  1533→\t\t}\n  1534→\n  1535→\t\tgroup.commits = append(group.commits, commitEntry{\n  1536→\t\t\tdate:    point.Date,\n  1537→\t\t\tgitSHA:  gitSHA,\n  1538→\t\t\tmessage: point.Message,\n  1539→\t\t})\n  1540→\n  1541→\t\t// Update flags - if any commit is temporary/task, the group is too\n  1542→\t\tif !point.IsLogsOnly {\n  1543→\t\t\tgroup.isTemporary = true\n  1544→\t\t}\n  1545→\t\tif point.IsTaskCheckpoint {\n  1546→\t\t\tgroup.isTask = true\n  1547→\t\t}\n  1548→\t\t// Update prompt if the group's prompt is empty but this point has one\n  1549→\t\tif group.prompt == \"\" && point.SessionPrompt != \"\" {\