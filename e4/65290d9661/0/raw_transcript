hBlob,\n   317→\t}\n   318→\treturn nil\n   319→}\n   320→\n   321→// writeMetadataJSON writes the metadata.json file for the checkpoint.\n   322→// If existingMetadata is provided, merges session info from the previous session(s).\n   323→func (s *GitStore) writeMetadataJSON(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry, existingMetadata *CommittedMetadata) error {\n   324→\t// Note: Agents array is only populated during multi-session merge (below).\n   325→\t// For single-session checkpoints, we only set Agent (singular).\n   326→\tmetadata := CommittedMetadata{\n   327→\t\tCheckpointID:                opts.CheckpointID,\n   328→\t\tSessionID:                   opts.SessionID,\n   329→\t\tStrategy:                    opts.Strategy,\n   330→\t\tCreatedAt:                   time.Now().UTC(),\n   331→\t\tBranch:                      opts.Branch,\n   332→\t\tCheckpointsCount:            opts.CheckpointsCount,\n   333→\t\tFilesTouched:                opts.FilesTouched,\n   334→\t\tAgent:                       opts.Agent,\n   335→\t\tAgents:                      nil, // Only set during multi-session merge\n   336→\t\tIsTask:                      opts.IsTask,\n   337→\t\tToolUseID:                   opts.ToolUseID,\n   338→\t\tSessionCount:                1,\n   339→\t\tSessionIDs:                  []string{opts.SessionID},\n   340→\t\tTranscriptIdentifierAtStart: opts.TranscriptIdentifierAtStart,\n   341→\t\tTranscriptLinesAtStart:      opts.TranscriptLinesAtStart,\n   342→\t\tTokenUsage:                  opts.TokenUsage,\n   343→\t\tInitialAttribution:          opts.InitialAttribution,\n   344→\t}\n   345→\n   346→\t// Merge with existing metadata if present (multi-session checkpoint)\n   347→\tif existingMetadata != nil {\n   348→\t\t// Get existing session count (default to 1 for backwards compat)\n   349→\t\texistingCount := existingMetadata.SessionCount\n   350→\t\tif existingCount == 0 {\n   351→\t\t\texistingCount = 1\n   352→\t\t}\n   353→\t\tmetadata.SessionCount = existingCount + 1\n   354→\n   355→\t\t// Merge session IDs\n   356→\t\texistingIDs := existingMetadata.SessionIDs\n   357→\t\tif len(existingIDs) == 0 {\n   358→\t\t\t// Backwards compat: old metadata only had SessionID\n   359→\t\t\texistingIDs = []string{existingMetadata.SessionID}\n   360→\t\t}\n   361→\t\tmetadata.SessionIDs = append(metadata.SessionIDs[:0], existingIDs...)\n   362→\t\tmetadata.SessionIDs = append(metadata.SessionIDs, opts.SessionID)\n   363→\n   364→\t\t// Merge agents (deduplicated, preserving order)\n   365→\t\texistingAgents := existingMetadata.Agents\n   366→\t\tif len(existingAgents) == 0 && existingMetadata.Agent != \"\" {\n   367→\t\t\t// Backwards compat: old metadata only had Agent\n   368→\t\t\texistingAgents = []agent.AgentType{existingMetadata.Agent}\n   369→\t\t}\n   370→\t\tmetadata.Agents = mergeAgents(existingAgents, opts.Agent)\n   371→\t\t// Keep Agent as the first agent for backwards compat\n   372→\t\tif len(metadata.Agents) > 0 {\n   373→\t\t\tmetadata.Agent = metadata.Agents[0]\n   374→\t\t}\n   375→\n   376→\t\t// Merge files touched (deduplicated)\n   377→\t\tmetadata.FilesTouched = mergeFilesTouched(existingMetadata.FilesTouched, opts.FilesTouched)\n   378→\n   379→\t\t// Sum checkpoint counts\n   380→\t\tmetadata.CheckpointsCount = existingMetadata.CheckpointsCount + opts.CheckpointsCount\n   381→\n   382→\t\t// Keep existing attribution - we calculated this for the first session based on all commits in the shadow branch already\n   383→\t\tif existingMetadata.InitialAttribution != nil {\n   384→\t\t\tmetadata.InitialAttribution = existingMetadata.InitialAttribution\n   385→\t\t}\n   386→\t}\n   387→\n   388→\tmetadataJSON, err := jsonutil.MarshalIndentWithNewline(metadata, \"\", \"  \")\n   389→\tif err != nil {\n   390→\t\treturn fmt.Errorf(\"failed to marshal metadata: %w\", err)\n   391→\t}\n   392→\tmetadataHash, err := CreateBlobFromContent(s.repo, metadataJSON)\n   393→\tif err != nil {\n   394→\t\treturn err\n   395→\t}\n   396→\tentries[basePath+paths.MetadataFileName] = object.TreeEntry{\n   397→\t\tName: basePath + paths.MetadataFileName,\n   398→\t\tMode: filemode.Regular,\n   399→\t\tHash: metadataHash,\n   400→\t}\n   401→\treturn nil\n   402→}\n   403→\n   404→// mergeFilesTouched combines two file lists, removing duplicates.\n   405→func mergeFilesTouched(existing, additional []string) []string {\n   406→\tseen := make(map[string]bool)\n   407→\tvar result []string\n   408→\n   409→\tfor _, f := range existing {\n   410→\t\tif !seen[f] {\n   411→\t\t\tseen[f] = true\n   412→\t\t\tresult = append(result, f)\n   413→\t\t}\n   414→\t}\n   415→\tfor _, f := range additional {\n   416→\t\tif !seen[f] {\n   417→\t\t\tseen[f] = true\n   418→\t\t\tresult = append(result, f)\n   419→\t\t}\n   420→\t}\n   421→\n   422→\tsort.Strings(result)\n   423→\treturn result\n   424→}\n   425→\n   426→// mergeAgents combines existing agents with a new agent, removing duplicates.\n   427→// Preserves order (existing agents first, then new agent if not already present).\n   428→func mergeAgents(existing []agent.AgentType, newAgent agent.AgentType) []agent.AgentType {\n   429→\tif newAgent == \"\" {\n   430→\t\treturn existing\n   431→\t}\n   432→\n   433→\tseen := make(map[agent.AgentType]bool)\n   434→\tvar result []agent.AgentType\n   435→\n   436→\tfor _, a := range existing {\n   437→\t\tif !seen[a] {\n   438→\t\t\tseen[a] = true\n   439→\t\t\tresult = append(result, a)\n   440→\t\t}\n   441→\t}\n   442→\n   443→\tif !seen[newAgent] {\n   444→\t\tresult = append(result, newAgent)\n   445→\t}\n   446→\n   447→\treturn result\n   448→}\n   449→\n   450→// readMetadataFromBlob reads CommittedMetadata from a blob hash.\n   451→func (s *GitStore) readMetadataFromBlob(hash plumbing.Hash) (*CommittedMetadata, error) {\n   452→\tblob, err := s.repo.BlobObject(hash)\n   453→\tif err != nil {\n   454→\t\treturn nil, fmt.Errorf(\"failed to get blob: %w\", err)\n   455→\t}\n   456→\n   457→\treader, err := blob.Reader()\n   458→\tif err != nil {\n   459→\t\treturn nil, fmt.Errorf(\"failed to get blob reader: %w\", err)\n   460→\t}\n   461→\tdefer reader.Close()\n   462→\n   463→\tvar metadata CommittedMetadata\n   464→\tif err := json.NewDecoder(reader).Decode(&metadata); err != nil {\n   465→\t\treturn nil, fmt.Errorf(\"failed to decode metadata: %w\", err)\n   466→\t}\n   467→\n   468→\treturn &metadata, nil\n   469→}\n   470→\n   471→// archiveExistingSession moves existing session files to a numbered subfolder.\n   472→// The subfolder number is based on the current session count (so first archived session goes to \"1/\").\n   473→func (s *GitStore) archiveExistingSession(basePath string, existingMetadata *CommittedMetadata, entries map[string]object.TreeEntry) {\n   474→\t// Determine archive folder number\n   475→\tsessionCount := existingMetadata.SessionCount\n   476→\tif sessionCount == 0 {\n   477→\t\tsessionCount = 1 // backwards compat\n   478→\t}\n   479→\tarchivePath := fmt.Sprintf(\"%s%d/\", basePath, sessionCount)\n   480→\n   481→\t// Files to archive (standard checkpoint files at basePath, excluding tasks/ subfolder)\n   482→\tfilesToArchive := []string{\n   483→\t\tpaths.MetadataFileName,\n   484→\t\tpaths.TranscriptFileName,\n   485→\t\tpaths.PromptFileName,\n   486→\t\tpaths.ContextFileName,\n   487→\t\tpaths.ContentHashFileName,\n   488→\t}\n   489→\n   490→\t// Also include transcript chunk files (full.jsonl.001, full.jsonl.002, etc.)\n   491→\tchunkPrefix := basePath + paths.TranscriptFileName + \".\"\n   492→\tfor srcPath := range entries {\n   493→\t\tif strings.HasPrefix(srcPath, chunkPrefix) {\n   494→\t\t\tchunkSuffix := strings.TrimPrefix(srcPath, basePath+paths.TranscriptFileName)\n   495→\t\t\tif idx := agent.ParseChunkIndex(paths.TranscriptFileName+chunkSuffix, paths.TranscriptFileName); idx > 0 {\n   496→\t\t\t\tfilesToArchive = append(filesToArchive, paths.TranscriptFileName+chunkSuffix)\n   497→\t\t\t}\n   498→\t\t}\n   499→\t}\n   500→\n   501→\t// Move each file to archive folder\n   502→\tfor _, filename := range filesToArchive {\n   503→\t\tsrcPath := basePath + filename\n   504→\t\tif entry, exists := entries[srcPath]; exists {\n   505→\t\t\t// Add to archive location\n   506→\t\t\tdstPath := archivePath + filename\n   507→\t\t\tentries[dstPath] = object.TreeEntry{\n   508→\t\t\t\tName: dstPath,\n   509→\t\t\t\tMode: entry.Mode,\n   510→\t\t\t\tHash: entry.Hash,\n   511→\t\t\t}\n   512→\t\t\t// Remove from original location (will be overwritten by new session)\n   513→\t\t\tdelete(entries, srcPath)\n   514→\t\t}\n   515→\t}\n   516→}\n   517→\n   518→// readArchivedSessions reads transcript data from archived session subfolders (1/, 2/, etc.).\n   519→// Returns sessions ordered by folder index (oldest first).\n   520→func (s *GitStore) readArchivedSessions(checkpointTree *object.Tree, sessionCount int, agentType agent.AgentType) []ArchivedSession {\n   521→\tvar archived []ArchivedSession\n   522→\n   523→\t// Archived sessions are in numbered folders: 1/, 2/, etc.\n   524→\t// The most recent session is at the root level (not archived).\n   525→\t// Session count N means there are N-1 archived sessions.\n   526→\tfor i := 1; i < sessionCount; i++ {\n   527→\t\tfolderName := strconv.Itoa(i)\n   528→\n   529→\t\t// Try to get the archived session subtree\n   530→\t\tsubTree, err := checkpointTree.Tree(folderName)\n   531→\t\tif err != nil {\n   532→\t\t\tcontinue // Folder doesn't exist, skip\n   533→\t\t}\n   534→\n   535→\t\tsession := ArchivedSession{\n   536→\t\t\tFolderIndex: i,\n   537→\t\t}\n   538→\n   539→\t\t// Read metadata to get session ID\n   540→\t\tif metadataFile, fileErr := subTree.File(paths.MetadataFileName); fileErr == nil {\n   541→\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   542→\t\t\t\tvar metadata CommittedMetadata\n   543→\t\t\t\tif jsonErr := json.Unmarshal([]byte(content), &metadata); jsonErr == nil {\n   544→\t\t\t\t\tsession.SessionID = metadata.SessionID\n   545→\t\t\t\t}\n   546→\t\t\t}\n   547→\t\t}\n   548→\n   549→\t\t// Read transcript (handles both chunked and non-chunked formats)\n   550→\t\tif transcript, err := readTranscriptFromTree(subTree, agentType); err == nil && transcript != nil {\n   551→\t\t\tsession.Transcript = transcript\n   552→\t\t}\n   553→\n   554→\t\t// Read prompts\n   555→\t\tif file, fileErr := subTree.File(paths.PromptFileName); fileErr == nil {\n   556→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   557→\t\t\t\tsession.Prompts = content\n   558→\t\t\t}\n   559→\t\t}\n   560→\n   561→\t\t// Only add if we got a transcript\n   562→\t\tif len(session.Transcript) > 0 {\n   563→\t\t\tarchived = append(archived, session)\n   564→\t\t}\n   565→\t}\n   566→\n   567→\treturn archived\n   568→}\n   569→\n   570→// buildCommitMessage constructs the commit message with proper trailers.\n   571→// The commit subject is always \"Checkpoint: <id>\" for consistency.\n   572→// If CommitSubject is provided (e.g., for task checkpoints), it's included in the body.\n   573→func (s *GitStore) buildCommitMessage(opts WriteCommittedOptions, taskMetadataPath string) string {\n   574→\tvar commitMsg strings.Builder\n   575→\n   576→\t// Subject line is always the checkpoint ID for consistent formatting\n   577→\tcommitMsg.WriteString(fmt.Sprintf(\"Checkpoint: %s\\n\\n\", opts.CheckpointID))\n   578→\n   579→\t// Include custom description in body if provided (e.g., task checkpoint details)\n   580→\tif opts.CommitSubject != \"\" {\n   581→\t\tcommitMsg.WriteString(opts.CommitSubject + \"\\n\\n\")\n   582→\t}\n   583→\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.SessionTrailerKey, opts.SessionID))\n   584→\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.StrategyTrailerKey, opts.Strategy))\n   585→\tif opts.Agent != \"\" {\n   586→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.AgentTrailerKey, opts.Agent))\n   587→\t}\n   588→\tif opts.EphemeralBranch != \"\" {\n   589→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.EphemeralBranchTrailerKey, opts.EphemeralBranch))\n   590→\t}\n   591→\tif taskMetadataPath != \"\" {\n   592→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.MetadataTaskTrailerKey, taskMetadataPath))\n   593→\t}\n   594→\n   595→\treturn commitMsg.String()\n   596→}\n   597→\n   598→// incrementalCheckpointData represents an incremental checkpoint during subagent execution.\n   599→// This mirrors strategy.SubagentCheckpoint but avoids import cycles.\n   600→type incrementalCheckpointData struct {\n   601→\tType      string          `json:\"type\"`\n   602→\tToolUseID string          `json:\"tool_use_id\"`\n   603→\tTimestamp time.Time       `json:\"timestamp\"`\n   604→\tData      json.RawMessage `json:\"data\"`\n   605→}\n   606→\n   607→// taskCheckpointData represents a final task checkpoint.\n   608→// This mirrors strategy.TaskCheckpoint but avoids import cycles.\n   609→type taskCheckpointData struct {\n   610→\tSessionID      string `json:\"session_id\"`\n   611→\tToolUseID      string `json:\"tool_use_id\"`\n   612→\tCheckpointUUID string `json:\"checkpoint_uuid\"`\n   613→\tAgentID        string `json:\"agent_id,omitempty\"`\n   614→}\n   615→\n   616→// ReadCommitted reads a committed checkpoint by ID from the entire/sessions branch.\n   617→// Returns nil, nil if the checkpoint doesn't exist.\n   618→//\n   619→\n   620→func (s *GitStore) ReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*ReadCommittedResult, error) {\n   621→\t_ = ctx // Reserved for future use\n   622→\n   623→\ttree, err := s.getSessionsBranchTree()\n   624→\tif err != nil {\n   625→\t\treturn nil, nil //nolint:nilnil,nilerr // No sessions branch means no checkpoint exists\n   626→\t}\n   627→\n   628→\tcheckpointPath := checkpointID.Path()\n   629→\tcheckpointTree, err := tree.Tree(checkpointPath)\n   630→\tif err != nil {\n   631→\t\treturn nil, nil //nolint:nilnil,nilerr // Checkpoint directory not found\n   632→\t}\n   633→\n   634→\tresult := &ReadCommittedResult{}\n   635→\n   636→\t// Read metadata.json\n   637→\tif metadataFile, fileErr := checkpointTree.File(paths.MetadataFileName); fileErr == nil {\n   638→\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   639→\t\t\t//nolint:errcheck,gosec // Best-effort parsing, defaults are fine\n   640→\t\t\tjson.Unmarshal([]byte(content), &result.Metadata)\n   641→\t\t}\n   642→\t}\n   643→\n   644→\t// Read transcript (handles both chunked and non-chunked formats)\n   645→\tif transcript, err := readTranscriptFromTree(checkpointTree, result.Metadata.Agent); err == nil && transcript != nil {\n   646→\t\tresult.Transcript = transcript\n   647→\t}\n   648→\n   649→\t// Read prompts\n   650→\tif file, fileErr := checkpointTree.File(paths.PromptFileName); fileErr == nil {\n   651→\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   652→\t\t\tresult.Prompts = content\n   653→\t\t}\n   654→\t}\n   655→\n   656→\t// Read context\n   657→\tif file, fileErr := checkpointTree.File(paths.ContextFileName); fileErr == nil {\n   658→\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   659→\t\t\tresult.Context = content\n   660→\t\t}\n   661→\t}\n   662→\n   663→\t// Read archived sessions if this is a multi-session checkpoint\n   664→\tif result.Metadata.SessionCount > 1 {\n   665→\t\tresult.ArchivedSessions = s.readArchivedSessions(checkpointTree, result.Metadata.SessionCount, result.Metadata.Agent)\n   666→\t}\n   667→\n   668→\treturn result, nil\n   669→}\n   670→\n   671→// ListCommitted lists all committed checkpoints from the entire/sessions branch.\n   672→// Scans sharded paths: <id[:2]>/<id[2:]>/ directories containing metadata.json.\n   673→//\n   674→\n   675→func (s *GitStore) ListCommitted(ctx context.Context) ([]CommittedInfo, error) {\n   676→\t_ = ctx // Reserved for future use\n   677→\n   678→\ttree, err := s.getSessionsBranchTree()\n   679→\tif err != nil {\n   680→\t\treturn []CommittedInfo{}, nil //nolint:nilerr // No sessions branch means empty list\n   681→\t}\n   682→\n   683→\tvar checkpoints []CommittedInfo\n   684→\n   685→\t// Scan sharded structure: <2-char-prefix>/<remaining-id>/metadata.json\n   686→\tfor _, bucketEntry := range tree.Entries {\n   687→\t\tif bucketEntry.Mode != filemode.Dir {\n   688→\t\t\tcontinue\n   689→\t\t}\n   690→\t\t// Bucket should be 2 hex chars\n   691→\t\tif len(bucketEntry.Name) != 2 {\n   692→\t\t\tcontinue\n   693→\t\t}\n   694→\n   695→\t\tbucketTree, treeErr := s.repo.TreeObject(bucketEntry.Hash)\n   696→\t\tif treeErr != nil {\n   697→\t\t\tcontinue\n   698→\t\t}\n   699→\n   700→\t\t// Each entry in the bucket is the remaining part of the checkpoint ID\n   701→\t\tfor _, checkpointEntry := range bucketTree.Entries {\n   702→\t\t\tif checkpointEntry.Mode != filemode.Dir {\n   703→\t\t\t\tcontinue\n   704→\t\t\t}\n   705→\n   706→\t\t\tcheckpointTree, cpTreeErr := s.repo.TreeObject(checkpointEntry.Hash)\n   707→\t\t\tif cpTreeErr != nil {\n   708→\t\t\t\tcontinue\n   709→\t\t\t}\n   710→\n   711→\t\t\t// Reconstruct checkpoint ID: <bucket><remaining>\n   712→\t\t\tcheckpointIDStr := bucketEntry.Name + checkpointEntry.Name\n   713→\t\t\tcheckpointID, cpIDErr := id.NewCheckpointID(checkpointIDStr)\n   714→\t\t\tif cpIDErr != nil {\n   715→\t\t\t\t// Skip invalid checkpoint IDs (shouldn't happen with our own data)\n   716→\t\t\t\tcontinue\n   717→\t\t\t}\n   718→\n   719→\t\t\tinfo := CommittedInfo{\n   720→\t\t\t\tCheckpointID: checkpointID,\n   721→\t\t\t}\n   722→\n   723→\t\t\t// Get details from metadata file\n   724→\t\t\tif metadataFile, fileErr := checkpointTree.File(paths.MetadataFileName); fileErr == nil {\n   725→\t\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   726→\t\t\t\t\tvar metadata CommittedMetadata\n