t\tgitSHA:  gitSHA,\n  1316→\t\t\tmessage: point.Message,\n  1317→\t\t})\n  1318→\n  1319→\t\t// Update flags - if any commit is temporary/task, the group is too\n  1320→\t\tif !point.IsLogsOnly {\n  1321→\t\t\tgroup.isTemporary = true\n  1322→\t\t}\n  1323→\t\tif point.IsTaskCheckpoint {\n  1324→\t\t\tgroup.isTask = true\n  1325→\t\t}\n  1326→\t\t// Update prompt if the group's prompt is empty but this point has one\n  1327→\t\tif group.prompt == \"\" && point.SessionPrompt != \"\" {\n  1328→\t\t\tgroup.prompt = point.SessionPrompt\n  1329→\t\t}\n  1330→\t}\n  1331→\n  1332→\t// Sort commits within each group by date (most recent first)\n  1333→\tfor _, group := range groupMap {\n  1334→\t\tsort.Slice(group.commits, func(i, j int) bool {\n  1335→\t\t\treturn group.commits[i].date.After(group.commits[j].date)\n  1336→\t\t})\n  1337→\t}\n  1338→\n  1339→\t// Build result slice in order, then sort by latest commit\n  1340→\tresult := make([]checkpointGroup, 0, len(order))\n  1341→\tfor _, cpID := range order {\n  1342→\t\tresult = append(result, *groupMap[cpID])\n  1343→\t}\n  1344→\n  1345→\t// Sort groups by latest commit timestamp (most recent first)\n  1346→\tsort.Slice(result, func(i, j int) bool {\n  1347→\t\t// Each group's commits are already sorted, so first commit is latest\n  1348→\t\tif len(result[i].commits) == 0 {\n  1349→\t\t\treturn false\n  1350→\t\t}\n  1351→\t\tif len(result[j].commits) == 0 {\n  1352→\t\t\treturn true\n  1353→\t\t}\n  1354→\t\treturn result[i].commits[0].date.After(result[j].commits[0].date)\n  1355→\t})\n  1356→\n  1357→\treturn result\n  1358→}\n  1359→\n  1360→// formatCheckpointGroup formats a single checkpoint group for display.\n  1361→func formatCheckpointGroup(sb *strings.Builder, group checkpointGroup) {\n  1362→\t// Checkpoint ID (truncated for display)\n  1363→\tcpID := group.checkpointID\n  1364→\tif len(cpID) > checkpointIDDisplayLength {\n  1365→\t\tcpID = cpID[:checkpointIDDisplayLength]\n  1366→\t}\n  1367→\n  1368→\t// Build status indicators\n  1369→\t// Skip [temporary] indicator when cpID is already \"temporary\" to avoid redundancy\n  1370→\tvar indicators []string\n  1371→\tif group.isTask {\n  1372→\t\tindicators = append(indicators, \"[Task]\")\n  1373→\t}\n  1374→\tif group.isTemporary && cpID != \"temporary\" {\n  1375→\t\tindicators = append(indicators, \"[temporary]\")\n  1376→\t}\n  1377→\n  1378→\tindicatorStr := \"\"\n  1379→\tif len(indicators) > 0 {\n  1380→\t\tindicatorStr = \" \" + strings.Join(indicators, \" \")\n  1381→\t}\n  1382→\n  1383→\t// Prompt (truncated)\n  1384→\tvar promptStr string\n  1385→\tif group.prompt == \"\" {\n  1386→\t\tpromptStr = \"(no prompt)\"\n  1387→\t} else {\n  1388→\t\t// Quote actual prompts\n  1389→\t\tpromptStr = fmt.Sprintf(\"%q\", strategy.TruncateDescription(group.prompt, maxPromptDisplayLength))\n  1390→\t}\n  1391→\n  1392→\t// Checkpoint header: [checkpoint_id] [indicators] prompt\n  1393→\tfmt.Fprintf(sb, \"[%s]%s %s\\n\", cpID, indicatorStr, promptStr)\n  1394→\n  1395→\t// List commits under this checkpoint\n  1396→\tfor _, commit := range group.commits {\n  1397→\t\t// Format: \"  MM-DD HH:MM (git_sha) message\"\n  1398→\t\tdateTimeStr := commit.date.Format(\"01-02 15:04\")\n  1399→\t\tmessage := strategy.TruncateDescription(commit.message, maxMessageDisplayLength)\n  1400→\t\tfmt.Fprintf(sb, \"  %s (%s) %s\\n\", dateTimeStr, commit.gitSHA, message)\n  1401→\t}\n  1402→}\n  1403→\n  1404→// countLines counts the number of lines in a byte slice.\n  1405→// For JSONL content (where each line ends with \\n), this returns the line count.\n  1406→// Empty content returns 0.\n  1407→func countLines(content []byte) int {\n  1408→\tif len(content) == 0 {\n  1409→\t\treturn 0\n  1410→\t}\n  1411→\tcount := 0\n  1412→\tfor _, b := range content {\n  1413→\t\tif b == '\\n' {\n  1414→\t\t\tcount++\n  1415→\t\t}\n  1416→\t}\n  1417→\treturn count\n  1418→}\n  1419→\n  1420→// hasCodeChanges returns true if the commit has changes to non-metadata files.\n  1421→// Used by getBranchCheckpoints to filter out metadata-only temporary checkpoints.\n  1422→// Returns false only if the commit has a parent AND only modified .entire/ metadata files.\n  1423→//\n  1424→// First commits (no parent) are always considered to have code changes since they\n  1425→// capture the working copy state at session start - real uncommitted work.\n  1426→//\n  1427→// This filters out periodic transcript saves that don't change code.\n  1428→func hasCodeChanges(commit *object.Commit) bool {\n  1429→\t// First commit on shadow branch captures working copy state - always meaningful\n  1430→\tif commit.NumParents() == 0 {\n  1431→\t\treturn true\n  1432→\t}\n  1433→\n  1434→\tparent, err := commit.Parent(0)\n  1435→\tif err != nil {\n  1436→\t\treturn true // Can't check, assume meaningful\n  1437→\t}\n  1438→\n  1439→\tcommitTree, err := commit.Tree()\n  1440→\tif err != nil {\n  1441→\t\treturn true\n  1442→\t}\n  1443→\n  1444→\tparentTree, err := parent.Tree()\n  1445→\tif err != nil {\n  1446→\t\treturn true\n  1447→\t}\n  1448→\n  1449→\tchanges, err := parentTree.Diff(commitTree)\n  1450→\tif err != nil {\n  1451→\t\treturn true\n  1452→\t}\n  1453→\n  1454→\t// Check if any non-metadata file was changed\n  1455→\tfor _, change := range changes {\n  1456→\t\tname := change.To.Name\n  1457→\t\tif name == \"\" {\n  1458→\t\t\tname = change.From.Name\n  1459→\t\t}\n  1460→\t\t// Skip .entire/ metadata files\n  1461→\t\tif !strings.HasPrefix(name, \".entire/\") {\n  1462→\t\t\treturn true\n  1463→\t\t}\n  1464→\t}\n  1465→\n  1466→\treturn false\n  1467→}\n  1468→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid"