ID: cpID,\n  1309→\t\t\t\tprompt:       point.SessionPrompt,\n  1310→\t\t\t\tisTemporary:  !point.IsLogsOnly,\n  1311→\t\t\t\tisTask:       point.IsTaskCheckpoint,\n  1312→\t\t\t}\n  1313→\t\t\tgroupMap[cpID] = group\n  1314→\t\t\torder = append(order, cpID)\n  1315→\t\t}\n  1316→\n  1317→\t\t// Short git SHA (7 chars)\n  1318→\t\tgitSHA := point.ID\n  1319→\t\tif len(gitSHA) > 7 {\n  1320→\t\t\tgitSHA = gitSHA[:7]\n  1321→\t\t}\n  1322→\n  1323→\t\tgroup.commits = append(group.commits, commitEntry{\n  1324→\t\t\tdate:    point.Date,\n  1325→\t\t\tgitSHA:  gitSHA,\n  1326→\t\t\tmessage: point.Message,\n  1327→\t\t})\n  1328→\n  1329→\t\t// Update flags - if any commit is temporary/task, the group is too\n  1330→\t\tif !point.IsLogsOnly {\n  1331→\t\t\tgroup.isTemporary = true\n  1332→\t\t}\n  1333→\t\tif point.IsTaskCheckpoint {\n  1334→\t\t\tgroup.isTask = true\n  1335→\t\t}\n  1336→\t\t// Update prompt if the group's prompt is empty but this point has one\n  1337→\t\tif group.prompt == \"\" && point.SessionPrompt != \"\" {\n  1338→\t\t\tgroup.prompt = point.SessionPrompt\n  1339→\t\t}\n  1340→\t}\n  1341→\n  1342→\t// Sort commits within each group by date (most recent first)\n  1343→\tfor _, group := range groupMap {\n  1344→\t\tsort.Slice(group.commits, func(i, j int) bool {\n  1345→\t\t\treturn group.commits[i].date.After(group.commits[j].date)\n  1346→\t\t})\n  1347→\t}\n  1348→\n  1349→\t// Build result slice in order, then sort by latest commit\n  1350→\tresult := make([]checkpointGroup, 0, len(order))\n  1351→\tfor _, cpID := range order {\n  1352→\t\tresult = append(result, *groupMap[cpID])\n  1353→\t}\n  1354→\n  1355→\t// Sort groups by latest commit timestamp (most recent first)\n  1356→\tsort.Slice(result, func(i, j int) bool {\n  1357→\t\t// Each group's commits are already sorted, so first commit is latest\n  1358→\t\tif len(result[i].commits) == 0 {\n  1359→\t\t\treturn false\n  1360→\t\t}\n  1361→\t\tif len(result[j].commits) == 0 {\n  1362→\t\t\treturn true\n  1363→\t\t}\n  1364→\t\treturn result[i].commits[0].date.After(result[j].commits[0].date)\n  1365→\t})\n  1366→\n  1367→\treturn result\n  1368→}\n  1369→\n  1370→// formatCheckpointGroup formats a single checkpoint group for display.\n  1371→func formatCheckpointGroup(sb *strings.Builder, group checkpointGroup) {\n  1372→\t// Checkpoint ID (truncated for display)\n  1373→\tcpID := group.checkpointID\n  1374→\tif len(cpID) > checkpointIDDisplayLength {\n  1375→\t\tcpID = cpID[:checkpointIDDisplayLength]\n  1376→\t}\n  1377→\n  1378→\t// Build status indicators\n  1379→\t// Skip [temporary] indicator when cpID is already \"temporary\" to avoid redundancy\n  1380→\tvar indicators []string\n  1381→\tif group.isTask {\n  1382→\t\tindicators = append(indicators, \"[Task]\")\n  1383→\t}\n  1384→\tif group.isTemporary && cpID != \"temporary\" {\n  1385→\t\tindicators = append(indicators, \"[temporary]\")\n  1386→\t}\n  1387→\n  1388→\tindicatorStr := \"\"\n  1389→\tif len(indicators) > 0 {\n  1390→\t\tindicatorStr = \" \" + strings.Join(indicators, \" \")\n  1391→\t}\n  1392→\n  1393→\t// Prompt (truncated)\n  1394→\tvar promptStr string\n  1395→\tif group.prompt == \"\" {\n  1396→\t\tpromptStr = \"(no prompt)\"\n  1397→\t} else {\n  1398→\t\t// Quote actual prompts\n  1399→\t\tpromptStr = fmt.Sprintf(\"%q\", strategy.TruncateDescription(group.prompt, maxPromptDisplayLength))\n  1400→\t}\n  1401→\n  1402→\t// Checkpoint header: [checkpoint_id] [indicators] prompt\n  1403→\tfmt.Fprintf(sb, \"[%s]%s %s\\n\", cpID, indicatorStr, promptStr)\n  1404→\n  1405→\t// List commits under this checkpoint\n  1406→\tfor _, commit := range group.commits {\n  1407→\t\t// Format: \"  MM-DD HH:MM (git_sha) message\"\n  1408→\t\tdateTimeStr := commit.date.Format(\"01-02 15:04\")\n  1409→\t\tmessage := strategy.TruncateDescription(commit.message, maxMessageDisplayLength)\n  1410→\t\tfmt.Fprintf(sb, \"  %s (%s) %s\\n\", dateTimeStr, commit.gitSHA, message)\n  1411→\t}\n  1412→}\n  1413→\n  1414→// countLines counts the number of lines in a byte slice.\n  1415→// For JSONL content (where each line ends with \\n), this returns the line count.\n  1416→// Empty content returns 0.\n  1417→func countLines(content []byte) int {\n  1418→\tif len(content) == 0 {\n  1419→\t\treturn 0\n  1420→\t}\n  1421→\tcount := 0\n  1422→\tfor _, b := range content {\n  1423→\t\tif b == '\\n' {\n  1424→\t\t\tcount++\n  1425→\t\t}\n  1426→\t}\n  1427→\treturn count\n  1428→}\n  1429→\n  1430→// hasCodeChanges returns true if the commit has changes to non-metadata files.\n  1431→// Used by getBranchCheckpoints to filter out metadata-only temporary checkpoints.\n  1432→// Returns false only if the commit has a parent AND only modified .entire/ metadata files.\n  1433→//\n  1434→// First commits (no parent) are always considered to have code changes since they\n  1435→// capture the working copy state at session start - real uncommitted work.\n  1436→//\n  1437→// This filters out periodic transcript saves that don't change code.\n  1438→func hasCodeChanges(commit *object.Commit) bool {\n  1439→\t// First commit on shadow branch captures working copy state - always meaningful\n  1440→\tif commit.NumParents() == 0 {\n  1441→\t\treturn true\n  1442→\t}\n  1443→\n  1444→\tparent, err := commit.Parent(0)\n  1445→\tif err != nil {\n  1446→\t\treturn true // Can't check, assume meaningful\n  1447→\t}\n  1448→\n  1449→\tcommitTree, err := commit.Tree()\n  1450→\tif err != nil {\n  1451→\t\treturn true\n  1452→\t}\n  1453→\n  1454→\tparentTree, err := parent.Tree()\n  1455→\tif err != nil {\n  1456→\t\treturn true\n  1457→\t}\n  1458→\n  1459→\tchanges, err := parentTree.Diff(commitTree)\n  1460→\tif err != nil {\n  1461→\t\treturn true\n  1462→\t}\n  1463→\n  1464→\t// Check if any non-metadata file was changed\n  1465→\tfor _, change := range changes {\n  1466→\t\tname := change.To.Name\n  1467→\t\tif name == \"\" {\n  1468→\t\t\tname = change.From.Name\n  1469→\t\t}\n  1470