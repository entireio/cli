n  1212→\t// maxPromptDisplayLength is the maximum length for session prompts before truncation\n  1213→\tmaxPromptDisplayLength = 60\n  1214→\t// checkpointIDDisplayLength is the number of characters to show from checkpoint IDs\n  1215→\tcheckpointIDDisplayLength = 12\n  1216→)\n  1217→\n  1218→// formatBranchCheckpoints formats checkpoint information for a branch.\n  1219→// Groups commits by checkpoint ID and shows the prompt for each checkpoint.\n  1220→// If sessionFilter is non-empty, only shows checkpoints matching that session ID (or prefix).\n  1221→func formatBranchCheckpoints(branchName string, points []strategy.RewindPoint, sessionFilter string) string {\n  1222→\tvar sb strings.Builder\n  1223→\n  1224→\t// Branch header\n  1225→\tfmt.Fprintf(&sb, \"Branch: %s\\n\", branchName)\n  1226→\n  1227→\t// Filter by session if specified\n  1228→\tif sessionFilter != \"\" {\n  1229→\t\tvar filtered []strategy.RewindPoint\n  1230→\t\tfor _, p := range points {\n  1231→\t\t\tif p.SessionID == sessionFilter || strings.HasPrefix(p.SessionID, sessionFilter) {\n  1232→\t\t\t\tfiltered = append(filtered, p)\n  1233→\t\t\t}\n  1234→\t\t}\n  1235→\t\tpoints = filtered\n  1236→\t}\n  1237→\n  1238→\tif len(points) == 0 {\n  1239→\t\tsb.WriteString(\"Checkpoints: 0\\n\")\n  1240→\t\tif sessionFilter != \"\" {\n  1241→\t\t\tfmt.Fprintf(&sb, \"Filtered by session: %s\\n\", sessionFilter)\n  1242→\t\t}\n  1243→\t\tsb.WriteString(\"\\nNo checkpoints found on this branch.\\n\")\n  1244→\t\tsb.WriteString(\"Checkpoints will appear here after you save changes during a Claude session.\\n\")\n  1245→\t\treturn sb.String()\n  1246→\t}\n  1247→\n  1248→\t// Group by checkpoint ID\n  1249→\tgroups := groupByCheckpointID(points)\n  1250→\n  1251→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(groups))\n  1252→\tif sessionFilter != \"\" {\n  1253→\t\tfmt.Fprintf(&sb, \"Filtered by session: %s\\n\", sessionFilter)\n  1254→\t}\n  1255→\tsb.WriteString(\"\\n\")\n  1256→\n  1257→\t// Output