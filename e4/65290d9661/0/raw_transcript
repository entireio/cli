th --commit or --checkpoint, that's still an error\n   161→\tif sessionID != \"\" && flagCount > 0 {\n   162→\t\treturn errors.New(\"cannot specify multiple of --session, --commit, --checkpoint\")\n   163→\t}\n   164→\tif flagCount > 1 {\n   165→\t\treturn errors.New(\"cannot specify multiple of --session, --commit, --checkpoint\")\n   166→\t}\n   167→\n   168→\t// Route to appropriate handler\n   169→\tif commitRef != \"\" {\n   170→\t\treturn runExplainCommit(w, commitRef, noPager, verbose, full, searchAll)\n   171→\t}\n   172→\tif checkpointID != \"\" {\n   173→\t\treturn runExplainCheckpoint(w, errW, checkpointID, noPager, verbose, full, rawTranscript, generate, force, searchAll)\n   174→\t}\n   175→\n   176→\t// Default or with session filter: show list view (optionally filtered by session)\n   177→\treturn runExplainBranchWithFilter(w, noPager, sessionID)\n   178→}\n   179→\n   180→// runExplainCheckpoint explains a specific checkpoint.\n   181→// Supports both committed checkpoints (by checkpoint ID) and temporary checkpoints (by git SHA).\n   182→// First tries to match committed checkpoints, then falls back to temporary checkpoints.\n   183→// When generate is true, generates an AI summary for the checkpoint.\n   184→// When force is true, regenerates even if a summary already exists.\n   185→// When rawTranscript is true, outputs only the raw transcript file (JSONL format).\n   186→// When searchAll is true, searches all commits without branch/depth limits (used for finding associated commits).\n   187→func runExplainCheckpoint(w, errW io.Writer, checkpointIDPrefix string, noPager, verbose, full, rawTranscript, generate, force, searchAll bool) error {\n   188→\trepo, err := openRepository()\n   189→\tif err != nil {\n   190→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   191→\t}\n   192→\n   193→\tstore := checkpoint.NewGitStore(repo)\n   194→\n   195→\t// First, try to find in committed checkpoints by checkpoint ID prefix\n   196→\tcommitted, err := store.ListCommitted(context.Background())\n   197→\tif err != nil {\n   198→\t\treturn fmt.Errorf(\"failed to list checkpoints: %w\", err)\n   199→\t}\n   200→\n   201→\t// Collect all matching checkpoint IDs to detect ambiguity\n   202→\tvar matches []id.CheckpointID\n   203→\tfor _, info := range committed {\n   204→\t\tif strings.HasPrefix(info.CheckpointID.String(), checkpointIDPrefix) {\n   205→\t\t\tmatches = append(matches, info.CheckpointID)\n   206→\t\t}\n   207→\t}\n   208→\n   209→\tvar fullCheckpointID id.CheckpointID\n   210→\tswitch len(matches) {\n   211→\tcase 0:\n   212→\t\t// Not found in committed, try temporary checkpoints by git SHA\n   213→\t\tif generate {\n   214→\t\t\treturn fmt.Errorf(\"cannot generate summary for temporary checkpoint %s (only committed checkpoints supported)\", checkpointIDPrefix)\n   215→\t\t}\n   216→\t\toutput, found := explainTemporaryCheckpoint(w, repo, store, checkpointIDPrefix, verbose, full, rawTranscript)\n   217→\t\tif found {\n   218→\t\t\toutputExplainContent(w, output, noPager)\n   219→\t\t\treturn nil\n   220→\t\t}\n   221→\t\t// If output is non-empty, it contains an error message (e.g., ambiguous prefix)\n   222→\t\tif output != \"\" {\n   223→\t\t\treturn errors.New(output)\n   224→\t\t}\n   225→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", checkpointIDPrefix)\n   226→\tcase 1:\n   227→\t\tfullCheckpointID = matches[0]\n   228→\tdefault:\n   229→\t\t// Ambiguous prefix - show up to 5 examples\n   230→\t\texamples := make([]string, 0, 5)\n   231→\t\tfor i := 0; i < len(matches) && i < 5; i++ {\n   232→\t\t\texamples = append(examples, matches[i].String())\n   233→\t\t}\n   234→\t\treturn fmt.Errorf(\"ambiguous checkpoint prefix %q matches %d checkpoints: %s\", checkpointIDPrefix, len(matches), strings.Join(examples, \", \"))\n   235→\t}\n   236→\n   237→\t// Load checkpoint data\n   238→\tresult, err := store.ReadCommitted(context.Background(), fullCheckpointID)\n   239→\tif err != nil {\n   240→\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   241→\t}\n   242→\tif result == nil {\n   243→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", fullCheckpointID)\n   244→\t}\n   245→\n   246→\t// Handle summary generation\n   247→\tif generate {\n   248→\t\tif err := generateCheckpointSummary(w, errW, store, fullCheckpointID, result, force); err != nil {\n   249→\t\t\treturn err\n   250→\t\t}\n   251→\t\t// Reload the result to get the updated summary\n   252→\t\tresult, err = store.ReadCommitted(context.Background(), fullCheckpointID)\n   253→\t\tif err != nil {\n   254→\t\t\treturn fmt.Errorf(\"failed to reload checkpoint: %w\", err)\n   255→\t\t}\n   256→\t\tif result == nil {\n   257→\t\t\treturn fmt.Errorf(\"checkpoint not found after save: %s\", fullCheckpointID)\n   258→\t\t}\n   259→\t}\n   260→\n   261→\t// Handle raw transcript output\n   262→\tif rawTranscript {\n   263→\t\tif len(result.Transcript) == 0 {\n   264→\t\t\treturn fmt.Errorf(\"checkpoint %s has no transcript\", fullCheckpointID)\n   265→\t\t}\n   266→\t\t// Output raw transcript directly (no pager, no formatting)\n   267→\t\tif _, err = w.Write(result.Transcript); err != nil {\n   268→\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n   269→\t\t}\n   270→\t\treturn nil\n   271→\t}\n   272→\n   273→\t// Look up the author for this checkpoint (best-effort, ignore errors)\n   274→\tauthor, _ := store.GetCheckpointAuthor(context.Background(), fullCheckpointID) //nolint:errcheck // Author is optional\n   275→\n   276→\t// Find associated commits (git commits with matching Entire-Checkpoint trailer)\n   277→\tassociatedCommits, _ := getAssociatedCommits(repo, fullCheckpointID, searchAll) //nolint:errcheck // Best-effort\n   278→\n   279→\t// Format and output\n   280→\toutput := formatCheckpointOutput(result, fullCheckpointID, associatedCommits, author, verbose, full)\n   281→\toutputExplainContent(w, output, noPager)\n   282→\treturn nil\n   283→}\n   284→\n   285→// generateCheckpointSummary generates an AI summary for a checkpoint and persists it.\n   286→// The summary is generated from the scoped transcript (only this checkpoint's portion),\n   287→// not the entire session transcript.\n   288→func generateCheckpointSummary(w, _ io.Writer, store *checkpoint.GitStore, checkpointID id.CheckpointID, result *checkpoint.ReadCommittedResult, force bool) error {\n   289→\t// Check if summary already exists\n   290→\tif result.Metadata.Summary != nil && !force {\n   291→\t\treturn fmt.Errorf(\"checkpoint %s already has a summary (use --force to regenerate)\", checkpointID)\n   292→\t}\n   293→\n   294→\t// Check if transcript exists\n   295→\tif len(result.Transcript) == 0 {\n   296→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript to summarise\", checkpointID)\n   297→\t}\n   298→\n   299→\t// Scope the transcript to only this checkpoint's portion\n   300→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   301→\tif len(scopedTranscript) == 0 {\n   302→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript content for this checkpoint (scoped)\", checkpointID)\n   303→\t}\n   304→\n   305→\t// Build condensed transcript for summarisation from the scoped portion\n   306→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(scopedTranscript)\n   307→\tif err != nil {\n   308→\t\treturn fmt.Errorf(\"failed to parse transcript: %w\", err)\n   309→\t}\n   310→\tif len(condensed) == 0 {\n   311→\t\treturn fmt.Errorf(\"checkpoint %s transcript has no content to summarise\", checkpointID)\n   312→\t}\n   313→\n   314→\tinput := summarise.Input{\n   315→\t\tTranscript:   condensed,\n   316→\t\tFilesTouched: result.Metadata.FilesTouched,\n   317→\t}\n   318→\n   319→\t// Generate summary using Claude CLI\n   320→\tctx := context.Background()\n   321→\tlogging.Info(ctx, \"generating checkpoint summary\")\n   322→\n   323→\tvar generator summarise.Generator = &summarise.ClaudeGenerator{}\n   324→\tsummary, err := generator.Generate(ctx, input)\n   325→\tif err != nil {\n   326→\t\treturn fmt.Errorf(\"failed to generate summary: %w\", err)\n   327→\t}\n   328→\n   329→\t// Persist the summary\n   330→\tif err := store.UpdateSummary(ctx, checkpointID, summary); err != nil {\n   331→\t\treturn fmt.Errorf(\"failed to save summary: %w\", err)\n   332→\t}\n   333→\n   334→\tfmt.Fprintln(w, \"✓ Summary generated and saved\")\n   335→\treturn nil\n   336→}\n   337→\n   338→// explainTemporaryCheckpoint finds and formats a temporary checkpoint by shadow commit hash prefix.\n   339→// Returns the formatted output and whether the checkpoint was found.\n   340→// Searches ALL shadow branches, not just the one for current HEAD, to find checkpoints\n   341→// created from different base commits (e.g., if HEAD advanced since session start).\n   342→// The writer w is used for raw transcript output to bypass the pager.\n   343→func explainTemporaryCheckpoint(w io.Writer, repo *git.Repository, store *checkpoint.GitStore, shaPrefix string, verbose, full, rawTranscript bool) (string, bool) {\n   344→\t// List temporary checkpoints from ALL shadow branches\n   345→\t// This ensures we find checkpoints even if HEAD has advanced since the session started\n   346→\ttempCheckpoints, err := store.ListAllTemporaryCheckpoints(context.Background(), \"\", branchCheckpointsLimit)\n   347→\tif err != nil {\n   348→\t\treturn \"\", false\n   349→\t}\n   350→\n   351→\t// Find checkpoints matching the SHA prefix - check for ambiguity\n   352→\tvar matches []checkpoint.TemporaryCheckpointInfo\n   353→\tfor _, tc := range tempCheckpoints {\n   354→\t\tif strings.HasPrefix(tc.CommitHash.String(), shaPrefix) {\n   355→\t\t\tmatches = append(matches, tc)\n   356→\t\t}\n   357→\t}\n   358→\n   359→\tif len(matches) == 0 {\n   360→\t\treturn \"\", false\n   361→\t}\n   362→\n   363→\tif len(matches) > 1 {\n   364→\t\t// Multiple matches - return ambiguous error (consistent with committed checkpoint behavior)\n   365→\t\tvar sb strings.Builder\n   366→\t\tfmt.Fprintf(&sb, \"ambiguous checkpoint prefix %q matches %d temporary checkpoints:\\n\", shaPrefix, len(matches))\n   367→\t\tfor _, m := range matches {\n   368→\t\t\tshortID := m.CommitHash.String()[:7]\n   369→\t\t\tfmt.Fprintf(&sb, \"  %s  %s  session %s\\n\",\n   370→\t\t\t\tshortID,\n   371→\t\t\t\tm.Timestamp.Format(\"2006-01-02 15:04:05\"),\n   372→\t\t\t\tm.SessionID)\n   373→\t\t}\n   374→\t\t// Return as \"not found\" with error message - caller will use this as error\n   375→\t\treturn sb.String(), false\n   376→\t}\n   377→\n   378→\ttc := matches[0]\n   379→\n   380→\t// Handle raw transcript output\n   381→\tif rawTranscript {\n   382→\t\ttranscriptBytes, transcriptErr := store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown)\n   383→\t\tif transcriptErr != nil || len(transcriptBytes) == 0 {\n   384→\t\t\t// Return specific error message (consistent with committed checkpoints)\n   385→\t\t\treturn fmt.Sprintf(\"checkpoint %s has no transcript\", tc.CommitHash.String()[:7]), false\n   386→\t\t}\n   387→\t\t// Write directly to writer (no pager, no formatting) - matches committed checkpoint behavior\n   388→\t\tif _, writeErr := fmt.Fprint(w, string(transcriptBytes)); writeErr != nil {\n   389→\t\t\treturn fmt.Sprintf(\"failed to write transcript: %v\", writeErr), false\n   390→\t\t}\n   391→\t\treturn \"\", true\n   392→\t}\n   393→\n   394→\t// Found exactly one match - read metadata from shadow branch commit tree\n   395→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   396→\tif commitErr != nil {\n   397→\t\treturn \"\", false\n   398→\t}\n   399→\n   400→\tshadowTree, treeErr := shadowCommit.Tree()\n   401→\tif treeErr != nil {\n   402→\t\treturn \"\", false\n   403→\t}\n   404→\n   405→\t// Read prompts from shadow branch\n   406→\tsessionPrompt := strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   407→\n   408→\t// Build output similar to formatCheckpointOutput but for temporary\n   409→\tvar sb strings.Builder\n   410→\tshortID := tc.CommitHash.String()[:7]\n   411→\tfmt.Fprintf(&sb, \"Checkpoint: %s [temporary]\\n\", shortID)\n   412→\tfmt.Fprintf(&sb, \"Session: %s\\n\", tc.SessionID)\n   413→\tfmt.Fprintf(&sb, \"Created: %s\\n\", tc.Timestamp.Format(\"2006-01-02 15:04:05\"))\n   414→\tsb.WriteString(\"\\n\")\n   415→\n   416→\t// Intent from prompt\n   417→\tintent := \"(not available)\"\n   418→\tif sessionPrompt != \"\" {\n   419→\t\tlines := strings.Split(sessionPrompt, \"\\n\")\n   420→\t\tif len(lines) > 0 && lines[0] != \"\" {\n   421→\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   422→\t\t}\n   423→\t}\n   424→\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   425→\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   426→\n   427→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   428→\t// For temporary checkpoints, load transcript and compute scope from parent commit\n   429→\tvar fullTranscript []byte\n   430→\tvar scopedTranscript []byte\n   431→\tif full || verbose {\n   432→\t\tfullTranscript, _ = store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   433→\n   434→\t\tif verbose && len(fullTranscript) > 0 {\n   435→\t\t\t// Compute scoped transcript by finding where parent's transcript ended\n   436→\t\t\t// Each shadow branch commit has the full transcript up to that point,\n   437→\t\t\t// so we diff against parent to get just this checkpoint's activity\n   438→\t\t\tscopedTranscript = fullTranscript // Default to full if no parent\n   439→\t\t\tif shadowCommit.NumParents() > 0 {\n   440→\t\t\t\tif parent, parentErr := shadowCommit.Parent(0); parentErr == nil {\n   441→\t\t\t\t\tparentTranscript, _ := store.GetTranscriptFromCommit(parent.Hash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   442→\t\t\t\t\tif len(parentTranscript) > 0 {\n   443→\t\t\t\t\t\t// Count lines in parent transcript to know where to slice from\n   444→\t\t\t\t\t\tparentLineCount := countLines(parentTranscript)\n   445→\t\t\t\t\t\tscopedTranscript = transcript.SliceFromLine(fullTranscript, parentLineCount)\n   446→\t\t\t\t\t}\n   447→\t\t\t\t}\n   448→\t\t\t}\n   449→\t\t}\n   450→\t}\n   451→\tappendTranscriptSection(&sb, verbose, full, fullTranscript, scopedTranscript, sessionPrompt)\n   452→\n   453→\treturn sb.String(), true\n   454→}\n   455→\n   456→// getAssociatedCommits finds git commits that reference the given checkpoint ID.\n   457→// Searches commits on the current branch for Entire-Checkpoint trailer matches.\n   458→// When searchAll is true, removes the commit scan limit (may be slow).\n   459→func getAssociatedCommits(repo *git.Repository, checkpointID id.CheckpointID, searchAll bool) ([]associatedCommit, error) {\n   460→\thead, err := repo.Head()\n   461→\tif err != nil {\n   462→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   463→\t}\n   464→\n   465→\t// Determine scan limit\n   466→\tlimit := commitScanLimit\n   467→\tif searchAll {\n   468→\t\tlimit = 0 // No limit\n   469→\t}\n   470→\n   471→\t// Check if on default branch for filtering\n   472→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   473→\tvar mainBranchHash plumbing.Hash\n   474→\tif !isOnDefault {\n   475→\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   476→\t}\n   477→\n   478→\t// Precompute main branch commits for filtering (same logic as getBranchCheckpoints)\n   479→\treachableFromMain := make(map[plumbing.Hash]bool)\n   480→\tif mainBranchHash != plumbing.ZeroHash {\n   481→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   482→\t\tif mainErr == nil {\n   483→\t\t\tmainCount := 0\n   484→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort main branch detection\n   485→\t\t\t\tmainCount++\n   486→\t\t\t\tif mainCount > 1000 {\n   487→\t\t\t\t\treturn errStopIteration\n   488→\t\t\t\t}\n   489→\t\t\t\treachableFromMain[c.Hash] = true\n   490→\t\t\t\treturn nil\n   491→\t\t\t})\n   492→\t\t\tmainIter.Close()\n   493→\t\t}\n   494→\t}\n   495→\n   496→\titer, err := repo.Log(&git.LogOptions{\n   497→\t\tFrom:  head.Hash(),\n   498→\t\tOrder: git.LogOrderCommitterTime,\n   499→\t})\n   500→\tif err != nil {\n   501→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   502→\t}\n   503→\tdefer iter.Close()\n   504→\n   505→\tvar commits []associatedCommit\n   506→\tcount := 0\n   507→\ttargetID := checkpointID.String()\n   508→\n   509→\terr = iter.ForEach(func(c *object.Commit) error {\n   510→\t\tif limit > 0 && count >= limit {\n   511→\t\t\treturn errStopIteration\n   512→\t\t}\n   513→\t\tcount++\n   514→\n   515→\t\t// Skip commits on main when on feature branch (same filtering as list view)\n   516→\t\tif len(reachableFromMain) > 0 && reachableFromMain[c.Hash] {\n   517→\t\t\treturn nil\n   518→\t\t}\n   519→\n   520→\t\t// Check for matching checkpoint trailer\n   521→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   522→\t\tif !found || cpID.String() != targetID {\n   523→\t\t\treturn nil\n   524→\t\t}\n   525→\n   526→\t\tfullSHA := c.Hash.String()\n   527→\t\tshortSHA := fullSHA\n   528→\t\tif len(fullSHA) >= 7 {\n   529→\t\t\tshortSHA = fullSHA[:7]\n   530→\t\t}\n   531→\n   532→\t\tcommits = append(commits, associatedCommit{\n   533→\t\t\tSHA:      fullSHA,\n   534→\t\t\tShortSHA: shortSHA,\n   535→\t\t\tMessage:  strings.Split(c.Message, \"\\n\")[0],\n   536→\t\t\tAuthor:   c.Author.Name,\n   537→\t\t\tDate:     c.Author.When,\n   538→\t\t})\n   539→\n   540→\t\treturn nil\n   541→\t})\n   542→\n   543→\tif err != nil && !errors.Is(err, errStopIteration) {\n   544→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   545→\t}\n   546→\n   547→\treturn commits, nil\n   548→}\n   549→\n   550→// scopeTranscriptForCheckpoint slices a transcript to include only the lines\n   551→// relevant to a specific checkpoint, starting from linesAtStart.\n   552→// This allows showing only what happened during a checkpoint, not the entire session.\n   553→func scopeTranscriptForCheckpoint(fullTranscript []byte, linesAtStart int) []byte {\n   554→\treturn transcript.SliceFromLine(fullTranscript, linesAtStart)\n   555→}\n   556→\n   557→// extractPromptsFromTranscript extracts user prompts from transcript bytes.\n   558→// Returns a slice of prompt strings.\n   559→func extractPromptsFromTranscript(transcriptBytes []byte) []string {\n   560→\tif len(transcriptBytes) == 0 {\n   561→\t\treturn nil\n   562→\t}\n   563→\n   564→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   565→\tif err != nil {\n   566→\t\treturn nil\n   567→\t}\n   568→\n   569→\tvar prompts []string\n   570→\tfor _, entry := range condensed {\n   571→\t\tif entry.Type == summarise.EntryTypeUser && entry.Content != \"\" {\n   572→\t\t\tprompts = append(prompts, entry.Content)\n   573→\t\t}\n   574→\t}\n   575→\treturn prompts\n   576→}\n   577→\n   578→// formatCheckpointOutput formats checkpoint data based on verbosity level.\n   579→// When verbose is false: summary only (ID, session, timestamp, tokens, intent).\n   580→// When verbose is true: adds files, associated commits, and scoped transcript for this checkpoint.\n   581→// When full is true: shows parsed full session transcript instead of scoped transcript.\n   582→//\n   583→// Transcript scope is controlled by TranscriptLinesAtStart in metadata, which indicates\n   584→// where this checkpoint's content begins in the full session transcript.\n   585→//\n   586→// Author is displayed when available (only for committed checkpoints).\n   587→// Associated commits are git commits that reference this checkpoint via Entire-Checkpoint trailer.\n   588→func formatCheckpointOutput(result *checkpoint.ReadCommittedResult, checkpointID id.CheckpointID, associatedCommits []associatedCommit, author checkpoint.Author, verbose, full bool) string {\n   589→\tvar sb strings.Builder\n   590→\tmeta := result.Metadata\n   591→\n   592→\t// Scope the transcript to this checkpoint's portion\n   593→\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   594→\t// lines from that point onwards (excluding earlier checkpoint content)\n   595→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, meta.TranscriptLinesAtStart)\n   596→\n   597→\t// Extract prompts from the scoped transcript for intent extraction\n   598→\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   599→\n   600→\t// Header - always shown\n   601→\t// Note: CheckpointID is always exactly 12 characters, matching checkpointIDDisplayLength\n   602→\tfmt.Fprintf(&sb, \"Checkpoint: %s\\n\", checkpointID)\n   603→\tfmt.Fprintf(&sb, \"Session: %s\\n\", meta.SessionID)\n   604→\tfmt.Fprintf(&sb, \"Created: %s\\n\", meta.CreatedAt.Format(\"2006-01-02 15:04:05\"))\n   605→\n   606→\t// Author (only for committed checkpoints with known author)\n   607→\tif author.Name != \"\" {\n   608→\t\tfmt.Fprintf(&sb, \"Author: %s <%s>\\n\", author.Name, author.Email)\n   609→\t}\n   610→\n   611→\t// Token usage\n   612→\tif meta.TokenUsage != nil {\n   613→\t\ttotalTokens := meta.TokenUsage.InputTokens + meta.TokenUsage.CacheCreationTokens +\n   614→\t\t\tmeta.TokenUsage.CacheReadTokens + meta.TokenUsage.OutputTokens\n   615→\t\tfmt.Fprintf(&sb, \"Tokens: %d\\n\", totalTokens)\n   616→\t}\n   617→\n   618→\t// Associated commits section\n   619→\tif len(associatedCommits) > 0 {\n   620→\t\tsb.WriteString(\"\\n\")\n   621→\t\tfmt.Fprintf(&sb, \"Commits: (%d)\\n\", len(associatedCommits))\n   622→\t\tfor _, c := range associatedCommits {\n   623→\t\t\tfmt.Fprintf(&sb, \"  %s %s %s\\n\", c.ShortSHA, c.Date.Format(\"2006-01-02\"), c.Message)\n   624→\t\t}\n   625→\t} else if associatedCommits != nil {\n   626→\t\t// associatedCommits is non-nil but empty - show \"no commits found\" message\n   627→\t\tsb.WriteString(\"\\nCommits: No commits found on this branch\\n\")\n   628→\t}\n   629→\n   630→\tsb.WriteString(\"\\n\")\n   631→\n   632→\t// Intent and Outcome from AI summary, or fallback to prompt text\n   633→\tif meta.Summary != nil {\n   634→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", meta.Summary.Intent)\n   635→\t\tfmt.Fprintf(&sb, \"Outcome: %s\\n\", meta.Summary.Outcome)\n   636→\t} else {\n   637→\t\t// Fallback: use first line of scoped prompts for intent,\n   638→\t\t// or fall back to result.Prompts for backwards compatibility with older checkpoints\n   639→\t\tintent := \"(not generated)\"\n   640→\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   641→\t\t\tintent = strategy.TruncateDescription(scopedPrompts[0], maxIntentDisplayLength)\n   642→\t\t} else if result.Prompts != \"\" {\n   643→\t\t\t// Backwards compatibility: use stored prompts if no transcript available\n   644→\t\t\tlines := strings.Split(result.Prompts, \"\\n\")\n   645→\t\t\tif len(lines) > 0 && lines[0] != \"\" {\n   646→\t\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   647→\t\t\t}\n   648→\t\t}\n   649→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   650→\t\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   651→\t}\n   652→\n   653→\t// Verbose: add learnings, friction, files, and scoped transcript\n   654→\tif verbose || full {\n   655→\t\t// AI Summary details (learnings, friction, open items)\n   656→\t\tif meta.Summary != nil {\n   657→\t\t\tformatSummaryDetails(&sb, meta.Summary)\n   658→\t\t}\n   659→\n   660→\t\tsb.WriteString(\"\\n\")\n   661→\n   662→\t\t// Files section\n   663→\t\tif len(meta.FilesTouched) > 0 {\n   664→\t\t\tfmt.Fprintf(&sb, \"Files: (%d)\\n\", len(meta.FilesTouched))\n   665→\t\t\tfor _, file := range meta.FilesTouched {\n   666→\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n   667→\t\t\t}\n   668→\t\t} else {\n   669→\t\t\tsb.WriteString(\"Files: (none)\\n\")\n   670→\t\t}\n   671→\t}\n   672→\n   673→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   674→\tappendTranscriptSection(&sb, verbose, full, result.Transcript, scopedTranscript, result.Prompts)\n   675→\n   676→\treturn sb.String()\n   677→}\n   678→\n   679→// appendTranscriptSection appends the appropriate transcript section to the builder\n   680→// based on verbosity level. Full mode shows the entire session, verbose shows checkpoint scope.\n   681→// fullTranscript is the entire session transcript, scopedContent is either scoped transcript bytes\n   682→// or a pre-formatted string (for backwards compat), and scopedFallback is used when scoped parsing fails.\n   683→func appendTranscriptSection(sb *strings.Builder, verbose, full bool, fullTranscript, scopedTranscript []byte, scopedFallback string) {\n   684→\tswitch {\n   685→\tcase full:\n   686→\t\tsb.WriteString(\"\\n\")\n   687→\t\tsb.WriteString(\"Transcript (full session):\\n\")\n   688→\t\tsb.WriteString(formatTranscriptBytes(fullTranscript, \"\"))\n   689→\n   690→\tcase verbose:\n   691→\t\tsb.WriteString(\"\\n\")\n   692→\t\tsb.WriteString(\"Transcript (checkpoint scope):\\n\")\n   693→\t\tsb.WriteString(formatTranscriptBytes(scopedTranscript, scopedFallback))\n   694→\t}\n   695→}\n   696→\n   697→// formatTranscriptBytes formats transcript bytes into a human-readable string.\n   698→// It parses the JSONL transcript and formats it using the condensed format.\n   699→// The fallback is used for backwards compatibility when transcript parsing fails or is empty.\n   700→func formatTranscriptBytes(transcriptBytes []byte, fallback string) string {\n   701→\tif len(transcriptBytes) == 0 {\n   702→\t\tif fallback != \"\" {\n   703→\t\t\treturn fallback + \"\\n\"\n   704→\t\t}\n   705→\t\treturn \"  (none)\\n\"\n   706→\t}\n   707→\n   708→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   709→\tif err != nil || len(condensed) == 0 {\n   710→\t\tif fallback != \"\" {\n   711→\t\t\treturn fallback + \"\\n\"\n   712→\t\t}\n   713→\t\treturn \"  (failed to parse transcript)\\n\"\n   714→\t}\n   715→\n   716→\tinput := summarise.Input{Transcript: condensed}\n   717→\treturn summarise.FormatCondensedTranscript(input)\n   718→}\n   719→\n   720→// formatSummaryDetails formats the detailed sections of an AI summary.\n   721→func formatSummaryDetails(sb *strings.Builder, summary *checkpoint.Summary) {\n   722→\t// Learnings section\n   723→\thasLearnings := len(summary.Learnings.Repo) > 0 ||\n   724→\t\tlen(summary.Learnings.Code) > 0 ||\n   725→\t\tlen(summary.Learnings.Workflow) > 0\n   726→\n   727→\tif hasLearnings {\n   728→\t\tsb.WriteString(\"\\nLearnings:\\n\")\n   729→\n   730→\t\tif len(summary.Learnings.Repo) > 0 {\n   731→\t\t\tsb.WriteString(\"  Repository:\\n\")\n   732→\t\t\tfor _, learning := range summary.Learnings.Repo {\n   733→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   734→\t\t\t}\n   735→\t\t}\n   736→\n   737→\t\tif len(summary.Learnings.Code) > 0 {\n   738→\t\t\tsb.WriteString(\"  Code:\\n\")\n   739→\t\t\tfor _, learning := range summary.Learnings.Code {\n   740→\t\t\t\tif learning.Line > 0 {\n   741→\t\t\t\t\tif learning.EndLine > 0 {\n   742→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d-%d: %s\\n\", learning.Path, learning.Line, learning.EndLine, learning.Finding)\n   743→\t\t\t\t\t} else {\n   744→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d: %s\\n\", learning.Path, learning.Line, learning.Finding)\n   745→\t\t\t\t\t}\n   746→\t\t\t\t} else {\n   747→\t\t\t\t\tfmt.Fprintf(sb, \"    - %s: %s\\n\", learning.Path, learning.Finding)\n   748→\t\t\t\t}\n   749→\t\t\t}\n   750→\t\t}\n   751→\n   752→\t\tif len(summary.Learnings.Workflow) > 0 {\n   753→\t\t\tsb.WriteString(\"  Workflow:\\n\")\n   754→\t\t\tfor _, learning := range summary.Learnings.Workflow {\n   755→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   756→\t\t\t}\n   757→\t\t}\n   758→\t}\n   759→\n   760→\t// Friction section\n   761→\tif len(summary.Friction) > 0 {\n   762→\t\tsb.WriteString(\"\\nFriction:\\n\")\n   763→\t\tfor _, item := range summary.Friction {\n   764→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   765→\t\t}\n   766→\t}\n   767→\n   768→\t// Open items section\n   769→\tif len(summary.OpenItems) > 0 {\n   770→\t\tsb.WriteString(\"\\nOpen Items:\\n\")\n   771→\t\tfor _, item := range summary.OpenItems {\n   772→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   773→\t\t}\n   774→\t}\n   775→}\n   776→\n   777→// runExplainDefault shows all checkpoints on the current branch.\n   778→// This is the default view when no flags are provided.\n   779→func runExplainDefault(w io.Writer, noPager bool) error {\n   780→\treturn runExplainBranchDefault(w, noPager)\n   781→}\n   782→\n   783→// branchCheckpointsLimit is the max checkpoints to show in branch view\n   784→const branchCheckpointsLimit = 100\n   785→\n   786→// commitScanLimit is how far back to scan git history for checkpoints\n   787→const commitScanLimit = 500\n   788→\n   789→// consecutiveMainLimit stops scanning after this many consecutive commits on main\n   790→// (indicates we've likely exhausted feature branch commits)\n   791→const consecutiveMainLimit = 100\n   792→\n   793→// errStopIteration is used to stop commit iteration early\n   794→var errStopIteration = errors.New(\"stop iteration\")\n   795→\n   796→// getBranchCheckpoints returns checkpoints relevant to the current branch.\n   797→// This is strategy-agnostic - it queries checkpoints directly from the checkpoint store.\n   798→//\n   799→// Behavior:\n   800→//   - On feature branches: only show checkpoints unique to this branch (not in main)\n   801→//   - On default branch (main/master): show all checkpoints in history (up to limit)\n   802→//   - Includes both committed checkpoints (entire/sessions) and temporary checkpoints (shadow branches)\n   803→func getBranchCheckpoints(repo *git.Repository, limit int) ([]strategy.RewindPoint, error) {\n   804→\tstore := checkpoint.NewGitStore(repo)\n   805→\n   806→\t// Get all committed checkpoints for lookup\n   807→\tcommittedInfos, err := store.ListCommitted(context.Background())\n   808→\tif err != nil {\n   809→\t\tcommittedInfos = nil // Continue without committed checkpoints\n   810→\t}\n   811→\n   812→\t// Build map of checkpoint ID -> committed info\n   813→\tcommittedByID := make(map[id.CheckpointID]checkpoint.CommittedInfo)\n   814→\tfor _, info := range committedInfos {\n   815→\t\tif !info.CheckpointID.IsEmpty() {\n   816→\t\t\tcommittedByID[info.CheckpointID] = info\n   817→\t\t}\n   818→\t}\n   819→\n   820→\thead, err := repo.Head()\n   821→\tif err != nil {\n   822→\t\t// Unborn HEAD (no commits yet) - return empty list instead of erroring\n   823→\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n   824→\t\t\treturn []strategy.RewindPoint{}, nil\n   825→\t\t}\n   826→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   827→\t}\n   828→\n   829→\t// Check if we're on the default branch (use repo-aware version)\n   830→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   831→\tvar mainBranchHash plumbing.Hash\n   832→\tif !isOnDefault {\n   833→\t\t// Prefer the actual default branch name (which may not be main/master)\n   834→\t\tif defaultBranchName := strategy.GetDefaultBranchName(repo); defaultBranchName != \"\" {\n   835→\t\t\t// Try local default branch first: refs/heads/<name>\n   836→\t\t\tref, refErr := repo.Reference(plumbing.ReferenceName(\"refs/heads/\"+defaultBranchName), true)\n   837→\t\t\tif refErr != nil {\n   838→\t\t\t\t// Fall back to remote default branch: refs/remotes/origin/<name>\n   839→\t\t\t\tref, refErr = repo.Reference(plumbing.ReferenceName(\"refs/remotes/origin/\"+defaultBranchName), true)\n   840→\t\t\t}\n   841→\t\t\tif refErr == nil {\n   842→\t\t\t\tmainBranchHash = ref.Hash()\n   843→\t\t\t}\n   844→\t\t}\n   845→\n   846→\t\t// Fall back to main/master detection if default branch resolution failed\n   847→\t\tif mainBranchHash == plumbing.ZeroHash {\n   848→\t\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   849→\t\t}\n   850→\t}\n   851→\n   852→\t// Precompute commits reachable from main (for O(1) filtering instead of O(N) per commit)\n   853→\t// This changes the filtering from O(N*M) to O(N+M) where N=commits scanned, M=main history depth\n   854→\treachableFromMain := make(map[plumbing.Hash]bool)\n   855→\tif mainBranchHash != plumbing.ZeroHash {\n   856→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   857→\t\tif mainErr == nil {\n   858→\t\t\tmainCount := 0\n   859→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   860→\t\t\t\tmainCount++\n   861→\t\t\t\tif mainCount > 1000 { // Same depth limit as before\n   862→\t\t\t\t\treturn errStopIteration\n   863→\t\t\t\t}\n   864→\t\t\t\treachableFromMain[c.Hash] = true\n   865→\t\t\t\treturn nil\n   866→\t\t\t})\n   867→\t\t\tmainIter.Close()\n   868→\t\t}\n   869→\t}\n   870→\n   871→\t// Walk git history and collect checkpoints\n   872→\titer, err := repo.Log(&git.LogOptions{\n   873→\t\tFrom:  head.Hash(),\n   874→\t\tOrder: git.LogOrderCommitterTime,\n   875→\t})\n   876→\tif err != nil {\n   877→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   878→\t}\n   879→\tdefer iter.Close()\n   880→\n   881→\tvar points []strategy.RewindPoint\n   882→\tcount := 0\n   883→\tconsecutiveMainCount := 0\n   884→\n   885→\terr = iter.ForEach(func(c *object.Commit) error {\n   886→\t\tif count >= commitScanLimit {\n   887→\t\t\treturn errStopIteration\n   888→\t\t}\n   889→\t\tcount++\n   890→\n   891→\t\t// On feature branches, skip commits that are reachable from main\n   892→\t\t// (but continue scanning - there may be more feature branch commits)\n   893→\t\tif len(reachableFromMain) > 0 {\n   894→\t\t\tif reachableFromMain[c.Hash] {\n   895→\t\t\t\tconsecutiveMainCount++\n   896→\t\t\t\tif consecutiveMainCount >= consecutiveMainLimit {\n   897→\t\t\t\t\treturn errStopIteration // Likely exhausted feature branch commits\n   898→\t\t\t\t}\n   899→\t\t\t\treturn nil // Skip this commit, continue scanning\n   900→\t\t\t}\n   901→\t\t\tconsecutiveMainCount = 0 // Reset on feature branch commit\n   902→\t\t}\n   903→\n   904→\t\t// Extract checkpoint ID from Entire-Checkpoint trailer\n   905→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   906→\t\tif !found {\n   907→\t\t\treturn nil // No checkpoint trailer, continue\n   908→\t\t}\n   909→\n   910→\t\t// Look up checkpoint info\n   911→\t\tcpInfo, found := committedByID[cpID]\n   912→\t\tif !found {\n   913→\t\t\treturn nil // Checkpoint not in store, continue\n   914→\t\t}\n   915→\n   916→\t\t// Create rewind point from committed info\n   917→\t\tmessage := strings.Split(c.Message, \"\\n\")[0]\n   918→\t\tpoint := strategy.RewindPoint{\n   919→\t\t\tID:               c.Hash.String(),\n   920→\t\t\tMessage:          message,\n   921→\t\t\tDate:             c.Committer.When,\n   922→\t\t\tIsLogsOnly:       true, // Committed checkpoints are logs-only\n   923→\t\t\tCheckpointID:     cpID,\n   924→\t\t\tSessionID:        cpInfo.SessionID,\n   925→\t\t\tIsTaskCheckpoint: cpInfo.IsTask,\n   926→\t\t\tToolUseID:        cpInfo.ToolUseID,\n   927→\t\t\tAgent:            cpInfo.Agent,\n   928→\t\t}\n   929→\t\t// Read session prompt from metadata branch (best-effort)\n   930→\t\tresult, _ := store.ReadCommitted(context.Background(), cpID) //nolint:errcheck  // Best-effort\n   931→\t\tif result != nil {\n   932→\t\t\t// Scope the transcript to this checkpoint's portion\n   933→\t\t\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   934→\t\t\t// lines from that point onwards (excluding earlier checkpoint content)\n   935→\t\t\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   936→\t\t\t// Extract prompts from the scoped transcript (not the full session's prompts)\n   937→\t\t\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   938→\t\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   939→\t\t\t\tpoint.SessionPrompt = scopedPrompts[0]\n   940→\t\t\t}\n   941→\t\t}\n   942→\n   943→\t\tpoints = append(points, point)\n   944→\t\treturn nil\n   945→\t})\n   946→\n   947→\tif err != nil && !errors.Is(err, errStopIteration) {\n   948→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   949→\t}\n   950→\n   951→\t// Get temporary checkpoints from ALL shadow branches whose base commit is reachable from HEAD.\n   952→\ttempPoints := getReachableTemporaryCheckpoints(repo, store, head.Hash(), isOnDefault, limit)\n   953→\tpoints = append(points, tempPoints...)\n   954→\n   955→\t// Sort by date, most recent first\n   956→\tsort.Slice(points, func(i, j int) bool {\n   957→\t\treturn points[i].Date.After(points[j].Date)\n   958→\t})\n   959→\n   960→\t// Apply limit\n   961→\tif len(points) > limit {\n   962→\t\tpoints = points[:limit]\n   963→\t}\n   964→\n   965→\treturn points, nil\n   966→}\n   967→\n   968→// getReachableTemporaryCheckpoints returns temporary checkpoints from shadow branches\n   969→// whose base commit is reachable from the given HEAD hash.\n   970→// For default branches, all shadow branches are included.\n   971→// For feature branches, only shadow branches whose base commit is in HEAD's history are included.\n   972→func getReachableTemporaryCheckpoints(repo *git.Repository, store *checkpoint.GitStore, headHash plumbing.Hash, isOnDefault bool, limit int) []strategy.RewindPoint {\n   973→\tvar points []strategy.RewindPoint\n   974→\n   975→\tshadowBranches, _ := store.ListTemporary(context.Background()) //nolint:errcheck // Best-effort\n   976→\tfor _, sb := range shadowBranches {\n   977→\t\t// Check if this shadow branch's base commit is reachable from current HEAD\n   978→\t\tif !isShadowBranchReachable(repo, sb.BaseCommit, headHash, isOnDefault) {\n   979→\t\t\tcontinue\n   980→\t\t}\n   981→\n   982→\t\t// List checkpoints from this shadow branch\n   983→\t\ttempCheckpoints, _ := store.ListCheckpointsForBranch(context.Background(), sb.BranchName, \"\", limit) //nolint:errcheck // Best-effort\n   984→\t\tfor _, tc := range tempCheckpoints {\n   985→\t\t\tpoint := convertTemporaryCheckpoint(repo, tc)\n   986→\t\t\tif point != nil {\n   987→\t\t\t\tpoints = append(points, *point)\n   988→\t\t\t}\n   989→\t\t}\n   990→\t}\n   991→\n   992→\treturn points\n   993→}\n   994→\n   995→// isShadowBranchReachable checks if a shadow branch's base commit is reachable from HEAD.\n   996→// For default branches, all shadow branches are considered reachable.\n   997→// For feature branches, we check if any commit with the base commit prefix is in HEAD's history.\n   998→func isShadowBranchReachable(repo *git.Repository, baseCommit string, headHash plumbing.Hash, isOnDefault bool) bool {\n   999→\t// For default branch: all shadow branches are potentially relevant\n  1000→\tif isOnDefault {\n  1001→\t\treturn true\n  1002→\t}\n  1003→\n  1004→\t// Check if base commit hash prefix matches any commit in HEAD's history\n  1005→\tbaseCommitIter, baseErr := repo.Log(&git.LogOptions{From: headHash})\n  1006→\tif baseErr != nil {\n  1007→\t\treturn false\n  1008→\t}\n  1009→\tdefer baseCommitIter.Close()\n  1010→\n  1011→\tbaseCount := 0\n  1012→\tfound := false\n  1013→\t_ = baseCommitIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n  1014→\t\tbaseCount++\n  1015→\t\tif baseCount > commitScanLimit {\n  1016→\t\t\treturn errStopIteration\n  1017→\t\t}\n  1018→\t\tif strings.HasPrefix(c.Hash.String(), baseCommit) {\n  1019→\t\t\tfound = true\n  1020→\t\t\treturn errStopIteration\n  1021→\t\t}\n  1022→\t\treturn nil\n  1023→\t})\n  1024→\n  1025→\treturn found\n  1026→}\n  1027→\n  1028→// convertTemporaryCheckpoint converts a TemporaryCheckpointInfo to a RewindPoint.\n  1029→// Returns nil if the checkpoint should be skipped (no code changes or can't be read).\n  1030→func convertTemporaryCheckpoint(repo *git.Repository, tc checkpoint.TemporaryCheckpointInfo) *strategy.RewindPoint {\n  1031→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n  1032→\tif commitErr != nil {\n  1033→\t\treturn nil\n  1034→\t}\n  1035→\n  1036→\t// Filter out checkpoints with no code changes (only .entire/ metadata changed)\n  1037→\t// This also filters out the first checkpoint which is just a baseline copy\n  1038→\tif !hasCodeChanges(shadowCommit) {\n  1039→\t\treturn nil\n  1040→\t}\n  1041→\n  1042→\t// Read session prompt from the shadow branch commit's tree (not from entire/sessions)\n  1043→\t// Temporary checkpoints store their metadata in the shadow branch, not in entire/sessions\n  1044→\tvar sessionPrompt string\n  1045→\tshadowTree, treeErr := shadowCommit.Tree()\n  1046→\tif treeErr == nil {\n  1047→\t\tsessionPrompt = strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n  1048→\t}\n  1049→\n  1050→\treturn &strategy.RewindPoint{\n  1051→\t\tID:               tc.CommitHash.String(),\n  1052→\t\tMessage:          tc.Message,\n  1053→\t\tMetadataDir:      tc.MetadataDir,\n  1054→\t\tDate:             tc.Timestamp,\n  1055→\t\tIsTaskCheckpoint: tc.IsTaskCheckpoint,\n  1056→\t\tToolUseID:        tc.ToolUseID,\n  1057→\t\tSessionID:        tc.SessionID,\n  1058→\t\tSessionPrompt:    sessionPrompt,\n  1059→\t\tIsLogsOnly:       false, // Temporary checkpoints can be fully rewound\n  1060→\t}\n  1061→}\n  1062→\n  1063→// runExplainBranchWithFilter shows checkpoints on the current branch, optionally filtered by session.\n  1064→// This is strategy-agnostic - it queries checkpoints directly.\n  1065→func runExplainBranchWithFilter(w io.Writer, noPager bool, sessionFilter string) error {\n  1066→\trepo, err := openRepository()\n  1067→\tif err != nil {\n  1068→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1069→\t}\n  1070→\n  1071→\t// Get current branch name\n  1072→\tbranchName := strategy.GetCurrentBranchName(repo)\n  1073→\tif branchName == \"\" {\n  1074→\t\t// Detached HEAD state or unborn HEAD - try to use short commit hash if possible\n  1075→\t\thead, headErr := repo.Head()\n  1076→\t\tif headErr != nil {\n  1077→\t\t\t// Unborn HEAD (no commits yet) - treat as empty history instead of erroring\n  1078→\t\t\tif errors.Is(headErr, plumbing.ErrReferenceNotFound) {\n  1079→\t\t\t\tbranchName = \"HEAD (no commits yet)\"\n  1080→\t\t\t} else {\n  1081→\t\t\t\treturn fmt.Errorf(\"failed to get HEAD: %w\", headErr)\n  1082→\t\t\t}\n  1083→\t\t} else {\n  1084→\t\t\tbranchName = \"HEAD (\" + head.Hash().String()[:7] + \")\"\n  1085→\t\t}\n  1086→\t}\n  1087→\n  1088→\t// Get checkpoints for this branch (strategy-agnostic)\n  1089→\tpoints, err := getBranchCheckpoints(repo, branchCheckpointsLimit)\n  1090→\tif err != nil {\n  1091→\t\t// Log the error but continue with empty list so user sees helpful message\n  1092→\t\tlogging.Warn(context.Background(), \"failed to get branch checkpoints\", \"error\", err)\n  1093→\t\tpoints = nil\n  1094→\t}\n  1095→\n  1096→\t// Format output\n  1097→\toutput := formatBranchCheckpoints(branchName, points, sessionFilter)\n  1098→\n  1099→\toutputExplainContent(w, output, noPager)\n  1100→\treturn nil\n  1101→}\n  1102→\n  1103→// runExplainBranchDefault shows all checkpoints on the current branch grouped by date.\n  1104→// This is a convenience wrapper that calls runExplainBranchWithFilter with no filter.\n  1105→func runExplainBranchDefault(w io.Writer, noPager bool) error {\n  1106→\treturn runExplainBranchWithFilter(w, noPager, \"\")\n  1107→}\n  1108→\n  1109→// outputExplainContent outputs content with optional pager support.\n  1110→func outputExplainContent(w io.Writer, content string, noPager bool) {\n  1111→\tif noPager {\n  1112→\t\tfmt.Fprint(w, content)\n  1113→\t} else {\n  1114→\t\toutputWithPager(w, content)\n  1115→\t}\n  1116→}\n  1117→\n  1118→// runExplainCommit looks up the checkpoint associated with a commit.\n  1119→// Extracts the Entire-Checkpoint trailer and delegates to checkpoint detail view.\n  1120→// If no trailer found, shows a message indicating no associated checkpoint.\n  1121→func runExplainCommit(w io.Writer, commitRef string, noPager, verbose, full, searchAll bool) error {\n  1122→\trepo, err := openRepository()\n  1123→\tif err != nil {\n  1124→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1125→\t}\n  1126→\n  1127→\t// Resolve the commit reference\n  1128→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1129→\tif err != nil {\n  1130→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1131→\t}\n  1132→\n  1133→\tcommit, err := repo.CommitObject(*hash)\n  1134→\tif err != nil {\n  1135→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1136→\t}\n  1137→\n  1138→\t// Extract Entire-Checkpoint trailer\n  1139→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1140→\tif !hasCheckpoint {\n  1141→\t\tfmt.Fprintln(w, \"No associated Entire checkpoint\")\n  1142→\t\tfmt.Fprintf(w, \"\\nCommit %s does not have an Entire-Checkpoint trailer.\\n\", hash.String()[:7])\n  1143→\t\tfmt.Fprintln(w, \"This commit was not created during an Entire session, or the trailer was removed.\")\n  1144→\t\treturn nil\n  1145→\t}\n  1146→\n  1147→\t// Delegate to checkpoint detail view\n  1148→\t// Note: We pass a nil errW since runExplainCheckpoint only uses it for generate mode\n  1149→\treturn runExplainCheckpoint(w, nil, checkpointID.String(), noPager, verbose, full, false, false, false, searchAll)\n  1150→}\n  1151→\n  1152→// formatSessionInfo formats session information for display.\n  1153→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1154→\tvar sb strings.Builder\n  1155→\n  1156→\t// Session header\n  1157→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1158→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1159→\n  1160→\tif !session.StartTime.IsZero() {\n  1161→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1162→\t}\n  1163→\n  1164→\tif sourceRef != \"\" {\n  1165→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1166→\t}\n  1167→\n  1168→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1169→\n  1170→\t// Checkpoint details\n  1171→\tfor _, cp := range checkpoints {\n  1172→\t\tsb.WriteString(\"\\n\")\n  1173→\n  1174→\t\t// Checkpoint header\n  1175→\t\ttaskMarker := \"\"\n  1176→\t\tif cp.IsTaskCheckpoint {\n  1177→\t\t\ttaskMarker = \" [Task]\"\n  1178→\t\t}\n  1179→\t\tfmt.Fprintf(&sb, \"─── Checkpoint %d [%s] %s%s ───\\n\",\n  1180→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker)\n  1181→\t\tsb.WriteString(\"\\n\")\n  1182→\n  1183→\t\t// Display all interactions in this checkpoint\n  1184→\t\tfor i, inter := range cp.Interactions {\n  1185→\t\t\t// For multiple interactions, add a sub-header\n  1186→\t\t\tif len(cp.Interactions) > 1 {\n  1187→\t\t\t\tfmt.Fprintf(&sb, \"### Interaction %d\\n\\n\", i+1)\n  1188→\t\t\t}\n  1189→\n  1190→\t\t\t// Prompt section\n  1191→\t\t\tif inter.Prompt != \"\" {\n  1192→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n  1193→\t\t\t\tsb.WriteString(inter.Prompt)\n  1194→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1195→\t\t\t}\n  1196→\n  1197→\t\t\t// Response section\n  1198→\t\t\tif len(inter.Responses) > 0 {\n  1199→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n  1200→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n  1201→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1202→\t\t\t}\n  1203→\n  1204→\t\t\t// Files modified for this interaction\n  1205→\t\t\tif len(inter.Files) > 0 {\n  1206→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(inter.Files))\n  1207→\t\t\t\tfor _, file := range inter.Files {\n  1208→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1209→\t\t\t\t}\n  1210→\t\t\t\tsb.WriteString(\"\\n\")\n  1211→\t\t\t}\n  1212→\t\t}\n  1213→\n  1214→\t\t// If no interactions, show message and/or files\n  1215→\t\tif len(cp.Interactions) == 0 {\n  1216→\t\t\t// Show commit message as summary when no transcript available\n  1217→\t\t\tif cp.Message != \"\" {\n  1218→\t\t\t\tsb.WriteString(cp.Message)\n  1219→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1220→\t\t\t}\n  1221→\t\t\t// Show aggregate files if available\n  1222→\t\t\tif len(cp.Files) > 0 {\n  1223→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(cp.Files))\n  1224→\t\t\t\tfor _, file := range cp.Files {\n  1225→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1226→\t\t\t\t}\n  1227→\t\t\t}\n  1228→\t\t}\n  1229→\t}\n  1230→\n  1231→\treturn sb.String()\n  1232→}\n  1233→\n  1234→// outputWithPager outputs content through a pager if stdout is a terminal and content is long.\n  1235→func outputWithPager(w io.Writer, content string) {\n  1236→\t// Check if we're writing to stdout and it's a terminal\n  1237→\tif f, ok := w.(*os.File); ok && f == os.Stdout && term.IsTerminal(int(f.Fd())) {\n  1238→\t\t// Get terminal height\n  1239→\t\t_, height, err := term.GetSize(int(f.Fd()))\n  1240→\t\tif err != nil {\n  1241→\t\t\theight = 24 // Default fallback\n  1242→\t\t}\n  1243→\n  1244→\t\t// Count lines in content\n  1245→\t\tlineCount := strings.Count(content, \"\\n\")\n  1246→\n  1247→\t\t// Use pager if content exceeds terminal height\n  1248→\t\tif lineCount > height-2 {\n  1249→\t\t\tpager := os.Getenv(\"PAGER\")\n  1250→\t\t\tif pager == \"\" {\n  1251→\t\t\t\tpager = \"less\"\n  1252→\t\t\t}\n  1253→\n  1254→\t\t\tcmd := exec.CommandContext(context.Background(), pager) //nolint:gosec // pager from env is expected\n  1255→\t\t\tcmd.Stdin = strings.NewReader(content)\n  1256→\t\t\tcmd.Stdout = f\n  1257→\t\t\tcmd.Stderr = os.Stderr\n  1258→\n  1259→\t\t\tif err := cmd.Run(); err != nil {\n  1260→\t\t\t\t// Fallback to direct output if pager fails\n  1261→\t\t\t\tfmt.Fprint(w, content)\n  1262→\t\t\t}\n  1263→\t\t\treturn\n  1264→\t\t}\n  1265→\t}\n  1266→\n  1267→\t// Direct output for non-terminal or short content\n  1268→\tfmt.Fprint(w, content)\n  1269→}\n  1270→\n  1271→// Constants for formatting output\n  1272→const (\n  1273→\t// maxIntentDisplayLength is the maximum length for intent text before truncation\n  1274→\tmaxIntentDisplayLength = 80\n  1275→\t// maxMessageDisplayLength is the maximum length for checkpoint messages before truncation\n  1276→\tmaxMessageDisplayLength = 80\n  1277→\t// maxPromptDisplayLength is the maximum length for session prompts before truncation\n  1278→\tmaxPromptDisplayLength = 60\n  1279→\t// checkpointIDDisplayLength is the number of characters to show from checkpoint IDs\n  1280→\tcheckpointIDDisplayLength = 12\n  1281→)\n  1282→\n  1283→// formatBranchCheckpoints formats checkpoint information for a branch.\n  1284→// Groups commits by checkpoint ID and shows the prompt for each checkpoint.\n  1285→// If sessionFilter is non-empty, only shows checkpoints matching that session ID (or prefix).\n  1286→func formatBranchCheckpoints(branchName string, points []strategy.RewindPoint, sessionFilter string) string {\n  1287→\tvar sb strings.Builder\n  1288→\n  1289→\t// Branch header\n  1290→\tfmt.Fprintf(&sb, \"Branch: %s\\n\", branchName)\n  1291→\n  1292→\t// Filter by session if specified\n  1293→\tif sessionFilter != \"\" {\n  1294→\t\tvar filtered []strategy.RewindPoint\n  1295→\t\tfor _, p := range points {\n  1296→\t\t\tif p.SessionID == sessionFilter || strings.HasPrefix(p.SessionID, sessionFilter) {\n  1297→\t\t\t\tfiltered = append(filtered, p)\n  1298→\t\t\t}\n  1299→\t\t}\n  1300→\t\tpoints = filtered\n  1301→\t}\n  1302→\n  1303→\tif len(points) == 0 {\n  1304→\t\tsb.WriteString(\"Checkpoints: 0\\n\")\n  1305→\t\tif sessionFilter != \"\" {\n  1306→\t\t\tfmt.Fprint