 to prevent path traversal and malformed data\n    41→\tif opts.CheckpointID.IsEmpty() {\n    42→\t\treturn errors.New(\"invalid checkpoint options: checkpoint ID is required\")\n    43→\t}\n    44→\tif err := validation.ValidateSessionID(opts.SessionID); err != nil {\n    45→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    46→\t}\n    47→\tif err := validation.ValidateToolUseID(opts.ToolUseID); err != nil {\n    48→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    49→\t}\n    50→\tif err := validation.ValidateAgentID(opts.AgentID); err != nil {\n    51→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    52→\t}\n    53→\n    54→\t// Ensure sessions branch exists\n    55→\tif err := s.ensureSessionsBranch(); err != nil {\n    56→\t\treturn fmt.Errorf(\"failed to ensure sessions branch: %w\", err)\n    57→\t}\n    58→\n    59→\t// Get current branch tip and flatten tree\n    60→\tref, entries, err := s.getSessionsBranchEntries()\n    61→\tif err != nil {\n    62→\t\treturn err\n    63→\t}\n    64→\n    65→\t// Use sharded path: <id[:2]>/<id[2:]>/\n    66→\tbasePath := opts.CheckpointID.Path() + \"/\"\n    67→\n    68→\t// Track task metadata path for commit trailer\n    69→\tvar taskMetadataPath string\n    70→\n    71→\t// Handle task checkpoints\n    72→\tif opts.IsTask && opts.ToolUseID != \"\" {\n    73→\t\ttaskMetadataPath, err = s.writeTaskCheckpointEntries(opts, basePath, entries)\n    74→\t\tif err != nil {\n    75→\t\t\treturn err\n    76→\t\t}\n    77→\t}\n    78→\n    79→\t// Write standard checkpoint entries (transcript, prompts, context, metadata)\n    80→\tif err := s.writeStandardCheckpointEntries(opts, basePath, entries); err != nil {\n    81→\t\treturn err\n    82→\t}\n    83→\n    84→\t// Build and commit\n    85→\tnewTreeHash, err := BuildTreeFromEntries(s.repo, entries)\n    86→\tif err != nil {\n    87→\t\treturn err\n    88→\t}\n    89→\n    90→\tcommitMsg := s.buildCommitMessage(opts, taskMeta