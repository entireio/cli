unc generateCheckpointSummary(w, _ io.Writer, store *checkpoint.GitStore, checkpointID id.CheckpointID, result *checkpoint.ReadCommittedResult, force bool) error {\n   282→\t// Check if summary already exists\n   283→\tif result.Metadata.Summary != nil && !force {\n   284→\t\treturn fmt.Errorf(\"checkpoint %s already has a summary (use --force to regenerate)\", checkpointID)\n   285→\t}\n   286→\n   287→\t// Check if transcript exists\n   288→\tif len(result.Transcript) == 0 {\n   289→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript to summarise\", checkpointID)\n   290→\t}\n   291→\n   292→\t// Scope the transcript to only this checkpoint's portion\n   293→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   294→\tif len(scopedTranscript) == 0 {\n   295→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript content for this checkpoint (scoped)\", checkpointID)\n   296→\t}\n   297→\n   298→\t// Build condensed transcript for summarisation from the scoped portion\n   299→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(scopedTranscript)\n   300→\tif err != nil {\n   301→\t\treturn fmt.Errorf(\"failed to parse transcript: %w\", err)\n   302→\t}\n   303→\tif len(condensed) == 0 {\n   304→\t\treturn fmt.Errorf(\"checkpoint %s transcript has no content to summarise\", checkpointID)\n   305→\t}\n   306→\n   307→\tinput := summarise.Input{\n   308→\t\tTranscript:   condensed,\n   309→\t\tFilesTouched: result.Metadata.FilesTouched,\n   310→\t}\n   311→\n   312→\t// Generate summary using Claude CLI\n   313→\tctx := context.Background()\n   314→\tlogging.Info(ctx, \"generating checkpoint summary\")\n   315→\n   316→\tvar generator summarise.Generator = &summarise.ClaudeGenerator{}\n   317→\tsummary, err := generator.Generate(ctx, input)\n   318→\tif err != nil {\n   319→\t\treturn fmt.Errorf(\"failed to generate summary: %w\", err)\n   320→\t}\n   321→\n   322→\t// Persist the summary\n   323→\tif err := store.UpdateSummary(ctx, checkpointID, summary); err != nil {\n   324→\t\treturn fmt.Errorf(\"failed to save summary: %w\", err)\n   325→\t}\n   326→\n   327→\tfmt.Fprintln(w, \"✓ Summary generated and saved\")\n   328→\treturn nil\n   329→}\n   330→\n   331→// explainTemporaryCheckpoint finds and formats a temporary checkpoint by shadow commit hash prefix.\n   332→// Returns the formatted output and whether the checkpoint was found.\n   333→// Searches ALL shadow branches, not just the one for current HEAD, to find checkpoints\n   334→// created from different base commits (e.g., if HEAD advanced since session start).\n   335→// The writer w is used for raw transcript output to bypass the pager.\n   336→func explainTemporaryCheckpoint(w io.Writer, repo *git.Repository, store *checkpoint.GitStore, shaPrefix string, verbose, full, rawTranscript bool) (string, bool) {\n   337→\t// List temporary checkpoints from ALL shadow branches\n   338→\t// This ensures we find checkpoints even if HEAD has advanced since the session started\n   339→\ttempCheckpoints, err := store.ListAllTemporaryCheckpoints(context.Background(), \"\", branchCheckpointsLimit)\n   340→\tif err != nil {\n   341→\t\treturn \"\", false\n   342→\t}\n   343→\n   344→\t// Find checkpoints matching the SHA prefix - check for ambiguity\n   345→\tvar matches []checkpoint.TemporaryCheckpointInfo\n   346→\tfor _, tc := range tempCheckpoints {\n   347→\t\tif strings.HasPrefix(tc.CommitHash.String(), shaPrefix) {\n   348→\t\t\tmatches = append(matches, tc)\n   349→\t\t}\n   350→\t}\n   351→\n   352→\tif len(matches) == 0 {\n   353→\t\treturn \"\", false\n   354→\t}\n   355→\n   356→\tif len(matches) > 1 {\n   357→\t\t// Multiple matches - return ambiguous error (consistent with committed checkpoint behavior)\n   358→\t\tvar sb strings.Builder\n   359→\t\tfmt.Fprintf(&sb, \"ambiguous checkpoint prefix %q matches %d temporary checkpoints:\\n\", shaPrefix, len(matches))\n   360→\t\tfor _, m := range matches {\n   361→\t\t\tshortID := m.CommitHash.String()[:7]\n   362→\t\t\tfmt.Fprintf(&sb, \"  %s  %s  session %s\\n\",\n   363→\t\t\t\tshortID,\n   364→\t\t\t\tm.Timestamp.Format(\"2006-01-02 15:04:05\"),\n   365→\t\t\t\tm.SessionID)\n   366→\t\t}\n   367→\t\t// Return as \"not found\" with error message - caller will use this as error\n   368→\t\treturn sb.String(), false\n   369→\t}\n   370→\n   371→\ttc := matches[0]\n   372→\n   373→\t// Handle raw transcript output\n   374→\tif rawTranscript {\n   375→\t\ttranscriptBytes, transcriptErr := store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown)\n   376→\t\tif transcriptErr != nil || len(transcriptBytes) == 0 {\n   377→\t\t\t// Return specific error message (consistent with committed checkpoints)\n   378→\t\t\treturn fmt.Sprintf(\"checkpoint %s has no transcript\", tc.CommitHash.String()[:7]), false\n   379→\t\t}\n   380→\t\t// Write directly to writer (no pager, no formatting) - matches committed checkpoint behavior\n   381→\t\tif _, writeErr := fmt.Fprint(w, string(transcriptBytes)); writeErr != nil {\n   382→\t\t\treturn fmt.Sprintf(\"failed to write transcript: %v\", writeErr), false\n   383→\t\t}\n   384→\t\treturn \"\", true\n   385→\t}\n   386→\n   387→\t// Found exactly one match - read metadata from shadow branch commit tree\n   388→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   389→\tif commitErr != nil {\n   390→\t\treturn \"\", false\n   391→\t}\n   392→\n   393→\tshadowTree, treeErr := shadowCommit.Tree()\n   394→\tif treeErr != nil {\n   395→\t\treturn \"\", false\n   396→\t}\n   397→\n   398→\t// Read prompts from shadow branch\n   399→\tsessionPrompt := strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   400→\n   401→\t// Build output similar to formatCheckpointOutput but for temporary\n   402→\tvar sb strings.Builder\n   403→\tshortID := tc.CommitHash.String()[:7]\n   404→\tfmt.Fprintf(&sb, \"Checkpoint: %s [temporary]\\n\", shortID)\n   405→\tfmt.Fprintf(&sb, \"Session: %s\\n\", tc.SessionID)\n   406→\tfmt.Fprintf(&sb, \"Created: %s\\n\", tc.Timestamp.Format(\"2006-01-02 15:04:05\"))\n   407→\tsb.WriteString(\"\\n\")\n   408→\n   409→\t// Intent from prompt\n   410→\tintent := \"(not available)\"\n   411→\tif sessionPrompt != \"\" {\n   412→\t\tlines := strings.Split(sessionPrompt, \"\\n\")\n   413→\t\tif len(lines) > 0 && lines[0] != \"\" {\n   414→\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   415→\t\t}\n   416→\t}\n   417→\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   418→\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   419→\n   420→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   421→\t// For temporary checkpoints, load transcript and compute scope from parent commit\n   422→\tvar fullTranscript []byte\n   423→\tvar scopedTranscript []byte\n   424→\tif full || verbose {\n   425→\t\tfullTranscript, _ = store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   426→\n   427→\t\tif verbose && len(fullTranscript) > 0 {\n   428→\t\t\t// Compute scoped transcript by finding where parent's transcript ended\n   429→\t\t\t// Each shadow branch commit has the full transcript up to that point,\n   430→\t\t\t// so we diff against parent to get just this checkpoint's activity\n   431→\t\t\tscopedTranscript = fullTranscript // Default to full if no parent\n   432→\t\t\tif shadowCommit.NumParents() > 0 {\n   433→\t\t\t\tif parent, parentErr := shadowCommit.Parent(0); parentErr == nil {\n   434→\t\t\t\t\tparentTranscript, _ := store.GetTranscriptFromCommit(parent.Hash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   435→\t\t\t\t\tif len(parentTranscript) > 0 {\n   436→\t\t\t\t\t\t// Count lines in parent transcript to know where to slice from\n   437→\t\t\t\t\t\tparentLineCount := countLines(parentTranscript)\n   438→\t\t\t\t\t\tscopedTranscript = transcript.SliceFromLine(fullTranscript, parentLineCount)\n   439→\t\t\t\t\t}\n   440→\t\t\t\t}\n   441→\t\t\t}\n   442→\t\t}\n   443→\t}\n   444→\tappendTranscriptSection(&sb, verbose, full, fullTranscript, scopedTranscript, sessionPrompt)\n   445→\n   446→\treturn sb.String(), true\n   447→}\n   448→\n   449→// findCommitMessageForCheckpoint searches git history for a commit with the\n   450→// Entire-Checkpoint trailer matching the given checkpoint ID, and returns\n   451→// the first line of the commit message. Returns empty string if not found.\n   452→func findCommitMessageForCheckpoint(repo *git.Repository, checkpointID id.CheckpointID) string {\n   453→\t// Get HEAD reference\n   454→\thead, err := repo.Head()\n   455→\tif err != nil {\n   456→\t\treturn \"\"\n   457→\t}\n   458→\n   459→\t// Iterate through commit history (limit to recent commits for performance)\n   460→\tcommitIter, err := repo.Log(&git.LogOptions{\n   461→\t\tFrom: head.Hash(),\n   462→\t})\n   463→\tif err != nil {\n   464→\t\treturn \"\"\n   465→\t}\n   466→\tdefer commitIter.Close()\n   467→\n   468→\tcount := 0\n   469→\n   470→\tfor {\n   471→\t\tcommit, iterErr := commitIter.Next()\n   472→\t\tif iterErr != nil {\n   473→\t\t\tbreak\n   474→\t\t}\n   475→\t\tcount++\n   476→\t\tif count > commitScanLimit {\n   477→\t\t\tbreak\n   478→\t\t}\n   479→\n   480→\t\t// Check if this commit has our checkpoint ID\n   481→\t\tfoundID, hasTrailer := trailers.ParseCheckpoint(commit.Message)\n   482→\t\tif hasTrailer && foundID == checkpointID {\n   483→\t\t\t// Return first line of commit message (without trailing newline)\n   484→\t\t\tfirstLine := strings.Split(commit.Message, \"\\n\")[0]\n   485→\t\t\treturn strings.TrimSpace(firstLine)\n   486→\t\t}\n   487→\t}\n   488→\n   489→\treturn \"\"\n   490→}\n   491→\n   492→// scopeTranscriptForCheckpoint slices a transcript to include only the lines\n   493→// relevant to a specific checkpoint, starting from linesAtStart.\n   494→// This allows showing only what happened during a checkpoint, not the entire session.\n   495→func scopeTranscriptForCheckpoint(fullTranscript []byte, linesAtStart int) []byte {\n   496→\treturn transcript.SliceFromLine(fullTranscript, linesAtStart)\n   497→}\n   498→\n   499→// extractPromptsFromTranscript extracts user prompts from transcript bytes.\n   500→// Returns a slice of prompt strings.\n   501→func extractPromptsFromTranscript(transcriptBytes []byte) []string {\n   502→\tif len(transcriptBytes) == 0 {\n   503→\t\treturn nil\n   504→\t}\n   505→\n   506→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   507→\tif err != nil {\n   508→\t\treturn nil\n   509→\t}\n   510→\n   511→\tvar prompts []string\n   512→\tfor _, entry := range condensed {\n   513→\t\tif entry.Type == summarise.EntryTypeUser && entry.Content != \"\" {\n   514→\t\t\tprompts = append(prompts, entry.Content)\n   515→\t\t}\n   516→\t}\n   517→\treturn prompts\n   518→}\n   519→\n   520→// formatCheckpointOutput formats checkpoint data based on verbosity level.\n   521→// When verbose is false: summary only (ID, session, timestamp, tokens, intent).\n   522→// When verbose is true: adds files, commit message, and scoped transcript for this checkpoint.\n   523→// When full is true: shows parsed full session transcript instead of scoped transcript.\n   524→//\n   525→// Transcript scope is controlled by TranscriptLinesAtStart in metadata, which indicates\n   526→// where this checkpoint's content begins in the full session transcript.\n   527→//\n   528→// Author is displayed when available (only for committed checkpoints).\n   529→func formatCheckpointOutput(result *checkpoint.ReadCommittedResult, checkpointID id.CheckpointID, commitMessage string, author checkpoint.Author, verbose, full bool) string {\n   530→\tvar sb strings.Builder\n   531→\tmeta := result.Metadata\n   532→\n   533→\t// Scope the transcript to this checkpoint's portion\n   534→\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   535→\t// lines from that point onwards (excluding earlier checkpoint content)\n   536→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, meta.TranscriptLinesAtStart)\n   537→\n   538→\t// Extract prompts from the scoped transcript for intent extraction\n   539→\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   540→\n   541→\t// Header - always shown\n   542→\t// Note: CheckpointID is always exactly 12 characters, matching checkpointIDDisplayLength\n   543→\tfmt.Fprintf(&sb, \"Checkpoint: %s\\n\", checkpointID)\n   544→\tfmt.Fprintf(&sb, \"Session: %s\\n\", meta.SessionID)\n   545→\tfmt.Fprintf(&sb, \"Created: %s\\n\", meta.CreatedAt.Format(\"2006-01-02 15:04:05\"))\n   546→\n   547→\t// Author (only for committed checkpoints with known author)\n   548→\tif author.Name != \"\" {\n   549→\t\tfmt.Fprintf(&sb, \"Author: %s <%s>\\n\", author.Name, author.Email)\n   550→\t}\n   551→\n   552→\t// Token usage\n   553→\tif meta.TokenUsage != nil {\n   554→\t\ttotalTokens := meta.TokenUsage.InputTokens + meta.TokenUsage.CacheCreationTokens +\n   555→\t\t\tmeta.TokenUsage.CacheReadTokens + meta.TokenUsage.OutputTokens\n   556→\t\tfmt.Fprintf(&sb, \"Tokens: %d\\n\", totalTokens)\n   557→\t}\n   558→\n   559→\tsb.WriteString(\"\\n\")\n   560→\n   561→\t// Intent and Outcome from AI summary, or fallback to prompt text\n   562→\tif meta.Summary != nil {\n   563→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", meta.Summary.Intent)\n   564→\t\tfmt.Fprintf(&sb, \"Outcome: %s\\n\", meta.Summary.Outcome)\n   565→\t} else {\n   566→\t\t// Fallback: use first line of scoped prompts for intent,\n   567→\t\t// or fall back to result.Prompts for backwards compatibility with older checkpoints\n   568→\t\tintent := \"(not generated)\"\n   569→\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   570→\t\t\tintent = strategy.TruncateDescription(scopedPrompts[0], maxIntentDisplayLength)\n   571→\t\t} else if result.Prompts != \"\" {\n   572→\t\t\t// Backwards compatibility: use stored prompts if no transcript available\n   573→\t\t\tlines := strings.Split(result.Prompts, \"\\n\")\n   574→\t\t\tif len(lines) > 0 && lines[0] != \"\" {\n   575→\t\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   576→\t\t\t}\n   577→\t\t}\n   578→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   579→\t\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   580→\t}\n   581→\n   582→\t// Verbose: add commit message, learnings, friction, files, and scoped transcript\n   583→\tif verbose || full {\n   584→\t\t// AI Summary details (learnings, friction, open items)\n   585→\t\tif meta.Summary != nil {\n   586→\t\t\tformatSummaryDetails(&sb, meta.Summary)\n   587→\t\t}\n   588→\n   589→\t\t// Commit message section (only if available)\n   590→\t\tif commitMessage != \"\" {\n   591→\t\t\tsb.WriteString(\"\\n\")\n   592→\t\t\tfmt.Fprintf(&sb, \"Commit: %s\\n\", commitMessage)\n   593→\t\t}\n   594→\n   595→\t\tsb.WriteString(\"\\n\")\n   596→\n   597→\t\t// Files section\n   598→\t\tif len(meta.FilesTouched) > 0 {\n   599→\t\t\tfmt.Fprintf(&sb, \"Files: (%d)\\n\", len(meta.FilesTouched))\n   600→\t\t\tfor _, file := range meta.FilesTouched {\n   601→\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n   602→\t\t\t}\n   603→\t\t} else {\n   604→\t\t\tsb.WriteString(\"Files: (none)\\n\")\n   605→\t\t}\n   606→\t}\n   607→\n   608→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   609→\tappendTranscriptSection(&sb, verbose, full, result.Transcript, scopedTranscript, result.Prompts)\n   610→\n   611→\treturn sb.String()\n   612→}\n   613→\n   614→// appendTranscriptSection appends the appropriate transcript section to the builder\n   615→// based on verbosity level. Full mode shows the entire session, verbose shows checkpoint scope.\n   616→// fullTranscript is the entire session transcript, scopedContent is either scoped transcript bytes\n   617→// or a pre-formatted string (for backwards compat), and scopedFallback is used when scoped parsing fails.\n   618→func appendTranscriptSection(sb *strings.Builder, verbose, full bool, fullTranscript, scopedTranscript []byte, scopedFallback string) {\n   619→\tswitch {\n   620→\tcase full:\n   621→\t\tsb.WriteString(\"\\n\")\n   622→\t\tsb.WriteString(\"Transcript (full session):\\n\")\n   623→\t\tsb.WriteString(formatTranscriptBytes(fullTranscript, \"\"))\n   624→\n   625→\tcase verbose:\n   626→\t\tsb.WriteString(\"\\n\")\n   627→\t\tsb.WriteString(\"Transcript (checkpoint scope):\\n\")\n   628→\t\tsb.WriteString(formatTranscriptBytes(scopedTranscript, scopedFallback))\n   629→\t}\n   630→}\n   631→\n   632→// formatTranscriptBytes formats transcript bytes into a human-readable string.\n   633→// It parses the JSONL transcript and formats it using the condensed format.\n   634→// The fallback is used for backwards compatibility when transcript parsing fails or is empty.\n   635→func formatTranscriptBytes(transcriptBytes []byte, fallback string) string {\n   636→\tif len(transcriptBytes) == 0 {\n   637→\t\tif fallback != \"\" {\n   638→\t\t\treturn fallback + \"\\n\"\n   639→\t\t}\n   640→\t\treturn \"  (none)\\n\"\n   641→\t}\n   642→\n   643→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   644→\tif err != nil || len(condensed) == 0 {\n   645→\t\tif fallback != \"\" {\n   646→\t\t\treturn fallback + \"\\n\"\n   647→\t\t}\n   648→\t\treturn \"  (failed to parse transcript)\\n\"\n   649→\t}\n   650→\n   651→\tinput := summarise.Input{Transcript: condensed}\n   652→\treturn summarise.FormatCondensedTranscript(input)\n   653→}\n   654→\n   655→// formatSummaryDetails formats the detailed sections of an AI summary.\n   656→func formatSummaryDetails(sb *strings.Builder, summary *checkpoint.Summary) {\n   657→\t// Learnings section\n   658→\thasLearnings := len(summary.Learnings.Repo) > 0 ||\n   659→\t\tlen(summary.Learnings.Code) > 0 ||\n   660→\t\tlen(summary.Learnings.Workflow) > 0\n   661→\n   662→\tif hasLearnings {\n   663→\t\tsb.WriteString(\"\\nLearnings:\\n\")\n   664→\n   665→\t\tif len(summary.Learnings.Repo) > 0 {\n   666→\t\t\tsb.WriteString(\"  Repository:\\n\")\n   667→\t\t\tfor _, learning := range summary.Learnings.Repo {\n   668→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   669→\t\t\t}\n   670→\t\t}\n   671→\n   672→\t\tif len(summary.Learnings.Code) > 0 {\n   673→\t\t\tsb.WriteString(\"  Code:\\n\")\n   674→\t\t\tfor _, learning := range summary.Learnings.Code {\n   675→\t\t\t\tif learning.Line > 0 {\n   676→\t\t\t\t\tif learning.EndLine > 0 {\n   677→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d-%d: %s\\n\", learning.Path, learning.Line, learning.EndLine, learning.Finding)\n   678→\t\t\t\t\t} else {\n   679→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d: %s\\n\", learning.Path, learning.Line, learning.Finding)\n   680→\t\t\t\t\t}\n   681→\t\t\t\t} else {\n   682→\t\t\t\t\tfmt.Fprintf(sb, \"    - %s: %s\\n\", learning.Path, learning.Finding)\n   683→\t\t\t\t}\n   684→\t\t\t}\n   685→\t\t}\n   686→\n   687→\t\tif len(summary.Learnings.Workflow) > 0 {\n   688→\t\t\tsb.WriteString(\"  Workflow:\\n\")\n   689→\t\t\tfor _, learning := range summary.Learnings.Workflow {\n   690→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   691→\t\t\t}\n   692→\t\t}\n   693→\t}\n   694→\n   695→\t// Friction section\n   696→\tif len(summary.Friction) > 0 {\n   697→\t\tsb.WriteString(\"\\nFriction:\\n\")\n   698→\t\tfor _, item := range summary.Friction {\n   699→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   700→\t\t}\n   701→\t}\n   702→\n   703→\t// Open items section\n   704→\tif len(summary.OpenItems) > 0 {\n   705→\t\tsb.WriteString(\"\\nOpen Items:\\n\")\n   706→\t\tfor _, item := range summary.OpenItems {\n   707→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   708→\t\t}\n   709→\t}\n   710→}\n   711→\n   712→// runExplainDefault shows all checkpoints on the current branch.\n   713→// This is the default view when no flags are provided.\n   714→func runExplainDefault(w io.Writer, noPager bool) error {\n   715→\treturn runExplainBranchDefault(w, noPager)\n   716→}\n   717→\n   718→// branchCheckpointsLimit is the max checkpoints to show in branch view\n   719→const branchCheckpointsLimit = 100\n   720→\n   721→// commitScanLimit is how far back to scan git history for checkpoints\n   722→const commitScanLimit = 500\n   723→\n   724→// consecutiveMainLimit stops scanning after this many consecutive commits on main\n   725→// (indicates we've likely exhausted feature branch commits)\n   726→const consecutiveMainLimit = 100\n   727→\n   728→// errStopIteration is used to stop commit iteration early\n   729→var errStopIteration = errors.New(\"stop iteration\")\n   730→\n   731→// getBranchCheckpoints returns checkpoints relevant to the current branch.\n   732→// This is strategy-agnostic - it queries checkpoints directly from the checkpoint store.\n   733→//\n   734→// Behavior:\n   735→//   - On feature branches: only show checkpoints unique to this branch (not in main)\n   736→//   - On default branch (main/master): show all checkpoints in history (up to limit)\n   737→//   - Includes both committed checkpoints (entire/sessions) and temporary checkpoints (shadow branches)\n   738→func getBranchCheckpoints(repo *git.Repository, limit int) ([]strategy.RewindPoint, error) {\n   739→\tstore := checkpoint.NewGitStore(repo)\n   740→\n   741→\t// Get all committed checkpoints for lookup\n   742→\tcommittedInfos, err := store.ListCommitted(context.Background())\n   743→\tif err != nil {\n   744→\t\tcommittedInfos = nil // Continue without committed checkpoints\n   745→\t}\n   746→\n   747→\t// Build map of checkpoint ID -> committed info\n   748→\tcommittedByID := make(map[id.CheckpointID]checkpoint.CommittedInfo)\n   749→\tfor _, info := range committedInfos {\n   750→\t\tif !info.CheckpointID.IsEmpty() {\n   751→\t\t\tcommittedByID[info.CheckpointID] = info\n   752→\t\t}\n   753→\t}\n   754→\n   755→\thead, err := repo.Head()\n   756→\tif err != nil {\n   757→\t\t// Unborn HEAD (no commits yet) - return empty list instead of erroring\n   758→\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n   759→\t\t\treturn []strategy.RewindPoint{}, nil\n   760→\t\t}\n   761→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   762→\t}\n   763→\n   764→\t// Check if we're on the default branch (use repo-aware version)\n   765→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   766→\tvar mainBranchHash plumbing.Hash\n   767→\tif !isOnDefault {\n   768→\t\t// Prefer the actual default branch name (which may not be main/master)\n   769→\t\tif defaultBranchName := strategy.GetDefaultBranchName(repo); defaultBranchName != \"\" {\n   770→\t\t\t// Try local default branch first: refs/heads/<name>\n   771→\t\t\tref, refErr := repo.Reference(plumbing.ReferenceName(\"refs/heads/\"+defaultBranchName), true)\n   772→\t\t\tif refErr != nil {\n   773→\t\t\t\t// Fall back to remote default branch: refs/remotes/origin/<name>\n   774→\t\t\t\tref, refErr = repo.Reference(plumbing.ReferenceName(\"refs/remotes/origin/\"+defaultBranchName), true)\n   775→\t\t\t}\n   776→\t\t\tif refErr == nil {\n   777→\t\t\t\tmainBranchHash = ref.Hash()\n   778→\t\t\t}\n   779→\t\t}\n   780→\n   781→\t\t// Fall back to main/master detection if default branch resolution failed\n   782→\t\tif mainBranchHash == plumbing.ZeroHash {\n   783→\t\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   784→\t\t}\n   785→\t}\n   786→\n   787→\t// Precompute commits reachable from main (for O(1) filtering instead of O(N) per commit)\n   788→\t// This changes the filtering from O(N*M) to O(N+M) where N=commits scanned, M=main history depth\n   789→\treachableFromMain := make(map[plumbing.Hash]bool)\n   790→\tif mainBranchHash != plumbing.ZeroHash {\n   791→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   792→\t\tif mainErr == nil {\n   793→\t\t\tmainCount := 0\n   794→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   795→\t\t\t\tmainCount++\n   796→\t\t\t\tif mainCount > 1000 { // Same depth limit as before\n   797→\t\t\t\t\treturn errStopIteration\n   798→\t\t\t\t}\n   799→\t\t\t\treachableFromMain[c.Hash] = true\n   800→\t\t\t\treturn nil\n   801→\t\t\t})\n   802→\t\t\tmainIter.Close()\n   803→\t\t}\n   804→\t}\n   805→\n   806→\t// Walk git history and collect checkpoints\n   807→\titer, err := repo.Log(&git.LogOptions{\n   808→\t\tFrom:  head.Hash(),\n   809→\t\tOrder: git.LogOrderCommitterTime,\n   810→\t})\n   811→\tif err != nil {\n   812→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   813→\t}\n   814→\tdefer iter.Close()\n   815→\n   816→\tvar points []strategy.RewindPoint\n   817→\tcount := 0\n   818→\tconsecutiveMainCount := 0\n   819→\n   820→\terr = iter.ForEach(func(c *object.Commit) error {\n   821→\t\tif count >= commitScanLimit {\n   822→\t\t\treturn errStopIteration\n   823→\t\t}\n   824→\t\tcount++\n   825→\n   826→\t\t// On feature branches, skip commits that are reachable from main\n   827→\t\t// (but continue scanning - there may be more feature branch commits)\n   828→\t\tif len(reachableFromMain) > 0 {\n   829→\t\t\tif reachableFromMain[c.Hash] {\n   830→\t\t\t\tconsecutiveMainCount++\n   831→\t\t\t\tif consecutiveMainCount >= consecutiveMainLimit {\n   832→\t\t\t\t\treturn errStopIteration // Likely exhausted feature branch commits\n   833→\t\t\t\t}\n   834→\t\t\t\treturn nil // Skip this commit, continue scanning\n   835→\t\t\t}\n   836→\t\t\tconsecutiveMainCount = 0 // Reset on feature branch commit\n   837→\t\t}\n   838→\n   839→\t\t// Extract checkpoint ID from Entire-Checkpoint trailer\n   840→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   841→\t\tif !found {\n   842→\t\t\treturn nil // No checkpoint trailer, continue\n   843→\t\t}\n   844→\n   845→\t\t// Look up checkpoint info\n   846→\t\tcpInfo, found := committedByID[cpID]\n   847→\t\tif !found {\n   848→\t\t\treturn nil // Checkpoint not in store, continue\n   849→\t\t}\n   850→\n   851→\t\t// Create rewind point from committed info\n   852→\t\tmessage := strings.Split(c.Message, \"\\n\")[0]\n   853→\t\tpoint := strategy.RewindPoint{\n   854→\t\t\tID:               c.Hash.String(),\n   855→\t\t\tMessage:          message,\n   856→\t\t\tDate:             c.Committer.When,\n   857→\t\t\tIsLogsOnly:       true, // Committed checkpoints are logs-only\n   858→\t\t\tCheckpointID:     cpID,\n   859→\t\t\tSessionID:        cpInfo.SessionID,\n   860→\t\t\tIsTaskCheckpoint: cpInfo.IsTask,\n   861→\t\t\tToolUseID:        cpInfo.ToolUseID,\n   862→\t\t\tAgent:            cpInfo.Agent,\n   863→\t\t}\n   864→\t\t// Read session prompt from metadata branch (best-effort)\n   865→\t\tresult, _ := store.ReadCommitted(context.Background(), cpID) //nolint:errcheck  // Best-effort\n   866→\t\tif result != nil {\n   867→\t\t\t// Scope the transcript to this checkpoint's portion\n   868→\t\t\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   869→\t\t\t// lines from that point onwards (excluding earlier checkpoint content)\n   870→\t\t\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   871→\t\t\t// Extract prompts from the scoped transcript (not the full session's prompts)\n   872→\t\t\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   873→\t\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   874→\t\t\t\tpoint.SessionPrompt = scopedPrompts[0]\n   875→\t\t\t}\n   876→\t\t}\n   877→\n   878→\t\tpoints = append(points, point)\n   879→\t\treturn nil\n   880→\t})\n   881→\n   882→\tif err != nil && !errors.Is(err, errStopIteration) {\n   883→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   884→\t}\n   885→\n   886→\t// Get temporary checkpoints from ALL shadow branches whose base commit is reachable from HEAD.\n   887→\ttempPoints := getReachableTemporaryCheckpoints(repo, store, head.Hash(), isOnDefault, limit)\n   888→\tpoints = append(points, tempPoints...)\n   889→\n   890→\t// Sort by date, most recent first\n   891→\tsort.Slice(points, func(i, j int) bool {\n   892→\t\treturn points[i].Date.After(points[j].Date)\n   893→\t})\n   894→\n   895→\t// Apply limit\n   896→\tif len(points) > limit {\n   897→\t\tpoints = points[:limit]\n   898→\t}\n   899→\n   900→\treturn points, nil\n   901→}\n   902→\n   903→// getReachableTemporaryCheckpoints returns temporary checkpoints from shadow branches\n   904→// whose base commit is reachable from the given HEAD hash.\n   905→// For default branches, all shadow branches are included.\n   906→// For feature branches, only shadow branches whose base commit is in HEAD's history are included.\n   907→func getReachableTemporaryCheckpoints(repo *git.Repository, store *checkpoint.GitStore, headHash plumbing.Hash, isOnDefault bool, limit int) []strategy.RewindPoint {\n   908→\tvar points []strategy.RewindPoint\n   909→\n   910→\tshadowBranches, _ := store.ListTemporary(context.Background()) //nolint:errcheck // Best-effort\n   911→\tfor _, sb := range shadowBranches {\n   912→\t\t// Check if this shadow branch's base commit is reachable from current HEAD\n   913→\t\tif !isShadowBranchReachable(repo, sb.BaseCommit, headHash, isOnDefault) {\n   914→\t\t\tcontinue\n   915→\t\t}\n   916→\n   917→\t\t// List checkpoints from this shadow branch\n   918→\t\ttempCheckpoints, _ := store.ListCheckpointsForBranch(context.Background(), sb.BranchName, \"\", limit) //nolint:errcheck // Best-effort\n   919→\t\tfor _, tc := range tempCheckpoints {\n   920→\t\t\tpoint := convertTemporaryCheckpoint(repo, tc)\n   921→\t\t\tif point != nil {\n   922→\t\t\t\tpoints = append(points, *point)\n   923→\t\t\t}\n   924→\t\t}\n   925→\t}\n   926→\n   927→\treturn points\n   928→}\n   929→\n   930→// isShadowBranchReachable checks if a shadow branch's base commit is reachable from HEAD.\n   931→// For default branches, all shadow branches are considered reachable.\n   932→// For feature branches, we check if any commit with the base commit prefix is in HEAD's history.\n   933→func isShadowBranchReachable(repo *git.Repository, baseCommit string, headHash plumbing.Hash, isOnDefault bool) bool {\n   934→\t// For default branch: all shadow branches are potentially relevant\n   935→\tif isOnDefault {\n   936→\t\treturn true\n   937→\t}\n   938→\n   939→\t// Check if base commit hash prefix matches any commit in HEAD's history\n   940→\tbaseCommitIter, baseErr := repo.Log(&git.LogOptions{From: headHash})\n   941→\tif baseErr != nil {\n   942→\t\treturn false\n   943→\t}\n   944→\tdefer baseCommitIter.Close()\n   945→\n   946→\tbaseCount := 0\n   947→\tfound := false\n   948→\t_ = baseCommitIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   949→\t\tbaseCount++\n   950→\t\tif baseCount > commitScanLimit {\n   951→\t\t\treturn errStopIteration\n   952→\t\t}\n   953→\t\tif strings.HasPrefix(c.Hash.String(), baseCommit) {\n   954→\t\t\tfound = true\n   955→\t\t\treturn errStopIteration\n   956→\t\t}\n   957→\t\treturn nil\n   958→\t})\n   959→\n   960→\treturn found\n   961→}\n   962→\n   963→// convertTemporaryCheckpoint converts a TemporaryCheckpointInfo to a RewindPoint.\n   964→// Returns nil if the checkpoint should be skipped (no code changes or can't be read).\n   965→func convertTemporaryCheckpoint(repo *git.Repository, tc checkpoint.TemporaryCheckpointInfo) *strategy.RewindPoint {\n   966→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   967→\tif commitErr != nil {\n   968→\t\treturn nil\n   969→\t}\n   970→\n   971→\t// Filter out checkpoints with no code changes (only .entire/ metadata changed)\n   972→\t// This also filters out the first checkpoint which is just a baseline copy\n   973→\tif !hasCodeChanges(shadowCommit) {\n   974→\t\treturn nil\n   975→\t}\n   976→\n   977→\t// Read session prompt from the shadow branch commit's tree (not from entire/sessions)\n   978→\t// Temporary checkpoints store their metadata in the shadow branch, not in entire/sessions\n   979→\tvar sessionPrompt string\n   980→\tshadowTree, treeErr := shadowCommit.Tree()\n   981→\tif treeErr == nil {\n   982→\t\tsessionPrompt = strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   983→\t}\n   984→\n   985→\treturn &strategy.RewindPoint{\n   986→\t\tID:               tc.CommitHash.String(),\n   987→\t\tMessage:          tc.Message,\n   988→\t\tMetadataDir:      tc.MetadataDir,\n   989→\t\tDate:             tc.Timestamp,\n   990→\t\tIsTaskCheckpoint: tc.IsTaskCheckpoint,\n   991→\t\tToolUseID:        tc.ToolUseID,\n   992→\t\tSessionID:        tc.SessionID,\n   993→\t\tSessionPrompt:    sessionPrompt,\n   994→\t\tIsLogsOnly:       false, // Temporary checkpoints can be fully rewound\n   995→\t}\n   996→}\n   997→\n   998→// runExplainBranchWithFilter shows checkpoints on the current branch, optionally filtered by session.\n   999→// This is strategy-agnostic - it queries checkpoints directly.\n  1000→func runExplainBranchWithFilter(w io.Writer, noPager bool, sessionFilter string) error {\n  1001→\trepo, err := openRepository()\n  1002→\tif err != nil {\n  1003→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1004→\t}\n  1005→\n  1006→\t// Get current branch name\n  1007→\tbranchName := strategy.GetCurrentBranchName(repo)\n  1008→\tif branchName == \"\" {\n  1009→\t\t// Detached HEAD state or unborn HEAD - try to use short commit hash if possible\n  1010→\t\thead, headErr := repo.Head()\n  1011→\t\tif headErr != nil {\n  1012→\t\t\t// Unborn HEAD (no commits yet) - treat as empty history instead of erroring\n  1013→\t\t\tif errors.Is(headErr, plumbing.ErrReferenceNotFound) {\n  1014→\t\t\t\tbranchName = \"HEAD (no commits yet)\"\n  1015→\t\t\t} else {\n  1016→\t\t\t\treturn fmt.Errorf(\"failed to get HEAD: %w\", headErr)\n  1017→\t\t\t}\n  1018→\t\t} else {\n  1019→\t\t\tbranchName = \"HEAD (\" + head.Hash().String()[:7] + \")\"\n  1020→\t\t}\n  1021→\t}\n  1022→\n  1023→\t// Get checkpoints for this branch (strategy-agnostic)\n  1024→\tpoints, err := getBranchCheckpoints(repo, branchCheckpointsLimit)\n  1025→\tif err != nil {\n  1026→\t\t// Log the error but continue with empty list so user sees helpful message\n  1027→\t\tlogging.Warn(context.Background(), \"failed to get branch checkpoints\", \"error\", err)\n  1028→\t\tpoints = nil\n  1029→\t}\n  1030→\n  1031→\t// Format output\n  1032→\toutput := formatBranchCheckpoints(branchName, points, sessionFilter)\n  1033→\n  1034→\toutputExplainContent(w, output, noPager)\n  1035→\treturn nil\n  1036→}\n  1037→\n  1038→// runExplainBranchDefault shows all checkpoints on the current branch grouped by date.\n  1039→// This is a convenience wrapper that calls runExplainBranchWithFilter with no filter.\n  1040→func runExplainBranchDefault(w io.Writer, noPager bool) error {\n  1041→\treturn runExplainBranchWithFilter(w, noPager, \"\")\n  1042→}\n  1043→\n  1044→// outputExplainContent outputs content with optional pager support.\n  1045→func outputExplainContent(w io.Writer, content string, noPager bool) {\n  1046→\tif noPager {\n  1047→\t\tfmt.Fprint(w, content)\n  1048→\t} else {\n  1049→\t\toutputWithPager(w, content)\n  1050→\t}\n  1051→}\n  1052→\n  1053→// runExplainCommit looks up the checkpoint associated with a commit.\n  1054→// Extracts the Entire-Checkpoint trailer and delegates to checkpoint detail view.\n  1055→// If no trailer found, shows a message indicating no associated checkpoint.\n  1056→func runExplainCommit(w io.Writer, commitRef string, noPager, verbose, full, searchAll bool) error {\n  1057→\trepo, err := openRepository()\n  1058→\tif err != nil {\n  1059→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1060→\t}\n  1061→\n  1062→\t// Resolve the commit reference\n  1063→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1064→\tif err != nil {\n  1065→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1066→\t}\n  1067→\n  1068→\tcommit, err := repo.CommitObject(*hash)\n  1069→\tif err != nil {\n  1070→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1071→\t}\n  1072→\n  1073→\t// Extract Entire-Checkpoint trailer\n  1074→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1075→\tif !hasCheckpoint {\n  1076→\t\tfmt.Fprintln(w, \"No associated Entire checkpoint\")\n  1077→\t\tfmt.Fprintf(w, \"\\nCommit %s does not have an Entire-Checkpoint trailer.\\n\", hash.String()[:7])\n  1078→\t\tfmt.Fprintln(w, \"This commit was not created during an Entire session, or the trailer was removed.\")\n  1079→\t\treturn nil\n  1080→\t}\n  1081→\n  1082→\t// Delegate to checkpoint detail view\n  1083→\t// Note: We pass a nil errW since runExplainCheckpoint only uses it for generate mode\n  1084→\treturn runExplainCheckpoint(w, nil, checkpointID.String(), noPager, verbose, full, false, false, false, searchAll)\n  1085→}\n  1086→\n  1087→// formatSessionInfo formats session information for display.\n  1088→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1089→\tvar sb strings.Builder\n  1090→\n  1091→\t// Session header\n  1092→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1093→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1094→\n  1095→\tif !session.StartTime.IsZero() {\n  1096→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1097→\t}\n  1098→\n  1099→\tif sourceRef != \"\" {\n  1100→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1101→\t}\n  1102→\n  1103→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1104→\n  1105→\t// Checkpoint details\n  1106→\tfor _, cp := range checkpoints {\n  1107→\t\tsb.WriteString(\"\\n\")\n  1108→\n  1109→\t\t//