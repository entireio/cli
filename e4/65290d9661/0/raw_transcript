 generate summary for temporary checkpoint %s (only committed checkpoints supported)\", checkpointIDPrefix)\n   202→\t\t}\n   203→\t\toutput, found := explainTemporaryCheckpoint(w, repo, store, checkpointIDPrefix, verbose, full, rawTranscript)\n   204→\t\tif found {\n   205→\t\t\toutputExplainContent(w, output, noPager)\n   206→\t\t\treturn nil\n   207→\t\t}\n   208→\t\t// If output is non-empty, it contains an error message (e.g., ambiguous prefix)\n   209→\t\tif output != \"\" {\n   210→\t\t\treturn errors.New(output)\n   211→\t\t}\n   212→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", checkpointIDPrefix)\n   213→\tcase 1:\n   214→\t\tfullCheckpointID = matches[0]\n   215→\tdefault:\n   216→\t\t// Ambiguous prefix - show up to 5 examples\n   217→\t\texamples := make([]string, 0, 5)\n   218→\t\tfor i := 0; i < len(matches) && i < 5; i++ {\n   219→\t\t\texamples = append(examples, matches[i].String())\n   220→\t\t}\n   221→\t\treturn fmt.Errorf(\"ambiguous checkpoint prefix %q matches %d checkpoints: %s\", checkpointIDPrefix, len(matches), strings.Join(examples, \", \"))\n   222→\t}\n   223→\n   224→\t// Load checkpoint data\n   225→\tresult, err := store.ReadCommitted(context.Background(), fullCheckpointID)\n   226→\tif err != nil {\n   227→\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   228→\t}\n   229→\tif result == nil {\n   230→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", fullCheckpointID)\n   231→\t}\n   232→\n   233→\t// Handle summary generation\n   234→\tif generate {\n   235→\t\tif err := generateCheckpointSummary(w, errW, store, fullCheckpointID, result, force); err != nil {\n   236→\t\t\treturn err\n   237→\t\t}\n   238→\t\t// Reload the result to get the updated summary\n   239→\t\tresult, err = store.ReadCommitted(context.Background(), fullCheckpointID)\n   240→\t\tif err != nil {\n   241→\t\t\treturn fmt.Errorf(\"failed to reload checkpoint: %w\", err)\n   242→\t\t}\n   243→\t\tif result == nil {\n   244→\t\t\treturn fmt.