tain modified file, got:\\n%s\", output)\n   803→\t}\n   804→}\n   805→\n   806→func TestFormatSessionInfo_DoesNotShowMessageWhenHasInteractions(t *testing.T) {\n   807→\t// Test that checkpoints WITH interactions don't show the message separately\n   808→\t// (the interactions already contain the content)\n   809→\tnow := time.Now()\n   810→\tsession := &strategy.Session{\n   811→\t\tID:          \"2025-12-12-full-checkpoint\",\n   812→\t\tStrategy:    \"auto-commit\",\n   813→\t\tStartTime:   now,\n   814→\t\tCheckpoints: []strategy.Checkpoint{},\n   815→\t}\n   816→\n   817→\tcheckpointDetails := []checkpointDetail{\n   818→\t\t{\n   819→\t\t\tIndex:            1,\n   820→\t\t\tShortID:          \"ghi9012\",\n   821→\t\t\tTimestamp:        now,\n   822→\t\t\tIsTaskCheckpoint: true,\n   823→\t\t\tMessage:          \"Completed 'dev' agent: Implement feature (toolu_03GHI)\",\n   824→\t\t\tInteractions: []interaction{\n   825→\t\t\t\t{\n   826→\t\t\t\t\tPrompt:    \"Implement the feature\",\n   827→\t\t\t\t\tResponses: []string{\"I've implemented the feature by...\"},\n   828→\t\t\t\t\tFiles:     []string{\"feature.go\"},\n   829→\t\t\t\t},\n   830→\t\t\t},\n   831→\t\t},\n   832→\t}\n   833→\n   834→\toutput := formatSessionInfo(session, \"\", checkpointDetails)\n   835→\n   836→\t// Should show the interaction content\n   837→\tif !strings.Contains(output, \"Implement the feature\") {\n   838→\t\tt.Errorf(\"expected output to contain prompt, got:\\n%s\", output)\n   839→\t}\n   840→\tif !strings.Contains(output, \"I've implemented the feature by\") {\n   841→\t\tt.Errorf(\"expected output to contain response, got:\\n%s\", output)\n   842→\t}\n   843→\n   844→\t// The message should NOT appear as a separate line (it's redundant when we have interactions)\n   845→\t// The output should contain ## Prompt and ## Responses for the interaction\n   846→\tif !strings.Contains(output, \"## Prompt\") {\n   847→\t\tt.Errorf(\"expected output to contain '## Prompt' when has in