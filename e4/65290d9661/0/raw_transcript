 len(scopedTranscript) == 0 {\n   286→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript content for this checkpoint (scoped)\", checkpointID)\n   287→\t}\n   288→\n   289→\t// Build condensed transcript for summarisation from the scoped portion\n   290→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(scopedTranscript)\n   291→\tif err != nil {\n   292→\t\treturn fmt.Errorf(\"failed to parse transcript: %w\", err)\n   293→\t}\n   294→\tif len(condensed) == 0 {\n   295→\t\treturn fmt.Errorf(\"checkpoint %s transcript has no content to summarise\", checkpointID)\n   296→\t}\n   297→\n   298→\tinput := summarise.Input{\n   299→\t\tTranscript:   condensed,\n   300→\t\tFilesTouched: result.Metadata.FilesTouched,\n   301→\t}\n   302→\n   303→\t// Generate summary using Claude CLI\n   304→\tctx := context.Background()\n   305→\tlogging.Info(ctx, \"generating checkpoint summary\")\n   306→\n   307→\tvar generator summarise.Generator = &summarise.ClaudeGenerator{}\n   308→\tsummary, err := generator.Generate(ctx, input)\n   309→\tif err != nil {\n   310→\t\treturn fmt.Errorf(\"failed to generate summary: %w\", err)\n   311→\t}\n   312→\n   313→\t// Persist the summary\n   314→\tif err := store.UpdateSummary(ctx, checkpointID, summary); err != nil {\n   315→\t\treturn fmt.Errorf(\"failed to save summary: %w\", err)\n   316→\t}\n   317→\n   318→\tfmt.Fprintln(w, \"✓ Summary generated and saved\")\n   319→\treturn nil\n   320→}\n   321→\n   322→// explainTemporaryCheckpoint finds and formats a temporary checkpoint by shadow commit hash prefix.\n   323→// Returns the formatted output and whether the checkpoint was found.\n   324→// Searches ALL shadow branches, not just the one for current HEAD, to find checkpoints\n   325→// created from different base commits (e.g., if HEAD advanced since session start).\n   326→// The writer w is used for raw transcript output to bypass the pager.\n   327→func explainTemporaryCheckpoint(w io.Writer, repo *git.Repository, store *checkpoint.GitStore, shaPrefix string, verbose, full, rawTranscript bool) (string, bool) {\n   328→\t// List temporary checkpoints from ALL shadow branches\n   329→\t// This ensures we find checkpoints even if HEAD has advanced since the session started\n   330→\ttempCheckpoints, err := store.ListAllTemporaryCheckpoints(context.Background(), \"\", branchCheckpointsLimit)\n   331→\tif err != nil {\n   332→\t\treturn \"\", false\n   333→\t}\n   334→\n   335→\t// Find checkpoints matching the SHA prefix - check for ambiguity\n   336→\tvar matches []checkpoint.TemporaryCheckpointInfo\n   337→\tfor _, tc := range tempCheckpoints {\n   338→\t\tif strings.HasPrefix(tc.CommitHash.String(), shaPrefix) {\n   339→\t\t\tmatches = append(matches, tc)\n   340→\t\t}\n   341→\t}\n   342→\n   343→\tif len(matches) == 0 {\n   344→\t\treturn \"\", false\n   345→\t}\n   346→\n   347→\tif len(matches) > 1 {\n   348→\t\t// Multiple matches - return ambiguous error (consistent with committed checkpoint behavior)\n   349→\t\tvar sb strings.Builder\n   350→\t\tfmt.Fprintf(&sb, \"ambiguous checkpoint prefix %q matches %d temporary checkpoints:\\n\", shaPrefix, len(matches))\n   351→\t\tfor _, m := range matches {\n   352→\t\t\tshortID := m.CommitHash.String()[:7]\n   353→\t\t\tfmt.Fprintf(&sb, \"  %s  %s  session %s\\n\",\n   354→\t\t\t\tshortID,\n   355→\t\t\t\tm.Timestamp.Format(\"2006-01-02 15:04:05\"),\n   356→\t\t\t\tm.SessionID)\n   357→\t\t}\n   358→\t\t// Return as \"not found\" with error message - caller will use this as error\n   359→\t\treturn sb.String(), false\n   360→\t}\n   361→\n   362→\ttc := matches[0]\n   363→\n   364→\t// Handle raw transcript output\n   365→\tif rawTranscript {\n   366→\t\ttranscriptBytes, transcriptErr := store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown)\n   367→\t\tif transcriptErr != nil || len(transcriptBytes) == 0 {\n   368→\t\t\t// Return specific error message (consistent with committed checkpoints)\n   369→\t\t\treturn fmt.Sprintf(\"checkpoint %s has no transcript\", tc.CommitHash.String()[:7]), false\n   370→\t\t}\n   371→\t\t// Write directly to writer (no pager, no formatting) - matches committed checkpoint behavior\n   372→\t\tif _, writeErr := fmt.Fprint(w, string(transcriptBytes)); writeErr != nil {\n   373→\t\t\treturn fmt.Sprintf(\"failed to write transcript: %v\", writeErr), false\n   374→\t\t}\n   375→\t\treturn \"\", true\n   376→\t}\n   377→\n   378→\t// Found exactly one match - read metadata from shadow branch commit tree\n   379→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   380→\tif commitErr != nil {\n   381→\t\treturn \"\", false\n   382→\t}\n   383→\n   384→\tshadowTree, treeErr := shadowCommit.Tree()\n   385→\tif treeErr != nil {\n   386→\t\treturn \"\", false\n   387→\t}\n   388→\n   389→\t// Read prompts from shadow branch\n   390→\tsessionPrompt := strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   391→\n   392→\t// Build output similar to formatCheckpointOutput but for temporary\n   393→\tvar sb strings.Builder\n   394→\tshortID := tc.CommitHash.String()[:7]\n   395→\tfmt.Fprintf(&sb, \"Checkpoint: %s [temporary]\\n\", shortID)\n   396→\tfmt.Fprintf(&sb, \"Session: %s\\n\", tc.SessionID)\n   397→\tfmt.Fprintf(&sb, \"Created: %s\\n\", tc.Timestamp.Format(\"2006-01-02 15:04:05\"))\n   398→\tsb.WriteString(\"\\n\")\n   399→\n   400→\t// Intent from prompt\n   401→\tintent := \"(not available)\"\n   402→\tif sessionPrompt != \"\" {\n   403→\t\tlines := strings.Split(sessionPrompt, \"\\n\")\n   404→\t\tif len(lines) > 0 && lines[0] != \"\" {\n   405→\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   406→\t\t}\n   407→\t}\n   408→\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   409→\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   410→\n   411→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   412→\t// For temporary checkpoints, load transcript and compute scope from parent commit\n   413→\tvar fullTranscript []byte\n   414→\tvar scopedTranscript []byte\n   415→\tif full || verbose {\n   416→\t\tfullTranscript, _ = store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   417→\n   418→\t\tif verbose && len(fullTranscript) > 0 {\n   419→\t\t\t// Compute scoped transcript by finding where parent's transcript ended\n   420→\t\t\t// Each shadow branch commit has the full transcript up to that point,\n   421→\t\t\t// so we diff against parent to get just this checkpoint's activity\n   422→\t\t\tscopedTranscript = fullTranscript // Default to full if no parent\n   423→\t\t\tif shadowCommit.NumParents() > 0 {\n   424→\t\t\t\tif parent, parentErr := shadowCommit.Parent(0); parentErr == nil {\n   425→\t\t\t\t\tparentTranscript, _ := store.GetTranscriptFromCommit(parent.Hash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   426→\t\t\t\t\tif len(parentTranscript) > 0 {\n   427→\t\t\t\t\t\t// Count lines in parent transcript to know where to slice from\n   428→\t\t\t\t\t\tparentLineCount := countLines(parentTranscript)\n   429→\t\t\t\t\t\tscopedTranscript = transcript.SliceFromLine(fullTranscript, parentLineCount)\n   430→\t\t\t\t\t}\n   431→\t\t\t\t}\n   432→\t\t\t}\n   433→\t\t}\n   434→\t}\n   435→\tappendTranscriptSection(&sb, verbose, full, fullTranscript, scopedTranscript, sessionPrompt)\n   436→\n   437→\treturn sb.String(), true\n   438→}\n   439→\n   440→// findCommitMessageForCheckpoint searches git history for a commit with the\n   441→// Entire-Checkpoint trailer matching the given checkpoint ID, and returns\n   442→// the first line of the commit message. Returns empty string if not found.\n   443→func findCommitMessageForCheckpoint(repo *git.Repository, checkpointID id.CheckpointID) string {\n   444→\t// Get HEAD reference\n   445→\thead, err := repo.Head()\n   446→\tif err != nil {\n   447→\t\treturn \"\"\n   448→\t}\n   449→\n   450→\t// Iterate through commit history (limit to recent commits for performance)\n   451→\tcommitIter, err := repo.Log(&git.LogOptions{\n   452→\t\tFrom: head.Hash(),\n   453→\t})\n   454→\tif err != nil {\n   455→\t\treturn \"\"\n   456→\t}\n   457→\tdefer commitIter.Close()\n   458→\n   459→\tcount := 0\n   460→\n   461→\tfor {\n   462→\t\tcommit, iterErr := commitIter.Next()\n   463→\t\tif iterErr != nil {\n   464→\t\t\tbreak\n   465→\t\t}\n   466→\t\tcount++\n   467→\t\tif count > commitScanLimit {\n   468→\t\t\tbreak\n   469→\t\t}\n   470→\n   471→\t\t// Check if this commit has our checkpoint ID\n   472→\t\tfoundID, hasTrailer := trailers.ParseCheckpoint(commit.Message)\n   473→\t\tif hasTrailer && foundID == checkpointID {\n   474→\t\t\t// Return first line of commit message (without trailing newline)\n   475→\t\t\tfirstLine := strings.Split(commit.Message, \"\\n\")[0]\n   476→\t\t\treturn strings.TrimSpace(firstLine)\n   477→\t\t}\n   478→\t}\n   479→\n   480→\treturn \"\"\n   481→}\n   482→\n   483→// scopeTranscriptForCheckpoint slices a transcript to include only the lines\n   484→// relevant to a specific checkpoint, starting from linesAtStart.\n   485→// This allows showing only what happened during a checkpoint, not the entire session.\n   486→func scopeTranscriptForCheckpoint(fullTranscript []byte, linesAtStart int) []byte {\n   487→\treturn transcript.SliceFromLine(fullTranscript, linesAtStart)\n   488→}\n   489→\n   490→// extractPromptsFromTranscript extracts user prompts from transcript bytes.\n   491→// Returns a slice of prompt strings.\n   492→func extractPromptsFromTranscript(transcriptBytes []byte) []string {\n   493→\tif len(transcriptBytes) == 0 {\n   494→\t\treturn nil\n   495→\t}\n   496→\n   497→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   498→\tif err != nil {\n   499→\t\treturn nil\n   500→\t}\n   501→\n   502→\tvar prompts []string\n   503→\tfor _, entry := range condensed {\n   504→\t\tif entry.Type == summarise.EntryTypeUser && entry.Content != \"\" {\n   505→\t\t\tprompts = append(prompts, entry.Content)\n   506→\t\t}\n   507→\t}\n   508→\treturn prompts\n   509→}\n   510→\n   511→// formatCheckpointOutput formats checkpoint data based on verbosity level.\n   512→// When verbose is false: summary only (ID, session, timestamp, tokens, intent).\n   513→// When verbose is true: adds files, commit message, and scoped transcript for this checkpoint.\n   514→// When full is true: shows parsed full session transcript instead of scoped transcript.\n   515→//\n   516→// Transcript scope is controlled by TranscriptLinesAtStart in metadata, which indicates\n   517→// where this checkpoint's content begins in the full session transcript.\n   518→func formatCheckpointOutput(result *checkpoint.ReadCommittedResult, checkpointID id.CheckpointID, commitMessage string, verbose, full bool) string {\n   519→\tvar sb strings.Builder\n   520→\tmeta := result.Metadata\n   521→\n   522→\t// Scope the transcript to this checkpoint's portion\n   523→\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   524→\t// lines from that point onwards (excluding earlier checkpoint content)\n   525→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, meta.TranscriptLinesAtStart)\n   526→\n   527→\t// Extract prompts from the scoped transcript for intent extraction\n   528→\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   529→\n   530→\t// Header - always shown\n   531→\t// Note: CheckpointID is always exactly 12 characters, matching checkpointIDDisplayLength\n   532→\tfmt.Fprintf(&sb, \"Checkpoint: %s\\n\", checkpointID)\n   533→\tfmt.Fprintf(&sb, \"Session: %s\\n\", meta.SessionID)\n   534→\tfmt.Fprintf(&sb, \"Created: %s\\n\", meta.CreatedAt.Format(\"2006-01-02 15:04:05\"))\n   535→\n   536→\t// Token usage\n   537→\tif meta.TokenUsage != nil {\n   538→\t\ttotalTokens := meta.TokenUsage.InputTokens + meta.TokenUsage.CacheCreationTokens +\n   539→\t\t\tmeta.TokenUsage.CacheReadTokens + meta.TokenUsage.OutputTokens\n   540→\t\tfmt.Fprintf(&sb, \"Tokens: %d\\n\", totalTokens)\n   541→\t}\n   542→\n   543→\tsb.WriteString(\"\\n\")\n   544→\n   545→\t// Intent and Outcome from AI summary, or fallback to prompt text\n   546→\tif meta.Summary != nil {\n   547→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", meta.Summary.Intent)\n   548→\t\tfmt.Fprintf(&sb, \"Outcome: %s\\n\", meta.Summary.Outcome)\n   549→\t} else {\n   550→\t\t// Fallback: use first line of scoped prompts for intent,\n   551→\t\t// or fall back to result.Prompts for backwards compatibility with older checkpoints\n   552→\t\tintent := \"(not generated)\"\n   553→\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   554→\t\t\tintent = strategy.TruncateDescription(scopedPrompts[0], maxIntentDisplayLength)\n   555→\t\t} else if result.Prompts != \"\" {\n   556→\t\t\t// Backwards compatibility: use stored prompts if no transcript available\n   557→\t\t\tlines := strings.Split(result.Prompts, \"\\n\")\n   558→\t\t\tif len(lines) > 0 && lines[0] != \"\" {\n   559→\t\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   560→\t\t\t}\n   561→\t\t}\n   562→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   563→\t\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   564→\t}\n   565→\n   566→\t// Verbose: add commit message, learnings, friction, files, and scoped transcript\n   567→\tif verbose || full {\n   568→\t\t// AI Summary details (learnings, friction, open items)\n   569→\t\tif meta.Summary != nil {\n   570→\t\t\tformatSummaryDetails(&sb, meta.Summary)\n   571→\t\t}\n   572→\n   573→\t\t// Commit message section (only if available)\n   574→\t\tif commitMessage != \"\" {\n   575→\t\t\tsb.WriteString(\"\\n\")\n   576→\t\t\tfmt.Fprintf(&sb, \"Commit: %s\\n\", commitMessage)\n   577→\t\t}\n   578→\n   579→\t\tsb.WriteString(\"\\n\")\n   580→\n   581→\t\t// Files section\n   582→\t\tif len(meta.FilesTouched) > 0 {\n   583→\t\t\tfmt.Fprintf(&sb, \"Files: (%d)\\n\", len(meta.FilesTouched))\n   584→\t\t\tfor _, file := range meta.FilesTouched {\n   585→\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n   586→\t\t\t}\n   587→\t\t} else {\n   588→\t\t\tsb.WriteString(\"Files: (none)\\n\")\n   589→\t\t}\n   590→\t}\n   591→\n   592→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   593→\tappendTranscriptSection(&sb, verbose, full, result.Transcript, scopedTranscript, result.Prompts)\n   594→\n   595→\treturn sb.String()\n   596→}\n   597→\n   598→// appendTranscriptSection appends the appropriate transcript section to the builder\n   599→// based on verbosity level. Full mode shows the entire session, verbose shows checkpoint scope.\n   600→// fullTranscript is the entire session transcript, scopedContent is either scoped transcript bytes\n   601→// or a pre-formatted string (for backwards compat), and scopedFallback is used when scoped parsing fails.\n   602→func appendTranscriptSection(sb *strings.Builder, verbose, full bool, fullTranscript, scopedTranscript []byte, scopedFallback string) {\n   603→\tswitch {\n   604→\tcase full:\n   605→\t\tsb.WriteString(\"\\n\")\n   606→\t\tsb.WriteString(\"Transcript (full session):\\n\")\n   607→\t\tsb.WriteString(formatTranscriptBytes(fullTranscript, \"\"))\n   608→\n   609→\tcase verbose:\n   610→\t\tsb.WriteString(\"\\n\")\n   611→\t\tsb.WriteString(\"Transcript (checkpoint scope):\\n\")\n   612→\t\tsb.WriteString(formatTranscriptBytes(scopedTranscript, scopedFallback))\n   613→\t}\n   614→}\n   615→\n   616→// formatTranscriptBytes formats transcript bytes into a human-readable string.\n   617→// It parses the JSONL transcript and formats it using the condensed format.\n   618→// The fallback is used for backwards compatibility when transcript parsing fails or is empty.\n   619→func formatTranscriptBytes(transcriptBytes []byte, fallback string) string {\n   620→\tif len(transcriptBytes) == 0 {\n   621→\t\tif fallback != \"\" {\n   622→\t\t\treturn fallback + \"\\n\"\n   623→\t\t}\n   624→\t\treturn \"  (none)\\n\"\n   625→\t}\n   626→\n   627→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   628→\tif err != nil || len(condensed) == 0 {\n   629→\t\tif fallback != \"\" {\n   630→\t\t\treturn fallback + \"\\n\"\n   631→\t\t}\n   632→\t\treturn \"  (failed to parse transcript)\\n\"\n   633→\t}\n   634→\n   635→\tinput := summarise.Input{Transcript: condensed}\n   636→\treturn summarise.FormatCondensedTranscript(input)\n   637→}\n   638→\n   639→// formatSummaryDetails formats the detailed sections of an AI summary.\n   640→func formatSummaryDetails(sb *strings.Builder, summary *checkpoint.Summary) {\n   641→\t// Learnings section\n   642→\thasLearnings := len(summary.Learnings.Repo) > 0 ||\n   643→\t\tlen(summary.Learnings.Code) > 0 ||\n   644→\t\tlen(summary.Learnings.Workflow) > 0\n   645→\n   646→\tif hasLearnings {\n   647→\t\tsb.WriteString(\"\\nLearnings:\\n\")\n   648→\n   649→\t\tif len(summary.Learnings.Repo) > 0 {\n   650→\t\t\tsb.WriteString(\"  Repository:\\n\")\n   651→\t\t\tfor _, learning := range summary.Learnings.Repo {\n   652→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   653→\t\t\t}\n   654→\t\t}\n   655→\n   656→\t\tif len(summary.Learnings.Code) > 0 {\n   657→\t\t\tsb.WriteString(\"  Code:\\n\")\n   658→\t\t\tfor _, learning := range summary.Learnings.Code {\n   659→\t\t\t\tif learning.Line > 0 {\n   660→\t\t\t\t\tif learning.EndLine > 0 {\n   661→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d-%d: %s\\n\", learning.Path, learning.Line, learning.EndLine, learning.Finding)\n   662→\t\t\t\t\t} else {\n   663→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d: %s\\n\", learning.Path, learning.Line, learning.Finding)\n   664→\t\t\t\t\t}\n   665→\t\t\t\t} else {\n   666→\t\t\t\t\tfmt.Fprintf(sb, \"    - %s: %s\\n\", learning.Path, learning.Finding)\n   667→\t\t\t\t}\n   668→\t\t\t}\n   669→\t\t}\n   670→\n   671→\t\tif len(summary.Learnings.Workflow) > 0 {\n   672→\t\t\tsb.WriteString(\"  Workflow:\\n\")\n   673→\t\t\tfor _, learning := range summary.Learnings.Workflow {\n   674→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   675→\t\t\t}\n   676→\t\t}\n   677→\t}\n   678→\n   679→\t// Friction section\n   680→\tif len(summary.Friction) > 0 {\n   681→\t\tsb.WriteString(\"\\nFriction:\\n\")\n   682→\t\tfor _, item := range summary.Friction {\n   683→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   684→\t\t}\n   685→\t}\n   686→\n   687→\t// Open items section\n   688→\tif len(summary.OpenItems) > 0 {\n   689→\t\tsb.WriteString(\"\\nOpen Items:\\n\")\n   690→\t\tfor _, item := range summary.OpenItems {\n   691→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   692→\t\t}\n   693→\t}\n   694→}\n   695→\n   696→// runExplainDefault shows all checkpoints on the current branch.\n   697→// This is the default view when no flags are provided.\n   698→func runExplainDefault(w io.Writer, noPager bool) error {\n   699→\treturn runExplainBranchDefault(w, noPager)\n   700→}\n   701→\n   702→// branchCheckpointsLimit is the max checkpoints to show in branch view\n   703→const branchCheckpointsLimit = 100\n   704→\n   705→// commitScanLimit is how far back to scan git history for checkpoints\n   706→const commitScanLimit = 500\n   707→\n   708→// consecutiveMainLimit stops scanning after this many consecutive commits on main\n   709→// (indicates we've likely exhausted feature branch commits)\n   710→const consecutiveMainLimit = 100\n   711→\n   712→// errStopIteration is used to stop commit iteration early\n   713→var errStopIteration = errors.New(\"stop iteration\")\n   714→\n   715→// getBranchCheckpoints returns checkpoints relevant to the current branch.\n   716→// This is strategy-agnostic - it queries checkpoints directly from the checkpoint store.\n   717→//\n   718→// Behavior:\n   719→//   - On feature branches: only show checkpoints unique to this branch (not in main)\n   720→//   - On default branch (main/master): show all checkpoints in history (up to limit)\n   721→//   - Includes both committed checkpoints (entire/sessions) and temporary checkpoints (shadow branches)\n   722→func getBranchCheckpoints(repo *git.Repository, limit int) ([]strategy.RewindPoint, error) {\n   723→\tstore := checkpoint.NewGitStore(repo)\n   724→\n   725→\t// Get all committed checkpoints for lookup\n   726→\tcommittedInfos, err := store.ListCommitted(context.Background())\n   727→\tif err != nil {\n   728→\t\tcommittedInfos = nil // Continue without committed checkpoints\n   729→\t}\n   730→\n   731→\t// Build map of checkpoint ID -> committed info\n   732→\tcommittedByID := make(map[id.CheckpointID]checkpoint.CommittedInfo)\n   733→\tfor _, info := range committedInfos {\n   734→\t\tif !info.CheckpointID.IsEmpty() {\n   735→\t\t\tcommittedByID[info.CheckpointID] = info\n   736→\t\t}\n   737→\t}\n   738→\n   739→\thead, err := repo.Head()\n   740→\tif err != nil {\n   741→\t\t// Unborn HEAD (no commits yet) - return empty list instead of erroring\n   742→\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n   743→\t\t\treturn []strategy.RewindPoint{}, nil\n   744→\t\t}\n   745→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   746→\t}\n   747→\n   748→\t// Check if we're on the default branch (use repo-aware version)\n   749→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   750→\tvar mainBranchHash plumbing.Hash\n   751→\tif !isOnDefault {\n   752→\t\t// Prefer the actual default branch name (which may not be main/master)\n   753→\t\tif defaultBranchName := strategy.GetDefaultBranchName(repo); defaultBranchName != \"\" {\n   754→\t\t\t// Try local default branch first: refs/heads/<name>\n   755→\t\t\tref, refErr := repo.Reference(plumbing.ReferenceName(\"refs/heads/\"+defaultBranchName), true)\n   756→\t\t\tif refErr != nil {\n   757→\t\t\t\t// Fall back to remote default branch: refs/remotes/origin/<name>\n   758→\t\t\t\tref, refErr = repo.Reference(plumbing.ReferenceName(\"refs/remotes/origin/\"+defaultBranchName), true)\n   759→\t\t\t}\n   760→\t\t\tif refErr == nil {\n   761→\t\t\t\tmainBranchHash = ref.Hash()\n   762→\t\t\t}\n   763→\t\t}\n   764→\n   765→\t\t// Fall back to main/master detection if default branch resolution failed\n   766→\t\tif mainBranchHash == plumbing.ZeroHash {\n   767→\t\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   768→\t\t}\n   769→\t}\n   770→\n   771→\t// Precompute commits reachable from main (for O(1) filtering instead of O(N) per commit)\n   772→\t// This changes the filtering from O(N*M) to O(N+M) where N=commits scanned, M=main history depth\n   773→\treachableFromMain := make(map[plumbing.Hash]bool)\n   774→\tif mainBranchHash != plumbing.ZeroHash {\n   775→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   776→\t\tif mainErr == nil {\n   777→\t\t\tmainCount := 0\n   778→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   779→\t\t\t\tmainCount++\n   780→\t\t\t\tif mainCount > 1000 { // Same depth limit as before\n   781→\t\t\t\t\treturn errStopIteration\n   782→\t\t\t\t}\n   783→\t\t\t\treachableFromMain[c.Hash] = true\n   784→\t\t\t\treturn nil\n   785→\t\t\t})\n   786→\t\t\tmainIter.Close()\n   787→\t\t}\n   788→\t}\n   789→\n   790→\t// Walk git history and collect checkpoints\n   791→\titer, err := repo.Log(&git.LogOptions{\n   792→\t\tFrom:  head.Hash(),\n   793→\t\tOrder: git.LogOrderCommitterTime,\n   794→\t})\n   795→\tif err != nil {\n   796→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   797→\t}\n   798→\tdefer iter.Close()\n   799→\n   800→\tvar points []strategy.RewindPoint\n   801→\tcount := 0\n   802→\tconsecutiveMainCount := 0\n   803→\n   804→\terr = iter.ForEach(func(c *object.Commit) error {\n   805→\t\tif count >= commitScanLimit {\n   806→\t\t\treturn errStopIteration\n   807→\t\t}\n   808→\t\tcount++\n   809→\n   810→\t\t// On feature branches, skip commits that are reachable from main\n   811→\t\t// (but continue scanning - there may be more feature branch commits)\n   812→\t\tif len(reachableFromMain) > 0 {\n   813→\t\t\tif reachableFromMain[c.Hash] {\n   814→\t\t\t\tconsecutiveMainCount++\n   815→\t\t\t\tif consecutiveMainCount >= consecutiveMainLimit {\n   816→\t\t\t\t\treturn errStopIteration // Likely exhausted feature branch commits\n   817→\t\t\t\t}\n   818→\t\t\t\treturn nil // Skip this commit, continue scanning\n   819→\t\t\t}\n   820→\t\t\tconsecutiveMainCount = 0 // Reset on feature branch commit\n   821→\t\t}\n   822→\n   823→\t\t// Extract checkpoint ID from Entire-Checkpoint trailer\n   824→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   825→\t\tif !found {\n   826→\t\t\treturn nil // No checkpoint trailer, continue\n   827→\t\t}\n   828→\n   829→\t\t// Look up checkpoint info\n   830→\t\tcpInfo, found := committedByID[cpID]\n   831→\t\tif !found {\n   832→\t\t\treturn nil // Checkpoint not in store, continue\n   833→\t\t}\n   834→\n   835→\t\t// Create rewind point from committed info\n   836→\t\tmessage := strings.Split(c.Message, \"\\n\")[0]\n   837→\t\tpoint := strategy.RewindPoint{\n   838→\t\t\tID:               c.Hash.String(),\n   839→\t\t\tMessage:          message,\n   840→\t\t\tDate:             c.Committer.When,\n   841→\t\t\tIsLogsOnly:       true, // Committed checkpoints are logs-only\n   842→\t\t\tCheckpointID:     cpID,\n   843→\t\t\tSessionID:        cpInfo.SessionID,\n   844→\t\t\tIsTaskCheckpoint: cpInfo.IsTask,\n   845→\t\t\tToolUseID:        cpInfo.ToolUseID,\n   846→\t\t\tAgent:            cpInfo.Agent,\n   847→\t\t}\n   848→\t\t// Read session prompt from metadata branch (best-effort)\n   849→\t\tresult, _ := store.ReadCommitted(context.Background(), cpID) //nolint:errcheck  // Best-effort\n   850→\t\tif result != nil {\n   851→\t\t\t// Scope the transcript to this checkpoint's portion\n   852→\t\t\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   853→\t\t\t// lines from that point onwards (excluding earlier checkpoint content)\n   854→\t\t\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   855→\t\t\t// Extract prompts from the scoped transcript (not the full session's prompts)\n   856→\t\t\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   857→\t\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   858→\t\t\t\tpoint.SessionPrompt = scopedPrompts[0]\n   859→\t\t\t}\n   860→\t\t}\n   861→\n   862→\t\tpoints = append(points, point)\n   863→\t\treturn nil\n   864→\t})\n   865→\n   866→\tif err != nil && !errors.Is(err, errStopIteration) {\n   867→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   868→\t}\n   869→\n   870→\t// Get temporary checkpoints from ALL shadow branches whose base commit is reachable from HEAD.\n   871→\ttempPoints := getReachableTemporaryCheckpoints(repo, store, head.Hash(), isOnDefault, limit)\n   872→\tpoints = append(points, tempPoints...)\n   873→\n   874→\t// Sort by date, most recent first\n   875→\tsort.Slice(points, func(i, j int) bool {\n   876→\t\treturn points[i].Date.After(points[j].Date)\n   877→\t})\n   878→\n   879→\t// Apply limit\n   880→\tif len(points) > limit {\n   881→\t\tpoints = points[:limit]\n   882→\t}\n   883→\n   884→\treturn points, nil\n   885→}\n   886→\n   887→// getReachableTemporaryCheckpoints returns temporary checkpoints from shadow branches\n   888→// whose base commit is reachable from the given HEAD hash.\n   889→// For default branches, all shadow branches are included.\n   890→// For feature branches, only shadow branches whose base commit is in HEAD's history are included.\n   891→func getReachableTemporaryCheckpoints(repo *git.Repository, store *checkpoint.GitStore, headHash plumbing.Hash, isOnDefault bool, limit int) []strategy.RewindPoint {\n   892→\tvar points []strategy.RewindPoint\n   893→\n   894→\tshadowBranches, _ := store.ListTemporary(context.Background()) //nolint:errcheck // Best-effort\n   895→\tfor _, sb := range shadowBranches {\n   896→\t\t// Check if this shadow branch's base commit is reachable from current HEAD\n   897→\t\tif !isShadowBranchReachable(repo, sb.BaseCommit, headHash, isOnDefault) {\n   898→\t\t\tcontinue\n   899→\t\t}\n   900→\n   901→\t\t// List checkpoints from this shadow branch\n   902→\t\ttempCheckpoints, _ := store.ListCheckpointsForBranch(context.Background(), sb.BranchName, \"\", limit) //nolint:errcheck // Best-effort\n   903→\t\tfor _, tc := range tempCheckpoints {\n   904→\t\t\tpoint := convertTemporaryCheckpoint(repo, tc)\n   905→\t\t\tif point != nil {\n   906→\t\t\t\tpoints = append(points, *point)\n   907→\t\t\t}\n   908→\t\t}\n   909→\t}\n   910→\n   911→\treturn points\n   912→}\n   913→\n   914→// isShadowBranchReachable checks if a shadow branch's base commit is reachable from HEAD.\n   915→// For default branches, all shadow branches are considered reachable.\n   916→// For feature branches, we check if any commit with the base commit prefix is in HEAD's history.\n   917→func isShadowBranchReachable(repo *git.Repository, baseCommit string, headHash plumbing.Hash, isOnDefault bool) bool {\n   918→\t// For default branch: all shadow branches are potentially relevant\n   919→\tif isOnDefault {\n   920→\t\treturn true\n   921→\t}\n   922→\n   923→\t// Check if base commit hash prefix matches any commit in HEAD's history\n   924→\tbaseCommitIter, baseErr := repo.Log(&git.LogOptions{From: headHash})\n   925→\tif baseErr != nil {\n   926→\t\treturn false\n   927→\t}\n   928→\tdefer baseCommitIter.Close()\n   929→\n   930→\tbaseCount := 0\n   931→\tfound := false\n   932→\t_ = baseCommitIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   933→\t\tbaseCount++\n   934→\t\tif baseCount > commitScanLimit {\n   935→\t\t\treturn errStopIteration\n   936→\t\t}\n   937→\t\tif strings.HasPrefix(c.Hash.String(), baseCommit) {\n   938→\t\t\tfound = true\n   939→\t\t\treturn errStopIteration\n   940→\t\t}\n   941→\t\treturn nil\n   942→\t})\n   943→\n   944→\treturn found\n   945→}\n   946→\n   947→// convertTemporaryCheckpoint converts a TemporaryCheckpointInfo to a RewindPoint.\n   948→// Returns nil if the checkpoint should be skipped (no code changes or can't be read).\n   949→func convertTemporaryCheckpoint(repo *git.Repository, tc checkpoint.TemporaryCheckpointInfo) *strategy.RewindPoint {\n   950→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   951→\tif commitErr != nil {\n   952→\t\treturn nil\n   953→\t}\n   954→\n   955→\t// Filter out checkpoints with no code changes (only .entire/ metadata changed)\n   956→\t// This also filters out the first checkpoint which is just a baseline copy\n   957→\tif !hasCodeChanges(shadowCommit) {\n   958→\t\treturn nil\n   959→\t}\n   960→\n   961→\t// Read session prompt from the shadow branch commit's tree (not from entire/sessions)\n   962→\t// Temporary checkpoints store their metadata in the shadow branch, not in entire/sessions\n   963→\tvar sessionPrompt string\n   964→\tshadowTree, treeErr := shadowCommit.Tree()\n   965→\tif treeErr == nil {\n   966→\t\tsessionPrompt = strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   967→\t}\n   968→\n   969→\treturn &strategy.RewindPoint{\n   970→\t\tID:               tc.CommitHash.String(),\n   971→\t\tMessage:          tc.Message,\n   972→\t\tMetadataDir:      tc.MetadataDir,\n   973→\t\tDate:             tc.Timestamp,\n   974→\t\tIsTaskCheckpoint: tc.IsTaskCheckpoint,\n   975→\t\tToolUseID:        tc.ToolUseID,\n   976→\t\tSessionID:        tc.SessionID,\n   977→\t\tSessionPrompt:    sessionPrompt,\n   978→\t\tIsLogsOnly:       false, // Temporary checkpoints can be fully rewound\n   979→\t}\n   980→}\n   981→\n   982→// runExplainBranchDefault shows all checkpoints on the current branch grouped by date.\n   983→// This is strategy-agnostic - it queries checkpoints directly.\n   984→func runExplainBranchDefault(w io.Writer, noPager bool) error {\n   985→\trepo, err := openRepository()\n   986→\tif err != nil {\n   987→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   988→\t}\n   989→\n   990→\t// Get current branch name\n   991→\tbranchName := strategy.GetCurrentBranchName(repo)\n   992→\tif branchName == \"\" {\n   993→\t\t// Detached HEAD state or unborn HEAD - try to use short commit hash if possible\n   994→\t\thead, headErr := repo.Head()\n   995→\t\tif headErr != nil {\n   996→\t\t\t// Unborn HEAD (no commits yet) - treat as empty history instead of erroring\n   997→\t\t\tif errors.Is(headErr, plumbing.ErrReferenceNotFound) {\n   998→\t\t\t\tbranchName = \"HEAD (no commits yet)\"\n   999→\t\t\t} else {\n  1000→\t\t\t\treturn fmt.Errorf(\"failed to get HEAD: %w\", headErr)\n  1001→\t\t\t}\n  1002→\t\t} else {\n  1003→\t\t\tbranchName = \"HEAD (\" + head.Hash().String()[:7] + \")\"\n  1004→\t\t}\n  1005→\t}\n  1006→\n  1007→\t// Get checkpoints for this branch (strategy-agnostic)\n  1008→\tpoints, err := getBranchCheckpoints(repo, branchCheckpointsLimit)\n  1009→\tif err != nil {\n  1010→\t\t// Log the error but continue with empty list so user sees helpful message\n  1011→\t\tlogging.Warn(context.Background(), \"failed to get branch checkpoints\", \"error\", err)\n  1012→\t\tpoints = nil\n  1013→\t}\n  1014→\n  1015→\t// Format output\n  1016→\toutput := formatBranchCheckpoints(branchName, points)\n  1017→\n  1018→\toutputExplainContent(w, output, noPager)\n  1019→\treturn nil\n  1020→}\n  1021→\n  1022→// outputExplainContent outputs content with optional pager support.\n  1023→func outputExplainContent(w io.Writer, content string, noPager bool) {\n  1024→\tif noPager {\n  1025→\t\tfmt.Fprint(w, content)\n  1026→\t} else {\n  1027→\t\toutputWithPager(w, content)\n  1028→\t}\n  1029→}\n  1030→\n  1031→// runExplainSession explains a specific session.\n  1032→func runExplainSession(w io.Writer, sessionID string, noPager bool) error {\n  1033→\tstrat := GetStrategy()\n  1034→\n  1035→\t// Get session details\n  1036→\tsession, err := strategy.GetSession(sessionID)\n  1037→\tif err != nil {\n  1038→\t\tif errors.Is(err, strategy.ErrNoSession) {\n  1039→\t\t\treturn fmt.Errorf(\"session not found: %s\", sessionID)\n  1040→\t\t}\n  1041→\t\treturn fmt.Errorf(\"failed to get session: %w\", err)\n  1042→\t}\n  1043→\n  1044→\t// Get source ref (metadata branch + commit) for this session\n  1045→\tsourceRef := strat.GetSessionMetadataRef(session.ID)\n  1046→\n  1047→\t// Gather checkpoint details\n  1048→\tcheckpointDetails := gatherCheckpointDetails(strat, session)\n  1049→\n  1050→\t// For strategies like shadow where active sessions may not have checkpoints,\n  1051→\t// try to get the current session transcript directly\n  1052→\tif len(checkpointDetails) == 0 && len(session.Checkpoints) == 0 {\n  1053→\t\tcheckpointDetails = gatherCurrentSessionDetails(strat, session)\n  1054→\t}\n  1055→\n  1056→\t// Format output\n  1057→\toutput := formatSessionInfo(session, sourceRef, checkpointDetails)\n  1058→\n  1059→\t// Output with pager if appropriate\n  1060→\tif noPager {\n  1061→\t\tfmt.Fprint(w, output)\n  1062→\t} else {\n  1063→\t\toutputWithPager(w, output)\n  1064→\t}\n  1065→\n  1066→\treturn nil\n  1067→}\n  1068→\n  1069→// gatherCurrentSessionDetails attempts to get transcript info for sessions without checkpoints.\n  1070→// This handles strategies like shadow where active sessions may not have checkpoint commits.\n  1071→func gatherCurrentSessionDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n  1072→\t// Try to get transcript via GetSessionContext which reads from metadata branch\n  1073→\t// For shadow, we can read the transcript from the same location pattern\n  1074→\tcontextContent := strat.GetSessionContext(session.ID)\n  1075→\tif contextContent == \"\" {\n  1076→\t\treturn nil\n  1077→\t}\n  1078→\n  1079→\t// Parse the context.md to extract the last prompt/summary\n  1080→\t// Context.md typically has sections like \"# Prompt\\n...\\n## Summary\\n...\"\n  1081→\tdetail := checkpointDetail{\n  1082→\t\tIndex:     1,\n  1083→\t\tTimestamp: session.StartTime,\n  1084→\t\tMessage:   \"Current session\",\n  1085→\t}\n  1086→\n  1087→\t// Try to extract prompt and summary from context.md\n  1088→\tlines := strings.Split(contextContent, \"\\n\")\n  1089→\tvar inPrompt, inSummary bool\n  1090→\tvar promptLines, summaryLines []string\n  1091→\n  1092→\tfor _, line := range lines {\n  1093→\t\ttrimmed := strings.TrimSpace(line)\n  1094→\t\tif strings.HasPrefix(trimmed, \"# \") && strings.Contains(strings.ToLower(trimmed), \"prompt\") {\n  1095→\t\t\tinPrompt = true\n  1096→\t\t\tinSummary = false\n  1097→\t\t\tcontinue\n  1098→\t\t}\n  1099→\t\tif strings.HasPrefix(trimmed, \"## \") && strings.Contains(strings.ToLower(trimmed), \"summary\") {\n  1100→\t\t\tinPrompt = false\n  1101→\t\t\tinSummary = true\n  1102→\t\t\tcontinue\n  1103→\t\t}\n  1104→\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"# \") {\n  1105→\t\t\tinPrompt = false\n  1106→\t\t\tinSummary = false\n  1107→\t\t\tcontinue\n  1108→\t\t}\n  1109→\n  1110→\t\tif inPrompt {\n  1111→\t\t\tpromptLines = append(promptLines, line)\n  1112→\t\t} else if inSummary {\n  1113→\t\t\tsummaryLines = append(summaryLines, line)\n  1114→\t\t}\n  1115→\t}\n  1116→\n  1117→\tvar inter interaction\n  1118→\tif len(promptLines) > 0 {\n  1119→\t\tinter.Prompt = strings.TrimSpace(strings.Join(promptLines, \"\\n\"))\n  1120→\t}\n  1121→\tif len(summaryLines) > 0 {\n  1122→\t\tinter.Responses = []string{strings.TrimSpace(strings.Join(summaryLines, \"\\n\"))}\n  1123→\t}\n  1124→\n  1125→\t// If we couldn't parse structured content, show the raw context\n  1126→\tif inter.Prompt == \"\" && len(inter.Responses) == 0 {\n  1127→\t\tinter.Responses = []string{contextContent}\n  1128→\t}\n  1129→\n  1130→\tif inter.Prompt != \"\" || len(inter.Responses) > 0 {\n  1131→\t\tdetail.Interactions = []interaction{inter}\n  1132→\t}\n  1133→\n  1134→\treturn []checkpointDetail{detail}\n  1135→}\n  1136→\n  1137→// gatherCheckpointDetails extracts detailed information for each checkpoint.\n  1138→// Checkpoints come in newest-first order, but we number them oldest=1, newest=N.\n  1139→func gatherCheckpointDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n  1140→\tdetails := make([]checkpointDetail, 0, len(session.Checkpoints))\n  1141→\ttotal := len(session.Checkpoints)\n  1142→\n  1143→\tfor i, cp := range session.Checkpoints {\n  1144→\t\tdetail := checkpointDetail{\n  1145→\t\t\tIndex:            total - i, // Reverse numbering: oldest=1, newest=N\n  1146→\t\t\tTimestamp:        cp.Timestamp,\n  1147→\t\t\tIsTaskCheckpoint: cp.IsTaskCheckpoint,\n  1148→\t\t\tMessage:          cp.Message,\n  1149→\t\t}\n  1150→\n  1151→\t\t// Use checkpoint ID for display (truncate long IDs)\n  1152→\t\tdetail.ShortID = cp.CheckpointID.String()\n  1153→\t\tif len(detail.ShortID) > 12 {\n  1154→\t\t\tdetail.ShortID = detail.ShortID[:12]\n  1155→\t\t}\n  1156→\n  1157→\t\t// Try to get transcript for this checkpoint\n  1158→\t\ttranscriptContent, err := strat.GetCheckpointLog(cp)\n  1159→\t\tif err == nil {\n  1160→\t\t\ttranscript, parseErr := parseTranscriptFromBytes(transcriptContent)\n  1161→\t\t\tif parseErr == nil {\n  1162→\t\t\t\t// Extract all prompt/response pairs from the transcript\n  1163→\t\t\t\tpairs := ExtractAllPromptResponses(transcript)\n  1164→\t\t\t\tfor _, pair := range pairs {\n  1165→\t\t\t\t\tdetail.Interactions = append(detail.Interactions, interaction(pair))\n  1166→\t\t\t\t}\n  1167→\n  1168→\t\t\t\t// Aggregate all files for the checkpoint\n  1169→\t\t\t\tfileSet := make(map[string]bool)\n  1170→\t\t\t\tfor _, pair := range pairs {\n  1171→\t\t\t\t\tfor _, f := range pair.Files {\n  1172→\t\t\t\t\t\tif !fileSet[f] {\n  1173→\t\t\t\t\t\t\tfileSet[f] = true\n  1174→\t\t\t\t\t\t\tdetail.Files = append(detail.Files, f)\n  1175→\t\t\t\t\t\t}\n  1176→\t\t\t\t\t}\n  1177→\t\t\t\t}\n  1178→\t\t\t}\n  1179→\t\t}\n  1180→\n  1181→\t\tdetails = append(details, detail)\n  1182→\t}\n  1183→\n  1184→\treturn details\n  1185→}\n  1186→\n  1187→// runExplainCommit looks up the checkpoint associated with a commit.\n  1188→// Extracts the Entire-Checkpoint trailer and delegates to checkpoint detail view.\n  1189→// If no trailer found, shows a message indicating no associated checkpoint.\n  1190→func runExplainCommit(w io.Writer, commitRef string, noPager, verbose, full, searchAll bool) error {\n  1191→\trepo, err := openRepository()\n  1192→\tif err != nil {\n  1193→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1194→\t}\n  1195→\n  1196→\t// Resolve the commit reference\n  1197→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1198→\tif err != nil {\n  1199→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1200→\t}\n  1201→\n  1202→\tcommit, err := repo.CommitObject(*hash)\n  1203→\tif err != nil {\n  1204→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1205→\t}\n  1206→\n  1207→\t// Extract Entire-Checkpoint trailer\n  1208→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1209→\tif !hasCheckpoint {\n  1210→\t\tfmt.Fprintln(w, \"No associated Entire checkpoint\")\n  1211→\t\tfmt.Fprintf(w, \"\\nCommit %s does not have an Entire-Checkpoint trailer.\\n\", hash.String()[:7])\n  1212→\t\tfmt.Fprintln(w, \"This commit was not created during an Entire session, or the trailer was removed.\")\n  1213→\t\treturn nil\n  1214→\t}\n  1215→\n  1216→\t// Delegate to checkpoint detail view\n  1217→\t// Note: We pass a nil errW since runExplainCheckpoint only uses it for generate mode\n  1218→\treturn runExplainCheckpoint(w, nil, checkpointID.String(), noPager, verbose, full, false, false, false, searchAll)\n  1219→}\n  1220→\n  1221→// formatSessionInfo formats session information for display.\n  1222→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1223→\tvar sb strings.Builder\n  1224→\n  1225→\t// Session header\n  1226→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1227→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1228→\n  1229→\tif !session.StartTime.IsZero() {\n  1230→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1231→\t}\n  1232→\n  1233→\tif sourceRef != \"\" {\n  1234→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1235→\t}\n  1236→\n  1237→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1238→\n  1239→\t// Checkpoint details\n  1240→\tfor _, cp := range checkpoints {\n  1241→\t\tsb.WriteString(\"\\n\")\n  1242→\n  1243→\t\t// Checkpoint header\n  1244→\t\ttaskMarker := \"\"\n  1245→\t\tif cp.IsTaskCheckpoint {\n  1246→\t\t\ttaskMarker = \" [Task]\"\n  1247→\t\t}\n  1248→\t\tfmt.Fprintf(&sb, \"─── Checkpoint %d [%s] %s%s ───\\n\",\n  1249→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker)\n  1250→\t\tsb.WriteString(\"\\n\")\n  1251→\n  1252→\t\t// Display all interactions in this checkpoint\n  1253→\t\tfor i, inter := range cp.Interactions {\n  1254→\t\t\t// For multiple interactions, add a sub-header\n  1255→\t\t\tif len(cp.Interactions) > 1 {\n  1256→\t\t\t\tfmt.Fprintf(&sb, \"### Interaction %d\\n\\n\", i+1)\n  1257→\t\t\t}\n  1258→\n  1259→\t\t\t// Prompt section\n  1260→\t\t\tif inter.Prompt != \"\" {\n  1261→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n  1262→\t\t\t\tsb.WriteString(inter.Prompt)\n  1263→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1264→\t\t\t}\n  1265→\n  1266→\t\t\t// Response section\n  1267→\t\t\tif len(inter.Responses) > 0 {\n  1268→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n  1269→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n  1270→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1271→\t\t\t}\n  1272→\n  1273→\t\t\t// Files modified for this interaction\n  1274→\t\t\tif len(inter.Files) > 0 {\n  1275→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(inter.Files))\n  1276→\t\t\t\tfor _, file := range inter.Files {\n  1277→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1278→\t\t\t\t}\n  1279→\t\t\t\tsb.WriteString(\"\\n\")\n  1280→\t\t\t}\n  1281→\t\t}\n  1282→\n  1283→\t\t// If no interactions, show message and/or files\n  1284→\t\tif len(cp.Interactions) == 0 {\n  1285→\t\t\t// Show commit message as summary when no transcript available\n  1286→\t\t\tif cp.Message != \"\" {\n  1287→\t\t\t\tsb.WriteString(cp.Message)\n  1288→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1289→\t\t\t}\n  1290→\t\t\t// Show aggregate files if available\n  1291→\t\t\tif len(cp.Files) > 0 {\n  1292→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(cp.Files))\n  1293→\t\t\t\tfor _, file := range cp.Files {\n  1294→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1295→\t\t\t\t}\n  1296→\t\t\t}\n  1297→\t\t}\n  1298→\t}\n  1299→\n  1300→\treturn sb.String()\n  1301→}\n  1302→\n  1303→// outputWithPager outputs content through a pager if stdout is a terminal and content is long.\n  1304→func outputWithPager(w io.Writer, content string) {\n  1305→\t// Check if we're writing to stdout and it's a terminal\n  1306→\tif f, ok := w.(*os.File); ok && f == os.Stdout && term.IsTerminal(int(f.Fd())) {\n  1307→\t\t// Get terminal height\n  1308→\t\t_, height, err := term.GetSize(int(f.Fd()))\n  1309→\t\tif err != nil {\n  1310→\t\t\theight = 24 // Default fallback\n  1311→\t\t}\n  1312→\n  1313→\t\t// Count lines in content\n  1314→\t\tlineCount := strings.Count(content, \"\\n\")\n  1315→\n  1316→\t\t// Use pager if content exceeds terminal height\n  1317→\t\tif lineCount > height-2 {\n  1318→\t\t\tpager := os.Getenv(\"PAGER\")\n  1319→\t\t\tif pager == \"\" {\n  1320→\t\t\t\tpager = \"less\"\n  1321→\t\t\t}\n  1322→\n  1323→\t\t\tcmd := exec.CommandContext(context.Background(), pager) //nolint:gosec // pager from env is expected\n  1324→\t\t\tcmd.Stdin = strings.NewReader(content)\n  1325→\t\t\tcmd.Stdout = f\n  1326→\t\t\tcmd.Stderr = os.Stderr\n  1327→\n  1328→\t\t\tif err := cmd.Run(); err != nil {\n  1329→\t\t\t\t// Fallback to direct output if pager fails\n  1330→\t\t\t\tfmt.Fprint(w, content)\n  1331→\t\t\t}\n  1332→\t\t\treturn\n  1333→\t\t}\n  1334→\t}\n  1335→\n  1336→\t// Direct output for non-terminal or short content\n  1337→\tfmt.Fprint(w, content)\n  1338→}\n  1339→\n  1340→// Constants for formatting output\n  1341→const (\n  1342→\t// maxIntentDisplayLength is the maximum length for intent text before truncation\n  1343→\tmaxIntentDisplayLength = 80\n  1344→\t// maxMessageDisplayLength is the maximum length for checkpoint messages before truncation\n  1345→\tmaxMessageDisplayLength = 80\n  1346→\t// maxPromptDisplayLength is the maximum length for session prompts before truncation\n  1347→\tmaxPromptDisplayLength = 60\n  1348→\t// checkpointIDDisplayLength is the number of characters to show from checkpoint IDs\n  1349→\tcheckpointIDDisplayLength = 12\n  1350→)\n  1351→\n  1352→// formatBranchCheckpoints formats checkpoint information for a branch.\n  1353→// Groups commits by checkpoint ID and shows the prompt for each checkpoint.\n  1354→func formatBranchCheckpoints(branchName string, points []strategy.RewindPoint) string {\n  1355→\tvar sb strings.Builder\n  1356→\n  1357→\t// Branch header\n  1358→\tfmt.Fprintf(&sb, \"Branch: %s\\n\", branchName)\n  1359→\n  1360→\tif len(points) == 0 {\n  1361→\t\tsb.WriteString(\"Checkpoints: 0\\n\")\n  1362→\t\tsb.WriteString(\"\\nNo checkpoints found on this branch.\\n\")\n  1363→\t\tsb.WriteString(\"Checkpoints will appear here after you save changes during a Claude session.\\n\")\n  1364→\t\treturn sb.String()\n  1365→\t}\n  1366→\n  1367→\t// Group by checkpoint ID\n  1368→\tgroups := groupByCheckpointID(points)\n  1369→\n  1370→\tfmt.Fprintf(&sb, \"Checkpo