→\tif entry, exists := entries[metadataPath]; exists {\n   219→\t\t// Read existing metadata to get session count\n   220→\t\texisting, err := s.readMetadataFromBlob(entry.Hash)\n   221→\t\tif err == nil {\n   222→\t\t\texistingMetadata = existing\n   223→\t\t\t// Archive existing session files to numbered subfolder\n   224→\t\t\ts.archiveExistingSession(basePath, existingMetadata, entries)\n   225→\t\t}\n   226→\t}\n   227→\n   228→\t// Write transcript (from in-memory content or file path)\n   229→\tif err := s.writeTranscript(opts, basePath, entries); err != nil {\n   230→\t\treturn err\n   231→\t}\n   232→\n   233→\t// Write prompts\n   234→\tif len(opts.Prompts) > 0 {\n   235→\t\tpromptContent := strings.Join(opts.Prompts, \"\\n\\n---\\n\\n\")\n   236→\t\tblobHash, err := CreateBlobFromContent(s.repo, []byte(promptContent))\n   237→\t\tif err != nil {\n   238→\t\t\treturn err\n   239→\t\t}\n   240→\t\tentries[basePath+paths.PromptFileName] = object.TreeEntry{\n   241→\t\t\tName: basePath + paths.PromptFileName,\n   242→\t\t\tMode: filemode.Regular,\n   243→\t\t\tHash: blobHash,\n   244→\t\t}\n   245→\t}\n   246→\n   247→\t// Write context\n   248→\tif len(opts.Context) > 0 {\n   249→\t\tblobHash, err := CreateBlobFromContent(s.repo, opts.Context)\n   250→\t\tif err != nil {\n   251→\t\t\treturn err\n   252→\t\t}\n   253→\t\tentries[basePath+paths.ContextFileName] = object.TreeEntry{\n   254→\t\t\tName: basePath + paths.ContextFileName,\n   255→\t\t\tMode: filemode.Regular,\n   256→\t\t\tHash: blobHash,\n   257→\t\t}\n   258→\t}\n   259→\n   260→\t// Copy additional metadata files from directory if specified\n   261→\tif opts.MetadataDir != \"\" {\n   262→\t\tif err := s.copyMetadataDir(opts.MetadataDir, basePath, entries); err != nil {\n   263→\t\t\treturn fmt.Errorf(\"failed to copy metadata directory: %w\", err)\n   264→\t\t}\n   265→\t}\n   266→\n   267→\t// Write metadata.json (with merged info if existing metadata present)\n   268→\treturn s.writeMetadataJ