est@test.com\"},\n   377→\t})\n   378→\tif err != nil {\n   379→\t\tt.Fatalf(\"failed to commit: %v\", err)\n   380→\t}\n   381→\n   382→\t// Change to temp dir so paths.RepoRoot() works correctly\n   383→\tt.Chdir(tempDir)\n   384→\n   385→\t// Create a test file that will be included in checkpoints\n   386→\ttestFile := filepath.Join(tempDir, \"test.go\")\n   387→\tif err := os.WriteFile(testFile, []byte(\"package main\\n\"), 0o644); err != nil {\n   388→\t\tt.Fatalf(\"failed to write test file: %v\", err)\n   389→\t}\n   390→\n   391→\t// Create metadata directory\n   392→\tmetadataDir := filepath.Join(tempDir, \".entire\", \"metadata\", \"test-session\")\n   393→\tif err := os.MkdirAll(metadataDir, 0o755); err != nil {\n   394→\t\tt.Fatalf(\"failed to create metadata dir: %v\", err)\n   395→\t}\n   396→\tif err := os.WriteFile(filepath.Join(metadataDir, \"full.jsonl\"), []byte(`{\"test\": true}`), 0o644); err != nil {\n   397→\t\tt.Fatalf(\"failed to write transcript: %v\", err)\n   398→\t}\n   399→\n   400→\t// Create checkpoint store\n   401→\tstore := NewGitStore(repo)\n   402→\n   403→\t// First checkpoint should be created\n   404→\tbaseCommit := initialCommit.String()\n   405→\tresult1, err := store.WriteTemporary(context.Background(), WriteTemporaryOptions{\n   406→\t\tSessionID:         \"test-session\",\n   407→\t\tBaseCommit:        baseCommit,\n   408→\t\tModifiedFiles:     []string{\"test.go\"},\n   409→\t\tMetadataDir:       \".entire/metadata/test-session\",\n   410→\t\tMetadataDirAbs:    metadataDir,\n   411→\t\tCommitMessage:     \"Checkpoint 1\",\n   412→\t\tAuthorName:        \"Test\",\n   413→\t\tAuthorEmail:       \"test@test.com\",\n   414→\t\tIsFirstCheckpoint: true,\n   415→\t})\n   416→\tif err != nil {\n   417→\t\tt.Fatalf(\"WriteTemporary() first call error = %v\", err)\n   418→\t}\n   419→\tif result1.Skipped {\n   420→\t\tt.Error(\"first checkpoint should not be skipped\")\n   421→\t}\n   422→\tif result1.CommitHash == plumbing.ZeroHash {\n   423→\t\tt.Error(\"first checkpoint should have a commit hash\")\n   424→\t}\n   425→\n   426→\t// Second checkpoint with identical content should be skipped\n   427→\tresult2, err := store.WriteTemporary(context.Background(), WriteTemporaryOptions{\n   428→\t\tSessionID:         \"test-session\",\n   429→\t\tBaseCommit:        baseCommit,\n   430→\t\tModifiedFiles:     []string{\"test.go\"},\n   431→\t\tMetadataDir:       \".entire/metadata/test-session\",\n   432→\t\tMetadataDirAbs:    metadataDir,\n   433→\t\tCommitMessage:     \"Checkpoint 2\",\n   434→\t\tAuthorName:        \"Test\",\n   435→\t\tAuthorEmail:       \"test@test.com\",\n   436→\t\tIsFirstCheckpoint: false,\n   437→\t})\n   438→\tif err != nil {\n   439→\t\tt.Fatalf(\"WriteTemporary() second call error = %v\", err)\n   440→\t}\n   441→\tif !result2.Skipped {\n   442→\t\tt.Error(\"second checkpoint with identical content should be skipped\")\n   443→\t}\n   444→\tif result2.CommitHash != result1.CommitHash {\n   445→\t\tt.Errorf(\"skipped checkpoint should return previous commit hash, got %s, want %s\",\n   446→\t\t\tresult2.CommitHash, result1.CommitHash)\n   447→\t}\n   448→\n   449→\t// Modify the file and create another checkpoint - should NOT be skipped\n   450→\tif err := os.WriteFile(testFile, []byte(\"package main\\n\\nfunc main() {}\\n\"), 0o644); err != nil {\n   451→\t\tt.Fatalf(\"failed to modify test file: %v\", err)\n   452→\t}\n   453→\n   454→\tresult3, err := store.WriteTemporary(context.Background(), WriteTemporaryOptions{\n   455→\t\tSessionID:         \"test-session\",\n   456→\t\tBaseCommit:        baseCommit,\n   457→\t\tModifiedFiles:     []string{\"test.go\"},\n   458→\t\tMetadataDir:       \".entire/metadata/test-session\",\n   459→\t\tMetadataDirAbs:    metadataDir,\n   460→\t\tCommitMessage:     \"Checkpoint 3\",\n   461→\t\tAuthorName:        \"Test\",\n   462→\t\tAuthorEmail:       \"test@test.com\",\n   463→\t\tIsFirstCheckpoint: false,\n   464→\t})\n   465→\tif err != nil {\n   466→\t\tt.Fatalf(\"WriteTemporary() third call error = %v\", err)\n   467→\t}\n   468→\tif result3.Skipped {\n   469→\t\tt.Error(\"third checkpoint with modified content should NOT be skipped\")\n   470→\t}\n   471→\tif result3.CommitHash == result1.CommitHash {\n   472→\t\tt.Error(\"third checkpoint should have a different commit hash than first\")\n   473→\t}\n   474→}\n   475→\n   476→// setupBranchTestRepo creates a test repository with an initial commit.\n   477→func setupBranchTestRepo(t *testing.T) (*git.Repository, plumbing.Hash) {\n   478→\tt.Helper()\n   479→\ttempDir := t.TempDir()\n   480→\n   481→\trepo, err := git.PlainInit(tempDir, false)\n   482→\tif err != nil {\n   483→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   484→\t}\n   485→\n   486→\tworktree, err := repo.Worktree()\n   487→\tif err != nil {\n   488→\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   489→\t}\n   490→\n   491→\treadmeFile := filepath.Join(tempDir, \"README.md\")\n   492→\tif err := os.WriteFile(readmeFile, []byte(\"# Test\"), 0o644); err != nil {\n   493→\t\tt.Fatalf(\"failed to write README: %v\", err)\n   494→\t}\n   495→\tif _, err := worktree.Add(\"README.md\"); err != nil {\n   496→\t\tt.Fatalf(\"failed to add README: %v\", err)\n   497→\t}\n   498→\tcommitHash, err := worktree.Commit(\"Initial commit\", &git.CommitOptions{\n   499→\t\tAuthor: &object.Signature{Name: \"Test\", Email: \"test@test.com\"},\n   500→\t})\n   501→\tif err != nil {\n   502→\t\tt.Fatalf(\"failed to commit: %v\", err)\n   503→\t}\n   504→\n   505→\treturn repo, commitHash\n   506→}\n   507→\n   508→// verifyBranchInMetadata reads and verifies the branch field in metadata.json.\n   509→func verifyBranchInMetadata(t *testing.T, repo *git.Repository, checkpointID id.CheckpointID, expectedBranch string, shouldOmit bool) {\n   510→\tt.Helper()\n   511→\n   512→\tmetadataRef, err := repo.Reference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), true)\n   513→\tif err != nil {\n   514→\t\tt.Fatalf(\"failed to get metadata branch reference: %v\", err)\n   515→\t}\n   516→\n   517→\tcommit, err := repo.CommitObject(metadataRef.Hash())\n   518→\tif err != nil {\n   519→\t\tt.Fatalf(\"failed to get commit object: %v\", err)\n   520→\t}\n   521→\n   522→\ttree, err := commit.Tree()\n   523→\tif err != nil {\n   524→\t\tt.Fatalf(\"failed to get tree: %v\", err)\n   525→\t}\n   526→\n   527→\tshardedPath := checkpointID.Path()\n   528→\tmetadataPath := shardedPath + \"/\" + paths.MetadataFileName\n   529→\tmetadataFile, err := tree.File(metadataPath)\n   530→\tif err != nil {\n   531→\t\tt.Fatalf(\"failed to find metadata.json at %s: %v\", metadataPath, err)\n   532→\t}\n   533→\n   534→\tcontent, err := metadataFile.Contents()\n   535→\tif err != nil {\n   536→\t\tt.Fatalf(\"failed to read metadata.json: %v\", err)\n   537→\t}\n   538→\n   539→\tvar metadata CommittedMetadata\n   540→\tif err := json.Unmarshal([]byte(content), &metadata); err != nil {\n   541→\t\tt.Fatalf(\"failed to parse metadata.json: %v\", err)\n   542→\t}\n   543→\n   544→\tif metadata.Branch != expectedBranch {\n   545→\t\tt.Errorf(\"metadata.Branch = %q, want %q\", metadata.Branch, expectedBranch)\n   546→\t}\n   547→\n   548→\tif shouldOmit && strings.Contains(content, `\"branch\"`) {\n   549→\t\tt.Errorf(\"metadata.json should not contain 'branch' field when empty (omitempty), got:\\n%s\", content)\n   550→\t}\n   551→}\n   552→\n   553→// TestArchiveExistingSession_ChunkedTranscript verifies that when archiving\n   554→// a session with chunked transcripts, all chunk files are moved to the archive folder.\n   555→func TestArchiveExistingSession_ChunkedTranscript(t *testing.T) {\n   556→\trepo, _ := setupBranchTestRepo(t)\n   557→\tstore := NewGitStore(repo)\n   558→\n   559→\tbasePath := \"a1/b2c3d4e5f6/\"\n   560→\n   561→\t// Simulate existing checkpoint with chunked transcript\n   562→\t// Chunk 0 is the base file (full.jsonl), chunks 1+ have suffixes (.001, .002)\n   563→\tentries := map[string]object.TreeEntry{\n   564→\t\tbasePath + paths.MetadataFileName:            {Name: basePath + paths.MetadataFileName, Hash: plumbing.NewHash(\"aaa\")},\n   565→\t\tbasePath + paths.TranscriptFileName:          {Name: basePath + paths.TranscriptFileName, Hash: plumbing.NewHash(\"bbb\")},          // chunk 0\n   566→\t\tbasePath + paths.TranscriptFileName + \".001\": {Name: basePath + paths.TranscriptFileName + \".001\", Hash: plumbing.NewHash(\"ccc\")}, // chunk 1\n   567→\t\tbasePath + paths.TranscriptFileName + \".002\": {Name: basePath + paths.TranscriptFileName + \".002\", Hash: plumbing.NewHash(\"ddd\")}, // chunk 2\n   568→\t\tbasePath + paths.PromptFileName:              {Name: basePath + paths.PromptFileName, Hash: plumbing.NewHash(\"eee\")},\n   569→\t\tbasePath + paths.ContextFileName:             {Name: basePath + paths.ContextFileName, Hash: plumbing.NewHash(\"fff\")},\n   570→\t\tbasePath + paths.ContentHashFileName:         {Name: basePath + paths.ContentHashFileName, Hash: plumbing.NewHash(\"ggg\")},\n   571→\t}\n   572→\n   573→\texistingMetadata := &CommittedMetadata{\n   574→\t\tSessionCount: 1,\n   575→\t}\n   576→\n   577→\t// Archive the existing session\n   578→\tstore.archiveExistingSession(basePath, existingMetadata, entries)\n   579→\n   580→\tarchivePath := basePath + \"1/\"\n   581→\n   582→\t// Verify standard files were archived\n   583→\tif _, ok := entries[archivePath+paths.MetadataFileName]; !ok {\n   584→\t\tt.Error(\"metadata.json should be archived to 1/\")\n   585→\t}\n   586→\tif _, ok := entries[archivePath+paths.TranscriptFileName]; !ok {\n   587→\t\tt.Error(\"full.jsonl (chunk 0) should be archived to 1/\")\n   588→\t}\n   589→\tif _, ok := entries[archivePath+paths.PromptFileName]; !ok {\n   590→\t\tt.Error(\"prompt.txt should be archived to 1/\")\n   591→\t}\n   592→\n   593→\t// Verify chunk files were archived\n   594→\tif _, ok := entries[archivePath+paths.TranscriptFileName+\".001\"]; !ok {\n   595→\t\tt.Error(\"full.jsonl.001 (chunk 1) should be archived to 1/\")\n   596→\t}\n   597→\tif _, ok := entries[archivePath+paths.TranscriptFileName+\".002\"]; !ok {\n   598→\t\tt.Error(\"full.jsonl.002 (chunk 2) should be archived to 1/\")\n   599→\t}\n   600→\n   601→\t// Verify original locations are cleared\n   602→\tif _, ok := entries[basePath+paths.TranscriptFileName]; ok {\n   603→\t\tt.Error(\"original full.jsonl should be removed from base path\")\n   604→\t}\n   605→\tif _, ok := entries[basePath+paths.TranscriptFileName+\".001\"]; ok {\n   606→\t\tt.Error(\"original full.jsonl.001 should be removed from base path\")\n   607→\t}\n   608→\tif _, ok := entries[basePath+paths.TranscriptFileName+\".002\"]; ok {\n   609→\t\tt.Error(\"original full.jsonl.002 should be removed from base path\")\n   610→\t}\n   611→}\n   612→\n   613→// TestWriteCommitted_BranchField verifies that the Branch field is correctly\n   614→// captured in metadata.json when on a branch, and is empty when in detached HEAD.\n   615→func TestWriteCommitted_BranchField(t *testing.T) {\n   616→\tt.Run(\"on branch\", func(t *testing.T) {\n   617→\t\trepo, commitHash := setupBranchTestRepo(t)\n   618→\n   619→\t\t// Create a feature branch and switch to it\n   620→\t\tbranchName := \"feature/test-branch\"\n   621→\t\tbranchRef := plumbing.NewBranchReferenceName(branchName)\n   622→\t\tref := plumbing.NewHashReference(branchRef, commitHash)\n   623→\t\tif err := repo.Storer.SetReference(ref); err != nil {\n   624→\t\t\tt.Fatalf(\"failed to create branch: %v\", err)\n   625→\t\t}\n   626→\n   627→\t\tworktree, err := repo.Worktree()\n   628→\t\tif err != nil {\n   629→\t\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   630→\t\t}\n   631→\t\tif err := worktree.Checkout(&git.CheckoutOptions{Branch: branchRef}); err != nil {\n   632→\t\t\tt.Fatalf(\"failed to checkout branch: %v\", err)\n   633→\t\t}\n   634→\n   635→\t\t// Get current branch name\n   636→\t\tvar currentBranch string\n   637→\t\thead, err := repo.Head()\n   638→\t\tif err == nil && head.Name().IsBranch() {\n   639→\t\t\tcurrentBranch = head.Name().Short()\n   640→\t\t}\n   641→\n   642→\t\t// Write a committed checkpoint with branch information\n   643→\t\tcheckpointID := id.MustCheckpointID(\"a1b2c3d4e5f6\")\n   644→\t\tstore := NewGitStore(repo)\n   645→\t\terr = store.WriteCommitted(context.Background(), WriteCommittedOptions{\n   646→\t\t\tCheckpointID: checkpointID,\n   647→\t\t\tSessionID:    \"test-session-123\",\n   648→\t\t\tStrategy:     \"manual-commit\",\n   649→\t\t\tBranch:       currentBranch,\n   650→\t\t\tTranscript:   []byte(\"test transcript content\"),\n   651→\t\t\tAuthorName:   \"Test Author\",\n   652→\t\t\tAuthorEmail:  \"test@example.com\",\n   653→\t\t})\n   654→\t\tif err != nil {\n   655→\t\t\tt.Fatalf(\"WriteCommitted() error = %v\", err)\n   656→\t\t}\n   657→\n   658→\t\tverifyBranchInMetadata(t, repo, checkpointID, branchName, false)\n   659→\t})\n   660→\n   661→\tt.Run(\"detached HEAD\", func(t *testing.T) {\n   662→\t\trepo, commitHash := setupBranchTestRepo(t)\n   663→\n   664→\t\t// Checkout the commit directly (detached HEAD)\n   665→\t\tworktree, err := repo.Worktree()\n   666→\t\tif err != nil {\n   667→\t\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   668→\t\t}\n   669→\t\tif err := worktree.Checkout(&git.CheckoutOptions{Hash: commitHash}); err != nil {\n   670→\t\t\tt.Fatalf(\"failed to checkout commit: %v\", err)\n   671→\t\t}\n   672→\n   673→\t\t// Verify we're in detached HEAD\n   674→\t\thead, err := repo.Head()\n   675→\t\tif err != nil {\n   676→\t\t\tt.Fatalf(\"failed to get HEAD: %v\", err)\n   677→\t\t}\n   678→\t\tif head.Name().IsBranch() {\n   679→\t\t\tt.Fatalf(\"expected detached HEAD, but on branch %s\", head.Name().Short())\n   680→\t\t}\n   681→\n   682→\t\t// Write a committed checkpoint (branch should be empty in detached HEAD)\n   683→\t\tcheckpointID := id.MustCheckpointID(\"b2c3d4e5f6a7\")\n   684→\t\tstore := NewGitStore(repo)\n   685→\t\terr = store.WriteCommitted(context.Background(), WriteCommittedOptions{\n   686→\t\t\tCheckpointID: checkpointID,\n   687→\t\t\tSessionID:    \"test-session-456\",\n   688→\t\t\tStrategy:     \"manual-commit\",\n   689→\t\t\tBranch:       \"\", // Empty when in detached HEAD\n   690→\t\t\tTranscript:   []byte(\"test transcript content\"),\n   691→\t\t\tAuthorName:   \"Test Author\",\n   692→\t\t\tAuthorEmail:  \"test@example.com\",\n   693→\t\t})\n   694→\t\tif err != nil {\n   695→\t\t\tt.Fatalf(\"WriteCommitted() error = %v\", err)\n   696→\t\t}\n   697→\n   698→\t\tverifyBranchInMetadata(t, repo, checkpointID, \"\", true)\n   699→\t})\n   700→}\n   701→\n   702→// TestUpdateSummary verifies that UpdateSummary correctly updates the summary\n   703→// field in an existing checkpoint's metadata.\n   704→func TestUpdateSummary(t *testing.T) {\n   705→\trepo, _ := setupBranchTestRepo(t)\n   706→\tstore := NewGitStore(repo)\n   707→\tcheckpointID := id.MustCheckpointID(\"f1e2d3c4b5a6\")\n   708→\n   709→\t// First, create a checkpoint without a summary\n   710→\terr := store.WriteCommitted(context.Background(), WriteCommittedOptions{\n   711→\t\tCheckpointID: checkpointID,\n   712→\t\tSessionID:    \"test-session-summary\",\n   713→\t\tStrategy:     \"manual-commit\",\n   714→\t\tTranscript:   []byte(\"test transcript content\"),\n   715→\t\tFilesTouched: []string{\"file1.go\", \"file2.go\"},\n   716→\t\tAuthorName:   \"Test Author\",\n   717→\t\tAuthorEmail:  \"test@example.com\",\n   718→\t})\n   719→\tif err != nil {\n   720→\t\tt.Fatalf(\"WriteCommitted() error = %v\", err)\n   721→\t}\n   722→\n   723→\t// Verify no summary initially\n   724→\tmetadata := readCheckpointMetadata(t, repo, checkpointID)\n   725→\tif metadata.Summary != nil {\n   726→\t\tt.Error(\"initial checkpoint should not have a summary\")\n   727→\t}\n   728→\n   729→\t// Update with a summary\n   730→\tsummary := &Summary{\n   731→\t\tIntent:  \"Test intent\",\n   732→\t\tOutcome: \"Test outcome\",\n   733→\t\tLearnings: LearningsSummary{\n   734→\t\t\tRepo:     []string{\"Repo learning 1\"},\n   735→\t\t\tCode:     []CodeLearning{{Path: \"file1.go\", Line: 10, Finding: \"Code finding\"}},\n   736→\t\t\tWorkflow: []string{\"Workflow learning\"},\n   737→\t\t},\n   738→\t\tFriction:  []string{\"Some friction\"},\n   739→\t\tOpenItems: []string{\"Open item 1\"},\n   740→\t}\n   741→\n   742→\terr = store.UpdateSummary(context.Background(), checkpointID, summary)\n   743→\tif err != nil {\n   744→\t\tt.Fatalf(\"UpdateSummary() error = %v\", err)\n   745→\t}\n   746→\n   747→\t// Verify summary was saved\n   748→\tupdatedMetadata := readCheckpointMetadata(t, repo, checkpointID)\n   749→\tif updatedMetadata.Summary == nil {\n   750→\t\tt.Fatal(\"updated checkpoint should have a summary\")\n   751→\t}\n   752→\tif updatedMetadata.Summary.Intent != \"Test intent\" {\n   753→\t\tt.Errorf(\"summary.Intent = %q, want %q\", updatedMetadata.Summary.Intent, \"Test intent\")\n   754→\t}\n   755→\tif updatedMetadata.Summary.Outcome != \"Test outcome\" {\n   756→\t\tt.Errorf(\"summary.Outcome = %q, want %q\", updatedMetadata.Summary.Outcome, \"Test outcome\")\n   757→\t}\n   758→\tif len(updatedMetadata.Summary.Learnings.Repo) != 1 {\n   759→\t\tt.Errorf(\"summary.Learnings.Repo length = %d, want 1\", len(updatedMetadata.Summary.Learnings.Repo))\n   760→\t}\n   761→\tif len(updatedMetadata.Summary.Friction) != 1 {\n   762→\t\tt.Errorf(\"summary.Friction length = %d, want 1\", len(updatedMetadata.Summary.Friction))\n   763→\t}\n   764→\n   765→\t// Verify other metadata fields are preserved\n   766→\tif updatedMetadata.SessionID != \"test-session-summary\" {\n   767→\t\tt.Errorf(\"metadata.SessionID = %q, want %q\", updatedMetadata.SessionID, \"test-session-summary\")\n   768→\t}\n   769→\tif len(updatedMetadata.FilesTouched) != 2 {\n   770→\t\tt.Errorf(\"metadata.FilesTouched length = %d, want 2\", len(updatedMetadata.FilesTouch