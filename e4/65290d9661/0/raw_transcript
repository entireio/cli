3→\t\treturn fmt.Errorf(\"failed to marshal metadata: %w\", err)\n   394→\t}\n   395→\tmetadataHash, err := CreateBlobFromContent(s.repo, metadataJSON)\n   396→\tif err != nil {\n   397→\t\treturn err\n   398→\t}\n   399→\tentries[basePath+paths.MetadataFileName] = object.TreeEntry{\n   400→\t\tName: basePath + paths.MetadataFileName,\n   401→\t\tMode: filemode.Regular,\n   402→\t\tHash: metadataHash,\n   403→\t}\n   404→\treturn nil\n   405→}\n   406→\n   407→// mergeFilesTouched combines two file lists, removing duplicates.\n   408→func mergeFilesTouched(existing, additional []string) []string {\n   409→\tseen := make(map[string]bool)\n   410→\tvar result []string\n   411→\n   412→\tfor _, f := range existing {\n   413→\t\tif !seen[f] {\n   414→\t\t\tseen[f] = true\n   415→\t\t\tresult = append(result, f)\n   416→\t\t}\n   417→\t}\n   418→\tfor _, f := range additional {\n   419→\t\tif !seen[f] {\n   420→\t\t\tseen[f] = true\n   421→\t\t\tresult = append(result, f)\n   422→\t\t}\n   423→\t}\n   424→\n   425→\tsort.Strings(result)\n   426→\treturn result\n   427→}\n   428→\n   429→// mergeAgents combines existing agents with a new agent, removing duplicates.\n   430→// Preserves order (existing agents first, then new agent if not already present).\n   431→func mergeAgents(existing []agent.AgentType, newAgent agent.AgentType) []agent.AgentType {\n   432→\tif newAgent == \"\" {\n   433→\t\treturn existing\n   434→\t}\n   435→\n   436→\tseen := make(map[agent.AgentType]bool)\n   437→\tvar result []agent.AgentType\n   438→\n   439→\tfor _, a := range existing {\n   440→\t\tif !seen[a] {\n   441→\t\t\tseen[a] = true\n   442→\t\t\tresult = append(result, a)\n   443→\t\t}\n   444→\t}\n   445→\n   446→\tif !seen[newAgent] {\n   447→\t\tresult = append(result, newAgent)\n   448→\t}\n   449→\n   450→\treturn result\n   451→}\n   452→\n   453→// readMetadataFromBlob reads CommittedMetadata from a blob hash.\n   454→func (s *GitStore) readMetadataFromBlob(hash plumbing.Hash) (*CommittedMetadata, error) {\n   455→\tblob, err := s.repo.BlobObject(hash)\n   456→\tif err != nil {\n   457→\t\treturn nil, fmt.Errorf(\"failed to get blob: %w\", err)\n   458→\t}\n   459→\n   460→\treader, err := blob.Reader()\n   461→\tif err != nil {\n   462→\t\treturn nil, fmt.Errorf(\"failed to get blob reader: %w\", err)\n   463→\t}\n   464→\tdefer reader.Close()\n   465→\n   466→\tvar metadata CommittedMetadata\n   467→\tif err := json.NewDecoder(reader).Decode(&metadata); err != nil {\n   468→\t\treturn nil, fmt.Errorf(\"failed to decode metadata: %w\", err)\n   469→\t}\n   470→\n   471→\treturn &metadata, nil\n   472→}\n   473→\n   474→// archiveExistingSession moves existing session files to a numbered subfolder.\n   475→// The subfolder number is based on the current session count (so first archived session goes to \"1/\").\n   476→func (s *GitStore) archiveExistingSession(basePath string, existingMetadata *CommittedMetadata, entries map[string]object.TreeEntry) {\n   477→\t// Determine archive folder number\n   478→\tsessionCount := existingMetadata.SessionCount\n   479→\tif sessionCount == 0 {\n   480→\t\tsessionCount = 1 // backwards compat\n   481→\t}\n   482→\tarchivePath := fmt.Sprintf(\"%s%d/\", basePath, sessionCount)\n   483→\n   484→\t// Files to archive (standard checkpoint files at basePath, excluding tasks/ subfolder)\n   485→\tfilesToArchive := []string{\n   486→\t\tpaths.MetadataFileName,\n   487→\t\tpaths.TranscriptFileName,\n   488→\t\tpaths.PromptFileName,\n   489→\t\tpaths.ContextFileName,\n   490→\t\tpaths.ContentHashFileName,\n   491→\t}\n   492→\n   493→\t// Also include transcript chunk files (full.jsonl.001, full.jsonl.002, etc.)\n   494→\tchunkPrefix := basePath + paths.TranscriptFileName + \".\"\n   495→\tfor srcPath := range entries {\n   496→\t\tif strings.HasPrefix(srcPath, chunkPrefix) {\n   497→\t\t\tchunkSuffix := strings.TrimPrefix(srcPath, basePath+paths.TranscriptFileName)\n   498→\t\t\tif idx := agent.ParseChunkIndex(paths.TranscriptFileName+chunkSuffix, paths.TranscriptFileName); idx > 0 {\n   499→\t\t\t\tfilesToArchive = append(filesToArchive, paths.TranscriptFileName+chunkSuffix)\n   500→\t\t\t}\n   501→\t\t}\n   502→\t}\n   503→\n   504→\t// Move each file to archive folder\n   505→\tfor _, filename := range filesToArchive {\n   506→\t\tsrcPath := basePath + filename\n   507→\t\tif entry, exists := entries[srcPath]; exists {\n   508→\t\t\t// Add to archive location\n   509→\t\t\tdstPath := archivePath + filename\n   510→\t\t\tentries[dstPath] = object.TreeEntry{\n   511→\t\t\t\tName: dstPath,\n   512→\t\t\t\tMode: entry.Mode,\n   513→\t\t\t\tHash: entry.Hash,\n   514→\t\t\t}\n   515→\t\t\t// Remove from original location (will be overwritten by new session)\n   516→\t\t\tdelete(entries, srcPath)\n   517→\t\t}\n   518→\t}\n   519→}\n   520→\n   521→// readArchivedSessions reads transcript data from archived session subfolders (1/, 2/, etc.).\n   522→// Returns sessions ordered by folder index (oldest first).\n   523→func (s *GitStore) readArchivedSessions(checkpointTree *object.Tree, sessionCount int, agentType agent.AgentType) []ArchivedSession {\n   524→\tvar archived []ArchivedSession\n   525→\n   526→\t// Archived sessions are in numbered folders: 1/, 2/, etc.\n   527→\t// The most recent session is at the root level (not archived).\n   528→\t// Session count N means there are N-1 archived sessions.\n   529→\tfor i := 1; i < sessionCount; i++ {\n   530→\t\tfolderName := strconv.Itoa(i)\n   531→\n   532→\t\t// Try to get the archived session subtree\n   533→\t\tsubTree, err := checkpointTree.Tree(folderName)\n   534→\t\tif err != nil {\n   535→\t\t\tcontinue // Folder doesn't exist, skip\n   536→\t\t}\n   537→\n   538→\t\tsession := ArchivedSession{\n   539→\t\t\tFolderIndex: i,\n   540→\t\t}\n   541→\n   542→\t\t// Read metadata to get session ID\n   543→\t\tif metadataFile, fileErr := subTree.File(paths.MetadataFileName); fileErr == nil {\n   544→\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   545→\t\t\t\tvar metadata CommittedMetadata\n   546→\t\t\t\tif jsonErr := json.Unmarshal([]byte(content), &metadata); jsonErr == nil {\n   547→\t\t\t\t\tsession.SessionID = metadata.SessionID\n   548→\t\t\t\t}\n   549→\t\t\t}\n   550→\t\t}\n   551→\n   552→\t\t// Read transcript (handles both chunked and non-chunked formats)\n   553→\t\tif transcript, err := readTranscriptFromTree(subTree, agentType); err == nil && transcript != nil {\n   554→\t\t\tsession.Transcript = transcript\n   555→\t\t}\n   556→\n   557→\t\t// Read prompts\n   558→\t\tif file, fileErr := subTree.File(paths.PromptFileName); fileErr == nil {\n   559→\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   560→\t\t\t\tsession.Prompts = content\n   561→\t\t\t}\n   562→\t\t}\n   563→\n   564→\t\t// Only add if we got a transcript\n   565→\t\tif len(session.Transcript) > 0 {\n   566→\t\t\tarchived = append(archived, session)\n   567→\t\t}\n   568→\t}\n   569→\n   570→\treturn archived\n   571→}\n   572→\n   573→// buildCommitMessage constructs the commit message with proper trailers.\n   574→// The commit subject is always \"Checkpoint: <id>\" for consistency.\n   575→// If CommitSubject is provided (e.g., for task checkpoints), it's included in the body.\n   576→func (s *GitStore) buildCommitMessage(opts WriteCommittedOptions, taskMetadataPath string) string {\n   577→\tvar commitMsg strings.Builder\n   578→\n   579→\t// Subject line is always the checkpoint ID for consistent formatting\n   580→\tcommitMsg.WriteString(fmt.Sprintf(\"Checkpoint: %s\\n\\n\", opts.CheckpointID))\n   581→\n   582→\t// Include custom description in body if provided (e.g., task checkpoint details)\n   583→\tif opts.CommitSubject != \"\" {\n   584→\t\tcommitMsg.WriteString(opts.CommitSubject + \"\\n\\n\")\n   585→\t}\n   586→\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.SessionTrailerKey, opts.SessionID))\n   587→\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.StrategyTrailerKey, opts.Strategy))\n   588→\tif opts.Agent != \"\" {\n   589→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.AgentTrailerKey, opts.Agent))\n   590→\t}\n   591→\tif opts.EphemeralBranch != \"\" {\n   592→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.EphemeralBranchTrailerKey, opts.EphemeralBranch))\n   593→\t}\n   594→\tif taskMetadataPath != \"\" {\n   595→\t\tcommitMsg.WriteString(fmt.Sprintf(\"%s: %s\\n\", trailers.MetadataTaskTrailerKey, taskMetadataPath))\n   596→\t}\n   597→\n   598→\treturn commitMsg.String()\n   599→}\n   600→\n   601→// incrementalCheckpointData represents an incremental checkpoint during subagent execution.\n   602→// This mirrors strategy.SubagentCheckpoint but avoids import cycles.\n   603→type incrementalCheckpointData struct {\n   604→\tType      string          `json:\"type\"`\n   605→\tToolUseID string          `json:\"tool_use_id\"`\n   606→\tTimestamp time.Time       `json:\"timestamp\"`\n   607→\tData      json.RawMessage `json:\"data\"`\n   608→}\n   609→\n   610→// taskCheckpointData represents a final task checkpoint.\n   611→// This mirrors strategy.TaskCheckpoint but avoids import cycles.\n   612→type taskCheckpointData struct {\n   613→\tSessionID      string `json:\"session_id\"`\n   614→\tToolUseID      string `json:\"tool_use_id\"`\n   615→\tCheckpointUUID string `json:\"checkpoint_uuid\"`\n   616→\tAgentID        string `json:\"agent_id,omitempty\"`\n   617→}\n   618→\n   619→// ReadCommitted reads a committed checkpoint by ID from the entire/sessions branch.\n   620→// Returns nil, nil if the checkpoint doesn't exist.\n   621→//\n   622→\n   623→func (s *GitStore) ReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*ReadCommittedResult, error) {\n   624→\t_ = ctx // Reserved for future use\n   625→\n   626→\ttree, err := s.getSessionsBranchTree()\n   627→\tif err != nil {\n   628→\t\treturn nil, nil //nolint:nilnil,nilerr // No sessions branch means no checkpoint exists\n   629→\t}\n   630→\n   631→\tcheckpointPath := checkpointID.Path()\n   632→\tcheckpointTree, err := tree.Tree(checkpointPath)\n   633→\tif err != nil {\n   634→\t\treturn nil, nil //nolint:nilnil,nilerr // Checkpoint directory not found\n   635→\t}\n   636→\n   637→\tresult := &ReadCommittedResult{}\n   638→\n   639→\t// Read metadata.json\n   640→\tif metadataFile, fileErr := checkpointTree.File(paths.MetadataFileName); fileErr == nil {\n   641→\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   642→\t\t\t//nolint:errcheck,gosec // Best-effort parsing, defaults are fine\n   643→\t\t\tjson.Unmarshal([]byte(content), &result.Metadata)\n   644→\t\t}\n   645→\t}\n   646→\n   647→\t// Read transcript (handles both chunked and non-chunked formats)\n   648→\tif transcript, err := readTranscriptFromTree(checkpointTree, result.Metadata.Agent); err == nil && transcript != nil {\n   649→\t\tresult.Transcript = transcript\n   650→\t}\n   651→\n   652→\t// Read prompts\n   653→\tif file, fileErr := checkpointTree.File(paths.PromptFileName); fileErr == nil {\n   654→\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   655→\t\t\tresult.Prompts = content\n   656→\t\t}\n   657→\t}\n   658→\n   659→\t// Read context\n   660→\tif file, fileErr := checkpointTree.File(paths.ContextFileName); fileErr == nil {\n   661→\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   662→\t\t\tresult.Context = content\n   663→\t\t}\n   664→\t}\n   665→\n   666→\t// Read archived sessions if this is a multi-session checkpoint\n   667→\tif result.Metadata.SessionCount > 1 {\n   668→\t\tresult.ArchivedSessions = s.readArchivedSessions(checkpointTree, result.Metadata.SessionCount, result.Metadata.Agent)\n   669→\t}\n   670→\n   671→\treturn result, nil\n   672→}\n   673→\n   674→// ListCommitted lists all committed checkpoints from the entire/sessions branch.\n   675→// Scans sharded paths: <id[:2]>/<id[2:]>/ directories containing metadata.json.\n   676→//\n   677→\n   678→func (s *GitStore) ListCommitted(ctx context.Context) ([]CommittedInfo, error) {\n   679→\t_ = ctx // Reserved for future use\n   680→\n   681→\ttree, err := s.getSessionsBranchTree()\n   682→\tif err != nil {\n   683→\t\treturn []CommittedInfo{}, nil //nolint:nilerr // No sessions branch means empty list\n   684→\t}\n   685→\n   686→\tvar checkpoints []CommittedInfo\n   687→\n   688→\t// Scan sharded structure: <2-char-prefix>/<remaining-id>/metadata.json\n   689→\tfor _, bucketEntry := range tree.Entries {\n   690→\t\tif bucketEntry.Mode != filemode.Dir {\n   691→\t\t\tcontinue\n   692→\t\t}\n   693→\t\t// Bucket should be 2 hex chars\n   694→\t\tif len(bucketEntry.Name) != 2 {\n   695→\t\t\tcontinue\n   696→\t\t}\n   697→\n   698→\t\tbucketTree, treeErr := s.repo.TreeObject(bucketEntry.Hash)\n   699→\t\tif treeErr != nil {\n   700→\t\t\tcontinue\n   701→\t\t}\n   702→\n   703→\t\t// Each entry in the bucket is the remaining part of the checkpoint ID\n   704→\t\tfor _, checkpointEntry := range bucketTree.Entries {\n   705→\t\t\tif checkpointEntry.Mode != filemode.Dir {\n   706→\t\t\t\tcontinue\n   707→\t\t\t}\n   708→\n   709→\t\t\tcheckpointTree, cpTreeErr := s.repo.TreeObject(checkpointEntry.Hash)\n   710→\t\t\tif cpTreeErr != nil {\n   711→\t\t\t\tcontinue\n   712→\t\t\t}\n   713→\n   714→\t\t\t// Reconstruct checkpoint ID: <bucket><remaining>\n   715→\t\t\tcheckpointIDStr := bucketEntry.Name + checkpointEntry.Name\n   716→\t\t\tcheckpointID, cpIDErr := id.NewCheckpointID(checkpointIDStr)\n   717→\t\t\tif cpIDErr != nil {\n   718→\t\t\t\t// Skip invalid checkpoint IDs (shouldn't happen with our own data)\n   719→\t\t\t\tcontinue\n   720→\t\t\t}\n   721→\n   722→\t\t\tinfo := CommittedInfo{\n   723→\t\t\t\tCheckpointID: checkpointID,\n   724→\t\t\t}\n   725→\n   726→\t\t\t// Get details from metadata file\n   727→\t\t\tif metadataFile, fileErr := checkpointTree.File(paths.MetadataFileName); fileErr == nil {\n   728→\t\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n   729→\t\t\t\t\tvar metadata CommittedMetadata\n   730→\t\t\t\t\tif err := json.Unmarshal([]byte(content), &metadata); err == nil {\n   731→\t\t\t\t\t\tinfo.SessionID = metadata.SessionID\n   732→\t\t\t\t\t\tinfo.CreatedAt = metadata.CreatedAt\n   733→\t\t\t\t\t\tinfo.CheckpointsCount = metadata.CheckpointsCount\n   734→\t\t\t\t\t\tinfo.FilesTouched = metadata.FilesTouched\n   735→\t\t\t\t\t\tinfo.Agent = metadata.Agent\n   736→\t\t\t\t\t\tinfo.IsTask = metadata.IsTask\n   737→\t\t\t\t\t\tinfo.ToolUseID = metadata.ToolUseID\n   738→\t\t\t\t\t\tinfo.SessionCount = metadata.SessionCount\n   739→\t\t\t\t\t\tinfo.SessionIDs = metadata.SessionIDs\n   740→\t\t\t\t\t}\n   741→\t\t\t\t}\n   742→\t\t\t}\n   743→\n   744→\t\t\tcheckpoints = append(checkpoints, info)\n   745→\t\t}\n   746→\t}\n   747→\n   748→\t// Sort by time (most recent first)\n   749→\tsort.Slice(checkpoints, func(i, j int) bool {\n   750→\t\treturn checkpoints[i].CreatedAt.After(checkpoints[j].CreatedAt)\n   751→\t})\n   752→\n   753→\treturn checkpoints, nil\n   754→}\n   755→\n   756→// GetTranscript retrieves the transcript for a specific checkpoint ID.\n   757→func (s *GitStore) GetTranscript(ctx context.Context, checkpointID id.CheckpointID) ([]byte, error) {\n   758→\tresult, err := s.ReadCommitted(ctx, checkpointID)\n   759→\tif err != nil {\n   760→\t\treturn nil, err\n   761→\t}\n   762→\tif result == nil {\n   763→\t\treturn nil, fmt.Errorf(\"checkpoint not found: %s\", checkpointID)\n   764→\t}\n   765→\tif len(result.Transcript) == 0 {\n   766→\t\treturn nil, fmt.Errorf(\"no transcript found for checkpoint: %s\", checkpointID)\n   767→\t}\n   768→\treturn result.Transcript, nil\n   769→}\n   770→\n   771→// GetSessionLog retrieves the session transcript and session ID for a checkpoint.\n   772→// This is the primary method for looking up session logs by checkpoint ID.\n   773→// Returns ErrCheckpointNotFound if the checkpoint doesn't exist.\n   774→// Returns ErrNoTranscript if the checkpoint exists but has no transcript.\n   775→func (s *GitStore) GetSessionLog(cpID id.CheckpointID) ([]byte, string, error) {\n   776→\tresult, err := s.ReadCommitted(context.Background(), cpID)\n   777→\tif err != nil {\n   778→\t\treturn nil, \"\", fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   779→\t}\n   780→\tif result == nil {\n   781→\t\treturn nil, \"\", ErrCheckpointNotFound\n   782→\t}\n   783→\tif len(result.Transcript) == 0 {\n   784→\t\treturn nil, \"\", ErrNoTranscript\n   785→\t}\n   786→\treturn result.Transcript, result.Metadata.SessionID, nil\n   787→}\n   788→\n   789→// LookupSessionLog is a convenience function that opens the repository and retrieves\n   790→// a session log by checkpoint ID. This is the primary entry point for callers that\n   791→// don't already have a GitStore instance.\n   792→// Returns ErrCheckpointNotFound if the checkpoint doesn't exist.\n   793→// Returns ErrNoTranscript if the checkpoint exists but has no transcript.\n   794→func LookupSessionLog(cpID id.CheckpointID) ([]byte, string, error) {\n   795→\trepo, err := git.PlainOpenWithOptions(\".\", &git.PlainOpenOptions{DetectDotGit: true})\n   796→\tif err != nil {\n   797→\t\treturn nil, \"\", fmt.Errorf(\"failed to open git repository: %w\", err)\n   798→\t}\n   799→\tstore := NewGitStore(repo)\n   800→\treturn store.GetSessionLog(cpID)\n   801→}\n   802→\n   803→// UpdateSummary updates the summary field in an existing checkpoint's metadata.\n   804→// Returns ErrCheckpointNotFound if the checkpoint doesn't exist.\n   805→func (s *GitStore) UpdateSummary(ctx context.Context, checkpointID id.CheckpointID, summary *Summary) error {\n   806→\t_ = ctx // Reserved for future use\n   807→\n   808→\t// Ensure sessions branch exists\n   809→\tif err := s.ensureSessionsBranch(); err != nil {\n   810→\t\treturn fmt.Errorf(\"failed to ensure sessions branch: %w\", err)\n   811→\t}\n   812→\n   813→\t// Get current branch tip and flatten tree\n   814→\tref, entries, err := s.getSessionsBranchEntries()\n   815→\tif err != nil {\n   816→\t\treturn err\n   817→\t}\n   818→\n   819→\t// Read existing metadata\n   820→\tbasePath := checkpointID.Path() + \"/\"\n   821→\tmetadataPath := basePath + paths.MetadataFileName\n   822→\tentry, exists := entries[metadataPath]\n   823→\tif !exists {\n   824→\t\treturn ErrCheckpointNotFound\n   825→\t}\n   826→\n   827→\t// Read and parse existing metadata\n   828→\texistingMetadata, err := s.readMetadataFromBlob(entry.Hash)\n   829→\tif err != nil {\n   830→\t\treturn fmt.Errorf(\"failed to read existing metadata: %w\", err)\n   831→\t}\n   832→\n   833→\t// Update the summary\n   834→\texistingMetadata.Summary = summary\n   835→\n   836→\t// Write updated metadata\n   837→\tmetadataJSON, err := jsonutil.MarshalIndentWithNewline(existingMetadata, \"\", \"  \")\n   838→\tif err != nil {\n   839→\t\treturn fmt.Errorf(\"failed to marshal metadata: %w\", err)\n   840→\t}\n   841→\tmetadataHash, err := CreateBlobFromContent(s.repo, metadataJSON)\n   842→\tif err != nil {\n   843→\t\treturn fmt.Errorf(\"failed to create metadata blob: %w\", err)\n   844→\t}\n   845→\tentries[metadataPath] = object.TreeEntry{\n   846→\t\tName: metadataPath,\n   847→\t\tMode: filemode.Regular,\n   848→\t\tHash: metadataHash,\n   849→\t}\n   850→\n   851→\t// Build and commit\n   852→\tnewTreeHash, err := BuildTreeFromEntries(s.repo, entries)\n   853→\tif err != nil {\n   854→\t\treturn err\n   855→\t}\n   856→\n   857→\tauthorName, authorEmail := getGitAuthorFromRepo(s.repo)\n   858→\tcommitMsg := fmt.Sprintf(\"Update summary for checkpoint %s (session: %s)\", checkpointID, existingMetadata.SessionID)\n   859→\tnewCommitHash, err := s.createCommit(newTreeHash, ref.Hash(), commitMsg, authorName, authorEmail)\n   860→\tif err != nil {\n   861→\t\treturn err\n   862→\t}\n   863→\n   864→\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n   865→\tnewRef := plumbing.NewHashReference(refName, newCommitHash)\n   866→\tif err := s.repo.Storer.SetReference(newRef); err != nil {\n   867→\t\treturn fmt.Errorf(\"failed to set branch reference: %w\", err)\n   868→\t}\n   869→\n   870→\treturn nil\n   871→}\n   872→\n   873→// ensureSessionsBranch ensures the entire/sessions branch exists.\n   874→func (s *GitStore) ensureSessionsBranch() error {\n   875→\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n   876→\t_, err := s.repo.Reference(refName, true)\n   877→\tif err == nil {\n   878→\t\treturn nil // Branch exists\n   879→\t}\n   880→\n   881→\t// Create orphan branch with empty tree\n   882→\temptyTreeHash, err := BuildTreeFromEntries(s.repo, make(map[string]object.TreeEntry))\n   883→\tif err != nil {\n   884→\t\treturn err\n   885→\t}\n   886→\n   887→\tauthorName, authorEmail := getGitAuthorFromRepo(s.repo)\n   888→\tcommitHash, err := s.createCommit(emptyTreeHash, plumbing.ZeroHash, \"Initialize sessions branch\", authorName, authorEmail)\n   889→\tif err != nil {\n   890→\t\treturn err\n   891→\t}\n   892→\n   893→\tnewRef := plumbing.NewHashReference(refName, commitHash)\n   894→\tif err := s.repo.Storer.SetReference(newRef); err != nil {\n   895→\t\treturn fmt.Errorf(\"failed to set branch reference: %w\", err)\n   896→\t}\n   897→\treturn nil\n   898→}\n   899→\n   900→// getSessionsBranchTree returns the tree object for the entire/sessions branch.\n   901→func (s *GitStore) getSessionsBranchTree() (*object.Tree, error) {\n   902→\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n   903→\tref, err := s.repo.Reference(refName, true)\n   904→\tif err != nil {\n   905→\t\treturn nil, fmt.Errorf(\"sessions branch not found: %w\", err)\n   906→\t}\n   907→\n   908→\tcommit, err := s.repo.CommitObject(ref.Hash())\n   909→\tif err != nil {\n   910→\t\treturn nil, fmt.Errorf(\"failed to get commit object: %w\", err)\n   911→\t}\n   912→\n   913→\ttree, err := commit.Tree()\n   914→\tif err != nil {\n   915→\t\treturn nil, fmt.Errorf(\"failed to get commit tree: %w\", err)\n   916→\t}\n   917→\n   918→\treturn tree, nil\n   919→}\n   920→\n   921→// CreateBlobFromContent creates a blob object from in-memory content.\n   922→// Exported for use by strategy package (session_test.go)\n   923→func CreateBlobFromContent(repo *git.Repository, content []byte) (plumbing.Hash, error) {\n   924→\tobj := repo.Storer.NewEncodedObject()\n   925→\tobj.SetType(plumbing.BlobObject)\n   926→\tobj.SetSize(int64(len(content)))\n   927→\n   928→\twriter, err := obj.Writer()\n   929→\tif err != nil {\n   930→\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get object writer: %w\", err)\n   931→\t}\n   932→\n   933→\t_, err = writer.Write(content)\n   934→\tif err != nil {\n   935→\t\t_ = writer.Close()\n   936→\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to write blob content: %w\", err)\n   937→\t}\n   938→\tif err := writer.Close(); err != nil {\n   939→\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to close blob writer: %w\", err)\n   940→\t}\n   941→\n   942→\thash, err := repo.Storer.SetEncodedObject(obj)\n   943→\tif err != nil {\n   944→\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to store blob object: %w\", err)\n   945→\t}\n   946→\treturn hash, nil\n   947→}\n   948→\n   949→// copyMetadataDir copies all files from a directory to the checkpoint path.\n   950→// Used to include additional metadata files like task checkpoints, subagent transcripts, etc.\n   951→func (s *GitStore) copyMetadataDir(metadataDir, basePath string, entries map[string]object.TreeEntry) error {\n   952→\terr := filepath.Walk(metadataDir, func(path string, info os.FileInfo, err error) error {\n   953→\t\tif err != nil {\n   954→\t\t\treturn err\n   955→\t\t}\n   956→\t\tif info.IsDir() {\n   957→\t\t\treturn nil\n   958→\t\t}\n   959→\n   960→\t\t// Skip symlinks to prevent reading files outside the metadata directory.\n   961→\t\t// A symlink could point to sensitive files (e.g., /etc/passwd) which would\n   962→\t\t// then be captured in the checkpoint and stored in git history.\n   963→\t\tif info.Mode()&os.ModeSymlink != 0 {\n   964→\t\t\treturn nil\n   965→\t\t}\n   966→\n   967→\t\t// Get relative path within metadata dir\n   968→\t\trelPath, err := filepath.Rel(metadataDir, path)\n   969→\t\tif err != nil {\n   970→\t\t\treturn fmt.Errorf(\"failed to get relative path for %s: %w\", path, err)\n   971→\t\t}\n   972→\n   973→\t\t// Prevent path traversal via symlinks pointing outside the metadata dir\n   974→\t\tif strings.HasPrefix(relPath, \"..\") {\n   975→\t\t\treturn fmt.Errorf(\"path traversal detected: %s\", relPath)\n   976→\t\t}\n   977→\n   978→\t\t// Create blob from file\n   979→\t\tblobHash, mode, err := createBlobFromFile(s.repo, path)\n   980→\t\tif err != nil {\n   981→\t\t\treturn fmt.Errorf(\"failed to create blob for %s: %w\", path, err)\n   982→\t\t}\n   983→\n   984→\t\t// Store at checkpoint path\n   985→\t\tfullPath := basePath + relPath\n   986→\t\tentries[fullPath] = object.TreeEntry{\n   987→\t\t\tName: fullPath,\n   988→\t\t\tMode: mode,\n   989→\t\t\tHash: blobHash,\n   990→\t\t}\n   991→\n   992→\t\treturn nil\n   993→\t})\n   994→\tif err != nil {\n   995→\t\treturn fmt.Errorf(\"failed to walk metadata directory: %w\", err)\n   996→\t}\n   997→\treturn nil\n   998→}\n   999→\n  1000→// getGitAuthorFromRepo retrieves the git user.name and user.email from the repository config.\n  1001→func getGitAuthorFromRepo(repo *git.Repository) (name, email string) {\n  1002→\t// Get repository config (includes local settings)\n  1003→\tcfg, err := repo.Config()\n  1004→\tif err == nil {\n  1005→\t\tname = cfg.User.Name\n  1006→\t\temail = cfg.User.Email\n  1007→\t}\n  1008→\n  1009→\t// Provide sensible defaults if git user is not configured\n  1010→\tif name == \"\" {\n  1011→\t\tname = \"Unknown\"\n  1012→\t}\n  1013→\tif email == \"\" {\n  1014→\t\temail = \"unknown@local\"\n  1015→\t}\n  1016→\n  1017→\treturn name, email\n  1018→}\n  1019→\n  1020→// readTranscriptFromTree reads a transcript from a git tree, handling both chunked and non-chunked formats.\n  1021→// It checks for chunk files first (.001, .002, etc.), then falls back to the base file.\n  1022→// The agentType is used for reassembling chunks in the correct format.\n  1023→func readTranscriptFromTree(tree *object.Tree, agentType agent.AgentType) ([]byte, error) {\n  1024→\t// Collect all transcript-related files\n  1025→\tvar chunkFiles []string\n  1026→\tvar hasBaseFile bool\n  1027→\n  1028→\tfor _, entry := range tree.Entries {\n  1029→\t\tif entry.Name == paths.TranscriptFileName || entry.Name == paths.TranscriptFileNameLegacy {\n  1030→\t\t\thasBaseFile = true\n  1031→\t\t}\n  1032→\t\t// Check for chunk files (full.jsonl.001, full.jsonl.002, etc.)\n  1033→\t\tif strings.HasPrefix(entry.Name, paths.TranscriptFileName+\".\") {\n  1034→\t\t\tidx := agent.ParseChunkIndex(entry.Name, paths.TranscriptFileName)\n  1035→\t\t\tif idx > 0 {\n  1036→\t\t\t\tchunkFiles = append(chunkFiles, entry.Name)\n  1037→\t\t\t}\n  1038→\t\t}\n  1039→\t}\n  1040→\n  1041→\t// If we have chunk files, read and reassemble them\n  1042→\tif len(chunkFiles) > 0 {\n  1043→\t\t// Sort chunk files by index\n  1044→\t\tchunkFiles = agent.SortChunkFiles(chunkFiles, paths.TranscriptFileName)\n  1045→\n  1046→\t\t// Check if base file should be included as chunk 0.\n  1047→\t\t// NOTE: This assumes the chunking convention where the unsuffixed file\n  1048→\t\t// (full.jsonl) is chunk 0, and numbered files (.001, .002) are chunks 1+.\n  1049→\t\tif hasBaseFile {\n  1050→\t\t\tchunkFiles = append([]string{paths.TranscriptFileName}, chunkFiles...)\n  1051→\t\t}\n  1052→\n  1053→\t\tvar chunks [][]byte\n  1054→\t\tfor _, chunkFile := range chunkFiles {\n  1055→\t\t\tfile, err := tree.File(chunkFile)\n  1056→\t\t\tif err != nil {\n  1057→\t\t\t\tlogging.Warn(context.Background(), \"failed to read transcript chunk file from tree\",\n  1058→\t\t\t\t\tslog.String(\"chunk_file\", chunkFile),\n  1059→\t\t\t\t\tslog.String(\"error\", err.Error()),\n  1060→\t\t\t\t)\n  1061→\t\t\t\tcontinue\n  1062→\t\t\t}\n  1063→\t\t\tcontent, err := file.Contents()\n  1064→\t\t\tif err != nil {\n  1065→\t\t\t\tlogging.Warn(context.Background(), \"failed to read transcript chunk contents\",\n  1066→\t\t\t\t\tslog.String(\"chunk_file\", chunkFile),\n  1067→\t\t\t\t\tslog.String(\"error\", err.Error()),\n  1068→\t\t\t\t)\n  1069→\t\t\t\tcontinue\n  1070→\t\t\t}\n  1071→\t\t\tchunks = append(chunks, []byte(content))\n  1072→\t\t}\n  1073→\n  1074→\t\tif len(chunks) > 0 {\n  1075→\t\t\tresult, err := agent.ReassembleTranscript(chunks, agentType)\n  1076→\t\t\tif err != nil {\n  1077→\t\t\t\treturn nil, fmt.Errorf(\"failed to reassemble transcript: %w\", err)\n  1078→\t\t\t}\n  1079→\t\t\treturn result, nil\n  1080→\t\t}\n  1081→\t}\n  1082→\n  1083→\t// Fall back to reading base file (non-chunked or backwards compatibility)\n  1084→\tif file, err := tree.File(paths.TranscriptFileName); err == nil {\n  1085→\t\tif content, err := file.Contents(); err == nil {\n  1086→\t\t\treturn []byte(content), nil\n  1087→\t\t}\n  1088→\t}\n  1089→\n  1090→\t// Try legacy filename\n  1091→\tif file, err := tree.File(paths.TranscriptFileNameLegacy); err == nil {\n  1092→\t\tif content, err := file.Contents(); err == nil {\n  1093→\t\t\treturn []byte(content), nil\n  1094→\t\t}\n  1095→\t}\n  1096→\n  1097→\treturn nil, nil\n  1098→}\n  1099→\n  1100→// Author contains author information for a checkpoint.\n  1101→type Author struct {\n  1102→\tName  string\n  1103→\tEmail string\n  1104→}\n  1105→\n  1106→// GetCheckpointAuthor retrieves the author of a checkpoint from the entire/sessions commit history.\n  1107→// Returns the author of the commit that introduced this checkpoint's metadata.json file.\n  1108→// Returns empty Author if the checkpoint is not found or the sessions branch doesn't exist.\n  1109→func (s *GitStore) GetCheckpointAuthor(ctx context.Context, checkpointID id.CheckpointID) (Author, error) {\n  1110→\t_ = ctx // Reserved for future use\n  1111→\n  1112→\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n  1113→\tref, err := s.repo.Reference(refName, true)\n  1114→\tif err != nil {\n  1115→\t\treturn Author{}, nil\n  1116→\t}\n  1117→\n  1118→\t// Path to the checkpoint's metadata file\n  1119→\tmetadataPath := checkpointID.Path() + \"/\" + paths.MetadataFileName\n  1120→\n  1121→\t// Walk commit history looking for the commit that introduced this file\n  1122→\titer, err := s.repo.Log(&git.LogOptions{\n  1123→\t\tFrom:  ref.Hash(),\n  1124→\t\tOrder: git.LogOrderCommitterTime,\n  1125→\t})\n  1126→\tif err != nil {\n  1127→\t\treturn Author{}, nil\n  1128→\t}\n  1129→\tdefer iter.Close()\n  1130→\n  1131→\tvar author Author\n  1132→\tvar foundCommit *object.Commit\n  1133→\n  1134→\terr = iter.ForEach(func(c *object.Commit) error {\n  1135→\t\ttree, treeErr := c.Tree()\n  1136→\t\tif treeErr != nil {\n  1137→\t\t\treturn nil //nolint:nilerr // Skip commits we can't read, continue searching\n  1138→\t\t}\n  1139→\n  1140→\t\t_, fileErr := tree.File(metadataPath)\n  1141→\t\tif fileErr != nil {\n  1142→\t\t\t// File doesn't exist in this commit - we've gone past the creation point\n  1143→\t\t\tif foundCommit != nil {\n  1144→\t\t\t\treturn errStopIteration\n  1145→\t\t\t}\n  1146→\t\t\treturn nil\n  1147→\t\t}\n  1148→\n  1149→\t\t// File exists - track it (oldest one with file is the creator)\n  1150→\t\tfoundCommit = c\n  1151→\t\tauthor = Author{\n  1152→\t\t\tName:  c.Author.Name,\n  1153→\t\t\tEmail: c.Author.Email,\n  1154→\t\t}\n  1155→\t\treturn nil\n  1156→\t})\n  1157→\n  1158→\t// Ignore errStopIteration - it's just for early exit\n  1159→\tif err != nil && !errors.Is(err, errStopIteration) {\n  1160→\t\treturn Author{}, nil\n  1161→\t}\n  1162→\n  1163→\treturn author, nil\n  1164→}\n