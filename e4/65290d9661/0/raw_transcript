fix) {\n   205→\t\t\tmatches = append(matches, info.CheckpointID)\n   206→\t\t}\n   207→\t}\n   208→\n   209→\tvar fullCheckpointID id.CheckpointID\n   210→\tswitch len(matches) {\n   211→\tcase 0:\n   212→\t\t// Not found in committed, try temporary checkpoints by git SHA\n   213→\t\tif generate {\n   214→\t\t\treturn fmt.Errorf(\"cannot generate summary for temporary checkpoint %s (only committed checkpoints supported)\", checkpointIDPrefix)\n   215→\t\t}\n   216→\t\toutput, found := explainTemporaryCheckpoint(w, repo, store, checkpointIDPrefix, verbose, full, rawTranscript)\n   217→\t\tif found {\n   218→\t\t\toutputExplainContent(w, output, noPager)\n   219→\t\t\treturn nil\n   220→\t\t}\n   221→\t\t// If output is non-empty, it contains an error message (e.g., ambiguous prefix)\n   222→\t\tif output != \"\" {\n   223→\t\t\treturn errors.New(output)\n   224→\t\t}\n   225→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", checkpointIDPrefix)\n   226→\tcase 1:\n   227→\t\tfullCheckpointID = matches[0]\n   228→\tdefault:\n   229→\t\t// Ambiguous prefix - show up to 5 examples\n   230→\t\texamples := make([]string, 0, 5)\n   231→\t\tfor i := 0; i < len(matches) && i < 5; i++ {\n   232→\t\t\texamples = append(examples, matches[i].String())\n   233→\t\t}\n   234→\t\treturn fmt.Errorf(\"ambiguous checkpoint prefix %q matches %d checkpoints: %s\", checkpointIDPrefix, len(matches), strings.Join(examples, \", \"))\n   235→\t}\n   236→\n   237→\t// Load checkpoint data\n   238→\tresult, err := store.ReadCommitted(context.Background(), fullCheckpointID)\n   239→\tif err != nil {\n   240→\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   241→\t}\n   242→\tif result == nil {\n   243→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", fullCheckpointID)\n   244→\t}\n   245→\n   246→\t// Handle summary generation\n   247→\tif generate {\n   248→\t\tif err := generateCheckpointSummary(w, errW, store, fullCheckpointID, result, force); err != nil {\n   249→\t\t\treturn err\n   250→\t\t}\n   251→\t\t// Reload the result to get the updated summary\n   252→\t\tresult, err = store.ReadCommitted(context.Background(), fullCheckpointID)\n   253→\t\tif err != nil {\n   254→\t\t\treturn fmt.Errorf(\"failed to reload checkpoint: %w\", err)\n   255→\t\t}\n   256→\t\tif result == nil {\n   257→\t\t\treturn fmt.Errorf(\"checkpoint not found after save: %s\", fullCheckpointID)\n   258→\t\t}\n   259→\t}\n   260→\n   261→\t// Handle raw transcript output\n   262→\tif rawTranscript {\n   263→\t\tif len(result.Transcript) == 0 {\n   264→\t\t\treturn fmt.Errorf(\"checkpoint %s has no transcript\", fullCheckpointID)\n   265→\t\t}\n   266→\t\t// Output raw transcript directly (no pager, no formatting)\n   267→\t\tif _, err = w.Write(result.Transcript); err != nil {\n   268→\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n   269→\t\t}\n   270→\t\treturn nil\n   271→\t}\n   272→\n   273→\t// Look up the commit message for this checkpoint\n   274→\tcommitMessage := findCommitMessageForCheckpoint(repo, fullCheckpointID)\n   275→\n   276→\t// Format and output\n   277→\toutput := formatCheckpointOutput(result, fullCheckpointID, commitMessage, verbose, full)\n   278→\toutputExplainContent(w, output, noPager)\n   279→\treturn nil\n   280→}\n   281→\n   282→// generateCheckpointSummary generates an AI summary for a checkpoint and persists it.\n   283→// The summary is generated from the scoped transcript (only this checkpoint's portion),\n   284→// not the entire session transcript.\n   285→func generateCheckpointSummary(w, _ io.Writer, store *checkpoint.GitStore, checkpointID id.CheckpointID, result *checkpoint.ReadCommittedResult, force bool) error {\n   286→\t// Check if summary already exists\n   287→\tif result.Metadata.Summary != nil && !force {\n   288→\t\treturn fmt.Errorf(\"checkpoint %s already has a summary (use --force to regenerate)\", checkpointID)\n   289→\t}\n   290→\n   291→\t// Check if transcript exists\n   292→\tif len(result.Transcript) == 0 {\n   293→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript to summarise\", checkpointID)\n   294→\t}\n   295→\n   296→\t// Scope the transcript to only this checkpoint's portion\n   297→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   298→\tif len(scopedTranscript) == 0 {\n   299→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript content for this checkpoint (scoped)\", checkpointID)\n   300→\t}\n   301→\n   302→\t// Build condensed transcript for summarisation from the scoped portion\n   303→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(scopedTranscript)\n   304→\tif err != nil {\n   305→\t\treturn fmt.Errorf(\"failed to parse transcript: %w\", err)\n   306→\t}\n   307→\tif len(condensed) == 0 {\n   308→\t\treturn fmt.Errorf(\"checkpoint %s transcript has no content to summarise\", checkpointID)\n   309→\t}\n   310→\n   311→\tinput := summarise.Input{\n   312→\t\tTranscript:   condensed,\n   313→\t\tFilesTouched: result.Metadata.FilesTouched,\n   314→\t}\n   315→\n   316→\t// Generate summary using Claude CLI\n   317→\tctx := context.Background()\n   318→\tlogging.Info(ctx, \"generating checkpoint summary\")\n   319→\n   320→\tvar generator summarise.Generator = &summarise.ClaudeGenerator{}\n   321→\tsummary, err := generator.Generate(ctx, input)\n   322→\tif err != nil {\n   323→\t\treturn fmt.Errorf(\"failed to generate summary: %w\", err)\n   324→\t}\n   325→\n   326→\t// Persist the summary\n   327→\tif err := store.UpdateSummary(ctx, checkpointID, summary); err != nil {\n   328→\t\treturn fmt.Errorf(\"failed to save summary: %w\", err)\n   329→\t}\n   330→\n   331→\tfmt.Fprintln(w, \"✓ Summary generated and saved\")\n   332→\treturn nil\n   333→}\n   334→\n   335→// explainTemporaryCheckpoint finds and formats a temporary checkpoint by shadow commit hash prefix.\n   336→// Returns the formatted output and whether the checkpoint was found.\n   337→// Searches ALL shadow branches, not just the one for current HEAD, to find checkpoints\n   338→// created from different base commits (e.g., if HEAD advanced since session start).\n   339→// The writer w is used for raw transcript output to bypass the pager.\n   340→func explainTemporaryCheckpoint(w io.Writer, repo *git.Repository, store *checkpoint.GitStore, shaPrefix string, verbose, full, rawTranscript bool) (string, bool) {\n   341→\t// List temporary checkpoints from ALL shadow branches\n   342→\t// This ensures we find checkpoints even if HEAD has advanced since the session started\n   343→\ttempCheckpoints, err := store.ListAllTemporaryCheckpoints(context.Background(), \"\", branchCheckpointsLimit)\n   344→\tif err != nil {\n   345→\t\treturn \"\", false\n   346→\t}\n   347→\n   348→\t// Find checkpoints matching the SHA prefix - check for ambiguity\n   349→\tvar matches []checkpoint.TemporaryCheckpointInfo\n   350→\tfor _, tc := range tempCheckpoints {\n   351→\t\tif strings.HasPrefix(tc.CommitHash.String(), shaPrefix) {\n   352→\t\t\tmatches = append(matches, tc)\n   353→\t\t}\n   354→\t}\n   355→\n   356→\tif len(matches) == 0 {\n   357→\t\treturn \"\", false\n   358→\t}\n   359→\n   360→\tif len(matches) > 1 {\n   361→\t\t// Multiple matches - return ambiguous error (consistent with committed checkpoint behavior)\n   362→\t\tvar sb strings.Builder\n   363→\t\tfmt.Fprintf(&sb, \"ambiguous checkpoint prefix %q matches %d temporary checkpoints:\\n\", shaPrefix, len(matches))\n   364→\t\tfor _, m := range matches {\n   365→\t\t\tshortID := m.CommitHash.String()[:7]\n   366→\t\t\tfmt.Fprintf(&sb, \"  %s  %s  session %s\\n\",\n   367→\t\t\t\tshortID,\n   368→\t\t\t\tm.Timestamp.Format(\"2006-01-02 15:04:05\"),\n   369→\t\t\t\tm.SessionID)\n   370→\t\t}\n   371→\t\t// Return as \"not found\" with error message - caller will use this as error\n   372→\t\treturn sb.String(), false\n   373→\t}\n   374→\n   375→\ttc := matches[0]\n   376→\n   377→\t// Handle raw transcript output\n   378→\tif rawTranscript {\n   379→\t\ttranscriptBytes, transcriptErr := store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown)\n   380→\t\tif transcriptErr != nil || len(transcriptBytes) == 0 {\n   381→\t\t\t// Return specific error message (consistent with committed checkpoints)\n   382→\t\t\treturn fmt.Sprintf(\"checkpoint %s has no transcript\", tc.CommitHash.String()[:7]), false\n   383→\t\t}\n   384→\t\t// Write directly to writer (no pager, no formatting) - matches committed checkpoint behavior\n   385→\t\tif _, writeErr := fmt.Fprint(w, string(transcriptBytes)); writeErr != nil {\n   386→\t\t\treturn fmt.Sprintf(\"failed to write transcript: %v\", writeErr), false\n   387→\t\t}\n   388→\t\treturn \"\", true\n   389→\t}\n   390→\n   391→\t// Found exactly one match - read metadata from shadow branch commit tree\n   392→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   393→\tif commitErr != nil {\n   394→\t\treturn \"\", false\n   395→\t}\n   396→\n   397→\tshadowTree, treeErr := shadowCommit.Tree()\n   398→\tif treeErr != nil {\n   399→\t\treturn \"\", false\n   400→\t}\n   401→\n   402→\t// Read prompts from shadow branch\n   403→\tsessionPrompt := strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   404→\n   405→\t// Build output similar to formatCheckpointOutput but for temporary\n   406→\tvar sb strings.Builder\n   407→\tshortID := tc.CommitHash.String()[:7]\n   408→\tfmt.Fprintf(&sb, \"Checkpoint: %s [temporary]\\n\", shortID)\n   409→\tfmt.Fprintf(&sb, \"Session: %s\\n\", tc.SessionID)\n   410→\tfmt.Fprintf(&sb, \"Created: %s\\n\", tc.Timestamp.Format(\"2006-01-02 15:04:05\"))\n   411→\tsb.WriteString(\"\\n\")\n   412→\n   413→\t// Intent from prompt\n   414→\tintent := \"(not available)\"\n   415→\tif sessionPrompt != \"\" {\n   416→\t\tlines := strings.Split(sessionPrompt, \"\\n\")\n   417→\t\tif len(lines) > 0 && lines[0] != \"\" {\n   418→\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   419→\t\t}\n   420→\t}\n   421→\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   422→\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   423→\n   424→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   425→\t// For temporary checkpoints, load transcript and compute scope from parent commit\n   426→\tvar fullTranscript []byte\n   427→\tvar scopedTranscript []byte\n   428→\tif full || verbose {\n   429→\t\tfullTranscript, _ = store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   430→\n   431→\t\tif verbose && len(fullTranscript) > 0 {\n   432→\t\t\t// Compute scoped transcript by finding where parent's transcript ended\n   433→\t\t\t// Each shadow branch commit has the full transcript up to that point,\n   434→\t\t\t// so we diff against parent to get just this checkpoint's activity\n   435→\t\t\tscopedTranscript = fullTranscript // Default to full if no parent\n   436→\t\t\tif shadowCommit.NumParents() > 0 {\n   437→\t\t\t\tif parent, parentErr := shadowCommit.Parent(0); parentErr == nil {\n   438→\t\t\t\t\tparentTranscript, _ := store.GetTranscriptFromCommit(parent.Hash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   439→\t\t\t\t\tif len(parentTranscript) > 0 {\n   440→\t\t\t\t\t\t// Count lines in parent transcript to know where to slice from\n   441→\t\t\t\t\t\tparentLineCount := countLines(parentTranscript)\n   442→\t\t\t\t\t\tscopedTranscript = transcript.SliceFromLine(fullTranscript, parentLineCount)\n   443→\t\t\t\t\t}\n   444→\t\t\t\t}\n   445→\t\t\t}\n   446→\t\t}\n   447→\t}\n   448→\tappendTranscriptSection(&sb, verbose, full, fullTranscript, scopedTranscript, sessionPrompt)\n   449→\n   450→\treturn sb.String(), true\n   451→}\n   452→\n   453→// findCommitMessageForCheckpoint searches git history for a commit with the\n   454→// Entire-Checkpoint trailer matching the given checkpoint ID, and returns\n   455→// the first line of the commit message. Returns empty string if not found.\n   456→func findCommitMessageForCheckpoint(repo *git.Repository, checkpointID id.CheckpointID) string {\n   457→\t// Get HEAD reference\n   458→\thead, err := repo.Head()\n   459→\tif err != nil {\n   460→\t\treturn \"\"\n   461→\t}\n   462→\n   463→\t// Iterate through commit history (limit to recent commits for performance)\n   464→\tcommitIter, err := repo.Log(&git.LogOptions{\n   465→\t\tFrom: head.Hash(),\n   466→\t})\n   467→\tif err != nil {\n   468→\t\treturn \"\"\n   469→\t}\n   470→\tdefer commitIter.Close()\n   471→\n   472→\tcount := 0\n   473→\n   474→\tfor {\n   475→\t\tcommit, iterErr := commitIter.Next()\n   476→\t\tif iterErr != nil {\n   477→\t\t\tbreak\n   478→\t\t}\n   479→\t\tcount++\n   480→\t\tif count > commitScanLimit {\n   481→\t\t\tbreak\n   482→\t\t}\n   483→\n   484→\t\t// Check if this commit has our checkpoint ID\n   485→\t\tfoundID, hasTrailer := trailers.ParseCheckpoint(commit.Message)\n   486→\t\tif hasTrailer && foundID == checkpointID {\n   487→\t\t\t// Return first line of commit message (without trailing newline)\n   488→\t\t\tfirstLine := strings.Split(commit.Message, \"\\n\")[0]\n   489→\t\t\treturn strings.TrimSpace(firstLine)\n   490→\t\t}\n   491→\t}\n   492→\n   493→\treturn \"\"\n   494→}\n   495→\n   496→// scopeTranscriptForCheckpoint slices a transcript to include only the lines\n   497→// relevant to a specific checkpoint, starting from linesAtStart.\n   498→// This allows showing only what happened during a checkpoint, not the entire session.\n   499→func scopeTranscriptForCheckpoint(fullTranscript []byte, linesAtStart int) []byte {\n   500→\treturn transcript.SliceFromLine(fullTranscript, linesAtStart)\n   501→}\n   502→\n   503→// extractPromptsFromTranscript extracts user prompts from transcript bytes.\n   504→// Returns a slice of prompt strings.\n   505→func extractPromptsFromTranscript(transcriptBytes []byte) []string {\n   506→\tif len(transcriptBytes) == 0 {\n   507→\t\treturn nil\n   508→\t}\n   509→\n   510→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   511→\tif err != nil {\n   512→\t\treturn nil\n   513→\t}\n   514→\n   515→\tvar prompts []string\n   516→\tfor _, entry := range condensed {\n   517→\t\tif entry.Type == summarise.EntryTypeUser && entry.Content != \"\" {\n   518→\t\t\tprompts = append(prompts, entry.Content)\n   519→\t\t}\n   520→\t}\n   521→\treturn prompts\n   522→}\n   523→\n   524→// formatCheckpointOutput formats checkpoint data based on verbosity level.\n   525→// When verbose is false: summary only (ID, session, timestamp, tokens, intent).\n   526→// When verbose is true: adds files, commit message, and scoped transcript for this checkpoint.\n   527→// When full is true: shows parsed full session transcript instead of scoped transcript.\n   528→//\n   529→// Transcript scope is controlled by TranscriptLinesAtStart in metadata, which indicates\n   530→// where this checkpoint's content begins in the full session transcript.\n   531→func formatCheckpointOutput(result *checkpoint.ReadCommittedResult, checkpointID id.CheckpointID, commitMessage string, verbose, full bool) string {\n   532→\tvar sb strings.Builder\n   533→\tmeta := result.Metadata\n   534→\n   535→\t// Scope the transcript to this checkpoint's portion\n   536→\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   537→\t// lines from that point onwards (excluding earlier checkpoint content)\n   538→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, meta.TranscriptLinesAtStart)\n   539→\n   540→\t// Extract prompts from the scoped transcript for intent extraction\n   541→\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   542→\n   543→\t// Header - always shown\n   544→\t// Note: CheckpointID is always exactly 12 characters, matching checkpointIDDisplayLength\n   545→\tfmt.Fprintf(&sb, \"Checkpoint: %s\\n\", checkpointID)\n   546→\tfmt.Fprintf(&sb, \"Session: %s\\n\", meta.SessionID)\n   547→\tfmt.Fprintf(&sb, \"Created: %s\\n\", meta.CreatedAt.Format(\"2006-01-02 15:04:05\"))\n   548→\n   549→\t// Token usage\n   550→\tif meta.TokenUsage != nil {\n   551→\t\ttotalTokens := meta.TokenUsage.InputTokens + meta.TokenUsage.CacheCreationTokens +\n   552→\t\t\tmeta.TokenUsage.CacheReadTokens + meta.TokenUsage.OutputTokens\n   553→\t\tfmt.Fprintf(&sb, \"Tokens: %d\\n\", totalTokens)\n   554→\t}\n   555→\n   556→\tsb.WriteString(\"\\n\")\n   557→\n   558→\t// Intent and Outcome from AI summary, or fallback to prompt text\n   559→\tif meta.Summary != nil {\n   560→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", meta.Summary.Intent)\n   561→\t\tfmt.Fprintf(&sb, \"Outcome: %s\\n\", meta.Summary.Outcome)\n   562→\t} else {\n   563→\t\t// Fallback: use first line of scoped prompts for intent,\n   564→\t\t// or fall back to result.Prompts for backwards compatibility with older checkpoints\n   565→\t\tintent := \"(not generated)\"\n   566→\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   567→\t\t\tintent = strategy.TruncateDescription(scopedPrompts[0], maxIntentDisplayLength)\n   568→\t\t} else if result.Prompts != \"\" {\n   569→\t\t\t// Backwards compatibility: use stored prompts if no transcript available\n   570→\t\t\tlines := strings.Split(result.Prompts, \"\\n\")\n   571→\t\t\tif len(lines) > 0 && lines[0] != \"\" {\n   572→\t\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   573→\t\t\t}\n   574→\t\t}\n   575→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   576→\t\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   577→\t}\n   578→\n   579→\t// Verbose: add commit message, learnings, friction, files, and scoped transcript\n   580→\tif verbose || full {\n   581→\t\t// AI Summary details (learnings, friction, open items)\n   582→\t\tif meta.Summary != nil {\n   583→\t\t\tformatSummaryDetails(&sb, meta.Summary)\n   584→\t\t}\n   585→\n   586→\t\t// Commit message section (only if available)\n   587→\t\tif commitMessage != \"\" {\n   588→\t\t\tsb.WriteString(\"\\n\")\n   589→\t\t\tfmt.Fprintf(&sb, \"Commit: %s\\n\", commitMessage)\n   590→\t\t}\n   591→\n   592→\t\tsb.WriteString(\"\\n\")\n   593→\n   594→\t\t// Files section\n   595→\t\tif len(meta.FilesTouched) > 0 {\n   596→\t\t\tfmt.Fprintf(&sb, \"Files: (%d)\\n\", len(meta.FilesTouched))\n   597→\t\t\tfor _, file := range meta.FilesTouched {\n   598→\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n   599→\t\t\t}\n   600→\t\t} else {\n   601→\t\t\tsb.WriteString(\"Files: (none)\\n\")\n   602→\t\t}\n   603→\t}\n   604→\n   605→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   606→\tappendTranscriptSection(&sb, verbose, full, result.Transcript, scopedTranscript, result.Prompts)\n   607→\n   608→\treturn sb.String()\n   609→}\n   610→\n   611→// appendTranscriptSection appends the appropriate transcript section to the builder\n   612→// based on verbosity level. Full mode shows the entire session, verbose shows checkpoint scope.\n   613→// fullTranscript is the entire session transcript, scopedContent is either scoped transcript bytes\n   614→// or a pre-formatted string (for backwards compat), and scopedFallback is used when scoped parsing fails.\n   615→func appendTranscriptSection(sb *strings.Builder, verbose, full bool, fullTranscript, scopedTranscript []byte, scopedFallback string) {\n   616→\tswitch {\n   617→\tcase full:\n   618→\t\tsb.WriteString(\"\\n\")\n   619→\t\tsb.WriteString(\"Transcript (full session):\\n\")\n   620→\t\tsb.WriteString(formatTranscriptBytes(fullTranscript, \"\"))\n   621→\n   622→\tcase verbose:\n   623→\t\tsb.WriteString(\"\\n\")\n   624→\t\tsb.WriteString(\"Transcript (checkpoint scope):\\n\")\n   625→\t\tsb.WriteString(formatTranscriptBytes(scopedTranscript, scopedFallback))\n   626→\t}\n   627→}\n   628→\n   629→// formatTranscriptBytes formats transcript bytes into a human-readable string.\n   630→// It parses the JSONL transcript and formats it using the condensed format.\n   631→// The fallback is used for backwards compatibility when transcript parsing fails or is empty.\n   632→func formatTranscriptBytes(transcriptBytes []byte, fallback string) string {\n   633→\tif len(transcriptBytes) == 0 {\n   634→\t\tif fallback != \"\" {\n   635→\t\t\treturn fallback + \"\\n\"\n   636→\t\t}\n   637→\t\treturn \"  (none)\\n\"\n   638→\t}\n   639→\n   640→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   641→\tif err != nil || len(condensed) == 0 {\n   642→\t\tif fallback != \"\" {\n   643→\t\t\treturn fallback + \"\\n\"\n   644→\t\t}\n   645→\t\treturn \"  (failed to parse transcript)\\n\"\n   646→\t}\n   647→\n   648→\tinput := summarise.Input{Transcript: condensed}\n   649→\treturn summarise.FormatCondensedTranscript(input)\n   650→}\n   651→\n   652→// formatSummaryDetails formats the detailed sections of an AI summary.\n   653→func formatSummaryDetails(sb *strings.Builder, summary *checkpoint.Summary) {\n   654→\t// Learnings section\n   655→\thasLearnings := len(summary.Learnings.Repo) > 0 ||\n   656→\t\tlen(summary.Learnings.Code) > 0 ||\n   657→\t\tlen(summary.Learnings.Workflow) > 0\n   658→\n   659→\tif hasLearnings {\n   660→\t\tsb.WriteString(\"\\nLearnings:\\n\")\n   661→\n   662→\t\tif len(summary.Learnings.Repo) > 0 {\n   663→\t\t\tsb.WriteString(\"  Repository:\\n\")\n   664→\t\t\tfor _, learning := range summary.Learnings.Repo {\n   665→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   666→\t\t\t}\n   667→\t\t}\n   668→\n   669→\t\tif len(summary.Learnings.Code) > 0 {\n   670→\t\t\tsb.WriteString(\"  Code:\\n\")\n   671→\t\t\tfor _, learning := range summary.Learnings.Code {\n   672→\t\t\t\tif learning.Line > 0 {\n   673→\t\t\t\t\tif learning.EndLine > 0 {\n   674→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d-%d: %s\\n\", learning.Path, learning.Line, learning.EndLine, learning.Finding)\n   675→\t\t\t\t\t} else {\n   676→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d: %s\\n\", learning.Path, learning.Line, learning.Finding)\n   677→\t\t\t\t\t}\n   678→\t\t\t\t} else {\n   679→\t\t\t\t\tfmt.Fprintf(sb, \"    - %s: %s\\n\", learning.Path, learning.Finding)\n   680→\t\t\t\t}\n   681→\t\t\t}\n   682→\t\t}\n   683→\n   684→\t\tif len(summary.Learnings.Workflow) > 0 {\n   685→\t\t\tsb.WriteString(\"  Workflow:\\n\")\n   686→\t\t\tfor _, learning := range summary.Learnings.Workflow {\n   687→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   688→\t\t\t}\n   689→\t\t}\n   690→\t}\n   691→\n   692→\t// Friction section\n   693→\tif len(summary.Friction) > 0 {\n   694→\t\tsb.WriteString(\"\\nFriction:\\n\")\n   695→\t\tfor _, item := range summary.Friction {\n   696→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   697→\t\t}\n   698→\t}\n   699→\n   700→\t// Open items section\n   701→\tif len(summary.OpenItems) > 0 {\n   702→\t\tsb.WriteString(\"\\nOpen Items:\\n\")\n   703→\t\tfor _, item := range summary.OpenItems {\n   704→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   705→\t\t}\n   706→\t}\n   707→}\n   708→\n   709→// runExplainDefault shows all checkpoints on the current branch.\n   710→// This is the default view when no flags are provided.\n   711→func runExplainDefault(w io.Writer, noPager bool) error {\n   712→\treturn runExplainBranchDefault(w, noPager)\n   713→}\n   714→\n   715→// branchCheckpointsLimit is the max checkpoints to show in branch view\n   716→const branchCheckpointsLimit = 100\n   717→\n   718→// commitScanLimit is how far back to scan git history for checkpoints\n   719→const commitScanLimit = 500\n   720→\n   721→// consecutiveMainLimit stops scanning after this many consecutive commits on main\n   722→// (indicates we've likely exhausted feature branch commits)\n   723→const consecutiveMainLimit = 100\n   724→\n   725→// errStopIteration is used to stop commit iteration early\n   726→var errStopIteration = errors.New(\"stop iteration\")\n   727→\n   728→// getBranchCheckpoints returns checkpoints relevant to the current branch.\n   729→// This is strategy-agnostic - it queries checkpoints directly from the checkpoint store.\n   730→//\n   731→// Behavior:\n   732→//   - On feature branches: only show checkpoints unique to this branch (not in main)\n   733→//   - On default branch (main/master): show all checkpoints in history (up to limit)\n   734→//   - Includes both committed checkpoints (entire/sessions) and temporary checkpoints (shadow branches)\n   735→func getBranchCheckpoints(repo *git.Repository, limit int) ([]strategy.RewindPoint, error) {\n   736→\tstore := checkpoint.NewGitStore(repo)\n   737→\n   738→\t// Get all committed checkpoints for lookup\n   739→\tcommittedInfos, err := store.ListCommitted(context.Background())\n   740→\tif err != nil {\n   741→\t\tcommittedInfos = nil // Continue without committed checkpoints\n   742→\t}\n   743→\n   744→\t// Build map of checkpoint ID -> committed info\n   745→\tcommittedByID := make(map[id.CheckpointID]checkpoint.CommittedInfo)\n   746→\tfor _, info := range committedInfos {\n   747→\t\tif !info.CheckpointID.IsEmpty() {\n   748→\t\t\tcommittedByID[info.CheckpointID] = info\n   749→\t\t}\n   750→\t}\n   751→\n   752→\thead, err := repo.Head()\n   753→\tif err != nil {\n   754→\t\t// Unborn HEAD (no commits yet) - return empty list instead of erroring\n   755→\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n   756→\t\t\treturn []strategy.RewindPoint{}, nil\n   757→\t\t}\n   758→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   759→\t}\n   760→\n   761→\t// Check if we're on the default branch (use repo-aware version)\n   762→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   763→\tvar mainBranchHash plumbing.Hash\n   764→\tif !isOnDefault {\n   765→\t\t// Prefer the actual default branch name (which may not be main/master)\n   766→\t\tif defaultBranchName := strategy.GetDefaultBranchName(repo); defaultBranchName != \"\" {\n   767→\t\t\t// Try local default branch first: refs/heads/<name>\n   768→\t\t\tref, refErr := repo.Reference(plumbing.ReferenceName(\"refs/heads/\"+defaultBranchName), true)\n   769→\t\t\tif refErr != nil {\n   770→\t\t\t\t// Fall back to remote default branch: refs/remotes/origin/<name>\n   771→\t\t\t\tref, refErr = repo.Reference(plumbing.ReferenceName(\"refs/remotes/origin/\"+defaultBranchName), true)\n   772→\t\t\t}\n   773→\t\t\tif refErr == nil {\n   774→\t\t\t\tmainBranchHash = ref.Hash()\n   775→\t\t\t}\n   776→\t\t}\n   777→\n   778→\t\t// Fall back to main/master detection if default branch resolution failed\n   779→\t\tif mainBranchHash == plumbing.ZeroHash {\n   780→\t\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   781→\t\t}\n   782→\t}\n   783→\n   784→\t// Precompute commits reachable from main (for O(1) filtering instead of O(N) per commit)\n   785→\t// This changes the filtering from O(N*M) to O(N+M) where N=commits scanned, M=main history depth\n   786→\treachableFromMain := make(map[plumbing.Hash]bool)\n   787→\tif mainBranchHash != plumbing.ZeroHash {\n   788→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   789→\t\tif mainErr == nil {\n   790→\t\t\tmainCount := 0\n   791→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   792→\t\t\t\tmainCount++\n   793→\t\t\t\tif mainCount > 1000 { // Same depth limit as before\n   794→\t\t\t\t\treturn errStopIteration\n   795→\t\t\t\t}\n   796→\t\t\t\treachableFromMain[c.Hash] = true\n   797→\t\t\t\treturn nil\n   798→\t\t\t})\n   799→\t\t\tmainIter.Close()\n   800→\t\t}\n   801→\t}\n   802→\n   803→\t// Walk git history and collect checkpoints\n   804→\titer, err := repo.Log(&git.LogOptions{\n   805→\t\tFrom:  head.Hash(),\n   806→\t\tOrder: git.LogOrderCommitterTime,\n   807→\t})\n   808→\tif err != nil {\n   809→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   810→\t}\n   811→\tdefer iter.Close()\n   812→\n   813→\tvar points []strategy.RewindPoint\n   814→\tcount := 0\n   815→\tconsecutiveMainCount := 0\n   816→\n   817→\terr = iter.ForEach(func(c *object.Commit) error {\n   818→\t\tif count >= commitScanLimit {\n   819→\t\t\treturn errStopIteration\n   820→\t\t}\n   821→\t\tcount++\n   822→\n   823→\t\t// On feature branches, skip commits that are reachable from main\n   824→\t\t// (but continue scanning - there may be more feature branch commits)\n   825→\t\tif len(reachableFromMain) > 0 {\n   826→\t\t\tif reachableFromMain[c.Hash] {\n   827→\t\t\t\tconsecutiveMainCount++\n   828→\t\t\t\tif consecutiveMainCount >= consecutiveMainLimit {\n   829→\t\t\t\t\treturn errStopIteration // Likely exhausted feature branch commits\n   830→\t\t\t\t}\n   831→\t\t\t\treturn nil // Skip this commit, continue scanning\n   832→\t\t\t}\n   833→\t\t\tconsecutiveMainCount = 0 // Reset on feature branch commit\n   834→\t\t}\n   835→\n   836→\t\t// Extract checkpoint ID from Entire-Checkpoint trailer\n   837→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   838→\t\tif !found {\n   839→\t\t\treturn nil // No checkpoint trailer, continue\n   840→\t\t}\n   841→\n   842→\t\t// Look up checkpoint info\n   843→\t\tcpInfo, found := committedByID[cpID]\n   844→\t\tif !found {\n   845→\t\t\treturn nil // Checkpoint not in store, continue\n   846→\t\t}\n   847→\n   848→\t\t// Create rewind point from committed info\n   849→\t\tmessage := strings.Split(c.Message, \"\\n\")[0]\n   850→\t\tpoint := strategy.RewindPoint{\n   851→\t\t\tID:               c.Hash.String(),\n   852→\t\t\tMessage:          message,\n   853→\t\t\tDate:             c.Committer.When,\n   854→\t\t\tIsLogsOnly:       true, // Committed checkpoints are logs-only\n   855→\t\t\tCheckpointID:     cpID,\n   856→\t\t\tSessionID:        cpInfo.SessionID,\n   857→\t\t\tIsTaskCheckpoint: cpInfo.IsTask,\n   858→\t\t\tToolUseID:        cpInfo.ToolUseID,\n   859→\t\t\tAgent:            cpInfo.Agent,\n   860→\t\t}\n   861→\t\t// Read session prompt from metadata branch (best-effort)\n   862→\t\tresult, _ := store.ReadCommitted(context.Background(), cpID) //nolint:errcheck  // Best-effort\n   863→\t\tif result != nil {\n   864→\t\t\t// Scope the transcript to this checkpoint's portion\n   865→\t\t\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   866→\t\t\t// lines from that point onwards (excluding earlier checkpoint content)\n   867→\t\t\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   868→\t\t\t// Extract prompts from the scoped transcript (not the full session's prompts)\n   869→\t\t\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   870→\t\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   871→\t\t\t\tpoint.SessionPrompt = scopedPrompts[0]\n   872→\t\t\t}\n   873→\t\t}\n   874→\n   875→\t\tpoints = append(points, point)\n   876→\t\treturn nil\n   877→\t})\n   878→\n   879→\tif err != nil && !errors.Is(err, errStopIteration) {\n   880→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   881→\t}\n   882→\n   883→\t// Get temporary checkpoints from ALL shadow branches whose base commit is reachable from HEAD.\n   884→\ttempPoints := getReachableTemporaryCheckpoints(repo, store, head.Hash(), isOnDefault, limit)\n   885→\tpoints = append(points, tempPoints...)\n   886→\n   887→\t// Sort by date, most recent first\n   888→\tsort.Slice(points, func(i, j int) bool {\n   889→\t\treturn points[i].Date.After(points[j].Date)\n   890→\t})\n   891→\n   892→\t// Apply limit\n   893→\tif len(points) > limit {\n   894→\t\tpoints = points[:limit]\n   895→\t}\n   896→\n   897→\treturn points, nil\n   898→}\n   899→\n   900→// getReachableTemporaryCheckpoints returns temporary checkpoints from shadow branches\n   901→// whose base commit is reachable from the given HEAD hash.\n   902→// For default branches, all shadow branches are included.\n   903→// For feature branches, only shadow branches whose base commit is in HEAD's history are included.\n   904→func getReachableTemporaryCheckpoints(repo *git.Repository, store *checkpoint.GitStore, headHash plumbing.Hash, isOnDefault bool, limit int) []strategy.RewindPoint {\n   905→\tvar points []strategy.RewindPoint\n   906→\n   907→\tshadowBranches, _ := store.ListTemporary(context.Background()) //nolint:errcheck // Best-effort\n   908→\tfor _, sb := range shadowBranches {\n   909→\t\t// Check if this shadow branch's base commit is reachable from current HEAD\n   910→\t\tif !isShadowBranchReachable(repo, sb.BaseCommit, headHash, isOnDefault) {\n   911→\t\t\tcontinue\n   912→\t\t}\n   913→\n   914→\t\t// List checkpoints from this shadow branch\n   915→\t\ttempCheckpoints, _ := store.ListCheckpointsForBranch(context.Background(), sb.BranchName, \"\", limit) //nolint:errcheck // Best-effort\n   916→\t\tfor _, tc := range tempCheckpoints {\n   917→\t\t\tpoint := convertTemporaryCheckpoint(repo, tc)\n   918→\t\t\tif point != nil {\n   919→\t\t\t\tpoints = append(points, *point)\n   920→\t\t\t}\n   921→\t\t}\n   922→\t}\n   923→\n   924→\treturn points\n   925→}\n   926→\n   927→// isShadowBranchReachable checks if a shadow branch's base commit is reachable from HEAD.\n   928→// For default branches, all shadow branches are considered reachable.\n   929→// For feature branches, we check if any commit with the base commit prefix is in HEAD's history.\n   930→func isShadowBranchReachable(repo *git.Repository, baseCommit string, headHash plumbing.Hash, isOnDefault bool) bool {\n   931→\t// For default branch: all shadow branches are potentially relevant\n   932→\tif isOnDefault {\n   933→\t\treturn true\n   934→\t}\n   935→\n   936→\t// Check if base commit hash prefix matches any commit in HEAD's history\n   937→\tbaseCommitIter, baseErr := repo.Log(&git.LogOptions{From: headHash})\n   938→\tif baseErr != nil {\n   939→\t\treturn false\n   940→\t}\n   941→\tdefer baseCommitIter.Close()\n   942→\n   943→\tbaseCount := 0\n   944→\tfound := false\n   945→\t_ = baseCommitIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   946→\t\tbaseCount++\n   947→\t\tif baseCount > commitScanLimit {\n   948→\t\t\treturn errStopIteration\n   949→\t\t}\n   950→\t\tif strings.HasPrefix(c.Hash.String(), baseCommit) {\n   951→\t\t\tfound = true\n   952→\t\t\treturn errStopIteration\n   953→\t\t}\n   954→\t\treturn nil\n   955→\t})\n   956→\n   957→\treturn found\n   958→}\n   959→\n   960→// convertTemporaryCheckpoint converts a TemporaryCheckpointInfo to a RewindPoint.\n   961→// Returns nil if the checkpoint should be skipped (no code changes or can't be read).\n   962→func convertTemporaryCheckpoint(repo *git.Repository, tc checkpoint.TemporaryCheckpointInfo) *strategy.RewindPoint {\n   963→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   964→\tif commitErr != nil {\n   965→\t\treturn nil\n   966→\t}\n   967→\n   968→\t// Filter out checkpoints with no code changes (only .entire/ metadata changed)\n   969→\t// This also filters out the first checkpoint which is just a baseline copy\n   970→\tif !hasCodeChanges(shadowCommit) {\n   971→\t\treturn nil\n   972→\t}\n   973→\n   974→\t// Read session prompt from the shadow branch commit's tree (not from entire/sessions)\n   975→\t// Temporary checkpoints store their metadata in the shadow branch, not in entire/sessions\n   976→\tvar sessionPrompt string\n   977→\tshadowTree, treeErr := shadowCommit.Tree()\n   978→\tif treeErr == nil {\n   979→\t\tsessionPrompt = strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   980→\t}\n   981→\n   982→\treturn &strategy.RewindPoint{\n   983→\t\tID:               tc.CommitHash.String(),\n   984→\t\tMessage:          tc.Message,\n   985→\t\tMetadataDir:      tc.MetadataDir,\n   986→\t\tDate:             tc.Timestamp,\n   987→\t\tIsTaskCheckpoint: tc.IsTaskCheckpoint,\n   988→\t\tToolUseID:        tc.ToolUseID,\n   989→\t\tSessionID:        tc.SessionID,\n   990→\t\tSessionPrompt:    sessionPrompt,\n   991→\t\tIsLogsOnly:       false, // Temporary checkpoints can be fully rewound\n   992→\t}\n   993→}\n   994→\n   995→// runExplainBranchDefault shows all checkpoints on the current branch grouped by date.\n   996→// This is strategy-agnostic - it queries checkpoints directly.\n   997→func runExplainBranchDefault(w io.Writer, noPager bool) error {\n   998→\trepo, err := openRepository()\n   999→\tif err != nil {\n  1000→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1001→\t}\n  1002→\n  1003→\t// Get current branch name\n  1004→\tbranchName := strategy.GetCurrentBranchName(repo)\n  1005→\tif branchName == \"\" {\n  1006→\t\t// Detached HEAD state or unborn HEAD - try to use short commit hash if possible\n  1007→\t\thead, headErr := repo.Head()\n  1008→\t\tif headErr != nil {\n  1009→\t\t\t// Unborn HEAD (no commits yet) - treat as empty history instead of erroring\n  1010→\t\t\tif errors.Is(headErr, plumbing.ErrReferenceNotFound) {\n  1011→\t\t\t\tbranchName = \"HEAD (no commits yet)\"\n  1012→\t\t\t} else {\n  1013→\t\t\t\treturn fmt.Errorf(\"failed to get HEAD: %w\", headErr)\n  1014→\t\t\t}\n  1015→\t\t} else {\n  1016→\t\t\tbranchName = \"HEAD (\" + head.Hash().String()[:7] + \")\"\n  1017→\t\t}\n  1018→\t}\n  1019→\n  1020→\t// Get checkpoints for this branch (strategy-agnostic)\n  1021→\tpoints, err := getBranchCheckpoints(repo, branchCheckpointsLimit)\n  1022→\tif err != nil {\n  1023→\t\t// Log the error but continue with empty list so user sees helpful message\n  1024→\t\tlogging.Warn(context.Background(), \"failed to get branch checkpoints\", \"error\", err)\n  1025→\t\tpoints = nil\n  1026→\t}\n  1027→\n  1028→\t// Format output\n  1029→\toutput := formatBranchCheckpoints(branchName, points)\n  1030→\n  1031→\toutputExplainContent(w, output, noPager)\n  1032→\treturn nil\n  1033→}\n  1034→\n  1035→// outputExplainContent outputs content with optional pager support.\n  1036→func outputExplainContent(w io.Writer, content string, noPager bool) {\n  1037→\tif noPager {\n  1038→\t\tfmt.Fprint(w, content)\n  1039→\t} else {\n  1040→\t\toutputWithPager(w, content)\n  1041→\t}\n  1042→}\n  1043→\n  1044→// runExplainSession explains a specific session.\n  1045→func runExplainSession(w io.Writer, sessionID string, noPager bool) error {\n  1046→\tstrat := GetStrategy()\n  1047→\n  1048→\t// Get session details\n  1049→\tsession, err := strategy.GetSession(sessionID)\n  1050→\tif err != nil {\n  1051→\t\tif errors.Is(err, strategy.ErrNoSession) {\n  1052→\t\t\treturn fmt.Errorf(\"session not found: %s\", sessionID)\n  1053→\t\t}\n  1054→\t\treturn fmt.Errorf(\"failed to get session: %w\", err)\n  1055→\t}\n  1056→\n  1057→\t// Get source ref (metadata branch + commit) for this session\n  1058→\tsourceRef := strat.GetSessionMetadataRef(session.ID)\n  1059→\n  1060→\t// Gather checkpoint details\n  1061→\tcheckpointDetails := gatherCheckpointDetails(strat, session)\n  1062→\n  1063→\t// For strategies like shadow where active sessions may not have checkpoints,\n  1064→\t// try to get the current session transcript directly\n  1065→\tif len(checkpointDetails) == 0 && len(session.Checkpoints) == 0 {\n  1066→\t\tcheckpointDetails = gatherCurrentSessionDetails(strat, session)\n  1067→\t}\n  1068→\n  1069→\t// Format output\n  1070→\toutput := formatSessionInfo(session, sourceRef, checkpointDetails)\n  1071→\n  1072→\t// Output with pager if appropriate\n  1073→\tif noPager {\n  1074→\t\tfmt.Fprint(w, output)\n  1075→\t} else {\n  1076→\t\toutputWithPager(w, output)\n  1077→\t}\n  1078→\n  1079→\treturn nil\n  1080→}\n  1081→\n  1082→// gatherCurrentSessionDetails attempts to get transcript info for sessions without checkpoints.\n  1083→// This handles strategies like shadow where active sessions may not have checkpoint commits.\n  1084→func gatherCurrentSessionDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n  1085→\t// Try to get transcript via GetSessionContext which reads from metadata branch\n  1086→\t// For shadow, we can read the transcript from the same location pattern\n  1087→\tcontextContent := strat.GetSessionContext(session.ID)\n  1088→\tif contextContent == \"\" {\n  1089→\t\treturn nil\n  1090→\t}\n  1091→\n  1092→\t// Parse the context.md to extract the last prompt/summary\n  1093→\t// Context.md typically has sections like \"# Prompt\\n...\\n## Summary\\n...\"\n  1094→\tdetail := checkpointDetail{\n  1095→\t\tIndex:     1,\n  1096→\t\tTimestamp: session.StartTime,\n  1097→\t\tMessage:   \"Current session\",\n  1098→\t}\n  1099→\n  1100→\t// Try to extract prompt and summary from context.md\n  1101→\tlines := strings.Split(contextContent, \"\\n\")\n  1102→\tvar inPrompt, inSummary bool\n  1103→\tvar promptLines, summaryLines []string\n  1104→\n  1105→\tfor _, line := range lines {\n  1106→\t\ttrimmed := strings.TrimSpace(line)\n  1107→\t\tif strings.HasPrefix(trimmed, \"# \") && strings.Contains(strings.ToLower(trimmed), \"prompt\") {\n  1108→\t\t\tinPrompt = true\n  1109→\t\t\tinSummary = false\n  1110→\t\t\tcontinue\n  1111→\t\t}\n  1112→\t\tif strings.HasPrefix(trimmed, \"## \") && strings.Contains(strings.ToLower(trimmed), \"summary\") {\n  1113→\t\t\tinPrompt = false\n  1114→\t\t\tinSummary = true\n  1115→\t\t\tcontinue\n  1116→\t\t}\n  1117→\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"# \") {\n  1118→\t\t\tinPrompt = false\n  1119→\t\t\tinSummary = false\n  1120→\t\t\tcontinue\n  1121→\t\t}\n  1122→\n  1123→\t\tif inPrompt {\n  1124→\t\t\tpromptLines = append(promptLines, line)\n  1125→\t\t} else if inSummary {\n  1126→\t\t\tsummaryLines = append(summaryLines, line)\n  1127→\t\t}\n  1128→\t}\n  1129→\n  1130→\tvar inter interaction\n  1131→\tif len(promptLines) > 0 {\n  1132→\t\tinter.Prompt = strings.TrimSpace(strings.Join(promptLines, \"\\n\"))\n  1133→\t}\n  1134→\tif len(summaryLines) > 0 {\n  1135→\t\tinter.Responses = []string{strings.TrimSpace(strings.Join(summaryLines, \"\\n\"))}\n  1136→\t}\n  1137→\n  1138→\t// If we couldn't parse structured content, show the raw context\n  1139→\tif inter.Prompt == \"\" && len(inter.Responses) == 0 {\n  1140→\t\tinter.Responses = []string{contextContent}\n  1141→\t}\n  1142→\n  1143→\tif inter.Prompt != \"\" || len(inter.Responses) > 0 {\n  1144→\t\tdetail.Interactions = []interaction{inter}\n  1145→\t}\n  1146→\n  1147→\treturn []checkpointDetail{detail}\n  1148→}\n  1149→\n  1150→// gatherCheckpointDetails extracts detailed information for each checkpoint.\n  1151→// Checkpoints come in newest-first order, but we number them oldest=1, newest=N.\n  1152→func gatherCheckpointDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n  1153→\tdetails := make([]checkpointDetail, 0, len(session.Checkpoints))\n  1154→\ttotal := len(session.Checkpoints)\n  1155→\n  1156→\tfor i, cp := range session.Checkpoints {\n  1157→\t\tdetail := checkpointDetail{\n  1158→\t\t\tIndex:            total - i, // Reverse numbering: oldest=1, newest=N\n  1159→\t\t\tTimestamp:        cp.Timestamp,\n  1160→\t\t\tIsTaskCheckpoint: cp.IsTaskCheckpoint,\n  1161→\t\t\tMessage:          cp.Message,\n  1162→\t\t}\n  1163→\n  1164→\t\t// Use checkpoint ID for display (truncate long IDs)\n  1165→\t\tdetail.ShortID = cp.CheckpointID.String()\n  1166→\t\tif len(detail.ShortID) > 12 {\n  1167→\t\t\tdetail.ShortID = detail.ShortID[:12]\n  1168→\t\t}\n  1169→\n  1170→\t\t// Try to get transcript for this checkpoint\n  1171→\t\ttranscriptContent, err := strat.GetCheckpointLog(cp)\n  1172→\t\tif err == nil {\n  1173→\t\t\ttranscript, parseErr := parseTranscriptFromBytes(transcriptContent)\n  1174→\t\t\tif parseErr == nil {\n  1175→\t\t\t\t// Extract all prompt/response pairs from the transcript\n  1176→\t\t\t\tpairs := ExtractAllPromptResponses(transcript)\n  1177→\t\t\t\tfor _, pair := range pairs {\n  1178→\t\t\t\t\tdetail.Interactions = append(detail.Interactions, interaction(pair))\n  1179→\t\t\t\t}\n  1180→\n  1181→\t\t\t\t// Aggregate all files for the checkpoint\n  1182→\t\t\t\tfileSet := make(map[string]bool)\n  1183→\t\t\t\tfor _, pair := range pairs {\n  1184→\t\t\t\t\tfor _, f := range pair.Files {\n  1185→\t\t\t\t\t\tif !fileSet[f] {\n  1186→\t\t\t\t\t\t\tfileSet[f] = true\n  1187→\t\t\t\t\t\t\tdetail.Files = append(detail.Files, f)\n  1188→\t\t\t\t\t\t}\n  1189→\t\t\t\t\t}\n  1190→\t\t\t\t}\n  1191→\t\t\t}\n  1192→\t\t}\n  1193→\n  1194→\t\tdetails = append(details, detail)\n  1195→\t}\n  1196→\n  1197→\treturn details\n  1198→}\n  1199→\n  1200→// runExplainCommit explains a specific commit.\n  1201→func runExplainCommit(w io.Writer, commitRef string) error {\n  1202→\trepo, err := openRepository()\n  1203→\tif err != nil {\n  1204→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1205→\t}\n  1206→\n  1207→\t// Resolve the commit reference\n  1208→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1209→\tif err != nil {\n  1210→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1211→\t}\n  1212→\n  1213→\tcommit, err := repo.CommitObject(*hash)\n  1214→\tif err != nil {\n  1215→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1216→\t}\n  1217→\n  1218→\t// Get files changed in this commit (diff from parent to current)\n  1219→\tvar files []string\n  1220→\tcommitTree, err := commit.Tree()\n  1221→\tif err == nil && commit.NumParents() > 0 {\n  1222→\t\tparent, parentErr := commit.Parent(0)\n  1223→\t\tif parentErr == nil {\n  1224→\t\t\tparentTree, treeErr := parent.Tree()\n  1225→\t\t\tif treeErr == nil {\n  1226→\t\t\t\t// Diff from parent to current commit to show what changed\n  1227→\t\t\t\tchanges, diffErr := parentTree.Diff(commitTree)\n  1228→\t\t\t\tif diffErr == nil {\n  1229→\t\t\t\t\tfor _, change := range changes {\n  1230→\t\t\t\t\t\tname := change.To.Name\n  1231→\t\t\t\t\t\tif name == \"\" {\n  1232→\t\t\t\t\t\t\tname = change.From.Name\n  1233→\t\t\t\t\t\t}\n  1234→\t\t\t\t\t\tfiles = append(files, name)\n  1235→\t\t\t\t\t}\n  1236→\t\t\t\t}\n  1237→\t\t\t}\n  1238→\t\t}\n  1239→\t}\n  1240→\n  1241→\t// Check for Entire metadata - try multiple trailer types\n  1242→\tmetadataDir, hasMetadata := trailers.ParseMetadata(commit.Message)\n  1243→\tsessionID, hasSession := trailers.ParseSession(commit.Message)\n  1244→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1245→\n  1246→\t// If no session trailer, try to extract from metadata path.\n  1247→\t// Note: extractSessionIDFromMetadata is defined in rewind.go as it's used\n  1248→\t// by both the rewind and explain commands for parsing metadata paths.\n  1249→\tif !hasSession && hasMetadata {\n  1250→\t\tsessionID = extractSessionIDFromMetadata(metadataDir)\n  1251→\t\thasSession = sessionID != \"\"\n  1252→\t}\n  1253→\n  1254→\t// Build commit info\n  1255→\tfullSHA := hash.String()\n  1256→\tshortSHA := fullSHA\n  1257→\tif len(fullSHA) >= 7 {\n  1258→\t\tshortSHA = fullSHA[:7]\n  1259→\t}\n  1260→\n  1261→\tinfo := &commitInfo{\n  1262→\t\tSHA:       fullSHA,\n  1263→\t\tShortSHA:  shortSHA,\n  1264→\t\tMessage:   strings.Split(commit.Message, \"\\n\")[0], // First line only\n  1265→\t\tAuthor:    commit.Author.Name,\n  1266→\t\tEmail:     commit.Author.Email,\n  1267→\t\tDate:      commit.Author.When,\n  1268→\t\tFiles:     files,\n  1269→\t\tHasEntire: hasMetadata || hasSession || hasCheckpoint,\n  1270→\t\tSessionID: sessionID,\n  1271→\t}\n  1272→\n  1273→\t// If we have a checkpoint ID but no session, try to look up session from metadata\n  1274→\tif hasCheckpoint && sessionID == \"\" {\n  1275→\t\tif result, err := checkpoint.NewGitStore(repo).ReadCommitted(context.Background(), checkpointID); err == nil && result != nil {\n  1276→\t\t\tinfo.SessionID = result.Metadata.SessionID\n  1277→\t\t}\n  1278→\t}\n  1279→\n  1280→\t// Format and output\n  1281→\toutput := formatCommitInfo(info)\n  1282→\tfmt.Fprint(w, output)\n  1283→\n  1284→\treturn nil\n  1285→}\n  1286→\n  1287→// formatSessionInfo formats session information for display.\n  1288→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1289→\tvar sb strings.Builder\n  1290→\n  1291→\t// Session header\n  1292→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1293→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1294→\n  1295→\tif !session.StartTime.IsZero() {\n  1296→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1297→\t}\n  1298→\n  1299→\tif sourceRef != \"\" {\n  1300→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1301→\t}\n  1302→\n  1303→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1304→\n  1305→\t// Checkpoint details\n  1306→\tfor _, cp := range checkpoints {\n  1307→\t\tsb.WriteString(\"\\n\")\n  1308→\n  1309→\t\t// Checkpoint header\n  1310→\t\ttaskMarker := \"\"\n  1311→\t\tif cp.IsTaskCheckpoint {\n  1312→\t\t\ttaskMarker = \" [Task]\"\n  1313→\t\t}\n  1314→\t\tfmt.Fprintf(&sb, \"─── Checkpoint %d [%s] %s%s ───\\n\",\n  1315→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker)\n  1316→\t\tsb.WriteString(\"\\n\")\n  1317→\n  1318→\t\t// Display all interactions in this checkpoint\n  1319→\t\tfor i, inter := range cp.Interactions {\n  1320→\t\t\t// For multiple interactions, add a sub-header\n  1321→\t\t\tif len(cp.Interactions) > 1 {\n  1322→\t\t\t\tfmt.Fprintf(&sb, \"### Interaction %d\\n\\n\", i+1)\n  1323→\t\t\t}\n  1324→\n  1325→\t\t\t// Prompt section\n  1326→\t\t\tif inter.Prompt != \"\" {\n  1327→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n  1328→\t\t\t\tsb.WriteString(inter.Prompt)\n  1329→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1330→\t\t\t}\n  1331→\n  1332→\t\t\t// Response section\n  1333→\t\t\tif len(inter.Responses) > 0 {\n  1334→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n  1335→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n  1336→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1337→\t\t\t}\n  1338→\n  1339→\t\t\t// Files modified for this interaction\n  1340→\t\t\tif len(inter.Files) > 0 {\n  1341→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(inter.Files))\n  1342→\t\t\t\tfor _, file := range inter.Files {\n  1343→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1344→\t\t\t\t}\n  1345→\t\t\t\tsb.WriteString(\"\\n\")\n  1346→\t\t\t}\n  1347→\t\t}\n  1348→\n  1349→\t\t// If no interactions, show message and/or files\n  1350→\t\tif len(cp.Interactions) == 0 {\n  1351→\t\t\t// Show commit message as summary when no transcript available\n  1352→\t\t\tif cp.Message != \"\" {\n  1353→\t\t\t\tsb.WriteString(cp.Message)\n  1354→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1355→\t\t\t}\n  1356→\t\t\t// Show aggregate files if available\n  1357→\t\t\tif len(cp.Files) > 0 {\n  1358→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(cp.Files))\n  1359→\t\t\t\tfor _, file := range cp.Files {\n  1360→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1361→\t\t\t\t}\n  1362→\t\t\t}\n  1363→\t\t}\n  1364→\t}\n  1365→\n  1366→\treturn sb.String()\n  1367→}\n  1368→\n  1369→// formatCommitInfo formats commit information for display.\n  1370→func formatCommitInfo(info *commitInfo) string {\n  1371→\tvar sb strings.Builder\n  1372→\n  1373→\tfmt.Fprintf(&sb, \"Commit: %s (%s)\\n\", info.SHA, info.ShortSHA)\n  1374→\tfmt.Fprintf(&sb, \"Date: %s\\n\", info.Date.Format(\"2006-01-02 15:04:05\"))\n  1375→\n  1376→\tif info.HasEntire && info.SessionID != \"\" {\n  1377→\t\tfmt.Fprintf(&sb, \"Session: %s\\n\", info.SessionID)\n  1378→\t}\n  1379→\n  1380→\tsb.WriteString(\"\\n\")\n  1381→\n  1382→\t// Message\n  1383→\tsb.WriteString(\"Message:\\n\")\n  1384→\tfmt.Fprintf(&sb, \"  %s\\n\", info.Message)\n  1385→\tsb.WriteString(\"\\n\")\n  1386→\n  1387→\t// Files modified\n  1388→\tif len(info.Files) > 0 {\n  1389→\t\tfmt.Fprintf(&sb, \"Files Modi