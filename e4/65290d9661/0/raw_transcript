→}\n   189→\n   190→// readCheckpointMetadata reads metadata.json from the metadata branch for a checkpoint.\n   191→func readCheckpointMetadata(t *testing.T, repo *git.Repository, checkpointID id.CheckpointID) CommittedMetadata {\n   192→\tt.Helper()\n   193→\n   194→\tref, err := repo.Reference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), true)\n   195→\tif err != nil {\n   196→\t\tt.Fatalf(\"failed to get metadata branch reference: %v\", err)\n   197→\t}\n   198→\n   199→\tcommit, err := repo.CommitObject(ref.Hash())\n   200→\tif err != nil {\n   201→\t\tt.Fatalf(\"failed to get commit object: %v\", err)\n   202→\t}\n   203→\n   204→\ttree, err := commit.Tree()\n   205→\tif err != nil {\n   206→\t\tt.Fatalf(\"failed to get tree: %v\", err)\n   207→\t}\n   208→\n   209→\tmetadataPath := checkpointID.Path() + \"/\" + paths.MetadataFileName\n   210→\tmetadataFile, err := tree.File(metadataPath)\n   211→\tif err != nil {\n   212→\t\tt.Fatalf(\"failed to find metadata.json: %v\", err)\n   213→\t}\n   214→\n   215→\tcontent, err := metadataFile.Contents()\n   216→\tif err != nil {\n   217→\t\tt.Fatalf(\"failed to read metadata.json: %v\", err)\n   218→\t}\n   219→\n   220→\tvar metadata CommittedMetadata\n   221→\tif err := json.Unmarshal([]byte(content), &metadata); err != nil {\n   222→\t\tt.Fatalf(\"failed to parse metadata.json: %v\", err)\n   223→\t}\n   224→\n   225→\treturn metadata\n   226→}\n   227→\n   228→func TestWriteCommitted_AgentsArray_SingleSession(t *testing.T) {\n   229→\trepo, _ := setupBranchTestRepo(t)\n   230→\tstore := NewGitStore(repo)\n   231→\tcheckpointID := id.MustCheckpointID(\"c1d2e3f4a5b6\")\n   232→\n   233→\terr := store.WriteCommitted(context.Background(), WriteCommittedOptions{\n   234→\t\tCheckpointID: checkpointID,\n   235→\t\tSessionID:    \"test-session-single\",\n   236→\t\tStrategy:     \"auto-commit\",\n   237→\t\tAgent:        agent.AgentTypeGemini,\n   238→\t\tTranscript:   []byte(\"test transcript\"),\n   239→