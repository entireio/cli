 if a summary already exists (requires --generate)\n    90→\n    91→Note: --session filters the list view; --commit and --checkpoint are mutually exclusive.`,\n    92→\t\tArgs: func(_ *cobra.Command, args []string) error {\n    93→\t\t\tif len(args) > 0 {\n    94→\t\t\t\treturn fmt.Errorf(\"unexpected argument %q\\nHint: use --checkpoint, --session, or --commit to specify what to explain\", args[0])\n    95→\t\t\t}\n    96→\t\t\treturn nil\n    97→\t\t},\n    98→\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n    99→\t\t\t// Check if Entire is disabled\n   100→\t\t\tif checkDisabledGuard(cmd.OutOrStdout()) {\n   101→\t\t\t\treturn nil\n   102→\t\t\t}\n   103→\n   104→\t\t\t// Validate flag dependencies\n   105→\t\t\tif generateFlag && checkpointFlag == \"\" {\n   106→\t\t\t\treturn errors.New(\"--generate requires --checkpoint/-c flag\")\n   107→\t\t\t}\n   108→\t\t\tif forceFlag && !generateFlag {\n   109→\t\t\t\treturn errors.New(\"--force requires --generate flag\")\n   110→\t\t\t}\n   111→\t\t\tif rawTranscriptFlag && checkpointFlag == \"\" {\n   112→\t\t\t\treturn errors.New(\"--raw-transcript requires --checkpoint/-c flag\")\n   113→\t\t\t}\n   114→\n   115→\t\t\t// Convert short flag to verbose (verbose = !short)\n   116→\t\t\tverbose := !shortFlag\n   117→\t\t\treturn runExplain(cmd.OutOrStdout(), cmd.ErrOrStderr(), sessionFlag, commitFlag, checkpointFlag, noPagerFlag, verbose, fullFlag, rawTranscriptFlag, generateFlag, forceFlag, searchAllFlag)\n   118→\t\t},\n   119→\t}\n   120→\n   121→\tcmd.Flags().StringVar(&sessionFlag, \"session\", \"\", \"Filter checkpoints by session ID (or prefix)\")\n   122→\tcmd.Flags().StringVar(&commitFlag, \"commit\", \"\", \"Explain a specific commit (SHA or ref)\")\n   123→\tcmd.Flags().StringVarP(&checkpointFlag, \"checkpoint\", \"c\", \"\", \"Explain a specific checkpoint (ID or prefix)\")\n   124→\tcmd.Flags().BoolVar(&noPagerFlag, \"no-pager\", false, \"Disable pager output\")\n   125→\tcmd.Flags().BoolVarP(&shortFlag, \"short\", \"s\", false, \"Show summary only (omit prompts and files)\")\n   126→\tcmd.Flags().BoolVar(&fullFlag, \"full\", false, \"Show parsed full transcript (all prompts/responses)\")\n   127→\tcmd.Flags().BoolVar(&rawTranscriptFlag, \"raw-transcript\", false, \"Show raw transcript file (JSONL format)\")\n   128→\tcmd.Flags().BoolVar(&generateFlag, \"generate\", false, \"Generate an AI summary for the checkpoint\")\n   129→\tcmd.Flags().BoolVar(&forceFlag, \"force\", false, \"Regenerate summary even if one already exists (requires --generate)\")\n   130→\tcmd.Flags().BoolVar(&searchAllFlag, \"search-all\", false, \"Search all commits (no branch/depth limit, may be slow)\")\n   131→\n   132→\t// Make --short, --full, and --raw-transcript mutually exclusive\n   133→\tcmd.MarkFlagsMutuallyExclusive(\"short\", \"full\", \"raw-transcript\")\n   134→\t// --generate and --raw-transcript are incompatible (summary would be generated but not shown)\n   135→\tcmd.MarkFlagsMutuallyExclusive(\"generate\", \"raw-transcript\")\n   136→\n   137→\treturn cmd\n   138→}\n   139→\n   140→// runExplain routes to the appropriate explain function based on flags.\n   141→func runExplain(w, errW io.Writer, sessionID, commitRef, checkpointID string, noPager, verbose, full, rawTranscript, generate, force, searchAll bool) error {\n   142→\t// Count mutually exclusive flags (--commit and --checkpoint are mutually exclusive)\n   143→\t// --session is now a filter for the list view, not a separate mode\n   144→\tflagCount := 0\n   145→\tif commitRef != \"\" {\n   146→\t\tflagCount++\n   147→\t}\n   148→\tif checkpointID != \"\" {\n   149→\t\tflagCount++\n   150→\t}\n   151→\t// If --session is combined with --commit or --checkpoint, that's still an error\n   152→\tif sessionID != \"\" && flagCount > 0 {\n   153→\t\treturn errors.New(\"cannot specify multiple of --session, --commit, --checkpoint\")\n   154→\t}\n   155→\tif flagCount > 1 {\n   156→\t\treturn errors.New(\"cannot specify multiple of --session, --commit, --checkpoint\")\n   157→\t}\n   158→\n   159→\t// Route to appropriate handler\n   160→\tif commitRef != \"\" {\n   161→\t\treturn runExplainCommit(w, commitRef, noPager, verbose, full, searchAll)\n   162→\t}\n   163→\tif checkpointID != \"\" {\n   164→\t\treturn runExplainCheckpoint(w, errW, checkpointID, noPager, verbose, full, rawTranscript, generate, force, searchAll)\n   165→\t}\n   166→\n   167→\t// Default or with session filter: show list view (optionally filtered by session)\n   168→\treturn runExplainBranchWithFilter(w, noPager, sessionID)\n   169→}\n   170→\n   171→// runExplainCheckpoint explains a specific checkpoint.\n   172→// Supports both committed checkpoints (by checkpoint ID) and temporary checkpoints (by git SHA).\n   173→// First tries to match committed checkpoints, then falls back to temporary checkpoints.\n   174→// When generate is true, generates an AI summary for the checkpoint.\n   175→// When force is true, regenerates even if a summary already exists.\n   176→// When rawTranscript is true, outputs only the raw transcript file (JSONL format).\n   177→// When searchAll is true, searches all commits without branch/depth limits (used for finding associated commits).\n   178→//\n   179→//nolint:revive,unparam // searchAll parameter will be used in Task 5 (associated commits feature)\n   180→func runExplainCheckpoint(w, errW io.Writer, checkpointIDPrefix string, noPager, verbose, full, rawTranscript, generate, force, searchAll bool) error {\n   181→\trepo, err := openRepository()\n   182→\tif err != nil {\n   183→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   184→\t}\n   185→\n   186→\tstore := checkpoint.NewGitStore(repo)\n   187→\n   188→\t// First, try to find in committed checkpoints by checkpoint ID prefix\n   189→\tcommitted, err := store.ListCommitted(context.Background())\n   190→\tif err != nil {\n   191→\t\treturn fmt.Errorf(\"failed to list checkpoints: %w\", err)\n   192→\t}\n   193→\n   194→\t// Collect all matching checkpoint IDs to detect ambiguity\n   195→\tvar matches []id.CheckpointID\n   196→\tfor _, info := range committed {\n   197→\t\tif strings.HasPrefix(info.CheckpointID.String(), checkpointIDPrefix) {\n   198→\t\t\tmatches = append(matches, info.CheckpointID)\n   199→\t\t}\n   200→\t}\n   201→\n   202→\tvar fullCheckpointID id.CheckpointID\n   203→\tswitch len(matches) {\n   204→\tcase 0:\n   205→\t\t// Not found in committed, try temporary checkpoints by git SHA\n   206→\t\tif generate {\n   207→\t\t\treturn fmt.Errorf(\"cannot generate summary for temporary checkpoint %s (only committed checkpoints supported)\", checkpointIDPrefix)\n   208→\t\t}\n   209→\t\toutput, found := explainTemporaryCheckpoint(w, repo, store, checkpointIDPrefix, verbose, full, rawTranscript)\n   210→\t\tif found {\n   211→\t\t\toutputExplainContent(w, output, noPager)\n   212→\t\t\treturn nil\n   213→\t\t}\n   214→\t\t// If output is non-empty, it contains an error message (e.g., ambiguous prefix)\n   215→\t\tif output != \"\" {\n   216→\t\t\treturn errors.New(output)\n   217→\t\t}\n   218→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", checkpointIDPrefix)\n   219→\tcase 1:\n   220→\t\tfullCheckpointID = matches[0]\n   221→\tdefault:\n   222→\t\t// Ambiguous prefix - show up to 5 examples\n   223→\t\texamples := make([]string, 0, 5)\n   224→\t\tfor i := 0; i < len(matches) && i < 5; i++ {\n   225→\t\t\texamples = append(examples, matches[i].String())\n   226→\t\t}\n   227→\t\treturn fmt.Errorf(\"ambiguous checkpoint prefix %q matches %d checkpoints: %s\", checkpointIDPrefix, len(matches), strings.Join(examples, \", \"))\n   228→\t}\n   229→\n   230→\t// Load checkpoint data\n   231→\tresult, err := store.ReadCommitted(context.Background(), fullCheckpointID)\n   232→\tif err != nil {\n   233→\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   234→\t}\n   235→\tif result == nil {\n   236→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", fullCheckpointID)\n   237→\t}\n   238→\n   239→\t// Handle summary generation\n   240→\tif generate {\n   241→\t\tif err := generateCheckpointSummary(w, errW, store, fullCheckpointID, result, force); err != nil {\n   242→\t\t\treturn err\n   243→\t\t}\n   244→\t\t// Reload the result to get the updated summary\n   245→\t\tresult, err = store.ReadCommitted(context.Background(), fullCheckpointID)\n   246→\t\tif err != nil {\n   247→\t\t\treturn fmt.Errorf(\"failed to reload checkpoint: %w\", err)\n   248→\t\t}\n   249→\t\tif result == nil {\n   250→\t\t\treturn fmt.Errorf(\"checkpoint not found after save: %s\", fullCheckpointID)\n   251→\t\t}\n   252→\t}\n   253→\n   254→\t// Handle raw transcript output\n   255→\tif rawTranscript {\n   256→\t\tif len(result.Transcript) == 0 {\n   257→\t\t\treturn fmt.Errorf(\"checkpoint %s has no transcript\", fullCheckpointID)\n   258→\t\t}\n   259→\t\t// Output raw transcript directly (no pager, no formatting)\n   260→\t\tif _, err = w.Write(result.Transcript); err != nil {\n   261→\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n   262→\t\t}\n   263→\t\treturn nil\n   264→\t}\n   265→\n   266→\t// Look up the commit message for this checkpoint\n   267→\tcommitMessage := findCommitMessageForCheckpoint(repo, fullCheckpointID)\n   268→\n   269→\t// Format and output\n   270→\toutput := formatCheckpointOutput(result, fullCheckpointID, commitMessage, verbose, full)\n   271→\toutputExplainContent(w, output, noPager)\n   272→\treturn nil\n   273→}\n   274→\n   275→// generateCheckpointSummary generates an AI summary for a checkpoint and persists it.\n   276→// The summary is generated from the scoped transcript (only this checkpoint's portion),\n   277→// not the entire session transcript.\n   278→func generateCheckpointSummary(w, _ io.Writer, store *checkpoint.GitStore, checkpointID id.CheckpointID, result *checkpoint.ReadCommittedResult, force bool) error {\n   279→\t// Check if summary already exists\n   280→\tif result.Metadata.Summary != nil && !force {\n   281→\t\treturn fmt.Errorf(\"checkpoint %s already has a summary (use --force to regenerate)\", checkpointID)\n   282→\t}\n   283→\n   284→\t// Check if transcript exists\n   285→\tif len(result.Transcript) == 0 {\n   286→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript to summarise\", checkpointID)\n   287→\t}\n   288→\n   289→\t// Scope the transcript to only this checkpoint's portion\n   290→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   291→\tif len(scopedTranscript) == 0 {\n   292→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript content for this checkpoint (scoped)\", checkpointID)\n   293→\t}\n   294→\n   295→\t// Build condensed transcript for summarisation from the scoped portion\n   296→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(scopedTranscript)\n   297→\tif err != nil {\n   298→\t\treturn fmt.Errorf(\"failed to parse transcript: %w\", err)\n   299→\t}\n   300→\tif len(condensed) == 0 {\n   301→\t\treturn fmt.Errorf(\"checkpoint %s transcript has no content to summarise\", checkpointID)\n   302→\t}\n   303→\n   304→\tinput := summarise.Input{\n   305→\t\tTranscript:   condensed,\n   306→\t\tFilesTouched: result.Metadata.FilesTouched,\n   307→\t}\n   308→\n   309→\t// Generate summary using Claude CLI\n   310→\tctx := context.Background()\n   311→\tlogging.Info(ctx, \"generating checkpoint summary\")\n   312→\n   313→\tvar generator summarise.Generator = &summarise.ClaudeGenerator{}\n   314→\tsummary, err := generator.Generate(ctx, input)\n   315→\tif err != nil {\n   316→\t\treturn fmt.Errorf(\"failed to generate summary: %w\", err)\n   317→\t}\n   318→\n   319→\t// Persist the summary\n   320→\tif err := store.UpdateSummary(ctx, checkpointID, summary); err != nil {\n   321→\t\treturn fmt.Errorf(\"failed to save summary: %w\", err)\n   322→\t}\n   323→\n   324→\tfmt.Fprintln(w, \"✓ Summary generated and saved\")\n   325→\treturn nil\n   326→}\n   327→\n   328→// explainTemporaryCheckpoint finds and formats a temporary checkpoint by shadow commit hash prefix.\n   329→// Returns the formatted output and whether the checkpoint was found.\n   330→// Searches ALL shadow branches, not just the one for current HEAD, to find checkpoints\n   331→// created from different base commits (e.g., if HEAD advanced since session start).\n   332→// The writer w is used for raw transcript output to bypass the pager.\n   333→func explainTemporaryCheckpoint(w io.Writer, repo *git.Repository, store *checkpoint.GitStore, shaPrefix string, verbose, full, rawTranscript bool) (string, bool) {\n   334→\t// List temporary checkpoints from ALL shadow branches\n   335→\t// This ensures we find checkpoints even if HEAD has advanced since the session started\n   336→\ttempCheckpoints, err := store.ListAllTemporaryCheckpoints(context.Background(), \"\", branchCheckpointsLimit)\n   337→\tif err != nil {\n   338→\t\treturn \"\", false\n   339→\t}\n   340→\n   341→\t// Find checkpoints matching the SHA prefix - check for ambiguity\n   342→\tvar matches []checkpoint.TemporaryCheckpointInfo\n   343→\tfor _, tc := range tempCheckpoints {\n   344→\t\tif strings.HasPrefix(tc.CommitHash.String(), shaPrefix) {\n   345→\t\t\tmatches = append(matches, tc)\n   346→\t\t}\n   347→\t}\n   348→\n   349→\tif len(matches) == 0 {\n   350→\t\treturn \"\", false\n   351→\t}\n   352→\n   353→\tif len(matches) > 1 {\n   354→\t\t// Multiple matches - return ambiguous error (consistent with committed checkpoint behavior)\n   355→\t\tvar sb strings.Builder\n   356→\t\tfmt.Fprintf(&sb, \"ambiguous checkpoint prefix %q matches %d temporary checkpoints:\\n\", shaPrefix, len(matches))\n   357→\t\tfor _, m := range matches {\n   358→\t\t\tshortID := m.CommitHash.String()[:7]\n   359→\t\t\tfmt.Fprintf(&sb, \"  %s  %s  session %s\\n\",\n   360→\t\t\t\tshortID,\n   361→\t\t\t\tm.Timestamp.Format(\"2006-01-02 15:04:05\"),\n   362→\t\t\t\tm.SessionID)\n   363→\t\t}\n   364→\t\t// Return as \"not found\" with error message - caller will use this as error\n   365→\t\treturn sb.String(), false\n   366→\t}\n   367→\n   368→\ttc := matches[0]\n   369→\n   370→\t// Handle raw transcript output\n   371→\tif rawTranscript {\n   372→\t\ttranscriptBytes, transcriptErr := store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown)\n   373→\t\tif transcriptErr != nil || len(transcriptBytes) == 0 {\n   374→\t\t\t// Return specific error message (consistent with committed checkpoints)\n   375→\t\t\treturn fmt.Sprintf(\"checkpoint %s has no transcript\", tc.CommitHash.String()[:7]), false\n   376→\t\t}\n   377→\t\t// Write directly to writer (no pager, no formatting) - matches committed checkpoint behavior\n   378→\t\tif _, writeErr := fmt.Fprint(w, string(transcriptBytes)); writeErr != nil {\n   379→\t\t\treturn fmt.Sprintf(\"failed to write transcript: %v\", writeErr), false\n   380→\t\t}\n   381→\t\treturn \"\", true\n   382→\t}\n   383→\n   384→\t// Found exactly one match - read metadata from shadow branch commit tree\n   385→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   386→\tif commitErr != nil {\n   387→\t\treturn \"\", false\n   388→\t}\n   389→\n   390→\tshadowTree, treeErr := shadowCommit.Tree()\n   391→\tif treeErr != nil {\n   392→\t\treturn \"\", false\n   393→\t}\n   394→\n   395→\t// Read prompts from shadow branch\n   396→\tsessionPrompt := strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   397→\n   398→\t// Build output similar to formatCheckpointOutput but for temporary\n   399→\tvar sb strings.Builder\n   400→\tshortID := tc.CommitHash.String()[:7]\n   401→\tfmt.Fprintf(&sb, \"Checkpoint: %s [temporary]\\n\", shortID)\n   402→\tfmt.Fprintf(&sb, \"Session: %s\\n\", tc.SessionID)\n   403→\tfmt.Fprintf(&sb, \"Created: %s\\n\", tc.Timestamp.Format(\"2006-01-02 15:04:05\"))\n   404→\tsb.WriteString(\"\\n\")\n   405→\n   406→\t// Intent from prompt\n   407→\tintent := \"(not available)\"\n   408→\tif sessionPrompt != \"\" {\n   409→\t\tlines := strings.Split(sessionPrompt, \"\\n\")\n   410→\t\tif len(lines) > 0 && lines[0] != \"\" {\n   411→\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   412→\t\t}\n   413→\t}\n   414→\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   415→\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   416→\n   417→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   418→\t// For temporary checkpoints, load transcript and compute scope from parent commit\n   419→\tvar fullTranscript []byte\n   420→\tvar scopedTranscript []byte\n   421→\tif full || verbose {\n   422→\t\tfullTranscript, _ = store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   423→\n   424→\t\tif verbose && len(fullTranscript) > 0 {\n   425→\t\t\t// Compute scoped transcript by finding where parent's transcript ended\n   426→\t\t\t// Each shadow branch commit has the full transcript up to that point,\n   427→\t\t\t// so we diff against parent to get just this checkpoint's activity\n   428→\t\t\tscopedTranscript = fullTranscript // Default to full if no parent\n   429→\t\t\tif shadowCommit.NumParents() > 0 {\n   430→\t\t\t\tif parent, parentErr := shadowCommit.Parent(0); parentErr == nil {\n   431→\t\t\t\t\tparentTranscript, _ := store.GetTranscriptFromCommit(parent.Hash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   432→\t\t\t\t\tif len(parentTranscript) > 0 {\n   433→\t\t\t\t\t\t// Count lines in parent transcript to know where to slice from\n   434→\t\t\t\t\t\tparentLineCount := countLines(parentTranscript)\n   435→\t\t\t\t\t\tscopedTranscript = transcript.SliceFromLine(fullTranscript, parentLineCount)\n   436→\t\t\t\t\t}\n   437→\t\t\t\t}\n   438→\t\t\t}\n   439→\t\t}\n   440→\t}\n   441→\tappendTranscriptSection(&sb, verbose, full, fullTranscript, scopedTranscript, sessionPrompt)\n   442→\n   443→\treturn sb.String(), true\n   444→}\n   445→\n   446→// findCommitMessageForCheckpoint searches git history for a commit with the\n   447→// Entire-Checkpoint trailer matching the given checkpoint ID, and returns\n   448→// the first line of the commit message. Returns empty string if not found.\n   449→func findCommitMessageForCheckpoint(repo *git.Repository, checkpointID id.CheckpointID) string {\n   450→\t// Get HEAD reference\n   451→\thead, err := repo.Head()\n   452→\tif err != nil {\n   453→\t\treturn \"\"\n   454→\t}\n   455→\n   456→\t// Iterate through commit history (limit to recent commits for performance)\n   457→\tcommitIter, err := repo.Log(&git.LogOptions{\n   458→\t\tFrom: head.Hash(),\n   459→\t})\n   460→\tif err != nil {\n   461→\t\treturn \"\"\n   462→\t}\n   463→\tdefer commitIter.Close()\n   464→\n   465→\tcount := 0\n   466→\n   467→\tfor {\n   468→\t\tcommit, iterErr := commitIter.Next()\n   469→\t\tif iterErr != nil {\n   470→\t\t\tbreak\n   471→\t\t}\n   472→\t\tcount++\n   473→\t\tif count > commitScanLimit {\n   474→\t\t\tbreak\n   475→\t\t}\n   476→\n   477→\t\t// Check if this commit has our checkpoint ID\n   478→\t\tfoundID, hasTrailer := trailers.ParseCheckpoint(commit.Message)\n   479→\t\tif hasTrailer && foundID == checkpointID {\n   480→\t\t\t// Return first line of commit message (without trailing newline)\n   481→\t\t\tfirstLine := strings.Split(commit.Message, \"\\n\")[0]\n   482→\t\t\treturn strings.TrimSpace(firstLine)\n   483→\t\t}\n   484→\t}\n   485→\n   486→\treturn \"\"\n   487→}\n   488→\n   489→// scopeTranscriptForCheckpoint slices a transcript to include only the lines\n   490→// relevant to a specific checkpoint, starting from linesAtStart.\n   491→// This allows showing only what happened during a checkpoint, not the entire session.\n   492→func scopeTranscriptForCheckpoint(fullTranscript []byte, linesAtStart int) []byte {\n   493→\treturn transcript.SliceFromLine(fullTranscript, linesAtStart)\n   494→}\n   495→\n   496→// extractPromptsFromTranscript extracts user prompts from transcript bytes.\n   497→// Returns a slice of prompt strings.\n   498→func extractPromptsFromTranscript(transcriptBytes []byte) []string {\n   499→\tif len(transcriptBytes) == 0 {\n   500→\t\treturn nil\n   501→\t}\n   502→\n   503→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   504→\tif err != nil {\n   505→\t\treturn nil\n   506→\t}\n   507→\n   508→\tvar prompts []string\n   509→\tfor _, entry := range condensed {\n   510→\t\tif entry.Type == summarise.EntryTypeUser && entry.Content != \"\" {\n   511→\t\t\tprompts = append(prompts, entry.Content)\n   512→\t\t}\n   513→\t}\n   514→\treturn prompts\n   515→}\n   516→\n   517→// formatCheckpointOutput formats checkpoint data based on verbosity level.\n   518→// When verbose is false: summary only (ID, session, timestamp, tokens, intent).\n   519→// When verbose is true: adds files, commit message, and scoped transcript for this checkpoint.\n   520→// When full is true: shows parsed full session transcript instead of scoped transcript.\n   521→//\n   522→// Transcript scope is controlled by TranscriptLinesAtStart in metadata, which indicates\n   523→// where this checkpoint's content begins in the full session transcript.\n   524→func formatCheckpointOutput(result *checkpoint.ReadCommittedResult, checkpointID id.CheckpointID, commitMessage string, verbose, full bool) string {\n   525→\tvar sb strings.Builder\n   526→\tmeta := result.Metadata\n   527→\n   528→\t// Scope the transcript to this checkpoint's portion\n   529→\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   530→\t// lines from that point onwards (excluding earlier checkpoint content)\n   531→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, meta.TranscriptLinesAtStart)\n   532→\n   533→\t// Extract prompts from the scoped transcript for intent extraction\n   534→\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   535→\n   536→\t// Header - always shown\n   537→\t// Note: CheckpointID is always exactly 12 characters, matching checkpointIDDisplayLength\n   538→\tfmt.Fprintf(&sb, \"Checkpoint: %s\\n\", checkpointID)\n   539→\tfmt.Fprintf(&sb, \"Session: %s\\n\", meta.SessionID)\n   540→\tfmt.Fprintf(&sb, \"Created: %s\\n\", meta.CreatedAt.Format(\"2006-01-02 15:04:05\"))\n   541→\n   542→\t// Token usage\n   543→\tif meta.TokenUsage != nil {\n   544→\t\ttotalTokens := meta.TokenUsage.InputTokens + meta.TokenUsage.CacheCreationTokens +\n   545→\t\t\tmeta.TokenUsage.CacheReadTokens + meta.TokenUsage.OutputTokens\n   546→\t\tfmt.Fprintf(&sb, \"Tokens: %d\\n\", totalTokens)\n   547→\t}\n   548→\n   549→\tsb.WriteString(\"\\n\")\n   550→\n   551→\t// Intent and Outcome from AI summary, or fallback to prompt text\n   552→\tif meta.Summary != nil {\n   553→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", meta.Summary.Intent)\n   554→\t\tfmt.Fprintf(&sb, \"Outcome: %s\\n\", meta.Summary.Outcome)\n   555→\t} else {\n   556→\t\t// Fallback: use first line of scoped prompts for intent,\n   557→\t\t// or fall back to result.Prompts for backwards compatibility with older checkpoints\n   558→\t\tintent := \"(not generated)\"\n   559→\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   560→\t\t\tintent = strategy.TruncateDescription(scopedPrompts[0], maxIntentDisplayLength)\n   561→\t\t} else if result.Prompts != \"\" {\n   562→\t\t\t// Backwards compatibility: use stored prompts if no transcript available\n   563→\t\t\tlines := strings.Split(result.Prompts, \"\\n\")\n   564→\t\t\tif len(lines) > 0 && lines[0] != \"\" {\n   565→\t\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   566→\t\t\t}\n   567→\t\t}\n   568→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   569→\t\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   570→\t}\n   571→\n   572→\t// Verbose: add commit message, learnings, friction, files, and scoped transcript\n   573→\tif verbose || full {\n   574→\t\t// AI Summary details (learnings, friction, open items)\n   575→\t\tif meta.Summary != nil {\n   576→\t\t\tformatSummaryDetails(&sb, meta.Summary)\n   577→\t\t}\n   578→\n   579→\t\t// Commit message section (only if available)\n   580→\t\tif commitMessage != \"\" {\n   581→\t\t\tsb.WriteString(\"\\n\")\n   582→\t\t\tfmt.Fprintf(&sb, \"Commit: %s\\n\", commitMessage)\n   583→\t\t}\n   584→\n   585→\t\tsb.WriteString(\"\\n\")\n   586→\n   587→\t\t// Files section\n   588→\t\tif len(meta.FilesTouched) > 0 {\n   589→\t\t\tfmt.Fprintf(&sb, \"Files: (%d)\\n\", len(meta.FilesTouched))\n   590→\t\t\tfor _, file := range meta.FilesTouched {\n   591→\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n   592→\t\t\t}\n   593→\t\t} else {\n   594→\t\t\tsb.WriteString(\"Files: (none)\\n\")\n   595→\t\t}\n   596→\t}\n   597→\n   598→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   599→\tappendTranscriptSection(&sb, verbose, full, result.Transcript, scopedTranscript, result.Prompts)\n   600→\n   601→\treturn sb.String()\n   602→}\n   603→\n   604→// appendTranscriptSection appends the appropriate transcript section to the builder\n   605→// based on verbosity level. Full mode shows the entire session, verbose shows checkpoint scope.\n   606→// fullTranscript is the entire session transcript, scopedContent is either scoped transcript bytes\n   607→// or a pre-formatted string (for backwards compat), and scopedFallback is used when scoped parsing fails.\n   608→func appendTranscriptSection(sb *strings.Builder, verbose, full bool, fullTranscript, scopedTranscript []byte, scopedFallback string) {\n   609→\tswitch {\n   610→\tcase full:\n   611→\t\tsb.WriteString(\"\\n\")\n   612→\t\tsb.WriteString(\"Transcript (full session):\\n\")\n   613→\t\tsb.WriteString(formatTranscriptBytes(fullTranscript, \"\"))\n   614→\n   615→\tcase verbose:\n   616→\t\tsb.WriteString(\"\\n\")\n   617→\t\tsb.WriteString(\"Transcript (checkpoint scope):\\n\")\n   618→\t\tsb.WriteString(formatTranscriptBytes(scopedTranscript, scopedFallback))\n   619→\t}\n   620→}\n   621→\n   622→// formatTranscriptBytes formats transcript bytes into a human-readable string.\n   623→// It parses the JSONL transcript and formats it using the condensed format.\n   624→// The fallback is used for backwards compatibility when transcript parsing fails or is empty.\n   625→func formatTranscriptBytes(transcriptBytes []byte, fallback string) string {\n   626→\tif len(transcriptBytes) == 0 {\n   627→\t\tif fallback != \"\" {\n   628→\t\t\treturn fallback + \"\\n\"\n   629→\t\t}\n   630→\t\treturn \"  (none)\\n\"\n   631→\t}\n   632→\n   633→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   634→\tif err != nil || len(condensed) == 0 {\n   635→\t\tif fallback != \"\" {\n   636→\t\t\treturn fallback + \"\\n\"\n   637→\t\t}\n   638→\t\treturn \"  (failed to parse transcript)\\n\"\n   639→\t}\n   640→\n   641→\tinput := summarise.Input{Transcript: condensed}\n   642→\treturn summarise.FormatCondensedTranscript(input)\n   643→}\n   644→\n   645→// formatSummaryDetails formats the detailed sections of an AI summary.\n   646→func formatSummaryDetails(sb *strings.Builder, summary *checkpoint.Summary) {\n   647→\t// Learnings section\n   648→\thasLearnings := len(summary.Learnings.Repo) > 0 ||\n   649→\t\tlen(summary.Learnings.Code) > 0 ||\n   650→\t\tlen(summary.Learnings.Workflow) > 0\n   651→\n   652→\tif hasLearnings {\n   653→\t\tsb.WriteString(\"\\nLearnings:\\n\")\n   654→\n   655→\t\tif len(summary.Learnings.Repo) > 0 {\n   656→\t\t\tsb.WriteString(\"  Repository:\\n\")\n   657→\t\t\tfor _, learning := range summary.Learnings.Repo {\n   658→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   659→\t\t\t}\n   660→\t\t}\n   661→\n   662→\t\tif len(summary.Learnings.Code) > 0 {\n   663→\t\t\tsb.WriteString(\"  Code:\\n\")\n   664→\t\t\tfor _, learning := range summary.Learnings.Code {\n   665→\t\t\t\tif learning.Line > 0 {\n   666→\t\t\t\t\tif learning.EndLine > 0 {\n   667→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d-%d: %s\\n\", learning.Path, learning.Line, learning.EndLine, learning.Finding)\n   668→\t\t\t\t\t} else {\n   669→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d: %s\\n\", learning.Path, learning.Line, learning.Finding)\n   670→\t\t\t\t\t}\n   671→\t\t\t\t} else {\n   672→\t\t\t\t\tfmt.Fprintf(sb, \"    - %s: %s\\n\", learning.Path, learning.Finding)\n   673→\t\t\t\t}\n   674→\t\t\t}\n   675→\t\t}\n   676→\n   677→\t\tif len(summary.Learnings.Workflow) > 0 {\n   678→\t\t\tsb.WriteString(\"  Workflow:\\n\")\n   679→\t\t\tfor _, learning := range summary.Learnings.Workflow {\n   680→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   681→\t\t\t}\n   682→\t\t}\n   683→\t}\n   684→\n   685→\t// Friction section\n   686→\tif len(summary.Friction) > 0 {\n   687→\t\tsb.WriteString(\"\\nFriction:\\n\")\n   688→\t\tfor _, item := range summary.Friction {\n   689→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   690→\t\t}\n   691→\t}\n   692→\n   693→\t// Open items section\n   694→\tif len(summary.OpenItems) > 0 {\n   695→\t\tsb.WriteString(\"\\nOpen Items:\\n\")\n   696→\t\tfor _, item := range summary.OpenItems {\n   697→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   698→\t\t}\n   699→\t}\n   700→}\n   701→\n   702→// runExplainDefault shows all checkpoints on the current branch.\n   703→// This is the default view when no flags are provided.\n   704→func runExplainDefault(w io.Writer, noPager bool) error {\n   705→\treturn runExplainBranchDefault(w, noPager)\n   706→}\n   707→\n   708→// branchCheckpointsLimit is the max checkpoints to show in branch view\n   709→const branchCheckpointsLimit = 100\n   710→\n   711→// commitScanLimit is how far back to scan git history for checkpoints\n   712→const commitScanLimit = 500\n   713→\n   714→// consecutiveMainLimit stops scanning after this many consecutive commits on main\n   715→// (indicates we've likely exhausted feature branch commits)\n   716→const consecutiveMainLimit = 100\n   717→\n   718→// errStopIteration is used to stop commit iteration early\n   719→var errStopIteration = errors.New(\"stop iteration\")\n   720→\n   721→// getBranchCheckpoints returns checkpoints relevant to the current branch.\n   722→// This is strategy-agnostic - it queries checkpoints directly from the checkpoint store.\n   723→//\n   724→// Behavior:\n   725→//   - On feature branches: only show checkpoints unique to this branch (not in main)\n   726→//   - On default branch (main/master): show all checkpoints in history (up to limit)\n   727→//   - Includes both committed checkpoints (entire/sessions) and temporary checkpoints (shadow branches)\n   728→func getBranchCheckpoints(repo *git.Repository, limit int) ([]strategy.RewindPoint, error) {\n   729→\tstore := checkpoint.NewGitStore(repo)\n   730→\n   731→\t// Get all committed checkpoints for lookup\n   732→\tcommittedInfos, err := store.ListCommitted(context.Background())\n   733→\tif err != nil {\n   734→\t\tcommittedInfos = nil // Continue without committed checkpoints\n   735→\t}\n   736→\n   737→\t// Build map of checkpoint ID -> committed info\n   738→\tcommittedByID := make(map[id.CheckpointID]checkpoint.CommittedInfo)\n   739→\tfor _, info := range committedInfos {\n   740→\t\tif !info.CheckpointID.IsEmpty() {\n   741→\t\t\tcommittedByID[info.CheckpointID] = info\n   742→\t\t}\n   743→\t}\n   744→\n   745→\thead, err := repo.Head()\n   746→\tif err != nil {\n   747→\t\t// Unborn HEAD (no commits yet) - return empty list instead of erroring\n   748→\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n   749→\t\t\treturn []strategy.RewindPoint{}, nil\n   750→\t\t}\n   751→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   752→\t}\n   753→\n   754→\t// Check if we're on the default branch (use repo-aware version)\n   755→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   756→\tvar mainBranchHash plumbing.Hash\n   757→\tif !isOnDefault {\n   758→\t\t// Prefer the actual default branch name (which may not be main/master)\n   759→\t\tif defaultBranchName := strategy.GetDefaultBranchName(repo); defaultBranchName != \"\" {\n   760→\t\t\t// Try local default branch first: refs/heads/<name>\n   761→\t\t\tref, refErr := repo.Reference(plumbing.ReferenceName(\"refs/heads/\"+defaultBranchName), true)\n   762→\t\t\tif refErr != nil {\n   763→\t\t\t\t// Fall back to remote default branch: refs/remotes/origin/<name>\n   764→\t\t\t\tref, refErr = repo.Reference(plumbing.ReferenceName(\"refs/remotes/origin/\"+defaultBranchName), true)\n   765→\t\t\t}\n   766→\t\t\tif refErr == nil {\n   767→\t\t\t\tmainBranchHash = ref.Hash()\n   768→\t\t\t}\n   769→\t\t}\n   770→\n   771→\t\t// Fall back to main/master detection if default branch resolution failed\n   772→\t\tif mainBranchHash == plumbing.ZeroHash {\n   773→\t\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   774→\t\t}\n   775→\t}\n   776→\n   777→\t// Precompute commits reachable from main (for O(1) filtering instead of O(N) per commit)\n   778→\t// This changes the filtering from O(N*M) to O(N+M) where N=commits scanned, M=main history depth\n   779→\treachableFromMain := make(map[plumbing.Hash]bool)\n   780→\tif mainBranchHash != plumbing.ZeroHash {\n   781→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   782→\t\tif mainErr == nil {\n   783→\t\t\tmainCount := 0\n   784→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   785→\t\t\t\tmainCount++\n   786→\t\t\t\tif mainCount > 1000 { // Same depth limit as before\n   787→\t\t\t\t\treturn errStopIteration\n   788→\t\t\t\t}\n   789→\t\t\t\treachableFromMain[c.Hash] = true\n   790→\t\t\t\treturn nil\n   791→\t\t\t})\n   792→\t\t\tmainIter.Close()\n   793→\t\t}\n   794→\t}\n   795→\n   796→\t// Walk git history and collect checkpoints\n   797→\titer, err := repo.Log(&git.LogOptions{\n   798→\t\tFrom:  head.Hash(),\n   799→\t\tOrder: git.LogOrderCommitterTime,\n   800→\t})\n   801→\tif err != nil {\n   802→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   803→\t}\n   804→\tdefer iter.Close()\n   805→\n   806→\tvar points []strategy.RewindPoint\n   807→\tcount := 0\n   808→\tconsecutiveMainCount := 0\n   809→\n   810→\terr = iter.ForEach(func(c *object.Commit) error {\n   811→\t\tif count >= commitScanLimit {\n   812→\t\t\treturn errStopIteration\n   813→\t\t}\n   814→\t\tcount++\n   815→\n   816→\t\t// On feature branches, skip commits that are reachable from main\n   817→\t\t// (but continue scanning - there may be more feature branch commits)\n   818→\t\tif len(reachableFromMain) > 0 {\n   819→\t\t\tif reachableFromMain[c.Hash] {\n   820→\t\t\t\tconsecutiveMainCount++\n   821→\t\t\t\tif consecutiveMainCount >= consecutiveMainLimit {\n   822→\t\t\t\t\treturn errStopIteration // Likely exhausted feature branch commits\n   823→\t\t\t\t}\n   824→\t\t\t\treturn nil // Skip this commit, continue scanning\n   825→\t\t\t}\n   826→\t\t\tconsecutiveMainCount = 0 // Reset on feature branch commit\n   827→\t\t}\n   828→\n   829→\t\t// Extract checkpoint ID from Entire-Checkpoint trailer\n   830→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   831→\t\tif !found {\n   832→\t\t\treturn nil // No checkpoint trailer, continue\n   833→\t\t}\n   834→\n   835→\t\t// Look up checkpoint info\n   836→\t\tcpInfo, found := committedByID[cpID]\n   837→\t\tif !found {\n   838→\t\t\treturn nil // Checkpoint not in store, continue\n   839→\t\t}\n   840→\n   841→\t\t// Create rewind point from committed info\n   842→\t\tmessage := strings.Split(c.Message, \"\\n\")[0]\n   843→\t\tpoint := strategy.RewindPoint{\n   844→\t\t\tID:               c.Hash.String(),\n   845→\t\t\tMessage:          message,\n   846→\t\t\tDate:             c.Committer.When,\n   847→\t\t\tIsLogsOnly:       true, // Committed checkpoints are logs-only\n   848→\t\t\tCheckpointID:     cpID,\n   849→\t\t\tSessionID:        cpInfo.SessionID,\n   850→\t\t\tIsTaskCheckpoint: cpInfo.IsTask,\n   851→\t\t\tToolUseID:        cpInfo.ToolUseID,\n   852→\t\t\tAgent:            cpInfo.Agent,\n   853→\t\t}\n   854→\t\t// Read session prompt from metadata branch (best-effort)\n   855→\t\tresult, _ := store.ReadCommitted(context.Background(), cpID) //nolint:errcheck  // Best-effort\n   856→\t\tif result != nil {\n   857→\t\t\t// Scope the transcript to this checkpoint's portion\n   858→\t\t\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   859→\t\t\t// lines from that point onwards (excluding earlier checkpoint content)\n   860→\t\t\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   861→\t\t\t// Extract prompts from the scoped transcript (not the full session's prompts)\n   862→\t\t\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   863→\t\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   864→\t\t\t\tpoint.SessionPrompt = scopedPrompts[0]\n   865→\t\t\t}\n   866→\t\t}\n   867→\n   868→\t\tpoints = append(points, point)\n   869→\t\treturn nil\n   870→\t})\n   871→\n   872→\tif err != nil && !errors.Is(err, errStopIteration) {\n   873→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   874→\t}\n   875→\n   876→\t// Get temporary checkpoints from ALL shadow branches whose base commit is reachable from HEAD.\n   877→\ttempPoints := getReachableTemporaryCheckpoints(repo, store, head.Hash(), isOnDefault, limit)\n   878→\tpoints = append(points, tempPoints...)\n   879→\n   880→\t// Sort by date, most recent first\n   881→\tsort.Slice(points, func(i, j int) bool {\n   882→\t\treturn points[i].Date.After(points[j].Date)\n   883→\t})\n   884→\n   885→\t// Apply limit\n   886→\tif len(points) > limit {\n   887→\t\tpoints = points[:limit]\n   888→\t}\n   889→\n   890→\treturn points, nil\n   891→}\n   892→\n   893→// getReachableTemporaryCheckpoints returns temporary checkpoints from shadow branches\n   894→// whose base commit is reachable from the given HEAD hash.\n   895→// For default branches, all shadow branches are included.\n   896→// For feature branches, only shadow branches whose base commit is in HEAD's history are included.\n   897→func getReachableTemporaryCheckpoints(repo *git.Repository, store *checkpoint.GitStore, headHash plumbing.Hash, isOnDefault bool, limit int) []strategy.RewindPoint {\n   898→\tvar points []strategy.RewindPoint\n   899→\n   900→\tshadowBranches, _ := store.ListTemporary(context.Background()) //nolint:errcheck // Best-effort\n   901→\tfor _, sb := range shadowBranches {\n   902→\t\t// Check if this shadow branch's base commit is reachable from current HEAD\n   903→\t\tif !isShadowBranchReachable(repo, sb.BaseCommit, headHash, isOnDefault) {\n   904→\t\t\tcontinue\n   905→\t\t}\n   906→\n   907→\t\t// List checkpoints from this shadow branch\n   908→\t\ttempCheckpoints, _ := store.ListCheckpointsForBranch(context.Background(), sb.BranchName, \"\", limit) //nolint:errcheck // Best-effort\n   909→\t\tfor _, tc := range tempCheckpoints {\n   910→\t\t\tpoint := convertTemporaryCheckpoint(repo, tc)\n   911→\t\t\tif point != nil {\n   912→\t\t\t\tpoints = append(points, *point)\n   913→\t\t\t}\n   914→\t\t}\n   915→\t}\n   916→\n   917→\treturn points\n   918→}\n   919→\n   920→// isShadowBranchReachable checks if a shadow branch's base commit is reachable from HEAD.\n   921→// For default branches, all shadow branches are considered reachable.\n   922→// For feature branches, we check if any commit with the base commit prefix is in HEAD's history.\n   923→func isShadowBranchReachable(repo *git.Repository, baseCommit string, headHash plumbing.Hash, isOnDefault bool) bool {\n   924→\t// For default branch: all shadow branches are potentially relevant\n   925→\tif isOnDefault {\n   926→\t\treturn true\n   927→\t}\n   928→\n   929→\t// Check if base commit hash prefix matches any commit in HEAD's history\n   930→\tbaseCommitIter, baseErr := repo.Log(&git.LogOptions{From: headHash})\n   931→\tif baseErr != nil {\n   932→\t\treturn false\n   933→\t}\n   934→\tdefer baseCommitIter.Close()\n   935→\n   936→\tbaseCount := 0\n   937→\tfound := false\n   938→\t_ = baseCommitIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   939→\t\tbaseCount++\n   940→\t\tif baseCount > commitScanLimit {\n   941→\t\t\treturn errStopIteration\n   942→\t\t}\n   943→\t\tif strings.HasPrefix(c.Hash.String(), baseCommit) {\n   944→\t\t\tfound = true\n   945→\t\t\treturn errStopIteration\n   946→\t\t}\n   947→\t\treturn nil\n   948→\t})\n   949→\n   950→\treturn found\n   951→}\n   952→\n   953→// convertTemporaryCheckpoint converts a TemporaryCheckpointInfo to a RewindPoint.\n   954→// Returns nil if the checkpoint should be skipped (no code changes or can't be read).\n   955→func convertTemporaryCheckpoint(repo *git.Repository, tc checkpoint.TemporaryCheckpointInfo) *strategy.RewindPoint {\n   956→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   957→\tif commitErr != nil {\n   958→\t\treturn nil\n   959→\t}\n   960→\n   961→\t// Filter out checkpoints with no code changes (only .entire/ metadata changed)\n   962→\t// This also filters out the first checkpoint which is just a baseline copy\n   963→\tif !hasCodeChanges(shadowCommit) {\n   964→\t\treturn nil\n   965→\t}\n   966→\n   967→\t// Read session prompt from the shadow branch commit's tree (not from entire/sessions)\n   968→\t// Temporary checkpoints store their metadata in the shadow branch, not in entire/sessions\n   969→\tvar sessionPrompt string\n   970→\tshadowTree, treeErr := shadowCommit.Tree()\n   971→\tif treeErr == nil {\n   972→\t\tsessionPrompt = strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   973→\t}\n   974→\n   975→\treturn &strategy.RewindPoint{\n   976→\t\tID:               tc.CommitHash.String(),\n   977→\t\tMessage:          tc.Message,\n   978→\t\tMetadataDir:      tc.MetadataDir,\n   979→\t\tDate:             tc.Timestamp,\n   980→\t\tIsTaskCheckpoint: tc.IsTaskCheckpoint,\n   981→\t\tToolUseID:        tc.ToolUseID,\n   982→\t\tSessionID:        tc.SessionID,\n   983→\t\tSessionPrompt:    sessionPrompt,\n   984→\t\tIsLogsOnly:       false, // Temporary checkpoints can be fully rewound\n   985→\t}\n   986→}\n   987→\n   988→// runExplainBranchWithFilter shows checkpoints on the current branch, optionally filtered by session.\n   989→// This is strategy-agnostic - it queries checkpoints directly.\n   990→func runExplainBranchWithFilter(w io.Writer, noPager bool, sessionFilter string) error {\n   991→\trepo, err := openRepository()\n   992→\tif err != nil {\n   993→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   994→\t}\n   995→\n   996→\t// Get current branch name\n   997→\tbranchName := strategy.GetCurrentBranchName(repo)\n   998→\tif branchName == \"\" {\n   999→\t\t// Detached HEAD state or unborn HEAD - try to use short commit hash if possible\n  1000→\t\thead, headErr := repo.Head()\n  1001→\t\tif headErr != nil {\n  1002→\t\t\t// Unborn HEAD (no commits yet) - treat as empty history instead of erroring\n  1003→\t\t\tif errors.Is(headErr, plumbing.ErrReferenceNotFound) {\n  1004→\t\t\t\tbranchName = \"HEAD (no commits yet)\"\n  1005→\t\t\t} else {\n  1006→\t\t\t\treturn fmt.Errorf(\"failed to get HEAD: %w\", headErr)\n  1007→\t\t\t}\n  1008→\t\t} else {\n  1009→\t\t\tbranchName = \"HEAD (\" + head.Hash().String()[:7] + \")\"\n  1010→\t\t}\n  1011→\t}\n  1012→\n  1013→\t// Get checkpoints for this branch (strategy-agnostic)\n  1014→\tpoints, err := getBranchCheckpoints(repo, branchCheckpointsLimit)\n  1015→\tif err != nil {\n  1016→\t\t// Log the error but continue with empty list so user sees helpful message\n  1017→\t\tlogging.Warn(context.Background(), \"failed to get branch checkpoints\", \"error\", err)\n  1018→\t\tpoints = nil\n  1019→\t}\n  1020→\n  1021→\t// Format output\n  1022→\toutput := formatBranchCheckpoints(branchName, points, sessionFilter)\n  1023→\n  1024→\toutputExplainContent(w, output, noPager)\n  1025→\treturn nil\n  1026→}\n  1027→\n  1028→// runExplainBranchDefault shows all checkpoints on the current branch grouped by date.\n  1029→// This is a convenience wrapper that calls runExplainBranchWithFilter with no filter.\n  1030→func runExplainBranchDefault(w io.Writer, noPager bool) error {\n  1031→\treturn runExplainBranchWithFilter(w, noPager, \"\")\n  1032→}\n  1033→\n  1034→// outputExplainContent outputs content with optional pager support.\n  1035→func outputExplainContent(w io.Writer, content string, noPager bool) {\n  1036→\tif noPager {\n  1037→\t\tfmt.Fprint(w, content)\n  1038→\t} else {\n  1039→\t\toutputWithPager(w, content)\n  1040→\t}\n  1041→}\n  1042→\n  1043→// runExplainCommit looks up the checkpoint associated with a commit.\n  1044→// Extracts the Entire-Checkpoint trailer and delegates to checkpoint detail view.\n  1045→// If no trailer found, shows a message indicating no associated checkpoint.\n  1046→func runExplainCommit(w io.Writer, commitRef string, noPager, verbose, full, searchAll bool) error {\n  1047→\trepo, err := openRepository()\n  1048→\tif err != nil {\n  1049→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1050→\t}\n  1051→\n  1052→\t// Resolve the commit reference\n  1053→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1054→\tif err != nil {\n  1055→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1056→\t}\n  1057→\n  1058→\tcommit, err := repo.CommitObject(*hash)\n  1059→\tif err != nil {\n  1060→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1061→\t}\n  1062→\n  1063→\t// Extract Entire-Checkpoint trailer\n  1064→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1065→\tif !hasCheckpoint {\n  1066→\t\tfmt.Fprintln(w, \"No associated Entire checkpoint\")\n  1067→\t\tfmt.Fprintf(w, \"\\nCommit %s does not have an Entire-Checkpoint trailer.\\n\", hash.String()[:7])\n  1068→\t\tfmt.Fprintln(w, \"This commit was not created during an Entire session, or the trailer was removed.\")\n  1069→\t\treturn nil\n  1070→\t}\n  1071→\n  1072→\t// Delegate to checkpoint detail view\n  1073→\t// Note: We pass a nil errW since runExplainCheckpoint only uses it for generate mode\n  1074→\treturn runExplainCheckpoint(w, nil, checkpointID.String(), noPager, verbose, full, false, false, false, searchAll)\n  1075→}\n  1076→\n  1077→// formatSessionInfo formats session information for display.\n  1078→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1079→\tvar sb strings.Builder\n  1080→\n  1081→\t// Session header\n  1082→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1083→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1084→\n  1085→\tif !session.StartTime.IsZero() {\n  1086→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1087→\t}\n  1088→\n  1089→\tif sourceRef != \"\" {\n  1090→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1091→\t}\n  1092→\n  1093→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1094→\n  1095→\t// Checkpoint details\n  1096→\tfor _, cp := range checkpoints {\n  1097→\t\tsb.WriteString(\"\\n\")\n  1098→\n  1099→\t\t// Checkpoint header\n  1100→\t\ttaskMarker := \"\"\n  1101→\t\tif cp.IsTaskCheckpoint {\n  1102→\t\t\ttaskMarker = \" [Task]\"\n  1103→\t\t}\n  1104→\t\tfmt.Fprintf(&sb, \"─── Checkpoint %d [%s] %s%s ───\\n\",\n  1105→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker)\n  1106→\t\tsb.WriteString(\"\\n\")\n  1107→\n  1108→\t\t// Display all interactions in this checkpoint\n  1109→\t\tfor i, inter := range cp.Interactions {\n  1110→\t\t\t// For multiple interactions, add a sub-header\n  1111→\t\t\tif len(cp.Interactions) > 1 {\n  1112→\t\t\t\tfmt.Fprintf(&sb, \"### Interaction %d\\n\\n\", i+1)\n  1113→\t\t\t}\n  1114→\n  1115→\t\t\t// Prompt section\n  1116→\t\t\tif inter.Prompt != \"\" {\n  1117→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n  1118→\t\t\t\tsb.WriteString(inter.Prompt)\n  1119→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1120→\t\t\t}\n  1121→\n  1122→\t\t\t// Response section\n  1123→\t\t\tif len(inter.Responses) > 0 {\n  1124→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n  1125→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n  1126→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1127→\t\t\t}\n  1128→\n  1129→\t\t\t// Files modified for this interaction\n  1130→\t\t\tif len(inter.Files) > 0 {\n  1131→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(inter.Files))\n  1132→\t\t\t\tfor _, file := range inter.Files {\n  1133→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1134→\t\t\t\t}\n  1135→\t\t\t\tsb.WriteString(\"\\n\")\n  1136→\t\t\t}\n  1137→\t\t}\n  1138→\n  1139→\t\t// If no interactions, show message and/or files\n  1140→\t\tif len(cp.Interactions) == 0 {\n  1141→\t\t\t// Show commit message as summary when no transcript available\n  1142→\t\t\tif cp.Message != \"\" {\n  1143→\t\t\t\tsb.WriteString(cp.Message)\n  1144→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1145→\t\t\t}\n  1146→\t\t\t// Show aggregate files if available\n  1147→\t\t\tif len(cp.Files) > 0 {\n  1148→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(cp.Files))\n  1149→\t\t\t\tfor _, file := range cp.Files {\n  1150→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1151→\t\t\t\t}\n  1152→\t\t\t}\n  1153→\t\t}\n  1154→\t}\n  1155→\n  1156→\treturn sb.String()\n  1157→}\n  1158→\n  1159→// outputWithPager outputs content through a pager if stdout is a terminal and content is long.\n  1160→func outputWithPager(w io.Writer, content string) {\n  1161→\t// Check if we're writing to stdout and it's a terminal\n  1162→\tif f, ok := w.(*os.File); ok && f == os.Stdout && term.IsTerminal(int(f.Fd())) {\n  1163→\t\t// Get terminal height\n  1164→\t\t_, height, err := term.GetSize(int(f.Fd()))\n  1165→\t\tif err != nil {\n  1166→\t\t\theight = 24 // Default fallback\n  1167→\t\t}\n  1168→\n  1169→\t\t// Count lines in content\n  1170→\t\tlineCount := strings.Count(content, \"\\n\")\n  1171→\n  1172→\t\t// Use pager if content exceeds terminal height\n  1173→\t\tif lineCount > height-2 {\n  1174→\t\t\tpager := os.Getenv(\"PAGER\")\n  1175→\t\t\tif pager == \"\" {\n  1176→\t\t\t\tpager = \"less\"\n  1177→\t\t\t}\n  1178→\n  1179→\t\t\tcmd := exec.CommandContext(context.Background(), pager) //nolint:gosec // pager from env is expected\n  1180→\t\t\tcmd.Stdin = strings.NewReader(content)\n  1181→\t\t\tcmd.Stdout = f\n  1182→\t\t\tcmd.Stderr = os.Stderr\n  1183→\n  1184→\t\t\tif err := cmd.Run(); err != nil {\n  1185→\t\t\t\t// Fallback to direct output if pager fails\n  1186→\t\t\t\tfmt.Fprint(w, content)\n  1187→\t\t\t}\n  1188→\t\t\treturn\n  1189→\t\t}\n  1190→\t}\n  1191→\n  1192→\t// Direct output for non-terminal or short content\n  1193→\tfmt.Fprint(w, content)\n  1194→}\n  1195→\n  1196→// Constants for formatting output\n  1197→const (\n  1198→\t// maxIntentDisplayLength is the maximum length for intent text before truncation\n  1199→\tmaxIntentDisplayLength = 80\n  1200→\t// maxMessageDisplayLength is the maximum length for checkpoint messages before truncation\n  1201→\tmaxMessageDisplayLength = 80\n  1202→\t// maxPromptDisplayLength is the maximum length for session prompts before truncation\n  1203→\tmaxPromptDisplayLength = 60\n  1204→\t// checkpointIDDisplayLength is the number of characters to show from checkpoint IDs\n  1205→\tcheckpointIDDisplayLength = 12\n  1206→)\n  1207→\n  1208→// formatBranchCheckpoints formats checkpoint information for a branch.\n  1209→// Groups commits by checkpoint ID and shows the prompt for each checkpoint.\n  1210→// If sessionFilter is non-empty, only shows checkpoints matching that session ID (or prefix).\n  1211→func formatBranchCheckpoints(branchName string, points []strategy.RewindPoint, sessionFilter string) string {\n  1212→\tvar sb strings.Builder\n  1213→\n  1214→\t// Branch header\n  1215→\tfmt.Fprintf(&sb, \"Branch: %s\\n\", branchName)\n  1216→\n  1217→\t// Filter by session if specified\n  1218→\tif sessionFilter != \"\" {\n  1219→\t\tvar filtered []strategy.RewindPoint\n  1220→\t\tfor _, p := range points {\n  1221→\t\t\tif p.SessionID == sessionFilter || strings.HasPrefix(p.SessionID, sessionFilter) {\n  1222→\t\t\t\tfiltered = append(filtered, p)\n  1223→\t\t\t}\n  1224→\t\t}\n  1225→\t\tpoints = filtered\n  1226→\t}\n  1227→\n  1228→\tif len(points) == 0 {\n  1229→\t\tsb.WriteString(\"Checkpoints: 0\\n\")\n  1230→\t\tif sessionFilter != \"\" {\n  1231→\t\t\tfmt.Fprintf(&sb, \"Filtered by session: %s\\n\", sessionFilter)\n  1232→\t\t}\n  1233→\t\tsb.WriteString(\"\\nNo checkpoints found on this branch.\\n\")\n  1234→\t\tsb.WriteString(\"Checkpoints will appear here after you save changes during a Claude session.\\n\")\n  1235→\t\treturn sb.String()\n  1236→\t}\n  1237→\n  1238→\t// Group by checkpoint ID\n  1239→\tgroups := groupByCheckpointID(points)\n  1240→\n  1241→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(groups))\n  1242→\tif sessionFilter != \"\" {\n  1243→\t\tfmt.Fprintf(&sb, \"Filtered by session: %s\\n\", sessionFilter)\n  1244→\t}\n  1245→\tsb.WriteString(\"\\n\")\n  1246→\n  1247→\t// Output each checkpoint group\n  1248→\tfor _, group := range groups {\n  1249→\t\tformatCheckpointGroup(&sb, group)\n  1250→\t\tsb.WriteString(\"\\n\")\n  1251→\t}\n  1252→\n  1253→\treturn sb.String()\n  1254→}\n  1255→\n  1256→// checkpointGroup represents a group of commits sharing the same checkpoint ID.\n  1257→type checkpointGroup struct {\n  1258→\tcheckpointID string\n  1259→\tprompt       string\n  1260→\tisTemporary  bool // true if any commit is not logs-only (can be rewound)\n  1261→\tisTask       bool // true if this is a task checkpoint\