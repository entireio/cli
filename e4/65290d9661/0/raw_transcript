riteCommitted() second session error = %v\", err)\n   287→\t}\n   288→\n   289→\tmetadata := readCheckpointMetadata(t, repo, checkpointID)\n   290→\n   291→\t// Verify Agent is the first agent (backwards compat)\n   292→\tif metadata.Agent != agent.AgentTypeGemini {\n   293→\t\tt.Errorf(\"metadata.Agent = %q, want %q (first agent for backwards compat)\", metadata.Agent, agent.AgentTypeGemini)\n   294→\t}\n   295→\n   296→\t// Verify Agents array contains both agents in order\n   297→\tif len(metadata.Agents) != 2 {\n   298→\t\tt.Errorf(\"metadata.Agents length = %d, want 2\", len(metadata.Agents))\n   299→\t}\n   300→\tif len(metadata.Agents) >= 2 {\n   301→\t\tif metadata.Agents[0] != agent.AgentTypeGemini {\n   302→\t\t\tt.Errorf(\"metadata.Agents[0] = %q, want %q\", metadata.Agents[0], agent.AgentTypeGemini)\n   303→\t\t}\n   304→\t\tif metadata.Agents[1] != agent.AgentTypeClaudeCode {\n   305→\t\t\tt.Errorf(\"metadata.Agents[1] = %q, want %q\", metadata.Agents[1], agent.AgentTypeClaudeCode)\n   306→\t\t}\n   307→\t}\n   308→\n   309→\tif metadata.SessionCount != 2 {\n   310→\t\tt.Errorf(\"metadata.SessionCount = %d, want 2\", metadata.SessionCount)\n   311→\t}\n   312→}\n   313→\n   314→func TestWriteCommitted_AgentsArray_Deduplication(t *testing.T) {\n   315→\trepo, _ := setupBranchTestRepo(t)\n   316→\tstore := NewGitStore(repo)\n   317→\tcheckpointID := id.MustCheckpointID(\"e3f4a5b6c7d8\")\n   318→\n   319→\t// Two sessions with the same agent\n   320→\tfor i := 1; i <= 2; i++ {\n   321→\t\terr := store.WriteCommitted(context.Background(), WriteCommittedOptions{\n   322→\t\t\tCheckpointID: checkpointID,\n   323→\t\t\tSessionID:    \"session-\" + string(rune('0'+i)),\n   324→\t\t\tStrategy:     \"auto-commit\",\n   325→\t\t\tAgent:        agent.AgentTypeClaudeCode,\n   326→\t\t\tTranscript:   []byte(\"transcript\"),\n   327→\t\t\tAuthorName:   \"Test Author\",\n   328→\t\t\tAuthorEmail:  \"test@example.com\",\n   329→\t\t})\n   330→\t\tif err != nil {\n   331→\t\t\tt.Fatalf(\"WriteCommitted() session %d error = %v\", i, err)\n   332→\t\t}\n   333→\t}\n   334→\n   335→\tmetadata := readCheckpointMetadata(t, repo, checkpointID)\n   336→\n   337→\t// Should only have one agent (deduplicated)\n   338→\tif len(metadata.Agents) != 1 {\n   339→\t\tt.Errorf(\"metadata.Agents length = %d, want 1 (deduplicated)\", len(metadata.Agents))\n   340→\t}\n   341→\tif len(metadata.Agents) > 0 && metadata.Agents[0] != agent.AgentTypeClaudeCode {\n   342→\t\tt.Errorf(\"metadata.Agents[0] = %q, want %q\", metadata.Agents[0], agent.AgentTypeClaudeCode)\n   343→\t}\n   344→\n   345→\t// But session count should be 2\n   346→\tif metadata.SessionCount != 2 {\n   347→\t\tt.Errorf(\"metadata.SessionCount = %d, want 2\", metadata.SessionCount)\n   348→\t}\n   349→}\n   350→\n   351→// TestWriteTemporary_Deduplication verifies that WriteTemporary skips creating\n   352→// a new commit when the tree hash matches the previous checkpoint.\n   353→func TestWriteTemporary_Deduplication(t *testing.T) {\n   354→\ttempDir := t.TempDir()\n   355→\n   356→\t// Initialize a git repository with an initial commit\n   357→\trepo, err := git.PlainInit(tempDir, false)\n   358→\tif err != nil {\n   359→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   360→\t}\n   361→\n   362→\t// Create worktree and make initial commit\n   363→\tworktree, err := repo.Worktree()\n   364→\tif err != nil {\n   365→\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   366→\t}\n   367→\n   368→\treadmeFile := filepath.Join(tempDir, \"README.md\")\n   369→\tif err := os.WriteFile(readmeFile, []byte(\"# Test\"), 0o644); err != nil {\n   370→\t\tt.Fatalf(\"failed to write README: %v\", err)\n   371→\t}\n   372→\tif _, err := worktree.Add(\"README.md\"); err != nil {\n   373→\t\tt.Fatalf(\"failed to add README: %v\", err)\n   374→\t}\n   375→\tinitialCommit, err := worktree.Commit(\"Initial commit\", &git.CommitOptions{\n   376→\t\tAuthor: &object.Signature{Name: \"Test\", Email: \"test@test.com\"},\n   377→\t})\n   378→\tif err != nil {\n   379→\t\tt.Fatalf(\"failed to commit: %v\", err)\n   380→\t}\n   381→\n   382→\t// Change to temp dir so paths.RepoRoot() works correctly\n   383→\tt.Chdir(tempDir)\n   384→\n   385→\t// Create a test file that will be included in checkpoints\n   386→\ttestFile := filepath.Join(tempDir, \"test.go\")\n   387→\tif err := os.WriteFile(testFile, []byte(\"package main\\n\"), 0o644); err != nil {\n   388→\t\tt.Fatalf(\"failed to write test file: %v\", err)\n   389→\t}\n   390→\n   391→\t// Create metadata directory\n   392→\tmetadataDir := filepath.Join(tempDir, \".entire\", \"metadata\", \"test-session\")\n   393→\tif err := os.MkdirAll(metadataDir, 0o755); err != nil {\n   394→\t\tt.Fatalf(\"failed to create metadata dir: %v\", err)\n   395→\t}\n   396→\tif err := os.WriteFile(filepath.Join(metadataDir, \"full.jsonl\"), []byte(`{\"test\": true}`), 0o644); err != nil {\n   397→\t\tt.Fatalf(\"failed to write transcript: %v\", err)\n   398→\t}\n   399→\n   400→\t// Create checkpoint store\n   401→\tstore := NewGitStore(repo)\n   402→\n   403→\t// First checkpoint should be created\n   404→\tbaseCommit := initialCommit.String()\n   405→\tresult1, err := store.WriteTemporary(context.Background(), WriteTemporaryOptions{\n   406→\t\tSessionID:         \"test-session\",\n   407→\t\tBaseCommit:        baseCommit,\n   408→\t\tModifiedFiles:     []string{\"test.go\"},\n   409→\t\tMetadataDir:       \".entire/metadata/test-session\",\n   410→\t\tMetadataDirAbs:    metadataDir,\n   411→\t\tCommitMessage:     \"Checkpoint 1\",\n   412→\t\tAuthorName:        \"Test\",\n   413→\t\tAuthorEmail:       \"test@test.com\",\n   414→\t\tIsFirstCheckpoint: true,\n   415→\t})\n   416→\tif err != nil {\n   417→\t\tt.Fatalf(\"WriteTemporary() first call error = %v\", err)\n   418→\t}\n   419→\tif result1.Skipped {\n   420→\t\tt.Error(\"first checkpoint should not be skipped\")\n   421→\t}\n   422→\tif result1.CommitHash == plumbing.ZeroHash {\n   423→\t\tt.Error(\"first checkpoint should have a commit hash\")\n   424→\t}\n   425→\n   426→\t// Second checkpoint with identical content should be skipped\n   427→\tresult2, err := store.WriteTemporary(context.Background(), WriteTemporaryOptions{\n   428→\t\tSessionID:         \"test-session\",\n   429→\t\tBaseCommit:        baseCommit,\n   430→\t\tModifiedFiles:     []string{\"test.go\"},\n   431→\t\tMetadataDir:       \".entire/metadata/test-session\",\n   432→\t\tMetadataDirAbs:    metadataDir,\n   433→\t\tCommitMessage:     \"Checkpoint 2\",\n   434→\t\tAuthorName:        \"Test\",\n   435→\t\tAuthorEmail:       \"test@test.com\",\n   436→\t\tIsFirstCheckpoint: false,\n   437→\t})\n   438→\tif err != nil {\n   439→\t\tt.Fatalf(\"WriteTemporary() second call error = %v\", err)\n   440→\t}\n   441→\tif !result2.Skipped {\n   442→\t\tt.Error(\"second checkpoint with identical content should be skipped\")\n   443→\t}\n   444→\tif result2.CommitHash != result1.CommitHash {\n   445→\t\tt.Errorf(\"skipped checkpoint should return previous commit hash, got %s, want %s\",\n   446→\t\t\tresult2.CommitHash, result1.CommitHash)\n   447→\t}\n   448→\n   449→\t// Modify the file and create another checkpoint - should NOT be skipped\n   450→\tif err := os.WriteFile(testFile, []byte(\"package main\\n\\nfunc main() {}\\n\"), 0o644); err != nil {\n   451→\t\tt.Fatalf(\"failed to modify test file: %v\", err)\n   452→\t}\n   453→\n   454→\tresult3, err := store.WriteTemporary(context.Background(), WriteTemporaryOptions{\n   455→\t\tSessionID:         \"test-session\",\n   456→\t\tBaseCommit:        baseCommit,\n   457→\t\tModifiedFiles:     []string{\"test.go\"},\n   458→\t\tMetadataDir:       \".entire/metadata/test-session\",\n   459→\t\tMetadataDirAbs:    metadataDir,\n   460→\t\tCommitMessage:     \"Checkpoint 3\",\n   461→\t\tAuthorName:        \"Test\",\n   462→\t\tAuthorEmail:       \"test@test.com\",\n   463→\t\tIsFirstCheckpoint: false,\n   464→\t})\n   465→\tif