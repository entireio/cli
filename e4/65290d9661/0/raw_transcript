inue\n  1115→\t\t}\n  1116→\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"# \") {\n  1117→\t\t\tinPrompt = false\n  1118→\t\t\tinSummary = false\n  1119→\t\t\tcontinue\n  1120→\t\t}\n  1121→\n  1122→\t\tif inPrompt {\n  1123→\t\t\tpromptLines = append(promptLines, line)\n  1124→\t\t} else if inSummary {\n  1125→\t\t\tsummaryLines = append(summaryLines, line)\n  1126→\t\t}\n  1127→\t}\n  1128→\n  1129→\tvar inter interaction\n  1130→\tif len(promptLines) > 0 {\n  1131→\t\tinter.Prompt = strings.TrimSpace(strings.Join(promptLines, \"\\n\"))\n  1132→\t}\n  1133→\tif len(summaryLines) > 0 {\n  1134→\t\tinter.Responses = []string{strings.TrimSpace(strings.Join(summaryLines, \"\\n\"))}\n  1135→\t}\n  1136→\n  1137→\t// If we couldn't parse structured content, show the raw context\n  1138→\tif inter.Prompt == \"\" && len(inter.Responses) == 0 {\n  1139→\t\tinter.Responses = []string{contextContent}\n  1140→\t}\n  1141→\n  1142→\tif inter.Prompt != \"\" || len(inter.Responses) > 0 {\n  1143→\t\tdetail.Interactions = []interaction{inter}\n  1144→\t}\n  1145→\n  1146→\treturn []checkpointDetail{detail}\n  1147→}\n  1148→\n  1149→// gatherCheckpointDetails extracts detailed information for each checkpoint.\n  1150→// Checkpoints come in newest-first order, but we number them oldest=1, newest=N.\n  1151→func gatherCheckpointDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n  1152→\tdetails := make([]checkpointDetail, 0, len(session.Checkpoints))\n  1153→\ttotal := len(session.Checkpoints)\n  1154→\n  1155→\tfor i, cp := range session.Checkpoints {\n  1156→\t\tdetail := checkpointDetail{\n  1157→\t\t\tIndex:            total - i, // Reverse numbering: oldest=1, newest=N\n  1158→\t\t\tTimestamp:        cp.Timestamp,\n  1159→\t\t\tIsTaskCheckpoint: cp.IsTaskCheckpoint,\n  1160→\t\t\tMessage:          cp.Message,\n  1161→\t\t}\n  1162→\n  1163→\t\t// Use checkpoint ID for display (truncate long IDs)\n  1164→\t\tdetail.ShortID = cp.CheckpointID.String()\n  1165→\t\tif len(detail.ShortID) > 12 {\n  1166→\t\t\tdetail.ShortID = detail.ShortID[:12]\n  1167→\t\t}\n  1168→\n  1169→\t\t// Try to get transcript for this checkpoint\n  1170→\t\ttranscriptContent, err := strat.GetCheckpointLog(cp)\n  1171→\t\tif err == nil {\n  1172→\t\t\ttranscript, parseErr := parseTranscriptFromBytes(transcriptContent)\n  1173→\t\t\tif parseErr == nil {\n  1174→\t\t\t\t// Extract all prompt/response pairs from the transcript\n  1175→\t\t\t\tpairs := ExtractAllPromptResponses(transcript)\n  1176→\t\t\t\tfor _, pair := range pairs {\n  1177→\t\t\t\t\tdetail.Interactions = append(detail.Interactions, interaction(pair))\n  1178→\t\t\t\t}\n  1179→\n  1180→\t\t\t\t// Aggregate all files for the checkpoint\n  1181→\t\t\t\tfileSet := make(map[string]bool)\n  1182→\t\t\t\tfor _, pair := range pairs {\n  1183→\t\t\t\t\tfor _, f := range pair.Files {\n  1184→\t\t\t\t\t\tif !fileSet[f] {\n  1185→\t\t\t\t\t\t\tfileSet[f] = true\n  1186→\t\t\t\t\t\t\tdetail.Files = append(detail.Files, f)\n  1187→\t\t\t\t\t\t}\n  1188→\t\t\t\t\t}\n  1189→\t\t\t\t}\n  1190→\t\t\t}\n  1191→\t\t}\n  1192→\n  1193→\t\tdetails = append(details, detail)\n  1194→\t}\n  1195→\n  1196→\treturn details\n  1197→}\n  1198→\n  1199→// runExplainCommit looks up the checkpoint associated with a commit.\n  1200→// Extracts the Entire-Checkpoint trailer and delegates to checkpoint detail view.\n  1201→// If no trailer found, shows a message indicating no associated checkpoint.\n  1202→func runExplainCommit(w io.Writer, commitRef string, noPager, verbose, full, searchAll bool) error {\n  1203→\trepo, err := openRepository()\n  1204→\tif err != nil {\n  1205→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1206→\t}\n  1207→\n  1208→\t// Resolve the commit reference\n  1209→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1210→\tif err != nil {\n  1211→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1212→\t}\n  1213→\n  1214→\tcommit, err := repo.CommitObject(*hash)\n  1215→\tif err != nil {\n  1216→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1217→\t}\n  1218→\n  1219→\t// Extract Entire-Checkpoint trailer\n  1220→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1221→\tif !hasCheckpoint {\n  1222→\t\tfmt.Fprintln(w, \"No associated Entire checkpoint\")\n  1223→\t\tfmt.Fprintf(w, \"\\nCommit %s does not have an Entire-Checkpoint trailer.\\n\", hash.String()[:7])\n  1224→\t\tfmt.Fprintln(w, \"This commit was not created during an Entire session, or the trailer was removed.\")\n  1225→\t\treturn nil\n  1226→\t}\n  1227→\n  1228→\t// Delegate to checkpoint detail view\n  1229→\t// Note: We pass a nil errW since runExplainCheckpoint only uses it for generate mode\n  1230→\treturn runExplainCheckpoint(w, nil, checkpointID.String(), noPager, verbose, full, false, false, false, searchAll)\n  1231→}\n  1232→\n  1233→// formatSessionInfo formats session information for display.\n  1234→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1235→\tvar sb strings.Builder\n  1236→\n  1237→\t// Session header\n  1238→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1239→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1240→\n  1241→\tif !session.StartTime.IsZero() {\n  1242→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1243→\t}\n  1244→\n  1245→\tif sourceRef != \"\" {\n  1246→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1247→\t}\n  1248→\n  1249→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1250→\n  1251→\t// Checkpoint details\n  1252→\tfor _, cp := range checkpoints {\n  1253→\t\tsb.WriteString(\"\\n\")\n  1254→\n  1255→\t\t// Checkpoint header\n  1256→\t\ttaskMarker := \"\"\n  1257→\t\tif cp.IsTaskCheckpoint {\n  1258→\t\t\ttaskMarker = \" [Task]\"\n  1259→\t\t}\n  1260→\t\tfmt.Fprintf(&sb, \"─── Checkpoint %d [%s] %s%s ───\\n\",\n  1261→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker)\n  1262→\t\tsb.WriteString(\"\\n\")\n  1263→\n  1264→\t\t// Display all interactions in this checkpoint\n  1265→\t\tfor i, inter := range cp.Interactions {\n  1266→\t\t\t// For multiple interactions, add a sub-header\n  1267→\t\t\tif len(cp.Interactions) > 1 {\n  1268→\t\t\t\tfmt.Fprintf(&sb, \"### Interaction %d\\n\\n\", i+1)\n  1269→\t\t\t}\n  1270→\n  1271→\t\t\t// Prompt section\n  1272→\t\t\tif inter.Prompt != \"\" {\n  1273→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n  1274→\t\t\t\tsb.WriteString(inter.Prompt)\n  1275→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1276→\t\t\t}\n  1277→\n  1278→\t\t\t// Response section\n  1279→\t\t\tif len(inter.Responses) > 0 {\n  1280→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n  1281→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n  1282→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1283→\t\t\t}\n  1284→\n  1285→\t\t\t// Files modified for this interaction\n  1286→\t\t\tif len(inter.Files) > 0 {\n  1287→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(inter.Files))\n  1288→\t\t\t\tfor _, file := range inter.Files {\n  1289→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1290→\t\t\t\t}\n  1291→\t\t\t\tsb.WriteString(\"\\n\")\n  1292→\t\t\t}\n  1293→\t\t}\n  1294→\n  1295→\t\t// If no interactions, show message and/or files\n  1296→\t\tif len(cp.Interactions) == 0 {\n  1297→\t\t\t// Show commit message as summary when no transcript available\n  1298→\t\t\tif cp.Message != \"\" {\n  1299→\t\t\t\tsb.WriteString(cp.Message)\n  1300→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1301→\t\t\t}\n  1302→\t\t\t// Show aggregate files if available\n  1303→\t\t\tif len(cp.Files) > 0 {\n  1304→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(cp.Files))\n  1305→\t\t\t\tfor _, file := range cp.Files {\n  1306→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1307→\t\t\t\t}\n  1308→\t\t\t}\n  1309→\t\t}\n  1310→\t}\n  1311→\n  1312→\treturn sb.String()\n  1313→}\n  1314→\n  1315→// outputWithPager outputs content through a pager if stdout is a terminal and content is long.\n  1316→func outputWithPager(w io.Writer, content string) {\n  1317→\t// Check if we're writing to stdout and it's a terminal\n  1318→\tif f, ok := w.(*os.File); ok && f == os.Stdout && term.IsTerminal(int(f.Fd())) {\n  1319→\t\t// Get terminal height\n  1320→\t\t_, height, err := term.GetSize(int(f.Fd()))\n  1321→\t\tif err != nil {\n  1322→\t\t\theight = 24 // Default fallback\n  1323→\t\t}\n  1324→\n  1325→\t\t// Count lines in content\n  1326→\t\tlineCount := strings.Count(content, \"\\n\")\n  1327→\n  1328→\t\t// Use pager if content exceeds terminal height\n  1329→\t\tif lineCount > height-2 {\n  1330→\t\t\tpager := os.Getenv(\"PAGER\")\n  1331→\t\t\tif pager == \"\" {\n  1332→\t\t\t\tpager = \"less\"\n  1333→\t\t\t}\n  1334→\n  1335→\t\t\tcmd := exec.CommandContext(context.Background(), pager) //nolint:gosec // pager from env is expected\n  1336→\t\t\tcmd.Stdin = strings.NewReader(content)\n  1337→\t\t\tcmd.Stdout = f\n  1338→\t\t\tcmd.Stderr = os.Stderr\n  1339→\n  1340→\t\t\tif err := cmd.Run(); err != nil {\n  1341→\t\t\t\t// Fallback to direct output if pager fails\n  1342→\t\t\t\tfmt.Fprint(w, content)\n  1343→\t\t\t}\n  1344→\t\t\treturn\n  1345→\t\t}\n  1346→\t}\n  1347→\n  1348→\t// Direct output for non-terminal or short content\n  1349→\tfmt.Fprint(w, content)\n  1350→}\n  1351→\n  1352→// Constants for formatting output\n  1353→const (\n  1354→\t// maxIntentDisplayLength is the maximum length for intent text before truncation\n  1355→\tmaxIntentDisplayLength = 80\n  1356→\t// maxMessageDisplayLength is the maximum length for checkpoint messages before truncation\n  1357→\tmaxMessageDisplayLength = 80\n  1358→\t// maxPromptDisplayLength is the maximum length for session prompts before truncation\n  1359→\tmaxPromptDisplayLength = 60\n  1360→\t// checkpointIDDisplayLen