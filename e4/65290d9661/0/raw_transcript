anch>@<commit-hash>\" e.g. \"entire/metadata@abc123def456\"\n    36→\tSourceRefTrailerKey = \"Entire-Source-Ref\"\n    37→\n    38→\t// CheckpointTrailerKey links commits to their checkpoint metadata on entire/sessions.\n    39→\t// Format: 12 hex characters e.g. \"a3b2c4d5e6f7\"\n    40→\t// This trailer survives git amend and rebase operations.\n    41→\tCheckpointTrailerKey = \"Entire-Checkpoint\"\n    42→\n    43→\t// EphemeralBranchTrailerKey identifies the shadow branch that a checkpoint originated from.\n    44→\t// Used in manual-commit strategy checkpoint commits on entire/sessions branch.\n    45→\t// Format: full branch name e.g. \"entire/2b4c177\"\n    46→\tEphemeralBranchTrailerKey = \"Ephemeral-branch\"\n    47→\n    48→\t// AgentTrailerKey identifies the agent that created a checkpoint.\n    49→\t// Format: human-readable agent name e.g. \"Claude Code\", \"Cursor\"\n    50→\tAgentTrailerKey = \"Entire-Agent\"\n    51→)\n    52→\n    53→// Pre-compiled regexes for trailer parsing.\n    54→var (\n    55→\t// Trailer parsing regexes.\n    56→\tstrategyTrailerRegex     = regexp.MustCompile(StrategyTrailerKey + `:\\s*(.+)`)\n    57→\tmetadataTrailerRegex     = regexp.MustCompile(MetadataTrailerKey + `:\\s*(.+)`)\n    58→\ttaskMetadataTrailerRegex = regexp.MustCompile(MetadataTaskTrailerKey + `:\\s*(.+)`)\n    59→\tbaseCommitTrailerRegex   = regexp.MustCompile(BaseCommitTrailerKey + `:\\s*([a-f0-9]{40})`)\n    60→\tcondensationTrailerRegex = regexp.MustCompile(CondensationTrailerKey + `:\\s*(.+)`)\n    61→\tsessionTrailerRegex      = regexp.MustCompile(SessionTrailerKey + `:\\s*(.+)`)\n    62→\tcheckpointTrailerRegex   = regexp.MustCompile(CheckpointTrailerKey + `:\\s*(` + checkpointID.Pattern + `)(?:\\s|$)`)\n    63→)\n    64→\n    65→// ParseStrategy extracts strategy from commit message.\n    66→// Returns the strategy name and true if found, empty string and false otherwise.\n    67→func ParseStrategy(commitMessage string) (string, bool) {\n    68→\tmat