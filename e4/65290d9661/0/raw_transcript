h+paths.ContentHashFileName] = object.TreeEntry{\n   317→\t\tName: basePath + paths.ContentHashFileName,\n   318→\t\tMode: filemode.Regular,\n   319→\t\tHash: hashBlob,\n   320→\t}\n   321→\treturn nil\n   322→}\n   323→\n   324→// writeMetadataJSON writes the metadata.json file for the checkpoint.\n   325→// If existingMetadata is provided, merges session info from the previous session(s).\n   326→func (s *GitStore) writeMetadataJSON(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry, existingMetadata *CommittedMetadata) error {\n   327→\t// Note: Agents array is only populated during multi-session merge (below).\n   328→\t// For single-session checkpoints, we only set Agent (singular).\n   329→\tmetadata := CommittedMetadata{\n   330→\t\tCheckpointID:                opts.CheckpointID,\n   331→\t\tSessionID:                   opts.SessionID,\n   332→\t\tStrategy:                    opts.Strategy,\n   333→\t\tCreatedAt:                   time.Now().UTC(),\n   334→\t\tBranch:                      opts.Branch,\n   335→\t\tCheckpointsCount:            opts.CheckpointsCount,\n   336→\t\tFilesTouched:                opts.FilesTouched,\n   337→\t\tAgent:                       opts.Agent,\n   338→\t\tAgents:                      nil, // Only set during multi-session merge\n   339→\t\tIsTask:                      opts.IsTask,\n   340→\t\tToolUseID:                   opts.ToolUseID,\n   341→\t\tSessionCount:                1,\n   342→\t\tSessionIDs:                  []string{opts.SessionID},\n   343→\t\tTranscriptIdentifierAtStart: opts.TranscriptIdentifierAtStart,\n   344→\t\tTranscriptLinesAtStart:      opts.TranscriptLinesAtStart,\n   345→\t\tTokenUsage:                  opts.TokenUsage,\n   346→\t\tInitialAttribution:          opts.InitialAttribution,\n   347→\t}\n   348→\n   349→\t// Merge with existing metadata if present (multi-session checkpoint)\n   350→\tif existingMetadata != nil {\n   351→\t\t// Get existing session count (default to