ag, checkpointFlag, noPagerFlag, verbose, fullFlag, rawTranscriptFlag, generateFlag, forceFlag, searchAllFlag)\n   135→\t\t},\n   136→\t}\n   137→\n   138→\tcmd.Flags().StringVar(&sessionFlag, \"session\", \"\", \"Filter checkpoints by session ID (or prefix)\")\n   139→\tcmd.Flags().StringVar(&commitFlag, \"commit\", \"\", \"Explain a specific commit (SHA or ref)\")\n   140→\tcmd.Flags().StringVarP(&checkpointFlag, \"checkpoint\", \"c\", \"\", \"Explain a specific checkpoint (ID or prefix)\")\n   141→\tcmd.Flags().BoolVar(&noPagerFlag, \"no-pager\", false, \"Disable pager output\")\n   142→\tcmd.Flags().BoolVarP(&shortFlag, \"short\", \"s\", false, \"Show summary only (omit prompts and files)\")\n   143→\tcmd.Flags().BoolVar(&fullFlag, \"full\", false, \"Show parsed full transcript (all prompts/responses)\")\n   144→\tcmd.Flags().BoolVar(&rawTranscriptFlag, \"raw-transcript\", false, \"Show raw transcript file (JSONL format)\")\n   145→\tcmd.Flags().BoolVar(&generateFlag, \"generate\", false, \"Generate an AI summary for the checkpoint\")\n   146→\tcmd.Flags().BoolVar(&forceFlag, \"force\", false, \"Regenerate summary even if one already exists (requires --generate)\")\n   147→\tcmd.Flags().BoolVar(&searchAllFlag, \"search-all\", false, \"Search all commits (no branch/depth limit, may be slow)\")\n   148→\n   149→\t// Make --short, --full, and --raw-transcript mutually exclusive\n   150→\tcmd.MarkFlagsMutuallyExclusive(\"short\", \"full\", \"raw-transcript\")\n   151→\t// --generate and --raw-transcript are incompatible (summary would be generated but not shown)\n   152→\tcmd.MarkFlagsMutuallyExclusive(\"generate\", \"raw-transcript\")\n   153→\n   154→\treturn cmd\n   155→}\n   156→\n   157→// runExplain routes to the appropriate explain function based on flags.\n   158→func runExplain(w, errW io.Writer, sessionID, commitRef, checkpointID string, noPager, verbose, full, rawTranscript, generate, force, searchAll bool) error {\n   159→\t// Count mutually exclusive flags (--commit and --checkpoint are mutually exclusive)\n   160→\t// --session is now a filter for the list view, not a separate mode\n   161→\tflagCount := 0\n   162→\tif commitRef != \"\" {\n   163→\t\tflagCount++\n   164→\t}\n   165→\tif checkpointID != \"\" {\n   166→\t\tflagCount++\n   167→\t}\n   168→\t// If --session is combined with --commit or --checkpoint, that's still an error\n   169→\tif sessionID != \"\" && flagCount > 0 {\n   170→\t\treturn errors.New(\"cannot specify multiple of --session, --commit, --checkpoint\")\n   171→\t}\n   172→\tif flagCount > 1 {\n   173→\t\treturn errors.New(\"cannot specify multiple of --session, --commit, --checkpoint\")\n   174→\t}\n   175→\n   176→\t// Route to appropriate handler\n   177→\tif commitRef != \"\" {\n   178→\t\treturn runExplainCommit(w, commitRef, noPager, verbose, full, searchAll)\n   179→\t}\n   180→\tif checkpointID != \"\" {\n   181→\t\treturn runExplainCheckpoint(w, errW, checkpointID, noPager, verbose, full, rawTranscript, generate, force, searchAll)\n   182→\t}\n   183→\n   184→\t// Default or with session filter: show list view (optionally filtered by session)\n   185→\treturn runExplainBranchWithFilter(w, noPager, sessionID)\n   186→}\n   187→\n   188→// runExplainCheckpoint explains a specific checkpoint.\n   189→// Supports both committed checkpoints (by checkpoint ID) and temporary checkpoints (by git SHA).\n   190→// First tries to match committed checkpoints, then falls back to temporary checkpoints.\n   191→// When generate is true, generates an AI summary for the checkpoint.\n   192→// When force is true, regenerates even if a summary already exists.\n   193→// When rawTranscript is true, outputs only the raw transcript file (JSONL format).\n   194→// When searchAll is true, searches all commits without branch/depth limits (used for finding associated commits).\n   195→func runExplainCheckpoint(w, errW io.Writer, checkpointIDPrefix string, noPager, verbose, full, rawTranscript, generate, force, searchAll bool) error {\n   196→\trepo, err := openRepository()\n   197→\tif err != nil {\n   198→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   199→\t}\n   200→\n   201→\tstore := checkpoint.NewGitStore(repo)\n   202→\n   203→\t// First, try to find in committed checkpoints by checkpoint ID prefix\n   204→\tcommitted, err := store.ListCommitted(context.Background())\n   205→\tif err != nil {\n   206→\t\treturn fmt.Errorf(\"failed to list checkpoints: %w\", err)\n   207→\t}\n   208→\n   209→\t// Collect all matching checkpoint IDs to detect ambiguity\n   210→\tvar matches []id.CheckpointID\n   211→\tfor _, info := range committed {\n   212→\t\tif strings.HasPrefix(info.CheckpointID.String(), checkpointIDPrefix) {\n   213→\t\t\tmatches = append(matches, info.CheckpointID)\n   214→\t\t}\n   215→\t}\n   216→\n   217→\tvar fullCheckpointID id.CheckpointID\n   218→\tswitch len(matches) {\n   219→\tcase 0:\n   220→\t\t// Not found in committed, try temporary checkpoints by git SHA\n   221→\t\tif generate {\n   222→\t\t\treturn fmt.Errorf(\"cannot generate summary for temporary checkpoint %s (only committed checkpoints supported)\", checkpointIDPrefix)\n   223→\t\t}\n   224→\t\toutput, found := explainTemporaryCheckpoint(w, repo, store, checkpointIDPrefix, verbose, full, rawTranscript)\n   225→\t\tif found {\n   226→\t\t\toutputExplainContent(w, output, noPager)\n   227→\t\t\treturn nil\n   228→\t\t}\n   229→\t\t// If output is non-empty, it contains an error message (e.g., ambiguous prefix)\n   230→\t\tif output != \"\" {\n   231→\t\t\treturn errors.New(output)\n   232→\t\t}\n   233→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", checkpointIDPrefix)\n   234→\tcase 1:\n   235→\t\tfullCheckpointID = matches[0]\n   236→\tdefault:\n   237→\t\t// Ambiguous prefix - show up to 5 examples\n   238→\t\texamples := make([]string, 0, 5)\n   239→\t\tfor i := 0; i < len(matches) && i < 5; i++ {\n   240→\t\t\texamples = append(examples, matches[i].String())\n   241→\t\t}\n   242→\t\treturn fmt.Errorf(\"ambiguous checkpoint prefix %q matches %d checkpoints: %s\", checkpointIDPrefix, len(matches), strings.Join(examples, \", \"))\n   243→\t}\n   244→\n   245→\t// Load checkpoint data\n   246→\tresult, err := store.ReadCommitted(context.Background(), fullCheckpointID)\n   247→\tif err != nil {\n   248→\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   249→\t}\n   250→\tif result == nil {\n   251→\t\treturn fmt.Errorf(\"checkpoint not found: %s\", fullCheckpointID)\n   252→\t}\n   253→\n   254→\t// Handle summary generation\n   255→\tif generate {\n   256→\t\tif err := generateCheckpointSummary(w, errW, store, fullCheckpointID, result, force); err != nil {\n   257→\t\t\treturn err\n   258→\t\t}\n   259→\t\t// Reload the result to get the updated summary\n   260→\t\tresult, err = store.ReadCommitted(context.Background(), fullCheckpointID)\n   261→\t\tif err != nil {\n   262→\t\t\treturn fmt.Errorf(\"failed to reload checkpoint: %w\", err)\n   263→\t\t}\n   264→\t\tif result == nil {\n   265→\t\t\treturn fmt.Errorf(\"checkpoint not found after save: %s\", fullCheckpointID)\n   266→\t\t}\n   267→\t}\n   268→\n   269→\t// Handle raw transcript output\n   270→\tif rawTranscript {\n   271→\t\tif len(result.Transcript) == 0 {\n   272→\t\t\treturn fmt.Errorf(\"checkpoint %s has no transcript\", fullCheckpointID)\n   273→\t\t}\n   274→\t\t// Output raw transcript directly (no pager, no formatting)\n   275→\t\tif _, err = w.Write(result.Transcript); err != nil {\n   276→\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n   277→\t\t}\n   278→\t\treturn nil\n   279→\t}\n   280→\n   281→\t// Look up the author for this checkpoint (best-effort, ignore errors)\n   282→\tauthor, _ := store.GetCheckpointAuthor(context.Background(), fullCheckpointID) //nolint:errcheck // Author is optional\n   283→\n   284→\t// Find associated commits (git commits with matching Entire-Checkpoint trailer)\n   285→\tassociatedCommits, _ := getAssociatedCommits(repo, fullCheckpointID, searchAll) //nolint:errcheck // Best-effort\n   286→\n   287→\t// Format and output\n   288→\toutput := formatCheckpointOutput(result, fullCheckpointID, associatedCommits, author, verbose, full)\n   289→\toutputExplainContent(w, output, noPager)\n   290→\treturn nil\n   291→}\n   292→\n   293→// generateCheckpointSummary generates an AI summary for a checkpoint and persists it.\n   294→// The summary is generated from the scoped transcript (only this checkpoint's portion),\n   295→// not the entire session transcript.\n   296→func generateCheckpointSummary(w, _ io.Writer, store *checkpoint.GitStore, checkpointID id.CheckpointID, result *checkpoint.ReadCommittedResult, force bool) error {\n   297→\t// Check if summary already exists\n   298→\tif result.Metadata.Summary != nil && !force {\n   299→\t\treturn fmt.Errorf(\"checkpoint %s already has a summary (use --force to regenerate)\", checkpointID)\n   300→\t}\n   301→\n   302→\t// Check if transcript exists\n   303→\tif len(result.Transcript) == 0 {\n   304→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript to summarise\", checkpointID)\n   305→\t}\n   306→\n   307→\t// Scope the transcript to only this checkpoint's portion\n   308→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   309→\tif len(scopedTranscript) == 0 {\n   310→\t\treturn fmt.Errorf(\"checkpoint %s has no transcript content for this checkpoint (scoped)\", checkpointID)\n   311→\t}\n   312→\n   313→\t// Build condensed transcript for summarisation from the scoped portion\n   314→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(scopedTranscript)\n   315→\tif err != nil {\n   316→\t\treturn fmt.Errorf(\"failed to parse transcript: %w\", err)\n   317→\t}\n   318→\tif len(condensed) == 0 {\n   319→\t\treturn fmt.Errorf(\"checkpoint %s transcript has no content to summarise\", checkpointID)\n   320→\t}\n   321→\n   322→\tinput := summarise.Input{\n   323→\t\tTranscript:   condensed,\n   324→\t\tFilesTouched: result.Metadata.FilesTouched,\n   325→\t}\n   326→\n   327→\t// Generate summary using Claude CLI\n   328→\tctx := context.Background()\n   329→\tlogging.Info(ctx, \"generating checkpoint summary\")\n   330→\n   331→\tvar generator summarise.Generator = &summarise.ClaudeGenerator{}\n   332→\tsummary, err := generator.Generate(ctx, input)\n   333→\tif err != nil {\n   334→\t\treturn fmt.Errorf(\"failed to generate summary: %w\", err)\n   335→\t}\n   336→\n   337→\t// Persist the summary\n   338→\tif err := store.UpdateSummary(ctx, checkpointID, summary); err != nil {\n   339→\t\treturn fmt.Errorf(\"failed to save summary: %w\", err)\n   340→\t}\n   341→\n   342→\tfmt.Fprintln(w, \"✓ Summary generated and saved\")\n   343→\treturn nil\n   344→}\n   345→\n   346→// explainTemporaryCheckpoint finds and formats a temporary checkpoint by shadow commit hash prefix.\n   347→// Returns the formatted output and whether the checkpoint was found.\n   348→// Searches ALL shadow branches, not just the one for current HEAD, to find checkpoints\n   349→// created from different base commits (e.g., if HEAD advanced since session start).\n   350→// The writer w is used for raw transcript output to bypass the pager.\n   351→func explainTemporaryCheckpoint(w io.Writer, repo *git.Repository, store *checkpoint.GitStore, shaPrefix string, verbose, full, rawTranscript bool) (string, bool) {\n   352→\t// List temporary checkpoints from ALL shadow branches\n   353→\t// This ensures we find checkpoints even if HEAD has advanced since the session started\n   354→\ttempCheckpoints, err := store.ListAllTemporaryCheckpoints(context.Background(), \"\", branchCheckpointsLimit)\n   355→\tif err != nil {\n   356→\t\treturn \"\", false\n   357→\t}\n   358→\n   359→\t// Find checkpoints matching the SHA prefix - check for ambiguity\n   360→\tvar matches []checkpoint.TemporaryCheckpointInfo\n   361→\tfor _, tc := range tempCheckpoints {\n   362→\t\tif strings.HasPrefix(tc.CommitHash.String(), shaPrefix) {\n   363→\t\t\tmatches = append(matches, tc)\n   364→\t\t}\n   365→\t}\n   366→\n   367→\tif len(matches) == 0 {\n   368→\t\treturn \"\", false\n   369→\t}\n   370→\n   371→\tif len(matches) > 1 {\n   372→\t\t// Multiple matches - return ambiguous error (consistent with committed checkpoint behavior)\n   373→\t\tvar sb strings.Builder\n   374→\t\tfmt.Fprintf(&sb, \"ambiguous checkpoint prefix %q matches %d temporary checkpoints:\\n\", shaPrefix, len(matches))\n   375→\t\tfor _, m := range matches {\n   376→\t\t\tshortID := m.CommitHash.String()[:7]\n   377→\t\t\tfmt.Fprintf(&sb, \"  %s  %s  session %s\\n\",\n   378→\t\t\t\tshortID,\n   379→\t\t\t\tm.Timestamp.Format(\"2006-01-02 15:04:05\"),\n   380→\t\t\t\tm.SessionID)\n   381→\t\t}\n   382→\t\t// Return as \"not found\" with error message - caller will use this as error\n   383→\t\treturn sb.String(), false\n   384→\t}\n   385→\n   386→\ttc := matches[0]\n   387→\n   388→\t// Handle raw transcript output\n   389→\tif rawTranscript {\n   390→\t\ttranscriptBytes, transcriptErr := store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown)\n   391→\t\tif transcriptErr != nil || len(transcriptBytes) == 0 {\n   392→\t\t\t// Return specific error message (consistent with committed checkpoints)\n   393→\t\t\treturn fmt.Sprintf(\"checkpoint %s has no transcript\", tc.CommitHash.String()[:7]), false\n   394→\t\t}\n   395→\t\t// Write directly to writer (no pager, no formatting) - matches committed checkpoint behavior\n   396→\t\tif _, writeErr := fmt.Fprint(w, string(transcriptBytes)); writeErr != nil {\n   397→\t\t\treturn fmt.Sprintf(\"failed to write transcript: %v\", writeErr), false\n   398→\t\t}\n   399→\t\treturn \"\", true\n   400→\t}\n   401→\n   402→\t// Found exactly one match - read metadata from shadow branch commit tree\n   403→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n   404→\tif commitErr != nil {\n   405→\t\treturn \"\", false\n   406→\t}\n   407→\n   408→\tshadowTree, treeErr := shadowCommit.Tree()\n   409→\tif treeErr != nil {\n   410→\t\treturn \"\", false\n   411→\t}\n   412→\n   413→\t// Read prompts from shadow branch\n   414→\tsessionPrompt := strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n   415→\n   416→\t// Build output similar to formatCheckpointOutput but for temporary\n   417→\tvar sb strings.Builder\n   418→\tshortID := tc.CommitHash.String()[:7]\n   419→\tfmt.Fprintf(&sb, \"Checkpoint: %s [temporary]\\n\", shortID)\n   420→\tfmt.Fprintf(&sb, \"Session: %s\\n\", tc.SessionID)\n   421→\tfmt.Fprintf(&sb, \"Created: %s\\n\", tc.Timestamp.Format(\"2006-01-02 15:04:05\"))\n   422→\tsb.WriteString(\"\\n\")\n   423→\n   424→\t// Intent from prompt\n   425→\tintent := \"(not available)\"\n   426→\tif sessionPrompt != \"\" {\n   427→\t\tlines := strings.Split(sessionPrompt, \"\\n\")\n   428→\t\tif len(lines) > 0 && lines[0] != \"\" {\n   429→\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   430→\t\t}\n   431→\t}\n   432→\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   433→\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   434→\n   435→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   436→\t// For temporary checkpoints, load transcript and compute scope from parent commit\n   437→\tvar fullTranscript []byte\n   438→\tvar scopedTranscript []byte\n   439→\tif full || verbose {\n   440→\t\tfullTranscript, _ = store.GetTranscriptFromCommit(tc.CommitHash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   441→\n   442→\t\tif verbose && len(fullTranscript) > 0 {\n   443→\t\t\t// Compute scoped transcript by finding where parent's transcript ended\n   444→\t\t\t// Each shadow branch commit has the full transcript up to that point,\n   445→\t\t\t// so we diff against parent to get just this checkpoint's activity\n   446→\t\t\tscopedTranscript = fullTranscript // Default to full if no parent\n   447→\t\t\tif shadowCommit.NumParents() > 0 {\n   448→\t\t\t\tif parent, parentErr := shadowCommit.Parent(0); parentErr == nil {\n   449→\t\t\t\t\tparentTranscript, _ := store.GetTranscriptFromCommit(parent.Hash, tc.MetadataDir, agent.AgentTypeUnknown) //nolint:errcheck // Best-effort\n   450→\t\t\t\t\tif len(parentTranscript) > 0 {\n   451→\t\t\t\t\t\t// Count lines in parent transcript to know where to slice from\n   452→\t\t\t\t\t\tparentLineCount := countLines(parentTranscript)\n   453→\t\t\t\t\t\tscopedTranscript = transcript.SliceFromLine(fullTranscript, parentLineCount)\n   454→\t\t\t\t\t}\n   455→\t\t\t\t}\n   456→\t\t\t}\n   457→\t\t}\n   458→\t}\n   459→\tappendTranscriptSection(&sb, verbose, full, fullTranscript, scopedTranscript, sessionPrompt)\n   460→\n   461→\treturn sb.String(), true\n   462→}\n   463→\n   464→// getAssociatedCommits finds git commits that reference the given checkpoint ID.\n   465→// Searches commits on the current branch for Entire-Checkpoint trailer matches.\n   466→// When searchAll is true, removes the commit scan limit (may be slow).\n   467→func getAssociatedCommits(repo *git.Repository, checkpointID id.CheckpointID, searchAll bool) ([]associatedCommit, error) {\n   468→\thead, err := repo.Head()\n   469→\tif err != nil {\n   470→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   471→\t}\n   472→\n   473→\t// Determine scan limit\n   474→\tlimit := commitScanLimit\n   475→\tif searchAll {\n   476→\t\tlimit = 0 // No limit\n   477→\t}\n   478→\n   479→\t// Check if on default branch for filtering\n   480→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   481→\tvar mainBranchHash plumbing.Hash\n   482→\tif !isOnDefault {\n   483→\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   484→\t}\n   485→\n   486→\t// Precompute main branch commits for filtering (same logic as getBranchCheckpoints)\n   487→\treachableFromMain := make(map[plumbing.Hash]bool)\n   488→\tif mainBranchHash != plumbing.ZeroHash {\n   489→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   490→\t\tif mainErr == nil {\n   491→\t\t\tmainCount := 0\n   492→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort main branch detection\n   493→\t\t\t\tmainCount++\n   494→\t\t\t\tif mainCount > 1000 {\n   495→\t\t\t\t\treturn errStopIteration\n   496→\t\t\t\t}\n   497→\t\t\t\treachableFromMain[c.Hash] = true\n   498→\t\t\t\treturn nil\n   499→\t\t\t})\n   500→\t\t\tmainIter.Close()\n   501→\t\t}\n   502→\t}\n   503→\n   504→\titer, err := repo.Log(&git.LogOptions{\n   505→\t\tFrom:  head.Hash(),\n   506→\t\tOrder: git.LogOrderCommitterTime,\n   507→\t})\n   508→\tif err != nil {\n   509→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   510→\t}\n   511→\tdefer iter.Close()\n   512→\n   513→\tvar commits []associatedCommit\n   514→\tcount := 0\n   515→\ttargetID := checkpointID.String()\n   516→\n   517→\terr = iter.ForEach(func(c *object.Commit) error {\n   518→\t\tif limit > 0 && count >= limit {\n   519→\t\t\treturn errStopIteration\n   520→\t\t}\n   521→\t\tcount++\n   522→\n   523→\t\t// Skip commits on main when on feature branch (same filtering as list view)\n   524→\t\tif len(reachableFromMain) > 0 && reachableFromMain[c.Hash] {\n   525→\t\t\treturn nil\n   526→\t\t}\n   527→\n   528→\t\t// Check for matching checkpoint trailer\n   529→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   530→\t\tif !found || cpID.String() != targetID {\n   531→\t\t\treturn nil\n   532→\t\t}\n   533→\n   534→\t\tfullSHA := c.Hash.String()\n   535→\t\tshortSHA := fullSHA\n   536→\t\tif len(fullSHA) >= 7 {\n   537→\t\t\tshortSHA = fullSHA[:7]\n   538→\t\t}\n   539→\n   540→\t\tcommits = append(commits, associatedCommit{\n   541→\t\t\tSHA:      fullSHA,\n   542→\t\t\tShortSHA: shortSHA,\n   543→\t\t\tMessage:  strings.Split(c.Message, \"\\n\")[0],\n   544→\t\t\tAuthor:   c.Author.Name,\n   545→\t\t\tDate:     c.Author.When,\n   546→\t\t})\n   547→\n   548→\t\treturn nil\n   549→\t})\n   550→\n   551→\tif err != nil && !errors.Is(err, errStopIteration) {\n   552→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   553→\t}\n   554→\n   555→\treturn commits, nil\n   556→}\n   557→\n   558→// scopeTranscriptForCheckpoint slices a transcript to include only the lines\n   559→// relevant to a specific checkpoint, starting from linesAtStart.\n   560→// This allows showing only what happened during a checkpoint, not the entire session.\n   561→func scopeTranscriptForCheckpoint(fullTranscript []byte, linesAtStart int) []byte {\n   562→\treturn transcript.SliceFromLine(fullTranscript, linesAtStart)\n   563→}\n   564→\n   565→// extractPromptsFromTranscript extracts user prompts from transcript bytes.\n   566→// Returns a slice of prompt strings.\n   567→func extractPromptsFromTranscript(transcriptBytes []byte) []string {\n   568→\tif len(transcriptBytes) == 0 {\n   569→\t\treturn nil\n   570→\t}\n   571→\n   572→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   573→\tif err != nil {\n   574→\t\treturn nil\n   575→\t}\n   576→\n   577→\tvar prompts []string\n   578→\tfor _, entry := range condensed {\n   579→\t\tif entry.Type == summarise.EntryTypeUser && entry.Content != \"\" {\n   580→\t\t\tprompts = append(prompts, entry.Content)\n   581→\t\t}\n   582→\t}\n   583→\treturn prompts\n   584→}\n   585→\n   586→// formatCheckpointOutput formats checkpoint data based on verbosity level.\n   587→// When verbose is false: summary only (ID, session, timestamp, tokens, intent).\n   588→// When verbose is true: adds files, associated commits, and scoped transcript for this checkpoint.\n   589→// When full is true: shows parsed full session transcript instead of scoped transcript.\n   590→//\n   591→// Transcript scope is controlled by TranscriptLinesAtStart in metadata, which indicates\n   592→// where this checkpoint's content begins in the full session transcript.\n   593→//\n   594→// Author is displayed when available (only for committed checkpoints).\n   595→// Associated commits are git commits that reference this checkpoint via Entire-Checkpoint trailer.\n   596→func formatCheckpointOutput(result *checkpoint.ReadCommittedResult, checkpointID id.CheckpointID, associatedCommits []associatedCommit, author checkpoint.Author, verbose, full bool) string {\n   597→\tvar sb strings.Builder\n   598→\tmeta := result.Metadata\n   599→\n   600→\t// Scope the transcript to this checkpoint's portion\n   601→\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   602→\t// lines from that point onwards (excluding earlier checkpoint content)\n   603→\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, meta.TranscriptLinesAtStart)\n   604→\n   605→\t// Extract prompts from the scoped transcript for intent extraction\n   606→\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   607→\n   608→\t// Header - always shown\n   609→\t// Note: CheckpointID is always exactly 12 characters, matching checkpointIDDisplayLength\n   610→\tfmt.Fprintf(&sb, \"Checkpoint: %s\\n\", checkpointID)\n   611→\tfmt.Fprintf(&sb, \"Session: %s\\n\", meta.SessionID)\n   612→\tfmt.Fprintf(&sb, \"Created: %s\\n\", meta.CreatedAt.Format(\"2006-01-02 15:04:05\"))\n   613→\n   614→\t// Author (only for committed checkpoints with known author)\n   615→\tif author.Name != \"\" {\n   616→\t\tfmt.Fprintf(&sb, \"Author: %s <%s>\\n\", author.Name, author.Email)\n   617→\t}\n   618→\n   619→\t// Token usage\n   620→\tif meta.TokenUsage != nil {\n   621→\t\ttotalTokens := meta.TokenUsage.InputTokens + meta.TokenUsage.CacheCreationTokens +\n   622→\t\t\tmeta.TokenUsage.CacheReadTokens + meta.TokenUsage.OutputTokens\n   623→\t\tfmt.Fprintf(&sb, \"Tokens: %d\\n\", totalTokens)\n   624→\t}\n   625→\n   626→\t// Associated commits section\n   627→\tif len(associatedCommits) > 0 {\n   628→\t\tsb.WriteString(\"\\n\")\n   629→\t\tfmt.Fprintf(&sb, \"Commits: (%d)\\n\", len(associatedCommits))\n   630→\t\tfor _, c := range associatedCommits {\n   631→\t\t\tfmt.Fprintf(&sb, \"  %s %s %s\\n\", c.ShortSHA, c.Date.Format(\"2006-01-02\"), c.Message)\n   632→\t\t}\n   633→\t} else if associatedCommits != nil {\n   634→\t\t// associatedCommits is non-nil but empty - show \"no commits found\" message\n   635→\t\tsb.WriteString(\"\\nCommits: No commits found on this branch\\n\")\n   636→\t}\n   637→\n   638→\tsb.WriteString(\"\\n\")\n   639→\n   640→\t// Intent and Outcome from AI summary, or fallback to prompt text\n   641→\tif meta.Summary != nil {\n   642→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", meta.Summary.Intent)\n   643→\t\tfmt.Fprintf(&sb, \"Outcome: %s\\n\", meta.Summary.Outcome)\n   644→\t} else {\n   645→\t\t// Fallback: use first line of scoped prompts for intent,\n   646→\t\t// or fall back to result.Prompts for backwards compatibility with older checkpoints\n   647→\t\tintent := \"(not generated)\"\n   648→\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   649→\t\t\tintent = strategy.TruncateDescription(scopedPrompts[0], maxIntentDisplayLength)\n   650→\t\t} else if result.Prompts != \"\" {\n   651→\t\t\t// Backwards compatibility: use stored prompts if no transcript available\n   652→\t\t\tlines := strings.Split(result.Prompts, \"\\n\")\n   653→\t\t\tif len(lines) > 0 && lines[0] != \"\" {\n   654→\t\t\t\tintent = strategy.TruncateDescription(lines[0], maxIntentDisplayLength)\n   655→\t\t\t}\n   656→\t\t}\n   657→\t\tfmt.Fprintf(&sb, \"Intent: %s\\n\", intent)\n   658→\t\tsb.WriteString(\"Outcome: (not generated)\\n\")\n   659→\t}\n   660→\n   661→\t// Verbose: add learnings, friction, files, and scoped transcript\n   662→\tif verbose || full {\n   663→\t\t// AI Summary details (learnings, friction, open items)\n   664→\t\tif meta.Summary != nil {\n   665→\t\t\tformatSummaryDetails(&sb, meta.Summary)\n   666→\t\t}\n   667→\n   668→\t\tsb.WriteString(\"\\n\")\n   669→\n   670→\t\t// Files section\n   671→\t\tif len(meta.FilesTouched) > 0 {\n   672→\t\t\tfmt.Fprintf(&sb, \"Files: (%d)\\n\", len(meta.FilesTouched))\n   673→\t\t\tfor _, file := range meta.FilesTouched {\n   674→\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n   675→\t\t\t}\n   676→\t\t} else {\n   677→\t\t\tsb.WriteString(\"Files: (none)\\n\")\n   678→\t\t}\n   679→\t}\n   680→\n   681→\t// Transcript section: full shows entire session, verbose shows checkpoint scope\n   682→\tappendTranscriptSection(&sb, verbose, full, result.Transcript, scopedTranscript, result.Prompts)\n   683→\n   684→\treturn sb.String()\n   685→}\n   686→\n   687→// appendTranscriptSection appends the appropriate transcript section to the builder\n   688→// based on verbosity level. Full mode shows the entire session, verbose shows checkpoint scope.\n   689→// fullTranscript is the entire session transcript, scopedContent is either scoped transcript bytes\n   690→// or a pre-formatted string (for backwards compat), and scopedFallback is used when scoped parsing fails.\n   691→func appendTranscriptSection(sb *strings.Builder, verbose, full bool, fullTranscript, scopedTranscript []byte, scopedFallback string) {\n   692→\tswitch {\n   693→\tcase full:\n   694→\t\tsb.WriteString(\"\\n\")\n   695→\t\tsb.WriteString(\"Transcript (full session):\\n\")\n   696→\t\tsb.WriteString(formatTranscriptBytes(fullTranscript, \"\"))\n   697→\n   698→\tcase verbose:\n   699→\t\tsb.WriteString(\"\\n\")\n   700→\t\tsb.WriteString(\"Transcript (checkpoint scope):\\n\")\n   701→\t\tsb.WriteString(formatTranscriptBytes(scopedTranscript, scopedFallback))\n   702→\t}\n   703→}\n   704→\n   705→// formatTranscriptBytes formats transcript bytes into a human-readable string.\n   706→// It parses the JSONL transcript and formats it using the condensed format.\n   707→// The fallback is used for backwards compatibility when transcript parsing fails or is empty.\n   708→func formatTranscriptBytes(transcriptBytes []byte, fallback string) string {\n   709→\tif len(transcriptBytes) == 0 {\n   710→\t\tif fallback != \"\" {\n   711→\t\t\treturn fallback + \"\\n\"\n   712→\t\t}\n   713→\t\treturn \"  (none)\\n\"\n   714→\t}\n   715→\n   716→\tcondensed, err := summarise.BuildCondensedTranscriptFromBytes(transcriptBytes)\n   717→\tif err != nil || len(condensed) == 0 {\n   718→\t\tif fallback != \"\" {\n   719→\t\t\treturn fallback + \"\\n\"\n   720→\t\t}\n   721→\t\treturn \"  (failed to parse transcript)\\n\"\n   722→\t}\n   723→\n   724→\tinput := summarise.Input{Transcript: condensed}\n   725→\treturn summarise.FormatCondensedTranscript(input)\n   726→}\n   727→\n   728→// formatSummaryDetails formats the detailed sections of an AI summary.\n   729→func formatSummaryDetails(sb *strings.Builder, summary *checkpoint.Summary) {\n   730→\t// Learnings section\n   731→\thasLearnings := len(summary.Learnings.Repo) > 0 ||\n   732→\t\tlen(summary.Learnings.Code) > 0 ||\n   733→\t\tlen(summary.Learnings.Workflow) > 0\n   734→\n   735→\tif hasLearnings {\n   736→\t\tsb.WriteString(\"\\nLearnings:\\n\")\n   737→\n   738→\t\tif len(summary.Learnings.Repo) > 0 {\n   739→\t\t\tsb.WriteString(\"  Repository:\\n\")\n   740→\t\t\tfor _, learning := range summary.Learnings.Repo {\n   741→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   742→\t\t\t}\n   743→\t\t}\n   744→\n   745→\t\tif len(summary.Learnings.Code) > 0 {\n   746→\t\t\tsb.WriteString(\"  Code:\\n\")\n   747→\t\t\tfor _, learning := range summary.Learnings.Code {\n   748→\t\t\t\tif learning.Line > 0 {\n   749→\t\t\t\t\tif learning.EndLine > 0 {\n   750→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d-%d: %s\\n\", learning.Path, learning.Line, learning.EndLine, learning.Finding)\n   751→\t\t\t\t\t} else {\n   752→\t\t\t\t\t\tfmt.Fprintf(sb, \"    - %s:%d: %s\\n\", learning.Path, learning.Line, learning.Finding)\n   753→\t\t\t\t\t}\n   754→\t\t\t\t} else {\n   755→\t\t\t\t\tfmt.Fprintf(sb, \"    - %s: %s\\n\", learning.Path, learning.Finding)\n   756→\t\t\t\t}\n   757→\t\t\t}\n   758→\t\t}\n   759→\n   760→\t\tif len(summary.Learnings.Workflow) > 0 {\n   761→\t\t\tsb.WriteString(\"  Workflow:\\n\")\n   762→\t\t\tfor _, learning := range summary.Learnings.Workflow {\n   763→\t\t\t\tfmt.Fprintf(sb, \"    - %s\\n\", learning)\n   764→\t\t\t}\n   765→\t\t}\n   766→\t}\n   767→\n   768→\t// Friction section\n   769→\tif len(summary.Friction) > 0 {\n   770→\t\tsb.WriteString(\"\\nFriction:\\n\")\n   771→\t\tfor _, item := range summary.Friction {\n   772→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   773→\t\t}\n   774→\t}\n   775→\n   776→\t// Open items section\n   777→\tif len(summary.OpenItems) > 0 {\n   778→\t\tsb.WriteString(\"\\nOpen Items:\\n\")\n   779→\t\tfor _, item := range summary.OpenItems {\n   780→\t\t\tfmt.Fprintf(sb, \"  - %s\\n\", item)\n   781→\t\t}\n   782→\t}\n   783→}\n   784→\n   785→// runExplainDefault shows all checkpoints on the current branch.\n   786→// This is the default view when no flags are provided.\n   787→func runExplainDefault(w io.Writer, noPager bool) error {\n   788→\treturn runExplainBranchDefault(w, noPager)\n   789→}\n   790→\n   791→// branchCheckpointsLimit is the max checkpoints to show in branch view\n   792→const branchCheckpointsLimit = 100\n   793→\n   794→// commitScanLimit is how far back to scan git history for checkpoints\n   795→const commitScanLimit = 500\n   796→\n   797→// consecutiveMainLimit stops scanning after this many consecutive commits on main\n   798→// (indicates we've likely exhausted feature branch commits)\n   799→const consecutiveMainLimit = 100\n   800→\n   801→// errStopIteration is used to stop commit iteration early\n   802→var errStopIteration = errors.New(\"stop iteration\")\n   803→\n   804→// getBranchCheckpoints returns checkpoints relevant to the current branch.\n   805→// This is strategy-agnostic - it queries checkpoints directly from the checkpoint store.\n   806→//\n   807→// Behavior:\n   808→//   - On feature branches: only show checkpoints unique to this branch (not in main)\n   809→//   - On default branch (main/master): show all checkpoints in history (up to limit)\n   810→//   - Includes both committed checkpoints (entire/sessions) and temporary checkpoints (shadow branches)\n   811→func getBranchCheckpoints(repo *git.Repository, limit int) ([]strategy.RewindPoint, error) {\n   812→\tstore := checkpoint.NewGitStore(repo)\n   813→\n   814→\t// Get all committed checkpoints for lookup\n   815→\tcommittedInfos, err := store.ListCommitted(context.Background())\n   816→\tif err != nil {\n   817→\t\tcommittedInfos = nil // Continue without committed checkpoints\n   818→\t}\n   819→\n   820→\t// Build map of checkpoint ID -> committed info\n   821→\tcommittedByID := make(map[id.CheckpointID]checkpoint.CommittedInfo)\n   822→\tfor _, info := range committedInfos {\n   823→\t\tif !info.CheckpointID.IsEmpty() {\n   824→\t\t\tcommittedByID[info.CheckpointID] = info\n   825→\t\t}\n   826→\t}\n   827→\n   828→\thead, err := repo.Head()\n   829→\tif err != nil {\n   830→\t\t// Unborn HEAD (no commits yet) - return empty list instead of erroring\n   831→\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n   832→\t\t\treturn []strategy.RewindPoint{}, nil\n   833→\t\t}\n   834→\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n   835→\t}\n   836→\n   837→\t// Check if we're on the default branch (use repo-aware version)\n   838→\tisOnDefault, _ := strategy.IsOnDefaultBranch(repo)\n   839→\tvar mainBranchHash plumbing.Hash\n   840→\tif !isOnDefault {\n   841→\t\t// Prefer the actual default branch name (which may not be main/master)\n   842→\t\tif defaultBranchName := strategy.GetDefaultBranchName(repo); defaultBranchName != \"\" {\n   843→\t\t\t// Try local default branch first: refs/heads/<name>\n   844→\t\t\tref, refErr := repo.Reference(plumbing.ReferenceName(\"refs/heads/\"+defaultBranchName), true)\n   845→\t\t\tif refErr != nil {\n   846→\t\t\t\t// Fall back to remote default branch: refs/remotes/origin/<name>\n   847→\t\t\t\tref, refErr = repo.Reference(plumbing.ReferenceName(\"refs/remotes/origin/\"+defaultBranchName), true)\n   848→\t\t\t}\n   849→\t\t\tif refErr == nil {\n   850→\t\t\t\tmainBranchHash = ref.Hash()\n   851→\t\t\t}\n   852→\t\t}\n   853→\n   854→\t\t// Fall back to main/master detection if default branch resolution failed\n   855→\t\tif mainBranchHash == plumbing.ZeroHash {\n   856→\t\t\tmainBranchHash = strategy.GetMainBranchHash(repo)\n   857→\t\t}\n   858→\t}\n   859→\n   860→\t// Precompute commits reachable from main (for O(1) filtering instead of O(N) per commit)\n   861→\t// This changes the filtering from O(N*M) to O(N+M) where N=commits scanned, M=main history depth\n   862→\treachableFromMain := make(map[plumbing.Hash]bool)\n   863→\tif mainBranchHash != plumbing.ZeroHash {\n   864→\t\tmainIter, mainErr := repo.Log(&git.LogOptions{From: mainBranchHash})\n   865→\t\tif mainErr == nil {\n   866→\t\t\tmainCount := 0\n   867→\t\t\t_ = mainIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n   868→\t\t\t\tmainCount++\n   869→\t\t\t\tif mainCount > 1000 { // Same depth limit as before\n   870→\t\t\t\t\treturn errStopIteration\n   871→\t\t\t\t}\n   872→\t\t\t\treachableFromMain[c.Hash] = true\n   873→\t\t\t\treturn nil\n   874→\t\t\t})\n   875→\t\t\tmainIter.Close()\n   876→\t\t}\n   877→\t}\n   878→\n   879→\t// Walk git history and collect checkpoints\n   880→\titer, err := repo.Log(&git.LogOptions{\n   881→\t\tFrom:  head.Hash(),\n   882→\t\tOrder: git.LogOrderCommitterTime,\n   883→\t})\n   884→\tif err != nil {\n   885→\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n   886→\t}\n   887→\tdefer iter.Close()\n   888→\n   889→\tvar points []strategy.RewindPoint\n   890→\tcount := 0\n   891→\tconsecutiveMainCount := 0\n   892→\n   893→\terr = iter.ForEach(func(c *object.Commit) error {\n   894→\t\tif count >= commitScanLimit {\n   895→\t\t\treturn errStopIteration\n   896→\t\t}\n   897→\t\tcount++\n   898→\n   899→\t\t// On feature branches, skip commits that are reachable from main\n   900→\t\t// (but continue scanning - there may be more feature branch commits)\n   901→\t\tif len(reachableFromMain) > 0 {\n   902→\t\t\tif reachableFromMain[c.Hash] {\n   903→\t\t\t\tconsecutiveMainCount++\n   904→\t\t\t\tif consecutiveMainCount >= consecutiveMainLimit {\n   905→\t\t\t\t\treturn errStopIteration // Likely exhausted feature branch commits\n   906→\t\t\t\t}\n   907→\t\t\t\treturn nil // Skip this commit, continue scanning\n   908→\t\t\t}\n   909→\t\t\tconsecutiveMainCount = 0 // Reset on feature branch commit\n   910→\t\t}\n   911→\n   912→\t\t// Extract checkpoint ID from Entire-Checkpoint trailer\n   913→\t\tcpID, found := trailers.ParseCheckpoint(c.Message)\n   914→\t\tif !found {\n   915→\t\t\treturn nil // No checkpoint trailer, continue\n   916→\t\t}\n   917→\n   918→\t\t// Look up checkpoint info\n   919→\t\tcpInfo, found := committedByID[cpID]\n   920→\t\tif !found {\n   921→\t\t\treturn nil // Checkpoint not in store, continue\n   922→\t\t}\n   923→\n   924→\t\t// Create rewind point from committed info\n   925→\t\tmessage := strings.Split(c.Message, \"\\n\")[0]\n   926→\t\tpoint := strategy.RewindPoint{\n   927→\t\t\tID:               c.Hash.String(),\n   928→\t\t\tMessage:          message,\n   929→\t\t\tDate:             c.Committer.When,\n   930→\t\t\tIsLogsOnly:       true, // Committed checkpoints are logs-only\n   931→\t\t\tCheckpointID:     cpID,\n   932→\t\t\tSessionID:        cpInfo.SessionID,\n   933→\t\t\tIsTaskCheckpoint: cpInfo.IsTask,\n   934→\t\t\tToolUseID:        cpInfo.ToolUseID,\n   935→\t\t\tAgent:            cpInfo.Agent,\n   936→\t\t}\n   937→\t\t// Read session prompt from metadata branch (best-effort)\n   938→\t\tresult, _ := store.ReadCommitted(context.Background(), cpID) //nolint:errcheck  // Best-effort\n   939→\t\tif result != nil {\n   940→\t\t\t// Scope the transcript to this checkpoint's portion\n   941→\t\t\t// If TranscriptLinesAtStart > 0, we slice the transcript to only include\n   942→\t\t\t// lines from that point onwards (excluding earlier checkpoint content)\n   943→\t\t\tscopedTranscript := scopeTranscriptForCheckpoint(result.Transcript, result.Metadata.TranscriptLinesAtStart)\n   944→\t\t\t// Extract prompts from the scoped transcript (not the full session's prompts)\n   945→\t\t\tscopedPrompts := extractPromptsFromTranscript(scopedTranscript)\n   946→\t\t\tif len(scopedPrompts) > 0 && scopedPrompts[0] != \"\" {\n   947→\t\t\t\tpoint.SessionPrompt = scopedPrompts[0]\n   948→\t\t\t}\n   949→\t\t}\n   950→\n   951→\t\tpoints = append(points, point)\n   952→\t\treturn nil\n   953→\t})\n   954→\n   955→\tif err != nil && !errors.Is(err, errStopIteration) {\n   956→\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n   957→\t}\n   958→\n   959→\t// Get temporary checkpoints from ALL shadow branches whose base commit is reachable from HEAD.\n   960→\ttempPoints := getReachableTemporaryCheckpoints(repo, store, head.Hash(), isOnDefault, limit)\n   961→\tpoints = append(points, tempPoints...)\n   962→\n   963→\t// Sort by date, most recent first\n   964→\tsort.Slice(points, func(i, j int) bool {\n   965→\t\treturn points[i].Date.After(points[j].Date)\n   966→\t})\n   967→\n   968→\t// Apply limit\n   969→\tif len(points) > limit {\n   970→\t\tpoints = points[:limit]\n   971→\t}\n   972→\n   973→\treturn points, nil\n   974→}\n   975→\n   976→// getReachableTemporaryCheckpoints returns temporary checkpoints from shadow branches\n   977→// whose base commit is reachable from the given HEAD hash.\n   978→// For default branches, all shadow branches are included.\n   979→// For feature branches, only shadow branches whose base commit is in HEAD's history are included.\n   980→func getReachableTemporaryCheckpoints(repo *git.Repository, store *checkpoint.GitStore, headHash plumbing.Hash, isOnDefault bool, limit int) []strategy.RewindPoint {\n   981→\tvar points []strategy.RewindPoint\n   982→\n   983→\tshadowBranches, _ := store.ListTemporary(context.Background()) //nolint:errcheck // Best-effort\n   984→\tfor _, sb := range shadowBranches {\n   985→\t\t// Check if this shadow branch's base commit is reachable from current HEAD\n   986→\t\tif !isShadowBranchReachable(repo, sb.BaseCommit, headHash, isOnDefault) {\n   987→\t\t\tcontinue\n   988→\t\t}\n   989→\n   990→\t\t// List checkpoints from this shadow branch\n   991→\t\ttempCheckpoints, _ := store.ListCheckpointsForBranch(context.Background(), sb.BranchName, \"\", limit) //nolint:errcheck // Best-effort\n   992→\t\tfor _, tc := range tempCheckpoints {\n   993→\t\t\tpoint := convertTemporaryCheckpoint(repo, tc)\n   994→\t\t\tif point != nil {\n   995→\t\t\t\tpoints = append(points, *point)\n   996→\t\t\t}\n   997→\t\t}\n   998→\t}\n   999→\n  1000→\treturn points\n  1001→}\n  1002→\n  1003→// isShadowBranchReachable checks if a shadow branch's base commit is reachable from HEAD.\n  1004→// For default branches, all shadow branches are considered reachable.\n  1005→// For feature branches, we check if any commit with the base commit prefix is in HEAD's history.\n  1006→func isShadowBranchReachable(repo *git.Repository, baseCommit string, headHash plumbing.Hash, isOnDefault bool) bool {\n  1007→\t// For default branch: all shadow branches are potentially relevant\n  1008→\tif isOnDefault {\n  1009→\t\treturn true\n  1010→\t}\n  1011→\n  1012→\t// Check if base commit hash prefix matches any commit in HEAD's history\n  1013→\tbaseCommitIter, baseErr := repo.Log(&git.LogOptions{From: headHash})\n  1014→\tif baseErr != nil {\n  1015→\t\treturn false\n  1016→\t}\n  1017→\tdefer baseCommitIter.Close()\n  1018→\n  1019→\tbaseCount := 0\n  1020→\tfound := false\n  1021→\t_ = baseCommitIter.ForEach(func(c *object.Commit) error { //nolint:errcheck // Best-effort\n  1022→\t\tbaseCount++\n  1023→\t\tif baseCount > commitScanLimit {\n  1024→\t\t\treturn errStopIteration\n  1025→\t\t}\n  1026→\t\tif strings.HasPrefix(c.Hash.String(), baseCommit) {\n  1027→\t\t\tfound = true\n  1028→\t\t\treturn errStopIteration\n  1029→\t\t}\n  1030→\t\treturn nil\n  1031→\t})\n  1032→\n  1033→\treturn found\n  1034→}\n  1035→\n  1036→// convertTemporaryCheckpoint converts a TemporaryCheckpointInfo to a RewindPoint.\n  1037→// Returns nil if the checkpoint should be skipped (no code changes or can't be read).\n  1038→func convertTemporaryCheckpoint(repo *git.Repository, tc checkpoint.TemporaryCheckpointInfo) *strategy.RewindPoint {\n  1039→\tshadowCommit, commitErr := repo.CommitObject(tc.CommitHash)\n  1040→\tif commitErr != nil {\n  1041→\t\treturn nil\n  1042→\t}\n  1043→\n  1044→\t// Filter out checkpoints with no code changes (only .entire/ metadata changed)\n  1045→\t// This also filters out the first checkpoint which is just a baseline copy\n  1046→\tif !hasCodeChanges(shadowCommit) {\n  1047→\t\treturn nil\n  1048→\t}\n  1049→\n  1050→\t// Read session prompt from the shadow branch commit's tree (not from entire/sessions)\n  1051→\t// Temporary checkpoints store their metadata in the shadow branch, not in entire/sessions\n  1052→\tvar sessionPrompt string\n  1053→\tshadowTree, treeErr := shadowCommit.Tree()\n  1054→\tif treeErr == nil {\n  1055→\t\tsessionPrompt = strategy.ReadSessionPromptFromTree(shadowTree, tc.MetadataDir)\n  1056→\t}\n  1057→\n  1058→\treturn &strategy.RewindPoint{\n  1059→\t\tID:               tc.CommitHash.String(),\n  1060→\t\tMessage:          tc.Message,\n  1061→\t\tMetadataDir:      tc.MetadataDir,\n  1062→\t\tDate:             tc.Timestamp,\n  1063→\t\tIsTaskCheckpoint: tc.IsTaskCheckpoint,\n  1064→\t\tToolUseID:        tc.ToolUseID,\n  1065→\t\tSessionID:        tc.SessionID,\n  1066→\t\tSessionPrompt:    sessionPrompt,\n  1067→\t\tIsLogsOnly:       false, // Temporary checkpoints can be fully rewound\n  1068→\t}\n  1069→}\n  1070→\n  1071→// runExplainBranchWithFilter shows checkpoints on the current branch, optionally filtered by session.\n  1072→// This is strategy-agnostic - it queries checkpoints directly.\n  1073→func runExplainBranchWithFilter(w io.Writer, noPager bool, sessionFilter string) error {\n  1074→\trepo, err := openRepository()\n  1075→\tif err != nil {\n  1076→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1077→\t}\n  1078→\n  1079→\t// Get current branch name\n  1080→\tbranchName := strategy.GetCurrentBranchName(repo)\n  1081→\tif branchName == \"\" {\n  1082→\t\t// Detached HEAD state or unborn HEAD - try to use short commit hash if possible\n  1083→\t\thead, headErr := repo.Head()\n  1084→\t\tif headErr != nil {\n  1085→\t\t\t// Unborn HEAD (no commits yet) - treat as empty history instead of erroring\n  1086→\t\t\tif errors.Is(headErr, plumbing.ErrReferenceNotFound) {\n  1087→\t\t\t\tbranchName = \"HEAD (no commits yet)\"\n  1088→\t\t\t} else {\n  1089→\t\t\t\treturn fmt.Errorf(\"failed to get HEAD: %w\", headErr)\n  1090→\t\t\t}\n  1091→\t\t} else {\n  1092→\t\t\tbranchName = \"HEAD (\" + head.Hash().String()[:7] + \")\"\n  1093→\t\t}\n  1094→\t}\n  1095→\n  1096→\t// Get checkpoints for this branch (strategy-agnostic)\n  1097→\tpoints, err := getBranchCheckpoints(repo, branchCheckpointsLimit)\n  1098→\tif err != nil {\n  1099→\t\t// Log the error but continue with empty list so user sees helpful message\n  1100→\t\tlogging.Warn(context.Background(), \"failed to get branch checkpoints\", \"error\", err)\n  1101→\t\tpoints = nil\n  1102→\t}\n  1103→\n  1104→\t// Format output\n  1105→\toutput := formatBranchCheckpoints(branchName, points, sessionFilter)\n  1106→\n  1107→\toutputExplainContent(w, output, noPager)\n  1108→\treturn nil\n  1109→}\n  1110→\n  1111→// runExplainBranchDefault shows all checkpoints on the current branch grouped by date.\n  1112→// This is a convenience wrapper that calls runExplainBranchWithFilter with no filter.\n  1113→func runExplainBranchDefault(w io.Writer, noPager bool) error {\n  1114→\treturn runExplainBranchWithFilter(w, noPager, \"\")\n  1115→}\n  1116→\n  1117→// outputExplainContent outputs content with optional pager support.\n  1118→func outputExplainContent(w io.Writer, content string, noPager bool) {\n  1119→\tif noPager {\n  1120→\t\tfmt.Fprint(w, content)\n  1121→\t} else {\n  1122→\t\toutputWithPager(w, content)\n  1123→\t}\n  1124→}\n  1125→\n  1126→// runExplainCommit looks up the checkpoint associated with a commit.\n  1127→// Extracts the Entire-Checkpoint trailer and delegates to checkpoint detail view.\n  1128→// If no trailer found, shows a message indicating no associated checkpoint.\n  1129→func runExplainCommit(w io.Writer, commitRef string, noPager, verbose, full, searchAll bool) error {\n  1130→\trepo, err := openRepository()\n  1131→\tif err != nil {\n  1132→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n  1133→\t}\n  1134→\n  1135→\t// Resolve the commit reference\n  1136→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n  1137→\tif err != nil {\n  1138→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n  1139→\t}\n  1140→\n  1141→\tcommit, err := repo.CommitObject(*hash)\n  1142→\tif err != nil {\n  1143→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n  1144→\t}\n  1145→\n  1146→\t// Extract Entire-Checkpoint trailer\n  1147→\tcheckpointID, hasCheckpoint := trailers.ParseCheckpoint(commit.Message)\n  1148→\tif !hasCheckpoint {\n  1149→\t\tfmt.Fprintln(w, \"No associated Entire checkpoint\")\n  1150→\t\tfmt.Fprintf(w, \"\\nCommit %s does not have an Entire-Checkpoint trailer.\\n\", hash.String()[:7])\n  1151→\t\tfmt.Fprintln(w, \"This commit was not created during an Entire session, or the trailer was removed.\")\n  1152→\t\treturn nil\n  1153→\t}\n  1154→\n  1155→\t// Delegate to checkpoint detail view\n  1156→\t// Note: We pass a nil errW since runExplainCheckpoint only uses it for generate mode\n  1157→\treturn runExplainCheckpoint(w, nil, checkpointID.String(), noPager, verbose, full, false, false, false, searchAll)\n  1158→}\n  1159→\n  1160→// formatSessionInfo formats session information for display.\n  1161→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n  1162→\tvar sb strings.Builder\n  1163→\n  1164→\t// Session header\n  1165→\tfmt.Fprintf(&sb, \"Session: %s\\n\", session.ID)\n  1166→\tfmt.Fprintf(&sb, \"Strategy: %s\\n\", session.Strategy)\n  1167→\n  1168→\tif !session.StartTime.IsZero() {\n  1169→\t\tfmt.Fprintf(&sb, \"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\"))\n  1170→\t}\n  1171→\n  1172→\tif sourceRef != \"\" {\n  1173→\t\tfmt.Fprintf(&sb, \"Source Ref: %s\\n\", sourceRef)\n  1174→\t}\n  1175→\n  1176→\tfmt.Fprintf(&sb, \"Checkpoints: %d\\n\", len(checkpoints))\n  1177→\n  1178→\t// Checkpoint details\n  1179→\tfor _, cp := range checkpoints {\n  1180→\t\tsb.WriteString(\"\\n\")\n  1181→\n  1182→\t\t// Checkpoint header\n  1183→\t\ttaskMarker := \"\"\n  1184→\t\tif cp.IsTaskCheckpoint {\n  1185→\t\t\ttaskMarker = \" [Task]\"\n  1186→\t\t}\n  1187→\t\tfmt.Fprintf(&sb, \"─── Checkpoint %d [%s] %s%s ───\\n\",\n  1188→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker)\n  1189→\t\tsb.WriteString(\"\\n\")\n  1190→\n  1191→\t\t// Display all interactions in this checkpoint\n  1192→\t\tfor i, inter := range cp.Interactions {\n  1193→\t\t\t// For multiple interactions, add a sub-header\n  1194→\t\t\tif len(cp.Interactions) > 1 {\n  1195→\t\t\t\tfmt.Fprintf(&sb, \"### Interaction %d\\n\\n\", i+1)\n  1196→\t\t\t}\n  1197→\n  1198→\t\t\t// Prompt section\n  1199→\t\t\tif inter.Prompt != \"\" {\n  1200→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n  1201→\t\t\t\tsb.WriteString(inter.Prompt)\n  1202→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1203→\t\t\t}\n  1204→\n  1205→\t\t\t// Response section\n  1206→\t\t\tif len(inter.Responses) > 0 {\n  1207→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n  1208→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n  1209→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1210→\t\t\t}\n  1211→\n  1212→\t\t\t// Files modified for this interaction\n  1213→\t\t\tif len(inter.Files) > 0 {\n  1214→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(inter.Files))\n  1215→\t\t\t\tfor _, file := range inter.Files {\n  1216→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1217→\t\t\t\t}\n  1218→\t\t\t\tsb.WriteString(\"\\n\")\n  1219→\t\t\t}\n  1220→\t\t}\n  1221→\n  1222→\t\t// If no interactions, show message and/or files\n  1223→\t\tif len(cp.Interactions) == 0 {\n  1224→\t\t\t// Show commit message as summary when no transcript available\n  1225→\t\t\tif cp.Message != \"\" {\n  1226→\t\t\t\tsb.WriteString(cp.Message)\n  1227→\t\t\t\tsb.WriteString(\"\\n\\n\")\n  1228→\t\t\t}\n  1229→\t\t\t// Show aggregate files if available\n  1230→\t\t\tif len(cp.Files) > 0 {\n  1231→\t\t\t\tfmt.Fprintf(&sb, \"Files Modified (%d):\\n\", len(cp.Files))\n  1232→\t\t\t\tfor _, file := range cp.Files {\n  1233→\t\t\t\t\tfmt.Fprintf(&sb, \"  - %s\\n\", file)\n  1234→\t\t\t\t}\n  1235→\t\t\t}\n  1236→\t\t}\n  1237→\t}\n  1238→\n  1239→\treturn sb.String()\n  1240→}\n  1241→\n  1242→// outputWithPager outputs content through a pager if stdout is a terminal and content is long.\n  1243→func outputWithPager(w io.Writer, content string) {\n  1244→\t// Check if we're writing to stdout and it's a terminal\n  1245→\tif f, ok := w.(*os.File); ok && f == os.Stdout && term.IsTerminal(int(f.Fd())) {\n  1246→\t\t// Get terminal height\n  1247→\t\t_, height, err := term.GetSize(int(f.Fd()))\n  1248→\t\tif err != nil {\n  1249→\t\t\theight = 24 // Default fallback\n  1250→\t\t}\n  1251→\n  1252→\t\t// Count lines in content\n  1253→\t\tlineCount := strings.Count(content, \"\\n\")\n  1254→\n  1255→\t\t// Use pager if content exceeds terminal height\n  1256→\t\tif lineCount > height-2 {\n  1257→\t\t\tpager := os.Getenv(\"PAGER\")\n  1258→\t\t\tif pager == \"\" {\n  1259→\t\t\t\tpager = \"less\"\n  1260→\t\t\t}\n  1261→\n  1262→\t\t\tcmd := exec.CommandContext(context.Background(), pager) //nolint:gosec // pager from env is expected\n  1263→\t\t\tcmd.Stdin = strings.NewReader(content)\n  1264→\t\t\tcmd.Stdout = f\n  1265→\t\t\tcmd.Stderr = os.Stderr\n  1266→\n  1267→\t\t\tif err := cmd.Run(); err != nil {\n  1268→\t\t\t\t// Fallback to direct output if pager fails\n  1269→\t\t\t\tfmt.Fprint(w, content)\n  1270→\t\t\t}\n  1271→\t\t\treturn\n  1272→\t\t}\n  1273→\t}\n  1274→\n  1275→\t// Direct output for non-terminal or short content\n  1276→\tfmt.Fprint(w, content)\n  1277→}\n  1278→\n  1279→// Constants for formatting output\n  1280→const (\n  1281→\t// maxIntentDisplayLength is the maximum length for intent text before truncation\n  1282→\tmaxIntentDisplayLength = 80\n  1283→\t// maxMessageDisplayLength is the maximum length for checkpoint messages before truncation\n  1284→\tmaxMessageDisplayLength = 80\n  1285→\t// maxPromptDisplayLength is the maximum length for session prompts before truncation\n  1286→\tmaxPromptDisplayLength = 60\n  1287→\t// checkpointIDDisplayLength is the number of characters to show from checkpoint IDs\n  1288→\tcheckpointIDDisplayLength = 12\n  1289→)\n  1290→\n  1291→// formatBranchCheckpoints formats checkpoint information for a branch.\n  1292→// Groups commits by checkpoint ID and shows the prompt for each checkpoint.\n  1293→// If sessionFilter is non-empty, only shows checkpoints matching that session ID (or prefix).\n  1294→func formatBranchCheckpoints(branchName string, points []strategy.RewindPoint, sessionFilter string) string {\n  1295→\tvar sb strings.Builder\n  1296→\n  1297→\t// Branch header\n  1298→\tfmt.Fprintf(&sb, \"Branch: %s\\n\", branchName)\n  1299→\n  1300→\t// Filter by session if specified\n  1301→\tif sessionFilter != \"\" {\n  1302→\t\tvar filtered []strategy.RewindPoint\n  1303→\t\tfor _, p := range points {\n  1304→\t\t\tif p.SessionID ==