{"parentUuid":"071b8e44-98b0-4f2c-8abe-c33fc60a985d","isSidechain":false,"promptId":"bf940a70-aba4-4343-b9dc-fc09cebd6e75","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RM83BKNFCkenfnJSmq6Web","type":"tool_result","content":"1\tpackage session\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"log/slog\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"sync\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n18\t\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n19\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n20\t\t\"github.com/entireio/cli/cmd/entire/cli/osroot\"\n21\t\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n22\t)\n23\t\n24\tconst (\n25\t\t// SessionStateDirName is the directory name for session state files within git common dir.\n26\t\tSessionStateDirName = \"entire-sessions\"\n27\t\n28\t\t// StaleSessionThreshold is the duration after which an ended session is considered stale\n29\t\t// and will be automatically deleted during load/list operations.\n30\t\tStaleSessionThreshold = 7 * 24 * time.Hour\n31\t\n32\t\t// StuckActiveThreshold is the duration after which an ACTIVE session with no\n33\t\t// interaction is considered stuck (used by \"entire doctor\" and \"entire status\").\n34\t\tStuckActiveThreshold = 1 * time.Hour\n35\t)\n36\t\n37\t// State represents the state of an active session.\n38\t// This is stored in .git/entire-sessions/<session-id>.json\n39\ttype State struct {\n40\t\t// SessionID is the unique session identifier\n41\t\tSessionID string `json:\"session_id\"`\n42\t\n43\t\t// CLIVersion is the version of the CLI that created this session\n44\t\tCLIVersion string `json:\"cli_version,omitempty\"`\n45\t\n46\t\t// BaseCommit tracks the current shadow branch base. Initially set to HEAD when the\n47\t\t// session starts, but updated on migration (pull/rebase) and after condensation.\n48\t\t// Used for shadow branch naming and checkpoint storage — NOT for attribution.\n49\t\tBaseCommit string `json:\"base_commit\"`\n50\t\n51\t\t// AttributionBaseCommit is the commit used as the reference point for attribution calculations.\n52\t\t// Unlike BaseCommit (which tracks the shadow branch and moves with migration), this field\n53\t\t// preserves the original base commit so deferred condensation can correctly calculate\n54\t\t// agent vs human line attribution. Updated only after successful condensation.\n55\t\tAttributionBaseCommit string `json:\"attribution_base_commit,omitempty\"`\n56\t\n57\t\t// WorktreePath is the absolute path to the worktree root\n58\t\tWorktreePath string `json:\"worktree_path,omitempty\"`\n59\t\n60\t\t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n61\t\t// Derived from .git/worktrees/<name>/, stable across git worktree move\n62\t\tWorktreeID string `json:\"worktree_id,omitempty\"`\n63\t\n64\t\t// StartedAt is when the session was started\n65\t\tStartedAt time.Time `json:\"started_at\"`\n66\t\n67\t\t// EndedAt is when the session was explicitly closed by the user.\n68\t\t// nil means the session is still active or was not cleanly closed.\n69\t\tEndedAt *time.Time `json:\"ended_at,omitempty\"`\n70\t\n71\t\t// Phase is the lifecycle stage of this session (see phase.go).\n72\t\t// Empty means idle (backward compat with pre-state-machine files).\n73\t\tPhase Phase `json:\"phase,omitempty\"`\n74\t\n75\t\t// TurnID is a unique identifier for the current agent turn.\n76\t\t// Lifecycle:\n77\t\t//   - Generated fresh in InitializeSession at each turn start\n78\t\t//   - Shared across all checkpoints within the same turn\n79\t\t//   - Used to correlate related checkpoints when a turn's work spans multiple commits\n80\t\t//   - Persists until the next InitializeSession call generates a new one\n81\t\tTurnID string `json:\"turn_id,omitempty\"`\n82\t\n83\t\t// TurnCheckpointIDs tracks all checkpoint IDs condensed during the current turn.\n84\t\t// Lifecycle:\n85\t\t//   - Set in PostCommit when a checkpoint is condensed for an ACTIVE session\n86\t\t//   - Consumed in HandleTurnEnd to finalize all checkpoints with the full transcript\n87\t\t//   - Cleared in HandleTurnEnd after finalization completes\n88\t\t//   - Cleared in InitializeSession when a new prompt starts\n89\t\t//   - Cleared when session is reset (ResetSession deletes the state file entirely)\n90\t\tTurnCheckpointIDs []string `json:\"turn_checkpoint_ids,omitempty\"`\n91\t\n92\t\t// LastInteractionTime is updated on agent-interaction events (TurnStart,\n93\t\t// TurnEnd, SessionStop, Compaction) but NOT on git commit hooks.\n94\t\t// Used for stale session detection in \"entire doctor\".\n95\t\tLastInteractionTime *time.Time `json:\"last_interaction_time,omitempty\"`\n96\t\n97\t\t// StepCount is the number of checkpoints/steps created in this session.\n98\t\t// JSON tag kept as \"checkpoint_count\" for backward compatibility with existing state files.\n99\t\tStepCount int `json:\"checkpoint_count\"`\n100\t\n101\t\t// CheckpointTranscriptStart is the transcript line offset where the current\n102\t\t// checkpoint cycle began. Set to 0 at session start, updated to current\n103\t\t// transcript length after each condensation. Used to scope the transcript\n104\t\t// for checkpoint condensation: \"everything since last checkpoint\".\n105\t\tCheckpointTranscriptStart int `json:\"checkpoint_transcript_start,omitempty\"`\n106\t\n107\t\t// CheckpointTranscriptSize is the byte size of the transcript at last condensation.\n108\t\t// Used for fast \"has new content?\" checks in PostCommit: compare the git blob size\n109\t\t// against this value without reading the full transcript content.\n110\t\tCheckpointTranscriptSize int64 `json:\"checkpoint_transcript_size,omitempty\"`\n111\t\n112\t\t// CompactTranscriptStart is the transcript.jsonl line offset where the current\n113\t\t// checkpoint cycle began. It parallels CheckpointTranscriptStart (full.jsonl)\n114\t\t// and is updated after each condensation.\n115\t\tCompactTranscriptStart int `json:\"compact_transcript_start,omitempty\"`\n116\t\n117\t\t// Deprecated: CondensedTranscriptLines is replaced by CheckpointTranscriptStart.\n118\t\t// Kept for backward compatibility with existing state files.\n119\t\t// Use NormalizeAfterLoad() to migrate.\n120\t\tCondensedTranscriptLines int `json:\"condensed_transcript_lines,omitempty\"`\n121\t\n122\t\t// UntrackedFilesAtStart tracks files that existed at session start (to preserve during rewind)\n123\t\tUntrackedFilesAtStart []string `json:\"untracked_files_at_start,omitempty\"`\n124\t\n125\t\t// FilesTouched tracks files modified/created/deleted during this session\n126\t\tFilesTouched []string `json:\"files_touched,omitempty\"`\n127\t\n128\t\t// LastCheckpointID is the checkpoint ID from the most recent condensation.\n129\t\t// Used to restore the Entire-Checkpoint trailer on amend and to identify\n130\t\t// sessions that have been condensed at least once. Cleared on new prompt.\n131\t\tLastCheckpointID id.CheckpointID `json:\"last_checkpoint_id,omitempty\"`\n132\t\n133\t\t// LastCheckpointCommitHash is the exact commit SHA that carried\n134\t\t// LastCheckpointID at condensation time. Used by the reconcile path to\n135\t\t// distinguish \"reset back to the condensed commit\" (same SHA) from\n136\t\t// \"cherry-picked / rebased a commit that happens to preserve the trailer\"\n137\t\t// (different SHA). Without this guard, a cherry-picked checkpoint would\n138\t\t// falsely fire reconcile and drop the pinned AttributionBaseCommit,\n139\t\t// corrupting attribution math for uncondensed shadow-branch work.\n140\t\t// Empty for legacy state files — reconcile falls back to trailer-only\n141\t\t// matching for backward compatibility.\n142\t\tLastCheckpointCommitHash string `json:\"last_checkpoint_commit_hash,omitempty\"`\n143\t\n144\t\t// FullyCondensed indicates this session has been condensed and has no remaining\n145\t\t// carry-forward files. PostCommit skips fully-condensed sessions entirely.\n146\t\t// Set after successful condensation when no files remain for carry-forward\n147\t\t// and the session phase is ENDED. Cleared on session reactivation (ENDED →\n148\t\t// ACTIVE via TurnStart, or ENDED → IDLE via SessionStart) by ActionClearEndedAt.\n149\t\tFullyCondensed bool `json:\"fully_condensed,omitempty\"`\n150\t\n151\t\t// DivergenceNoticeShown indicates the prepare-commit-msg warning about\n152\t\t// attribution divergence has been shown. Set when the warning fires,\n153\t\t// cleared when AttributionBaseCommit realigns with BaseCommit (next\n154\t\t// successful condensation). Prevents repeated warnings on every commit.\n155\t\tDivergenceNoticeShown bool `json:\"divergence_notice_shown,omitempty\"`\n156\t\n157\t\t// AttachedManually indicates this session was imported via `entire attach` rather\n158\t\t// than being captured by hooks during normal agent execution.\n159\t\tAttachedManually bool `json:\"attached_manually,omitempty\"`\n160\t\n161\t\t// AgentType identifies the agent that created this session (e.g., \"Claude Code\", \"Gemini CLI\", \"Cursor\")\n162\t\tAgentType types.AgentType `json:\"agent_type,omitempty\"`\n163\t\n164\t\t// ModelName is the LLM model used in this session (e.g., \"claude-sonnet-4-20250514\", \"gpt-4o\").\n165\t\t// Set from hook data when the agent provides it.\n166\t\tModelName string `json:\"model_name,omitempty\"`\n167\t\n168\t\t// Token usage tracking (accumulated across all checkpoints in this session)\n169\t\tTokenUsage *agent.TokenUsage `json:\"token_usage,omitempty\"`\n170\t\n171\t\t// Hook-provided session metrics (for agents like Cursor that report via hooks)\n172\t\tSessionDurationMs int64 `json:\"session_duration_ms,omitempty\"`\n173\t\tSessionTurnCount  int   `json:\"session_turn_count,omitempty\"`\n174\t\tContextTokens     int   `json:\"context_tokens,omitempty\"`\n175\t\tContextWindowSize int   `json:\"context_window_size,omitempty\"`\n176\t\n177\t\t// Deprecated: TranscriptLinesAtStart is replaced by CheckpointTranscriptStart.\n178\t\t// Kept for backward compatibility with existing state files.\n179\t\tTranscriptLinesAtStart int `json:\"transcript_lines_at_start,omitempty\"`\n180\t\n181\t\t// TranscriptIdentifierAtStart is the last transcript identifier when the session started.\n182\t\t// Used for identifier-based transcript scoping (UUID for Claude, message ID for Gemini).\n183\t\tTranscriptIdentifierAtStart string `json:\"transcript_identifier_at_start,omitempty\"`\n184\t\n185\t\t// TranscriptPath is the path to the live transcript file (for mid-session commit detection)\n186\t\tTranscriptPath string `json:\"transcript_path,omitempty\"`\n187\t\n188\t\t// LastPrompt is the most recent user prompt for this session (truncated for display).\n189\t\t// Updated on every turn start (UserPromptSubmit). JSON tag kept as \"first_prompt\"\n190\t\t// for backward compatibility with existing state files.\n191\t\tLastPrompt string `json:\"last_prompt,omitempty\"`\n192\t\n193\t\t// PromptAttributions tracks user and agent line changes at each prompt start.\n194\t\t// This enables accurate attribution by capturing user edits between checkpoints.\n195\t\tPromptAttributions []PromptAttribution `json:\"prompt_attributions,omitempty\"`\n196\t\n197\t\t// PendingPromptAttribution holds attribution calculated at prompt start (before agent runs).\n198\t\t// This is moved to PromptAttributions when SaveStep is called.\n199\t\tPendingPromptAttribution *PromptAttribution `json:\"pending_prompt_attribution,omitempty\"`\n200\t}\n201\t\n202\t// PromptAttribution captures line-level attribution data at the start of each prompt.\n203\t// By recording what changed since the last checkpoint BEFORE the agent works,\n204\t// we can accurately separate user edits from agent contributions.\n205\ttype PromptAttribution struct {\n206\t\t// CheckpointNumber is which checkpoint this was recorded before (1-indexed)\n207\t\tCheckpointNumber int `json:\"checkpoint_number\"`\n208\t\n209\t\t// UserLinesAdded is lines added by user since the last checkpoint\n210\t\tUserLinesAdded int `json:\"user_lines_added\"`\n211\t\n212\t\t// UserLinesRemoved is lines removed by user since the last checkpoint\n213\t\tUserLinesRemoved int `json:\"user_lines_removed\"`\n214\t\n215\t\t// AgentLinesAdded is total agent lines added so far (base → last checkpoint).\n216\t\t// Always 0 for checkpoint 1 since there's no previous checkpoint to measure against.\n217\t\tAgentLinesAdded int `json:\"agent_lines_added\"`\n218\t\n219\t\t// AgentLinesRemoved is total agent lines removed so far (base → last checkpoint).\n220\t\t// Always 0 for checkpoint 1 since there's no previous checkpoint to measure against.\n221\t\tAgentLinesRemoved int `json:\"agent_lines_removed\"`\n222\t\n223\t\t// UserAddedPerFile tracks per-file user additions for accurate modification tracking.\n224\t\t// This enables distinguishing user self-modifications from agent modifications.\n225\t\t// See docs/architecture/attribution.md for details.\n226\t\tUserAddedPerFile map[string]int `json:\"user_added_per_file,omitempty\"`\n227\t\n228\t\t// UserRemovedPerFile tracks per-file user removals for accurate agent deletion attribution.\n229\t\t// Without this, global user removals would be subtracted from agent-file-only removals,\n230\t\t// incorrectly reducing agent deletion credit when users delete lines in non-agent files.\n231\t\tUserRemovedPerFile map[string]int `json:\"user_removed_per_file,omitempty\"`\n232\t}\n233\t\n234\t// NormalizeAfterLoad applies backward-compatible migrations to state loaded from disk.\n235\t// Call this after deserializing a State from JSON.\n236\tfunc (s *State) NormalizeAfterLoad(ctx context.Context) {\n237\t\t// Normalize legacy phase values. \"active_committed\" was removed with the\n238\t\t// 1:1 checkpoint model in favor of the state machine handling commits\n239\t\t// during ACTIVE phase with immediate condensation.\n240\t\tif s.Phase == \"active_committed\" {\n241\t\t\tlogCtx := logging.WithComponent(ctx, \"session\")\n242\t\t\tlogging.Info(logCtx, \"migrating legacy active_committed phase to active\",\n243\t\t\t\tslog.String(\"session_id\", s.SessionID),\n244\t\t\t)\n245\t\t\ts.Phase = PhaseActive\n246\t\t}\n247\t\t// Also normalize via PhaseFromString to handle any other legacy/unknown values.\n248\t\ts.Phase = PhaseFromString(string(s.Phase))\n249\t\n250\t\t// Migrate transcript fields: CheckpointTranscriptStart replaces both\n251\t\t// CondensedTranscriptLines and TranscriptLinesAtStart from older state files.\n252\t\tif s.CheckpointTranscriptStart == 0 {\n253\t\t\tif s.CondensedTranscriptLines > 0 {\n254\t\t\t\ts.CheckpointTranscriptStart = s.CondensedTranscriptLines\n255\t\t\t} else if s.TranscriptLinesAtStart > 0 {\n256\t\t\t\ts.CheckpointTranscriptStart = s.TranscriptLinesAtStart\n257\t\t\t}\n258\t\t}\n259\t\t// Clear deprecated fields so they aren't re-persisted.\n260\t\t// Note: this is a one-way migration. If the state is re-saved, older CLI versions\n261\t\t// will see 0 for these fields and fall back to scoping from the transcript start.\n262\t\t// This is acceptable since CLI upgrades are monotonic and the worst case is\n263\t\t// redundant transcript content in a condensation, not data loss.\n264\t\ts.CondensedTranscriptLines = 0\n265\t\ts.TranscriptLinesAtStart = 0\n266\t\n267\t\t// Backfill AttributionBaseCommit for sessions created before this field existed.\n268\t\t// Without this, a mid-turn commit would migrate BaseCommit and the fallback in\n269\t\t// calculateSessionAttributions would use the migrated value, producing zero attribution.\n270\t\tif s.AttributionBaseCommit == \"\" && s.BaseCommit != \"\" {\n271\t\t\ts.AttributionBaseCommit = s.BaseCommit\n272\t\t}\n273\t\n274\t\t// DivergenceNoticeShown is only meaningful while attribution is actually\n275\t\t// diverged. Self-heal any state file where the flag outlived the divergence\n276\t\t// — otherwise a future legitimate divergence would be silently suppressed.\n277\t\tif s.DivergenceNoticeShown && s.AttributionBaseCommit == s.BaseCommit {\n278\t\t\ts.DivergenceNoticeShown = false\n279\t\t}\n280\t}\n281\t\n282\t// RealignAttributionBase sets AttributionBaseCommit to newBase and clears any\n283\t// bookkeeping whose meaning depends on attribution being diverged from the\n284\t// shadow-branch base. Call this every time a code path intentionally brings\n285\t// AttributionBaseCommit back in line with BaseCommit (condensation, reconcile,\n286\t// post-commit base advance) so a stale DivergenceNoticeShown cannot suppress\n287\t// the next legitimate divergence warning.\n288\tfunc (s *State) RealignAttributionBase(newBase string) {\n289\t\ts.AttributionBaseCommit = newBase\n290\t\ts.DivergenceNoticeShown = false\n291\t}\n292\t\n293\t// IsStale returns true when a session hasn't seen interaction for longer than\n294\t// StaleSessionThreshold. Falls back to StartedAt when LastInteractionTime is\n295\t// nil (sessions created before interaction tracking was added).\n296\t// IsStuckActive returns true if the session is in ACTIVE phase but has not had\n297\t// any interaction for longer than StuckActiveThreshold. Falls back to StartedAt\n298\t// when LastInteractionTime is nil, so brand-new sessions are not falsely flagged.\n299\tfunc (s *State) IsStuckActive() bool {\n300\t\tif !s.Phase.IsActive() {\n301\t\t\treturn false\n302\t\t}\n303\t\tref := s.LastInteractionTime\n304\t\tif ref == nil {\n305\t\t\tref = &s.StartedAt\n306\t\t}\n307\t\treturn time.Since(*ref) > StuckActiveThreshold\n308\t}\n309\t\n310\tfunc (s *State) IsStale() bool {\n311\t\tvar since time.Duration\n312\t\tif s.LastInteractionTime != nil {\n313\t\t\tsince = time.Since(*s.LastInteractionTime)\n314\t\t} else {\n315\t\t\tsince = time.Since(s.StartedAt)\n316\t\t}\n317\t\treturn since > StaleSessionThreshold\n318\t}\n319\t\n320\t// StateStore provides low-level operations for managing session state files.\n321\t//\n322\t// StateStore is a primitive for session state persistence. It is NOT the same as\n323\t// the Sessions interface - it only handles state files in .git/entire-sessions/,\n324\t// not the full session data which includes checkpoint content.\n325\t//\n326\t// Use StateStore directly in strategies for performance-critical state operations.\n327\t// Use the Sessions interface (when implemented) for high-level session management.\n328\ttype StateStore struct {\n329\t\t// stateDir is the directory where session state files are stored\n330\t\tstateDir string\n331\t}\n332\t\n333\t// NewStateStore creates a new state store.\n334\t// Uses the git common dir to store session state (shared across worktrees).\n335\tfunc NewStateStore(ctx context.Context) (*StateStore, error) {\n336\t\tcommonDir, err := getGitCommonDir(ctx)\n337\t\tif err != nil {\n338\t\t\treturn nil, fmt.Errorf(\"failed to get git common dir: %w\", err)\n339\t\t}\n340\t\treturn &StateStore{\n341\t\t\tstateDir: filepath.Join(commonDir, SessionStateDirName),\n342\t\t}, nil\n343\t}\n344\t\n345\t// NewStateStoreWithDir creates a new state store with a custom directory.\n346\t// This is useful for testing.\n347\tfunc NewStateStoreWithDir(stateDir string) *StateStore {\n348\t\treturn &StateStore{stateDir: stateDir}\n349\t}\n350\t\n351\t// Load loads the session state for the given session ID.\n352\t// Returns (nil, nil) when session file doesn't exist or session is stale (not an error condition).\n353\t// Stale sessions (ended longer than StaleSessionThreshold ago) are automatically deleted.\n354\tfunc (s *StateStore) Load(ctx context.Context, sessionID string) (*State, error) {\n355\t\t// Validate session ID to prevent path traversal\n356\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n357\t\t\treturn nil, fmt.Errorf(\"invalid session ID: %w\", err)\n358\t\t}\n359\t\n360\t\troot, err := os.OpenRoot(s.stateDir)\n361\t\tif os.IsNotExist(err) {\n362\t\t\treturn nil, nil //nolint:nilnil // nil,nil indicates session not found (expected case)\n363\t\t}\n364\t\tif err != nil {\n365\t\t\treturn nil, fmt.Errorf(\"failed to open session state directory: %w\", err)\n366\t\t}\n367\t\tdefer root.Close()\n368\t\n369\t\tfileName := sessionID + \".json\"\n370\t\tdata, err := osroot.ReadFile(root, fileName)\n371\t\tif os.IsNotExist(err) {\n372\t\t\treturn nil, nil //nolint:nilnil // nil,nil indicates session not found (expected case)\n373\t\t}\n374\t\tif err != nil {\n375\t\t\treturn nil, fmt.Errorf(\"failed to read session state: %w\", err)\n376\t\t}\n377\t\n378\t\tvar state State\n379\t\tif err := json.Unmarshal(data, &state); err != nil {\n380\t\t\treturn nil, fmt.Errorf(\"failed to unmarshal session state: %w\", err)\n381\t\t}\n382\t\tstate.NormalizeAfterLoad(ctx)\n383\t\n384\t\tif state.IsStale() {\n385\t\t\tlogCtx := logging.WithComponent(ctx, \"session\")\n386\t\t\tlogging.Debug(logCtx, \"deleting stale session state\",\n387\t\t\t\tslog.String(\"session_id\", sessionID),\n388\t\t\t)\n389\t\t\t_ = s.Clear(ctx, sessionID) //nolint:errcheck // best-effort cleanup of stale session\n390\t\t\treturn nil, nil             //nolint:nilnil // stale session treated as not found\n391\t\t}\n392\t\n393\t\treturn &state, nil\n394\t}\n395\t\n396\t// Save saves the session state atomically.\n397\tfunc (s *StateStore) Save(ctx context.Context, state *State) error {\n398\t\t_ = ctx // Reserved for future use\n399\t\n400\t\t// Validate session ID to prevent path traversal\n401\t\tif err := validation.ValidateSessionID(state.SessionID); err != nil {\n402\t\t\treturn fmt.Errorf(\"invalid session ID: %w\", err)\n403\t\t}\n404\t\n405\t\tif err := os.MkdirAll(s.stateDir, 0o750); err != nil {\n406\t\t\treturn fmt.Errorf(\"failed to create session state directory: %w\", err)\n407\t\t}\n408\t\n409\t\tdata, err := jsonutil.MarshalIndentWithNewline(state, \"\", \"  \")\n410\t\tif err != nil {\n411\t\t\treturn fmt.Errorf(\"failed to marshal session state: %w\", err)\n412\t\t}\n413\t\n414\t\t// Use os.Root for traversal-resistant write of temp file.\n415\t\t// Rename is not available on os.Root, so we keep using os.Rename.\n416\t\troot, err := os.OpenRoot(s.stateDir)\n417\t\tif err != nil {\n418\t\t\treturn fmt.Errorf(\"failed to open session state directory: %w\", err)\n419\t\t}\n420\t\tdefer root.Close()\n421\t\n422\t\tfileName := state.SessionID + \".json\"\n423\t\ttmpFileName := fileName + \".tmp\"\n424\t\tif err := osroot.WriteFile(root, tmpFileName, data, 0o600); err != nil {\n425\t\t\treturn fmt.Errorf(\"failed to write session state: %w\", err)\n426\t\t}\n427\t\n428\t\t// Atomic rename: not available on os.Root, use os.Rename with validated paths.\n429\t\tstateFile := s.stateFilePath(state.SessionID)\n430\t\ttmpFile := stateFile + \".tmp\"\n431\t\tif err := os.Rename(tmpFile, stateFile); err != nil {\n432\t\t\treturn fmt.Errorf(\"failed to rename session state file: %w\", err)\n433\t\t}\n434\t\treturn nil\n435\t}\n436\t\n437\t// Clear removes the session state file for the given session ID.\n438\tfunc (s *StateStore) Clear(ctx context.Context, sessionID string) error {\n439\t\t_ = ctx // Reserved for future use\n440\t\n441\t\t// Validate session ID to prevent path traversal\n442\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n443\t\t\treturn fmt.Errorf(\"invalid session ID: %w\", err)\n444\t\t}\n445\t\n446\t\t// Remove all files for this session (state .json, .model hint, any future hint files).\n447\t\t// filepath.Glob finds matches; os.Root ensures traversal-resistant removal.\n448\t\tmatches, _ := filepath.Glob(filepath.Join(s.stateDir, sessionID+\".*\")) //nolint:errcheck // pattern is always valid\n449\t\tif len(matches) > 0 {\n450\t\t\troot, rootErr := os.OpenRoot(s.stateDir)\n451\t\t\tif rootErr != nil {\n452\t\t\t\treturn fmt.Errorf(\"failed to open session state directory for cleanup: %w\", rootErr)\n453\t\t\t}\n454\t\t\tdefer root.Close()\n455\t\t\tfor _, f := range matches {\n456\t\t\t\t_ = osroot.Remove(root, filepath.Base(f)) //nolint:errcheck // best-effort cleanup\n457\t\t\t}\n458\t\t}\n459\t\n460\t\treturn nil\n461\t}\n462\t\n463\t// RemoveAll removes the entire session state directory.\n464\t// This is used during uninstall to completely remove all session state.\n465\tfunc (s *StateStore) RemoveAll() error {\n466\t\tif err := os.RemoveAll(s.stateDir); err != nil {\n467\t\t\treturn fmt.Errorf(\"failed to remove session state directory: %w\", err)\n468\t\t}\n469\t\treturn nil\n470\t}\n471\t\n472\t// List returns all session states.\n473\tfunc (s *StateStore) List(ctx context.Context) ([]*State, error) {\n474\t\tentries, err := os.ReadDir(s.stateDir)\n475\t\tif os.IsNotExist(err) {\n476\t\t\treturn nil, nil\n477\t\t}\n478\t\tif err != nil {\n479\t\t\treturn nil, fmt.Errorf(\"failed to read session state directory: %w\", err)\n480\t\t}\n481\t\n482\t\tvar states []*State\n483\t\tfor _, entry := range entries {\n484\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n485\t\t\t\tcontinue\n486\t\t\t}\n487\t\t\tif strings.HasSuffix(entry.Name(), \".tmp\") {\n488\t\t\t\tcontinue // Skip temp files\n489\t\t\t}\n490\t\n491\t\t\tsessionID := strings.TrimSuffix(entry.Name(), \".json\")\n492\t\t\tstate, err := s.Load(ctx, sessionID)\n493\t\t\tif err != nil {\n494\t\t\t\tcontinue // Skip corrupted state files\n495\t\t\t}\n496\t\t\tif state == nil {\n497\t\t\t\tcontinue // Not found or stale (Load handles cleanup)\n498\t\t\t}\n499\t\n500\t\t\tstates = append(states, state)\n501\t\t}\n502\t\treturn states, nil\n503\t}\n504\t\n505\t// stateFilePath returns the path to a session state file.\n506\tfunc (s *StateStore) stateFilePath(sessionID string) string {\n507\t\treturn filepath.Join(s.stateDir, sessionID+\".json\")\n508\t}\n509\t\n510\t// gitCommonDirCache caches the git common dir to avoid repeated subprocess calls.\n511\t// Keyed by working directory to handle directory changes (same pattern as paths.WorktreeRoot).\n512\tvar (\n513\t\tgitCommonDirMu       sync.RWMutex\n514\t\tgitCommonDirCache    string\n515\t\tgitCommonDirCacheDir string\n516\t)\n517\t\n518\t// ClearGitCommonDirCache clears the cached git common dir.\n519\t// Useful for testing when changing directories.\n520\tfunc ClearGitCommonDirCache() {\n521\t\tgitCommonDirMu.Lock()\n522\t\tgitCommonDirCache = \"\"\n523\t\tgitCommonDirCacheDir = \"\"\n524\t\tgitCommonDirMu.Unlock()\n525\t}\n526\t\n527\t// getGitCommonDir returns the path to the shared git directory.\n528\t// In a regular checkout, this is .git/\n529\t// In a worktree, this is the main repo's .git/ (not .git/worktrees/<name>/)\n530\t// The result is cached per working directory.\n531\tfunc getGitCommonDir(ctx context.Context) (string, error) {\n532\t\tcwd, err := os.Getwd() //nolint:forbidigo // used for cache key, not git-relative paths\n533\t\tif err != nil {\n534\t\t\tcwd = \"\"\n535\t\t}\n536\t\n537\t\t// Check cache with read lock first\n538\t\tgitCommonDirMu.RLock()\n539\t\tif gitCommonDirCache != \"\" && gitCommonDirCacheDir == cwd {\n540\t\t\tcached := gitCommonDirCache\n541\t\t\tgitCommonDirMu.RUnlock()\n542\t\t\treturn cached, nil\n543\t\t}\n544\t\tgitCommonDirMu.RUnlock()\n545\t\n546\t\t// Cache miss — resolve via git subprocess\n547\t\tcmd := exec.CommandContext(ctx, \"git\", \"rev-parse\", \"--git-common-dir\")\n548\t\tcmd.Dir = \".\"\n549\t\toutput, err := cmd.Output()\n550\t\tif err != nil {\n551\t\t\treturn \"\", fmt.Errorf(\"failed to get git common dir: %w\", err)\n552\t\t}\n553\t\n554\t\tcommonDir := strings.TrimSpace(string(output))\n555\t\n556\t\t// git rev-parse --git-common-dir returns relative paths from the working directory,\n557\t\t// so we need to make it absolute if it isn't already\n558\t\tif !filepath.IsAbs(commonDir) {\n559\t\t\tcommonDir = filepath.Join(\".\", commonDir)\n560\t\t}\n561\t\tcommonDir = filepath.Clean(commonDir)\n562\t\n563\t\tgitCommonDirMu.Lock()\n564\t\tgitCommonDirCache = commonDir\n565\t\tgitCommonDirCacheDir = cwd\n566\t\tgitCommonDirMu.Unlock()\n567\t\n568\t\treturn commonDir, nil\n569\t}\n570\t"}]},"uuid":"58bb8a94-9b42-428b-812f-4bbcbbbba537","timestamp":"2026-05-04T13:19:14.192Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/session/state.go","content":"package session\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/osroot\"\n\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n)\n\nconst (\n\t// SessionStateDirName is the directory name for session state files within git common dir.\n\tSessionStateDirName = \"entire-sessions\"\n\n\t// StaleSessionThreshold is the duration after which an ended session is considered stale\n\t// and will be automatically deleted during load/list operations.\n\tStaleSessionThreshold = 7 * 24 * time.Hour\n\n\t// StuckActiveThreshold is the duration after which an ACTIVE session with no\n\t// interaction is considered stuck (used by \"entire doctor\" and \"entire status\").\n\tStuckActiveThreshold = 1 * time.Hour\n)\n\n// State represents the state of an active session.\n// This is stored in .git/entire-sessions/<session-id>.json\ntype State struct {\n\t// SessionID is the unique session identifier\n\tSessionID string `json:\"session_id\"`\n\n\t// CLIVersion is the version of the CLI that created this session\n\tCLIVersion string `json:\"cli_version,omitempty\"`\n\n\t// BaseCommit tracks the current shadow branch base. Initially set to HEAD when the\n\t// session starts, but updated on migration (pull/rebase) and after condensation.\n\t// Used for shadow branch naming and checkpoint storage — NOT for attribution.\n\tBaseCommit string `json:\"base_commit\"`\n\n\t// AttributionBaseCommit is the commit used as the reference point for attribution calculations.\n\t// Unlike BaseCommit (which tracks the shadow branch and moves with migration), this field\n\t// preserves the original base commit so deferred condensation can correctly calculate\n\t// agent vs human line attribution. Updated only after successful condensation.\n\tAttributionBaseCommit string `json:\"attribution_base_commit,omitempty\"`\n\n\t// WorktreePath is the absolute path to the worktree root\n\tWorktreePath string `json:\"worktree_path,omitempty\"`\n\n\t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n\t// Derived from .git/worktrees/<name>/, stable across git worktree move\n\tWorktreeID string `json:\"worktree_id,omitempty\"`\n\n\t// StartedAt is when the session was started\n\tStartedAt time.Time `json:\"started_at\"`\n\n\t// EndedAt is when the session was explicitly closed by the user.\n\t// nil means the session is still active or was not cleanly closed.\n\tEndedAt *time.Time `json:\"ended_at,omitempty\"`\n\n\t// Phase is the lifecycle stage of this session (see phase.go).\n\t// Empty means idle (backward compat with pre-state-machine files).\n\tPhase Phase `json:\"phase,omitempty\"`\n\n\t// TurnID is a unique identifier for the current agent turn.\n\t// Lifecycle:\n\t//   - Generated fresh in InitializeSession at each turn start\n\t//   - Shared across all checkpoints within the same turn\n\t//   - Used to correlate related checkpoints when a turn's work spans multiple commits\n\t//   - Persists until the next InitializeSession call generates a new one\n\tTurnID string `json:\"turn_id,omitempty\"`\n\n\t// TurnCheckpointIDs tracks all checkpoint IDs condensed during the current turn.\n\t// Lifecycle:\n\t//   - Set in PostCommit when a checkpoint is condensed for an ACTIVE session\n\t//   - Consumed in HandleTurnEnd to finalize all checkpoints with the full transcript\n\t//   - Cleared in HandleTurnEnd after finalization completes\n\t//   - Cleared in InitializeSession when a new prompt starts\n\t//   - Cleared when session is reset (ResetSession deletes the state file entirely)\n\tTurnCheckpointIDs []string `json:\"turn_checkpoint_ids,omitempty\"`\n\n\t// LastInteractionTime is updated on agent-interaction events (TurnStart,\n\t// TurnEnd, SessionStop, Compaction) but NOT on git commit hooks.\n\t// Used for stale session detection in \"entire doctor\".\n\tLastInteractionTime *time.Time `json:\"last_interaction_time,omitempty\"`\n\n\t// StepCount is the number of checkpoints/steps created in this session.\n\t// JSON tag kept as \"checkpoint_count\" for backward compatibility with existing state files.\n\tStepCount int `json:\"checkpoint_count\"`\n\n\t// CheckpointTranscriptStart is the transcript line offset where the current\n\t// checkpoint cycle began. Set to 0 at session start, updated to current\n\t// transcript length after each condensation. Used to scope the transcript\n\t// for checkpoint condensation: \"everything since last checkpoint\".\n\tCheckpointTranscriptStart int `json:\"checkpoint_transcript_start,omitempty\"`\n\n\t// CheckpointTranscriptSize is the byte size of the transcript at last condensation.\n\t// Used for fast \"has new content?\" checks in PostCommit: compare the git blob size\n\t// against this value without reading the full transcript content.\n\tCheckpointTranscriptSize int64 `json:\"checkpoint_transcript_size,omitempty\"`\n\n\t// CompactTranscriptStart is the transcript.jsonl line offset where the current\n\t// checkpoint cycle began. It parallels CheckpointTranscriptStart (full.jsonl)\n\t// and is updated after each condensation.\n\tCompactTranscriptStart int `json:\"compact_transcript_start,omitempty\"`\n\n\t// Deprecated: CondensedTranscriptLines is replaced by CheckpointTranscriptStart.\n\t// Kept for backward compatibility with existing state files.\n\t// Use NormalizeAfterLoad() to migrate.\n\tCondensedTranscriptLines int `json:\"condensed_transcript_lines,omitempty\"`\n\n\t// UntrackedFilesAtStart tracks files that existed at session start (to preserve during rewind)\n\tUntrackedFilesAtStart []string `json:\"untracked_files_at_start,omitempty\"`\n\n\t// FilesTouched tracks files modified/created/deleted during this session\n\tFilesTouched []string `json:\"files_touched,omitempty\"`\n\n\t// LastCheckpointID is the checkpoint ID from the most recent condensation.\n\t// Used to restore the Entire-Checkpoint trailer on amend and to identify\n\t// sessions that have been condensed at least once. Cleared on new prompt.\n\tLastCheckpointID id.CheckpointID `json:\"last_checkpoint_id,omitempty\"`\n\n\t// LastCheckpointCommitHash is the exact commit SHA that carried\n\t// LastCheckpointID at condensation time. Used by the reconcile path to\n\t// distinguish \"reset back to the condensed commit\" (same SHA) from\n\t// \"cherry-picked / rebased a commit that happens to preserve the trailer\"\n\t// (different SHA). Without this guard, a cherry-picked checkpoint would\n\t// falsely fire reconcile and drop the pinned AttributionBaseCommit,\n\t// corrupting attribution math for uncondensed shadow-branch work.\n\t// Empty for legacy state files — reconcile falls back to trailer-only\n\t// matching for backward compatibility.\n\tLastCheckpointCommitHash string `json:\"last_checkpoint_commit_hash,omitempty\"`\n\n\t// FullyCondensed indicates this session has been condensed and has no remaining\n\t// carry-forward files. PostCommit skips fully-condensed sessions entirely.\n\t// Set after successful condensation when no files remain for carry-forward\n\t// and the session phase is ENDED. Cleared on session reactivation (ENDED →\n\t// ACTIVE via TurnStart, or ENDED → IDLE via SessionStart) by ActionClearEndedAt.\n\tFullyCondensed bool `json:\"fully_condensed,omitempty\"`\n\n\t// DivergenceNoticeShown indicates the prepare-commit-msg warning about\n\t// attribution divergence has been shown. Set when the warning fires,\n\t// cleared when AttributionBaseCommit realigns with BaseCommit (next\n\t// successful condensation). Prevents repeated warnings on every commit.\n\tDivergenceNoticeShown bool `json:\"divergence_notice_shown,omitempty\"`\n\n\t// AttachedManually indicates this session was imported via `entire attach` rather\n\t// than being captured by hooks during normal agent execution.\n\tAttachedManually bool `json:\"attached_manually,omitempty\"`\n\n\t// AgentType identifies the agent that created this session (e.g., \"Claude Code\", \"Gemini CLI\", \"Cursor\")\n\tAgentType types.AgentType `json:\"agent_type,omitempty\"`\n\n\t// ModelName is the LLM model used in this session (e.g., \"claude-sonnet-4-20250514\", \"gpt-4o\").\n\t// Set from hook data when the agent provides it.\n\tModelName string `json:\"model_name,omitempty\"`\n\n\t// Token usage tracking (accumulated across all checkpoints in this session)\n\tTokenUsage *agent.TokenUsage `json:\"token_usage,omitempty\"`\n\n\t// Hook-provided session metrics (for agents like Cursor that report via hooks)\n\tSessionDurationMs int64 `json:\"session_duration_ms,omitempty\"`\n\tSessionTurnCount  int   `json:\"session_turn_count,omitempty\"`\n\tContextTokens     int   `json:\"context_tokens,omitempty\"`\n\tContextWindowSize int   `json:\"context_window_size,omitempty\"`\n\n\t// Deprecated: TranscriptLinesAtStart is replaced by CheckpointTranscriptStart.\n\t// Kept for backward compatibility with existing state files.\n\tTranscriptLinesAtStart int `json:\"transcript_lines_at_start,omitempty\"`\n\n\t// TranscriptIdentifierAtStart is the last transcript identifier when the session started.\n\t// Used for identifier-based transcript scoping (UUID for Claude, message ID for Gemini).\n\tTranscriptIdentifierAtStart string `json:\"transcript_identifier_at_start,omitempty\"`\n\n\t// TranscriptPath is the path to the live transcript file (for mid-session commit detection)\n\tTranscriptPath string `json:\"transcript_path,omitempty\"`\n\n\t// LastPrompt is the most recent user prompt for this session (truncated for display).\n\t// Updated on every turn start (UserPromptSubmit). JSON tag kept as \"first_prompt\"\n\t// for backward compatibility with existing state files.\n\tLastPrompt string `json:\"last_prompt,omitempty\"`\n\n\t// PromptAttributions tracks user and agent line changes at each prompt start.\n\t// This enables accurate attribution by capturing user edits between checkpoints.\n\tPromptAttributions []PromptAttribution `json:\"prompt_attributions,omitempty\"`\n\n\t// PendingPromptAttribution holds attribution calculated at prompt start (before agent runs).\n\t// This is moved to PromptAttributions when SaveStep is called.\n\tPendingPromptAttribution *PromptAttribution `json:\"pending_prompt_attribution,omitempty\"`\n}\n\n// PromptAttribution captures line-level attribution data at the start of each prompt.\n// By recording what changed since the last checkpoint BEFORE the agent works,\n// we can accurately separate user edits from agent contributions.\ntype PromptAttribution struct {\n\t// CheckpointNumber is which checkpoint this was recorded before (1-indexed)\n\tCheckpointNumber int `json:\"checkpoint_number\"`\n\n\t// UserLinesAdded is lines added by user since the last checkpoint\n\tUserLinesAdded int `json:\"user_lines_added\"`\n\n\t// UserLinesRemoved is lines removed by user since the last checkpoint\n\tUserLinesRemoved int `json:\"user_lines_removed\"`\n\n\t// AgentLinesAdded is total agent lines added so far (base → last checkpoint).\n\t// Always 0 for checkpoint 1 since there's no previous checkpoint to measure against.\n\tAgentLinesAdded int `json:\"agent_lines_added\"`\n\n\t// AgentLinesRemoved is total agent lines removed so far (base → last checkpoint).\n\t// Always 0 for checkpoint 1 since there's no previous checkpoint to measure against.\n\tAgentLinesRemoved int `json:\"agent_lines_removed\"`\n\n\t// UserAddedPerFile tracks per-file user additions for accurate modification tracking.\n\t// This enables distinguishing user self-modifications from agent modifications.\n\t// See docs/architecture/attribution.md for details.\n\tUserAddedPerFile map[string]int `json:\"user_added_per_file,omitempty\"`\n\n\t// UserRemovedPerFile tracks per-file user removals for accurate agent deletion attribution.\n\t// Without this, global user removals would be subtracted from agent-file-only removals,\n\t// incorrectly reducing agent deletion credit when users delete lines in non-agent files.\n\tUserRemovedPerFile map[string]int `json:\"user_removed_per_file,omitempty\"`\n}\n\n// NormalizeAfterLoad applies backward-compatible migrations to state loaded from disk.\n// Call this after deserializing a State from JSON.\nfunc (s *State) NormalizeAfterLoad(ctx context.Context) {\n\t// Normalize legacy phase values. \"active_committed\" was removed with the\n\t// 1:1 checkpoint model in favor of the state machine handling commits\n\t// during ACTIVE phase with immediate condensation.\n\tif s.Phase == \"active_committed\" {\n\t\tlogCtx := logging.WithComponent(ctx, \"session\")\n\t\tlogging.Info(logCtx, \"migrating legacy active_committed phase to active\",\n\t\t\tslog.String(\"session_id\", s.SessionID),\n\t\t)\n\t\ts.Phase = PhaseActive\n\t}\n\t// Also normalize via PhaseFromString to handle any other legacy/unknown values.\n\ts.Phase = PhaseFromString(string(s.Phase))\n\n\t// Migrate transcript fields: CheckpointTranscriptStart replaces both\n\t// CondensedTranscriptLines and TranscriptLinesAtStart from older state files.\n\tif s.CheckpointTranscriptStart == 0 {\n\t\tif s.CondensedTranscriptLines > 0 {\n\t\t\ts.CheckpointTranscriptStart = s.CondensedTranscriptLines\n\t\t} else if s.TranscriptLinesAtStart > 0 {\n\t\t\ts.CheckpointTranscriptStart = s.Transcrip