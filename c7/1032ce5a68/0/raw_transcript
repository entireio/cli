ch_RefusesWhenCheckpointMissingFromLocalBranch(t *testing.T) {\n390\t\tsetupAttachTestRepo(t)\n391\t\n392\t\trepoRoot := mustGetwd(t)\n393\t\trunGitInDir(t, repoRoot, \"commit\", \"--amend\", \"-m\", \"init\\n\\nEntire-Checkpoint: ffffffffeeee\")\n394\t\n395\t\tsessionID := \"orphaned-attach-session\"\n396\t\tsetupClaudeTranscript(t, sessionID, `{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"attach please\"},\"uuid\":\"u1\"}\n397\t`)\n398\t\n399\t\tvar out bytes.Buffer\n400\t\terr := runAttach(context.Background(), &out, sessionID, agent.AgentNameClaudeCode, true)\n401\t\tif err == nil {\n402\t\t\tt.Fatal(\"expected error: checkpoint referenced by HEAD is missing locally and attach should refuse\")\n403\t\t}\n404\t\tif !strings.Contains(err.Error(), \"missing from the local entire/checkpoints/v1 branch\") {\n405\t\t\tt.Errorf(\"error message should explain the missing-branch situation; got: %v\", err)\n406\t\t}\n407\t\tif !strings.Contains(err.Error(), \"git fetch origin entire/checkpoints/v1\") {\n408\t\t\tt.Errorf(\"error message should include the fetch command to fix it; got: %v\", err)\n409\t\t}\n410\t\n411\t\trepo, err := git.PlainOpen(repoRoot)\n412\t\tif err != nil {\n413\t\t\tt.Fatal(err)\n414\t\t}\n415\t\tstore := cpkg.NewGitStore(repo)\n416\t\tsummary, err := store.ReadCommitted(context.Background(), \"ffffffffeeee\")\n417\t\tif err != nil {\n418\t\t\tt.Fatalf(\"ReadCommitted: %v\", err)\n419\t\t}\n420\t\tif summary != nil {\n421\t\t\tt.Errorf(\"attach should NOT have created checkpoint ffffffffeeee locally; found %+v\", summary)\n422\t\t}\n423\t}\n424\t\n425\t// Regression for https://github.com/entireio/cli/pull/1014#pullrequestreview-copilot:\n426\t// Bob clones a repo where Alice's checkpoint is on the remote-tracking ref\n427\t// (refs/remotes/origin/entire/checkpoints/v1) but the local branch doesn't\n428\t// exist yet. ReadCommitted falls back to the remote-tracking tree, so a naive\n429\t// \"read and check\" guard would think all