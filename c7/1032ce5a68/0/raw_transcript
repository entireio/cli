 agent session that wasn't captured by hooks.\n49\t\n50\tThis creates a checkpoint from the session's transcript and links it to the\n51\tlast commit. Use this when hooks failed to fire or weren't installed when\n52\tthe session started, or to attach a research session.\n53\t\n54\tIf the last commit already has a checkpoint, the session is added to it.\n55\tOtherwise a new checkpoint is created.\n56\t\n57\tWorks with any registered agent, including external agents enabled via\n58\texternal_agents in settings. Run 'entire agent list' to see the full list.`,\n59\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n60\t\t\t\tif len(args) != 1 {\n61\t\t\t\t\treturn cmd.Help()\n62\t\t\t\t}\n63\t\t\t\tif checkDisabledGuard(cmd.Context(), cmd.OutOrStdout()) {\n64\t\t\t\t\treturn nil\n65\t\t\t\t}\n66\t\t\t\t// Discover external agents so --agent <external-name> is recognized\n67\t\t\t\t// and so auto-detection can find transcripts from external agents.\n68\t\t\t\texternal.DiscoverAndRegister(cmd.Context())\n69\t\t\t\tagentName := types.AgentName(agentFlag)\n70\t\t\t\treturn runAttach(cmd.Context(), cmd.OutOrStdout(), args[0], agentName, force)\n71\t\t\t},\n72\t\t}\n73\t\tcmd.Flags().BoolVarP(&force, \"force\", \"f\", false, \"Skip confirmation and amend the last commit with the checkpoint trailer\")\n74\t\tcmd.Flags().StringVarP(&agentFlag, \"agent\", \"a\", string(agent.DefaultAgentName), \"Agent that created the session (see 'entire agent list' for registered agents, including external)\")\n75\t\treturn cmd\n76\t}\n77\t\n78\tfunc runAttach(ctx context.Context, w io.Writer, sessionID string, agentName types.AgentName, force bool) error {\n79\t\t// Initialize structured logger so logging.Warn/Info write to .entire/logs/ not stderr.\n80\t\tif err := logging.Init(ctx, sessionID); err != nil {\n81\t\t\t// Init failed — logging will use stderr fallback, non-fatal.\n82\t\t\t_ = err\n83\t\t}\n84\t\tdefer logging.Close()\n85\t\n86\t\tlogCtx := logging.WithComponent(ctx, \"attach\")\n87\t\n88\t\t// Open repository once — shared across all operations.\n89\t\trepo, err := openRepository(ctx)\n90\t\tif err != nil {\n91\t\t\treturn err\n92\t\t}\n93\t\n94\t\texistingState, err := validateAttachPreconditions(ctx, repo, sessionID)\n95\t\tif err != nil {\n96\t\t\treturn err\n97\t\t}\n98\t\n99\t\theadCommit, err := getHeadCommit(repo)\n100\t\tif err != nil {\n101\t\t\treturn err\n102\t\t}\n103\t\n104\t\t// If session already has a checkpoint, just offer to link it.\n105\t\tif existingState != nil && !existingState.LastCheckpointID.IsEmpty() {\n106\t\t\tcpID := existingState.LastCheckpointID.String()\n107\t\t\tfmt.Fprintf(w, \"Session %s already has checkpoint %s\\n\", sessionID, cpID)\n108\t\t\tif err := promptAmendCommit(logCtx, w, headCommit, cpID, force); err != nil {\n109\t\t\t\tlogging.Warn(logCtx, \"failed to amend commit\", \"error\", err)\n110\t\t\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", cpID)\n111\t\t\t}\n112\t\t\treturn nil\n113\t\t}\n114\t\n115\t\t// Resolve agent and transcript path.\n116\t\tag, transcriptPath, err := resolveAgentAndTranscript(logCtx, w, sessionID, agentName, existingState)\n117\t\tif err != nil {\n118\t\t\treturn err\n119\t\t}\n120\t\n121\t\ttranscriptData, err := ag.ReadTranscript(transcriptPath)\n122\t\tif err != nil {\n123\t\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n124\t\t}\n125\t\n126\t\t// Normalize Gemini transcripts for storage.\n127\t\tstoredTranscript := transcriptData\n128\t\tif ag.Type() == agent.AgentTypeGemini {\n129\t\t\tif normalized, normErr := geminicli.NormalizeTranscript(transcriptData); normErr == nil {\n130\t\t\t\tstoredTranscript = normalized\n131\t\t\t} else {\n132\t\t\t\tlogging.Warn(logCtx, \"failed to normalize Gemini transcript, storing raw\", \"error\", normErr)\n133\t\t\t}\n134\t\t}\n135\t\n136\t\tmeta := extractTranscriptMetadata(transcriptData)\n137\t\n138\t\t// Determine checkpoint ID: reuse from HEAD if one