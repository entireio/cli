that waitForTranscriptFlush treats it as\n982\t// stale and skips the 3-second poll loop.\n983\tfunc setupClaudeTranscript(t *testing.T, sessionID, content string) {\n984\t\tt.Helper()\n985\t\tclaudeDir := t.TempDir()\n986\t\tt.Setenv(\"ENTIRE_TEST_CLAUDE_PROJECT_DIR\", claudeDir)\n987\t\tfpath := filepath.Join(claudeDir, sessionID+\".jsonl\")\n988\t\tif err := os.WriteFile(fpath, []byte(content), 0o600); err != nil {\n989\t\t\tt.Fatal(err)\n990\t\t}\n991\t\tstale := time.Now().Add(-3 * time.Minute)\n992\t\tif err := os.Chtimes(fpath, stale, stale); err != nil {\n993\t\t\tt.Fatal(err)\n994\t\t}\n995\t}\n996\t\n997\t// enableEntire creates the .entire/settings.json file to mark Entire as enabled.\n998\tfunc enableEntire(t *testing.T, repoDir string) {\n999\t\tt.Helper()\n1000\t\tentireDir := filepath.Join(repoDir, \".entire\")\n1001\t\tif err := os.MkdirAll(entireDir, 0o750); err != nil {\n1002\t\t\tt.Fatal(err)\n1003\t\t}\n1004\t\tsettingsContent := `{\"enabled\": true}`\n1005\t\tif err := os.WriteFile(filepath.Join(entireDir, \"settings.json\"), []byte(settingsContent), 0o600); err != nil {\n1006\t\t\tt.Fatal(err)\n1007\t\t}\n1008\t}\n1009\t\n1010\tfunc setAttachCheckpointsV2Enabled(t *testing.T, repoDir string) {\n1011\t\tt.Helper()\n1012\t\tentireDir := filepath.Join(repoDir, \".entire\")\n1013\t\tif err := os.MkdirAll(entireDir, 0o750); err != nil {\n1014\t\t\tt.Fatal(err)\n1015\t\t}\n1016\t\tsettingsContent := `{\"enabled\": true, \"strategy_options\": {\"checkpoints_v2\": true}}`\n1017\t\tif err := os.WriteFile(filepath.Join(entireDir, \"settings.json\"), []byte(settingsContent), 0o600); err != nil {\n1018\t\t\tt.Fatal(err)\n1019\t\t}\n1020\t}\n1021\t\n1022\tfunc setAttachCheckpointsV2Only(t *testing.T, repoDir string) {\n1023\t\tt.Helper()\n1024\t\tentireDir := filepath.Join(repoDir, \".entire\")\n1025\t\tif err := os.MkdirAll(entireDir, 0o750); err != nil {\n1026\t\t\tt.Fatal(err)\n1027\t\t}\n1028\t\tsettingsContent := `{\"enabled\": true, \"strategy_options