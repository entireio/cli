ient{inner: &deviceflow.Client{\n50\t\t\tHTTP:           httpClient,\n51\t\t\tBaseURL:        api.AuthBaseURL(),\n52\t\t\tClientID:       p.clientID,\n53\t\t\tScope:          \"cli\",\n54\t\t\tUserAgent:      p.clientID,\n55\t\t\tDeviceCodePath: p.deviceCodePath,\n56\t\t\tTokenPath:      p.tokenPath,\n57\t\t}}\n58\t}\n59\t\n60\t// BaseURL returns the issuer base URL this client talks to.\n61\tfunc (c *Client) BaseURL() string { return c.inner.BaseURL }\n62\t\n63\t// StartDeviceAuth requests a fresh device code.\n64\tfunc (c *Client) StartDeviceAuth(ctx context.Context) (*DeviceAuthStart, error) {\n65\t\treturn c.inner.StartDeviceAuth(ctx) //nolint:wrapcheck // shim preserves the lib's wrapped errors verbatim\n66\t}\n67\t\n68\t// PollDeviceAuth polls the token endpoint. On any OAuth-protocol error\n69\t// (recognised RFC 8628 §3.5 sentinel or unknown but spec-shaped code\n70\t// like invalid_request / invalid_client / server_error), the wire-side\n71\t// code is returned in DeviceAuthPoll.Error so the existing polling\n72\t// loop in login.go can branch on it — known codes hit the dedicated\n73\t// switch arms, unknown codes fall through to the default arm and fail\n74\t// fast. Non-protocol errors (network, decode) are returned as a real\n75\t// error and treated as transient by the polling loop.\n76\tfunc (c *Client) PollDeviceAuth(ctx context.Context, deviceCode string) (*DeviceAuthPoll, error) {\n77\t\tt, err := c.inner.PollDeviceAuth(ctx, deviceCode)\n78\t\tif err != nil {\n79\t\t\tif code, description, ok := oauthErrorParts(err); ok {\n80\t\t\t\treturn &DeviceAuthPoll{\n81\t\t\t\t\tError:            code,\n82\t\t\t\t\tErrorDescription: description,\n83\t\t\t\t}, nil\n84\t\t\t}\n85\t\t\treturn nil, err //nolint:wrapcheck // shim returns deviceflow errors verbatim so callers can errors.Is on sentinels\n86\t\t}\n87\t\n88\t\treturn &DeviceAuthPoll{\n89\t\t\tAccessToken: t.AccessToken,\n90\t\t\tTokenType:   t.TokenType,\n91\t\t\tExpiresIn:   secondsUntil(t),\n92\t\t\tScope:       t.Scope,\n93\t\t}, nil\n94\t}\n95\t\n96\t// oauthErrorParts inspects err for either a recognised RFC 8628 §3.5\n97\t// sentinel or the generic \"oauth error: <code>\" wrapper deviceflow uses\n98\t// for unrecognised but spec-shaped codes (RFC 6749 §5.2: invalid_request,\n99\t// invalid_client, server_error, …).\n100\t//\n101\t// On a match, returns the wire-side code, any error_description the\n102\t// server included, and ok=true. Otherwise returns \"\", \"\", false — the\n103\t// caller should treat the error as a transport/decode failure.\n104\t//\n105\t// Surfacing unknown codes as ok=true is what keeps login.go's polling\n106\t// loop fast-failing on terminal OAuth rejections instead of treating\n107\t// them as transient and retrying ~5 times.\n108\tfunc oauthErrorParts(err error) (code, description string, ok bool) {\n109\t\tswitch {\n110\t\tcase errors.Is(err, deviceflow.ErrAuthorizationPending):\n111\t\t\tcode = \"authorization_pending\"\n112\t\tcase errors.Is(err, deviceflow.ErrSlowDown):\n113\t\t\tcode = \"slow_down\"\n114\t\tcase errors.Is(err, deviceflow.ErrAccessDenied):\n115\t\t\tcode = \"access_denied\"\n116\t\tcase errors.Is(err, deviceflow.ErrExpiredToken):\n117\t\t\tcode = \"expired_token\"\n118\t\tcase errors.Is(err, deviceflow.ErrInvalidGrant):\n119\t\t\tcode = \"invalid_grant\"\n120\t\tdefault:\n121\t\t\t// Unknown but legitimate OAuth codes come back from\n122\t\t\t// deviceflow.errCodeToSentinel as fmt.Errorf(\"oauth error: %s\",\n123\t\t\t// code), optionally wrapped a second time with \": <description>\"\n124\t\t\t// when the server supplied error_description.\n125\t\t\tconst oauthPrefix = \"oauth error: \"\n126\t\t\trest, hadPrefix := strings.CutPrefix(err.Error(), oauthPrefix)\n127\t\t\tif !hadPrefix {\n128\t\t\t\treturn \"\", \"\", false\n129\t\t\t}\n130\t\t\tif c, d, hasDesc := strings.Cut(rest, \": \"); hasDesc {\n131\t\t\t\treturn c, d, true\n132\t\t\t}\n133\t\t\treturn rest, \"\", true\n134\t\t}\n135\t\tdescription = d