oding.EncodeToString(payload)\n59\t\tsig := base64.RawURLEncoding.EncodeToString([]byte(\"not-real\"))\n60\t\treturn header + \".\" + body + \".\" + sig\n61\t}\n62\t\n63\t// makeJWTWithExp builds an unsigned JWT carrying `exp` (and optionally\n64\t// `aud`). The signature segment is junk — tokenmanager never verifies\n65\t// it, ParseClaims is documented as unverified.\n66\tfunc makeJWTWithExp(t *testing.T, exp time.Time, aud []string) string {\n67\t\tt.Helper()\n68\t\theader := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"none\",\"typ\":\"JWT\"}`))\n69\t\tclaims := map[string]any{\"sub\": \"test\", \"exp\": exp.Unix()}\n70\t\tif len(aud) > 0 {\n71\t\t\tclaims[\"aud\"] = aud\n72\t\t}\n73\t\tpayload, err := json.Marshal(claims)\n74\t\tif err != nil {\n75\t\t\tt.Fatalf(\"marshal payload: %v\", err)\n76\t\t}\n77\t\tbody := base64.RawURLEncoding.EncodeToString(payload)\n78\t\tsig := base64.RawURLEncoding.EncodeToString([]byte(\"not-real\"))\n79\t\treturn header + \".\" + body + \".\" + sig\n80\t}\n81\t\n82\tfunc newTestManager(t *testing.T, store tokenstore.Store, exchange func(context.Context, sts.ExchangeRequest) (*tokens.TokenSet, error)) *Manager {\n83\t\tt.Helper()\n84\t\tm, err := New(Config{\n85\t\t\tIssuer:   testIssuer,\n86\t\t\tClientID: testClientID,\n87\t\t\tSTSPath:  testSTSPath,\n88\t\t\tStore:    store,\n89\t\t\tExchange: exchange,\n90\t\t})\n91\t\tif err != nil {\n92\t\t\tt.Fatalf(\"New: %v\", err)\n93\t\t}\n94\t\treturn m\n95\t}\n96\t\n97\tfunc TestNew_RequiresFields(t *testing.T) {\n98\t\tt.Parallel()\n99\t\tcases := []struct {\n100\t\t\tname string\n101\t\t\tcfg  Config\n102\t\t}{\n103\t\t\t{\"missing issuer\", Config{ClientID: \"x\", STSPath: \"/p\", Store: newMemStore()}},\n104\t\t\t{\"missing clientID\", Config{Issuer: \"https://x\", STSPath: \"/p\", Store: newMemStore()}},\n105\t\t\t{\"missing Store\", Config{Issuer: \"https://x\", ClientID: \"x\", STSPath: \"/p\"}},\n106\t\t}\n107\t\tfor _, tc := range cases {\n108\t\t\tt.Run(tc.name, 