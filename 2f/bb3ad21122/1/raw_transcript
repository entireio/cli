profilerFromContext(ctx)\n187\t\tif p == nil {\n188\t\t\treturn func() {}\n189\t\t}\n190\t\tstart := time.Now()\n191\t\treturn func() { p.recordStage(name, time.Since(start)) }\n192\t}\n193\t\n194\t// formatProfileDuration formats a duration with adaptive precision:\n195\t//   - <1s: integer milliseconds (\"142ms\")\n196\t//   - 1s..10s: one decimal place (\"1.4s\", \"9.2s\")\n197\t//   - 10s..60s: integer seconds (\"12s\", \"42s\")\n198\t//   - 1m..1h: minutes and seconds (\"22m13s\")\n199\t//   - >=1h: hours and minutes (\"1h5m\")\n200\tfunc formatProfileDuration(d time.Duration) string {\n201\t\tswitch {\n202\t\tcase d < time.Second:\n203\t\t\treturn fmt.Sprintf(\"%dms\", d.Milliseconds())\n204\t\tcase d < 10*time.Second:\n205\t\t\treturn fmt.Sprintf(\"%.1fs\", d.Seconds())\n206\t\tcase d < time.Minute:\n207\t\t\treturn fmt.Sprintf(\"%ds\", int(d.Seconds()))\n208\t\tcase d < time.Hour:\n209\t\t\tm := int(d / time.Minute)\n210\t\t\ts := int((d % time.Minute) / time.Second)\n211\t\t\treturn fmt.Sprintf(\"%dm%ds\", m, s)\n212\t\tdefault:\n213\t\t\th := int(d / time.Hour)\n214\t\t\tm := int((d % time.Hour) / time.Minute)\n215\t\t\treturn fmt.Sprintf(\"%dh%dm\", h, m)\n216\t\t}\n217\t}"},"type":"attachment","uuid":"01415b28-b0dd-4d43-94d2-11a00d6135fc","timestamp":"2026-05-07T18:08:41.148Z","userType":"external","entrypoint":"cli","cwd":"/Users/ninawork/entire/devenv/cli","sessionId":"939fabd6-10fa-4faa-9bd3-ce01733dd4f7","version":"2.1.132","gitBranch":"v2-migration-performance"}
