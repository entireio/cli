\t\t\tt.Errorf(\"expected empty output for empty profiler, got %q\", got)\n53\t\t}\n54\t}\n55\t\n56\tfunc TestMigrateProfiler_RecordsPhase(t *testing.T) {\n57\t\tt.Parallel()\n58\t\tp := newMigrateProfiler()\n59\t\tp.recordPhase(\"list_v1_checkpoints\", 142*time.Millisecond)\n60\t\tp.recordPhase(\"process_checkpoints\", 22*time.Minute+8*time.Second)\n61\t\n62\t\tvar buf bytes.Buffer\n63\t\tp.render(&buf)\n64\t\tgot := buf.String()\n65\t\n66\t\tif !strings.Contains(got, \"PHASE\") || !strings.Contains(got, \"DURATION\") {\n67\t\t\tt.Fatalf(\"missing phase header in output:\\n%s\", got)\n68\t\t}\n69\t\tif !strings.Contains(got, \"list_v1_checkpoints\") || !strings.Contains(got, \"142ms\") {\n70\t\t\tt.Errorf(\"missing list_v1_checkpoints/142ms in output:\\n%s\", got)\n71\t\t}\n72\t\tif !strings.Contains(got, \"process_checkpoints\") || !strings.Contains(got, \"22m8s\") {\n73\t\t\tt.Errorf(\"missing process_checkpoints/22m8s in output:\\n%s\", got)\n74\t\t}\n75\t\n76\t\t// Phase order should match insertion order.\n77\t\tlistIdx := strings.Index(got, \"list_v1_checkpoints\")\n78\t\tprocIdx := strings.Index(got, \"process_checkpoints\")\n79\t\tif listIdx == -1 || procIdx == -1 || listIdx > procIdx {\n80\t\t\tt.Errorf(\"phases not in insertion order:\\n%s\", got)\n81\t\t}\n82\t}\n83\t\n84\tfunc TestMigrateProfiler_AggregatesStage(t *testing.T) {\n85\t\tt.Parallel()\n86\t\tp := newMigrateProfiler()\n87\t\tp.recordStage(\"read_v2_existing\", 3*time.Millisecond)\n88\t\tp.recordStage(\"read_v2_existing\", 5*time.Millisecond)\n89\t\tp.recordStage(\"read_v2_existing\", 45*time.Millisecond) // max\n90\t\n91\t\tvar buf bytes.Buffer\n92\t\tp.render(&buf)\n93\t\tgot := buf.String()\n94\t\n95\t\tif !strings.Contains(got, \"STAGE\") || !strings.Contains(got, \"COUNT\") ||\n96\t\t\t!strings.Contains(got, \"TOTAL\") || !strings.Contains(got, \"AVG\") || !strings.Contains(got, \"MAX\") {\n97\t\t\tt.Fatalf(\"missing stage header columns:\\n%s\", got)\n98\t\t}\n99\t\n100\t\t// Find the stage row.\n101\t\tvar stageLine string\n102\t\tfor _, line := range strings.Split(got, \"\\n\") {\n103\t\t\tif strings.Contains(line, \"read_v2_existing\") {\n104\t\t\t\tstageLine = line\n105\t\t\t\tbreak\n106\t\t\t}\n107\t\t}\n108\t\tif stageLine == \"\" {\n109\t\t\tt.Fatalf(\"missing read_v2_existing row:\\n%s\", got)\n110\t\t}\n111\t\n112\t\t// count=3, total=53ms, avg=17ms (53/3 truncated), max=45ms.\n113\t\tfor _, want := range []string{\"3\", \"53ms\", \"17ms\", \"45ms\"} {\n114\t\t\tif !strings.Contains(stageLine, want) {\n115\t\t\t\tt.Errorf(\"stage line missing %q: %q\", want, stageLine)\n116\t\t\t}\n117\t\t}\n118\t}\n119\t\n120\tfunc TestMigrateProfiler_StageOrderPreserved(t *testing.T) {\n121\t\tt.Parallel()\n122\t\tp := newMigrateProfiler()\n123\t\t// Insert in non-alphabetic order.\n124\t\tp.recordStage(\"write_v2_session\", 10*time.Millisecond)\n125\t\tp.recordStage(\"read_v1_summary\", 5*time.Millisecond)\n126\t\tp.recordStage(\"compact_transcript\", 20*time.Millisecond)\n127\t\n128\t\tvar buf bytes.Buffer\n129\t\tp.render(&buf)\n130\t\tgot := buf.String()\n131\t\n132\t\twIdx := strings.Index(got, \"write_v2_session\")\n133\t\trIdx := strings.Index(got, \"read_v1_summary\")\n134\t\tcIdx := strings.Index(got, \"compact_transcript\")\n135\t\tif wIdx == -1 || rIdx == -1 || cIdx == -1 {\n136\t\t\tt.Fatalf(\"missing stage rows:\\n%s\", got)\n137\t\t}\n138\t\tif wIdx >= rIdx || rIdx >= cIdx {\n139\t\t\tt.Errorf(\"stages not in insertion order (got w=%d r=%d c=%d):\\n%s\", wIdx, rIdx, cIdx, got)\n140\t\t}\n141\t}\n142\t\n143\tfunc TestProfileStart_NoProfilerIsNoop(t *testing.T) {\n144\t\tt.Parallel()\n145\t\t// No profiler in context — calling stop must not panic.\n146\t\tstop := profileStartStage(context.Background(), \"noop\")\n147\t\tstop()\n148\t\tstop = profileStartPhase(context.Background(), \"noop\")\n149\t\tstop()\n150\t}\n151\t\n152\tfunc TestProfileStart_RecordsStageOnStop(t *testing.T) {\n153\t\tt.Parallel()\n154\t\tp := newMigrateProfiler()\n155\t\tctx := contextWithProfiler(context.Background(), p)\n156\t\n157\t\tstop := profileStartStage(ctx, \"compact_transcript\")\n158\t\ttime.Sleep(2 * time.Millisecond)\n159\t\tstop()\n160\t\n161\t\tif got := p.stageCount(\"compact_transcript\"); got != 1 {\n162\t\t\tt.Errorf(\"expected 1 stage record, got %d\", got)\n163\t\t}\n164\t\tif dur := p.stageTotal(\"compact_transcript\"); dur < time.Millisecond {\n165\t\t\tt.Errorf(\"expected at least 1ms recorded, got %v\", dur)\n166\t\t}\n167\t}\n168\t\n169\tfunc TestProfileStart_RecordsPhaseOnStop(t *testing.T) {\n170\t\tt.Parallel()\n171\t\tp := newMigrateProfiler()\n172\t\tctx := contextWithProfiler(context.Background(), p)\n173\t\n174\t\tstop := profileStartPhase(ctx, \"list_v1_checkpoints\")\n175\t\ttime.Sleep(2 * time.Millisecond)\n176\t\tstop()\n177\t\n178\t\tif got := p.phaseCount(); got != 1 {\n179\t\t\tt.Errorf(\"expected 1 phase recorded, got %d\", got)\n180\t\t}\n181\t}\n182\t\n183\t// TestMigrateCheckpointsV2_ProfilerCapturesPhasesAndStages verifies the profiler\n184\t// instrumentation in the migration path actually fires when a profiler is in\n185\t// context — i.e., phases and per-checkpoint stages are recorded with counts\n186\t// matching the number of v1 checkpoints/sessions migrated.\n187\tfunc TestMigrateCheckpointsV2_ProfilerCapturesPhasesAndStages(t *testing.T) {\n188\t\tt.Parallel()\n189\t\trepo := initMigrateTestRepo(t)\n190\t\tv1Store, v2Store := newMigrateStores(repo)\n191\t\n192\t\ttranscript := []byte(\"{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":\\\"hello\\\"}\\n\")\n193\t\tfor i, cpID := range []id.CheckpointID{\n194\t\t\tid.MustCheckpointID(\"aa11bb22cc33\"),\n195\t\t\tid.MustCheckpointID(\"dd44ee55ff66\"),\n196\t\t} {\n197\t\t\twriteV1Checkpoint(t, v1Store, cpID, \"session-prof-\"+string(rune('a'+i)), transcript, []string{\"prompt\"})\n198\t\t}\n199\t\n200\t\tp := newMigrateProfiler()\n201\t\tctx := contextWithProfiler(context.Background(), p)\n202\t\tvar stdout bytes.Buffer\n203\t\n204\t\tresult, _, err := migrateCheckpointsV2(ctx, repo, v1Store, v2Store, &stdout, false)\n205\t\trequire.NoError(t, err)\n206\t\trequire.Equal(t, 2, result.migrated)\n207\t\n208\t\t// Phases run once each.\n209\t\tif p.phaseCount() < 2 {\n210\t\t\tt.Errorf(\"expected at least 2 phases (list + index), got %d\", p.phaseCount())\n211\t\t}\n212\t\n213\t\t// Per-checkpoint stages: each fires once per v1 checkpoint.\n214\t\tfor _, name := range []string{\"read_v2_existing\", \"read_v1_summary\"} {\n215\t\t\tif got := p.stageCount(name); got != 2 {\n216\t\t\t\tt.Errorf(\"stage %q count = %d, want 2\", name, got)\n217\t\t\t}\n218\t\t}\n219\t\t// Per-session stages: one session per checkpoint here, so also 2.\n220\t\tfor _, name := range []string{\"read_v1_session\", \"compact_transcript\", \"write_v2_session\"} {\n221\t\t\tif got := p.stageCount(name); got != 2 {\n222\t\t\t\tt.Errorf(\"stage %q count = %d, want 2\", name, got)\n223\t\t\t}\n224\t\t}\n225\t\n226\t\t// Render produces output with both PHASE and STAGE sections.\n227\t\tvar report bytes.Buffer\n228\t\tp.render(&report)\n229\t\tif !strings.Contains(report.String(), \"PHASE\") || !strings.Contains(report.String(), \"STAGE\") {\n230\t\t\tt.Errorf(\"rendered profile missing PHASE or STAGE section:\\n%s\", report.String())\n231\t\t}\n232\t}"},"type":"attachment","uuid":"c9e1f185-d364-49a2-8a74-e1607d16ef11","timestamp":"2026-05-07T18:08:41.148Z","userType":"external","entrypoint":"cli","cwd":"/Users/ninawork/entire/devenv/cli","sessionId":"939fabd6-10fa-4faa-9bd3-ce01733dd4f7","version":"2.1.132","gitBranch":"v2-migration-performance"}
{"parentUuid":"c9e1f185-d364-49a2-8a74-e1607d16ef11","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/ninawork/entire/devenv/cli/cmd/entire/cli/migrate_profile.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"time\"\n8\t)\n9\t\n10\t// migrateProfiler tracks timing for `entire migrate --profile`. It distinguishes\n11\t// two kinds of measurements:\n12\t//\n13\t//   - Phases: one-shot wall-clock segments (e.g., listing v1 checkpoints,\n14\t//     packing the partial generation). Each call to recordPhase appends a row.\n15\t//   - Stages: per-iteration segments inside the migration loop, aggregated\n16\t//     across thousands of calls into count/total/avg/max so the report stays\n17\t//     a fixed size regardless of checkpoint count.\n18\ttype migrateProfiler struct {\n19\t\tphases     []phaseRecord\n20\t\tstages     map[string]*stageStat\n21\t\tstageOrder []string\n22\t}\n23\t\n24\ttype phaseRecord struct {\n25\t\tname     string\n26\t\tduration time.Duration\n27\t}\n28\t\n29\ttype stageStat struct {\n30\t\tname  string\n31\t\tcount int\n32\t\ttotal time.Duration\n33\t\tmax   time.Duration\n34\t}\n35\t\n36\tfunc newMigrateProfiler() *migrateProfiler {\n37\t\treturn &migrateProfiler{stages: make(map[string]*stageStat)}\n38\t}\n39\t\n40\tfunc (p *migrateProfiler) recordPhase(name string, dur time.Duration) {\n41\t\tif p == nil {\n42\t\t\treturn\n43\t\t}\n44\t\tp.phases = append(p.phases, phaseRecord{name: name, duration: dur})\n45\t}\n46\t\n47\tfunc (p *migrateProfiler) recordStage(name string, dur time.Duration) {\n48\t\tif p == nil {\n49\t\t\treturn\n50\t\t}\n51\t\ts, ok := p.stages[name]\n52\t\tif !ok {\n53\t\t\ts = &stageStat{name: name}\n54\t\t\tp.stages[name] = s\n55\t\t\tp.stageOrder = append(p.stageOrder, name)\n56\t\t}\n57\t\ts.count++\n58\t\ts.total += dur\n59\t\tif dur > s.max {\n60\t\t\ts.max = dur\n61\t\t}\n62\t}\n63\t\n64\tfunc (p *migrateProfiler) phaseCount() int { return len(p.phases) }\n65\t\n66\tfunc (p *migrateProfiler) stageCount(name string) int {\n67\t\tif s, ok := p.stages[name]; ok {\n68\t\t\treturn s.count\n69\t\t}\n70\t\treturn 0\n71\t}\n72\t\n73\tfunc (p *migrateProfiler) stageTotal(name string) time.Duration {\n74\t\tif s, ok := p.stages[name]; ok {\n75\t\t\treturn s.total\n76\t\t}\n77\t\treturn 0\n78\t}\n79\t\n80\tfunc (p *migrateProfiler) render(w io.Writer) {\n81\t\tif p == nil || (len(p.phases) == 0 && len(p.stageOrder) == 0) {\n82\t\t\treturn\n83\t\t}\n84\t\tif len(p.phases) > 0 {\n85\t\t\tp.renderPhases(w)\n86\t\t}\n87\t\tif len(p.stageOrder) > 0 {\n88\t\t\tif len(p.phases) > 0 {\n89\t\t\t\tfmt.Fprintln(w)\n90\t\t\t}\n91\t\t\tp.renderStages(w)\n92\t\t}\n93\t}\n94\t\n95\tfunc (p *migrateProfiler) renderPhases(w io.Writer) {\n96\t\tnameWidth := len(\"PHASE\")\n97\t\tdurWidth := len(\"DURATION\")\n98\t\tfor _, ph := range p.phases {\n99\t\t\tif n := len(ph.name); n > nameWidth {\n100\t\t\t\tnameWidth = n\n101\t\t\t}\n102\t\t\tif d := len(formatProfileDuration(ph.duration)); d > durWidth {\n103\t\t\t\tdurWidth = d\n104\t\t\t}\n105\t\t}\n106\t\tfmt.Fprintf(w, \"%-*s  %*s\\n\", nameWidth, \"PHASE\", durWidth, \"DURATION\")\n107\t\tfor _, ph := range p.phases {\n108\t\t\tfmt.Fprintf(w, \"%-*s  %*s\\n\", nameWidth, ph.name, durWidth, formatProfileDuration(ph.duration))\n109\t\t}\n110\t}\n111\t\n112\tfunc (p *migrateProfiler) renderStages(w io.Writer) {\n113\t\tnameWidth := len(\"STAGE\")\n114\t\tcountWidth := len(\"COUNT\")\n115\t\ttotalWidth := len(\"TOTAL\")\n116\t\tavgWidth := len(\"AVG\")\n117\t\tmaxWidth := len(\"MAX\")\n118\t\tfor _, name := range p.stageOrder {\n119\t\t\ts := p.stages[name]\n120\t\t\tavg := stageAverage(s)\n121\t\t\tif n := len(name); n > nameWidth {\n122\t\t\t\tnameWidth = n\n123\t\t\t}\n124\t\t\tif c := len(strconv.Itoa(s.count)); c > countWidth {\n125\t\t\t\tcountWidth = c\n126\t\t\t}\n127\t\t\tif t := len(formatProfileDuration(s.total)); t > totalWidth {\n128\t\t\t\ttotalWidth = t\n129\t\t\t}\n