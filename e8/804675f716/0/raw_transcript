pected -v shorthand to exist\")\n    56→\t}\n    57→\n    58→\t// Full flag\n    59→\tif cmd.Flags().Lookup(\"full\") == nil {\n    60→\t\tt.Error(\"expected --full flag to exist\")\n    61→\t}\n    62→\n    63→\t// Generate flag\n    64→\tif cmd.Flags().Lookup(\"generate\") == nil {\n    65→\t\tt.Error(\"expected --generate flag to exist\")\n    66→\t}\n    67→\n    68→\t// Limit flag\n    69→\tif cmd.Flags().Lookup(\"limit\") == nil {\n    70→\t\tt.Error(\"expected --limit flag to exist\")\n    71→\t}\n    72→}\n    73→\n    74→func TestExplainSession_NotFound(t *testing.T) {\n    75→\ttmpDir := t.TempDir()\n    76→\tt.Chdir(tmpDir)\n    77→\n    78→\t// Initialize git repo\n    79→\tif _, err := git.PlainInit(tmpDir, false); err != nil {\n    80→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n    81→\t}\n    82→\n    83→\t// Create .entire directory\n    84→\tif err := os.MkdirAll(\".entire\", 0o750); err != nil {\n    85→\t\tt.Fatalf(\"failed to create .entire dir: %v\", err)\n    86→\t}\n    87→\n    88→\tvar stdout bytes.Buffer\n    89→\terr := runExplainSession(&stdout, \"nonexistent-session\", false)\n    90→\n    91→\tif err == nil {\n    92→\t\tt.Error(\"expected error for nonexistent session, got nil\")\n    93→\t}\n    94→\tif !strings.Contains(err.Error(), \"not found\") {\n    95→\t\tt.Errorf(\"expected 'not found' in error, got: %v\", err)\n    96→\t}\n    97→}\n    98→\n    99→func TestExplainCommit_NotFound(t *testing.T) {\n   100→\ttmpDir := t.TempDir()\n   101→\tt.Chdir(tmpDir)\n   102→\n   103→\t// Initialize git repo\n   104→\tif _, err := git.PlainInit(tmpDir, false); err != nil {\n   105→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   106→\t}\n   107→\n   108→\tvar stdout bytes.Buffer\n   109→\terr := runExplainCommit(&stdout, \"nonexistent\")\n   110→\n   111→\tif err == nil {\n   112→\t\tt.Error(\"expected error for nonexistent commit, got nil\")\n   113→\t}\n   114→\tif !strings.Contains(err.Error(), \"not found\") && !strings.Contains(err.Error(), \"resolve\") {\n   115→\t\tt.Errorf(\"expected 'not found' or 'resolve' in error, got: %v\", err)\n   116→\t}\n   117→}\n   118→\n   119→func TestExplainCommit_NoEntireData(t *testing.T) {\n   120→\ttmpDir := t.TempDir()\n   121→\tt.Chdir(tmpDir)\n   122→\n   123→\t// Initialize git repo\n   124→\trepo, err := git.PlainInit(tmpDir, false)\n   125→\tif err != nil {\n   126→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   127→\t}\n   128→\n   129→\tw, err := repo.Worktree()\n   130→\tif err != nil {\n   131→\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   132→\t}\n   133→\n   134→\t// Create a commit without Entire metadata\n   135→\ttestFile := filepath.Join(tmpDir, \"test.txt\")\n   136→\tif err := os.WriteFile(testFile, []byte(\"test content\"), 0o644); err != nil {\n   137→\t\tt.Fatalf(\"failed to write test file: %v\", err)\n   138→\t}\n   139→\tif _, err := w.Add(\"test.txt\"); err != nil {\n   140→\t\tt.Fatalf(\"failed to add test file: %v\", err)\n   141→\t}\n   142→\tcommitHash, err := w.Commit(\"regular commit\", &git.CommitOptions{\n   143→\t\tAuthor: &object.Signature{\n   144→\t\t\tName:  \"Test\",\n   145→\t\t\tEmail: \"test@example.com\",\n   146→\t\t},\n   147→\t})\n   148→\tif err != nil {\n   149→\t\tt.Fatalf(\"failed to create commit: %v\", err)\n   150→\t}\n   151→\n   152→\tvar stdout bytes.Buffer\n   153→\terr = runExplainCommit(&stdout, commitHash.String())\n   154→\tif err != nil {\n   155→\t\tt.Fatalf(\"runExplainCommit() should not error for non-Entire commits, got: %v\", err)\n   156→\t}\n   157→\n   158→\toutput := stdout.String()\n   159→\n   160→\t// Should show git info\n   161→\tif !strings.Contains(output, commitHash.String()[:7]) {\n   162→\t\tt.Errorf(\"expected output to contain short commit hash, got: %s\", output)\n   163→\t}\n   164→\tif !strings.Contains(output, \"regular commit\") {\n   165→\t\tt.Errorf(\"expected output to contain commit message, got: %s\", output)\n   166→\t}\n   167→\t// Should