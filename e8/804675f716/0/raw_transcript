)\n   496→\t}\n   497→}\n   498→\n   499→// Helper to verify common session functions work with SessionSource interface\n   500→func TestStrategySessionSourceInterface(t *testing.T) {\n   501→\t// This ensures manual-commit strategy implements SessionSource\n   502→\tvar s = strategy.NewManualCommitStrategy()\n   503→\n   504→\t// Cast to SessionSource - manual-commit strategy should implement it\n   505→\tsource, ok := s.(strategy.SessionSource)\n   506→\tif !ok {\n   507→\t\tt.Fatal(\"ManualCommitStrategy should implement SessionSource interface\")\n   508→\t}\n   509→\n   510→\t// GetAdditionalSessions should exist and be callable\n   511→\t_, err := source.GetAdditionalSessions()\n   512→\tif err != nil {\n   513→\t\tt.Logf(\"GetAdditionalSessions returned error: %v\", err)\n   514→\t}\n   515→}\n   516→\n   517→func TestFormatSessionInfo_CheckpointNumberingReversed(t *testing.T) {\n   518→\tnow := time.Now()\n   519→\tsession := &strategy.Session{\n   520→\t\tID:          \"2025-12-09-test-session\",\n   521→\t\tStrategy:    \"auto-commit\",\n   522→\t\tStartTime:   now.Add(-2 * time.Hour),\n   523→\t\tCheckpoints: []strategy.Checkpoint{}, // Not used for format test\n   524→\t}\n   525→\n   526→\t// Simulate checkpoints coming in newest-first order from ListSessions\n   527→\t// but numbered with oldest=1, newest=N\n   528→\tcheckpointDetails := []checkpointDetail{\n   529→\t\t{\n   530→\t\t\tIndex:     3, // Newest checkpoint should have highest number\n   531→\t\t\tShortID:   \"ccc3333\",\n   532→\t\t\tTimestamp: now,\n   533→\t\t\tMessage:   \"Third (newest) checkpoint\",\n   534→\t\t\tInteractions: []interaction{{\n   535→\t\t\t\tPrompt:    \"Latest change\",\n   536→\t\t\t\tResponses: []string{},\n   537→\t\t\t}},\n   538→\t\t},\n   539→\t\t{\n   540→\t\t\tIndex:     2,\n   541→\t\t\tShortID:   \"bbb2222\",\n   542→\t\t\tTimestamp: now.Add(-time.Hour),\n   543→\t\t\tMessage:   \"Second checkpoint\",\n   544→\t\t\tInteractions: []interaction{{\n   545→\t\t