w intent/outcome placeholders\n   960→\tif !strings.Contains(output, \"Intent:\") {\n   961→\t\tt.Errorf(\"expected 'Intent:', got:\\n%s\", output)\n   962→\t}\n   963→}\n   964→\n   965→func TestFormatBranchExplain_TruncatesLongCheckpointID(t *testing.T) {\n   966→\tnow := time.Now()\n   967→\tpoints := []strategy.RewindPoint{\n   968→\t\t{\n   969→\t\t\tCheckpointID: \"abc123def456789012345\", // Longer than 12 chars\n   970→\t\t\tDate:         now,\n   971→\t\t\tSessionID:    \"2026-01-19-session1\",\n   972→\t\t},\n   973→\t}\n   974→\n   975→\toutput := formatBranchExplain(\"feature/test\", toCheckpointsWithMeta(points), false, false, false, 0, 1)\n   976→\n   977→\t// Should truncate to 12 chars\n   978→\tif !strings.Contains(output, \"[abc123def456]\") {\n   979→\t\tt.Errorf(\"expected truncated checkpoint ID (12 chars), got:\\n%s\", output)\n   980→\t}\n   981→\t// Should NOT contain the full ID\n   982→\tif strings.Contains(output, \"[abc123def456789012345]\") {\n   983→\t\tt.Errorf(\"expected checkpoint ID to be truncated, got:\\n%s\", output)\n   984→\t}\n   985→}\n   986→\n   987→func TestFormatBranchExplain_WithMetadata(t *testing.T) {\n   988→\tnow := time.Now()\n   989→\tcheckpoints := []checkpointWithMeta{\n   990→\t\t{\n   991→\t\t\tPoint: strategy.RewindPoint{\n   992→\t\t\t\tCheckpointID: \"abc123def456\",\n   993→\t\t\t\tDate:         now,\n   994→\t\t\t\tSessionID:    \"2026-01-19-session1\",\n   995→\t\t\t},\n   996→\t\t\tMetadata: &checkpoint.CommittedMetadata{\n   997→\t\t\t\tIntent:  \"Add user authentication\",\n   998→\t\t\t\tOutcome: \"Implemented JWT-based auth\",\n   999→\t\t\t},\n  1000→\t\t},\n  1001→\t}\n  1002→\n  1003→\toutput := formatBranchExplain(\"feature/test\", checkpoints, false, false, false, 0, 1)\n  1004→\n  1005→\t// Should display real intent from metadata\n  1006→\tif !strings.Contains(output, \"Intent: Add user authentication\") {\n  1007→\t\tt.Errorf(\"expected real intent, got:\\n%s\", output)\n  1008→\t}\n  1009→\t