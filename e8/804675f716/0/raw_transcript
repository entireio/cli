oint with message but no interactions (like incremental checkpoints)\n   671→\tcheckpointDetails := []checkpointDetail{\n   672→\t\t{\n   673→\t\t\tIndex:            1,\n   674→\t\t\tShortID:          \"abc1234\",\n   675→\t\t\tTimestamp:        now,\n   676→\t\t\tIsTaskCheckpoint: true,\n   677→\t\t\tMessage:          \"Starting 'dev' agent: Implement feature X (toolu_01ABC)\",\n   678→\t\t\tInteractions:     []interaction{}, // Empty - no transcript available\n   679→\t\t},\n   680→\t}\n   681→\n   682→\toutput := formatSessionInfo(session, \"\", checkpointDetails)\n   683→\n   684→\t// Should show the commit message when there are no interactions\n   685→\tif !strings.Contains(output, \"Starting 'dev' agent: Implement feature X (toolu_01ABC)\") {\n   686→\t\tt.Errorf(\"expected output to contain commit message when no interactions, got:\\n%s\", output)\n   687→\t}\n   688→\n   689→\t// Should NOT show \"## Prompt\" or \"## Responses\" sections since there are no interactions\n   690→\tif strings.Contains(output, \"## Prompt\") {\n   691→\t\tt.Errorf(\"expected output to NOT contain '## Prompt' when no interactions, got:\\n%s\", output)\n   692→\t}\n   693→\tif strings.Contains(output, \"## Responses\") {\n   694→\t\tt.Errorf(\"expected output to NOT contain '## Responses' when no interactions, got:\\n%s\", output)\n   695→\t}\n   696→}\n   697→\n   698→func TestFormatSessionInfo_ShowsMessageAndFilesWhenNoInteractions(t *testing.T) {\n   699→\t// Test that checkpoints without transcript but with files show both message and files\n   700→\tnow := time.Now()\n   701→\tsession := &strategy.Session{\n   702→\t\tID:          \"2025-12-12-incremental-with-files\",\n   703→\t\tStrategy:    \"auto-commit\",\n   704→\t\tStartTime:   now,\n   705→\t\tCheckpoints: []strategy.Checkpoint{},\n   706→\t}\n   707→\n   708→\tcheckpointDetails := []checkpointDetail{\n   709→\t\t{\n   710→\t\t\tIndex:            1,\n   711→\t\t\tShortID:          \"def5678\",\n   712→\t\t\tTimestamp