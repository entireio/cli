if cmd.Flags().Lookup(\"full\") == nil {\n    60→\t\tt.Error(\"expected --full flag to exist\")\n    61→\t}\n    62→\n    63→\t// Generate flag\n    64→\tif cmd.Flags().Lookup(\"generate\") == nil {\n    65→\t\tt.Error(\"expected --generate flag to exist\")\n    66→\t}\n    67→\n    68→\t// Limit flag\n    69→\tif cmd.Flags().Lookup(\"limit\") == nil {\n    70→\t\tt.Error(\"expected --limit flag to exist\")\n    71→\t}\n    72→}\n    73→\n    74→func TestExplainSession_NotFound(t *testing.T) {\n    75→\ttmpDir := t.TempDir()\n    76→\tt.Chdir(tmpDir)\n    77→\n    78→\t// Initialize git repo\n    79→\tif _, err := git.PlainInit(tmpDir, false); err != nil {\n    80→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n    81→\t}\n    82→\n    83→\t// Create .entire directory\n    84→\tif err := os.MkdirAll(\".entire\", 0o750); err != nil {\n    85→\t\tt.Fatalf(\"failed to create .entire dir: %v\", err)\n    86→\t}\n    87→\n    88→\tvar stdout bytes.Buffer\n    89→\terr := runExplainSession(&stdout, \"nonexistent-session\", false)\n    90→\n    91→\tif err == nil {\n    92→\t\tt.Error(\"expected error for nonexistent session, got nil\")\n    93→\t}\n    94→\tif !strings.Contains(err.Error(), \"not found\") {\n    95→\t\tt.Errorf(\"expected 'not found' in error, got: %v\", err)\n    96→\t}\n    97→}\n    98→\n    99→func TestExplainCommit_NotFound(t *testing.T) {\n   100→\ttmpDir := t.TempDir()\n   101→\tt.Chdir(tmpDir)\n   102→\n   103→\t// Initialize git repo\n   104→\tif _, err := git.PlainInit(tmpDir, false); err != nil {\n   105→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   106→\t}\n   107→\n   108→\tvar stdout bytes.Buffer\n   109→\terr := runExplainCommit(&stdout, \"nonexistent\")\n   110→\n   111→\tif err == nil {\n   112→\t\tt.Error(\"expected error for nonexistent commit, got nil\")\n   113→\t}\n   114→\tif !strings.Contains(err.Error(), \"not found\") && !strings.Contains(err.Error(), \"resolve\") {\n   115→\t\tt.Errorf(\"expected 'not found' or 'res