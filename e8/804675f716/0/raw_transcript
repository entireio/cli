ession ID\")\n   368→\t}\n   369→\tif !strings.Contains(output, \"Strategy:\") {\n   370→\t\tt.Error(\"expected output to contain 'Strategy:'\")\n   371→\t}\n   372→\tif !strings.Contains(output, \"manual-commit\") {\n   373→\t\tt.Error(\"expected output to contain strategy name\")\n   374→\t}\n   375→\tif !strings.Contains(output, \"Checkpoints: 2\") {\n   376→\t\tt.Error(\"expected output to contain 'Checkpoints: 2'\")\n   377→\t}\n   378→\t// Check checkpoint details\n   379→\tif !strings.Contains(output, \"Checkpoint 1\") {\n   380→\t\tt.Error(\"expected output to contain 'Checkpoint 1'\")\n   381→\t}\n   382→\tif !strings.Contains(output, \"## Prompt\") {\n   383→\t\tt.Error(\"expected output to contain '## Prompt'\")\n   384→\t}\n   385→\tif !strings.Contains(output, \"## Responses\") {\n   386→\t\tt.Error(\"expected output to contain '## Responses'\")\n   387→\t}\n   388→\tif !strings.Contains(output, \"Files Modified\") {\n   389→\t\tt.Error(\"expected output to contain 'Files Modified'\")\n   390→\t}\n   391→}\n   392→\n   393→func TestFormatSessionInfo_WithSourceRef(t *testing.T) {\n   394→\tnow := time.Now()\n   395→\tsession := &strategy.Session{\n   396→\t\tID:          \"2025-12-09-test-session-abc\",\n   397→\t\tDescription: \"Test description\",\n   398→\t\tStrategy:    \"auto-commit\",\n   399→\t\tStartTime:   now,\n   400→\t\tCheckpoints: []strategy.Checkpoint{\n   401→\t\t\t{\n   402→\t\t\t\tCheckpointID: \"abc1234567890\",\n   403→\t\t\t\tMessage:      \"First checkpoint\",\n   404→\t\t\t\tTimestamp:    now,\n   405→\t\t\t},\n   406→\t\t},\n   407→\t}\n   408→\n   409→\tcheckpointDetails := []checkpointDetail{\n   410→\t\t{\n   411→\t\t\tIndex:     1,\n   412→\t\t\tShortID:   \"abc1234\",\n   413→\t\t\tTimestamp: now,\n   414→\t\t\tMessage:   \"First checkpoint\",\n   415→\t\t},\n   416→\t}\n   417→\n   418→\t// Test with source ref provided\n   419→\tsourceRef := \"entire/metadata@abc123def456\"\n   420→\toutput := formatSessionInfo(session, sou