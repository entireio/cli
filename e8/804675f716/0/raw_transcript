,\n   648→\t\t\tMessage:   \"Test checkpoint\",\n   649→\t\t},\n   650→\t}\n   651→\n   652→\toutput := formatSessionInfo(session, \"\", checkpointDetails)\n   653→\n   654→\t// Should contain \"2025-12-10 14:35\" in the checkpoint header\n   655→\tif !strings.Contains(output, \"2025-12-10 14:35\") {\n   656→\t\tt.Errorf(\"expected output to contain date '2025-12-10 14:35', got:\\n%s\", output)\n   657→\t}\n   658→}\n   659→\n   660→func TestFormatSessionInfo_ShowsMessageWhenNoInteractions(t *testing.T) {\n   661→\t// Test that checkpoints without transcript content show the commit message\n   662→\tnow := time.Now()\n   663→\tsession := &strategy.Session{\n   664→\t\tID:          \"2025-12-12-incremental-session\",\n   665→\t\tStrategy:    \"auto-commit\",\n   666→\t\tStartTime:   now,\n   667→\t\tCheckpoints: []strategy.Checkpoint{},\n   668→\t}\n   669→\n   670→\t// Checkpoint with message but no interactions (like incremental checkpoints)\n   671→\tcheckpointDetails := []checkpointDetail{\n   672→\t\t{\n   673→\t\t\tIndex:            1,\n   674→\t\t\tShortID:          \"abc1234\",\n   675→\t\t\tTimestamp:        now,\n   676→\t\t\tIsTaskCheckpoint: true,\n   677→\t\t\tMessage:          \"Starting 'dev' agent: Implement feature X (toolu_01ABC)\",\n   678→\t\t\tInteractions:     []interaction{}, // Empty - no transcript available\n   679→\t\t},\n   680→\t}\n   681→\n   682→\toutput := formatSessionInfo(session, \"\", checkpointDetails)\n   683→\n   684→\t// Should show the commit message when there are no interactions\n   685→\tif !strings.Contains(output, \"Starting 'dev' agent: Implement feature X (toolu_01ABC)\") {\n   686→\t\tt.Errorf(\"expected output to contain commit message when no interactions, got:\\n%s\", output)\n   687→\t}\n   688→\n   689→\t// Should NOT show \"## Prompt\" or \"## Responses\" sections since there are no interactions\n   690→\tif strings.Contains(output, \"## Prompt\") {\n   691→\t\tt.Errorf(\"expected output to NOT contain '## Prompt