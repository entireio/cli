used variable warnings until generate is implemented\n   137→\t_ = generate\n   138→\n   139→\t// Get current branch info\n   140→\tisDefault, branchName, err := IsOnDefaultBranch()\n   141→\tif err != nil {\n   142→\t\tbranchName = \"unknown\"\n   143→\t}\n   144→\n   145→\t// Apply default limit on main branch when limit is 0 (auto)\n   146→\teffectiveLimit := limit\n   147→\tif isDefault && limit == 0 {\n   148→\t\teffectiveLimit = defaultLimitOnMain\n   149→\t}\n   150→\n   151→\tstrat := GetStrategy()\n   152→\n   153→\t// Get all rewind points (pass 0 for no limit at strategy level)\n   154→\tallPoints, err := strat.GetRewindPoints(0)\n   155→\tif err != nil {\n   156→\t\t// If no rewind points available, show empty branch view\n   157→\t\tallPoints = nil\n   158→\t}\n   159→\n   160→\ttotalCount := len(allPoints)\n   161→\n   162→\t// Apply limit\n   163→\tpoints := allPoints\n   164→\tif effectiveLimit > 0 && len(points) > effectiveLimit {\n   165→\t\tpoints = points[:effectiveLimit]\n   166→\t}\n   167→\n   168→\t// Load metadata for each checkpoint\n   169→\tcheckpoints := make([]checkpointWithMeta, len(points))\n   170→\tfor i, point := range points {\n   171→\t\tcheckpoints[i] = checkpointWithMeta{\n   172→\t\t\tPoint:    point,\n   173→\t\t\tMetadata: loadCheckpointMetadata(point.CheckpointID),\n   174→\t\t}\n   175→\t}\n   176→\n   177→\t// Format output\n   178→\toutput := formatBranchExplain(branchName, checkpoints, verbose, full, isDefault, effectiveLimit, totalCount)\n   179→\n   180→\tif noPager {\n   181→\t\tfmt.Fprint(w, output)\n   182→\t} else {\n   183→\t\toutputWithPager(w, output)\n   184→\t}\n   185→\n   186→\treturn nil\n   187→}\n   188→\n   189→// formatBranchExplain formats the branch-level explain output.\n   190→// Parameters:\n   191→//   - branchName: the current branch name\n   192→//   - checkpoints: the checkpoints with metadata to display (already limited)\n   193→//   - verbose: show additional details like session IDs\n   194→//   - full: show complete transcript (future use)\n   195→//   - isDefault: whether on main/master branch\n   196→//   - limit: the applied limit (0 means no limit)\n   197→//   - totalCount: total number of checkpoints before limiting\n   198→func formatBranchExplain(branchName string, checkpoints []checkpointWithMeta, verbose, full bool, isDefault bool, limit, totalCount int) string {\n   199→\t// Silence unused parameter warnings until full is implemented\n   200→\t_ = full\n   201→\n   202→\tvar sb strings.Builder\n   203→\n   204→\t// Header\n   205→\tsb.WriteString(fmt.Sprintf(\"Branch: %s\\n\", branchName))\n   206→\tif isDefault && limit > 0 && totalCount > limit {\n   207→\t\tsb.WriteString(fmt.Sprintf(\"Checkpoints: %d (showing last %d)\\n\", totalCount, limit))\n   208→\t} else {\n   209→\t\tsb.WriteString(fmt.Sprintf(\"Checkpoints: %d\\n\", len(checkpoints)))\n   210→\t}\n   211→\n   212→\tsb.WriteString(\"\\n\")\n   213→\n   214→\t// Branch-level intent/outcome placeholders\n   215→\tsb.WriteString(\"Intent: (run with --generate to create summary)\\n\")\n   216→\tsb.WriteString(\"Outcome: (run with --generate to create summary)\\n\")\n   217→\n   218→\tsb.WriteString(\"\\n\")\n   219→\tsb.WriteString(strings.Repeat(\"\\u2500\", 40)) // Unicode box drawing character for line\n   220→\tsb.WriteString(\"\\n\\n\")\n   221→\n   222→\t// Checkpoint details\n   223→\tfor _, cp := range checkpoints {\n   224→\t\tpoint := cp.Point\n   225→\t\tmeta := cp.Metadata\n   226→\n   227→\t\tid := point.CheckpointID\n   228→\t\tif len(id) > 12 {\n   229→\t\t\tid = id[:12]\n   230→\t\t}\n   231→\t\tsb.WriteString(fmt.Sprintf(\"[%s] %s\\n\", id, point.Date.Format(\"2006-01-02 15:04\")))\n   232→\n   233→\t\tif verbose && point.SessionID != \"\" {\n   234→\t\t\tsb.WriteString(fmt.Sprintf(\"  Session: %s\\n\", point.SessionID))\n   235→\t\t}\n   236→\n   237→\t\t// Display intent - real value if available, otherwise placeholder\n   238→\t\tintent := \"(not generated)\"\n   239→\t\tif meta != nil && meta.Intent != \"\" {\n   240→\t\t\tintent = meta.Intent\n   241→\t\t}\n   242→\t\tsb.WriteString(fmt.Sprintf(\"  Intent: %s\\n\", intent))\n   243→\n   244→\t\t// Display outcome - real value if available, otherwise placeholder\n   245→\t\toutcome := \"(not generated)\"\n   246→\t\tif meta != nil && meta.Outcome != \"\" {\n   247→\t\t\toutcome = meta.Outcome\n   248→\t\t}\n   249→\t\tsb.WriteString(fmt.Sprintf(\"  Outcome: %s\\n\", outcome))\n   250→\n   251→\t\tsb.WriteString(\"\\n\")\n   252→\t}\n   253→\n   254→\t// Footer for limited view\n   255→\tif isDefault && limit > 0 && totalCount > limit {\n   256→\t\tsb.WriteString(fmt.Sprintf(\"(%d total checkpoints. Use --limit N to adjust)\\n\", totalCount))\n   257→\t}\n   258→\n   259→\treturn sb.String()\n   260→}\n   261→\n   262→// runExplainSession explains a specific session.\n   263→func runExplainSession(w io.Writer, sessionID string, noPager bool) error {\n   264→\tstrat := GetStrategy()\n   265→\n   266→\t// Get session details\n   267→\tsession, err := strategy.GetSession(sessionID)\n   268→\tif err != nil {\n   269→\t\tif errors.Is(err, strategy.ErrNoSession) {\n   270→\t\t\treturn fmt.Errorf(\"session not found: %s\", sessionID)\n   271→\t\t}\n   272→\t\treturn fmt.Errorf(\"failed to get session: %w\", err)\n   273→\t}\n   274→\n   275→\t// Get source ref (metadata branch + commit) for this session\n   276→\tsourceRef := strat.GetSessionMetadataRef(session.ID)\n   277→\n   278→\t// Gather checkpoint details\n   279→\tcheckpointDetails := gatherCheckpointDetails(strat, session)\n   280→\n   281→\t// For strategies like shadow where active sessions may not have checkpoints,\n   282→\t// try to get the current session transcript directly\n   283→\tif len(checkpointDetails) == 0 && len(session.Checkpoints) == 0 {\n   284→\t\tcheckpointDetails = gatherCurrentSessionDetails(strat, session)\n   285→\t}\n   286→\n   287→\t// Format output\n   288→\toutput := formatSessionInfo(session, sourceRef, checkpointDetails)\n   289→\n   290→\t// Output with pager if appropriate\n   291→\tif noPager {\n   292→\t\tfmt.Fprint(w, output)\n   293→\t} else {\n   294→\t\toutputWithPager(w, output)\n   295→\t}\n   296→\n   297→\treturn nil\n   298→}\n   299→\n   300→// gatherCurrentSessionDetails attempts to get transcript info for sessions without checkpoints.\n   301→// This handles strategies like shadow where active sessions may not have checkpoint commits.\n   302→func gatherCurrentSessionDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n   303→\t// Try to get transcript via GetSessionContext which reads from metadata branch\n   304→\t// For shadow, we can read the transcript from the same location pattern\n   305→\tcontextContent := strat.GetSessionContext(session.ID)\n   306→\tif contextContent == \"\" {\n   307→\t\treturn nil\n   308→\t}\n   309→\n   310→\t// Parse the context.md to extract the last prompt/summary\n   311→\t// Context.md typically has sections like \"# Prompt\\n...\\n## Summary\\n...\"\n   312→\tdetail := checkpointDetail{\n   313→\t\tIndex:     1,\n   314→\t\tTimestamp: session.StartTime,\n   315→\t\tMessage:   \"Current session\",\n   316→\t}\n   317→\n   318→\t// Try to extract prompt and summary from context.md\n   319→\tlines := strings.Split(contextContent, \"\\n\")\n   320→\tvar inPrompt, inSummary bool\n   321→\tvar promptLines, summaryLines []string\n   322→\n   323→\tfor _, line := range lines {\n   324→\t\ttrimmed := strings.TrimSpace(line)\n   325→\t\tif strings.HasPrefix(trimmed, \"# \") && strings.Contains(strings.ToLower(trimmed), \"prompt\") {\n   326→\t\t\tinPrompt = true\n   327→\t\t\tinSummary = false\n   328→\t\t\tcontinue\n   329→\t\t}\n   330→\t\tif strings.HasPrefix(trimmed, \"## \") && strings.Contains(strings.ToLower(trimmed), \"summary\") {\n   331→\t\t\tinPrompt = false\n   332→\t\t\tinSummary = true\n   333→\t\t\tcontinue\n   334→\t\t}\n   335→\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"# \") {\n   336→\t\t\tinPrompt = false\n   337→\t\t\tinSummary = false\n   338→\t\t\tcontinue\n   339→\t\t}\n   340→\n   341→\t\tif inPrompt {\n   342→\t\t\tpromptLines = append(promptLines, line)\n   343→\t\t} else if inSummary {\n   344→\t\t\tsummaryLines = append(summaryLines, line)\n   345→\t\t}\n   346→\t}\n   347→\n   348→\tvar inter interaction\n   349→\tif len(promptLines) > 0 {\n   350→\t\tinter.Prompt = strings.TrimSpace(strings.Join(promptLines, \"\\n\"))\n   351→\t}\n   352→\tif len(summaryLines) > 0 {\n   353→\t\tinter.Responses = []string{strings.TrimSpace(strings.Join(summaryLines, \"\\n\"))}\n   354→\t}\n   355→\n   356→\t// If we couldn't parse structured content, show the raw context\n   357→\tif inter.Prompt == \"\" && len(inter.Responses) == 0 {\n   358→\t\tinter.Responses = []string{contextContent}\n   359→\t}\n   360→\n   361→\tif inter.Prompt != \"\" || len(inter.Responses) > 0 {\n   362→\t\tdetail.Interactions = []interaction{inter}\n   363→\t}\n   364→\n   365→\treturn []checkpointDetail{detail}\n   366→}\n   367→\n   368→// gatherCheckpointDetails extracts detailed information for each checkpoint.\n   369→// Checkpoints come in newest-first order, but we number them oldest=1, newest=N.\n   370→func gatherCheckpointDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n   371→\tdetails := make([]checkpointDetail, 0, len(session.Checkpoints))\n   372→\ttotal := len(session.Checkpoints)\n   373→\n   374→\tfor i, cp := range session.Checkpoints {\n   375→\t\tdetail := checkpointDetail{\n   376→\t\t\tIndex:            total - i, // Reverse numbering: oldest=1, newest=N\n   377→\t\t\tTimestamp:        cp.Timestamp,\n   378→\t\t\tIsTaskCheckpoint: cp.IsTaskCheckpoint,\n   379→\t\t\tMessage:          cp.Message,\n   380→\t\t}\n   381→\n   382→\t\t// Use checkpoint ID for display (truncate long IDs)\n   383→\t\tdetail.ShortID = cp.CheckpointID\n   384→\t\tif len(detail.ShortID) > 12 {\n   385→\t\t\tdetail.ShortID = detail.ShortID[:12]\n   386→\t\t}\n   387→\n   388→\t\t// Try to get transcript for this checkpoint\n   389→\t\ttranscriptContent, err := strat.GetCheckpointLog(cp)\n   390→\t\tif err == nil {\n   391→\t\t\ttranscript, parseErr := parseTranscriptFromBytes(transcriptContent)\n   392→\t\t\tif parseErr == nil {\n   393→\t\t\t\t// Extract all prompt/response pairs from the transcript\n   394→\t\t\t\tpairs := ExtractAllPromptResponses(transcript)\n   395→\t\t\t\tfor _, pair := range pairs {\n   396→\t\t\t\t\tdetail.Interactions = append(detail.Interactions, interaction(pair))\n   397→\t\t\t\t}\n   398→\n   399→\t\t\t\t// Aggregate all files for the checkpoint\n   400→\t\t\t\tfileSet := make(map[string]bool)\n   401→\t\t\t\tfor _, pair := range pairs {\n   402→\t\t\t\t\tfor _, f := range pair.Files {\n   403→\t\t\t\t\t\tif !fileSet[f] {\n   404→\t\t\t\t\t\t\tfileSet[f] = true\n   405→\t\t\t\t\t\t\tdetail.Files = append(detail.Files, f)\n   406→\t\t\t\t\t\t}\n   407→\t\t\t\t\t}\n   408→\t\t\t\t}\n   409→\t\t\t}\n   410→\t\t}\n   411→\n   412→\t\tdetails = append(details, detail)\n   413→\t}\n   414→\n   415→\treturn details\n   416→}\n   417→\n   418→// runExplainCommit explains a specific commit.\n   419→func runExplainCommit(w io.Writer, commitRef string) error {\n   420→\trepo, err := openRepository()\n   421→\tif err != nil {\n   422→\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   423→\t}\n   424→\n   425→\t// Resolve the commit reference\n   426→\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n   427→\tif err != nil {\n   428→\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n   429→\t}\n   430→\n   431→\tcommit, err := repo.CommitObject(*hash)\n   432→\tif err != nil {\n   433→\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n   434→\t}\n   435→\n   436→\t// Get files changed in this commit (diff from parent to current)\n   437→\tvar files []string\n   438→\tcommitTree, err := commit.Tree()\n   439→\tif err == nil && commit.NumParents() > 0 {\n   440→\t\tparent, parentErr := commit.Parent(0)\n   441→\t\tif parentErr == nil {\n   442→\t\t\tparentTree, treeErr := parent.Tree()\n   443→\t\t\tif treeErr == nil {\n   444→\t\t\t\t// Diff from parent to current commit to show what changed\n   445→\t\t\t\tchanges, diffErr := parentTree.Diff(commitTree)\n   446→\t\t\t\tif diffErr == nil {\n   447→\t\t\t\t\tfor _, change := range changes {\n   448→\t\t\t\t\t\tname := change.To.Name\n   449→\t\t\t\t\t\tif name == \"\" {\n   450→\t\t\t\t\t\t\tname = change.From.Name\n   451→\t\t\t\t\t\t}\n   452→\t\t\t\t\t\tfiles = append(files, name)\n   453→\t\t\t\t\t}\n   454→\t\t\t\t}\n   455→\t\t\t}\n   456→\t\t}\n   457→\t}\n   458→\n   459→\t// Check for Entire metadata\n   460→\tmetadataDir, hasMetadata := paths.ParseMetadataTrailer(commit.Message)\n   461→\tsessionID, hasSession := paths.ParseSessionTrailer(commit.Message)\n   462→\n   463→\t// If no session trailer, try to extract from metadata path.\n   464→\t// Note: extractSessionIDFromMetadata is defined in rewind.go as it's used\n   465→\t// by both the rewind and explain commands for parsing metadata paths.\n   466→\tif !hasSession && hasMetadata {\n   467→\t\tsessionID = extractSessionIDFromMetadata(metadataDir)\n   468→\t\thasSession = sessionID != \"\"\n   469→\t}\n   470→\n   471→\t// Build commit info\n   472→\tfullSHA := hash.String()\n   473→\tshortSHA := fullSHA\n   474→\tif len(fullSHA) >= 7 {\n   475→\t\tshortSHA = fullSHA[:7]\n   476→\t}\n   477→\n   478→\tinfo := &commitInfo{\n   479→\t\tSHA:       fullSHA,\n   480→\t\tShortSHA:  shortSHA,\n   481→\t\tMessage:   strings.Split(commit.Message, \"\\n\")[0], // First line only\n   482→\t\tAuthor:    commit.Author.Name,\n   483→\t\tEmail:     commit.Author.Email,\n   484→\t\tDate:      commit.Author.When,\n   485→\t\tFiles:     files,\n   486→\t\tHasEntire: hasMetadata || hasSession,\n   487→\t\tSessionID: sessionID,\n   488→\t}\n   489→\n   490→\t// Format and output\n   491→\toutput := formatCommitInfo(info)\n   492→\tfmt.Fprint(w, output)\n   493→\n   494→\treturn nil\n   495→}\n   496→\n   497→// formatSessionInfo formats session information for display.\n   498→func formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n   499→\tvar sb strings.Builder\n   500→\n   501→\t// Session header\n   502→\tsb.WriteString(fmt.Sprintf(\"Session: %s\\n\", session.ID))\n   503→\tsb.WriteString(fmt.Sprintf(\"Strategy: %s\\n\", session.Strategy))\n   504→\n   505→\tif !session.StartTime.IsZero() {\n   506→\t\tsb.WriteString(fmt.Sprintf(\"Started: %s\\n\", session.StartTime.Format(\"2006-01-02 15:04:05\")))\n   507→\t}\n   508→\n   509→\tif sourceRef != \"\" {\n   510→\t\tsb.WriteString(fmt.Sprintf(\"Source Ref: %s\\n\", sourceRef))\n   511→\t}\n   512→\n   513→\tsb.WriteString(fmt.Sprintf(\"Checkpoints: %d\\n\", len(checkpoints)))\n   514→\n   515→\t// Checkpoint details\n   516→\tfor _, cp := range checkpoints {\n   517→\t\tsb.WriteString(\"\\n\")\n   518→\n   519→\t\t// Checkpoint header\n   520→\t\ttaskMarker := \"\"\n   521→\t\tif cp.IsTaskCheckpoint {\n   522→\t\t\ttaskMarker = \" [Task]\"\n   523→\t\t}\n   524→\t\tsb.WriteString(fmt.Sprintf(\"─── Checkpoint %d [%s] %s%s ───\\n\",\n   525→\t\t\tcp.Index, cp.ShortID, cp.Timestamp.Format(\"2006-01-02 15:04\"), taskMarker))\n   526→\t\tsb.WriteString(\"\\n\")\n   527→\n   528→\t\t// Display all interactions in this checkpoint\n   529→\t\tfor i, inter := range cp.Interactions {\n   530→\t\t\t// For multiple interactions, add a sub-header\n   531→\t\t\tif len(cp.Interactions) > 1 {\n   532→\t\t\t\tsb.WriteString(fmt.Sprintf(\"### Interaction %d\\n\\n\", i+1))\n   533→\t\t\t}\n   534→\n   535→\t\t\t// Prompt section\n   536→\t\t\tif inter.Prompt != \"\" {\n   537→\t\t\t\tsb.WriteString(\"## Prompt\\n\\n\")\n   538→\t\t\t\tsb.WriteString(inter.Prompt)\n   539→\t\t\t\tsb.WriteString(\"\\n\\n\")\n   540→\t\t\t}\n   541→\n   542→\t\t\t// Response section\n   543→\t\t\tif len(inter.Responses) > 0 {\n   544→\t\t\t\tsb.WriteString(\"## Responses\\n\\n\")\n   545→\t\t\t\tsb.WriteString(strings.Join(inter.Responses, \"\\n\\n\"))\n   546→\t\t\t\tsb.WriteString(\"\\n\\n\")\n   547→\t\t\t}\n   548→\n   549→\t\t\t// Files modified for this interaction\n   550→\t\t\tif len(inter.Files) > 0 {\n   551→\t\t\t\tsb.WriteString(fmt.Sprintf(\"Files Modified (%d):\\n\", len(inter.Files)))\n   552→\t\t\t\tfor _, file := range inter.Files {\n   553→\t\t\t\t\tsb.WriteString(fmt.Sprintf(\"  - %s\\n\", file))\n   554→\t\t\t\t}\n   555→\t\t\t\tsb.WriteString(\"\\n\")\n   556→\t\t\t}\n   557→\t\t}\n   558→\n   559→\t\t// If no interactions, show message and/or files\n   560→\t\tif len(cp.Interactions) == 0 {\n   561→\t\t\t// Show commit message as summary when no transcript available\n   562→\t\t\tif cp.Message != \"\" {\n   563→\t\t\t\tsb.WriteString(cp.Message)\n   564→\t\t\t\tsb.WriteString(\"\\n\\n\")\n   565→\t\t\t}\n   566→\t\t\t// Show aggregate files if available\n   567→\t\t\tif len(cp.Files) > 0 {\n   568→\t\t\t\tsb.WriteString(fmt.Sprintf(\"Files Modified (%d):\\n\", len(cp.Files)))\n   569→\t\t\t\tfor _, file := range cp.Files {\n   570→\t\t\t\t\tsb.WriteString(fmt.Sprintf(\"  - %s\\n\", file))\n   571→\t\t\t\t}\n   572→\t\t\t}\n   573→\t\t}\n   574→\t}\n   575→\n   576→\treturn sb.String()\n   577→}\n   578→\n   579→// formatCommitInfo formats commit information for display.\n   580→func formatCommitInfo(info *commitInfo) string {\n   581→\tvar sb strings.Builder\n   582→\n   583→\tsb.WriteString(fmt.Sprintf(\"Commit: %s (%s)\\n\", info.SHA, info.ShortSHA))\n   584→\tsb.WriteString(fmt.Sprintf(\"Date: %s\\n\", info.Date.Format(\"2006-01-02 15:04:05\")))\n   585→\n   586→\tif info.HasEntire && info.SessionID != \"\" {\n   587→\t\tsb.WriteString(fmt.Sprintf(\"Session: %s\\n\", info.SessionID))\n   588→\t}\n   589→\n   590→\tsb.WriteString(\"\\n\")\n   591→\n   592→\t// Message\n   593→\tsb.WriteString(\"Message:\\n\")\n   594→\tsb.WriteString(fmt.Sprintf(\"  %s\\n\", info.Message))\n   595→\tsb.WriteString(\"\\n\")\n   596→\n   597→\t// Files modified\n   598→\tif len(info.Files) > 0 {\n   599→\t\tsb.WriteString(fmt.Sprintf(\"Files Modified (%d):\\n\", len(info.Files)))\n   600→\t\tfor _, file := range info.Files {\n   601→\t\t\tsb.WriteString(fmt.Sprintf(\"  - %s\\n\", file))\n   602→\t\t}\n   603→\t\tsb.WriteString(\"\\n\")\n   604→\t}\n   605→\n   606→\t// Note for non-Entire commits\n   607→\tif !info.HasEntire {\n   608→\t\tsb.WriteString(\"Note: No Entire session data available for this commit.\\n\")\n   609→\t}\n   610→\n   611→\treturn sb.String()\n   612→}\n   613→\n   614→// outputWithPager outputs content through a pager if stdout is a terminal and content is long.\n   615→func outputWithPager(w io.Writer, content string) {\n   616→\t// Check if we're writing to stdout and it's a terminal\n   617→\tif f, ok := w.(*os.File); ok && f == os.Stdout && term.IsTerminal(int(f.Fd())) {\n   618→\t\t// Get terminal height\n   619→\t\t_, height, err := term.GetSize(int(f.Fd()))\n   620→\t\tif err != nil {\n   621→\t\t\theight = 24 // Default fallback\n   622→\t\t}\n   623→\n   624→\t\t// Count lines in content\n   625→\t\tlineCount := strings.Count(content, \"\\n\")\n   626→\n   627→\t\t// Use pager if content exceeds terminal height\n   628→\t\tif lineCount > height-2 {\n   629→\t\t\tpager := os.Getenv(\"PAGER\")\n   630→\t\t\tif pager == \"\" {\n   631→\t\t\t\tpager = \"less\"\n   632→\t\t\t}\n   633→\n   634→\t\t\tcmd := exec.CommandContext(context.Background(), pager) //nolint:gosec // pager from env is expected\n   635→\t\t\tcmd.Stdin = strings.NewReader(content)\n   636→\t\t\tcmd.Stdout = f\n   637→\t\t\tcmd.Stderr = os.Stderr\n   638→\n   639→\t\t\tif err := cmd.Run(); err != nil {\n   640→\t\t\t\t// Fallback to direct output if pager fails\n   641→\t\t\t\tfmt.Fprint(w, content)\n   642→\t\t\t}\n   643→\t\t\treturn\n   644→\t\t}\n   645→\t}\n   646→\n   647→\t// Direct output for non-terminal or short content\n   648→\tfmt.Fprint(w, content)\n   649→}\n   650→\n   651→// loadCheckpointMetadata loads the CommittedMetadata for a checkpoint ID.\n   652→// Returns nil if metadata cannot be loaded (e.g., no repository, no sessions branch,\n   653→// checkpoint doesn't exist, or any other error).\n   654→func loadCheckpointMetadata(checkpointID string) *checkpoint.CommittedMetadata {\n   655→\trepo, err := openRepository()\n   656→\tif err != nil {\n   657→\t\treturn nil\n   658→\t}\n   659→\n   660→\tstore := checkpoint.NewGitStore(repo)\n   661→\tresult, err := store.ReadCommitted(context.Background(), checkpointID)\n   662→\tif err != nil || result == nil {\n   663→\t\treturn nil\n   664→\t}\n   665→\n   666→\treturn &result.Metadata\n   667→}\n   668→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"a763d509-c035-44f1-a8e5-cc8587969542","timestamp":"2026-01-20T00:08:05.411Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/alex/workspace/cli/cmd/entire/cli/explain.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"time\"\n\n\t\"entire.io/cli/cmd/entire/cli/checkpoint\"\n\t\"entire.io/cli/cmd/entire/cli/paths\"\n\t\"entire.io/cli/cmd/entire/cli/strategy\"\n\n\t\"github.com/go-git/go-git/v5/plumbing\"\n\t\"github.com/spf13/cobra\"\n\t\"golang.org/x/term\"\n)\n\n// commitInfo holds information about a commit for display purposes.\ntype commitInfo struct {\n\tSHA       string\n\tShortSHA  string\n\tMessage   string\n\tAuthor    string\n\tEmail     string\n\tDate      time.Time\n\tFiles     []string\n\tHasEntire bool\n\tSessionID string\n}\n\n// interaction holds a single prompt and its responses for display.\ntype interaction struct {\n\tPrompt    string\n\tResponses []string // Multiple responses can occur between tool calls\n\tFiles     []string\n}\n\n// checkpointDetail holds detailed information about a checkpoint for display.\ntype checkpointDetail struct {\n\tIndex            int\n\tShortID          string\n\tTimestamp        time.Time\n\tIsTaskCheckpoint bool\n\tMessage          string\n\t// Interactions contains all prompt/response pairs in this checkpoint.\n\t// Most strategies have one, but shadow condensations may have multiple.\n\tInteractions []interaction\n\t// Files is the aggregate list of all files modified (for backwards compat)\n\tFiles []string\n}\n\n// checkpointWithMeta holds a rewind point together with its loaded metadata.\n// Used by formatBranchExplain to display metadata summaries when available.\ntype checkpointWithMeta struct {\n\tPoint    strategy.RewindPoint\n\tMetadata *checkpoint.CommittedMetadata\n}\n\nfunc newExplainCmd() *cobra.Command {\n\tvar sessionFlag string\n\tvar commitFlag string\n\tvar noPagerFlag bool\n\tvar verboseFlag bool\n\tvar fullFlag bool\n\tvar generateFlag bool\n\tvar limitFlag int\n\n\tcmd := &cobra.Command{\n\t\tUse:   \"explain\",\n\t\tShort: \"Explain a session or commit\",\n\t\tLong: `Explain provides human-readable context about sessions and commits.\n\nUse this command to understand what happened during agent-driven development,\neither for self-review or to understand a teammate's work.\n\nBy default, explains the current session. Use flags to explain a specific\nsession or commit.`,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\t// Check if Entire is disabled\n\t\t\tif checkDisabledGuard(cmd.OutOrStdout()) {\n\t\t\t\treturn nil\n\t\t\t}\n\n\t\t\treturn runExplain(cmd.OutOrStdout(), sessionFlag, commitFlag, noPagerFlag, verboseFlag, fullFlag, generateFlag, limitFlag)\n\t\t},\n\t}\n\n\tcmd.Flags().StringVar(&sessionFlag, \"session\", \"\", \"Explain a specific session (ID or prefix)\")\n\tcmd.Flags().StringVar(&commitFlag, \"commit\", \"\", \"Explain a specific commit (SHA or ref)\")\n\tcmd.Flags().BoolVar(&noPagerFlag, \"no-pager\", false, \"Disable pager output\")\n\tcmd.Flags().BoolVarP(&verboseFlag, \"verbose\", \"v\", false, \"Show prompts, files, and session IDs\")\n\tcmd.Flags().BoolVar(&fullFlag, \"full\", false, \"Show complete transcript\")\n\tcmd.Flags().BoolVar(&generateFlag, \"generate\", false, \"Generate AI summaries for checkpoints\")\n\tcmd.Flags().IntVar(&limitFlag, \"limit\", 0, \"Limit number of checkpoints shown (0 = auto)\")\n\n\treturn cmd\n}\n\n// runExplain routes to the appropriate explain function based on flags.\n// The verbose, full, and generate parameters are accepted for future use\n// but are not yet implemented in the output formatting.\nfunc runExplain(w io.Writer, sessionID, commitRef string, noPager, verbose, full, generate bool, limit int) error {\n\t// Silence unused variable warnings until these are implemented\n\t_ = verbose\n\t_ = full\n\t_ = generate\n\n\t// Error if both flags are provided\n\tif sessionID != \"\" && commitRef != \"\" {\n\t\treturn errors.New(\"cannot specify both --session and --commit\")\n\t}\n\n\t// Route to appropriate handler\n\tif sessionID != \"\" {\n\t\treturn runExplainSession(w, sessionID, noPager)\n\t}\n\tif commitRef != \"\" {\n\t\treturn runExplainCommit(w, commitRef)\n\t}\n\n\t// Default: explain branch-level view\n\treturn runExplainDefault(w, noPager, verbose, full, generate, limit)\n}\n\n// defaultLimitOnMain is the default number of checkpoints to show on main/master branches.\nconst defaultLimitOnMain = 10\n\n// runExplainDefault explains the current branch state.\n// Shows branch-level information with checkpoint listing.\n// The verbose, full, and generate parameters control output detail level.\nfunc runExplainDefault(w io.Writer, noPager, verbose, full, generate bool, limit int) error {\n\t// Silence unused variable warnings until generate is implemented\n\t_ = generate\n\n\t// Get current branch info\n\tisDefault, branchName, err := IsOnDefaultBranch()\n\tif err != nil {\n\t\tbranchName = \"unknown\"\n\t}\n\n\t// Apply default limit on main branch when limit is 0 (auto)\n\teffectiveLimit := limit\n\tif isDefault && limit == 0 {\n\t\teffectiveLimit = defaultLimitOnMain\n\t}\n\n\tstrat := GetStrategy()\n\n\t// Get all rewind points (pass 0 for no limit at strategy level)\n\tallPoints, err := strat.GetRewindPoints(0)\n\tif err != nil {\n\t\t// If no rewind points available, show empty branch view\n\t\tallPoints = nil\n\t}\n\n\ttotalCount := len(allPoints)\n\n\t// Apply limit\n\tpoints := allPoints\n\tif effectiveLimit > 0 && len(points) > effectiveLimit {\n\t\tpoints = points[:effectiveLimit]\n\t}\n\n\t// Load metadata for each checkpoint\n\tcheckpoints := make([]checkpointWithMeta, len(points))\n\tfor i, point := range points {\n\t\tcheckpoints[i] = checkpointWithMeta{\n\t\t\tPoint:    point,\n\t\t\tMetadata: loadCheckpointMetadata(point.CheckpointID),\n\t\t}\n\t}\n\n\t// Format output\n\toutput := formatBranchExplain(branchName, checkpoints, verbose, full, isDefault, effectiveLimit, totalCount)\n\n\tif noPager {\n\t\tfmt.Fprint(w, output)\n\t} else {\n\t\toutputWithPager(w, output)\n\t}\n\n\treturn nil\n}\n\n// formatBranchExplain formats the branch-level explain output.\n// Parameters:\n//   - branchName: the current branch name\n//   - checkpoints: the checkpoints with metadata to display (already limited)\n//   - verbose: show additional details like session IDs\n//   - full: show complete transcript (future use)\n//   - isDefault: whether on main/master branch\n//   - limit: the applied limit (0 means no limit)\n//   - totalCount: total number of checkpoints before limiting\nfunc formatBranchExplain(branchName string, checkpoints []checkpointWithMeta, verbose, full bool, isDefault bool, limit, totalCount int) string {\n\t// Silence unused parameter warnings until full is implemented\n\t_ = full\n\n\tvar sb strings.Builder\n\n\t// Header\n\tsb.WriteString(fmt.Sprintf(\"Branch: %s\\n\", branchName))\n\tif isDefault && limit > 0 && totalCount > limit {\n\t\tsb.WriteString(fmt.Sprintf(\"Checkpoints: %d (showing last %d)\\n\", totalCount, limit))\n\t} else {\n\t\tsb.WriteString(fmt.Sprintf(\"Checkpoints: %d\\n\", len(checkpoints)))\n\t}\n\n\tsb.WriteString(\"\\n\")\n\n\t// Branch-level intent/outcome placeholders\n\tsb.WriteString(\"Intent: (run with --generate to create summary)\\n\")\n\tsb.WriteString(\"Outcome: (run with --generate to create summary)\\n\")\n\n\tsb.WriteString(\"\\n\")\n\tsb.WriteString(strings.Repeat(\"\\u2500\", 40)) // Unicode box drawing character for line\n\tsb.WriteString(\"\\n\\n\")\n\n\t// Checkpoint details\n\tfor _, cp := range checkpoints {\n\t\tpoint := cp.Point\n\t\tmeta := cp.Metadata\n\n\t\tid := point.CheckpointID\n\t\tif len(id) > 12 {\n\t\t\tid = id[:12]\n\t\t}\n\t\tsb.WriteString(fmt.Sprintf(\"[%s] %s\\n\", id, point.Date.Format(\"2006-01-02 15:04\")))\n\n\t\tif verbose && point.SessionID != \"\" {\n\t\t\tsb.WriteString(fmt.Sprintf(\"  Session: %s\\n\", point.SessionID))\n\t\t}\n\n\t\t// Display intent - real value if available, otherwise placeholder\n\t\tintent := \"(not generated)\"\n\t\tif meta != nil && meta.Intent != \"\" {\n\t\t\tintent = meta.Intent\n\t\t}\n\t\tsb.WriteString(fmt.Sprintf(\"  Intent: %s\\n\", intent))\n\n\t\t// Display outcome - real value if available, otherwise placeholder\n\t\toutcome := \"(not generated)\"\n\t\tif meta != nil && meta.Outcome != \"\" {\n\t\t\toutcome = meta.Outcome\n\t\t}\n\t\tsb.WriteString(fmt.Sprintf(\"  Outcome: %s\\n\", outcome))\n\n\t\tsb.WriteString(\"\\n\")\n\t}\n\n\t// Footer for limited view\n\tif isDefault && limit > 0 && totalCount > limit {\n\t\tsb.WriteString(fmt.Sprintf(\"(%d total checkpoints. Use --limit N to adjust)\\n\", totalCount))\n\t}\n\n\treturn sb.String()\n}\n\n// runExplainSession explains a specific session.\nfunc runExplainSession(w io.Writer, sessionID string, noPager bool) error {\n\tstrat := GetStrategy()\n\n\t// Get session details\n\tsession, err := strategy.GetSession(sessionID)\n\tif err != nil {\n\t\tif errors.Is(err, strategy.ErrNoSession) {\n\t\t\treturn fmt.Errorf(\"session not found: %s\", sessionID)\n\t\t}\n\t\treturn fmt.Errorf(\"failed to get session: %w\", err)\n\t}\n\n\t// Get source ref (metadata branch + commit) for this session\n\tsourceRef := strat.GetSessionMetadataRef(session.ID)\n\n\t// Gather checkpoint details\n\tcheckpointDetails := gatherCheckpointDetails(strat, session)\n\n\t// For strategies like shadow where active sessions may not have checkpoints,\n\t// try to get the current session transcript directly\n\tif len(checkpointDetails) == 0 && len(session.Checkpoints) == 0 {\n\t\tcheckpointDetails = gatherCurrentSessionDetails(strat, session)\n\t}\n\n\t// Format output\n\toutput := formatSessionInfo(session, sourceRef, checkpointDetails)\n\n\t// Output with pager if appropriate\n\tif noPager {\n\t\tfmt.Fprint(w, output)\n\t} else {\n\t\toutputWithPager(w, output)\n\t}\n\n\treturn nil\n}\n\n// gatherCurrentSessionDetails attempts to get transcript info for sessions without checkpoints.\n// This handles strategies like shadow where active sessions may not have checkpoint commits.\nfunc gatherCurrentSessionDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n\t// Try to get transcript via GetSessionContext which reads from metadata branch\n\t// For shadow, we can read the transcript from the same location pattern\n\tcontextContent := strat.GetSessionContext(session.ID)\n\tif contextContent == \"\" {\n\t\treturn nil\n\t}\n\n\t// Parse the context.md to extract the last prompt/summary\n\t// Context.md typically has sections like \"# Prompt\\n...\\n## Summary\\n...\"\n\tdetail := checkpointDetail{\n\t\tIndex:     1,\n\t\tTimestamp: session.StartTime,\n\t\tMessage:   \"Current session\",\n\t}\n\n\t// Try to extract prompt and summary from context.md\n\tlines := strings.Split(contextContent, \"\\n\")\n\tvar inPrompt, inSummary bool\n\tvar promptLines, summaryLines []string\n\n\tfor _, line := range lines {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif strings.HasPrefix(trimmed, \"# \") && strings.Contains(strings.ToLower(trimmed), \"prompt\") {\n\t\t\tinPrompt = true\n\t\t\tinSummary = false\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(trimmed, \"## \") && strings.Contains(strings.ToLower(trimmed), \"summary\") {\n\t\t\tinPrompt = false\n\t\t\tinSummary = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"# \") {\n\t\t\tinPrompt = false\n\t\t\tinSummary = false\n\t\t\tcontinue\n\t\t}\n\n\t\tif inPrompt {\n\t\t\tpromptLines = append(promptLines, line)\n\t\t} else if inSummary {\n\t\t\tsummaryLines = append(summaryLines, line)\n\t\t}\n\t}\n\n\tvar inter interaction\n\tif len(promptLines) > 0 {\n\t\tinter.Prompt = strings.TrimSpace(strings.Join(promptLines, \"\\n\"))\n\t}\n\tif len(summaryLines) > 0 {\n\t\tinter.Responses = []string{strings.TrimSpace(strings.Join(summaryLines, \"\\n\"))}\n\t}\n\n\t// If we couldn't parse structured content, show the raw context\n\tif inter.Prompt == \"\" && len(inter.Responses) == 0 {\n\t\tinter.Responses = []string{contextContent}\n\t}\n\n\tif inter.Prompt != \"\" || len(inter.Responses) > 0 {\n\t\tdetail.Interactions = []interaction{inter}\n\t}\n\n\treturn []checkpointDetail{detail}\n}\n\n// gatherCheckpointDetails extracts detailed information for each checkpoint.\n// Checkpoints come in newest-first order, but we number them oldest=1, newest=N.\nfunc gatherCheckpointDetails(strat strategy.Strategy, session *strategy.Session) []checkpointDetail {\n\tdetails := make([]checkpointDetail, 0, len(session.Checkpoints))\n\ttotal := len(session.Checkpoints)\n\n\tfor i, cp := range session.Checkpoints {\n\t\tdetail := checkpointDetail{\n\t\t\tIndex:            total - i, // Reverse numbering: oldest=1, newest=N\n\t\t\tTimestamp:        cp.Timestamp,\n\t\t\tIsTaskCheckpoint: cp.IsTaskCheckpoint,\n\t\t\tMessage:          cp.Message,\n\t\t}\n\n\t\t// Use checkpoint ID for display (truncate long IDs)\n\t\tdetail.ShortID = cp.CheckpointID\n\t\tif len(detail.ShortID) > 12 {\n\t\t\tdetail.ShortID = detail.ShortID[:12]\n\t\t}\n\n\t\t// Try to get transcript for this checkpoint\n\t\ttranscriptContent, err := strat.GetCheckpointLog(cp)\n\t\tif err == nil {\n\t\t\ttranscript, parseErr := parseTranscriptFromBytes(transcriptContent)\n\t\t\tif parseErr == nil {\n\t\t\t\t// Extract all prompt/response pairs from the transcript\n\t\t\t\tpairs := ExtractAllPromptResponses(transcript)\n\t\t\t\tfor _, pair := range pairs {\n\t\t\t\t\tdetail.Interactions = append(detail.Interactions, interaction(pair))\n\t\t\t\t}\n\n\t\t\t\t// Aggregate all files for the checkpoint\n\t\t\t\tfileSet := make(map[string]bool)\n\t\t\t\tfor _, pair := range pairs {\n\t\t\t\t\tfor _, f := range pair.Files {\n\t\t\t\t\t\tif !fileSet[f] {\n\t\t\t\t\t\t\tfileSet[f] = true\n\t\t\t\t\t\t\tdetail.Files = append(detail.Files, f)\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tdetails = append(details, detail)\n\t}\n\n\treturn details\n}\n\n// runExplainCommit explains a specific commit.\nfunc runExplainCommit(w io.Writer, commitRef string) error {\n\trepo, err := openRepository()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n\t}\n\n\t// Resolve the commit reference\n\thash, err := repo.ResolveRevision(plumbing.Revision(commitRef))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"commit not found: %s\", commitRef)\n\t}\n\n\tcommit, err := repo.CommitObject(*hash)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get commit: %w\", err)\n\t}\n\n\t// Get files changed in this commit (diff from parent to current)\n\tvar files []string\n\tcommitTree, err := commit.Tree()\n\tif err == nil && commit.NumParents() > 0 {\n\t\tparent, parentErr := commit.Parent(0)\n\t\tif parentErr == nil {\n\t\t\tparentTree, treeErr := parent.Tree()\n\t\t\tif treeErr == nil {\n\t\t\t\t// Diff from parent to current commit to show what changed\n\t\t\t\tchanges, diffErr := parentTree.Diff(commitTree)\n\t\t\t\tif diffErr == nil {\n\t\t\t\t\tfor _, change := range changes {\n\t\t\t\t\t\tname := change.To.Name\n\t\t\t\t\t\tif name == \"\" {\n\t\t\t\t\t\t\tname = change.From.Name\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfiles = append(files, name)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\t// Check for Entire metadata\n\tmetadataDir, hasMetadata := paths.ParseMetadataTrailer(commit.Message)\n\tsessionID, hasSession := paths.ParseSessionTrailer(commit.Message)\n\n\t// If no session trailer, try to extract from metadata path.\n\t// Note: extractSessionIDFromMetadata is defined in rewind.go as it's used\n\t// by both the rewind and explain commands for parsing metadata paths.\n\tif !hasSession && hasMetadata {\n\t\tsessionID = extractSessionIDFromMetadata(metadataDir)\n\t\thasSession = sessionID != \"\"\n\t}\n\n\t// Build commit info\n\tfullSHA := hash.String()\n\tshortSHA := fullSHA\n\tif len(fullSHA) >= 7 {\n\t\tshortSHA = fullSHA[:7]\n\t}\n\n\tinfo := &commitInfo{\n\t\tSHA:       fullSHA,\n\t\tShortSHA:  shortSHA,\n\t\tMessage:   strings.Split(commit.Message, \"\\n\")[0], // First line only\n\t\tAuthor:    commit.Author.Name,\n\t\tEmail:     commit.Author.Email,\n\t\tDate:      commit.Author.When,\n\t\tFiles:     files,\n\t\tHasEntire: hasMetadata || hasSession,\n\t\tSessionID: sessionID,\n\t}\n\n\t// Format and output\n\toutput := formatCommitInfo(info)\n\tfmt.Fprint(w, output)\n\n\treturn nil\n}\n\n// formatSessionInfo formats session information for display.\nfunc formatSessionInfo(session *strategy.Session, sourceRef string, checkpoints []checkpointDetail) string {\n\tvar sb strings.Builder\n\n\t// Session header\n\tsb.WriteString(fmt.Sprintf(\"Session: %s\\n\", session.ID))\n\tsb.WriteString(fmt.Sprintf(\"Strategy: %s\\n\", session.Strategy))\n\n\tif !session.Sta