   []interaction{}, // Empty - no transcript\n   716→\t\t\tFiles:            []string{\"api/endpoint.go\", \"api/endpoint_test.go\"},\n   717→\t\t},\n   718→\t}\n   719→\n   720→\toutput := formatSessionInfo(session, \"\", checkpointDetails)\n   721→\n   722→\t// Should show the commit message\n   723→\tif !strings.Contains(output, \"Running tests for API endpoint (toolu_02DEF)\") {\n   724→\t\tt.Errorf(\"expected output to contain commit message, got:\\n%s\", output)\n   725→\t}\n   726→\n   727→\t// Should also show the files\n   728→\tif !strings.Contains(output, \"Files Modified\") {\n   729→\t\tt.Errorf(\"expected output to contain 'Files Modified', got:\\n%s\", output)\n   730→\t}\n   731→\tif !strings.Contains(output, \"api/endpoint.go\") {\n   732→\t\tt.Errorf(\"expected output to contain modified file, got:\\n%s\", output)\n   733→\t}\n   734→}\n   735→\n   736→func TestFormatSessionInfo_DoesNotShowMessageWhenHasInteractions(t *testing.T) {\n   737→\t// Test that checkpoints WITH interactions don't show the message separately\n   738→\t// (the interactions already contain the content)\n   739→\tnow := time.Now()\n   740→\tsession := &strategy.Session{\n   741→\t\tID:          \"2025-12-12-full-checkpoint\",\n   742→\t\tStrategy:    \"auto-commit\",\n   743→\t\tStartTime:   now,\n   744→\t\tCheckpoints: []strategy.Checkpoint{},\n   745→\t}\n   746→\n   747→\tcheckpointDetails := []checkpointDetail{\n   748→\t\t{\n   749→\t\t\tIndex:            1,\n   750→\t\t\tShortID:          \"ghi9012\",\n   751→\t\t\tTimestamp:        now,\n   752→\t\t\tIsTaskCheckpoint: true,\n   753→\t\t\tMessage:          \"Completed 'dev' agent: Implement feature (toolu_03GHI)\",\n   754→\t\t\tInteractions: []interaction{\n   755→\t\t\t\t{\n   756→\t\t\t\t\tPrompt:    \"Implement the feature\",\n   757→\t\t\t\t\tResponses: []string{\"I've implemented the feature by...\"},\n   758→\t\t\t\t\tFiles:     []string{\"feature.go\"},\n   759→\t\t\t\t},\n   760→\t\t\t},\n   761→\t\t},\n   762→\t}\n   763→\n   764→\toutput := formatSessionInfo(session, \"\", checkpointDetails)\n   765→\n   766→\t// Should show the interaction content\n   767→\tif !strings.Contains(output, \"Implement the feature\") {\n   768→\t\tt.Errorf(\"expected output to contain prompt, got:\\n%s\", output)\n   769→\t}\n   770→\tif !strings.Contains(output, \"I've implemented the feature by\") {\n   771→\t\tt.Errorf(\"expected output to contain response, got:\\n%s\", output)\n   772→\t}\n   773→\n   774→\t// The message should NOT appear as a separate line (it's redundant when we have interactions)\n   775→\t// The output should contain ## Prompt and ## Responses for the interaction\n   776→\tif !strings.Contains(output, \"## Prompt\") {\n   777→\t\tt.Errorf(\"expected output to contain '## Prompt' when has interactions, got:\\n%s\", output)\n   778→\t}\n   779→}\n   780→\n   781→func TestRunExplainDefault_ShowsBranchInfo(t *testing.T) {\n   782→\tsetupExplainTestRepo(t)\n   783→\n   784→\tvar stdout bytes.Buffer\n   785→\t// Call runExplainDefault with noPager=true to avoid pager issues in test\n   786→\terr := runExplainDefault(&stdout, true, false, false, false, 0)\n   787→\n   788→\t// Should not error (may have no checkpoints, but should still show branch info)\n   789→\tif err != nil {\n   790→\t\tt.Fatalf(\"runExplainDefault() error = %v\", err)\n   791→\t}\n   792→\n   793→\t// For now, we're just checking the function runs and includes branch info\n   794→\toutput := stdout.String()\n   795→\tif !strings.Contains(output, \"Branch:\") {\n   796→\t\tt.Errorf(\"expected output to contain 'Branch:', got:\\n%s\", output)\n   797→\t}\n   798→}\n   799→\n   800→func TestRunExplainDefault_DefaultLimitOnMainBranch(t *testing.T) {\n   801→\tsetupExplainTestRepo(t)\n   802→\n   803→\tvar stdout bytes.Buffer\n   804→\t// Call with limit=0 (auto) - should apply default limit on main branch\n   805→\terr := runExplainDefault(&stdout, true, false, false, false, 0)\n   806→\n   807→\tif err