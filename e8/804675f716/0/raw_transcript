utcome: First checkpoint outcome\") {\n  1105→\t\tt.Errorf(\"expected first checkpoint outcome, got:\\n%s\", output)\n  1106→\t}\n  1107→\n  1108→\t// The output should contain at least one placeholder (from the second checkpoint)\n  1109→\t// Count occurrences of \"(not generated)\" - should be 2 (intent + outcome for second checkpoint)\n  1110→\tplaceholderCount := strings.Count(output, \"(not generated)\")\n  1111→\tif placeholderCount != 2 {\n  1112→\t\tt.Errorf(\"expected 2 placeholders for second checkpoint, got %d in:\\n%s\", placeholderCount, output)\n  1113→\t}\n  1114→}\n  1115→\n  1116→func TestFormatBranchExplain_WithGeneratedSummary(t *testing.T) {\n  1117→\t// Test that GeneratedSummary is used when Metadata has no intent/outcome\n  1118→\tnow := time.Now()\n  1119→\tcheckpoints := []checkpointWithMeta{\n  1120→\t\t{\n  1121→\t\t\tPoint: strategy.RewindPoint{\n  1122→\t\t\t\tCheckpointID: \"abc123def456\",\n  1123→\t\t\t\tDate:         now,\n  1124→\t\t\t\tSessionID:    \"2026-01-19-session1\",\n  1125→\t\t\t},\n  1126→\t\t\tMetadata: nil, // No stored metadata\n  1127→\t\t\tGeneratedSummary: &Summary{\n  1128→\t\t\t\tIntent:  \"Generated intent from transcript\",\n  1129→\t\t\t\tOutcome: \"Generated outcome from transcript\",\n  1130→\t\t\t},\n  1131→\t\t},\n  1132→\t}\n  1133→\n  1134→\toutput := formatBranchExplain(\"feature/test\", checkpoints, false, false, false, 0, 1)\n  1135→\n  1136→\t// Should display generated intent\n  1137→\tif !strings.Contains(output, \"Intent: Generated intent from transcript\") {\n  1138→\t\tt.Errorf(\"expected generated intent, got:\\n%s\", output)\n  1139→\t}\n  1140→\t// Should display generated outcome\n  1141→\tif !strings.Contains(output, \"Outcome: Generated outcome from transcript\") {\n  1142→\t\tt.Errorf(\"expected generated outcome, got:\\n%s\", output)\n  1143→\t}\n  1144→\t// Should NOT show placeholder text\n  1145→\tif strings.Contains(output, \"(not generated)\") {\n  1146→\t\tt.Errorf(\"expected no pla