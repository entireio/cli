{"parentUuid":"7be7d678-f704-4e59-acfd-00374dd1b7e9","isSidechain":false,"promptId":"b5cdc172-8893-41e7-a59a-d5fd70de15f8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018B1FDdcP8m9pzPUDgvBSm4","type":"tool_result","content":"2595\t// HandleTurnEnd dispatches strategy-specific actions emitted when an agent turn ends.\n2596\t// The primary job is to finalize all checkpoints from this turn with the full transcript.\n2597\t//\n2598\t// During a turn, PostCommit writes provisional transcript data (whatever was available\n2599\t// at commit time). HandleTurnEnd replaces that with the complete session transcript\n2600\t// (from prompt to stop event), ensuring every checkpoint has the full context.\n2601\t//\n2602\t\n2603\tfunc (s *ManualCommitStrategy) HandleTurnEnd(ctx context.Context, state *SessionState) error { //nolint:unparam // error return is part of the hook contract; callers check it\n2604\t\thadMidTurnCommits := len(state.TurnCheckpointIDs) > 0\n2605\t\n2606\t\t// Finalize all checkpoints from this turn with the full transcript.\n2607\t\t//\n2608\t\t// IMPORTANT: This is best-effort - errors are logged but don't fail the hook.\n2609\t\t// Failing here would prevent session cleanup and could leave state inconsistent.\n2610\t\t// The provisional transcript from PostCommit is already persisted, so the\n2611\t\t// checkpoint isn't lost - it just won't have the complete transcript.\n2612\t\terrCount := s.finalizeAllTurnCheckpoints(ctx, state)\n2613\t\tif errCount > 0 {\n2614\t\t\tlogCtx := logging.WithComponent(ctx, \"checkpoint\")\n2615\t\t\tlogging.Warn(logCtx, \"HandleTurnEnd completed with errors (best-effort)\",\n2616\t\t\t\tslog.String(\"session_id\", state.SessionID),\n2617\t\t\t\tslog.Int(\"error_count\", errCount),\n2618\t\t\t)\n2619\t\t}\n2620\t\n2621\t\t// Advance CheckpointTranscriptStart to the actual transcript end after\n2622\t\t// mid-turn commits. When an agent commits mid-turn (e.g., Codex \"commit/push\"),\n2623\t\t// co