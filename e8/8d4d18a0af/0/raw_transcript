{\n40\t\t\treturn false, false, fmt.Errorf(\"failed to get HEAD: %w\", err)\n41\t\t}\n42\t\n43\t\tcurrentHead := head.Hash().String()\n44\t\tif state.BaseCommit == currentHead {\n45\t\t\treturn false, false, nil // No migration needed\n46\t\t}\n47\t\n48\t\t// Reconcile path: if HEAD sits on the exact commit carrying this session's\n49\t\t// LastCheckpointID, the user has reset back to the last condensed\n50\t\t// checkpoint. Update both BaseCommit and AttributionBaseCommit to HEAD.\n51\t\t// Deliberately do NOT rename or touch the old shadow branch — it\n52\t\t// preserves rewind data from the discarded segment of history.\n53\t\t//\n54\t\t// The SHA guard (currentHead == LastCheckpointCommitHash) distinguishes a\n55\t\t// true reset from a cherry-pick/rebase that merely preserved the trailer.\n56\t\t// Cherry-picking a checkpoint commit creates a new SHA with the same\n57\t\t// message; firing reconcile in that case would drop the pinned\n58\t\t// AttributionBaseCommit and corrupt attribution for uncondensed work.\n59\t\t// Legacy state files without LastCheckpointCommitHash fall back to\n60\t\t// trailer-only matching for backward compatibility.\n61\t\tif !state.LastCheckpointID.IsEmpty() {\n62\t\t\tshaMismatch := state.LastCheckpointCommitHash != \"\" && state.LastCheckpointCommitHash != currentHead\n63\t\t\tif shaMismatch {\n64\t\t\t\t// Trailer may still be present via cherry-pick/rebase, but the\n65\t\t\t\t// SHA doesn't match what we condensed into — fall through to migrate.\n66\t\t\t\tlogging.Debug(logging.WithComponent(ctx, \"migration\"), \"reconcile skipped: HEAD SHA does not match LastCheckpointCommitHash\",\n67\t\t\t\t\tslog.String(\"head\", currentHead[:7]),\n68\t\t\t\t\tslog.String(\"expected\", state.LastCheckpointCommitHash[:7]))\n69\t\t\t} else {\n70\t\t\t\theadCommit, commitErr := repo.CommitObject(head.Hash())\n71\t\t\t\tif commitErr == nil {\n72\t\t\t\t\tfor _, cpID := range trailers.ParseAllCheckpoints(headCommit.Message) {\n73\t\t\t\t\t\tif cp