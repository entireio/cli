r codexHookEventLabels = []struct {\n50\t\tdisplayName string\n51\t\tkeyLabel    string\n52\t}{\n53\t\t{\"PreToolUse\", \"pre_tool_use\"},\n54\t\t{\"PermissionRequest\", \"permission_request\"},\n55\t\t{\"PostToolUse\", \"post_tool_use\"},\n56\t\t{\"PreCompact\", \"pre_compact\"},\n57\t\t{\"PostCompact\", \"post_compact\"},\n58\t\t{\"SessionStart\", \"session_start\"},\n59\t\t{\"UserPromptSubmit\", \"user_prompt_submit\"},\n60\t\t{\"Stop\", \"stop\"},\n61\t}\n62\t\n63\t// codexHookTrustState reads .codex/hooks.json from projectDir and returns the\n64\t// `[hooks.state.<key>]` TOML block that pre-trusts every command handler\n65\t// declared there. The hash matches Codex's command_hook_hash exactly (see\n66\t// codex-rs/hooks/src/engine/discovery.rs and config/src/fingerprint.rs):\n67\t//\n68\t//  1. Build a NormalizedHookIdentity = { event_name, matcher, hooks: [normalized_handler] }\n69\t//  2. Serialize to JSON with object keys sorted alphabetically (canonical_json)\n70\t//  3. SHA-256 the compact JSON bytes; format as \"sha256:<hex>\"\n71\t//\n72\t// Returns empty string when no hooks file exists.\n73\tfunc codexHookTrustState(projectDir string) (string, error) {\n74\t\thooksPath := filepath.Join(projectDir, \".codex\", \"hooks.json\")\n75\t\tdata, err := os.ReadFile(hooksPath)\n76\t\tif err != nil {\n77\t\t\tif os.IsNotExist(err) {\n78\t\t\t\treturn \"\", nil\n79\t\t\t}\n80\t\t\treturn \"\", err\n81\t\t}\n82\t\n83\t\tvar file codexHookFile\n84\t\tif err := json.Unmarshal(data, &file); err != nil {\n85\t\t\treturn \"\", fmt.Errorf(\"parse hooks.json: %w\", err)\n86\t\t}\n87\t\n88\t\tvar sb strings.Builder\n89\t\tfor _, ev := range codexHookEventLabels {\n90\t\t\tgroups := codexEventGroups(&file.Hooks, ev.displayName)\n91\t\t\tfor groupIdx, group := range groups {\n92\t\t\t\tfor handlerIdx, handler := range group.Hooks {\n93\t\t\t\t\tif handler.Type != \"command\" {\n94\t\t\t\t\t\tcontinue\n95\t\t\t\t\t}\n96\t\t\t\t\ttimeoutSec := uint64(600)\n97\t\t\t\t\tif handler.Timeout != nil {\n98\t\t\t\t\t\ttimeoutSec = *handler.Timeout\n99\t\t\t\t\t}\n100\t\t\t\t\tif timeoutSec < 1 {\n101\t\t\t\t\t\ttimeoutSec = 1\n102\t\t\t\t\t}\n103\t\t\t\t\thash := codexCommandHookHash(ev.keyLabel, group.Matcher, handler.Command, timeoutSec, handler.Async, handler.StatusMessage)\n104\t\t\t\t\tkey := fmt.Sprintf(\"%s:%s:%d:%d\", hooksPath, ev.keyLabel, groupIdx, handlerIdx)\n105\t\t\t\t\tfmt.Fprintf(&sb, \"[hooks.state.%q]\\ntrusted_hash = %q\\n\\n\", key, hash)\n106\t\t\t\t}\n107\t\t\t}\n108\t\t}\n109\t\treturn sb.String(), nil\n110\t}\n111\t\n112\tfunc codexEventGroups(events *codexHookEvents, displayName string) []codexHookGroup {\n113\t\tswitch displayName {\n114\t\tcase \"PreToolUse\":\n115\t\t\treturn events.PreToolUse\n116\t\tcase \"PermissionRequest\":\n117\t\t\treturn events.PermissionRequest\n118\t\tcase \"PostToolUse\":\n119\t\t\treturn events.PostToolUse\n120\t\tcase \"PreCompact\":\n121\t\t\treturn events.PreCompact\n122\t\tcase \"PostCompact\":\n123\t\t\treturn events.PostCompact\n124\t\tcase \"SessionStart\":\n125\t\t\treturn events.SessionStart\n126\t\tcase \"UserPromptSubmit\":\n127\t\t\treturn events.UserPromptSubmit\n128\t\tcase \"Stop\":\n129\t\t\treturn events.Stop\n130\t\t}\n131\t\treturn nil\n132\t}\n133\t\n134\t// codexCommandHookHash mirrors command_hook_hash + version_for_toml. Codex\n135\t// builds a TOML value of NormalizedHookIdentity then serde_json::to_value\n136\t// converts it to JSON; we skip the TOML round-trip and emit the equivalent\n137\t// JSON directly. Crucially:\n138\t//   - matcher is omitted when nil (TOML can't represent null Options)\n139\t//   - timeout is always present (the normalized handler always sets Some(_))\n140\t//   - statusMessage is omitted when nil\n141\t//   - object keys are sorted alphabetically by canonicalize before hashing\n142\tfunc codexCommandHookHash(eventLabel string, matcher *string, command string, timeoutSec uint64, async bool, statusMessage *string) string {\n143\t\thandler := map[string]any{\n144\t\t\t\"type\":    \"command\",\n145\t\t\t\"command\": command,\n146\t\t\t\"timeout\": json.Number(strconv.FormatUint(timeoutSec, 10)),\n147\t\t\t\"async\":   async,\n148\t\t}\n149\t\tif statusMessage != nil {\n150\t\t\thandler[\"statusMessage\"] = *statusMessage\n151\t\t}\n152\t\tidentity := map[string]any{\n153\t\t\t\"event_name\": eventLabel,\n154\t\t\t\"hooks\":      []any{handler},\n155\t\t}\n156\t\tif matcher != nil {\n157\t\t\tidentity[\"matcher\"] = *matcher\n158\t\t}\n159\t\n160\t\tcanonical := codexCanonicalJSON(identity)\n161\t\tsum := sha256.Sum256(canonical)\n162\t\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n163\t}\n164\t\n165\t// codexCanonicalJSON marshals v with object keys sorted alphabetically, no\n166\t// whitespace. Go's encoding/json already sorts map[string]any keys, but we\n167\t// re-walk explicitly to make the contract obvious and to keep the output\n168\t// stable if a future stdlib change reorders.\n169\tfunc codexCanonicalJSON(v any) []byte {\n170\t\tvar buf strings.Builder\n171\t\tcodexWriteCanonical(&buf, v)\n172\t\treturn []byte(buf.String())\n173\t}\n174\t\n175\tfunc codexWriteCanonical(buf *strings.Builder, v any) {\n176\t\tswitch t := v.(type) {\n177\t\tcase map[string]any:\n178\t\t\tkeys := make([]string, 0, len(t))\n179\t\t\tfor k := range t {\n180\t\t\t\tkeys = append(keys, k)\n181\t\t\t}\n182\t\t\tsort.Strings(keys)\n183\t\t\tbuf.WriteByte('{')\n184\t\t\tfor i, k := range keys {\n185\t\t\t\tif i > 0 {\n186\t\t\t\t\tbuf.WriteByte(',')\n187\t\t\t\t}\n188\t\t\t\tbuf.Write(codexJSONAtom(k))\n189\t\t\t\tbuf.WriteByte(':')\n190\t\t\t\tcodexWriteCanonical(buf, t[k])\n191\t\t\t}\n192\t\t\tbuf.WriteByte('}')\n193\t\tcase []any:\n194\t\t\tbuf.WriteByte('[')\n195\t\t\tfor i, item := range t {\n196\t\t\t\tif i > 0 {\n197\t\t\t\t\tbuf.WriteByte(',')\n198\t\t\t\t}\n199\t\t\t\tcodexWriteCanonical(buf, item)\n200\t\t\t}\n201\t\t\tbuf.WriteByte(']')\n202\t\tdefault:\n203\t\t\tbuf.Write(codexJSONAtom(t))\n204\t\t}\n205\t}\n206\t\n207\t// codexJSONAtom marshals a scalar matching serde_json's default escaping\n208\t// rules: only the JSON-required characters (\", \\, control chars) are\n209\t// escaped — `<`, `>`, `&` pass through unchanged. Go's default json.Marshal\n210\t// HTML-escapes those bytes to \\u00XX, which would diverge from Codex's\n211\t// hash for any command containing shell redirection (>, &&, etc.).\n212\tfunc codexJSONAtom(v any) []byte {\n213\t\tvar b bytes.Buffer\n214\t\tenc := json.NewEncoder(&b)\n215\t\tenc.SetEscapeHTML(false)\n216\t\t_ = enc.Encode(v)\n217\t\tout := b.Bytes()\n218\t\tif n := len(out); n > 0 && out[n-1] == '\\n' {\n219\t\t\tout = out[:n-1]\n220\t\t}\n221\t\treturn out\n222\t}"},"type":"attachment","uuid":"c131e572-b4c9-4153-8283-5f0f849943c8","timestamp":"2026-05-08T12:14:54.828Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli","sessionId":"b1ed7d58-eb6b-498c-931f-1f6f207e13c3","version":"2.1.129","gitBranch":"soph/add-codex-post-tool"}
