(HEAD changed during session)\",\n148\t\t\tslog.String(\"from\", oldShadowBranch),\n149\t\t\tslog.String(\"to\", newShadowBranch))\n150\t\n151\t\t// Update state with new base commit.\n152\t\t// NOTE: AttributionBaseCommit is intentionally NOT updated here. Migration\n153\t\t// renames the shadow branch but its checkpoint trees are still relative to\n154\t\t// the original base. Attribution must diff from that original base to\n155\t\t// correctly measure agent work captured in those checkpoints.\n156\t\tstate.BaseCommit = newBaseCommit\n157\t\treturn true, nil\n158\t}"},"type":"attachment","uuid":"9cb8b665-570f-476e-a576-6caf8007fe29","timestamp":"2026-05-08T09:38:48.086Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli","sessionId":"b1ed7d58-eb6b-498c-931f-1f6f207e13c3","version":"2.1.129","gitBranch":"soph/add-codex-post-tool"}
