epo checks, enabled checks, logging, event parsing, and lifecycle dispatch.\n91\t// Used by both the registered subcommand path and the RunE fallback for external agents.\n92\t// When initLogging is true, it initializes and cleans up hook logging (used by the RunE fallback\n93\t// since it doesn't go through PersistentPreRunE). Built-in agent subcommands pass false since\n94\t// their parent command's PersistentPreRunE already handles logging.\n95\tfunc executeAgentHook(cmd *cobra.Command, agentName types.AgentName, hookName string, initLogging bool) error {\n96\t\t// Skip silently if not in a git repository - hooks shouldn't prevent the agent from working\n97\t\tif _, err := paths.WorktreeRoot(cmd.Context()); err != nil {\n98\t\t\treturn nil\n99\t\t}\n100\t\n101\t\t// Skip if Entire is not enabled\n102\t\tenabled, err := IsEnabled(cmd.Context())\n103\t\tif err == nil && !enabled {\n104\t\t\treturn nil\n105\t\t}\n106\t\n107\t\tif initLogging {\n108\t\t\tcleanup := initHookLogging(cmd.Context())\n109\t\t\tdefer cleanup()\n110\t\t}\n111\t\n112\t\t// Initialize logging context with agent name\n113\t\tctx := logging.WithAgent(logging.WithComponent(cmd.Context(), \"hooks\"), agentName)\n114\t\n115\t\t// Strategy name for logging\n116\t\tstrategyName := strategy.StrategyNameManualCommit\n117\t\n118\t\thookType := getHookType(hookName)\n119\t\n120\t\t// Start root perf span — child spans in lifecycle handlers and strategy\n121\t\t// methods will automatically nest under this span.\n122\t\tctx, span := perf.Start(ctx, hookName,\n123\t\t\tslog.String(\"hook_type\", hookType))\n124\t\tdefer span.End()\n125\t\n126\t\tlogging.Debug(ctx, \"hook invoked\",\n127\t\t\tslog.String(\"hook\", hookName),\n128\t\t\tslog.String(\"hook_type\", hookType),\n129\t\t\tslog.String(\"strategy\", strategyName),\n130\t\t)\n131\t\n132\t\t// Set the current hook agent so handlers can retrieve it\n133\t\tcurrentHookAgentName = agentName\n134\t\tdefer func() { currentHookAgentName = \"\" }()\n135\t\n