IfNeeded(ctx, repo, state); err != nil {\n60\t\t\tmigrateSpan.RecordError(err)\n61\t\t\tmigrateSpan.End()\n62\t\t\treturn err\n63\t\t}\n64\t\tmigrateSpan.End()\n65\t\n66\t\t// Get checkpoint store\n67\t\tstore, err := s.getCheckpointStore()\n68\t\tif err != nil {\n69\t\t\treturn fmt.Errorf(\"failed to get checkpoint store: %w\", err)\n70\t\t}\n71\t\n72\t\t// Check if shadow branch exists to report whether we created it\n73\t\tshadowBranchName := checkpoint.ShadowBranchNameForCommit(state.BaseCommit, state.WorktreeID)\n74\t\tbranchExisted := store.ShadowBranchExists(state.BaseCommit, state.WorktreeID)\n75\t\n76\t\t// Use the pending attribution calculated at prompt start (in InitializeSession)\n77\t\t// This was calculated BEFORE the agent made changes, so it accurately captures user edits\n78\t\tvar promptAttr PromptAttribution\n79\t\tif state.PendingPromptAttribution != nil {\n80\t\t\tpromptAttr = *state.PendingPromptAttribution\n81\t\t\tstate.PendingPromptAttribution = nil // Clear after use\n82\t\t} else {\n83\t\t\t// No pending attribution (e.g., first checkpoint or session initialized without it)\n84\t\t\tpromptAttr = PromptAttribution{CheckpointNumber: state.StepCount + 1}\n85\t\t}\n86\t\n87\t\t// Log the prompt attribution for debugging\n88\t\tattrLogCtx := logging.WithComponent(ctx, \"attribution\")\n89\t\tlogging.Debug(attrLogCtx, \"prompt attribution at checkpoint save\",\n90\t\t\tslog.Int(\"checkpoint_number\", promptAttr.CheckpointNumber),\n91\t\t\tslog.Int(\"user_added\", promptAttr.UserLinesAdded),\n92\t\t\tslog.Int(\"user_removed\", promptAttr.UserLinesRemoved),\n93\t\t\tslog.Int(\"agent_added\", promptAttr.AgentLinesAdded),\n94\t\t\tslog.Int(\"agent_removed\", promptAttr.AgentLinesRemoved),\n95\t\t\tslog.String(\"session_id\", sessionID))\n96\t\n97\t\t// Use WriteTemporary to create the checkpoint\n98\t\t_, writeCheckpointSpan := perf.Start(ctx, \"write_temporary_checkpoint\")\n99\t\tisFirstCheckpointOfSession := state.StepCount == 0\n100\t\tresult, 