lled()\n  })\n\n  it(\"scopes both queries to the requested repo at the SQL level\", async () => {\n    mockGetByUser.mockResolvedValue([makeCheckpoint()])\n    mockGetTeamOnUserRepos.mockResolvedValue([])\n\n    const res = await get(\"/?repo=org/app\")\n    expect(res.status).toBe(200)\n\n    expect(mockGetByUser).toHaveBeenCalledWith(\n      \"user-1\",\n      12345,\n      expect.any(String),\n      expect.any(String),\n      null,\n      \"org/app\",\n    )\n    expect(mockGetTeamOnUserRepos).toHaveBeenCalledWith(\n      \"user-1\",\n      12345,\n      expect.any(String),\n      expect.any(String),\n      null,\n      \"org/app\",\n    )\n  })\n\n  it(\"only caps recap aggregate queries when an explicit limit is supplied\", async () => {\n    const since = \"2026-04-20T00:00:00.000Z\"\n    const until = \"2026-04-21T00:00:00.000Z\"\n\n    await get(`/?repo=org/app&since=${since}&until=${until}`)\n    expect(mockGetByUser).toHaveBeenLastCalledWith(\"user-1\", 12345, since, until, null, \"org/app\")\n    expect(mockGetTeamOnUserRepos).toHaveBeenLastCalledWith(\n      \"user-1\",\n      12345,\n      since,\n      until,\n      null,\n      \"org/app\",\n    )\n\n    await get(`/?repo=org/app&since=${since}&until=${until}&limit=250`)\n    expect(mockGetByUser).toHaveBeenLastCalledWith(\"user-1\", 12345, since, until, 250, \"org/app\")\n    expect(mockGetTeamOnUserRepos).toHaveBeenLastCalledWith(\n      \"user-1\",\n      12345,\n      since,\n      until,\n      250,\n      \"org/app\",\n    )\n  })\n\n  it.each([\n    {\n      label: \"user has activity in the window\",\n      myCheckpoints: [makeCheckpoint({ commit_author_github_id: 12345 })],\n      // Two team authors plus the requesting user = 3.\n      expected: 3,\n    },\n    {\n      label: \"user has no activity in the window\",\n      myCheckpoints: [],\n      // Two team authors and the requesting user contributed nothing — they\n      // aren't a contributor in this window, so the +1 must drop to +0.