oidParser,\n  \"factoryai-droid\": droidParser,\n  droid: droidParser,\n  kiro: kiroParser,\n  opencode: opencodeParser,\n  \"open code\": opencodeParser,\n  \"open-code\": opencodeParser,\n  pi: piParser,\n}\n\nexport interface ParserOptions {\n  /** When true, try the shared transcript.jsonl parser before the agent-specific one. */\n  enableUnifiedTranscriptParser?: boolean\n}\n\n/**\n * Wraps an agent-specific parser so that transcript.jsonl content is handled\n * by the shared UnifiedTranscriptParser, falling back to the agent parser otherwise.\n */\nclass UnifiedTranscriptParserWithFallback implements TranscriptParser {\n  readonly name: string\n  readonly format: TranscriptParser[\"format\"]\n\n  constructor(private readonly agentParser: TranscriptParser) {\n    this.name = agentParser.name\n    this.format = agentParser.format\n  }\n\n  parse(content: string) {\n    if (isUnifiedTranscript(content)) return unifiedTranscriptParser.parse(content)\n    return this.agentParser.parse(content)\n  }\n\n  parseFrom(content: string, offset: number) {\n    if (isUnifiedTranscript(content)) return unifiedTranscriptParser.parseFrom(content, offset)\n    return this.agentParser.parseFrom?.(content, offset) ?? this.agentParser.parse(content)\n  }\n\n  strip(content: string): string {\n    if (isUnifiedTranscript(content)) return unifiedTranscriptParser.strip(content)\n    return this.agentParser.strip?.(content) ?? content\n  }\n\n  classifyTool(call: ToolCall): ToolMixCategoryKey {\n    return this.agentParser.classifyTool?.(call) ?? \"other\"\n  }\n\n  extractSkillFromTool(call: ToolCall): string | null {\n    return this.agentParser.extractSkillFromTool?.(call) ?? null\n  }\n\n  extractMcpServerFromTool(call: ToolCall): string | null {\n    return this.agentParser.extractMcpServerFromTool?.(call) ?? null\n  }\n}\n\n/**\n * Get the appropriate transcript parser for a given agent string.\n * Falls back to a generic parser for unknown agents.\n *\n * When `options.enableUn