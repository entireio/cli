eAnalysesInto(db, meByAgent, myCheckpoints),\n          mergeAnalysesInto(db, teamByAgent, teamCheckpoints),\n        ])\n      }\n\n      // Daily activity from the user's own checkpoints — powers the CLI\n      // activity strip. Computed here so CLI doesn't need a second call.\n      const daily = buildDailyActivity(myCheckpoints, startDate, endDate)\n\n      // Contributors summary is only meaningful for a scoped repo. Count\n      // distinct *authors* (commit_author_github_id) — counting commit_sha\n      // would conflate \"team has 50 commits this week\" with \"50 distinct\n      // contributors\", which is wrong. The +1 for distinctUsers counts the\n      // requesting user themselves, but only when they actually have at\n      // least one checkpoint in the window — otherwise they're not a\n      // contributor in this window and counting them would over-state the\n      // team size.\n      let contribSummary: {\n        distinctUsers: number\n        totalTokens: number\n        totalCheckpoints: number\n      } | null = null\n      if (repoParam) {\n        const teamAuthorIds = new Set<number>()\n        for (const cp of teamCheckpoints) {\n          if (typeof cp.commit_author_github_id === \"number\") {\n            teamAuthorIds.add(cp.commit_author_github_id)\n          }\n        }\n        contribSummary = {\n          distinctUsers: teamAuthorIds.size + (myCheckpoints.length > 0 ? 1 : 0),\n          totalTokens: sumTokens(myCheckpoints) + sumTokens(teamCheckpoints),\n          totalCheckpoints: myCheckpoints.length + teamCheckpoints.length,\n        }\n      }\n\n      // Assemble final per-agent map. Agents that appear on either side.\n      // Each agent's contributors field is null when ?repo= is absent\n      // (no team data was fetched), matching the top-level contributors null.\n      const allAgents = new Set<AgentId>([\n        ...(Object.keys(meByAgent) as AgentId[]),\n        ...(Object.keys(teamByAgent) as AgentId[]),\n      ])\n      const agents: Record<\n        string,\n        {\n          agentId: string\n          agentLabel: string\n          me: AgentAggregate\n          contributors: AgentAggregate | null\n        }\n      > = {}\n      for (const agentId of allAgents) {\n        agents[agentId] = {\n          agentId,\n          agentLabel: getAgentLabel(agentId),\n          me: meByAgent[agentId] ?? emptyAggregate(),\n          contributors: repoParam ? (teamByAgent[agentId] ?? null) : null,\n        }\n      }\n\n      const summary = {\n        me: summarizeAggregates(meByAgent),\n        team: repoParam ? summarizeAggregates(teamByAgent) : null,\n        repoCount: countRepos(myCheckpoints),\n        activeDays: daily.filter((day) => day.count > 0).length,\n        analysis: { complete: 0, pending: 0, failed: 0 },\n      }\n\n      return c.json({\n        timeframe: c.req.query(\"timeframe\") ?? \"last-6-months\",\n        repo: repoParam,\n        since,\n        until,\n        agents,\n        summary,\n        contributors: contribSummary,\n        daily,\n        updated_at: new Date().toISOString(),\n      })\n    } catch (err) {\n      console.error(\"Failed to build recap:\", err)\n      recordSpanError(err)\n      return c.json({ error: \"Failed to build recap\" }, 500)\n    }\n  },\n)\n\n// parseRecapWindow accepts either explicit `since`/`until` ISO8601 params\n// or falls back to the timeframe enum (last-month / last-3-months /\n// last-6-months). Explicit dates give the CLI precise control so its\n// --day / --week / --month ranges line up exactly with the server's\n// aggregation boundaries.\n//\n// Returns a discriminated union so partial / malformed / inverted ranges\n// surface as 400s instead of silently degrading to the default window —\n// a CLI fat-finger on `--since` should not return 6 months of data.\ntype RecapWindow =\n  | { ok: true; limit: number | null; startDate: Date; endDate: Date }\n  | { ok: false; error: string }\n\nfunction parseRecapWindow(c: Context<{ Bindings: Env; Variables: Variables }>): RecapWindow {\n  const sinceParam = c.req.query(\"since\")\n  const untilParam = c.req.query(\"until\")\n  if (sinceParam || untilParam) {\n    if (!sinceParam || !untilParam) {\n      return { ok: false, error: \"since and until must be provided together\" }\n    }\n    const startDate = new Date(sinceParam)\n    const endDate = new Date(untilParam)\n    if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime())) {\n      return { ok: false, error: \"since and until must be valid ISO-8601 dates\" }\n    }\n    if (startDate.getTime() > endDate.getTime()) {\n      return { ok: false, error: \"since must be on or before until\" }\n    }\n    const limit = parseRecapLimit(c.req.query(\"limit\"))\n    return { ok: true, limit, startDate, endDate }\n  }\n  const fallback = parseTimeframeParams(c)\n  return {\n    ok: true,\n    limit: parseRecapLimit(c.req.query(\"limit\")),\n    startDate: fallback.startDate,\n    endDate: fallback.endDate,\n  }\n}\n\nfunction parseRecapLimit(limitParam: string | undefined): number | null {\n  if (!limitParam) return null\n  const parsedLimit = parseInt(limitParam, 10)\n  if (Number.isNaN(parsedLimit) || parsedLimit <= 0) return null\n  return Math.min(parsedLimit, 1000)\n}\n\n// aggregateCheckpointsByAgent groups UserCheckpoint rows by their agent\n// field and sums checkpoint counts + tokens. Token sum uses input_tokens\n// + output_tokens from the checkpoint row directly — no analyses required.\nfunction aggregateCheckpointsByAgent(cps: UserCheckpoint[]): AgentAggregates {\n"}}
