in) =>\n      join.onRef(\"rc.repo_id\", \"=\", \"cc.repo_id\").onRef(\"rc.commit_sha\", \"=\", \"cc.commit_sha\"),\n    )\n    .innerJoin(\"repos\", \"repos.id\", \"cc.repo_id\")\n    .innerJoin(\"user_repos\", (join) =>\n      join.onRef(\"user_repos.repo_id\", \"=\", \"cc.repo_id\").on(\"user_repos.user_id\", \"=\", userId),\n    )\n    .leftJoin(\"repo_branch_commits as bc\", (join) =>\n      join.onRef(\"bc.repo_id\", \"=\", \"cc.repo_id\").onRef(\"bc.commit_sha\", \"=\", \"cc.commit_sha\"),\n    )\n    .where(\"rc.commit_author_github_id\", \"=\", githubId)\n    .where(\"cp.created_at\", \">=\", new Date(startDate))\n    .where(\"cp.created_at\", \"<\", new Date(endDate))\n  if (repoFullName) {\n    rankedBuilder = rankedBuilder.where(\"repos.full_name\", \"=\", repoFullName)\n  }\n  const ranked = rankedBuilder\n    .select([\n      \"cc.repo_id\",\n      \"cc.checkpoint_id\",\n      \"cc.commit_sha\",\n      sql<string>`COALESCE(bc.branch, cc.branch)`.as(\"branch\"),\n      \"cp.created_at\",\n      sql<number>`ROW_NUMBER() OVER (\n        PARTITION BY cc.repo_id, cc.checkpoint_id\n        ORDER BY\n          CASE WHEN COALESCE(bc.branch, cc.branch) = repos.default_branch THEN 0 ELSE 1 END,\n          CASE COALESCE(bc.branch, cc.branch) WHEN 'main' THEN 0 WHEN 'master' THEN 1 ELSE 2 END,\n          COALESCE(bc.branch, cc.branch)\n      )`.as(\"rn\"),\n    ])\n    .as(\"ranked\")\n\n  let commitsQuery = db\n    .selectFrom(ranked)\n    .innerJoin(\"repo_commits as rc\", (join) =>\n      join\n        .onRef(\"rc.repo_id\", \"=\", \"ranked.repo_id\")\n        .onRef(\"rc.commit_sha\", \"=\", \"ranked.commit_sha\"),\n    )\n    .innerJoin(\"repos\", \"repos.id\", \"ranked.repo_id\")\n    .leftJoin(\"repo_checkpoints as cp\", (join) =>\n      join\n        .onRef(\"cp.repo_id\", \"=\", \"ranked.repo_id\")\n        .onRef(\"cp.checkpoint_id\", \"=\", \"ranked.checkpoint_id\"),\n    )\n    .select([\n      \"ranked.checkpoint_id\",\n      \"ranked.branch\",\n      \"rc.commit_sha\",\n      \"rc.commit_message\",\n      \"rc.commit_date\",\n      \"rc.commit_author_github_id\",\n      \"rc.additions\",\n      \"rc.deletions\",\n      \"rc.files_changed\",\n      \"ranked.repo_id\",\n      \"repos.full_name as repo_full_name\",\n      \"repos.default_branch\",\n      \"repos.is_private\",\n      \"cp.agent\",\n      \"cp.steps\",\n      \"cp.session_count\",\n      \"cp.session_ids\",\n      \"cp.input_tokens\",\n      \"cp.output_tokens\",\n    ])\n    .where(\"ranked.rn\", \"=\", 1)\n    .orderBy(\"rc.commit_date\", \"desc\")\n\n  if (effectiveLimit !== null) {\n    commitsQuery = commitsQuery.limit(effectiveLimit)\n  }\n\n  const commits = await commitsQuery.execute()\n\n  return commits.map((commit) => ({\n    checkpoint_id: commit.checkpoint_id,\n    commit_sha: commit.commit_sha,\n    commit_message: commit.commit_message,\n    commit_date: dateToStr(commit.commit_date),\n    commit_author_github_id: commit.commit_author_github_id ?? null,\n    additions: commit.additions ?? 0,\n    deletions: commit.deletions ?? 0,\n    files_changed: commit.files_changed ?? 0,\n    repo_id: commit.repo_id ?? \"\",\n    repo_full_name: commit.repo_full_name ?? \"\",\n    branch: commit.branch,\n    is_private: toBool(commit.is_private),\n    agent: commit.agent ?? null,\n    steps: commit.steps ?? null,\n    session_count: commit.session_count ?? null,\n    session_ids: parseStringArray(commit.session_ids),\n    input_tokens: commit.input_tokens ?? null,\n    output_tokens: commit.output_tokens ?? null,\n  }))\n"}}
