   212→\n   213→\t// Create .entire directory but no current_session file\n   214→\tif err := os.MkdirAll(\".entire\", 0o750); err != nil {\n   215→\t\tt.Fatalf(\"failed to create .entire dir: %v\", err)\n   216→\t}\n   217→\n   218→\tvar stdout bytes.Buffer\n   219→\terr := runExplainDefault(&stdout, false)\n   220→\n   221→\tif err == nil {\n   222→\t\tt.Error(\"expected error when no current session, got nil\")\n   223→\t}\n   224→\t// Case-insensitive check for \"no active session\"\n   225→\terrLower := strings.ToLower(err.Error())\n   226→\tif !strings.Contains(errLower, \"no active session\") {\n   227→\t\tt.Errorf(\"expected 'no active session' in error, got: %v\", err)\n   228→\t}\n   229→}\n   230→\n   231→func TestExplainBothFlagsError(t *testing.T) {\n   232→\t// Test that providing both --session and --commit returns an error\n   233→\tvar stdout bytes.Buffer\n   234→\terr := runExplain(&stdout, \"session-id\", \"commit-sha\", \"\", false, false, false)\n   235→\n   236→\tif err == nil {\n   237→\t\tt.Error(\"expected error when both flags provided, got nil\")\n   238→\t}\n   239→\t// Case-insensitive check for \"cannot specify multiple\"\n   240→\terrLower := strings.ToLower(err.Error())\n   241→\tif !strings.Contains(errLower, \"cannot specify multiple\") {\n   242→\t\tt.Errorf(\"expected 'cannot specify multiple' in error, got: %v\", err)\n   243→\t}\n   244→}\n   245→\n   246→func TestFormatSessionInfo(t *testing.T) {\n   247→\tnow := time.Now()\n   248→\tsession := &strategy.Session{\n   249→\t\tID:          \"2025-12-09-test-session-abc\",\n   250→\t\tDescription: \"Test description\",\n   251→\t\tStrategy:    \"manual-commit\",\n   252→\t\tStartTime:   now,\n   253→\t\tCheckpoints: []strategy.Checkpoint{\n   254→\t\t\t{\n   255→\t\t\t\tCheckpointID: \"abc1234567890\",\n   256→\t\t\t\tMessage:      \"First checkpoint\",\n   257→\t\t\t\tTimestamp:    now.Add(-time.Hour),\n   258→\t\t\t},\n   259→\t\t\t{\n   260→\t\t\t\tCheckpointID: \"def0987654321