review; /review must not appear, and the\n      // legacy paraphrase must not appear either.\n      if strings.Contains(prompt, \"/review\") {\n          t.Fatalf(\"stdin prompt must not contain /review (subcommand handles it):\\n%s\", prompt)\n      }\n      if strings.Contains(prompt, \"Review the current branch changes\") {\n          t.Fatalf(\"stdin prompt must not contain stale paraphrase:\\n%s\", prompt)\n      }\n\n      // The explicit Scope clause is carried by --base/--uncommitted flags now.\n      if strings.Contains(prompt, \"Scope:\") {\n          t.Fatalf(\"stdin prompt must not contain explicit Scope clause:\\n%s\", prompt)\n      }\n\n      // The remaining context (always-prompt, checkpoint context) must be\n      // preserved end-to-end.\n      for _, wantText := range []string{\n          \"Focus on auth regressions.\",\n          \"Commits in scope (newest first):\",\n          \"abc123 summary\",\n      } {\n          if !strings.Contains(prompt, wantText) {\n              t.Fatalf(\"stdin prompt missing %q:\\n%s\", wantText, prompt)\n          }\n      }\n  }\n  ```\n\n- [ ] **Step 3: Run the updated tests; verify they fail**\n\n  Run: `go test ./cmd/entire/cli/agent/codex/ -run \"TestCodexReviewer_ArgvShape|TestCodexReviewer_StdinPromptDropsReviewAndScope\" -v`\n  Expected: FAIL — argv is still old shape, prompt still contains paraphrase\n\n- [ ] **Step 4: Update `buildCodexReviewCmd` to produce the new shape**\n\n  In `cmd/entire/cli/agent/codex/reviewer.go`, replace `buildCodexReviewCmd` (lines 30-41) and the surrounding doc comment (lines 16-28) with:\n\n  ```go\n  // NewReviewer returns the AgentReviewer for codex.\n  //\n  // Argv shape: codex exec review [--base <ref>] --uncommitted --json\n  // --skip-git-repo-check -. Custom review instructions (entire's composed\n  // prompt minus /review and the explicit scope clause) are piped via stdin.\n  // Scope is carried by --base / --uncommitted flags.\n  //\n  // Requires codex CLI >= 0.130.0 — older versions of `codex exec review`\n  // did not accept a [PROMPT] argument.\n  func NewReviewer() *reviewtypes.ReviewerTemplate {\n      return &reviewtypes.ReviewerTemplate{\n          AgentName: \"codex\",\n          BuildCmd:  buildCodexReviewCmd,\n          Parser:    parseCodexOutput,\n      }\n  }\n\n  // buildCodexReviewCmd builds the exec.Cmd for a codex review run via codex's\n  // native `exec review` subcommand. Exposed at package level for test\n  // inspection of argv, stdin, and env.\n  func buildCodexReviewCmd(ctx context.Context, cfg reviewtypes.RunConfig) *exec.Cmd {\n      args := []string{codexExecCommand, \"review\"}\n      if cfg.ScopeBaseRef != \"\" {\n          args = append(args, \"--base\", cfg.ScopeBaseRef)\n      }\n      args = append(args, \"--uncommitted\", \"--json\", \"--skip-git-repo-check\", \"-\")\n\n      prompt := composeNativeReviewPrompt(cfg)\n      cmd := exec.CommandContext(ctx, \"codex\", args...)\n      cmd.Stdin = strings.NewReader(prompt)\n      cmd.Env = review.AppendReviewEnv(os.Environ(), \"codex\", cfg, prompt)\n      return cmd\n  }\n\n  const codexExecCommand = \"exec\"\n  ```\n\n  Also: remove the now-unused `review.ComposeReviewPrompt` import path if no longer referenced (Go will surface this as a build error). The `review` package is still used for `review.AppendReviewEnv`, so the import stays — just the `ComposeReviewPrompt` reference goes away.\n\n- [ ] **Step 5: Run tests; verify they now pass**\n\n  Run: `go test ./cmd/entire/cli/agent/codex/ -run \"TestCodexReviewer_ArgvShape|TestCodexReviewer_StdinPromptDropsReviewAndScope|TestComposeNativeReviewPrompt\" -v`\n  Expected: PASS for all four new/updated cases.\n\n---\n\n## Task 3: Delete obsolete paraphrase code\n\n`expandCodexBuiltinReview` and `codexBuiltinReviewPrompt` are now unreachable.\n\n**Files:**\n- Modify: `cmd/entire/cli/agent/codex/reviewer.go` (delete lines 43-61, the const + function)\n\n- [ ] **Step 1: Delete the constants and helper**