\n   121\t\t\t\tcpID, freshLookup, commitErr := resolveCheckpointFromCommitRef(ctx, errW, opts.target)\n   122\t\t\t\tif commitErr == nil {\n   123\t\t\t\t\treturn cpID, freshLookup, nil\n   124\t\t\t\t}\n   125\t\t\t}\n   126\t\t\treturn id.CheckpointID(\"\"), lookup, fmt.Errorf(\"%w: %s\", checkpoint.ErrCheckpointNotFound, prefix)\n   127\t\tdefault:\n   128\t\t\treturn id.CheckpointID(\"\"), lookup, fmt.Errorf(\"%w: %s matches %d checkpoints\", errAmbiguousCommitPrefix, prefix, len(matches))\n   129\t\t}\n   130\t}\n   131\t\n   132\t// resolveCheckpointFromCommitRef opens the repo, resolves a git commit-ish,\n   133\t// and extracts the Entire-Checkpoint trailer. If the resolved checkpoint\n   134\t// isn't present in the local committed list, retries once after fetching\n   135\t// metadata from the remote — symmetry with the prefix path so\n   136\t// `--commit <sha>` and `--checkpoint <prefix>` share the same fetch\n   137\t// behavior.\n   138\tfunc resolveCheckpointFromCommitRef(ctx context.Context, errW io.Writer, commitRef string) (id.CheckpointID, *explainCheckpointLookup, error) {\n   139\t\trepo, err := openRepository(ctx)\n   140\t\tif err != nil {\n   141\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"not a git repository: %w\", err)\n   142\t\t}\n   143\t\thash, _, err := resolveCommitUnambiguous(repo, commitRef)\n   144\t\tif err != nil {\n   145\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"commit not found: %s: %w\", commitRef, err)\n   146\t\t}\n   147\t\tcommit, err := repo.CommitObject(hash)\n   148\t\tif err != nil {\n   149\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"failed to read commit: %w\", err)\n   150\t\t}\n   151\t\tcpID, found := trailers.ParseCheckpoint(commit.Message)\n   152\t\tif !found {\n   153\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"commit %s has no Entire-Checkpoint trailer\", commit.Hash)\n   154\t\t}\n   155\t\tlookup, lookupErr := newExplainCheckpointLookup(ctx)\n   156\t\tif lookupErr !