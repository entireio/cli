v2Err == nil {\n   197\t\t\t\tv2OK = true\n   198\t\t\t}\n   199\t\t}\n   200\t\tstop(false)\n   201\t\tif v1Err != nil && !v2OK {\n   202\t\t\treturn nil, lookup\n   203\t\t}\n   204\t\tfresh, freshErr := newExplainCheckpointLookup(ctx)\n   205\t\tif freshErr != nil {\n   206\t\t\treturn nil, lookup\n   207\t\t}\n   208\t\treturn matchCheckpointPrefix(fresh, prefix), fresh\n   209\t}\n   210\t\n   211\tfunc matchCheckpointPrefix(lookup *explainCheckpointLookup, prefix string) []id.CheckpointID {\n   212\t\tvar matches []id.CheckpointID\n   213\t\tfor _, info := range lookup.committed {\n   214\t\t\tif strings.HasPrefix(info.CheckpointID.String(), prefix) {\n   215\t\t\t\tmatches = append(matches, info.CheckpointID)\n   216\t\t\t}\n   217\t\t}\n   218\t\treturn matches\n   219\t}\n   220\t\n   221\t// errCheckpointHasNoSessions distinguishes \"this checkpoint has zero sessions\"\n   222\t// from checkpoint.ErrCheckpointNotFound — callers using errors.Is on the\n   223\t// not-found sentinel were getting wrong-fault UX (e.g. \"did you mistype the\n   224\t// ID?\") for a legitimate empty-checkpoint edge case.\n   225\tvar errCheckpointHasNoSessions = errors.New(\"checkpoint has no sessions\")\n   226\t\n   227\t// resolveSessionIndex maps the user's --session-index value (or the implicit\n   228\t// default) onto a valid 0-based offset within summary.Sessions.\n   229\tfunc resolveSessionIndex(summary *checkpoint.CheckpointSummary, requested int) (int, error) {\n   230\t\tif summary == nil {\n   231\t\t\treturn 0, checkpoint.ErrCheckpointNotFound\n   232\t\t}\n   233\t\tif len(summary.Sessions) == 0 {\n   234\t\t\treturn 0, errCheckpointHasNoSessions\n   235\t\t}\n   236\t\tif requested < 0 {\n   237\t\t\treturn len(summary.Sessions) - 1, nil\n   238\t\t}\n   239\t\tif requested >= len(summary.Sessions) {\n   240\t\t\treturn 0, fmt.Errorf(\"session index %d out of range (checkpoint has %d sessions)\", requested, len(summary.Sessions))\n   241\t\t}\n   242\t\treturn requested, nil\n   243\t}\n   244\t\n   245\t// runExplainStreamTranscript streams either the compact transcript (default)\n   246\t// or the raw transcript (when --raw-transcript is set) for the selected\n   247\t// session of the resolved checkpoint. When --transcript is used on a\n   248\t// v1-only checkpoint (compact transcripts are a v2-only artifact), falls\n   249\t// through to the raw transcript with a one-line stderr note rather than\n   250\t// erroring — the consumer's stated intent is \"give me transcript bytes\",\n   251\t// and we have a way to satisfy it without making them re-run.\n   252\tfunc runExplainStreamTranscript(ctx context.Context, w, errW io.Writer, opts explainExportOptions) error {\n   253\t\tcpID, lookup, err := resolveExplainCheckpointID(ctx, errW, opts)\n   254\t\tif err != nil {\n   255\t\t\treturn err\n   256\t\t}\n   257\t\n   258\t\treader, summary, err := checkpoint.ResolveCommittedReaderForCheckpoint(ctx, cpID, lookup.v1Store, lookup.v2Store, lookup.preferCheckpointsV2)\n   259\t\tif err != nil {\n   260\t\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n"}}
