t// Hidden from `entire help` while the feature is still maturing —\n   107\t\t\t// users who know about it can still run `entire review` / `entire\n   108\t\t\t// review --help` and the command works normally.\n   109\t\t\tHidden: true,\n   110\t\t\tShort:  \"Run configured review skills against the current branch\",\n   111\t\t\tLong: `Run the review skills configured in .entire/settings.json against\n   112\tthe current branch. On first run, an interactive picker writes the config.\n   113\t\n   114\tLabs entry: review is experimental. We are actively refining it based on user\n   115\tfeedback.\n   116\t\n   117\tThe review session is recorded as part of the next checkpoint, so the\n   118\treview metadata is permanently attached to the commit it covers.\n   119\t\n   120\tFlags:\n   121\t  --edit         re-open the review config picker\n   122\t  --findings     browse local review findings\n   123\t  --fix          apply review findings in a normal agent session\n   124\t  --all          with --fix, apply all sources/findings without selectors\n   125\t  --agent NAME   select a specific configured agent when more than one is\n   126\t                 configured (default: alphabetically first)\n   127\t\n   128\tSubcommands:\n   129\t  attach <id>    tag an existing session as a review (equivalent to\n   130\t                 'entire attach --review <id>')`,\n   131\t\t\tArgs: func(_ *cobra.Command, args []string) error {\n   132\t\t\t\tif len(args) > 1 {\n   133\t\t\t\t\treturn fmt.Errorf(\"accepts at most one review session id, received %d\", len(args))\n   134\t\t\t\t}\n   135\t\t\t\tif len(args) == 1 && !fix {\n   136\t\t\t\t\treturn errors.New(\"review session id is only valid with --fix\")\n   137\t\t\t\t}\n   138\t\t\t\treturn nil\n   139\t\t\t},\n   140\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n   141\t\t\t\tctx := cmd.Context()\n   142\t\t\t\t// Discover external agents so review configs that target them\n   143\t\t\t\t// resolve correctly — without this, GetAgentsWithHooksInstalled\n   144\t\t\t\t// and agent.Get can't see them.\n   145\t\t\t\texternal.DiscoverAndRegister(ctx)\n   146\t\n   147\t\t\t\tif all && !fix {\n   148\t\t\t\t\treturn errors.New(\"--all requires --fix\")\n   149\t\t\t\t}\n   150\t\t\t\tmodes := 0\n   151\t\t\t\tfor _, enabled := range []bool{edit, findings, fix} {\n   152\t\t\t\t\tif enabled {\n   153\t\t\t\t\t\tmodes++\n   154\t\t\t\t\t}\n   155\t\t\t\t}\n   156\t\t\t\tif modes > 1 {\n   157\t\t\t\t\treturn errors.New(\"--edit, --findings, and --fix are mutually exclusive\")\n   158\t\t\t\t}\n   159\t\t\t\tif edit {\n   160\t\t\t\t\t_, err := RunReviewConfigPicker(ctx, cmd.OutOrStdout(), deps.GetAgentsWithHooksInstalled)\n   161\t\t\t\t\treturn err\n   162\t\t\t\t}\n   163\t\t\t\tif findings {\n   164\t\t\t\t\treturn runReviewFindings(ctx, cmd, deps.NewSilentError)\n   165\t\t\t\t}\n   166\t\t\t\tif fix {\n   167\t\t\t\t\ttarget := \"\"\n   168\t\t\t\t\tif len(args) == 1 {\n   169\t\t\t\t\t\ttarget = args[0]\n   170\t\t\t\t\t}\n   171\t\t\t\t\treturn runReviewFix(ctx, cmd, target, all, agentOverride, deps.NewSilentError)\n   172\t\t\t\t}\n   173\t\t\t\tinnerDeps := runReviewDeps{\n   174\t\t\t\t\tpromptForAgentFn: deps.PromptForAgentFn,\n   175\t\t\t\t\tmultiPickerFn:    deps.MultiPickerFn,\n   176\t\t\t\t}\n   177\t\t\t\treturn runReview(ctx, cmd, agentOverride, deps, innerDeps)\n   178\t\t\t},\n   179\t\t}\n   180\t\tcmd.Flags().BoolVar(&edit, \"edit\", false, \"re-open the review config picker\")\n   181\t\tcmd.Flags().BoolVar(&findings, \"findings\", false, \"browse local review findings\")\n   182\t\tcmd.Flags().BoolVar(&fix, \"fix\", false, \"apply review findings in a normal agent session\")\n   183\t\tcmd.Flags().BoolVar(&all, \"all\", false, \"with --fix, apply all sources/findings without selectors\")\n   184\t\tcmd.Flags().StringVar(&agentOverride, \"agent\", \"\", \"select a specific configured agent (default: alphabetically first)\")\n   185\t\tif deps.AttachCmd != nil {\n   186\t\t\tcmd.AddCommand(deps.AttachCmd)\n   187\t\t}\n   188\t\treturn cmd\n   189\t}\n   190\t\n   191\t// runReview executes the main review flow.\n   192\tfunc runReview(ctx context.Context, cmd *cobra.Command, agentOverride string, deps Deps, innerDeps runReviewDeps) error {\n   193\t\tout := cmd.OutOrStdout()\n   194\t\tsilentErr := deps.NewSilentError\n   195\t\n   196\t\t// 1. Pre-flight: must be in a git repo.\n   197\t\tif _, err := paths.WorktreeRoot(ctx); err != nil {\n   198\t\t\tcmd.SilenceUsage = true\n   199\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Run `entire enable` first.\")\n   200\t\t\treturn silentErr(errors.New(\"not a git repository\"))\n   201\t\t}\n   202\t\n   203\t\t// 2. Load config. A load error means the settings file exists but is\n   204\t\t// malformed (Load returns a default-filled object when the file is\n   205\t\t// missing). Surface the error instead of silently opening the picker,\n   206\t\t// which would cause SaveReviewConfig to write over the user's other\n   207\t\t// settings with an empty EntireSettings{}.\n   208\t\ts, err := settings.Load(ctx)\n   209\t\tif err != nil {\n   210\t\t\tcmd.SilenceUsage = true\n   211\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Failed to load settings: %v\\n\", err)\n   212\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Fix `.entire/settings.json` and re-run `entire review`.\")\n   213\t\t\treturn silentErr(err)\n   214\t\t}\n   215\t\tif s == nil || len(s.Review) == 0 {\n   216\t\t\tif !ConfirmFirstRunSetup(ctx, out) {\n   217\t\t\t\treturn nil\n   218\t\t\t}\n   219\t\t\tpicked, pickErr := RunReviewConfigPicker(ctx, out, deps.GetAgentsWithHooksInstalled)\n   220\t\t\tif pickErr != nil {\n   221\t\t\t\treturn pickErr\n   222\t\t\t}\n   223\t\t\tif s == nil {\n   224\t\t\t\ts = &settings.EntireSettings{}\n   225\t\t\t}\n   226\t\t\ts.Review = picked\n   227\t\t\tfmt.Fprintln(out)\n   228\t\t\tfmt.Fprintln(out, \"Setup complete — running review now.\")\n   229\t\t}\n   230\t\n   231\t\t// 3. Resolve installed agents and determine the dispatch path.\n   232\t\t//\n   233\t\t// Three paths:\n   234\t\t//   - Multi-agent: 2+ launchable eligible agents AND no --agent override →\n   235\t\t//     show multi-select picker then RunMulti. Steps 3.5, 3.6, and the\n   236\t\t//     single-agent skill-verify guard are skipped; each reviewer pulls\n   237\t\t//     its own skills from settings at spawn time via RunConfig.\n   238\t\t//   - Single-agent (default): 1 or fewer launchable eligible agents, OR\n   239\t\t//     --agent override set. Falls through to the full agent-selection and\n   240\t\t//     validation path below (steps 3–3.6).\n   241\t\tinstalled := deps.GetAgentsWithHooksInstalled(ctx)\n   242\t\tif agentOverride == \"\" {\n   243\t\t\tlaunchableEligible := computeLaunchableEligible(s, installed, deps.ReviewerFor)\n   244\t\t\tif len(launchableEligible) >= 2 {\n   245\t\t\t\treturn runMultiAgentPath(ctx, cmd, launchableEligible, s, innerDeps, deps, out)\n   246\t\t\t}\n   247\t\t}\n   248\t\n   249\t\t// Single-agent path: pick agent, verify hooks + skills, scope, run.\n   250\t\n   251\t\t// 3a. Base selection on the eligible set (configured AND installed):\n   252\t\t//   - 0 eligible: fall through; SelectReviewAgent below errors with the\n   253\t\t//     full configured map (clearer \"no installed agent\" diagnostic than\n   254\t\t//     a silent fail).\n   255\t\t//   - 1 eligible: use it directly. This matters when the alphabetically-\n   256\t\t//     first configured agent isn't installed but exactly one other is —\n   257\t\t//     without this, SelectReviewAgent would default to the alphabetical\n   258\t\t//     first and the verify-hooks check below would error needlessly.\n   259\t\t//   - 2+ eligible: prompt with single-select (non-launchable agents reach\n   260\t\t//     this branch since computeLaunchableEligible filtered them out above).\n   261\t\tif agentOverride == \"\" {\n   262\t\t\teligible := ComputeEligibleConfigured(s, installed)\n   263\t\t\tswitch {\n   264\t\t\tcase len(eligible) == 1:\n   265\t\t\t\tagentOverride = eligible[0].Name\n   266\t\t\tcase len(eligible) > 1:\n   267\t\t\t\tfn := innerDeps.promptForAgentFn\n   268\t\t\t\tif fn == nil {\n   269\t\t\t\t\tfn = PromptForAgent\n   270\t\t\t\t}\n   271\t\t\t\tpicked, pickErr := fn(ctx, eligible)\n   272\t\t\t\tif pickErr != nil {\n   273\t\t\t\t\tcmd.SilenceUsage = true\n   274\t\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), pickErr.Error())\n   275\t\t\t\t\treturn silentErr(pickErr)\n   276\t\t\t\t}\n   277\t\t\t\tif picked == \"\" {\n   278\t\t\t\t\t// Defensive: empty picker return must not fall through to\n   279\t\t\t\t\t// alphabetical-first default.\n   280\t\t\t\t\tcmd.SilenceUsage = true\n   281\t\t\t\t\temptyErr := errors.New(\"agent picker returned empty agent name\")\n   282\t\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), emptyErr.Error())\n   283\t\t\t\t\treturn silentErr(emptyErr)\n   284\t\t\t\t}\n   285\t\t\t\tagentOverride = picked\n   286\t\t\t}\n   287\t\t}\n   288\t\n   289\t\tagentName, cfg, err := SelectReviewAgent(s.Review, agentOverride)\n   290\t\tif err != nil {\n   291\t\t\tcmd.SilenceUsage = true\n   292\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n   293\t\t\treturn silentErr(err)\n   294\t\t}\n   295\t\n   296\t\treturn runSingleAgentPath(ctx, cmd, agentName, cfg, installed, deps, out)\n   297\t}\n   298\t\n   299\t// runSingleAgentPath completes a single-agent review: verifies hooks + skills,\n   300\t// guards against re-review, resolves scope, then dispatches via Run or\n   301\t// RunMarkerFallback.\n   302\tfunc runSingleAgentPath(\n   303\t\tctx context.Context,\n   304\t\tcmd *cobra.Command,\n   305\t\tagentName string,\n   306\t\tcfg settings.ReviewConfig,\n   307\t\tinstalled []types.AgentName,\n   308\t\tdeps Deps,\n   309\t\tout io.Writer,\n   310\t) error {\n   311\t\tsilentErr := deps.NewSilentError\n   312\t\n   313\t\t// 3.5. Verify hooks are installed for the selected agent.\n   314\t\tfound := false\n   315\t\tfor _, n := range installed {\n   316\t\t\tif string(n) == agentName {\n   317\t\t\t\tfound = true\n   318\t\t\t\tbreak\n   319\t\t\t}\n   320\t\t}\n   321\t\tif !found {\n   322\t\t\tcmd.SilenceUsage = true\n   323\t\t\tfmt.Fprintf(cmd.ErrOrStderr(),\n   324\t\t\t\t\"Hooks are not installed for %q. Run `entire configure --agent %s` first, \"+\n   325\t\t\t\t\t\"or remove %q from review settings.\\n\",\n   326\t\t\t\tagentName, agentName, agentName)\n   327\t\t\treturn silentErr(fmt.Errorf(\"hooks not installed for %s\", agentName))\n   328\t\t}\n   329\t\n   330\t\t// 3.6. Verify configured skills are actually installed on disk.\n   331\t\tag, agErr := agent.Get(types.AgentName(agentName))\n   332\t\tif agErr != nil {\n   333\t\t\treturn fmt.Errorf(\"resolve agent %s: %w\", agentName, agErr)\n   334\t\t}\n   335\t\tif err := VerifyConfiguredSkillsInstalled(ctx, ag, cfg); err != nil {\n   336\t\t\tcmd.SilenceUsage = true\n   337\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n   338\t\t\treturn silentErr(err)\n   339\t\t}\n   340\t\n   341\t\t// 4. Re-run guard: check if HEAD's checkpoint already has a review.\n   342\t\tif reviewed, meta := deps.HeadHasReviewCheckpoint(ctx); reviewed {\n   343\t\t\tvar proceed bool\n   344\t\t\tform := newAccessibleForm(huh.NewGroup(\n   345\t\t\t\thuh.NewConfirm().\n   346\t\t\t\t\tTitle(fmt.Sprintf(\"Already reviewed: %s. Proceed anyway?\", meta)).\n   347\t\t\t\t\tValue(&proceed),\n   348\t\t\t))\n   349\t\t\tif err := form.RunWithContext(ctx); err != nil {\n   350\t\t\t\tfmt.Fprintln(out, \"prompt cancelled\")\n   351\t\t\t\treturn err //nolint:wrapcheck // propagate huh cancellation\n   352\t\t\t}\n   353\t\t\tif !proceed {\n   354\t\t\t\tfmt.Fprintln(out, \"Review cancelled.\")\n   355\t\t\t\treturn nil\n   356\t\t\t}\n   357\t\t}\n   358\t\n   359\t\t// 5. Resolve HEAD SHA and worktree root.\n   360\t\tworktreeRoot, err := paths.WorktreeRoot(ctx)\n"}}
{"timestamp":"2026-05-08T14:17:43.931Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_GfqFDDRoyECp8CDBWmokURxR","output":"Chunk ID: 40bc82\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 2968\nOutput:\n     1\t// Package review — see env.go for package-level rationale.\n     2\t//\n     3\t// picker.go implements the interactive review skills picker and agent selection\n     4\t// helpers. pickConfig presents a huh multi-select per installed agent and saves\n     5\t// the selection to .entire/settings.json.\n     6\tpackage review\n     7\t\n     8\timport (\n     9\t\t\"context\"\n    10\t\t\"errors\"\n    11\t\t\"fmt\"\n    12\t\t\"io\"\n    13\t\t\"log/slog\"\n    14\t\t\"os\"\n    15\t\t\"sort\"\n    16\t\t\"strings\"\n    17\t\n    18\t\t\"charm.land/huh/v2\"\n    19\t\n    20\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n    21\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/skilldiscovery\"\n    22\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n    23\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n    24\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n    25\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n    26\t)\n    27\t\n    28\t// AgentChoice is one row in the spawn-time picker. Name is the agent\n    29\t// registry key (used for marker/override); Label is the picker-visible\n    30\t// string (\"<name>   (N skills configured)\" or \"<name>   (prompt-only)\").\n    31\ttype AgentChoice struct {\n    32\t\tName  string\n    33\t\tLabel string\n    34\t}\n    35\t\n    36\t// newAccessibleForm creates a huh form with accessibility mode enabled when\n    37\t// the ACCESSIBLE env var is set. Mirrors cli.NewAccessibleForm without\n    38\t// requiring an import of the cli package (which would be circular).\n    39\tfunc newAccessibleForm(groups ...*huh.Group) *huh.Form {\n    40\t\tform := huh.NewForm(groups...).WithTheme(huh.ThemeF