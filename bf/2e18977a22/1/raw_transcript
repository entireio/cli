seID    string                    `json:\"tool_use_id,omitempty\"`\n   331\t\tFilesTouched []string                  `json:\"files_touched,omitempty\"`\n   332\t\tTokenUsage   *checkpointSessionTokens  `json:\"token_usage,omitempty\"`\n   333\t\tSummary      *checkpointSessionSummary `json:\"summary,omitempty\"`\n   334\t\n   335\t\t// Error is set when this session's metadata could not be read. The Index\n   336\t\t// field remains valid; all other content fields are zero. Consumers can\n   337\t\t// detect this by checking for a non-empty Error.\n   338\t\tError string `json:\"error,omitempty\"`\n   339\t}\n   340\t\n   341\ttype checkpointSessionTokens struct {\n   342\t\tInputTokens         int `json:\"input_tokens\"`\n   343\t\tOutputTokens        int `json:\"output_tokens\"`\n   344\t\tCacheReadTokens     int `json:\"cache_read_tokens,omitempty\"`\n   345\t\tCacheCreationTokens int `json:\"cache_creation_tokens,omitempty\"`\n   346\t}\n   347\t\n   348\ttype checkpointSessionSummary struct {\n   349\t\tIntent  string `json:\"intent,omitempty\"`\n   350\t\tOutcome string `json:\"outcome,omitempty\"`\n   351\t}\n   352\t\n   353\t// runExplainCheckpointJSON resolves a single checkpoint and emits a metadata-only\n   354\t// JSON envelope. Reads each session's metadata.json from /main; never reads any\n   355\t// transcript file.\n   356\tfunc runExplainCheckpointJSON(ctx context.Context, w, errW io.Writer, opts explainExportOptions) error {\n   357\t\tcpID, lookup, err := resolveExplainCheckpointID(ctx, errW, opts)\n   358\t\tif err != nil {\n   359\t\t\treturn err\n   360\t\t}\n   361\t\n   362\t\treader, summary, err := checkpoint.ResolveCommittedReaderForCheckpoint(ctx, cpID, lookup.v1Store, lookup.v2Store, lookup.preferCheckpointsV2)\n   363\t\tif err != nil {\n   364\t\t\treturn fmt.Errorf(\"failed to read checkpoint: %w\", err)\n   365\t\t}\n   366\t\n   367\t\tenvelope, failedSessions := buildCheckpointJSONEnvelope(ctx, reader, summary, cpID)\n   368\t\n   369\t\tenc := json.NewEncoder(w)\n   370\t\tenc.SetIndent(\"\", \"  \")\n   371\t\tif err := enc.Encode(envelope); err != nil {\n   372\t\t\treturn fmt.Errorf(\"failed to encode checkpoint json: %w\", err)\n   373\t\t}\n   374\t\n   375\t\t// Fail hard so automation can't mistake incomplete metadata for a clean\n   376\t\t// export. The envelope (with its `partial` flag and per-session error\n   377\t\t// fields) has already been written to stdout; using SilentError keeps\n   378\t\t// the diagnostic on stderr from interleaving with that output.\n   379\t\tif envelope.Partial {\n   380\t\t\tfmt.Fprintf(errW, \"checkpoint %s: failed to read metadata for %d session(s) (indexes %v)\\n\",\n   381\t\t\t\tcpID, len(failedSessions), failedSessions)\n   382\t\t\treturn NewSilentError(fmt.Errorf(\"checkpoint %s export incomplete: %d session(s) unreadable\", cpID, len(failedSessions)))\n   383\t\t}\n   384\t\treturn nil\n   385\t}\n   386\t\n   387\t// buildCheckpointJSONEnvelope builds the JSON envelope for a single checkpoint,\n   388\t// reading each session's metadata via the supplied reader. Returns the envelope\n   389\t// plus the list of session indexes that failed to read; a non-empty failed\n   390\t// list means envelope.Partial is true. Extracted from runExplainCheckpointJSON\n   391\t// so the envelope-building behavior (per-session error fields, partial flag)\n   392\t// can be tested independently of the v2 git tree, which the cli package\n   393\t// can't easily corrupt.\n   394\tfunc buildCheckpointJSONEnvelope(ctx context.Context, reader checkpoint.CommittedReader, summary *checkpoint.CheckpointSummary, cpID id.CheckpointID) (checkpointExportJSON, []int) {\n   395\t\tenvelope := checkpointExportJSON{\n   396\t\t\tCheckpointID:     cpID.String(),\n   397\t\t\tStrategy:         summary.Strategy,\n   398\t\t\tBranch:           summary.Branch,\n   399\t\t\tCheckpointsCount: summary.CheckpointsCount,\n   400\t\t\tFilesTouched:     summary.FilesTouched,\n   401\t\t\tHasReview:        summary.HasReview,\n   402\t\t\tSessionCount:     len(summary.Sessions),\n   403\t\t}\n   404\t\n   405\t\tenvelope.Sessions = make([]checkpointSessionJSON, 0, len(summary.Sessions))\n   406\t\tvar failedSessions []int\n   407\t\tfor idx := range summary.Sessions {\n   408\t\t\tmeta, metaErr := readSessionMetadataForExport(ctx, reader, cpID, idx)\n   409\t\t\tif metaErr != nil {\n   410\t\t\t\t// Surface the per-session error as a stub entry with an explicit\n   411\t\t\t\t// error string rather than failing the whole envelope or silently\n   412\t\t\t\t// returning empty fields. Consumers branch on the `error` field\n   413\t\t\t\t// and the top-level `partial` flag.\n   414\t\t\t\tenvelope.Sessions = append(envelope.Sessions, checkpointSessionJSON{\n   415\t\t\t\t\tIndex: idx,\n   416\t\t\t\t\tError: metaErr.Error(),\n   417\t\t\t\t})\n   418\t\t\t\tfailedSessions = append(failedSessions, idx)\n   419\t\t\t\tcontinue\n   420\t\t\t}\n   421\t\t\tenvelope.Sessions = append(envelope.Sessions, sessionMetadataToJSON(idx, meta))\n   422\t\t}\n   423\t\tenvelope.Partial = len(failedSessions) > 0\n   424\t\treturn envelope, failedSessions\n   425\t}\n   426\t\n   427\t// readSessionMetadataForExport reads only metadata.json for a session — no\n   428\t// transcript or prompt bytes. Both v1 and v2 stores expose a metadata-only\n   429\t// reader, so this never depends on transcript availability (which would\n   430\t// cause an unrelated ErrNoTranscript on v1 checkpoints whose raw transcript\n   431\t// has been pruned).\n   432\tfunc readSessionMetadataForExport(ctx context.Context, reader checkpoint.CommittedReader, cpID id.CheckpointID, idx int) (*checkpoint.CommittedMetadata, error) {\n   433\t\tswitch r := reader.(type) {\n   434\t\tcase *checkpoint.V2GitStore:\n   435\t\t\tmeta, err := r.ReadSessionMetadata(ctx, cpID, idx)\n   436\t\t\tif err != nil {\n   437\t\t\t\treturn nil, fmt.Errorf(\"read v2 session metadata: %w\", err)\n   438\t\t\t}\n  