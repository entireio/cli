nding associated commits).\n   551\t//\n   552\t\n   553\tfunc runExplainCheckpoint(ctx context.Context, w, errW io.Writer, checkpointIDPrefix string, noPager, verbose, full, rawTranscript, generate, force, searchAll bool) error {\n   554\t\treturn runExplainCheckpointWithLookup(ctx, w, errW, checkpointIDPrefix, noPager, verbose, full, rawTranscript, generate, force, searchAll, nil, nil)\n   555\t}\n   556\t\n   557\tfunc runExplainCheckpointWithLookup(ctx context.Context, w, errW io.Writer, checkpointIDPrefix string, noPager, verbose, full, rawTranscript, generate, force, searchAll bool, lookup *explainCheckpointLookup, lookupErr error) error {\n   558\t\tif lookup == nil {\n   559\t\t\tvar err error\n   560\t\t\tlookup, err = newExplainCheckpointLookup(ctx)\n   561\t\t\tif err != nil {\n   562\t\t\t\treturn err\n   563\t\t\t}\n   564\t\t} else if lookupErr != nil {\n   565\t\t\treturn lookupErr\n   566\t\t}\n   567\t\n   568\t\t// Match the prefix locally; on miss, fetch from remote and retry once.\n   569\t\tmatches, lookup := matchCheckpointPrefixWithRemoteFallback(ctx, errW, lookup, checkpointIDPrefix)\n   570\t\n   571\t\tvar fullCheckpointID id.CheckpointID\n   572\t\tswitch len(matches) {\n   573\t\tcase 0:\n   574\t\t\t// Check temp checkpoints BEFORE returning errCannotGenerateTemporaryCheckpoint\n   575\t\t\t// so runExplainAuto can distinguish:\n   576\t\t\t//   - target matched a real temp checkpoint (sentinel returned, no fallback)\n   577\t\t\t//   - target matched nothing (ErrCheckpointNotFound, safe to fall back to commit)\n   578\t\t\t// Previously the --generate path bailed before checking temp checkpoints,\n   579\t\t\t// which made runExplainAuto fall back to commit resolution for temp\n   580\t\t\t// checkpoint SHAs and produce a misleading \"no trailer\" error.\n   581\t\t\t//\n   582\t\t\t// --generate and --raw-transcript are mutually exclusive at the flag\n   583\t\t\t// layer, so rawTranscript is always false when generate is true; the\n  