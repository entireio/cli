onSummary{\n   486\t\t\t\tIntent:  meta.Summary.Intent,\n   487\t\t\t\tOutcome: meta.Summary.Outcome,\n   488\t\t\t}\n   489\t\t}\n   490\t\treturn out\n   491\t}\n   492\t\n   493\t// branchCheckpointJSON is one entry in the list emitted by\n   494\t// `entire checkpoint explain --json` (no target).\n   495\ttype branchCheckpointJSON struct {\n   496\t\tCheckpointID     string    `json:\"checkpoint_id\"`\n   497\t\tSessionID        string    `json:\"session_id,omitempty\"`\n   498\t\tAgent            string    `json:\"agent,omitempty\"`\n   499\t\tDate             time.Time `json:\"date\"`\n   500\t\tMessage          string    `json:\"message,omitempty\"`\n   501\t\tIsTaskCheckpoint bool      `json:\"is_task_checkpoint,omitempty\"`\n   502\t\tIsLogsOnly       bool      `json:\"is_logs_only,omitempty\"`\n   503\t\tSessionCount     int       `json:\"session_count,omitempty\"`\n   504\t\tSessionIDs       []string  `json:\"session_ids,omitempty\"`\n   505\t}\n   506\t\n   507\t// runExplainListJSON emits a JSON array of branch checkpoints, optionally\n   508\t// filtered by session ID prefix (mirrors the prose list view). The cap\n   509\t// defaults to branchCheckpointsLimit; pass listLimit > 0 to override.\n   510\t//\n   511\t// Truncation detection: we ask the underlying lister for one more than the\n   512\t// effective cap. If we got that many back, we know there were at least\n   513\t// `cap` checkpoints we didn't return — emit a stderr note so the consumer\n   514\t// knows to set --limit higher. The JSON shape stays a flat array so jq\n   515\t// pipelines don't have to unwrap.\n   516\tfunc runExplainListJSON(ctx context.Context, w, errW io.Writer, sessionFilter string, listLimit int) error {\n   517\t\trepo, err := openRepository(ctx)\n   518\t\tif err != nil {\n   519\t\t\treturn fmt.Errorf(\"not a git repository: %w\", err)\n   520\t\t}\n   521\t\n   522\t\tlimit := listLimit\n   523\t\tif limit <= 0 {\n   524\t\t\tlimit = branchCheckpointsLimit\n   525\t\t}\n   526\t\n   527\t\t// Probe one extra so we can detect truncation.\n   528\t\tpoints, err := getBranchCheckpoints(ctx, repo, limit+1)\n   529\t\tif err != nil {\n   530\t\t\tif ctx.Err() != nil {\n   531\t\t\t\treturn NewSilentError(ctx.Err())\n   532\t\t\t}\n   533\t\t\t// JSON consumers cannot distinguish \"[]\" from \"fetch failed\" if we\n   534\t\t\t// swallow the error. Surface it so scripts get a non-zero exit and\n   535\t\t\t// a real diagnostic instead of silently degraded output.\n   536\t\t\treturn fmt.Errorf(\"failed to list checkpoints: %w\", err)\n   537\t\t}\n   538\t\ttruncated := len(points) > limit\n   539\t\tif truncated {\n   540\t\t\tpoints = points[:limit]\n   541\t\t}\n   542\t\n   543\t\tout := make([]branchCheckpointJSON, 0, len(points))\n   544\t\tfor _, p := range points {\n   545\t\t\tif sessionFilter != \"\" && !checkpointMatchesSessionFilter(p, sessionFilter) {\n   546\t\t\t\tcontinue\n   547\t\t\t}\n   548\t\t\tentry := branchCheckpointJSON{\n   549\t\t\t\tSessionID:        p.SessionID,\n   550\t\t\t\tAgent:            string(p.Agent),\n   551\t\t\t\tDate:             p.Date,\n   552\t\t\t\tMessage:          p.Message,\n   553\t\t\t\tIsTaskCheckpoint: p.IsTaskCheckpoint,\n   554\t\t\t\tIsLogsOnly:       p.IsLogsOnly,\n   555\t\t\t\tSessionCount:     p.SessionCount,\n   556\t\t\t\tSessionIDs:       p.SessionIDs,\n   557\t\t\t}\n   558\t\t\tif !p.CheckpointID.IsEmpty() {\n   559\t\t\t\tentry.CheckpointID = p.CheckpointID.String()\n   560\t\t\t} else {\n   561\t\t\t\tentry.CheckpointID = p.ID\n   562\t\t\t}\n   563\t\t\tout = append(out, entry)\n   564\t\t}\n   565\t\n   566\t\tenc := json.NewEncoder(w)\n   567\t\tenc.SetIndent(\"\", \"  \")\n   568\t\tif err := enc.Encode(out); err != nil {\n   569\t\t\treturn fmt.Errorf(\"failed to encode checkpoint list: %w\", err)\n   570\t\t}\n   571\t\n   572\t\tif truncated {\n   573\t\t\tfmt.Fprintf(errW, \"note: list capped at %d checkpoints; rerun with --limit <N> to see more\\n\", limit)