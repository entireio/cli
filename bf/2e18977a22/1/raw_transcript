3\t// that has curated review skills, and saves the selection to\n    84\t// .entire/settings.json. Previously-saved skills are pre-checked via\n    85\t// huh.Option.Selected(true), mirroring how `entire enable` preserves prior\n    86\t// selections in its own agent picker.\n    87\t//\n    88\t// getInstalled is injected to avoid an import cycle with the cli package.\n    89\tfunc RunReviewConfigPicker(ctx context.Context, out io.Writer, getInstalled func(context.Context) []types.AgentName) (map[string]settings.ReviewConfig, error) {\n    90\t\tinstalled := getInstalled(ctx)\n    91\t\tif len(installed) == 0 {\n    92\t\t\treturn nil, errors.New(\n    93\t\t\t\t\"no agents with hooks installed; \" +\n    94\t\t\t\t\t\"run 'entire configure --agent <name>' to install hooks for one, \" +\n    95\t\t\t\t\t\"or 'entire enable' to set up the repo\",\n    96\t\t\t)\n    97\t\t}\n    98\t\n    99\t\t// Narrow to agents that have a curated skills list; others need manual\n   100\t\t// editing of settings.json under review.<agent-name>.\n   101\t\ttype configurableAgent struct {\n   102\t\t\tname types.AgentName\n   103\t\t\tag   agent.Agent\n   104\t\t}\n   105\t\tvar configurable []configurableAgent\n   106\t\tfor _, name := range installed {\n   107\t\t\tif !skilldiscovery.IsEligible(string(name)) {\n   108\t\t\t\tcontinue\n   109\t\t\t}\n   110\t\t\tag, err := agent.Get(name)\n   111\t\t\tif err != nil {\n   112\t\t\t\tcontinue\n   113\t\t\t}\n   114\t\t\tconfigurable = append(configurable, configurableAgent{name: name, ag: ag})\n   115\t\t}\n   116\t\tif len(configurable) == 0 {\n   117\t\t\treturn nil, errors.New(\n   118\t\t\t\t\"no installed agents have curated review skills; \" +\n   119\t\t\t\t\t\"edit .entire/settings.json directly under review.<agent-name>\",\n   120\t\t\t)\n   121\t\t}\n   122\t\n   123\t\t// Load existing config so we can pre-check saved skills and seed saved\n   124\t\t// prompts. A load error here means the settings file is malformed; log\