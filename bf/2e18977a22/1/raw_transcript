, noPager, verbose, full, rawTranscript, generate, force, searchAll, lookup, lookupErr)\n   450\t\tif checkpointErr == nil {\n   451\t\t\treturn nil\n   452\t\t}\n   453\t\t// Fall back to commit resolution ONLY when nothing (committed or temp)\n   454\t\t// matched the target. errCannotGenerateTemporaryCheckpoint signals that\n   455\t\t// we DID match a temp checkpoint but --generate is unsupported for it;\n   456\t\t// falling back to commit in that case would produce a misleading\n   457\t\t// \"no trailer\" error for the shadow-branch commit.\n   458\t\tif !errors.Is(checkpointErr, checkpoint.ErrCheckpointNotFound) {\n   459\t\t\treturn checkpointErr\n   460\t\t}\n   461\t\tlogging.Debug(ctx, \"explain auto: checkpoint lookup failed, trying commit fallback\",\n   462\t\t\tslog.String(\"target\", target),\n   463\t\t\tslog.String(\"checkpoint_error\", checkpointErr.Error()))\n   464\t\n   465\t\tif lookupErr != nil {\n   466\t\t\t// Composed message beats errors.Join here — the latter renders\n   467\t\t\t// two lines (one per error) and users act on the first/stale one.\n   468\t\t\treturn fmt.Errorf(\"no checkpoint matched %q, and commit fallback failed: %w\", target, lookupErr)\n   469\t\t}\n   470\t\thash, ambiguousMatches, resolveErr := resolveCommitUnambiguous(lookup.repo, target)\n   471\t\tif resolveErr != nil {\n   472\t\t\tif errors.Is(resolveErr, errAmbiguousCommitPrefix) {\n   473\t\t\t\trenderAmbiguousPrefixFailure(errW, target, \"commits\", buildAmbiguousCommitMatches(lookup.repo, ambiguousMatches))\n   474\t\t\t\treturn NewSilentError(resolveErr)\n   475\t\t\t}\n   476\t\t\tlogging.Debug(ctx, \"explain auto: git ref resolution failed\",\n   477\t\t\t\tslog.String(\"target\", target),\n   478\t\t\t\tslog.String(\"error\", resolveErr.Error()))\n   479\t\t\treturn fmt.Errorf(\"no checkpoint or commit found matching %q\", target)\n   480\t\t}\n   481\t\tcommit, commitErr := lookup.repo.CommitObject(hash)\n   482\t\tif commitErr != nil {\n   483\t\t\tr