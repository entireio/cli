{"parentUuid":"45a66639-ed1d-49cf-a654-9517bb3bb7c8","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/thomi/Projects/entire-cli/cmd/entire/cli/plugin_store.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"runtime\"\n10\t\t\"sort\"\n11\t\t\"strings\"\n12\t)\n13\t\n14\t// Managed plugin storage. The kubectl-style dispatcher in plugin.go resolves\n15\t// `entire-<name>` binaries from $PATH, period. To let `entire plugin install`\n16\t// be additive rather than a parallel mechanism, this file provides:\n17\t//\n18\t//  1. PluginBinDir() — a per-user managed dir that main.go prepends to PATH\n19\t//     before the dispatcher runs. Anything dropped here (or symlinked here)\n20\t//     becomes invocable as `entire <name>` without the user fiddling with PATH.\n21\t//\n22\t//  2. PluginDataDir(name) — a per-plugin durable storage dir, passed to plugins\n23\t//     as ENTIRE_PLUGIN_DATA_DIR. Independent of where the binary itself lives\n24\t//     so plugins installed via PATH and via the managed dir get the same\n25\t//     contract.\n26\t//\n27\t// Honors ENTIRE_PLUGIN_DIR as a parent-dir override; falls back to\n28\t// XDG_DATA_HOME, then a platform default.\n29\t\n30\tconst (\n31\t\tpluginEnvPluginDir      = \"ENTIRE_PLUGIN_DIR\"\n32\t\tpluginManagedBinSubdir  = \"bin\"\n33\t\tpluginManagedDataSubdir = \"data\"\n34\t\tpluginEnvPluginData     = \"ENTIRE_PLUGIN_DATA_DIR\"\n35\t\t// Path segments for the managed plugin tree. Kept as separate\n36\t\t// segments (rather than \"entire/plugins\") so filepath.Join produces\n37\t\t// platform-native separators on Windows.\n38\t\tpluginManagedTopDir = \"entire\"\n39\t\tpluginManagedSubDir = \"plugins\"\n40\t)\n41\t\n42\t// pluginParentDir returns the per-user directory that holds the managed\n43\t// plugin storage. Resolution, in order:\n44\t//\n45\t//  1. ENTIRE_PLUGIN_DIR (cross-platform override).\n46\t//  2. On Windows: LOCALAPPDATA if set, else ~\\AppData\\Local\\entire\\plugins.\n47\t//  3. On Unix: XDG_DATA_HOME if set, else ~/.local/share/entire/plugins.\n48\t//\n49\t// XDG_DATA_HOME is deliberately ignored on Windows even when set (e.g. in\n50\t// MSYS/Cygwin) — Windows users expect Windows conventions, and routing\n51\t// through XDG would produce a surprising location.\n52\t//\n53\t// os.UserHomeDir is called only when no env-var branch resolves, so a\n54\t// degenerate environment with $LOCALAPPDATA or $XDG_DATA_HOME but no home\n55\t// still returns a usable path.\n56\tfunc pluginParentDir() (string, error) {\n57\t\tif v := os.Getenv(pluginEnvPluginDir); v != \"\" {\n58\t\t\treturn v, nil\n59\t\t}\n60\t\tif runtime.GOOS == windowsGOOS {\n61\t\t\tif appData := os.Getenv(\"LOCALAPPDATA\"); appData != \"\" {\n62\t\t\t\treturn filepath.Join(appData, pluginManagedTopDir, pluginManagedSubDir), nil\n63\t\t\t}\n64\t\t\thome, err := os.UserHomeDir()\n65\t\t\tif err != nil {\n66\t\t\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n67\t\t\t}\n68\t\t\treturn filepath.Join(home, \"AppData\", \"Local\", pluginManagedTopDir, pluginManagedSubDir), nil\n69\t\t}\n70\t\tif v := os.Getenv(\"XDG_DATA_HOME\"); v != \"\" {\n71\t\t\treturn filepath.Join(v, pluginManagedTopDir, pluginManagedSubDir), nil\n72\t\t}\n73\t\thome, err := os.UserHomeDir()\n74\t\tif err != nil {\n75\t\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n76\t\t}\n77\t\treturn filepath.Join(home, \".local\", \"share\", pluginManagedTopDir, pluginManagedSubDir), nil\n78\t}\n79\t\n80\t// PluginBinDir returns the managed install directory. Binaries (or symlinks)\n81\t// placed here are auto-discovered by the kubectl-style dispatcher because\n82\t// main.go prepends this dir to PATH before MaybeRunPlugin runs.\n83\tfunc PluginBinDir() (string, error) {\n84\t\tparent, err := pluginParentDir()\n85\t\tif err != nil {\n86\t\t\treturn \"\", err\n87\t\t}\n88\t\treturn filepath.Join(parent, pluginManagedBinSubdir), nil\n89\t}\n90\t\n91\t// PluginDataDir returns the per-plugin data directory for the given bare name\n92\t// (e.g. \"pgr\" for `entire-pgr`). The returned path is not created — that's\n93\t// the plugin's responsibility on first use.\n94\t//\n95\t// Returns an error for names the dispatcher would never invoke (empty,\n96\t// flag-shaped, agent-protocol-reserved, \".\"/\"..\" path-traversal, slashes).\n97\t// This guarantees ENTIRE_PLUGIN_DATA_DIR always points inside the managed\n98\t// data subtree.\n99\tfunc PluginDataDir(name string) (string, error) {\n100\t\tif err := validatePluginName(name); err != nil {\n101\t\t\treturn \"\", err\n102\t\t}\n103\t\tparent, err := pluginParentDir()\n104\t\tif err != nil {\n105\t\t\treturn \"\", err\n106\t\t}\n107\t\treturn filepath.Join(parent, pluginManagedDataSubdir, name), nil\n108\t}\n109\t\n110\t// validatePluginName mirrors the dispatcher's isPluginCandidate rules and\n111\t// returns a descriptive error for invalid names. Used by every entry point\n112\t// that takes a plugin name from outside the dispatcher (data dir resolution,\n113\t// managed-dir install).\n114\tfunc validatePluginName(name string) error {\n115\t\tif name == \"\" {\n116\t\t\treturn errors.New(\"plugin name is empty\")\n117\t\t}\n118\t\tif strings.HasPrefix(name, \"-\") {\n119\t\t\treturn fmt.Errorf(\"plugin name %q must not start with '-'\", name)\n120\t\t}\n121\t\tif strings.HasPrefix(name, \"agent-\") {\n122\t\t\treturn fmt.Errorf(\"plugin name %q is reserved for the external agent protocol\", name)\n123\t\t}\n124\t\tif strings.ContainsAny(name, `/\\`) {\n125\t\t\treturn fmt.Errorf(\"plugin name %q must not contain path separators\", name)\n126\t\t}\n127\t\tif name == \".\" || name == \"..\" {\n128\t\t\treturn fmt.Errorf(\"plugin name %q is not a valid identifier\", name)\n129\t\t}\n130\t\treturn nil\n131\t}\n132\t\n133\t// EnsurePluginBinDir creates the managed install dir if it doesn't exist.\n134\tfunc EnsurePluginBinDir() (string, error) 