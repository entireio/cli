{"parentUuid":"35426401-76e3-4e4e-8d25-9e4f1cf41fec","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/thomi/Projects/entire-cli/cmd/entire/cli/plugin_store_test.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"runtime\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t)\n10\t\n11\t// withPluginDir points $ENTIRE_PLUGIN_DIR at a fresh temp dir so the managed\n12\t// helpers operate in isolation. Mutates process state, so the calling test\n13\t// must not be t.Parallel.\n14\tfunc withPluginDir(t *testing.T) string {\n15\t\tt.Helper()\n16\t\tdir := t.TempDir()\n17\t\tt.Setenv(pluginEnvPluginDir, dir)\n18\t\treturn dir\n19\t}\n20\t\n21\tfunc TestPluginParentDir_HonorsOverride(t *testing.T) { //nolint:paralleltest // mutates env\n22\t\tdir := withPluginDir(t)\n23\t\tgot, err := pluginParentDir()\n24\t\tif err != nil {\n25\t\t\tt.Fatalf(\"pluginParentDir: %v\", err)\n26\t\t}\n27\t\tif got != dir {\n28\t\t\tt.Errorf(\"pluginParentDir = %q, want %q\", got, dir)\n29\t\t}\n30\t}\n31\t\n32\tfunc TestPluginBinDir_AndDataDir(t *testing.T) { //nolint:paralleltest // mutates env\n33\t\troot := withPluginDir(t)\n34\t\tbin, err := PluginBinDir()\n35\t\tif err != nil {\n36\t\t\tt.Fatalf(\"PluginBinDir: %v\", err)\n37\t\t}\n38\t\tif want := filepath.Join(root, \"bin\"); bin != want {\n39\t\t\tt.Errorf(\"PluginBinDir = %q, want %q\", bin, want)\n40\t\t}\n41\t\tdata, err := PluginDataDir(\"pgr\")\n42\t\tif err != nil {\n43\t\t\tt.Fatalf(\"PluginDataDir: %v\", err)\n44\t\t}\n45\t\tif want := filepath.Join(root, \"data\", \"pgr\"); data != want {\n46\t\t\tt.Errorf(\"PluginDataDir(pgr) = %q, want %q\", data, want)\n47\t\t}\n48\t}\n49\t\n50\tfunc TestPrependPluginBinDirToPATH(t *testing.T) { //nolint:paralleltest // mutates env\n51\t\troot := withPluginDir(t)\n52\t\tt.Setenv(\"PATH\", \"/usr/bin:/bin\")\n53\t\tPrependPluginBinDirToPATH()\n54\t\tbin := filepath.Join(root, \"bin\")\n55\t\tgot := os.Getenv(\"PATH\")\n56\t\tif !strings.HasPrefix(got, bin+string(os.PathListSeparator)) {\n57\t\t\tt.Errorf(\"PATH does not start with managed bin dir: %q\", got)\n58\t\t}\n59\t\t// Idempotent: a second call must not double-prepend.\n60\t\tPrependPluginBinDirToPATH()\n61\t\tif strings.Count(os.Getenv(\"PATH\"), bin) != 1 {\n62\t\t\tt.Errorf(\"PATH contains managed bin dir %d times after second prepend; want 1: %q\", strings.Count(os.Getenv(\"PATH\"), bin), os.Getenv(\"PATH\"))\n63\t\t}\n64\t}\n65\t\n66\tfunc TestInstallPluginFromPath_SymlinksAndLists(t *testing.T) { //nolint:paralleltest // mutates env\n67\t\tif runtime.GOOS == windowsGOOS {\n68\t\t\tt.Skip(\"symlink path is Unix-only here\")\n69\t\t}\n70\t\twithPluginDir(t)\n71\t\tsrc := filepath.Join(t.TempDir(), \"entire-pgr\")\n72\t\tif err := os.WriteFile(src, []byte(\"#!/bin/sh\\nexit 0\\n\"), 0o755); err != nil {\n73\t\t\tt.Fatalf(\"write src: %v\", err)\n74\t\t}\n75\t\n76\t\tp, err := InstallPluginFromPath(InstallPluginOptions{SourcePath: src})\n77\t\tif err != nil {\n78\t\t\tt.Fatalf(\"InstallPluginFromPath: %v\", err)\n79\t\t}\n80\t\tif p.Name != \"pgr\" {\n81\t\t\tt.Errorf(\"Name = %q, want pgr\", p.Name)\n82\t\t}\n83\t\tif !p.Symlink {\n84\t\t\tt.Errorf(\"expected Symlink=true; got %+v\", p)\n85\t\t}\n86\t\n87\t\tplugins, err := ListInstalledPlugins()\n88\t\tif err != nil {\n89\t\t\tt.Fatalf(\"ListInstalledPlugins: %v\", err)\n90\t\t}\n91\t\tif len(plugins) != 1 || plugins[0].Name != \"pgr\" {\n92\t\t\tt.Errorf(\"ListInstalledPlugins = %+v; want one entry named pgr\", plugins)\n93\t\t}\n94\t\n95\t\t// Re-install without --force fails.\n96\t\tif _, err := InstallPluginFromPath(InstallPluginOptions{SourcePath: src}); err == nil {\n97\t\t\tt.Errorf(\"expected error on re-install without --force\")\n98\t\t}\n99\t\t// With --force succeeds.\n100\t\tif _, err := InstallPluginFromPath(InstallPluginOptions{SourcePath: src, Force: true}); err != nil {\n101\t\t\tt.Errorf(\"InstallPluginFromPath --force: %v\", err)\n102\t\t}\n103\t\n104\t\t// Remo