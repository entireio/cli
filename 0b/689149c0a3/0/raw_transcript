{"parentUuid":"64b2129e-6b4b-41b6-8278-5749f93da0df","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/thomi/Projects/entire-cli/cmd/entire/cli/plugin_store.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"runtime\"\n9\t\t\"sort\"\n10\t\t\"strings\"\n11\t)\n12\t\n13\t// Managed plugin storage. The kubectl-style dispatcher in plugin.go resolves\n14\t// `entire-<name>` binaries from $PATH, period. To let `entire plugin install`\n15\t// be additive rather than a parallel mechanism, this file provides:\n16\t//\n17\t//  1. PluginBinDir() — a per-user managed dir that main.go prepends to PATH\n18\t//     before the dispatcher runs. Anything dropped here (or symlinked here)\n19\t//     becomes invocable as `entire <name>` without the user fiddling with PATH.\n20\t//\n21\t//  2. PluginDataDir(name) — a per-plugin durable storage dir, passed to plugins\n22\t//     as ENTIRE_PLUGIN_DATA_DIR. Independent of where the binary itself lives\n23\t//     so plugins installed via PATH and via the managed dir get the same\n24\t//     contract.\n25\t//\n26\t// Honors ENTIRE_PLUGIN_DIR as a parent-dir override; falls back to\n27\t// XDG_DATA_HOME, then a platform default.\n28\t\n29\tconst (\n30\t\tpluginEnvPluginDir       = \"ENTIRE_PLUGIN_DIR\"\n31\t\tpluginManagedBinSubdir   = \"bin\"\n32\t\tpluginManagedDataSubdir  = \"data\"\n33\t\tpluginEnvPluginData      = \"ENTIRE_PLUGIN_DATA_DIR\"\n34\t\tpluginManagedDirEntireXD = \"entire/plugins\"\n35\t)\n36\t\n37\t// pluginParentDir returns the per-user directory that holds the managed\n38\t// plugin storage. Honors ENTIRE_PLUGIN_DIR; otherwise XDG_DATA_HOME, then a\n39\t// platform default.\n40\tfunc pluginParentDir() (string, error) {\n41\t\tif v := os.Getenv(pluginEnvPluginDir); v != \"\" {\n42\t\t\treturn v, nil\n43\t\t}\n44\t\tif v := os.Getenv(\"XDG_DATA_HOME\"); v != \"\" {\n45\t\t\treturn filepath.Join(v, pluginManagedDirEntireXD), nil\n46\t\t}\n47\t\thome, err := os.UserHomeDir()\n48\t\tif err != nil {\n49\t\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n50\t\t}\n51\t\tif runtime.GOOS == windowsGOOS {\n52\t\t\tif appData := os.Getenv(\"LOCALAPPDATA\"); appData != \"\" {\n53\t\t\t\treturn filepath.Join(appData, pluginManagedDirEntireXD), nil\n54\t\t\t}\n55\t\t\treturn filepath.Join(home, \"AppData\", \"Local\", pluginManagedDirEntireXD), nil\n56\t\t}\n57\t\treturn filepath.Join(home, \".local\", \"share\", pluginManagedDirEntireXD), nil\n58\t}\n59\t\n60\t// PluginBinDir returns the managed install directory. Binaries (or symlinks)\n61\t// placed here are auto-discovered by the kubectl-style dispatcher because\n62\t// main.go prepends this dir to PATH before MaybeRunPlugin runs.\n63\tfunc PluginBinDir() (string, error) {\n64\t\tparent, err := pluginParentDir()\n65\t\tif err != nil {\n66\t\t\treturn \"\", err\n67\t\t}\n68\t\treturn filepath.Join(parent, pluginManagedBinSubdir), nil\n69\t}\n70\t\n71\t// PluginDataDir returns the per-plugin data directory for the given bare name\n72\t// (e.g. \"pgr\" for `entire-pgr`). The returned path is not created — that's\n73\t// the plugin's responsibility on first use.\n74\t//\n75\t// Returns an error for names the dispatcher would never invoke (empty,\n76\t// flag-shaped, agent-protocol-reserved, \".\"/\"..\" path-traversal, slashes).\n77\t// This guarantees ENTIRE_PLUGIN_DATA_DIR always points inside the managed\n78\t// data subtree.\n79\tfunc PluginDataDir(name string) (string, error) {\n80\t\tif err := validatePluginName(name); err != nil {\n81\t\t\treturn \"\", err\n82\t\t}\n83\t\tparent, err := pluginParentDir()\n84\t\tif err != nil {\n85\t\t\treturn \"\", err\n86\t\t}\n87\t\treturn filepath.Join(parent, pluginManagedDataSubdir, name), nil\n88\t}\n89\t\n90\t// validatePluginName mirrors the dispatcher's isPluginCandidate rules and\n91\t// returns a descriptive error for invalid names. Used by every entry point\n92\t// that takes a plugin name from outside the dispatcher (data dir resolution,\n93\t// managed-dir install).\n94\tfunc validatePluginName(name string) error {\n95\t\tif name == \"\" {\n96\t\t\treturn errors.New(\"plugin name is empty\")\n97\t\t}\n98\t\tif strings.HasPrefix(name, \"-\") {\n99\t\t\treturn fmt.Errorf(\"plugin name %q must not start with '-'\", name)\n100\t\t}\n101\t\tif strings.HasPrefix(name, \"agent-\") {\n102\t\t\treturn fmt.Errorf(\"plugin name %q is reserved for the external agent protocol\", name)\n103\t\t}\n104\t\tif strings.ContainsAny(name, `/\\`) {\n105\t\t\treturn fmt.Errorf(\"plugin name %q must not contain path separators\", name)\n106\t\t}\n107\t\tif name == \".\" || name == \"..\" {\n108\t\t\treturn fmt.Errorf(\"plugin name %q is not a valid identifier\", name)\n109\t\t}\n110\t\treturn nil\n111\t}\n112\t\n113\t// EnsurePluginBinDir creates the managed install dir if it doesn't exist.\n114\tfunc EnsurePluginBinDir() (string, error) {\n115\t\tdir, err := PluginBinDir()\n116\t\tif err != nil {\n117\t\t\treturn \"\", err\n118\t\t}\n119\t\tif err := os.MkdirAll(dir, 0o750); err != nil {\n120\t\t\treturn \"\", fmt.Errorf(\"create plugin bin dir: %w\", err)\n121\t\t}\n122\t\treturn dir, nil\n123\t}\n124\t\n125\t// PrependPluginBinDirToPATH prepends the managed bin dir to the process's\n126\t// PATH so the kubectl dispatcher discovers managed-installed plugins. Idempotent\n127\t// against an already-prepended dir. Called from main.go before MaybeRunPlugin.\n128\t//\n129\t// Errors are non-fatal — managed installs simply won't be discoverable on this\n130\t// invocation, which mirrors the kubectl-style \"drop a binary on PATH yourself\"\n131\t// fallback.\n132\tfunc PrependPluginBinDirToPATH() {\n133\t\tdir, err := PluginBinDir()\n134\t\tif err != nil || dir == \"\" {\n135\t\t\treturn\n136\t\t}\n137\t\tcur := os.Getenv(\"PATH\")\n138\t\tsep := string(os.PathListSeparator)\n139\t\tif cur == \"\" {\n140\t\t\t_ = os.Setenv(\"PATH\", dir)\n141\t\t\treturn\n142\t\t}\n143\t\t// Idempotent: if the first entry already matches, leave it alone.\n144\t\tif i := strings.Index(cur, sep); i >= 0 && cur[:i] == dir {\n145\t\t\treturn\n146\t\t}\n147\t\tif cur == dir {\n148\t\t\treturn\n149\t\t}\n150\t\t_ = os.Setenv(\"PATH\", dir+sep+cur)\n151\t}\n152\t\n153\t// InstalledPlugin describes a single entry in the managed bin dir.\n154\ttype InstalledPlugin struct {\n155\t\t// Name is the bare plugin name (without the `entire-` prefix and any\n156\t\t// platform-specific extension).\n157\t\tName string\n158\t\t// Path is the absolute path inside the managed bin dir.\n159\t\tPath string\n160\t\t// Symlink is true when Path is a symlink to a source location elsewhere\n161\t\t// (the typical local-dev install). LinkTarget is populated in that case.\n162\t\tSymlink    bool\n163\t\tLinkTarget string\n164\t}\n165\t\n166\t// ListInstalledPlugins enumerates entries in the managed bin dir whose name\n167\t// starts with `entire-`. Sorted by bare name. A missing dir returns no error\n168\t// and an empty slice.\n169\tfunc ListInstalledPlugins() ([]*InstalledPlugin, error) {\n170\t\tdir, err := PluginBinDir()\n171\t\tif err != nil {\n172\t\t\treturn nil, err\n173\t\t}\n174\t\tentries, err := os.ReadDir(dir)\n175\t\tif err != nil {\n176\t\t\tif errors.Is(err, os.ErrNotExist) {\n177\t\t\t\treturn nil, nil\n178\t\t\t}\n179\t\t\treturn nil, fmt.Errorf(\"read plugin bin dir: %w\", err)\n180\t\t}\n181\t\n182\t\tvar out []*InstalledPlugin\n183\t\tfor _, e := range entries {\n184\t\t\tfull := e.Name()\n185\t\t\tif !strings.HasPrefix(full, pluginBinaryPrefix) {\n186\t\t\t\tcontinue\n187\t\t\t}\n188\t\t\tbare := bareNameFromBinaryName(full)\n189\t\t\tif bare == \"\" {\n190\t\t\t\tcontinue\n191\t\t\t}\n192\t\t\tpath := filepath.Join(dir, full)\n193\t\t\tinfo, err := os.Lstat(path)\n194\t\t\tif err != nil {\n195\t\t\t\tcontinue\n196\t\t\t}\n197\t\t\tip := &InstalledPlugin{Name: bare, Path: path}\n198\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n199\t\t\t\tip.Symlink = true\n200\t\t\t\tif target, err := os.Readlink(path); err == nil {\n201\t\t\t\t\tip.LinkTarget = target\n202\t\t\t\t}\n203\t\t\t}\n204\t\t\tout = append(out, ip)\n205\t\t}\n206\t\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\n207\t\treturn out, nil\n208\t}\n209\t\n210\t// FindInstalledPlugin returns the entry for the given bare name, or nil if\n211\t// it isn't installed in the managed dir.\n212\tfunc FindInstalledPlugin(name string) (*InstalledPlugin, error) {\n213\t\tall, err := ListInstalledPlugins()\n214\t\tif err != nil {\n215\t\t\treturn nil, err\n216\t\t}\n217\t\tfor _, p := range all {\n218\t\t\tif p.Name == name {\n219\t\t\t\treturn p, nil\n220\t\t\t}\n221\t\t}\n222\t\treturn nil, nil //nolint:nilnil // not-installed signal\n223\t}\n224\t\n225\t// InstallPluginOptions configures InstallPluginFromPath.\n226\ttype InstallPluginOptions struct {\n227\t\t// SourcePath is the absolute (or working-dir-relative) path to the plugin\n228\t\t// executable. Its basename — minus any platform extension — must match\n229\t\t// `entire-<name>` so the dispatcher can resolve it.\n230\t\tSourcePath string\n\n... [130 lines truncated] ..."},"type":"attachment","uuid":"a7058ed3-27a2-4cfb-a352-63c733ba20e0","timestamp":"2026-05-05T17:14:24.684Z","userType":"external","entrypoint":"cli","cwd":"/Users/thomi/Projects/entire-cli","sessionId":"a1f70cf7-7a52-4ebc-865d-2e575c556160","version":"2.1.126","gitBranch":"ashtom/plugin-exploration"}
