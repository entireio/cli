) {\n134\t\tt.Parallel()\n135\t\tgot := pluginEnv([]string{\"ENTIRE_PLUGIN_ENV=AWS_*\", \"PATH=/bin\"})\n136\t\tif !slices.Contains(envNames(got), \"ENTIRE_PLUGIN_ENV\") {\n137\t\t\tt.Errorf(\"ENTIRE_PLUGIN_ENV should pass through to plugins; got %v\", envNames(got))\n138\t\t}\n139\t}\n140\t\n141\tfunc envNames(env []string) []string {\n142\t\tout := make([]string, 0, len(env))\n143\t\tfor _, kv := range env {\n144\t\t\tif k, _, ok := splitKV(kv); ok {\n145\t\t\t\tout = append(out, k)\n146\t\t\t}\n147\t\t}\n148\t\treturn out\n149\t}\n150\t\n151\tfunc splitKV(kv string) (key, value string, ok bool) {\n152\t\tfor i := range len(kv) {\n153\t\t\tif kv[i] == '=' {\n154\t\t\t\tif i == 0 {\n155\t\t\t\t\treturn \"\", \"\", false\n156\t\t\t\t}\n157\t\t\t\treturn kv[:i], kv[i+1:], true\n158\t\t\t}\n159\t\t}\n160\t\treturn \"\", \"\", false\n161\t}"},"type":"attachment","uuid":"d205a9e0-6976-43f4-8481-1c5be188a1ae","timestamp":"2026-05-06T15:58:30.315Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments_2","sessionId":"d3f01bb0-fb75-46a6-ae70-8aab0a703055","version":"2.1.129","gitBranch":"soph/external-command-support"}
