45\t\t\t\tname:     \"XDG_ prefix passes\",\n46\t\t\t\tparent:   []string{\"XDG_CONFIG_HOME=/h/.cfg\", \"XDG_DATA_HOME=/h/.data\"},\n47\t\t\t\twantHave: []string{\"XDG_CONFIG_HOME\", \"XDG_DATA_HOME\"},\n48\t\t\t},\n49\t\t\t{\n50\t\t\t\tname:     \"CI detection passes\",\n51\t\t\t\tparent:   []string{\"CI=true\", \"GITHUB_ACTIONS=true\", \"BUILDKITE=true\"},\n52\t\t\t\twantHave: []string{\"CI\", \"GITHUB_ACTIONS\", \"BUILDKITE\"},\n53\t\t\t},\n54\t\t\t{\n55\t\t\t\tname:     \"proxies pass in both cases\",\n56\t\t\t\tparent:   []string{\"HTTP_PROXY=p\", \"https_proxy=p\", \"NO_PROXY=localhost\"},\n57\t\t\t\twantHave: []string{\"HTTP_PROXY\", \"https_proxy\", \"NO_PROXY\"},\n58\t\t\t},\n59\t\t\t{\n60\t\t\t\tname:     \"extras are always added\",\n61\t\t\t\tparent:   []string{\"PATH=/bin\"},\n62\t\t\t\textra:    []string{\"ENTIRE_CLI_VERSION=1.0\", \"ENTIRE_REPO_ROOT=/r\"},\n63\t\t\t\twantHave: []string{\"ENTIRE_CLI_VERSION\", \"ENTIRE_REPO_ROOT\", \"PATH\"},\n64\t\t\t},\n65\t\t\t{\n66\t\t\t\tname:     \"override admits an exact name\",\n67\t\t\t\tparent:   []string{\"ENTIRE_PLUGIN_ENV=AWS_PROFILE\", \"AWS_PROFILE=dev\", \"AWS_REGION=us-east-1\", \"PATH=/bin\"},\n68\t\t\t\twantHave: []string{\"AWS_PROFILE\", \"PATH\"},\n69\t\t\t\twantMiss: []string{\"AWS_REGION\"},\n70\t\t\t},\n71\t\t\t{\n72\t\t\t\tname:     \"override admits a wildcard prefix\",\n73\t\t\t\tparent:   []string{\"ENTIRE_PLUGIN_ENV=AWS_*\", \"AWS_PROFILE=dev\", \"AWS_REGION=us-east-1\", \"GITHUB_TOKEN=x\"},\n74\t\t\t\twantHave: []string{\"AWS_PROFILE\", \"AWS_REGION\"},\n75\t\t\t\twantMiss: []string{\"GITHUB_TOKEN\"},\n76\t\t\t},\n77\t\t\t{\n78\t\t\t\tname:     \"override accepts mixed list with whitespace\",\n79\t\t\t\tparent:   []string{\"ENTIRE_PLUGIN_ENV= AWS_* , GH_TOKEN \", \"AWS_PROFILE=dev\", \"GH_TOKEN=t\", \"GITHUB_TOKEN=x\"},\n80\t\t\t\twantHave: []string{\"AWS_PROFILE\", \"GH_TOKEN\"},\n81\t\t\t\twantMiss: []string{\"GITHUB_TOKEN\"},\n82\t\t\t},\n83\t\t\t{\n84\t\t\t\tname:     \"malformed entr