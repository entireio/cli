{"parentUuid":"be3d1697-5d72-4a97-a176-b950a378ff34","isSidechain":false,"attachment":{"type":"file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/me.ts","content":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/me.ts","content":"import { Hono } from \"hono\"\nimport { describeRoute, resolver } from \"hono-openapi\"\nimport { z } from \"zod\"\n\nimport type { Env, Variables } from \"../env\"\nimport {\n  computeDailyContributions,\n  computeHourlyContributions,\n  computeRepoBreakdown,\n  computeStats,\n  computeStreaks,\n  createTimezoneConverter,\n} from \"../lib/activity-aggregator\"\nimport { getDb } from \"../lib/db\"\nimport { requireBearerAuth } from \"../lib/middleware\"\nimport { recordSpanError } from \"../lib/telemetry\"\nimport { handleUserCommits, parseTimeframeParams } from \"./cache\"\nimport { recapRoutes } from \"./recap\"\n\nconst meRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n\nmeRoutes.use(\"*\", requireBearerAuth)\n\nconst errorSchema = z.object({ error: z.string() })\n\nconst checkpointListItemSchema = z.object({\n  checkpoint_id: z.string(),\n  prompt: z.string().nullable(),\n  agent: z.string(),\n  agents: z.array(z.string()),\n  session_count: z.number(),\n  total_steps: z.number(),\n})\n\nconst userCommitListItemSchema = z.object({\n  commit_sha: z.string(),\n  commit_message: z.string().nullable(),\n  commit_author_username: z.string().nullable(),\n  commit_date: z.string().nullable(),\n  additions: z.number(),\n  deletions: z.number(),\n  files_changed: z.number(),\n  checkpoints: z.array(checkpointListItemSchema),\n  repo_full_name: z.string(),\n  is_private: z.boolean(),\n  checkpoint_repo_full_name: z.string().nullable(),\n})\n\nconst commitsResponseSchema = z.object({\n  commits: z.array(userCommitListItemSchema),\n  timeframe: z.string(),\n  updated_at: z.string(),\n})\n\nmeRoutes.get(\n  \"/commits\",\n  describeRoute({\n    tags: [\"Me\"],\n    summary: \"Recent commits for the authenticated user\",\n    description:\n      \"Returns the authenticated user's most recent commits within the requested \" +\n      \"timeframe, each grouped with its associated checkpoints. Backs the commit \" +\n      \"list on the overview dashboard and is suitable for CLI commit history views.\",\n    parameters: [\n      {\n        name: \"timeframe\",\n        in: \"query\",\n        required: false,\n        description: \"Window of commits to return. Defaults to last-6-months.\",\n        schema: {\n          type: \"string\",\n          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n        },\n      },\n      {\n        name: \"limit\",\n        in: \"query\",\n        required: false,\n        description: \"Max commits to return (1-1000, default 500).\",\n        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n      },\n    ],\n    responses: {\n      200: {\n        description: \"Recent commits with checkpoints\",\n        content: { \"application/json\": { schema: resolver(commitsResponseSchema) } },\n      },\n      401: {\n        description: \"Not authenticated\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      404: {\n        description: \"User not found\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      500: {\n        description: \"Failed to fetch commits\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n    },\n  }),\n  handleUserCommits,\n)\n\nconst agentContributionsSchema = z.object({\n  claude: z.number(),\n  gemini: z.number(),\n  amp: z.number(),\n  codex: z.number(),\n  opencode: z.number(),\n  copilot: z.number(),\n  pi: z.number(),\n  cursor: z.number(),\n  droid: z.number(),\n  kiro: z.number(),\n  unknown: z.number(),\n})\n\nconst agentIdSchema = z.enum([\n  \"claude\",\n  \"gemini\",\n  \"amp\",\n  \"codex\",\n  \"opencode\",\n  \"copilot\",\n  \"pi\",\n  \"cursor\",\n  \"droid\",\n  \"kiro\",\n  \"unknown\",\n])\n\nconst activityResponseSchema = z.object({\n  stats: z.object({\n    tasks: z.number(),\n    orchestration: z.number(),\n    iteration: z.number(),\n    throughput: z.number(),\n    streak: z.number(),\n    current_streak: z.number(),\n  }),\n  daily_contributions: z.array(\n    z.object({\n      date: z.string(),\n      agents: agentContributionsSchema,\n    }),\n  ),\n  hourly_contributions: z.array(\n    z.object({\n      date: z.string(),\n      hour: z.number(),\n      agent: agentIdSchema,\n      value: z.number(),\n    }),\n  ),\n  repos: z.array(\n    z.object({\n      repo: z.string(),\n      total: z.number(),\n      agents: agentContributionsSchema,\n    }),\n  ),\n})\n\nmeRoutes.get(\n  \"/activity\",\n  describeRoute({\n    tags: [\"Me\"],\n    summary: \"Pre-aggregated activity for the authenticated user\",\n    description:\n      \"Returns dashboard-ready rollups of the authenticated user's checkpoints: \" +\n      \"stats (tasks, orchestration, iteration, throughput, streaks), daily and hourly \" +\n      \"contributions grouped by agent, and a per-repo breakdown. All fields are \" +\n      \"computed from the same set of checkpoints bounded by `timeframe`, bucketed by \" +\n      \"`commit_date` in the caller-supplied IANA timezone. `streak` / `current_streak` \" +\n      \"are therefore scoped to the requested window, not lifetime values.\",\n    parameters: [\n      {\n        name: \"timezone\",\n        in: \"query\",\n        required: true,\n        description: \"IANA timezone identifier (e.g. Europe/Berlin, America/New_York, UTC).\",\n        schema: { type: \"string\" },\n      },\n      {\n        name: \"timeframe\",\n        in: \"query\",\n        required: false,\n        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n        schema: {\n          type: \"string\",\n          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n        },\n      },\n      {\n        name: \"limit\",\n        in: \"query\",\n        required: false,\n        description: \"Max checkpoints to aggregate (1-1000, default 500).\",\n        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n      },\n    ],\n    responses: {\n      200: {\n        description: \"Aggregated activity data\",\n        content: { \"application/json\": { schema: resolver(activityResponseSchema) } },\n      },\n      400: {\n        description: \"Missing or invalid timezone\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      401: {\n        description: \"Not authenticated\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      404: {\n        description: \"User not found\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      500: {\n        description: \"Failed to fetch activity\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n    },\n  }),\n  async (c) => {\n    const userId = c.get(\"userId\") as string\n\n    const timezone = c.req.query(\"timezone\")\n    if (!timezone) {\n      return c.json({ error: \"timezone parameter is required\" }, 400)\n    }\n\n    let conv\n    try {\n      conv = createTimezoneConverter(timezone)\n    } catch {\n      return c.json({ error: \"Invalid timezone\" }, 400)\n    }\n\n    const { limit, startDate, endDate } = parseTimeframeParams(c)\n\n    try {\n      const db = getDb(c.env)\n      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n      if (!user) {\n        return c.json({ error: \"User not found\" }, 404)\n      }\n\n      const checkpoints = await db.checkpoints.getByUser(\n        userId,\n        user.github_id,\n        startDate.toISOString(),\n        endDate.toISOString(),\n        limit,\n      )\n\n      // Derive streaks from the same checkpoints that back the charts so\n      // every field in the response reflects the requested timeframe and\n      // shares the same commit_date day boundary.\n      const streakTimestamps = checkpoints\n        .map((cp) => cp.commit_date)\n        .filter((d): d is string => d !== null)\n      const { currentStreak, streak } = computeStreaks(streakTimestamps, conv)\n      const baseStats = computeStats(checkpoints)\n\n      return c.json({\n        stats: { ...baseStats, streak, current_streak: currentStreak },\n        daily_contributions: computeDailyContributions(checkpoints, conv),\n        hourly_contributions: computeHourlyContributions(checkpoints, conv),\n        repos: computeRepoBreakdown(checkpoints),\n      })\n    } catch (err) {\n      console.error(\"Failed to fetch user activity:\", err)\n      recordSpanError(err)\n      return c.json({ error: \"Failed to fetch activity\" }, 500)\n    }\n  },\n)\n\n// /me/recap — per-agent aggregates for the CLI `entire recap` command.\n// Mounted here (rather than at app.ts level) so it inherits meRoutes'\n// bearer-auth middleware and shares the \"/me\" OpenAPI tag.\nmeRoutes.route(\"/recap\", recapRoutes)\n\nexport { meRoutes }\n","numLines":287,"startLine":1,"totalLines":287}},"displayPath":"../../../entire.io/.worktrees/recap-endpoint/api/src/routes/me.ts"},"type":"attachment","uuid":"17204b15-15e3-4375-a82d-f81ef35ac61a","timestamp":"2026-04-23T01:09:47.505Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity","slug":"kind-beaming-shannon"}
{"parentUuid":"17204b15-15e3-4375-a82d-f81ef35ac61a","isSidechain":false,"attachment":{"type":"file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","content":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts","content":"// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n//\n// Returns, for every agent the user has used in the window (and optionally\n// every agent any contributor used on a scoped repo):\n//   - me side: checkpoints + labels + skills + mcpServers + toolMix\n//     (tokens intentionally omitted — the CLI sums metadata.json locally)\n//   - contributors side: the same shape aggregated across all contributors\n//     to the specified repo (requires ?repo=org/name)\n//\n// This endpoint consolidates three CLI operations into one request:\n//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n//   2. POST /checkpoints/analyses/batch → analyses for each cp\n//   3. GET /:org/:repo/overview/*       → contributor aggregates\n//\n// Without this endpoint the CLI has to do all three itself and attribute\n// analyses to agents via the commits endpoint — a lot of round trips and\n// brittle client-side joining. Centralizing on the server matches the\n// pattern established by /me/activity (PR #1590).\n\nimport { Hono } from \"hono\"\nimport { describeRoute, resolver } from \"hono-openapi\"\nimport { z } from \"zod\"\n\nimport type { Env, Variables } from \"../env\"\nimport { getDb } from \"../lib/db\"\nimport {\n  aggregateByAgent,\n  type AgentAggregate,\n  type AnalysisWithAgent,\n} from \"../lib/recap-aggregator\"\nimport { recordSpanError } from \"../lib/telemetry\"\nimport { parseTimeframeParams } from \"./cache\"\n\n// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n// applied at the meRoutes level (requireBearerAuth); duplicating it here\n// would double-execute the middleware.\nconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n\nconst errorSchema = z.object({ error: z.string() })\n\nconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\nconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\nconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\nconst toolMixSchema = z.object({\n  shell: z.number(),\n  fileOps: z.number(),\n  search: z.number(),\n  mcp: z.number(),\n  agent: z.number(),\n  other: z.number(),\n})\n\nconst agentAggregateSchema = z.object({\n  checkpoints: z.number(),\n  tokens: z.number(),\n  transcriptTokens: z.number(),\n  filesChanged: z.number(),\n  labels: z.array(labelCountSchema),\n  skills: z.array(skillCountSchema),\n  mcpServers: z.array(mcpCountSchema),\n  toolMix: toolMixSchema,\n})\n\nconst perAgentEntrySchema = z.object({\n  me: agentAggregateSchema,\n  contributors: agentAggregateSchema.nullable(),\n})\n\nconst recapResponseSchema = z.object({\n  timeframe: z.string(),\n  repo: z.string().nullable(),\n  agents: z.record(z.string(), perAgentEntrySchema),\n  contributors: z\n    .object({\n      distinctUsers: z.number(),\n      totalTokens: z.number(),\n      totalCheckpoints: z.number(),\n    })\n    .nullable(),\n  updated_at: z.string(),\n})\n\nrecapRoutes.get(\n  \"/\",\n  describeRoute({\n    tags: [\"Me\"],\n    summary: \"Per-agent recap aggregates for the authenticated user\",\n    description:\n      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n      \"`contributors` counterpart aggregated across every contributor on the \" +\n      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n    parameters: [\n      {\n        name: \"timeframe\",\n        in: \"query\",\n        required: false,\n        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n        schema: {\n          type: \"string\",\n          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n        },\n      },\n      {\n        name: \"repo\",\n        in: \"query\",\n        required: false,\n        description:\n          \"Restrict me-side aggregates and enable the contributors side. \" +\n          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n          \"the user has checkpoints on and the contributors side is null.\",\n        schema: { type: \"string\" },\n      },\n      {\n        name: \"limit\",\n        in: \"query\",\n        required: false,\n        description: \"Max checkpoints to consider (1-1000, default 500).\",\n        schema: { type: \"integer\", minimum: 1, maximum: 1000, default: 500 },\n      },\n    ],\n    responses: {\n      200: {\n        description: \"Per-agent recap aggregates\",\n        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n      },\n      401: {\n        description: \"Not authenticated\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      404: {\n        description: \"User or repo not found\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      500: {\n        description: \"Failed to build recap\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n    },\n  }),\n  async (c) => {\n    const userId = c.get(\"userId\") as string\n    const { limit, startDate, endDate } = parseTimeframeParams(c)\n    const repoParam = c.req.query(\"repo\")?.trim() || null\n\n    try {\n      const db = getDb(c.env)\n      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n      if (!user) return c.json({ error: \"User not found\" }, 404)\n\n      // --- me side ---\n      // Pull the user's checkpoints in the window. When a repo is scoped,\n      // filter here so we don't drag other repos into the me aggregates.\n      const myCheckpoints = await db.checkpoints.getByUser(\n        userId,\n        user.github_id,\n        startDate.toISOString(),\n        endDate.toISOString(),\n        limit,\n      )\n      const scopedMyCheckpoints = repoParam\n        ? myCheckpoints.filter((cp) => cp.repo_full_name === repoParam)\n        : myCheckpoints\n\n      const meRows = await buildAnalysisRows(db, scopedMyCheckpoints, c.env)\n      const meByAgent = aggregateByAgent(meRows)\n\n      // --- contributors side ---\n      // Only available when a specific repo is requested; otherwise the\n      // \"contributors\" concept doesn't have a well-defined scope.\n      let contribByAgent: Record<string, AgentAggregate> = {}\n      let contribSummary: {\n        distinctUsers: number\n        totalTokens: number\n        totalCheckpoints: number\n      } | null = null\n\n      if (repoParam) {\n        const repoParts = repoParam.split(\"/\")\n        if (repoParts.length === 2 && repoParts[0] && repoParts[1]) {\n          const repo = await db.repos.getByFullName(repoParam)\n          if (repo) {\n            const branch = repo.default_branch ?? \"main\"\n            const { daily: agentActivity } = await getAgentActivityBundle(\n              db,\n              repo.id,\n              branch,\n              startDate.toISOString(),\n              endDate.toISOString(),\n            )\n\n            // Sum tokens per agent from agent-activity — SQL aggregate that\n            // doesn't require loading every analysis.\n            const tokensByAgent: Record<string, number> = {}\n            for (const row of agentActivity) {\n              tokensByAgent[row.agent] = (tokensByAgent[row.agent] ?? 0) + (row.tokens ?? 0)\n            }\n\n            const allCheckpoints = await db.checkpoints.getForBranch(repo.id, branch, {\n              limit,\n            })\n            const windowed = allCheckpoints.filter((cp) => {\n              if (!cp.commit_date) return false\n              const t = new Date(cp.commit_date).getTime()\n              return t >= startDate.getTime() && t < endDate.getTime()\n            })\n\n            const contribRows = await buildAnalysisRows(db, windowed, c.env, repo.id)\n            contribByAgent = aggregateByAgent(contribRows, tokensByAgent)\n\n            const contributorsResult = await db.repoOverview.getContributorAgents(\n              repo.id,\n              branch,\n              startDate.toISOString(),\n              endDate.toISOString(),\n            )\n            contribSummary = {\n              distinctUsers: contributorsResult.contributors.length,\n              totalTokens: Object.values(tokensByAgent).reduce((s, n) => s + n, 0),\n              totalCheckpoints: windowed.length,\n            }\n          }\n        }\n      }\n\n      // Merge me + contributors into the per-agent map, keyed by agent.\n      const allAgents = new Set<string>([\n        ...Object.keys(meByAgent),\n        ...Object.keys(contribByAgent),\n      ])\n      const agents: Record<string, { me: AgentAggregate; contributors: AgentAggregate | null }> = {}\n      for (const name of allAgents) {\n        agents[name] = {\n          me: meByAgent[name] ?? emptyAggregate(),\n          contributors: contribByAgent[name] ?? null,\n        }\n      }\n\n      return c.json({\n        timeframe: c.req.query(\"timeframe\") ?? \"last-6-months\",\n        repo: repoParam,\n        agents,\n        contributors: contribSummary,\n        updated_at: new Date().toISOString(),\n      })\n    } catch (err) {\n      console.error(\"Failed to build recap:\", err)\n      recordSpanError(err)\n      return c.json({ error: \"Failed to build recap\" }, 500)\n    }\n  },\n)\n\nfunction emptyAggregate(): AgentAggregate {\n  return {\n    checkpoints: 0,\n    tokens: 0,\n    transcriptTokens: 0,\n    filesChanged: 0,\n    labels: [],\n    skills: [],\n    mcpServers: [],\n    toolMix: { shell: 0, fileOps: 0, search: 0, mcp: 0, agent: 0, other: 0 },\n  }\n}\n\n/**\n * buildAnalysisRows loads analyses for the given checkpoints and attaches\n * each to its producing agent. When repoId is passed explicitly (contrib\n * path), analyses are keyed by that repo; for the me path we fall back to\n * looking up the repo per checkpoint via cp.repo_id.\n */\nasync function buildAnalysisRows(\n  db: ReturnType<typeof getDb>,\n  checkpoints: Array<{\n    checkpoint_id: string\n    agent: string | null\n    repo_id?: string | null\n  }>,\n  _env: Env,\n  repoId?: string,\n): Promise<AnalysisWithAgent[]> {\n  const byRepo = new Map<string, string[]>()\n  for (const cp of checkpoints) {\n    const rid = repoId ?? cp.repo_id ?? \"\"\n    if (!rid || !cp.checkpoint_id) continue\n    const arr = byRepo.get(rid) ?? []\n    arr.push(cp.checkpoint_id)\n    byRepo.set(rid, arr)\n  }\n\n  const analysesById = new Map<string, ReturnType<typeof parseAnalysisRow>>()\n  for (const [rid, ids] of byRepo) {\n    const rows = await db.analyses.getByCheckpointIds(rid, ids)\n    for (const row of rows) {\n      analysesById.set(row.checkpoint_id, parseAnalysisRow(row))\n    }\n  }\n\n  const out: AnalysisWithAgent[] = []\n  for (const cp of checkpoints) {\n    if (!cp.checkpoint_id) continue\n    out.push({\n      checkpointId: cp.checkpoint_id,\n      agent: cp.agent ?? \"unknown\",\n      analysis: analysesById.get(cp.checkpoint_id) ?? null,\n    })\n  }\n  return out\n}\n\n/**\n * parseAnalysisRow mirrors formatCheckpointAnalysisResponse from cache.ts\n * but returns the parsed analysis JSON directly (or null for non-complete\n * states) without the status discriminator.\n */\nfunction parseAnalysisRow(row: {\n  status: string\n  analysis_json: string | null\n}): import(\"../types\").StoredCheckpointAnalysis | null {\n  if (row.status !== \"complete\" || !row.analysis_json) return null\n  try {\n    return JSON.parse(row.analysis_json)\n  } catch {\n    return null\n  }\n}\n\n/**\n * getAgentActivityBundle wraps repoOverview.getAgentActivityDaily and\n * returns both the raw rows and the computed-per-agent tokens map. Splits\n * into its own helper so the handler stays readable.\n */\nasync function getAgentActivityBundle(\n  db: ReturnType<typeof getDb>,\n  repoId: string,\n  branch: string,\n  since?: string,\n  until?: string,\n): Promise<{\n  daily: Awaited<ReturnType<typeof db.repoOverview.getAgentActivityDaily>>\n}> {\n  const daily = await db.repoOverview.getAgentActivityDaily(repoId, branch, since, until)\n  return { daily }\n}\n\nexport { recapRoutes }\n","numLines":349,"startLine":1,"totalLines":349}},"displayPath":"../../../entire.io/.worktrees/recap-endpoint/api/src/routes/recap.ts"},"type":"attachment","uuid":"71492597-4fef-4b8a-8c93-497dcc2ea4c1","timestamp":"2026-04-23T01:09:47.414Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity","slug":"kind-beaming-shannon"}
