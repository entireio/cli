ghput: 0,\n    })\n  })\n\n  it(\"computes stats for a single checkpoint\", () => {\n    const stats = computeStats([makeCheckpoint()])\n    expect(stats.tasks).toBe(1)\n    expect(stats.orchestration).toBe(83)\n    expect(stats.iteration).toBe(2)\n    expect(stats.throughput).toBe(15)\n  })\n\n  it(\"defaults steps and session_count to 1 when null\", () => {\n    const stats = computeStats([makeCheckpoint({ steps: null, session_count: null })])\n    expect(stats.orchestration).toBe(50)\n    expect(stats.iteration).toBe(1)\n  })\n\n  it(\"defaults steps and session_count to 1 when zero\", () => {\n    const stats = computeStats([makeCheckpoint({ steps: 0, session_count: 0 })])\n    expect(stats.orchestration).toBe(50)\n    expect(stats.iteration).toBe(1)\n  })\n\n  it(\"computes throughput only from checkpoints with token data\", () => {\n    const stats = computeStats([\n      makeCheckpoint({ input_tokens: 10000, output_tokens: 5000 }),\n      makeCheckpoint({ input_tokens: null, output_tokens: null }),\n    ])\n    expect(stats.throughput).toBe(15)\n  })\n\n  it(\"returns throughput 0 when no checkpoints have token data\", () => {\n    const stats = computeStats([makeCheckpoint({ input_tokens: null, output_tokens: null })])\n    expect(stats.throughput).toBe(0)\n  })\n})\n\ndescribe(\"computeStreaks\", () => {\n  const FIXED_NOW = new Date(\"2026-04-15T12:00:00Z\")\n\n  it(\"returns zeros for empty timestamps\", () => {\n    expect(computeStreaks([], UTC)).toEqual({ currentStreak: 0, streak: 0 })\n  })\n\n  it(\"computes current streak from today\", () => {\n    vi.useFakeTimers()\n    vi.setSystemTime(FIXED_NOW)\n\n    const result = computeStreaks(\n      [\"2026-04-15T10:00:00Z\", \"2026-04-14T10:00:00Z\", \"2026-04-13T10:00:00Z\"],\n      UTC,\n    )\n    expect(result.currentStreak).toBe(3)\n    expect(result.streak).toBe(3)\n\n    vi.useRealTimers()\n  })\n\n  it(\"starts from yesterday if no activity today\", () => {\n    vi.useFakeTimers()\n    vi.setSystemTime(FIXED_NOW)\n\n    const result = computeStreaks([\"2026-04-14T10:00:00Z\", \"2026-04-13T10:00:00Z\"], UTC)\n    expect(result.currentStreak).toBe(2)\n\n    vi.useRealTimers()\n  })\n\n  it(\"handles gaps — longest streak differs from current\", () => {\n    vi.useFakeTimers()\n    vi.setSystemTime(FIXED_NOW)\n\n    const result = computeStreaks(\n      [\n        \"2026-04-15T10:00:00Z\",\n        \"2026-04-10T10:00:00Z\",\n        \"2026-04-11T10:00:00Z\",\n        \"2026-04-12T10:00:00Z\",\n        \"2026-04-13T10:00:00Z\",\n      ],\n      UTC,\n    )\n    expect(result.currentStreak).toBe(1)\n    expect(result.streak).toBe(4)\n\n    vi.useRealTimers()\n  })\n\n  it(\"respects timezone for date bucketing\", () => {\n    vi.useFakeTimers()\n    vi.setSystemTime(new Date(\"2026-04-15T04:00:00Z\"))\n\n    // April 15 00:30 UTC = April 14 20:30 in New York (EDT)\n    const timestamps = [\"2026-04-15T00:30:00Z\"]\n    expect(computeStreaks(timestamps, UTC).currentStreak).toBe(1)\n    expect(computeStreaks(timestamps, NY).currentStreak).toBe(1)\n\n    vi.useRealTimers()\n  })\n})\n\ndescribe(\"computeDailyContributions\", () => {\n  it(\"groups by date and agent, sums steps\", () => {\n    const result = computeDailyContributions(\n      [\n        makeCheckpoint({ commit_date: \"2026-04-15T10:00:00Z\", agent: \"Claude Code\", steps: 3 }),\n        makeCheckpoint({ commit_date: \"2026-04-15T14:00:00Z\", agent: \"cursor\", steps: 2 }),\n        makeCheckpoint({ commit_date: \"2026-04-14T10:00:00Z\", agent: \"Claude Code\", steps: 5 }),\n      ],\n      UTC,\n    )\n\n    expect(result).toHaveLength(2)\n    expect(result[0].date).toBe(\"2026-04-14\")\n    expect(result[0].agents.claude).toBe(5)\n    expect(result[1].date).toBe(\"2026-04-15\")\n    expect(result[1].agents.claude).toBe(3)\n    expect(result[1].agents.cursor).toBe(2)\n  })\n\n  it(\"defaults steps to 1 when null\", () => {\n    const result = computeDailyContributions([makeCheckpoint({ steps: null })], UTC)\n    expect(result[0].agents.claude).toBe(1)\n  })\n\n  it(\"skips checkpoints with null commit_date\", () => {\n    expect(computeDailyContributions([makeCheckpoint({ commit_date: null })], UTC)).toHaveLength(0)\n  })\n\n  it(\"crosses timezone boundary — UTC early morning falls on previous day in US\", () => {\n    const cps = [makeCheckpoint({ commit_date: \"2026-04-15T03:00:00Z\", agent: \"claude\" })]\n\n    expect(computeDailyContributions(cps, UTC)[0].date).toBe(\"2026-04-15\")\n    // 03:00 UTC = 23:00 EDT on April 14\n    expect(computeDailyContributions(cps, NY)[0].date).toBe(\"2026-04-14\")\n  })\n\n  it(\"initializes all agent buckets to 0\", () => {\n    const result = computeDailyContributions([makeCheckpoint({ agent: \"claude\" })], UTC)\n    expect(result[0].agents.gemini).toBe(0)\n    expect(result[0].agents.unknown).toBe(0)\n  })\n\n  it(\"sorts by date ascending\", () => {\n    const result = computeDailyContributions(\n      [\n        makeCheckpoint({ commit_date: \"2026-04-17T10:00:00Z\" }),\n        makeCheckpoint({ commit_date: \"2026-04-15T10:00:00Z\" }),\n        makeCheckpoint({ commit_date: \"2026-04-16T10:00:00Z\" }),\n      ],\n      UTC,\n    )\n    expect(result.map((r) => r.date)).toEqual([\"2026-04-15\", \"2026-04-16\", \"2026-04-17\"])\n  })\n})\n\ndescribe(\"computeHourlyContributions\", () => {\n  it(\"groups by date + hour + agent\", () => {\n    const result = computeHourlyContributions(\n      [\n        makeCheckpoint({ commit_date: \"2026-04-15T14:00:00Z\", agent: \"claude\", steps: 3 }),\n        makeCheckpoint({ commit_date: \"2026-04-15T14:30:00Z\", agent: \"claude\", steps: 2 }),\n        makeCheckpoint({ commit_date: \"2026-04-15T15:00:00Z\", agent: \"cursor\", steps: 1 }),\n      ],\n      UTC,\n    )\n\n    expect(result).toHaveLength(2)\n    expect(result[0]).toEqual({ date: \"2026-04-15\", hour: 14, agent: \"claude\", value: 5 })\n    expect(result[1]).toEqual({ date: \"2026-04-15\", hour: 15, agent: \"cursor\", value: 1 })\n  })\n\n  it(\"converts hours to user timezone\", () => {\n    // 14:00 UTC = 10:00 EDT\n    const result = computeHourlyContributions(\n      [makeCheckpoint({ commit_date: \"2026-04-15T14:00:00Z\", agent: \"claude\" })],\n      NY,\n    )\n    expect(result[0].hour).toBe(10)\n  })\n\n  it(\"sorts by date then hour\", () => {\n    const result = computeHourlyContributions(\n      [\n        makeCheckpoint({ commit_date: \"2026-04-15T16:00:00Z\" }),\n        makeCheckpoint({ commit_date: \"2026-04-15T14:00:00Z\" }),\n        makeCheckpoint({ commit_date: \"2026-04-14T10:00:00Z\" }),\n      ],\n      UTC,\n    )\n    expect(result.map((r) => `${r.date}-${r.hour}`)).toEqual([\n      \"2026-04-14-10\",\n      \"2026-04-15-14\",\n      \"2026-04-15-16\",\n    ])\n  })\n})\n\ndescribe(\"computeRepoBreakdown\", () => {\n  it(\"counts checkpoints per repo and agent\", () => {\n    const result = computeRepoBreakdown([\n      makeCheckpoint({ repo_full_name: \"org/app\", agent: \"claude\" }),\n      makeCheckpoint({ repo_full_name: \"org/app\", agent: \"cursor\" }),\n      makeCheckpoint({ repo_full_name: \"org/lib\", agent: \"claude\" }),\n    ])\n\n    expect(result).toHaveLength(2)\n    expect(result[0].repo).toBe(\"org/app\")\n    expect(result[0].total).toBe(2)\n    expect(result[0].agents.claude).toBe(1)\n    expect(result[0].agents.cursor).toBe(1)\n    expect(result[1].repo).toBe(\"org/lib\")\n    expect(result[1].total).toBe(1)\n  })\n\n  it(\"sorts by total descending\", () => {\n    const result = computeRepoBreakdown([\n      makeCheckpoint({ repo_full_name: \"org/small\" }),\n      makeCheckpoint({ repo_full_name: \"org/big\" }),\n      makeCheckpoint({ repo_full_name: \"org/big\" }),\n      makeCheckpoint({ repo_full_name: \"org/big\" }),\n    ])\n    expect(result[0].repo).toBe(\"org/big\")\n    expect(result[0].total).toBe(3)\n    expect(result[1].repo).toBe(\"org/small\")\n    expect(result[1].total).toBe(1)\n  })\n\n  it(\"counts checkpoints, not steps\", () => {\n    const result = computeRepoBreakdown([\n      makeCheckpoint({ repo_full_name: \"org/app\", steps: 100 }),\n      makeCheckpoint({ repo_full_name: \"org/app\", steps: 1 }),\n    ])\n    expect(result[0].total).toBe(2)\n  })\n})\n\ndescribe(\"agent normalization in aggregation\", () => {\n  it(\"normalizes agent names\", () => {\n    const result = computeDailyContributions(\n      [\n        makeCheckpoint({ agent: \"Claude Code\", commit_date: \"2026-04-15T10:00:00Z\" }),\n        makeCheckpoint({ agent: \"open-code\", commit_date: \"2026-04-15T10:00:00Z\" }),\n        makeCheckpoint({ agent: \"Factory AI Droid\", commit_date: \"2026-04-15T10:00:00Z\" }),\n        makeCheckpoint({ agent: \"Copilot CLI\", commit_date: \"2026-04-15T10:00:00Z\" }),\n        makeCheckpoint({ agent: null, commit_date: \"2026-04-15T10:00:00Z\" }),\n      ],\n      UTC,\n    )\n    expect(result[0].agents.claude).toBeGreaterThan(0)\n    expect(result[0].agents.opencode).toBeGreaterThan(0)\n    expect(result[0].agents.droid).toBeGreaterThan(0)\n    expect(result[0].agents.copilot).toBeGreaterThan(0)\n    expect(result[0].agents.unknown).toBeGreaterThan(0)\n  })\n})\n","structuredPatch":[{"oldStart":19,"oldLines":6,"newStart":19,"newLines":7,"lines":["     additions: 10,","     deletions: 5,","     files_changed: 3,","+    repo_id: \"repo-1\",","     repo_full_name: \"org/app\",","     branch: \"main\",","     is_private: false,"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"d3357510-ce2b-4977-b910-30426bb175e4","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity","slug":"kind-beaming-shannon"}
