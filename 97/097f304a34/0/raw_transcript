     \"cc.commit_sha\",\n1524\t      sql<string>`COALESCE(bc.branch, cc.branch)`.as(\"branch\"),\n1525\t      \"cp.created_at\",\n1526\t      // ROW_NUMBER() assigns 1, 2, 3... within each (repo_id, checkpoint_id) group.\n1527\t      // ORDER BY (bc.branch IS NOT NULL) DESC puts the default-branch row first (1=true, 0=false).\n1528\t      // The outer query filters WHERE rn = 1 to keep one row per checkpoint,\n1529\t      // preferring the default branch. If the checkpoint isn't on the default branch,\n1530\t      // an arbitrary branch is picked.\n1531\t      sql<number>`ROW_NUMBER() OVER (PARTITION BY cc.repo_id, cc.checkpoint_id ORDER BY (bc.branch IS NOT NULL) DESC)`.as(\n1532\t        \"rn\",\n1533\t      ),\n1534\t    ])\n1535\t    .where(\"rc.commit_author_github_id\", \"=\", githubId)\n1536\t    .where(\"cp.created_at\", \">=\", new Date(startDate))\n1537\t    .where(\"cp.created_at\", \"<=\", new Date(endDate))\n1538\t    .as(\"ranked\")\n1539\t\n1540\t  const commits = await db\n1541\t    .selectFrom(ranked)\n1542\t    .innerJoin(\"repo_commits as rc\", (join) =>\n1543\t      join\n1544\t        .onRef(\"rc.repo_id\", \"=\", \"ranked.repo_id\")\n1545\t        .onRef(\"rc.commit_sha\", \"=\", \"ranked.commit_sha\"),\n1546\t    )"}]},"uuid":"4d99f6a1-e5e9-45e6-a3cd-af4462c6c61e","timestamp":"2026-04-23T02:34:18.755Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/lib/planetscale/checkpoints.ts","content":"export async function getCheckpointsByUser(\n  db: Kysely<DB>,\n  userId: string,\n  githubId: number,\n  startDate: string,\n  endDate: string,\n  limit: number = 500,\n): Promise<UserCheckpoint[]> {\n  // Subquery: deduplicate checkpoint commits in SQL using ROW_NUMBER so the\n  // LIMIT applies to unique (repo_id, checkpoint_id) pairs. Prefers the row\n  // on the default branch. Uses repo_checkpoints.created_at as the primary\n  // time axis — this comes from checkpoint session metadata and is available\n  // even without commit resolution.\n  const ranked = db\n    .selectFrom(\"repo_checkpoint_commits as cc\")\n    .innerJoin(\"repo_checkpoints as cp\", (join) =>\n      join\n        .onRef(\"cp.repo_id\", \"=\", \"cc.repo_id\")\n        .onRef(\"cp.checkpoint_id\", \"=\", \"cc.checkpoint_id\"),\n    )\n    .innerJoin(\"repo_commits as rc\", (join) =>\n      join.onRef(\"rc.repo_id\", \"=\", \"cc.repo_id\").onRef(\"rc.commit_sha\", \"=\", \"cc.commit_sha\"),\n    )\n    .innerJoin(\"repos\", \"repos.id\", \"cc.repo_id\")\n    .innerJoin(\"user_repos\", (join) =>\n      join.onRef(\"user_repos.repo_id\", \"=\", \"cc.repo_id\").on(\"user_repos.user_id\", \"=\", userId),\n    )\n    .leftJoin(\"repo_branch_commits as bc\", (join) =>\n      join\n        .onRef(\"bc.repo_id\", \"=\", \"cc.repo_id\")\n        .onRef(\"bc.commit_sha\", \"=\", \"cc.commit_sha\")\n        .onRef(\"bc.branch\", \"=\", \"repos.default_branch\"),\n    )\n    .select([\n      \"cc.repo_id\",\n      \"cc.checkpoint_id\",\n      \"cc.commit_sha\",\n      sql<string>`COALESCE(bc.branch, cc.branch)`.as(\"branch\"),\n      \"cp.created_at\",\n      // ROW_NUMBER() assigns 1, 2, 3... within each (repo_id, checkpoint_id) group.\n      // ORDER BY (bc.branch IS NOT NULL) DESC puts the default-branch row first (1=true, 0=false).\n      // The outer query filters WHERE rn = 1 to keep one row per checkpoint,\n      // preferring the default branch. If the checkpoint isn't on the default branch,\n      // an arbitrary branch is picked.\n      sql<number>`ROW_NUMBER() OVER (PARTITION BY cc.repo_id, cc.checkpoint_id ORDER BY (bc.branch IS NOT NULL) DESC)`.as(\n        \"rn\",\n      ),\n    ])\n    .where(\"rc.commit_author_github_id\", \"=\", githubId)\n    .where(\"cp.created_at\", \">=\", new Date(startDate))\n    .where(\"cp.created_at\", \"<=\", new Date(endDate))\n    .as(\"ranked\")\n\n  const commits = await db\n    .selectFrom(ranked)\n    .innerJoin(\"repo_commits as rc\", (join) =>\n      join\n        .onRef(\"rc.repo_id\", \"=\", \"ranked.repo_id\")\n        .onRef(\"rc.commit_sha\", \"=\", \"ranked.commit_sha\"),\n    )","numLines":60,"startLine":1487,"totalLines":2510}},"sourceToolAssistantUUID":"6af90569-0cbc-4232-b740-2d455b8a10cc","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity","slug":"kind-beaming-shannon"}
