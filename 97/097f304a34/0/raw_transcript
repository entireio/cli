/ work for power users, and d/w/m are the one-letter range hotkeys.\n\tcase \"right\", \"l\", \"tab\":\n\t\tm.view = rebuildView(m.sessions, nextRange(m.view.Range), m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\tcase \"left\", \"h\", \"shift+tab\":\n\t\tm.view = rebuildView(m.sessions, prevRange(m.view.Range), m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\tcase \"1\", \"d\":\n\t\tm.view = rebuildView(m.sessions, RangeDay, m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\tcase \"2\", \"w\":\n\t\tm.view = rebuildView(m.sessions, RangeWeek, m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\tcase \"3\", \"M\":\n\t\tm.view = rebuildView(m.sessions, RangeMonth, m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\tcase \"4\":\n\t\tm.view = rebuildView(m.sessions, Range30d, m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\tcase \"5\":\n\t\tm.view = rebuildView(m.sessions, Range90d, m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\n\t// Filter toggles: single-key cycle for agent + view mode.\n\tcase \"a\":\n\t\tm.agentFilter = cycleAgent(m.agents, m.agentFilter)\n\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\tcase \"v\":\n\t\tm.mode = cycleMode(m.mode)\n\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n\t\trefreshViewport(&m)\n\n\t// Vertical scroll. Up/down for single line; space / pgup / pgdn for\n\t// half-page; home/end for jumps. Mouse wheel handled in Update.\n\tcase \"up\", \"k\":\n\t\tm.viewport.ScrollUp(1)\n\tcase \"down\", \"j\":\n\t\tm.viewport.ScrollDown(1)\n\tcase \"pgup\", \"b\":\n\t\tm.viewport.HalfPageUp()\n\tcase \"pgdown\", \" \", \"pgdn\":\n\t\tm.viewport.HalfPageDown()\n\tcase \"home\", \"g\":\n\t\tm.viewport.GotoTop()\n\tcase \"end\", \"G\":\n\t\tm.viewport.GotoBottom()\n\t}\n\treturn m, nil\n}\n\n// rangeOrder is the navigation sequence used by left/right arrow + tab.\n// Stable order means the visual header's tab positions and keyboard\n// traversal order always agree.\nvar rangeOrder = []RangeKey{RangeDay, RangeWeek, RangeMonth, Range30d, Range90d}\n\nfunc nextRange(current RangeKey) RangeKey {\n\tfor i, r := range rangeOrder {\n\t\tif r == current {\n\t\t\treturn rangeOrder[(i+1)%len(rangeOrder)]\n\t\t}\n\t}\n\treturn rangeOrder[0]\n}\n\nfunc prevRange(current RangeKey) RangeKey {\n\tfor i, r := range rangeOrder {\n\t\tif r == current {\n\t\t\treturn rangeOrder[(i-1+len(rangeOrder))%len(rangeOrder)]\n\t\t}\n\t}\n\treturn rangeOrder[0]\n}\n\n// refreshViewport re-renders the body into the viewport after a state\n// change. Keeps scroll position at top when the underlying view changed\n// (range / agent / mode cycle) so users don't get stranded halfway down\n// a different dataset. Free function with explicit pointer so it works\n// alongside bubbletea's value-receiver Update/View contract.\nfunc refreshViewport(m *TUIModel) {\n\tif !m.ready {\n\t\treturn\n\t}\n\tm.viewport.SetContent(RenderStatic(m.view, m.styles, m.viewport.Width))\n\tm.viewport.GotoTop()\n}\n\n// View renders the scrollable body inside the viewport plus a fixed help\n// line at the bottom. First frame (before WindowSizeMsg arrives) falls back\n// to direct static rendering so there's no blank flash.\nfunc (m TUIModel) View() string {\n\thelp := m.styles.help.Render(\"  1-5 d/w/m  range  ·  a  agent  ·  v  view  ·  ↑↓/pgup/pgdn  scroll  ·  q  quit\")\n\tif !m.ready {\n\t\treturn RenderStatic(m.view, m.styles, m.width) + \"\\n\" + help\n\t}\n\treturn m.viewport.View() + \"\\n\" + help\n}\n\n// rebuildView is a tiny wrapper that anchors Now at call time so range math\n// stays correct across long-running TUI sessions.\nfunc rebuildView(sessions []RecapSession, r RangeKey, agent string, mode ViewMode) View {\n\treturn BuildView(sessions, BuildOpts{Range: r, AgentFilter: agent, Mode: mode, Now: time.Now()})\n}\n\n// cycleMode advances the view mode: both → me → contributors → both.\nfunc cycleMode(current ViewMode) ViewMode {\n\tswitch current {\n\tcase ViewBoth:\n\t\treturn ViewMe\n\tcase ViewMe:\n\t\treturn ViewContributors\n\tcase ViewContributors:\n\t\treturn ViewBoth\n\t}\n\treturn ViewBoth\n}\n\n// cycleAgent advances the filter in a stable round-robin: \"\" → agents[0] →\n// agents[1] → … → \"\". Stable order means the same key press always moves\n// to the same next agent.\nfunc cycleAgent(agents []string, current string) string {\n\tif len(agents) == 0 {\n\t\treturn \"\"\n\t}\n\tif current == \"\" {\n\t\treturn agents[0]\n\t}\n\tfor i, a := range agents {\n\t\tif a == current {\n\t\t\tif i+1 < len(agents) {\n\t\t\t\treturn agents[i+1]\n\t\t\t}\n\t\t\treturn \"\"\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc distinctAgents(sessions []RecapSession) []string {\n\tseen := map[string]bool{}\n\tvar out []string\n\tfor _, s := range sessions {\n\t\tfor _, a := range s.AgentsUsed {\n\t\t\tif !seen[a] {\n\t\t\t\tseen[a] = true\n\t\t\t\tout = append(out, a)\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}\n","structuredPatch":[{"oldStart":178,"oldLines":7,"newStart":178,"newLines":7,"lines":[" // line at the bottom. First frame (before WindowSizeMsg arrives) falls back"," // to direct static rendering so there's no blank flash."," func (m TUIModel) View() string {","-  help := m.styles.help.Render(\"  1-5 d/w/m  range  ·  a  agent  ·  v  view  ·  ↑↓/pgup/pgdn  scroll  ·  q  quit\")","+  help := m.styles.help.Render(\"  ←→/tab  range  ·  a  agent  ·  v  view  ·  ↑↓  scroll  ·  q  quit\")","   if !m.ready {","     return RenderStatic(m.view, m.styles, m.width) + \"\\n\" + help","   }"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"548d2421-81ef-412b-87f1-1ecc34a51442","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
