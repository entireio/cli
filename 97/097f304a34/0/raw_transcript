ll\n// content that's taller than the terminal, without losing the help line.\ntype TUIModel struct {\n\tsessions    []RecapSession\n\tview        View\n\tagentFilter string\n\tagents      []string // agents present in sessions, for cycling\n\tmode        ViewMode // me / contributors / both\n\tstyles      Styles\n\tviewport    viewport.Model\n\tready       bool // true after first WindowSizeMsg sizes the viewport\n\twidth       int\n\theight      int\n}\n\n// NewTUIModel wraps a pre-built View with the state bubbletea needs for\n// interactive toggles. agentFilter is the initial filter (\"\" = all agents).\nfunc NewTUIModel(sessions []RecapSession, initial View, agentFilter string) TUIModel {\n\tmode := initial.Mode\n\tif mode == \"\" {\n\t\tmode = ViewBoth\n\t}\n\treturn TUIModel{\n\t\tsessions:    sessions,\n\t\tview:        initial,\n\t\tagentFilter: agentFilter,\n\t\tagents:      distinctAgents(sessions),\n\t\tmode:        mode,\n\t\tstyles:      NewStyles(true),\n\t\twidth:       100,\n\t\theight:      24,\n\t}\n}\n\n// Init is a no-op — no async work on startup.\nfunc (m TUIModel) Init() tea.Cmd { return nil }\n\n// Update dispatches on keyboard and window-resize messages. Range + agent\n// toggles rebuild the View via BuildView; scroll keys delegate to the\n// viewport so content taller than the terminal stays reachable.\nfunc (m TUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) { //nolint:ireturn // tea.Model is required by bubbletea's interface contract\n\tswitch msg := msg.(type) {\n\tcase tea.WindowSizeMsg:\n\t\tm.width, m.height = msg.Width, msg.Height\n\t\t// Reserve one line for the help footer.\n\t\tif !m.ready {\n\t\t\tm.viewport = viewport.New(msg.Width, msg.Height-1)\n\t\t\tm.ready = true\n\t\t} else {\n\t\t\tm.viewport.Width = msg.Width\n\t\t\tm.viewport.Height = msg.Height - 1\n\t\t}\n\t\tm.refreshViewport()\n\t\treturn m, nil\n\tcase tea.KeyMsg:\n\t\treturn m.handleKey(msg)\n\t}\n\treturn m, nil\n}\n\nfunc (m TUIModel) handleKey(msg tea.KeyMsg) (tea.Model, tea.Cmd) { //nolint:ireturn // mirrors Update's bubbletea contract\n\tkey := msg.String()\n\tswitch key {\n\tcase \"q\", \"ctrl+c\", \"esc\":\n\t\treturn m, tea.Quit\n\tcase \"1\", \"d\":\n\t\tm.view = rebuildView(m.sessions, RangeDay, m.agentFilter, m.mode)\n\t\tm.refreshViewport()\n\tcase \"2\", \"w\":\n\t\tm.view = rebuildView(m.sessions, RangeWeek, m.agentFilter, m.mode)\n\t\tm.refreshViewport()\n\tcase \"3\", \"m\":\n\t\tm.view = rebuildView(m.sessions, RangeMonth, m.agentFilter, m.mode)\n\t\tm.refreshViewport()\n\tcase \"4\":\n\t\tm.view = rebuildView(m.sessions, Range30d, m.agentFilter, m.mode)\n\t\tm.refreshViewport()\n\tcase \"5\":\n\t\tm.view = rebuildView(m.sessions, Range90d, m.agentFilter, m.mode)\n\t\tm.refreshViewport()\n\tcase \"a\":\n\t\tm.agentFilter = cycleAgent(m.agents, m.agentFilter)\n\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n\t\tm.refreshViewport()\n\tcase \"v\":\n\t\tm.mode = cycleMode(m.mode)\n\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n\t\tm.refreshViewport()\n\tdefault:\n\t\t// Pass everything else (up/down/pgup/pgdn/home/end) to the viewport.\n\t\tvar cmd tea.Cmd\n\t\tm.viewport, cmd = m.viewport.Update(msg)\n\t\treturn m, cmd\n\t}\n\treturn m, nil\n}\n\n// refreshViewport re-renders the body into the viewport after a state\n// change. Keeps scroll position at top when the underlying view actually\n// changed (range / agent / mode cycle) so users don't get stranded halfway\n// down a different dataset.\nfunc (m *TUIModel) refreshViewport() {\n\tif !m.ready {\n\t\treturn\n\t}\n\tm.viewport.SetContent(RenderStatic(m.view, m.styles, m.viewport.Width))\n\tm.viewport.GotoTop()\n}\n\n// View renders the scrollable body inside the viewport plus a fixed help\n// line at the bottom. First frame (before WindowSizeMsg arrives) falls back\n// to direct static rendering so there's no blank flash.\nfunc (m TUIModel) View() string {\n\thelp := m.styles.help.Render(\"  1-5 d/w/m  range  ·  a  agent  ·  v  view  ·  ↑↓/pgup/pgdn  scroll  ·  q  quit\")\n\tif !m.ready {\n\t\treturn RenderStatic(m.view, m.styles, m.width) + \"\\n\" + help\n\t}\n\treturn m.viewport.View() + \"\\n\" + help\n}\n\n// rebuildView is a tiny wrapper that anchors Now at call time so range math\n// stays correct across long-running TUI sessions.\nfunc rebuildView(sessions []RecapSession, r RangeKey, agent string, mode ViewMode) View {\n\treturn BuildView(sessions, BuildOpts{Range: r, AgentFilter: agent, Mode: mode, Now: time.Now()})\n}\n\n// cycleMode advances the view mode: both → me → contributors → both.\nfunc cycleMode(current ViewMode) ViewMode {\n\tswitch current {\n\tcase ViewBoth:\n\t\treturn ViewMe\n\tcase ViewMe:\n\t\treturn ViewContributors\n\tcase ViewContributors:\n\t\treturn ViewBoth\n\t}\n\treturn ViewBoth\n}\n\n// cycleAgent advances the filter in a stable round-robin: \"\" → agents[0] →\n// agents[1] → … → \"\". Stable order means the same key press always moves\n// to the same next agent.\nfunc cycleAgent(agents []string, current string) string {\n\tif len(agents) == 0 {\n\t\treturn \"\"\n\t}\n\tif current == \"\" {\n\t\treturn agents[0]\n\t}\n\tfor i, a := range agents {\n\t\tif a == current {\n\t\t\tif i+1 < len(agents) {\n\t\t\t\treturn agents[i+1]\n\t\t\t}\n\t\t\treturn \"\"\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc distinctAgents(sessions []RecapSession) []string {\n\tseen := map[string]bool{}\n\tvar out []string\n\tfor _, s := range sessions {\n\t\tfor _, a := range s.AgentsUsed {\n\t\t\tif !seen[a] {\n\t\t\t\tseen[a] = true\n\t\t\t\tout = append(out, a)\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}\n","structuredPatch":[{"oldStart":107,"oldLines":10,"newStart":107,"newLines":11,"lines":[" }"," "," // refreshViewport re-renders the body into the viewport after a state","-// change. Keeps scroll position at top when the underlying view actually","-// changed (range / agent / mode cycle) so users don't get stranded halfway","-// down a different dataset.","-f