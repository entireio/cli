\n\t\t\t}\n\t\t}\n\t\treturn b.String()\n\t}\n\n\tif you > team {\n\t\tteamCells := cellsFor(team, you, width)\n\t\tyouCells := width - teamCells\n\t\tif team > 0 && teamCells == 0 {\n\t\t\tteamCells = 1\n\t\t\tyouCells = width - 1\n\t\t}\n\t\treturn strings.Repeat(styles.accent.Render(\"█\"), youCells) +\n\t\t\tstrings.Repeat(styles.team.Render(\"▒\"), teamCells)\n\t}\n\n\t// team-dominant: magenta fill width, amber fills start.\n\tyouCells := cellsFor(you, team, width)\n\tif you > 0 && youCells == 0 {\n\t\tyouCells = 1\n\t}\n\tteamCells := width - youCells\n\treturn strings.Repeat(styles.accent.Render(\"█\"), youCells) +\n\t\tstrings.Repeat(styles.team.Render(\"█\"), teamCells)\n}\n\n// cellsFor returns the number of cells that should represent `value` when\n// the total bar is `width` and the larger side is `dominant`. Rounds to nearest\n// integer; returns at least 1 for non-zero values (minimum-1-cell rule).\nfunc cellsFor(value, dominant, width int) int {\n\tif dominant == 0 {\n\t\treturn 0\n\t}\n\tn := (value*width + dominant/2) / dominant\n\tif value > 0 && n == 0 {\n\t\treturn 1\n\t}\n\tif n > width {\n\t\treturn width\n\t}\n\treturn n\n}\n","structuredPatch":[{"oldStart":3,"oldLines":7,"newStart":3,"newLines":7,"lines":[" import \"strings\""," "," const (","-  barMinWidth = 9","+  barMinWidth = 12","   barMaxWidth = 40"," )"," "]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"70e7e1ba-7d24-465a-8d14-046caab5db71","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity","slug":"kind-beaming-shannon"}
