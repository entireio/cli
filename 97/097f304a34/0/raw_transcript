{"parentUuid":"635a2440-1c46-48ff-bb7c-d445bf5e3ec4","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/.worktrees/recap-endpoint/api/src/lib/activity-aggregator.test.ts","snippet":"1\timport { describe, expect, it, vi } from \"vitest\"\n2\t\n3\timport {\n4\t  computeDailyContributions,\n5\t  computeHourlyContributions,\n6\t  computeRepoBreakdown,\n7\t  computeStats,\n8\t  computeStreaks,\n9\t  createTimezoneConverter,\n10\t} from \"./activity-aggregator\"\n11\timport type { UserCheckpoint } from \"./db/checkpoints\"\n12\t\n13\tfunction makeCheckpoint(overrides: Partial<UserCheckpoint> = {}): UserCheckpoint {\n14\t  return {\n15\t    checkpoint_id: \"cp-1\",\n16\t    commit_sha: \"abc123\",\n17\t    commit_message: \"feat: stuff\",\n18\t    commit_date: \"2026-04-15T14:30:00Z\",\n19\t    additions: 10,\n20\t    deletions: 5,\n21\t    files_changed: 3,\n22\t    repo_id: \"repo-1\",\n23\t    repo_full_name: \"org/app\",\n24\t    branch: \"main\",\n25\t    is_private: false,\n26\t    agent: \"Claude Code\",\n27\t    steps: 5,\n28\t    session_count: 2,\n29\t    input_tokens: 10000,\n30\t    output_tokens: 5000,\n31\t    ...overrides,\n32\t  }\n33\t}\n34\t\n35\tconst UTC = createTimezoneConverter(\"UTC\")\n36\tconst NY = createTimezoneConverter(\"America/New_York\")\n37\t\n38\tdescribe(\"computeStats\", () => {\n39\t  it(\"returns zeros for empty checkpoints\", () => {\n40\t    expect(computeStats([])).toEqual({\n41\t      tasks: 0,\n42\t      orchestration: 0,\n43\t      iteration: 0,\n44\t      throughput: 0,\n45\t      continuity_hours: 0,\n46\t    })\n47\t  })\n48\t\n49\t  it(\"computes stats for a single checkpoint\", () => {\n50\t    const stats = computeStats([makeCheckpoint()])\n51\t    expect(stats.tasks).toBe(1)\n52\t    expect(stats.orchestration).toBe(83)\n53\t    expect(stats.iteration).toBe(2)\n54\t    expect(stats.throughput).toBe(15)\n55\t    // makeCheckpoint has steps: 