ers\"`\n45\t\tToolMix          ToolMix      `json:\"toolMix\"`\n46\t}\n47\t\n48\t// SkillCount pairs a skill name with its usage count.\n49\ttype SkillCount struct {\n50\t\tSkill string `json:\"skill\"`\n51\t\tCount int    `json:\"count\"`\n52\t}\n53\t\n54\t// McpCount pairs an MCP server name with its usage count.\n55\ttype McpCount struct {\n56\t\tName  string `json:\"name\"`\n57\t\tCount int    `json:\"count\"`\n58\t}\n59\t\n60\t// ToolMix is the per-agent tool-category usage breakdown returned by\n61\t// /me/recap. Distinct from ToolProfile in model.go (which is the richer\n62\t// per-checkpoint shape from the analysis pipeline).\n63\ttype ToolMix struct {\n64\t\tShell   int `json:\"shell\"`\n65\t\tFileOps int `json:\"fileOps\"`\n66\t\tSearch  int `json:\"search\"`\n67\t\tMCP     int `json:\"mcp\"`\n68\t\tAgent   int `json:\"agent\"`\n69\t\tOther   int `json:\"other\"`\n70\t}\n71\t\n72\t// ContribSummary is the repo-wide rollup returned alongside per-agent\n73\t// data when ?repo= is set. Nil when no repo was specified.\n74\ttype ContribSummary struct {\n75\t\tDistinctUsers    int `json:\"distinctUsers\"`\n76\t\tTotalTokens      int `json:\"totalTokens\"`\n77\t\tTotalCheckpoints int `json:\"totalCheckpoints\"`\n78\t}\n79\t\n80\t// FetchMeRecap calls GET /api/v1/me/recap?timeframe=&repo=&limit= and\n81\t// returns the decoded response. Any error (network, non-2xx, decode)\n82\t// surfaces to the caller; this is the \"fast path\" that replaces the old\n83\t// commits + batch-analyses + overview fetch stack once the server endpoint\n84\t// is deployed.\n85\t//\n86\t// timeframe is one of the values the server accepts (\"last-month\",\n87\t// \"last-3-months\", \"last-6-months\"). repo is \"org/name\" or empty.\n88\tfunc FetchMeRecap(\n89\t\tctx context.Context,\n90\t\tclient *api.Client,\n91\t\ttimeframe, repo string,\n92\t\tlimit int,\n93\t) (*MeRecapResponse, error) {\n94\t\tif client == nil {\n95\t\t\treturn nil, errors.New(\"me/recap: nil client\")\n96\t\t}\n97\t\tq := url.Values{}\n98\t\tif timeframe != \"\" {\n99\t\t\tq.Set(\"timeframe\", timeframe)\n100\t\t}\n101\t\tif repo != \"\" {\n102\t\t\tq.Set(\"repo\", repo)\n103\t\t}\n104\t\tif limit > 0 {\n105\t\t\tq.Set(\"limit\", strconv.Itoa(limit))\n106\t\t}\n107\t\tpath := \"/api/v1/me/recap\"\n108\t\tif encoded := q.Encode(); encoded != \"\" {\n109\t\t\tpath += \"?\" + encoded\n110\t\t}\n111\t\tresp, err := client.Get(ctx, path)\n112\t\tif err != nil {\n113\t\t\treturn nil, fmt.Errorf(\"me/recap get: %w\", err)\n114\t\t}\n115\t\tdefer func() { _ = resp.Body.Close() }()\n116\t\tif resp.StatusCode >= 400 {\n117\t\t\tbody, _ := io.ReadAll(resp.Body) //nolint:errcheck // best-effort error body\n118\t\t\treturn nil, fmt.Errorf(\"me/recap: http %d: %s\", resp.StatusCode, string(body))\n119\t\t}\n120\t\tvar out MeRecapResponse\n121\t\tif err := json.NewDecoder(resp.Body).Decode(&out); err != nil {\n122\t\t\treturn nil, fmt.Errorf(\"me/recap decode: %w\", err)\n123\t\t}\n124\t\treturn &out, nil\n125\t}\n126\t\n127\t// TimeframeForRange maps our RangeKey to the timeframe value the server\n128\t// endpoint accepts. The server only supports last-month / last-3-months /\n129\t// last-6-months today; day / week / month are rounded up to last-month,\n130\t// 90d maps to last-3-months.\n131\tfunc TimeframeForRange(r RangeKey) string {\n132\t\tswitch r {\n133\t\tcase RangeDay, RangeWeek, RangeMonth:\n134\t\t\treturn \"last-month\"\n135\t\tcase Range90d:\n136\t\t\treturn \"last-3-months\"\n137\t\t}\n138\t\treturn \"last-month\"\n139\t}\n140\t\n141\t// ContributorsFromMeRecap converts a MeRecapResponse into the\n142\t// ContributorsData shape the rest of the recap package consumes. This\n143\t// lets us drop in the new endpoint without changing downstream rendering.\n144\tfunc ContributorsFromMeRecap(resp *MeRecapResponse) *ContributorsData {\n145\t\tif resp == nil || len(resp.Agents) == 0 {\n146\t\t\treturn nil\n147\t\t}\n148\t\tout := &ContributorsData{ByAgent: map[string]*AgentContrib{}}\n149\t\tif resp.Repo != nil {\n150\t\t\tout.Repo = *resp.Repo\n151\t\t}\n152\t\tfor name, entry := range resp.Agents {\n153\t\t\tif entry.Contributors == nil {\n154\t\t\t\tcontinue\n155\t\t\t}\n156\t\t\tc := entry.Contributors\n157\t\t\tdistinctContribs := 0\n158\t\t\tif resp.Contributors != nil {\n159\t\t\t\tdistinctContribs = resp.Contributors.DistinctUsers\n160\t\t\t}\n161\t\t\tagg := &AgentContrib{\n162\t\t\t\tTotalCount:       c.Checkpoints,\n163\t\t\t\tTokens:           c.Tokens,\n164\t\t\t\tDistinctContribs: distinctContribs,\n165\t\t\t\tSkills:           flattenSkills(c.Skills),\n166\t\t\t\tMCPServers:       flattenMCP(c.MCPServers),\n167\t\t\t\tToolMix:          toolMixToMap(c.ToolMix),\n168\t\t\t}\n169\t\t\tagg.Labels = append(agg.Labels, c.Labels...)\n170\t\t\tout.ByAgent[name] = agg\n171\t\t}\n172\t\treturn out\n173\t}\n174\t\n175\tfunc flattenSkills(xs []SkillCount) []string {\n176\t\tout := make([]string, 0, len(xs))\n177\t\tfor _, x := range xs {\n178\t\t\tout = append(out, x.Skill)\n179\t\t}\n180\t\tif len(out) > 3 {\n181\t\t\tout = out[:3]\n182\t\t}\n183\t\treturn out\n184\t}\n185\t\n186\tfunc flattenMCP(xs []McpCount) []string {\n187\t\tout := make([]string, 0, len(xs))\n188\t\tfor _, x := range xs {\n189\t\t\tout = append(out, x.Name)\n190\t\t}\n191\t\tif len(out) > 3 {\n192\t\t\tout = out[:3]\n193\t\t}\n194\t\treturn out\n195\t}\n196\t\n197\tfunc toolMixToMap(t ToolMix) map[string]int {\n198\t\treturn map[string]int{\n199\t\t\t\"shell\":   t.Shell,\n200\t\t\t\"fileOps\": t.FileOps,\n201\t\t\t\"search\":  t.Search,\n202\t\t\t\"mcp\":     t.MCP,\n203\t\t\t\"agent\":   t.Agent,\n204\t\t\t\"other\":   t.Other,\n205\t\t}\n206\t}"},"type":"attachment","uuid":"685132d9-865c-4669-b8bf-fbb9774a16ab","timestamp":"2026-04-23T05:35:43.093Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"e