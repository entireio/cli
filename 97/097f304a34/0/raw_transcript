{"parentUuid":"5c74ae7a-e4c3-4f28-b114-8fd976206c3c","isSidechain":false,"attachment":{"type":"file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/me_recap.go","content":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/me_recap.go","content":"package recap\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/url\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/api\"\n)\n\n// RecapEndpointResponse mirrors the shape returned by\n// GET /api/v1/me/recap on entire.io. Bearer-auth, repo-scoped (optional).\n//\n// Mirrors api/src/routes/recap.ts + api/src/lib/recap-aggregator.ts on the\n// server. Keep these types in sync when either side changes.\ntype RecapEndpointResponse struct {\n\tTimeframe   string                     `json:\"timeframe\"`\n\tRepo        *string                    `json:\"repo\"`\n\tAgents      map[string]RecapAgentEntry `json:\"agents\"`\n\tContributors *RecapContribSummary       `json:\"contributors\"`\n\tUpdatedAt   string                     `json:\"updated_at\"`\n}\n\n// RecapAgentEntry is one agent row with both me + contributors columns.\ntype RecapAgentEntry struct {\n\tMe           RecapAgentAggregate  `json:\"me\"`\n\tContributors *RecapAgentAggregate `json:\"contributors\"`\n}\n\n// RecapAgentAggregate is the per-side per-agent payload. transcriptTokens\n// and filesChanged are the deterministic \"survives LLM-off\" fields;\n// labels require LLM analysis to be complete.\ntype RecapAgentAggregate struct {\n\tCheckpoints      int               `json:\"checkpoints\"`\n\tTokens           int               `json:\"tokens\"`\n\tTranscriptTokens int               `json:\"transcriptTokens\"`\n\tFilesChanged     int               `json:\"filesChanged\"`\n\tLabels           []RecapLabelCount `json:\"labels\"`\n\tSkills           []RecapSkillCount `json:\"skills\"`\n\tMCPServers       []RecapMcpCount   `json:\"mcpServers\"`\n\tToolMix          RecapToolMix      `json:\"toolMix\"`\n}\n\ntype RecapLabelCount struct {\n\tLabel string `json:\"label\"`\n\tCount int    `json:\"count\"`\n}\ntype RecapSkillCount struct {\n\tSkill string `json:\"skill\"`\n\tCount int    `json:\"count\"`\n}\ntype RecapMcpCount struct {\n\tName  string `json:\"name\"`\n\tCount int    `json:\"count\"`\n}\ntype RecapToolMix struct {\n\tShell   int `json:\"shell\"`\n\tFileOps int `json:\"fileOps\"`\n\tSearch  int `json:\"search\"`\n\tMCP     int `json:\"mcp\"`\n\tAgent   int `json:\"agent\"`\n\tOther   int `json:\"other\"`\n}\n\n// RecapContribSummary is the repo-wide rollup returned alongside per-agent\n// data when ?repo= is set. Nil when no repo was specified.\ntype RecapContribSummary struct {\n\tDistinctUsers    int `json:\"distinctUsers\"`\n\tTotalTokens      int `json:\"totalTokens\"`\n\tTotalCheckpoints int `json:\"totalCheckpoints\"`\n}\n\n// FetchMeRecap calls GET /api/v1/me/recap?timeframe=&repo=&limit= and\n// returns the decoded response. Any error (network, non-2xx, decode)\n// surfaces to the caller; this is the \"fast path\" that replaces the old\n// commits + batch-analyses + overview fetch stack once the server endpoint\n// is deployed.\n//\n// timeframe is one of the values the server accepts (\"last-month\",\n// \"last-3-months\", \"last-6-months\"). repo is \"org/name\" or empty.\nfunc FetchMeRecap(\n\tctx context.Context,\n\tclient *api.Client,\n\ttimeframe, repo string,\n\tlimit int,\n) (*RecapEndpointResponse, error) {\n\tif client == nil {\n\t\treturn nil, fmt.Errorf(\"me/recap: nil client\")\n\t}\n\tq := url.Values{}\n\tif timeframe != \"\" {\n\t\tq.Set(\"timeframe\", timeframe)\n\t}\n\tif repo != \"\" {\n\t\tq.Set(\"repo\", repo)\n\t}\n\tif limit > 0 {\n\t\tq.Set(\"limit\", fmt.Sprintf(\"%d\", limit))\n\t}\n\tpath := \"/api/v1/me/recap\"\n\tif encoded := q.Encode(); encoded != \"\" {\n\t\tpath += \"?\" + encoded\n\t}\n\tresp, err := client.Get(ctx, path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"me/recap get: %w\", err)\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\tif resp.StatusCode >= 400 {\n\t\tbody, _ := io.ReadAll(resp.Body) //nolint:errcheck // best-effort error body\n\t\treturn nil, fmt.Errorf(\"me/recap: http %d: %s\", resp.StatusCode, string(body))\n\t}\n\tvar out RecapEndpointResponse\n\tif err := json.NewDecoder(resp.Body).Decode(&out); err != nil {\n\t\treturn nil, fmt.Errorf(\"me/recap decode: %w\", err)\n\t}\n\treturn &out, nil\n}\n\n// TimeframeForRange maps our RangeKey to the timeframe value the server\n// endpoint accepts. The server only supports last-month / last-3-months /\n// last-6-months today; day / week / 30d / 90d are rounded up to the\n// smallest server timeframe that contains them.\nfunc TimeframeForRange(r RangeKey) string {\n\tswitch r {\n\tcase RangeDay, RangeWeek, Range30d, RangeMonth:\n\t\treturn \"last-month\"\n\tcase Range90d:\n\t\treturn \"last-3-months\"\n\t}\n\treturn \"last-month\"\n}\n\n// ContributorsFromMeRecap converts a RecapEndpointResponse into the\n// ContributorsData shape the rest of the recap package consumes. This\n// lets us drop in the new endpoint without changing downstream rendering.\nfunc ContributorsFromMeRecap(resp *RecapEndpointResponse) *ContributorsData {\n\tif resp == nil || len(resp.Agents) == 0 {\n\t\treturn nil\n\t}\n\tout := &ContributorsData{ByAgent: map[string]*AgentContrib{}}\n\tif resp.Repo != nil {\n\t\tout.Repo = *resp.Repo\n\t}\n\tfor name, entry := range resp.Agents {\n\t\tif entry.Contributors == nil {\n\t\t\tcontinue\n\t\t}\n\t\tc := entry.Contributors\n\t\tdistinctContribs := 0\n\t\tif resp.Contributors != nil {\n\t\t\tdistinctContribs = resp.Contributors.DistinctUsers\n\t\t}\n\t\tagg := &AgentContrib{\n\t\t\tTotalCount:       c.Checkpoints,\n\t\t\tTokens:           c.Tokens,\n\t\t\tDistinctContribs: distinctContribs,\n\t\t\tSkills:           flattenSkills(c.Skills),\n\t\t\tMCPServers:       flattenMCP(c.MCPServers),\n\t\t\tToolMix:          toolMixToMap(c.ToolMix),\n\t\t}\n\t\tfor _, l := range c.Labels {\n\t\t\tagg.Labels = append(agg.Labels, LabelCount{Label: l.Label, Count: l.Count})\n\t\t}\n\t\tout.ByAgent[name] = agg\n\t}\n\treturn out\n}\n\nfunc flattenSkills(xs []RecapSkillCount) []string {\n\tout := make([]string, 0, len(xs))\n\tfor _, x := range xs {\n\t\tout = append(out, x.Skill)\n\t}\n\tif len(out) > 3 {\n\t\tout = out[:3]\n\t}\n\treturn out\n}\n\nfunc flattenMCP(xs []RecapMcpCount) []string {\n\tout := make([]string, 0, len(xs))\n\tfor _, x := range xs {\n\t\tout = append(out, x.Name)\n\t}\n\tif len(out) > 3 {\n\t\tout = out[:3]\n\t}\n\treturn out\n}\n\nfunc toolMixToMap(t RecapToolMix) map[string]int {\n\treturn map[string]int{\n\t\t\"shell\":   t.Shell,\n\t\t\"fileOps\": t.FileOps,\n\t\t\"search\":  t.Search,\n\t\t\"mcp\":     t.MCP,\n\t\t\"agent\":   t.Agent,\n\t\t\"other\":   t.Other,\n\t}\n}\n\n// Suppress unused import when time is removed; keep the import path\n// available for downstream helpers that may need it.\nvar _ = time.Second\n","numLines":209,"startLine":1,"totalLines":209}},"displayPath":"cmd/entire/cli/recap/me_recap.go"},"type":"attachment","uuid":"ba759d3a-562d-4799-bebd-95282bd42bbb","timestamp":"2026-04-23T01:09:47.422Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity","slug":"kind-beaming-shannon"}
