{"parentUuid":"de7b256a-e88c-4f63-a424-e1a60273b38d","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/contributors.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/url\"\n9\t\t\"strings\"\n10\t\t\"sync\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/api\"\n14\t)\n15\t\n16\t// ContributorsData is the per-agent roll-up fetched from the entire.io\n17\t// repo-overview endpoints. Keyed by canonical agent name (e.g. \"claude-code\").\n18\t// Empty map = no data (not logged in, repo not tracked, or empty window).\n19\ttype ContributorsData struct {\n20\t\tRepo    string\n21\t\tByAgent map[string]*AgentContrib\n22\t}\n23\t\n24\t// AgentContrib is what the contributors column shows per agent. Mirrors the\n25\t// shape of the \"me\" side of AgentCard but populated from server data.\n26\ttype AgentContrib struct {\n27\t\tTotalCount       int // activity events (checkpoints or commits, depending on endpoint)\n28\t\tTokens           int\n29\t\tDistinctContribs int\n30\t}\n31\t\n32\t// FetchContributors pulls the three repo-overview endpoints in parallel and\n33\t// merges them into a per-agent summary. Any endpoint failure degrades to an\n34\t// empty result — this is optional enrichment, never a hard error.\n35\t//\n36\t// The repo argument is \"<owner>/<name>\" as resolved by ResolveRepoFromWorktree.\n37\t// Returns (nil, nil) for an empty repo string so the command can pass whatever\n38\t// ResolveRepoFromWorktree returned without a pre-check.\n39\tfunc FetchContributors(\n40\t\tctx context.Context,\n41\t\tclient *api.Client,\n42\t\trepo string,\n43\t\tstart, end time.Time,\n44\t) (*ContributorsData, error) {\n45\t\tif client == nil || repo == \"\" || repo == repoUnknown {\n46\t\t\treturn nil, nil //nolint:nilnil // optional data; no-op call is a valid state\n47\t\t}\n48\t\tparts := strings.SplitN(repo, \"/\", 2)\n49\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\n50\t\t\treturn nil, fmt.Errorf(\"contributors: invalid repo %q (want \\\"org/name\\\")\", repo)\n51\t\t}\n52\t\torg, name := url.PathEscape(parts[0]), url.PathEscape(parts[1])\n53\t\tparams := fmt.Sprintf(\"?since=%s&until=%s\",\n54\t\t\turl.QueryEscape(start.Format(time.RFC3339)),\n55\t\t\turl.QueryEscape(end.Format(time.RFC3339)))\n56\t\n57\t\tvar (\n58\t\t\twg       sync.WaitGroup\n59\t\t\tmu       sync.Mutex\n60\t\t\tagentAct *agentActivityResponse\n61\t\t\tcontribA *contributorAgentsResponse\n62\t\t\tcontribT *contributorTokensResponse\n63\t\t\tfirstErr error\n64\t\t)\n65\t\tset := func(err error) {\n66\t\t\tmu.Lock()\n67\t\t\tdefer mu.Unlock()\n68\t\t\tif err != nil && firstErr == nil {\n69\t\t\t\tfirstErr = err\n70\t\t\t}\n71\t\t}\n72\t\n73\t\twg.Add(3)\n74\t\tgo func() {\n75\t\t\tdefer wg.Done()\n76\t\t\tout, err := fetchJSON[agentActivityResponse](ctx, client,\n77\t\t\t\tfmt.Sprintf(\"/%s/%s/overview/agent-activity%s\", org, name, params))\n78\t\t\tmu.Lock()\n79\t\t\tagentAct = out\n80\t\t\tmu.Unlock()\n81\t\t\tset(err)\n82\t\t}()\n83\t\tgo func() {\n84\t\t\tdefer wg.Done()\n85\t\t\tout, err := fetchJSON[contributorAgentsResponse](ctx, client,\n86\t\t\t\tfmt.Sprintf(\"/%s/%s/overview/contributor-agents%s\", org, name, params))\n87\t\t\tmu.Lock()\n88\t\t\tcontribA = out\n89\t\t\tmu.Unlock()\n90\t\t\tset(err)\n91\t\t}()\n92\t\tgo func() {\n93\t\t\tdefer wg.Done()\n94\t\t\tout, err := fetchJSON[contributorTokensResponse](ctx, client,\n95\t\t\t\tfmt.Sprintf(\"/%s/%s/overview/contributor-tokens%s\", org, name, params))\n96\t\t\tmu.Lock()\n97\t\t\tcontribT = out\n98\t\t\tmu.Unlock()\n99\t\t\tset(err)\n100\t\t}()\n101\t\twg.Wait()\n102\t\n103\t\tif firstErr != nil {\n104\t\t\treturn nil, firstErr\n105\t\t}\n106\t\treturn mergeContributors(repo, agentAct, contribA, contribT), nil\n107\t}\n108\t\n109\t// mergeContributors collapses the three response shapes into the per-agent\n110\t// AgentContrib map. Missing inputs degrade to zero-valued fields rather than\n111\t// dropping the agent — a card with \"7 sessions · — tokens · 3 contributors\"\n112\t// is better than silently omitting the agent.\n113\tfunc mergeContributors(\n114\t\trepo string,\n115\t\tact *agentActivityResponse,\n116\t\tagents *contributorAgentsResponse,\n117\t\ttokens *contributorTokensResponse,\n118\t) *ContributorsData {\n119\t\tout := &ContributorsData{Repo: repo, ByAgent: map[string]*AgentContrib{}}\n120\t\tbyAgent := out.ByAgent\n121\t\n122\t\tif act != nil {\n123\t\t\tfor _, d := range act.Daily {\n124\t\t\t\tif d.Agent == \"\" {\n125\t\t\t\t\tcontinue\n126\t\t\t\t}\n127\t\t\t\ta, ok := byAgent[d.Agent]\n128\t\t\t\tif !ok {\n129\t\t\t\t\ta = &AgentContrib{}\n130\t\t\t\t\tbyAgent[d.Agent] = a\n131\t\t\t\t}\n132\t\t\t\ta.TotalCount += d.Count\n133\t\t\t\ta.Tokens += d.Tokens\n134\t\t\t}\n135\t\t}\n136\t\n137\t\t// Distinct contributors per agent: walk contributor-agents and count any\n138\t\t// contributor whose agents map includes that agent with > 0 commits.\n139\t\tif agents != nil {\n140\t\t\tagentDistinct := map[string]int{}\n141\t\t\tfor _, c := range agents.Contributors {\n142\t\t\t\tfor agentName, cnt := range c.Agents {\n143\t\t\t\t\tif cnt > 0 {\n144\t\t\t\t\t\tagentDistinct[agentName]++\n145\t\t\t\t\t}\n146\t\t\t\t}\n147\t\t\t}\n148\t\t\tfor agentName, distinct := range agentDistinct {\n149\t\t\t\ta, ok := byAgent[agentName]\n150\t\t\t\tif !ok {\n151\t\t\t\t\ta = &AgentContrib{}\n152\t\t\t\t\tbyAgent[agentName] = a\n153\t\t\t\t}\n154\t\t\t\ta.DistinctContribs = distinct\n155\t\t\t}\n156\t\t}\n157\t\n158\t\t// contributor-tokens is user-scoped (sum across all agents per user), not\n159\t\t// per-agent. We surface it separately via ContributorsData.TotalTokens\n160\t\t// aggregates if callers need it — today AgentCard.ContribTokens already\n161\t\t// came from agent-activity above, which is more accurate per-agent.\n162\t\t_ = tokens\n163\t\n164\t\treturn out\n165\t}\n166\t\n167\t// response types — minimal shapes matching entire.io/api/src/routes/repo-overview.ts ---------\n168\t\n169\ttype agentActivityResponse struct {\n170\t\tDaily []struct {\n171\t\t\tDate         string `json:\"date\"`\n172\t\t\tAgent        string `json:\"agent\"`\n173\t\t\tCount        int    `json:\"count\"`\n174\t\t\tTokens       int    `json:\"tokens\"`\n175\t\t\tInputTokens  int    `json:\"inputTokens\"`\n176\t\t\tOutputTokens int    `json:\"outputTokens\"`\n177\t\t} `json:\"daily\"`\n178\t}\n179\t\n180\ttype contributorAgentsResponse struct {\n181\t\tTotalCommits int `json:\"total_commits\"`\n182\t\tContributors []struct {\n183\t\t\tUsername     *string        `json:\"username\"`\n184\t\t\tGithubID     *int           `json:\"github_id\"`\n185\t\t\tTotalCommits int            `json:\"total_commits\"`\n186\t\t\tAgents       map[string]int `json:\"agents\"`\n187\t\t\tUntracked    int            `json:\"untracked\"`\n188\t\t} `json:\"contributors\"`\n189\t}\n190\t\n191\ttype contributorTokensResponse struct {\n192\t\tContributors []struct {\n193\t\t\tUsername     *string `json:\"username\"`\n194\t\t\tGithubID     *int    `json:\"github_id\"`\n195\t\t\tInputTokens  int     `json:\"input_tokens\"`\n196\t\t\tOutputTokens int     `json:\"output_tokens\"`\n197\t\t} `json:\"contributors\"`\n198\t}\n199\t\n200\t// fetchJSON is a tiny generic GET+decode helper kept in this file because it's\n201\t// only used for the three overview calls. If a second consumer appears, move\n202\t// it to the api package.\n203\tfunc fetchJSON[T any](ctx context.Context, client *api.Client, path string) (*T, error) {\n204\t\tresp, err := client.Get(ctx, path)\n205\t\tif err != nil {\n206\t\t\treturn nil, fmt.Errorf(\"contributors get %s: %w\", path, err)\n207\t\t}\n208\t\tdefer func() { _ = resp.Body.Close() }()\n209\t\tif resp.StatusCode >= 400 {\n210\t\t\tbody, _ := io.ReadAll(resp.Body) //nolint:errcheck // best-effort