sNamespace {\n  return {\n    async findByTokenHash(hash: string) {\n      const row = await db\n        .selectFrom(\"api_tokens\")\n        .select([\"id\", \"user_id\", \"scope\", \"expires_at\", \"last_used_at\"])\n        .where(\"token_hash\", \"=\", hash)\n        .executeTakeFirst()\n      if (!row) return null\n      return {\n        id: row.id,\n        user_id: row.user_id,\n        scope: row.scope,\n        expires_at: row.expires_at.toISOString(),\n        last_used_at: row.last_used_at?.toISOString() ?? null,\n      }\n    },\n\n    async updateLastUsedAt(id: string) {\n      assertValidUuid(id, \"apiTokenId\")\n      await db\n        .updateTable(\"api_tokens\")\n        .set({ last_used_at: new Date() })\n        .where(\"id\", \"=\", id)\n        .execute()\n    },\n\n    async create(data) {\n      const id = generateId()\n      await db\n        .insertInto(\"api_tokens\")\n        .values({\n          id,\n          user_id: data.userId,\n          token_hash: data.tokenHash,\n          name: data.name,\n          scope: data.scope,\n          expires_at: new Date(data.expiresAt),\n        })\n        .execute()\n      const row = await db\n        .selectFrom(\"api_tokens\")\n        .select([\"id\", \"user_id\", \"name\", \"scope\", \"expires_at\", \"last_used_at\", \"created_at\"])\n        .where(\"id\", \"=\", id)\n        .executeTakeFirstOrThrow()\n      return rowToApiToken(row)\n    },\n\n    async listForUser(userId: string) {\n      assertValidUuid(userId, \"userId\")\n      const rows = await db\n        .selectFrom(\"api_tokens\")","numLines":80,"startLine":1,"totalLines":101}},"sourceToolAssistantUUID":"4ddade37-4aab-4c0c-bb5a-5f5f9dc519f2","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity","slug":"kind-beaming-shannon"}
