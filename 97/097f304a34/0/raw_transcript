append(out, k)\n\t}\n\tsort.Slice(out, func(i, j int) bool {\n\t\tif thisCounts[out[i]] != thisCounts[out[j]] {\n\t\t\treturn thisCounts[out[i]] > thisCounts[out[j]]\n\t\t}\n\t\treturn out[i] < out[j]\n\t})\n\treturn out\n}\n\n// LongestStreak returns the longest run of consecutive calendar days (in\n// sessions' timezone) with any session activity, and the streak's start date.\n// When labelFilter is non-empty, only sessions whose checkpoints carry that\n// label contribute. Returns (0, zero time) when no qualifying days exist.\nfunc LongestStreak(sessions []RecapSession, labelFilter string) (int, time.Time) {\n\tdays := map[string]time.Time{}\n\tfor _, s := range sessions {\n\t\tif labelFilter != \"\" && !sessionHasLabel(s, labelFilter) {\n\t\t\tcontinue\n\t\t}\n\t\tif s.StartedAt.IsZero() {\n\t\t\tcontinue\n\t\t}\n\t\td := dayKey(s.StartedAt)\n\t\tif _, ok := days[d]; !ok {\n\t\t\tdays[d] = time.Date(s.StartedAt.Year(), s.StartedAt.Month(), s.StartedAt.Day(), 0, 0, 0, 0, s.StartedAt.Location())\n\t\t}\n\t}\n\tif len(days) == 0 {\n\t\treturn 0, time.Time{}\n\t}\n\tordered := make([]time.Time, 0, len(days))\n\tfor _, t := range days {\n\t\tordered = append(ordered, t)\n\t}\n\tsort.Slice(ordered, func(i, j int) bool { return ordered[i].Before(ordered[j]) })\n\n\tbestLen := 1\n\tbestStart := ordered[0]\n\tcurLen := 1\n\tcurStart := ordered[0]\n\tfor i := 1; i < len(ordered); i++ {\n\t\tif ordered[i].Sub(ordered[i-1]) == 24*time.Hour {\n\t\t\tcurLen++\n\t\t} else {\n\t\t\tif curLen > bestLen {\n\t\t\t\tbestLen = curLen\n\t\t\t\tbestStart = curStart\n\t\t\t}\n\t\t\tcurLen = 1\n\t\t\tcurStart = ordered[i]\n\t\t}\n\t}\n\tif curLen > bestLen {\n\t\tbestLen = curLen\n\t\tbestStart = curStart\n\t}\n\treturn bestLen, bestStart\n}\n\n// MostActiveDay returns the day-of-week with the highest checkpoint count\n// across all sessions in the slice. Returns (Sunday, 0) when input is empty\n// so callers can treat zero-count as \"no data.\"\nfunc MostActiveDay(sessions []RecapSession) (time.Weekday, int) {\n\tcounts := [7]int{}\n\tfor _, s := range sessions {\n\t\tfor _, cp := range s.Checkpoints {\n\t\t\tcounts[cp.CreatedAt.Weekday()]++\n\t\t}\n\t}\n\tbestIdx := 0\n\tfor i := 1; i < 7; i++ {\n\t\tif counts[i] > counts[bestIdx] {\n\t\t\tbestIdx = i\n\t\t}\n\t}\n\treturn time.Weekday(bestIdx), counts[bestIdx]\n}\n\n// Delta describes a period-over-period change in an integer metric.\n// Used for WoW arrows in the Week tab header. Sign of Change matches\n// Direction for easy rendering.\ntype Delta struct {\n\tCurrent   int\n\tPrior     int\n\tChange    float64 // (Current - Prior) / Prior; 0 when Prior == 0\n\tDirection int     // -1, 0, +1\n}\n\n// WeekOverWeekDelta compares two integer week totals and returns a Delta.\n// Prior == 0 with Current > 0 yields Direction +1 but Change 0 (infinity\n// isn't renderable); callers show \"new this week\" instead of a percentage.\nfunc WeekOverWeekDelta(current, prior int) Delta {\n\td := Delta{Current: current, Prior: prior}\n\tif prior > 0 {\n\t\td.Change = float64(current-prior) / float64(prior)\n\t}\n\tswitch {\n\tcase current > prior:\n\t\td.Direction = 1\n\tcase current < prior:\n\t\td.Direction = -1\n\t}\n\treturn d\n}\n\n// ActionHint names a primary next action to surface on a session row.\n// One hint per session — determined by NextAction's priority ordering.\ntype ActionHint string\n\nconst (\n\tActionNone    ActionHint = \"\"\n\tActionResume  ActionHint = \"resume\"\n\tActionCommit  ActionHint = \"commit\"\n\tActionPush    ActionHint = \"push\"\n\tActionClean   ActionHint = \"clean\"\n)\n\n// NextAction picks a single primary action for the session. First match\n// wins, so order reflects priority:\n//\n//  1. Commit  — has checkpoints that aren't linked to any commit yet\n//  2. Push    — checkpoints linked locally but not yet on remote\n//               (caller populates via a future \"pushed\" marker — today\n//               this path is dormant; we still encode the priority\n//               so rendering can wire it later without re-ordering)\n//  3. Clean   — ended >7 days ago with no follow-up activity\n//  4. Resume  — idle/active session with no pending commits\n//  5. None    — otherwise\nfunc NextAction(s RecapSession) ActionHint {\n\tif hasUncommittedCheckpoints(s) {\n\t\treturn ActionCommit\n\t}\n\tif s.EndedAt != nil && time.Since(*s.EndedAt) > 7*24*time.Hour {\n\t\treturn ActionClean\n\t}\n\tif s.IsActive || s.Phase == \"IDLE\" {\n\t\treturn ActionResume\n\t}\n\treturn ActionNone\n}\n\n// IdleWithUncommitted returns sessions where work has paused but checkpoints\n// haven't been linked to commits — the \"come back and commit this\" list.\nfunc IdleWithUncommitted(sessions []RecapSession) []RecapSession {\n\tvar out []RecapSession\n\tfor _, s := range sessions {\n\t\tif !hasUncommittedCheckpoints(s) {\n\t\t\tcontinue\n\t\t}\n\t\tif s.IsActive || s.Phase == \"IDLE\" || s.EndedAt != nil {\n\t\t\tout = append(out, s)\n\t\t}\n\t}\n\treturn out\n}\n\n// helpers (package-private) ---------------------------------------------------\n\nfunc topKV(counts map[string]int) (string, int) {\n\tif len(counts) == 0 {\n\t\treturn \"\", 0\n\t}\n\ttype kv struct {\n\t\tk string\n\t\tv int\n\t}\n\tall := make([]kv, 0, len(counts))\n\tfor k, v := range counts {\n\t\tall = append(all, kv{k, v})\n\t}\n\tsort.Slice(all, func(i, j int) bool {\n\t\tif all[i].v != all[j].v {\n\t\t\treturn all[i].v > all[j].v\n\t\t}\n\t\treturn all[i].k < all[j].k\n\t})\n\treturn all[0].k, all[0].v\n}\n\nfunc sessionHasLabel(s RecapSession, label string) bool {\n\tfor _, cp := range s.Checkpoints {\n\t\tfor _, lbl := range cp.Labels {\n\t\t\tif lbl == label {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\nfunc dayKey(t time.Time) string {\n\treturn t.Format(\"2006-01-02\")\n}\n\nfunc hasUncommittedCheckpoints(s RecapSession) bool {\n\tfor _, cp := range s.Checkpoints {\n\t\tif cp.LinkedCommit == \"\" {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","userModi