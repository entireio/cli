{"parentUuid":"f0193782-da49-4e88-8bcc-190732d6602f","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/contributors.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/url\"\n9\t\t\"strings\"\n10\t\t\"sync\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/api\"\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n15\t)\n16\t\n17\t// ContributorsData is the per-agent roll-up fetched from the entire.io\n18\t// repo-overview endpoints. Keyed by canonical agent name (e.g. \"claude-code\").\n19\t// Empty map = no data (not logged in, repo not tracked, or empty window).\n20\ttype ContributorsData struct {\n21\t\tRepo    string\n22\t\tByAgent map[string]*AgentContrib\n23\t}\n24\t\n25\t// AgentContrib is what the contributors column shows per agent. Mirrors the\n26\t// shape of the \"me\" side of AgentCard but populated from server data.\n27\t//\n28\t// The \"breadth\" fields (Labels, Skills, MCPServers, ToolMix) are aggregated\n29\t// client-side by collecting every checkpoint ID in the repo for the range,\n30\t// batch-fetching their analyses, and grouping by the agent that produced\n31\t// each checkpoint. No per-agent aggregation exists server-side for these.\n32\ttype AgentContrib struct {\n33\t\tTotalCount       int // activity events from agent-activity daily count\n34\t\tTokens           int\n35\t\tDistinctContribs int\n36\t\n37\t\tLabels     []LabelCount\n38\t\tSkills     []string\n39\t\tMCPServers []string\n40\t\tToolMix    map[string]int // category (shell/fileOps/…) → count\n41\t}\n42\t\n43\t// FetchContributors pulls the three repo-overview endpoints in parallel and\n44\t// merges them into a per-agent summary. Any endpoint failure degrades to an\n45\t// empty result — this is optional enrichment, never a hard error.\n46\t//\n47\t// The repo argument is \"<owner>/<name>\" as resolved by ResolveRepoFromWorktree.\n48\t// Returns (nil, nil) for an empty repo string so the command can pass whatever\n49\t// ResolveRepoFromWorktree returned without a pre-check.\n50\tfunc FetchContributors(\n51\t\tctx context.Context,\n52\t\tclient *api.Client,\n53\t\trepo string,\n54\t\tstart, end time.Time,\n55\t) (*ContributorsData, error) {\n56\t\tif client == nil || repo == \"\" || repo == repoUnknown {\n57\t\t\treturn nil, nil //nolint:nilnil // optional data; no-op call is a valid state\n58\t\t}\n59\t\tparts := strings.SplitN(repo, \"/\", 2)\n60\t\tif len(parts) != 2 || parts[0] == \"\" || parts[1] == \"\" {\n61\t\t\treturn nil, fmt.Errorf(\"contributors: invalid repo %q (want \\\"org/name\\\")\", repo)\n62\t\t}\n63\t\torg, name := url.PathEscape(parts[0]), url.PathEscape(parts[1])\n64\t\tparams := fmt.Sprintf(\"?since=%s&until=%s\",\n65\t\t\turl.QueryEscape(start.Format(time.RFC3339)),\n66\t\t\turl.QueryEscape(end.Format(time.RFC3339)))\n67\t\t// Routes are mounted server-side at /api/v1/cache/:org/:repo/overview/*\n68\t\t// (see api/src/app.ts: v1.route(\"/cache\", cacheRoutes), then\n69\t\t// cacheRoutes.route(\"/\", overviewRoutes)). Missing this prefix yielded\n70\t\t// silent 404s that surfaced as \"repo may not be tracked\" in v1.\n71\t\tbase := fmt.Sprintf(\"/api/v1/cache/%s/%s/overview\", org, name)\n72\t\n73\t\tvar (\n74\t\t\twg       sync.WaitGroup\n75\t\t\tmu       sync.Mutex\n76\t\t\tagentAct *agentActivityResponse\n77\t\t\tcontribA *contributorAgentsResponse\n78\t\t\tcontribT *contributorTokensResponse\n79\t\t\tfirstErr error\n80\t\t)\n81\t\tset := func(err error) {\n82\t\t\tmu.Lock()\n83\t\t\tdefer mu.Unlock()\n84\t\t\tif err != nil && firstErr == nil {\n85\t\t\t\tfirstErr = err\n86\t\t\t}\n87\t\t}\n88\t\n89\t\tvar commitsResp *commitsResponse\n90\t\n91\t\twg.Add(4)\n92\t\tgo func() {\n93\t\t\tdefer wg.Done()\n94\t\t\t// /commits returns commits + their checkpoints (with agent field),\n95\t\t\t// which we then batch into /checkpoints/analyses/batch to get labels,\n96\t\t\t// skills, MCP servers, and tool profile per agent.\n97\t\t\tout, err := fetchJSON[commitsResponse](ctx, client,\n98\t\t\t\tfmt.Sprintf(\"/api/v1/cache/%s/%s/commits?branch=main&since=%s&until=%s\",\n99\t\t\t\t\torg, name,\n100\t\t\t\t\turl.QueryEscape(start.Format(time.RFC3339)),\n101\t\t\t\t\turl.QueryEscape(end.Format(time.RFC3339))))\n102\t\t\tmu.Lock()\n103\t\t\tcommitsResp = out\n104\t\t\tmu.Unlock()\n105\t\t\tset(err)\n106\t\t}()\n107\t\tgo func() {\n108\t\t\tdefer wg.Done()\n109\t\t\tout, err := fetchJSON[agentActivityResponse](ctx, client, base+\"/agent-activity\"+params)\n110\t\t\tmu.Lock()\n111\t\t\tagentAct = out\n112\t\t\tmu.Unlock()\n113\t\t\tset(err)\n114\t\t}()\n115\t\tgo func() {\n116\t\t\tdefer wg.Done()\n117\t\t\tout, err := fetchJSON[contributorAgentsResponse](ctx, client, base+\"/contributor-agents\"+params)\n118\t\t\tmu.Lock()\n119\t\t\tcontribA = out\n120\t\t\tmu.Unlock()\n121\t\t\tset(err)\n122\t\t}()\n123\t\tgo func() {\n124\t\t\tdefer wg.Done()\n125\t\t\tout, err := fetchJSON[contributorTokensResponse](ctx, client, base+\"/contributor-tokens\"+params)\n126\t\t\tmu.Lock()\n127\t\t\tcontribT = out\n128\t\t\tmu.Unlock()\n129\t\t\tset(err)\n130\t\t}()\n131\t\twg.Wait()\n132\t\n133\t\tif firstErr != nil {\n134\t\t\treturn nil, firstErr\n135\t\t}\n136\t\n137\t\t// Second-stage: batch-fetch analyses for every checkpoint we got via\n138\t\t// /commits. Aggregate labels/skills/MCP/toolProfile by agent. Runs after\n139\t\t// the first parallel wave so we know which checkpoint IDs to request.\n140\t\tanalysesByAgent := fetchAgentAnalysisAggregates(ctx, client, repo, commitsResp)\n141\t\n142\t\treturn mergeContributors(repo, agentAct, contribA, contribT, analysesByAgent), nil\n143\t}\n144\t\n145\t// fetchAgentAnalysisAggregates collects checkpoint IDs by agent from the\n146\t// /commits response, batch-fetches their analyses via\n147\t// POST /api/v1/cache/checkpoints/analyses/batch, and returns a per-agent\n148\t// aggregate of labels, skills, MCP servers, and tool-profile categories.\n149\t//\n150\t// Batch size is capped server-side at 200, so we chunk. A failed chunk logs\n151\t// at debug and skips forward — partial aggregates are better than nothing.\n152\tfunc fetchAgentAnalysisAggregates(\n153\t\tctx context.Context,\n154\t\tclient *api.Client,\n155\t\trepo string,\n156\t\tcommits *commitsResponse,\n157\t) map[string]*agentAnalysisAgg {\n158\t\tout := map[string]*agentAnalysisAgg{}\n159\t\tif commits == nil {\n160\t\t\treturn out\n161\t\t}\n162\t\n163\t\t// Map each checkpoint ID to its producing agent.\n164\t\tagentByCP := map[string]string{}\n165\t\tfor _, c := range commits.Commits {\n166\t\t\tfor _, cp := range c.Checkpoints {\n167\t\t\t\tif cp.CheckpointID == \"\" || cp.Agent == \"\" {\n168\t\t\t\t\tcontinue\n169\t\t\t\t}\n170\t\t\t\tagentByCP[cp.CheckpointID] = cp.Agent\n171\t\t\t}\n172\t\t}\n173\t\tif len(agentByCP) == 0 {\n174\t\t\treturn out\n175\t\t}\n176\t\n177\t\tids := make([]string, 0, len(agentByCP))\n178\t\tfor id := range agentByCP {\n179\t\t\tids = append(ids, id)\n180\t\t}\n181\t\n182\t\tconst batchSize = 200\n183\t\tfor start := 0; start < len(ids); start += batchSize {\n184\t\t\tend := start + batchSize\n185\t\t\tif end > len(ids) {\n186\t\t\t\tend = len(ids)\n187\t\t\t}\n188\t\t\tbatch := ids[start:end]\n189\t\n190\t\t\tresp, err := postBatchAnalyses(ctx, client, repo, batch)\n191\t\t\tif err != nil {\n192\t\t\t\tlogging.Debug(ctx, \"recap: batch analyses failed\", \"count\", len(batch), \"error\", err.Error())\n193\t\t\t\tcontinue\n194\t\t\t}\n195\t\t\tfor cpID, a := range resp.Analyses {\n196\t\t\t\tif a == nil || a.Status != AnalysisStatusComplete {\n197\t\t\t\t\tcontinue\n198\t\t\t\t}\n199\t\t\t\tagent := agentByCP[cpID]\n200\t\t\t\tif agent == \"\" {\n201\t\t\t\t\tcontinue\n202\t\t\t\t}\n203\t\t\t\tagg, ok := out[agent]\n204\t\t\t\tif !ok {\n205\t\t\t\t\tagg = &agentAnalysisAgg{\n206\t\t\t\t\t\tlabels:  map[string]int{},\n207\t\t\t\t\t\tskills:  map[string]int{},\n208\t\t\t\t\t\tmcp:     map[string]int{},\n209\t\t\t\t\t\ttoolMix: map[string]int{},\n210\t\t\t\t\t}\n211\t\t\t\t\tout[agent] = agg\n212\t\t\t\t}\n213\t\t\t\tfor _, lbl := range a.Extraction.Labels {\n214\t\t\t\t\tagg.labels[lbl]++\n215\t\t\t\t}\n216\t\t\t\tfor _, s := range a.SkillsUsed {\n217\t\t\t\t\tagg.skills[s]++\n218\t\t\t\t}\n219\t\t\t\tfor _, m := range a.MCPServersUsed {\n220\t\t\t\t\tagg.mcp[m.Name] += m.Count\n221\t\t\t\t}\n222\t\t\t\tif a.ToolProfile != nil {\n223\t\t\t\t\tfor k, v := range a.ToolProfile.Categories {\n224\t\t\t\t\t\tagg.toolMix[k] += v.Count\n225\t\t\t\t\t}\n226\t\t\t\t}\n227\t\t\t}\n228\t\t}\n229\t\treturn out\n230\t}\n231\t\n232\tfunc postBatchAnalyses(ctx context.Context, client *api.Client, repo string, ids []string) (*batchAnalysesResponse, error) {\n233\t\tbody := map[string]any{\"checkpointIds\": ids, \"repoFullName\": repo}\n234\t\tresp, err := client.Post(ctx, \"/api/v1/cache/checkpoints/analyses/batch\", body)\n235\t\tif err != nil {\n236\t\t\treturn nil, fmt.Errorf(\"batch analyses post: %w\", err)\n237\t\t}\n238\t\tdefer func() { _ = resp.Body.Close() }()\n239\t\tif resp.StatusCode >= 400 {\n240\t\t\treturn nil, fmt.Errorf(\"batch analyses: http %d\", resp.StatusCode)\n241\t\t}\n242\t\tvar out batchAnalysesResponse\n\n... [161 lines truncated] ..."},"type":"attachment","uuid":"ed92b2fb-b91c-4eb4-8e00-739c917b5f93","timestamp":"2026-04-22T06:46:56.068Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
