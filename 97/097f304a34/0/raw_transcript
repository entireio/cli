{"parentUuid":"3eb46c43-f150-4dc3-879a-53c722a273a9","isSidechain":false,"promptId":"b0c5474d-b578-402c-9c43-60b161899789","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGq1bR9M1s6JX2m5DXp1h3","type":"tool_result","content":"The file /Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/api/src/lib/recap-aggregator.ts has been updated successfully."}]},"uuid":"d0ac63ba-0e32-4f60-9765-4349b6b69eef","timestamp":"2026-04-22T23:33:24.150Z","toolUseResult":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/entire.io/api/src/lib/recap-aggregator.ts","oldString":"export interface AgentAggregate {\n  checkpoints: number\n  tokens: number\n  labels: LabelCount[]\n  skills: SkillCount[]\n  mcpServers: McpCount[]\n  toolMix: ToolMix\n}","newString":"export interface AgentAggregate {\n  checkpoints: number\n  tokens: number\n  transcriptTokens: number\n  filesChanged: number\n  labels: LabelCount[]\n  skills: SkillCount[]\n  mcpServers: McpCount[]\n  toolMix: ToolMix\n}","originalFile":"// Per-agent aggregator for /api/v1/me/recap.\n//\n// The recap endpoint returns two columns of agent-scoped metrics:\n//   me           — aggregates across the authenticated user's checkpoints\n//   contributors — aggregates across every contributor's checkpoints on the repo\n//\n// Both columns share the same aggregation shape (labels / skills / MCP /\n// toolMix counts, plus tokens + checkpoint count where applicable). The CLI\n// consumes this endpoint so it doesn't have to round-trip dozens of per-cp\n// analysis requests and the batch endpoint + reconstruct agent attribution.\n\nimport type { StoredCheckpointAnalysis, ToolProfile } from \"../types\"\n\n/**\n * Shape of an analysis row with its producing agent attached. Callers\n * join analyses with checkpoint/commit records before handing them here.\n */\nexport interface AnalysisWithAgent {\n  checkpointId: string\n  agent: string\n  analysis: StoredCheckpointAnalysis | null\n}\n\n/**\n * LabelCount / SkillCount / McpCount follow the same sorted-desc shape the\n * frontend already renders elsewhere.\n */\nexport interface LabelCount {\n  label: string\n  count: number\n}\n\nexport interface SkillCount {\n  skill: string\n  count: number\n}\n\nexport interface McpCount {\n  name: string\n  count: number\n}\n\n/**\n * AgentAggregate is the shared shape for either the me side or the\n * contributors side of a recap row. tokens / checkpoints may be 0 when\n * the caller doesn't supply a source (e.g. contributor tokens come from a\n * separate SQL aggregate via /agent-activity).\n */\nexport interface AgentAggregate {\n  checkpoints: number\n  tokens: number\n  labels: LabelCount[]\n  skills: SkillCount[]\n  mcpServers: McpCount[]\n  toolMix: ToolMix\n}\n\n/**\n * ToolMix mirrors ToolProfile.categories but hoisted to the top level so\n * the response is easier to consume (no nested `categories` wrapper).\n */\nexport interface ToolMix {\n  shell: number\n  fileOps: number\n  search: number\n  mcp: number\n  agent: number\n  other: number\n}\n\nconst emptyToolMix = (): ToolMix => ({\n  shell: 0,\n  fileOps: 0,\n  search: 0,\n  mcp: 0,\n  agent: 0,\n  other: 0,\n})\n\n/**\n * aggregateByAgent groups per-checkpoint analyses by agent and rolls up\n * labels, skills, MCP servers, and tool-profile counts. Inputs with null\n * analysis (pending / not_available / failed) contribute a checkpoint\n * count but no qualitative fields.\n *\n * `tokensByAgent` is optional supplemental input — when provided, its\n * values override the default (0) for `tokens`. This lets the handler\n * pull tokens from `agent-activity` (SQL aggregate) rather than summing\n * across analysis rows, which is what the dashboard already does.\n */\nexport function aggregateByAgent(\n  rows: AnalysisWithAgent[],\n  tokensByAgent?: Record<string, number>,\n): Record<string, AgentAggregate> {\n  const out: Record<string, AgentAggregate> = {}\n\n  for (const row of rows) {\n    const key = row.agent\n    if (!key) continue\n    let agg = out[key]\n    if (!agg) {\n      agg = {\n        checkpoints: 0,\n        tokens: tokensByAgent?.[key] ?? 0,\n        labels: [],\n        skills: [],\n        mcpServers: [],\n        toolMix: emptyToolMix(),\n      }\n      out[key] = agg\n    }\n    agg.checkpoints += 1\n\n    const analysis = row.analysis\n    if (!analysis) continue\n\n    const labelCounts = new Map<string, number>()\n    for (const l of analysis.extraction?.labels ?? []) {\n      labelCounts.set(l, (labelCounts.get(l) ?? 0) + 1)\n    }\n    // Merge into existing agg.labels\n    for (const [label, count] of labelCounts) {\n      const existing = agg.labels.find((x) => x.label === label)\n      if (existing) existing.count += count\n      else agg.labels.push({ label, count })\n    }\n\n    for (const skill of analysis.skillsUsed ?? []) {\n      const existing = agg.skills.find((x) => x.skill === skill)\n      if (existing) existing.count += 1\n      else agg.skills.push({ skill, count: 1 })\n    }\n\n    for (const m of analysis.mcpServersUsed ?? []) {\n      const existing = agg.mcpServers.find((x) => x.name === m.name)\n      if (existing) existing.count += m.count\n      else agg.mcpServers.push({ name: m.name, count: m.count })\n    }\n\n    if (analysis.toolProfile) {\n      accumulateToolMix(agg.toolMix, analysis.toolProfile)\n    }\n  }\n\n  // Sort each per-agent list desc by count, stable by name tiebreaker so\n  // consumers get deterministic display order.\n  for (const agg of Object.values(out)) {\n    agg.labels.sort(byCountThenName((x) => x.label))\n    agg.skills.sort(byCountThenName((x) => x.skill))\n    agg.mcpServers.sort(byCountThenName((x) => x.name))\n  }\n\n  return out\n}\n\nfunction accumulateToolMix(dest: ToolMix, tp: ToolProfile): void {\n  const cats = tp.categories\n  dest.shell += cats.shell?.count ?? 0\n  dest.fileOps += cats.fileOps?.count ?? 0\n  dest.search += cats.search?.count ?? 0\n  dest.mcp += cats.mcp?.count ?? 0\n  dest.agent += cats.agent?.count ?? 0\n  dest.other += cats.other?.count ?? 0\n}\n\nfunction byCountThenName<T extends { count: number }>(nameOf: (x: T) => string) {\n  return (a: T, b: T) => {\n    if (a.count !== b.count) return b.count - a.count\n    return nameOf(a).localeCompare(nameOf(b))\n  }\n}\n","structuredPatch":[{"oldStart":49,"oldLines":6,"newStart":49,"newLines":8,"lines":[" export interface AgentAggregate {","   checkpoints: number","   tokens: number","+  transcriptTokens: number","+  filesChanged: number","   labels: LabelCount[]","   skills: SkillCount[]","   mcpServers: McpCount[]"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"3eb46c43-f150-4dc3-879a-53c722a273a9","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
