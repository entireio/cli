ementation with:\n\n```go\nfunc renderSummaryBand(s SummaryBand, styles Styles) string {\n    var b strings.Builder\n\n    // Title line.\n    b.WriteString(styles.title.Render(s.RangeLabel))\n    b.WriteString(\"\\n\\n\")\n\n    // you / team rows.\n    b.WriteString(renderSummaryRow(\"you\", styles.accent,\n        s.YouSessions, s.YouCheckpoints, s.YouTokens, styles))\n    b.WriteString(\"\\n\")\n    b.WriteString(renderSummaryRow(\"team\", styles.team,\n        s.TeamSessions, s.TeamCheckpoints, s.TeamTokens, styles))\n\n    // top line (only when at least one signal is non-empty).\n    topLine := renderTopLine(s, styles)\n    if topLine != \"\" {\n        b.WriteString(\"\\n\\n\")\n        b.WriteString(topLine)\n    }\n\n    // Context line.\n    b.WriteString(\"\\n\\n\")\n    b.WriteString(renderContextLine(s, styles))\n    return b.String()\n}\n\nfunc renderSummaryRow(label string, labelStyle lipgloss.Style, sessions, checkpoints, tokens int, styles Styles) string {\n    return fmt.Sprintf(\"%s  %s  %s  %s\",\n        labelStyle.Render(label),\n        styles.value.Render(fmt.Sprintf(\"%d sessions\", sessions)),\n        styles.value.Render(fmt.Sprintf(\"%d checkpoints\", checkpoints)),\n        styles.value.Render(fmt.Sprintf(\"%s tok\", formatTokens(tokens))))\n}\n\nfunc renderTopLine(s SummaryBand, styles Styles) string {\n    var parts []string\n    if s.TopAgent != \"\" {\n        parts = append(parts, styles.accent.Render(s.TopAgent))\n    }\n    if s.TopSkill != \"\" {\n        parts = append(parts, styles.info.Render(s.TopSkill))\n    }\n    if s.TopLabel != \"\" {\n        parts = append(parts, labelStyle(s.TopLabel, styles).Render(s.TopLabel))\n    }\n    if s.TopModel != \"\" {\n        parts = append(parts, styles.value.Render(s.TopModel))\n    }\n    if len(parts) == 0 {\n        return \"\"\n    }\n    return styles.label.Render(\"top\") + \"  \" + strings.Join(parts, \" · \")\n}\n\nfunc renderContextLine(s SummaryBand, styles Styles) string {\n    return styles.label.Render(fmt.Sprintf(\"%d agents · %d repos · %d active days\",\n        s.AgentCount, s.RepoCount, s.ActiveDays))\n}\n```\n\n`labelStyle(labelName, styles)` returns the semantic style for a label name or falls back to `styles.value` when unknown (matches spec §Summary panel §Unknown label fallback). If it doesn't already exist in `styles.go`, add it:\n\n```go\n// labelStyle returns the semantic color style for a canonical label name.\n// Unknown labels fall through to styles.value (white-bold).\nfunc labelStyle(name string, s Styles) lipgloss.Style {\n    switch name {\n    case \"feature_build\", \"enhancement\":\n        return lipgloss.NewStyle().Foreground(lipgloss.Color(\"42\"))\n    case \"bug_fix\", \"security_fix\":\n        return lipgloss.NewStyle().Foreground(lipgloss.Color(\"203\"))\n    case \"refactor\", \"optimization\":\n        return lipgloss.NewStyle().Foreground(lipgloss.Color(\"220\"))\n    case \"testing\":\n        return lipgloss.NewStyle().Foreground(lipgloss.Color(\"170\"))\n    case \"investigation\", \"documentation\":\n        return lipgloss.NewStyle().Foreground(lipgloss.Color(\"81\"))\n    case \"performance\":\n        return lipgloss.NewStyle().Foreground(lipgloss.Color(\"214\"))\n    default:\n        return s.value\n    }\n}\n```\n\n- [ ] **Step 5: Run tests — expect green**\n\n```bash\ngo test ./cmd/entire/cli/recap/ -run TestRenderSummaryBand -count=1 -v\n```\n\n- [ ] **Step 6: Run the full package**\n\n```bash\nmise run test 2>&1 | tail -20\n```\n\nAny tests that failed because they assumed the old summary shape need updating to the new shape (delete or rewrite them — do not keep both).\n\n- [ ] **Step 7: Commit**\n\n```bash\nmise run fmt && mise run lint && mise run test\ngit add cmd/entire/cli/recap/render_static.go cmd/entire/cli/recap/render_static_test.go cmd/entire/cli/recap/styles.go cmd/entire/cli/recap/model.go\ngit commit -m \"feat(recap): rewrite summary panel (you/team/top/context)\n\nSpec: d