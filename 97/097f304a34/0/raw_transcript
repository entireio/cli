.Location())\n53\t\t\treturn monthStart, monthStart.AddDate(0, 1, 0)\n54\t\tcase Range30d:\n55\t\t\treturn dayEnd.AddDate(0, 0, -30), dayEnd\n56\t\tcase Range90d:\n57\t\t\treturn dayEnd.AddDate(0, 0, -90), dayEnd\n58\t\t}\n59\t\treturn dayStart, dayEnd\n60\t}\n61\t\n62\t// BuildOpts controls how the view is assembled.\n63\ttype BuildOpts struct {\n64\t\tRange        RangeKey\n65\t\tAgentFilter  string    // empty = all agents\n66\t\tMode         ViewMode  // defaults to ViewBoth\n67\t\tContributors *ContributorsData // optional; fills the contributors columns\n68\t\tNow          time.Time // injectable for deterministic tests\n69\t}\n70\t\n71\t// View is everything a renderer needs. Pure data — no styling, no I/O.\n72\t// The Footer string is left to the renderer; the view exposes the raw bits.\n73\ttype View struct {\n74\t\tTitle      string\n75\t\tRange      RangeKey\n76\t\tMode       ViewMode // rendering path dispatches on this\n77\t\tSummary    SummaryBand\n78\t\tActivity   []int // heatmap buckets; length depends on Range\n79\t\tSessions   []SessionRow\n80\t\tAgentCards []AgentCard\n81\t\tRepos      []RepoLine // nil when all sessions share one repo\n82\t\tWorktrees  []WorktreeRollup\n83\t\tLabels     []LabelLine\n84\t}\n85\t\n86\t// SummaryBand holds the headline facts at the top of every view.\n87\ttype SummaryBand struct {\n88\t\tTopAgent         string\n89\t\tTopAgentCount    int\n90\t\tTopModel         string\n91\t\tTopModelCount    int\n92\t\tDominantLabel    string\n93\t\tDominantLabelPct float64 // 0-1\n94\t\tSessionCount     int\n95\t\tCheckpointCount  int\n96\t\tTokenTotal       int\n97\t\tCommitCount      int\n98\t\tAgentFilter      string // non-empty when filtered — rendered as chip\n99\t}\n100\t\n101\t// SessionRow is a row in the middle panel's chronological list.\n102\ttype SessionRow struct {\n103\t\tBadge       string // ● live, ◌ idle\n104\t\tAgent       string\n105\t\tRepo        string\n106\t\tSpan        string // \"2h\", \"30m\"\n107\t\t