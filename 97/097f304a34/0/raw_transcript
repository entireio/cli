er agent.\n112\t// When mode is \"me\" only, the contributors column is suppressed; \"contributors\"\n113\t// hides the me column; \"both\" shows side-by-side.\n114\tfunc renderAgentsView(cards []AgentCard, mode ViewMode, styles Styles) string {\n115\t\tif len(cards) == 0 {\n116\t\t\treturn styles.muted.Render(\"(no agents in range)\")\n117\t\t}\n118\t\tvar blocks []string\n119\t\tfor _, c := range cards {\n120\t\t\tblocks = append(blocks, renderAgentCard(c, mode, styles))\n121\t\t}\n122\t\treturn strings.Join(blocks, \"\\n\\n\")\n123\t}\n124\t\n125\tfunc renderAgentCard(c AgentCard, mode ViewMode, styles Styles) string {\n126\t\tvar b strings.Builder\n127\t\tb.WriteString(styles.title.Render(c.Agent))\n128\t\tb.WriteString(\"\\n\")\n129\t\n130\t\tshowMe := mode == ViewMe || mode == ViewBoth\n131\t\tshowContrib := mode == ViewContributors || mode == ViewBoth\n132\t\n133\t\t// Column headers.\n134\t\tswitch mode {\n135\t\tcase ViewBoth:\n136\t\t\tfmt.Fprintf(&b, \"  %-24s %-14s %-14s\\n\",\n137\t\t\t\t\"\", styles.label.Render(\"me\"), styles.label.Render(\"contributors\"))\n138\t\tcase ViewMe:\n139\t\t\tfmt.Fprintf(&b, \"  %-24s %-14s\\n\", \"\", styles.label.Render(\"me\"))\n140\t\tcase ViewContributors:\n141\t\t\tfmt.Fprintf(&b, \"  %-24s %-14s\\n\", \"\", styles.label.Render(\"contributors\"))\n142\t\t}\n143\t\n144\t\t// Numeric rows.\n145\t\trow := func(label, meVal, contribVal string) string {\n146\t\t\tswitch mode {\n147\t\t\tcase ViewBoth:\n148\t\t\t\treturn fmt.Sprintf(\"  %-24s %s %s\\n\",\n149\t\t\t\t\tstyles.muted.Render(label),\n150\t\t\t\t\tpadValue(meVal, 14, styles.value),\n151\t\t\t\t\tpadValue(contribVal, 14, styles.value))\n152\t\t\tcase ViewMe:\n153\t\t\t\treturn fmt.Sprintf(\"  %-24s %s\\n\",\n154\t\t\t\t\tstyles.muted.Render(label),\n155\t\t\t\t\tpadValue(meVal, 14, styles.value))\n156\t\t\tcase ViewContributors:\n157\t\t\t\treturn fmt.Sprintf(\"  %-24s %s\\n\",\n158\t\t\t\t\tstyles.muted.Render(label),\n159\t\t\t\t\tpadValue(contribVal, 14, sty