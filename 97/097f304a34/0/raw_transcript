{"parentUuid":"5698fd4e-6db4-4351-bf38-eed0cc2e4ec3","isSidechain":false,"promptId":"9916a65a-8698-4bd2-81f0-3d061363dd1a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KmgVXZyt1RFZskW8yHKfAU","type":"tool_result","content":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"strconv\"\n6\t\t\"strings\"\n7\t\t\"time\"\n8\t)\n9\t\n10\tconst (\n11\t\tplaceholderDash = \"—\"\n12\t\tunknownAgent    = \"unknown\"\n13\t)\n14\t\n15\t// RenderStatic produces the full static (non-TUI) recap output for a view.\n16\t// Width is the outer terminal width — the function clamps to a 60-cell\n17\t// minimum and uses the space for panel borders + content padding.\n18\t//\n19\t// Accessible / piped mode: pass styles from NewStyles(false). Output\n20\t// then contains no ANSI escapes and no Unicode borders; panels degrade to\n21\t// section headers separated by blank lines.\n22\tfunc RenderStatic(view View, styles Styles, width int) string {\n23\t\tif width < 60 {\n24\t\t\twidth = 60\n25\t\t}\n26\t\tvar b strings.Builder\n27\t\n28\t\t// Header bar: active range tab + agent filter + view mode. Present in\n29\t\t// both TUI and piped output so the reader always knows what's selected.\n30\t\tb.WriteString(renderHeader(view, \"\", styles))\n31\t\tb.WriteString(\"\\n\\n\")\n32\t\n33\t\t// Panel 1: Summary band.\n34\t\tb.WriteString(renderPanel(view.Title, renderSummaryBand(view.Summary, styles), width, styles))\n35\t\tb.WriteString(\"\\n\\n\")\n36\t\n37\t\t// Panel 2: Activity strip — range-dependent.\n38\t\tb.WriteString(renderActivityStrip(view, styles))\n39\t\tb.WriteString(\"\\n\\n\")\n40\t\n41\t\t// Panel 3: Agents (default) or Sessions (fallback when view has no AgentCards).\n42\t\tif len(view.AgentCards) > 0 {\n43\t\t\tb.WriteString(renderPanel(\"Agents\", renderAgentsView(view.AgentCards, view.Mode, styles), width, styles))\n44\t\t} else {\n45\t\t\tb.WriteString(renderPanel(\"Sessions\", renderSessionList(view.Sessions, styles), width, styles))\n46\t\t}\n47\t\tb.WriteString(\"\\n\\n\")\n48\t\n49\t\t// Panel 4: Repos · Worktrees · Labels (3-column bottom panel).\n50\t\tb.WriteString(renderBottomPanel(view, styles))\n51\t\n52\t\t// Diagnostic notes: \"not logged in\", \"repo not tracked\", etc. Only\n53\t\t// rendered when present so silent successful cases show no chrome.\n54\t\tif len(view.Notes) > 0 {\n55\t\t\tb.WriteString(\"\\n\\n\")\n56\t\t\tfor i, n := range view.Notes {\n57\t\t\t\tif i > 0 {\n58\t\t\t\t\tb.WriteString(\"\\n\")\n59\t\t\t\t}\n60\t\t\t\tb.WriteString(styles.muted.Render(\"  ℹ \" + n))\n61\t\t\t}\n62\t\t}\n63\t\n64\t\treturn b.String()\n65\t}\n66\t\n67\tfunc renderSummaryBand(s SummaryBand, styles Styles) string {\n68\t\tkv := func(label, value string) string {\n69\t\t\treturn styles.label.Render(label) + \"  \" + styles.value.Render(value)\n70\t\t}\n71\t\n72\t\t// \"Focus\" = the one label that covers ≥55% of the range's checkpoints\n73\t\t// AND leads the runner-up by ≥15%. Empty when no label takes the lead\n74\t\t// cleanly, or when no labels are loaded yet (server analysis pending).\n75\t\tfocus := placeholderDash\n76\t\tif s.DominantLabel != \"\" {\n77\t\t\tfocus = fmt.Sprintf(\"▪ %s  %d%%\", s.DominantLabel, int(s.DominantLabelPct*100))\n78\t\t} else if s.CheckpointCount > 0 {\n79\t\t\tfocus = styles.muted.Render(\"(mixed)\")\n80\t\t}\n81\t\n82\t\ttopAgent := s.TopAgent\n83\t\tif topAgent == \"\" {\n84\t\t\ttopAgent = placeholderDash\n85\t\t}\n86\t\tif s.AgentFilter != \"\" {\n87\t\t\ttopAgent = styles.accent.Render(\"[\"+s.AgentFilter+\"]\") + \" (filter)\"\n88\t\t}\n89\t\ttopSkill := placeholderDash // skill wiring lives in a later chunk; keep the slot visible\n90\t\ttopModel := s.TopModel\n91\t\tif topModel == \"\" {\n92\t\t\ttopModel = placeholderDash\n93\t\t}\n94\t\n95\t\tline1 := kv(\"Top agent\", topAgent) + \"  \" + kv(\"Top skill\", topSkill)\n96\t\tline2 := kv(\"Focus    \", focus) + \"  \" + kv(\"Top model\", topModel)\n97\t\ttotals := fmt.Sprintf(\"%d sessions · %d checkpoints · %s tokens · %d commits\",\n98\t\t\ts.SessionCount, s.CheckpointCount, formatTokens(s.TokenTotal), s.CommitCount)\n99\t\tline3 := kv(\"Totals    \", totals)\n100\t\treturn line1 + \"\\n\" + line2 + \"\\n\\n\" + line3\n101\t}\n102\t\n103\tfunc renderActivityStrip(view View, styles Styles) string {\n104\t\tif len(view.Activity) == 0 {\n105\t\t\treturn styles.muted.Render(\"  (no activity in range)\")\n106\t\t}\n107\t\tvar header string\n108\t\tswitch view.Range {\n109\t\tcase RangeDay:\n110\t\t\theader = \"Activity (24h)\"\n111\t\tcase RangeWeek:\n112\t\t\theader = \"Activity (7d)\"\n113\t\tcase RangeMonth:\n114\t\t\theader = \"Activity (this month)\"\n115\t\tcase Range30d:\n116\t\t\theader = \"Activity (30d)\"\n117\t\tcase Range90d:\n118\t\t\theader = \"Activity (90d)\"\n119\t\tdefault:\n120\t\t\theader = \"Activity\"\n121\t\t}\n122\t\n123\t\tif view.Range == RangeDay && len(view.Activity) == 24 {\n124\t\t\tvar events [24]int\n125\t\t\tcopy(events[:], view.Activity)\n126\t\t\treturn styles.label.Render(header) + \"\\n\" + renderIntraDayStrip(events, styles)\n127\t\t}\n128\t\tstrip := renderHeatmapStrip(view.Activity, maxOf(view.Activity), styles)\n129\t\tlabels := renderRangeAxisLabels(view.Range, len(view.Activity), styles)\n130\t\treturn styles.label.Render(header) + \"\\n\" + strip + \"\\n\" + labels\n131\t}\n132\t\n133\t// renderRangeAxisLabels draws a second row of labels under the heatmap\n134\t// strip so multi-day ranges have context for each cell.\n135\t//   - week: M T W T F S S (one letter per day, aligned with cells)\n136\t//   - month/30d/90d: date markers every ~7 cells, formatted \"Apr 1\"\n137\t//\n138\t// All labels are styled with the muted grey so the heatmap row stays\n139\t// visually prominent.\n140\tfunc renderRangeAxisLabels(r RangeKey, cellCount int, styles Styles) string {\n141\t\tnow := time.Now()\n142\t\tswitch r { //nolint:exhaustive // RangeDay uses a different renderer (renderIntraDayStrip) with its own hour labels\n143\t\tcase RangeWeek:\n144\t\t\t// 7 day-of-week initials, starting 7 days ago.\n145\t\t\tstart := now.AddDate(0, 0, -6)\n146\t\t\tvar out []rune\n147\t\t\tfor i := 0; i < 7 && i < cellCount; i++ {\n148\t\t\t\td := start.AddDate(0, 0, i)\n149\t\t\t\tinitials := []rune{'M', 'T', 'W', 'T', 'F', 'S', 'S'}\n150\t\t\t\t// Go's Weekday enum is Sun=0..Sat=6; map to our index where M=0.\n151\t\t\t\tidx := (int(d.Weekday()) + 6) % 7\n152\t\t\t\tout = append(out, initials[idx])\n153\t\t\t}\n154\t\t\treturn styles.muted.Render(string(out))\n155\t\tcase RangeMonth, Range30d, Range90d:\n156\t\t\t// Date markers every 7 cells. Each marker occupies up to 6 characters;\n157\t\t\t// pad between markers so the next one lines up with its cell.\n158\t\t\tstep := 7\n159\t\t\tif r == Range90d {\n160\t\t\t\tstep = 14\n161\t\t\t}\n162\t\t\tstart := now.AddDate(0, 0, -(cellCount - 1))\n163\t\t\tvar out strings.Builder\n164\t\t\twritten := 0\n165\t\t\tfor i := 0; i < cellCount; i += step {\n166\t\t\t\tif i > written {\n167\t\t\t\t\tout.WriteString(strings.Repeat(\" \", i-written))\n168\t\t\t\t\twritten = i\n169\t\t\t\t}\n170\t\t\t\tlabel := start.AddDate(0, 0, i).Format(\"Jan 2\")\n171\t\t\t\tout.WriteString(label)\n172\t\t\t\twritten += len(label)\n173\t\t\t}\n174\t\t\treturn styles.muted.Render(out.String())\n175\t\t}\n176\t\treturn \"\"\n177\t}\n178\t\n179\tfunc renderSessionList(rows []SessionRow, styles Styles) string {\n180\t\tif len(rows) == 0 {\n181\t\t\treturn styles.muted.Render(\"(no sessions in range)\")\n182\t\t}\n183\t\tvar b strings.Builder\n184\t\tfor i, r := range rows {\n185\t\t\tagent := r.Agent\n186\t\t\tif agent == \"\" {\n187\t\t\t\tagent = unknownAgent\n188\t\t\t}\n189\t\t\tlabel := r.Label\n190\t\t\tif label == \"\" {\n191\t\t\t\tlabel = styles.muted.Render(placeholderDash)\n192\t\t\t}\n193\t\t\thint := string(r.Hint)\n194\t\t\thintStyle := styles.styleForHint(r.Hint)\n195\t\t\thintRendered := \"\"\n196\t\t\tif hint != \"\" {\n197\t\t\t\thintRendered = hintStyle.Render(\"▶ \" + hint)\n198\t\t\t}\n199\t\t\tline := fmt.Sprintf(\"%s %-14s %-8s ▪ %-16s %2d cp   %s\",\n200\t\t\t\tstyles.accent.Render(r.Badge),\n201\t\t\t\tagent,\n202\t\t\t\tr.Span,\n203\t\t\t\tlabel,\n204\t\t\t\tr.Checkpoints,\n205\t\t\t\thintRendered,\n206\t\t\t)\n207\t\t\tb.WriteString(strings.TrimRight(line, \" \"))\n208\t\t\tif i < len(rows)-1 {\n209\t\t\t\tb.WriteString(\"\\n\")\n210\t\t\t}\n211\t\t}\n212\t\treturn b.String()\n213\t}\n214\t\n215\tfunc renderBottomPanel(view View, styles Styles) string {\n216\t\t// 3 columns: Repos (optional), Worktrees, Labels.\n217\t\t// Simple left-aligned columns; width split handled by caller's terminal.\n218\t\tvar cols []string\n219\t\n220\t\tif len(view.Repos) > 0 {\n221\t\t\tvar rb strings.Builder\n222\t\t\trb.WriteString(styles.label.Render(\"Repos\") + \"\\n\")\n223\t\t\tfor _, r := range view.Repos {\n224\t\t\t\tfmt.Fprintf(&rb, \"%-20s %d sess\\n\", r.Repo, r.SessionCount)\n225\t\t\t}\n226\t\t\tcols = append(cols, strings.TrimRight(rb.String(), \"\\n\"))\n227\t\t}\n228\t\n229\t\tif len(view.Worktrees) > 0 {\n230\t\t\tvar wb strings.Builder\n231\t\t\twb.WriteString(styles.label.Render(\"Worktrees\") + \"\\n\")\n232\t\t\tfor _, w := range view.Worktrees {\n233\t\t\t\tmarker := \" \"\n234\t\t\t\tif w.HasUncommitted {\n235\t\t\t\t\tmarker = styles.warn.Render(\"⇈\")\n236\t\t\t\t}\n237\t\t\t\tid := w.WorktreeID\n238\t\t\t\tif id == \"\" {\n239\t\t\t\t\tid = \"(default)\"\n240\t\t\t\t}\n241\t\t\t\tfmt.Fprintf(&wb, \"%-20s %d sess %s\\n\", id, w.SessionCount, marker)\n242\t\t\t}\n243\t\t\tcols = append(cols, strings.TrimRight(wb.String(), \"\\n\"))\n244\t\t}\n245\t\n246\t\tif len(view.Labels) > 0 {\n247\t\t\tvar lb strings.Builder\n248\t\t\tlb.WriteString(styles.label.Render(\"Labels\") + \"\\n\")\n249\t\t\t// Use max count as scale for gradient bar so the topmost label is full.\n250\t\t\tmaxCount := 0\n251\t\t\tfor _, l := range view.Labels {\n252\t\t\t\tif l.Count > maxCount {\n253\t\t\t\t\tmaxCount = l.Count\n254\t\t\t\t}\n255\t\t\t}