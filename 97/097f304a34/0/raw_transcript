\t\t\tlabelCounts map[string]int\n53\t\t\tmodels      map[string]int\n54\t\t\trepos       map[string]int\n55\t\t}\n56\t\tbuckets := map[string]*bucket{}\n57\t\tfor _, s := range sessions {\n58\t\t\tfor _, agent := range s.AgentsUsed {\n59\t\t\t\tb, ok := buckets[agent]\n60\t\t\t\tif !ok {\n61\t\t\t\t\tb = &bucket{\n62\t\t\t\t\t\tcard:        &AgentCard{Agent: agent},\n63\t\t\t\t\t\tlabelCounts: map[string]int{},\n64\t\t\t\t\t\tmodels:      map[string]int{},\n65\t\t\t\t\t\trepos:       map[string]int{},\n66\t\t\t\t\t}\n67\t\t\t\t\tbuckets[agent] = b\n68\t\t\t\t}\n69\t\t\t\tb.card.MeSessions++\n70\t\t\t\tfor _, cp := range s.Checkpoints {\n71\t\t\t\t\tb.card.MeCheckpoints++\n72\t\t\t\t\tif cp.TokenUsage != nil {\n73\t\t\t\t\t\tb.card.MeTokens += cp.TokenUsage.InputTokens + cp.TokenUsage.OutputTokens\n74\t\t\t\t\t}\n75\t\t\t\t\tfor _, lbl := range cp.Labels {\n76\t\t\t\t\t\tb.labelCounts[lbl]++\n77\t\t\t\t\t}\n78\t\t\t\t}\n79\t\t\t\tfor _, m := range s.ModelsUsed {\n80\t\t\t\t\tb.models[m]++\n81\t\t\t\t}\n82\t\t\t\tif s.Repo != \"\" {\n83\t\t\t\t\tb.repos[s.Repo]++\n84\t\t\t\t}\n85\t\t\t}\n86\t\t}\n87\t\tcards := make([]AgentCard, 0, len(buckets))\n88\t\tfor _, b := range buckets {\n89\t\t\tb.card.MeLabels = labelCountsSorted(b.labelCounts)\n90\t\t\tb.card.MeModels = topNByCount(b.models, 3)\n91\t\t\tb.card.MeRepos = reposSorted(b.repos)\n92\t\t\tcards = append(cards, *b.card)\n93\t\t}\n94\t\tsort.Slice(cards, func(i, j int) bool {\n95\t\t\tif cards[i].MeSessions != cards[j].MeSessions {\n96\t\t\t\treturn cards[i].MeSessions > cards[j].MeSessions\n97\t\t\t}\n98\t\t\treturn cards[i].Agent < cards[j].Agent\n99\t\t})\n100\t\treturn cards\n101\t}\n102\t\n103\t// ViewMode selects what data columns appear in the Agents view.\n104\ttype ViewMode string\n105\t\n106\tconst (\n107\t\tViewMe           ViewMode = \"me\"\n108\t\tViewContributors ViewMode = \"contributors\"\n109\t\tViewBoth         ViewMode = \"both\"\n110\t)\n111\t\n112\t// renderAgentsView draws the Agents view: one AgentCard panel per agent.\n113\t// When mode is \"me\" only, the contributors column is suppressed; \"contributors\"\n114\t// hides the me column; \"both\" shows side-by-side.\n115\tfunc renderAgentsView(cards []AgentCard, mode ViewMode, styles Styles) string {\n116\t\tif len(cards) == 0 {\n117\t\t\treturn styles.muted.Render(\"(no agents in range)\")\n118\t\t}\n119\t\tvar blocks []string\n120\t\tfor _, c := range cards {\n121\t\t\tblocks = append(blocks, renderAgentCard(c, mode, styles))\n122\t\t}\n123\t\treturn strings.Join(blocks, \"\\n\\n\")\n124\t}\n125\t\n126\tfunc renderAgentCard(c AgentCard, mode ViewMode, styles Styles) string {\n127\t\tvar b strings.Builder\n128\t\tb.WriteString(styles.title.Render(c.Agent))\n129\t\tb.WriteString(\"\\n\")\n130\t\n131\t\tshowMe := mode == ViewMe || mode == ViewBoth\n132\t\tshowContrib := mode == ViewContributors || mode == ViewBoth\n133\t\n134\t\t// Column headers.\n135\t\tswitch mode {\n136\t\tcase ViewBoth:\n137\t\t\tfmt.Fprintf(&b, \"  %-24s %-14s %-14s\\n\",\n138\t\t\t\t\"\", styles.label.Render(\"me\"), styles.label.Render(\"contributors\"))\n139\t\tcase ViewMe:\n140\t\t\tfmt.Fprintf(&b, \"  %-24s %-14s\\n\", \"\", styles.label.Render(\"me\"))\n141\t\tcase ViewContributors:\n142\t\t\tfmt.Fprintf(&b, \"  %-24s %-14s\\n\", \"\", styles.label.Render(\"contributors\"))\n143\t\t}\n144\t\n145\t\t// Numeric rows.\n146\t\trow := func(label, meVal, contribVal string) string {\n147\t\t\tswitch mode {\n148\t\t\tcase ViewBoth:\n149\t\t\t\treturn fmt.Sprintf(\"  %-24s %s %s\\n\",\n150\t\t\t\t\tstyles.muted.Render(label),\n151\t\t\t\t\tpadValue(meVal, styles.value),\n152\t\t\t\t\tpadValue(contribVal, styles.value))\n153\t\t\tcase ViewMe:\n154\t\t\t\treturn fmt.Sprintf(\"  %-24s %s\\n\",\n155\t\t\t\t\tstyles.muted.Render(label),\n156\t\t\t\t\tpadValue(meVal, styles.value))\n157\t\t\tcase ViewContributors:\n158\t\t\t\treturn fmt.Sprintf(\"  %-24s %s\\n\",\n159\t\t\t\t\tstyles.muted.Render(label),\n160\t\t\t\t\tpadValue(contribVal,