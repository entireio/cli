{"parentUuid":"8c8d801c-be9b-4810-8737-3ad079ea56bb","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/agents_card.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"sort\"\n6\t\t\"strconv\"\n7\t\t\"strings\"\n8\t)\n9\t\n10\t// LabelCount pairs a label with its occurrence count — used for ordered\n11\t// distribution rendering in the Labels column + Agents cards.\n12\ttype LabelCount struct {\n13\t\tLabel string `json:\"label\"`\n14\t\tCount int    `json:\"count\"`\n15\t}\n16\t\n17\t// AgentCard is the per-agent panel data used by the Agents view. Fields\n18\t// prefixed Me are the current user's activity; fields prefixed Contrib are\n19\t// the whole repo's contributor aggregate (populated by a follow-up commit\n20\t// that wires the overview endpoints).\n21\ttype AgentCard struct {\n22\t\tAgent string\n23\t\n24\t\t// \"me\" column — from local + per-checkpoint enrichment\n25\t\tMeSessions    int\n26\t\tMeCheckpoints int\n27\t\tMeTokens      int\n28\t\tMeLabels      []LabelCount\n29\t\tMeSkills      []string\n30\t\tMeModels      []string\n31\t\tMeRepos       []RepoLine\n32\t\tMeToolMix     map[string]int\n33\t\n34\t\t// \"contributors\" column — from repo-overview endpoints\n35\t\t// Empty when not logged in / repo not tracked / solo repo.\n36\t\tContribSessions    int\n37\t\tContribCheckpoints int\n38\t\tContribTokens      int\n39\t\tContribLabels      []LabelCount\n40\t\tContribSkills      []string\n41\t\tContribModels      []string\n42\t\tContribCount       int // distinct contributors including you\n43\t\tContribToolMix     map[string]int\n44\t}\n45\t\n46\t// RepoInfo is an alias for RepoLine used in test code and public APIs.\n47\t// Both types represent a repo with a session count.\n48\ttype RepoInfo = RepoLine\n49\t\n50\t// buildAgentCards turns a list of filtered sessions into per-agent cards for\n51\t// the \"me\" side. Contributor fields are left zero — the server-overview\n52\t// integration fills them in later.\n53\tfunc buildAgentCards(sessions []RecapSession) []AgentCard {\n54\t\ttype bucket struct {\n55\t\t\tcard        *AgentCard\n56\t\t\tlabelCounts map[string]int\n57\t\t\tmodels      map[string]int\n58\t\t\trepos       map[string]int\n59\t\t}\n60\t\tbuckets := map[string]*bucket{}\n61\t\tfor _, s := range sessions {\n62\t\t\tfor _, agent := range s.AgentsUsed {\n63\t\t\t\tb, ok := buckets[agent]\n64\t\t\t\tif !ok {\n65\t\t\t\t\tb = &bucket{\n66\t\t\t\t\t\tcard:        &AgentCard{Agent: agent},\n67\t\t\t\t\t\tlabelCounts: map[string]int{},\n68\t\t\t\t\t\tmodels:      map[string]int{},\n69\t\t\t\t\t\trepos:       map[string]int{},\n70\t\t\t\t\t}\n71\t\t\t\t\tbuckets[agent] = b\n72\t\t\t\t}\n73\t\t\t\tb.card.MeSessions++\n74\t\t\t\tfor _, cp := range s.Checkpoints {\n75\t\t\t\t\tb.card.MeCheckpoints++\n76\t\t\t\t\tif cp.TokenUsage != nil {\n77\t\t\t\t\t\tb.card.MeTokens += cp.TokenUsage.InputTokens + cp.TokenUsage.OutputTokens\n78\t\t\t\t\t}\n79\t\t\t\t\tfor _, lbl := range cp.Labels {\n80\t\t\t\t\t\tb.labelCounts[lbl]++\n81\t\t\t\t\t}\n82\t\t\t\t}\n83\t\t\t\tfor _, m := range s.ModelsUsed {\n84\t\t\t\t\tb.models[m]++\n85\t\t\t\t}\n86\t\t\t\tif s.Repo != \"\" {\n87\t\t\t\t\tb.repos[s.Repo]++\n88\t\t\t\t}\n89\t\t\t}\n90\t\t}\n91\t\tcards := make([]AgentCard, 0, len(buckets))\n92\t\tfor _, b := range buckets {\n93\t\t\tb.card.MeLabels = labelCountsSorted(b.labelCounts)\n94\t\t\tb.card.MeModels = topNByCount(b.models, 3)\n95\t\t\tb.card.MeRepos = reposSorted(b.repos)\n96\t\t\tcards = append(cards, *b.card)\n97\t\t}\n98\t\tsort.Slice(cards, func(i, j int) bool {\n99\t\t\tif cards[i].MeSessions != cards[j].MeSessions {\n100\t\t\t\treturn cards[i].MeSessions > cards[j].MeSessions\n101\t\t\t}\n102\t\t\treturn cards[i].Agent < cards[j].Agent\n103\t\t})\n104\t\treturn cards\n105\t}\n106\t\n107\t// applyContributors fills AgentCard.Contrib* fields from a ContributorsData\n108\t// map fetched from the server. Leaves zero-valued fields alone when no data\n109\t// is available for a given agent — the renderer shows \"—\" as a placeholder.\n110\tfunc applyContributors(cards []AgentCard, data *ContributorsData) {\n111\t\tif data == nil || len(data.ByAgent) == 0 {\n112\t\t\treturn\n113\t\t}\n114\t\tfor i := range cards {\n115\t\t\tif a, ok := data.ByAgent[cards[i].Agent]; ok && a != nil {\n116\t\t\t\tcards[i].ContribSessions = a.TotalCount\n117\t\t\t\tcards[i].ContribCheckpoints = a.TotalCount\n118\t\t\t\tcards[i].ContribTokens = a.Tokens\n119\t\t\t\tcards[i].ContribCount = a.DistinctContribs\n120\t\t\t}\n121\t\t}\n122\t}\n123\t\n124\t// ViewMode selects what data columns appear in the Agents view.\n125\ttype ViewMode string\n126\t\n127\tconst (\n128\t\tViewMe           ViewMode = \"me\"\n129\t\tViewContributors ViewMode = \"contributors\"\n130\t\tViewBoth         ViewMode = \"both\"\n131\t)\n132\t\n133\t// renderAgentsView composes the Agents panel body: optional legend row\n134\t// + sorted agent cards separated by blank lines.\n135\t// innerWidth is threaded from RenderStatic so narrow terminals cascade\n136\t// down to the bar-rendering level. The caller computes it as\n137\t// `terminalWidth - 4` (2 chars border + 1 char padding each side).\n138\tfunc renderAgentsView(cards []AgentCard, mode ViewMode, innerWidth int, styles Styles) string {\n139\t\tif len(cards) == 0 {\n140\t\t\treturn styles.muted.Render(\"(no agent activity in range)\")\n141\t\t}\n142\t\n143\t\tsorted := append([]AgentCard(nil), cards...)\n144\t\tsort.SliceStable(sorted, func(i, j int) bool {\n145\t\t\tiSum := sorted[i].MeSessions + sorted[i].ContribSessions\n146\t\t\tjSum := sorted[j].MeSessions + sorted[j].ContribSessions\n147\t\t\tif iSum != jSum {\n148\t\t\t\treturn iSum > jSum\n149\t\t\t}\n150\t\t\treturn sorted[i].Agent < sorted[j].Agent\n151\t\t})\n152\t\n153\t\tvar parts []string\n154\t\tif mode == ViewBoth {\n155\t\t\tparts = append(parts, fmt.Sprintf(\"%s   %