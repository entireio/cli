{"parentUuid":"cadf5238-fa1b-4bfb-8b29-2be89c06d0e8","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/tui.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"time\"\n5\t\n6\t\ttea \"github.com/charmbracelet/bubbletea\"\n7\t)\n8\t\n9\t// TUIModel backs the interactive recap view. It keeps the raw sessions so\n10\t// range + agent toggles can rebuild the View instantly without re-fetching.\n11\ttype TUIModel struct {\n12\t\tsessions    []RecapSession\n13\t\tview        View\n14\t\tagentFilter string\n15\t\tagents      []string // agents present in sessions, for cycling\n16\t\tmode        ViewMode // me / contributors / both\n17\t\tstyles      Styles\n18\t\twidth       int\n19\t\theight      int\n20\t}\n21\t\n22\t// NewTUIModel wraps a pre-built View with the state bubbletea needs for\n23\t// interactive toggles. agentFilter is the initial filter (\"\" = all agents).\n24\tfunc NewTUIModel(sessions []RecapSession, initial View, agentFilter string) TUIModel {\n25\t\tmode := initial.Mode\n26\t\tif mode == \"\" {\n27\t\t\tmode = ViewBoth\n28\t\t}\n29\t\treturn TUIModel{\n30\t\t\tsessions:    sessions,\n31\t\t\tview:        initial,\n32\t\t\tagentFilter: agentFilter,\n33\t\t\tagents:      distinctAgents(sessions),\n34\t\t\tmode:        mode,\n35\t\t\tstyles:      NewStyles(true),\n36\t\t\twidth:       100,\n37\t\t\theight:      24,\n38\t\t}\n39\t}\n40\t\n41\t// Init is a no-op — no async work on startup.\n42\tfunc (m TUIModel) Init() tea.Cmd { return nil }\n43\t\n44\t// Update dispatches on keyboard and window-resize messages. Range + agent\n45\t// toggles rebuild the View via BuildView; nothing else changes.\n46\t//\n47\t\n48\tfunc (m TUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n49\t\tswitch msg := msg.(type) {\n50\t\tcase tea.WindowSizeMsg:\n51\t\t\tm.width, m.height = msg.Width, msg.Height\n52\t\t\treturn m, nil\n53\t\tcase tea.KeyMsg:\n54\t\t\treturn m.handleKey(msg)\n55\t\t}\n56\t\treturn m, nil\n57\t}\n58\t\n59\tfunc (m TUIModel) handleKey(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n60\t\tkey := msg.String()\n61\t\tswitch key {\n62\t\tcase \"q\", \"ctrl+c\", \"esc\":\n63\t\t\treturn m, tea.Quit\n64\t\tcase \"1\", \"d\":\n65\t\t\tm.view = rebuildView(m.sessions, RangeDay, m.agentFilter, m.mode)\n66\t\tcase \"2\", \"w\":\n67\t\t\tm.view = rebuildView(m.sessions, RangeWeek, m.agentFilter, m.mode)\n68\t\tcase \"3\", \"m\":\n69\t\t\tm.view = rebuildView(m.sessions, RangeMonth, m.agentFilter, m.mode)\n70\t\tcase \"4\":\n71\t\t\tm.view = rebuildView(m.sessions, Range30d, m.agentFilter, m.mode)\n72\t\tcase \"5\":\n73\t\t\tm.view = rebuildView(m.sessions, Range90d, m.agentFilter, m.mode)\n74\t\tcase \"a\":\n75\t\t\tm.agentFilter = cycleAgent(m.agents, m.agentFilter)\n76\t\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n77\t\tcase \"v\":\n78\t\t\tm.mode = cycleMode(m.mode)\n79\t\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n80\t\t}\n81\t\treturn m, nil\n82\t}\n83\t\n84\t// View renders the current state via the static renderer, plus a help line\n85\t// at the bottom so users discover the keybinds without reading docs.\n86\tfunc (m TUIModel) View() string {\n87\t\tbody := RenderStatic(m.view, m.styles, m.width)\n88\t\thelp := m.styles.help.Render(\"  d w m 4 5  range  ·  a  agent filter  ·  v  view (me/contributors/both)  ·  q  quit\")\n89\t\treturn body + \"\\n\" + help\n90\t}\n91\t\n92\t// rebuildView is a tiny wrapper that anchors Now at call time so range math\n93\t// stays correct across long-running TUI sessions.\n94\tfunc rebuildView(sessions []RecapSession, r RangeKey, agent string, mode ViewMode) View {\n95\t\treturn BuildView(sessions, BuildOpts{Range: r, AgentFilter: agent, Mode: mode, Now: time.Now()})\n96\t}\n97\t\n98\t// cycleMode advances the view mode: both → me → contributors → both.\n99\tfunc cycleMode(current ViewMode) ViewMode {\n100\t\tswitch current {\n101\t\tcase ViewBoth:\n102\t\t\treturn ViewMe\n103\t\tcase ViewMe:\n104\t\t\treturn ViewContributors\n105\t\tcase ViewContributors:\n106\t\t\treturn ViewBoth\n107\t\t}\n108\t\treturn ViewBoth\n109\t}\n110\t\n111\t// cycleAgent advances the filter in a stable round-robin: \"\" → agents[0] →\n112\t// agents[1] → … → \"\". Stable order means the same key press always moves\n113\t// to the same next agent.\n114\tfunc cycleAgent(agents []string, current string) string {\n115\t\tif len(agents) == 0 {\n116\t\t\treturn \"\"\n117\t\t}\n118\t\tif current == \"\" {\n119\t\t\treturn agents[0]\n120\t\t}\n121\t\tfor i, a := range agents {\n122\t\t\tif a == current {\n123\t\t\t\tif i+1 < len(agents) {\n124\t\t\t\t\treturn agents[i+1]\n125\t\t\t\t}\n126\t\t\t\treturn \"\"\n127\t\t\t}\n128\t\t}\n129\t\treturn \"\"\n130\t}\n131\t\n132\tfunc distinctAgents(sessions []RecapSession) []string {\n133\t\tseen := map[string]bool{}\n134\t\tvar out []string\n135\t\tfor _, s := range sessions {\n136\t\t\tfor _, a := range s.AgentsUsed {\n137\t\t\t\tif !seen[a] {\n138\t\t\t\t\tseen[a] = true\n139\t\t\t\t\tout = append(out, a)\n140\t\t\t\t}\n141\t\t\t}\n142\t\t}\n143\t\treturn out\n144\t}"},"type":"attachment","uuid":"bca2896c-7096-448b-b7ef-5faa3d745364","timestamp":"2026-04-22T00:47:48.126Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
