  mode,\n\t\tstyles:      NewStyles(true),\n\t\twidth:       100,\n\t\theight:      24,\n\t}\n}\n\n// Init is a no-op — no async work on startup.\nfunc (m TUIModel) Init() tea.Cmd { return nil }\n\n// Update dispatches on keyboard and window-resize messages. Range + agent\n// toggles rebuild the View via BuildView; nothing else changes.\nfunc (m TUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) { //nolint:ireturn // tea.Model is required by bubbletea's interface contract\n\tswitch msg := msg.(type) {\n\tcase tea.WindowSizeMsg:\n\t\tm.width, m.height = msg.Width, msg.Height\n\t\treturn m, nil\n\tcase tea.KeyMsg:\n\t\treturn m.handleKey(msg)\n\t}\n\treturn m, nil\n}\n\nfunc (m TUIModel) handleKey(msg tea.KeyMsg) (tea.Model, tea.Cmd) { //nolint:ireturn // mirrors Update's bubbletea contract\n\tkey := msg.String()\n\tswitch key {\n\tcase \"q\", \"ctrl+c\", \"esc\":\n\t\treturn m, tea.Quit\n\tcase \"1\", \"d\":\n\t\tm.view = rebuildView(m.sessions, RangeDay, m.agentFilter, m.mode)\n\tcase \"2\", \"w\":\n\t\tm.view = rebuildView(m.sessions, RangeWeek, m.agentFilter, m.mode)\n\tcase \"3\", \"m\":\n\t\tm.view = rebuildView(m.sessions, RangeMonth, m.agentFilter, m.mode)\n\tcase \"4\":\n\t\tm.view = rebuildView(m.sessions, Range30d, m.agentFilter, m.mode)\n\tcase \"5\":\n\t\tm.view = rebuildView(m.sessions, Range90d, m.agentFilter, m.mode)\n\tcase \"a\":\n\t\tm.agentFilter = cycleAgent(m.agents, m.agentFilter)\n\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n\tcase \"v\":\n\t\tm.mode = cycleMode(m.mode)\n\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n\t}\n\treturn m, nil\n}\n\n// View renders a header bar with the active toggles, the static panel body,\n// and a help line at the bottom. The header makes the available toggles\n// visually obvious — users don't need to read the help line to see what\n// range or view mode is active.\nfunc (m TUIModel) View() string {\n\theader := m.renderHeader()\n\tbody := RenderStatic(m.view, m.styles, m.width)\n\thelp := m.styles.help.Render(\"  1-5 d/w/m  range  ·  a  agent  ·  v  view  ·  q  quit\")\n\treturn header + \"\\n\" + body + \"\\n\" + help\n}\n\n// renderHeader returns a one-line bar showing the current range tab, agent\n// filter, and view mode. Active option is wrapped in brackets and rendered\n// in amber; inactive options are muted gray, separated by middle dots.\nfunc (m TUIModel) renderHeader() string {\n\ttab := func(label string, active bool) string {\n\t\tif active {\n\t\t\treturn m.styles.accent.Render(\"[\" + label + \"]\")\n\t\t}\n\t\treturn m.styles.muted.Render(label)\n\t}\n\tsep := m.styles.help.Render(\" · \")\n\n\trangeLabels := []struct {\n\t\tlabel string\n\t\tr     RangeKey\n\t}{\n\t\t{\"day\", RangeDay},\n\t\t{\"week\", RangeWeek},\n\t\t{\"month\", RangeMonth},\n\t\t{\"30d\", Range30d},\n\t\t{\"90d\", Range90d},\n\t}\n\tparts := make([]string, 0, len(rangeLabels))\n\tfor _, rl := range rangeLabels {\n\t\tparts = append(parts, tab(rl.label, m.view.Range == rl.r))\n\t}\n\trangeBar := strings.Join(parts, sep)\n\n\tagentVal := \"all\"\n\tif m.agentFilter != \"\" {\n\t\tagentVal = m.agentFilter\n\t}\n\tagent := m.styles.muted.Render(\"agent: \") + m.styles.accent.Render(\"[\"+agentVal+\"]\")\n\n\tviewVal := string(m.mode)\n\tif viewVal == \"\" {\n\t\tviewVal = string(ViewBoth)\n\t}\n\tview := m.styles.muted.Render(\"view: \") + m.styles.accent.Render(\"[\"+viewVal+\"]\")\n\n\treturn \"  \" + rangeBar + \"     \" + agent + \"     \" + view\n}\n\n// rebuildView is a tiny wrapper that anchors Now at call time so range math\n// stays correct across long-running TUI sessions.\nfunc rebuildView(sessions []RecapSession, r RangeKey, agent string, mode ViewMode) View {\n\treturn BuildView(sessions, BuildOpts{Range: r, AgentFilter: agent, Mode: mode, Now: time.Now()})\n}\n\n// cycleMode advances the view mode: both → me → contributors → both.\nfunc cycleMode(current ViewMode) ViewMode {\n\tswitch current {\n\tcase ViewBoth:\n\t\treturn ViewMe\n\tcase ViewMe:\n\t\treturn ViewContributors\n\tcase ViewContributors:\n\t\treturn ViewBoth\n\t}\n\treturn ViewBoth\n}\n\n// cycleAgent advances the filter in a stable round-robin: \"\" → agents[0] →\n// agents[1] → … → \"\". Stable order means the same key press always moves\n// to the same next agent.\nfunc cycleAgent(agents []string, current string) string {\n\tif len(agents) == 0 {\n\t\treturn \"\"\n\t}\n\tif current == \"\" {\n\t\treturn agents[0]\n\t}\n\tfor i, a := range agents {\n\t\tif a == current {\n\t\t\tif i+1 < len(agents) {\n\t\t\t\treturn agents[i+1]\n\t\t\t}\n\t\t\treturn \"\"\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc distinctAgents(sessions []RecapSession) []string {\n\tseen := map[string]bool{}\n\tvar out []string\n\tfor _, s := range sessions {\n\t\tfor _, a := range s.AgentsUsed {\n\t\t\tif !seen[a] {\n\t\t\t\tseen[a] = true\n\t\t\t\tout = append(out, a)\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}\n","structuredPatch":[{"oldStart":80,"oldLines":60,"newStart":80,"newLines":15,"lines":["   return m, nil"," }"," ","-// View renders a header bar with the active toggles, the static panel body,","-// and a help line at the bottom. The header makes the available toggles","-// visually obvious — users don't need to read the help line to see what","-// range or view mode is active.","+// View renders the static panels (which already include the toggle header)","+// plus a help line at the bottom. The header is produced by RenderStatic,","+// so both TUI and piped output expose the active toggles identically."," func (m TUIModel) View() string {","-  header := m.renderHeader()","   body := RenderStatic(m.view, m.styles, m.width)","   help := m.styles.help.Render(\"  1-5 d/w/m  range  ·  a  agent  ·  v  view  ·  q  quit\")","-  return header + \"\\n\" + body + \"\\n\" + help","+  return body + \"\\n\" + help"," }"," ","-// renderHeader returns a one-line bar showing the current range tab, agent","-// filter, and view mode. Active option is wrapped in b