\t\t\t\t\tif c.Hidden {\n48\t\t\t\t\t\treturn\n49\t\t\t\t\t}\n50\t\t\t\t}\n51\t\n52\t\t\t\t// Load settings once for telemetry and version check\n53\t\t\t\tvar telemetryEnabled *bool\n54\t\t\t\tsettings, err := LoadEntireSettings(cmd.Context())\n55\t\t\t\tif err == nil {\n56\t\t\t\t\ttelemetryEnabled = settings.Telemetry\n57\t\t\t\t}\n58\t\n59\t\t\t\t// Check if telemetry is enabled\n60\t\t\t\tif telemetryEnabled != nil && *telemetryEnabled {\n61\t\t\t\t\t// Use detached tracking (non-blocking)\n62\t\t\t\t\tinstalledAgents := GetAgentsWithHooksInstalled(cmd.Context())\n63\t\t\t\t\tagentStr := JoinAgentNames(installedAgents)\n64\t\t\t\t\ttelemetry.TrackCommandDetached(cmd, agentStr, settings.Enabled, versioninfo.Version)\n65\t\t\t\t}\n66\t\n67\t\t\t\t// Version check and notification (synchronous with 2s timeout)\n68\t\t\t\t// Runs AFTER command completes to avoid interfering with interactive modes\n69\t\t\t\tversioncheck.CheckAndNotify(cmd.Context(), cmd.OutOrStdout(), versioninfo.Version)\n70\t\t\t},\n71\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n72\t\t\t\tctx := cmd.Context()\n73\t\t\t\t// If we're in a git repo but Entire isn't set up yet, start the setup flow\n74\t\t\t\tif _, err := paths.WorktreeRoot(ctx); err == nil && !settings.IsSetUpAny(ctx) {\n75\t\t\t\t\treturn runSetupFlow(ctx, cmd.OutOrStdout(), EnableOptions{})\n76\t\t\t\t}\n77\t\t\t\treturn cmd.Help()\n78\t\t\t},\n79\t\t}\n80\t\n81\t\t// Add subcommands here\n82\t\tcmd.AddCommand(newRewindCmd())\n83\t\tcmd.AddCommand(newResumeCmd())\n84\t\tcmd.AddCommand(newCleanCmd())\n85\t\tcmd.AddCommand(newResetCmd())\n86\t\tcmd.AddCommand(newSessionsCmd())\n87\t\tcmd.AddCommand(newSetupCmd())\n88\t\tcmd.AddCommand(newEnableCmd())\n89\t\tcmd.AddCommand(newDisableCmd())\n90\t\tcmd.AddCommand(newStatusCmd())\n91\t\tcmd.AddCommand(newLoginCmd())\n92\t\tcmd.AddCommand(newLogoutCmd())\n93\t\tcmd.AddCommand(newHooksCmd())\n94\t\tcmd.AddCommand(newVersionCmd())\n95\t\tcmd.AddCommand(newExplainCmd())\n96\t\tcmd.AddCommand(newDoctorCmd())\n97\t\tcmd.AddCommand(newTraceCmd())\n98\t\tcmd.AddCommand(newTrailCmd())\n99\t\tcmd.AddCommand(newSearchCmd())\n100\t\tcmd.AddCommand(newSendAnalyticsCmd())\n101\t\tcmd.AddCommand(newAttachCmd())\n102\t\tcmd.AddCommand(newCurlBashPostInstallCmd())\n103\t\tcmd.AddCommand(newMigrateCmd())\n104\t\tcmd.AddCommand(newActivityCmd())\n105\t\n106\t\tcmd.SetVersionTemplate(versionString())\n107\t\n108\t\t// Replace default help command with custom one that supports -t flag\n109\t\tcmd.SetHelpCommand(NewHelpCmd(cmd))\n110\t\n111\t\treturn cmd\n112\t}\n113\t\n114\tfunc versionString() string {\n115\t\treturn fmt.Sprintf(\"Entire CLI %s (%s)\\nGo version: %s\\nOS/Arch: %s/%s\\n\",\n116\t\t\tversioninfo.Version, versioninfo.Commit, runtime.Version(), runtime.GOOS, runtime.GOARCH)\n117\t}\n118\t\n119\tfunc newVersionCmd() *cobra.Command {\n120\t\treturn &cobra.Command{\n121\t\t\tUse:   \"version\",\n122\t\t\tShort: \"Show build information\",\n123\t\t\tRun: func(cmd *cobra.Command, _ []string) {\n124\t\t\t\t// Use OutOrStdout explicitly — cobra's cmd.Print() defaults to\n125\t\t\t\t// stderr in v1.10+, but version output should go to stdout.\n126\t\t\t\tfmt.Fprint(cmd.OutOrStdout(), versionString())\n127\t\t\t},\n128\t\t}\n129\t}\n130\t\n131\t// newSendAnalyticsCmd creates the hidden command for sending analytics from a detached subprocess.\n132\t// This command is invoked by TrackCommandDetached and should not be called directly by users.\n133\tfunc newSendAnalyticsCmd() *cobra.Command {\n134\t\treturn &cobra.Command{\n135\t\t\tUse:    \"__send_analytics\",\n136\t\t\tHidden: true,\n137\t\t\tArgs:   cobra.ExactArgs(1),\n138\t\t\tRun: func(_ *cobra.Command, args []string) {\n139\t\t\t\ttelemetry.SendEvent(args[0])\n140\t\t\t},\n141\t\t}\n142\t}"},"type":"attachment","uuid":"de7b256a-e88c-4f63-a424-e1a60273b38d","timestamp":"2026-04-23T19:25:33.765Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/