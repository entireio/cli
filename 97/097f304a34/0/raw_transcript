{"parentUuid":"86fca895-d741-4b6d-998a-783155556e2a","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/agents_card.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"sort\"\n6\t\t\"strconv\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/charmbracelet/lipgloss\"\n10\t)\n11\t\n12\t// LabelCount pairs a label with its occurrence count — used for ordered\n13\t// distribution rendering in the Labels column + Agents cards.\n14\ttype LabelCount struct {\n15\t\tLabel string\n16\t\tCount int\n17\t}\n18\t\n19\t// AgentCard is the per-agent panel data used by the Agents view. Fields\n20\t// prefixed Me are the current user's activity; fields prefixed Contrib are\n21\t// the whole repo's contributor aggregate (populated by a follow-up commit\n22\t// that wires the overview endpoints).\n23\ttype AgentCard struct {\n24\t\tAgent string\n25\t\n26\t\t// \"me\" column — from local + per-checkpoint enrichment\n27\t\tMeSessions    int\n28\t\tMeCheckpoints int\n29\t\tMeTokens      int\n30\t\tMeLabels      []LabelCount\n31\t\tMeSkills      []string\n32\t\tMeModels      []string\n33\t\tMeRepos       []RepoLine\n34\t\n35\t\t// \"contributors\" column — from repo-overview endpoints\n36\t\t// Empty when not logged in / repo not tracked / solo repo.\n37\t\tContribSessions    int\n38\t\tContribCheckpoints int\n39\t\tContribTokens      int\n40\t\tContribLabels      []LabelCount\n41\t\tContribSkills      []string\n42\t\tContribModels      []string\n43\t\tContribCount       int // distinct contributors including you\n44\t}\n45\t\n46\t// buildAgentCards turns a list of filtered sessions into per-agent cards for\n47\t// the \"me\" side. Contributor fields are left zero — the server-overview\n48\t// integration fills them in later.\n49\tfunc buildAgentCards(sessions []RecapSession) []AgentCard {\n50\t\ttype bucket struct {\n51\t\t\tcard        *AgentCard\n52\t\t\tlabelCounts map[string]int\n53\t\t\tmodels      map[string]int\n54\t\t\trepos       map[string]int\n55\t\t}\n56\t\tbuckets := map[string]*bucket{}\n57\t\tfor _, s := range sessions {\n58\t\t\tfor _, agent := range s.AgentsUsed {\n59\t\t\t\tb, ok := buckets[agent]\n60\t\t\t\tif !ok {\n61\t\t\t\t\tb = &bucket{\n62\t\t\t\t\t\tcard:        &AgentCard{Agent: agent},\n63\t\t\t\t\t\tlabelCounts: map[string]int{},\n64\t\t\t\t\t\tmodels:      map[string]int{},\n65\t\t\t\t\t\trepos:       map[string]int{},\n66\t\t\t\t\t}\n67\t\t\t\t\tbuckets[agent] = b\n68\t\t\t\t}\n69\t\t\t\tb.card.MeSessions++\n70\t\t\t\t// Sessions carry the authoritative token totals (populated from\n71\t\t\t\t// session.State, which reflects metadata.json). Attributing once\n72\t\t\t\t// per (session, agent) avoids double-counting even if AgentsUsed\n73\t\t\t\t// ever grows past a single entry.\n74\t\t\t\tif s.TokenUsage != nil {\n75\t\t\t\t\tb.card.MeTokens += s.TokenUsage.InputTokens + s.TokenUsage.OutputTokens\n76\t\t\t\t}\n77\t\t\t\tfor _, cp := range s.Checkpoints {\n78\t\t\t\t\tb.card.MeCheckpoints++\n79\t\t\t\t\tfor _, lbl := range cp.Labels {\n80\t\t\t\t\t\tb.labelCounts[lbl]++\n81\t\t\t\t\t}\n82\t\t\t\t}\n83\t\t\t\tfor _, m := range s.ModelsUsed {\n84\t\t\t\t\tb.models[m]++\n85\t\t\t\t}\n86\t\t\t\tif s.Repo != \"\" {\n87\t\t\t\t\tb.repos[s.Repo]++\n88\t\t\t\t}\n89\t\t\t}\n90\t\t}\n91\t\tcards := make([]AgentCard, 0, len(buckets))\n92\t\tfor _, b := range buckets {\n93\t\t\tb.card.MeLabels = labelCountsSorted(b.labelCounts)\n94\t\t\tb.card.MeModels = topNByCount(b.models, 3)\n95\t\t\tb.card.MeRepos = reposSorted(b.repos)\n96\t\t\tcards = append(cards, *b.card)\n97\t\t}\n98\t\tsort.Slice(cards, func(i, j int) bool {\n99\t\t\tif cards[i].MeSessions != cards[j].MeSessions {\n100\t\t\t\treturn cards[i].MeSessions > cards[j].MeSessions\n101\t\t\t}\n102\t\t\treturn cards[i].Agent < cards[j].Agent\n103\t\t})\n104\t\treturn cards\n105\t}\n106\t\n107\t// applyContributors fills AgentCard.Contrib* fields from a ContributorsData\n108\t// map fetched from the server. Leaves zero-valued fields alone when no data\n109\t// is available for a given agent — the renderer shows \"—\" as a placeholder.\n110\tfunc applyContributors(cards []AgentCard, data *ContributorsData) {\n111\t\tif data == nil || len(data.ByAgent) == 0 {\n112\t\t\treturn\n113\t\t}\n114\t\tfor i := range cards {\n115\t\t\tif a, ok := data.ByAgent[cards[i].Agent]; ok && a != nil {\n116\t\t\t\tcards[i].ContribSessions = a.TotalCount\n117\t\t\t\tcards[i].ContribCheckpoints = a.TotalCount\n118\t\t\t\tcards[i].ContribTokens = a.Tokens\n119\t\t\t\tcards[i].ContribCount = a.DistinctContribs\n120\t\t\t}\n121\t\t}\n122\t}\n123\t\n124\t// ViewMode selects what data columns appear in the Agents view.\n125\ttype ViewMode string\n126\t\n127\tconst (\n128\t\tViewMe           ViewMode = \"me\"\n129\t\tViewContributors ViewMode = \"contributors\"\n130\t\tViewBoth         ViewMode = \"both\"\n131\t)\n132\t\n133\t// renderAgentsView draws the Agents view: one AgentCard panel per agent.\n134\t// When mode is \"me\" only, the contributors column is suppressed; \"contributors\"\n135\t// hides the me column; \"both\" shows side-by-side.\n136\t//\n137\t// When the user requested \"both\" but no card carries contributor data\n138\t// (common for --day ranges, solo repos, unauthed users, untracked repos),\n139\t// we auto-collapse to \"me\" so users don't see a column full of em-dashes.\n140\t// Explicit --view contributors still renders even when empty so users can\n141\t// see \"this is where team data lands.\"\n142\tfunc renderAgentsView(cards []AgentCard, mode ViewMode, styles Styles) string {\n143\t\tif len(cards) == 0 {\n144\t\t\treturn styles.muted.Render(\"(no agents in range)\")\n145\t\t}\n146\t\teffectiveMode := mode\n147\t\tif mode == ViewBoth && !hasContribData(cards) {\n148\t\t\teffectiveMode = ViewMe\n149\t\t}\n150\t\tvar blocks []string\n151\t\tfor _, c := range cards {\n152\t\t\tblocks = append(blocks, renderAgentCard(c, effectiveMode, styles))\n153\t\t}\n154\t\treturn strings.Join(blocks, \"\\n\\n\")\n155\t}\n156\t\n157\t// hasContribData returns true when any card has a non-zero contributor\n158\t// signal (sessions, tokens, or distinct contributors). Zero across all cards\n159\t// means the server call returned nothing useful for this view.\n160\tfunc hasContribData(cards []AgentCard) bool {\n161\t\tfor _, c := range cards {\n162\t\t\tif c.ContribSessions > 0 || c.ContribTokens > 0 || c.ContribCount > 0 {\n163\t\t\t\treturn true\n164\t\t\t}\n165\t\t}\n166\t\treturn false\n167\t}\n168\t\n169\tfunc renderAgentCard(c AgentCard, mode ViewMode, styles Styles) string {\n170\t\tvar b strings.Builder\n171\t\tb.WriteString(styles.title.Render(c.Agent))\n172\t\tb.WriteString(\"\\n\")\n173\t\n174\t\tshowMe := mode == ViewMe || mode == ViewBoth\n175\t\tshowContrib := mode == ViewContributors || mode == ViewBoth\n176\t\n177\t\t// Column headers, centered over their metric columns. Padding happens\n178\t\t// on the plain text before styling so ANSI escape bytes don't throw off\n179\t\t// fmt's width counting.\n180\t\tswitch mode {\n181\t\tcase ViewBoth:\n182\t\t\tfmt.Fprintf(&b, \"  %-24s %s %s\\n\",\n183\t\t\t\t\"\", styles.label.Render(leftAlignLabel(\"me\")), styles.label.Render(leftAlignLabel(\"contributors\")))\n184\t\tcase ViewMe:\n185\t\t\tfmt.Fprintf(&b, \"  %-24s %s\\n\", \"\", styles.label.Render(leftAlignLabel(\"me\")))\n186\t\tcase ViewContributors:\n187\t\t\tfmt.Fprintf(&b, \"  %-24s %s\\n\", \"\", styles.label.Render(leftAlignLabel(\"contributors\")))\n188\t\t}\n189\t\n190\t\t// Numeric rows.\n191\t\trow := func(label, meVal, contribVal string) string {\n192\t\t\tswitch mode {\n193\t\t\tcase ViewBoth:\n194\t\t\t\treturn fmt.Sprintf(\"  %-24s %s %s\\n\",\n195\t\t\t\t\tstyles.muted.Render(label),\n196\t\t\t\t\tpadValue(meVal, styles.value),\n197\t\t\t\t\tpadValue(contribVal, styles.value))\n198\t\t\tcase ViewMe:\n199\t\t\t\treturn fmt.Sprintf(\"  %-24s %s\\n\",\n200\t\t