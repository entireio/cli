urn nil\n\t}\n\tvar payload responseItemPayload\n\tif err := json.Unmarshal(rl.Payload, &payload); err != nil {\n\t\treturn nil\n\t}\n\tcall, ok := toolCallFromPayload(payload, rl.Timestamp)\n\tif !ok {\n\t\treturn nil\n\t}\n\treturn []agent.ToolCall{call}\n}\n\n// toolCallFromPayload recognizes the four Codex tool-call payload shapes\n// and returns a normalized ToolCall. Unknown payload types (messages,\n// reasoning, token_count, *_output) return ok=false.\nfunc toolCallFromPayload(p responseItemPayload, rawTimestamp string) (agent.ToolCall, bool) {\n\t// Timestamp parse failures fall back to zero time — tool count is\n\t// still accurate, only per-call duration attribution suffers.\n\tts, err := time.Parse(time.RFC3339, rawTimestamp)\n\tif err != nil {\n\t\tts = time.Time{}\n\t}\n\n\tswitch p.Type {\n\tcase \"function_call\":\n\t\treturn agent.ToolCall{\n\t\t\tName:        p.Name,\n\t\t\tBashCommand: commandFromFunctionArgs(p.Name, p.Arguments),\n\t\t\tTimestamp:   ts,\n\t\t}, true\n\tcase \"local_shell_call\":\n\t\treturn agent.ToolCall{\n\t\t\tName:        \"local_shell\",\n\t\t\tBashCommand: commandFromFunctionArgs(\"local_shell\", p.Arguments),\n\t\t\tTimestamp:   ts,\n\t\t}, true\n\tcase \"custom_tool_call\":\n\t\treturn agent.ToolCall{Name: p.Name, Timestamp: ts}, true\n\tcase \"web_search_call\":\n\t\treturn agent.ToolCall{Name: \"web_search\", Timestamp: ts}, true\n\t}\n\treturn agent.ToolCall{}, false\n}\n\n// commandFromFunctionArgs extracts the shell command string from the\n// arguments JSON for tools whose first arg is a command. Codex's\n// exec_command uses {\"cmd\":\"…\"}; other tools may not have a command.\nconst toolNameExecCommand = \"exec_command\"\n\nfunc commandFromFunctionArgs(name, args string) string {\n\tif name != toolNameExecCommand && name != \"shell\" && name != \"local_shell\" {\n\t\treturn \"\"\n\t}\n\tif args == \"\" {\n\t\treturn \"\"\n\t}\n\tvar v struct {\n\t\tCmd     string   `json:\"cmd,omitempty\"`\n\t\tCommand []string `j