ls, \", \")))\n\t}\n\tif showMe && len(c.MeRepos) > 0 {\n\t\tvar repoLines []string\n\t\tfor _, r := range c.MeRepos {\n\t\t\trepoLines = append(repoLines, fmt.Sprintf(\"%s (%d)\", r.Repo, r.SessionCount))\n\t\t}\n\t\tfmt.Fprintf(&b, \"  %s %s\\n\",\n\t\t\tpadLabel(\"Top repos\", styles.muted),\n\t\t\tstrings.Join(repoLines, \", \"))\n\t}\n\n\treturn b.String()\n}","new_string":"\t// Qualitative fields first: tokens, labels, skills, MCP, tool mix.\n\t// Every row is always rendered so the card has a consistent shape —\n\t// \"—\" marks rows where the data genuinely doesn't exist at this\n\t// aggregation level (contrib side has no per-agent models etc.).\n\torDash := func(s string) string {\n\t\tif s == \"\" {\n\t\t\treturn styles.muted.Render(\"—\")\n\t\t}\n\t\treturn s\n\t}\n\n\tb.WriteString(row(\"Tokens\", tokensIfAny(c.MeTokens, showMe), tokensIfAny(c.ContribTokens, showContrib)))\n\tb.WriteString(row(\"Top labels\",\n\t\torDash(topLabelsInline(c.MeLabels, styles)),\n\t\torDash(topLabelsInline(c.ContribLabels, styles))))\n\tb.WriteString(row(\"Top skills\",\n\t\torDash(joinOrDash(c.MeSkills, styles.info)),\n\t\torDash(joinOrDash(c.ContribSkills, styles.info))))\n\tb.WriteString(row(\"MCP servers\",\n\t\torDash(joinOrDash(c.MeMCPServers, styles.info)),\n\t\torDash(joinOrDash(c.ContribMCPServers, styles.info))))\n\tb.WriteString(row(\"Tool mix\",\n\t\torDash(formatToolMixInline(toolMixFromLabels(c.MeLabels), styles)),\n\t\torDash(formatToolMixInline(c.ContribToolMix, styles))))\n\n\t// Counts.\n\tb.WriteString(row(\"Sessions\", meN(c.MeSessions), contribN(c.ContribSessions)))\n\tb.WriteString(row(\"Checkpoints\", meN(c.MeCheckpoints), contribN(c.ContribCheckpoints)))\n\tif mode == ViewBoth || mode == ViewContributors {\n\t\tcontribCount := \"—\"\n\t\tif c.ContribCount > 0 {\n\t\t\tcontribCount = strconv.Itoa(c.ContribCount)\n\t\t}\n\t\tb.WriteString(row(\"Distinct contribs\", \"—\", styles.muted.Render(contribCount)))\n\t}\n\n\t// Models + repos: me-side only (no