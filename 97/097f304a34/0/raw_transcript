{"parentUuid":"f07c42f3-fdee-4743-8748-d047502c7d9b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/tui.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"time\"\n5\t\n6\t\t\"github.com/charmbracelet/bubbles/viewport\"\n7\t\ttea \"github.com/charmbracelet/bubbletea\"\n8\t)\n9\t\n10\t// TUIModel backs the interactive recap view. It keeps the raw sessions so\n11\t// range + agent toggles can rebuild the View instantly without re-fetching.\n12\t// A viewport holds the rendered body so arrow keys / pgup-pgdn scroll\n13\t// content that's taller than the terminal, without losing the help line.\n14\ttype TUIModel struct {\n15\t\tsessions    []RecapSession\n16\t\tview        View\n17\t\tagentFilter string\n18\t\tagents      []string // agents present in sessions, for cycling\n19\t\tmode        ViewMode // me / contributors / both\n20\t\tstyles      Styles\n21\t\tviewport    viewport.Model\n22\t\tready       bool // true after first WindowSizeMsg sizes the viewport\n23\t\twidth       int\n24\t\theight      int\n25\t}\n26\t\n27\t// NewTUIModel wraps a pre-built View with the state bubbletea needs for\n28\t// interactive toggles. agentFilter is the initial filter (\"\" = all agents).\n29\tfunc NewTUIModel(sessions []RecapSession, initial View, agentFilter string) TUIModel {\n30\t\tmode := initial.Mode\n31\t\tif mode == \"\" {\n32\t\t\tmode = ViewBoth\n33\t\t}\n34\t\treturn TUIModel{\n35\t\t\tsessions:    sessions,\n36\t\t\tview:        initial,\n37\t\t\tagentFilter: agentFilter,\n38\t\t\tagents:      distinctAgents(sessions),\n39\t\t\tmode:        mode,\n40\t\t\tstyles:      NewStyles(true),\n41\t\t\twidth:       100,\n42\t\t\theight:      24,\n43\t\t}\n44\t}\n45\t\n46\t// Init is a no-op — no async work on startup.\n47\tfunc (m TUIModel) Init() tea.Cmd { return nil }\n48\t\n49\t// Update dispatches on keyboard, mouse-wheel, and window-resize messages.\n50\t// Range + agent toggles rebuild the View via BuildView; scroll keys +\n51\t// mouse wheel drive the viewport so content taller than the terminal stays\n52\t// reachable.\n53\tfunc (m TUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n54\t\tswitch msg := msg.(type) {\n55\t\tcase tea.WindowSizeMsg:\n56\t\t\tm.width, m.height = msg.Width, msg.Height\n57\t\t\t// Reserve one line for the help footer.\n58\t\t\tif !m.ready {\n59\t\t\t\tm.viewport = viewport.New(msg.Width, msg.Height-1)\n60\t\t\t\tm.ready = true\n61\t\t\t} else {\n62\t\t\t\tm.viewport.Width = msg.Width\n63\t\t\t\tm.viewport.Height = msg.Height - 1\n64\t\t\t}\n65\t\t\trefreshViewport(&m)\n66\t\t\treturn m, nil\n67\t\tcase tea.MouseMsg:\n68\t\t\t// Only wheel events drive scrolling; other buttons are ignored.\n69\t\t\tswitch msg.Button { //nolint:exhaustive // wheel up/down are the only buttons we handle; rest ignored by design\n70\t\t\tcase tea.MouseButtonWheelUp:\n71\t\t\t\tm.viewport.ScrollUp(3)\n72\t\t\tcase tea.MouseButtonWheelDown:\n73\t\t\t\tm.viewport.ScrollDown(3)\n74\t\t\t}\n75\t\t\treturn m, nil\n76\t\tcase tea.KeyMsg:\n77\t\t\treturn m.handleKey(msg)\n78\t\t}\n79\t\treturn m, nil\n80\t}\n81\t\n82\tfunc (m TUIModel) handleKey(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n83\t\tkey := msg.String()\n84\t\tswitch key {\n85\t\tcase \"q\", \"ctrl+c\", \"esc\":\n86\t\t\treturn m, tea.Quit\n87\t\n88\t\t// Range nav: left/right arrows cycle through the 5 ranges. Tab / Shift-Tab\n89\t\t// do the same (standard dashboard tab affordance). Number shortcuts still\n90\t\t// work for power users, and d/w/m are the one-letter range hotkeys.\n91\t\tcase \"right\", \"l\", \"tab\":\n92\t\t\tm.view = rebuildView(m.sessions, nextRange(m.view.Range), m.agentFilter, m.mode)\n93\t\t\trefreshViewport(&m)\n94\t\tcase \"left\", \"h\", \"shift+tab\":\n95\t\t\tm.view = rebuildView(m.sessions, prevRange(m.view.Range), m.agentFilter, m.mode)\n96\t\t\trefreshViewport(&m)\n97\t\tcase \"1\", \"d\":\n98\t\t\tm.view = rebuildView(m.sessions, RangeDay, m.agentFilter, m.mode)\n99\t\t\trefreshViewport(&m)\n100\t\tcase \"2\", \"w\":\n101\t\t\tm.view = rebuildView(m.sessions, RangeWeek, m.agentFilter, m.mode)\n102\t\t\trefreshViewport(&m)\n103\t\tcase \"3\", \"m\":\n104\t\t\tm.view = rebuildView(m.sessions, RangeMonth, m.agentFilter, m.mode)\n105\t\t\trefreshViewport(&m)\n106\t\tcase \"4\":\n107\t\t\tm.view = rebuildView(m.sessions, Range30d, m.agentFilter, m.mode)\n108\t\t\trefreshViewport(&m)\n109\t\tcase \"5\":\n110\t\t\tm.view = rebuildView(m.sessions, Range90d, m.agentFilter, m.mode)\n111\t\t\trefreshViewport(&m)\n112\t\n113\t\t// Filter toggles: single-key cycle for agent + view mode.\n114\t\tcase \"a\":\n115\t\t\tm.agentFilter = cycleAgent(m.agents, m.agentFilter)\n116\t\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n117\t\t\trefreshViewport(&m)\n118\t\tcase \"v\":\n119\t\t\tm.mode = cycleMode(m.mode)\n120\t\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter, m.mode)\n121\t\t\trefreshViewport(&m)\n122\t\n123\t\t// Vertical scroll. Up/down for single line; space / pgup / pgdn for\n124\t\t// half-page; home/end for jumps. Mouse wheel handled in Update.\n125\t\tcase \"up\", \"k\":\n126\t\t\tm.viewport.ScrollUp(1)\n127\t\tcase \"down\", \"j\":\n128\t\t\tm.viewport.ScrollDown(1)\n129\t\tcase \"pgup\", \"b\":\n130\t\t\tm.viewport.HalfPageUp()\n131\t\tcase \"pgdown\", \" \", \"pgdn\":\n132\t\t\tm.viewport.HalfPageDown()\n133\t\tcase \"home\", \"g\":\n134\t\t\tm.viewport.GotoTop()\n135\t\tcase \"end\", \"G\":\n136\t\t\tm.viewport.GotoBottom()\n137\t\t}\n138\t\treturn m, nil\n139\t}\n140\t\n141\t// rangeOrder is the navigation sequence used by left/right arrow + tab.\n142\t// Stable order means the visual header's tab positions and keyboard\n143\t// traversal order always agree.\n144\tvar rangeOrder = []RangeKey{RangeDay, RangeWeek, RangeMonth, Range30d, Range90d}\n145\t\n146\tfunc nextRange(current RangeKey) RangeKey {\n147\t\tfor i, r := range rangeOrder {\n148\t\t\tif r == current {\n149\t\t\t\treturn rangeOrder[(i+1)%len(rangeOrder)]\n150\t\t\t}\n151\t\t}\n152\t\treturn rangeOrder[0]\n153\t}\n154\t\n155\tfunc prevRange(current RangeKey) RangeKey {\n156\t\tfor i, r := range rangeOrder {\n157\t\t\tif r == current {\n158\t\t\t\treturn rangeOrder[(i-1+len(rangeOrder))%len(rangeOrder)]\n159\t\t\t}\n160\t\t}\n161\t\treturn rangeOrder[0]\n162\t}\n163\t\n164\t// refreshViewport re-renders the body into the viewport after a state\n165\t// change. Keeps scroll position at top when the underlying view changed\n166\t// (range / agent / mode cycle) so users don't get stranded halfway down\n167\t// a different dataset. Free function with explicit pointer so it works\n168\t// alongside bubbletea's value-receiver Update/View contract.\n169\tfunc refreshViewport(m *TUIModel) {\n170\t\tif !m.ready {\n171\t\t\treturn\n172\t\t}\n173\t\tm.viewport.SetContent(RenderStatic(m.view, m.styles, m.viewport.Width))\n174\t\tm.viewport.GotoTop()\n175\t}\n176\t\n177\t// View renders the scrollable body inside the viewport plus a fixed help\n178\t// line at the bottom. First frame (before WindowSizeMsg arrives) falls back\n179\t// to direct static rendering so there's no blank flash.\n180\tfunc (m TUIModel) View() string {\n181\t\thelp := m.styles.help.Render(\"  ←→/tab  range  ·  a  agent  ·  v  view  ·  ↑↓  scroll  ·  q  quit\")\n182\t\tif !m.ready {\n183\t\t\treturn RenderStatic(m.view, m.styles, m.width) + \"\\n\" + help\n184\t\t}\n185\t\treturn m.viewport.View() + \"\\n\" + help\n186\t}\n187\t\n188\t// rebuildView is a tiny wrapper that anchors Now at call time so range math\n189\t// stays correct across long-running TUI sessions.\n190\tfunc rebuildView(sessions []RecapSession, r RangeKey, agent string, mode ViewMode) View {\n191\t\treturn BuildView(sessions, BuildOpts{Range: r, AgentFilter: agent, Mode: mode, Now: time.Now()})\n192\t}\n193\t\n194\t// cycleMode advances the view mode: both → me → contributors → both.\n195\tfunc cycleMode(current ViewMode) ViewMode {\n196\t\tswitch current {\n197\t\tcase ViewBoth:\n198\t\t\treturn ViewMe\n199\t\tcase ViewMe:\n200\t\t\treturn ViewContributors\n201\t\tcase ViewContributors:\n202\t\t\treturn ViewBoth\n203\t\t}\n204\t\treturn ViewBoth\n205\t}\n206\t\n207\t// cycleAgent advances the filter in a stable round-robin: \"\" → agents[0] →\n208\t// agents[1] → … → \"\". Stable order means the same key press always moves\n209\t// to the same next agent.\n210\tfunc cycleAgent(agents []string, current string) string {\n211\t\tif len(agents) == 0 {\n212\t\t\treturn \"\"\n213\t\t}\n214\t\tif current == \"\" {\n215\t\t\treturn agents[0]\n216\t\t}\n217\t\tfor i, a := range agents {\n218\t\t\tif a == current {\n219\t\t\t\tif i+1 < len(agents) {\n220\t\t\t\t\treturn agents[i+1]\n221\t\t\t\t}\n222\t\t\t\treturn \"\"\n223\t\t\t}\n224\t\t}\n225\t\treturn \"\"\n226\t}\n227\t\n228\tfunc distinctAgents(sessions []RecapSession) []string {\n229\t\tseen := map[string]bool{}\n230\t\tvar out []string\n231\t\tfor _, s := range sessions {\n232\t\t\tfor _, a := range s.AgentsUsed {\n233\t\t\t\tif !seen[a] {\n234\t\t\t\t\tseen[a] = true\n235\t\t\t\t\tout = append(out, a)\n236\t\t\t\t}\n237\t\t\t}\n238\t\t}\n239\t\treturn out\n240\t}"},"type":"attachment","uuid":"4d97f248-a9c0-4d89-b356-6592ca9873b1","timestamp":"2026-04-22T06:22:40.197Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
