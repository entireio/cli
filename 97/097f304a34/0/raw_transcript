w with the state bubbletea needs for\n// interactive toggles. agentFilter is the initial filter (\"\" = all agents).\nfunc NewTUIModel(sessions []RecapSession, initial View, agentFilter string) TUIModel {\n\treturn TUIModel{\n\t\tsessions:    sessions,\n\t\tview:        initial,\n\t\tagentFilter: agentFilter,\n\t\tagents:      distinctAgents(sessions),\n\t\tstyles:      NewStyles(true),\n\t\twidth:       100,\n\t\theight:      24,\n\t}\n}\n\n// Init is a no-op — no async work on startup.\nfunc (m TUIModel) Init() tea.Cmd { return nil }\n\n// Update dispatches on keyboard and window-resize messages. Range + agent\n// toggles rebuild the View via BuildView; nothing else changes.\n//\n//nolint:ireturn // bubbletea.Model is the required return type for tea.Model's Update contract\nfunc (m TUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n\tswitch msg := msg.(type) {\n\tcase tea.WindowSizeMsg:\n\t\tm.width, m.height = msg.Width, msg.Height\n\t\treturn m, nil\n\tcase tea.KeyMsg:\n\t\treturn m.handleKey(msg)\n\t}\n\treturn m, nil\n}\n\n//nolint:ireturn // bubbletea.Model return type mirrors Update's contract\nfunc (m TUIModel) handleKey(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n\tkey := msg.String()\n\tswitch key {\n\tcase \"q\", \"ctrl+c\", \"esc\":\n\t\treturn m, tea.Quit\n\tcase \"1\", \"d\":\n\t\tm.view = rebuildView(m.sessions, RangeDay, m.agentFilter)\n\tcase \"2\", \"w\":\n\t\tm.view = rebuildView(m.sessions, RangeWeek, m.agentFilter)\n\tcase \"3\", \"m\":\n\t\tm.view = rebuildView(m.sessions, RangeMonth, m.agentFilter)\n\tcase \"4\":\n\t\tm.view = rebuildView(m.sessions, Range30d, m.agentFilter)\n\tcase \"5\":\n\t\tm.view = rebuildView(m.sessions, Range90d, m.agentFilter)\n\tcase \"a\":\n\t\tm.agentFilter = cycleAgent(m.agents, m.agentFilter)\n\t\tm.view = rebuildView(m.sessions, m.view.Range, m.agentFilter)\n\t}\n\treturn m, nil\n}\n\n// View renders the current state via the static renderer, plus a help line\n// at the bottom so users discover the keybinds without reading docs.\nfunc (m TUIModel) View() string {\n\tbody := RenderStatic(m.view, m.styles, m.width)\n\thelp := m.styles.help.Render(\"  d w m 4 5  range  ·  a  agent filter  ·  q  quit\")\n\treturn body + \"\\n\" + help\n}\n\n// rebuildView is a tiny wrapper that anchors Now at call time so range math\n// stays correct across long-running TUI sessions.\nfunc rebuildView(sessions []RecapSession, r RangeKey, agent string) View {\n\treturn BuildView(sessions, BuildOpts{Range: r, AgentFilter: agent, Now: time.Now()})\n}\n\n// cycleAgent advances the filter in a stable round-robin: \"\" → agents[0] →\n// agents[1] → … → \"\". Stable order means the same key press always moves\n// to the same next agent.\nfunc cycleAgent(agents []string, current string) string {\n\tif len(agents) == 0 {\n\t\treturn \"\"\n\t}\n\tif current == \"\" {\n\t\treturn agents[0]\n\t}\n\tfor i, a := range agents {\n\t\tif a == current {\n\t\t\tif i+1 < len(agents) {\n\t\t\t\treturn agents[i+1]\n\t\t\t}\n\t\t\treturn \"\"\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc distinctAgents(sessions []RecapSession) []string {\n\tseen := map[string]bool{}\n\tvar out []string\n\tfor _, s := range sessions {\n\t\tfor _, a := range s.AgentsUsed {\n\t\t\tif !seen[a] {\n\t\t\t\tseen[a] = true\n\t\t\t\tout = append(out, a)\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}\n","structuredPatch":[{"oldStart":13,"oldLines":6,"newStart":13,"newLines":7,"lines":["   view        View","   agentFilter string","   agents      []string // agents present in sessions, for cycling","+  mode        ViewMode // me / contributors / both","   styles      Styles","   width       int","   height      int"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"2ba724b0-e6ba-42b6-b016-967575a3ff00","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
