list of filtered sessions into per-agent cards for\n52\t// the \"me\" side. Contributor fields are left zero — the server-overview\n53\t// integration fills them in later.\n54\tfunc buildAgentCards(sessions []RecapSession) []AgentCard {\n55\t\ttype bucket struct {\n56\t\t\tcard        *AgentCard\n57\t\t\tlabelCounts map[string]int\n58\t\t\tskills      map[string]int\n59\t\t\tmcp         map[string]int\n60\t\t\ttoolMix     map[string]int\n61\t\t\tmodels      map[string]int\n62\t\t\trepos       map[string]int\n63\t\t\tfiles       map[string]struct{}\n64\t\t}\n65\t\tbuckets := map[string]*bucket{}\n66\t\tfor _, s := range sessions {\n67\t\t\tfor _, agent := range s.AgentsUsed {\n68\t\t\t\tb, ok := buckets[agent]\n69\t\t\t\tif !ok {\n70\t\t\t\t\tb = &bucket{\n71\t\t\t\t\t\tcard:        &AgentCard{Agent: agent},\n72\t\t\t\t\t\tlabelCounts: map[string]int{},\n73\t\t\t\t\t\tskills:      map[string]int{},\n74\t\t\t\t\t\tmcp:         map[string]int{},\n75\t\t\t\t\t\ttoolMix:     map[string]int{},\n76\t\t\t\t\t\tmodels:      map[string]int{},\n77\t\t\t\t\t\trepos:       map[string]int{},\n78\t\t\t\t\t\tfiles:       map[string]struct{}{},\n79\t\t\t\t\t}\n80\t\t\t\t\tbuckets[agent] = b\n81\t\t\t\t}\n82\t\t\t\tb.card.MeSessions++\n83\t\t\t\t// Sessions carry the authoritative token totals (populated from\n84\t\t\t\t// session.State, which reflects metadata.json). Attributing once\n85\t\t\t\t// per (session, agent) avoids double-counting.\n86\t\t\t\tif s.TokenUsage != nil {\n87\t\t\t\t\tb.card.MeTokens += s.TokenUsage.InputTokens + s.TokenUsage.OutputTokens\n88\t\t\t\t}\n89\t\t\t\tfor _, f := range s.FilesTouched {\n90\t\t\t\t\tb.files[f] = struct{}{}\n91\t\t\t\t}\n92\t\t\t\tfor _, cp := range s.Checkpoints {\n93\t\t\t\t\tb.card.MeCheckpoints++\n94\t\t\t\t\tfor _, lbl := range cp.Labels {\n95\t\t\t\t\t\tb.labelCounts[lbl]++\n96\t\t\t\t\t}\n97\t\t\t\t\tfor _, sk := range cp.SkillsUsed {\n98\t\t\t\t\t\tb.skills[sk]++\n99\t\t\t\t\t}\n100\t\t\t\t\tfor _, m := range cp.MCPServers {\n101\t\t\t\t\t\tb.mcp[m]++\n102\t\t\t\t\t}\n103\t\t\t\t\tif cp.ToolProfile != nil {\n104\t\t\t\t\t\tfor k, v := range cp.ToolProfile.Categories {\n105\t\t\t\t\t\t\tb.toolMix[k] += v.Count\n106\t\t\t\t\t\t}\n107\t\t\t\t\t}\n108\t\t\t\t\tfor _, f := range cp.FilesTouched {\n109\t\t\t\t\t\tb.files[f] = struct{}{}\n110\t\t\t\t\t}\n111\t\t\t\t}\n112\t\t\t\tfor _, m := range s.ModelsUsed {\n113\t\t\t\t\tb.models[m]++\n114\t\t\t\t}\n115\t\t\t\tif s.Repo != \"\" {\n116\t\t\t\t\tb.repos[s.Repo]++\n117\t\t\t\t}\n118\t\t\t}\n119\t\t}\n120\t\tcards := make([]AgentCard, 0, len(buckets))\n121\t\tfor _, b := range buckets {\n122\t\t\tb.card.MeLabels = labelCountsSorted(b.labelCounts)\n123\t\t\tb.card.MeSkills = topNByCount(b.skills, 3)\n124\t\t\tb.card.MeMCPServers = topNByCount(b.mcp, 3)\n125\t\t\tb.card.MeToolMix = b.toolMix\n126\t\t\tb.card.MeModels = topNByCount(b.models, 3)\n127\t\t\tb.card.MeRepos = reposSorted(b.repos)\n128\t\t\tb.card.MeFilesChanged = len(b.files)\n129\t\t\tcards = append(cards, *b.card)\n130\t\t}\n131\t\tsort.Slice(cards, func(i, j int) bool {\n132\t\t\tif cards[i].MeSessions != cards[j].MeSessions {\n133\t\t\t\treturn cards[i].MeSessions > cards[j].MeSessions\n134\t\t\t}\n135\t\t\treturn cards[i].Agent < cards[j].Agent\n136\t\t})\n137\t\treturn cards\n138\t}\n139\t\n140\t// applyContributors fills AgentCard.Contrib* fields from a ContributorsData\n141\t// map fetched from the server. Leaves zero-valued fields alone when no data\n142\t// is available for a given agent — the renderer shows \"—\" as a placeholder.\n143\tfunc applyContributors(cards []AgentCard, data *ContributorsData) {\n144\t\tif data == nil || len(data.ByAgent) == 0 {\n145\t\t\treturn\n146\t\t}\n147\t\tfor i := range cards {\n148\t\t\tif a, ok := data.ByAgent[cards[i].Agent]; ok && a != nil {\n149\t\t\t\tcards[i].ContribSessions = a.TotalCount\n150\t\t\t\tcards[i].ContribCheckpoints = a.TotalCount\n151\t\t\t\tcards[i].ContribTokens = a.Tokens\n152\t\t\t\tcards[i].ContribCount = a.DistinctContribs\n153\t\t\t\tcards[i].ContribLabels = a.Labels\n154\t\t\t\tcards[i].ContribSkills = a.Skills\n155\t\t\t\tcards[i].ContribMCPServers = a.MCPServers\n156\t\t\t\tcards[i].ContribToolMix = a.ToolMix\n157\t\t\t}\n158\t\t}\n159\t}\n160\t\n161\t// ViewMode selects what data columns appear in the Agents view.\n162\ttype ViewMode string\n163\t\n164\tconst (\n165\t\tViewMe           ViewMode = \"me\"\n166\t\tViewContributors ViewMode = \"contributors\"\n167\t\tViewBoth         ViewMode = \"both\"\n168\t)\n169\t\n170\t// renderAgentsView draws the Agents view: one AgentCard panel per agent.\n171\t// When mode is \"me\" only, the contributors column is suppressed; \"contributors\"\n172\t// hides the me column; \"both\" shows side-by-side.\n173\t//\n174\t// When the user requested \"both\" but no card carries contributor data\n175\t// (common for --day ranges, solo repos, unauthed users, untracked repos),\n176\t// we auto-collapse to \"me\" so users don't see a column full of em-dashes.\n177\t// Explicit --view contributors still renders even when empty so users can\n178\t// see \"this is where team data lands.\"\n179\tfunc renderAgentsView(cards []AgentCard, mode ViewMode, styles Styles) string {\n180\t\tif len(cards) == 0 {\n181\t\t\treturn styles.muted.Render(\"(no agents in range)\")\n182\t\t}\n183\t\teffectiveMode := mode\n184\t\tif mode == ViewBoth && !hasContribData(cards) {\n185\t\t\teffectiveMode = ViewMe\n186\t\t}\n187\t\tvar blocks []string\n188\t\tfor _, c := range cards {\n189\t\t\tblocks = append(blocks, renderAgentCard(c, effectiveMode, styles))\n190\t\t}\n191\t\treturn strings.Join(blocks, \"\\n\\n\")\n192\t}\n193\t\n194\t// hasContribData returns true when any card has a non-zero contributor\n195\t// signal (sessions, tokens, or distinct contributors). Zero across all cards\n196\t// means the server call returned nothing useful for this view.\n197\tfunc hasContribData(cards []AgentCard) bool {\n198\t\tfor _, c := range cards {\n199\t\t\tif c.ContribSession