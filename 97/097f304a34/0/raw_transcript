{"parentUuid":"8e0b6088-bdb1-4998-b16d-0241d48f5e6d","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/render_static.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"strconv\"\n6\t\t\"strings\"\n7\t)\n8\t\n9\tconst (\n10\t\tplaceholderDash = \"—\"\n11\t\tunknownAgent    = \"unknown\"\n12\t)\n13\t\n14\t// RenderStatic produces the full static (non-TUI) recap output for a view.\n15\t// Width is the outer terminal width — the function clamps to a 60-cell\n16\t// minimum and uses the space for panel borders + content padding.\n17\t//\n18\t// Accessible / piped mode: pass styles from NewStyles(false). Output\n19\t// then contains no ANSI escapes and no Unicode borders; panels degrade to\n20\t// section headers separated by blank lines.\n21\tfunc RenderStatic(view View, styles Styles, width int) string {\n22\t\tif width < 60 {\n23\t\t\twidth = 60\n24\t\t}\n25\t\tvar b strings.Builder\n26\t\n27\t\t// Panel 1: Summary band.\n28\t\tb.WriteString(renderPanel(view.Title, renderSummaryBand(view.Summary, styles), width, styles))\n29\t\tb.WriteString(\"\\n\\n\")\n30\t\n31\t\t// Panel 2: Activity strip — range-dependent.\n32\t\tb.WriteString(renderActivityStrip(view, styles))\n33\t\tb.WriteString(\"\\n\\n\")\n34\t\n35\t\t// Panel 3: Session list.\n36\t\tb.WriteString(renderPanel(\"Sessions\", renderSessionList(view.Sessions, styles), width, styles))\n37\t\tb.WriteString(\"\\n\\n\")\n38\t\n39\t\t// Panel 4: Repos · Worktrees · Labels (3-column bottom panel).\n40\t\tb.WriteString(renderBottomPanel(view, styles))\n41\t\n42\t\treturn b.String()\n43\t}\n44\t\n45\tfunc renderSummaryBand(s SummaryBand, styles Styles) string {\n46\t\tkv := func(label, value string) string {\n47\t\t\treturn styles.label.Render(label) + \"  \" + styles.value.Render(value)\n48\t\t}\n49\t\n50\t\tdom := placeholderDash\n51\t\tif s.DominantLabel != \"\" {\n52\t\t\tdom = fmt.Sprintf(\"▪ %s  %d%%\", s.DominantLabel, int(s.DominantLabelPct*100))\n53\t\t}\n54\t\n55\t\ttopAgent := s.TopAgent\n56\t\tif topAgent == \"\" {\n57\t\t\ttopAgent = placeholderDash\n58\t\t}\n59\t\tif s.AgentFilter != \"\" {\n60\t\t\ttopAgent = styles.accent.Render(\"[\"+s.AgentFilter+\"]\") + \" (filter)\"\n61\t\t}\n62\t\ttopSkill := placeholderDash // skill wiring lives in a later chunk; keep the slot visible\n63\t\ttopModel := s.TopModel\n64\t\tif topModel == \"\" {\n65\t\t\ttopModel = placeholderDash\n66\t\t}\n67\t\n68\t\tline1 := kv(\"Top agent\", topAgent) + \"  \" + kv(\"Top skill\", topSkill)\n69\t\tline2 := kv(\"Dominant \", dom) + \"  \" + kv(\"Top model\", topModel)\n70\t\ttotals := fmt.Sprintf(\"%d sessions · %d checkpoints · %s tokens · %d commits\",\n71\t\t\ts.SessionCount, s.CheckpointCount, formatTokens(s.TokenTotal), s.CommitCount)\n72\t\tline3 := kv(\"Totals    \", totals)\n73\t\treturn line1 + \"\\n\" + line2 + \"\\n\\n\" + line3\n74\t}\n75\t\n76\tfunc renderActivityStrip(view View, styles Styles) string {\n77\t\tif len(view.Activity) == 0 {\n78\t\t\treturn styles.muted.Render(\"  (no activity in range)\")\n79\t\t}\n80\t\tvar header string\n81\t\tswitch view.Range {\n82\t\tcase RangeDay:\n83\t\t\theader = \"Activity (24h)\"\n84\t\tcase RangeWeek:\n85\t\t\theader = \"Activity (7d)\"\n86\t\tcase RangeMonth:\n87\t\t\theader = \"Activity (this month)\"\n88\t\tcase Range30d:\n89\t\t\theader = \"Activity (30d)\"\n90\t\tcase Range90d:\n91\t\t\theader = \"Activity (90d)\"\n92\t\tdefault:\n93\t\t\theader = \"Activity\"\n94\t\t}\n95\t\n96\t\tif view.Range == RangeDay && len(view.Activity) == 24 {\n97\t\t\tvar events [24]int\n98\t\t\tcopy(events[:], view.Activity)\n99\t\t\treturn styles.label.Render(header) + \"\\n\" + renderIntraDayStrip(events, styles)\n100\t\t}\n101\t\treturn styles.label.Render(header) + \"\\n\" + renderHeatmapStrip(view.Activity, maxOf(view.Activity), styles)\n102\t}\n103\t\n104\tfunc renderSessionList(rows []SessionRow, styles Styles) string {\n105\t\tif len(rows) == 0 {\n106\t\t\treturn styles.muted.Render(\"(no sessions in range)\")\n107\t\t}\n108\t\tvar b strings.Builder\n109\t\tfor i, r := range rows {\n110\t\t\tagent := r.Agent\n111\t\t\tif agent == \"\" {\n112\t\t\t\tagent = unknownAgent\n113\t\t\t}\n114\t\t\tlabel := r.Label\n115\t\t\tif label == \"\" {\n116\t\t\t\tlabel = styles.muted.Render(placeholderDash)\n117\t\t\t}\n118\t\t\thint := string(r.Hint)\n119\t\t\thintStyle := styles.styleForHint(r.Hint)\n120\t\t\thintRendered := \"\"\n121\t\t\tif hint != \"\" {\n122\t\t\t\thintRendered = hintStyle.Render(\"▶ \" + hint)\n123\t\t\t}\n124\t\t\tline := fmt.Sprintf(\"%s %-14s %-8s ▪ %-16s %2d cp   %s\",\n125\t\t\t\tstyles.accent.Render(r.Badge),\n126\t\t\t\tagent,\n127\t\t\t\tr.Span,\n128\t\t\t\tlabel,\n129\t\t\t\tr.Checkpoints,\n130\t\t\t\thintRendered,\n131\t\t\t)\n132\t\t\tb.WriteString(strings.TrimRight(line, \" \"))\n133\t\t\tif i < len(rows)-1 {\n134\t\t\t\tb.WriteString(\"\\n\")\n135\t\t\t}\n136\t\t}\n137\t\treturn b.String()\n138\t}\n139\t\n140\tfunc renderBottomPanel(view View, styles Styles) string {\n141\t\t// 3 columns: Repos (optional), Worktrees, Labels.\n142\t\t// Simple left-aligned columns; width split handled by caller's terminal.\n143\t\tvar cols []string\n144\t\n145\t\tif len(view.Repos) > 0 {\n146\t\t\tvar rb strings.Builder\n147\t\t\trb.WriteString(styles.label.Render(\"Repos\") + \"\\n\")\n148\t\t\tfor _, r := range view.Repos {\n149\t\t\t\tfmt.Fprintf(&rb, \"%-20s %d sess\\n\", r.Repo, r.SessionCount)\n150\t\t\t}\n151\t\t\tcols = append(cols, strings.TrimRight(rb.String(), \"\\n\"))\n152\t\t}\n153\t\n154\t\tif len(view.Worktrees) > 0 {\n155\t\t\tvar wb strings.Builder\n156\t\t\twb.WriteString(styles.label.Render(\"Worktrees\") + \"\\n\")\n157\t\t\tfor _, w := range view.Worktrees {\n158\t\t\t\tmarker := \" \"\n159\t\t\t\tif w.HasUncommitted {\n160\t\t\t\t\tmarker = styles.warn.Render(\"⇈\")\n161\t\t\t\t}\n162\t\t\t\tid := w.WorktreeID\n163\t\t\t\tif id == \"\" {\n164\t\t\t\t\tid = \"(default)\"\n165\t\t\t\t}\n166\t\t\t\tfmt.Fprintf(&wb, \"%-20s %d sess %s\\n\", id, w.SessionCount, marker)\n167\t\t\t}\n168\t\t\tcols = append(cols, strings.TrimRight(wb.String(), \"\\n\"))\n169\t\t}\n170\t\n171\t\tif len(view.Labels) > 0 {\n172\t\t\tvar lb strings.Builder\n173\t\t\tlb.WriteString(styles.label.Render(\"Labels\") + \"\\n\")\n174\t\t\t// Use max count as scale for gradient bar so the topmost label is full.\n175\t\t\tmaxCount := 0\n176\t\t\tfor _, l := range view.Labels {\n177\t\t\t\tif l.Count > maxCount {\n178\t\t\t\t\tmaxCount = l.Count\n179\t\t\t\t}\n180\t\t\t}\n181\t\t\tfor _, l := range view.Labels {\n182\t\t\t\tbar := renderGradientBar(l.Count, maxCount, styles)\n183\t\t\t\tfmt.Fprintf(&lb, \"%-16s %s\\n\", l.Label, bar)\n184\t\t\t}\n185\t\t\tcols = append(cols, strings.TrimRight(lb.String(), \"\\n\"))\n186\t\t}\n187\t\n188\t\tif len(cols) == 0 {\n189\t\t\treturn \"\"\n190\t\t}\n191\t\treturn strings.Join(cols, \"\\n\\n\")\n192\t}\n193\t\n194\t// helpers -------------------------------------------------------------------\n195\t\n196\tfunc maxOf(xs []int) int {\n197\t\tm := 0\n198\t\tfor _, v := range xs {\n199\t\t\tif v > m {\n200\t\t\t\tm = v\n201\t\t\t}\n202\t\t}\n203\t\treturn m\n204\t}\n205\t\n206\t// formatTokens renders a token count compactly: 142000 → \"142k\", 1500000 → \"1.5M\".\n207\tfunc formatTokens(n int) string {\n208\t\tswitch {\n209\t\tcase n >= 1_000_000:\n210\t\t\treturn fmt.Sprintf(\"%.1fM\", float64(n)/1_000_000)\n211\t\tcase n >= 1_000:\n212\t\t\treturn fmt.Sprintf(\"%dk\", n/1_000)\n213\t\tdefault:\n214\t\t\treturn strconv.Itoa(n)\n215\t\t}\n216\t}"},"type":"attachment","uuid":"d9027f0f-6c0b-4006-a14e-017d8bcebef6","timestamp":"2026-04-22T00:06:34.816Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
