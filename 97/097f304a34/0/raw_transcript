ngeDay, AgentFilter: \"codex\", Now: now})\n45\t\tif view.Summary.SessionCount != 1 {\n46\t\t\tt.Errorf(\"SessionCount = %d, want 1\", view.Summary.SessionCount)\n47\t\t}\n48\t\tif view.Summary.AgentFilter != \"codex\" {\n49\t\t\tt.Errorf(\"AgentFilter = %q, want codex\", view.Summary.AgentFilter)\n50\t\t}\n51\t}\n52\t\n53\tfunc TestBuildRecapView_HidesReposWhenSingleRepo(t *testing.T) {\n54\t\tt.Parallel()\n55\t\tnow := time.Date(2026, 4, 21, 15, 0, 0, 0, time.UTC)\n56\t\tsessions := []RecapSession{\n57\t\t\t{SessionID: \"a\", StartedAt: now.Add(-1 * time.Hour), LastInteraction: now, Repo: \"entireio/cli\"},\n58\t\t\t{SessionID: \"b\", StartedAt: now.Add(-2 * time.Hour), LastInteraction: now, Repo: \"entireio/cli\"},\n59\t\t}\n60\t\tview := BuildView(sessions, BuildOpts{Range: RangeDay, Now: now})\n61\t\tif view.Repos != nil {\n62\t\t\tt.Errorf(\"single-repo → Repos should be nil, got %v\", view.Repos)\n63\t\t}\n64\t}\n65\t\n66\tfunc TestBuildRecapView_ShowsReposWhenMultiple(t *testing.T) {\n67\t\tt.Parallel()\n68\t\tnow := time.Date(2026, 4, 21, 15, 0, 0, 0, time.UTC)\n69\t\tsessions := []RecapSession{\n70\t\t\t{SessionID: \"a\", StartedAt: now.Add(-1 * time.Hour), LastInteraction: now, Repo: \"entireio/cli\"},\n71\t\t\t{SessionID: \"b\", StartedAt: now.Add(-2 * time.Hour), LastInteraction: now, Repo: \"entireio/ent.io\"},\n72\t\t}\n73\t\tview := BuildView(sessions, BuildOpts{Range: RangeDay, Now: now})\n74\t\tif len(view.Repos) != 2 {\n75\t\t\tt.Errorf(\"multi-repo → len(Repos) = %d, want 2: %v\", len(view.Repos), view.Repos)\n76\t\t}\n77\t}\n78\t\n79\tfunc TestBuildRecapView_ActivityBucketsForDay(t *testing.T) {\n80\t\tt.Parallel()\n81\t\tnow := time.Date(2026, 4, 21, 23, 0, 0, 0, time.UTC)\n82\t\t// Checkpoint at 10am today.\n83\t\tcp := RecapCheckpoint{\n84\t\t\tCreatedAt: time.Date(2026, 4, 21, 10, 0, 0, 0, time.UTC),\n85\t\t\tLabels:    []string{\"bug_fix\"},\n86\t\t}\n87\t\tsessions := []RecapSession{{\n88\t\t\tStartedAt:       now.Add(-1 * time.Hour),\n89\t\t\tLastInteraction: now,\n90\t\t\tCheckpoints:     []RecapCheckpoint{cp},\n91\t\t}}\n92\t\tview := BuildView(sessions, BuildOpts{Range: RangeDay, Now: now})\n93\t\tif len(view.Activity) != 24 {\n94\t\t\tt.Fatalf(\"Day activity should have 24 hourly buckets, got %d\", len(view.Activity))\n95\t\t}\n96\t\tif view.Activity[10] != 1 {\n97\t\t\tt.Errorf(\"expected 1 event at hour 10, got %d\", view.Activity[10])\n98\t\t}\n99\t}\n100\t\n101\tfunc TestRangeBounds_DayEqualsMidnightToMidnight(t *testing.T) {\n102\t\tt.Parallel()\n103\t\tnow := time.Date(2026, 4, 21, 15, 30, 0, 0, time.UTC)\n104\t\tstart, end := RangeDay.bounds(now)\n105\t\twantStart := time.Date(2026, 4, 21, 0, 0, 0, 0, time.UTC)\n106\t\twantEnd := time.Date(2026, 4, 22, 0, 0, 0, 0, time.UTC)\n107\t\tif !start.Equal(wantStart) || !end.Equal(wantEnd) {\n108\t\t\tt.Errorf(\"Day bounds = [%v, %v), want [%v, %v)\", start, end, wantStart, wantEnd)\n109\t\t}\n110\t}\n111\t\n112\tfunc TestRangeBounds_MonthIsCalendarAligned(t *testing.T) {\n113\t\tt.Parallel()\n114\t\tnow := time.Date(2026, 4, 21, 15, 0, 0, 0, time.UTC)\n115\t\tstart, end := RangeMonth.bounds(now)\n116\t\twantStart := time.Date(2026, 4, 1, 0, 0, 0, 0, time.UTC)\n117\t\twantEnd := time.Date(2026, 5, 1, 0, 0, 0, 0, time.UTC)\n118\t\tif !start.Equal(wantStart) || !end.Equal(wantEnd) {\n119\t\t\tt.Errorf(\"Month bounds = [%v, %v), want [%v, %v)\", start, end, wantStart, wantEnd)\n120\t\t}\n121\t}"},"type":"attachment","uuid":"38c3e398-1156-4b43-a703-c9fe64aa9961","timestamp":"2026-04-22T00:01:43.910Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
