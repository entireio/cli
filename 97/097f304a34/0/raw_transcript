{"parentUuid":"6158d970-438b-4bd1-ad29-a5a2219e37e4","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/render_static.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"strings\"\n6\t)\n7\t\n8\t// RenderStatic produces the full static (non-TUI) recap output for a view.\n9\t// Width is the outer terminal width — the function clamps to a 60-cell\n10\t// minimum and uses the space for panel borders + content padding.\n11\t//\n12\t// Accessible / piped mode: pass styles from newRecapStyles(false). Output\n13\t// then contains no ANSI escapes and no Unicode borders; panels degrade to\n14\t// section headers separated by blank lines.\n15\tfunc RenderStatic(view RecapView, styles recapStyles, width int) string {\n16\t\tif width < 60 {\n17\t\t\twidth = 60\n18\t\t}\n19\t\tvar b strings.Builder\n20\t\n21\t\t// Panel 1: Summary band.\n22\t\tb.WriteString(renderPanel(view.Title, renderSummaryBand(view.Summary, styles), width, styles))\n23\t\tb.WriteString(\"\\n\\n\")\n24\t\n25\t\t// Panel 2: Activity strip — range-dependent.\n26\t\tb.WriteString(renderActivityStrip(view, styles))\n27\t\tb.WriteString(\"\\n\\n\")\n28\t\n29\t\t// Panel 3: Session list.\n30\t\tb.WriteString(renderPanel(\"Sessions\", renderSessionList(view.Sessions, styles), width, styles))\n31\t\tb.WriteString(\"\\n\\n\")\n32\t\n33\t\t// Panel 4: Repos · Worktrees · Labels (3-column bottom panel).\n34\t\tb.WriteString(renderBottomPanel(view, styles))\n35\t\n36\t\treturn b.String()\n37\t}\n38\t\n39\tfunc renderSummaryBand(s SummaryBand, styles recapStyles) string {\n40\t\tkv := func(label, value string) string {\n41\t\t\treturn styles.label.Render(label) + \"  \" + styles.value.Render(value)\n42\t\t}\n43\t\n44\t\tdom := \"—\"\n45\t\tif s.DominantLabel != \"\" {\n46\t\t\tdom = fmt.Sprintf(\"▪ %s  %d%%\", s.DominantLabel, int(s.DominantLabelPct*100))\n47\t\t}\n48\t\n49\t\ttopAgent := s.TopAgent\n50\t\tif topAgent == \"\" {\n51\t\t\ttopAgent = \"—\"\n52\t\t}\n53\t\tif s.AgentFilter != \"\" {\n54\t\t\ttopAgent = styles.accent.Render(\"[\"+s.AgentFilter+\"]\") + \" (filter)\"\n55\t\t}\n56\t\ttopSkill := \"—\" // skill wiring lives in a later chunk; keep the slot visible\n57\t\ttopModel := s.TopModel\n58\t\tif topModel == \"\" {\n59\t\t\ttopModel = \"—\"\n60\t\t}\n61\t\n62\t\tline1 := kv(\"Top agent\", topAgent) + \"  \" + kv(\"Top skill\", topSkill)\n63\t\tline2 := kv(\"Dominant \", dom) + \"  \" + kv(\"Top model\", topModel)\n64\t\ttotals := fmt.Sprintf(\"%d sessions · %d checkpoints · %s tokens · %d commits\",\n65\t\t\ts.SessionCount, s.CheckpointCount, formatTokens(s.TokenTotal), s.CommitCount)\n66\t\tline3 := kv(\"Totals    \", totals)\n67\t\treturn line1 + \"\\n\" + line2 + \"\\n\\n\" + line3\n68\t}\n69\t\n70\tfunc renderActivityStrip(view RecapView, styles recapStyles) string {\n71\t\tif len(view.Activity) == 0 {\n72\t\t\treturn styles.muted.Render(\"  (no activity in range)\")\n73\t\t}\n74\t\tvar header string\n75\t\tswitch view.Range {\n76\t\tcase RangeDay:\n77\t\t\theader = \"Activity (24h)\"\n78\t\tcase RangeWeek:\n79\t\t\theader = \"Activity (7d)\"\n80\t\tcase RangeMonth:\n81\t\t\theader = \"Activity (this month)\"\n82\t\tcase Range30d:\n83\t\t\theader = \"Activity (30d)\"\n84\t\tcase Range90d:\n85\t\t\theader = \"Activity (90d)\"\n86\t\tdefault:\n87\t\t\theader = \"Activity\"\n88\t\t}\n89\t\n90\t\tif view.Range == RangeDay && len(view.Activity) == 24 {\n91\t\t\tvar events [24]int\n92\t\t\tcopy(events[:], view.Activity)\n93\t\t\treturn styles.label.Render(header) + \"\\n\" + renderIntraDayStrip(events, styles)\n94\t\t}\n95\t\treturn styles.label.Render(header) + \"\\n\" + renderHeatmapStrip(view.Activity, maxOf(view.Activity), styles)\n96\t}\n97\t\n98\tfunc renderSessionList(rows []SessionRow, styles recapStyles) string {\n99\t\tif len(rows) == 0 {\n100\t\t\treturn styles.muted.Render(\"(no sessions in range)\")\n101\t\t}\n102\t\tvar b strings.Builder\n103\t\tfor i, r := range rows {\n104\t\t\tagent := r.Agent\n105\t\t\tif agent == \"\" {\n106\t\t\t\tagent = \"unknown\"\n107\t\t\t}\n108\t\t\tlabel := r.Label\n109\t\t\tif label == \"\" {\n110\t\t\t\tlabel = styles.muted.Render(\"—\")\n111\t\t\t}\n112\t\t\thint := string(r.Hint)\n113\t\t\thintStyle := styles.styleForHint(r.Hint)\n114\t\t\thintRendered := \"\"\n115\t\t\tif hint != \"\" {\n116\t\t\t\thintRendered = hintStyle.Render(\"▶ \" + hint)\n117\t\t\t}\n118\t\t\tline := fmt.Sprintf(\"%s %-14s %-8s ▪ %-16s %2d cp   %s\",\n119\t\t\t\tstyles.accent.Render(r.Badge),\n120\t\t\t\tagent,\n121\t\t\t\tr.Span,\n122\t\t\t\tlabel,\n123\t\t\t\tr.Checkpoints,\n124\t\t\t\thintRendered,\n125\t\t\t)\n126\t\t\tb.WriteString(strings.TrimRight(line, \" \"))\n127\t\t\tif i < len(rows)-1 {\n128\t\t\t\tb.WriteString(\"\\n\")\n129\t\t\t}\n130\t\t}\n131\t\treturn b.String()\n132\t}\n133\t\n134\tfunc renderBottomPanel(view RecapView, styles recapStyles) string {\n135\t\t// 3 columns: Repos (optional), Worktrees, Labels.\n136\t\t// Simple left-aligned columns; width split handled by caller's terminal.\n137\t\tvar cols []string\n138\t\n139\t\tif len(view.Repos) > 0 {\n140\t\t\tvar rb strings.Builder\n141\t\t\trb.WriteString(styles.label.Render(\"Repos\") + \"\\n\")\n142\t\t\tfor _, r := range view.Repos {\n143\t\t\t\tfmt.Fprintf(&rb, \"%-20s %d sess\\n\", r.Repo, r.SessionCount)\n144\t\t\t}\n145\t\t\tcols = append(cols, strings.TrimRight(rb.String(), \"\\n\"))\n146\t\t}\n147\t\n148\t\tif len(view.Worktrees) > 0 {\n149\t\t\tvar wb strings.Builder\n150\t\t\twb.WriteString(styles.label.Render(\"Worktrees\") + \"\\n\")\n151\t\t\tfor _, w := range view.Worktrees {\n152\t\t\t\tmarker := \" \"\n153\t\t\t\tif w.HasUncommitted {\n154\t\t\t\t\tmarker = styles.warn.Render(\"⇈\")\n155\t\t\t\t}\n156\t\t\t\tid := w.WorktreeID\n157\t\t\t\tif id == \"\" {\n158\t\t\t\t\tid = \"(default)\"\n159\t\t\t\t}\n160\t\t\t\tfmt.Fprintf(&wb, \"%-20s %d sess %s\\n\", id, w.SessionCount, marker)\n161\t\t\t}\n162\t\t\tcols = append(cols, strings.TrimRight(wb.String(), \"\\n\"))\n163\t\t}\n164\t\n165\t\tif len(view.Labels) > 0 {\n166\t\t\tvar lb strings.Builder\n167\t\t\tlb.WriteString(styles.label.Render(\"Labels\") + \"\\n\")\n168\t\t\t// Use max count as scale for gradient bar so the topmost label is full.\n169\t\t\tmaxCount := 0\n170\t\t\tfor _, l := range view.Labels {\n171\t\t\t\tif l.Count > maxCount {\n172\t\t\t\t\tmaxCount = l.Count\n173\t\t\t\t}\n174\t\t\t}\n175\t\t\tfor _, l := range view.Labels {\n176\t\t\t\tbar := renderGradientBar(l.Count, maxCount, 8, styles)\n177\t\t\t\tfmt.Fprintf(&lb, \"%-16s %s\\n\", l.Label, bar)\n178\t\t\t}\n179\t\t\tcols = append(cols, strings.TrimRight(lb.String(), \"\\n\"))\n180\t\t}\n181\t\n182\t\tif len(cols) == 0 {\n183\t\t\treturn \"\"\n184\t\t}\n185\t\treturn strings.Join(cols, \"\\n\\n\")\n186\t}\n187\t\n188\t// helpers -------------------------------------------------------------------\n189\t\n190\tfunc maxOf(xs []int) int {\n191\t\tm := 0\n192\t\tfor _, v := range xs {\n193\t\t\tif v > m {\n194\t\t\t\tm = v\n195\t\t\t}\n196\t\t}\n197\t\treturn m\n198\t}\n199\t\n200\t// formatTokens renders a token count compactly: 142000 → \"142k\", 1500000 → \"1.5M\".\n201\tfunc formatTokens(n int) string {\n202\t\tswitch {\n203\t\tcase n >= 1_000_000:\n204\t\t\treturn fmt.Sprintf(\"%.1fM\", float64(n)/1_000_000)\n205\t\tcase n >= 1_000:\n206\t\t\treturn fmt.Sprintf(\"%dk\", n/1_000)\n207\t\tdefault:\n208\t\t\treturn strconv.Itoa(n)\n209\t\t}\n210\t}"},"type":"attachment","uuid":"d45ae3ac-4743-4a4c-a627-9a7c3de01f2a","timestamp":"2026-04-22T00:00:18.982Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity","sessionId":"b35707d3-641d-4b8a-83b2-52ef9ab92ecf","version":"2.1.116","gitBranch":"entire-activity"}
{"parentUuid":"d45ae3ac-4743-4a4c-a627-9a7c3de01f2a","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/entire-activity/cmd/entire/cli/recap/recap_view.go","snippet":"1\tpackage recap\n2\t\n3\timport (\n4\t\t\"sort\"\n5\t\t\"strconv\"\n6\t\t\"time\"\n7\t)\n8\t\n9\t// RangeKey names a pre-baked time range selectable via CLI flag or keyboard\n10\t// toggle. Day is the default; Month is calendar-aligned, 30d and 90d are\n11\t// rolling windows.\n12\ttype RangeKey string\n13\t\n14\tconst (\n15\t\tRangeDay     RangeKey = \"day\"\n16\t\tRangeWeek    RangeKey = \"week\"\n17\t\tRangeMonth   RangeKey = \"month\"\n18\t\tRange30d     RangeKey = \"30d\"\n19\t\tRange90d     RangeKey = \"90d\"\n20\t\trangeDefault          = RangeDay\n21\t)\n22\t\n23\t// Title returns the human-readable label shown in the summary panel header.\n24\tfunc (r RangeKey) Title() string {\n25\t\tswitch r {\n26\t\tcase RangeDay:\n27\t\t\treturn \"Today\"\n28\t\tcase RangeWeek:\n29\t\t\treturn \"Last 7 days\"\n30\t\tcase RangeMonth:\n31\t\t\treturn \"This month\"\n32\t\tcase Range30d:\n33\t\t\treturn \"Last 30 days\"\n34\t\tcase Range90d:\n35\t\t\treturn \"Last 90 days\"\n36\t\t}\n37\t\treturn string(r)\n38\t}\n39\t\n40\t// bounds returns the half-open [start, end) interval for a RangeKey relative\n41\t// to a reference time (usually time.Now()). Local-time midnight boundaries\n42\t// so \"today\" starts where the user's clock starts.\n43\tfunc (r RangeKey) bounds(now time.Time) (time.Time, time.Time) {\n44\t\tdayStart := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())\n45\t\tdayEnd := dayStart.AddDate(0, 0, 1)\n46\t\tswitch r {\n47\t\tcase RangeDay:\n48\t\t\treturn dayStart, dayEnd\n49\t\tcase RangeWeek:\n50\t\t\treturn dayEnd.AddDate(0, 0, -7), dayEnd\n51\t\tcase RangeMonth:\n52\t\t\tmonthStart := time.Date(now.Year(), now.Month(), 1, 0, 0, 0, 0, now.Location())\n53\t\t\treturn monthStart, monthStart.AddDate(0, 1, 0)\n54\t\tcase Range30d:\n55\t\t\treturn dayEnd.AddDate(0, 0, -30), dayEnd\n56\t\tcase Range90d:\n57\t\t\treturn dayEnd.AddDate(0, 0, -90), dayEnd\n58\t\t}\n59\t\treturn dayStart, dayEnd\n60\t}\n61\t\n62\t// BuildOpts controls how the view is assembled.\n63\ttype BuildOpts struct {\n64\t\tRange       RangeKey\n65\t\tAgentFilter string    // empty = all agents\n66\t\tNow         time.Time // injectable for deterministic tests\n67\t}\n68\t\n69\t// RecapView is everything a renderer needs. Pure data — no styling, no I/O.\n70\t// The Footer string is left to the renderer; the view exposes the raw bits.\n71\ttype RecapView struct {\n72\t\tTitle     string\n73\t\tRange     RangeKey\n74\t\tSummary   SummaryBand\n75\t\tActivity  []int // heatmap buckets; length depends on Range\n76\t\tSessions  []SessionRow\n77\t\tRepos     []RepoLine // nil when all sessions share one repo\n78\t\tWorktrees []WorktreeRollup\n79\t\tLabels    []LabelLine\n80\t}\n81\t\n82\t// SummaryBand holds the headline facts at the top of every view.\n83\ttype SummaryBand struct {\n84\t\tTopAgent         string\n85\t\tTopAgentCount    int\n86\t\tTopModel         string\n87\t\tTopModelCount    int\n88\t\tDominantLabel    string\n89\t\tDominantLabelPct float64 // 0-1\n90\t\tSessionCount     int\n91\t\tCheckpointCount  int\n92\t\tTokenTotal       int\n93\t\tCommitCount      int\n94\t\tAgentFilter      string // non-empty when filtered — rendered as chip\n95\t}\n96\t\n97\t// SessionRow is a row in the middle panel's chronological list.\n98\ttype SessionRow struct {\n99\t\tBadge       string // ● live, ◌ idle\n100\t\tAgent       string\n101\t\tRepo        string\n102\t\tSpan        string // \"2h\", \"30m\"\n103\t\tLabel       string // session's dominant label\n104\t\tCheckpoints int\n105\t\tHint        ActionHint\n106\t\tStartedAt   time.Time // for chronological sort\n107\t}\n108\t\n109\t// RepoLine is a row in the Repos bottom-panel column.\n110\ttype RepoLine struct {\n111\t\tRepo         string\n112\t\tSessionCount int\n113\t}\n114\t\n115\t// LabelLine is a row in the Labels bottom-panel column.\n116\ttype LabelLine struct {\n117\t\tLabel string\n118\t\tCount int\n119\t\tPct   int // 0-100, pre-rounded for rendering\n120\t}\n121\t\n122\t// BuildRecapView projects a slice of sessions into a RecapView for the\n123\t// given range + agent filter. Pure — no I/O, no git — so it's easy to\n124\t// fixture-test and safe to call from TUI update loops.\n125\tfunc BuildRecapView(sessions []RecapSession, opts BuildOpts) RecapView {\n126\t\tif opts.Range == \"\" {\n127\t\t\topts.Range = rangeDefault\n128\t\t}\n129\t\tif opts.Now.IsZero() {\n130\t\t\topts.Now = time.Now()\n131\t\t}\n132\t\tstart, end := opts.Range.bounds(opts.Now)\n133\t\n134\t\t// Filter by range first, then by agent. Order matters for performance\n135\t\t// but not for correctness — both filters are commutative.\n136\t\tfiltered := make([]RecapSession, 0, len(sessions))\n137\t\tfor _, s := range sessions {\n138\t\t\tif !inRange(s, start, end) {\n139\t\t\t\tcontinue\n140\t\t\t}\n141\t\t\tif opts.AgentFilter != \"\" && !sessionUsesAgent(s, opts.AgentFilter) {\n142\t\t\t\tcontinue\n143\t\t\t}\n144\t\t\tfiltered = append(filtered, s)\n145\t\t}\n146\t\n147\t\tview := RecapView{\n148\t\t\tTitle: opts.Range.Title(),\n149\t\t\tRange: opts.Range,\n150\t\t}\n151\t\n152\t\t// Collect checkpoints in-range for aggregations that work at the cp level.\n153\t\tvar cps []RecapCheckpoint\n154\t\ttokens := 0\n155\t\tcommits := map[string]bool{}\n156\t\tfor _, s := range filtered {\n157\t\t\tfor _, cp := range s.Checkpoints {\n158\t\t\t\tif cp.CreatedAt.Before(start) || !cp.CreatedAt.Before(end) {\n159\t\t\t\t\tcontinue\n160\t\t\t\t}\n161\t\t\t\tcps = append(cps, cp)\n162\t\t\t\tif cp.TokenUsage != nil {\n163\t\t\t\t\ttokens += cp.TokenUsage.InputTokens + cp.TokenUsage.OutputTokens\n164\t\t\t\t}\n165\t\t\t\tif cp.LinkedCommit != \"\" {\n166\t\t\t\t\tcommits[cp.LinkedCommit] = true\n167\t\t\t\t}\n168\t\t\t}\n169\t\t}\n170\t\n171\t\t// Summary band.\n172\t\tagentCounts := map[string]int{}\n173\t\tmodelCounts := map[string]int{}\n174\t\tlabelCounts := map[string]int{}\n175\t\tfor _, s := range filtered {\n176\t\t\tfor _, a := range s.AgentsUsed {\n177\t\t\t\tagentCounts[a]++\n178\t\t\t}\n179\t\t\tfor _, m := range s.ModelsUsed {\n180\t\t\t\tmodelCounts[m]++\n181\t\t\t}\n182\t\t}\n183\t\tfor _, cp := range cps {\n184\t\t\tfor _, lbl := range cp.Labels {\n185\t\t\t\tlabelCounts[lbl]++\n186\t\t\t}\n187\t\t}\n188\t\ttopAgent, topAgentN := pickTop(agentCounts)\n189\t\ttopModel, topModelN := pickTop(modelCounts)\n190\t\tdomLabel, domOK := DominantLabel(labelCounts)\n191\t\tdomPct := 0.0\n192\t\tif domOK {\n193\t\t\ttotal := 0\n194\t\t\tfor _, c := range labelCounts {\n195\t\t\t\ttotal += c\n196\t\t\t}\n197\t\t\tif total > 0 {\n198\t\t\t\tdomPct = float64(labelCounts[domLabel]) / float64(total)\n199\t\t\t}\n200\t\t}\n201\t\tview.Summary = SummaryBand{\n202\t\t\tTopAgent:         topAgent,\n203\t\t\tTopAgentCount:    topAgentN,\n204\t\t\tTopModel:         topModel,\n205\t\t\tTopModelCount:    topModelN,\n206\t\t\tDominantLabel:    domLabel,\n207\t\t\tDominantLabelPct: domPct,\n208\t\t\tSessionCount:     len(filtered),\n209\t\t\tCheckpointCount:  len(cps),\n210\t\t\tTokenTotal:       tokens,\n211\t\t\tCommitCount:      len(commits),\n212\t\t\tAgentFilter:      opts.AgentFilter,\n213\t\t}\n214\t\n215\t\t// Activity buckets: shape depends on range. Day = 24 hourly; others =\n216\t\t// daily cells across the span.\n217\t\tview.Activity = buildActivityBuckets(cps, opts.Range, start, end)\n218\t\n219\t\t// Session rows in chronological order (oldest first).\n220\t\tsort.Slice(filtered, func(i, j int) bool {\n221\t\t\treturn filtered[i].StartedAt.Before(filtered[j].StartedAt)\n222\t\t})\n223\t\tview.Sessions = make([]SessionRow, 0, len(filtered))\n224\t\tfor _, s := range filtered {\n225\t\t\tlabel, _ := DominantLabel(perSessionLabelCounts(s))\n226\t\t\tview.Sessions = append(view.Se