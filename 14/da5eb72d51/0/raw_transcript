\n393\t\tif err == nil {\n394\t\t\tt.Fatal(\"expected error for empty input\")\n395\t\t}\n396\t\tif !strings.Contains(err.Error(), \"empty hook input\") {\n397\t\t\tt.Errorf(\"expected 'empty hook input' error, got: %v\", err)\n398\t\t}\n399\t}\n400\t\n401\tfunc TestReadAndParse_InvalidJSON(t *testing.T) {\n402\t\tt.Parallel()\n403\t\n404\t\t_, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(\"not valid json\"))\n405\t\n406\t\tif err == nil {\n407\t\t\tt.Fatal(\"expected error for invalid JSON\")\n408\t\t}\n409\t\tif !strings.Contains(err.Error(), \"failed to parse hook input\") {\n410\t\t\tt.Errorf(\"expected 'failed to parse hook input' error, got: %v\", err)\n411\t\t}\n412\t}\n413\t\n414\tfunc TestReadAndParse_PartialJSON(t *testing.T) {\n415\t\tt.Parallel()\n416\t\n417\t\t// JSON with only some fields - should still parse (missing fields are zero values)\n418\t\tinput := `{\"session_id\": \"partial-only\"}`\n419\t\n420\t\tresult, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(input))\n421\t\n422\t\tif err != nil {\n423\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n424\t\t}\n425\t\tif result.SessionID != \"partial-only\" {\n426\t\t\tt.Errorf(\"expected session_id 'partial-only', got %q\", result.SessionID)\n427\t\t}\n428\t\tif result.TranscriptPath != \"\" {\n429\t\t\tt.Errorf(\"expected empty transcript_path, got %q\", result.TranscriptPath)\n430\t\t}\n431\t}\n432\t\n433\tfunc TestReadAndParse_ExtraFields(t *testing.T) {\n434\t\tt.Parallel()\n435\t\n436\t\t// JSON with extra fields - should ignore them\n437\t\tinput := `{\"session_id\": \"test\", \"transcript_path\": \"/t\", \"extra_field\": \"ignored\", \"another\": 123}`\n438\t\n439\t\tresult, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(input))\n440\t\n441\t\tif err != nil {\n442\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n443\t\t}\n444\t\tif result.SessionID != \"test\" {\n445\t\t\tt.Errorf(\"expected session_id 'test', got %q\", result.SessionID)\n446\t\t}\n447\t}\n448\t\n449\tfunc TestReadAndParse_AgentHookInput(t *testing.T) {\n450\t\tt.Parallel()\n451\t\n452\t\tinput := `{\n453\t\t\t\"session_id\": \"agent-session\",\n454\t\t\t\"transcript_path\": \"/path/to/agent.json\",\n455\t\t\t\"cwd\": \"/work\",\n456\t\t\t\"hook_event_name\": \"before-agent\",\n457\t\t\t\"timestamp\": \"2024-01-15T12:00:00Z\",\n458\t\t\t\"prompt\": \"User's question here\"\n459\t\t}`\n460\t\n461\t\tresult, err := agent.ReadAndParseHookInput[agentHookInputRaw](strings.NewReader(input))\n462\t\n463\t\tif err != nil {\n464\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n465\t\t}\n466\t\tif result.SessionID != \"agent-session\" {\n467\t\t\tt.Errorf(\"expected session_id 'agent-session', got %q\", result.SessionID)\n468\t\t}\n469\t\tif result.Prompt != \"User's question here\" {\n470\t\t\tt.Errorf(\"expected prompt 'User's question here', got %q\", result.Prompt)\n471\t\t}\n472\t\tif result.HookEventName != \"before-agent\" {\n473\t\t\tt.Errorf(\"expected hook_event_name 'before-agent', got %q\", result.HookEventName)\n474\t\t}\n475\t}\n476\t\n477\t// captureStdout swaps os.Stdout for a pipe, runs fn, and returns what was\n478\t// written. Sequential (no t.Parallel) because os.Stdout is process-global.\n479\tfunc captureStdout(t *testing.T, fn func()) string {\n480\t\tt.Helper()\n481\t\tr, w, err := os.Pipe()\n482\t\trequire.NoError(t, err)\n483\t\n484\t\toriginal := os.Stdout\n485\t\tos.Stdout = w\n486\t\n487\t\tdone := make(chan []byte, 1)\n488\t\tgo func() {\n489\t\t\tdata, _ := io.ReadAll(r) //nolint:errcheck // best-effort drain\n490\t\t\tdone <- data\n491\t\t}()\n492\t\n493\t\tfn()\n494\t\trequire.NoError(t, w.Close())\n495\t\tos.Stdout = original\n496\t\tgot := <-done\n497\t\trequire.NoError(t, r.Close())\n498\t\treturn string(got)\n499\t}\n500\t\n501\t// TestWriteHookResponse_PlainText_NoJSON verifies the response is emitted as\n502\t// plain text (not JSON). Gemini CLI v0.40.0 double-displays JSON systemMessage\n503\t// (once with the [hookName] tag, once without) — plain text takes only the\n504\t// non-tagged path so the user sees the banner once.\n505\tfunc TestWriteHookResponse_PlainText_NoJSON(t *testing.T) {\n506\t\tag := &GeminiCLIAgent{}\n507\t\tout := captureStdout(t, func() {\n508\t\t\trequire.NoError(t, ag.WriteHookResponse(\"hello banner\"))\n509\t\t})\n510\t\n511\t\trequire.Equal(t, \"hello banner\\n\", out, \"expected exact plain-text output (no JSON envelope)\")\n512\t\trequire.False(t, strings.HasPrefix(strings.TrimSpace(out), \"{\"),\n513\t\t\t\"output must not start with '{' — gemini's JSON parser would route it through the duplicate-display path\")\n514\t}\n515\t\n516\tfunc TestWriteHookResponse_EmptyMessage_WritesNothing(t *testing.T) {\n517\t\tag := &GeminiCLIAgent{}\n518\t\tout := captureStdout(t, func() {\n519\t\t\trequire.NoError(t, ag.WriteHookResponse(\"\"))\n520\t\t})\n521\t\trequire.Empty(t, out, \"empty message should produce no output\")\n522\t}\n523\t"}]},"uuid":"ef059746-14a6-4174-8a40-a50e83f54234","timestamp":"2026-04-30T12:41:11.086Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/agent/geminicli/lifecycle_test.go","content":"package geminicli\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/stretchr/testify/require\"\n)\n\nfunc TestParseHookEvent_SessionStart(t *testing.T) {\n\tt.Parallel()\n\n\tag := &GeminiCLIAgent{}\n\tinput := `{\"session_id\": \"gemini-session-123\", \"transcript_path\": \"/tmp/gemini.json\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameSessionStart, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Type != agent.SessionStart {\n\t\tt.Errorf(\"expected event type %v, got %v\", agent.SessionStart, event.Type)\n\t}\n\tif event.SessionID != \"g