ains(err.Error(), \"agent cannot be nil\") {\n103\t\t\tt.Errorf(\"expected error message about nil agent, got: %v\", err)\n104\t\t}\n105\t}\n106\t\n107\tfunc TestDispatchLifecycleEvent_NilEvent(t *testing.T) {\n108\t\tt.Parallel()\n109\t\n110\t\tag := newMockAgent()\n111\t\n112\t\terr := DispatchLifecycleEvent(context.Background(), ag, nil)\n113\t\tif err == nil {\n114\t\t\tt.Error(\"expected error for nil event, got nil\")\n115\t\t}\n116\t\tif !strings.Contains(err.Error(), \"event cannot be nil\") {\n117\t\t\tt.Errorf(\"expected error message about nil event, got: %v\", err)\n118\t\t}\n119\t}\n120\t\n121\tfunc TestDispatchLifecycleEvent_UnknownEventType(t *testing.T) {\n122\t\tt.Parallel()\n123\t\n124\t\tag := newMockAgent()\n125\t\tevent := &agent.Event{\n126\t\t\tType:      agent.EventType(999), // Unknown type\n127\t\t\tSessionID: \"test-session\",\n128\t\t}\n129\t\n130\t\terr := DispatchLifecycleEvent(context.Background(), ag, event)\n131\t\tif err == nil {\n132\t\t\tt.Error(\"expected error for unknown event type, got nil\")\n133\t\t}\n134\t\tif !strings.Contains(err.Error(), \"unknown lifecycle event type\") {\n135\t\t\tt.Errorf(\"expected error message about unknown event type, got: %v\", err)\n136\t\t}\n137\t}\n138\t\n139\t// --- handleLifecycleSessionStart tests ---\n140\t\n141\tfunc TestHandleLifecycleSessionStart_EmptySessionID(t *testing.T) {\n142\t\tt.Parallel()\n143\t\n144\t\tag := newMockAgent()\n145\t\tevent := &agent.Event{\n146\t\t\tType:      agent.SessionStart,\n147\t\t\tSessionID: \"\", // Empty\n148\t\t}\n149\t\n150\t\terr := handleLifecycleSessionStart(context.Background(), ag, event)\n151\t\tif err == nil {\n152\t\t\tt.Error(\"expected error for empty session ID, got nil\")\n153\t\t}\n154\t\tif !strings.Contains(err.Error(), \"no session_id\") {\n155\t\t\tt.Errorf(\"expected error message about missing session_id, got: %v\", err)\n156\t\t}\n157\t}\n158\t\n159\t// mockHookResponseAgent extends mockLifecycleAgent with HookResponseWriter.\n160\ttype mockHookResponseAgent struct {\n161\t\tmockLifecycleAgent\n162\t\n163\t\tlastMessage string\n164\t}\n165\t\n166\tvar _ agent.HookResponseWriter = (*mockHookResponseAgent)(nil)\n167\t\n168\tfunc (m *mockHookResponseAgent) WriteHookResponse(message string) error {\n169\t\tm.lastMessage = message\n170\t\treturn nil\n171\t}\n172\t\n173\tfunc newMockHookResponseAgent() *mockHookResponseAgent {\n174\t\treturn &mockHookResponseAgent{\n175\t\t\tmockLifecycleAgent: mockLifecycleAgent{\n176\t\t\t\tname:      \"mock-hrw\",\n177\t\t\t\tagentType: \"Mock HRW Agent\",\n178\t\t\t},\n179\t\t}\n180\t}\n181\t\n182\t// TestHandleLifecycleSessionStart_StoresAgentTypeHint verifies the\n183\t// SessionStart hook claims the session for its agent so a wrapper agent's\n184\t// later TurnStart hook (e.g., Cursor IDE forwarding to Claude Code's hook\n185\t// system) cannot re-label the session.\n186\tfunc TestHandleLifecycleSessionStart_StoresAgentTypeHint(t *testing.T) {\n187\t\ttmpDir := t.TempDir()\n188\t\ttestutil.InitRepo(t, tmpDir)\n189\t\ttestutil.WriteFile(t, tmpDir, \"init.txt\", \"init\")\n190\t\ttestutil.GitAdd(t, tmpDir, \"init.txt\")\n191\t\ttestutil.GitCommit(t, tmpDir, \"init\")\n192\t\tt.Chdir(tmpDir)\n193\t\tpaths.ClearWorktreeRootCache()\n194\t\n195\t\tag := newMockHookResponseAgent()\n196\t\tag.agentType = \"Cursor\"\n197\t\tevent := &agent.Event{\n198\t\t\tType:      agent.SessionStart,\n199\t\t\tSessionID: \"test-agent-hint\",\n200\t\t\tTimestamp: time.Now(),\n201\t\t}\n202\t\trequire.NoError(t, handleLifecycleSessionStart(context.Background(), ag, event))\n203\t\n204\t\tgot := strategy.LoadAgentTypeHint(context.Background(), \"test-agent-hint\")\n205\t\trequire.Equal(t, types.AgentType(\"Cursor\"), got)\n206\t}\n207\t\n208\t// TestHandleLifecycleSessionStart_AgentTypeHintFirstWriterWins verifies that\n209\t// when multiple agents fire SessionStart for the same session ID, only the\n210\t// first agent's claim is recorded AND only the first emits the banner. This\n211\t// matches both the Cursor cross-agent and the Gemini repeat-source\n212\t// (startup → resume) cases — the user must see the banner only once.\n213\tfunc TestHandleLifecycleSessionStart_AgentTypeHintFirstWriterWins(t *testing.T) {\n214\t\ttmpDir := t.TempDir()\n215\t\ttestutil.InitRepo(t, tmpDir)\n216\t\ttestutil.WriteFile(t, tmpDir, \"init.txt\", \"init\")\n217\t\ttestutil.GitAdd(t, tmpDir, \"init.txt\")\n218\t\ttestutil.GitCommit(t, tmpDir, \"init\")\n219\t\tt.Chdir(tmpDir)\n220\t\tpaths.ClearWorktreeRootCache()\n221\t\n222\t\tctx := context.Background()\n223\t\tsessionID := \"test-agent-hint-race\"\n224\t\n225\t\tfirst := newMockHookResponseAgent()\n226\t\tfirst.agentType = \"Cursor\"\n227\t\trequire.NoError(t, handleLifecycleSessionStart(ctx, first, &agent.Event{\n228\t\t\tType: agent.SessionStart, SessionID: sessionID, Timestamp: time.Now(),\n229\t\t}))\n230\t\trequire.NotEmpty(t, first.lastMessage, \"first SessionStart must emit the banner\")\n231\t\n232\t\tsecond := newMockHookResponseAgent()\n233\t\tsecond.agentType = testAgentClaude\n234\t\trequire.NoError(t, handleLifecycleSessionStart(ctx, second, &agent.Event{\n235\t\t\tType: agent.SessionStart, SessionID: sessionID, Timestamp: time.Now(),\n236\t\t}))\n237\t\trequire.Empty(t, second.lastMessage, \"subsequent SessionStarts for the same session must not emit the banner again\")\n238\t\n239\t\tgot := strategy.LoadAgentTypeHint(ctx, sessionID)\n240\t\trequire.Equal(t, types.AgentType(\"Cursor\"), got, \"first SessionStart caller must own the session\")\n241\t}\n242\t\n243\t// TestHandleLifecycleSessionStart_GeminiRepeatSourceDoesNotDuplicate covers\n244\t// the specific case the user reported: Gemini fires SessionStart twice for\n245\t// the same session (e.g., source=startup followed by source=resume) and we\n246\t// were emitting the banner both times.\n247\tfunc TestHandleLifecycleSessionStart_GeminiRepeatSourceDoesNotDuplicate(t *testing.T) {\n248\t\ttmpDir := t.TempDir()\n249\t\ttestutil.InitRepo(t, tmpDir)\n250\t\ttestutil.WriteFile(t, tmpDir, \"init.txt\", \"init\")\n251\t\ttestutil.GitAdd(t, tmpDir, \"init.txt\")\n252\t\ttestutil.GitCommit(t, tmpDir, \"init\")\n253\t\tt.Chdir(tmpDir)\n254\t\tpaths.ClearWorktreeRootCache()\n255\t\n256\t\tctx := context.Background()\n257\t\tsessionID := \"test-gemini-repeat\"\n258\t\n259\t\tag := newMockHookResponseAgent()\n260\t\tag.agentType = \"Gemini CLI\"\n261\t\n262\t\trequire.NoError(t, handleLifecycleSessionStart(ctx, ag, &agent.Event{\n263\t\t\tType: agent.SessionStart, SessionID: sessionID, Timestamp: time.Now(),\n264\t\t}))\n265\t\tfirst := ag.lastMessage\n266\t\trequire.NotEmpty(t, first)\n267\t\n268\t\tag.lastMessage = \"\"\n269\t\trequire.NoError(t, handleLifecycleSessionStart(ctx, ag, &agent.Event{\n270\t\t\tType: agent.SessionStart, SessionID: sessionID, Timestamp: time.Now(),\n271\t\t}))\n272\t\trequire.Empty(t, ag.lastMessage, \"second SessionStart from the same agent must not re-emit the banner\")\n273\t}\n274\t\n275\tfunc TestHandleLifecycleSessionStart_EmptyRepoWarning(t *testing.T) {\n276\t\t// Cannot use t.Parallel() because we use t.Chdir()\n277\t\ttmpDir := t.TempDir()\n278\t\ttestutil.InitRepo(t, tmpDir) // no commits — empty repo\n279\t\tt.Chdir(tmpDir)\n280\t\tpaths.ClearWorktreeRootCache()\n281\t\n282\t\tag := newMockHookResponseAgent()\n283\t\tevent := &agent.Event{\n284\t\t\tType:      agent.SessionStart,\n285\t\t\tSessionID: \"test-empty-repo-warning\",\n286\t\t\tTimestamp: time.Now(),\n287\t\t}\n288\t\n289\t\terr := handleLifecycleSessionStart(context.Background(), ag, event)\n290\t\trequire.NoError(t, err)\n291\t\n292\t\tif !strings.Contains(ag.lastMessage, \"no commits yet\") {\n293\t\t\tt.Errorf(\"expected message containing 'no commits yet', got: %q\", ag.lastMessage)\n294\t\t}\n295\t}\n296\t\n297\tfunc TestHandleLifecycleSessionStart_DefaultMessageWithCommits(t *testing.T) {\n298\t\t// Cannot use t.Parallel() because we use t.Chdir()\n299\t\ttmpDir := t.TempDir()\n300\t\ttestutil.InitRepo(t, tmpDir)\n301\t\ttestutil.WriteFile(t, tmpDir, \"init.txt\", \"init\")\n302\t\ttestutil.GitAdd(t, tmpDir, \"init.txt\")\n303\t\ttestutil.GitCommit(t, tmpDir, \"init\")\n304\t\tt.Chdir(tmpDir)\n305\t\tpaths.ClearWorktreeRootCache()\n306\t\n307\t\tag := newMockHookResponseAgent()\n308\t\tevent := &agent.Event{\n309\t\t\tType:      agent.SessionStart,\n310\t\t\tSessionID: \"test-default-message\",\n311\t\t\tTimestamp: time.Now(),\n312\t\t}\n313\t\n314\t\terr := handleLifecycleSessionStart(context.Background(), ag, event)\n315\t\trequire.NoError(t, err)\n316\t\n317\t\tif !strings.Contains(ag.lastMessage, \"link this conversation to your next commit\") {\n318\t\t\tt.Errorf(\"expected message containing 'link this conversation to your next commit', got: %q\", ag.lastMessage)\n319\t\t}\n320\t\tif strings.Contains(ag.lastMessage, \"no commits yet\") {\n321\t\t\tt.Errorf(\"did not expect empty-repo warning, got: %q\", ag.lastMessage)\n322\t\t}\n323\t\tif !strings.HasPrefix(ag.lastMessage, \"\\n\\nEntire CLI \") {\n324\t\t\tt.Errorf(\"expected multiline session-start banner, got %q\", ag.lastMessage)\n325\t\t}\n326\t\tif !strings.Contains(ag.lastMessage, \"\\n\\n\") {\n327\t\t\tt.Errorf(\"expected default agent banner to remain multiline, got %q\", ag.lastMessage)\n328\t\t}\n329\t}\n330\t\n331\tfunc TestSessionStartMessage_CodexUsesSingleLineBanner(t *testing.T) {\n332\t\tt.Parallel()\n333\t\n334\t\tmsg := sessionStartMessage(agent.AgentNameCodex, false)\n335\t\trequire.Equal(t, \"Entire CLI will link this conversation to your next commit.\", msg)\n336\t\tif strings.Contains(msg, \"\\n\") {\n337\t\t\tt.Fatalf(\"expected single-line Codex message, got %q\", msg)\n338\t\t}\n339\t}\n340\t\n341\tfunc TestSessionStartMessage_CodexUsesSingleLineBannerForEmptyRepo(t *testing.T) {\n342\t\tt.Parallel()\n343\t\n344\t\tmsg := sessionStartMessage(agent.AgentNameCodex, true)\n345\t\trequire.Equal(t, \"Entire CLI found no commits yet — checkpoints will activate after your first commit