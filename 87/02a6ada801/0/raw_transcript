\tSessionID:      \"2026-01-19-test\",\n   190→\t\tIntent:         \"Add user authentication\",\n   191→\t\tOutcome:        \"Implemented JWT-based auth with refresh tokens\",\n   192→\t\tLearnings:      []string{\"go-jwt library requires explicit algorithm\", \"refresh tokens need separate storage\"},\n   193→\t\tFrictionPoints: []string{\"Initial approach with sessions didn't scale\"},\n   194→\t}\n   195→\n   196→\tdata, err := json.Marshal(meta)\n   197→\tif err != nil {\n   198→\t\tt.Fatalf(\"json.Marshal() error = %v\", err)\n   199→\t}\n   200→\n   201→\tvar decoded CommittedMetadata\n   202→\terr = json.Unmarshal(data, &decoded)\n   203→\tif err != nil {\n   204→\t\tt.Fatalf(\"json.Unmarshal() error = %v\", err)\n   205→\t}\n   206→\n   207→\tif decoded.Intent != \"Add user authentication\" {\n   208→\t\tt.Errorf(\"Intent = %q, want %q\", decoded.Intent, \"Add user authentication\")\n   209→\t}\n   210→\tif decoded.Outcome != \"Implemented JWT-based auth with refresh tokens\" {\n   211→\t\tt.Errorf(\"Outcome = %q, want %q\", decoded.Outcome, \"Implemented JWT-based auth with refresh tokens\")\n   212→\t}\n   213→\tif len(decoded.Learnings) != 2 {\n   214→\t\tt.Errorf(\"len(Learnings) = %d, want 2\", len(decoded.Learnings))\n   215→\t}\n   216→\tif len(decoded.FrictionPoints) != 1 {\n   217→\t\tt.Errorf(\"len(FrictionPoints) = %d, want 1\", len(decoded.FrictionPoints))\n   218→\t}\n   219→}\n   220→\n   221→func TestUpdateSummary(t *testing.T) {\n   222→\ttempDir := t.TempDir()\n   223→\n   224→\t// Initialize a git repository with an initial commit\n   225→\trepo, err := git.PlainInit(tempDir, false)\n   226→\tif err != nil {\n   227→\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n   228→\t}\n   229→\n   230→\t// Create worktree and make initial commit\n   231→\tworktree, err := repo.Worktree()\n   232→\tif err != nil {\n   233→\t\tt.Fatalf(\"failed to get worktree: %v\", err)\n   234→\t}\n   235→\n   236→\treadmeFile := filepath.Join(tempDir, \"README.m