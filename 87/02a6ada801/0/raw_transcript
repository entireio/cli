lIndentWithNewline(checkpoint, \"\", \"  \")\n   170→\tif err != nil {\n   171→\t\treturn \"\", fmt.Errorf(\"failed to marshal task checkpoint: %w\", err)\n   172→\t}\n   173→\tblobHash, err := CreateBlobFromContent(s.repo, checkpointData)\n   174→\tif err != nil {\n   175→\t\treturn \"\", fmt.Errorf(\"failed to create task checkpoint blob: %w\", err)\n   176→\t}\n   177→\n   178→\tcheckpointFile := taskPath + \"checkpoint.json\"\n   179→\tentries[checkpointFile] = object.TreeEntry{\n   180→\t\tName: checkpointFile,\n   181→\t\tMode: filemode.Regular,\n   182→\t\tHash: blobHash,\n   183→\t}\n   184→\n   185→\t// Write subagent transcript if available\n   186→\tif opts.SubagentTranscriptPath != \"\" && opts.AgentID != \"\" {\n   187→\t\tagentContent, readErr := os.ReadFile(opts.SubagentTranscriptPath)\n   188→\t\tif readErr == nil {\n   189→\t\t\tagentBlobHash, agentBlobErr := CreateBlobFromContent(s.repo, agentContent)\n   190→\t\t\tif agentBlobErr == nil {\n   191→\t\t\t\tagentPath := taskPath + \"agent-\" + opts.AgentID + \".jsonl\"\n   192→\t\t\t\tentries[agentPath] = object.TreeEntry{\n   193→\t\t\t\t\tName: agentPath,\n   194→\t\t\t\t\tMode: filemode.Regular,\n   195→\t\t\t\t\tHash: agentBlobHash,\n   196→\t\t\t\t}\n   197→\t\t\t}\n   198→\t\t}\n   199→\t}\n   200→\n   201→\t// Return task path without trailing slash\n   202→\treturn taskPath[:len(taskPath)-1], nil\n   203→}\n   204→\n   205→// writeStandardCheckpointEntries writes transcript, prompts, context, metadata.json and any additional files.\n   206→// If the checkpoint already exists (from a previous session), archives the existing files to a numbered subfolder.\n   207→func (s *GitStore) writeStandardCheckpointEntries(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry) error {\n   208→\t// Check if checkpoint already exists (multi-session support)\n   209→\tvar existingMetadata *CommittedMetadata\n   210→\tmetadataPath := basePath + paths.MetadataFileName\n   211→\tif entry, exists := entries[metadataPath]; exists {\n   212→\t\t// Read existing metadata to get session count\n   213→\t\texisting, err := s.readMetadataFromBlob(entry.Hash)\n   214→\t\tif err == nil {\n   215→\t\t\texistingMetadata = existing\n   216→\t\t\t// Archive existing session files to numbered subfolder\n   217→\t\t\ts.archiveExistingSession(basePath, existingMetadata, entries)\n   218→\t\t}\n   219→\t}\n   220→\n   221→\t// Write transcript (from in-memory content or file path)\n   222→\tif err := s.writeTranscript(opts, basePath, entries); err != nil {\n   223→\t\treturn err\n   224→\t}\n   225→\n   226→\t// Write prompts\n   227→\tif len(opts.Prompts) > 0 {\n   228→\t\tpromptContent := strings.Join(opts.Prompts, \"\\n\\n---\\n\\n\")\n   229→\t\tblobHash, err := CreateBlobFromContent(s.repo, []byte(promptContent))\n   230→\t\tif err != nil {\n   231→\t\t\treturn err\n   232→\t\t}\n   233→\t\tentries[basePath+paths.PromptFileName] = object.TreeEntry{\n   234→\t\t\tName: basePath + paths.PromptFileName,\n   235→\t\t\tMode: filemode.Regular,\n   236→\t\t\tHash: blobHash,\n   237→\t\t}\n   238→\t}\n   239→\n   240→\t// Write context\n   241→\tif len(opts.Context) > 0 {\n   242→\t\tblobHash, err := CreateBlobFromContent(s.repo, opts.Context)\n   243→\t\tif err != nil {\n   244→\t\t\treturn err\n   245→\t\t}\n   246→\t\tentries[basePath+paths.ContextFileName] = object.TreeEntry{\n   247→\t\t\tName: basePath + paths.ContextFileName,\n   248→\t\t\tMode: filemode.Regular,\n   249→\t\t\tHash: blobHash,\n   250→\t\t}\n   251→\t}\n   252→\n   253→\t// Copy additional metadata files from directory if specified\n   254→\tif opts.MetadataDir != \"\" {\n   255→\t\tif err := s.copyMetadataDir(opts.MetadataDir, basePath, entries); err != nil {\n   256→\t\t\treturn fmt.Errorf(\"failed to copy metadata directory: %w\", err)\n   257→\t\t}\n   258→\t}\n   259→\n   260→\t// Write metadata.json (with merged info if existing metadata present)\n   261→\treturn s.writeMetadataJSON(opts, basePath, entries, existingMetadata)\n   262→}\n   263→\n   264→// writeTranscript writes the transcript file from in-memory content or file path.\n   265→func (s *GitStore) writeTranscript(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry) error {\n   266→\ttranscript := opts.Transcript\n   267→\tif len(transcript) == 0 && opts.TranscriptPath != \"\" {\n   268→\t\tvar readErr error\n   269→\t\ttranscript, readErr = os.ReadFile(opts.TranscriptPath)\n   270→\t\tif readErr != nil {\n   271→\t\t\t// Non-fatal: transcript may not exist yet\n   272→\t\t\ttranscript = nil\n   273→\t\t}\n   274→\t}\n   275→\tif len(transcript) == 0 {\n   276→\t\treturn nil\n   277→\t}\n   278→\n   279→\tblobHash, err := CreateBlobFromContent(s.repo, transcript)\n   280→\tif err != nil {\n   281→\t\treturn err\n   282→\t}\n   283→\tentries[basePath+paths.TranscriptFileName] = object.TreeEntry{\n   284→\t\tName: basePath + paths.TranscriptFileName,\n   285→\t\tMode: filemode.Regular,\n   286→\t\tHash: blobHash,\n   287→\t}\n   288→\n   289→\t// Content hash for deduplication\n   290→\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n   291→\thashBlob, err := CreateBlobFromContent(s.repo, []byte(contentHash))\n   292→\tif err != nil {\n   293→\t\treturn err\n   294→\t}\n   295→\tentries[basePath+paths.ContentHashFileName] = object.TreeEntry{\n   296→\t\tName: basePath + paths.ContentHashFileName,\n   297→\t\tMode: filemode.Regular,\n   298→\t\tHash: hashBlob,\n   299→\t}\n   300→\treturn nil\n   301→}\n   302→\n   303→// writeMetadataJSON writes the metadata.json file for the checkpoint.\n   304→// If existingMetadata is provided, merges session info from the previous session(s).\n   305→func (s *GitStore) writeMetadataJSON(opts WriteCommittedOptions, basePath string, entries map[string]object.TreeEntry, existingMetadata *CommittedMetadata) error {\n   306→\tmetadata := CommittedMetadata{\n   307→\t\tCheckpointID:     opts.CheckpointID,\n   308→\t\tSessionID:        opts.SessionID,\n   309→\t\tStrategy:         opts.Strategy,\n   310→\t\tCreatedAt:        time.Now(),\n   311→\t\tCheckpointsCount: opts.CheckpointsCount,\n   312→\t\tFilesTouched:     opts.FilesTouched,\n   313→\t\tAgent:            opts.Agent,\n   314→\t\tIsTask:           opts.IsTask,\n   315→\t\tToolUseID:        opts.ToolUseID,\n   316→\t\tSessionCount:     1,\n   317→\t\tSessionIDs:       []string{opts.SessionID},\n   318→\t}\n   319→\n   320→\t// Merge with existing metadata if present (multi-session checkpoint)\n   321→\tif existingMetadata != nil {\n   322→\t\t// Get existing session count (default to 1 for backwards compat)\n   323→\t\texistingCount := existingMetadata.SessionCount\n   324→\t\tif existingCount == 0 {\n   325→\t\t\texistingCount = 1\n   326→\t\t}\n   327→\t\tmetadata.SessionCount = existingCount + 1\n   328→\n   329→\t\t// Merge session IDs\n   330→\t\texistingIDs := existingMetadata.SessionIDs\n   331→\t\tif len(existingIDs) == 0 {\n   332→\t\t\t// Backwards compat: old metadata only had SessionID\n   333→\t\t\texistingIDs = []string{existingMetadata.SessionID}\n   334→\t\t}\n   335→\t\tmetadata.SessionIDs = append(metadata.SessionIDs[:0], existingIDs...)\n   336→\t\tmetadata.SessionIDs = append(metadata.SessionIDs, opts.SessionID)\n   337→\n   338→\t\t// Merge files touched (deduplicated)\n   339→\t\tmetadata.FilesTouched = mergeFilesTouched(existingMetadata.FilesTouched, opts.FilesTouched)\n   340→\n   341→\t\t// Sum checkpoint counts\n   342→\t\tmetadata.CheckpointsCount = existingMetadata.CheckpointsCount + opts.CheckpointsCount\n   343→\t}\n   344→\n   345→\tmetadataJSON, err := jsonutil.MarshalIndentWithNewline(metadata, \"\", \"  \")\n   346→\tif err != nil {\n   347→\t\treturn fmt.Errorf(\"failed to marshal metadata: %w\", err)\n   348→\t}\n   349→\tmetadataHash, err := CreateBlobFromContent(s.repo, metadataJSON)\n   350→\tif err != nil {\n   351→\t\treturn err\n   352→\t}\n   353→\tentries[basePath+paths.MetadataFileName] = object.TreeEntry{\n   354→\t\tName: basePath + paths.MetadataFileName,\n   355→\t\tMode: filemode.Regular,\n   356→\t\tHash: metadataHash,\n   357→\t}\n   358→\treturn nil\n   359→}\n   360→\n   361→// mergeFilesTouched combines two file lists, removing duplicates.\n   362→func mergeFilesTouched(existing, additional []string) []string {\n   363→\tseen := make(map[string]bool)\n   364→\tvar result []string\n   365→\n   366→\tfor _, f := range existing {\n   367→\t\tif !seen[f] {\n   368→\t\t\tseen[f] = true\n   369→\t\t\tresult = append(result, f)\n   370→\t\t}\n   371→\t}\n   372→\tfor _, f := range additional {\n   373→\t\tif !seen[f] {\n   374→\t\t\tseen[f] = true\n   375→\t\t\tresult = append(result, f)\n   376→\t\t}\n   377→\t}\n   378→\n   379→\tsort.Strings(result)\n   380→\treturn result\n   381→}\n   382→\n   383→// readMetadataFromBlob reads CommittedMetadata from a blob hash.\n   384→func (s *GitStore) readMetadataFromBlob(hash plumbing.Hash) (*CommittedMetadata, error) {\n   385→\tblob, err := s.repo.BlobObject(hash)\n   386→\tif err != nil {\n   387→\t\treturn nil, fmt.Errorf(\"failed to get blob: %w\", err)\n   388→\t}\n   389→\n   390→\treader, err := blob.Reader()\n   391→\tif err != nil {\n   392→\t\treturn nil, fmt.Errorf(\"failed to get blob reader: %w\", err)\n   393→\t}\n   394→\tdefer reader.Close()\n   395→\n   396→\tvar metadata CommittedMetadata\n   397→\tif err := json.NewDecoder(reader).Decode(&metadata); err != nil {\n   398→\t\treturn nil, fmt.Errorf(\"failed to decode metadata: %w\", err)\n   399→\t}\n   400→\n   401→\treturn &metadata, nil\n   402→}\n   403→\n   404→// archiveExistingSession moves existing session files to a numbered subfolder.\n   405→// The subfolder number is based on the current session count (so first archived session goes to \"1/\").\n   406→func (s *GitStore) archiveExistingSession(basePath string, existingMetadata *CommittedMetadata, entries map[string]object.TreeEntry) {\n   407→\t// Determine archive folder number\n   408→\tsessionCount := existingMetadata.SessionCount\n   409→\tif sessionCount == 0 {\n   410→\t\tsessionCount = 1 // backwards compat\n   411→\t}\n   412→\tarchivePath := fmt.Sprintf(\"%s%d/\", basePath, sessionCount)\n   413→\n   414→\t// Files to archive (standard checkpoint files at basePath, excluding tasks/ subfolder)\n   415→\tfilesToArchive := []string{\n   416→\t\tpaths.MetadataFileName,\n   417→\t\tpaths.TranscriptFileName,\n   418→\t\tpaths.PromptFileName,\n   419→\t\tpaths.ContextFileName,\n   420→\t\tpaths.ContentHashFileName,\n   421→\t}\n   422→\n   423→\t// Move each file to archive folder\n   424→\tfor _, filename := range filesToArchive {\n   425→\t\tsrcPath := basePath + filename\n   426→\t\tif entry, exists := entries[srcPath]; exists {\n   427→\t\t\t// Add to archive location\n   428→\t\t\tdstPath := archivePath + filename\n   429→\t\t\tentries[dstPath] = object.TreeEntry{\n   430→\t\t\t\tName: dstPath,\n   431→\t\t\t\tMode: entry.Mode,\n   432→\t\t\t\tHash: entry.Hash,\n   433→\t\t\t}\n   434→\t\t\t// Remove from original location (will be overwritten by new session)\n   435→\t\t\tdelete(entries, srcPath)\n   436→\t\t}\n   437→\t}\n   438→}\n   439→\n   440→// readArchivedSessions reads transcript data from archived session subfolders (1/, 2/, etc.).\n   441→// Returns sessions ordered by folder index (oldest first).\n   442→func (s *GitStore) readArchivedSessions(checkpointTree *object.Tree, sessionCount int) []ArchivedSession {\n   443→\tvar archived []ArchivedSession\n   444→\n   445→\t// Archived sessions are in numbered folders: 1/, 2/, etc.\n   446→\t// The most recent session is at the root level (not archived).\n   447→\t// Session count N means there are N-1 archived sessions.\n   448→\tfor i := 1; i < sessionCount; i++ {\n   449→\t\tfolderName := strconv.Itoa(i)\n   450→\n   451→\t\t// Try to get the archived session subtree\n   452→\t\tsubTree, err := checkpointTree.Tree(folderName)\n   453→\t\tif err !