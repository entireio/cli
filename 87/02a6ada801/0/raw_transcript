nt to the entire/sessions branch.\n    25→// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n    26→//\n    27→// For task checkpoints (IsTask=true), additional files are written under tasks/<tool-use-id>/:\n    28→//   - For incremental checkpoints: checkpoints/NNN-<tool-use-id>.json\n    29→//   - For final checkpoints: checkpoint.json and agent-<agent-id>.jsonl\n    30→func (s *GitStore) WriteCommitted(ctx context.Context, opts WriteCommittedOptions) error {\n    31→\t_ = ctx // Reserved for future use\n    32→\n    33→\t// Validate identifiers to prevent path traversal and malformed data\n    34→\tif err := paths.ValidateCheckpointID(opts.CheckpointID); err != nil {\n    35→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    36→\t}\n    37→\tif err := paths.ValidateSessionID(opts.SessionID); err != nil {\n    38→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    39→\t}\n    40→\tif err := paths.ValidateToolUseID(opts.ToolUseID); err != nil {\n    41→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    42→\t}\n    43→\tif err := paths.ValidateAgentID(opts.AgentID); err != nil {\n    44→\t\treturn fmt.Errorf(\"invalid checkpoint options: %w\", err)\n    45→\t}\n    46→\n    47→\t// Ensure sessions branch exists\n    48→\tif err := s.ensureSessionsBranch(); err != nil {\n    49→\t\treturn fmt.Errorf(\"failed to ensure sessions branch: %w\", err)\n    50→\t}\n    51→\n    52→\t// Get current branch tip and flatten tree\n    53→\tref, entries, err := s.getSessionsBranchEntries()\n    54→\tif err != nil {\n    55→\t\treturn err\n    56→\t}\n    57→\n    58→\t// Use sharded path: <id[:2]>/<id[2:]>/\n    59→\tbasePath := paths.CheckpointPath(opts.CheckpointID) + \"/\"\n    60→\n    61→\t// Track task metadata path for commit trailer\n    62→\tvar taskMetadataPath string\n    63→\n    64→\t// Handle task checkpoints\n    65→\tif opts.IsTask && opts.ToolUseID != \"\" {\n    66→\t\ttaskMetadataPath, err = s.write