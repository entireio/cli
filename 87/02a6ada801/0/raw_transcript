{"parentUuid":"e7700da8-1430-4c3b-ab76-ea63733fb73d","isSidechain":false,"userType":"external","cwd":"/Users/alex/workspace/cli","sessionId":"c2b51eb0-d0e9-43cf-b431-42c05d49450b","version":"2.1.12","gitBranch":"alex/ent-53-improve-explain","slug":"wise-yawning-wand","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nfg6hbf7Kjtq8nE8BPDdKb","type":"tool_result","content":"     1→// Package checkpoint provides types and interfaces for checkpoint storage.\n     2→//\n     3→// A Checkpoint captures a point-in-time within a session, containing either\n     4→// full state (Temporary) or metadata with a commit reference (Committed).\n     5→//\n     6→// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\n     7→package checkpoint\n     8→\n     9→import (\n    10→\t\"context\"\n    11→\t\"time\"\n    12→\n    13→\t\"github.com/go-git/go-git/v5/plumbing\"\n    14→)\n    15→\n    16→// Checkpoint represents a save point within a session.\n    17→type Checkpoint struct {\n    18→\t// ID is the unique checkpoint identifier\n    19→\tID string\n    20→\n    21→\t// SessionID is the session this checkpoint belongs to\n    22→\tSessionID string\n    23→\n    24→\t// Timestamp is when this checkpoint was created\n    25→\tTimestamp time.Time\n    26→\n    27→\t// Type indicates temporary (full state) or committed (metadata only)\n    28→\tType Type\n    29→\n    30→\t// Message is a human-readable description of the checkpoint\n    31→\tMessage string\n    32→}\n    33→\n    34→// Type indicates the storage location and lifecycle of a checkpoint.\n    35→type Type int\n    36→\n    37→const (\n    38→\t// Temporary checkpoints contain full state (code + metadata) and are stored\n    39→\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n    40→\tTemporary Type = iota\n    41→\n    42→\t// Committed checkpoints contain metadata + commit reference and are stored\n    43→\t// on the entire/sessions branch. They are the permanent record.\n    44→\tCommitted\n    45→)\n    46→\n    47→// Store provides low-level primitives for reading and writing checkpoints.\n    48→// This is used by strategies to implement their storage approach.\n    49→//\n    50→// The interface matches the GitStore implementation signatures directly:\n    51→// - WriteTemporary takes WriteTemporaryOptions and returns the commit hash\n    52→// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n    53→// - List methods return implementation-specific info types for richer data\n    54→type Store interface {\n    55→\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n    56→\t// Shadow branches are named entire/<base-commit-short-hash>.\n    57→\t// Returns the commit hash of the created checkpoint.\n    58→\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (plumbing.Hash, error)\n    59→\n    60→\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n    61→\t// baseCommit is the commit hash the session is based on.\n    62→\t// Returns nil, nil if the shadow branch doesn't exist.\n    63→\tReadTemporary(ctx context.Context, baseCommit string) (*ReadTemporaryResult, error)\n    64→\n    65→\t// ListTemporary lists all shadow branches with their checkpoint info.\n    66→\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n    67→\n    68→\t// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n    69→\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n    70→\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n    71→\n    72→\t// ReadCommitted reads a committed checkpoint by ID.\n    73→\t// Returns nil, nil if the checkpoint does not exist.\n    74→\tReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error)\n    75→\n    76→\t// ListCommitted lists all committed checkpoints.\n    77→\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n    78→\n    79→\t// UpdateSummary updates the summary fields of an existing checkpoint.\n    80→\t// This is used by --generate to persist generated summaries.\n    81→\tUpdateSummary(ctx context.Context, opts UpdateSummaryOptions) error\n    82→}\n    83→\n    84→// UpdateSummaryOptions contains options for updating checkpoint summary fields.\n    85→type UpdateSummaryOptions struct {\n    86→\t// CheckpointID is the checkpoint to update\n    87→\tCheckpointID string\n    88→\n    89→\t// Summary fields to update\n    90→\tIntent         string\n    91→\tOutcome        string\n    92→\tLearnings      []string\n    93→\tFrictionPoints []string\n    94→\n    95→\t// AuthorName is the name to use for commits\n    96→\tAuthorName string\n    97→\n    98→\t// AuthorEmail is the email to use for commits\n    99→\tAuthorEmail string\n   100→}\n   101→\n   102→// WriteTemporaryOptions contains options for writing a temporary checkpoint.\n   103→type WriteTemporaryOptions struct {\n   104→\t// SessionID is the session identifier\n   105→\tSessionID string\n   106→\n   107→\t// BaseCommit is the commit hash this session is based on\n   108→\tBaseCommit string\n   109→\n   110→\t// ModifiedFiles are files that have been modified (relative paths)\n   111→\tModifiedFiles []string\n   112→\n   113→\t// NewFiles are files that have been created (relative paths)\n   114→\tNewFiles []string\n   115→\n   116→\t// DeletedFiles are files that have been deleted (relative paths)\n   117→\tDeletedFiles []string\n   118→\n   119→\t// MetadataDir is the relative path to the metadata directory\n   120→\tMetadataDir string\n   121→\n   122→\t// MetadataDirAbs is the absolute path to the metadata directory\n   123→\tMetadataDirAbs string\n   124→\n   125→\t// CommitMessage is the commit subject line\n   126→\tCommitMessage string\n   127→\n   128→\t// AuthorName is the name to use for commits\n   129→\tAuthorName string\n   130→\n   131→\t// AuthorEmail is the email to use for commits\n   132→\tAuthorEmail string\n   133→\n   134→\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n   135→\t// When true, all working directory files are captured (not just modified)\n   136→\tIsFirstCheckpoint bool\n   137→}\n   138→\n   139→// ReadTemporaryResult contains the result of reading a temporary checkpoint.\n   140→type ReadTemporaryResult struct {\n   141→\t// CommitHash is the hash of the checkpoint commit\n   142→\tCommitHash plumbing.Hash\n   143→\n   144→\t// TreeHash is the hash of the tree containing the checkpoint state\n   145→\tTreeHash plumbing.Hash\n   146→\n   147→\t// SessionID is the session identifier from the commit trailer\n   148→\tSessionID string\n   149→\n   150→\t// MetadataDir is the metadata directory path from the commit trailer\n   151→\tMetadataDir string\n   152→\n   153→\t// Timestamp is when the checkpoint was created\n   154→\tTimestamp time.Time\n   155→}\n   156→\n   157→// TemporaryInfo contains summary information about a shadow branch.\n   158→type TemporaryInfo struct {\n   159→\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n   160→\tBranchName string\n   161→\n   162→\t// BaseCommit is the short commit hash this branch is based on\n   163→\tBaseCommit string\n   164→\n   165→\t// LatestCommit is the hash of the latest commit on the branch\n   166→\tLatestCommit plumbing.Hash\n   167→\n   168→\t// SessionID is the session identifier from the latest commit\n   169→\tSessionID string\n   170→\n   171→\t// Timestamp is when the latest checkpoint was created\n   172→\tTimestamp time.Time\n   173→}\n   174→\n   175→// WriteCommittedOptions contains options for writing a committed checkpoint.\n   176→type WriteCommittedOptions struct {\n   177→\t// CheckpointID is the stable 12-hex-char identifier\n   178→\tCheckpointID string\n   179→\n   180→\t// SessionID is the session identifier\n   181→\tSessionID string\n   182→\n   183→\t// Strategy is the name of the strategy that created this checkpoint\n   184→\tStrategy string\n   185→\n   186→\t// Transcript is the session transcript content (full.jsonl)\n   187→\tTranscript []byte\n   188→\n   189→\t// Prompts contains user prompts from the session\n   190→\tPrompts []string\n   191→\n   192→\t// Context is the generated context.md content\n   193→\tContext []byte\n   194→\n   195→\t// FilesTouched are files modified during the session\n   196→\tFilesTouched []string\n   197→\n   198→\t// CheckpointsCount is the number of checkpoints in this session\n   199→\tCheckpointsCount int\n   200→\n   201→\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n   202→\tEphemeralBranch string\n   203→\n   204→\t// AuthorName is the name to use for commits\n   205→\tAuthorName string\n   206→\n   207→\t// AuthorEmail is the email to use for commits\n   208→\tAuthorEmail string\n   209→\n   210→\t// MetadataDir is a directory containing additional metadata files to copy\n   211→\t// If set, all files in this directory will be copied to the checkpoint path\n   212→\t// This is useful for copying task metadata files, subagent transcripts, etc.\n   213→\tMetadataDir string\n   214→\n   215→\t// Task checkpoint fields (for auto-commit strategy task checkpoints)\n   216→\tIsTask    bool   // Whether this is a task checkpoint\n   217→\tToolUseID string // Tool use ID for task checkpoints\n   218→\n   219→\t// Additional task checkpoint fields for subagent checkpoints\n   220→\tAgentID                string // Subagent identifier\n   221→\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n   222→\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n   223→\tSubagentTranscriptPath string // Path to subagent's transcript file\n   224→\n   225→\t// Incremental checkpoint fields\n   226→\tIsIncremental       bool   // Whether this is an incremental checkpoint\n   227→\tIncrementalSequence int    // Checkpoint sequence number\n   228→\tIncrementalType     string // Tool type that triggered this checkpoint\n   229→\tIncrementalData     []byte // Tool input payload for this checkpoint\n   230→\n   231→\t// Commit message fields (used for task checkpoints)\n   232→\tCommitSubject string // Subject line for the metadata commit (overrides default)\n   233→\n   234→\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n   235→\tAgent string\n   236→}\n   237→\n   238→// ReadCommittedResult contains the result of reading a committed checkpoint.\n   239→type ReadCommittedResult struct {\n   240→\t// Metadata contains the checkpoint metadata\n   241→\tMetadata CommittedMetadata\n   242→\n   243→\t// Transcript is the session transcript content (most recent session)\n   244→\tTranscript []byte\n   245→\n   246→\t// Prompts contains user prompts (most recent session)\n   247→\tPrompts string\n   248→\n   249→\t// Context is the context.md content\n   250→\tContext string\n   251→\n   252→\t// ArchivedSessions contains transcripts from previous sessions when multiple\n   253→\t// sessions were condensed to the same checkpoint. Ordered from oldest to newest\n   254→\t// (1/, 2/, etc.). The root-level Transcript is the most recent session.\n   255→\tArchivedSessions []ArchivedSession\n   256→}\n   257→\n   258→// ArchivedSession contains transcript data from a previous session\n   259→// that was archived when multiple sessions contributed to the same checkpoint.\n   260→type ArchivedSession struct {\n   261→\t// SessionID is the session identifier for this archived session\n   262→\tSessionID string\n   263→\n   264→\t// Transcript is the session transcript content\n   265→\tTranscript []byte\n   266→\n   267→\t// Prompts contains user prompts from this session\n   268→\tPrompts string\n   269→\n   270→\t// FolderIndex is the archive folder number (1, 2, etc.)\n   271→\tFolderIndex int\n   272→}\n   273→\n   274→// CommittedInfo contains summary information about a committed checkpoint.\n   275→type CommittedInfo struct {\n   276→\t// CheckpointID is the stable 12-hex-char identifier\n   277→\tCheckpointID string\n   278→\n   279→\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n   280→\tSessionID string\n   281→\n   282→\t// CreatedAt is when the checkpoint was created\n   283→\tCreatedAt time.Time\n   284→\n   285→\t// CheckpointsCount is the total number of checkpoints across all sessions\n   286→\tCheckpointsCount int\n   287→\n   288→\t// FilesTouched are files modified during all sessions\n   289→\tFilesTouched []string\n   290→\n   291→\t// Agent identifies the agent that created this checkpoint\n   292→\tAgent string\n   293→\n   294→\t// IsTask indicates if this is a task checkpoint\n   295→\tIsTask bool\n   296→\n   297→\t// ToolUseID is the tool use ID for task checkpoints\n   298→\tToolUseID string\n   299→\n   300→\t// Multi-session support\n   301→\tSessionCount int      // Number of sessions (1 if single session)\n   302→\tSessionIDs   []string // All session IDs that contributed\n   303→}\n   304→\n   305→// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\n   306→type CommittedMetadata struct {\n   307→\tCheckpointID     string    `json:\"checkpoint_id\"`\n   308→\tSessionID        string    `json:\"session_id\"`\n   309→\tStrategy         string    `json:\"strategy\"`\n   310→\tCreatedAt        time.Time `json:\"created_at\"`\n   311→\tCheckpointsCount int       `json:\"checkpoints_count\"`\n   312→\tFilesTouched     []string  `json:\"files_touched\"`\n   313→\n   314→\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n   315→\tAgent string `json:\"agent,omitempty\"`\n   316→\n   317→\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n   318→\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n   319→\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n   320→\n   321→\t// Task checkpoint fields (only populated for task checkpoints)\n   322→\tIsTask    bool   `json:\"is_task,omitempty\"`\n   323→\tToolUseID string `json:\"tool_use_id,omitempty\"`\n   324→\n   325→\t// Summary fields for explain output (lazily generated, may be empty)\n   326→\tIntent         string   `json:\"intent,omitempty\"`          // What the user was trying to accomplish\n   327→\tOutcome        string   `json:\"outcome,omitempty\"`         // What was actually achieved\n   328→\tLearnings      []string `json:\"learnings,omitempty\"`       // Key insights discovered during the session\n   329→\tFrictionPoints []string `json:\"friction_points,omitempty\"` // Difficulties or blockers encountered\n   330→}\n   331→\n   332→// Info provides summary information for listing checkpoints.\n   333→// This is the generic checkpoint info type.\n   334→type Info struct {\n   335→\t// ID is the checkpoint identifier\n   336→\tID string\n   337→\n   338→\t// SessionID identifies the session\n   339→\tSessionID string\n   340→\n   341→\t// Type indicates temporary or committed\n   342→\tType Type\n   343→\n   344→\t// CreatedAt is when the checkpoint was created\n   345→\tCreatedAt time.Time\n   346→\n   347→\t// Message is a summary description\n   348→\tMessage string\n   349→}\n   350→\n   351→// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n   352→// Task checkpoints are created when a subagent completes and contain both\n   353→// code changes and task-specific metadata.\n   354→type WriteTemporaryTaskOptions struct {\n   355→\t// SessionID is the session identifier\n   356→\tSessionID string\n   357→\n   358→\t// BaseCommit is the commit hash this session is based on\n   359→\tBaseCommit string\n   360→\n   361→\t// ToolUseID is the unique identifier for this Task tool invocation\n   362→\tToolUseID string\n   363→\n   364→\t// AgentID is the subagent identifier\n   365→\tAgentID string\n   366→\n   367→\t// ModifiedFiles are files that have been modified (relative paths)\n   368→\tModifiedFiles []string\n   369→\n   370→\t// NewFiles are files that have been created (relative paths)\n   371→\tNewFiles []string\n   372→\n   373→\t// DeletedFiles are files that have been deleted (relative paths)\n   374→\tDeletedFiles []string\n   375→\n   376→\t// TranscriptPath is the path to the main session transcript\n   377→\tTranscriptPath string\n   378→\n   379→\t// SubagentTranscriptPath is the path to the subagent's transcript\n   380→\tSubagentTranscriptPath string\n   381→\n   382→\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n   383→\tCheckpointUUID string\n   384→\n   385→\t// CommitMessage is the commit message (already formatted)\n   386→\tCommitMessage string\n   387→\n   388→\t// AuthorName is the name to use for commits\n   389→\tAuthorName string\n   390→\n   391→\t// AuthorEmail is the email to use for commits\n   392→\tAuthorEmail string\n   393→\n   394→\t// IsIncremental indicates this is an incremental checkpoint\n   395→\tIsIncremental bool\n   396→\n   397→\t// IncrementalSequence is the checkpoint sequence number\n   398→\tIncrementalSequence int\n   399→\n   400→\t// IncrementalType is the tool that triggered this checkpoint\n   401→\tIncrementalType string\n   402→\n   403→\t// IncrementalData is the tool_input payload for this checkpoint\n   404→\tIncrementalData []byte\n   405→}\n   406→\n   407→// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n   408→// Used by ListTemporaryCheckpoints to provide rewind point data.\n   409→type TemporaryCheckpointInfo struct {\n   410→\t// CommitHash is the hash of the checkpoint commit\n   411→\tCommitHash plumbing.Hash\n   412→\n   413→\t// Message is the first line of the commit message\n   414→\tMessage string\n   415→\n   416→\t// SessionID is the session identifier from the Entire-Session trailer\n   417→\tSessionID string\n   418→\n   419→\t// MetadataDir is the metadata directory path from trailers\n   420→\tMetadataDir string\n   421→\n   422→\t// IsTaskCheckpoint indicates if this is a task checkpoint\n   423→\tIsTaskCheckpoint bool\n   424→\n   425→\t// ToolUseID is the tool use ID for task checkpoints\n   426→\tToolUseID string\n   427→\n   428→\t// Timestamp is when the checkpoint was created\n   429→\tTimestamp time.Time\n   430→}\n   431→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"6377da68-4571-4eba-9771-b417be2cad0e","timestamp":"2026-01-20T00:25:18.272Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/alex/workspace/cli/cmd/entire/cli/checkpoint/checkpoint.go","content":"// Package checkpoint provides types and interfaces for checkpoint storage.\n//\n// A Checkpoint captures a point-in-time within a session, containing either\n// full state (Temporary) or metadata with a commit reference (Committed).\n//\n// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\npackage checkpoint\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/go-git/go-git/v5/plumbing\"\n)\n\n// Checkpoint represents a save point within a session.\ntype Checkpoint struct {\n\t// ID is the unique checkpoint identifier\n\tID string\n\n\t// SessionID is the session this checkpoint belongs to\n\tSessionID string\n\n\t// Timestamp is when this checkpoint was created\n\tTimestamp time.Time\n\n\t// Type indicates temporary (full state) or committed (metadata only)\n\tType Type\n\n\t// Message is a human-readable description of the checkpoint\n\tMessage string\n}\n\n// Type indicates the storage location and lifecycle of a checkpoint.\ntype Type int\n\nconst (\n\t// Temporary checkpoints contain full state (code + metadata) and are stored\n\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n\tTemporary Type = iota\n\n\t// Committed checkpoints contain metadata + commit reference and are stored\n\t// on the entire/sessions branch. They are the permanent record.\n\tCommitted\n)\n\n// Store provides low-level primitives for reading and writing checkpoints.\n// This is used by strategies to implement their storage approach.\n//\n// The interface matches the GitStore implementation signatures directly:\n// - WriteTemporary takes WriteTemporaryOptions and returns the commit hash\n// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n// - List methods return implementation-specific info types for richer data\ntype Store interface {\n\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n\t// Shadow branches are named entire/<base-commit-short-hash>.\n\t// Returns the commit hash of the created checkpoint.\n\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (plumbing.Hash, error)\n\n\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n\t// baseCommit is the commit hash the session is based on.\n\t// Returns nil, nil if the shadow branch doesn't exist.\n\tReadTemporary(ctx context.Context, baseCommit string) (*ReadTemporaryResult, error)\n\n\t// ListTemporary lists all shadow branches with their checkpoint info.\n\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n\n\t// WriteCommitted writes a committed checkpoint to the entire/sessions branch.\n\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n\n\t// ReadCommitted reads a committed checkpoint by ID.\n\t// Returns nil, nil if the checkpoint does not exist.\n\tReadCommitted(ctx context.Context, checkpointID string) (*ReadCommittedResult, error)\n\n\t// ListCommitted lists all committed checkpoints.\n\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n\n\t// UpdateSummary updates the summary fields of an existing checkpoint.\n\t// This is used by --generate to persist generated summaries.\n\tUpdateSummary(ctx context.Context, opts UpdateSummaryOptions) error\n}\n\n// UpdateSummaryOptions contains options for updating checkpoint summary fields.\ntype UpdateSummaryOptions struct {\n\t// CheckpointID is the checkpoint to update\n\tCheckpointID string\n\n\t// Summary fields to update\n\tIntent         string\n\tOutcome        string\n\tLearnings      []string\n\tFrictionPoints []string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n}\n\n// WriteTemporaryOptions contains options for writing a temporary checkpoint.\ntype WriteTemporaryOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// MetadataDir is the relative path to the metadata directory\n\tMetadataDir string\n\n\t// MetadataDirAbs is the absolute path to the metadata directory\n\tMetadataDirAbs string\n\n\t// CommitMessage is the commit subject line\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n\t// When true, all working directory files are captured (not just modified)\n\tIsFirstCheckpoint bool\n}\n\n// ReadTemporaryResult contains the result of reading a temporary checkpoint.\ntype ReadTemporaryResult struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// TreeHash is the hash of the tree containing the checkpoint state\n\tTreeHash plumbing.Hash\n\n\t// SessionID is the session identifier from the commit trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from the commit trailer\n\tMetadataDir string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n\n// TemporaryInfo contains summary information about a shadow branch.\ntype TemporaryInfo struct {\n\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n\tBranchName string\n\n\t// BaseCommit is the short commit hash this branch is based on\n\tBaseCommit string\n\n\t// LatestCommit is the hash of the latest commit on the branch\n\tLatestCommit plumbing.Hash\n\n\t// SessionID is the session identifier from the latest commit\n\tSessionID string\n\n\t// Timestamp is when the latest checkpoint was created\n\tTimestamp time.Time\n}\n\n// WriteCommittedOptions contains options for writing a committed checkpoint.\ntype WriteCommittedOptions struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// Strategy is the name of the strategy that created this checkpoint\n\tStrategy string\n\n\t// Transcript is the session transcript content (full.jsonl)\n\tTranscript []byte\n\n\t// Prompts contains user prompts from the session\n\tPrompts []string\n\n\t// Context is the generated context.md content\n\tContext []byte\n\n\t// FilesTouched are files modified during the session\n\tFilesTouched []string\n\n\t// CheckpointsCount is the number of checkpoints in this session\n\tCheckpointsCount int\n\n\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n\tEphemeralBranch string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// MetadataDir is a directory containing additional metadata files to copy\n\t// If set, all files in this directory will be copied to the checkpoint path\n\t// This is useful for copying task metadata files, subagent transcripts, etc.\n\tMetadataDir string\n\n\t// Task checkpoint fields (for auto-commit strategy task checkpoints)\n\tIsTask    bool   // Whether this is a task checkpoint\n\tToolUseID string // Tool use ID for task checkpoints\n\n\t// Additional task checkpoint fields for subagent checkpoints\n\tAgentID                string // Subagent identifier\n\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n\tSubagentTranscriptPath string // Path to subagent's transcript file\n\n\t// Incremental checkpoint fields\n\tIsIncremental       bool   // Whether this is an incremental checkpoint\n\tIncrementalSequence int    // Checkpoint sequence number\n\tIncrementalType     string // Tool type that triggered this checkpoint\n\tIncrementalData     []byte // Tool input payload for this checkpoint\n\n\t// Commit message fields (used for task checkpoints)\n\tCommitSubject string // Subject line for the metadata commit (overrides default)\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string\n}\n\n// ReadCommittedResult contains the result of reading a committed checkpoint.\ntype ReadCommittedResult struct {\n\t// Metadata contains the checkpoint metadata\n\tMetadata CommittedMetadata\n\n\t// Transcript is the session transcript content (most recent session)\n\tTranscript []byte\n\n\t// Prompts contains user prompts (most recent session)\n\tPrompts string\n\n\t// Context is the context.md content\n\tContext string\n\n\t// ArchivedSessions contains transcripts from previous sessions when multiple\n\t// sessions were condensed to the same checkpoint. Ordered from oldest to newest\n\t// (1/, 2/, etc.). The root-level Transcript is the most recent session.\n\tArchivedSessions []ArchivedSession\n}\n\n// ArchivedSession contains transcript data from a previous session\n// that was archived when multiple sessions contributed to the same checkpoint.\ntype ArchivedSession struct {\n\t// SessionID is the session identifier for this archived session\n\tSessionID string\n\n\t// Transcript is the session transcript content\n\tTranscript []byte\n\n\t// Prompts contains user prompts from this session\n\tPrompts string\n\n\t// FolderIndex is the archive folder number (1, 2, etc.)\n\tFolderIndex int\n}\n\n// CommittedInfo contains summary information about a committed checkpoint.\ntype CommittedInfo struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID string\n\n\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n\tSessionID string\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// CheckpointsCount is the total number of checkpoints across all sessions\n\tCheckpointsCount int\n\n\t// FilesTouched are files modified during all sessions\n\tFilesTouched []string\n\n\t// Agent identifies the agent that created this checkpoint\n\tAgent string\n\n\t// IsTask indicates if this is a task checkpoint\n\tIsTask bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Multi-session support\n\tSessionCount int      // Number of sessions (1 if single session)\n\tSessionIDs   []string // All session IDs that contributed\n}\n\n// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\ntype CommittedMetadata struct {\n\tCheckpointID     string    `json:\"checkpoint_id\"`\n\tSessionID        string    `json:\"session_id\"`\n\tStrategy         string    `json:\"strategy\"`\n\tCreatedAt        time.Time `json:\"created_at\"`\n\tCheckpointsCount int       `json:\"checkpoints_count\"`\n\tFilesTouched     []string  `json:\"files_touched\"`\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent string `json:\"agent,omitempty\"`\n\n\t// Multi-session support: when multiple sessions contribute to the same checkpoint\n\tSessionCount int      `json:\"session_count,omitempty\"` // Number of sessions (1 if omitted for backwards compat)\n\tSessionIDs   []string `json:\"session_ids,omitempty\"`   // All session IDs that contributed\n\n\t// Task checkpoint fields (only populated for task checkpoints)\n\tIsTask    bool   `json:\"is_task,omitempty\"`\n\tToolUseID string `json:\"tool_use_id,omitempty\"`\n\n\t// Summary fields for explain output (lazily generated, may be empty)\n\tIntent         string   `json:\"intent,omitempty\"`          // What the user was trying to accomplish\n\tOutcome        string   `json:\"outcome,omitempty\"`         // What was actually achieved\n\tLearnings      []string `json:\"learnings,omitempty\"`       // Key insights discovered during the session\n\tFrictionPoints []string `json:\"friction_points,omitempty\"` // Difficulties or blockers encountered\n}\n\n// Info provides summary information for listing checkpoints.\n// This is the generic checkpoint info type.\ntype Info struct {\n\t// ID is the checkpoint identifier\n\tID string\n\n\t// SessionID identifies the session\n\tSessionID string\n\n\t// Type indicates temporary or committed\n\tType Type\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// Message is a summary description\n\tMessage string\n}\n\n// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n// Task checkpoints are created when a subagent completes and contain both\n// code changes and task-speci