tfor _, branch := range branches {\n138\t\t\t// Use git CLI to delete branches because go-git v5's RemoveReference\n139\t\t\t// doesn't properly persist deletions with packed refs or worktrees\n140\t\t\tif err := DeleteBranchCLI(ctx, branch); err != nil {\n141\t\t\t\tfailed = append(failed, branch)\n142\t\t\t\tcontinue\n143\t\t\t}\n144\t\n145\t\t\tdeleted = append(deleted, branch)\n146\t\t}\n147\t\n148\t\treturn deleted, failed, nil\n149\t}\n150\t\n151\t// ListOrphanedSessionStates returns session state files that are orphaned.\n152\t// A session state is orphaned if:\n153\t//   - No checkpoints on entire/checkpoints/v1 reference this session ID\n154\t//   - No shadow branch exists for the session's base commit\n155\t//\n156\t// This is strategy-agnostic as session states are shared by all strategies.\n157\tfunc ListOrphanedSessionStates(ctx context.Context) ([]CleanupItem, error) {\n158\t\trepo, err := OpenRepository(ctx)\n159\t\tif err != nil {\n160\t\t\treturn nil, fmt.Errorf(\"failed to open git repository: %w\", err)\n161\t\t}\n162\t\n163\t\t// Get all session states\n164\t\tstore, err := session.NewStateStore(ctx)\n165\t\tif err != nil {\n166\t\t\treturn nil, fmt.Errorf(\"failed to create state store: %w\", err)\n167\t\t}\n168\t\n169\t\tstates, err := store.List(ctx)\n170\t\tif err != nil {\n171\t\t\treturn nil, fmt.Errorf(\"failed to list session states: %w\", err)\n172\t\t}\n173\t\n174\t\tif len(states) == 0 {\n175\t\t\treturn []CleanupItem{}, nil\n176\t\t}\n177\t\n178\t\t// Get all checkpoints to find which sessions have checkpoints\n179\t\tcpStore := checkpoint.NewGitStore(repo)\n180\t\n181\t\tsessionsWithCheckpoints := make(map[string]bool)\n182\t\tcheckpoints, listErr := cpStore.ListCommitted(ctx)\n183\t\tif listErr == nil {\n184\t\t\tfor _, cp := range checkpoints {\n185\t\t\t\tsessionsWithCheckpoints[cp.SessionID] = true\n186\t\t\t}\n187\t\t}\n188\t\n189\t\t// Get all shadow branches as a set for quick lookup\n190\t\tshadowBranches, _ := ListShadowBran