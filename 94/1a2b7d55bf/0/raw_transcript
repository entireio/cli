ession's transcript and links it to the\n49\tlast commit. Use this when hooks failed to fire or weren't installed when\n50\tthe session started, or to attach a research session.\n51\t\n52\tIf the last commit already has a checkpoint, the session is added to it.\n53\tOtherwise a new checkpoint is created.\n54\t\n55\tWorks with any registered agent, including external agents enabled via\n56\texternal_agents in settings. Run 'entire configure' to see the full list.`,\n57\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n58\t\t\t\tif len(args) != 1 {\n59\t\t\t\t\treturn cmd.Help()\n60\t\t\t\t}\n61\t\t\t\tif checkDisabledGuard(cmd.Context(), cmd.OutOrStdout()) {\n62\t\t\t\t\treturn nil\n63\t\t\t\t}\n64\t\t\t\t// Discover external agents so --agent <external-name> is recognized\n65\t\t\t\t// and so auto-detection can find transcripts from external agents.\n66\t\t\t\texternal.DiscoverAndRegister(cmd.Context())\n67\t\t\t\tagentName := types.AgentName(agentFlag)\n68\t\t\t\treturn runAttach(cmd.Context(), cmd.OutOrStdout(), args[0], agentName, force)\n69\t\t\t},\n70\t\t}\n71\t\tcmd.Flags().BoolVarP(&force, \"force\", \"f\", false, \"Skip confirmation and amend the last commit with the checkpoint trailer\")\n72\t\tcmd.Flags().StringVarP(&agentFlag, \"agent\", \"a\", string(agent.DefaultAgentName), \"Agent that created the session (see 'entire configure' for registered agents, including external)\")\n73\t\treturn cmd\n74\t}\n75\t\n76\tfunc runAttach(ctx context.Context, w io.Writer, sessionID string, agentName types.AgentName, force bool) error {\n77\t\t// Initialize structured logger so logging.Warn/Info write to .entire/logs/ not stderr.\n78\t\tif err := logging.Init(ctx, sessionID); err != nil {\n79\t\t\t// Init failed — logging will use stderr fallback, non-fatal.\n80\t\t\t_ = err\n81\t\t}\n82\t\tdefer logging.Close()\n83\t\n84\t\tlogCtx := logging.WithComponent(ctx, \"attach\")\n85\t\n86\t\t// Open repository once — shared across all operations.\n87\t\trepo, err := openRepository(ctx)\n88\t\tif err != nil {\n89\t\t\treturn err\n90\t\t}\n91\t\n92\t\texistingState, err := validateAttachPreconditions(ctx, repo, sessionID)\n93\t\tif err != nil {\n94\t\t\treturn err\n95\t\t}\n96\t\n97\t\theadCommit, err := getHeadCommit(repo)\n98\t\tif err != nil {\n99\t\t\treturn err\n100\t\t}\n101\t\n102\t\t// If session already has a checkpoint, just offer to link it.\n103\t\tif existingState != nil && !existingState.LastCheckpointID.IsEmpty() {\n104\t\t\tcpID := existingState.LastCheckpointID.String()\n105\t\t\tfmt.Fprintf(w, \"Session %s already has checkpoint %s\\n\", sessionID, cpID)\n106\t\t\tif err := promptAmendCommit(logCtx, w, headCommit, cpID, force); err != nil {\n107\t\t\t\tlogging.Warn(logCtx, \"failed to amend commit\", \"error\", err)\n108\t\t\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", cpID)\n109\t\t\t}\n110\t\t\treturn nil\n111\t\t}\n112\t\n113\t\t// Resolve agent and transcript path.\n114\t\tag, transcriptPath, err := resolveAgentAndTranscript(logCtx, w, sessionID, agentName, existingState)\n115\t\tif err != nil {\n116\t\t\treturn err\n117\t\t}\n118\t\n119\t\ttranscriptData, err := ag.ReadTranscript(transcriptPath)\n120\t\tif err != nil {\n121\t\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n122\t\t}\n123\t\n124\t\t// Normalize Gemini transcripts for storage.\n125\t\tstoredTranscript := transcriptData\n126\t\tif ag.Type() == agent.AgentTypeGemini {\n127\t\t\tif normalized, normErr := geminicli.NormalizeTranscript(transcriptData); normErr == nil {\n128\t\t\t\tstoredTranscript = normalized\n129\t\t\t} else {\n130\t\t\t\tlogging.Warn(logCtx, \"failed to normalize Gemini transcript, storing raw\", \"error\", normErr)\n131\t\t\t}\n132\t\t}\n133\t\n134\t\tmeta := extractTranscriptMetadata(transcriptData)\n135\t\n136\t\t// Determine checkpoint ID: reuse from HEAD if one exists, otherwise generate new.\n137\t\tcheckpointID, isExistingCheckpoint := resolveCheckpointID(headCommit)\n138\t\n139\t\t// Refresh the metadata branch if HEAD already references a checkpoint.\n140\t\t// Returns a possibly-freshly-opened repo handle; see refreshForExistingCheckpoint.\n141\t\trepo = refreshForExistingCheckpoint(ctx, logCtx, repo, isExistingCheckpoint)\n142\t\n143\t\t// Write directly to entire/checkpoints/v1.\n144\t\tstore := cpkg.NewGitStore(repo)\n145\t\tif err := verifyCheckpointLocallyAvailable(ctx, store, checkpointID, isExistingCheckpoint); err != nil {\n146\t\t\treturn err\n147\t\t}\n148\t\n149\t\tauthor, err := GetGitAuthor(ctx)\n150\t\tif err != nil {\n151\t\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n152\t\t}\n153\t\n154\t\tvar prompts []string\n155\t\tif meta.FirstPrompt != \"\" {\n156\t\t\tprompts = []string{meta.FirstPrompt}\n157\t\t}\n158\t\n159\t\ttokenUsage := agent.CalculateTokenUsage(logCtx, ag, transcriptData, 0, \"\")\n160\t\n161\t\t_, redactSpan := perf.Start(ctx, \"redact_transcript\")\n162\t\tredactedTranscript, redactErr := redact.JSONLBytes(storedTranscript)\n163\t\tredactSpan.End()\n164\t\tif redactErr != nil {\n165\t\t\treturn fmt.Errorf(\"failed to redact transcript: %w\", redactErr)\n166\t\t}\n167\t\n168\t\twriteOpts := cpkg.WriteCommittedOptions{\n169\t\t\tCheckpointID: checkpointID,\n170\t\t\tSessionID:    sessionID,\n171\t\t\tStrategy:     strategy.StrategyNameManualCommit,\n172\t\t\tTranscript:   redactedTranscript,\n173\t\t\tPrompts:      prompts,\n174\t\t\tAuthorName:   author.Name,\n175\t\t\tAuthorEmail:  author.Email,\n176\t\t\tAgent:        ag.Type(),\n177\t\t\tModel:        meta.Model,\n178\t\t\tTokenUsage:   tokenUsage,\n179\t\t}\n180\t\n181\t\tif compacted := compactTranscriptForStartLine(logCtx, redactedTranscript.Bytes(), cpkg.CommittedMetadata{\n182\t\t\tCheckpointID: checkpointID,\n183\t\t\tAgent:        ag.Type(),\n184\t\t}, 0); compacted != nil {\n185\t\t\twriteOpts.CompactTranscript = compacted\n186\t\t}\n187\t\n188\t\tv2 := settings.CheckpointsVersion(logCtx) == 2\n189\t\tif !v2 {\n190\t\t\tif err := store.WriteCommitted(ctx, writeOpts); err != nil {\n191\t\t\t\treturn fmt.Errorf(\"failed to write checkpoint: %w\", err)\n192\t\t\t}\n193\t\t}\n194\t\t// IsCheckpointsV2Enabled is true whenever v2 writes are enabled, including\n195\t\t// both v2-only mode (checkpoints_version == 2) and dual-write mode. Only\n196\t\t// v2-only mode propagates the error.\n197\t\tif settings.IsCheckpointsV2Enabled(logCtx) {\n198\t\t\tif err := writeAttachCheckpointV2(logCtx, repo, writeOpts); err != nil {\n199\t\t\t\tif v2 {\n200\t\t\t\t\treturn fmt.Errorf(\"failed to write checkpoint to v2: %w\", err)\n201\t\t\t\t}\n202\t\t\t\tlogging.Warn(logCtx, \"attach v2 dual-write failed\", \"error\", err)\n203\t\t\t}\n204\t\t}\n205\t\n206\t\t// Create or update session state.\n207\t\tif err := saveAttachSessionState(logCtx, existingState, sessionID, ag.Type(), transcriptPath, checkpointID, meta, tokenUsage); err != nil {\n208\t\t\tlogging.Warn(logCtx, \"failed to save session state\", \"error\", err)\n209\t\t}\n210\t\n211\t\tfmt.Fprintf(w, \"Attached session %s\\n\", sessionID)\n212\t\tif isExistingCheckpoint {\n213\t\t\tfmt.Fprintf(w, \"  Added to existing checkpoint %s\\n\", checkpointID)\n214\t\t\treturn nil\n215\t\t}\n216\t\n217\t\tfmt.Fprintf(w, \"  Created checkpoint %s\\n\", checkpointID)\n218\t\tcpIDStr := checkpointID.String()\n219\t\tif err := promptAmendCommit(logCtx, w, headCommit, cpIDStr, force); err != nil {\n220\t\t\tlogging.Warn(logCtx, \"failed to amend commit\", \"error\", err)\n221\t\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", cpIDStr)\n222\t\t}\n223\t\n224\t\treturn nil\n225\t}\n226\t\n227\t// writeAttachCheckpointV2 writes attach-created checkpoints into the v2 refs.\n228\tfunc writeAttachCheckpointV2(ctx context.Context, repo *git.Repository, opts cpkg.WriteCommittedOptions) error {\n229\t\tv2URL, err := remote.FetchURL(ctx)\n230\t\tif err != nil {\n231\t\t\tlogging.Debug(ctx, \"attach: using origin for v2 store fetch remote\",\n232\t\t\t\tslog.String(\"error\", err.Error()),\n233\t\t\t)\n234\t\t}\n235\t\tv2Store := cpkg.NewV2GitStore(repo, v2URL)\n236\t\tif err := v2Store.WriteCommitted(ctx, opts); err != nil {\n237\t\t\treturn fmt.Errorf(\"v2 write committed: %w\", err)\n238\t\t}\n239\t\treturn nil\n240\t}\n241\t\n242\t// getHeadCommit returns the HEAD commit object.\n243\tfunc getHeadCommit(repo *git.Repository) (*object.Commit, error) {\n244\t\theadRef, err := repo.Head()\n245\t\tif err != nil {\n246\t\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n247\t\t}\n248\t\tcommit, err := repo.CommitObject(headRef.Hash())\n249\t\tif err != nil {\n250\t\t\treturn nil, fmt.Errorf(\"failed to get HEAD commit: %w\", err)\n251\t\t}\n252\t\treturn commit, nil\n253\t}\n254\t\n255\t// refreshForExistingCheckpoint refreshes the entire/checkpoints/v1 branch\n256\t// before reading or writing when HEAD already references a checkpoint.\n257\t// This mirrors `entire resume`'s metadata fetch fallback chain so attach\n258\t// doesn't operate on a stale local orphan branch after a normal `git pull`.\n259\t// Returns a freshly-opened repo handle so go-git sees any newly fetched\n260\t// packfiles; on fetch failure, logs a warning and returns the original repo.\n261\tfunc refreshForExistingCheckpoint(ctx, logCtx context.Context, repo *git.Repository, isExistingCheckpoint bool) *git.Repository {\n262\t\tif !isExistingCheckpoint {\n263\t\t\treturn repo\n264\t\t}\n265\t\t_, freshRepo, fetchErr := getMetadataTree(ctx)\n266\t\tif fetchErr != nil {\n267\t\t\tlogging.Warn(logCtx, \"failed to refresh metadata branch before attach; proceeding with local state\",\n268\t\t\t\tslog.String(\"error\", fetchErr.Error()))\n269\t\t\treturn repo\n270\t\t}\n271\t\treturn freshRepo\n272\t}\n273\t\n274\t// verifyCheckpointLocallyAvailable refuses the attach when HEAD references\n275\t// an Entire-Checkpoint that is still missing from the local\n276\t// entire/checkpoints/v1 branch after refresh. Without this guard, attach\n277\t// would create a fresh checkpoint under the same ID and overwrite the\n278\t// original session data on push.\n279\tfunc verifyCheckpointLocallyAvailable(ctx context.Context, store *cpkg.GitStore, checkpointID id.CheckpointID, isExistingCheckpoint bool) error {\n280\t\tif !isExistingCheckpoint {\n281\t\t\treturn nil\n282\t\t}\n283\t\tsummary, readErr := store.ReadCommitted(ctx, checkpointID)\n284\t\tif readErr != nil {\n285\t\t\treturn fmt.Errorf(\"failed to read checkpoint %s: %w\", checkpointID, readErr)\n286\t\t}\n287\t\tif summary != nil {\n288\t\t\treturn nil\n289\t\t}\n290\t\tconst fetchCmd = \"git fetch origin entire/checkpoints/v1:entire/checkpoints/v1\"\n291\t\treturn fmt.Errorf(\n292\t\t\t\"checkpoint %s referenced by HEAD is missing from the local entire/checkpoints/v1 branch (the remote fetch didn't bring it in either). Creating a fresh checkpoint here would overwrite the original session data on push. Run:\\n\\n    %s\\n\\nthen re-run attach. If the colleague who made this commit hasn't pushed their checkpoint metadata yet, ask them to do so first\",\n293\t\t\tcheckpointID.String(), fetchCmd,\n294\t\t)\n295\t}\n296\t\n297\t// resolveCheckpointID returns the checkpoint ID to use for the attach.\n298\t// If HEAD already has an Entire-Checkpoint trailer, reuses that ID (the session\n299\t// gets added as an additional session in the existing checkpoint).\n300\t// Otherwise generates a new ID.\n301\tfunc resolveCheckpointID(headCommit *object.Commit) (id.CheckpointID, bool) {\n302\t\texisting := trailers.ParseAllCheckpoints(headCommit.Message)\n303\t\tif len(existing) > 0 {\n304\t\t\treturn existing[len(existing)-1], true\n305\t\t}\n306\t\n307\t\tcpID, err := id.Generate()\n308\t\tif err != nil {\n309\t\t\t// Generation only fails if crypto/rand fails — extremely unlikely.\n310\t\t\t// Fall back to empty which will cause WriteCommitted to fail with a clear error.\n311\t\t\treturn id.EmptyCheckpointID, false\n312\t\t}\n313\t\treturn cpID, false\n314\t}\n315\t\n316\t// saveAttachSessionState creates or updates the session state file for the attached session.\n317\t// If existingState is non-nil, it is updated in place (avoids a redundant disk load).\n318\tfunc saveAttachSessionState(ctx context.Context, existingState *session.State, sessionID string, agentType types.AgentType, transcriptPath string, checkpointID id.CheckpointID, meta transcriptMetadata, tokenUsage *agent.TokenUsage) error {\n319\t\tstateStore, err := session.NewStateStore(ctx)\n320\t\tif err != nil {\n321\t\t\treturn fmt.Errorf(\"failed to open session store: %w\", err)\n322\t\t}\n323\t\n324\t\tnow := time.Now()\n325\t\tstate := existingState\n326\t\tif state == nil {\n327\t\t\tstate = &session.State{\n328\t\t\t\tSessionID: sessionID,\n329\t\t\t\tStartedAt: now,\n330\t\t\t}\n331\t\t}\n332\t\n333\t\tstate.CLIVersion = versioninfo.Version\n334\t\tstate.AttachedManually = true\n335\t\tstate.AgentType = agentType\n336\t\tstate.TranscriptPath = transcriptPath\n337\t\tstate.LastCheckpointID = checkpointID\n338\t\tstate.Phase = session.PhaseEnded\n339\t\tstate.LastInteractionTime = &now\n340\t\tif meta.TurnCount > 0 {\n341\t\t\tstate.SessionTurnCount = meta.TurnCount\n342\t\t}\n343\t\tif meta.Model != \"\" {\n344\t\t\tstate.ModelName = meta.Model\n345\t\t}\n346\t\tif meta.FirstPrompt != \"\" {\n347\t\t\tstate.LastPrompt = meta.FirstPrompt\n348\t\t}\n349\t\tif tokenUsage != nil {\n350\t\t\tstate.TokenUsage = tokenUsage\n351\t\t}\n352\t\n353\t\tif err := stateStore.Save(ctx, state); err != nil {\n354\t\t\treturn fmt.Errorf(\"failed to save session state: %w\", err)\n355\t\t}\n356\t\treturn nil\n357\t}\n358\t\n359\t// validateAttachPreconditions checks session ID format and git repo state.\n360\t// Returns the existing session state if the session is already tracked (nil if new).\n361\tfunc validateAttachPreconditions(ctx context.Context, repo *git.Repository, sessionID string) (*session.State, error) {\n362\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n363\t\t\treturn nil, fmt.Errorf(\"invalid session ID: %w\", err)\n364\t\t}\n365\t\n366\t\tif strategy.IsEmptyRepository(repo) {\n367\t\t\treturn nil, errors.New(\"repository has no commits yet — make an initial commit before running attach\")\n368\t\t}\n369\t\n370\t\tstore, err := session.NewStateStore(ctx)\n371\t\tif err != nil {\n372\t\t\treturn nil, fmt.Errorf(\"failed to open session store: %w\", err)\n373\t\t}\n374\t\texisting, err := store.Load(ctx, sessionID)\n375\t\tif err != nil {\n376\t\t\treturn nil, fmt.Errorf(\"failed to check existing session: %w\", err)\n377\t\t}\n378\t\n379\t\treturn existing, nil\n380\t}\n381\t\n382\t// resolveAgentAndTranscript resolves the agent and transcript path.\n383\t// For existing sessions, resolves the agent from session state's AgentType.\n384\t// For new sessions, uses the --agent flag with auto-detection fallback.\n385\tfunc resolveAgentAndTranscript(ctx context.Context, w io.Writer, sessionID string, agentName types.AgentName, existingState *session.State) (agent.Agent, string, error) {\n386\t\tag, err := resolveAgent(existingState, agentName)\n387\t\tif err != nil {\n388\t\t\treturn nil, \"\", err\n389\t\t}\n390\t\n391\t\ttranscriptPath, err := resolveAndValidateTranscript(ctx, sessionID, ag)\n392\t\tif err != nil {\n393\t\t\t// Auto-detect: try all other agents.\n394\t\t\tdetectedAg, detectedPath, detectErr := detectAgentByTranscript(ctx, sessionID, agentName)\n395\t\t\tif detectErr != nil {\n396\t\t\t\treturn nil, \"\", fmt.Errorf(\"%w (also tried auto-detecting other agents: %w)\", err, detectErr)\n397\t\t\t}\n398\t\t\tag = detectedAg\n399\t\t\ttranscriptPath = detectedPath\n400\t\t\tlogging.Info(ctx, \"auto-detected agent from transcript\", \"agent\", ag.Name())\n401\t\t\tfmt.Fprintf(w, \"Auto-detected agent: %s\\n\", ag.Name())\n402\t\t}\n403\t\n404\t\treturn ag, transcriptPath, nil\n405\t}\n406\t\n407\t// resolveAgent resolves the agent to use. For existing sessions with an AgentType,\n408\t// uses agent.GetByAgentType. Otherwise falls back to the --agent flag.\n409\tfunc resolveAgent(existingState *session.State, agentName types.AgentName) (agent.Agent, error) {\n410\t\tif existingState != nil && existingState.AgentType != \"\" {\n411\t\t\tag, err := agent.GetByAgentType(existingState.AgentType)\n412\t\t\tif err == nil {\n413\t\t\t\treturn ag, nil\n414\t\t\t}\n415\t\t\t// Fall through to flag-based resolution.\n416\t\t}\n417\t\tag, err := agent.Get(agentName)\n418\t\tif err != nil {\n419\t\t\treturn nil, fmt.Errorf(\"agent %q not available: %w\", agentName, err)\n420\t\t}\n421\t\treturn ag, nil\n422\t}\n423\t\n424\t// resolveAndValidateTranscript finds the transcript file for a session, searching alternative\n425\t// project directories if needed.\n426\tfunc resolveAndValidateTranscript(ctx context.Context, sessionID string, ag agent.Agent) (string, error) {\n427\t\ttranscriptPath, err := resolveTranscriptPath(ctx, sessionID, ag)\n428\t\tif err != nil {\n429\t\t\treturn \"\", fmt.Errorf(\"failed to resolve transcript path: %w\", err)\n430\t\t}\n431\t\t// Only call PrepareTranscript when the file already exists — it flushes\n432\t\t// in-progress writes, but can't conjure a file that was never started.\n433\t\t// This avoids agents like Cursor polling for 3s on non-existent files\n434\t\t// during auto-detection.\n435\t\tif _, statErr := os.Stat(transcriptPath); statErr == nil {\n436\t\t\tif preparer, ok := agent.AsTranscriptPreparer(ag); ok {\n437\t\t\t\tif prepErr := preparer.PrepareTranscript(ctx, transcriptPath); prepErr != nil {\n438\t\t\t\t\tlogging.Debug(ctx, \"PrepareTranscript failed (best-effort)\", \"error\", prepErr)\n439\t\t\t\t}\n440\t\t\t}\n441\t\t\treturn transcriptPath, nil\n442\t\t}\n443\t\tfound, searchErr := searchTranscriptInProjectDirs(sessionID, ag)\n444\t\tif searchErr == nil {\n445\t\t\tlogging.Info(ctx, \"found transcript in alternative project directory\", \"path\", found)\n446\t\t\treturn found, nil\n447\t\t}\n448\t\tlogging.Debug(ctx, \"fallback transcript search failed\", \"error\", searchErr)\n449\t\treturn \"\", fmt.Errorf(\"transcript not found for agent %q with session %s; is the session ID correct?\", ag.Name(), sessionID)\n450\t}\n451\t\n452\t// detectAgentByTranscript tries all registered agents (except skip) to find one whose\n453\t// transcript resolution succeeds for the given session ID.\n454\tfunc detectAgentByTranscript(ctx context.Context, sessionID string, skip types.AgentName) (agent.Agent, string, error) {\n455\t\tfor _, name := range agent.List() {\n456\t\t\tif name == skip {\n457\t\t\t\tcontinue\n458\t\t\t}\n459\t\t\tag, err := agent.Get(name)\n460\t\t\tif err != nil {\n461\t\t\t\tcontinue\n462\t\t\t}\n463\t\t\tpath, resolveErr := resolveAndValidateTranscript(ctx, sessionID, ag)\n464\t\t\tif resolveErr != nil {\n465\t\t\t\tlogging.Debug(ctx, \"auto-detect: agent did not match\", \"agent\", string(name), \"error\", resolveErr)\n466\t\t\t\tcontinue\n467\t\t\t}\n468\t\t\treturn ag, path, nil\n469\t\t}\n470\t\treturn nil, \"\", errors.New(\"transcript not found for any registered agent\")\n471\t}\n472\t\n473\t// promptAmendCommit shows the last commit and asks whether to amend it with the checkpoint trailer.\n474\t// When force is true, it amends without prompting.\n475\tfunc promptAmendCommit(ctx context.Context, w io.Writer, headCommit *object.Commit, checkpointIDStr string, force bool) error {\n476\t\tshortHash := headCommit.Hash.String()[:7]\n477\t\tsubject := strings.SplitN(headCommit.Message, \"\\n\", 2)[0]\n478\t\n479\t\t// Skip amending if this exact checkpoint ID is already in the commit.\n480\t\tfor _, existing := range trailers.ParseAllCheckpoints(headCommit.Message) {\n481\t\t\tif existing.String() == checkpointIDStr {\n482\t\t\t\tfmt.Fprintf(w, \"Commit %s already has Entire-Checkpoint: %s\\n\", shortHash, checkpointIDStr)\n483\t\t\t\treturn nil\n484\t\t\t}\n485\t\t}\n486\t\n487\t\tfmt.Fprintf(w, \"\\nLast commit: %s %s\\n\", shortHash, subject)\n488\t\n489\t\tamend := true\n490\t\tif !force {\n491\t\t\tif !interactive.CanPromptInteractively() {\n492\t\t\t\t// Non-interactive: can't prompt, print trailer for manual use.\n493\t\t\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", checkpointIDStr)\n494\t\t\t\treturn nil\n495\t\t\t}\n496\t\t\tform := NewAccessibleForm(\n497\t\t\t\thuh.NewGroup(\n498\t\t\t\t\thuh.NewConfirm().\n499\t\t\t\t\t\tTitle(\"Amend the last commit in this branch?\").\n500\t\t\t\t\t\tAffirmative(\"Y\").\n501\t\t\t\t\t\tNegative(\"n\").\n502\t\t\t\t\t\tValue(&amend),\n503\t\t\t\t),\n504\t\t\t)\n505\t\t\tif err := form.Run(); err != nil {\n506\t\t\t\treturn fmt.Errorf(\"prompt failed: %w\", err)\n507\t\t\t}\n508\t\t}\n509\t\n510\t\tif !amend {\n511\t\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", checkpointIDStr)\n512\t\t\treturn nil\n513\t\t}\n514\t\n515\t\tnewMessage := trailers.AppendCheckpointTrailer(headCommit.Message, checkpointIDStr)\n516\t\n517\t\tcmd := exec.CommandContext(ctx, \"git\", \"commit\", \"--amend\", \"--only\", \"-m\", newMessage)\n518\t\tif output, err := cmd.CombinedOutput(); err != nil {\n519\t\t\treturn fmt.Errorf(\"failed to amend commit: %w\\n%s\", err, output)\n520\t\t}\n521\t\n522\t\tfmt.Fprintf(w, \"Amended commit %s with Entire-Checkpoint: %s\\n\", shortHash, checkpointIDStr)\n523\t\treturn nil\n524\t}\n525\t"}]},"uuid":"9d94307f-7438-4f61-a656-63691ec4a9ce","timestamp":"2026-04-23T16:16:58.724Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/attach.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/external\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/geminicli\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\tcpkg \"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/remote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n\t\"github.com/entireio/cli/cmd/entire/cli/trailers\"\n\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n\t\"github.com/entireio/cli/cmd/entire/cli/versioninfo\"\n\t\"github.com/entireio/cli/perf\"\n\t\"github.com/entireio/cli/redact\"\n\n\t\"github.com/charmbracelet/huh\"\n\t\"github.com/go-git/go-git/v6\"\n\t\"github.com/go-git/go-git/v6/plumbing/object\"\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newAttachCmd() *cobra.Command {\n\tvar (\n\t\tforce     bool\n\t\tagentFlag string\n\t)\n\tcmd := &cobra.Command{\n\t\tUse:   \"attach <session-id>\",\n\t\tShort: \"Attach an existing agent session\",\n\t\tLong: `Attach an existing agent session that wasn't captured by hooks.\n\nThis creates a checkpoint from the session's transcript and links it to the\nlast commit. Use this when hooks failed to fire or weren't installed when\nthe session started, or to attach a research session.\n\nIf the last commit already has a checkpoint, the session is added to it.\nOtherwise a new checkpoint is created.\n\nWorks with any registered agent, including external agents enabled via\nexternal_agents in settings. Run 'entire configure' to see the full list.`,\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\tif len(args) != 1 {\n\t\t\t\treturn cmd.Help()\n\t\t\t}\n\t\t\tif checkDisabledGuard(cmd.Context(), cmd.OutOrStdout()) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\t// Discover external agents so --agent <external-name> is recognized\n\t\t\t// and so auto-detection can find transcripts from external agents.\n\t\t\texternal.DiscoverAndRegister(cmd.Context())\n\t\t\tagentName := types.AgentName(agentFlag)\n\t\t\treturn runAttach(cmd.Context(), cmd.OutOrStdout(), args[0], agentName, force)\n\t\t},\n\t}\n\tcmd.Flags().BoolVarP(&force, \"force\", \"f\", false, \"Skip confirmation and amend the last commit with the checkpoint trailer\")\n\tcmd.Flags().StringVarP(&agentFlag, \"agent\", \"a\", string(agent.DefaultAgentName), \"Agent that created the session (see 'entire configure' for registered agents, including external)\")\n\treturn cmd\n}\n\nfunc runAttach(ctx context.Context, w io.Writer, sessionID string, agentName types.AgentName, force bool) error {\n\t// Initialize structured logger so logging.Warn/Info write to .entire/logs/ not stderr.\n\tif err := logging.Init(ctx, sessionID); err != nil {\n\t\t// Init failed — logging will use stderr fallback, non-fatal.\n\t\t_ = err\n\t}\n\tdefer logging.Close()\n\n\tlogCtx := logging.WithComponent(ctx, \"attach\")\n\n\t// Open repository once — shared across all operations.\n\trepo, err := openRepository(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\texistingState, err := validateAttachPreconditions(ctx, repo, sessionID)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\theadCommit, err := getHeadCommit(repo)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// If session already has a checkpoint, just offer to link it.\n\tif existingState != nil && !existingState.LastCheckpointID.IsEmpty() {\n\t\tcpID := existingState.LastCheckpointID.String()\n\t\tfmt.Fprintf(w, \"Session %s already has checkpoint %s\\n\", sessionID, cpID)\n\t\tif err := promptAmendCommit(logCtx, w, headCommit, cpID, force); err != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to amend commit\", \"error\", err)\n\t\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", cpID)\n\t\t}\n\t\treturn nil\n\t}\n\n\t// Resolve agent and transcript path.\n\tag, transcriptPath, err := resolveAgentAndTranscript(logCtx, w, sessionID, agentName, existingState)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\ttranscriptData, err := ag.ReadTranscript(transcriptPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\n\t// Normalize Gemini transcripts for storage.\n\tstoredTranscript := transcriptData\n\tif ag.Type() == agent.AgentTypeGemini {\n\t\tif normalized, normErr := geminicli.NormalizeTranscript(transcriptData); normErr == nil {\n\t\t\tstoredTranscript = normalized\n\t\t} else {\n\t\t\tlogging.Warn(logCtx, \"failed to normalize Gemini transcript, storing raw\", \"error\", normErr)\n\t\t}\n\t}\n\n\tmeta := extractTranscriptMetadata(transcriptData)\n\n\t// Determine checkpoint ID: reuse from HEAD if one exists, otherwise generate new.\n\tcheckpointID, isExistingCheckpoint := resolveCheckpointID(headCommit)\n\n\t// Refresh the metadata branch if HEAD already references a checkpoint.\n\t// Returns a possibly-freshly-opened repo handle; see refreshForExistingCheckpoint.\n\trepo = refreshForExistingCheckpoint(ctx, logCtx, repo, isExistingCheckpoint)\n\n\t// Write directly to entire/checkpoints/v1.\n\tstore := cpkg.NewGitStore(repo)\n\tif err := verifyCheckpointLocallyAvailable(ctx, store, checkpointID, isExistingCheckpoint); err != nil {\n\t\treturn err\n\t}\n\n\tauthor, err := GetGitAuthor(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n\t}\n\n\tvar prompts []string\n\tif meta.FirstPrompt != \"\" {\n\t\tprompts = []string{meta.FirstPrompt}\n\t}\n\n\ttokenUsage := agent.CalculateTokenUsage(logCtx, ag, transcriptData, 0, \"\")\n\n\t_, redactSpan := perf.Start(ctx, \"redact_transcript\")\n\tredactedTranscript, redactErr := redact.JSONLBytes(storedTranscript)\n\tredactSpan.End()\n\tif redactErr != nil {\n\t\treturn fmt.Errorf(\"failed to redact transcript: %w\", redactErr)\n\t}\n\n\twriteOpts := cpkg.WriteCommittedOptions{\n\t\tCheckpointID: checkpointID,\n\t\tSessionID:    sessionID,\n\t\tStrategy:     strategy.StrategyNameManualCommit,\n\t\tTranscript:   redactedTranscript,\n\t\tPrompts:      prompts,\n\t\tAuthorName:   author.Name,\n\t\tAuthorEmail:  author.Email,\n\t\tAgent:        ag.Type(),\n\t\tModel:        meta.Model,\n\t\tTokenUsage:   tokenUsage,\n\t}\n\n\tif compacted := compactTranscriptForStartLine(logCtx, redactedTranscript.Bytes(), cpkg.CommittedMetadata{\n\t\tCheckpointID: checkpointID,\n\t\tAgent:        ag.Type(),\n\t}, 0); compacted != nil {\n\t\twriteOpts.CompactTranscript = compacted\n\t}\n\n\tv2 := settings.CheckpointsVersion(logCtx) == 2\n\tif !v2 {\n\t\tif err := store.WriteCommitted(ctx, writeOpts); err != nil {\n\t\t\treturn fmt.Errorf(\"failed to write checkpoint: %w\", err)\n\t\t}\n\t}\n\t// IsCheckpointsV2Enabled is true whenever v2 writes are enabled, including\n\t// both v2-only mode (checkpoints_version == 2) and dual-write mode. Only\n\t// v2-only mode propagates the error.\n\tif settings.IsCheckpointsV2Enabled(logCtx) {\n\t\tif err := writeAttachCheckpointV2(logCtx, repo, writeOpts); err != nil {\n\t\t\tif v2 {\n\t\t\t\treturn fmt.Errorf(\"failed to write checkpoint to v2: %w\", err)\n\t\t\t}\n\t\t\tlogging.Warn(logCtx, \"attach v2 dual-write failed\", \"error\", err)\n\t\t}\n\t}\n\n\t// Create or update session state.\n\tif err := saveAttachSessionState(logCtx, existingState, sessionID, ag.Type(), transcriptPath, checkpointID, meta, tokenUsage); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to save session state\", \"error\", err)\n\t}\n\n\tfmt.Fprintf(w, \"Attached session %s\\n\", sessionID)\n\tif isExistingCheckpoint {\n\t\tfmt.Fprintf(w, \"  Added to existing checkpoint %s\\n\", checkpointID)\n\t\treturn nil\n\t}\n\n\tfmt.Fprintf(w, \"  Created checkpoint %s\\n\", checkpointID)\n\tcpIDStr := checkpointID.String()\n\tif err := promptAmendCommit(logCtx, w, headCommit, cpIDStr, force); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to amend commit\", \"error\", err)\n\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", cpIDStr)\n\t}\n\n\treturn nil\n}\n\n// writeAttachCheckpointV2 writes attach-created checkpoints into the v2 refs.\nfunc writeAttachCheckpointV2(ctx context.Context, repo *git.Repository, opts cpkg.WriteCommittedOptions) error {\n\tv2URL, err := remote.FetchURL(ctx)\n\tif err != nil {\n\t\tlogging.Debug(ctx, \"attach: using origin for v2 store fetch remote\",\n\t\t\tslog.String(\"error\", err.Error()),\n\t\t)\n\t}\n\tv2Store := cpkg.NewV2GitStore(repo, v2URL)\n\tif err := v2Store.WriteCommitted(ctx, opts); err != nil {\n\t\treturn fmt.Errorf(\"v2 write committed: %w\", err)\n\t}\n\treturn nil\n}\n\n// getHeadCommit returns the HEAD commit object.\nfunc getHeadCommit(repo *git.Repository) (*object.Commit, error) {\n\theadRef, err := repo.Head()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n\t}\n\tcommit, err := repo.CommitObject(headRef.Hash())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get HEAD commit: %w\", err)\n\t}\n\treturn commit, nil\n}\n\n// refreshForExistingCheckpoint refreshes the entire/checkpoints/v1 branch\n// before reading or writing when HEAD already references a checkpoint.\n// This mirrors `entire resume`'s metadata fetch fallback chain so attach\n// doesn't operate on a stale local orphan branch after a normal `git pull`.\n// Returns a freshly-opened repo handle so go-git sees any newly fetched\n// packfiles; on fetch failure, logs a warning and returns the original repo.\nfunc refreshForExistingCheckpoint(ctx, logCtx context.Context, repo *git.Repository, isExistingCheckpoint bool) *git.Repository {\n\tif !isExistingCheckpoint {\n\t\treturn repo\n\t}\n\t_, freshRepo, fetchErr := getMetadataTree(ctx)\n\tif fetchErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to refresh metadata branch before attach; proceeding with local state\",\n\t\t\tslog.String(\"error\", fetchErr.Error()))\n\t\treturn repo\n\t}\n\treturn freshRepo\n}\n\n// verifyCheckpointLocallyAvailable refuses the attach when HEAD references\n// an Entire-Checkpoint that is still missing from the local\n// entire/checkpoints/v1 branch after refresh. Without this guard, attach\n// would create a fresh checkpoint under the same ID and overwrite the\n// original session data on push.\nfunc verifyCheckpointLocallyAvailable(ctx context.Context, store *cpkg.GitStore, checkpointID id.CheckpointID, isExistingCheckpoint bool) error {\n\tif !isExistingCheckpoint {\n\t\treturn nil\n\t}\n\tsummary, readErr := store.ReadCommitted(ctx, checkpointID)\n\tif readErr != nil {\n\t\treturn fmt.Errorf(\"failed to read checkpoint %s: %w\", checkpointID, readErr)\n\t}\n\tif summary != nil {\n\t\treturn nil\n\t}\n\tconst fetchCmd = \"git fetch origin entire/checkpoints/v1:entire/checkpoints/v1\"\n\treturn fmt.Errorf(\n\t\t\"checkpoint %s referenced by HEAD is missing from the local entire/checkpoints/v1 branch (the remote fetch didn't bring it in either). Creating a fresh checkpoint here would overwrite the original session data on push. Run:\\n\\n    %s\\n\\nthen re-run attach. If the colleague who made this commit hasn't pushed their checkpoint metadata yet, ask them to do so first\",\n\t\tcheckpointID.String(), fetchCmd,\n\t)\n}\n\n// resolveCheckpointID returns the checkpoint ID to use for the attach.\n// If HEAD already has an Entire-Checkpoint trailer, reuses that ID (the session\n// gets added as an additional session in the existing checkpoint).\n// Otherwise generates a new ID.\nfunc resolveCheckpointID(headCommit *object.Commit) (id.CheckpointID, bool) {\n\texisting := trailers.ParseAllCheckpoints(headCommit.Message)\n\tif len(existing) > 0 {\n\t\treturn existing[len(existing)-1], true\n\t}\n\n\tcpID, err := id.Generate()\n\tif err != nil {\n\t\t// Generation only fails if crypto/rand fails — extremely unlikely.\n\t\t// Fall back to empty which will cause WriteCommitted to fail with a clear error.\n\t\treturn id.EmptyCheckpointID, false\n\t}\n\treturn cpID, false\n}\n\n// saveAttachSessionState creates or updates the session state file for the attached session.\n// If existingState is non-nil, it is updated in place (avoids a redundant disk load).\nfunc saveAttachSessionState(ctx context.Context, existingState *session.State, sessionID string, agentType types.AgentType, transcriptPath string, checkpointID id.CheckpointID, meta transcriptMetadata, tokenUsage *agent.TokenUsage) error {\n\tstateStore, err := session.NewStateStore(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to open session store: %w\", err)\n\t}\n\n\tnow := time.Now()\n\tstate := existingState\n\tif state == nil {\n\t\tstate = &session.State{\n\t\t\tSessionID: sessionID,\n\t\t\tStartedAt: now,\n\t\t}\n\t}\n\n\tstate.CLIVersion = versioninfo.Version\n\tstate.AttachedManually = true\n\tstate.AgentType = agentType\n\tstate.TranscriptPath = transcriptPath\n\tstate.LastCheckpointID = checkpointID\n\tstate.Phase = session.PhaseEnded\n\tstate.LastInteractionTime = &now\n\tif meta.TurnCount > 0 {\n\t\tstate.SessionTurnCount = meta.TurnCount\n\t}\n\tif meta.Model != \"\" {\n\t\tstate.ModelName = meta.Model\n\t}\n\tif meta.FirstPrompt != \"\" {\n\t\tstate.LastPrompt = meta.FirstPrompt\n\t}\n\tif tokenUsage != nil {\n\t\tstate.TokenUsage = tokenUsage\n\t}\n\n\tif err := stateStore.Save(ctx, state); err != nil {\n\t\treturn fmt.Errorf(\"failed to save session state: %w\", err)\n\t}\n\treturn nil\n}\n\n// validateAttachPreconditions checks session ID format and git repo state.\n// Returns the existing session state if the session is already tracked (nil if new).\nfunc validateAttachPreconditions(ctx context.Context, repo *git.Repository, sessionID string) (*session.State, error) {\n\tif err := validation.ValidateSessionID(sessionID); err != nil {\n\t\treturn nil, fmt.Errorf(\"invalid session ID: %w\", err)\n\t}\n\n\tif strategy.IsEmptyRepository(repo) {\n\t\treturn nil, errors.New(\"repository has no commits yet — make an initial commit before running attach\")\n\t}