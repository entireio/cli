erb = no-op\n    }\n}\n\nfunc (a *AntigravityAgent) parsePreInvocation(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n    var p PreInvocationPayload\n    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n\n    // First-ever invocation? Session state not yet created → emit SessionStart;\n    // framework's SessionStart handler runs strategy.InitializeSession.\n    eventType := agent.TurnStart\n    if _, err := strategy.LoadSessionState(ctx, p.ConversationID); errors.Is(err, strategy.ErrStateNotFound) {\n        eventType = agent.SessionStart\n    } else if err != nil {\n        return nil, err\n    }\n    return &agent.Event{\n        Type:       eventType,\n        SessionID:  p.ConversationID,\n        SessionRef: p.TranscriptPath,\n        Timestamp:  time.Now(),\n    }, nil\n}\n\nfunc (a *AntigravityAgent) parsePostInvocation(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n    var p PostInvocationPayload\n    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n    return &agent.Event{\n        Type: agent.TurnEnd, SessionID: p.ConversationID,\n        SessionRef: p.TranscriptPath, Timestamp: time.Now(),\n    }, nil\n}\n\nfunc (a *AntigravityAgent) parseStop(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n    var p StopPayload\n    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n    if !p.FullyIdle {\n        return nil, nil //nolint:nilnil // background tasks live; do not finalize\n    }\n    return &agent.Event{\n        Type: agent.SessionEnd, SessionID: p.ConversationID,\n        SessionRef: p.TranscriptPath, Timestamp: time.Now(),\n    }, nil\n}\n\nfunc (a *AntigravityAgent) parsePreToolUse(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n    var p PreToolUsePayload\n    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n    modified, newFiles := extractFilePaths(p.ToolCall)\n    if len(modified) == 0 && len(newFiles) == 0 {\n        return nil, nil //nolint:nilnil // non-mutating tool\n    }\n    return &agent.Event{\n        Type: agent.ToolUse, SessionID: p.ConversationID, SessionRef: p.TranscriptPath,\n        ModifiedFiles: modified, NewFiles: newFiles, Timestamp: time.Now(),\n    }, nil\n}\n\n// extractFilePaths inspects toolCall.Args for the three mutating tools.\n// Returns (modified, new) — `write_to_file` with Overwrite=false → newFiles; else modified.\nfunc extractFilePaths(tc ToolCall) (modified, newFiles []string) {\n    switch tc.Name {\n    case \"write_to_file\":\n        var a struct{ TargetFile string; Overwrite bool }\n        _ = json.Unmarshal(tc.Args, &a)\n        if a.TargetFile == \"\" { return }\n        if a.Overwrite { return []string{a.TargetFile}, nil }\n        return nil, []string{a.TargetFile}\n    case \"replace_file_content\", \"multi_replace_file_content\":\n        var a struct{ TargetFile string }\n        _ = json.Unmarshal(tc.Args, &a)\n        if a.TargetFile != \"\" { return []string{a.TargetFile}, nil }\n    }\n    return\n}\n\n// WriteHookResponse fulfills the HookSupport contract for emitting stdout JSON\n// back to Antigravity. For most hooks we emit nothing; for Stop we must always\n// emit a \"decision\" field (REQUIRED per /tmp/ag-hooks.md:379). When the framework\n// decides to allow the stop (no condense-in-flight, etc.), we emit `{\"decision\":\"stop\"}`.\nfunc (a *AntigravityAgent) WriteHookResponse(message string) error { /* same shape as geminicli's WriteHookResponse */ }\n```\n\n- [ ] **Step 4: Verify tests pass**\n\n```\ngo test ./cmd/entire/cli/agent/antigravity/ -v\n```\n\nExpected: PASS.\n\n### Task 7: Wire blank import + smoke-test\n\n**Files:**\n- Modify: `cmd/entire/cli/hooks_cmd.go`\n\n- [ ] **Step 1: Add blank import alphabetically**\n\nIn `cmd/entire/cli/hooks_cmd.go`, alphabetical order puts `antigravity` before `claudecode`:\n\n```go\n_ \"github.com/entireio/cli/cmd/entire/cli/agent/antigra