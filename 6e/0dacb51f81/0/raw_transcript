ommonPayload\n    InvocationNum   int `json:\"invocationNum\"`\n    InitialNumSteps int `json:\"initialNumSteps\"`\n}\n\n// PostInvocation has identical fields per the doc.\ntype PostInvocationPayload = PreInvocationPayload\n\ntype StopPayload struct {\n    CommonPayload\n    ExecutionNum      int    `json:\"executionNum\"`\n    TerminationReason string `json:\"terminationReason\"`\n    Error             string `json:\"error,omitempty\"`\n    FullyIdle         bool   `json:\"fullyIdle\"`\n}\n\n// === stdout payloads ===\n\ntype PreToolUseDecision string\n\nconst (\n    DecisionAllow    PreToolUseDecision = \"allow\"\n    DecisionDeny     PreToolUseDecision = \"deny\"\n    DecisionAsk      PreToolUseDecision = \"ask\"\n    DecisionForceAsk PreToolUseDecision = \"force_ask\"\n)\n\ntype PreToolUseOutput struct {\n    Decision            PreToolUseDecision `json:\"decision\"`\n    Reason              string             `json:\"reason,omitempty\"`\n    PermissionOverrides []string           `json:\"permissionOverrides,omitempty\"`\n}\n\ntype InjectStep struct {\n    ToolCall         *ToolCall `json:\"toolCall,omitempty\"`\n    UserMessage      string    `json:\"userMessage,omitempty\"`\n    EphemeralMessage string    `json:\"ephemeralMessage,omitempty\"`\n}\n\ntype PreInvocationOutput struct {\n    InjectSteps []InjectStep `json:\"injectSteps,omitempty\"`\n}\n\ntype PostInvocationOutput struct {\n    InjectSteps         []InjectStep `json:\"injectSteps,omitempty\"`\n    TerminationBehavior string       `json:\"terminationBehavior,omitempty\"`\n}\n\n// StopOutput: per docs, `decision` is REQUIRED. \"continue\" prevents stop;\n// any other value (we emit \"stop\") allows the stop.\ntype StopOutput struct {\n    Decision string `json:\"decision\"`\n    Reason   string `json:\"reason,omitempty\"`\n}\n```\n\n- [ ] **Step 5: Verify tests pass**\n\n```\ngo test ./cmd/entire/cli/agent/antigravity/ -v\n```\n\nExpected: PASS (5 fixture-parse tests + 3 agent tests).\n\n### Task 4: 