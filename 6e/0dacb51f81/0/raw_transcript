9\tfunc (a *AntigravityAgent) parsePreInvocation(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n730\t    var p PreInvocationPayload\n731\t    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n732\t    // Always emit TurnStart. The framework's TurnStart handler\n733\t    // (cli/lifecycle.go:406) calls strategy.InitializeSession, which is\n734\t    // idempotent — first arrival creates state, subsequent arrivals reuse it.\n735\t    return &agent.Event{\n736\t        Type:       agent.TurnStart,\n737\t        SessionID:  p.ConversationID,\n738\t        SessionRef: p.TranscriptPath,\n739\t        Timestamp:  time.Now(),\n740\t    }, nil\n741\t}\n742\t\n743\tfunc (a *AntigravityAgent) parsePostInvocation(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n744\t    var p PostInvocationPayload\n745\t    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n746\t    return &agent.Event{\n747\t        Type: agent.TurnEnd, SessionID: p.ConversationID,\n748\t        SessionRef: p.TranscriptPath, Timestamp: time.Now(),\n749\t    }, nil\n750\t}\n751\t\n752\tfunc (a *AntigravityAgent) parseStop(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n753\t    var p StopPayload\n754\t    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n755\t    if !p.FullyIdle {\n756\t        return nil, nil //nolint:nilnil // background tasks live; do not finalize\n757\t    }\n758\t    return &agent.Event{\n759\t        Type: agent.SessionEnd, SessionID: p.ConversationID,\n760\t        SessionRef: p.TranscriptPath, Timestamp: time.Now(),\n761\t    }, nil\n762\t}\n763\t\n764\tfunc (a *AntigravityAgent) parsePreToolUse(ctx context.Context, stdin io.Reader) (*agent.Event, error) {\n765\t    var p PreToolUsePayload\n766\t    if err := json.NewDecoder(stdin).Decode(&p); err != nil { return nil, err }\n767\t    modified, newFiles := extractFilePaths(p.ToolCall)\n768\t    if len(modified) == 0 && len(newFiles) == 0 {\n769\t        return nil, nil //nolint:nilnil // non-mutating tool\n770\t    }\n771\t    return &agent.Event{\n772\t        Type: agent.ToolUse, SessionID: p.ConversationID, SessionRef: p.TranscriptPath,\n773\t        ModifiedFiles: modified, NewFiles: newFiles, Timestamp: time.Now(),\n774\t    }, nil\n775\t}\n776\t\n777\t// extractFilePaths inspects toolCall.Args for the three mutating tools.\n778\t// Returns (modified, new) — `write_to_file` with Overwrite=false → newFiles; else modified.\n779\tfunc extractFilePaths(tc ToolCall) (modified, newFiles []string) {\n780\t    switch tc.Name {\n781\t    case \"write_to_file\":\n782\t        var a struct{ TargetFile string; Overwrite bool }\n783\t        _ = json.Unmarshal(tc.Args, &a)\n784\t        if a.TargetFile == \"\" { return }\n785\t        if a.Overwrite { return []string{a.TargetFile}, nil }\n786\t        return nil, []string{a.TargetFile}\n787\t    case \"replace_file_content\", \"multi_replace_file_content\":\n788\t        var a struct{ TargetFile string }\n789\t        _ = json.Unmarshal(tc.Args, &a)\n790\t        if a.TargetFile != \"\" { return []string{a.TargetFile}, nil }\n791\t    }\n792\t    return\n793\t}\n794\t\n795\t// WriteHookResponse writes a JSON message to stdout for Antigravity to consume.\n796\t// Mirrors geminicli's implementation. Callers must supply a JSON-shaped string.\n797\t//\n798\t// For hook events with no stdout response (PreToolUse `allow`-by-default, all\n799\t// other non-Stop events), the framework passes an empty message which we skip.\n800\t// For Stop: the framework should always pass `{\"decision\":\"stop\"}` (REQUIRED\n801\t// per /tmp/ag-hooks.md:379); v1 never returns `{\"decision\":\"continue\"}` because\n802\t// nothing in the lifecycle handlers can decide to override Antigravity's stop.\n803\t// PreToolUse: v1 emits `{\"decision\":\"allow\"}` (the framework's default path).\n804\tfunc (a *AntigravityAgent) WriteHookResponse(message string) error {\n805\t    if message == \"\" { return nil }\n806\t    if _, err := fmt.Fprintln(os.Stdout, message); err != nil {\n807\t        return fmt.Errorf(\"failed to write hook response: %w\", err)\n808\t    }\n809\t    return nil\n810\t}\n811\t```\n812\t\n813\t- [ ] **Step 4: Verify tests pass**\n814\t\n815\t```\n816\tgo test ./cmd/entire/cli/agent/antigravity/ -v\n817\t```\n818\t\n819\tExpected: PASS.\n820\t\n821\t### Task 7: Wire blank import + smoke-test\n822\t\n823\t**Files:**\n824\t- Modify: `cmd/entire/cli/hooks_cmd.go`\n825\t\n826\t- [ ] **Step 1: Add blank import alphabetically**\n827\t\n828\tIn `cmd/entire/cli/hooks_cmd.go`, alphabetical order puts `antigravity` before `claudecode`:\n829\t\n830\t```go\n831\t_ \"github.com/entireio/cli/cmd/entire/cli/agent/antigravity\"\n832\t_ \"github.com/entireio/cli/cmd/entire/cli/agent/claudecode\"\n833\t```\n834\t\n835\t- [ ] **Step 2: Smoke-test the subcommand surface exists**\n836\t\n837\tThe framework auto-generates `entire hooks <agent> <verb>` subcommands from each agent's `HookNames()`. Verify:\n838\t\n839\t```fish\n840\tgo run ./cmd/entire hooks antigravity --help\n841\t```\n842\t\n843\tExpected: lists 5 subcommands: pre-tool-use, post-tool-use, pre-invocation, post-invocation, stop.\n844\t\n845\t- [ ] **Step 3: Smoke-test one event end-to-end**\n846\t\n847\t```fish\n848\tcat cmd/entire/cli/agent/antigravity/testdata/hook_stdin_preinvocation.json | go run ./cmd/entire hooks antigravity pre-invocation\n849\t```\n850\t\n851\tExpected: exit 0. (Stdout content depends on framework; verify no panic and no JSON parse error.)\n852\t\n853\t### Task 8: Commit chunk 2\n854\t\n855\t- [ ] **Step 1: Full check**\n856\t\n857\t```\n858\tmise run fmt && mise run lint && mise run test\n859\t```\n860\t\n861\tExpected: clean.\n862\t\n863\t- [ ] **Step 2: Commit**\n864\t\n865\t```fish\n866\tgit add cmd/entire/cli/agent/antigravity/hooks.go cmd/entire/cli/agent/antigravity/hooks_test.go cmd/entire/cli/agent/antigravity/lifecycle.go cmd/e