andler will call `strategy.InitializeSession` for us; we do not call it directly from `ParseHookEvent`.\n\nHook constants:\n\n```go\nconst (\n    HookNamePreToolUse     = \"pre-tool-use\"\n    HookNamePostToolUse    = \"post-tool-use\"\n    HookNamePreInvocation  = \"pre-invocation\"\n    HookNamePostInvocation = \"post-invocation\"\n    HookNameStop           = \"stop\"\n)\n```\n\n- [ ] **Step 1: Write failing tests**\n\n```go\n// lifecycle_test.go\npackage antigravity\n\nimport (\n    \"bytes\"\n    \"context\"\n    \"os\"\n    \"path/filepath\"\n    \"strings\"\n    \"testing\"\n\n    \"github.com/entireio/cli/cmd/entire/cli/agent\"\n    \"github.com/entireio/cli/cmd/entire/cli/testutil\"\n)\n\nfunc TestHookNames(t *testing.T) {\n    t.Parallel()\n    a := &AntigravityAgent{}\n    names := a.HookNames()\n    want := []string{\"pre-tool-use\", \"post-tool-use\", \"pre-invocation\", \"post-invocation\", \"stop\"}\n    if len(names) != len(want) { t.Fatalf(\"got %d, want %d\", len(names), len(want)) }\n    // ... iterate to compare\n}\n\nfunc TestParseHookEvent_PreInvocation_FirstEverEmitsSessionStart(t *testing.T) {\n    t.Parallel()\n    tmpDir := t.TempDir()\n    testutil.InitRepo(t, tmpDir)\n    t.Chdir(tmpDir)\n\n    data, _ := os.ReadFile(filepath.Join(\"testdata\", \"hook_stdin_preinvocation.json\"))\n    a := &AntigravityAgent{}\n    ev, err := a.ParseHookEvent(context.Background(), HookNamePreInvocation, bytes.NewReader(data))\n    if err != nil { t.Fatal(err) }\n    if ev == nil || ev.Type != agent.SessionStart {\n        t.Errorf(\"got %v, want SessionStart\", ev)\n    }\n    if ev.SessionID != \"ec33ebf9-0cba-4100-8142-c61503f6c587\" {\n        t.Errorf(\"SessionID = %q\", ev.SessionID)\n    }\n    if ev.SessionRef == \"\" || !strings.HasSuffix(ev.SessionRef, \"transcript.jsonl\") {\n        t.Errorf(\"SessionRef = %q (want transcriptPath)\", ev.SessionRef)\n    }\n}\n\nfunc TestParseHookEvent_PreInvocation_SecondTimeEmitsTurnStart(t *testing.T) {\n    t