os/exec\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/mattn/go-isatty\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/review\"\n\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n)\n\nconst probeFlag = \"--probe\"\n\nfunc main() {\n\t// Self-spawn pattern: re-exec the same binary with --probe to act as\n\t// the fake \"buffering agent\". Lets the whole smoke test live in one\n\t// file the user can run with `go run ./e2e/streaming-smoke`.\n\tif len(os.Args) > 1 && os.Args[1] == probeFlag {\n\t\trunProbe(os.Args[2:])\n\t\treturn\n\t}\n\n\tuseTUI := flag.Bool(\"tui\", false, \"boot the real review TUI with UsePTY=true (the fix)\")\n\tuseTUIBuggy := flag.Bool(\"tui-buggy\", false, \"boot the real review TUI with UsePTY=false (the bug)\")\n\tflag.Parse()\n\n\tvar err error\n\tswitch {\n\tcase *useTUI:\n\t\terr = runTUI(true)\n\tcase *useTUIBuggy:\n\t\terr = runTUI(false)\n\tdefault:\n\t\terr = runTimeline()\n\t}\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, \"streaming-smoke:\", err)\n\t\tos.Exit(1)\n\t}\n}\n\n// runProbe is the fake-agent side. When stdout is a pipe (not a TTY)\n// it wraps stdout in a bufio.Writer with a libc-typical 64KB buffer so\n// per-line writes accumulate until exit — the same pattern that causes\n// real agents to \"burst at the end\". When stdout IS a TTY it writes\n// directly so the natural per-line flushing happens.\n//\n// Args (parsed from the probe sub-command's argv):\n//\n//\t--lines N    how many lines to emit (default 5)\n//\t--delay D    sleep between lines (default 150ms)\n//\t--label S    prefix for each line so two probes are distinguishable\nfunc runProbe(args []string) {\n\tfs := flag.NewFlagSet(\"probe\", flag.ExitOnError)\n\tlines := fs.Int(\"lines\", 5, \"number of lines\")\n\tdelay := fs.Duration(\"delay\", 150*time.Millisecond, \"sleep between lines\")\n\tlabel := fs.String(\"label\", \"probe\", \"per-line label\")\n\t_ = fs.Parse(args)\n\n\tif isatty.IsTerminal(os.Stdout.Fd()) {\n\t\tfor i := 1; i <= *lines; i++ {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s line %d/%d\\n\", *label, i, *lines)\n\t\t\ttime.Sleep(*delay)\n\t\t}\n\t\treturn\n\t}\n\n\t// Pipe path: simulate libc/Rust/Node block buffering. All lines stay\n\t// in the buffer until Flush() at exit — even though the loop sleeps\n\t// between writes, the runner sees them as one burst.\n\tw := bufio.NewWriterSize(os.Stdout, 64*1024)\n\tfor i := 1; i <= *lines; i++ {\n\t\tfmt.Fprintf(w, \"%s line %d/%d\\n\", *label, i, *lines)\n\t\ttime.Sleep(*delay)\n\t}\n\t_ = w.Flush()\n}\n\n// runTimeline spawns the probe twice — once without PTY (bug), once with\n// PTY (fix) — and prints per-event timing for each pass.\nfunc runTimeline() error {\n\tself, err := os.Executable()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"locate self: %w\", err)\n\t}\n\n\tfmt.Println(\"streaming-smoke: spawning probe twice to compare buffering behaviour.\")\n\tfmt.Println(\"look for events clustered at end (Pass 1) vs staggered (Pass 2).\")\n\tfmt.Println()\n\n\tif err := timelinePass(\"Pass 1: UsePTY=false (simulates the bug)\", self, false); err != nil {\n\t\treturn err\n\t}\n\tfmt.Println()\n\tif err := timelinePass(\"Pass 2: UsePTY=true (the fix)\", self, true); err != nil {\n\t\treturn err\n\t}\n\tfmt.Println()\n\tfmt.Println(\"for an interactive demo: `go run ./e2e/streaming-smoke --tui`\")\n\treturn nil\n}\n\nfunc timelinePass(label, selfPath string, usePTY bool) error {\n\ttmpl := buildProbeReviewer(\"smoke-probe\", selfPath, []string{\"--lines\", \"5\"}, usePTY)\n\tstarted := time.Now()\n\tproc, err := tmpl.Start(context.Background(), reviewtypes.RunConfig{})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"%s: start: %w\", label, err)\n\t}\n\n\tfmt.Printf(\"=== %s ===\\n\", label)\n\tfor ev := range proc.Events() {\n\t\tprintEvent(time.Since(started), ev)\n\t}\n\tif err := proc.Wait(); err != nil {\n\t\treturn fmt.Errorf(\"%s: wait: %w\", label, err)\n\t}\n\treturn nil\n}\n\n// runTUI boots the real review Bubble Tea dashboard with two fake probes\n// so the user can press Ctrl+O during the run and see drill-in streaming\n// (when usePTY=true) or batched-at-EOF behaviour (when usePTY=false).\nfunc runTUI(usePTY bool) error {\n\tself, err := os.Executable()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"locate self: %w\", err)\n\t}\n\tif !isatty.IsTerminal(os.Stdout.Fd()) {\n\t\treturn errors.New(\"--tui requires a real terminal; rerun without --tui for a non-interactive demo\")\n\t}\n\n\t// Two probes with different cadence so the dashboard rows visibly\n\t// diverge. ~12s total — long enough to comfortably hit Ctrl+O,\n\t// switch agents, and watch the buffer grow before the run ends.\n\treviewers := []reviewtypes.AgentReviewer{\n\t\tbuildProbeReviewer(\"fast-probe\", self, []string{\"--lines\", \"20\", \"--delay\", \"300ms\", \"--label\", \"fast\"}, usePTY),\n\t\tbuildProbeReviewer(\"slow-probe\", self, []string{\"--lines\", \"12\", \"--delay\", \"1s\", \"--label\", \"slow\"}, usePTY),\n\t}\n\n\tmode := \"UsePTY=true (the fix)\"\n\tif !usePTY {\n\t\tmode = \"UsePTY=false (the bug)\"\n\t}\n\tfmt.Printf(\"streaming-smoke TUI demo (%s)\\n\", mode)\n\tfmt.Println(\"press Ctrl+O during the run to drill into an agent's event buffer.\")\n\tfmt.Println(\"press Ctrl+C to cancel. press any key to dismiss after both finish.\")\n\tfmt.Println()\n\ttime.Sleep(800 * time.Millisecond) // let the user read before the TUI takes over\n\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\n\tagentNames := []string{reviewers[0].Name(), reviewers[1].Name()}\n\ttui := review.NewTUISink(agentNames, cancel, os.Stdout, os.Stdin)\n\ttui.Start()\n\n\tsinks := []reviewtypes.Sink{tui}\n\tif _, err := review.RunMulti(ctx, reviewers, reviewtypes.RunConfig{}, sinks); err != nil {\n\t\t// Non-fatal: a probe exit error shouldn't drown the demo's main point.\n\t\tfmt.Fprintln(os.Stderr, \"streaming-smoke: RunMulti returned:\", err)\n\t}\n\treturn nil\n}\n\nfunc buildProbeReviewer(name, selfPath string, probeArgs []string, usePTY bool) *reviewtypes.ReviewerTemplate {\n\treturn &reviewtypes.ReviewerTemplate{\n\t\tAgentName: name,\n\t\tBuildCmd: func(ctx context.Context, _ reviewtypes.RunConfig) *exec.Cmd {\n\t\t\targs := append([]string{probeFlag}, probeArgs...)\n\t\t\treturn exec.CommandContext(ctx, selfPath, args...)\n\t\t},\n\t\tParser: lineParser,\n\t\tUsePTY: usePTY,\n\t}\n}\n\nfunc printEvent(elapsed time.Duration, ev reviewtypes.Event) {\n\tprefix := fmt.Sprintf(\"  + %4dms  \", elapsed.Milliseconds())\n\tswitch e := ev.(type) {\n\tcase reviewtypes.AssistantText:\n\t\tfmt.Printf(\"%sAssistantText  %q\\n\", prefix, e.Text)\n\tcase reviewtypes.Started:\n\t\tfmt.Printf(\"%sStarted{}\\n\", prefix)\n\tcase reviewtypes.Finished:\n\t\tfmt.Printf(\"%sFinished{Success:%v}\\n\", prefix, e.Success)\n\tdefault:\n\t\tfmt.Printf(\"%s%T\\n\", prefix, ev)\n\t}\n}\n\nfunc lineParser(r io.Reader) <-chan reviewtypes.Event {\n\tch := make(chan reviewtypes.Event, 16)\n\tgo func() {\n\t\tdefer close(ch)\n\t\tch <- reviewtypes.Started{}\n\t\ts := bufio.NewScanner(r)\n\t\tfor s.Scan() {\n\t\t\tline := strings.TrimRight(s.Text(), \"\\r\")\n\t\t\tif line == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tch <- reviewtypes.AssistantText{Text: line}\n\t\t}\n\t\tif err := s.Err(); err != nil {\n\t\t\tch <- reviewtypes.RunError{Err: err}\n\t\t\tch <- reviewtypes.Finished{Success: false}\n\t\t\treturn\n\t\t}\n\t\tch <- reviewtypes.Finished{Success: true}\n\t}()\n\treturn ch\n}","is_error":false}]},"uuid":"f0da6051-c787-40bd-a238-1fd1b3057776","timestamp":"2026-05-12T02:51:46.280Z","toolUseResult":{"stdout":"// streaming-smoke is a self-contained verifier for the per-agent live\n// streaming fix in `entire review`. It does NOT call any agent API.\n//\n// # What it proves\n//\n// The fix routes each agent's stdout through a pseudo-terminal so the\n// child's isatty(stdout) returns true and its runtime (libc / Rust / Node)\n// reverts to line-buffered flushing instead of block-buffering until exit.\n// 