tlangs = append(langs, l)\n\t}\n\tsort.Strings(langs)\n\n\treturn &ScanResult{\n\t\tSlice:       slice,\n\t\tLanguages:   langs,\n\t\tFileCount:   files,\n\t\tSymbolCount: symbols,\n\t}, nil\n}\n\n// hasDotComponent reports whether any path component begins with a dot.\n// Forward-slash assumed (rel paths are normalized before this is called).\nfunc hasDotComponent(rel string) bool {\n\tfor _, p := range strings.Split(rel, \"/\") {\n\t\tif p == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(p, \".\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","structuredPatch":[{"oldStart":227,"oldLines":7,"newStart":227,"newLines":7,"lines":[" // hasDotComponent reports whether any path component begins with a dot."," // Forward-slash assumed (rel paths are normalized before this is called)."," func hasDotComponent(rel string) bool {","-  for _, p := range strings.Split(rel, \"/\") {","+  for p := range strings.SplitSeq(rel, \"/\") {","     if p == \"\" {","       continue","     }"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"2b81d41b-28eb-4752-86bb-80e9fa911664","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude"}
