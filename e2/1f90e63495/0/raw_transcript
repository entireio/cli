\n\tdir := t.TempDir()\n\twriteFile(t, dir, \"ok.go\", \"package main\\nfunc main() {}\\n\")\n\twriteFile(t, dir, \"broken.go\", \"package main\\n}}}}\\nfunc but-wait!\\n\")\n\n\tres, err := Scan(context.Background(), dir)\n\tif err != nil {\n\t\tt.Fatalf(\"Scan: %v\", err)\n\t}\n\t// Both files appear as nodes.\n\tgotPaths := filePaths(res.Slice)\n\tif !slices.Equal(gotPaths, []string{\"broken.go\", \"ok.go\"}) {\n\t\tt.Errorf(\"file paths = %v; want sorted\", gotPaths)\n\t}\n\t// At least the `main` symbol from ok.go survived.\n\tmainSeen := false\n\tfor _, n := range res.Slice.Nodes {\n\t\tif n.Type == graph.NodeSymbol && n.Name == \"main\" && n.Path == \"ok.go\" {\n\t\t\tmainSeen = true\n\t\t}\n\t}\n\tif !mainSeen {\n\t\tt.Errorf(\"expected `main` symbol from ok.go\")\n\t}\n}\n\nfunc TestScan_DirectoryNodesAndContainsEdges(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteFile(t, dir, \"a/b/c.go\", \"package c\\nfunc Hello() {}\\n\")\n\n\tres, err := Scan(context.Background(), dir)\n\tif err != nil {\n\t\tt.Fatalf(\"Scan: %v\", err)\n\t}\n\n\twantDirIDs := []string{\"dir:a\", \"dir:a/b\"}\n\tfor _, want := range wantDirIDs {\n\t\tif !hasNodeID(res.Slice, want) {\n\t\t\tt.Errorf(\"missing dir node %q\", want)\n\t\t}\n\t}\n\n\t// repo:. → dir:a, dir:a → dir:a/b, dir:a/b → file:a/b/c.go, file → sym\n\twantEdges := []struct{ from, to string }{\n\t\t{\"repo:.\", \"dir:a\"},\n\t\t{\"dir:a\", \"dir:a/b\"},\n\t\t{\"dir:a/b\", \"file:a/b/c.go\"},\n\t\t{\"file:a/b/c.go\", \"sym:a/b/c.go:Hello\"},\n\t}\n\tfor _, want := range wantEdges {\n\t\tif !hasContainsEdge(res.Slice, want.from, want.to) {\n\t\t\tt.Errorf(\"missing contains edge %s -> %s\", want.from, want.to)\n\t\t}\n\t}\n}\n\nfunc writeFile(t *testing.T, dir, rel, content string) {\n\tt.Helper()\n\tfull := filepath.Join(dir, filepath.FromSlash(rel))\n\tif err := os.MkdirAll(filepath.Dir(full), 0o750); err != nil {\n\t\tt.Fatalf(\"MkdirAll: %v\", err)\n\t}\n\tif err := os.WriteFile(full, []byte(content)