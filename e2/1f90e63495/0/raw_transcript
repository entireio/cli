rn s.writeJSON(historyFile, sliceOrEmpty(slice))\n}\n\n// ReadHistory loads the history slice. Missing file → empty slice.\nfunc (s *Store) ReadHistory() (*GraphSlice, error) {\n\treturn s.readSlice(historyFile)\n}\n\n// WriteSemantic persists the agent-assisted semantic slice.\nfunc (s *Store) WriteSemantic(slice *GraphSlice) error {\n\treturn s.writeJSON(semanticFile, sliceOrEmpty(slice))\n}\n\n// ReadSemantic loads the semantic slice. Missing file → empty slice.\nfunc (s *Store) ReadSemantic() (*GraphSlice, error) {\n\treturn s.readSlice(semanticFile)\n}\n\n// TimelineEvent is one step in the time-ordered replay.\ntype TimelineEvent struct {\n\tAt           string         `json:\"at\"` // RFC3339\n\tCheckpointID string         `json:\"checkpoint_id,omitempty\"`\n\tSessionID    string         `json:\"session_id,omitempty\"`\n\tKind         string         `json:\"kind\"` // \"introduced\"|\"modified\"|\"removed\"|\"checkpoint\"\n\tNodeIDs      []string       `json:\"node_ids,omitempty\"`\n\tAttrs        map[string]any `json:\"attrs,omitempty\"`\n}\n\n// Timeline is the persisted event stream for replay/time-slider.\ntype Timeline struct {\n\tEvents []TimelineEvent `json:\"events\"`\n}\n\n// WriteTimeline persists the timeline events.\nfunc (s *Store) WriteTimeline(t *Timeline) error {\n\tif t == nil {\n\t\tt = &Timeline{}\n\t}\n\tif t.Events == nil {\n\t\tt.Events = []TimelineEvent{}\n\t}\n\treturn s.writeJSON(timelineFile, t)\n}\n\n// ReadTimeline loads the timeline. Missing file → empty timeline.\nfunc (s *Store) ReadTimeline() (*Timeline, error) {\n\tvar t Timeline\n\tif err := s.readJSON(timelineFile, &t); err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn &Timeline{Events: []TimelineEvent{}}, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\tif t.Events == nil {\n\t\tt.Events = []TimelineEvent{}\n\t}\n\treturn &t, nil\n}\n\n// FusedGraph returns the union of structural, history, and semantic slices.\n// Duplicate node IDs are de-duplicated keeping the first occurrence (structural\n// wins over history wins over semantic) so deterministic data takes precedence.\nfunc (s *Store) FusedGraph() (*GraphSlice, error) {\n\tstructural, err := s.ReadStructural()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read structural: %w\", err)\n\t}\n\thistory, err := s.ReadHistory()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read history: %w\", err)\n\t}\n\tsemantic, err := s.ReadSemantic()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read semantic: %w\", err)\n\t}\n\n\tout := &GraphSlice{}\n\tseenNodes := make(map[string]struct{})\n\tseenEdges := make(map[string]struct{})\n\n\tfor _, slice := range []*GraphSlice{structural, history, semantic} {\n\t\tfor _, n := range slice.Nodes {\n\t\t\tif _, dup := seenNodes[n.ID]; dup {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseenNodes[n.ID] = struct{}{}\n\t\t\tout.Nodes = append(out.Nodes, n)\n\t\t}\n\t\tfor _, e := range slice.Edges {\n\t\t\tif _, dup := seenEdges[e.ID]; dup {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tseenEdges[e.ID] = struct{}{}\n\t\t\tout.Edges = append(out.Edges, e)\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// readSlice loads a graph slice file; missing file returns an empty slice.\nfunc (s *Store) readSlice(name string) (*GraphSlice, error) {\n\tvar slice GraphSlice\n\tif err := s.readJSON(name, &slice); err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn &GraphSlice{}, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\treturn &slice, nil\n}\n\nfunc (s *Store) writeJSON(name string, v any) error {\n\tif err := os.MkdirAll(s.root, 0o750); err != nil {\n\t\treturn fmt.Errorf(\"create understand cache: %w\", err)\n\t}\n\tdata, err := jsonutil.MarshalIndentWithNewline(v, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"marshal %s: %w\", name, err)\n\t}\n\ttarget := filepath.Join(s.root, name)\n\ttmp := target + \".tmp\"\n\tif err := os.WriteFile(tmp, data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"write %s: %w\", name, err)\n\t}\n\tif err := os.Rename(tmp, target); err != nil {\n\t\treturn fmt.Errorf(\"rename %s: %w\", name, err)\n\t}\n\treturn nil\n}\n\nfunc (s *Store) readJSON(name string, v any) error {\n\tdata, err := os.ReadFile(filepath.Join(s.root, name))\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := unmarshalStrict(data, v); err != nil {\n\t\treturn fmt.Errorf(\"decode %s: %w\", name, err)\n\t}\n\treturn nil\n}\n\nfunc sliceOrEmpty(s *GraphSlice) *GraphSlice {\n\tif s == nil {\n\t\treturn &GraphSlice{Nodes: []Node{}, Edges: []Edge{}}\n\t}\n\tif s.Nodes == nil {\n\t\ts.Nodes = []Node{}\n\t}\n\tif s.Edges == nil {\n\t\ts.Edges = []Edge{}\n\t}\n\treturn s\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"ad845ce6-f2e7-4fe7-a6c8-c1bf91677ed9","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude"}
