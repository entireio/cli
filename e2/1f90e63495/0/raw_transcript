ache directory.\nfunc (s *Store) Root() string { return s.root }\n\n// Exists reports whether the cache directory and a manifest exist.\n// A bare empty directory does not count.\nfunc (s *Store) Exists() bool {\n\t_, err := os.Stat(filepath.Join(s.root, manifestFile))\n\treturn err == nil\n}\n\n// Reset removes the entire cache directory. Returns nil if it doesn't exist.\nfunc (s *Store) Reset() error {\n\tif err := os.RemoveAll(s.root); err != nil {\n\t\treturn fmt.Errorf(\"reset understand cache: %w\", err)\n\t}\n\treturn nil\n}\n\n// WriteManifest persists the build manifest atomically.\nfunc (s *Store) WriteManifest(m *Manifest) error {\n\tif m == nil {\n\t\treturn errors.New(\"nil manifest\")\n\t}\n\tif m.SchemaVersion == 0 {\n\t\tm.SchemaVersion = SchemaVersion\n\t}\n\treturn s.writeJSON(manifestFile, m)\n}\n\n// ReadManifest loads the build manifest.\nfunc (s *Store) ReadManifest() (*Manifest, error) {\n\tvar m Manifest\n\tif err := s.readJSON(manifestFile, &m); err != nil {\n\t\treturn nil, err\n\t}\n\tif m.SchemaVersion > SchemaVersion {\n\t\treturn nil, fmt.Errorf(\"understand cache schema_version=%d is newer than supported (%d); rebuild required\", m.SchemaVersion, SchemaVersion)\n\t}\n\treturn &m, nil\n}\n\n// Slice is a minimal serializable form for the structural / history /\n// semantic / timeline files. Each layer writes its own slice; readers fuse\n// them at query time.\ntype Slice struct {\n\tNodes []Node `json:\"nodes\"`\n\tEdges []Edge `json:\"edges\"`\n}\n\n// WriteStructural persists the deterministic structural slice.\nfunc (s *Store) WriteStructural(slice *Slice) error {\n\treturn s.writeJSON(structuralFile, sliceOrEmpty(slice))\n}\n\n// ReadStructural loads the structural slice. Returns an empty slice when the\n// file is missing — callers can treat absence as \"build hasn't run yet\".\nfunc (s *Store) ReadStructural() (*Slice, error) {\n\treturn s.readSlice(structuralFile)\n}\n\n// WriteHistory persists the history fusion slice.\nfunc (s 