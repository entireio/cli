ontains,\n\t\t\t})\n\t\t\tdirNodes[rel] = id\n\t\t\treturn nil\n\t\t}\n\n\t\t// Skip files that begin with `.` at any path component.\n\t\t// Keeps `.gitignore` itself out of the index along with editor turds.\n\t\tif hasDotComponent(rel) {\n\t\t\treturn nil\n\t\t}\n\n\t\text := strings.ToLower(filepath.Ext(rel))\n\t\tlang := languageByExt[ext]\n\t\tif lang != \"\" {\n\t\t\tlanguages[lang] = struct{}{}\n\t\t}\n\n\t\tfileID := \"file:\" + rel\n\t\tparentRel := filepath.ToSlash(filepath.Dir(rel))\n\t\tparentID, ok := dirNodes[parentRel]\n\t\tif !ok {\n\t\t\tparentID = repoNodeID\n\t\t}\n\n\t\tfileNode := graph.Node{\n\t\t\tID:       fileID,\n\t\t\tType:     graph.NodeFile,\n\t\t\tName:     filepath.Base(rel),\n\t\t\tPath:     rel,\n\t\t\tLanguage: lang,\n\t\t}\n\t\t// Stat for size only; LineStart/End are reserved for symbol nodes.\n\t\tif info, errInfo := d.Info(); errInfo == nil {\n\t\t\tfileNode.Attrs = map[string]any{\"size_bytes\": info.Size()}\n\t\t}\n\t\tslice.Nodes = append(slice.Nodes, fileNode)\n\t\tslice.Edges = append(slice.Edges, graph.Edge{\n\t\t\tID:   \"e:contains:\" + parentID + \"->\" + fileID,\n\t\t\tFrom: parentID,\n\t\t\tTo:   fileID,\n\t\t\tType: graph.EdgeContains,\n\t\t})\n\t\tfiles++\n\n\t\tif lang == \"go\" {\n\t\t\tadded, errParse := extractGoSymbols(slice, rel, fileID, path)\n\t\t\tif errParse == nil {\n\t\t\t\tsymbols += added\n\t\t\t}\n\t\t\t// Parse errors are intentionally swallowed: a malformed Go file\n\t\t\t// should not prevent the rest of the structural index from\n\t\t\t// landing. Symbol coverage for that file is simply absent.\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"scan: walk: %w\", err)\n\t}\n\n\tlangs := make([]string, 0, len(languages))\n\tfor l := range languages {\n\t\tlangs = append(langs, l)\n\t}\n\tsort.Strings(langs)\n\n\treturn &ScanResult{\n\t\tSlice:       slice,\n\t\tLanguages:   langs,\n\t\tFileCount:   files,\n\t\tSymbolCount: symbols,\n\t}, nil\n}\n\n// hasDotComponent repor