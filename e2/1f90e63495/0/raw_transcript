ded += emitGenDecl(slice, relPath, fileID, fset, d)\n\t\t}\n\t}\n\treturn added, nil\n}\n\n// emitFunc handles top-level function and method declarations.\nfunc emitFunc(slice *graph.Slice, relPath, fileID string, fset *token.FileSet, fn *ast.FuncDecl) int {\n\tif fn.Name == nil || !fn.Name.IsExported() && !alwaysIndex(fn.Name.Name) {\n\t\t// Index unexported names too — they show up in tour/explain — but use\n\t\t// the exported guard to skip empty names defensively.\n\t\tif fn.Name == nil {\n\t\t\treturn 0\n\t\t}\n\t}\n\n\tkind := graph.SymbolFunction\n\tidSuffix := fn.Name.Name\n\tif fn.Recv != nil && len(fn.Recv.List) > 0 {\n\t\tkind = graph.SymbolMethod\n\t\trecvType := receiverTypeName(fn.Recv.List[0].Type)\n\t\tif recvType != \"\" {\n\t\t\tidSuffix = recvType + \".\" + fn.Name.Name\n\t\t}\n\t}\n\tif isTestFunc(fn.Name.Name) {\n\t\tkind = graph.SymbolTest\n\t}\n\n\tstartPos := fset.Position(fn.Pos())\n\tendPos := fset.Position(fn.End())\n\n\tid := \"sym:\" + relPath + \":\" + idSuffix\n\tnode := graph.Node{\n\t\tID:         id,\n\t\tType:       graph.NodeSymbol,\n\t\tSymbolKind: kind,\n\t\tName:       idSuffix,\n\t\tPath:       relPath,\n\t\tLanguage:   \"go\",\n\t\tLineStart:  startPos.Line,\n\t\tLineEnd:    endPos.Line,\n\t}\n\tslice.Nodes = append(slice.Nodes, node)\n\tslice.Edges = append(slice.Edges, graph.Edge{\n\t\tID:   \"e:contains:\" + fileID + \"->\" + id,\n\t\tFrom: fileID,\n\t\tTo:   id,\n\t\tType: graph.EdgeContains,\n\t})\n\treturn 1\n}\n\n// emitGenDecl handles `type`, `var`, `const` blocks. The POC indexes types\n// only (struct/interface/alias) — plain vars and consts add noise without\n// pulling much weight in moments 1–8.\nfunc emitGenDecl(slice *graph.Slice, relPath, fileID string, fset *token.FileSet, gd *ast.GenDecl) int {\n\tif gd.Tok != token.TYPE {\n\t\treturn 0\n\t}\n\tadded := 0\n\tfor _, spec := range gd.Specs {\n\t\tts, ok := spec.(*ast.TypeSpec)\n\t\tif !ok || ts.Name == nil {\n\t\t\tcontinue\n\t\t}\n\t\tkind := graph.SymbolType