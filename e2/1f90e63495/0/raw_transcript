eSpec)\n\t\tif !ok || ts.Name == nil {\n\t\t\tcontinue\n\t\t}\n\t\tkind := graph.SymbolType\n\t\tswitch ts.Type.(type) {\n\t\tcase *ast.StructType:\n\t\t\tkind = graph.SymbolStruct\n\t\tcase *ast.InterfaceType:\n\t\t\tkind = graph.SymbolInterface\n\t\t}\n\n\t\tstartPos := fset.Position(ts.Pos())\n\t\tendPos := fset.Position(ts.End())\n\n\t\tid := \"sym:\" + relPath + \":\" + ts.Name.Name\n\t\tslice.Nodes = append(slice.Nodes, graph.Node{\n\t\t\tID:         id,\n\t\t\tType:       graph.NodeSymbol,\n\t\t\tSymbolKind: kind,\n\t\t\tName:       ts.Name.Name,\n\t\t\tPath:       relPath,\n\t\t\tLanguage:   \"go\",\n\t\t\tLineStart:  startPos.Line,\n\t\t\tLineEnd:    endPos.Line,\n\t\t})\n\t\tslice.Edges = append(slice.Edges, graph.Edge{\n\t\t\tID:   \"e:contains:\" + fileID + \"->\" + id,\n\t\t\tFrom: fileID,\n\t\t\tTo:   id,\n\t\t\tType: graph.EdgeContains,\n\t\t})\n\t\tadded++\n\t}\n\treturn added\n}\n\n// receiverTypeName returns the bare type name from a method receiver, stripping\n// any `*` pointer wrapper. Returns \"\" when the AST is not the shapes we expect\n// (very rare in real code).\nfunc receiverTypeName(expr ast.Expr) string {\n\tswitch t := expr.(type) {\n\tcase *ast.Ident:\n\t\treturn t.Name\n\tcase *ast.StarExpr:\n\t\tif id, ok := t.X.(*ast.Ident); ok {\n\t\t\treturn id.Name\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc isTestFunc(name string) bool {\n\tswitch {\n\tcase len(name) > 4 && name[:4] == \"Test\":\n\t\treturn true\n\tcase len(name) > 9 && name[:9] == \"Benchmark\":\n\t\treturn true\n\tcase len(name) > 4 && name[:4] == \"Fuzz\":\n\t\treturn true\n\t}\n\treturn false\n}\n\n// alwaysIndex returns true for names that are not exported but should still be\n// indexed (e.g. `init`, `main`). We currently always emit symbols regardless\n// of export status, but keep this hook so we can tighten later.\nfunc alwaysIndex(name string) bool {\n\treturn name == \"init\" || name == \"main\"\n}\n","structuredPatch":[{"oldStart":19,"oldLines":7,"newStart":19,"newLines":