d\"`\n\tType       NodeType       `json:\"type\"`\n\tSymbolKind SymbolKind     `json:\"symbol_kind,omitempty\"`\n\tName       string         `json:\"name\"`\n\tPath       string         `json:\"path,omitempty\"`     // repo-relative (forward-slash)\n\tLanguage   string         `json:\"language,omitempty\"` // best-effort language guess\n\tLineStart  int            `json:\"line_start,omitempty\"`\n\tLineEnd    int            `json:\"line_end,omitempty\"`\n\tAttrs      map[string]any `json:\"attrs,omitempty\"`\n}\n\n// Edge is a directed relation From → To.\ntype Edge struct {\n\tID    string         `json:\"id\"`\n\tFrom  string         `json:\"from\"`\n\tTo    string         `json:\"to\"`\n\tType  EdgeType       `json:\"type\"`\n\tScope Scope          `json:\"scope,omitempty\"`\n\tAttrs map[string]any `json:\"attrs,omitempty\"`\n}\n\n// Manifest is the build summary written at .entire/understand/manifest.json.\ntype Manifest struct {\n\tSchemaVersion      int            `json:\"schema_version\"`\n\tBuildID            string         `json:\"build_id\"`\n\tBuiltAt            time.Time      `json:\"built_at\"`\n\tRepoFingerprint    string         `json:\"repo_fingerprint\"`\n\tCheckpointHead     string         `json:\"checkpoint_head,omitempty\"`\n\tStructuralStatus   string         `json:\"structural_status\"` // \"ok\"|\"skipped\"|\"error\"\n\tHistoryStatus      string         `json:\"history_status\"`\n\tSemanticStatus     SemanticStatus `json:\"semantic_status\"`\n\tSemanticReason     string         `json:\"semantic_reason,omitempty\"`\n\tSemanticProvider   string         `json:\"semantic_provider,omitempty\"`\n\tSemanticModel      string         `json:\"semantic_model,omitempty\"`\n\tSupportedLanguages []string       `json:\"supported_languages\"`\n\tNodeCount          int            `json:\"node_count\"`\n\tEdgeCount          int            `json:\"edge_count\"`\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"4b5879