{"parentUuid":"ead02261-9466-4c5f-b130-dcd017b4c2a9","isSidechain":false,"message":{"model":"claude-opus-4-7","id":"msg_01AMHJf9vhnkTJZvtJfVMHDX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017m9rTYmX6yEoEKbp3Aut8F","name":"Write","input":{"file_path":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/understand/graph/types.go","content":"// Package graph defines the schema and persistence layer for the\n// `entire understand` fused graph (structural + history + semantic).\npackage graph\n\nimport \"time\"\n\n// SchemaVersion is the on-disk schema version for understand artifacts.\n// Bump on any breaking change to the persisted format. Readers must check this\n// against the version they understand and refuse to use a higher version.\nconst SchemaVersion = 1\n\n// NodeType enumerates the node kinds that can appear in the fused graph.\ntype NodeType string\n\nconst (\n\tNodeRepo       NodeType = \"repo\"\n\tNodeDirectory  NodeType = \"directory\"\n\tNodeFile       NodeType = \"file\"\n\tNodeModule     NodeType = \"module\"\n\tNodePackage    NodeType = \"package\"\n\tNodeSymbol     NodeType = \"symbol\"\n\tNodeDomain     NodeType = \"domain\"\n\tNodeFlow       NodeType = \"flow\"\n\tNodeStep       NodeType = \"step\"\n\tNodePattern    NodeType = \"pattern\"\n\tNodeCheckpoint NodeType = \"checkpoint\"\n\tNodeSession    NodeType = \"session\"\n)\n\n// SymbolKind narrows a NodeSymbol to a specific role. Empty for non-symbol nodes.\ntype SymbolKind string\n\nconst (\n\tSymbolFunction  SymbolKind = \"function\"\n\tSymbolMethod    SymbolKind = \"method\"\n\tSymbolType      SymbolKind = \"type\"\n\tSymbolInterface SymbolKind = \"interface\"\n\tSymbolClass     SymbolKind = \"class\"\n\tSymbolStruct    SymbolKind = \"struct\"\n\tSymbolTest      SymbolKind = \"test\"\n\tSymbolConfig    SymbolKind = \"config\"\n\tSymbolDocument  SymbolKind = \"document\"\n)\n\n// EdgeType enumerates the relations that can appear between graph nodes.\ntype EdgeType string\n\nconst (\n\tEdgeContains        EdgeType = \"contains\"\n\tEdgeImports         EdgeType = \"imports\"\n\tEdgeCalls           EdgeType = \"calls\"\n\tEdgeImplements      EdgeType = \"implements\"\n\tEdgeReferences      EdgeType = \"references\"\n\tEdgeBelongsTo       EdgeType = \"belongs_to\"\n\tEdgePartOfFlow      EdgeType = \"part_of_flow\"\n\tEdgeRealizesPattern EdgeType = \"realizes_pattern\"\n\tEdgeTouchedIn       EdgeType = \"touched_in\"\n\tEdgeIntroducedIn    EdgeType = \"introduced_in\"\n\tEdgeModifiedIn      EdgeType = \"modified_in\"\n\tEdgeExplainedBy     EdgeType = \"explained_by\"\n\tEdgePrecedes        EdgeType = \"precedes\"\n)\n\n// Scope captures how authoritative a checkpoint→symbol attribution is.\n//\n// ScopeSymbol is reserved for deterministic evidence (diff overlap with a\n// symbol's line range, tool telemetry pointing at a symbol, observed\n// introduction/removal during timeline replay). ScopeFileOwner is used when\n// the checkpoint touched the symbol's owning file but no symbol-level evidence\n// exists; UI/CLI rendering must qualify these as \"(file-level inferred)\".\ntype Scope string\n\nconst (\n\tScopeSymbol    Scope = \"symbol\"\n\tScopeFileOwner Scope = \"file-owner\"\n)\n\n// SemanticStatus captures whether the agent-assisted stage ran successfully.\ntype SemanticStatus string\n\nconst (\n\tSemanticOK      SemanticStatus = \"ok\"\n\tSemanticSkipped SemanticStatus = \"skipped\"\n\tSemanticPartial SemanticStatus = \"partial\"\n)\n\n// Node is one entity in the fused graph. ID is stable across builds; consumers\n// must not assume any other field is stable.\ntype Node struct {\n\tID         string         `json:\"id\"`\n\tType       NodeType       `json:\"type\"`\n\tSymbolKind SymbolKind     `json:\"symbol_kind,omitempty\"`\n\tName       string         `json:\"name\"`\n\tPath       string         `json:\"path,omitempty\"`     // repo-relative (forward-slash)\n\tLanguage   string         `json:\"langua