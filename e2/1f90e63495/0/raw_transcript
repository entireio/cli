":      {},\n\t\".idea\":        {},\n}\n\n// languageByExt is the file extension → language label map. The label is the\n// `Language` field on file nodes; structural code only special-cases \"go\" but\n// we keep a few well-known labels so semantic stages and the dashboard can\n// group files sensibly.\nvar languageByExt = map[string]string{\n\t\".go\":      \"go\",\n\t\".py\":      \"python\",\n\t\".ts\":      \"typescript\",\n\t\".tsx\":     \"typescript\",\n\t\".js\":      \"javascript\",\n\t\".jsx\":     \"javascript\",\n\t\".rs\":      \"rust\",\n\t\".rb\":      \"ruby\",\n\t\".java\":    \"java\",\n\t\".kt\":      \"kotlin\",\n\t\".swift\":   \"swift\",\n\t\".c\":       \"c\",\n\t\".cc\":      \"cpp\",\n\t\".cpp\":     \"cpp\",\n\t\".h\":       \"c\",\n\t\".hpp\":     \"cpp\",\n\t\".cs\":      \"csharp\",\n\t\".sh\":      \"shell\",\n\t\".bash\":    \"shell\",\n\t\".md\":      \"markdown\",\n\t\".json\":    \"json\",\n\t\".yaml\":    \"yaml\",\n\t\".yml\":     \"yaml\",\n\t\".toml\":    \"toml\",\n\t\".html\":    \"html\",\n\t\".css\":     \"css\",\n\t\".sql\":     \"sql\",\n\t\".proto\":   \"proto\",\n\t\".graphql\": \"graphql\",\n}\n\n// ScanResult is the outcome of a structural index pass.\ntype ScanResult struct {\n\t// Slice is the structural graph slice (nodes + edges).\n\tSlice *graph.Slice\n\t// Languages is the sorted, deduplicated list of languages observed.\n\tLanguages []string\n\t// FileCount is the number of file nodes emitted (handy for manifests).\n\tFileCount int\n\t// SymbolCount is the number of symbol nodes emitted (Go-only for the POC).\n\tSymbolCount int\n}\n\n// Scan walks repoRoot, builds directory/file/symbol nodes, and links them\n// with `contains` edges. Errors are returned only for I/O failures that prevent\n// the scan from completing; per-file parse errors are silently downgraded to\n// \"no symbols\" so a malformed source file does not break the whole index.\nfunc Scan(ctx context.Context, repoRoot string) (*ScanResult, error) {\n\tif repoRoot == \"\" {\n\t\treturn nil, errors.New(\"scan: empty repoRoot\")\n\t}\n\tst, err := os.Stat(repoRoot)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"scan: stat repo root: %w\", err)\n\t}\n\tif !st.IsDir() {\n\t\treturn nil, fmt.Errorf(\"scan: repo root %q is not a directory\", repoRoot)\n\t}\n\n\tslice := &graph.Slice{}\n\trepoNodeID := \"repo:.\"\n\tslice.Nodes = append(slice.Nodes, graph.Node{\n\t\tID:   repoNodeID,\n\t\tType: graph.NodeRepo,\n\t\tName: filepath.Base(repoRoot),\n\t})\n\n\tdirNodes := map[string]string{\".\": repoNodeID}\n\tlanguages := map[string]struct{}{}\n\tfiles := 0\n\tsymbols := 0\n\n\terr = filepath.WalkDir(repoRoot, func(path string, d fs.DirEntry, walkErr error) error {\n\t\tif walkErr != nil {\n\t\t\t// Skip unreadable subtrees rather than failing the whole index.\n\t\t\tif d != nil && d.IsDir() {\n\t\t\t\treturn fs.SkipDir\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn fmt.Errorf(\"scan: context: %w\", err)\n\t\t}\n\n\t\t// Translate to forward-slash repo-relative.\n\t\trel, err := filepath.Rel(repoRoot, path)\n\t\tif err != nil {\n\t\t\treturn nil //nolint:nilerr // entries we can't relativize are skipped, not fatal\n\t\t}\n\t\trel = filepath.ToSlash(rel)\n\t\tif rel == \".\" {\n\t\t\treturn nil\n\t\t}\n\n\t\tif d.IsDir() {\n\t\t\tif _, skip := excludedDirs[d.Name()]; skip {\n\t\t\t\treturn fs.SkipDir\n\t\t\t}\n\t\t\tparentRel := filepath.ToSlash(filepath.Dir(rel))\n\t\t\tparentID, ok := dirNodes[parentRel]\n\t\t\tif !ok {\n\t\t\t\tparentID = repoNodeID\n\t\t\t}\n\t\t\tid := \"dir:\" + rel\n\t\t\tslice.Nodes = append(slice.Nodes, graph.Node{\n\t\t\t\tID:   id,\n\t\t\t\tType: graph.NodeDirectory,\n\t\t\t\tName: d.Name(),\n\t\t\t\tPath: rel,\n\t\t\t})\n\t\t\tslice.Edges = append(slice.Edges, graph.Edge{\n\t\t\t\tID:   \"e:contains:\" + parentID + \"->\" + id,\n\t\t\t\tFrom: parentID,\n\t\t\t\tTo:   id,\n\t\t\t\tType: graph.EdgeContains,\n\t\t\t})\n\t\t\tdirNodes[rel] = id\n\t\t\treturn nil\n\t\t}\n\n\t\t// Skip files that begin with `.` at any path component.\n\t\t// Keeps `.gitignore` itself out of the index along with editor turds.\n\t\tif hasDotComponent(rel) {\n\t\t\treturn nil\n\t\t}\n\n\t\text := strings.ToLower(filepath.Ext(rel))\n\t\tlang := languageByExt[ext]\n\t\tif lang != \"\" {\n\t\t\tlanguages[lang] = struct{}{}\n\t\t}\n\n\t\tfileID := \"file:\" + rel\n\t\tparentRel := filepath.ToSlash(filepath.Dir(rel))\n\t\tparentID, ok := dirNodes[parentRel]\n\t\tif !ok {\n\t\t\tparentID = repoNodeID\n\t\t}\n\n\t\tfileNode := graph.Node{\n\t\t\tID:       fileID,\n\t\t\tType:     graph.NodeFile,\n\t\t\tName:     filepath.Base(rel),\n\t\t\tPath:     rel,\n\t\t\tLanguage: lang,\n\t\t}\n\t\t// Stat for size only; LineStart/End are reserved for symbol nodes.\n\t\tif info, errInfo := d.Info(); errInfo == nil {\n\t\t\tfileNode.Attrs = map[string]any{\"size_bytes\": info.Size()}\n\t\t}\n\t\tslice.Nodes = append(slice.Nodes, fileNode)\n\t\tslice.Edges = append(slice.Edges, graph.Edge{\n\t\t\tID:   \"e:contains:\" + parentID + \"->\" + fileID,\n\t\t\tFrom: parentID,\n\t\t\tTo:   fileID,\n\t\t\tType: graph.EdgeContains,\n\t\t})\n\t\tfiles++\n\n\t\tif lang == \"go\" {\n\t\t\tadded, errParse := extractGoSymbols(slice, rel, fileID, path)\n\t\t\tif errParse == nil {\n\t\t\t\tsymbols += added\n\t\t\t}\n\t\t\t// Parse errors are intentionally swallowed: a malformed Go file\n\t\t\t// should not prevent the rest of the structural index from\n\t\t\t// landing. Symbol coverage for that file is simply absent.\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"scan: walk: %w\", err)\n\t}\n\n\tlangs := make([]string, 0, len(languages))\n\tfor l := range languages {\n\t\tlangs = append(langs, l)\n\t}\n\tsort.Strings(langs)\n\n\treturn &ScanResult{\n\t\tSlice:       slice,\n\t\tLanguages:   langs,\n\t\tFileCount:   files,\n\t\tSymbolCount: symbols,\n\t}, nil\n}\n\n// hasDotComponent reports whether any path component begins with a dot.\n// Forward-slash assumed (rel paths are normalized before this is called).\nfunc hasDotComponent(rel string) bool {\n\tfor p := range strings.SplitSeq(rel, \"/\") {\n\t\tif p == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(p, \".\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","structuredPatch":[{"oldStart":9,"oldLines":6,"newStart":9,"newLines":7,"lines":[" "," import (","   \"context\"","+  \"errors\"","   \"fmt\"","   \"io/fs\"","   \"os\""]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"50f57a68-714c-4bc1-9406-f0891fa10c63","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude"}
