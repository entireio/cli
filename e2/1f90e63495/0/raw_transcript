re) ReadManifest() (*Manifest, error) {\n\tvar m Manifest\n\tif err := s.readJSON(manifestFile, &m); err != nil {\n\t\treturn nil, err\n\t}\n\tif m.SchemaVersion > SchemaVersion {\n\t\treturn nil, fmt.Errorf(\"understand cache schema_version=%d is newer than supported (%d); rebuild required\", m.SchemaVersion, SchemaVersion)\n\t}\n\treturn &m, nil\n}\n\n// Slice is a minimal serializable form for the structural / history /\n// semantic / timeline files. Each layer writes its own slice; readers fuse\n// them at query time.\ntype Slice struct {\n\tNodes []Node `json:\"nodes\"`\n\tEdges []Edge `json:\"edges\"`\n}\n\n// WriteStructural persists the deterministic structural slice.\nfunc (s *Store) WriteStructural(slice *Slice) error {\n\treturn s.writeJSON(structuralFile, sliceOrEmpty(slice))\n}\n\n// ReadStructural loads the structural slice. Returns an empty slice when the\n// file is missing — callers can treat absence as \"build hasn't run yet\".\nfunc (s *Store) ReadStructural() (*Slice, error) {\n\treturn s.readSlice(structuralFile)\n}\n\n// WriteHistory persists the history fusion slice.\nfunc (s *Store) WriteHistory(slice *Slice) error {\n\treturn s.writeJSON(historyFile, sliceOrEmpty(slice))\n}\n\n// ReadHistory loads the history slice. Missing file → empty slice.\nfunc (s *Store) ReadHistory() (*Slice, error) {\n\treturn s.readSlice(historyFile)\n}\n\n// WriteSemantic persists the agent-assisted semantic slice.\nfunc (s *Store) WriteSemantic(slice *Slice) error {\n\treturn s.writeJSON(semanticFile, sliceOrEmpty(slice))\n}\n\n// ReadSemantic loads the semantic slice. Missing file → empty slice.\nfunc (s *Store) ReadSemantic() (*Slice, error) {\n\treturn s.readSlice(semanticFile)\n}\n\n// TimelineEvent is one step in the time-ordered replay.\ntype TimelineEvent struct {\n\tAt           string         `json:\"at\"` // RFC3339\n\tCheckpointID string         `json:\"checkpoint_id,omitempty\"`\n\tSessionID    string         `json:\"session_id,omitempty\"`\n\tKind    