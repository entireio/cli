l             `json:\"present\"`\n\tManifest *graph.Manifest  `json:\"manifest,omitempty\"`\n\tReason   string           `json:\"reason,omitempty\"`\n\tCacheDir string           `json:\"cache_dir\"`\n}\n\nfunc runUnderstandStatus(ctx context.Context, w io.Writer, jsonOut bool) error {\n\troot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tstore := graph.NewStore(root)\n\n\treport := statusReport{CacheDir: store.Root()}\n\tif !store.Exists() {\n\t\treport.Present = false\n\t\treport.Reason = \"no understand cache yet — run `entire understand build`\"\n\t\treturn emitStatus(w, report, jsonOut)\n\t}\n\n\tmanifest, err := store.ReadManifest()\n\tif err != nil {\n\t\t// A cache exists but its manifest is unreadable — surface this rather\n\t\t// than silently treating it as \"no cache\".\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treport.Present = false\n\t\t\treport.Reason = \"cache directory exists but manifest is missing\"\n\t\t\treturn emitStatus(w, report, jsonOut)\n\t\t}\n\t\treturn fmt.Errorf(\"read manifest: %w\", err)\n\t}\n\n\treport.Present = true\n\treport.Manifest = manifest\n\treturn emitStatus(w, report, jsonOut)\n}\n\nfunc emitStatus(w io.Writer, r statusReport, jsonOut bool) error {\n\tif jsonOut {\n\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"marshal status: %w\", err)\n\t\t}\n\t\t_, err = w.Write(data)\n\t\treturn err\n\t}\n\n\tif !r.Present {\n\t\tfmt.Fprintf(w, \"understand cache: not present\\n\")\n\t\tfmt.Fprintf(w, \"  cache_dir: %s\\n\", r.CacheDir)\n\t\tif r.Reason != \"\" {\n\t\t\tfmt.Fprintf(w, \"  reason: %s\\n\", r.Reason)\n\t\t}\n\t\treturn nil\n\t}\n\n\tm := r.Manifest\n\tfmt.Fprintf(w, \"understand cache: present\\n\")\n\tfmt.Fprintf(w, \"  cache_dir: %s\\n\", r.CacheDir)\n\tfmt.Fprintf(w, \"  schema_version: %d\\n\", m.SchemaVersion)\n\tfmt.Fprintf(w, \"  build_id: %s\\n\", m.BuildID)\n\tif !m.BuiltAt.IsZero() {\n\t\tfmt.Fprintf(w, \"  b