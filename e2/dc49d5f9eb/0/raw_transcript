   document.getElementById(\"stats\").innerHTML = stats.map(([label, value]) => `\n          <div class=\"stat\"><span class=\"tiny\">${label}</span><strong>${value}</strong></div>\n        `).join(\"\");\n      }\n\n      function matches(node) {\n        if (!state.query) return true;\n        const haystack = [\n          node.name,\n          node.filePath,\n          node.summary,\n          ...(node.tags || []),\n          node.entire?.last_prompt_excerpt || \"\"\n        ].join(\" \").toLowerCase();\n        return haystack.includes(state.query);\n      }\n\n      function renderNodes() {\n        const list = document.getElementById(\"nodes\");\n        const nodes = (state.graph.nodes || [])\n          .filter((node) => [\"file\", \"function\", \"class\", \"config\", \"document\", \"service\", \"table\", \"schema\", \"pipeline\"].includes(node.type))\n          .filter(matches)\n          .sort((a, b) => (a.entire?.hotness_rank || 99999) - (b.entire?.hotness_rank || 99999));\n        list.innerHTML = nodes.map((node) => {\n          const diffStatus = node.entire?.diff_status;\n          return `\n            <article class=\"node ${state.selected?.id === node.id ? \"active\" : \"\"}\" data-node=\"${node.id}\">\n              <strong>${node.name}</strong>\n              <div class=\"meta\">${node.filePath || node.id}</div>\n              <div class=\"badges\">\n                <span class=\"badge\">${node.type}</span>\n                ${node.entire?.checkpoint_count_30d ? `<span class=\"badge\">${node.entire.checkpoint_count_30d} checkpoints</span>` : \"\"}\n                ${diffStatus ? `<span class=\"badge ${diffStatus}\">${diffStatus}</span>` : \"\"}\n              </div>\n            </article>\n          `;\n        }).join(\"\");\n        list.querySelectorAll(\"[data-node]\").forEach((el) => {\n          el.addEventListener(\"click\", () => {\n            state.selected = state.graph.nodes.find((node) => node.id === el.dataset.node);\n            renderNodes();\n            renderDetails();\n          });\n        });\n        if (!state.selected && nodes.length) {\n          state.selected = nodes[0];\n          renderDetails();\n        }\n      }\n\n      function renderDetails() {\n        const target = state.selected;\n        const box = document.getElementById(\"details\");\n        if (!target) {\n          box.textContent = \"No node selected.\";\n          return;\n        }\n        const related = (state.graph.edges || [])\n          .filter((edge) => edge.source === target.id || edge.target === target.id)\n          .slice(0, 8)\n          .map((edge) => edge.source === target.id ? `${edge.type} -> ${edge.target}` : `${edge.type} <- ${edge.source}`);\n        box.innerHTML = `\n          <h2 class=\"detail-title\">${target.name}</h2>\n          <div class=\"meta\">${target.filePath || target.id}</div>\n          <p>${target.summary}</p>\n          <div class=\"detail-list\">\n            <div><strong>Complexity:</strong> ${target.complexity}</div>\n            <div><strong>Last prompt:</strong> ${target.entire?.last_prompt_excerpt || \"n/a\"}</div>\n            <div><strong>Last checkpoint:</strong> ${target.entire?.last_checkpoint_id || \"n/a\"}</div>\n            <div><strong>Last touched:</strong> ${target.entire?.last_touched_at || \"n/a\"}</div>\n            <div><strong>Agents:</strong> ${formatAgents(target.entire?.agents_30d)}</div>\n            <div><strong>Tags:</strong> ${(target.tags || []).map((tag) => `<code>${tag}</code>`).join(\" \") || \"n/a\"}</div>\n            <div><strong>Related:</strong><br />${related.map((item) => `<div>${item}</div>`).join(\"\") || \"n/a\"}</div>\n          </div>\n        `;\n      }\n\n      function renderTour() {\n        document.getElementById(\"tour\").innerHTML = (state.graph.tour || []).map((step) => `\n          <div class=\"tour-step\">\n            <strong>${step.order}. ${step.title}</strong>\n            <div class=\"meta\">${step.description}</div>\n          </div>\n        `).join(\"\");\n      }\n\n      function formatAgents(value) {\n        if (!value) return \"n/a\";\n        return Object.entries(value).map(([agent, count]) => `${agent}=${count}`).join(\", \");\n      }\n\n      document.getElementById(\"search\").addEventListener(\"input\", (event) => {\n        state.query = event.target.value.toLowerCase().trim();\n        renderNodes();\n      });\n\n      load().catch((error) => {\n        document.getElementById(\"subtitle\").textContent = error.message;\n      });\n    </script>\n  </body>\n</html>\n"},"/Users/alisha/.marvin/worktrees/collab-ba7318a2-codex/cmd/entire/cli/understand/serve.go":{"type":"add","content":"package understand\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"embed\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/remote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n)\n\n//go:embed dashboard/dist/*\nvar dashboardDist embed.FS\n\ntype ServerOptions struct {\n\tRepoRoot string\n}\n\ntype ServerSession struct {\n\tURL      string\n\trepoRoot string\n\ttoken    string\n\tserver   *http.Server\n\tlistener net.Listener\n}\n\nfunc StartServer(ctx context.Context, opts ServerOptions) (*ServerSession, error) {\n\trepoRoot := opts.RepoRoot\n\tif repoRoot == \"\" {\n\t\tvar err error\n\t\trepoRoot, err = paths.WorktreeRoot(ctx)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"resolve repo root: %w\", err)\n\t\t}\n\t}\n\tif _, err := os.Stat(graph.GraphPath(repoRoot)); err != nil {\n\t\treturn nil, fmt.Errorf(\"knowledge graph missing: run `entire understand build` first\")\n\t}\n\n\ttoken, err := randomToken()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"generate access token: %w\", err)\n\t}\n\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"listen: %w\", err)\n\t}\n\n\tsession := &ServerSession{\n\t\trepoRoot: repoRoot,\n\t\ttoken:    token,\n\t\tlistener: listener,\n\t}\n\tsession.URL = fmt.Sprintf(\"http://%s/?token=%s\", listener.Addr().String(), token)\n\tsession.server = &http.Server{\n\t\tHandler: session.routes(),\n\t}\n\tgo func() {\n\t\t_ = session.server.Serve(listener)\n\t}()\n\n\treturn session, nil\n}\n\nfunc (s *ServerSession) Wait(ctx context.Context) error {\n\tsigCtx, stop := signal.NotifyContext(ctx, os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\t<-sigCtx.Done()\n\tshutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\tdefer cancel()\n\treturn s.server.Shutdown(shutdownCtx)\n}\n\nfunc (s *ServerSession) routes() http.Handler {\n\tmux := http.NewServeMux()\n\tmux.HandleFunc(\"/\", s.handleIndex)\n\tmux.HandleFunc(\"/knowledge-graph.json\", s.handleGraph)\n\tmux.HandleFunc(\"/meta.json\", s.handleMeta)\n\tmux.HandleFunc(\"/diff-overlay.json\", s.handleDiff)\n\tmux.HandleFunc(\"/api/diff\", s.handleDiff)\n\tmux.HandleFunc(\"/api/file\", s.handleFile)\n\tmux.HandleFunc(\"/api/checkpoint\", s.handleCheckpoint)\n\treturn mux\n}\n\nfunc (s *ServerSession) handleIndex(w http.ResponseWriter, r *http.Request) {\n\tif !s.authorized(r) {\n\t\thttp.Error(w, \"Unauthorized\", http.StatusUnauthorized)\n\t\treturn\n\t}\n\tsub, err := fs.Sub(dashboardDist, \"dashboard/dist\")\n\tif err != nil {\n\t\thttp.Error(w, \"Dashboard unavailable\", http.StatusInternalServerError)\n\t\treturn\n\t}\n\thttp.FileServer(http.FS(sub)).ServeHTTP(w, r)\n}\n\nfunc (s *ServerSession) handleGraph(w http.ResponseWriter, r *http.Request) {\n\ts.serveGeneratedFile(w, r, graph.GraphPath(s.repoRoot))\n}\n\nfunc (s *ServerSession) handleMeta(w http.ResponseWriter, r *http.Request) {\n\ts.serveGeneratedFile(w, r, graph.MetaPath(s.repoRoot))\n}\n\nfunc (s *ServerSession) handleDiff(w http.ResponseWriter, r *http.Request) {\n\ts.serveGeneratedFile(w, r, graph.DiffOverlayPath(s.repoRoot))\n}\n\nfunc (s *ServerSession) handleFile(w http.ResponseWriter, r *http.Request) {\n\tif !s.authorized(r) {\n\t\thttp.Error(w, \"Unauthorized\", http.StatusUnauthorized)\n\t\treturn\n\t}\n\tpath := strings.TrimSpace(r.URL.Query().Get(\"path\"))\n\tif path == \"\" {\n\t\thttp.Error(w, \"Missing path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath := filepath.Join(s.repoRoot, filepath.Clean(path))\n\tif !paths.IsSubpath(s.repoRoot, absPath) {\n\t\thttp.Error(w, \"Not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\tcontent, err := os.ReadFile(absPath) //nolint:gosec // path checked against repo root\n\tif err != nil {\n\t\thttp.Error(w, \"Not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\twriteJSONResponse(w, map[string]any{\n\t\t\"path\":    path,\n\t\t\"content\": string(content),\n\t})\n}\n\nfunc (s *ServerSession) handleCheckpoint(w http.ResponseWriter, r *http.Request) {\n\tif !s.authorized(r) {\n\t\thttp.Error(w, \"Unauthorized\", http.StatusUnauthorized)\n\t\treturn\n\t}\n\trawID := strings.TrimSpace(r.URL.Query().Get(\"id\"))\n\tif rawID == \"\" {\n\t\thttp.Error(w, \"Missing id\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tcheckpointID, err := id.NewCheckpointID(rawID)\n\tif err != nil {\n\t\thttp.Error(w, \"Not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\trepo, err := strategy.OpenRepository(r.Context())\n\tif err != nil {\n\t\thttp.Error(w, \"Repository unavailable\", http.StatusInternalServerError)\n\t\treturn\n\t}\n\tv1Store := checkpoint.NewGitStore(repo)\n\tv2URL, fetchErr := remote.FetchURL(r.Context())\n\tif fetchErr != nil {\n\t\tv2URL = \"\"\n\t}\n\tv2Store := checkpoint.NewV2GitStore(repo, v2URL)\n\treader, summary, err := checkpoint.ResolveCommittedReaderForCheckpoint(r.Context(), checkpointID, v1Store, v2Store, settings.IsCheckpointsV2Enabled(r.Context()))\n\tif err != nil || summary == nil || len(summary.Sessions) == 0 {\n\t\thttp.Error(w, \"Not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\tcontent, err := reader.ReadSessionContent(r.Context(), checkpointID, len(summary.Sessions)-1)\n\tif err != nil {\n\t\thttp.Error(w, \"Not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\twriteJSONResponse(w, map[string]any{\n\t\t\"summary\":  summary,\n\t\t\"metadata\": content.Metadata,\n\t\t\"prompts\":  content.Prompts,\n\t})\n}\n\nfunc (s *ServerSession) serveGeneratedFile(w http.ResponseWriter, r *http.Request, path string) {\n\tif !s.authorized(r) {\n\t\thttp.Error(w, \"Unauthorized\", http.StatusUnauthorized)\n\t\treturn\n\t}\n\tcontent, err := os.ReadFile(path) //nolint:gosec // generated file under repo root\n\tif err != nil {\n\t\thttp.Error(w, \"Not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\t_, _ = w.Write(content)\n}\n\nfunc (s *ServerSession) authorized(r *http.Request) bool {\n\ttoken := strings.TrimSpace(r.URL.Query().Get(\"token\"))\n\tif token == \"\" {\n\t\ttoken = strings.TrimSpace(r.Header.Get(\"X-Entire-Understand-Token\"))\n\t}\n\treturn subtle.ConstantTimeCompare([]byte(token), []byte(s.token)) == 1\n}\n\nfunc randomToken() (string, error) {\n\tbuf := make([]byte, 32)\n\tif _, err := rand.Read(buf); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn base64.RawURLEncoding.EncodeToString(buf), nil\n}\n\nfunc writeJSONResponse(w http.ResponseWriter, value any) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tenc := json.NewEncoder(w)\n\tenc.SetEscapeHTML(false)\n\t_ = enc.Encode(value)\n}\n"}},"status":"completed"}}
