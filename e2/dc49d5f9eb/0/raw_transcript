return true\n+\t\t}\n+\t\tif matched, _ := filepath.Match(pattern, path); matched {\n+\t\t\treturn true\n+\t\t}\n+\t\tif strings.Contains(path, pattern) {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn strings.HasPrefix(path, \".git/\") || strings.HasPrefix(path, \"node_modules/\")\n+}\n+\n+func classifyFile(path string) (string, NodeType) {\n+\tswitch ext := strings.ToLower(filepath.Ext(path)); ext {\n+\tcase \".go\":\n+\t\treturn \"go\", NodeTypeFile\n+\tcase \".ts\", \".tsx\", \".js\", \".jsx\", \".mjs\", \".cjs\":\n+\t\treturn \"typescript\", NodeTypeFile\n+\tcase \".py\":\n+\t\treturn \"python\", NodeTypeFile\n+\tcase \".md\", \".mdx\", \".rst\", \".txt\":\n+\t\treturn \"markdown\", NodeTypeDocument\n+\tcase \".json\", \".yaml\", \".yml\", \".toml\", \".ini\", \".conf\", \".env\":\n+\t\treturn \"config\", NodeTypeConfig\n+\tcase \".sql\":\n+\t\treturn \"sql\", NodeTypeTable\n+\tcase \".proto\":\n+\t\treturn \"protobuf\", NodeTypeSchema\n+\tcase \".sh\":\n+\t\treturn \"shell\", NodeTypePipeline\n+\tdefault:\n+\t\tif strings.EqualFold(filepath.Base(path), \"Dockerfile\") {\n+\t\t\treturn \"docker\", NodeTypeService\n+\t\t}\n+\t\treturn \"\", \"\"\n+\t}\n+}\n+\n+func summarizeFile(file sourceFile) string {\n+\tswitch file.NodeType {\n+\tcase NodeTypeDocument:\n+\t\treturn fmt.Sprintf(\"Documentation file in %s.\", filepath.Dir(file.Path))\n+\tcase NodeTypeConfig:\n+\t\treturn fmt.Sprintf(\"Configuration artifact used by %s.\", filepath.Dir(file.Path))\n+\tcase NodeTypeTable:\n+\t\treturn \"SQL or data-schema artifact.\"\n+\tcase NodeTypeSchema:\n+\t\treturn \"Schema definition file.\"\n+\tcase NodeTypePipeline:\n+\t\treturn \"Automation or pipeline script.\"\n+\tcase NodeTypeService:\n+\t\treturn \"Infrastructure or service definition.\"\n+\tdefault:\n+\t\treturn fmt.Sprintf(\"%s source file in %s.\", strings.Title(file.Language), filepath.Dir(file.Path))\n+\t}\n+}\n+\n+func buildFileTags(file sourceFile) []string {\n+\ttags := []string{file.Language}\n+\tif dir := filepath.Dir(file.Path); dir != \".\" {\n+\t\ttags = append(tags, dir)\n+\t}\n+\treturn tags\n+}\n+\n+func languageNotesForFile(file sourceFile) string {\n+\tswitch file.Language {\n+\tcase \"go\":\n+\t\treturn \"Go nodes use the standard-library parser for imports, functions, and named types.\"\n+\tcase \"typescript\":\n+\t\treturn \"TypeScript and JavaScript nodes are extracted with regex heuristics for imports, functions, and classes.\"\n+\tcase \"python\":\n+\t\treturn \"Python nodes are extracted with regex heuristics for imports, functions, and classes.\"\n+\tdefault:\n+\t\treturn \"\"\n+\t}\n+}\n+\n+func analyzeFile(file sourceFile) ([]GraphNode, []importRef) {\n+\tswitch file.Language {\n+\tcase \"go\":\n+\t\treturn analyzeGoFile(file)\n+\tcase \"typescript\":\n+\t\treturn analyzeScriptFile(file)\n+\tcase \"python\":\n+\t\treturn analyzePythonFile(file)\n+\tdefault:\n+\t\treturn nil, nil\n+\t}\n+}\n+\n+func analyzeGoFile(file sourceFile) ([]GraphNode, []importRef) {\n+\tfset := token.NewFileSet()\n+\tparsed, err := parser.ParseFile(fset, file.Path, file.Content, parser.ParseComments)\n+\tif err != nil {\n+\t\treturn nil, nil\n+\t}\n+\n+\tvar nodes []GraphNode\n+\tvar imports []importRef\n+\tfor _, spec := range parsed.Imports {\n+\t\timportPath := strings.Trim(spec.Path.Value, `\"`)\n+\t\timports = append(imports, importRef{ImportPath: importPath})\n+\t}\n+\tfor _, decl := range parsed.Decls {\n+\t\tswitch typed := decl.(type) {\n+\t\tcase *ast.FuncDecl:\n+\t\t\tname := typed.Name.Name\n+\t\t\tif typed.Recv != nil && len(typed.Recv.List) > 0 {\n+\t\t\t\tname = fmt.Sprintf(\"%s.%s\", recvName(typed.Recv.List[0].Type), name)\n+\t\t\t}\n+\t\t\tnodes = append(nodes, GraphNode{\n+\t\t\t\tID:         fmt.Sprintf(\"function:%s#%s\", file.Path, name),\n+\t\t\t\tType:       NodeTypeFunction,\n+\t\t\t\tName:       name,\n+\t\t\t\tFilePath:   file.Path,\n+\t\t\t\tLineRange:  [2]int{fset.Position(typed.Pos()).Line, fset.Position(typed.End()).Line},\n+\t\t\t\tSummary:    \"Go function or method.\",\n+\t\t\t\tTags:       []string{\"go\", \"symbol\"},\n+\t\t\t\tComplexity: complexityForLines(fset.Position(typed.End()).Line - fset.Position(typed.Pos()).Line + 1),\n+\t\t\t})\n+\t\tcase *ast.GenDecl:\n+\t\t\tfor _, spec := range typed.Specs {\n+\t\t\t\ttypeSpec, ok := spec.(*ast.TypeSpec)\n+\t\t\t\tif !ok {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tswitch typeSpec.Type.(type) {\n+\t\t\t\tcase *ast.StructType, *ast.InterfaceType:\n+\t\t\t\t\tnodes = append(nodes, GraphNode{\n+\t\t\t\t\t\tID:         fmt.Sprintf(\"class:%s#%s\", file.Path, typeSpec.Name.Name),\n+\t\t\t\t\t\tType:       NodeTypeClass,\n+\t\t\t\t\t\tName:       typeSpec.Name.Name,\n+\t\t\t\t\t\tFilePath:   file.Path,\n+\t\t\t\t\t\tLineRange:  [2]int{fset.Position(typeSpec.Pos()).Line, fset.Position(typeSpec.End()).Line},\n+\t\t\t\t\t\tSummary:    \"Go struct or interface.\",\n+\t\t\t\t\t\tTags:       []string{\"go\", \"type\"},\n+\t\t\t\t\t\tComplexity: complexityForLines(fset.Position(typeSpec.End()).Line - fset.Position(typeSpec.Pos()).Line + 1),\n+\t\t\t\t\t})\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn nodes, imports\n+}\n+\n+func analyzeScriptFile(file sourceFile) ([]GraphNode, []importRef) {\n+\tconst importPattern = `(?m)^\\s*import(?:[\\s\\w{},*]+from)?\\s*[\"']([^\"']+)[\"']|require\\(\\s*[\"']([^\"']+)[\"']\\s*\\)`\n+\tconst functionPattern = `(?m)^\\s*(?:export\\s+)?(?:async\\s+)?function\\s+([A-Za-z_][A-Za-z0-9_]*)|^\\s*(?:const|let|var)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(?:async\\s*)?\\(`\n+\tconst classPattern = `(?m)^\\s*(?:export\\s+)?class\\s+([A-Za-z_][A-Za-z0-9_]*)`\n+\n+\timports := regexImports(file, regexp.MustCompile(importPattern))\n+\tnodes := regexSymbolNodes(file, regexp.MustCompile(functionPattern), NodeTypeFunction, \"JavaScript or TypeScript function.\")\n+\tnodes = append(nodes, regexSymbolNodes(file, regexp.MustCompile(classPattern), NodeTypeClass, \"JavaScript or TypeScript class.\")...)\n+\treturn nodes, imports\n+}\n+\n+func analyzePythonFile(file sourceFile) ([]GraphNode, []importRef) {\n+\tconst importPattern = `(?m)^\\s*from\\s+([.\\w]+)\\s+import|^\\s*import\\s+([.\\w, ]+)`\n+\tconst functionPattern = `(?m)^def\\s+([A-Za-z_][A-Za-z0-9_]*)`\n+\tconst classPattern = `(?m)^class\\s+([A-Za-z_][A-Za-z0-9_]*)`\n+\n+\timports := regexImports(file, regexp.MustCompile(importPattern))\n+\tnodes := regexSymbolNodes(file, regexp.MustCompile(functionPattern), NodeTypeFunction, \"Python function.\")\n+\tnodes = append(nodes, regexSymbolNodes(file, regexp.MustCompile(classPattern), NodeTypeClass, \"Python class.\")...)\n+\treturn nodes, imports\n+}\n+\n+func regexImports(file sourceFile, re *regexp.Regexp) []importRef {\n+\tmatches := re.FindAllStringSubmatch(file.Content, -1)\n+\timports := make([]importRef, 0, len(matches))\n+\tfor _, match := range matches {\n+\t\tfor i := 1; i < len(match); i++ {\n+\t\t\tvalue := strings.TrimSpace(match[i])\n+\t\t\tif value == \"\" {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif strings.Contains(value, \",\") {\n+\t\t\t\tfor _, part := range strings.Split(value, \",\") {\n+\t\t\t\t\tpart = strings.TrimSpace(part)\n+\t\t\t\t\tif part != \"\" {\n+\t\t\t\t\t\timports = append(imports, importRef{ImportPath: part})\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\timports = append(imports, importRef{ImportPath: value})\n+\t\t}\n+\t}\n+\treturn imports\n+}\n+\n+func regexSymbolNodes(file sourceFile, re *regexp.Regexp, nodeType NodeType, summary string) []GraphNode {\n+\tindexes := re.FindAllStringSubmatchIndex(file.Content, -1)\n+\tnodes := make([]GraphNode, 0, len(indexes))\n+\tfor _, idx := range indexes {\n+\t\tname := \"\"\n+\t\tfor group := 2; group < len(idx); group += 2 {\n+\t\t\tstart := idx[group]\n+\t\t\tend := idx[group+1]\n+\t\t\tif start >= 0 && end > start {\n+\t\t\t\tname = file.Content[start:end]\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t\tif name == \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tline := lineNumberAtOffset(file.Content, idx[0])\n+\t\tnodes = append(nodes, GraphNode{\n+\t\t\tID:         fmt.Sprintf(\"%s:%s#%s\", nodeType, file.Path, name),\n+\t\t\tType:       nodeType,\n+\t\t\tName:       name,\n+\t\t\tFilePath:   file.Path,\n+\t\t\tLineRange:  [2]int{line, line},\n+\t\t\tSummary:    summary,\n+\t\t\tTags:       []string{file.Language, \"symbol\"},\n+\t\t\tComplexity: \"simple\",\n+\t\t})\n+\t}\n+\treturn nodes\n+}\n+\n+func resolveImports(graph *KnowledgeGraph, imports []importRef, fileNodeIndex map[string]int, dirToFiles map[string][]string, modulePath string) {\n+\tadded := map[string]struct{}{}\n+\tfor _, ref := range imports {\n+\t\ttargets := resolveImportTargets(ref, fileNodeIndex, dirToFiles, modulePath)\n+\t\tfor _, target := range targets {\n+\t\t\tkey := ref.SourceNodeID + \"->\" + target\n+\t\t\tif _, ok := added[key]; ok {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tadded[key] = struct{}{}\n+\t\t\tgraph.Edges = append(graph.Edges, GraphEdge{\n+\t\t\t\tSource:      ref.SourceNodeID,\n+\t\t\t\tTarget:      target,\n+\t\t\t\tType:        EdgeTypeImports,\n+\t\t\t\tDirection:   \"forward\",\n+\t\t\t\tDescription: \"Static import dependency\",\n+\t\t\t\tWeight:      0.85,\n+\t\t\t})\n+\t\t}\n+\t}\n+}\n+\n+func resolveImportTargets(ref importRef, fileNodeIndex map[string]int, dirToFiles map[string][]string, modulePath string) []string {\n+\tswitch ref.Language {\n+\tcase \"go\":\n+\t\tif modulePath != \"\" && strings.HasPrefix(ref.ImportPath, modulePath+\"/\") {\n+\t\t\tdir := strings.TrimPrefix(ref.ImportPath, modulePath+\"/\")\n+\t\t\tif files := dirToFiles[dir]; len(files) > 0 {\n+\t\t\t\treturn fileIDs(files)\n+\t\t\t}\n+\t\t}\n+\tcase \"typescript\":\n+\t\tif strings.HasPrefix(ref.ImportPath, \".\") {\n+\t\t\tbaseDir := filepath.Dir(ref.SourcePath)\n+\t\t\tcandidate := filepath.Clean(filepath.Join(baseDir, ref.ImportPath))\n+\t\t\tfor _, suffix := range []string{\"\", \".ts\", \".tsx\", \".js\", \".jsx\", \".mjs\", \".cjs\", \"/index.ts\", \"/index.tsx\", \"/index.js\"} {\n+\t\t\t\tpath := strings.TrimPrefix(candidate+suffix, \"./\")\n+\t\t\t\tif _, ok := fileNodeIndex[path]; ok {\n+\t\t\t\t\treturn []string{\"file:\" + path}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\tcase \"python\":\n+\t\tpath := strings.ReplaceAll(ref.ImportPath, \".\", \"/\")\n+\t\tfor _, candidate := range []string{path + \".py\", filepath.Join(path, \"__init__.py\")} {\n+\t\t\tif _, ok := fileNodeIndex[candidate]; ok {\n+\t\t\t\treturn []string{\"file:\" + candidate}\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+func applyTelemetry(graph *KnowledgeGraph, files []sourceFile, snapshot *telemetry.Snapshot) {\n+\tpathToFileNode := map[string]*GraphNode{}\n+\tsymbolsByFile := map[string][]*GraphNode{}\n+\tfor i := range graph.Nodes {\n+\t\tnode := &graph.Nodes[i]\n+\t\tif node.FilePath == \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif node.Type == NodeTypeFile || node.Type == NodeTypeConfig || node.Type == NodeTypeDocument || node.Type == NodeTypeTable || node.Type == NodeTypeSchema || node.Type == NodeTypePipeline || node.Type == NodeTypeService {\n+\t\t\tpathToFileNode[node.FilePath] = node\n+\t\t\tcontinue\n+\t\t}\n+\t\tsymbolsByFile[node.FilePath] = append(symbolsByFile[node.FilePath], node)\n+\t}\n+\n+\ttype score struct {\n+\t\tpath  string\n+\t\tscore float64\n+\t}\n+\tscores := make([]score, 0, len(snapshot.Files))\n+\tfor path, metrics := range snapshot.Files {\n+\t\tscoreValue := float64(metrics.CheckpointCount) + float64(len(metrics.AgentCounts))*1.5\n+\t\tscores = append(scores, score{path: path, score: scoreValue})\n+\t}\n+\tsort.Slice(scores, func(i, j int) bool {\n+\t\treturn scores[i].score > scores[j].score\n+\t})\n+\thotnessRanks := map[string]int{}\n+\tfor i, item := range scores {\n+\t\thotnessRanks[item.path] = i + 1\n+\t}\n+\n+\tfor _, file := range files {\n+\t\tmetrics, ok := snapshot.Files[file.Path]\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tmeta := &EntireNode{\n+\t\t\tCheckpointCount30d: metrics.CheckpointCount,\n+\t\t\tAgents30d:          metrics.AgentCounts,\n+\t\t\tLastCheckpo