lves\n   129→\t\trepo, err := strategy.OpenRepository()\n   130→\t\tif err != nil {\n   131→\t\t\t// Output user-friendly error message via hook response\n   132→\t\t\tif outputErr := outputHookResponse(false, fmt.Sprintf(\"Failed to open git repository: %v\\n\\nPlease ensure you're in a git repository and try again.\", err)); outputErr != nil {\n   133→\t\t\t\treturn false, outputErr\n   134→\t\t\t}\n   135→\t\t\treturn true, nil // Skip hook after outputting response\n   136→\t\t}\n   137→\t\thead, err := repo.Head()\n   138→\t\tif err != nil {\n   139→\t\t\t// Output user-friendly error message via hook response\n   140→\t\t\tif outputErr := outputHookResponse(false, fmt.Sprintf(\"Failed to get git HEAD: %v\\n\\nPlease ensure the repository has at least one commit.\", err)); outputErr != nil {\n   141→\t\t\t\treturn false, outputErr\n   142→\t\t\t}\n   143→\t\t\treturn true, nil // Skip hook after outputting response\n   144→\t\t}\n   145→\t\t// Derive agent type from agent description (e.g., \"Claude Code\" from \"Claude Code - ...\")\n   146→\t\tagentType := ag.Description()\n   147→\t\tif idx := strings.Index(agentType, \" - \"); idx > 0 {\n   148→\t\t\tagentType = agentType[:idx]\n   149→\t\t}\n   150→\t\tnewState := &strategy.SessionState{\n   151→\t\t\tSessionID:              entireSessionID,\n   152→\t\t\tBaseCommit:             head.Hash().String(),\n   153→\t\t\tConcurrentWarningShown: true,\n   154→\t\t\tStartedAt:              time.Now(),\n   155→\t\t\tAgentType:              agentType,\n   156→\t\t}\n   157→\t\tif saveErr := strategy.SaveSessionState(newState); saveErr != nil {\n   158→\t\t\tfmt.Fprintf(os.Stderr, \"Warning: failed to save session state: %v\\n\", saveErr)\n   159→\t\t}\n   160→\n   161→\t\t// Get resume command for the other session\n   162→\t\tresumeCmd := ag.FormatResumeCommand(ag.ExtractAgentSessionID(otherSession.SessionID))\n   163→\n   164→\t\t// Output blocking JSON response\n   165→\t\tif err := outputHookResponse(false, \"You