ession metadata\n */\nexport async function exportMetadata(\n  sessionID: string,\n  sessionInfo: unknown,\n  directory: string\n): Promise<string> {\n  const exportDir = path.join(directory, \".entire\", \"opencode\", \"sessions\", sessionID)\n  await fs.mkdir(exportDir, { recursive: true })\n\n  const metadataPath = path.join(exportDir, \"metadata.json\")\n\n  const metadata = {\n    session_id: sessionID,\n    exported_at: new Date().toISOString(),\n    info: sessionInfo,\n  }\n\n  await fs.writeFile(metadataPath, JSON.stringify(metadata, null, 2), \"utf-8\")\n\n  return metadataPath\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":14,"cache_creation_input_tokens":2537,"cache_read_input_tokens":86776,"cache_creation":{"ephemeral_5m_input_tokens":2537,"ephemeral_1h_input_tokens":0},"output_tokens":3188,"service_tier":"standard"}},"requestId":"req_011CWydx1Q8mwPpF6YQAgNzf","type":"assistant","uuid":"ea42afe1-b5b3-4fe7-b664-586e66b20d49","timestamp":"2026-01-10T11:43:43.405Z"}
