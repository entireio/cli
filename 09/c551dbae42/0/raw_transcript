h,\n    }\n  } catch (error) {\n    throw new Error(`Failed to export transcript for session ${sessionID}: ${String(error)}`)\n  }\n}\n\n/**\n * Export session metadata\n */\nexport async function exportMetadata(\n  sessionID: string,\n  sessionInfo: unknown,\n  directory: string\n): Promise<string> {\n  const exportDir = path.join(directory, \".entire\", \"opencode\", \"sessions\", sessionID)\n  await fs.mkdir(exportDir, { recursive: true })\n\n  const metadataPath = path.join(exportDir, \"metadata.json\")\n\n  const metadata = {\n    session_id: sessionID,\n    exported_at: new Date().toISOString(),\n    info: sessionInfo,\n  }\n\n  await fs.writeFile(metadataPath, JSON.stringify(metadata, null, 2), \"utf-8\")\n\n  return metadataPath\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"ea42afe1-b5b3-4fe7-b664-586e66b20d49"}
