ent {\n  event: {\n    type: string\n    properties: {\n      info?: {\n        id: string\n        projectID: string\n        directory: string\n        title: string\n        time: {\n          created: number\n          updated: number\n        }\n      }\n      sessionID?: string\n    }\n  }\n}\n\nexport function createSessionHooks(\n  ctx: PluginInput,\n  config: EntireConfig,\n  entireCLI: EntireCLI,\n  logger: Logger\n) {\n  const { client, directory } = ctx\n\n  return {\n    /**\n     * Handle session.created event\n     * Initializes session tracking in Entire CLI\n     */\n    async onSessionCreated({ event }: SessionEvent): Promise<void> {\n      console.error(\"[entire-integration] onSessionCreated called\")\n      const sessionID = event.properties.info?.id\n      console.error(`[entire-integration] Session ID: ${sessionID}`)\n      if (!sessionID) {\n        await logger.warn(\"session.created event missing session ID\")\n        return\n      }\n\n      try {\n        console.error(`[entire-integration] Starting session tracking for: ${sessionID}`)\n        await logger.debug(\"Session created\", { sessionID })\n\n        // Export transcript and metadata\n        let transcriptPath = \"\"\n        if (config.export_transcripts) {\n          console.error(\"[entire-integration] Exporting transcript...\")\n          const exported = await exportTranscript(sessionID, client, directory)\n          transcriptPath = exported.path\n          console.error(`[entire-integration] Transcript exported to: ${transcriptPath}`)\n          await logger.debug(\"Exported transcript\", {\n            sessionID,\n            path: transcriptPath,\n            messageCount: exported.messageCount,\n          })\n\n          // Export session metadata\n          await exportMetadata(sessionID, event.properties.info, directory)\n        }\n\n        // Call entire hooks opencode session-start\n        console.error(`[entire-integration] Calling entire hooks opencode session-start...`)\n        await entireCLI.callHook(\"session-start\", {\n          session_id: sessionID,\n          session_ref: sessionID,\n          timestamp: new Date().toISOString(),\n          transcript_path: transcriptPath,\n        })\n        console.error(`[entire-integration] Hook call completed`)\n\n        await logger.info(\"Session tracking initialized\", { sessionID })\n      } catch (error) {\n        await logger.error(\"Failed to initialize session tracking\", {\n          sessionID,\n          error: String(error),\n        })\n      }\n    },\n\n    /**\n     * Handle session.idle event\n     * Saves checkpoint when session goes idle\n     */\n    async onSessionIdle({ event }: SessionEvent): Promise<void> {\n      console.error(\"[entire-integration] onSessionIdle called\")\n      const sessionID = event.properties.sessionID\n      console.error(`[entire-integration] Session ID: ${sessionID}`)\n      if (!sessionID) {\n        await logger.warn(\"session.idle event missing session ID\")\n        return\n      }\n\n      try {\n        console.error(`[entire-integration] Creating checkpoint for session: ${sessionID}`)\n        await logger.debug(\"Session idle\", { sessionID })\n\n        // Export transcript\n        let transcriptPath = \"\"\n        if (config.export_transcripts) {\n          console.error(`[entire-integration] Exporting transcript for ${sessionID}...`)\n          const exported = await exportTranscript(sessionID, client, directory)\n          transcriptPath = exported.path\n          console.error(`[entire-integration] Transcript exported to: ${transcriptPath}`)\n          await logger.debug(\"Exported transcript on idle\", {\n            sessionID,\n            path: transcriptPath,\n            messageCount: exported.messageCount,\n          })\n        } else {\n          console.error(`[entire-integration] Transcript export DISABLED by config`)\n        }\n\n        // Call entire hooks opencode stop\n        const hookInput = {\n          session_id: sessionID,\n          session_ref: sessionID,\n          timestamp: new Date().toISOString(),\n          transcript_path: transcriptPath,\n        }\n        console.error(`[entire-integration] About to call hook with input:`)\n        console.error(JSON.stringify(hookInput, null, 2))\n        await entireCLI.callHook(\"stop\", hookInput)\n\n        await logger.info(\"Session checkpoint saved\", { sessionID })\n      } catch (error) {\n        await logger.warn(\"Failed to save session checkpoint\", {\n          sessionID,\n          error: String(error),\n        })\n      }\n    },\n\n    /**\n     * Handle session.status event\n     * Could be used for periodic checkpoints (currently just logs)\n     */\n    async onSessionStatus({ event }: SessionEvent): Promise<void> {\n      const sessionID = event.properties.sessionID\n      if (!sessionID) {\n        return\n      }\n\n      await logger.debug(\"Session status update\", { sessionID })\n      // Future: could implement periodic checkpointing here\n    },\n  }\n}\n","structuredPatch":[{"oldStart":41,"oldLines":16,"newStart":41,"newLines":13,"lines":["      * Initializes session tracking in Entire CLI","      */","     async onSessionCreated({ event }: SessionEvent): Promise<void> {","-      console.error(\"[entire-integration] onSessionCreated called\")","       const sessionID = event.properties.info?.id","-      console.error(`[entire-integration] Session ID: ${sessionID}`)","       if (!sessionID) {","         await logger.warn(\"session.created event missing session ID\")","         return","       }"," ","       try {","-        console.error(`[entire-integration] Starting session tracking for: ${sessionID}`)","         await logger.debug(\"Session created\", { sessionID })"," ","         // Export transcript and metadata"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"12a30f85-65f3-4726-89ee-319a7cdcfb57"}
