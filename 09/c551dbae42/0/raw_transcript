rr}`)\n      }\n\n      if (result.status !== 0) {\n        throw new EntireCLIError(\n          `Hook '${hookName}' failed with exit code ${result.status}`,\n          result.status || 1,\n          result.stderr || \"\"\n        )\n      }\n    } catch (error) {\n      console.error(`[entire-integration] Hook error:`, error)\n      if (error instanceof EntireCLIError) {\n        throw error\n      }\n      throw new Error(`Failed to call hook '${hookName}': ${String(error)}`)\n    }\n  }\n\n  /**\n   * Show installation instructions\n   */\n  showInstallInstructions(): void {\n    console.error(\"╭─────────────────────────────────────────────────╮\")\n    console.error(\"│  ⚠️  Entire CLI not found                       │\")\n    console.error(\"│                                                 │\")\n    console.error(\"│  Install with:                                  │\")\n    console.error(\"│    go install entire.io/cli/cmd/entire@latest   │\")\n    console.error(\"│                                                 │\")\n    console.error(\"│  Or visit: https://entire.io/cli                │\")\n    console.error(\"╰─────────────────────────────────────────────────╯\")\n  }\n\n  /**\n   * Show setup instructions\n   */\n  showSetupInstructions(directory: string): void {\n    console.error(\"╭─────────────────────────────────────────────────╮\")\n    console.error(\"│  ⚠️  Entire CLI not configured                  │\")\n    console.error(\"│                                                 │\")\n    console.error(\"│  Run from repository root:                      │\")\n    console.error(`│    cd ${directory}                              │`)\n    console.error(\"│    entire setup                                 │\")\n    console.error(\"│                                                 │\")\n    console.error(\"│  Session tracking is disabled until setup.      │\")\n    console.error(\"╰─────────────────────────────────────────────────╯\")\n  }\n}\n","structured