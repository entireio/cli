r\": async (_input, _output) => {\n        // TODO: Phase 2 - Implement task tracking\n      },\n    }\n  } catch (error) {\n    console.error(\"[entire-integration] Plugin initialization failed:\", error)\n    await logger.error(\"Plugin initialization failed\", {\n      error: String(error),\n      stack: error instanceof Error ? error.stack : undefined,\n    })\n    // Return empty hooks to prevent OpenCode from crashing\n    return {}\n  }\n}\n\n// Export for use in OpenCode\nexport default EntireIntegrationPlugin\n","structuredPatch":[{"oldStart":39,"oldLines":7,"newStart":39,"newLines":9,"lines":["   }"," ","   // Check if Entire CLI is configured in this repository","+  console.error(\"[entire-integration] Checking if setup...\")","   const isSetup = await entireCLI.isSetup(directory)","+  console.error(`[entire-integration] Is setup: ${isSetup}`)"," ","   if (!isSetup) {","     await logger.warn(\"Entire CLI not configured in this repository. Session tracking disabled.\", {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"210dab4e-4183-4d55-82b8-2cecbb546356"}
