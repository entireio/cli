pt_path: transcriptPath,\n        })\n\n        await logger.info(\"Session checkpoint saved\", { sessionID })\n      } catch (error) {\n        await logger.warn(\"Failed to save session checkpoint\", {\n          sessionID,\n          error: String(error),\n        })\n      }\n    },\n\n    /**\n     * Handle session.status event\n     * Could be used for periodic checkpoints (currently just logs)\n     */\n    async onSessionStatus({ event }: SessionEvent): Promise<void> {\n      const sessionID = event.properties.sessionID\n      if (!sessionID) {\n        return\n      }\n\n      await logger.debug(\"Session status update\", { sessionID })\n      // Future: could implement periodic checkpointing here\n    },\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":14,"cache_creation_input_tokens":92878,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":92878,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"}},"requestId":"req_011CWyeUMmKpcCFpfL75r1ko","type":"assistant","uuid":"96b70ba2-cc6d-4096-b38b-8b7a1226a1a3","timestamp":"2026-01-10T11:50:17.898Z"}
