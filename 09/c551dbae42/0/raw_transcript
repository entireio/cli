opencode-ai/plugin\"\nimport { EntireCLI } from \"./cli/entire\"\nimport { Logger } from \"./utils/logger\"\nimport { loadConfig, ensureConfigDirectory } from \"./utils/config\"\nimport { createSessionHooks } from \"./hooks/session\"\n\nexport const EntireIntegrationPlugin: Plugin = async (ctx) => {\n  const startTime = Date.now()\n  const { client, directory } = ctx\n\n  // Write a debug file to prove plugin is executing\n  const fs = await import(\"fs/promises\")\n  const path = await import(\"path\")\n\n  const logs: string[] = []\n  const log = (msg: string) => {\n    const elapsed = Date.now() - startTime\n    const line = `[${elapsed}ms] ${msg}`\n    console.error(`[entire-integration] ${line}`)\n    logs.push(line)\n  }\n\n  const writeDebug = async (filename: string, content: string) => {\n    try {\n      await fs.writeFile(path.join(directory, \".entire\", filename), content)\n    } catch (e) {\n      // Ignore\n    }\n  }\n\n  log(\"Plugin function called\")\n  await writeDebug(\"plugin-loaded.txt\", `Plugin loaded at ${new Date().toISOString()}\\n`)\n\n  const logger = new Logger(client)\n\n  try {\n    // Initialize Entire CLI wrapper\n    log(\"Creating EntireCLI instance\")\n    const entireCLI = new EntireCLI()\n\n    // Check if Entire CLI is installed\n    log(\"Checking if Entire CLI installed...\")\n    const hasEntire = await entireCLI.isInstalled()\n    log(`Entire CLI installed: ${hasEntire}`)\n\n  if (!hasEntire) {\n    await logger.error(\"Entire CLI not found. Session tracking disabled.\", {\n      installUrl: \"https://entire.io/cli\",\n      installCommand: \"go install entire.io/cli/cmd/entire@latest\",\n    })\n\n    // Show console error for visibility\n    entireCLI.showInstallInstructions()\n\n    // Return empty hooks (plugin loads but does nothing)\n    return {}\n  }\n\n  // Check if Entire CLI is configured in this repository\n  console.error(\"[entire-integration] Checking if setup...\")\n  const isSetup = await entireCLI.isSetup(directory)\n  console.error(`[entire-integration] Is setup: ${isSetup}`)\n\n  if (!isSetup) {\n    await logger.warn(\"Entire CLI not configured in this repository. Session tracking disabled.\", {\n      setupCommand: `cd ${directory} && entire setup`,\n      directory,\n    })\n\n    // Show console warning\n    entireCLI.showSetupInstructions(directory)\n\n    // Return empty hooks\n    return {}\n  }\n\n  // Load configuration\n  console.error(\"[entire-integration] Loading config...\")\n  const config = await loadConfig(directory)\n  console.error(\"[entire-integration] Config loaded\")\n\n  // Ensure .entire/opencode directory exists\n  console.error(\"[entire-integration] Ensuring config directory...\")\n  await ensureConfigDirectory(directory)\n  console.error(\"[entire-integration] Config directory ready\")\n\n  // Log successful initialization\n  console.error(\"[entire-integration] Logging initialization...\")\n  await logger.info(\"Entire CLI integration active\", {\n    directory,\n    config: {\n      task_tracking: config.enable_task_tracking,\n      todo_tracking: config.enable_todo_tracking,\n      export_transcripts: config.export_transcripts,\n    },\n  })\n  console.error(\"[entire-integration] Logger.info completed\")\n\n  // Create session hooks\n  log(\"Creating session hooks...\")\n  const sessionHooks = createSessionHooks(ctx, config, entireCLI, logger)\n  log(\"Session hooks created\")\n\n  log(`Creating unified event handler`)\n\n    // OpenCode expects a single \"event\" handler, not individual event keys\n    const pluginHooks = {\n      event: async ({ event }: { event: any }) => {\n        console.error(`[entire-integration] ⚡ EVENT: ${event.type}`)\n\n        if (event.type === \"session.created\") {\n          console.error(\"[entire-integration] Handling session.created\")\n          await sessionHooks.onSessionCreated({ event })\n        } else if (event.type === \"session.idle\") {\n          console.error(\"[entire-integration] Handling session.idle\")\n          await sessionHooks.onSessionIdle({ event })\n        } else if (event.type === \"session.status\") {\n          await sessionHooks.onSessionStatus({ event })\n        } else if (event.type === \"tool.execute.before\") {\n          console.error(\"[entire-integration] ⚡ tool.execute.before event!\")\n        } else if (event.type === \"tool.execute.after\") {\n          console.error(\"[entire-integration] ⚡ tool.execute.after event!\")\n        }\n      },\n    }\n\n    log(`Plugin hooks created`)\n    await writeDebug(\"hooks-returned.json\", JSON.stringify(Object.keys(pluginHooks), null, 2))\n    await writeDebug(\"plugin-timing.log\", logs.join(\"\\n\"))\n\n    log(\"Returning hooks to OpenCode\")\n    return pluginHooks\n  } catch (error) {\n    console.error(\"[entire-integration] Plugin initialization failed:\", error)\n    await logger.error(\"Plugin initialization failed\", {\n      error: String(error),\n      stack: error instanceof Error ? error.stack : undefined,\n    })\n    // Return empty hooks to prevent OpenCode from crashing\n    return {}\n  }\n}\n\n// Export for use in OpenCode\nexport default EntireIntegrationPlugin\n","structuredPatch":[{"oldStart":12,"oldLines":32,"newStart":12,"newLines":8,"lines":[" import { createSessionHooks } from \"./hooks/session\""," "," export const EntireIntegrationPlugin: Plugin = async (ctx) => {","-  const startTime = Date.now()","   const { client, directory } = ctx"," ","-  // Write a debug file to prove plugin is executing","-  const fs = await import(\"fs/promises\")","-  const path = await import(\"path\")","-","-  const logs: string[] = []","-  const log = (msg: string) => {","-    const elapsed = Date.now() - startTime","-    const line = `[${elapsed}ms] ${msg}`","-    console.error(`[entire-integration] ${line}`)","-    logs.push(line)","-  }","-","-  const writeDebug = async (filename: string, content: string) => {","-    try {","-      await fs.writeFile(path.join(directory, \".entire\", filename), content)","-    } catch (e) {","-      // Ignore","-    }","-  }","-","-  log(\"Plugin function called\")","-  await writeDebug(\"plugin-loaded.txt\", `Plugin loaded at ${new Date().toISOString()}\\n`)","-","   const logger = new Logger(client)"," ","   try {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"d133a9ce-b939-4cb1-9d2d-f54bc8db73f0"}
