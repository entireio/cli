       await logger.debug(\"Session created\", { sessionID })\n\n        // Export transcript and metadata\n        let transcriptPath = \"\"\n        if (config.export_transcripts) {\n          console.error(\"[entire-integration] Exporting transcript...\")\n          const exported = await exportTranscript(sessionID, client, directory)\n          transcriptPath = exported.path\n          console.error(`[entire-integration] Transcript exported to: ${transcriptPath}`)\n          await logger.debug(\"Exported transcript\", {\n            sessionID,\n            path: transcriptPath,\n            messageCount: exported.messageCount,\n          })\n\n          // Export session metadata\n          await exportMetadata(sessionID, event.properties.info, directory)\n        }\n\n        // Call entire hooks opencode session-start\n        console.error(`[entire-integration] Calling entire hooks opencode session-start...`)\n        await entireCLI.callHook(\"session-start\", {\n          session_id: sessionID,\n          session_ref: sessionID,\n          timestamp: new Date().toISOString(),\n          transcript_path: transcriptPath,\n        })\n        console.error(`[entire-integration] Hook call completed`)\n\n        await logger.info(\"Session tracking initialized\", { sessionID })\n      } catch (error) {\n        await logger.error(\"Failed to initialize session tracking\", {\n          sessionID,\n          error: String(error),\n        })\n      }\n    },\n\n    /**\n     * Handle session.idle event\n     * Saves checkpoint when session goes idle\n     */\n    async onSessionIdle({ event }: SessionEvent): Promise<void> {\n      console.error(\"[entire-integration] onSessionIdle called\")\n      const sessionID = event.properties.sessionID\n      console.error(`[entire-integration] Session ID: ${sessionID}`)\n      if (!sessionID) {\n        await logger.warn(\"session.idle event missing session ID\")\n        return\n      }\n\n      try {\n        console.erro