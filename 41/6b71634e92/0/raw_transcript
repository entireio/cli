tes a record to either the\n262\t// ctx-carried logger or, during migration, the package-level logger set by\n263\t// Init.\n264\t//\n265\t// The read lock is held across the legacy l.Log so Init/Close cannot close\n266\t// logBufWriter mid-write while a record is in flight. The ctx-logger path\n267\t// does not need the lock because the logger value in ctx is immutable for\n268\t// the lifetime of the request and the file closer fires only after\n269\t// ExecuteContext returns.\n270\tfunc log(ctx context.Context, level slog.Level, msg string, attrs ...any) {\n271\t\tmu.RLock()\n272\t\tdefer mu.RUnlock()\n273\t\n274\t\t// Migration bridge: when Init() set the global logger, route through\n275\t\t// the legacy path so per-command Init/Close still observe writes to\n276\t\t// the configured log file. Once all callers move to WithLogger, the\n277\t\t// global stays nil and this branch is unreachable — task 10 deletes it.\n278\t\tif logger != nil {\n279\t\t\tlegacyLog(ctx, logger, currentSessionID, level, msg, attrs...)\n280\t\t\treturn\n281\t\t}\n282\t\n283\t\tLoggerFromContext(ctx).Log(ctx, level, msg, attrs...)\n284\t}\n285\t\n286\t// legacyLog reproduces the pre-refactor attr extraction so that callers still\n287\t// invoking Init() observe the same record shape during migration.\n288\tfunc legacyLog(ctx context.Context, l *slog.Logger, globalSessionID string, level slog.Level, msg string, attrs ...any) {\n289\t\tvar allAttrs []any\n290\t\tif globalSessionID != \"\" {\n291\t\t\tallAttrs = append(allAttrs, slog.String(\"session_id\", globalSessionID))\n292\t\t}\n293\t\tfor _, a := range attrsFromContext(ctx, globalSessionID) {\n294\t\t\tallAttrs = append(allAttrs, a)\n295\t\t}\n296\t\tallAttrs = append(allAttrs, attrs...)\n297\t\tl.Log(nil, level, msg, allAttrs...) //nolint:staticcheck // nil context is intentional - attrs already extracted\n298\t}\n299\t\n300\t// --- New context-carried logger API ---\n301\t//\n302\t// These additions live alongside the existing globals during migration.\n303\t// Once all callers move to ctx-carried loggers, the globals + Init/Close above\n304\t// will be deleted.\n305\t\n306\t// Closer flushes and closes any IO held by a logger. Idempotent: safe to call\n307\t// multiple times. A no-op closer is returned when there is no IO to clean up.\n308\ttype Closer func() error\n309\t\n310\t// Options configures New.\n311\ttype Options struct {\n312\t\t// Output, if non-nil, is used directly. Tests pass *bytes.Buffer here.\n313\t\t// If nil, New returns a logger backed by a lazy writer that opens\n314\t\t// .entire/logs/entire.log on first write, falling back to stderr on\n315\t\t// failure (with a one-shot stderr warning).\n316\t\tOutput io.Writer\n317\t\n318\t\t// Level is the minimum slog level. Use ResolveLevel to compute from\n319\t\t// env + settings precedence.\n320\t\tLevel slog.Level\n321\t}\n322\t\n323\t// loggerCtxKey is the private context key for *slog.Logger.\n324\t// Type-distinct from contextKey to avoid collisions.\n325\ttype loggerCtxKey struct{}\n326\t\n327\t// New constructs a *slog.Logger and a matching Closer.\n328\t//\n329\t// When opts.Output is nil, the logger writes to .entire/logs/entire.log via\n330\t// a lazy writer that opens the file on first write and falls back to stderr\n331\t// on failure.\n332\t//\n333\t// The returned Closer flushes and closes the underlying file (if any). It is\n334\t// idempotent — main.go's defer is the canonical caller.\n335\tfunc New(ctx context.Context, opts Options) (*slog.Logger, Closer) {\n336\t\tif opts.Output != nil {\n337\t\t\treturn createLogger(opts.Output, opts.Level), noopCloser\n338\t\t}\n339\t\tlw := newLazyWriter(ctx)\n340\t\treturn createLogger(lw, opts.Level), lw.Close\n341\t}\n342\t\n343\t// WithLogger stores l in ctx so LoggerFromContext can retrieve it later.\n344\tfunc WithLogger(ctx context.Context, l *slog.Logger) context.Context {\n345\t\tif l == nil {\n346\t\t\treturn ctx\n347\t\t}\n348\t\treturn context.WithValue(ctx, loggerCtxKey{}, l)\n349\t}\n350\t\n351\t// LoggerFromContext returns the logger stored by WithLogger, or slog.Default()\n352\t// when none is present. Never returns nil.\n353\tfunc LoggerFromContext(ctx context.Context) *slog.Logger {\n354\t\tif ctx == nil {\n355\t\t\treturn slog.Default()\n356\t\t}\n357\t\tif l, ok := ctx.Value(loggerCtxKey{}).(*slog.Logger); ok && l != nil {\n358\t\t\treturn l\n359\t\t}\n360\t\treturn slog.Default()\n361\t}\n362\t\n363\t// ResolveLevel computes the effective slog.Level using env > settings > Info\n364\t// precedence. Empty inputs are skipped; invalid inputs fall back to Info.\n365\tfunc ResolveLevel(envValue, settingsValue string) slog.Level {\n366\t\tfor _, v := range []string{envValue, settingsValue} {\n367\t\t\tif v == \"\" {\n368\t\t\t\tcontinue\n369\t\t\t}\n370\t\t\tif !isValidLogLevel(v) {\n371\t\t\t\tfmt.Fprintf(os.Stderr, \"[entire] Warning: invalid log level %q, defaulting to INFO\\n\", v)\n372\t\t\t\treturn slog.LevelInfo\n373\t\t\t}\n374\t\t\treturn parseLogLevel(v)\n375\t\t}\n376\t\treturn slog.LevelInfo\n377\t}\n378\t\n379\tfunc noopCloser() error { return nil }\n380\t\n381\t// lazyWriter opens .entire/logs/entire.log on first write, falling back to\n382\t// stderr if the open fails. Subsequent writes go to the chosen target.\n383\t//\n384\t// Designed so that invocations that emit no log lines (e.g., entire --version)\n385\t// never create the file. Closer is sync.Once-guarded; safe to call multiple\n386\t// times.\n387\ttype lazyWriter struct {\n388\t\tctx       context.Context\n389\t\topenOnce  sync.Once\n390\t\tcloseOnce sync.Once\n391\t\n392\t\ttarget  io.Writer\n393\t\tflush   func() error\n394\t\tcloseFn func() error\n395\t}\n396\t\n397\tfunc newLazyWriter(ctx context.Context) *lazyWriter {\n398\t\tif ctx == nil {\n399\t\t\tctx = context.Background()\n400\t\t}\n401\t\treturn &lazyWriter{ctx: ctx}\n402\t}\n403\t\n404\t// Write implements io.Writer. The first call resolves the underlying target\n405\t// (file or st