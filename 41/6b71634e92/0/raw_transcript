le, logBufWriter, and currentSessionID\n58\t\tmu sync.RWMutex\n59\t\n60\t\t// logLevelGetter is an optional callback to get log level from settings.\n61\t\t// Set by SetLogLevelGetter before Init is called.\n62\t\tlogLevelGetter func() string\n63\t)\n64\t\n65\t// SetLogLevelGetter sets a callback function to get the log level from settings.\n66\t// This allows the logging package to read settings without a circular dependency.\n67\t// The callback is only used if ENTIRE_LOG_LEVEL env var is not set.\n68\tfunc SetLogLevelGetter(getter func() string) {\n69\t\tmu.Lock()\n70\t\tdefer mu.Unlock()\n71\t\tlogLevelGetter = getter\n72\t}\n73\t\n74\t// Init initializes the logger for a session, writing JSON logs to\n75\t// .entire/logs/entire.log.\n76\t//\n77\t// If sessionID is non-empty, it is stored as an slog attribute on every log line for filtering.\n78\t// If the log file cannot be created, falls back to stderr.\n79\t// Log level is controlled by ENTIRE_LOG_LEVEL environment variable.\n80\tfunc Init(ctx context.Context, sessionID string) error {\n81\t\t// Validate session ID if provided (used only for the slog attribute, not the filename)\n82\t\tif sessionID != \"\" {\n83\t\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n84\t\t\t\treturn fmt.Errorf(\"invalid session ID for logging: %w\", err)\n85\t\t\t}\n86\t\t}\n87\t\n88\t\tmu.Lock()\n89\t\tdefer mu.Unlock()\n90\t\n91\t\t// Close any existing log file (flush buffer first)\n92\t\tif logBufWriter != nil {\n93\t\t\t_ = logBufWriter.Flush()\n94\t\t\tlogBufWriter = nil\n95\t\t}\n96\t\tif logFile != nil {\n97\t\t\t_ = logFile.Close()\n98\t\t\tlogFile = nil\n99\t\t}\n100\t\n101\t\t// Get log level from environment first, then settings\n102\t\tlevelStr := os.Getenv(LogLevelEnvVar)\n103\t\tif levelStr == \"\" && logLevelGetter != nil {\n104\t\t\tlevelStr = logLevelGetter()\n105\t\t}\n106\t\tlevel := parseLogLevel(levelStr)\n107\t\n108\t\t// Warn if invalid level was provided\n109\t\tif levelStr != \"\" && !