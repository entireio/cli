TIRE_LOG_LEVEL\"\n48\t\n49\t// LogsDir is the directory where log files are stored (relative to repo root).\n50\tconst LogsDir = \".entire/logs\"\n51\t\n52\t// Closer flushes and closes any IO held by a logger. Idempotent: safe to call\n53\t// multiple times. A no-op closer is returned when there is no IO to clean up.\n54\ttype Closer func() error\n55\t\n56\t// Options configures New.\n57\ttype Options struct {\n58\t\t// Output, if non-nil, is used directly. Tests pass *bytes.Buffer here.\n59\t\t// If nil, New returns a logger backed by a lazy writer that opens\n60\t\t// .entire/logs/entire.log on first write, falling back to stderr on\n61\t\t// failure (with a one-shot stderr warning).\n62\t\tOutput io.Writer\n63\t\n64\t\t// Level is the minimum slog level. Use ResolveLevel to compute from\n65\t\t// env + settings precedence.\n66\t\tLevel slog.Level\n67\t}\n68\t\n69\t// loggerCtxKey is the private context key for *slog.Logger.\n70\t// Type-distinct from contextKey to avoid collisions.\n71\ttype loggerCtxKey struct{}\n72\t\n73\t// New constructs a *slog.Logger and a matching Closer.\n74\t//\n75\t// When opts.Output is nil, the logger writes to .entire/logs/entire.log via\n76\t// a lazy writer that opens the file on first write and falls back to stderr\n77\t// on failure.\n78\t//\n79\t// The returned Closer flushes and closes the underlying file (if any). It is\n80\t// idempotent — main.go's defer is the canonical caller.\n81\tfunc New(ctx context.Context, opts Options) (*slog.Logger, Closer) {\n82\t\tif opts.Output != nil {\n83\t\t\treturn createLogger(opts.Output, opts.Level), noopCloser\n84\t\t}\n85\t\tlw := newLazyWriter(ctx)\n86\t\treturn createLogger(lw, opts.Level), lw.Close\n87\t}\n88\t\n89\t// WithLogger stores l in ctx so LoggerFromContext can retrieve it later.\n90\tfunc WithLogger(ctx context.Context, l *slog.Logger) context.Context {\n91\t\tif l == nil {\n92\t\t\treturn ctx\n93\t\t}\n94\t\treturn context.WithValue(ctx, loggerCtxKey{}, l)\n95\t}\n96\t\n97\t// LoggerFromContext returns the logger stored by WithLogger, or slog.Default()\n98\t// when none is present. Never returns nil.\n99\tfunc LoggerFromContext(ctx context.Context) *slog.Logger {\n100\t\tif ctx == nil {\n101\t\t\treturn slog.Default()\n102\t\t}\n103\t\tif l, ok := ctx.Value(loggerCtxKey{}).(*slog.Logger); ok && l != nil {\n104\t\t\treturn l\n105\t\t}\n106\t\treturn slog.Default()\n107\t}\n108\t\n109\t// ResolveLevel computes the effective slog.Level using env > settings > Info\n110\t// precedence. Empty inputs are skipped; invalid inputs fall back to Info.\n111\tfunc ResolveLevel(envValue, settingsValue string) slog.Level {\n112\t\tfor _, v := range []string{envValue, settingsValue} {\n113\t\t\tif v == \"\" {\n114\t\t\t\tcontinue\n115\t\t\t}\n116\t\t\tif !isValidLogLevel(v) {\n117\t\t\t\tfmt.Fprintf(os.Stderr, \"[entire] Warning: invalid log level %q, defaulting to INFO\\n\", v)\n118\t\t\t\treturn slog.LevelInfo\n119\t\t\t}\n120\t\t\treturn parseLogLevel(v)\n121\t\t}\n122\t\treturn slog.LevelInfo\n123\t}\n124\t\n125\tfunc noopCloser() error { return nil }\n126\t\n127\t// createLogger creates a JSON logger writing to the given writer at the specified level.\n128\tfunc createLogger(w io.Writer, level slog.Level) *slog.Logger {\n129\t\topts := &slog.HandlerOptions{\n130\t\t\tLevel: level,\n131\t\t}\n132\t\thandler := slog.NewJSONHandler(w, opts)\n133\t\treturn slog.New(handler)\n134\t}\n135\t\n136\t// parseLogLevel parses a log level string to slog.Level.\n137\t// Returns slog.LevelInfo for empty or invalid values.\n138\tfunc parseLogLevel(s string) slog.Level {\n139\t\tswitch strings.ToUpper(strings.TrimSpace(s)) {\n140\t\tcase \"DEBUG\":\n141\t\t\treturn slog.LevelDebug\n142\t\tcase \"INFO\":\n143\t\t\treturn slog.LevelInfo\n144\t\tcase \"WARN\", \"WARNING\":\n145\t\t\treturn slog.LevelWarn\n146\t\tcase \"ERROR\":\n147\t\t\treturn slog.LevelError\n148\t\tdefault:\n149\t\t\treturn slog.LevelInfo\n150\t\t}\n151\t}\n152\t\n153\t// isValidLogLevel checks if the given string is a valid log level.\n154\tfunc isValidLogLevel(s string) bool {\n155\t\tswitch strings.ToUpper(strings.TrimSpace(s)) {\n156\t\tcase \"DEBUG\", \"INFO\", \"WARN\", \"WARNING\", \"ERROR\", \"\":\n157\t\t\treturn true\n158\t\tdefault:\n159\t\t\treturn false\n160\t\t}\n161\t}\n162\t\n163\t// Debug logs at DEBUG level using the ctx-carried logger.\n164\tfunc Debug(ctx context.Context, msg string, attrs ...any) {\n165\t\tlog(ctx, slog.LevelDebug, msg, attrs...)\n166\t}\n167\t\n168\t// Info logs at INFO level using the ctx-carried logger.\n169\tfunc Info(ctx context.Context, msg string, attrs ...any) {\n170\t\tlog(ctx, slog.LevelInfo, msg, attrs...)\n171\t}\n172\t\n173\t// Warn logs at WARN level using the ctx-carried logger.\n174\tfunc Warn(ctx context.Context, msg string, attrs ...any) {\n175\t\tlog(ctx, slog.LevelWarn, msg, attrs...)\n176\t}\n177\t\n178\t// Error logs at ERROR level using the ctx-carried logger.\n179\tfunc Error(ctx context.Context, msg string, attrs ...any) {\n180\t\tlog(ctx, slog.LevelError, msg, attrs...)\n181\t}\n182\t\n183\t// LogDuration logs a message with duration_ms calculated from the start time.\n184\t// Designed for use with defer:\n185\t//\n186\t//\tdefer logging.LogDuration(ctx, slog.LevelInfo, \"operation completed\", time.Now())\n187\tfunc LogDuration(ctx context.Context, level slog.Level, msg string, start time.Time, attrs ...any) {\n188\t\tdurationMs := time.Since(start).Milliseconds()\n189\t\tallAttrs := make([]any, 0, len(attrs)+1)\n190\t\tallAttrs = append(allAttrs, slog.Int64(\"duration_ms\", durationMs))\n191\t\tallAttrs = append(allAttrs, attrs...)\n192\t\tlog(ctx, level, msg, allAttrs...)\n193\t}\n194\t\n195\t// log routes a record to the ctx-carried logger, materialising the typed-key\n196\t// enrichment attrs (session_id, component, …) from ctx as slog.Attrs.\n197\t//\n198\t// The logger value in ctx is immutable for the lifetime of the request and the\n199\t// file closer fires only after main.go's defer