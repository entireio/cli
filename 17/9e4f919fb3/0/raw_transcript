ldDispatchRepoOptions(slugs []string) []huh.Option[string] {\n491\t\tsort.Strings(slugs)\n492\t\toptions := make([]huh.Option[string], 0, len(slugs))\n493\t\tseen := make(map[string]struct{}, len(slugs))\n494\t\tfor _, slug := range slugs {\n495\t\t\tif slug == \"\" {\n496\t\t\t\tcontinue\n497\t\t\t}\n498\t\t\tif _, ok := seen[slug]; ok {\n499\t\t\t\tcontinue\n500\t\t\t}\n501\t\t\tseen[slug] = struct{}{}\n502\t\t\toptions = append(options, huh.NewOption(slug, slug))\n503\t\t}\n504\t\treturn options\n505\t}\n506\t\n507\tfunc buildDispatchOrgOptions(names []string) []huh.Option[string] {\n508\t\tsort.Strings(names)\n509\t\toptions := make([]huh.Option[string], 0, len(names))\n510\t\tseen := make(map[string]struct{}, len(names))\n511\t\tfor _, name := range names {\n512\t\t\tname = strings.TrimSpace(name)\n513\t\t\tif name == \"\" {\n514\t\t\t\tcontinue\n515\t\t\t}\n516\t\t\tif _, ok := seen[name]; ok {\n517\t\t\t\tcontinue\n518\t\t\t}\n519\t\t\tseen[name] = struct{}{}\n520\t\t\toptions = append(options, huh.NewOption(name, name))\n521\t\t}\n522\t\treturn options\n523\t}\n524\t\n525\tfunc normalizeDispatchWizardSelections(values []string) []string {\n526\t\tnormalized := make([]string, 0, len(values))\n527\t\tseen := make(map[string]struct{}, len(values))\n528\t\tfor _, value := range values {\n529\t\t\tvalue = strings.TrimSpace(value)\n530\t\t\tif value == \"\" {\n531\t\t\t\tcontinue\n532\t\t\t}\n533\t\t\tif _, ok := seen[value]; ok {\n534\t\t\t\tcontinue\n535\t\t\t}\n536\t\t\tseen[value] = struct{}{}\n537\t\t\tnormalized = append(normalized, value)\n538\t\t}\n539\t\treturn normalized\n540\t}\n541\t\n542\tfunc discoverLocalRepoRoots(ctx context.Context, currentRepo string) []string {\n543\t\trootSet := map[string]struct{}{currentRepo: {}}\n544\t\tparent := filepath.Dir(currentRepo)\n545\t\n546\t\tentries, err := os.ReadDir(parent)\n547\t\tif err == nil {\n548\t\t\tcandidates := make([]string, 0, len(entries))\n549\t\t\tfor _, entry := range entries {\n550\t\t\t\tif !entry.IsDir() {\n551\t\t\t\t\tcontinue\n552\t\t\t\t}\n553\t\t\t\tcandidate := filepath.Join(parent, entry.Name())\n554\t\t\t\tif _, statErr := os.Stat(filepath.Join(candidate, \".git\")); statErr != nil {\n555\t\t\t\t\tcontinue\n556\t\t\t\t}\n557\t\t\t\tcandidates = append(candidates, candidate)\n558\t\t\t}\n559\t\n560\t\t\tresolved := make([]string, len(candidates))\n561\t\t\tsem := make(chan struct{}, dispatchWizardRepoDiscoveryConcurrencyLimit)\n562\t\t\tvar wg sync.WaitGroup\n563\t\t\twg.Add(len(candidates))\n564\t\t\tfor i, candidate := range candidates {\n565\t\t\t\tsem <- struct{}{}\n566\t\t\t\tgo func(i int, candidate string) {\n567\t\t\t\t\tdefer wg.Done()\n568\t\t\t\t\tdefer func() { <-sem }()\n569\t\t\t\t\tif repoRoot, resolveErr := resolveDispatchWizardTopLevel(ctx, candidate); resolveErr == nil {\n570\t\t\t\t\t\tresolved[i] = repoRoot\n571\t\t\t\t\t}\n572\t\t\t\t}(i, candidate)\n573\t\t\t}\n574\t\t\twg.Wait()\n575\t\t\tfor _, repoRoot := range resolved {\n576\t\t\t\tif repoRoot != \"\" {\n577\t\t\t\t\trootSet[repoRoot] = struct{}{}\n578\t\t\t\t}\n579\t\t\t}\n580\t\t}\n581\t\n582\t\trepoRoots := make([]string, 0, len(rootSet))\n583\t\tfor repoRoot := range rootSet {\n584\t\t\trepoRoots = append(repoRoots, repoRoot)\n585\t\t}\n586\t\tsort.Slice(repoRoots, func(i, j int) bool {\n587\t\t\tif repoRoots[i] == currentRepo {\n588\t\t\t\treturn true\n589\t\t\t}\n590\t\t\tif repoRoots[j] == currentRepo {\n591\t\t\t\treturn false\n592\t\t\t}\n593\t\t\treturn filepath.Base(repoRoots[i]) < filepath.Base(repoRoots[j])\n594\t\t})\n595\t\treturn repoRoots\n596\t}\n597\t\n598\tfunc discoverLocalRepoSlugs(ctx context.Context, currentRepo string) []string {\n599\t\trepoRoots := discoverLocalRepoRoots(ctx, currentRepo)\n600\t\trepoSlugs := make([]string, 0, len(repoRoots))\n601\t\tseenRepoSlugs := make(map[string]struct{}, len(repoRoots))\n602\t\tfor _, repoRoot := range repoRoots {\n603\t\t\trepoSlug := discoverRepoSlug(repoRoot)\n604\t\t\tif repoSlug == \"\" {\n605\t\t\t\tcontinue\n606\t\t\t}\n607\t\t\tif _, ok := seenRepoSlugs[repoSlug]; ok {\n608\t\t\t\tcontinue\n609\t\t\t}\n610\t\t\tseenRepoSlugs[repoSlug] = struct{}{}\n611\t\t\trepoSlugs = append(repoSlugs, repoSlug)\n612\t\t}\n613\t\treturn repoSlugs\n614\t}\n615\t\n616\tfunc resolveGitTopLevel(ctx context.Context, path string) (string, error) {\n617\t\tcmd := exec.CommandContext(ctx, \"git\", \"-C\", path, \"rev-parse\", \"--show-toplevel\")\n618\t\toutput, err := cmd.Output()\n619\t\tif err != nil {\n620\t\t\treturn \"\", fmt.Errorf(\"git rev-parse --show-toplevel: %w\", err)\n621\t\t}\n622\t\treturn strings.TrimSpace(string(output)), nil\n623\t}\n624\t\n625\tfunc discoverAuthenticatedDispatchWizardOrgs(ctx context.Context) ([]string, error) {\n626\t\tcmd := exec.CommandContext(ctx, \"gh\", \"api\", \"user/orgs\", \"--jq\", \".[].login\")\n627\t\toutput, err := cmd.Output()\n628\t\tif err != nil {\n629\t\t\treturn nil, fmt.Errorf(\"gh api user/orgs: %w\", err)\n630\t\t}\n631\t\n632\t\torgs := make([]string, 0)\n633\t\tfor _, line := range strings.Split(string(output), \"\\n\") {\n634\t\t\tline = strings.TrimSpace(line)\n635\t\t\tif line != \"\" {\n636\t\t\t\torgs = append(orgs, line)\n637\t\t\t}\n638\t\t}\n639\t\tsort.Strings(orgs)\n640\t\treturn orgs, nil\n641\t}\n642\t\n643\tfunc discoverAuthenticatedDispatchWizardRepos(ctx context.Context) ([]string, error) {\n644\t\tcmd := exec.CommandContext(\n645\t\t\tctx,\n646\t\t\t\"gh\",\n647\t\t\t\"api\",\n648\t\t\t\"--paginate\",\n649\t\t\t\"user/repos?per_page=100&affiliation=owner,collaborator,organization_member&sort=full_name\",\n650\t\t\t\"--jq\",\n651\t\t\t\".[].full_name\",\n652\t\t)\n653\t\toutput, err := cmd.Output()\n654\t\tif err != nil {\n655\t\t\treturn nil, fmt.Errorf(\"gh api user/repos: %w\", err)\n656\t\t}\n657\t\n658\t\trepos := make([]string, 0)\n659\t\tseen := make(map[string]struct{})\n660\t\tfor _, line := range strings.Split(string(output), \"\\n\") {\n661\t\t\tline = strings.TrimSpace(line)\n662\t\t\tif line