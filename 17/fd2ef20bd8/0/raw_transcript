orktreePath:        \"/some/other/worktree\",\n309\t\t\tStartedAt:           newer,\n310\t\t\tLastInteractionTime: &newer,\n311\t\t\tPhase:               \"idle\",\n312\t\t}\n313\t\n314\t\t// Session from current worktree (older)\n315\t\tcurrentWorktree := &SessionState{\n316\t\t\tSessionID:           \"current-worktree-session\",\n317\t\t\tBaseCommit:          \"xyz7890\",\n318\t\t\tWorktreePath:        resolvedDir, // matches current worktree\n319\t\t\tStartedAt:           older,\n320\t\t\tLastInteractionTime: &older,\n321\t\t\tPhase:               \"idle\",\n322\t\t}\n323\t\n324\t\tif err := SaveSessionState(context.Background(), otherWorktree); err != nil {\n325\t\t\tt.Fatalf(\"SaveSessionState() error = %v\", err)\n326\t\t}\n327\t\tif err := SaveSessionState(context.Background(), currentWorktree); err != nil {\n328\t\t\tt.Fatalf(\"SaveSessionState() error = %v\", err)\n329\t\t}\n330\t\n331\t\t// FindMostRecentSession should return the current worktree's session,\n332\t\t// not the other worktree's session (even though it's more recent).\n333\t\tresult := FindMostRecentSession(context.Background())\n334\t\tif result != \"current-worktree-session\" {\n335\t\t\tt.Errorf(\"FindMostRecentSession(context.Background()) = %q, want %q (should prefer current worktree)\",\n336\t\t\t\tresult, \"current-worktree-session\")\n337\t\t}\n338\t}\n339\t\n340\t// TestFindMostRecentSession_FallsBackWhenNoWorktreeMatch tests that\n341\t// FindMostRecentSession falls back to all sessions when none match the current worktree.\n342\tfunc TestFindMostRecentSession_FallsBackWhenNoWorktreeMatch(t *testing.T) {\n343\t\tdir := t.TempDir()\n344\t\t_, err := git.PlainInit(dir, false)\n345\t\tif err != nil {\n346\t\t\tt.Fatalf(\"failed to init git repo: %v\", err)\n347\t\t}\n348\t\n349\t\tt.Chdir(dir)\n350\t\n351\t\tnewer := time.Now()\n352\t\n353\t\t// Session from a different worktree only (no sessions for current worktree)\n354\t\totherWorktree := &SessionState{\n355\t\t\tSessionID:        