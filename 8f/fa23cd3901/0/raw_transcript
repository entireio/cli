   554\t\t\treturn fmt.Errorf(\"review run: %w\", waitErr)\n   555\t\t}\n   556\t\treturn nil\n   557\t}\n   558\t\n   559\t// handlePickerError maps multi-picker error sentinels to the appropriate\n   560\t// command-layer response.\n   561\t//   - ErrPickerCancelled → return nil (user cancelled; no error shown)\n   562\t//   - ErrNoAgentsSelected → surface error to user\n   563\t//   - other errors → surface to user\n   564\tfunc handlePickerError(cmd *cobra.Command, silentErr func(error) error, pickErr error) error {\n   565\t\tif errors.Is(pickErr, ErrPickerCancelled) {\n   566\t\t\treturn nil\n   567\t\t}\n   568\t\tcmd.SilenceUsage = true\n   569\t\tfmt.Fprintln(cmd.ErrOrStderr(), pickErr.Error())\n   570\t\treturn silentErr(pickErr)\n   571\t}\n   572\t\n   573\t// multiAgentSinkInputs collects the parameters composeMultiAgentSinks needs.\n   574\t// It exists so tests can drive the helper with explicit isTTY / canPrompt\n   575\t// values instead of monkey-patching interactive helpers at run time.\n   576\t//\n   577\t// isTTY here means \"the TUI sink is safe to compose\" — production callers\n   578\t// AND IsTerminalWriter(out) with CanPromptInteractively() before passing\n   579\t// it in, since the TUI both writes ANSI to stdout AND reads keypresses\n   580\t// from stdin. A terminal-stdout-but-non-interactive-stdin scenario (an\n   581\t// agent host like Claude Code invoking `entire review`) must NOT use the\n   582\t// TUI — its dismissal loop would block forever.\n   583\ttype multiAgentSinkInputs struct {\n   584\t\tout               io.Writer\n   585\t\tisTTY             bool\n   586\t\tcanPrompt         bool\n   587\t\tagentNames        []string\n   588\t\tcancelRun         context.CancelFunc\n   589\t\trunContext        context.Context\n   590\t\tsynthesisProvider SynthesisProvider\n   591\t\tpromptYN          func(ctx context.Context, question string, def bool) (bool, error)\n   592\t\tperRunPrompt      string\n   593\t\tonSynthesisResult func(result string)\n   594\t}\n   595\t\n   596\ttype singleAgentSinkInputs struct {\n   597\t\tout       io.Writer\n   598\t\tisTTY     bool\n   599\t\tcanPrompt bool\n   600\t\tagentName string\n   601\t\tcancelRun context.CancelFunc\n   602\t}\n   603\t\n   604\t// composeMultiAgentSinks builds the sink slice for a multi-agent run.\n   605\t//\n   606\t//   - Non-TTY: [DumpSink] alone — narrative dump only, no live UI, no prompts.\n   607\t//   - TTY: [TUISink, DumpSink, SynthesisSink?] — TUI owns the live dashboard;\n   608\t//     DumpSink renders the post-run narrative; SynthesisSink (if a provider is\n   609\t//     configured AND stdin can prompt) appends the y/N synthesis offer.\n   610\t//\n   611\t// The synthesis sink is only appended when canPrompt is true: without a\n   612\t// promptable stdin, the y/N form would never resolve. SynthesisSink also\n   613\t// guards on InputTTY internally (defense in depth) but suppressing it here\n   614\t// avoids constructing a sink that will silently no-op.\n   615\tfunc composeMultiAgentSinks(in multiAgentSinkInputs) []reviewtypes.Sink {\n   616\t\tif !in.isTTY {\n   617\t\t\treturn []reviewtypes.Sink{DumpSink{W: in.out}}\n   618\t\t}\n   619\t\tsinks := []reviewtypes.Sink{\n   620\t\t\tNewTUISink(in.agentNames, in.cancelRun, in.out),\n   621\t\t\tDumpSink{W: in.out},\n   622\t\t}\n   623\t\tif in.synthesisProvider != nil && in.canPrompt {\n   624\t\t\tsinks = append(sinks, SynthesisSink{\n   625\t\t\t\tProvider:     in.synthesisProvider,\n   626\t\t\t\tWriter:       in.out,\n   627\t\t\t\tInputTTY:     in.canPrompt,\n   628\t\t\t\tPromptYN:     in.promptYN,\n   629\t\t\t\tPerRunPrompt: in.perRunPrompt,\n   630\t\t\t\tRunContext:   in.runContext,\n   631\t\t\t\tOnResult:     in.onSynthesisResult,\n   632\t\t\t})\n   633\t\t}\n   634\t\treturn sinks\n   635\t}\n   636\t\n   637\tfunc writePostReviewManifest(\n   638\t\tctx context.Context,\n   639\t\tout io.Writer,\n   640\t\tworktreeRoot string,\n   641\t\theadSHA str