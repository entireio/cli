= deps.ReviewCheckpointContext(ctx, worktreeRoot, scopeBaseRef)\n   479\t\t}\n   480\t\n   481\t\t// Build per-agent reviewers with individual RunConfigs (each agent has\n   482\t\t// its own skills + always-prompt from s.Review[name]).\n   483\t\treviewers := make([]reviewtypes.AgentReviewer, 0, len(picked.Names))\n   484\t\tfor _, name := range picked.Names {\n   485\t\t\tagentCfg := s.Review[name] // zero value is safe (empty skills/prompt)\n   486\t\t\treviewer := deps.ReviewerFor(name)\n   487\t\t\tif reviewer == nil {\n   488\t\t\t\t// Shouldn't happen given launchableEligible was filtered for\n   489\t\t\t\t// ReviewerFor != nil, but be defensive.\n   490\t\t\t\tcmd.SilenceUsage = true\n   491\t\t\t\treturn silentErr(fmt.Errorf(\"agent %q is not launchable but appeared in eligible list\", name))\n   492\t\t\t}\n   493\t\t\t// Wrap the reviewer so it sees the per-agent RunConfig at Start time.\n   494\t\t\t// We cannot pass a different RunConfig per reviewer in RunMulti's\n   495\t\t\t// current API (all reviewers share one RunConfig). Instead, build a\n   496\t\t\t// configuredReviewer adapter that injects per-agent skills into\n   497\t\t\t// RunConfig before forwarding to the underlying reviewer.\n   498\t\t\treviewers = append(reviewers, &perAgentConfiguredReviewer{\n   499\t\t\t\tinner: reviewer,\n   500\t\t\t\tcfg: runConfigWithReviewConfig(reviewtypes.RunConfig{\n   501\t\t\t\t\tPerRunPrompt:      picked.PerRun,\n   502\t\t\t\t\tScopeBaseRef:      scopeBaseRef,\n   503\t\t\t\t\tCheckpointContext: checkpointContext,\n   504\t\t\t\t\tStartingSHA:       headSHA,\n   505\t\t\t\t}, agentCfg),\n   506\t\t\t})\n   507\t\t}\n   508\t\n   509\t\t// Compose sinks based on TTY detection.\n   510\t\t// TTY mode: [TUISink, DumpSink] — TUI owns the live dashboard; DumpSink\n   511\t\t// renders the post-run narrative after TUI dismisses (RunFinished is called\n   512\t\t// on each sink in order, and TUISink.RunFinished blocks until user dismisses).\n   513\t\t// Non-