"\n    32\t)\n    33\t\n    34\t// perAgentState tracks the mutable accumulation for one agent during a\n    35\t// multi-agent run.\n    36\t//\n    37\t// Write paths (no mutex; the close-after-wait protocol below provides\n    38\t// happens-before for both):\n    39\t//   - waitErr and finishedAt are written by the per-agent forwarding\n    40\t//     goroutine after its proc.Events range loop exits, immediately before\n    41\t//     wg.Done.\n    42\t//   - All other mutable fields (events buffer, tokens, finishedSeen,\n    43\t//     finishedOk, sawRunError) are written from the single dispatch loop\n    44\t//     reading the fan-in channel.\n    45\t//\n    46\t// Read path: the main RunMulti goroutine reads every field only after\n    47\t// `for ev := range fanIn` returns, which is sequenced after wg.Wait →\n    48\t// close(fanIn) by the close goroutine. That sequencing is the\n    49\t// happens-before for both write paths.\n    50\t//\n    51\t// DO NOT add new writers from goroutines outside this protocol — adding\n    52\t// a third write path would require a mutex (or a redesign).\n    53\ttype perAgentState struct {\n    54\t\tname         string\n    55\t\tproc         reviewtypes.Process\n    56\t\tstartErr     error\n    57\t\tstartedAt    time.Time\n    58\t\tfinishedAt   time.Time\n    59\t\tbuffer       []reviewtypes.Event\n    60\t\ttokens       reviewtypes.Tokens\n    61\t\tfinishedSeen bool\n    62\t\tfinishedOk   bool\n    63\t\tsawRunError  bool\n    64\t\twaitErr      error\n    65\t}\n    66\t\n    67\t// taggedEvent associates a fan-in event with its originating agent index.\n    68\ttype taggedEvent struct {\n    69\t\tagentIdx int\n    70\t\tev       reviewtypes.Event\n    71\t}\n    72\t\n    73\t// RunMulti executes a multi-agent review. Each reviewer runs concurrently;\n    74\t// events from N agents are funneled into a single dispatch loop that calls\n    75\t// every sink's AgentEvent in arrival order from a single goroutine\n