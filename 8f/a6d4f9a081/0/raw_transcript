e|node>\",\n\t\tShort: \"Estimate the structural and historical blast radius of a change\",\n\t\tLong: `Walk dependency and ownership edges from the target and rank affected nodes.\nFor the POC the relations considered are 'contains' (siblings/descendants) and\n'touched_in' (files that share a checkpoint history with the target).\n\nExamples:\n  entire understand impact cmd/entire/cli/root.go\n  entire understand impact dir:cmd/entire/cli/understand`,\n\t\tArgs: cobra.ExactArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\treturn runUnderstandImpact(cmd.Context(), cmd.OutOrStdout(), args[0], jsonOut, maxAffected)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n\tcmd.Flags().IntVar(&maxAffected, \"max\", 30, \"Maximum number of affected nodes to list\")\n\treturn cmd\n}\n\ntype impactNeighbor struct {\n\tNodeID         string `json:\"node_id\"`\n\tPath           string `json:\"path,omitempty\"`\n\tType           string `json:\"type\"`\n\tReason         string `json:\"reason\"`\n\tSharedCps      int    `json:\"shared_checkpoints,omitempty\"`\n\tLastCheckpoint string `json:\"last_checkpoint,omitempty\"`\n\tLastAt         string `json:\"last_at,omitempty\"`\n\t// ConflictHint is a deterministic structural-direction-change marker.\n\t// Currently the only emitted hint is \"agent-flip\" — the most recent\n\t// cp's agent differs from the file's most-frequent agent — which is a\n\t// proxy for \"different author redoing or reverting prior work\".\n\t// Semantic-driven contradiction wording lights up when the synthesis\n\t// stage runs.\n\tConflictHint string `json:\"conflict_hint,omitempty\"`\n}\n\ntype impactReport struct {\n\tTarget              string           `json:\"target\"`\n\tNodeID              string           `json:\"node_id\"`\n\tAffected            []impactNeighbor `json:\"affected\"`\n\tTruncated           bool             `json:\"truncated,omitempty\"`\n\tStale               bool             `json:\"stale,omitempty\"`\n\tSemanticUnavailable bool             `json:\"semantic_unavailable,omitempty\"`\n}\n\nfunc runUnderstandImpact(ctx context.Context, w io.Writer, target string, jsonOut bool, maxAffected int) error {\n\tq, err := loadQueryEnv(ctx)\n\tif err != nil {\n\t\tif errors.Is(err, errNoUnderstandCache) {\n\t\t\tfmt.Fprintln(w, err.Error())\n\t\t\treturn nil\n\t\t}\n\t\treturn err\n\t}\n\tnode, err := q.resolveAreaNode(target)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\treport := impactReport{\n\t\tTarget:              target,\n\t\tNodeID:              node.ID,\n\t\tStale:               q.stale,\n\t\tSemanticUnavailable: q.semanticUnavailableNotice() != \"\",\n\t}\n\n\t// Collect \"shared checkpoint\" siblings: files that appear in the same\n\t// touched_in edge set as the target. Score by number of overlapping cps.\n\tshared := computeImpactSharedCheckpoints(q, node.ID)\n\n\t// Collect contains-descendants for area-style queries (dir:/repo:.).\n\tdescendants := q.descendantFiles(node.ID)\n\n\t// Merge and de-dupe (descendants take precedence over shared, since their\n\t// reason is structural rather than inferred).\n\tseen := map[string]bool{node.ID: true}\n\tfor _, d := range descendants {\n\t\tif seen[d.ID] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[d.ID] = true\n\t\treport.Affected = append(report.Affected, neighborFor(q, d, \"contains\"))\n\t}\n\t// Sort shared by overlap desc, recency desc.\n\ttype sharedEntry struct {\n\t\tnodeID string\n\t\tcount  int\n\t\tlastAt string\n\t}\n\tentries := make([]sharedEntry, 0, len(shared))\n\tfor id, count := range shared {\n\t\tif seen[id] {\n\t\t\tcontinue\n\t\t}\n\t\tvar lastAt string\n\t\tif cp := q.recentCheckpoint(id); cp != nil {\n\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n\t\t\t\tlastAt = at\n\t\t\t}\n\t\t}\n\t\tentries = append(entries, sharedEntry{nodeID: id, count: count, lastAt: lastAt})\n\t}\n\tsort.Slice(entries, func(i, j int) bool {\n\t\tif entries[i].count != entries[j].