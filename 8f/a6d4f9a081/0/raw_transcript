n\t)\n\n\tcmd := &cobra.Command{\n\t\tUse:   \"prime [<path>...]\",\n\t\tShort: \"Generate a priming packet for the next agent session\",\n\t\tLong: `Build a structural + historical priming packet to orient an agent at the\nstart of a new session.\n\nModes:\n  default        Print the markdown packet to stdout (use --json for machine output).\n  --exec --agent claude-code\n                 Launch the agent's CLI with the packet piped as stdin. Other\n                 agents are accepted by name but produce a \"not yet supported\"\n                 message rather than silently exec'ing.\n\nExamples:\n  entire understand prime\n  entire understand prime cmd/entire/cli/understand\n  entire understand prime --exec --agent claude-code`,\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\treturn runUnderstandPrime(cmd.Context(), cmd.OutOrStdout(), primeOptions{\n\t\t\t\tTargets:     args,\n\t\t\t\tJSONOut:     jsonOut,\n\t\t\t\tExec:        execMode,\n\t\t\t\tAgentName:   agentName,\n\t\t\t\tTopHotspots: topHotspots,\n\t\t\t})\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n\tcmd.Flags().BoolVar(&execMode, \"exec\", false, \"Launch the named agent with the packet on stdin\")\n\tcmd.Flags().StringVar(&agentName, \"agent\", \"\", \"Agent name for --exec (POC supports claude-code only)\")\n\tcmd.Flags().IntVar(&topHotspots, \"top-hotspots\", 8, \"Number of hotspot rows to include in the packet\")\n\treturn cmd\n}\n\ntype primeOptions struct {\n\tTargets     []string\n\tJSONOut     bool\n\tExec        bool\n\tAgentName   string\n\tTopHotspots int\n}\n\ntype primeTarget struct {\n\tInput  string   `json:\"input\"`\n\tNodeID string   `json:\"node_id,omitempty\"`\n\tPath   string   `json:\"path,omitempty\"`\n\tType   string   `json:\"type,omitempty\"`\n\tLastCp string   `json:\"last_cp,omitempty\"`\n\tLastAt string   `json:\"last_at,omitempty\"`\n\tNotes  []string `json:\"notes,omitempty\"`\n}\n\ntype primePacket struct {\n\tTitle    string        `json:\"title\"`\n\tTargets  []primeTarget `json:\"targets,omitempty\"`\n\tHotspots []hotspot     `json:\"hotspots,omitempty\"`\n\tNoCache  bool          `json:\"no_cache,omitempty\"`\n\tReason   string        `json:\"reason,omitempty\"`\n}\n\n// primeBinaryLookup is overridable from tests so --exec can be exercised\n// without a real CLI on PATH. Default uses exec.LookPath.\nvar primeBinaryLookup = exec.LookPath\n\n// primeRunner executes the prepared command. Tests can replace this with a\n// no-op to verify --exec composition without actually launching anything.\nvar primeRunner = runPrimeExec\n\nfunc runUnderstandPrime(ctx context.Context, w io.Writer, opts primeOptions) error {\n\tq, err := loadQueryEnv(ctx)\n\tif err != nil {\n\t\tif errors.Is(err, errNoUnderstandCache) {\n\t\t\tpacket := primePacket{NoCache: true, Reason: err.Error(), Title: \"no understand cache\"}\n\t\t\treturn emitPrimePacket(w, packet, opts)\n\t\t}\n\t\treturn err\n\t}\n\n\tpacket := buildPrimePacket(q, opts)\n\tif opts.Exec {\n\t\treturn execPrime(w, packet, opts)\n\t}\n\treturn emitPrimePacket(w, packet, opts)\n}\n\nfunc buildPrimePacket(q *queryEnv, opts primeOptions) primePacket {\n\tpkt := primePacket{Title: \"Entire understand priming packet\"}\n\n\tfor _, raw := range opts.Targets {\n\t\tt := primeTarget{Input: raw}\n\t\tif node, err := q.resolveAreaNode(raw); err == nil {\n\t\t\tt.NodeID = node.ID\n\t\t\tt.Path = node.Path\n\t\t\tt.Type = string(node.Type)\n\t\t\tif cp := q.recentCheckpoint(node.ID); cp != nil {\n\t\t\t\tt.LastCp = cp.Name\n\t\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n\t\t\t\t\tt.LastAt = at\n\t\t\t\t}\n\t\t\t}\n\t\t\t// Inline up to 3 sibling-via-checkpoint files as notes so the\n\t\t\t// agent sees what tends to move with this target.\n\t\t\tshared := computeImpactSharedCheckpoints(q, node.ID)\n\t\t\ttype entry struct {\n\t\t\t\tpath  string\n\t\t\t\tcount int\n\t\t\t}\n\t\t\tentries := make([]entry, 0, len(shared))\n\t\t\tfor id, c := range shared {\n\t\t\t\tif n := q.byID[id]; n != nil {\n\t\t\t\t\tentries = append(entries, entry{path: n.Path, count: c})\n\t\t\t\t}\n\t\t\t}\n\t\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].count > entries[j].count })\n\t\t\tfor i, e := range entries {\n\t\t\t\tif i >= 3 {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tt.Notes = append(t.Notes, fmt.Sprintf(\"often co-touched with `%s` (%d shared cps)\", e.path, e.count))\n\t\t\t}\n\t\t} else {\n\t\t\tt.Notes = []string{\"unresolved target — run `entire understand build` if missing\"}\n\t\t}\n\t\tpkt.Targets = append(pkt.Targets, t)\n\t}\n\n\t// Top hotspots regardless of targets — gives the agent a global picture.\n\ttop := opts.TopHotspots\n\tif top <= 0 {\n\t\ttop = 8\n\t}\n\tpkt.Hotspots = topHotspotsFor(q, top)\n\treturn pkt\n}\n\n// topHotspotsFor reuses the hotspots scoring from understand_hotspots.go but\n// inlines the loop here to avoid re-running the whole command and re-loading\n// the graph.\nfunc topHotspotsFor(q *queryEnv, n int) []hotspot {\n\tout := []hotspot{}\n\tfor fileID, cps := range q.touchedCps {\n\t\tnode := q.byID[fileID]\n\t\tif node == nil || node.Type != graph.NodeFile {\n\t\t\tcontinue\n\t\t}\n\t\tagents := map[string]struct{}{}\n\t\tfor _, cpID := range cps {\n\t\t\tif cp := q.byID[cpID]; cp != nil {\n\t\t\t\tif a, ok := cp.Attrs[\"agent\"].(string); ok && a != \"\" {\n\t\t\t\t\tagents[a] = struct{}{}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tout = append(out, hotspot{\n\t\t\tNodeID:          fileID,\n\t\t\tPath:            node.Path,\n\t\t\tCheckpointCount: len(cps),\n\t\t\tDistinctAgents:  len(agents),\n\t\t\tScore:           float64(len(cps)) + 0.5*float64(len(agents)),\n\t\t})\n\t}\n\tsort.Slice(out, func(i, j int) bool {\n\t\tif out[i].Score != out[j].Score {\n\t\t\treturn out[i].Score > out[j].Score\n\t\t}\n\t\treturn out[i].Path < out[j].Path\n\t})\n\tif len(out) > n {\n\t\tout = out[:n]\n\t}\n\treturn out\n}\n\nfunc emitPrimePacket(w io.Writer, p primePacket, opts primeOptions) error {\n\tif opts.JSONOut {\n\t\tdata, err := jsonutil.MarshalIndentWithNewline(p, \"\", \"  \")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"marshal prime packet: %w\", err)\n\t\t}\n\t\tif _, err := w.Write(data); err != nil {\n\t\t\treturn fmt.Errorf(\"write prime JSON: %w\", err)\n\t\t}\n\t\treturn nil\n\t}\n\tif p.NoCache {\n\t\tfmt.Fprintln(w, p.Reason)\n\t\treturn nil\n\t}\n\tfmt.Fprintf(w, \"# %s\\n\\n\", p.Title)\n\tif len(p.Targets) > 0 {\n\t\tfmt.Fprintln(w, \"## Targets\")\n\t\tfor _, t := range p.Targets {\n\t\t\tfmt.Fprintf(w, \"- **%s**\", t.Input)\n\t\t\tif t.Path != \"\" && t.Path != t.Input {\n\t\t\t\tfmt.Fprintf(w, \" → `%s`\", t.Path)\n\t\t\t}\n\t\t\tif t.Type != \"\" {\n\t\t\t\tfmt.Fprintf(w, \" _(%s)_\", t.Type)\n\t\t\t}\n\t\t\tif t.LastCp != \"\" {\n\t\t\t\tfmt.Fprintf(w, \"; last in `%s`\", t.LastCp)\n\t\t\t\tif t.LastAt != \"\" {\n\t\t\t\t\tfmt.Fprintf(w, \" at %s\", t.LastAt)\n\t\t\t\t}\n\t\t\t}\n\t\t\tfmt.Fprintln(w)\n\t\t\tfor _, note := range t.Notes {\n\t\t\t\tfmt.Fprintf(w, \"  - %s\\n\", note)\n\t\t\t}\n\t\t}\n\t\tfmt.Fprintln(w)\n\t}\n\tif len(p.Hotspots) > 0 {\n\t\tfmt.Fprintln(w, \"## Hotspots\")\n\t\tfor i, h := range p.Hotspots {\n\t\t\tfmt.Fprintf(w, \"%d. **%s** — score=%.1f (cps=%d, agents=%d)\\n\",\n\t\t\t\ti+1, h.Path, h.Score, h.CheckpointCount, h.DistinctAgents)\n\t\t}\n\t}\n\treturn nil\n}\n\n// execPrime piped the packet into a known agent integration. POC ships\n// claude-code only; other agents return a clear \"not yet supported\" message.\nfunc execPrime(w io.Writer, packet primePacket, opts primeOptions) error {\n\tif opts.AgentName == \"\" {\n\t\treturn errors.New(\"understand prime: --exec requires --agent <name>\")\n\t}\n\tif opts.AgentName != \"claude-code\" {\n\t\tfmt.Fprintf(w, \"agent %q is not yet supported for --exec; use the default packet output and pipe it manually.\\n\", opts.AgentName)\n\t\treturn nil\n\t}\n\tbinary, err := primeBinaryLookup(\"claude\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"claude CLI not on PATH: %w\", err)\n\t}\n\n\t// Render the packet as markdown for piping.\n\tvar sb strings.Builder\n\tif err := emitPrimePacket(&sb, packet, primeOptions{}); err != nil {\n\t\treturn err\n\t}\n\n\treturn primeRunner(binary, sb.String())\n}\n\n// runPrimeExec is the default --exec runner. It connects child stdin to the\n// packet and child stdout/stderr to the user's terminal so the agent runs\n// interactively.\nfunc runPrimeExec(binary, stdin string) error {\n\tcmd := exec.Command(binary)\n\tcmd.Stdin = strings.NewReader(stdin)\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\tif err := cmd.Run(); err != nil {\n\t\treturn fmt.Errorf(\"launch %s: %w\", binary, err)\n\t}\n\treturn nil\n}\n","structuredPatch":[{"oldStart":283,"oldLines":7,"newStart":283,"newLines":7,"lines":[" // packet and child stdout/stderr to the user's terminal so the agent runs"," // interactively."," func runPrimeExec(binary, stdin string) error {","-  cmd := exec.Command(binary)","+  cmd := exec.CommandContext(context.Background(), binary) //nolint:gosec // binary resolved via primeBinaryLookup","   cmd.Stdin = strings.NewReader(stdin)","   cmd.Stdout = os.Stdout","   cmd.Stderr = os.Stderr"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"0a353b5d-4833-44b3-878b-4464c1dd93f7","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
