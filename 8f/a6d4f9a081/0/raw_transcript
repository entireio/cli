.Errorf(\"retry prompt missing validation hint; got=%q\", fake.prompt(1))\n\t}\n}\n\nfunc TestSynthesize_RejectsNilValidator(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{}\n\ts := &Synthesizer{Generator: fake}\n\n\t_, err := s.Synthesize(context.Background(), SynthesisRequest{Prompt: \"x\"})\n\tif err == nil {\n\t\tt.Fatal(\"Synthesize: want error for nil validator\")\n\t}\n}\n\nfunc TestRunSharded_PreservesOrder(t *testing.T) {\n\tt.Parallel()\n\n\tvar calls atomic.Int32\n\n\tfake := &fakeGenerator{}\n\tfor range 5 {\n\t\tfake.responses = append(fake.responses, func(string) (string, error) {\n\t\t\tcalls.Add(1)\n\t\t\treturn `{\"tag\":\"ok\"}`, nil\n\t\t})\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\titems := []string{\"a\", \"b\", \"c\", \"d\", \"e\"}\n\touts, err := RunSharded(context.Background(), s, items, func(item string) SynthesisRequest {\n\t\treturn SynthesisRequest{Prompt: item, Validator: sampleValidator, Label: item}\n\t}, 2)\n\tif err != nil {\n\t\tt.Fatalf(\"RunSharded: %v\", err)\n\t}\n\tif got := calls.Load(); got != 5 {\n\t\tt.Errorf(\"calls=%d; want 5\", got)\n\t}\n\tfor i, want := range items {\n\t\tif outs[i].Item != want {\n\t\t\tt.Errorf(\"outs[%d].Item=%q; want %q\", i, outs[i].Item, want)\n\t\t}\n\t\tif outs[i].Result == nil || outs[i].Result.FellBack {\n\t\t\tt.Errorf(\"outs[%d].Result invalid: %+v\", i, outs[i].Result)\n\t\t}\n\t}\n}\n\nfunc TestRunSharded_ConcurrencyCap(t *testing.T) {\n\tt.Parallel()\n\n\tvar inflight atomic.Int32\n\tvar peak atomic.Int32\n\n\tfake := &fakeGenerator{}\n\tfor range 6 {\n\t\tfake.responses = append(fake.responses, func(string) (string, error) {\n\t\t\tcur := inflight.Add(1)\n\t\t\tdefer inflight.Add(-1)\n\t\t\tfor {\n\t\t\t\tprev := peak.Load()\n\t\t\t\tif cur <= prev || peak.CompareAndSwap(prev, cur) {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\ttime.Sleep(20 * time.Millisecond)\n\t\t\treturn `{\"tag\":\"ok\"}`, nil\n\t\t})\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\titems := []int{1, 2, 3, 4, 5, 6}\n\t_, err := RunSharded(context.Background(), s, items, func(int) SynthesisRequest {\n\t\treturn SynthesisRequest{Prompt: \"x\", Validator: sampleValidator, Label: \"x\"}\n\t}, 2)\n\tif err != nil {\n\t\tt.Fatalf(\"RunSharded: %v\", err)\n\t}\n\tif got := peak.Load(); got > 2 {\n\t\tt.Errorf(\"peak in-flight=%d; want <=2\", got)\n\t}\n}\n\nfunc TestRunSharded_FallbackPerShardDoesNotBlockOthers(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{}\n\t// 3 shards × 2 attempts each — first shard always fails twice, others succeed.\n\tfake.responses = append(fake.responses,\n\t\tfunc(string) (string, error) { return \"garbage\", nil },           // shard 1 attempt 1\n\t\tfunc(string) (string, error) { return `{\"tag\":\"ok\"}`, nil },      // shard 2 attempt 1\n\t\tfunc(string) (string, error) { return `{\"tag\":\"ok\"}`, nil },      // shard 3 attempt 1\n\t\tfunc(string) (string, error) { return \"still garbage\", nil },     // shard 1 attempt 2 → fall back\n\t)\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\titems := []string{\"first\", \"second\", \"third\"}\n\touts, err := RunSharded(context.Background(), s, items, func(item string) SynthesisRequest {\n\t\treturn SynthesisRequest{Prompt: item, Validator: sampleValidator, Label: item}\n\t}, 1) // serial so the response order is deterministic\n\tif err != nil {\n\t\tt.Fatalf(\"RunSharded: %v\", err)\n\t}\n\tif !outs[0].Result.FellBack {\n\t\tt.Errorf(\"shard 0 should have fallen back\")\n\t}\n\tif outs[1].Result.FellBack || outs[2].Result.FellBack {\n\t\tt.Errorf(\"shards 1,2 should NOT have fallen back: %+v %+v\", outs[1].Result, outs[2].Result)\n\t}\n}\n\nfunc TestNewDataBlock_WrapsContent(t *testing.T) {\n\tt.Parallel()\n\n\tblock, err := NewDataBlock(\"checkpoint\", \"deadbeef cafe abc def\")\n\tif err != nil {\n\t\tt.Fatalf(\"NewDataBlock: %v\", err)\n\t}\n\tout := block.String()\n\n\tif !strings.Contains(out, \"<checkpoint nonce=\