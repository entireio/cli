n53\t\t\t\t}\n54\t\t\t\treturn runUnderstandPr(cmd.Context(), cmd.OutOrStdout(), prOptions{\n55\t\t\t\t\tID:       id,\n56\t\t\t\t\tBase:     base,\n57\t\t\t\t\tHead:     head,\n58\t\t\t\t\tRevset:   revset,\n59\t\t\t\t\tJSONOut:  jsonOut,\n60\t\t\t\t\tMaxFiles: maxFiles,\n61\t\t\t\t})\n62\t\t\t},\n63\t\t}\n64\t\tcmd.Flags().StringVar(&base, \"base\", \"\", \"Base ref for diff fallback (used when no PR id)\")\n65\t\tcmd.Flags().StringVar(&head, \"head\", \"HEAD\", \"Head ref for diff fallback\")\n66\t\tcmd.Flags().StringVar(&revset, \"rev\", \"\", \"Revset for diff fallback (e.g. origin/main..HEAD)\")\n67\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n68\t\tcmd.Flags().IntVar(&maxFiles, \"max-files\", 50, \"Maximum number of touched files to annotate\")\n69\t\treturn cmd\n70\t}\n71\t\n72\t// PR-source labels used in the report shape and emitted JSON.\n73\tconst (\n74\t\tprSourceGH     = \"gh\"\n75\t\tprSourceDiff   = \"diff\"\n76\t\tprSourceRevset = \"revset\"\n77\t)\n78\t\n79\ttype prOptions struct {\n80\t\tID       string\n81\t\tBase     string\n82\t\tHead     string\n83\t\tRevset   string\n84\t\tJSONOut  bool\n85\t\tMaxFiles int\n86\t}\n87\t\n88\ttype prTouchedFile struct {\n89\t\tPath           string  `json:\"path\"`\n90\t\tStatus         string  `json:\"status,omitempty\"` // \"added\", \"modified\", \"removed\", \"renamed\"\n91\t\tNodeID         string  `json:\"node_id,omitempty\"`\n92\t\tLastCheckpoint string  `json:\"last_checkpoint,omitempty\"`\n93\t\tLastAt         string  `json:\"last_at,omitempty\"`\n94\t\tLastAgent      string  `json:\"last_agent,omitempty\"`\n95\t\tHotspotScore   float64 `json:\"hotspot_score,omitempty\"`\n96\t}\n97\t\n98\ttype prReport struct {\n99\t\tSource  string          `json:\"source\"` // \"gh\" | \"diff\" | \"revset\"\n100\t\tID      string          `json:\"id,omitempty\"`\n101\t\tBase    string          `json:\"base,omitempty\"`\n102\t\tHead    string          `json:\"head,omitempty\"`\