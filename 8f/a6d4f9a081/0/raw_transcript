e target).\n\nExamples:\n  entire understand impact cmd/entire/cli/root.go\n  entire understand impact dir:cmd/entire/cli/understand`,\n\t\tArgs: cobra.ExactArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\treturn runUnderstandImpact(cmd.Context(), cmd.OutOrStdout(), args[0], jsonOut, maxAffected)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n\tcmd.Flags().IntVar(&maxAffected, \"max\", 30, \"Maximum number of affected nodes to list\")\n\treturn cmd\n}\n\ntype impactNeighbor struct {\n\tNodeID         string `json:\"node_id\"`\n\tPath           string `json:\"path,omitempty\"`\n\tType           string `json:\"type\"`\n\tReason         string `json:\"reason\"`\n\tSharedCps      int    `json:\"shared_checkpoints,omitempty\"`\n\tLastCheckpoint string `json:\"last_checkpoint,omitempty\"`\n\tLastAt         string `json:\"last_at,omitempty\"`\n}\n\ntype impactReport struct {\n\tTarget    string           `json:\"target\"`\n\tNodeID    string           `json:\"node_id\"`\n\tAffected  []impactNeighbor `json:\"affected\"`\n\tTruncated bool             `json:\"truncated,omitempty\"`\n}\n\nfunc runUnderstandImpact(ctx context.Context, w io.Writer, target string, jsonOut bool, maxAffected int) error {\n\tq, err := loadQueryEnv(ctx)\n\tif err != nil {\n\t\tif errors.Is(err, errNoUnderstandCache) {\n\t\t\tfmt.Fprintln(w, err.Error())\n\t\t\treturn nil\n\t\t}\n\t\treturn err\n\t}\n\tnode, err := q.resolveAreaNode(target)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\treport := impactReport{Target: target, NodeID: node.ID}\n\n\t// Collect \"shared checkpoint\" siblings: files that appear in the same\n\t// touched_in edge set as the target. Score by number of overlapping cps.\n\tshared := computeImpactSharedCheckpoints(q, node.ID)\n\n\t// Collect contains-descendants for area-style queries (dir:/repo:.).\n\tdescendants := q.descendantFiles(node.ID)\n\n\t// Merge and de-dupe (descendants take precedence over shared, since their\n\t// reason is structural rather than inferred).\n\tseen := map[string]bool{node.ID: true}\n\tfor _, d := range descendants {\n\t\tif seen[d.ID] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[d.ID] = true\n\t\treport.Affected = append(report.Affected, neighborFor(q, d, \"contains\"))\n\t}\n\t// Sort shared by overlap desc, recency desc.\n\ttype sharedEntry struct {\n\t\tnodeID  string\n\t\tcount   int\n\t\tlastAt  string\n\t}\n\tentries := make([]sharedEntry, 0, len(shared))\n\tfor id, count := range shared {\n\t\tif seen[id] {\n\t\t\tcontinue\n\t\t}\n\t\tvar lastAt string\n\t\tif cp := q.recentCheckpoint(id); cp != nil {\n\t\t\tlastAt, _ = cp.Attrs[\"created_at\"].(string)\n\t\t}\n\t\tentries = append(entries, sharedEntry{nodeID: id, count: count, lastAt: lastAt})\n\t}\n\tsort.Slice(entries, func(i, j int) bool {\n\t\tif entries[i].count != entries[j].count {\n\t\t\treturn entries[i].count > entries[j].count\n\t\t}\n\t\treturn entries[i].lastAt > entries[j].lastAt\n\t})\n\tfor _, e := range entries {\n\t\tn := q.byID[e.nodeID]\n\t\tif n == nil {\n\t\t\tcontinue\n\t\t}\n\t\tnb := neighborFor(q, n, fmt.Sprintf(\"shares %d checkpoint(s)\", e.count))\n\t\tnb.SharedCps = e.count\n\t\treport.Affected = append(report.Affected, nb)\n\t}\n\n\tif maxAffected > 0 && len(report.Affected) > maxAffected {\n\t\treport.Affected = report.Affected[:maxAffected]\n\t\treport.Truncated = true\n\t}\n\n\treturn emitImpact(w, report, jsonOut)\n}\n\n// computeImpactSharedCheckpoints returns map[fileNodeID]sharedCpCount for files\n// that share at least one cp with `targetID`.\nfunc computeImpactSharedCheckpoints(q *queryEnv, targetID string) map[string]int {\n\tcpsForTarget := map[string]struct{}{}\n\tfor _, cpID := range q.touchedCps[targetID] {\n\t\tcpsForTarget[cpID] = struct{}{}\n\t}\n\tif len(cpsForTarget) == 0 {\n\t\treturn nil\n\t}\n\tout := map[string]int{}\n\tfor fileID, cps := range q.touchedCps {\n\t\tif fileID == targetID {\n\t\t\tcontinue\n\t\t}\n\t\tcount := 0\n\t\tfor _, cp := range cps {\n\t\t\tif _, ok := cpsForTarget[cp]; ok {\n\t\t\t\tcount++\n\t\t\t}\n\t\t}\n\t\tif count > 0 {\n\t\t\tout[fileID] = count\n\t\t}\n\t}\n\treturn out\n}\n\nfunc neighborFor(q *queryEnv, n *graph.Node, reason string) impactNeighbor {\n\tnb := impactNeighbor{\n\t\tNodeID: n.ID,\n\t\tPath:   n.Path,\n\t\tType:   string(n.Type),\n\t\tReason: reason,\n\t}\n\tif cp := q.recentCheckpoint(n.ID); cp != nil {\n\t\tnb.LastCheckpoint = cp.Name\n\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n\t\t\tnb.LastAt = at\n\t\t}\n\t}\n\treturn nb\n}\n\nfunc emitImpact(w io.Writer, r impactReport, jsonOut bool) error {\n\tif jsonOut {\n\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"marshal impact: %w\", err)\n\t\t}\n\t\tif _, err := w.Write(data); err != nil {\n\t\t\treturn fmt.Errorf(\"write impact JSON: %w\", err)\n\t\t}\n\t\treturn nil\n\t}\n\tfmt.Fprintf(w, \"# Impact: %s (`%s`)\\n\\n\", r.Target, r.NodeID)\n\tif len(r.Affected) == 0 {\n\t\tfmt.Fprintln(w, \"_No structural neighbors or shared-checkpoint files found._\")\n\t\treturn nil\n\t}\n\tfor _, n := range r.Affected {\n\t\tpath := n.Path\n\t\tif path == \"\" {\n\t\t\tpath = n.NodeID\n\t\t}\n\t\tfmt.Fprintf(w, \"- **%s** _(%s)_ — %s\", path, n.Type, n.Reason)\n\t\tif n.LastCheckpoint != \"\" {\n\t\t\tfmt.Fprintf(w, \"; last in `%s`\", n.LastCheckpoint)\n\t\t\tif n.LastAt != \"\" {\n\t\t\t\tfmt.Fprintf(w, \" at %s\", n.LastAt)\n\t\t\t}\n\t\t}\n\t\tfmt.Fprintln(w)\n\t}\n\tif r.Truncated {\n\t\tfmt.Fprintln(w, \"\\n_(output truncated; raise --max to see more)_\")\n\t}\n\treturn nil\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"03864e8a-b587-4dc2-b726-9a2181d5fee1","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peace