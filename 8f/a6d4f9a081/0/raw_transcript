me and\n98\t// surface a clear \"not yet supported\" message.\n99\tconst primeSupportedExecAgent = \"claude-code\"\n100\t\n101\t// primeBinaryLookup is overridable from tests so --exec can be exercised\n102\t// without a real CLI on PATH. Default uses exec.LookPath.\n103\tvar primeBinaryLookup = exec.LookPath\n104\t\n105\t// primeRunner executes the prepared command. Tests can replace this with a\n106\t// no-op to verify --exec composition without actually launching anything.\n107\tvar primeRunner = runPrimeExec\n108\t\n109\tfunc runUnderstandPrime(ctx context.Context, w io.Writer, opts primeOptions) error {\n110\t\tq, err := loadQueryEnv(ctx)\n111\t\tif err != nil {\n112\t\t\tif errors.Is(err, errNoUnderstandCache) {\n113\t\t\t\tpacket := primePacket{NoCache: true, Reason: err.Error(), Title: \"no understand cache\"}\n114\t\t\t\treturn emitPrimePacket(w, packet, opts)\n115\t\t\t}\n116\t\t\treturn err\n117\t\t}\n118\t\n119\t\tpacket := buildPrimePacket(q, opts)\n120\t\tif opts.Exec {\n121\t\t\treturn execPrime(w, packet, opts)\n122\t\t}\n123\t\treturn emitPrimePacket(w, packet, opts)\n124\t}\n125\t\n126\tfunc buildPrimePacket(q *queryEnv, opts primeOptions) primePacket {\n127\t\tpkt := primePacket{Title: \"Entire understand priming packet\"}\n128\t\n129\t\tfor _, raw := range opts.Targets {\n130\t\t\tt := primeTarget{Input: raw}\n131\t\t\tif node, err := q.resolveAreaNode(raw); err == nil {\n132\t\t\t\tt.NodeID = node.ID\n133\t\t\t\tt.Path = node.Path\n134\t\t\t\tt.Type = string(node.Type)\n135\t\t\t\tif cp := q.recentCheckpoint(node.ID); cp != nil {\n136\t\t\t\t\tt.LastCp = cp.Name\n137\t\t\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n138\t\t\t\t\t\tt.LastAt = at\n139\t\t\t\t\t}\n140\t\t\t\t}\n141\t\t\t\t// Inline up to 3 sibling-via-checkpoint files as notes so the\n142\t\t\t\t// agent sees what tends to move with this target.\n143\t\t\t\tshared := computeImpactSharedCheckpoints(q, node.ID)\n144\t\t\t\ttype entry struct {\n145\t\t\t\t\tpath  string\n