links(p)\n\t\tif canonRepo == \"\" {\n\t\t\tcanonRepo = repoRoot\n\t\t}\n\t\tif canonInput == \"\" {\n\t\t\tcanonInput = p\n\t\t}\n\t\tif rel, err := filepath.Rel(canonRepo, canonInput); err == nil && !strings.HasPrefix(rel, \"..\") {\n\t\t\treturn filepath.ToSlash(rel)\n\t\t}\n\t\treturn p\n\t}\n\n\t// Strip leading \"./\".\n\tp = strings.TrimPrefix(p, \"./\")\n\treturn p\n}","originalFile":"package cli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n\t\"github.com/spf13/cobra\"\n)\n\n// newUnderstandExplainCmd builds `entire understand explain <file|node>`.\n//\n// This is the supporting primitive — the spec says it's the detail backend for\n// dashboard click-through, impact, tour, and prime. Resolution rules:\n//\n//   - if the argument matches an exact node ID (any prefix), return that node\n//   - else if it's a file path (relative or absolute), normalize to repo-relative\n//     forward-slash and look for `file:<rel>` or `ghost:<rel>`\n//\n// Symbol-level checkpoint attribution is not yet emitted by the build pipeline\n// (history fuse is file-owner only); rendering surfaces the \"(file-level\n// inferred)\" qualifier on every checkpoint→symbol relationship and never\n// conflates the two scopes in a single rendered string.\nfunc newUnderstandExplainCmd() *cobra.Command {\n\tvar jsonOut bool\n\n\tcmd := &cobra.Command{\n\t\tUse:   \"explain <file|node>\",\n\t\tShort: \"Explain a file or graph node and surface its checkpoint trail\",\n\t\tLong: `Resolve a file path or node ID and print structural identity plus the most\nrecent checkpoints that shaped it.\n\nExamples:\n  entire understand explain main.go\n  entire understand explain file:cmd/entire/cli/root.go\n  entire understand explain sym:cmd/entire/cli/understand_status.go:newUnderstandStatusCmd\n\nUse --json for a stable shape suitable for scripting.`,\n\t\tArgs: cobra.ExactArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\treturn runUnderstandExplain(cmd.Context(), cmd.OutOrStdout(), args[0], jsonOut)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n\treturn cmd\n}\n\n// explainReport is the JSON shape emitted by explain --json. Stable for\n// downstream commands (tour, impact, prime).\ntype explainReport struct {\n\tNode       *graph.Node       `json:\"node\"`\n\tChildren   []graph.Node      `json:\"children,omitempty\"`\n\tCheckpoints []checkpointBrief `json:\"checkpoints,omitempty\"`\n\tNoCache    bool              `json:\"no_cache,omitempty\"`\n\tReason     string            `json:\"reason,omitempty\"`\n}\n\n// checkpointBrief is a thin checkpoint summary inlined into explain output.\n// Scope is \"symbol\" or \"file-owner\" — never mixed in a single struct value.\ntype checkpointBrief struct {\n\tID         string `json:\"id\"`\n\tName       string `json:\"name,omitempty\"`\n\tCreatedAt  string `json:\"created_at,omitempty\"`\n\tAgent      string `json:\"agent,omitempty\"`\n\tScope      string `json:\"scope\"`\n\tIsTask     bool   `json:\"is_task,omitempty\"`\n\tToolUseID  string `json:\"tool_use_id,omitempty\"`\n}\n\nfunc runUnderstandExplain(ctx context.Context, w io.Writer, target string, jsonOut bool) error {\n\troot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"resolve repo root: %w\", err)\n\t}\n\tstore := graph.NewStore(root)\n\tif !store.Exists() {\n\t\treport := explainReport{NoCache: true, Reason: \"no understand cache yet — run `entire understand build`\"}\n\t\treturn emitExplain(w, report, jsonOut)\n\t}\n\n\tfused, err := store.FusedGraph()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"read fused graph: %w\", err)\n\t}\n\n\tnode, err := resolveExplainNode(fused, target, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\treport := explainReport{Node: node}\n\treport.Children = collectChildren(fused, node.ID)\n\treport.Checkpoints = collectCheckpoints(fused, node.ID)\n\treturn emitExplain(w, report, jsonOut)\n}\n\nfunc emitExplain(w io.Writer, r explainReport, jsonOut bool) error {\n\tif jsonOut {\n\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"marshal explain: %w\", err)\n\t\t}\n\t\tif _, err := w.Write(data); err != nil {\n\t\t\treturn fmt.Errorf(\"write explain JSON: %w\", err)\n\t\t}\n\t\treturn nil\n\t}\n\tif r.NoCache {\n\t\tfmt.Fprintf(w, \"no understand cache yet — run `entire understand build`\\n\")\n\t\treturn nil\n\t}\n\n\tn := r.Node\n\tfmt.Fprintf(w, \"# %s\\n\\n\", n.ID)\n\tfmt.Fprintf(w, \"- type: %s\\n\", n.Type)\n\tif n.SymbolKind != \"\" {\n\t\tfmt.Fprintf(w, \"- symbol_kind: %s\\n\", n.SymbolKind)\n\t}\n\tif n.Path != \"\" {\n\t\tfmt.Fprintf(w, \"- path: %s\\n\", n.Path)\n\t}\n\tif n.Language != \"\" {\n\t\tfmt.Fprintf(w, \"- language: %s\\n\", n.Language)\n\t}\n\tif n.LineStart > 0 || n.LineEnd > 0 {\n\t\tfmt.Fprintf(w, \"- lines: %d-%d\\n\", n.LineStart, n.LineEnd)\n\t}\n\tif removed, _ := n.Attrs[\"removed\"].(bool); removed {\n\t\tfmt.Fprintf(w, \"- status: REMOVED (file no longer in working tree)\\n\")\n\t}\n\n\tif len(r.Children) > 0 {\n\t\tfmt.Fprintf(w, \"\\n## Contains (%d)\\n\\n\", len(r.Children))\n\t\tfor _, c := range r.Children {\n\t\t\tlabel := string(c.Type)\n\t\t\tif c.SymbolKind != \"\" {\n\t\t\t\tlabel = fmt.Sprintf(\"%s/%s\", c.Type, c.SymbolKind)\n\t\t\t}\n\t\t\tfmt.Fprintf(w, \"- %s `%s`\", label, c.Name)\n\t\t\tif c.LineStart > 0 {\n\t\t\t\tfmt.Fprintf(w, \" (lines %d-%d)\", c.LineStart, c.LineEnd)\n\t\t\t}\n\t\t\tfmt.Fprintln(w)\n\t\t}\n\t}\n\n\tif len(r.Checkpoints) > 0 {\n\t\tfmt.Fprintf(w, \"\\n## Checkpoint trail (%d)\\n\\n\", len(r.Checkpoints))\n\t\tfor _, cp := range r.Checkpoints {\n\t\t\tqualifier := \"\"\n\t\t\tif cp.Scope == string(graph.ScopeFileOwner) {\n\t\t\t\tqualifier = \" _(file-level inferred)_\"\n\t\t\t}\n\t\t\tfmt.Fprintf(w, \"- `%s`%s\", cp.ID, qualifier)\n\t\t\tif cp.CreatedAt != \"\" {\n\t\t\t\tfmt.Fprintf(w, \" — %s\", cp.CreatedAt)\n\t\t\t}\n\t\t\tif cp.Agent != \"\" {\n\t\t\t\tfmt.Fprintf(w, \" _(%s)_\", cp.Agent)\n\t\t\t}\n\t\t\tif cp.IsTask {\n\t\t\t\tfmt.Fprintf(w, \" [task]\")\n\t\t\t}\n\t\t\tfmt.Fprintln(w)\n\t\t}\n\t} else {\n\t\tfmt.Fprintf(w, \"\\n_No checkpoint trail yet._\\n\")\n\t}\n\treturn nil\n}\n\nfunc resolveExplainNode(fused *graph.Slice, target, repoRoot string) (*graph.Node, error) {\n\ttarget = strings.TrimSpace(target)\n\tif target == \"\" {\n\t\treturn nil, errors.New(\"explain: empty target\")\n\t}\n\n\t// Exact node-ID match first.\n\tfor i, n := range fused.Nodes {\n\t\tif n.ID == target {\n\t\t\treturn &fused.Nodes[i], nil\n\t\t}\n\t}\n\n\t// File path resolution: normalize relative to repo root, prefer file:\n\t// then ghost: prefix.\n\trel := normalizeExplainPath(target, repoRoot)\n\tfor _, prefix := range []string{\"file:\", \"ghost:\"} {\n\t\twant := prefix + rel\n\t\tfor i, n := range fused.Nodes {\n\t\t\tif n.ID == want {\n\t\t\t\treturn &fused.Nodes[i], nil\n\t\t\t}\n\t\t}\n\t}\n\n\t// Last-resort symbol resolution: if target looks like `path/to/file.go:Symbol`,\n\t// try sym:<path>:<symbol>.\n\tif strings.Contains(target, \":\") && !strings.HasPrefix(target, \"sym:\") {\n\t\twant := \"sym:\" + rel\n\t\tfor i, n := range fused.Nodes {\n\t\t\tif n.ID == want {\n\t\t\t\treturn &fused.Nodes[i], nil\n\t\t\t}\n\t\t}\n\t}\n\n\treturn nil, fmt.Errorf(\"explain: no node matches %q (try `entire understand build` or pass an exact node ID)\", target)\n}\n\n// normalizeExplainPath converts the user-facing argument into a repo-relative\n// forward-slash path matching what the index emits. Absolute paths under\n// repoRoot are made relative; anything outside the repo is returned as-is so\n// resolution simply fails to find a match.\nfunc normalizeExplainPath(p, repoRoot string) string {\n\tp = strings.TrimSpace(p)\n\tp = strings.ReplaceAll(p, \"\\\\\", \"/\")\n\n\tif filepath.IsAbs(p) {\n\t\tif rel, err := filepath.Rel(repoRoot, p); err == nil && !strings.HasPrefix(rel, \"..\") {\n\t\t\treturn filepath.ToSlash(rel)\n\t\t}\n\t\treturn p\n\t}\n\n\t// Strip leading \"./\".\n\tp = strings.TrimPrefix(p, \"./\")\n\treturn p\n}\n\nfunc collectChildren(fused *graph.Slice, nodeID string) []graph.Node {\n\tbyID := make(map[string]*graph.Node, len(fused.Nodes))\n\tfor i := range fused.Nodes {\n\t\tbyID[fused.Nodes[i].ID] = &fused.Nodes[i]\n\t}\n\tchildren := []graph.Node{}\n\tfor _, e := range fused.Edges {\n\t\tif e.Type != graph.EdgeContains || e.From != nodeID {\n\t\t\tcontinue\n\t\t}\n\t\tif c, ok := byID[e.To]; ok {\n\t\t\tchildren = append(children, *c)\n\t\t}\n\t}\n\tsort.Slice(children, func(i, j int) bool { return children[i].ID < children[j].ID })\n\treturn children\n}\n\nfunc collectCheckpoints(fused *graph.Slice, nodeID string) []checkpointBrief {\n\tbyID := make(map[string]*graph.Node, len(fused.Nodes))\n\tfor i := range fused.Nodes {\n\t\tbyID[fused.Nodes[i].ID] = &fused.Nodes[i]\n\t}\n\n\tout := []checkpointBrief{}\n\tseen := map[string]struct{}{}\n\n\taddCheckpointEdge := func(cpNodeID string, scope graph.Scope) {\n\t\tcp, ok := byID[cpNodeID]\n\t\tif !ok || cp.Type != graph.NodeCheckpoint {\n\t\t\treturn\n\t\t}\n\t\tif _, dup := seen[cpNodeID]; dup {\n\t\t\treturn\n\t\t}\n\t\tseen[cpNodeID] = struct{}{}\n\t\tbrief := checkpointBrief{\n\t\t\tID:    cp.Name,\n\t\t\tName:  cp.Name,\n\t\t\tScope: string(scope),\n\t\t}\n\t\tif at, _ := cp.Attrs[\"created_at\"].(string); at != \"\" {\n\t\t\tbrief.CreatedAt = at\n\t\t}\n\t\tif ag, _ := cp.Attrs[\"agent\"].(string); ag != \"\" {\n\t\t\tbrief.Agent = ag\n\t\t}\n\t\tif isTask, _ := cp.Attrs[\"is_task\"].(bool); isTask {\n\t\t\tbrief.IsTask = true\n\t\t}\n\t\tif tu, _ := cp.Attrs[\"tool_use_id\"].(string); tu != \"\" {\n\t\t\tbrief.ToolUseID = tu\n\t\t}\n\t\tout = append(out, brief)\n\t}\n\n\t// Direct