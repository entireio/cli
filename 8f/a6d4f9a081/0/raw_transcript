/util.go\", string(graph.EdgeTouchedIn)},\n\t} {\n\t\tif !hasEdge(res.Slice, want.from, want.to, want.typ) {\n\t\t\tt.Errorf(\"missing edge %s -%s-> %s\", want.from, want.typ, want.to)\n\t\t}\n\t}\n\n\t// Touched edges must be ScopeFileOwner per spec.\n\tfor _, e := range res.Slice.Edges {\n\t\tif e.Type == graph.EdgeTouchedIn && e.Scope != graph.ScopeFileOwner {\n\t\t\tt.Errorf(\"touched_in edge %+v has Scope=%q; want %q\", e, e.Scope, graph.ScopeFileOwner)\n\t\t}\n\t}\n\n\tif res.CheckpointCount != 1 || res.SessionCount != 1 || res.GhostFileCount != 0 {\n\t\tt.Errorf(\"counts = %+v; want CheckpointCount=1 SessionCount=1 GhostFileCount=0\", res)\n\t}\n}\n\nfunc TestFuse_SessionDeduplicatedAcrossCheckpoints(t *testing.T) {\n\tt.Parallel()\n\n\tinfos := []checkpoint.CommittedInfo{\n\t\t{\n\t\t\tCheckpointID: mustID(\"aaaaaaaaaaaa\"),\n\t\t\tCreatedAt:    time.Date(2026, 1, 1, 10, 0, 0, 0, time.UTC),\n\t\t\tSessionIDs:   []string{\"sess-1\"},\n\t\t},\n\t\t{\n\t\t\tCheckpointID: mustID(\"bbbbbbbbbbbb\"),\n\t\t\tCreatedAt:    time.Date(2026, 1, 2, 10, 0, 0, 0, time.UTC),\n\t\t\tSessionIDs:   []string{\"sess-1\"}, // same session, second checkpoint\n\t\t},\n\t\t{\n\t\t\tCheckpointID: mustID(\"cccccccccccc\"),\n\t\t\tCreatedAt:    time.Date(2026, 1, 3, 10, 0, 0, 0, time.UTC),\n\t\t\tSessionIDs:   []string{\"sess-2\"},\n\t\t},\n\t}\n\tres, err := Fuse(infos, FuseOptions{})\n\tif err != nil {\n\t\tt.Fatalf(\"Fuse: %v\", err)\n\t}\n\n\tsessionNodeIDs := []string{}\n\tfor _, n := range res.Slice.Nodes {\n\t\tif n.Type == graph.NodeSession {\n\t\t\tsessionNodeIDs = append(sessionNodeIDs, n.ID)\n\t\t}\n\t}\n\tslices.Sort(sessionNodeIDs)\n\twant := []string{\"sess:sess-1\", \"sess:sess-2\"}\n\tif !slices.Equal(sessionNodeIDs, want) {\n\t\tt.Errorf(\"session nodes = %v; want %v\", sessionNodeIDs, want)\n\t}\n\tif res.SessionCount != 2 {\n\t\tt.Errorf(\"SessionCount = %d; want 2\", res.SessionCount)\n\t}\n}\n\nfunc TestFuse_GhostFileForRemovedPaths(t *testing.T) {\n\tt.Parallel()\n\n\tinfos := []checkpoint.CommittedInfo{\n\t\t{\n\t\t\tCheckpointID: mustID(\"aaaaaaaaaaaa\"),\n\t\t\tCreatedAt:    time.Now(),\n\t\t\tFilesTouched: []string{\"current.go\", \"deleted.go\"},\n\t\t},\n\t}\n\tres, err := Fuse(infos, FuseOptions{\n\t\tStructuralFiles: map[string]struct{}{\"current.go\": {}}, // deleted.go missing\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Fuse: %v\", err)\n\t}\n\n\tif !hasEdge(res.Slice, \"cp:aaaaaaaaaaaa\", \"file:current.go\", string(graph.EdgeTouchedIn)) {\n\t\tt.Error(\"missing live touched_in edge\")\n\t}\n\tif !hasEdge(res.Slice, \"cp:aaaaaaaaaaaa\", \"ghost:deleted.go\", string(graph.EdgeTouchedIn)) {\n\t\tt.Error(\"missing ghost touched_in edge\")\n\t}\n\t// Ghost node exists with `removed: true`.\n\tvar ghost *graph.Node\n\tfor i, n := range res.Slice.Nodes {\n\t\tif n.ID == \"ghost:deleted.go\" {\n\t\t\tghost = &res.Slice.Nodes[i]\n\t\t}\n\t}\n\tif ghost == nil {\n\t\tt.Fatal(\"ghost node missing\")\n\t}\n\tif ghost.Path != \"deleted.go\" {\n\t\tt.Errorf(\"ghost Path = %q; want deleted.go\", ghost.Path)\n\t}\n\tif removed, _ := ghost.Attrs[\"removed\"].(bool); !removed {\n\t\tt.Errorf(\"ghost.Attrs[removed] = %v; want true\", ghost.Attrs[\"removed\"])\n\t}\n\tif res.GhostFileCount != 1 {\n\t\tt.Errorf(\"GhostFileCount = %d; want 1\", res.GhostFileCount)\n\t}\n}\n\nfunc TestFuse_DeterministicEdgeOrderByTime(t *testing.T) {\n\tt.Parallel()\n\n\t// Insert checkpoints out of order — Fuse should sort them by CreatedAt.\n\tinfos := []checkpoint.CommittedInfo{\n\t\t{CheckpointID: mustID(\"cccccccccccc\"), CreatedAt: time.Date(2026, 1, 3, 0, 0, 0, 0, time.UTC), FilesTouched: []string{\"a.go\"}},\n\t\t{CheckpointID: mustID(\"aaaaaaaaaaaa\"), CreatedAt: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC), FilesTouched: []string{\"a.go\"}},\n\t\t{CheckpointID: mustID(\"bbbbbbbbbbbb\"), CreatedAt: time.Date(2026, 1, 2, 0, 0, 0, 0, time.UTC), FilesTouched: []string{\"a.go\"}},\n\t}\n\tres, err := Fuse(infos, FuseOptions{StructuralFiles: map[string]struct{}{\"a.go\": {}}})\n\tif err != nil {\n\t\tt.Fatalf(\"Fuse: %v\", err)\n\t}\n\n\t// Edges referencing file:a.go should appear in chronological cp order.\n\tvar seenCps []string\n\tfor _, e := range res.Slice.Edges {\n\t\tif e.Type == graph.EdgeTouchedIn && e.To == \"file:a.go\" {\n\t\t\tseenCps = append(seenCps, e.From)\n\t\t}\n\t}\n\twant := []string{\"cp:aaaaaaaaaaaa\", \"cp:bbbbbbbbbbbb\", \"cp:cccccccccccc\"}\n\tif !slices.Equal(seenCps, want) {\n\t\tt.Errorf(\"edge order by cp = %v; want %v\", seenCps, want)\n\t}\n}\n\nfunc TestFuse_EmptyInput(t *testing.T) {\n\tt.Parallel()\n\n\tres, err := Fuse(nil, FuseOptions{})\n\tif err != nil {\n\t\tt.Fatalf(\"Fuse(nil): %v\", err)\n\t}\n\tif len(res.Slice.Nodes) != 0 || len(res.Slice.Edges) != 0 {\n\t\tt.Errorf(\"nodes/edges = %d/%d; want 0/0\", len(res.Slice.Nodes), len(res.Slice.Edges))\n\t}\n}\n\nfunc hasNode(s *graph.Slice, id string) bool {\n\tfor _, n := range s.Nodes {\n\t\tif n.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc hasEdge(s *graph.Slice, from, to, typ string) bool {\n\tfor _, e := range s.Edges {\n\t\tif e.From == from && e.To == to && string(e.Type) == typ {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":786,"cache_read_input_tokens":169242,"output_tokens":3564,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":786,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":1,"output_tokens":3564,"cache_read_input_tokens":169242,"cache_creation_input_tokens":786,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":786},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CajsaoCnnVmcJ7qGhEFW3","type":"assistant","uuid":"31250e92-4e02-457d-a6ee-4982aad03735","times