\t\t\t\tsort.Slice(entries, func(i, j int) bool { return entries[i].count > entries[j].count })\n150\t\t\t\tfor i, e := range entries {\n151\t\t\t\t\tif i >= 3 {\n152\t\t\t\t\t\tbreak\n153\t\t\t\t\t}\n154\t\t\t\t\tt.Notes = append(t.Notes, fmt.Sprintf(\"often co-touched with `%s` (%d shared cps)\", e.path, e.count))\n155\t\t\t\t}\n156\t\t\t} else {\n157\t\t\t\tt.Notes = []string{\"unresolved target — run `entire understand build` if missing\"}\n158\t\t\t}\n159\t\t\tpkt.Targets = append(pkt.Targets, t)\n160\t\t}\n161\t\n162\t\t// Top hotspots regardless of targets — gives the agent a global picture.\n163\t\ttop := opts.TopHotspots\n164\t\tif top <= 0 {\n165\t\t\ttop = 8\n166\t\t}\n167\t\tpkt.Hotspots = topHotspotsFor(q, top)\n168\t\treturn pkt\n169\t}\n170\t\n171\t// topHotspotsFor reuses the hotspots scoring from understand_hotspots.go but\n172\t// inlines the loop here to avoid re-running the whole command and re-loading\n173\t// the graph.\n174\tfunc topHotspotsFor(q *queryEnv, n int) []hotspot {\n175\t\tout := []hotspot{}\n176\t\tfor fileID, cps := range q.touchedCps {\n177\t\t\tnode := q.byID[fileID]\n178\t\t\tif node == nil || node.Type != graph.NodeFile {\n179\t\t\t\tcontinue\n180\t\t\t}\n181\t\t\tagents := map[string]struct{}{}\n182\t\t\tfor _, cpID := range cps {\n183\t\t\t\tif cp := q.byID[cpID]; cp != nil {\n184\t\t\t\t\tif a, ok := cp.Attrs[\"agent\"].(string); ok && a != \"\" {\n185\t\t\t\t\t\tagents[a] = struct{}{}\n186\t\t\t\t\t}\n187\t\t\t\t}\n188\t\t\t}\n189\t\t\tout = append(out, hotspot{\n190\t\t\t\tNodeID:          fileID,\n191\t\t\t\tPath:            node.Path,\n192\t\t\t\tCheckpointCount: len(cps),\n193\t\t\t\tDistinctAgents:  len(agents),\n194\t\t\t\tScore:           float64(len(cps)) + 0.5*float64(len(agents)),\n195\t\t\t})\n196\t\t}\n197\t\tsort.Slice(out, func(i, j int) bool {\n198\t\t\tif out[i].Score != out[j].Score {\n199\t\t\t\treturn out[i].Score > out[j].Score\n200\t\t\t}\n201\t\t\treturn out[i].Path < out[j].Path\n202\t\t})\n203\t\tif