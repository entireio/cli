{"parentUuid":"1a7ac4c2-19dd-48ae-a2f6-a1f16b71ce2b","isSidechain":false,"promptId":"22f854f5-b3f8-4b4e-8776-19cfec301ce7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0149JL8FJcTVrUkDJi5NJeTL","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\n9\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n10\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/external\"\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/summarize\"\n17\t\n18\t\t\"charm.land/huh/v2\"\n19\t)\n20\t\n21\tvar (\n22\t\tloadSummarySettings            = LoadEntireSettings\n23\t\tloadSummarySettingsFromFile    = settings.LoadFromFile\n24\t\tsaveLocalSummarySettings       = SaveEntireSettingsLocal\n25\t\tgetSummaryAgent                = agent.Get\n26\t\tlistRegisteredAgents           = agent.List\n27\t\tisSummaryCLIAvailable          = agent.IsSummaryCLIAvailable\n28\t\tdiscoverSummaryProviders       = external.DiscoverAndRegister\n29\t\tdiscoverSummaryProvidersAlways = external.DiscoverAndRegisterAlways\n30\t)\n31\t\n32\ttype checkpointSummaryProvider struct {\n33\t\tName        types.AgentName\n34\t\tDisplayName string\n35\t\tModel       string\n36\t\tGenerator   summarize.Generator\n37\t}\n38\t\n39\tfunc resolveCheckpointSummaryProvider(ctx context.Context, w io.Writer) (*checkpointSummaryProvider, error) {\n40\t\ts, err := loadSummarySettings(ctx)\n41\t\tif err != nil {\n42\t\t\treturn nil, fmt.Errorf(\"loading settings: %w\", err)\n43\t\t}\n44\t\n45\t\tif s.SummaryGeneration != nil && s.SummaryGeneration.Provider != \"\" {\n46\t\t\tproviderName := types.AgentName(s.SummaryGeneration.Provider)\n47\t\t\tdiscoverSummaryProviderIfMissing(ctx, providerName)\n48\t\t\tif err := ensureSummaryProviderPresent(ctx, providerName); err != nil {\n49\t\t\t\treturn nil, err\n50\t\t\t}\n51\t\t\treturn buildCheckpointSummaryProvider(providerName, s.SummaryGeneration.Model)\n52\t\t}\n53\t\n54\t\t// Use the always-variant so installed external plugins surface in the\n55\t\t// picker even when external_agents is currently off. Installation\n56\t\t// (placing entire-agent-* on $PATH) is the user's opt-in to \"this\n57\t\t// plugin exists\"; selecting it in the picker is when external_agents\n58\t\t// flips on (handled by persistSummaryProviderSelection).\n59\t\tdiscoverSummaryProvidersAlways(ctx)\n60\t\tcandidates := listEnabledSummaryProviders(ctx)\n61\t\n62\t\tswitch len(candidates) {\n63\t\tcase 0:\n64\t\t\treturn nil, errors.New(\"no summary-capable provider is available; install claude, codex, gemini, cursor, or copilot, install an external entire-agent-* plugin that declares text_generator, or set summary_generation.provider in settings\")\n65\t\tcase 1:\n66\t\t\treturn autoSelectSummaryProvider(ctx, w, candidates[0].Name, \"non-interactive auto-select: single installed provider\")\n67\t\tdefault:\n68\t\t\tif !interactive.CanPromptInteractively() {\n69\t\t\t\treturn autoSelectSummaryProvider(ctx, w, candidates[0].Name, \"non-interactive auto-select: first detected of multiple\")\n70\t\t\t}\n71\t\n72\t\t\tselected, err := promptForSummaryProvider(candidates)\n73\t\t\tif err != nil {\n74\t\t\t\treturn nil, err\n75\t\t\t}\n76\t\t\tprovider, err := autoSelectSummaryProvider(ctx, w, selected, \"interactive prompt selection\")\n77\t\t\tif err != nil {\n78\t\t\t\treturn nil, err\n79\t\t\t}\n80\t\t\tfmt.Fprintf(w, \"Using %s for summary generation.\\n\", provider.DisplayName)\n81\t\t\treturn provider, nil\n82\t\t}\n83\t}\n84\t\n85\tfunc discoverSummaryProviderIfMissing(ctx context.Context, name types.AgentName) {\n86\t\tif _, err := getSummaryAgent(name); err == nil {\n87\t\t\treturn\n88\t\t}\n89\t\tdiscoverSummaryProviders(ctx)\n90\t}\n91\t\n92\t// autoSelectSummaryProvider builds a provider for an auto-selected candidate\n93\t// (single-installed or non-interactive-first-of-many) and persists the choice\n94\t// so subsequent runs don't re-decide. Persistence failure is surfaced as a\n95\t// warning — not an error — because the selection is still usable in-process.\n96\tfunc autoSelectSummaryProvider(ctx context.Context, w io.Writer, name types.AgentName, reason string) (*checkpointSummaryProvider, error) {\n97\t\tlogging.Info(ctx, reason, \"provider\", string(name))\n98\t\tprovider, err := buildCheckpointSummaryProvider(name, \"\")\n99\t\tif err != nil {\n100\t\t\treturn nil, err\n101\t\t}\n102\t\tflagFlipped, saveErr := persistSummaryProviderSelection(ctx, provider.Name, provider.Model)\n103\t\tif saveErr != nil {\n104\t\t\tlogging.Warn(ctx, \"failed to save summary provider selection, continuing without persistence\",\n105\t\t\t\t\"error\", saveErr.Error())\n106\t\t\tfmt.Fprintf(w, \"Warning: could not save provider selection: %v\\nUse `entire configure --summarize-provider %s` to set it manually.\\n\", saveErr, provider.Name)\n107\t\t}\n108\t\tif flagFlipped {\n109\t\t\tfmt.Fprintln(w, externalAgentsAutoEnabledNotice)\n110\t\t}\n111\t\treturn provider, nil\n112\t}\n113\t\n114\tfunc listEnabledSummaryProviders(_ context.Context) []checkpointSummaryProvider {\n115\t\tregistered := listRegisteredAgents()\n116\t\tproviders := make([]checkpointSummaryProvider, 0, len(registered))\n117\t\tfor _, name := range registered {\n118\t\t\tag, err := getSummaryAgent(name)\n119\t\t\tif err != nil {\n120\t\t\t\tcontinue\n121\t\t\t}\n122\t\t\tif _, ok := agent.AsTextGenerator(ag); !ok {\n123\t\t\t\tcontinue\n124\t\t\t}\n125\t\t\t// Check CLI binary on PATH for built-ins. External agents are already\n126\t\t\t// proven executable by discovery and are gated by text_generator.\n127\t\t\tif !isSummaryProviderAvailable(name, ag) {\n128\t\t\t\tcontinue\n129\t\t\t}\n130\t\t\tproviders = append(providers, checkpointSummaryProvider{\n131\t\t\t\tName:        name,\n132\t\t\t\tDisplayName: string(ag.Type()),\n133\t\t\t})\n134\t\t}\n135\t\treturn providers\n136\t}\n137\t\n138\tfunc isSummaryProviderAvailable(name types.AgentName, ag agent.Agent) bool {\n139\t\tif external.IsExternal(ag) {\n140\t\t\t_, ok := agent.AsTextGenerator(ag)\n141\t\t\treturn ok\n142\t\t}\n143\t\treturn isSummaryCLIAvailable(name)\n144\t}\n145\t\n146\tfunc promptForSummaryProvider(providers []checkpointSummaryProvider) (types.AgentName, error) {\n147\t\toptions := make([]huh.Option[string], 0, len(providers))\n148\t\tfor _, provider := range providers {\n149\t\t\toptions = append(options, huh.NewOption(provider.DisplayName, string(provider.Name)))\n150\t\t}\n151\t\n152\t\tvar selected string\n153\t\tform := NewAccessibleForm(\n154\t\t\thuh.NewGroup(\n155\t\t\t\thuh.NewSelect[string]().\n156\t\t\t\t\tTitle(\"Choose a summary provider\").\n157\t\t\t\t\tDescription(\"This choice will be saved. Use `entire configure --summarize-provider <name>` to change it later.\").\n158\t\t\t\t\tOptions(options...).\n159\t\t\t\t\tValue(&selected),\n160\t\t\t),\n161\t\t)\n162\t\tif err := form.Run(); err != nil {\n163\t\t\treturn \"\", fmt.Errorf(\"summary provider selection cancelled: %w\", err)\n164\t\t}\n165\t\n166\t\treturn types.AgentName(selected), nil\n167\t}\n168\t\n169\tfunc buildCheckpointSummaryProvider(name types.AgentName, model string) (*checkpointSummaryProvider, error) {\n170\t\tag, err := getSummaryAgent(name)\n171\t\tif err != nil {\n172\t\t\treturn nil, fmt.Errorf(\"loading summary provider %s: %w\", name, err)\n173\t\t}\n174\t\n175\t\ttextGenerator, ok := agent.AsTextGenerator(ag)\n176\t\tif !ok {\n177\t\t\treturn nil, fmt.Errorf(\"agent %s does not support summary generation\", name)\n178\t\t}\n179\t\n180\t\teffectiveModel := summarize.ResolveModel(name, model)\n181\t\n182\t\treturn &checkpointSummaryProvider{\n183\t\t\tName:        name,\n184\t\t\tDisplayName: string(ag.Type()),\n185\t\t\tModel:       effectiveModel,\n186\t\t\tGenerator: &summarize.TextGeneratorAdapter{\n187\t\t\t\tTextGenerator: textGenerator,\n188\t\t\t\tModel:         effectiveModel,\n189\t\t\t},\n190\t\t}, nil\n191\t}\n192\t\n193\t// ensureSummaryProviderPresent returns an error if the named summary provider's\n194\t// CLI binary is not on PATH. Checks the binary directly (via exec.LookPath)\n195\t// rather than DetectPresence, because DetectPresence checks repo-level agent\n196\t// configuration — a repo using Claude Code for development can still use Codex\n197\t// or Gemini for summary generation as long as the binary is installed.\n198\tfunc ensureSummaryProviderPresent(_ context.Context, name types.AgentName) error {\n199\t\tag, err := getSummaryAgent(name)\n200\t\tif err != nil {\n201\t\t\treturn fmt.Errorf(\"unknown summary provider %s: %w\", name, err)\n202\t\t}\n203\t\tif _, ok := agent.AsTextGenerator(ag); !ok {\n204\t\t\treturn fmt.Errorf(\"agent %s does not support summary generation\", name)\n205\t\t}\n206\t\tif !isSummaryProviderAvailable(name, ag) {\n207\t\t\treturn fmt.Errorf(\"summary provider %q is configured but its CLI binary is not on PATH; install it or update summary_generation.provider in settings\", name)\n208\t\t}\n209\t\treturn nil\n210\t}\n211\t\n212\tfunc validateSummaryProvider(provider string) error {\n213\t\tname := types.AgentName(provider)\n214\t\tag, err := getSummaryAgent(name)\n215\t\tif err != nil {\n216\t\t\treturn fmt.Errorf(\"unknown summary provider %q: %w\", provider, err)\n217\t\t}\n218\t\tif _, ok := agent.AsTextGenerator(ag); !ok {\n219\t\t\treturn fmt.Errorf(\"agent %q does not support summary generation\", provider)\n220\t\t}\n221\t\tif !isSummaryProviderAvailable(name, ag) {\n222\t\t\treturn fmt.Errorf(\"summary provider %q is configured but its CLI binary is not on PATH; install it or choose another provider\", provider)\n223\t\t}\n224\t\treturn nil\n225\t}\n226\t\n227\t// persistSummaryProviderSelection writes the chosen provider to\n228\t// settings.local.json. When the chosen provider is an external agent and\n229\t// external_agents is not yet enabled, it also flips that setting on so the\n230\t// plugin can actually run; in that case it returns flagFlipped=true so the\n231\t// caller can surface a one-time notice. The flag is written to local because\n232\t// the provider choice is already machine-specific (depends on $PATH).\n233\tfunc persistSummaryProviderSelection(ctx context.Context, provider types.AgentName, model string) (flagFlipped bool, err error) {\n234\t\ttargetFileAbs, err := paths.AbsPath(ctx, settings.EntireSettingsLocalFile)\n235\t\tif err != nil {\n236\t\t\ttargetFileAbs = settings.EntireSettingsLocalFile\n237\t\t}\n238\t\n239\t\ts, err := loadSummarySettingsFromFile(targetFileAbs)\n240\t\tif err != nil {\n241\t\t\treturn false, fmt.Errorf(\"loading settings for update: %w\", err)\n242\t\t}\n243\t\tif s.SummaryGeneration == nil {\n244\t\t\ts.SummaryGeneration = &settings.SummaryGenerationSettings{}\n245\t\t}\n246\t\ts.SummaryGeneration.SetProvider(string(provider), model)\n247\t\n248\t\tif ag, getErr := getSummaryAgent(provider); getErr == nil && external.IsExternal(ag) && !s.ExternalAgents {\n249\t\t\ts.ExternalAgents = true\n250\t\t\tflagFlipped = true\n251\t\t}\n252\t\n253\t\tif err := saveLocalSummarySettings(ctx, s); err != nil {\n254\t\t\treturn false, fmt.Errorf(\"saving summary provider selection: %w\", err)\n255\t\t}\n256\t\treturn flagFlipped, nil\n257\t}\n258\t\n259\t// summaryProviderRows builds the structured rows used by the summary-generation\n260\t// success block. Returns nil for a nil provider so callers can append optional\n261\t// provider info to a row slice without nil-checking themselves.\n262\tfunc summaryProviderRows(provider *checkpointSummaryProvider) []explainRow {\n263\t\tif provider == nil {\n264\t\t\treturn nil\n265\t\t}\n266\t\tmodel := provider.Model\n267\t\tif model == \"\" {\n268\t\t\tmodel = \"provider default\"\n269\t\t}\n270\t\treturn []explainRow{\n271\t\t\t{Label: \"provider\", Value: provider.DisplayName},\n272\t\t\t{Label: \"model\", Value: model},\n273\t\t}\n274\t}\n275\t"}]},"uuid":"53a37b07-57a3-438e-8719-b957ec82b12c","timestamp":"2026-05-05T18:32:00.272Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/explain_summary_provider.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/external\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/summarize\"\n\n\t\"charm.land/huh/v2\"\n)\n\nvar (\n\tloadSummarySettings            = LoadEntireSettings\n\tloadSummarySettingsFromFile    = settings.LoadFromFile\n\tsaveLocalSummarySettings       = SaveEntireSettingsLocal\n\tgetSummaryAgent                = agent.Get\n\tlistRegisteredAgents           = agent.List\n\tisSummaryCLIAvailable          = agent.IsSummaryCLIAvailable\n\tdiscoverSummaryProviders       = external.DiscoverAndRegister\n\tdiscoverSummaryProvidersAlways = external.DiscoverAndRegisterAlways\n)\n\ntype checkpointSummaryProvider struct {\n\tName        types.AgentName\n\tDisplayName string\n\tModel       string\n\tGenerator   summarize.Generator\n}\n\nfunc resolveCheckpointSummaryProvider(ctx context.Context, w io.Writer) (*checkpointSummaryProvider, error) {\n\ts, err := loadSummarySettings(ctx)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"loading settings: %w\", err)\n\t}\n\n\tif s.SummaryGeneration != nil && s.SummaryGeneration.Provider != \"\" {\n\t\tproviderName := types.AgentName(s.SummaryGeneration.Provider)\n\t\tdiscoverSummaryProviderIfMissing(ctx, providerName)\n\t\tif err := ensureSummaryProviderPresent(ctx, providerName); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn buildCheckpointSummaryProvider(providerName, s.SummaryGeneration.Model)\n\t}\n\n\t// Use the always-variant so installed external plugins surface in the\n\t// picker even when external_agents is currently off. Installation\n\t// (placing entire-agent-* on $PATH) is the user's opt-in to \"this\n\t// plugin exists\"; selecting it in the picker is when external_agents\n\t// flips on (handled by persistSummaryProviderSelection).\n\tdiscoverSummaryProvidersAlways(ctx)\n\tcandidates := listEnabledSummaryProviders(ctx)\n\n\tswitch len(candidates) {\n\tcase 0:\n\t\treturn nil, errors.New(\"no summary-capable provider is available; install claude, codex, gemini, cursor, or copilot, install an external entire-agent-* plugin that declares text_generator, or set summary_generation.provider in settings\")\n\tcase 1:\n\t\treturn autoSelectSummaryProvider(ctx, w, candidates[0].Name, \"non-interactive auto-select: single installed provider\")\n\tdefault:\n\t\tif !interactive.CanPromptInteractively() {\n\t\t\treturn autoSelectSummaryProvider(ctx, w, candidates[0].Name, \"non-interactive auto-select: first detected of multiple\")\n\t\t}\n\n\t\tselected, err := promptForSummaryProvider(candidates)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tprovider, err := autoSelectSummaryProvider(ctx, w, selected, \"interactive prompt selection\")\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfmt.Fprintf(w, \"Using %s for summary generation.\\n\", provider.DisplayName)\n\t\treturn provider, nil\n\t}\n}\n\nfunc discoverSummaryProviderIfMissing(ctx context.Context, name types.AgentName) {\n\tif _, err := getSummaryAgent(name); err == nil {\n\t\treturn\n\t}\n\tdiscoverSummaryProviders(ctx)\n}\n\n// autoSelectSummaryProvider builds a provider for an auto-selected candidate\n// (single-installed or non-interactive-first-of-many) and persists the choice\n// so subsequent runs don't re-decide. Persistence failure is surfaced as a\n// warning — not an error — because the selection is still usable in-process.\nfunc autoSelectSummaryProvider(ctx context.Context, w io.Writer, name types.AgentName, reason string) (*checkpointSummaryProvider, error) {\n\tlogging.Info(ctx, reason, \"provider\", string(name))\n\tprovider, err := buildCheckpointSummaryProvider(name, \"\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tflagFlipped, saveErr := persistSummaryProviderSelection(ctx, provider.Name, provider.Model)\n\tif saveErr != nil {\n\t\tlogging.Warn(ctx, \"failed to save summary provider selection, continuing without persistence\",\n\t\t\t\"error\", saveErr.Error())\n\t\tfmt.Fprintf(w, \"Warning: could not save provider selection: %v\\nUse `entire configure --summarize-provider %s` to set it manually.\\n\", saveErr, provider.Name)\n\t}\n\tif flagFlipped {\n\t\tfmt.Fprintln(w, externalAgentsAutoEnabledNotice)\n\t}\n\treturn provider, nil\n}\n\nfunc listEnabledSummaryProviders(_ context.Context) []checkpointSummaryProvider {\n\tregistered := listRegisteredAgents()\n\tproviders := make([]checkpointSummaryProvider, 0, len(registered))\n\tfor _, name := range registered {\n\t\tag, err := getSummaryAgent(name)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif _, ok := agent.AsTextGenerator(ag); !ok {\n\t\t\tcontinue\n\t\t}\n\t\t// Check CLI binary on PATH for built-ins. External agents are already\n\t\t// proven executable by discovery and are gated by text_generator.\n\t\tif !isSummaryProviderAvailable(name, ag) {\n\t\t\tcontinue\n\t\t}\n\t\tproviders = append(providers, checkpointSummaryProvider{\n\t\t\tName:        name,\n\t\t\tDisplayName: string(ag.Type()),\n\t\t})\n\t}\n\treturn providers\n}\n\nfunc isSummaryProviderAvailable(name types.AgentName, ag agent.Agent) bool {\n\tif external.IsExternal(ag) {\n\t\t_, ok := agent.AsTextGenerator(ag)\n\t\treturn ok\n\t}\n\treturn isSummaryCLIAvailable(name)\n}\n\nfunc promptForSummaryProvider(providers []checkpointSummaryProvider) (types.AgentName, error) {\n\toptions := make([]huh.Option[string], 0, len(providers))\n\tfor _, provider := range providers {\n\t\toptions = append(options, huh.NewOption(provider.DisplayName, string(provider.Name)))\n\t}\n\n\tvar selected string\n\tform := NewAccessibleForm(\n\t\thuh.NewGroup(\n\t\t\thuh.NewSelect[string]().\n\t\t\t\tTitle(\"Choose a summary provider\").\n\t\t\t\tDescription(\"This choice will be saved. Use `entire configure --summarize-provider <name>` to change it later.\").\n\t\t\t\tOptions(options...).\n\t\t\t\tValue(&selected),\n\t\t),\n\t)\n\tif err := form.Run(); err != nil {\n\t\treturn \"\", fmt.Errorf(\"summary provider selection cancelled: %w\", err)\n\t}\n\n\treturn types.AgentName(selected), nil\n}\n\nfunc buildCheckpointSummaryProvider(name types.AgentName, model string) (*checkpointSummaryProvider, error) {\n\tag, err := getSummaryAgent(name)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"loading summary provider %s: %w\", name, err)\n\t}\n\n\ttextGenerator, ok := agent.AsTextGenerator(ag)\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"agent %s does not support summary generation\", name)\n\t}\n\n\teffectiveModel := summarize.ResolveModel(name, model)\n\n\treturn &checkpointSummaryProvider{\n\t\tName:        name,\n\t\tDisplayName: string(ag.Type()),\n\t\tModel:       effectiveModel,\n\t\tGenerator: &summarize.TextGeneratorAdapter{\n\t\t\tTextGenerator: textGenerator,\n\t\t\tModel:         effectiveModel,\n\t\t},\n\t}, nil\n}\n\n// ensureSummaryProviderPresent returns an error if the named summary provider's\n// CLI binary is not on PATH. Checks the binary directly (via exec.LookPath)\n// rather than DetectPresence, because DetectPresence checks repo-level agent\n// configuration — a repo using Claude Code for development can still use Codex\n// or Gemini for summary generation as long as the binary is installed.\nfunc ensureSummaryProviderPresent(_ context.Context, name types.AgentName) error {\n\tag, err := getSummaryAgent(name)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"unknown summary provider %s: %w\", name, err)\n\t}\n\tif _, ok := agent.AsTextGenerator(ag); !ok {\n\t\treturn fmt.Errorf(\"agent %s does not support summary generation\", name)\n\t}\n\tif !isSummaryProviderAvailable(name, ag) {\n\t\treturn fmt.Errorf(\"summary provider %q is configured but its CLI binary is not on PATH; install it or update summary_generation.provider in settings\", name)\n\t}\n\treturn nil\n}\n\nfunc validateSummaryProvider(provider string) error {\n\tname := types.AgentName(provider)\n\tag, err := getSummaryAgent(name)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"unknown summary provider %q: %w\", provider, err)\n\t}\n\tif _, ok := agent.AsTextGenerator(ag); !ok {\n\t\treturn fmt.Errorf(\"agent %q does not support summary generation\", provider)\n\t}\n\tif !isSummaryProviderAvailable(name, ag) {\n\t\treturn fmt.Errorf(\"summary provider %q is configured but its CLI binary is not on PATH; install it or choose another provider\", provider)\n\t}\n\treturn nil\n}\n\n// persistSummaryProviderSelection writes the chosen provider to\n// settings.local.json. When the chosen provider is an external agent and\n// external_agents is not yet enabled, it also flips that setting on so the\n// plugin can actually run; in that case it returns flagFlipped=true so the\n// caller can surface a one-time notice. The flag is written to local because\n// the provider choice is already machine-specific (depends on $PATH).\nfunc persistSummaryProviderSelection(ctx context.Context, provider types.AgentName, model string) (flagFlipped bool, err error) {\n\ttargetFileAbs, err := paths.AbsPath(ctx, settings.EntireSettingsLocalFile)\n\tif err != nil {\n\t\ttargetFileAbs = settings.EntireSettingsLocalFile\n\t}\n\n\ts, err := loadSummarySettingsFromFile(targetFileAbs)\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"loading settings for update: %w\", err)\n\t}\n\tif s.SummaryGeneration == nil {\n\t\ts.SummaryGeneration = &settings.SummaryGenerationSettings{}\n\t}\n\ts.SummaryGeneration.SetProvider(string(provider), model)\n\n\tif ag, getErr := getSummaryAgent(provider); getErr == nil && external.IsExternal(ag) && !s.ExternalAgents {\n\t\ts.ExternalAgents = true\n\t\tflagFlipped = true\n\t}\n\n\tif err := saveLocalSummarySettings(ctx, s); err != nil {\n\t\treturn false, fmt.Errorf(\"saving summary provider selection: %w\", err)\n\t}\n\treturn flagFlipped, nil\n}\n\n// summaryProviderRows builds the structured rows used by the summary-generation\n// success block. Returns nil for a nil provider so callers can append optional\n// provider info to a row slice without nil-checking themselves.\nfunc summaryProviderRows(provider *checkpointSummaryProvider) []explainRow {\n\tif provider == nil {\n\t\treturn nil\n\t}\n\tmodel := provider.Model\n\tif model == \"\" {\n\t\tmodel = \"provider default\"\n\t}\n\treturn []explainRow{\n\t\t{Label: \"provider\", Value: provider.DisplayName},\n\t\t{Label: \"model\", Value: model},\n\t}\n}\n","numLines":275,"startLine":1,"totalLines":275}},"sourceToolAssistantUUID":"1a7ac4c2-19dd-48ae-a2f6-a1f16b71ce2b","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
