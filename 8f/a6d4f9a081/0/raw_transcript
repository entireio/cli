\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\n// fakeGenerator is a programmable TextGenerator. Each Call returns the next\n// scripted response or runs the next scripted func.\ntype fakeGenerator struct {\n\tmu        sync.Mutex\n\tresponses []func(prompt string) (string, error)\n\tprompts   []string\n}\n\nfunc (f *fakeGenerator) GenerateText(_ context.Context, prompt, _ string) (string, error) {\n\tf.mu.Lock()\n\tdefer f.mu.Unlock()\n\tf.prompts = append(f.prompts, prompt)\n\tif len(f.responses) == 0 {\n\t\treturn \"\", errors.New(\"fake: out of scripted responses\")\n\t}\n\tresp := f.responses[0]\n\tf.responses = f.responses[1:]\n\treturn resp(prompt)\n}\n\nfunc (f *fakeGenerator) prompt(i int) string {\n\tf.mu.Lock()\n\tdefer f.mu.Unlock()\n\tif i >= len(f.prompts) {\n\t\treturn \"\"\n\t}\n\treturn f.prompts[i]\n}\n\ntype sample struct {\n\tTag string `json:\"tag\"`\n}\n\nvar sampleValidator = JSONValidator(\n\tfunc() *sample { return &sample{} },\n\tfunc(s *sample) error {\n\t\tif s.Tag == \"\" {\n\t\t\treturn NewValidationFeedback(errors.New(\"missing tag\"), \"Include a non-empty `tag` field.\")\n\t\t}\n\t\treturn nil\n\t},\n)\n\nfunc TestSynthesize_HappyPath(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{\n\t\tresponses: []func(string) (string, error){\n\t\t\tfunc(string) (string, error) { return `{\"tag\":\"ok\"}`, nil },\n\t\t},\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\tres, err := s.Synthesize(context.Background(), SynthesisRequest{\n\t\tPrompt:    \"build a domain map\",\n\t\tValidator: sampleValidator,\n\t\tLabel:     \"domain-map\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Synthesize: %v\", err)\n\t}\n\tif res.FellBack {\n\t\tt.Errorf(\"FellBack=true; want false\")\n\t}\n\tif res.Attempts != 1 {\n\t\tt.Errorf(\"Attempts=%d; want 1\", res.Attempts)\n\t}\n\tvar got sample\n\tif err := json.Unmarshal(res.Payload, &got); err != nil {\n\t\tt.Fatalf(\"payload not JSON: %v\", err)\n\t}\n\tif got.Tag != \"ok\" {\n\t\tt.Errorf(\"tag=%q; want ok\", got.Tag)\n\t}\n}\n\nfunc TestSynthesize_StripsCodeFence(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{\n\t\tresponses: []func(string) (string, error){\n\t\t\tfunc(string) (string, error) { return \"```json\\n{\\\"tag\\\":\\\"fenced\\\"}\\n```\", nil },\n\t\t},\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\tres, err := s.Synthesize(context.Background(), SynthesisRequest{\n\t\tPrompt:    \"x\",\n\t\tValidator: sampleValidator,\n\t\tLabel:     \"fenced\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Synthesize: %v\", err)\n\t}\n\tif res.FellBack {\n\t\tt.Errorf(\"FellBack=true; want false\")\n\t}\n\tvar got sample\n\tif err := json.Unmarshal(res.Payload, &got); err != nil {\n\t\tt.Fatalf(\"payload not JSON: %v\", err)\n\t}\n\tif got.Tag != \"fenced\" {\n\t\tt.Errorf(\"tag=%q; want fenced\", got.Tag)\n\t}\n}\n\nfunc TestSynthesize_RetryThenSuccess(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{\n\t\tresponses: []func(string) (string, error){\n\t\t\tfunc(string) (string, error) { return `not json`, nil },\n\t\t\tfunc(string) (string, error) { return `{\"tag\":\"recovered\"}`, nil },\n\t\t},\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\tres, err := s.Synthesize(context.Background(), SynthesisRequest{\n\t\tPrompt:    \"x\",\n\t\tValidator: sampleValidator,\n\t\tLabel:     \"retry\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Synthesize: %v\", err)\n\t}\n\tif res.FellBack {\n\t\tt.Errorf(\"FellBack=true; want false\")\n\t}\n\tif res.Attempts != 2 {\n\t\tt.Errorf(\"Attempts=%d; want 2\", res.Attempts)\n\t}\n\tif !strings.Contains(fake.prompt(1), \"JSON only\") {\n\t\tt.Errorf(\"retry prompt missing strict reminder; got=%q\", fake.prompt(1))\n\t}\n}\n\nfunc TestSynthesize_RetryThenFallback(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{\n\t\tresponses: []func(string) (string, error){\n\t\t\tfunc(string) (string, error) { return `still not json`, nil },\