{"parentUuid":"0ed36a1c-0170-442b-aba4-b022e75a55e5","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/understand_dashboard.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"os/exec\"\n9\t\t\"runtime\"\n10\t\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/understand/dashboard\"\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n14\t\t\"github.com/spf13/cobra\"\n15\t)\n16\t\n17\t// newUnderstandDashboardCmd builds `entire understand dashboard`.\n18\t//\n19\t// Server is loopback-only with a per-launch bearer token. Token is rendered\n20\t// into the bootstrap HTML via a server-injected script tag — never via a URL\n21\t// or query string — so it can't leak into browser history or screenshots.\n22\t//\n23\t// --print emits the URL + token to stdout instead of starting the browser\n24\t// and is the form tests and scripted callers should use.\n25\t//\n26\t// --replay is accepted for API compatibility with the `replay` command; for\n27\t// v1 it is a thin alias that just sets a query-string-free fragment hash so\n28\t// the SPA can default to a replay-mode view.\n29\tfunc newUnderstandDashboardCmd() *cobra.Command {\n30\t\tvar openBrowser bool\n31\t\tvar replay bool\n32\t\tvar printOnly bool\n33\t\n34\t\tcmd := &cobra.Command{\n35\t\t\tUse:   \"dashboard\",\n36\t\t\tShort: \"Launch the loopback dashboard for the understand graph\",\n37\t\t\tLong: `Start a 127.0.0.1-only HTTP server backed by the local understand cache.\n38\t\n39\tEach launch mints a fresh random bearer token. The token is required on\n40\tevery API call via the Authorization header — never in the URL — so it\n41\tcannot leak into browser history, screenshots, or copied links.\n42\t\n43\tEndpoints:\n44\t  /                  HTML shell (bootstraps the token into window state)\n45\t  /api/manifest      Build manifest\n46\t  /api/graph         Fused graph (read-only, no transcript bodies)\n47\t  /api/timeline      Replay events\n48\t  /api/hotspots      Per-file score table\n49\t  /api/checkpoint/<id>\n50\t                     Reserved for on-demand transcript lookup; v1 returns 404\n51\t                     to prevent bulk exposure.`,\n52\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n53\t\t\t\treturn runUnderstandDashboard(cmd.Context(), cmd.OutOrStdout(), dashboardOptions{\n54\t\t\t\t\tOpen:      openBrowser,\n55\t\t\t\t\tReplay:    replay,\n56\t\t\t\t\tPrintOnly: printOnly,\n57\t\t\t\t})\n58\t\t\t},\n59\t\t}\n60\t\tcmd.Flags().BoolVar(&openBrowser, \"open\", false, \"Open the URL in the default browser after launch\")\n61\t\tcmd.Flags().BoolVar(&replay, \"replay\", false, \"Default the dashboard view to replay/timeline mode\")\n62\t\tcmd.Flags().BoolVar(&printOnly, \"print\", false, \"Print the URL + token and exit instead of running the server\")\n63\t\treturn cmd\n64\t}\n65\t\n66\ttype dashboardOptions struct {\n67\t\tOpen      bool\n68\t\tReplay    bool\n69\t\tPrintOnly bool\n70\t}\n71\t\n72\tfunc runUnderstandDashboard(ctx context.Context, w io.Writer, opts dashboardOptions) error {\n73\t\troot, err := paths.WorktreeRoot(ctx)\n74\t\tif err != nil {\n75\t\t\treturn fmt.Errorf(\"resolve repo root: %w\", err)\n76\t\t}\n77\t\tstore := graph.NewStore(root)\n78\t\tif !store.Exists() {\n79\t\t\treturn errors.New(\"no understand cache yet — run `entire understand build`\")\n80\t\t}\n81\t\n82\t\tsrv, err := dashboard.New(store)\n83\t\tif err != nil {\n84\t\t\treturn fmt.Errorf(\"dashboard: %w\", err)\n85\t\t}\n86\t\tif opts.PrintOnly {\n87\t\t\t// Build a printable line that includes the token but does NOT actually\n88\t\t\t// start the listener. Useful for tests and for users who want to\n89\t\t\t// drive the API from curl without opening a browser tab.\n90\t\t\tfmt.Fprintf(w, \"would-launch: token=%s (run without --print to bind)\\n\", srv.Token())\n91\t\t\treturn nil\n92\t\t}\n93\t\n94\t\turl, err := srv.Start(ctx)\n95\t\tif err != nil {\n96\t\t\treturn fmt.Errorf(\"start dashboard: %w\", err)\n97\t\t}\n98\t\tdefer func() { _ = srv.Stop() }()\n99\t\n100\t\tsuffix := \"\"\n101\t\tif opts.Replay {\n102\t\t\tsuffix = \"#replay\"\n103\t\t}\n104\t\tfullURL := url + suffix\n105\t\tfmt.Fprintf(w, \"dashboard: %s\\n\", fullURL)\n106\t\tfmt.Fprintf(w, \"  bearer token: %s (use Authorization: Bearer ...)\\n\", srv.Token())\n107\t\tif opts.Open {\n108\t\t\tif err := openBrowserCommand(fullURL); err != nil {\n109\t\t\t\tfmt.Fprintf(w, \"  (couldn't open browser automatically: %s)\\n\", err.Error())\n110\t\t\t}\n111\t\t}\n112\t\tfmt.Fprintln(w, \"  press Ctrl-C to stop the server.\")\n113\t\n114\t\t<-ctx.Done()\n115\t\treturn nil\n116\t}\n117\t\n118\t// openBrowserCommand uses the platform's default URL opener. We do not pass\n119\t// the token to the OS opener — it is already in the page bootstrap.\n120\tfunc openBrowserCommand(url string) error {\n121\t\tvar bin string\n122\t\tvar args []string\n123\t\tswitch runtime.GOOS {\n124\t\tcase \"darwin\":\n125\t\t\tbin = \"open\"\n126\t\t\targs = []string{url}\n127\t\tcase \"windows\":\n128\t\t\tbin = \"rundll32\"\n129\t\t\targs = []string{\"url.dll,FileProtocolHandler\", url}\n130\t\tdefault:\n131\t\t\tbin = \"xdg-open\"\n132\t\t\targs = []string{url}\n133\t\t}\n134\t\tif _, err := exec.LookPath(bin); err != nil {\n135\t\t\treturn fmt.Errorf(\"no URL opener on PATH (%s): %w\", bin, err)\n136\t\t}\n137\t\tcmd := exec.Command(bin, args...)\n138\t\tif err := cmd.Start(); err != nil {\n139\t\t\treturn fmt.Errorf(\"open browser: %w\", err)\n140\t\t}\n141\t\treturn nil\n142\t}"},"type":"attachment","uuid":"24d16b69-406a-4f46-b150-a152b20318db","timestamp":"2026-05-05T19:01:53.314Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBra