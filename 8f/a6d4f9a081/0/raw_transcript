t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\tres, err := s.Synthesize(context.Background(), SynthesisRequest{\n\t\tPrompt:    \"x\",\n\t\tValidator: sampleValidator,\n\t\tLabel:     \"retry\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Synthesize: %v\", err)\n\t}\n\tif res.FellBack {\n\t\tt.Errorf(\"FellBack=true; want false\")\n\t}\n\tif res.Attempts != 2 {\n\t\tt.Errorf(\"Attempts=%d; want 2\", res.Attempts)\n\t}\n\tif !strings.Contains(fake.prompt(1), \"JSON only\") {\n\t\tt.Errorf(\"retry prompt missing strict reminder; got=%q\", fake.prompt(1))\n\t}\n}\n\nfunc TestSynthesize_RetryThenFallback(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{\n\t\tresponses: []func(string) (string, error){\n\t\t\tfunc(string) (string, error) { return `still not json`, nil },\n\t\t\tfunc(string) (string, error) { return `{\"tag\":\"\"}`, nil }, // valid JSON, fails invariant\n\t\t},\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\tres, err := s.Synthesize(context.Background(), SynthesisRequest{\n\t\tPrompt:    \"x\",\n\t\tValidator: sampleValidator,\n\t\tLabel:     \"fallback\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Synthesize: %v\", err)\n\t}\n\tif !res.FellBack {\n\t\tt.Errorf(\"FellBack=false; want true\")\n\t}\n\tif res.Attempts != 2 {\n\t\tt.Errorf(\"Attempts=%d; want 2\", res.Attempts)\n\t}\n\tif res.LastError == nil {\n\t\tt.Errorf(\"LastError=nil; want validation error\")\n\t}\n}\n\nfunc TestSynthesize_ContextCancelTerminal(t *testing.T) {\n\tt.Parallel()\n\n\tctx, cancel := context.WithCancel(context.Background())\n\tcancel() // cancelled before we even call\n\n\tfake := &fakeGenerator{\n\t\tresponses: []func(string) (string, error){\n\t\t\tfunc(string) (string, error) { return \"\", context.Canceled },\n\t\t},\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\t_, err := s.Synthesize(ctx, SynthesisRequest{\n\t\tPrompt:    \"x\",\n\t\tValidator: sampleValidator,\n\t\tLabel:     \"cancelled\",\n\t})\n\tif !errors.Is(err, context.Canceled) {\n\t\tt.Errorf(\"err=%v; want context.Canceled\", err)\n\t}\n}\n\nfunc TestSynthesize_StrictReminderHintAttached(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{\n\t\tresponses: []func(string) (string, error){\n\t\t\tfunc(string) (string, error) { return `{\"tag\":\"\"}`, nil }, // first attempt fails invariant w/ hint\n\t\t\tfunc(string) (string, error) { return `{\"tag\":\"ok\"}`, nil },\n\t\t},\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\t_, err := s.Synthesize(context.Background(), SynthesisRequest{\n\t\tPrompt:    \"x\",\n\t\tValidator: sampleValidator,\n\t\tLabel:     \"hint\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Synthesize: %v\", err)\n\t}\n\tif !strings.Contains(fake.prompt(1), \"Validation hint\") {\n\t\tt.Errorf(\"retry prompt missing validation hint; got=%q\", fake.prompt(1))\n\t}\n}\n\nfunc TestSynthesize_RejectsNilValidator(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{}\n\ts := &Synthesizer{Generator: fake}\n\n\t_, err := s.Synthesize(context.Background(), SynthesisRequest{Prompt: \"x\"})\n\tif err == nil {\n\t\tt.Fatal(\"Synthesize: want error for nil validator\")\n\t}\n}\n\nfunc TestRunSharded_PreservesOrder(t *testing.T) {\n\tt.Parallel()\n\n\tvar calls atomic.Int32\n\n\tfake := &fakeGenerator{}\n\tfor range 5 {\n\t\tfake.responses = append(fake.responses, func(string) (string, error) {\n\t\t\tcalls.Add(1)\n\t\t\treturn `{\"tag\":\"ok\"}`, nil\n\t\t})\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\titems := []string{\"a\", \"b\", \"c\", \"d\", \"e\"}\n\touts, err := RunSharded(context.Background(), s, items, func(item string) SynthesisRequest {\n\t\treturn SynthesisRequest{Prompt: item, Validator: sampleValidator, Label: item}\n\t}, 2)\n\tif err != nil {\n\t\tt.Fatalf(\"RunSharded: %v\", err)\n\t}\n\tif got := calls.Load(); got != 5 {\n\t\tt.Errorf(\"calls=%d; want 5\", got)\n\t}\n\tfor i, want := range items {\n\t\tif outs[i].Item != want {\n\t\t\tt.Errorf(\"outs[%d].Item=%q; want %q\", i, outs[i].Item, want)\n\t\t}\n\t\tif outs[i].Result == nil || outs[i].Result.FellBack {\n\t\t\tt.Errorf(\"outs[%d].Result invalid: %+v\", i, outs[i].Result)\n\t\t}\n\t}\n}\n\nfunc TestRunSharded_ConcurrencyCap(t *testing.T) {\n\tt.Parallel()\n\n\tvar inflight atomic.Int32\n\tvar peak atomic.Int32\n\n\tfake := &fakeGenerator{}\n\tfor range 6 {\n\t\tfake.responses = append(fake.responses, func(string) (string, error) {\n\t\t\tcur := inflight.Add(1)\n\t\t\tdefer inflight.Add(-1)\n\t\t\tfor {\n\t\t\t\tprev := peak.Load()\n\t\t\t\tif cur <= prev || peak.CompareAndSwap(prev, cur) {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\ttime.Sleep(20 * time.Millisecond)\n\t\t\treturn `{\"tag\":\"ok\"}`, nil\n\t\t})\n\t}\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\titems := []int{1, 2, 3, 4, 5, 6}\n\t_, err := RunSharded(context.Background(), s, items, func(int) SynthesisRequest {\n\t\treturn SynthesisRequest{Prompt: \"x\", Validator: sampleValidator, Label: \"x\"}\n\t}, 2)\n\tif err != nil {\n\t\tt.Fatalf(\"RunSharded: %v\", err)\n\t}\n\tif got := peak.Load(); got > 2 {\n\t\tt.Errorf(\"peak in-flight=%d; want <=2\", got)\n\t}\n}\n\nfunc TestRunSharded_FallbackPerShardDoesNotBlockOthers(t *testing.T) {\n\tt.Parallel()\n\n\tfake := &fakeGenerator{}\n\t// 3 shards × 2 attempts each — first shard always fails twice, others succeed.\n\tfake.responses = append(fake.responses,\n\t\tfunc(string) (string, error) { return \"garbage\", nil },           // shard 1 attempt 1\n\t\tfunc(string) (string, error) { return `{\"tag\":\"ok\"}`, nil },      // shard 2 attempt 1\n\t\tfunc(string) (string, error) { return `{\"tag\":\"ok\"}`, nil },      // shard 3 attempt 1\n\t\tfunc(string) (string, error) { return \"still garbage\", nil },     // shard 1 attempt 2 → fall back\n\t)\n\ts := &Synthesizer{Generator: fake, Logger: NopLogger{}}\n\n\titems := []string{\"first\", \"second\", \"third\"}\n\touts, err := RunSharded(context.Background(), s, items, func(item string) SynthesisRequest {\n\t\treturn SynthesisRequest{Prompt: item, Validator: sampleValidator, Label: item}\n\t}, 1) // serial so the response order is deterministic\n\tif err != nil {\n\t\tt.Fatalf(\"RunSharded: %v\", err)\n\t}\n\tif !outs[0].Result.FellBack {\n\t\tt.Errorf(\"shard 0 should have fallen back\")\n\t}\n\tif outs[1].Result.FellBack || outs[2].Result.FellBack {\n\t\tt.Errorf(\"shards 1,2 should NOT have fallen back: %+v %+v\", outs[1].Result, outs[2].Result)\n\t}\n}\n\nfunc TestNewDataBlock_WrapsContent(t *testing.T) {\n\tt.Parallel()\n\n\tblock, err := NewDataBlock(\"checkpoint\", \"deadbeef cafe abc def\")\n\tif err != nil {\n\t\tt.Fatalf(\"NewDataBlock: %v\", err)\n\t}\n\tout := block.String()\n\n\tif !strings.Contains(out, \"<checkpoint nonce=\") {\n\t\tt.Errorf(\"opening tag missing nonce attribute: %s\", out)\n\t}\n\tif !strings.Contains(out, \"</checkpoint>\") {\n\t\tt.Errorf(\"closing tag missing: %s\", out)\n\t}\n\tif !strings.Contains(out, \"deadbeef cafe abc def\") {\n\t\tt.Errorf(\"content missing: %s\", out)\n\t}\n}\n\nfunc TestNewDataBlock_RequiresTag(t *testing.T) {\n\tt.Parallel()\n\n\tif _, err := NewDataBlock(\"\", \"anything\"); err == nil {\n\t\tt.Fatal(\"want error for empty tag\")\n\t}\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"d3a54aeb-a53d-4d56-a574-01ed99857a10","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
