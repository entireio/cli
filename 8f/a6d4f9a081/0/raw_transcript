j < len(out); j++ {\n\t\t\tif out[j].Score > out[i].Score || (out[j].Score == out[i].Score && out[j].Path < out[i].Path) {\n\t\t\t\tout[i], out[j] = out[j], out[i]\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}\n\nfunc writeJSON(w http.ResponseWriter, v any) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tenc := json.NewEncoder(w)\n\tenc.SetEscapeHTML(false)\n\tif err := enc.Encode(v); err != nil {\n\t\t// Headers are already flushed; the client will see a truncated\n\t\t// response but no panic. Surface for ops via the server log.\n\t\thttp.Error(w, \"encode failure\", http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc mintToken() (string, error) {\n\tvar b [16]byte\n\tif _, err := rand.Read(b[:]); err != nil {\n\t\treturn \"\", fmt.Errorf(\"dashboard: random token: %w\", err)\n\t}\n\treturn hex.EncodeToString(b[:]), nil\n}\n","structuredPatch":[{"oldStart":39,"oldLines":9,"newStart":39,"newLines":17,"lines":[" //go:embed assets/index.html"," var indexHTML string"," ","+// CheckpointReader is the minimal surface the dashboard needs to resolve","+// /api/checkpoint/<id> on demand. It mirrors checkpoint.GitStore.ReadCommitted","+// so tests can inject a fake reader without spinning up a real git repo.","+type CheckpointReader interface {","+  ReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*checkpoint.CheckpointSummary, error)","+}","+"," // Server is the loopback dashboard. Construct via New and start with Start."," type Server struct {","   store     *graph.Store","+  cpReader  CheckpointReader","   listener  net.Listener","   server    *http.Server","   token     string"]},{"oldStart":51,"oldLines":7,"newStart":59,"newLines":12,"lines":[" }"," "," // New builds an unstarted server bound to the given store.","-func New(store *graph.Store) (*Server, error) {","+//","+// cpReader is optional; pass nil to keep the on-demand che