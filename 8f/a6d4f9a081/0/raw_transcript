learWorktreeRootCache()\n\n\tvar buf bytes.Buffer\n\tif err := runUnderstandBuild(context.Background(), &buf, buildOptions{NoSemantic: true}); err != nil {\n\t\tt.Fatalf(\"runUnderstandBuild: %v\", err)\n\t}\n\n\tout := buf.String()\n\tif !strings.Contains(out, \"structural:\") {\n\t\tt.Errorf(\"missing structural progress line; got:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"semantic: skipped (--no-semantic)\") {\n\t\tt.Errorf(\"missing --no-semantic skip line; got:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"build complete\") {\n\t\tt.Errorf(\"missing completion line; got:\\n%s\", out)\n\t}\n\n\t// Manifest should now exist with structural=ok, semantic=skipped.\n\tstore := graph.NewStore(dir)\n\tmanifest, err := store.ReadManifest()\n\tif err != nil {\n\t\tt.Fatalf(\"ReadManifest: %v\", err)\n\t}\n\tif manifest.StructuralStatus != \"ok\" {\n\t\tt.Errorf(\"StructuralStatus=%q; want ok\", manifest.StructuralStatus)\n\t}\n\tif manifest.SemanticStatus != graph.SemanticSkipped {\n\t\tt.Errorf(\"SemanticStatus=%q; want skipped\", manifest.SemanticStatus)\n\t}\n\tif manifest.NodeCount == 0 {\n\t\tt.Errorf(\"NodeCount=0; want >0 (we wrote two go files)\")\n\t}\n\tif !contains(manifest.SupportedLanguages, \"go\") {\n\t\tt.Errorf(\"SupportedLanguages=%v; want to include go\", manifest.SupportedLanguages)\n\t}\n\n\t// Structural slice must round-trip through the store.\n\tstr, err := store.ReadStructural()\n\tif err != nil {\n\t\tt.Fatalf(\"ReadStructural: %v\", err)\n\t}\n\tif len(str.Nodes) == 0 {\n\t\tt.Errorf(\"structural nodes empty after build\")\n\t}\n\n\t// History slice exists but is empty (no checkpoints branch yet).\n\thist, err := store.ReadHistory()\n\tif err != nil {\n\t\tt.Fatalf(\"ReadHistory: %v\", err)\n\t}\n\tif len(hist.Nodes) != 0 {\n\t\tt.Errorf(\"history nodes=%d; want 0 (no checkpoints branch)\", len(hist.Nodes))\n\t}\n\n\t// Timeline written, even if empty.\n\ttl, err := store.ReadTimeline()\n\tif err != nil {\n\t\tt.Fatalf(\"ReadTimeline: