{"parentUuid":"68689273-6ff1-4504-b348-cc3288c02974","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/understand_impact.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"sort\"\n9\t\n10\t\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n12\t\t\"github.com/spf13/cobra\"\n13\t)\n14\t\n15\t// newUnderstandImpactCmd builds `entire understand impact <file|node>`.\n16\t//\n17\t// For the POC the impact analysis is structural: starting from the resolved\n18\t// node, walk contains-edges to find sibling/descendant files plus\n19\t// touched_in-edges to find files that share a checkpoint history with the\n20\t// target. Each affected file is annotated with its last touching checkpoint.\n21\t//\n22\t// Symbol-level call/import edges are not yet emitted by the structural index\n23\t// (Go-only POC, no go/types resolution); when those land, this command will\n24\t// pick them up automatically because the walker is already shape-flexible.\n25\tfunc newUnderstandImpactCmd() *cobra.Command {\n26\t\tvar jsonOut bool\n27\t\tvar maxAffected int\n28\t\n29\t\tcmd := &cobra.Command{\n30\t\t\tUse:   \"impact <file|node>\",\n31\t\t\tShort: \"Estimate the structural and historical blast radius of a change\",\n32\t\t\tLong: `Walk dependency and ownership edges from the target and rank affected nodes.\n33\tFor the POC the relations considered are 'contains' (siblings/descendants) and\n34\t'touched_in' (files that share a checkpoint history with the target).\n35\t\n36\tExamples:\n37\t  entire understand impact cmd/entire/cli/root.go\n38\t  entire understand impact dir:cmd/entire/cli/understand`,\n39\t\t\tArgs: cobra.ExactArgs(1),\n40\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n41\t\t\t\treturn runUnderstandImpact(cmd.Context(), cmd.OutOrStdout(), args[0], jsonOut, maxAffected)\n42\t\t\t},\n43\t\t}\n44\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n45\t\tcmd.Flags().IntVar(&maxAffected, \"max\", 30, \"Maximum number of affected nodes to list\")\n46\t\treturn cmd\n47\t}\n48\t\n49\ttype impactNeighbor struct {\n50\t\tNodeID         string `json:\"node_id\"`\n51\t\tPath           string `json:\"path,omitempty\"`\n52\t\tType           string `json:\"type\"`\n53\t\tReason         string `json:\"reason\"`\n54\t\tSharedCps      int    `json:\"shared_checkpoints,omitempty\"`\n55\t\tLastCheckpoint string `json:\"last_checkpoint,omitempty\"`\n56\t\tLastAt         string `json:\"last_at,omitempty\"`\n57\t}\n58\t\n59\ttype impactReport struct {\n60\t\tTarget    string           `json:\"target\"`\n61\t\tNodeID    string           `json:\"node_id\"`\n62\t\tAffected  []impactNeighbor `json:\"affected\"`\n63\t\tTruncated bool             `json:\"truncated,omitempty\"`\n64\t}\n65\t\n66\tfunc runUnderstandImpact(ctx context.Context, w io.Writer, target string, jsonOut bool, maxAffected int) error {\n67\t\tq, err := loadQueryEnv(ctx)\n68\t\tif err != nil {\n69\t\t\tif errors.Is(err, errNoUnderstandCache) {\n70\t\t\t\tfmt.Fprintln(w, err.Error())\n71\t\t\t\treturn nil\n72\t\t\t}\n73\t\t\treturn err\n74\t\t}\n75\t\tnode, err := q.resolveAreaNode(target)\n76\t\tif err != nil {\n77\t\t\treturn err\n78\t\t}\n79\t\n80\t\treport := impactReport{Target: target, NodeID: node.ID}\n81\t\n82\t\t// Collect \"shared checkpoint\" siblings: files that appear in the same\n83\t\t// touched_in edge set as the target. Score by number of overlapping cps.\n84\t\tshared := computeImpactSharedCheckpoints(q, node.ID)\n85\t\n86\t\t// Collect contains-descendants for area-style queries (dir:/repo:.).\n87\t\tdescendants := q.descendantFiles(node.ID)\n88\t\n89\t\t// Merge and de-dupe (descendants take precedence over shared, since their\n90\t\t// reason is structural rather than inferred).\n91\t\tseen := map[string]bool{node.ID: true}\n92\t\tfor _, d := range descendants {\n93\t\t\tif seen[d.ID] {\n94\t\t\t\tcontinue\n95\t\t\t}\n96\t\t\tseen[d.ID] = true\n97\t\t\treport.Affected = append(report.Affected, neighborFor(q, d, \"contains\"))\n98\t\t}\n99\t\t// Sort shared by overlap desc, recency desc.\n100\t\ttype sharedEntry struct {\n101\t\t\tnodeID string\n102\t\t\tcount  int\n103\t\t\tlastAt string\n104\t\t}\n105\t\tentries := make([]sharedEntry, 0, len(shared))\n106\t\tfor id, count := range shared {\n107\t\t\tif seen[id] {\n108\t\t\t\tcontinue\n109\t\t\t}\n110\t\t\tvar lastAt string\n111\t\t\tif cp := q.recentCheckpoint(id); cp != nil {\n112\t\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n113\t\t\t\t\tlastAt = at\n114\t\t\t\t}\n115\t\t\t}\n116\t\t\tentries = append(entries, sharedEntry{nodeID: id, count: count, lastAt: lastAt})\n117\t\t}\n118\t\tsort.Slice(entries, func(i, j int) bool {\n119\t\t\tif entries[i].count != entries[j].count {\n120\t\t\t\treturn entries[i].count > entries[j].count\n121\t\t\t}\n122\t\t\treturn entries[i].lastAt > entries[j].lastAt\n123\t\t})\n124\t\tfor _, e := range entries {\n125\t\t\tn := q.byID[e.nodeID]\n126\t\t\tif n == nil {\n127\t\t\t\tcontinue\n128\t\t\t}\n129\t\t\tnb := neighborFor(q, n, fmt.Sprintf(\"shares %d checkpoint(s)\", e.count))\n130\t\t\tnb.SharedCps = e.count\n131\t\t\treport.Affected = append(report.Affected, nb)\n132\t\t}\n133\t\n134\t\tif maxAffected > 0 && len(report.Affected) > maxAffected {\n135\t\t\treport.Affected = report.Affected[:maxAffected]\n136\t\t\treport.Truncated = true\n137\t\t}\n138\t\n139\t\treturn emitImpact(w, report, jsonOut)\n140\t}\n141\t\n142\t// computeImpactSharedCheckpoints returns map[fileNodeID]sharedCpCount for files\n143\t// that share at least one cp with `targetID`.\n144\tfunc computeImpactSharedCheckpoints(q *queryEnv, targetID string) map[string]int {\n145\t\tcpsForTarget := map[string]struct{}{}\n146\t\tfor _, cpID := range q.touchedCps[targetID] {\n147\t\t\tcpsForTarget[cpID] = struct{}{}\n148\t\t}\n149\t\tif len(cpsForTarget) == 0 {\n150\t\t\treturn nil\n151\t\t}\n152\t\tout := map[string]int{}\n153\t\tfor fileID, cps := range q.touchedCps {\n154\t\t\tif fileID == targetID {\n155\t\t\t\tcontinue\n156\t\t\t}\n157\t\t\tcount := 0\n158\t\t\tfor _, cp := range cps {\n159\t\t\t\tif _, ok := cpsForTarget[cp]; ok {\n160\t\t\t\t\tcount++\n161\t\t\t\t}\n162\t\t\t}\n163\t\t\tif count > 0 {\n164\t\t\t\tout[fileID] = count\n165\t\t\t}\n166\t\t}\n167\t\treturn out\n168\t}\n169\t\n170\tfunc neighborFor(q *queryEnv, n *graph.Node, reason string) impactNeighbor {\n171\t\tnb := impactNeighbor{\n172\t\t\tNodeID: n.ID,\n173\t\t\tPath:   n.Path,\n174\t\t\tType:   string(n.Type),\n175\t\t\tReason: reason,\n176\t\t}\n177\t\tif cp := q.recentCheckpoint(n.ID); cp != nil {\n178\t\t\tnb.LastCheckpoint = cp.Name\n179\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n180\t\t\t\tnb.LastAt = at\n181\t\t\t}\n182\t\t}\n183\t\treturn nb\n184\t}\n185\t\n186\tfunc emitImpact(w io.Writer, r impactReport, jsonOut bool) error {\n187\t\tif jsonOut {\n188\t\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n189\t\t\tif err != nil {\n190\t\t\t\treturn fmt.Errorf(\"marshal impact: %w\", err)\n191\t\t\t}\n192\t\t\tif _, err := w.Write(data); err != nil {\n193\t\t\t\treturn fmt.Errorf(\"write impact JSON: %w\", err)\n194\t\t\t}\n195\t\t\treturn nil\n196\t\t}\n197\t\tfmt.Fprintf(w, \"# Impact: %s (`%s`)\\n\\n\", r.Target, r.NodeID)\n198\t\tif len(r.Affected) == 0 {\n199\t\t\tfmt.Fprintln(w, \"_No structural neighbors or shared-checkpoint files found._\")\n200\t\t\treturn nil\n201\t\t}\n202\t\tfor _, n := range r.Affected {\n203\t\t\tpath := n.Path\n204\t\t\tif path == \"\" {\n205\t\t\t\tpath = n.NodeID\n206\t\t\t}\n207\t\t\tfmt.Fprintf(w, \"- **%s** _(%s)_ — %s\", path, n.Type, n.Reason)\n208\t\t\tif n.LastCheckpoint != \"\" {\n209\t\t\t\tfmt.Fprintf(w, \"; last in `%s`\", n.LastCheckpoint)\n210\t\t\t\tif n.LastAt != \"\" {\n211\t\t\t\t\tfmt.Fprintf(w, \" at