tatus=%d; want 401 (token in URL must not authenticate)\", rec.Code)\n\t}\n}\n\nfunc TestServer_RejectsNonGetMethods(t *testing.T) {\n\tt.Parallel()\n\tsrv, h := newHandler(t)\n\trec := httptest.NewRecorder()\n\treq := httptest.NewRequestWithContext(t.Context(), http.MethodPost, \"/api/manifest\", strings.NewReader(\"{}\"))\n\treq.Header.Set(\"Authorization\", \"Bearer \"+srv.Token())\n\th.ServeHTTP(rec, req)\n\tif rec.Code != http.StatusMethodNotAllowed {\n\t\tt.Errorf(\"status=%d; want 405\", rec.Code)\n\t}\n}\n\nfunc TestServer_GraphIsReadOnlyShape(t *testing.T) {\n\tt.Parallel()\n\tsrv, h := newHandler(t)\n\trec := httptest.NewRecorder()\n\treq := httptest.NewRequestWithContext(t.Context(), http.MethodGet, \"/api/graph\", http.NoBody)\n\treq.Header.Set(\"Authorization\", \"Bearer \"+srv.Token())\n\th.ServeHTTP(rec, req)\n\tif rec.Code != http.StatusOK {\n\t\tt.Fatalf(\"status=%d; want 200\", rec.Code)\n\t}\n\tbody, readErr := io.ReadAll(rec.Body)\n\tif readErr != nil {\n\t\tt.Fatalf(\"read body: %v\", readErr)\n\t}\n\n\t// The graph endpoint must NOT include any prompt/transcript bodies in\n\t// bulk. We canary on a few sentinel keys; if any of these appear here\n\t// we have accidentally widened the bulk-exposure surface.\n\tfor _, banned := range []string{\"\\\"prompt\\\"\", \"\\\"transcript\\\"\", \"transcript_body\", \"raw_transcript\"} {\n\t\tif strings.Contains(string(body), banned) {\n\t\t\tt.Errorf(\"graph response contained banned key %q (transcript bulk-leak regression):\\n%s\", banned, string(body))\n\t\t}\n\t}\n}\n\nfunc TestServer_CheckpointDetailIsStub(t *testing.T) {\n\tt.Parallel()\n\tsrv, h := newHandler(t)\n\trec := httptest.NewRecorder()\n\treq := httptest.NewRequestWithContext(t.Context(), http.MethodGet, \"/api/checkpoint/abc\", http.NoBody)\n\treq.Header.Set(\"Authorization\", \"Bearer \"+srv.Token())\n\th.ServeHTTP(rec, req)\n\tif rec.Code != http.StatusNotFound {\n\t\tt.Errorf(\"status=%d; want 404 (v1 dashboard refuses to expose detail)\