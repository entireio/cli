.Body)\n155\t\tif readErr != nil {\n156\t\t\tt.Fatalf(\"read body: %v\", readErr)\n157\t\t}\n158\t\n159\t\t// The graph endpoint must NOT include any prompt/transcript bodies in\n160\t\t// bulk. We canary on a few sentinel keys; if any of these appear here\n161\t\t// we have accidentally widened the bulk-exposure surface.\n162\t\tfor _, banned := range []string{\"\\\"prompt\\\"\", \"\\\"transcript\\\"\", \"transcript_body\", \"raw_transcript\"} {\n163\t\t\tif strings.Contains(string(body), banned) {\n164\t\t\t\tt.Errorf(\"graph response contained banned key %q (transcript bulk-leak regression):\\n%s\", banned, string(body))\n165\t\t\t}\n166\t\t}\n167\t}\n168\t\n169\tfunc TestServer_CheckpointDetailIsStub(t *testing.T) {\n170\t\tt.Parallel()\n171\t\tsrv, h := newHandler(t)\n172\t\trec := httptest.NewRecorder()\n173\t\treq := httptest.NewRequestWithContext(t.Context(), http.MethodGet, \"/api/checkpoint/abc\", http.NoBody)\n174\t\treq.Header.Set(\"Authorization\", \"Bearer \"+srv.Token())\n175\t\th.ServeHTTP(rec, req)\n176\t\tif rec.Code != http.StatusNotFound {\n177\t\t\tt.Errorf(\"status=%d; want 404 (v1 dashboard refuses to expose detail)\", rec.Code)\n178\t\t}\n179\t}\n180\t\n181\tfunc TestServer_IndexBootstrapsToken(t *testing.T) {\n182\t\tt.Parallel()\n183\t\tsrv, h := newHandler(t)\n184\t\trec := httptest.NewRecorder()\n185\t\treq := httptest.NewRequestWithContext(t.Context(), http.MethodGet, \"/\", http.NoBody)\n186\t\th.ServeHTTP(rec, req)\n187\t\tif rec.Code != http.StatusOK {\n188\t\t\tt.Fatalf(\"index status=%d; want 200\", rec.Code)\n189\t\t}\n190\t\tbody := rec.Body.String()\n191\t\tif !strings.Contains(body, \"window.__entireUnderstandToken=\") {\n192\t\t\tt.Errorf(\"index missing bootstrap script tag\")\n193\t\t}\n194\t\tif !strings.Contains(body, srv.Token()) {\n195\t\t\tt.Errorf(\"index didn't include the per-launch token\")\n196\t\t}\n197\t\t// Token must NOT appear inside a URL-shaped fragment in the body.\n198\t\tif strings.Contains(body, \"?token=\"+srv.Token()) {\n199\t\t\tt.Errorf(\"token appeared in a URL — must only be in bootstrap state\")\n200\t\t}\n201\t}\n202\t\n203\tfunc TestServer_FreshTokenPerInstance(t *testing.T) {\n204\t\tt.Parallel()\n205\t\tsrvA, _ := newHandler(t)\n206\t\tsrvB, _ := newHandler(t)\n207\t\tif srvA.Token() == \"\" || srvB.Token() == \"\" {\n208\t\t\tt.Fatalf(\"empty token: a=%q b=%q\", srvA.Token(), srvB.Token())\n209\t\t}\n210\t\tif srvA.Token() == srvB.Token() {\n211\t\t\tt.Errorf(\"tokens collided: %q\", srvA.Token())\n212\t\t}\n213\t}\n214\t\n215\tfunc TestServer_LiveListenerOnLoopback(t *testing.T) {\n216\t\tt.Parallel()\n217\t\tstore := makeStore(t)\n218\t\tsrv, err := New(store)\n219\t\tif err != nil {\n220\t\t\tt.Fatalf(\"New: %v\", err)\n221\t\t}\n222\t\turl, err := srv.Start(t.Context())\n223\t\tif err != nil {\n224\t\t\tt.Fatalf(\"Start: %v\", err)\n225\t\t}\n226\t\tt.Cleanup(func() {\n227\t\t\tif err := srv.Stop(); err != nil {\n228\t\t\t\tt.Logf(\"Stop: %v\", err)\n229\t\t\t}\n230\t\t})\n231\t\tif !strings.HasPrefix(url, \"http://127.0.0.1:\") {\n232\t\t\tt.Errorf(\"URL=%q; must bind to 127.0.0.1 only\", url)\n233\t\t}\n234\t}"},"type":"attachment","uuid":"9a3b18f8-59d5-40a0-adb5-e0b8cd37d2bf","timestamp":"2026-05-05T19:03:38.406Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
{"parentUuid":"9a3b18f8-59d5-40a0-adb5-e0b8cd37d2bf","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/understand_dashboard.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"os/exec\"\n9\t\t\"runtime\"\n10\t\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/understand/dashboard\"\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n14\t\t\"github.com/spf13/cobra\"\n15\t)\n16\t\n17\t// newUnderstandDashboardCmd builds `entire understand dashboard`.\n18\t//\n19\t// Server is loopback-only with a per-launch bearer token. Token is rendered\n20\t// into the bootstrap HTML via a server-injected script tag — never via a URL\n21\t// or query string — so it can't leak into browser history or screenshots.\n22\t//\n23\t// --print emits the URL + token to stdout instead of starting the browser\n24\t// and is the form tests and scripted callers should use.\n25\t//\n26\t// --replay is accepted for API compatibility with the `replay` command; for\n27\t// v1 it is a thin alias that just sets a query-string-free fragment hash so\n28\t// the SPA can default to a replay-mode view.\n29\tfunc newUnderstandDashboardCmd() *cobra.Command {\n30\t\tvar openBrowser bool\n31\t\tvar replay bool\n32\t\tvar printOnly bool\n33\t\n34\t\tcmd := &cobra.Command{\n35\t\t\tUse:   \"dashboard\",\n36\t\t\tShort: \"Launch the loopback dashboard for the understand graph\",\n37\t\t\tLong: `Start a 127.0.0.1-only HTTP server backed by the local understand cache.\n38\t\n39\tEach launch mints a fresh random bearer token. The token is required on\n40\tevery API call via the Authorization header — never in the URL — so it\n41\tcannot leak into browser history, screenshots, or copied links.\n42\t\n43\tEndpoints:\n44\t  /                  HTML shell (bootstraps the token into window state)\n45\t  /api/manifest      Build manifest\n46\t  /api/graph         Fused graph (read-only, no transcript bodies)\n47\t  /api/timeline      Replay events\n48\t  /api/hotspots      Per-file score table\n49\t  /api/checkpoint/<id>\n50\t                     Reserved for on-demand transcript lookup; v1 returns 404\n51\t                     to prevent bulk exposure.`,\n52\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n53\t\t\t\treturn runUnderstandDashboard(cmd.Context(), cmd.OutOrStdout(), dashboardOptions{\n54\t\t\t\t\tOpen:      openBrowser,\n55\t\t\t\t\tReplay:    replay,\n56\t\t\t\t\tPrintOnly: printOnly,\n57\t\t\t\t})\n58\t\t\t},\n59\t\t}\n60\t\tcmd.Flags().BoolVar(&openBrowser, \"open\", false, \"Open the URL in the default browser after launch\")\n61\t\tcmd.Flags().BoolVar(&replay, \"replay\", false, \"Default the dashboard view to replay/timeline mode\")\n62\t\tcmd.Flags().BoolVar(&printOnly, \"print\", false, \"Print the URL + token and exit instead of running the server\")\n63\t\treturn cmd\n64\t}\n65\t\n66\ttype dashboardOptions struct {\n67\t\tOpen      bool\n68\t\tReplay    bool\n69\t\tPrintOnly bool\n70\t}\n71\t\n72\tfunc runUnderstandDashboard(ctx context.Context, w io.Writer, opts dashboardOptions) error {\n73\t\troot, err := paths.WorktreeRoot(ctx)\n74\t\tif err != nil {\n75\t\t\treturn fmt.Errorf(\"resolve repo root: %w\", err)\n76\t\t}\n77\t\tstore := graph.NewStore(root)\n78\t\tif !store.Exists() {\n79\t\t\treturn errors.New(\"no understand cache yet — run `entire understand build`\")\n80\t\t}\n81\t\n82\t\tsrv, err := dashboard.New(store)\n83\t\tif err != nil {\n84\t\t\treturn fmt.Errorf(\"dashboard: %w\", err)\n85\t\t}\n86\t\tif opts.PrintOnly {\n87\t\t\t// Build a printable line that includes the token but does NOT actually\n88\t\t\t// start the listener. Useful for tests and for users who want to\n89\t\t\t// drive the API from curl without opening a browser tab.\n90\t\t\tfmt.Fprintf(w, \"would-launch: token=%s (run without --print to bind)\\n\", srv.Token())\n91\t\t\treturn nil\n92\t\t}\n93\t\n94\t\turl, err := srv.Start(ctx)\n95\t\tif err != nil {\n96\t\t\treturn fmt.Errorf(\"start dashboard: %w\", err)\n97\t\t}\n98\t\tdefer func() {\n99\t\t\tif err := srv.Stop(); err != nil {\n100\t\t\t\tfmt.Fprintf(w, \"  (server stop: %s)\\n\", err.Error())\n101\t\t\t}\n102\t\t}()\n103\t\n104\t\tsuffix := \"\"\n105\t\tif opts.Replay {\n106\t\t\tsuffix = \"#replay\"\n107\t\t}\n108\t\tfullURL := url + suffix\n109\t\tfmt.Fprintf(w, \"dashboard: %s\\n\", fullURL)\n110\t\tfmt.Fprintf(w, \"  bearer token: %s (use Authorization: Bearer ...)\\n\", srv.Token())\n111\t\tif opts.Open {\n112\t\t\tif err := openBrowserCommand(fullURL); err != nil {\n113\t\t\t\tfmt.Fprintf(w, \"  (couldn't open browser automatically: %s)\\n\", err.Error())\n114\t\t\t}\n115\t\t}\n116\t\tfmt.Fprintln(w, \"  press Ctrl-C to stop the server.\")\n117\t\n118\t\t<-ctx.Done()\n119\t\treturn nil\n120\t}\n121\t\n122\t// openBrowserCommand uses the platform's default URL opener. We do not pass\n123\t// the token to the OS opener — it is already in the page bootstrap.\n124\tfunc openBrowserCommand(url string) error {\n125\t\tvar bin string\n126\t\tvar args []string\n127\t\tswitch runtime.GOOS {\n128\t\tcase \"darwin\":\n129\t\t\tbin = \"open\"\n130\t\t\targs = []string{url}\n131\t\tcase \"windows\":\n132\t\t\tbin = \"rundll32\"\n133\t\t\targs = []string{\"url.dll,FileProtocolHandler\", url}\n134\t\tdefault:\n135\t\t\tbin = \"xdg-open\"\n136\t\t\targs = []string{url}\n137\t\t}\n138\t\tif _, err := exec.LookPath(bin); err != nil {\n139\t\t\treturn fmt.Errorf(\"no URL opener on PATH (%s): %w\", bin, err)\n140\t\t}\n141\t\tcmd := exec.CommandContext(context.Background(), bin, args...)\n142\t\tif err := cmd.Start(); err != nil {\n143\t\t\treturn fmt.Errorf(\"open browser: %w\", err)\n144\t\t}\n145\t\treturn nil\n146\t}"},"type":"attachment","uuid":"0cd780bf-98fa-4b1e-b6b8-1ebb6fd0b1be","timestamp":"2026-05-05T19:03:38.406Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
