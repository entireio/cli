d\"\n\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n)\n\n// makeStore returns a populated graph.Store rooted in t.TempDir() so the\n// server has artifacts to read.\nfunc makeStore(t *testing.T) *graph.Store {\n\tt.Helper()\n\tdir := t.TempDir()\n\tstore := graph.NewStore(dir)\n\tif err := store.WriteManifest(&graph.Manifest{\n\t\tBuildID:          \"test-build\",\n\t\tBuiltAt:          time.Date(2026, 5, 5, 0, 0, 0, 0, time.UTC),\n\t\tStructuralStatus: \"ok\",\n\t\tHistoryStatus:    \"ok\",\n\t\tSemanticStatus:   graph.SemanticSkipped,\n\t\tNodeCount:        2,\n\t\tEdgeCount:        1,\n\t}); err != nil {\n\t\tt.Fatalf(\"WriteManifest: %v\", err)\n\t}\n\tif err := store.WriteStructural(&graph.Slice{\n\t\tNodes: []graph.Node{\n\t\t\t{ID: \"file:main.go\", Type: graph.NodeFile, Name: \"main.go\", Path: \"main.go\"},\n\t\t},\n\t}); err != nil {\n\t\tt.Fatalf(\"WriteStructural: %v\", err)\n\t}\n\tif err := store.WriteHistory(&graph.Slice{\n\t\tNodes: []graph.Node{\n\t\t\t{ID: \"cp:abc\", Type: graph.NodeCheckpoint, Name: \"abc\", Attrs: map[string]any{\"agent\": \"claude-code\"}},\n\t\t},\n\t\tEdges: []graph.Edge{\n\t\t\t{ID: \"h1\", From: \"cp:abc\", To: \"file:main.go\", Type: graph.EdgeTouchedIn, Scope: graph.ScopeFileOwner},\n\t\t},\n\t}); err != nil {\n\t\tt.Fatalf(\"WriteHistory: %v\", err)\n\t}\n\tif err := store.WriteTimeline(&graph.Timeline{\n\t\tEvents: []graph.TimelineEvent{\n\t\t\t{At: \"2026-05-05T00:00:00Z\", CheckpointID: \"abc\", Kind: \"checkpoint\", NodeIDs: []string{\"file:main.go\"}},\n\t\t},\n\t}); err != nil {\n\t\tt.Fatalf(\"WriteTimeline: %v\", err)\n\t}\n\treturn store\n}\n\nfunc newHandler(t *testing.T) (*Server, http.Handler) {\n\tt.Helper()\n\tstore := makeStore(t)\n\tsrv, err := New(store, nil)\n\tif err != nil {\n\t\tt.Fatalf(\"New: %v\", err)\n\t}\n\tmux := http.NewServeMux()\n\tsrv.RegisterHandlers(mux)\n\treturn srv, mux\n}\n\nfunc TestServer_RejectsMissingToken(t *testing.T) {\n\tt.Parallel()\n\t_, h := newHandler(t)\n