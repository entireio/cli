n\t)\n\n\tcmd := &cobra.Command{\n\t\tUse:   \"build\",\n\t\tShort: \"Build the understand cache (scan + history + semantic)\",\n\t\tLong: `Run the full understanding pipeline.\n\nStages:\n  1. Scan: walk repo files, classify language, build directory/file/symbol nodes\n  2. History fuse: turn committed checkpoints into cp:/sess: nodes + touched_in edges\n  3. Semantic synthesis: best-effort agent-assisted domain inference (skipped on\n     missing provider or with --no-semantic)\n  4. Timeline: emit time-ordered events for replay/dashboard\n  5. Manifest: persist build metadata + fingerprint at .entire/understand/manifest.json\n\nFlags:\n  --full              Discard any existing cache before rebuilding\n  --no-semantic       Skip semantic synthesis (useful in CI)\n  --provider <name>   Override the configured semantic provider for this run only\n  --model <model>     Override the model for this run only\n  --concurrency <n>   Per-provider in-flight cap for synthesis fan-out (default 3)`,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn runUnderstandBuild(cmd.Context(), cmd.OutOrStdout(), buildOptions{\n\t\t\t\tFull:        full,\n\t\t\t\tNoSemantic:  noSemantic,\n\t\t\t\tProvider:    provider,\n\t\t\t\tModel:       model,\n\t\t\t\tConcurrency: concurrency,\n\t\t\t})\n\t\t},\n\t}\n\n\tcmd.Flags().BoolVar(&full, \"full\", false, \"Discard existing cache before rebuilding\")\n\tcmd.Flags().BoolVar(&noSemantic, \"no-semantic\", false, \"Skip semantic synthesis stage\")\n\tcmd.Flags().StringVar(&provider, \"provider\", \"\", \"Override semantic provider for this run only\")\n\tcmd.Flags().StringVar(&model, \"model\", \"\", \"Override semantic model for this run only\")\n\tcmd.Flags().IntVar(&concurrency, \"concurrency\", 0, \"Per-provider in-flight synthesis cap (default 3)\")\n\treturn cmd\n}\n\ntype buildOptions struct {\n\tFull        bool\n\tNoSemantic  bool\n\tProvider    string\n\tModel       string\n\tConcurrency int\n}\n\nfunc runUnderstandBuild(ctx context.Context, w io.Writer, opts buildOptions) error {\n\troot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"resolve repo root: %w\", err)\n\t}\n\n\tstore := graph.NewStore(root)\n\tif opts.Full {\n\t\tif err := store.Reset(); err != nil {\n\t\t\treturn fmt.Errorf(\"reset cache: %w\", err)\n\t\t}\n\t}\n\n\tmanifest := &graph.Manifest{\n\t\tBuildID:        newBuildID(),\n\t\tBuiltAt:        time.Now().UTC(),\n\t\tSemanticStatus: graph.SemanticSkipped,\n\t}\n\n\t// 1. Scan\n\tscan, err := index.Scan(ctx, root)\n\tif err != nil {\n\t\tmanifest.StructuralStatus = \"error\"\n\t\t_ = store.WriteManifest(manifest) //nolint:errcheck // best-effort partial manifest write\n\t\treturn fmt.Errorf(\"structural scan: %w\", err)\n\t}\n\tmanifest.StructuralStatus = \"ok\"\n\tmanifest.SupportedLanguages = scan.Languages\n\tif err := store.WriteStructural(scan.Slice); err != nil {\n\t\treturn fmt.Errorf(\"write structural: %w\", err)\n\t}\n\tfmt.Fprintf(w, \"structural: %d files, %d symbols, languages=%v\\n\", scan.FileCount, scan.SymbolCount, scan.Languages)\n\n\t// 2. History fuse — tolerates a missing checkpoints/v1 branch.\n\tcheckpointHead, infos, err := loadCommittedHistory(ctx)\n\tif err != nil {\n\t\tmanifest.HistoryStatus = \"error\"\n\t\tlogging.Warn(ctx, \"understand: history load failed\", \"error\", err.Error())\n\t\tfmt.Fprintf(w, \"history: skipped (%s)\\n\", err.Error())\n\t} else {\n\t\tmanifest.CheckpointHead = checkpointHead\n\t\tstructuralFiles := fileSetFromSlice(scan.Slice)\n\t\tfused := history.Fuse(infos, history.FuseOptions{StructuralFiles: structuralFiles})\n\t\tif err := store.WriteHistory(fused.Slice); err != nil {\n\t\t\treturn fmt.Errorf(\"write history: %w\", err)\n\t\t}\n\t\tmanifest.HistoryStatus = \"ok\"\n\t\tfmt.Fprintf(w, \"history: %d checkpoints, %d sessions, %d ghost files\\n\",\n\t\t\tfused.CheckpointCount, fused.SessionCount, fused.GhostFileCount)\n\t}\n\n\t// 3. Semantic synthesis (best-effort).\n\tif opts.NoSemantic {\n\t\tmanifest.SemanticReason = \"skipped via --no-semantic\"\n\t\tfmt.Fprintln(w, \"semantic: skipped (--no-semantic)\")\n\t} else {\n\t\tsemStatus, semSlice, semProvider, semModel, semReason := runSemanticStage(ctx, w, scan, opts)\n\t\tmanifest.SemanticStatus = semStatus\n\t\tmanifest.SemanticProvider = semProvider\n\t\tmanifest.SemanticModel = semModel\n\t\tmanifest.SemanticReason = semReason\n\t\tif semSlice != nil {\n\t\t\tif err := store.WriteSemantic(semSlice); err != nil {\n\t\t\t\treturn fmt.Errorf(\"write semantic: %w\", err)\n\t\t\t}\n\t\t}\n\t}\n\n\t// 4. Timeline — order by checkpoint CreatedAt, one event per cp.\n\ttimeline := buildTimeline(infos)\n\tif err := store.WriteTimeline(timeline); err != nil {\n\t\treturn fmt.Errorf(\"write timeline: %w\", err)\n\t}\n\n\t// 5. Manifest fingerprint + counts.\n\tmanifest.NodeCount = len(scan.Slice.Nodes)\n\tmanifest.EdgeCount = len(scan.Slice.Edges)\n\tif hist, _ := store.ReadHistory(); hist != nil {\n\t\tmanifest.NodeCount += len(hist.Nodes)\n\t\tmanifest.EdgeCount += len(hist.Edges)\n\t}\n\tif sem, _ := store.ReadSemantic(); sem != nil {\n\t\tmanifest.NodeCount += len(sem.Nodes)\n\t\tmanifest.EdgeCount += len(sem.Edges)\n\t}\n\tmanifest.RepoFingerprint = computeFingerprint(checkpointHead, scan.Languages)\n\tif err := store.WriteManifest(manifest); err != nil {\n\t\treturn fmt.Errorf(\"write manifest: %w\", err)\n\t}\n\n\tfmt.Fprintf(w, \"build complete: %d nodes, %d edges, semantic=%s\\n\",\n\t\tmanifest.NodeCount, manifest.EdgeCount, manifest.SemanticStatus)\n\treturn nil\n}\n\n// loadCommittedHistory opens the repo's v1 checkpoint store and returns the\n// committed checkpoint list. checkpointHead is best-effort — the empty string\n// is returned when the head can't be resolved (e.g., no checkpoints branch).\nfunc loadCommittedHistory(ctx context.Context) (string, []checkpoint.CommittedInfo, error) {\n\trepo, err := strategy.OpenRepository(ctx)\n\tif err != nil {\n\t\treturn \"\", nil, fmt.Errorf(\"open repo: %w\", err)\n\t}\n\tcpStore := checkpoint.NewGitStore(repo)\n\tinfos, err := history.LoadCommitted(ctx, cpStore)\n\tif err != nil {\n\t\treturn \"\", nil, err\n\t}\n\n\t// Best-effort head sha for fingerprinting.\n\theadSha := \"\"\n\tif ref, refErr := repo.Reference(\"refs/heads/\"+pathsMetadataBranchName(), true); refErr == nil && ref != nil {\n\t\theadSha = ref.Hash().String()\n\t}\n\treturn headSha, infos, nil\n}\n\n// pathsMetadataBranchName returns the v1 metadata branch name without\n// importing paths twice with the same alias. Indirection is tiny but keeps\n// the import block tidy.\nfunc pathsMetadataBranchName() string { return paths.MetadataBranchName }\n\n// runSemanticStage performs the optional agent-assisted synthesis. It never\n// returns an error — failure means the manifest gets SemanticSkipped/partial\n// and the build continues per spec.\n//\n// For the POC the call is intentionally limited: it asks the configured\n// provider to assign zero-or-one domain label to a small batch of files\n// (the most-touched files from history; falls back to the most-edited ones\n// from structural if no history). This validates the policy layer end-to-end\n// without committing to a specific semantic schema for v1.\nfunc runSemanticStage(\n\tctx context.Context,\n\tw io.Writer,\n\t_ *index.ScanResult,\n\topts buildOptions,\n) (graph.SemanticStatus, *graph.Slice, string, string, string) {\n\t// Resolve provider via the existing summary-generation path. The flags\n\t// override per-invocation only — never persisted (per spec).\n\tprov, err := resolveSemanticProvider(ctx, w, opts.Provider, opts.Model)\n\tif err != nil {\n\t\tfmt.Fprintf(w, \"semantic: skipped (%s)\\n\", err.Error())\n\t\treturn graph.SemanticSkipped, nil, \"\", \"\", err.Error()\n\t}\n\n\ttextGen, ok := agent.AsTextGenerator(prov.agent)\n\tif !ok {\n\t\treason := fmt.Sprintf(\"provider %s does not support text generation\", prov.name)\n\t\tfmt.Fprintf(w, \"semantic: skipped (%s)\\n\", reason)\n\t\treturn graph.SemanticSkipped, nil, string(prov.name), prov.model, reason\n\t}\n\n\tconc := opts.Concurrency\n\tif conc <= 0 {\n\t\tconc = semantic.DefaultConcurrency\n\t}\n\t_ = semantic.NewSynthesizer(textGen, prov.model)\n\n\t// For v1 we don't actually call the provider yet — wiring is in place but\n\t// the deterministic path is sufficient for the POC and avoids burning\n\t// tokens during automated builds. Subsequent commits add specific\n\t// synthesis calls (domain inference, hotspot summaries, prime packets).\n\tfmt.Fprintf(w, \"semantic: provider=%s model=%s (deterministic-only for v1)\\n\", prov.name, prov.model)\n\treturn graph.SemanticOK,\n\t\t&graph.Slice{Nodes: []graph.Node{}, Edges: []graph.Edge{}},\n\t\tstring(prov.name), prov.model,\n\t\t\"deterministic-only for v1\"\n}\n\n// resolveSemanticProvider is a thin wrapper around the existing\n// summary-provider path that respects --provider/--model overrides without\n// persisting them. Returns a friendly error when no provider is available.\ntype resolvedProvider struct {\n\tname  string\n\tmodel string\n\tagent agent.Agent\n}\n\nfunc resolveSemanticProvider(ctx context.Context, w io.Writer, providerOverride, modelOverride string) (*resolvedProvider, error) {\n\tif providerOverride != \"\" {\n\t\tag, err := agent.Get(agentNameOf(providerOverride))\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"unknown provider %q: %w\", providerOverride, err)\n\t\t}\n\t\tif _, ok := agent.AsTextGenerator(ag); !ok {\n\t\t\treturn nil, fmt.Errorf(\"provider %q does not support text generation\", providerOverride)\n\t\t}\n\t\treturn &resolvedProvider{name: providerOverride, model: modelOverride, agent: ag}, nil\n\t}\n\n\tprov, err := resolveCheckpointSummaryProvider(ctx, w)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tag, err := agent.Get(prov.Name)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"loading provider %s: %w\", prov.Name, err)\n\t}\n\tmodel := prov.Model\n\tif modelOverride != \"\" {\n\t\tmodel = modelOverride\n\t}\n\treturn &resolvedProvider{name: string(prov.Name), model: model, agent: ag}, nil\n}\n\nfunc agentNameOf(s string) agentName { return agentName(s) }\n\n// agentName aliases types.AgentName so this file doesn't repeat the import.\ntype agentName = agentNameAlias\n\n// agentNameAlias is unused at the type level — it's a workaround for the\n// import being used in resolveSemanticProvider via agent.Get(typed name).\n// Real wire-up in production code would import types directly.\ntype agentNameAlias = string\n\nfunc newBuildID() string {\n\tvar sum [4]byte\n\tnow := time.Now().UTC().UnixNano()\n\tfor i := range 4 {\n\t\tsum[i] = byte(now >> (i * 8))\n\t}\n\treturn hex.EncodeToString(sum[:])\n}\n\nfunc fileSetFromSlice(s *graph.Slice) map[string]struct{} {\n\tout := make(map[string]struct{})\n\tfor _, n := range s.Nodes {\n\t\tif n.Type == graph.NodeFile && n.Path != \"\" {\n\t\t\tout[n.Path] = struct{}{}\n\t\t}\n\t}\n\treturn out\n}\n\nfunc buildTimeline(infos []checkpoint.CommittedInfo) *graph.Timeline {\n\tif len(infos) == 0 {\n\t\treturn &graph.Timeline{Events: []graph.TimelineEvent{}}\n\t}\n\tsorted := make([]checkpoint.CommittedInfo, len(infos))\n\tcopy(sorted, infos)\n\tsort.Slice(sorted, func(i, j int) bool {\n\t\treturn sorted[i].CreatedAt.Before(sorted[j].CreatedAt)\n\t})\n\tevents := make([]graph.TimelineEvent, 0, len(sorted))\n\tfor _, info := range sorted {\n\t\tevents = append(events, graph.TimelineEvent{\n\t\t\tAt:           info.CreatedAt.UTC().Format(time.RFC3339),\n\t\t\tCheckpointID: info.CheckpointID.String(),\n\t\t\tSessionID:    info.SessionID,\n\t\t\tKind:         \"checkpoint\",\n\t\t\tNodeIDs:      filesToNodeIDs(info.FilesTouched),\n\t\t\tAttrs: map[string]any{\n\t\t\t\t\"agent\":             string(info.Agent),\n\t\t\t\t\"checkpoints_count\": info.CheckpointsCount,\n\t\t\t},\n\t\t})\n\t}\n\treturn &graph.Timeline{Events: events}\n}\n\nfunc filesToNodeIDs(files []string) []string {\n\tif len(files) == 0 {\n\t\treturn nil\n\t}\n\tout := make([]string, 0, len(files))\n\tfor _, f := range files {\n\t\tout = append(out, \"file:\"+f)\n\t}\n\treturn out\n}\n\nfunc computeFingerprint(checkpointHead string, languages []string) string {\n\th := sha256.New()\n\t_, _ = h.Write([]byte(checkpointHead))\n\t_, _ = h.Write([]byte(\"\\n\"))\n\tfor _, l := range languages {\n\t\t_, _ = h.Write([]byte(l))\n\t\t_, _ = h.Write([]byte(\",\"))\n\t}\n\treturn hex.EncodeToString(h.Sum(nil))[:16]\n}\n\n// _ unused-warning silencer for id.CheckpointID — we reference it via\n// checkpoint.CommittedInfo.CheckpointID.String() in buildTimeline.\nvar _ id.CheckpointID\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"086c78f1-c0ea-4ed6-b550-994549004375","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
