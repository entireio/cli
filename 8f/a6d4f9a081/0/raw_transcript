or a pattern\",\n\t\tLong: `Search node names and paths for the given pattern and rank matches by\nrecency and match strength. Output includes a \"why this matched\" reason for\neach example.\n\nExamples:\n  entire understand examples NewStore\n  entire understand examples \"rate limiter\"`,\n\t\tArgs: cobra.ExactArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\treturn runUnderstandExamples(cmd.Context(), cmd.OutOrStdout(), args[0], jsonOut, maxResults)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n\tcmd.Flags().IntVar(&maxResults, \"max\", 20, \"Maximum number of results to return\")\n\treturn cmd\n}\n\ntype exampleHit struct {\n\tNodeID   string  `json:\"node_id\"`\n\tPath     string  `json:\"path,omitempty\"`\n\tType     string  `json:\"type\"`\n\tScore    float64 `json:\"score\"`\n\tReason   string  `json:\"reason\"`\n\tLastAt   string  `json:\"last_at,omitempty\"`\n\tLastCpID string  `json:\"last_cp,omitempty\"`\n}\n\ntype examplesReport struct {\n\tPattern             string       `json:\"pattern\"`\n\tHits                []exampleHit `json:\"hits\"`\n\tStale               bool         `json:\"stale,omitempty\"`\n\tSemanticUnavailable bool         `json:\"semantic_unavailable,omitempty\"`\n}\n\nfunc runUnderstandExamples(ctx context.Context, w io.Writer, pattern string, jsonOut bool, maxResults int) error {\n\tq, err := loadQueryEnv(ctx)\n\tif err != nil {\n\t\tif errors.Is(err, errNoUnderstandCache) {\n\t\t\tfmt.Fprintln(w, err.Error())\n\t\t\treturn nil\n\t\t}\n\t\treturn err\n\t}\n\n\tpattern = strings.TrimSpace(pattern)\n\treport := examplesReport{\n\t\tPattern:             pattern,\n\t\tStale:               q.stale,\n\t\tSemanticUnavailable: q.semanticUnavailableNotice() != \"\",\n\t}\n\tif pattern == \"\" {\n\t\treturn emitExamples(w, report, jsonOut, q)\n\t}\n\n\tlower := strings.ToLower(pattern)\n\n\tfor i := range q.fused.Nodes {\n\t\tn := &q.fused.Nodes[i]\n\t\tif n.Type != graph.NodeFile && n.Type != graph.NodeSymbol {\n\t\t\tcontinue\n\t\t}\n\t\tscore, reason := scoreExampleMatch(n, lower)\n\t\tif score <= 0 {\n\t\t\tcontinue\n\t\t}\n\t\thit := exampleHit{\n\t\t\tNodeID: n.ID,\n\t\t\tPath:   n.Path,\n\t\t\tType:   string(n.Type),\n\t\t\tScore:  score,\n\t\t\tReason: reason,\n\t\t}\n\t\tif cp := q.recentCheckpoint(n.ID); cp != nil {\n\t\t\thit.LastCpID = cp.Name\n\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n\t\t\t\thit.LastAt = at\n\t\t\t}\n\t\t}\n\t\treport.Hits = append(report.Hits, hit)\n\t}\n\n\tsort.Slice(report.Hits, func(i, j int) bool {\n\t\tif report.Hits[i].Score != report.Hits[j].Score {\n\t\t\treturn report.Hits[i].Score > report.Hits[j].Score\n\t\t}\n\t\t// Tiebreak: most-recently touched first.\n\t\treturn report.Hits[i].LastAt > report.Hits[j].LastAt\n\t})\n\tif maxResults > 0 && len(report.Hits) > maxResults {\n\t\treport.Hits = report.Hits[:maxResults]\n\t}\n\treturn emitExamples(w, report, jsonOut, q)\n}\n\n// scoreExampleMatch returns a non-negative score (higher = better match) and a\n// short human-readable reason. Symbol-name exact matches outrank file-name\n// substring matches outrank path substring matches.\nfunc scoreExampleMatch(n *graph.Node, lowerPattern string) (float64, string) {\n\tlowerName := strings.ToLower(n.Name)\n\tlowerPath := strings.ToLower(n.Path)\n\n\tswitch {\n\tcase n.Type == graph.NodeSymbol && lowerName == lowerPattern:\n\t\treturn 4.0, \"symbol name exactly matches\"\n\tcase n.Type == graph.NodeSymbol && strings.Contains(lowerName, lowerPattern):\n\t\treturn 3.0, \"symbol name contains pattern\"\n\tcase lowerName == lowerPattern:\n\t\treturn 2.5, \"node name exactly matches\"\n\tcase strings.Contains(lowerName, lowerPattern):\n\t\treturn 2.0, \"node name contains pattern\"\n\tcase strings.Contains(lowerPath, lowerPattern):\n\t\treturn 1.0, \"path contains pattern\"\n\tdefault:\n\t\treturn 0, \"\"\n\t}\n}\n\nfunc emitExamples(w io.Writer, r examplesReport, jsonOut bool, q *queryEnv) error {\n\tif jsonOut {\n\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"marshal examples: %w\", err)\n\t\t}\n\t\tif _, err := w.Write(data); err != nil {\n\t\t\treturn fmt.Errorf(\"write examples JSON: %w\", err)\n\t\t}\n\t\treturn nil\n\t}\n\tif r.Pattern == \"\" {\n\t\tfmt.Fprintln(w, \"_Empty pattern; nothing to match._\")\n\t\treturn nil\n\t}\n\tif len(r.Hits) == 0 {\n\t\tfmt.Fprintf(w, \"_No matches for pattern %q._\\n\", r.Pattern)\n\t\treturn nil\n\t}\n\tfmt.Fprintf(w, \"# Examples for `%s`\\n\\n\", r.Pattern)\n\tfor _, h := range r.Hits {\n\t\tpath := h.Path\n\t\tif path == \"\" {\n\t\t\tpath = h.NodeID\n\t\t}\n\t\tfmt.Fprintf(w, \"- **%s** _(%s)_ — %s\", path, h.Type, h.Reason)\n\t\tif h.LastCpID != \"\" {\n\t\t\tfmt.Fprintf(w, \"; last in `%s`\", h.LastCpID)\n\t\t\tif h.LastAt != \"\" {\n\t\t\t\tfmt.Fprintf(w, \" at %s\", h.LastAt)\n\t\t\t}\n\t\t}\n\t\tfmt.Fprintln(w)\n\t}\n\treturn nil\n}\n","structuredPatch":[{"oldStart":164,"oldLines":6,"newStart":164,"newLines":14,"lines":["     return nil","   }","   fmt.Fprintf(w, \"# Examples for `%s`\\n\\n\", r.Pattern)","+  if notice := q.staleNotice(); notice != \"\" {","+    fmt.Fprintln(w, notice)","+    fmt.Fprintln(w)","+  }","+  if notice := q.semanticUnavailableNotice(); notice != \"\" {","+    fmt.Fprintln(w, notice)","+    fmt.Fprintln(w)","+  }","   for _, h := range r.Hits {","     path := h.Path","     if path == \"\" {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"186d2eab-386f-42ab-afe8-2671c71c642d","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
