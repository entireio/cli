{"parentUuid":"147637ce-d359-42b4-9cd7-75a868a249ed","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/understand_hotspots.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"sort\"\n9\t\n10\t\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n12\t\t\"github.com/spf13/cobra\"\n13\t)\n14\t\n15\t// newUnderstandHotspotsCmd builds `entire understand hotspots`.\n16\t//\n17\t// Scoring inputs per the spec: checkpoint count, distinct-agent count,\n18\t// rewrite count (approximated by checkpoint count for the POC), and a\n19\t// stub for centrality. Contradiction-flag scoring requires semantic data\n20\t// (intent/outcome summaries) and is not yet active in v1.\n21\tfunc newUnderstandHotspotsCmd() *cobra.Command {\n22\t\tvar jsonOut bool\n23\t\tvar topN int\n24\t\n25\t\tcmd := &cobra.Command{\n26\t\t\tUse:   \"hotspots\",\n27\t\t\tShort: \"Rank files by checkpoint churn and agent diversity\",\n28\t\t\tLong: `Surface unstable parts of the codebase. Score is a deterministic mix of\n29\tcheckpoint count and distinct-agent count over each file's touched_in edges.\n30\t\n31\tExamples:\n32\t  entire understand hotspots\n33\t  entire understand hotspots --top 50 --json`,\n34\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n35\t\t\t\treturn runUnderstandHotspots(cmd.Context(), cmd.OutOrStdout(), jsonOut, topN)\n36\t\t\t},\n37\t\t}\n38\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n39\t\tcmd.Flags().IntVar(&topN, \"top\", 20, \"Number of top hotspots to return\")\n40\t\treturn cmd\n41\t}\n42\t\n43\ttype hotspot struct {\n44\t\tNodeID          string `json:\"node_id\"`\n45\t\tPath            string `json:\"path\"`\n46\t\tCheckpointCount int    `json:\"checkpoint_count\"`\n47\t\tDistinctAgents  int    `json:\"distinct_agents\"`\n48\t\t// Centrality is a deterministic blast-radius proxy: count of direct\n49\t\t// children (symbols) plus 1 for the file itself. Files with many\n50\t\t// symbols sit on more dependency walks, so a touched_in churn there\n51\t\t// affects more callers. The semantic stage will refine this with\n52\t\t// in-degree-from-imports and call-graph reachability when synthesis\n53\t\t// runs.\n54\t\tCentrality int     `json:\"centrality\"`\n55\t\tScore      float64 `json:\"score\"`\n56\t\tLastCpID   string  `json:\"last_cp,omitempty\"`\n57\t\tLastAt     string  `json:\"last_at,omitempty\"`\n58\t}\n59\t\n60\ttype hotspotsReport struct {\n61\t\tHotspots []hotspot `json:\"hotspots\"`\n62\t\tStale    bool      `json:\"stale,omitempty\"`\n63\t}\n64\t\n65\tfunc runUnderstandHotspots(ctx context.Context, w io.Writer, jsonOut bool, topN int) error {\n66\t\tq, err := loadQueryEnv(ctx)\n67\t\tif err != nil {\n68\t\t\tif errors.Is(err, errNoUnderstandCache) {\n69\t\t\t\tfmt.Fprintln(w, err.Error())\n70\t\t\t\treturn nil\n71\t\t\t}\n72\t\t\treturn err\n73\t\t}\n74\t\n75\t\treport := hotspotsReport{Hotspots: []hotspot{}, Stale: q.stale}\n76\t\tfor fileID, cps := range q.touchedCps {\n77\t\t\tn := q.byID[fileID]\n78\t\t\tif n == nil || (n.Type != graph.NodeFile) {\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\t// Distinct agents touching this file.\n82\t\t\tagents := map[string]struct{}{}\n83\t\t\tfor _, cpID := range cps {\n84\t\t\t\tcp := q.byID[cpID]\n85\t\t\t\tif cp == nil {\n86\t\t\t\t\tcontinue\n87\t\t\t\t}\n88\t\t\t\tif a, ok := cp.Attrs[\"agent\"].(string); ok && a != \"\" {\n89\t\t\t\t\tagents[a] = struct{}{}\n90\t\t\t\t}\n91\t\t\t}\n92\t\t\tcentrality := 1 + len(q.containsFrom[fileID])\n93\t\t\tscore := float64(len(cps)) + 0.5*float64(len(agents)) + 0.25*float64(centrality)\n94\t\t\ths := hotspot{\n95\t\t\t\tNodeID:          fileID,\n96\t\t\t\tPath:            n.Path,\n97\t\t\t\tCheckpointCount: len(cps),\n98\t\t\t\tDistinctAgents:  len(agents),\n99\t\t\t\tCentrality:      centrality,\n100\t\t\t\tScore:           score,\n101\t\t\t}\n102\t\t\tif cp := q.recentCheckpoint(fileID); cp != nil {\n103\t\t\t\ths.LastCpID = cp.Name\n104\t\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n105\t\t\t\t\ths.LastAt = at\n106\t\t\t\t}\n107\t\t\t}\n108\t\t\treport.Hotspots = append(report.Hotspots, hs)\n109\t\t}\n110\t\tsort.Slice(report.Hotspots, func(i, j int) bool {\n111\t\t\tif report.Hotspots[i].Score != report.Hotspots[j].Score {\n112\t\t\t\treturn report.Hotspots[i].Score > report.Hotspots[j].Score\n113\t\t\t}\n114\t\t\treturn report.Hotspots[i].Path < report.Hotspots[j].Path\n115\t\t})\n116\t\tif topN > 0 && len(report.Hotspots) > topN {\n117\t\t\treport.Hotspots = report.Hotspots[:topN]\n118\t\t}\n119\t\n120\t\treturn emitHotspots(w, report, jsonOut, q)\n121\t}\n122\t\n123\tfunc emitHotspots(w io.Writer, r hotspotsReport, jsonOut bool, q *queryEnv) error {\n124\t\tif jsonOut {\n125\t\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n126\t\t\tif err != nil {\n127\t\t\t\treturn fmt.Errorf(\"marshal hotspots: %w\", err)\n128\t\t\t}\n129\t\t\tif _, err := w.Write(data); err != nil {\n130\t\t\t\treturn fmt.Errorf(\"write hotspots JSON: %w\", err)\n131\t\t\t}\n132\t\t\treturn nil\n133\t\t}\n134\t\tif len(r.Hotspots) == 0 {\n135\t\t\tfmt.Fprintln(w, \"_No hotspots — no checkpoint history yet, or no files have been touched._\")\n136\t\t\treturn nil\n137\t\t}\n138\t\tfmt.Fprintln(w, \"# Hotspots\")\n139\t\tfmt.Fprintln(w)\n140\t\tif notice := q.staleNotice(); notice != \"\" {\n141\t\t\tfmt.Fprintln(w, notice)\n142\t\t\tfmt.Fprintln(w)\n143\t\t}\n144\t\tfor i, h := range r.Hotspots {\n145\t\t\tfmt.Fprintf(w, \"%d. **%s** — score=%.1f (cps=%d, agents=%d, centrality=%d)\",\n146\t\t\t\ti+1, h.Path, h.Score, h.CheckpointCount, h.DistinctAgents, h.Centrality)\n147\t\t\tif h.LastCpID != \"\" {\n148\t\t\t\tfmt.Fprintf(w, \"; last in `%s`\", h.LastCpID)\n149\t\t\t\tif h.LastAt != \"\" {\n150\t\t\t\t\tfmt.Fprintf(w, \" at %s\", h.LastAt)\n151\t\t\t\t}\n152\t\t\t}\n153\t\t\tfmt.Fprintln(w)\n154\t\t}\n155\t\treturn nil\n156\t}"},"type":"attachment","uuid":"28ee6108-c005-44a8-8f3e-9832b1e56d82","timestamp":"2026-05-05T19:25:53.455Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
{"parentUuid":"28ee6108-c005-44a8-8f3e-9832b1e56d82","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/understand_tour.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\n9\t\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n10\t\t\"github.com/spf13/cobra\"\n11\t)\n12\t\n13\t// newUnderstandTourCmd builds `entire understand tour <area>`.\n14\t//\n15\t// Per the spec the tour is a guided walk through a structural neighborhood\n16\t// annotated with the checkpoints that most recently shaped each stop. For the\n17\t// POC we ship the deterministic stops + checkpoint annotations; semantic\n18\t// narration is gated behind the build pipeline (deterministic-only for v1).\n19\tfunc newUnderstandTourCmd() *cobra.Command {\n20\t\tvar jsonOut bool\n21\t\tvar dashboardLink bool\n22\t\tvar maxStops int\n23\t\n24\t\tcmd := &cobra.Command{\n25\t\t\tUse:   \"tour <area>\",\n26\t\t\tShort: \"Guided structural walk annotated with checkpoint history\",\n27\t\t\tLong: `Resolve <area> to a file/dir/module/node and walk its descendants. Each stop\n28\tincludes the most recent touching checkpoint when available.\n29\t\n30\t--dashboard emits a deep-link URL fragment (e.g. #area=<node-id>) the\n31\tdashboard SPA can route to. The dashboard server itself is not started; pair\n32\twith` + \" `entire understand dashboard` \" + `if you want a live UI.\n33\t\n34\tExamples:\n35\t  entire understand tour cmd/\n36\t  entire understand tour cmd/entire/cli/understand\n37\t  entire understand tour file:cmd/entire/cli/root.go --dashboard`,\n38\t\t\tArgs: cobra.ExactArgs(1),\n39\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n40\t\t\t\treturn runUnderstandTour(cmd.Context(), cmd.OutOrStdout(), args[0], jsonOut, dashboardLink, maxStops)\n41\t\t\t},\n42\t\t}\n43\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n44\t\tcmd.Flags().BoolVar(&dashboardLink, \"dashboard\", false, \"Emit a dashboard deep-link fragment (#area=<node-id>) instead of the walkthrough\")\n45\t\tcmd.Flags().IntVar(&maxStops, \"max-stops\", 25, \"Maximum number of stops to include\")\n46\t\treturn cmd\n47\t}\n48\t\n49\ttype tourStop struct {\n50\t\tNodeID         string `json:\"node_id\"`\n51\t\tName           string `json:\"name\"`\n52\t\tPath           string `json:\"path,omitempty\"`\n53\t\tLanguage       string `json:\"language,omitempty\"`\n54\t\tLastCheckpoint string `json:\"last_checkpoint,omitempty\"`\n55\t\tLastAt         string `json:\"last_at,omitempty\"`\n56\t\tLastAgent      string `json:\"last_agent,omitempty\"`\n57\t}\n58\t\n59\ttype tourReport struct {\n60\t\tArea                string     `json:\"area\"`\n61\t\tNodeID              string     `json:\"node_id\"`\n62\t\tDashboardFragment   string     `json:\"dashboard_fragment,omitempty\"`\n63\t\tStops               []tourStop `json:\"stops\"`\n64\t\tSkipped             int        `json:\"skipped,omitempty\"`\n65\t\tStale               bool       `json:\"stale,omitempty\"`\n66\t\tSemanticUnavailable bool       `json:\"semantic_unavailable,omitempty\"`\n67\t}\n68\t\n69\tfunc runUnderstandTour(ctx context.Context, w io.Writer, target string, jsonOut, dashboardLink bool, maxStops int) error {\n70\t\tq, err := loadQueryEnv(ctx)\n71\t\tif err != nil {\n72\t\t\tif errors.Is(err, errNoUnderstandCache) {\n73\t\t\t\tfmt.Fprintln(w, err.Error())\n74\t\t\t\treturn nil\n75\t\t\t}\n76\t\t\treturn err\n77\t\t}\n78\t\tnode, err := q.resolveAreaNode(target)\n79\t\tif err != nil {\n80\t\t\treturn err\n81\t\t}\n82\t\n83\t\tif dashboardLink {\n84\t\t\treport := tourReport{\n85\t\t\t\tArea:              target,\n86\t\t\t\tNodeID:            node.ID,\n87\t\t\t\tDashboardFragment: \"#area=\" + node.ID,\n88\t\t\t\tStale:             q.stale,\n89\t\t\t}\n90\t\t\treturn emitTour(w, report, jsonOut, q)\n91\t\t}\n92\t\n93\t\tfiles := q.descendantFiles(node.ID)\n94\t\treport := tourReport{\n95\t\t\tArea:                target,\n96\t\t\tNodeID:              node.ID,\n97\t\t\tStale:               q.stale,\n98\t\t\tSemanticUnavailable: q.semanticUnavailableNotice() != \"\",\n99\t\t}\n100\t\tif maxStops <= 0 {\n101\t\t\tmaxStops = 25\n102\t\t}\n103\t\tfor i, f := range files {\n104\t\t\tif i >= maxStops {\n105\t\t\t\treport.Skipped = len(files) - i\n106\t\t\t\tbreak\n107\t\t\t}\n108\t\t\tstop := tourStop{\n109\t\t\t\tNodeID:   f.ID,\n110\t\t\t\tName:     f.Name,\n111\t\t\t\tPath:     f.Path,\n112\t\t\t\tLanguage: f.Language,\n113\t\t\t}\n114\t\t\tif cp := q.recentCheckpoint(f.ID); cp != nil {\n115\t\t\t\tstop.LastCheckpoint = cp.Name\n116\t\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n117\t\t\t\t\tstop.LastAt = at\n118\t\t\t\t}\n119\t\t\t\tif ag, ok := cp.Attrs[\"agent\"].(string); ok {\n120\t\t\t\t\tstop.LastAgent = ag\n121\t\t\t\t}\n122\t\t\t}\n123\t\t\treport.Stops = append(report.Stops, stop)\n124\t\t}\n125\t\n126\t\treturn emitTour(w, report, jsonOut, q)\n127\t}\n128\t\n129\tfunc emitTour(w io.Writer, r tourReport, jsonOut bool, q *queryEnv) error {\n130\t\tif jsonOut {\n131\t\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n132\t\t\tif err != nil {\n133\t\t\t\treturn fmt.Errorf(\"marshal tour: %w\", err)\n134\t\t\t}\n135\t\t\tif _, err := w.Write(data); err != nil {\n136\t\t\t\treturn fmt.Errorf(\"write tour JSON: %w\", err)\n137\t\t\t}\n138\t\t\treturn nil\n139\t\t}\n140\t\tif r.DashboardFragment != \"\" {\n141\t\t\tfmt.Fprintf(w, \"Dashboard fragment for `%s`: %s\\n\", r.NodeID, r.DashboardFragment)\n142\t\t\tfmt.Fprintln(w, \"Pair with `entire understand dashboard` to load the SPA, then append the fragment to the URL.\")\n143\t\t\treturn nil\n144\t\t}\n145\t\tfmt.Fprintf(w, \"# Tour: %s (`%s`)\\n\\n\", r.Area, r.NodeID)\n146\t\tif notice := q.staleNotice(); notice != \"\" {\n147\t\t\tfmt.Fprintln(w, notice)\n148\t\t\tfmt.Fprintln(w)\n149\t\t}\n150\t\tif notice := q.semanticUnavailableNotice(); notice != \"\" {\n151\t\t\tfmt.Fprintln(w, notice)\n152\t\t\tfmt.Fprintln(w)\n153\t\t}\n154\t\tif len(r.Stops) == 0 {\n155\t\t\tfmt.Fprintln(w, \"_No file descendants found at this area._\")\n156\t\t\treturn nil\n157\t\t}\n158\t\tfor i, s := range r.Stops {\n159\t\t\tfmt.Fprintf(w, \"%d. **%s**\", i+1, s.Path)\n160\t\t\tif s.Language != \"\" {\n161\t\t\t\tfmt.Fprintf(w, \" _(%s)_\", s.Language)\n162\t\t\t}\n163\t\t\tfmt.Fprintln(w)\n164\t\t\tif s.LastCheckpoint != \"\" {\n165\t\t\t\tfmt.Fprintf(w, \"   - last touched in `%s`\", s.LastCheckpoint)\n166\t\t\t\tif s.LastAt != \"\" {\n167\t\t\t\t\tfmt.Fprintf(w, \" at %s\", s.LastAt)\n168\t\t\t\t}\n169\t\t\t\tif s.LastAgent != \"\" {\n170\t\t\t\t\tfmt.Fprintf(w, \" by %s\", s.LastAgent)\n171\t\t\t\t}\n172\t\t\t\tfmt.Fprintln(w)\n173\t\t\t} else {\n174\t\t\t\tfmt.Fprintln(w, \"   - no checkpoint trail yet\")\n175\t\t\t}\n176\t\t}\n177\t\tif r.Skipped > 0 {\n178\t\t\tfmt.Fprintf(w, \"\\n_…%d more files omitted (raise --max-stops to see all)._\\n\", r.Skipped)\n179\t\t}\n180\t\treturn nil\n181\t}"},"type":"attachment","uuid":"a69691d7-3f09-4f56-93f2-e12b2de06aa4","timestamp":"2026-05-05T19:25:53.455Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
