til.InitRepo(t, dir)\n\tseedReplayCache(t, dir)\n\tt.Chdir(dir)\n\tpaths.ClearWorktreeRootCache()\n\n\tvar buf bytes.Buffer\n\tif err := runUnderstandReplay(context.Background(), &buf, replayOptions{JSONOut: true}); err != nil {\n\t\tt.Fatalf(\"runUnderstandReplay: %v\", err)\n\t}\n\tvar got replayReport\n\tif err := json.Unmarshal(buf.Bytes(), &got); err != nil {\n\t\tt.Fatalf(\"decode: %v\\nraw=%s\", err, buf.String())\n\t}\n\tif len(got.Events) != 3 {\n\t\tt.Errorf(\"Events=%d; want 3\", len(got.Events))\n\t}\n\t// Events should be sorted by At ascending.\n\tif got.Events[0].CheckpointID != \"aaaa\" || got.Events[2].CheckpointID != \"cccc\" {\n\t\tt.Errorf(\"event order wrong: %+v\", got.Events)\n\t}\n}\n\nfunc TestUnderstandReplay_FromTimestamp(t *testing.T) {\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\tseedReplayCache(t, dir)\n\tt.Chdir(dir)\n\tpaths.ClearWorktreeRootCache()\n\n\tvar buf bytes.Buffer\n\tif err := runUnderstandReplay(context.Background(), &buf, replayOptions{\n\t\tFrom: \"2026-02-15T00:00:00Z\", JSONOut: true,\n\t}); err != nil {\n\t\tt.Fatalf(\"runUnderstandReplay: %v\", err)\n\t}\n\tvar got replayReport\n\tif err := json.Unmarshal(buf.Bytes(), &got); err != nil {\n\t\tt.Fatalf(\"decode: %v\", err)\n\t}\n\tif len(got.Events) != 1 || got.Events[0].CheckpointID != \"cccc\" {\n\t\tt.Errorf(\"expected only cccc; got %+v\", got.Events)\n\t}\n}\n\nfunc TestUnderstandReplay_FromCheckpointID(t *testing.T) {\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\tseedReplayCache(t, dir)\n\tt.Chdir(dir)\n\tpaths.ClearWorktreeRootCache()\n\n\tvar buf bytes.Buffer\n\tif err := runUnderstandReplay(context.Background(), &buf, replayOptions{\n\t\tFrom: \"bbbb\", JSONOut: true,\n\t}); err != nil {\n\t\tt.Fatalf(\"runUnderstandReplay: %v\", err)\n\t}\n\tvar got replayReport\n\tif err := json.Unmarshal(buf.Bytes(), &got); err != nil {\n\t\tt.Fatalf(\"decode: %v\", err)\n\t}\n\t// \"bbbb\" matches itself directly via boundMatches.\n\tfound := false\n\tfor _, e := range got.Events {\n\t\tif e.CheckpointID == \"bbbb\" {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\tt.Errorf(\"expected bbbb in filtered events: %+v\", got.Events)\n\t}\n}\n\nfunc TestUnderstandReplay_Limit(t *testing.T) {\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\tseedReplayCache(t, dir)\n\tt.Chdir(dir)\n\tpaths.ClearWorktreeRootCache()\n\n\tvar buf bytes.Buffer\n\tif err := runUnderstandReplay(context.Background(), &buf, replayOptions{Limit: 2, JSONOut: true}); err != nil {\n\t\tt.Fatalf(\"runUnderstandReplay: %v\", err)\n\t}\n\tvar got replayReport\n\tif err := json.Unmarshal(buf.Bytes(), &got); err != nil {\n\t\tt.Fatalf(\"decode: %v\", err)\n\t}\n\tif len(got.Events) != 2 {\n\t\tt.Errorf(\"Limit=2 produced %d events\", len(got.Events))\n\t}\n}\n\nfunc TestUnderstandReplay_NoCacheError(t *testing.T) {\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\tt.Chdir(dir)\n\tpaths.ClearWorktreeRootCache()\n\n\tvar buf bytes.Buffer\n\terr := runUnderstandReplay(context.Background(), &buf, replayOptions{})\n\tif err == nil {\n\t\tt.Fatal(\"expected error when cache missing\")\n\t}\n\tif !strings.Contains(err.Error(), \"no understand cache\") {\n\t\tt.Errorf(\"error should mention no cache: %v\", err)\n\t}\n}\n\nfunc TestUnderstandDashboard_PrintMode(t *testing.T) {\n\tdir := t.TempDir()\n\ttestutil.InitRepo(t, dir)\n\tseedReplayCache(t, dir)\n\tt.Chdir(dir)\n\tpaths.ClearWorktreeRootCache()\n\n\tvar buf bytes.Buffer\n\tif err := runUnderstandDashboard(context.Background(), &buf, dashboardOptions{PrintOnly: true}); err != nil {\n\t\tt.Fatalf(\"runUnderstandDashboard --print: %v\", err)\n\t}\n\tout := buf.String()\n\tif !strings.Contains(out, \"would-launch:\") {\n\t\tt.Errorf(\"expected --print banner; got:\\n%s\", out)\n\t}\n\tif !strings.Contains(out, \"token=\") {\n\t\tt.Errorf(\"--print output missing token line:\\n%s\", out)\n\t}\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"96d22307-78c5