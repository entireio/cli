 font: 12px/1.4 ui-monospace, Menlo, monospace; }\n  pre { background: #f5f5f5; padding: 0.75rem; overflow: auto; border-radius: 4px; }\n  .hint { color: #777; font-size: 12px; }\n  .pill { display: inline-block; padding: 1px 6px; border-radius: 8px; background: #eef; color: #225; margin-right: 4px; }\n  table { border-collapse: collapse; width: 100%; }\n  th, td { border-bottom: 1px solid #eee; padding: 4px 6px; text-align: left; vertical-align: top; }\n  th { background: #fafafa; }\n  .checkpoint { color: #884; }\n  details { margin-top: 8px; }\n  summary { cursor: pointer; color: #36a; }\n</style>\n</head>\n<body>\n<h1>entire understand</h1>\n<p class=\"hint\">Loopback-only dashboard. Bearer token bound to this launch — close the tab to invalidate the session.</p>\n\n<div id=\"manifest\"></div>\n<div id=\"hotspots\"></div>\n<div id=\"timeline\"></div>\n\n<details><summary>Raw fused graph (full)</summary><pre id=\"graph\"></pre></details>\n\n<script>\n(function () {\n  // The bootstrap script-tag injected by the server populates window.__entireUnderstandToken\n  // before this script runs. Token is *only* used as a Bearer header — never as a query\n  // string — so it doesn't end up in browser history, screenshots, or copied URLs.\n  const token = window.__entireUnderstandToken;\n  if (!token) {\n    document.body.textContent = \"missing bootstrap token; reload the page\";\n    return;\n  }\n\n  function api(path) {\n    return fetch(path, { headers: { \"Authorization\": \"Bearer \" + token } }).then(function (r) {\n      if (!r.ok) throw new Error(path + \": \" + r.status);\n      return r.json();\n    });\n  }\n\n  function el(tag, opts) {\n    const n = document.createElement(tag);\n    if (opts) {\n      if (opts.text != null) n.textContent = String(opts.text);\n      if (opts.cls) n.className = opts.cls;\n    }\n    return n;\n  }\n\n  function pill(text) {\n    return el(\"span\", { text: text, cls: \"pill\" });\n  }\n\n  function renderManifest(m) {\n    const root = document.getElementById(\"manifest\");\n    root.replaceChildren();\n    root.appendChild(el(\"h2\", { text: \"Manifest\" }));\n    const p = document.createElement(\"p\");\n    p.appendChild(pill(\"build \" + (m.build_id || \"?\")));\n    p.appendChild(pill(\"structural \" + (m.structural_status || \"?\")));\n    p.appendChild(pill(\"history \" + (m.history_status || \"?\")));\n    p.appendChild(pill(\"semantic \" + (m.semantic_status || \"?\")));\n    if (m.semantic_provider) p.appendChild(pill(\"provider \" + m.semantic_provider));\n    p.appendChild(pill(\"nodes \" + (m.node_count || 0)));\n    p.appendChild(pill(\"edges \" + (m.edge_count || 0)));\n    root.appendChild(p);\n  }\n\n  function renderTable(parent, header, rows) {\n    parent.replaceChildren();\n    parent.appendChild(el(\"h2\", { text: header.title }));\n    if (!rows.length) {\n      parent.appendChild(el(\"p\", { text: header.empty }));\n      return;\n    }\n    const table = document.createElement(\"table\");\n    const tr = document.createElement(\"tr\");\n    header.columns.forEach(function (col) {\n      tr.appendChild(el(\"th\", { text: col }));\n    });\n    table.appendChild(tr);\n    rows.forEach(function (row) {\n      const r = document.createElement(\"tr\");\n      row.forEach(function (cell, i) {\n        r.appendChild(el(\"td\", { text: cell, cls: i === 1 ? \"checkpoint\" : \"\" }));\n      });\n      table.appendChild(r);\n    });\n    parent.appendChild(table);\n  }\n\n  function renderHotspots(rows) {\n    renderTable(\n      document.getElementById(\"hotspots\"),\n      { title: \"Hotspots\", columns: [\"file\", \"cps\", \"agents\", \"score\"], empty: \"No data yet — run `entire understand build`.\" },\n      rows.map(function (h) { return [h.path || h.node_id, h.checkpoint_count, h.distinct_agents, h.score.toFixed(1)]; })\n    );\n  }\n\n  function renderTimeline(events) {\n    renderTable(\n      document.getElementById(\"timeline\"),\n      { title: \"Timeline\", columns: [\"at\", \"cp\", \"session\", \"files\"], empty: \"No checkpoints yet.\" },\n      events.map(function (e) { return [e.at, e.checkpoint_id || \"\", e.session_id || \"\", (e.node_ids || []).length]; })\n    );\n  }\n\n  Promise.all([\n    api(\"/api/manifest\"),\n    api(\"/api/hotspots\"),\n    api(\"/api/timeline\"),\n    api(\"/api/graph\")\n  ]).then(function (results) {\n    renderManifest(results[0]);\n    renderHotspots(results[1].hotspots || []);\n    renderTimeline(results[2].events || []);\n    document.getElementById(\"graph\").textContent = JSON.stringify(results[3], null, 2);\n  }).catch(function (err) {\n    const e = document.createElement(\"p\");\n    e.style.color = \"#c00\";\n    e.textContent = \"load failed: \" + err.message;\n    document.body.insertBefore(e, document.body.firstChild);\n  });\n})();\n</script>\n</body>\n</html>\n","userModified":false},"sourceToolAssistantUUID":"2ab6efa7-74a3-4b75-9d47-9545e6db6f5e","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
