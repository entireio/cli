,headRefName,files'\n     (requires gh on PATH; never falls back to embedded auth)\n  2. --base <ref> --head <ref> using local 'git diff'\n  3. --rev <revset> using local 'git diff'\n\nExamples:\n  entire understand pr 1234\n  entire understand pr --base main --head HEAD\n  entire understand pr --rev origin/main..HEAD`,\n\t\tArgs: cobra.MaximumNArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\tid := \"\"\n\t\t\tif len(args) == 1 {\n\t\t\t\tid = args[0]\n\t\t\t}\n\t\t\treturn runUnderstandPr(cmd.Context(), cmd.OutOrStdout(), prOptions{\n\t\t\t\tID:       id,\n\t\t\t\tBase:     base,\n\t\t\t\tHead:     head,\n\t\t\t\tRevset:   revset,\n\t\t\t\tJSONOut:  jsonOut,\n\t\t\t\tMaxFiles: maxFiles,\n\t\t\t})\n\t\t},\n\t}\n\tcmd.Flags().StringVar(&base, \"base\", \"\", \"Base ref for diff fallback (used when no PR id)\")\n\tcmd.Flags().StringVar(&head, \"head\", \"HEAD\", \"Head ref for diff fallback\")\n\tcmd.Flags().StringVar(&revset, \"rev\", \"\", \"Revset for diff fallback (e.g. origin/main..HEAD)\")\n\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n\tcmd.Flags().IntVar(&maxFiles, \"max-files\", 50, \"Maximum number of touched files to annotate\")\n\treturn cmd\n}\n\ntype prOptions struct {\n\tID       string\n\tBase     string\n\tHead     string\n\tRevset   string\n\tJSONOut  bool\n\tMaxFiles int\n}\n\ntype prTouchedFile struct {\n\tPath           string `json:\"path\"`\n\tStatus         string `json:\"status,omitempty\"` // \"added\", \"modified\", \"removed\", \"renamed\"\n\tNodeID         string `json:\"node_id,omitempty\"`\n\tLastCheckpoint string `json:\"last_checkpoint,omitempty\"`\n\tLastAt         string `json:\"last_at,omitempty\"`\n\tLastAgent      string `json:\"last_agent,omitempty\"`\n\tHotspotScore   float64 `json:\"hotspot_score,omitempty\"`\n}\n\ntype prReport struct {\n\tSource   string          `json:\"source\"` // \"gh\" | \"diff\" | \"revset\"\n\tID       string          `json:\"id,omitempty\"`\n\tBase     string          `json:\"base,omitempty\"`\n\tHead     string          `json:\"head,omitempty\"`\n\tRevset   string          `json:\"revset,omitempty\"`\n\tFiles    []prTouchedFile `json:\"files\"`\n\tReason   string          `json:\"reason,omitempty\"`\n\tNoCache  bool            `json:\"no_cache,omitempty\"`\n}\n\nfunc runUnderstandPr(ctx context.Context, w io.Writer, opts prOptions) error {\n\tq, err := loadQueryEnv(ctx)\n\tif err != nil {\n\t\tif errors.Is(err, errNoUnderstandCache) {\n\t\t\treport := prReport{NoCache: true, Reason: err.Error()}\n\t\t\treturn emitPr(w, report, opts.JSONOut)\n\t\t}\n\t\treturn err\n\t}\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"resolve repo root: %w\", err)\n\t}\n\n\treport := prReport{}\n\tvar paths []touchedFileRaw\n\n\tswitch {\n\tcase opts.ID != \"\":\n\t\tpaths, err = ghTouchedFiles(ctx, opts.ID)\n\t\tif err != nil {\n\t\t\treport.Reason = fmt.Sprintf(\"gh lookup failed (%s); pass --base / --head to use local diff\", err.Error())\n\t\t\treturn emitPr(w, report, opts.JSONOut)\n\t\t}\n\t\treport.Source = \"gh\"\n\t\treport.ID = opts.ID\n\tcase opts.Revset != \"\":\n\t\tpaths, err = gitTouchedFiles(ctx, repoRoot, []string{opts.Revset})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"git diff %s: %w\", opts.Revset, err)\n\t\t}\n\t\treport.Source = \"revset\"\n\t\treport.Revset = opts.Revset\n\tcase opts.Base != \"\":\n\t\targs := []string{opts.Base + \"...\" + opts.Head}\n\t\tpaths, err = gitTouchedFiles(ctx, repoRoot, args)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"git diff %s..%s: %w\", opts.Base, opts.Head, err)\n\t\t}\n\t\treport.Source = \"diff\"\n\t\treport.Base = opts.Base\n\t\treport.Head = opts.Head\n\tdefault:\n\t\treturn errors.New(\"understand pr: provide a PR id, or --base/--head, or --rev\")\n\t}\n\n\tif opts.MaxFiles > 0 && len(paths) > opts.MaxFiles {\n\t\tpaths = paths[:opts.MaxFiles]\n\t}\n\tfor _, p := range paths {\n\t\tf := prTouchedFile{Path: p.Path, Status: p.Status}\n\t\tnodeID := \"file:\" + p.Path\n\t\tif _, ok := q.byID[nodeID]; !ok {\n\t\t\tnodeID = \"ghost:\" + p.Path\n\t\t}\n\t\tif n, ok := q.byID[nodeID]; ok {\n\t\t\tf.NodeID = n.ID\n\t\t\tif cp := q.recentCheckpoint(n.ID); cp != nil {\n\t\t\t\tf.LastCheckpoint = cp.Name\n\t\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n\t\t\t\t\tf.LastAt = at\n\t\t\t\t}\n\t\t\t\tif ag, ok := cp.Attrs[\"agent\"].(string); ok {\n\t\t\t\t\tf.LastAgent = ag\n\t\t\t\t}\n\t\t\t}\n\t\t\tf.HotspotScore = float64(q.touchedCount[n.ID])\n\t\t}\n\t\treport.Files = append(report.Files, f)\n\t}\n\tsort.SliceStable(report.Files, func(i, j int) bool {\n\t\treturn report.Files[i].HotspotScore > report.Files[j].HotspotScore\n\t})\n\n\treturn emitPr(w, report, opts.JSONOut)\n}\n\ntype touchedFileRaw struct {\n\tPath   string\n\tStatus string\n}\n\n// ghTouchedFiles invokes `gh pr view <id> --json files,baseRefName,headRefName`.\n// gh's JSON output for `files` is an array of {path, additions, deletions}\n// objects; we map each to a path with status=\"modified\" because gh does not\n// distinguish renames in this view.\nfunc ghTouchedFiles(ctx context.Context, prID string) ([]touchedFileRaw, error) {\n\tif _, err := exec.LookPath(\"gh\"); err != nil {\n\t\treturn nil, fmt.Errorf(\"gh not on PATH: %w\", err)\n\t}\n\tcmd := exec.CommandContext(ctx, \"gh\", \"pr\", \"view\", prID, \"--json\", \"files\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tvar ex *exec.ExitError\n\t\tif errors.As(err, &ex) {\n\t\t\treturn nil, fmt.Errorf(\"gh pr view %s exit %d: %s\", prID, ex.ExitCode(), strings.TrimSpace(string(ex.Stderr)))\n\t\t}\n\t\treturn nil, fmt.Errorf(\"gh pr view %s: %w\", prID, err)\n\t}\n\tvar parsed struct {\n\t\tFiles []struct {\n\t\t\tPath string `json:\"path\"`\n\t\t} `json:\"files\"`\n\t}\n\tif err := json.Unmarshal(out, &parsed); err != nil {\n\t\treturn nil, fmt.Errorf(\"parse gh json: %w\", err)\n\t}\n\tfiles := make([]touchedFileRaw, 0, len(parsed.Files))\n\tfor _, f := range parsed.Files {\n\t\tfiles = append(files, touchedFileRaw{Path: f.Path, Status: \"modified\"})\n\t}\n\treturn files, nil\n}\n\n// gitTouchedFiles runs `git diff --name-status` for the given args and returns\n// the touched paths annotated with their porcelain status code (A/M/D/R...).\nfunc gitTouchedFiles(ctx context.Context, repoRoot string, diffArgs []string) ([]touchedFileRaw, error) {\n\targs := append([]string{\"diff\", \"--name-status\"}, diffArgs...)\n\tcmd := exec.CommandContext(ctx, \"git\", args...)\n\tcmd.Dir = repoRoot\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tvar ex *exec.ExitError\n\t\tif errors.As(err, &ex) {\n\t\t\treturn nil, fmt.Errorf(\"git diff exit %d: %s\", ex.ExitCode(), strings.TrimSpace(string(ex.Stderr)))\n\t\t}\n\t\treturn nil, fmt.Errorf(\"git diff: %w\", err)\n\t}\n\tfiles := []touchedFileRaw{}\n\tfor _, line := range strings.Split(strings.TrimSpace(string(out)), \"\\n\") {\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tfields := strings.Fields(line)\n\t\tif len(fields) < 2 {\n\t\t\tcontinue\n\t\t}\n\t\tstatus := translateGitStatus(fields[0])\n\t\t// Renames have format `R<score> old new`; pick the new path.\n\t\tpath := fields[len(fields)-1]\n\t\tfiles = append(files, touchedFileRaw{Path: path, Status: status})\n\t}\n\treturn files, nil\n}\n\nfunc translateGitStatus(code string) string {\n\tif code == \"\" {\n\t\treturn \"\"\n\t}\n\tswitch code[0] {\n\tcase 'A':\n\t\treturn \"added\"\n\tcase 'D':\n\t\treturn \"removed\"\n\tcase 'M':\n\t\treturn \"modified\"\n\tcase 'R':\n\t\treturn \"renamed\"\n\tcase 'C':\n\t\treturn \"copied\"\n\tdefault:\n\t\treturn strings.ToLower(code)\n\t}\n}\n\nfunc emitPr(w io.Writer, r prReport, jsonOut bool) error {\n\tif jsonOut {\n\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"marshal pr: %w\", err)\n\t\t}\n\t\tif _, err := w.Write(data); err != nil {\n\t\t\treturn fmt.Errorf(\"write pr JSON: %w\", err)\n\t\t}\n\t\treturn nil\n\t}\n\tif r.NoCache {\n\t\tfmt.Fprintln(w, r.Reason)\n\t\treturn nil\n\t}\n\tif r.Reason != \"\" {\n\t\tfmt.Fprintln(w, r.Reason)\n\t\treturn nil\n\t}\n\tswitch r.Source {\n\tcase \"gh\":\n\t\tfmt.Fprintf(w, \"# PR review: #%s\\n\\n\", r.ID)\n\tcase \"diff\":\n\t\tfmt.Fprintf(w, \"# Diff review: %s..%s\\n\\n\", r.Base, r.Head)\n\tcase \"revset\":\n\t\tfmt.Fprintf(w, \"# Revset review: %s\\n\\n\", r.Revset)\n\t}\n\tif len(r.Files) == 0 {\n\t\tfmt.Fprintln(w, \"_No touched files in the requested range._\")\n\t\treturn nil\n\t}\n\tfor _, f := range r.Files {\n\t\tstatus := f.Status\n\t\tif status == \"\" {\n\t\t\tstatus = \"modified\"\n\t\t}\n\t\tfmt.Fprintf(w, \"- **%s** _(%s)_\", f.Path, status)\n\t\tif f.HotspotScore > 0 {\n\t\t\tfmt.Fprintf(w, \" — touched in %d prior checkpoint(s)\", int(f.HotspotScore))\n\t\t}\n\t\tif f.LastCheckpoint != \"\" {\n\t\t\tfmt.Fprintf(w, \"; last in `%s`\", f.LastCheckpoint)\n\t\t\tif f.LastAt != \"\" {\n\t\t\t\tfmt.Fprintf(w, \" at %s\", f.LastAt)\n\t\t\t}\n\t\t\tif f.LastAgent != \"\" {\n\t\t\t\tfmt.Fprintf(w, \" by %s\", f.LastAgent)\n\t\t\t}\n\t\t}\n\t\tfmt.Fprintln(w)\n\t}\n\treturn nil\n}\n","structuredPatch":[{"oldStart":69,"oldLines":6,"newStart":69,"newLines":13,"lines":["   return cmd"," }"," ","+// PR-source labels used in the report shape and emitted JSON.","+const (","+  prSourceGH     = \"gh\"","+  prSourceDiff   = \"diff\"","+  prSourceRevset = \"revset\"","+)","+"," type prOptions struct {","   ID       string","   Base     string"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"26008a02-38c9-4477-9251-5d8f21ea2306","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
