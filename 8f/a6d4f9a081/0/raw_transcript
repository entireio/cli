{"parentUuid":"14898162-da5d-47a4-b12e-89b2c3cfca05","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/alisha/.marvin/worktrees/collab-95042499-claude/cmd/entire/cli/understand_examples.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"sort\"\n9\t\t\"strings\"\n10\t\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n13\t\t\"github.com/spf13/cobra\"\n14\t)\n15\t\n16\t// newUnderstandExamplesCmd builds `entire understand examples <pattern>`.\n17\t//\n18\t// The pattern is treated as untrusted data — it is never injected into a\n19\t// model prompt. The deterministic match path uses lexical substring search\n20\t// over node names and paths, scored by recency × match strength. Semantic\n21\t// pattern-graph traversal is wired in but disabled until build runs actual\n22\t// synthesis (deterministic-only for v1).\n23\tfunc newUnderstandExamplesCmd() *cobra.Command {\n24\t\tvar jsonOut bool\n25\t\tvar maxResults int\n26\t\n27\t\tcmd := &cobra.Command{\n28\t\t\tUse:   \"examples <pattern>\",\n29\t\t\tShort: \"Find structurally similar examples for a pattern\",\n30\t\t\tLong: `Search node names and paths for the given pattern and rank matches by\n31\trecency and match strength. Output includes a \"why this matched\" reason for\n32\teach example.\n33\t\n34\tExamples:\n35\t  entire understand examples NewStore\n36\t  entire understand examples \"rate limiter\"`,\n37\t\t\tArgs: cobra.ExactArgs(1),\n38\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n39\t\t\t\treturn runUnderstandExamples(cmd.Context(), cmd.OutOrStdout(), args[0], jsonOut, maxResults)\n40\t\t\t},\n41\t\t}\n42\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit JSON instead of markdown\")\n43\t\tcmd.Flags().IntVar(&maxResults, \"max\", 20, \"Maximum number of results to return\")\n44\t\treturn cmd\n45\t}\n46\t\n47\ttype exampleHit struct {\n48\t\tNodeID   string  `json:\"node_id\"`\n49\t\tPath     string  `json:\"path,omitempty\"`\n50\t\tType     string  `json:\"type\"`\n51\t\tScore    float64 `json:\"score\"`\n52\t\tReason   string  `json:\"reason\"`\n53\t\tLastAt   string  `json:\"last_at,omitempty\"`\n54\t\tLastCpID string  `json:\"last_cp,omitempty\"`\n55\t}\n56\t\n57\ttype examplesReport struct {\n58\t\tPattern string       `json:\"pattern\"`\n59\t\tHits    []exampleHit `json:\"hits\"`\n60\t}\n61\t\n62\tfunc runUnderstandExamples(ctx context.Context, w io.Writer, pattern string, jsonOut bool, maxResults int) error {\n63\t\tq, err := loadQueryEnv(ctx)\n64\t\tif err != nil {\n65\t\t\tif errors.Is(err, errNoUnderstandCache) {\n66\t\t\t\tfmt.Fprintln(w, err.Error())\n67\t\t\t\treturn nil\n68\t\t\t}\n69\t\t\treturn err\n70\t\t}\n71\t\n72\t\tpattern = strings.TrimSpace(pattern)\n73\t\treport := examplesReport{Pattern: pattern}\n74\t\tif pattern == \"\" {\n75\t\t\treturn emitExamples(w, report, jsonOut)\n76\t\t}\n77\t\n78\t\tlower := strings.ToLower(pattern)\n79\t\n80\t\tfor i := range q.fused.Nodes {\n81\t\t\tn := &q.fused.Nodes[i]\n82\t\t\tif n.Type != graph.NodeFile && n.Type != graph.NodeSymbol {\n83\t\t\t\tcontinue\n84\t\t\t}\n85\t\t\tscore, reason := scoreExampleMatch(n, lower)\n86\t\t\tif score <= 0 {\n87\t\t\t\tcontinue\n88\t\t\t}\n89\t\t\thit := exampleHit{\n90\t\t\t\tNodeID: n.ID,\n91\t\t\t\tPath:   n.Path,\n92\t\t\t\tType:   string(n.Type),\n93\t\t\t\tScore:  score,\n94\t\t\t\tReason: reason,\n95\t\t\t}\n96\t\t\tif cp := q.recentCheckpoint(n.ID); cp != nil {\n97\t\t\t\thit.LastCpID = cp.Name\n98\t\t\t\tif at, ok := cp.Attrs[\"created_at\"].(string); ok {\n99\t\t\t\t\thit.LastAt = at\n100\t\t\t\t}\n101\t\t\t}\n102\t\t\treport.Hits = append(report.Hits, hit)\n103\t\t}\n104\t\n105\t\tsort.Slice(report.Hits, func(i, j int) bool {\n106\t\t\tif report.Hits[i].Score != report.Hits[j].Score {\n107\t\t\t\treturn report.Hits[i].Score > report.Hits[j].Score\n108\t\t\t}\n109\t\t\t// Tiebreak: most-recently touched first.\n110\t\t\treturn report.Hits[i].LastAt > report.Hits[j].LastAt\n111\t\t})\n112\t\tif maxResults > 0 && len(report.Hits) > maxResults {\n113\t\t\treport.Hits = report.Hits[:maxResults]\n114\t\t}\n115\t\treturn emitExamples(w, report, jsonOut)\n116\t}\n117\t\n118\t// scoreExampleMatch returns a non-negative score (higher = better match) and a\n119\t// short human-readable reason. Symbol-name exact matches outrank file-name\n120\t// substring matches outrank path substring matches.\n121\tfunc scoreExampleMatch(n *graph.Node, lowerPattern string) (float64, string) {\n122\t\tlowerName := strings.ToLower(n.Name)\n123\t\tlowerPath := strings.ToLower(n.Path)\n124\t\n125\t\tswitch {\n126\t\tcase n.Type == graph.NodeSymbol && lowerName == lowerPattern:\n127\t\t\treturn 4.0, \"symbol name exactly matches\"\n128\t\tcase n.Type == graph.NodeSymbol && strings.Contains(lowerName, lowerPattern):\n129\t\t\treturn 3.0, \"symbol name contains pattern\"\n130\t\tcase lowerName == lowerPattern:\n131\t\t\treturn 2.5, \"node name exactly matches\"\n132\t\tcase strings.Contains(lowerName, lowerPattern):\n133\t\t\treturn 2.0, \"node name contains pattern\"\n134\t\tcase strings.Contains(lowerPath, lowerPattern):\n135\t\t\treturn 1.0, \"path contains pattern\"\n136\t\tdefault:\n137\t\t\treturn 0, \"\"\n138\t\t}\n139\t}\n140\t\n141\tfunc emitExamples(w io.Writer, r examplesReport, jsonOut bool) error {\n142\t\tif jsonOut {\n143\t\t\tdata, err := jsonutil.MarshalIndentWithNewline(r, \"\", \"  \")\n144\t\t\tif err != nil {\n145\t\t\t\treturn fmt.Errorf(\"marshal examples: %w\", err)\n146\t\t\t}\n147\t\t\tif _, err := w.Write(data); err != nil {\n148\t\t\t\treturn fmt.Errorf(\"write examples JSON: %w\", err)\n149\t\t\t}\n150\t\t\treturn nil\n151\t\t}\n152\t\tif r.Pattern == \"\" {\n153\t\t\tfmt.Fprintln(w, \"_Empty pattern; nothing to match._\")\n154\t\t\treturn nil\n155\t\t}\n156\t\tif len(r.Hits) == 0 {\n157\t\t\tfmt.Fprintf(w, \"_No matches for pattern %q._\\n\", r.Pattern)\n158\t\t\treturn nil\n159\t\t}\n160\t\tfmt.Fprintf(w, \"# Examples for `%s`\\n\\n\", r.Pattern)\n161\t\tfor _, h := range r.Hits {\n162\t\t\tpath := h.Path\n163\t\t\tif path == \"\" {\n164\t\t\t\tpath = h.NodeID\n165\t\t\t}\n166\t\t\tfmt.Fprintf(w, \"- **%s** _(%s)_ — %s\", path, h.Type, h.Reason)\n167\t\t\tif h.LastCpID != \"\" {\n168\t\t\t\tfmt.Fprintf(w, \"; last in `%s`\", h.LastCpID)\n169\t\t\t\tif h.LastAt != \"\" {\n170\t\t\t\t\tfmt.Fprintf(w, \" at %s\", h.LastAt)\n171\t\t\t\t}\n172\t\t\t}\n173\t\t\tfmt.Fprintln(w)\n174\t\t}\n175\t\treturn nil\n176\t}"},"type":"attachment","uuid":"c2d77d8a-4517-447f-be57-40d9cd4adbab","timestamp":"2026-05-05T18:50:12.355Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
