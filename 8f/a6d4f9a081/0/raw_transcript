// ---------------------------------------------------------------------------\n  // Side panel\n  // ---------------------------------------------------------------------------\n  const detail = document.getElementById(\"detail\");\n  const dTitle = document.getElementById(\"d-title\");\n  const dMeta = document.getElementById(\"d-meta\");\n  const dConflictSection = document.getElementById(\"d-conflict-section\");\n  const dConflict = document.getElementById(\"d-conflict\");\n  const dChildrenSection = document.getElementById(\"d-children-section\");\n  const dChildren = document.getElementById(\"d-children\");\n  const dCpSection = document.getElementById(\"d-checkpoints-section\");\n  const dCheckpoints = document.getElementById(\"d-checkpoints\");\n  const dSummarySection = document.getElementById(\"d-summary-section\");\n  const dSummary = document.getElementById(\"d-summary\");\n\n  function clearDetail() {\n    detail.classList.add(\"empty\");\n    dTitle.textContent = \"\";\n    dMeta.textContent = \"\";\n    dConflict.textContent = \"\";\n    dChildren.replaceChildren();\n    dCheckpoints.replaceChildren();\n    dSummary.replaceChildren();\n  }\n  clearDetail();\n\n  function showDetail(node) {\n    detail.classList.remove(\"empty\");\n    dTitle.textContent = node.id;\n    const metaParts = [node.type];\n    if (node.symbol_kind) metaParts.push(node.symbol_kind);\n    if (node.path) metaParts.push(node.path);\n    if (node.language) metaParts.push(node.language);\n    if (node.line_start) metaParts.push(\"L\" + node.line_start + \"-\" + node.line_end);\n    dMeta.textContent = metaParts.join(\" · \");\n\n    // Conflict hint (deterministic, populated by impact endpoint when we add one).\n    if (node.conflict_hint) {\n      dConflictSection.style.display = \"\";\n      dConflict.textContent = \"conflict hint: \" + node.conflict_hint;\n    } else {\n      dConflictSection.style.display = \"none\";\n    }\n\n    // Children: direct contains targets.\n    const children = childrenOf(node.id);\n    dChildrenSection.style.display = children.length ? \"\" : \"none\";\n    dChildren.replaceChildren();\n    children.forEach(function (c) {\n      const li = document.createElement(\"li\");\n      const link = document.createElement(\"a\");\n      link.href = \"#\";\n      link.textContent = c.label;\n      link.addEventListener(\"click\", function (ev) {\n        ev.preventDefault();\n        focusNode(c.id);\n      });\n      li.appendChild(link);\n      dChildren.appendChild(li);\n    });\n\n    // Checkpoint trail.\n    const cps = checkpointsTouching(node.id);\n    dCpSection.style.display = cps.length ? \"\" : \"none\";\n    dCheckpoints.replaceChildren();\n    cps.forEach(function (cp) {\n      const li = document.createElement(\"li\");\n      const head = document.createElement(\"div\");\n      head.textContent = cp.id;\n      li.appendChild(head);\n      const meta = document.createElement(\"div\");\n      meta.className = \"qualifier\";\n      const parts = [];\n      if (cp.created_at) parts.push(cp.created_at);\n      if (cp.agent) parts.push(cp.agent);\n      if (cp.scope === \"file-owner\") parts.push(\"(file-level inferred)\");\n      meta.textContent = parts.join(\" · \");\n      li.appendChild(meta);\n      const btn = document.createElement(\"button\");\n      btn.className = \"action\";\n      btn.textContent = \"fetch detail\";\n      btn.addEventListener(\"click\", function () {\n        loadCheckpointDetail(cp.id);\n      });\n      li.appendChild(btn);\n      dCheckpoints.appendChild(li);\n    });\n\n    dSummarySection.style.display = \"none\";\n    dSummary.replaceChildren();\n  }\n\n  function loadCheckpointDetail(cpID) {\n    api(\"/api/checkpoint/\" + encodeURIComponent(cpID))\n      .then(function (cp) {\n        dSummarySection.style.display = \"\";\n        dSummary.replaceChildren();\n        const rows = [\n          [\"checkpoint_id\", cp.checkpoint_id],\n          [\"strategy\", cp.strategy],\n          [\"branch\", cp.branch],\n          [\"checkpoints_count\", cp.checkpoints_count],\n          [\"session_count\", cp.session_count],\n        ];\n        rows.forEach(function (kv) {\n          if (!kv[1]) return;\n          const li = document.createElement(\"li\");\n          const k = document.createElement(\"strong\");\n          k.textContent = kv[0] + \": \";\n          li.appendChild(k);\n          li.appendChild(document.createTextNode(String(kv[1])));\n          dSummary.appendChild(li);\n        });\n        if (cp.files_touched && cp.files_touched.length) {\n          const li = document.createElement(\"li\");\n          const k = document.createElement(\"strong\");\n          k.textContent = \"files (\" + cp.files_touched.length + \"):\";\n          li.appendChild(k);\n          const ul = document.createElement(\"ul\");\n          cp.files_touched.forEach(function (f) {\n            const fli = document.createElement(\"li\");\n            const link = document.createElement(\"a\");\n            link.href = \"#\";\n            link.textContent = f;\n            link.addEventListener(\"click\", function (ev) {\n              ev.preventDefault();\n              focusNode(\"file:\" + f);\n            });\n            fli.appendChild(link);\n            ul.appendChild(fli);\n          });\n          li.appendChild(ul);\n          dSummary.appendChild(li);\n        }\n      })\n      .catch(function (err) {\n        showBanner(\"checkpoint detail failed: \" + err.message);\n      });\n  }\n\n  // ---------------------------------------------------------------------------\n  // Graph state\n  // ---------------------------------------------------------------------------\n  let cy = null;\n  let graphData = { nodes: [], edges: [] };\n  const nodesByID = new Map();\n  const edgesIndexFromTo = new Map(); // from-id -> [edges]\n  const edgesIndexToFrom = new Map(); // to-id -> [edges]\n\n  function indexEdge(idx, key, edge) {\n    if (!idx.has(key)) idx.set(key, []);\n    idx.get(key).push(edge);\n  }\n\n  function buildIndex() {\n    nodesByID.clear();\n    edgesIndexFromTo.clear();\n    edgesIndexToFrom.clear();\n    graphData.nodes.forEach(function (n) {\n      nodesByID.set(n.id, n);\n    });\n    graphData.edges.forEach(function (e) {\n      indexEdge(edgesIndexFromTo, e.from, e);\n      indexEdge(edgesIndexToFrom, e.to, e);\n    });\n  }\n\n  function childrenOf(nodeID) {\n    const out = [];\n    (edgesIndexFromTo.get(nodeID) || []).forEach(function (e) {\n      if (e.type !== \"contains\") return;\n      const child = nodesByID.get(e.to);\n      if (!child) return;\n      out.push({ id: child.id, label: child.name + (child.symbol_kind ? \" · \" + child.symbol_kind : \"\") });\n    });\n    return out;\n  }\n\n  function checkpointsTouching(nodeID) {\n    // Direct cp -> file edges.\n    const seen = new Set();\n    const out = [];\n    (edgesIndexToFrom.get(nodeID) || []).forEach(function (e) {\n      if (e.type !== \"touched_in\") return;\n      const cp = nodesByID.get(e.from);\n      if (!cp) return;\n      if (seen.has(cp.id)) return;\n      seen.add(cp.id);\n      out.push({\n        id: cp.name,\n        scope: e.scope || \"\",\n        created_at: (cp.attrs && cp.attrs.created_at) || \"\",\n        agent: (cp.attrs && cp.attrs.agent) || \"\",\n      });\n    });\n\n    // For symbols: bubble up to owning file's checkpoints (file-owner scope).\n    const me = nodesByID.get(nodeID);\n    if (me && me.type === \"symbol\" && me.path) {\n      const fileID = \"file:\" + me.path;\n      (edgesIndexToFrom.get(fileID) || []).forEach(function (e) {\n        if (e.type !== \"touched_in\") return;\n        const cp = nodesByID.get(e.from);\n        if (!cp || seen.has(cp.id)) return;\n        seen.add(cp.id);\n        out.push({\n          id: cp.name,\n          scope: \"file-owner\",\n          created_at: (cp.attrs && cp.attrs.created_at) || \"\",\n          agent: (cp.attrs && cp.attrs.agent) || \"\",\n        });\n      });\n    }\n    out.sort(function (a, b) { return (b.created_at || \"\").localeCompare(a.created_at || \"\"); });\n    return out;\n  }\n\n  function focusNode(nodeID) {\n    if (!cy) return;\n    const ele = cy.getElementById(nodeID);\n    if (!ele || ele.empty()) {\n      showBanner(\"node \" + nodeID + \" not in current view (filter may hide it)\");\n      return;\n    }\n    hideBanner();\n    cy.elements().removeClass(\"highlight\").removeClass(\"dim\");\n    ele.addClass(\"highlight\");\n    ele.neighborhood().addClass(\"highlight\");\n    cy.elements().difference(ele.neighborhood().union(ele)).addClass(\"dim\");\n    cy.animate({\n      center: { eles: ele },\n      zoom: Math.max(cy.zoom(), 0.9),\n    }, { duration: 280 });\n    showDetail(nodesByID.get(nodeID));\n  }\n\n  // ---------------------------------------------------------------------------\n  // Node typing → cytoscape style\n  // ---------------------------------------------------------------------------\n  const STYLE = [\n    {\n      selector: \"node\",\n      style: {\n        \"label\": \"data(label)\",\n        \"font-size\": 10,\n        \"color\": \"#1f2937\",\n        \"text-valign\": \"bottom\",\n        \"text-margin-y\": 4,\n        \"text-wrap\": \"ellipsis\",\n        \"text-max-width\": 110,\n        \"background-color\": \"#888\",\n        \"width\": 16,\n        \"height\": 16,\n        \"border-width\": 1,\n        \"border-color\": \"#fff\",\n      },\n    },\n    { selector: 'node[type = \"repo\"]',       style: { \"background-color\": \"var(--c-repo, #111827)\", \"width\": 28, \"height\": 28 } },\n    { selector: 'node[type = \"directory\"]',  style: { \"background-color\": \"#94a3b8\", \"width\": 14, \"height\": 14 } },\n    { selector: 'node[type = \"file\"]',       style: { \"background-color\": \"#4a90e2\", \"width\": 18, \"height\": 18 } },\n    { selector: 'node[type = \"symbol\"]',     style: { \"background-color\": \"#10b981\", \"width\": 12, \"height\": 12 } },\n    { selector: 'node[type = \"package\"]',    style: { \"background-color\": \"#6366f1\", \"shape\": \"diamond\", \"width\": 14, \"height\": 14 } },\n    { selector: 'node[type = \"checkpoint\"]', style: { \"background-color\": \"#f59e0b\", \"shape\": \"round-rectangle\", \"width\": 14, \"height\": 12 } },\n    { selector: 'node[type = \"session\"]',    style: { \"background-color\": \"#a855f7\", \"shape\": \"round-rectangle\", \"width\": 14, \"height\": 12 } },\n    { selector: 'node[?ghost]',              style: { \"background-color\": \"#dc2626\", \"border-color\": \"#7f1d1d\", \"border-width\": 2 } },\n    {\n      selector: \"edge\",\n      style: {\n        \"width\": 1,\n        \"line-color\": \"#cbd5e1\",\n        \"target-arrow-color\": \"#cbd5e1\",\n        \"target-arrow-shape\": \"triangle\",\n        \"curve-style\": \"bezier\",\n        \"opacity\": 0.7,\n      },\n    },\n    { selector: 'edge[type = \"contains\"]',    style: { \"line-color\": \"#9ca3af\", \"target-arrow-color\": \"#9ca3af\" } },\n    { selector: 'edge[type = \"imports\"]',     style: { \"line-color\": \"#6366f1\", \"target-arrow-color\": \"#6366f1\", \"line-style\": \"dashed\" } },\n    { selector: 'edge[type = \"touched_in\"]',  style: { \"line-color\": \"#fbbf24\", \"target-arrow-color\": \"#fbbf24\", \"opacity\": 0.4 } },\n    { selector: 'edge[type = \"belongs_to\"]',  style: { \"line-color\": \"#a855f7\", \"target-arrow-color\": \"#a855f7\" } },\n    { selector: \".highlight\",                 style: { \"z-index\": 999, \"border-width\": 3, \"border-color\": \"#2563eb\" } },\n    { selector: \"edge.highlight\",             style: { \"line-color\": \"#2563eb\", \"target-arrow-color\": \"#2563eb\", \"width\": 2, \"opacity\": 1 } },\n    { selector: \".dim\",                       style: { \"opacity\": 0.15 } },\n    { selector: \".replay-hidden\",             style: { \"display\": \"none\" } },\n    { selector: \".replay-introduced\",         style: { \"border-color\": \"#16a34a\", \"border-width\": 3 } },\n    { selector: \".replay-modified\",           style: { \"border-color\": \"#f59e0b\", \"border-width\": 2 } },\n  ];\n\n  // ---------------------------------------------------------------------------\n  // Filters\n  // ---------------------------------------------------------------------------\n  function activeFilters() {\n    const set = new Set();\n    document.querySelectorAll('header input[data-filter]').forEach(function (cb) {\n      if (cb.checked) set.add(cb.dataset.filter);\n    });\n    return set;\n  }\n\n  function applyFilters() {\n    if (!cy) return;\n    const allowed = activeFilters();\n    cy.batch(function () {\n      cy.nodes().forEach(function (n) {\n        const t = n.data(\"type\");\n        n.style(\"display\", allowed.has(t) ? \"element\" : \"none\");\n      });\n      cy.edges().forEach(function (e) {\n        const src = cy.getElementById(e.data(\"source\"));\n        const tgt = cy.getElementById(e.data(\"target\"));\n        const visible = src && !src.empty() && tgt && !tgt.empty() &&\n          src.style(\"display\") !== \"none\" && tgt.style(\"display\") !== \"none\";\n        e.style(\"display\", visible ? \"element\" : \"none\");\n      });\n    });\n  }\n\n  // ---------------------------------------------------------------------------\n  // Load + render\n  // ---------------------------------------------------------------------------\n  function nodeLabel(n) {\n    if (n.type === \"checkpoint\") return n.name.slice(0, 8);\n    if (n.type === \"session\") return \"sess\";\n    if (n.type === \"package\") return n.name;\n    return n.name || n.id;\n  }\n\n  function buildElements() {\n    const elements = [];\n    graphData.nodes.forEach(function (n) {\n      elements.push({\n        group: \"nodes\",\n        data: {\n          id: n.id,\n          label: nodeLabel(n),\n          type: n.type,\n          symbol_kind: n.symbol_kind,\n          path: n.path,\n          language: n.language,\n          ghost: !!(n.attrs && n.attrs.removed),\n          attrs: n.attrs || {},\n          line_start: n.line_start,\n          line_end: n.line_end,\n          name: n.name,\n        },\n      });\n    });\n    graphData.edges.forEach(function (e) {\n      elements.push({\n        group: \"edges\",\n        data: {\n          id: e.id,\n          source: e.from,\n          target: e.to,\n          type: e.type,\n          scope: e.scope || \"\",\n        },\n      });\n    });\n    return elements;\n  }\n\n  function relayout() {\n    if (!cy) return;\n    cy.layout({\n      name: \"dagre\",\n      rankDir: \"TB\",\n      nodeSep: 30,\n      rankSep: 60,\n      animate: true,\n      animationDuration: 350,\n    }).run();\n  }\n\n  function init() {\n    Promise.all([api(\"/api/manifest\"), api(\"/api/graph\"), api(\"/api/timeline\")])\n      .then(function (results) {\n        const m = results[0];\n        const graph = results[1];\n        const tl = results[2];\n\n        const pill = document.getElementById(\"manifest-pill\");\n        pill.textContent =\n          (graph.nodes ? graph.nodes.length : 0) + \" nodes · \" +\n          (graph.edges ? graph.edges.length : 0) + \" edges · \" +\n          \"semantic \" + (m.semantic_status || \"?\");\n        if (m.stale || m.checkpoint_head_changed) {\n          showBanner(\"cache may be stale — run `entire understand build` to refresh\");\n        }\n\n        graphData = { nodes: graph.nodes || [], edges: graph.edges || [] };\n        buildIndex();\n\n        cy = cytoscape({\n          container: document.getElementById(\"cy\"),\n          elements: buildElements(),\n          style: STYLE,\n          wheelSensitivity: 0.2,\n          minZoom: 0.05,\n          maxZoom: 4,\n        });\n        cy.on(\"tap\", \"node\", function (evt) {\n          const id = evt.target.id();\n          focusNode(id);\n        });\n        cy.on(\"tap\", function (evt) {\n          if (evt.target === cy) {\n            cy.elements().removeClass(\"highlight\").removeClass(\"dim\");\n            clearDetail();\n          }\n        });\n\n        applyFilters();\n        relayout();\n        wireSearch();\n        wireFilters();\n        wireReplay(tl.events || []);\n\n        // If URL fragment matches #area=<id>, focus it once layout settles.\n        const fragment = window.location.hash;\n        if (fragment.indexOf(\"#area=\") === 0) {\n          const target = decodeURIComponent(fragment.slice(\"#area=\".length));\n          setTimeout(function () { focusNode(target); }, 600);\n        }\n      })\n      .catch(function (err) {\n        document.getElementById(\"cy\").textContent = \"load failed: \" + err.message;\n      });\n  }\n\n  // ---------------------------------------------------------------------------\n  // Search\n  // ---------------------------------------------------------------------------\n  function wireSearch() {\n    const input = document.getElementById(\"search\");\n    let lastMatchID = null;\n    input.addEventListener(\"keydown\", function (ev) {\n      if (ev.key !== \"Enter\") return;\n      const q = input.value.trim().toLowerCase();\n      if (!q) return;\n      // Exact-id match first, then substring on name/path.\n      let match = null;\n      if (nodesByID.has(input.value.trim())) {\n        match = nodesByID.get(input.value.trim());\n      }\n      if (!match) {\n        for (const n of nodesByID.values()) {\n          if ((n.name && n.name.toLowerCase() === q) ||\n              (n.path && n.path.toLowerCase() === q)) {\n            match = n;\n            break;\n          }\n        }\n      }\n      if (!match) {\n        for (const n of nodesByID.values()) {\n          if ((n.name && n.name.toLowerCase().includes(q)) ||\n              (n.path && n.path.toLowerCase().includes(q))) {\n            if (n.id === lastMatchID) continue;\n            match = n;\n            break;\n          }\n        }\n      }\n      if (match) {\n        lastMatchID = match.id;\n        focusNode(match.id);\n      } else {\n        showBanner(\"no match for: \" + input.value);\n      }\n    });\n  }\n\n  // ---------------------------------------------------------------------------\n  // Filter checkboxes\n  // ---------------------------------------------------------------------------\n  function wireFilters() {\n    document.querySelectorAll('header input[data-filter]').forEach(function (cb) {\n      cb.addEventListener(\"change\", applyFilters);\n    });\n    document.getElementById(\"layout-btn\").addEventListener(\"click\", relayout);\n    document.getElementById(\"fit-btn\").addEventListener(\"click\", function () {\n      if (cy) cy.fit(undefined, 30);\n    });\n  }\n\n  // ---------------------------------------------------------------------------\n  // Replay mode\n  // ---------------------------------------------------------------------------\n  function wireReplay(events) {\n    const btn = document.getElementById(\"replay-btn\");\n    const bar = document.getElementById(\"timeline-bar\");\n    const slider = document.getElementById(\"timeline-slider\");\n    const cur = document.getElementById(\"timeline-current\");\n    const total = document.getElementById(\"timeline-total\");\n    const exitBtn = document.getElementById(\"timeline-exit\");\n\n    let active = false;\n    let chronological = events.slice().sort(function (a, b) {\n      return (a.at || \"\").localeCompare(b.at || \"\");\n    });\n\n    function enter() {\n      if (!chronological.length) {\n        showBanner(\"no timeline events; run `entire understand build` against a repo with checkpoints\");\n        return;\n      }\n      active = true;\n      btn.classList.add(\"active\");\n      bar.classList.remove(\"hidden\");\n      slider.min = 0;\n      slider.max = chronological.length - 1;\n      slider.value = chronological.length - 1;\n      total.textContent = chronological.length + \" events\";\n      apply(chronological.length - 1);\n    }\n