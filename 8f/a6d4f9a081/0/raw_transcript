, \"timeline.json\"} {\n\t\tpath := filepath.Join(cacheDir, name)\n\t\tif _, err := os.Stat(path); err != nil {\n\t\t\tt.Errorf(\"expected artifact %s missing: %v\", name, err)\n\t\t}\n\t}\n\n\t// 2. Status (JSON form is the stable contract for downstream tools)\n\tstatusOut := env.RunCLI(\"understand\", \"status\", \"--json\")\n\tvar status struct {\n\t\tPresent  bool `json:\"present\"`\n\t\tManifest struct {\n\t\t\tBuildID            string   `json:\"build_id\"`\n\t\t\tStructuralStatus   string   `json:\"structural_status\"`\n\t\t\tHistoryStatus      string   `json:\"history_status\"`\n\t\t\tSemanticStatus     string   `json:\"semantic_status\"`\n\t\t\tSupportedLanguages []string `json:\"supported_languages\"`\n\t\t\tNodeCount          int      `json:\"node_count\"`\n\t\t} `json:\"manifest\"`\n\t}\n\tif err := json.Unmarshal([]byte(statusOut), &status); err != nil {\n\t\tt.Fatalf(\"status JSON: %v\\nraw=%s\", err, statusOut)\n\t}\n\tif !status.Present {\n\t\tt.Fatalf(\"status.Present=false; want true\")\n\t}\n\tif status.Manifest.StructuralStatus != \"ok\" {\n\t\tt.Errorf(\"structural status=%q; want ok\", status.Manifest.StructuralStatus)\n\t}\n\tif status.Manifest.SemanticStatus != \"skipped\" {\n\t\tt.Errorf(\"semantic status=%q; want skipped\", status.Manifest.SemanticStatus)\n\t}\n\thasGo := false\n\tfor _, l := range status.Manifest.SupportedLanguages {\n\t\tif l == \"go\" {\n\t\t\thasGo = true\n\t\t}\n\t}\n\tif !hasGo {\n\t\tt.Errorf(\"SupportedLanguages=%v; want go\", status.Manifest.SupportedLanguages)\n\t}\n\tif status.Manifest.NodeCount == 0 {\n\t\tt.Errorf(\"NodeCount=0; want >0\")\n\t}\n\n\t// 3. Explain a known file\n\texplainOut := env.RunCLI(\"understand\", \"explain\", \"cmd/main.go\", \"--json\")\n\tvar explain struct {\n\t\tNode *struct {\n\t\t\tID       string `json:\"id\"`\n\t\t\tType     string `json:\"type\"`\n\t\t\tPath     string `json:\"path\"`\n\t\t\tLanguage string `json:\"language\"`\n\t\t} `json:\"node\"`\n\t\tChildren []struct {\n\t\