ckage needs. It is\n// structurally compatible with agent.TextGenerator so callers can pass an\n// agent directly without an adapter.\ntype TextGenerator interface {\n\tGenerateText(ctx context.Context, prompt string, model string) (string, error)\n}\n\n// SchemaValidator returns nil when the payload is acceptable. Implementations\n// typically json.Unmarshal into a typed struct then assert invariants.\ntype SchemaValidator func(payload []byte) error\n\n// SynthesisRequest is one prompt + validator unit.\ntype SynthesisRequest struct {\n\t// Prompt is the full prompt sent on the first attempt.\n\tPrompt string\n\t// StrictReminder is appended (after a newline) on the second attempt.\n\t// Empty string yields the default reminder.\n\tStrictReminder string\n\t// Validator is required; nil validators are rejected.\n\tValidator SchemaValidator\n\t// Label is used for log lines and error messages. Free-form, short.\n\tLabel string\n}\n\n// SynthesisResult is the structured outcome of one Synthesize call.\ntype SynthesisResult struct {\n\t// Payload is the raw response bytes after stripping any fenced code block.\n\t// Non-nil on success and after first-attempt-failure-then-retry success.\n\tPayload []byte\n\t// Attempts counts how many times the generator was invoked (1 or 2).\n\tAttempts int\n\t// FellBack is true when both attempts failed and the caller should\n\t// degrade to deterministic-only output for this shard.\n\tFellBack bool\n\t// LastError is the last error encountered during attempts, if any.\n\tLastError error\n}\n\n// Synthesizer applies the policy layer to a TextGenerator.\ntype Synthesizer struct {\n\tGenerator TextGenerator\n\tModel     string\n\tTimeout   time.Duration\n\t// Logger is optional; nil means no-op.\n\tLogger Logger\n}\n\n// Synthesize runs req.Prompt under a bounded context. On schema-validation\n// or parse failure it retries once with the strict reminder appended. After\n// the second failure it returns a result with FellBack=true; the caller is\n// responsible for emitting deterministic-only output for that shard.\n//\n// On context cancellation/timeout it returns the underlying ctx error wrapped.\nfunc (s *Synthesizer) Synthesize(ctx context.Context, req SynthesisRequest) (*SynthesisResult, error) {\n\tif s == nil || s.Generator == nil {\n\t\treturn nil, errors.New(\"semantic: nil Synthesizer or Generator\")\n\t}\n\tif req.Validator == nil {\n\t\treturn nil, errors.New(\"semantic: SynthesisRequest.Validator is required\")\n\t}\n\ttimeout := s.Timeout\n\tif timeout <= 0 {\n\t\ttimeout = DefaultTimeout\n\t}\n\n\tprompt := req.Prompt\n\tres := &SynthesisResult{}\n\n\tfor attempt := 1; attempt <= 2; attempt++ {\n\t\tcallCtx, cancel := context.WithTimeout(ctx, timeout)\n\t\traw, err := s.Generator.GenerateText(callCtx, prompt, s.Model)\n\t\tcancel()\n\t\tres.Attempts = attempt\n\t\tres.LastError = err\n\n\t\tif err != nil {\n\t\t\t// Cancellation/timeout from the parent ctx is terminal.\n\t\t\tif ctxErr := ctx.Err(); ctxErr != nil {\n\t\t\t\treturn res, fmt.Errorf(\"semantic %s: %w\", req.Label, ctxErr)\n\t\t\t}\n\t\t\t// On timeout for this attempt the result is treated as a failed\n\t\t\t// attempt — fall through to retry, which gets a fresh deadline.\n\t\t\ts.logf(\"warn\", \"semantic generator failed\", \"label\", req.Label, \"attempt\", attempt, \"error\", err.Error())\n\t\t} else {\n\t\t\tpayload := stripCodeFence(raw)\n\t\t\tif vErr := req.Validator([]byte(payload)); vErr == nil {\n\t\t\t\tres.Payload = []byte(payload)\n\t\t\t\tres.LastError = nil\n\t\t\t\treturn res, nil\n\t\t\t} else {\n\t\t\t\tres.LastError = vErr\n\t\t\t\ts.logf(\"warn\", \"semantic schema validation failed\", \"label\", req.Label, \"attempt\", attempt, \"error\", vErr.Error())\n\t\t\t}\n\t\t}\n\n\t\t// Build retry prompt.\n\t\tif attempt == 1 {\n\t\t\tprompt = applyStrictReminder(req.Prompt, req.StrictReminder, res.LastError)\n\t\t}\n\t}\n\n\tres.FellBack = true\n\ts.logf(\"info\", \"semantic shard fell back to deterministic\", \"label\", req.Label, \"last_error\", errString(res.LastError))\n\treturn res, nil\n}\n\n// applyStrictReminder builds the retry prompt: original prompt followed by a\n// blank line, the reminder, and a brief note about the previous error. Errors\n// surfaced to the model are validation failures only — the model never sees\n// the underlying TextGenerator error since that may include path or env data.\nfunc applyStrictReminder(original, reminder string, lastErr error) string {\n\tif reminder == \"\" {\n\t\treminder = \"Your previous response could not be parsed. Reply with valid JSON only — no prose, no markdown fences, no leading text.\"\n\t}\n\tout := original + \"\\n\\n\" + reminder\n\tvar v *validationFeedback\n\tif errors.As(lastErr, &v) && v.Hint != \"\" {\n\t\tout += \"\\n\\nValidation hint: \" + v.Hint\n\t}\n\treturn out\n}\n\n// stripCodeFence removes a single leading ```json / ``` fence and its trailing\n// ``` if present. Models routinely wrap JSON in fences despite \"no prose\"\n// instructions; one cheap strip pass avoids burning the retry budget on that.\nfunc stripCodeFence(s string) string {\n\tt := strings.TrimSpace(s)\n\tif !strings.HasPrefix(t, \"```\") {\n\t\treturn t\n\t}\n\t// Drop the opening fence line.\n\tif i := strings.Index(t, \"\\n\"); i >= 0 {\n\t\tt = t[i+1:]\n\t} else {\n\t\treturn t\n\t}\n\t// Drop a trailing ``` if present.\n\tt = strings.TrimSpace(t)\n\tt = strings.TrimSuffix(t, \"```\")\n\treturn strings.TrimSpace(t)\n}\n\n// ValidationFeedback returns a SchemaValidator-compatible error type that lets\n// callers attach a human-readable hint surfaced back to the model on retry.\n// Use it for \"missing field X\" / \"expected array of objects\" cases where one\n// short sentence reliably fixes the next attempt.\ntype validationFeedback struct {\n\tErr  error\n\tHint string\n}\n\nfunc (v *validationFeedback) Error() string {\n\tif v.Err == nil {\n\t\treturn v.Hint\n\t}\n\treturn v.Err.Error()\n}\n\n// NewValidationFeedback wraps an error with a model-facing hint.\nfunc NewValidationFeedback(err error, hint string) error {\n\treturn &validationFeedback{Err: err, Hint: hint}\n}\n\n// JSONValidator returns a SchemaValidator that checks the payload parses as\n// JSON and decodes into the provided template. The template should be a\n// pointer to a typed struct; typed-struct decode is a coarse but effective\n// shape check.\nfunc JSONValidator[T any](mk func() *T, invariants ...func(*T) error) SchemaValidator {\n\treturn func(payload []byte) error {\n\t\tptr := mk()\n\t\tif err := json.Unmarshal(payload, ptr); err != nil {\n\t\t\treturn NewValidationFeedback(fmt.Errorf(\"json unmarshal: %w\", err), \"Output must be valid JSON.\")\n\t\t}\n\t\tfor _, inv := range invariants {\n\t\t\tif err := inv(ptr); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}\n}\n\nfunc errString(e error) string {\n\tif e == nil {\n\t\treturn \"\"\n\t}\n\treturn e.Error()\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"56189f62-6ef5-47f3-b93c-abadaa285ac6","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/collab-95042499-claude","sessionId":"e4e10c4f-00ee-43dc-a2f3-a62030c8c6eb","version":"2.1.128","gitBranch":"collab/95042499/claude","slug":"peaceful-splashing-dijkstra"}
