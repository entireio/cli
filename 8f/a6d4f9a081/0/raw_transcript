{"parentUuid":"f7a8b0c6-03a5-4b08-9617-6465dd3ff1c9","isSidechain":false,"promptId":"1cb6dcb3-5d0b-4da2-b4b7-4289becd2655","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EhsDvSb15R1ScdtRKCYa8w","type":"tool_result","content":"520\t//\t│   └── content_hash.txt\n521\t//\t├── 2/                    # Second session\n522\t//\t└── 3/                    # Third session...\n523\t//\n524\t//nolint:revive // Named CheckpointSummary to avoid conflict with existing Summary struct\n525\ttype CheckpointSummary struct {\n526\t\tCLIVersion          string              `json:\"cli_version,omitempty\"`\n527\t\tCheckpointID        id.CheckpointID     `json:\"checkpoint_id\"`\n528\t\tStrategy            string              `json:\"strategy\"`\n529\t\tBranch              string              `json:\"branch,omitempty\"`\n530\t\tCheckpointsCount    int                 `json:\"checkpoints_count\"`\n531\t\tFilesTouched        []string            `json:\"files_touched\"`\n532\t\tSessions            []SessionFilePaths  `json:\"sessions\"`\n533\t\tTokenUsage          *agent.TokenUsage   `json:\"token_usage,omitempty\"`\n534\t\tCombinedAttribution *InitialAttribution `json:\"combined_attribution,omitempty\"`\n535\t}\n536\t\n537\t// SessionMetrics contains hook-provided session metrics from agents that report\n538\t// them via lifecycle hooks (e.g., Cursor). These supplement transcript-derived\n539\t// metrics for agents whose transcripts lack usage/timing data.\n540\ttype SessionMetrics struct {\n541\t\tDurationMs        int64 `json:\"duration_ms,omitempty\"`\n542\t\tTurnCount         int   `json:\"turn_count,omitempty\"`\n543\t\tContextTokens     int   `json:\"context_tokens,omitempty\"`\n544\t\tContextWindowSize int   `json:\"context_window_size,omitempty\"`\n545\t}\n546\t\n547\t// Summary contains AI-generated summary of a checkpoint.\n548\ttype Summary struct {\n549\t\tIntent    string           `json:\"intent\"`     // What user wanted to accomplish\n550\t\tOutcom