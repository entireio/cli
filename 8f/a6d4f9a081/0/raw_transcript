otstrapped with the token via a server-injected\n// <script>window.__entireUnderstandToken=...</script> tag so the JS never\n// needs to read it from a URL or a cookie.\npackage dashboard\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t_ \"embed\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"html\"\n\t\"net\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/understand/graph\"\n)\n\n//go:embed assets/index.html\nvar indexHTML string\n\n// Server is the loopback dashboard. Construct via New and start with Start.\ntype Server struct {\n\tstore     *graph.Store\n\tlistener  net.Listener\n\tserver    *http.Server\n\ttoken     string\n\taddr      string\n\tstartedAt time.Time\n\tserveErr  error\n}\n\n// New builds an unstarted server bound to the given store.\nfunc New(store *graph.Store) (*Server, error) {\n\tif store == nil {\n\t\treturn nil, errors.New(\"dashboard: nil store\")\n\t}\n\ttok, err := mintToken()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Server{store: store, token: tok}, nil\n}\n\n// Start binds the listener on 127.0.0.1:<port>, registers handlers, and runs\n// the server in the background. Returns the chosen URL (with /).\nfunc (s *Server) Start(ctx context.Context) (string, error) {\n\tvar lc net.ListenConfig\n\tln, err := lc.Listen(ctx, \"tcp\", \"127.0.0.1:0\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"dashboard: listen: %w\", err)\n\t}\n\ts.listener = ln\n\ts.addr = ln.Addr().String()\n\n\tmux := http.NewServeMux()\n\ts.RegisterHandlers(mux)\n\n\ts.server = &http.Server{\n\t\tHandler:           mux,\n\t\tReadHeaderTimeout: 5 * time.Second,\n\t}\n\ts.startedAt = time.Now()\n\tgo func() {\n\t\t// Background loop: Serve only returns ErrServerClosed in the normal\n\t\t// shutdown path; any other error here means the listener died and\n\t\t// the caller will discover that on the next request.\n\t\tif err := s.server.Serve(ln); err != nil && !errors.Is(err, http.ErrServerClosed) {\n\t\t\ts.serveErr = err\n\t\t}\n\t}()\n\n\treturn \"http://\" + s.addr + \"/\", nil\n}\n\n// Stop shuts the server down with a 2-second drain.\nfunc (s *Server) Stop() error {\n\tif s.server == nil {\n\t\treturn nil\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n\tdefer cancel()\n\tif err := s.server.Shutdown(ctx); err != nil {\n\t\treturn fmt.Errorf(\"dashboard: shutdown: %w\", err)\n\t}\n\treturn nil\n}\n\n// Token returns the per-launch bearer token. Surfaced for the CLI command's\n// banner and for tests.\nfunc (s *Server) Token() string { return s.token }\n\n// Addr returns the bound 127.0.0.1:<port> string. Empty until Start is called.\nfunc (s *Server) Addr() string { return s.addr }\n\n// RegisterHandlers wires the read-only endpoints onto a mux. Exposed so tests\n// can drive the server with httptest.NewRecorder + http.Handler directly.\nfunc (s *Server) RegisterHandlers(mux *http.ServeMux) {\n\tmux.HandleFunc(\"/\", s.serveIndex)\n\tmux.HandleFunc(\"/api/manifest\", s.requireToken(s.handleManifest))\n\tmux.HandleFunc(\"/api/graph\", s.requireToken(s.handleGraph))\n\tmux.HandleFunc(\"/api/timeline\", s.requireToken(s.handleTimeline))\n\tmux.HandleFunc(\"/api/hotspots\", s.requireToken(s.handleHotspots))\n\tmux.HandleFunc(\"/api/checkpoint/\", s.requireToken(s.handleCheckpointStub))\n}\n\n// requireToken wraps a handler so each request must present the per-launch\n// bearer token. Bypasses the index page so the bootstrap HTML can load.\nfunc (s *Server) requireToken(next http.HandlerFunc) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tif r.Method != http.MethodGet {\n\t\t\thttp.Error(w, \"method not allowed\", http.StatusMethodNotAllowed)\n\t\t\treturn\n\t\t}\n\t\tauth := r.Header.Get(\"Authorization\")\n\t\tif !strings.HasPrefix(auth, \"Bearer \") {\n\t\t\thttp.Error(w, \"missing bearer token\", http.StatusUnauthorized)\n\t\t\treturn\n\t\t}\n\t\tgot := strings.TrimSpace(strings.TrimPrefix(auth, \"Bearer \"))\n\t\tif got != s.token {\n\t\t\thttp.Error(w, \"bad token\", http.StatusUnauthorized)\n\t\t\treturn\n\t\t}\n\t\tnext(w, r)\n\t}\n}\n\nfunc (s *Server) serveIndex(w http.ResponseWriter, r *http.Request) {\n\tif r.URL.Path != \"/\" {\n\t\thttp.NotFound(w, r)\n\t\treturn\n\t}\n\t// Inject the per-launch token into a script tag *before* the embedded\n\t// HTML. The token is rendered through html.EscapeString defensively even\n\t// though it's hex; this also documents the framing rule for future\n\t// maintainers (don't drop user-controlled values into bootstrap).\n\tbootstrap := \"<script>window.__entireUnderstandToken=\" +\n\t\t\"\\\"\" + html.EscapeString(s.token) + \"\\\";</script>\\n\"\n\tw.Header().Set(\"Content-Type\", \"text/html; charset=utf-8\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tif _, err := w.Write([]byte(bootstrap)); err != nil {\n\t\treturn\n\t}\n\tif _, err := w.Write([]byte(indexHTML)); err != nil {\n\t\treturn\n\t}\n}\n\nfunc (s *Server) handleManifest(w http.ResponseWriter, _ *http.Request) {\n\tm, err := s.store.ReadManifest()\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n\twriteJSON(w, m)\n}\n\nfunc (s *Server) handleGraph(w http.ResponseWriter, _ *http.Request) {\n\tfused, err := s.store.FusedGraph()\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n\twriteJSON(w, fused)\n}\n\nfunc (s *Server) handleTimeline(w http.ResponseWriter, _ *http.Request) {\n\ttl, err := s.store.ReadTimeline()\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n\twriteJSON(w, tl)\n}\n\n// HotspotShape is the JSON shape returned by /api/hotspots. Mirrors the\n// hotspot rows produced by `entire understand hotspots` so the dashboard\n// and CLI agree on the contract.\ntype HotspotShape struct {\n\tNodeID          string  `json:\"node_id\"`\n\tPath            string  `json:\"path\"`\n\tCheckpointCount int     `json:\"checkpoint_count\"`\n\tDistinctAgents  int     `json:\"distinct_agents\"`\n\tScore           float64 `json:\"score\"`\n}\n\nfunc (s *Server) handleHotspots(w http.ResponseWriter, _ *http.Request) {\n\tfused, err := s.store.FusedGraph()\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n\trows := computeHotspots(fused)\n\twriteJSON(w, map[string]any{\"hotspots\": rows})\n}\n\n// handleCheckpointStub returns a stable 404 for now. The intent — per the\n// spec — is to fetch prompt/transcript content on demand by checkpoint ID\n// only when the per-launch bearer token is present. The actual loader\n// requires the agent transcript path, which is out of scope for the v1\n// dashboard. Keeping the route registered (and gated by requireToken)\n// documents the contract and prevents accidental bulk exposure later.\nfunc (s *Server) handleCheckpointStub(w http.ResponseWriter, _ *http.Request) {\n\thttp.Error(w, \"checkpoint detail not yet exposed in v1; use `entire understand explain` from the CLI\", http.StatusNotFound)\n}\n\n// computeHotspots builds the same per-file score the CLI hotspots command\n// produces, in the same order. Lives here (rather than in package cli) so\n// the dashboard handler stays self-contained and testable without importing\n// cli into a server-side package.\nfunc computeHotspots(fused *graph.Slice) []HotspotShape {\n\tbyID := make(map[string]*graph.Node, len(fused.Nodes))\n\ttouchedCps := map[string][]string{}\n\tfor i := range fused.Nodes {\n\t\tbyID[fused.Nodes[i].ID] = &fused.Nodes[i]\n\t}\n\tfor _, e := range fused.Edges {\n\t\tif e.Type == graph.EdgeTouchedIn {\n\t\t\ttouchedCps[e.To] = append(touchedCps[e.To], e.From)\n\t\t}\n\t}\n\tout := []HotspotShape{}\n\tfor fileID, cps := range touchedCps {\n\t\tn := byID[fileID]\n\t\tif n == nil || n.Type != graph.NodeFile {\n\t\t\tcontinue\n\t\t}\n\t\tagents := map[string]struct{}{}\n\t\tfor _, cpID := range cps {\n\t\t\tcp := byID[cpID]\n\t\t\tif cp == nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif a, ok := cp.Attrs[\"agent\"].(string); ok && a != \"\" {\n\t\t\t\tagents[a] = struct{}{}\n\t\t\t}\n\t\t}\n\t\tout = append(out, HotspotShape{\n\t\t\tNodeID:          fileID,\n\t\t\tPath:            n.Path,\n\t\t\tCheckpointCount: len(cps),\n\t\t\tDistinctAgents:  len(agents),\n\t\t\tScore:           float64(len(cps)) + 0.5*float64(len(agents)),\n\t\t})\n\t}\n\t// Highest score first; tiebreak by path for determinism.\n\tfor i := 0; i < len(out); i++ {\n\t\tfor j := i + 1; j < len(out); j++ {\n\t\t\tif out[j].Score > out[i].Score || (out[j].Score == out[i].Score && out[j].Path < out[i].Path) {\n\t\t\t\tout[i], out[j] = out[j], out[i]\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}\n\nfunc writeJSON(w http.ResponseWriter, v any) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tenc := json.NewEncoder(w)\n\tenc.SetEscapeHTML(false)\n\tif err := enc.Encode(v); err != nil {\n\t\t// Headers are already flushed; the client will see a truncated\n\t\t// response but no panic. Surface for ops via the server log.\n\t\thttp.Error(w, \"encode failure\", http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc mintToken() (string, error) {\n\tvar b [16]byte\n\tif _, err := rand.Read(b[:]); err != nil {\n\t\treturn \"\", fmt.Errorf(\"dashboard: random token: %w\", err)\n\t}\n\treturn hex.EncodeToString(b[:]), nil\n}\n","structuredPatch":[{"oldStart":31,"oldLines":6,"newStart":31,"newLines":8,"lines":["   \"strings\"","   \"time\""," ","+  \"github.com/entireio/cli/cmd/entire/cli/checkpoint\"","+  \"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"","   \"github.com/entireio/cli/cmd/entire/cli/understand/graph\""," )"," "]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"85f3aab9-110a-4741-9a01-e