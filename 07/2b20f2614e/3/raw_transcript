g(\"checkpoint_id\", string(info.CheckpointID)),\n410\t\t\t\t\tslog.String(\"error\", taskErr.Error()),\n411\t\t\t\t)\n412\t\t\t} else {\n413\t\t\t\tfullCheckpoint.taskTrees = taskTrees\n414\t\t\t}\n415\t\t}\n416\t\n417\t\tif compactFailed {\n418\t\t\toutcome.compactTranscriptSkipped = true\n419\t\t\tlogging.Warn(ctx, \"compact transcript not generated during checkpoint migration\",\n420\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n421\t\t\t\tslog.Int(\"migrated_sessions\", migratedSessions),\n422\t\t\t)\n423\t\t}\n424\t\tif skippedMissingSessions > 0 {\n425\t\t\tlogging.Warn(ctx, \"checkpoint migration skipped v1 sessions with missing transcript/session content\",\n426\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n427\t\t\t\tslog.Int(\"missing_sessions\", skippedMissingSessions),\n428\t\t\t)\n429\t\t}\n430\t\n431\t\treturn fullCheckpoint, outcome, nil\n432\t}\n433\t\n434\t// generationPacker buffers up to batchSize migrated checkpoints and flushes\n435\t// them into a single archived /full/<n> ref each time the buffer fills, so\n436\t// peak heap stays bounded by one batch worth of transcripts instead of\n437\t// growing with the total v1 list. The next generation number is resolved\n438\t// lazily on first flush so force-migration prune steps that remove existing\n439\t// archived refs are visible before we pick the next slot.\n440\ttype generationPacker struct {\n441\t\trepo           *git.Repository\n442\t\tv2Store        *checkpoint.V2GitStore\n443\t\tbatchSize      int\n444\t\tnextGeneration int\n445\t\tnumbered       bool\n446\t\tpending        []migratedFullCheckpoint\n447\t\tflushed        bool\n448\t\t// writtenRefs records every /full/<n> ref this packer creates so the\n449\t\t// caller can exclude them from the generation-metadata repair pass.\n450\t\twrittenRefs []plumbing.ReferenceName\n451\t}\n452\t\n453\tfunc newGenerationPacker(repo *git.Repository, v2Store *checkpoint.V2GitStore) *generationPacker {\n454\t\tbatchSize := migrateMaxCheckpointsPerGeneration\n455\t\tif batchSize <= 0 {\n456\t\t\tbatchSize = checkpoint.DefaultMaxCheckpointsPerGeneration\n457\t\t}\n458\t\treturn &generationPacker{\n459\t\t\trepo:      repo,\n460\t\t\tv2Store:   v2Store,\n461\t\t\tbatchSize: batchSize,\n462\t\t}\n463\t}\n464\t\n465\tfunc (p *generationPacker) add(ctx context.Context, cp migratedFullCheckpoint) error {\n466\t\tp.pending = append(p.pending, cp)\n467\t\tif len(p.pending) >= p.batchSize {\n468\t\t\treturn p.flush(ctx)\n469\t\t}\n470\t\treturn nil\n471\t}\n472\t\n473\tfunc (p *generationPacker) flush(ctx context.Context) error {\n474\t\tif len(p.pending) == 0 {\n475\t\t\treturn nil\n476\t\t}\n477\t\tif !p.numbered {\n478\t\t\tnext, err := p.v2Store.NextGenerationNumber()\n479\t\t\tif err != nil {\n480\t\t\t\treturn fmt.Errorf(\"list archived v2 generations: %w\", err)\n481\t\t\t}\n482\t\t\tp.nextGeneration = next\n483\t\t\tp.numbered = true\n484\t\t}\n485\t\trefName := plumbing.ReferenceName(fmt.Sprintf(\"%s%013d\", paths.V2FullRefPrefix, p.nextGeneration))\n486\t\tif err := writeMigratedFullGeneration(ctx, p.repo, refName, p.pending); err != nil {\n487\t\t\treturn err\n488\t\t}\n489\t\tp.writtenRefs = append(p.writtenRefs, refName)\n490\t\tp.nextGeneration++\n491\t\tp.pending = nil\n492\t\tp.flushed = true\n493\t\treturn nil\n494\t}\n495\t\n496\tfunc (p *generationPacker) finalize(ctx context.Context, ensureEmptyCurrent bool) error {\n497\t\tif err := p.flush(ctx); err != nil {\n498\t\t\treturn err\n499\t\t}\n500\t\tif p.flushed && ensureEmptyCurrent {\n501\t\t\treturn ensureEmptyV2FullCurrent(ctx, p.repo)\n502\t\t}\n503\t\treturn nil\n504\t}\n505\t\n506\tfunc writeMigratedFullGeneration(ctx context.Context, repo *git.Repository, refName plumbing.ReferenceName, checkpoints []migratedFullCheckpoint) error {\n507\t\tentries := make(map[string]object.TreeEntry)\n508\t\n509\t\tfor _, cp := range checkpoints {\n510\t\t\tfor _, session := range cp.sessions {\n511\t\t\t\tif err := writeMigratedFullSessionEntries(ctx, repo, cp, session, entries); err != nil {\n512\t\t\t\t\treturn fmt.Errorf(\"write full session entries for checkpoint %s session %d: %w\", cp.checkpointID, session.sessionIndex, err)\n513\t\t\t\t}\n514\t\t\t}\n515\t\t}\n516\t\n517\t\ttreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, entries)\n518\t\tif err != nil {\n519\t\t\treturn fmt.Errorf(\"build migrated generation tree: %w\", err)\n520\t\t}\n521\t\n522\t\tv2Store := checkpoint.NewV2GitStore(repo, migrateRemoteName)\n523\t\t// Reuse the transcripts already in memory rather than walking the tree\n524\t\t// we just built — same first/last-event range, no redundant blob reads.\n525\t\tgen, found := checkpoint.AggregateTranscriptTimestamps(migratedTranscripts(checkpoints))\n526\t\tif !found {\n527\t\t\tvar err error\n528\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n529\t\t\tif err != nil {\n530\t\t\t\treturn fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n531\t\t\t}\n532\t\t}\n533\t\tif !found {\n534\t\t\tgen, found = generationMetadataFromMigratedSessions(checkpoints)\n535\t\t}\n536\t\tif !found {\n537\t\t\treturn fmt.Errorf(\"no timestamps found for migrated generation %s\", refName)\n538\t\t}\n539\t\n540\t\ttreeHash, err = v2Store.AddGenerationJSONToTree(treeHash, gen)\n541\t\tif err != nil {\n542\t\t\treturn fmt.Errorf(\"add generation metadata: %w\", err)\n543\t\t}\n544\t\n545\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, treeHash, plumbing.ZeroHash,\n546\t\t\tfmt.Sprintf(\"Archive migrated generation: %s\\n\", refName),\n547\t\t\tmigrateAuthorName, migrateAuthorEmail)\n548\t\tif err != nil {\n549\t\t\treturn fmt.Errorf(\"create migrated generation commit: %w\", err)\n550\t\t}\n551\t\n552\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n553\t\t\treturn fmt.Errorf(\"update migrated generation ref %s: %w\", refName, err)\n554\t\t}\n555\t\treturn nil\n556\t}\n557\t\n558\tfunc migratedTranscripts(checkpoints []migratedFullCheckpoint) [][]byte {\n559\t\tvar transcripts [][]byte\n560\t\tfor _, cp := range checkpoints {\n561\t\t\tfor _, session := range cp.sessions {\n562\t\t\t\tif len(session.content.Transcript) == 0 {\n563\t\t\t\t\tcontinue\n564\t\t\t\t}\n565\t\t\t\ttranscripts = append(transcripts, session.content.Transcript)\n566\t\t\t}\n567\t\t}\n568\t\treturn transcripts\n569\t}\n570\t\n571\tfunc generationMetadataFromMigratedSessions(checkpoints []migratedFullCheckpoint) (checkpoint.GenerationMetadata, bool) {\n572\t\tvar gen checkpoint.GenerationMetadata\n573\t\tfound := false\n574\t\tfor _, cp := range checkpoints {\n575\t\t\tfor _, session := range cp.sessions {\n576\t\t\t\tcheckpoint.MergeGenerationTime(&gen, &found, session.content.Metadata.CreatedAt)\n577\t\t\t}\n578\t\t}\n579\t\treturn gen, found\n580\t}\n581\t\n582\tfunc writeMigratedFullSessionEntries(ctx context.Context, repo *git.Repository, cp migratedFullCheckpoint, session migratedFullSession, entries map[string]object.TreeEntry) error {\n583\t\tsessionPath := fmt.Sprintf(\"%s/%d/\", cp.checkpointID.Path(), session.sessionIndex)\n584\t\ttranscript := session.content.Transcript\n585\t\n586\t\tchunks, err := agent.ChunkTranscript(ctx, transcript, session.content.Metadata.Agent)\n587\t\tif err != nil {\n588\t\t\treturn fmt.Errorf(\"chunk transcript: %w\", err)\n589\t\t}\n590\t\tfor i, chunk := range chunks {\n591\t\t\tblobHash, blobErr := checkpoint.CreateBlobFromContent(repo, chunk)\n592\t\t\tif blobErr != nil {\n593\t\t\t\treturn fmt.Errorf(\"create transcript blob: %w\", blobErr)\n594\t\t\t}\n595\t\t\tpath := sessionPath + agent.ChunkFileName(paths.V2RawTranscriptFileName, i)\n596\t\t\tentries[path] = object.TreeEntry{\n597\t\t\t\tName: path,\n598\t\t\t\tMode: filemode.Regular,\n599\t\t\t\tHash: blobHash,\n600\t\t\t}\n601\t\t}\n602\t\n603\t\thashPath := sessionPath + paths.V2RawTranscriptHashFileName\n604\t\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n605\t\thashBlob, err := checkpoint.CreateBlobFromContent(repo, []byte(contentHash))\n606\t\tif err != nil {\n607\t\t\treturn fmt.Errorf(\"create transcript hash blob: %w\", err)\n608\t\t}\n609\t\tentries[hashPath] = object.TreeEntry{\n610\t\t\tName: hashPath,\n611\t\t\tMode: filemode.Regular,\n612\t\t\tHash: hashBlob,\n613\t\t}\n614\t\n615\t\tfor _, taskTreeHash := range cp.taskTrees[session.sessionIndex] {\n616\t\t\ttaskTree, treeErr := repo.TreeObject(taskTreeHash)\n617\t\t\tif treeErr != nil {\n618\t\t\t\treturn fmt.Errorf(\"read task metadata tree: %w\", treeErr)\n619\t\t\t}\n620\t\t\ttaskEntries := make(map[string]object.TreeEntry)\n621\t\t\tif flattenErr := checkpoint.FlattenTree(repo, taskTree, sessionPath+\"tasks\", taskEntries); flattenErr != nil {\n622\t\t\t\treturn fmt.Errorf(\"flatten task metadata tree: %w\", flattenErr)\n623\t\t\t}\n624\t\t\tfor path, entry := range taskEntries {\n625\t\t\t\tif _, exists := entries[path]; exists {\n626\t\t\t\t\tcontinue\n627\t\t\t\t}\n628\t\t\t\tentries[path] = entry\n629\t\t\t}\n630\t\t}\n631\t\n632\t\treturn nil\n633\t}\n634\t\n635\tfunc ensureEmptyV2FullCurrent(ctx context.Context, repo *git.Repository) error {\n636\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n637\t\tif _, err := repo.Reference(refName, true); err == nil {\n638\t\t\treturn nil\n639\t\t}\n640\t\n641\t\temptyTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, map[string]object.TreeEntry{})\n642\t\tif err != nil {\n643\t\t\treturn fmt.Errorf(\"build empty v2 full/current tree: %w\", err)\n644\t\t}\n645\t\n646\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, emptyTreeHash, plumbing.ZeroHash,\n647\t\t\t\"Start generation\\n\",\n648\t\t\tmigrateAuthorName, migrateAuthorEmail)\n649\t\tif err != nil {\n650\t\t\treturn fmt.Errorf(\"create empty v2 full/current commit: %w\", err)\n651\t\t}\n652\t\n653\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n654\t\t\treturn fmt.Errorf(\"update %s: %w\", refName, err)\n655\t\t}\n656\t\treturn nil\n657\t}\n658\t\n659\tfunc readV1SessionForMigration(ctx context.Context, v1Store *checkpoint.GitStore, checkpointID id.CheckpointID, sessionIdx int) (*checkpoint.SessionContent, bool, error) {\n660\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, checkpointID, sessionIdx)\n661\t\tif readErr != nil {\n662\t\t\tif errors.Is(readErr, checkpoint.ErrNoTranscript) || errors.Is(readErr, checkpoint.ErrCheckpointNotFound) {\n663\t\t\t\twarnMissingV1Session(ctx, checkpointID, sessionIdx, readErr)\n664\t\t\t\treturn nil, true, nil\n665\t\t\t}\n666\t\t\treturn nil, false, fmt.Errorf(\"read v1 session content: %w\", readErr)\n667\t\t}\n668\t\treturn content, false, nil\n669\t}\n670\t\n671\tfunc warnMissingV1Session(ctx context.Context, checkpointID id.CheckpointID, sessionIdx int, err error) {\n672\t\tlogging.Warn(ctx, \"skipping v1 session with missing transcript during checkpoint migration\",\n673\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n674\t\t\tslog.Int(\"session_index\", sessionIdx),\n675\t\t\tslog.String(\"error\", err.Error()),\n676\t\t)\n677\t}\n678\t\n679\tfunc pruneV2CheckpointForForce(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID) error {\n680\t\tfor _, refName := range []plumbing.ReferenceName{\n681\t\t\tplumbing.ReferenceName(paths.V2MainRefName),\n682\t\t\tplumbing.ReferenceName(paths.V2FullCurrentRefName),\n683\t\t} {\n684\t\t\tif err := pruneV2CheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n685\t\t\t\treturn err\n686\t\t\t}\n687\t\t}\n688\t\n689\t\tarchived, err := v2Store.ListArchivedGenerations()\n690\t\tif err != nil {\n691\t\t\treturn fmt.Errorf(\"failed to list archived v2 generations while pruning checkpoint %s: %w\", cpID, err)\n692\t\t}\n693\t\tfor _, generation := range archived {\n694\t\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + generation)\n695\t\t\tif err := pruneV2ArchivedCheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n696\t\t\t\treturn err\n697\t\t\t}\n698\t\t}\n699\t\n700\t\treturn nil\n701\t}\n702\t\n703\tfunc pruneV2CheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n704\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n705\t\tif err != nil {\n706\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n707\t\t\t\treturn nil\n708\t\t\t}\n709\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n710\t\t}\n711\t\n712\t\trootTree, err := repo.TreeObject(rootTreeHash)\n713\t\tif err != nil {\n714\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n715\t\t}\n716\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n717\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n718\t\t}\n719\t\n720\t\tshardPrefix := string(cpID[:2])\n721\t\tshardSuffix := string(cpID[2:])\n722\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n723\t\tif err != nil {\n724\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n725\t\t}\n726\t\tif newRoot == rootTreeHash {\n727\t\t\treturn nil\n728\t\t}\n729\t\n730\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n731\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n732\t\t\tmigrateAuthorName, migrateAuthorEmail)\n733\t\tif err != nil {\n734\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n735\t\t}\n736\t\n737\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n738\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n739\t\t}\n740\t\treturn nil\n741\t}\n742\t\n743\tfunc pruneV2ArchivedCheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n744\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n745\t\tif err != nil {\n746\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n747\t\t\t\treturn nil\n748\t\t\t}\n749\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n750\t\t}\n751\t\n752\t\trootTree, err := repo.TreeObject(rootTreeHash)\n753\t\tif err != nil {\n754\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n755\t\t}\n756\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n757\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n758\t\t}\n759\t\n760\t\tshardPrefix := string(cpID[:2])\n761\t\tshardSuffix := string(cpID[2:])\n762\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n763\t\tif err != nil {\n764\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n765\t\t}\n766\t\tif newRoot == rootTreeHash {\n767\t\t\treturn nil\n768\t\t}\n769\t\n770\t\tcount, err := v2Store.CountCheckpointsInTree(newRoot)\n771\t\tif err != nil {\n772\t\t\treturn fmt.Errorf(\"failed to count checkpoints in pruned %s: %w\", refName, err)\n773\t\t}\n774\t\tif count == 0 {\n775\t\t\tif err := repo.Storer.RemoveReference(refName); err != nil {\n776\t\t\t\treturn fmt.Errorf(\"failed to remove empty archived v2 generation %s: %w\", refName, err)\n777\t\t\t}\n778\t\t\treturn nil\n779\t\t}\n780\t\n781\t\tnewRoot, err = addRecomputedGenerationJSON(v2Store, newRoot)\n782\t\tif err != nil {\n783\t\t\treturn fmt.Errorf(\"failed to recompute generation metadata for %s: %w\", refName, err)\n784\t\t}\n785\t\n786\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n787\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n788\t\t\tmigrateAuthorName, migrateAuthorEmail)\n789\t\tif err != nil {\n790\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n791\t\t}\n792\t\n793\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n794\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n795\t\t}\n796\t\treturn nil\n797\t}\n798\t\n799\tfunc addRecomputedGenerationJSON(v2Store *checkpoint.V2GitStore, treeHash plumbing.Hash) (plumbing.Hash, error) {\n800\t\tgen, found, err := v2Store.ComputeGenerationTimestampsFromTrees(treeHash, nil)\n801\t\tif err != nil {\n802\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute raw transcript timestamps: %w\", err)\n803\t\t}\n804\t\tif !found {\n805\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n806\t\t\tif err != nil {\n807\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n808\t\t\t}\n809\t\t}\n810\t\tif !found {\n811\t\t\treturn treeHash, nil\n812\t\t}\n813\t\n814\t\tnewTreeHash, err := v2Store.AddGenerationJSONToTree(treeHash, gen)\n815\t\tif err != nil {\n816\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"add generation metadata: %w\", err)\n817\t\t}\n818\t\treturn newTreeHash, nil\n819\t}\n820\t\n821\tfunc pruneCheckpointFromRoot(repo *git.Repository, rootTreeHash plumbing.Hash, shardPrefix, shardSuffix string) (plumbing.Hash, error) {\n822\t\tnewRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n823\t\t\t[]string{shardPrefix},\n824\t\t\tnil,\n825\t\t\tcheckpoint.UpdateSubtreeOptions{\n826\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n827\t\t\t\tDeleteNames: []string{shardSuffix},\n828\t\t\t},\n829\t\t)\n830\t\tif err != nil {\n831\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune checkpoint from shard: %w\", err)\n832\t\t}\n833\t\tif newRoot == rootTreeHash {\n834\t\t\treturn newRoot, nil\n835\t\t}\n836\t\n837\t\tnewRootTree, err := repo.TreeObject(newRoot)\n838\t\tif err != nil {\n839\t\t\treturn plumbing.ZeroHash, fmt.Errorf(