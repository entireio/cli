t\tPromptAttributionsJSON:      m.PromptAttributions,\n887\t\t\tCombinedAttribution:         combinedAttribution,\n888\t\t\tSummary:                     m.Summary,\n889\t\t\tCheckpointTranscriptStart:   m.GetTranscriptStart(),\n890\t\t\tTranscriptIdentifierAtStart: m.TranscriptIdentifierAtStart,\n891\t\t\tIsTask:                      m.IsTask,\n892\t\t\tToolUseID:                   m.ToolUseID,\n893\t\t\tAuthorName:                  migrateAuthorName,\n894\t\t\tAuthorEmail:                 migrateAuthorEmail,\n895\t\t}\n896\t}\n897\t\n898\tfunc tryCompactTranscript(ctx context.Context, transcript []byte, m checkpoint.CommittedMetadata) []byte {\n899\t\treturn compactTranscriptForStartLine(ctx, transcript, m, 0)\n900\t}\n901\t\n902\tfunc compactTranscriptForStartLine(ctx context.Context, transcript []byte, m checkpoint.CommittedMetadata, startLine int) []byte {\n903\t\tif len(transcript) == 0 {\n904\t\t\treturn nil\n905\t\t}\n906\t\tif m.Agent == \"\" {\n907\t\t\tlogging.Warn(ctx, \"compact transcript skipped: no agent type in checkpoint metadata\",\n908\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n909\t\t\t)\n910\t\t\treturn nil\n911\t\t}\n912\t\n913\t\tcompacted, err := compact.Compact(redact.AlreadyRedacted(transcript), compact.MetadataFields{\n914\t\t\tAgent:      string(m.Agent),\n915\t\t\tCLIVersion: versioninfo.Version,\n916\t\t\tStartLine:  startLine,\n917\t\t})\n918\t\tif err != nil {\n919\t\t\tlogging.Warn(ctx, \"compact transcript generation failed during migration\",\n920\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n921\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n922\t\t\t\tslog.String(\"error\", err.Error()),\n923\t\t\t)\n924\t\t\treturn nil\n925\t\t}\n926\t\tif len(compacted) == 0 {\n927\t\t\tlogging.Warn(ctx, \"transcript.jsonl generation produced no output\",\n928\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n929\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n930\t\t\t\tslog.Int(\"input_bytes\", len(transcript)),\n931\t\t\t)\n932\t\t\treturn nil\n933\t\t}\n934\t\treturn compacted\n935\t}\n936\t\n937\t// computeCompactOffset determines the transcript.jsonl line offset for a checkpoint\n938\t// by comparing a full compact (startLine=0) against the scoped compact. The difference\n939\t// is the number of compact lines before this checkpoint's data.\n940\tfunc computeCompactOffset(ctx context.Context, fullTranscript, fullCompact []byte, m checkpoint.CommittedMetadata) int {\n941\t\tstartLine := m.GetTranscriptStart()\n942\t\tif startLine == 0 || len(fullTranscript) == 0 || m.Agent == \"\" {\n943\t\t\treturn 0\n944\t\t}\n945\t\n946\t\tif len(fullCompact) == 0 {\n947\t\t\treturn 0\n948\t\t}\n949\t\n950\t\tscopedCompact, err := compact.Compact(redact.AlreadyRedacted(fullTranscript), compact.MetadataFields{\n951\t\t\tAgent:      string(m.Agent),\n952\t\t\tCLIVersion: versioninfo.Version,\n953\t\t\tStartLine:  startLine,\n954\t\t})\n955\t\tif err != nil {\n956\t\t\tlogging.Warn(ctx, \"compact transcript offset calculation failed during migration\",\n957\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n958\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n959\t\t\t\tslog.String(\"error\", err.Error()),\n960\t\t\t)\n961\t\t\treturn 0\n962\t\t}\n963\t\tif len(scopedCompact) == 0 {\n964\t\t\treturn 0\n965\t\t}\n966\t\n967\t\tfullLines := bytes.Count(fullCompact, []byte{'\\n'})\n968\t\tscopedLines := bytes.Count(scopedCompact, []byte{'\\n'})\n969\t\toffset := fullLines - scopedLines\n970\t\tif offset < 0 {\n971\t\t\tlogging.Warn(ctx, \"compact transcript offset was negative during migration, defaulting to 0\",\n972\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n973\t\t\t\tslog.Int(\"full_lines\", fullLines),\n974\t\t\t\tslog.Int(\"scoped_lines\", scopedLines),\n975\t\t\t)\n976\t\t\treturn 0\n977\t\t}\n978\t\treturn offset\n979\t}\n980\t\n981\tfunc collectTaskMetadataForMigratedFullGeneration(repo *git.Repository, cpID id.CheckpointID, summary *checkpoint.CheckpointSummary, v1ToV2SessionIdx map[int]int) (map[int][]plumbing.Hash, error) {\n982\t\trootTaskV2SessionIdx, attachRootTasks := latestMigratedV2SessionIndex(v1ToV2SessionIdx)\n983\t\treturn collectTaskMetadataForMigratedFullGenerationWithRootSession(repo, cpID, summary, v1ToV2SessionIdx, rootTaskV2SessionIdx, attachRootTasks)\n984\t}\n985\t\n986\tfunc collectTaskMetadataForMigratedFullGenerationWithRootSession(\n987\t\trepo *git.Repository,\n988\t\tcpID id.CheckpointID,\n989\t\tsummary *checkpoint.CheckpointSummary,\n990\t\tv1ToV2SessionIdx map[int]int,\n991\t\trootTaskV2SessionIdx int,\n992\t\tattachRootTasks bool,\n993\t) (map[int][]plumbing.Hash, error) {\n994\t\tv1Tree, err := resolveV1CheckpointTree(repo, cpID)\n995\t\tif err != nil {\n996\t\t\treturn nil, err\n997\t\t}\n998\t\n999\t\ttaskTrees := make(map[int][]plumbing.Hash)\n1000\t\n1001\t\t// Legacy v1 layout stores task metadata at checkpoint root: <cp>/tasks/<tool-use-id>/...\n1002\t\t// Prefer attaching this tree to the latest session in v2.\n1003\t\tif rootTasksTree, rootTasksErr := v1Tree.Tree(\"tasks\"); rootTasksErr == nil {\n1004\t\t\tif attachRootTasks {\n1005\t\t\t\ttaskTrees[rootTaskV2SessionIdx] = append(taskTrees[rootTaskV2SessionIdx], rootTasksTree.Hash)\n1006\t\t\t}\n1007\t\t}\n1008\t\n1009\t\tfor sessionIdx := range len(summary.Sessions) {\n1010\t\t\tsessionDir := strconv.Itoa(sessionIdx)\n1011\t\t\tsessionTree, sessionErr := v1Tree.Tree(sessionDir)\n1012\t\t\tif sessionErr != nil {\n1013\t\t\t\tcontinue\n1014\t\t\t}\n1015\t\n1016\t\t\ttasksTree, tasksErr := sessionTree.Tree(\"tasks\")\n1017\t\t\tif tasksErr != nil {\n1018\t\t\t\tcontinue\n1019\t\t\t}\n1020\t\n1021\t\t\tv2SessionIdx, ok := v1ToV2SessionIdx[sessionIdx]\n1022\t\t\tif !ok {\n1023\t\t\t\tcontinue\n1024\t\t\t}\n1025\t\t\ttaskTrees[v2SessionIdx] = append(taskTrees[v2SessionIdx], tasksTree.Hash)\n1026\t\t}\n1027\t\n1028\t\treturn taskTrees, nil\n1029\t}\n1030\t\n1031\tfunc latestMigratedV2SessionIndex(v1ToV2SessionIdx map[int]int) (int, bool) {\n1032\t\tlatest := -1\n1033\t\tfor _, v2SessionIdx := range v1ToV2SessionIdx {\n1034\t\t\tif v2SessionIdx > latest {\n1035\t\t\t\tlatest = v2SessionIdx\n1036\t\t\t}\n1037\t\t}\n1038\t\tif latest < 0 {\n1039\t\t\treturn -1, false\n1040\t\t}\n1041\t\treturn latest, true\n1042\t}\n1043\t\n1044\tfunc resolveV1CheckpointTree(repo *git.Repository, cpID id.CheckpointID) (*object.Tree, error) {\n1045\t\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n1046\t\tref, err := repo.Reference(refName, true)\n1047\t\tif err != nil {\n1048\t\t\t// Try remote tracking branch\n1049\t\t\tremoteRefName := plumbing.NewRemoteReferenceName(migrateRemoteName, paths.MetadataBranchName)\n1050\t\t\tref, err = repo.Reference(remoteRefName, true)\n1051\t\t\tif err != nil {\n1052\t\t\t\treturn nil, fmt.Errorf(\"v1 branch not found: %w\", err)\n1053\t\t\t}\n1054\t\t}\n1055\t\n1056\t\tcommit, err := repo.CommitObject(ref.Hash())\n1057\t\tif err != nil {\n1058\t\t\treturn nil, fmt.Errorf(\"failed to get v1 commit: %w\", err)\n1059\t\t}\n1060\t\n1061\t\trootTree, err := commit.Tree()\n1062\t\tif err != nil {\n1063\t\t\treturn nil, fmt.Errorf(\"failed to get v1 tree: %w\", err)\n1064\t\t}\n1065\t\n1066\t\tcpTree, err := rootTree.Tree(cpID.Path())\n1067\t\tif err != nil {\n1068\t\t\treturn nil, fmt.Errorf(\"checkpoint %s not found in v1 tree: %w\", cpID, err)\n1069\t\t}\n1070\t\n1071\t\treturn cpTree, nil\n1072\t}\n1073\t\n1074\t// collectMissingFullCheckpointForPacking returns a migratedFullCheckpoint\n1075\t// scoped to the sessions that lack /full/* artifacts on this v2 checkpoint,\n1076\t// reading their content from v1 so the caller can hand it to the same\n1077\t// generationPacker fresh migrations use. Returns errAlreadyMigrated when\n1078\t// every session is already packed.\n1079\tfunc collectMissingFullCheckpointForPacking(\n1080\t\tctx context.Context,\n1081\t\trepo *git.Repository,\n1082\t\tv1Store *checkpoint.GitStore,\n1083\t\t