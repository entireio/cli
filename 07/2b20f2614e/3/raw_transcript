nts it as skipped.\n321\t\t\tfullCheckpoint, err := collectMissingFullCheckpointForPacking(ctx, repo, v1Store, v2Store, info, existing, fullArtifacts)\n322\t\t\tif err != nil && !errors.Is(err, errAlreadyMigrated) {\n323\t\t\t\treturn nil, outcome, err\n324\t\t\t}\n325\t\t\tbackfilled, backfillErr := backfillCompactTranscripts(ctx, v1Store, v2Store, info, existing)\n326\t\t\tif errors.Is(backfillErr, errTranscriptNotGeneratable) {\n327\t\t\t\toutcome.compactTranscriptSkipped = true\n328\t\t\t} else if backfillErr != nil && !errors.Is(backfillErr, errAlreadyMigrated) {\n329\t\t\t\treturn nil, outcome, backfillErr\n330\t\t\t}\n331\t\t\tif fullCheckpoint == nil {\n332\t\t\t\tif backfilled > 0 {\n333\t\t\t\t\treturn nil, outcome, nil\n334\t\t\t\t}\n335\t\t\t\treturn nil, outcome, errAlreadyMigrated\n336\t\t\t}\n337\t\t\treturn fullCheckpoint, outcome, nil\n338\t\t}\n339\t\n340\t\tif existing != nil && force {\n341\t\t\tif pruneErr := pruneV2CheckpointForForce(ctx, repo, v2Store, info.CheckpointID); pruneErr != nil {\n342\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to reset existing v2 checkpoint %s before force migration: %w\", info.CheckpointID, pruneErr)\n343\t\t\t}\n344\t\t}\n345\t\n346\t\tsummary, err := v1Store.ReadCommitted(ctx, info.CheckpointID)\n347\t\tif err != nil {\n348\t\t\treturn nil, outcome, fmt.Errorf(\"failed to read v1 summary: %w\", err)\n349\t\t}\n350\t\tif summary == nil {\n351\t\t\treturn nil, outcome, fmt.Errorf(\"v1 checkpoint %s has no summary\", info.CheckpointID)\n352\t\t}\n353\t\n354\t\tcompactFailed := false\n355\t\tshouldCopyTaskMetadata := false\n356\t\tskippedMissingSessions := 0\n357\t\tmigratedSessions := 0\n358\t\tv1ToV2SessionIdx := make(map[int]int, len(summary.Sessions))\n359\t\tfullCheckpoint := &migratedFullCheckpoint{\n360\t\t\tcheckpointID: info.CheckpointID,\n361\t\t}\n362\t\n363\t\tfor sessionIdx := range len(summary.Sessions) {\n364\t\t\tcontent, skipped, readErr := readV1SessionForMigration(ctx, v1Store, info.Checkpoint