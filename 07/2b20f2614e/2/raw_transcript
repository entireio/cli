on.sessionIndex,\n1130\t\t\t\tcontent:      v1Session.content,\n1131\t\t\t})\n1132\t\t\tv1ToV2SessionIdx[v1Session.sessionIndex] = missingSession.sessionIndex\n1133\t\t}\n1134\t\n1135\t\tlatestV2SessionIdx := len(v2Summary.Sessions) - 1\n1136\t\ttaskTrees, taskErr := collectTaskMetadataForMigratedFullGenerationWithRootSession(\n1137\t\t\trepo,\n1138\t\t\tinfo.CheckpointID,\n1139\t\t\tv1Summary,\n1140\t\t\tv1ToV2SessionIdx,\n1141\t\t\tlatestV2SessionIdx,\n1142\t\t\tlatestV2SessionIdx >= 0,\n1143\t\t)\n1144\t\tif taskErr != nil {\n1145\t\t\treturn nil, fmt.Errorf(\"failed to collect task metadata while resuming migration: %w\", taskErr)\n1146\t\t}\n1147\t\tfullCheckpoint.taskTrees = taskTrees\n1148\t\n1149\t\treturn fullCheckpoint, nil\n1150\t}\n1151\t\n1152\ttype missingFullSessionForPacking struct {\n1153\t\tsessionIndex int\n1154\t\tsessionID    string\n1155\t}\n1156\t\n1157\ttype v1SessionForPacking struct {\n1158\t\tsessionIndex int\n1159\t\tcontent      *checkpoint.SessionContent\n1160\t}\n1161\t\n1162\tfunc collectMissingFullSessionsForPacking(\n1163\t\tctx context.Context,\n1164\t\tv2Store *checkpoint.V2GitStore,\n1165\t\tcheckpointID id.CheckpointID,\n1166\t\tsummary *checkpoint.CheckpointSummary,\n1167\t\tfullArtifacts checkpoint.FullSessionArtifactsIndex,\n1168\t) ([]missingFullSessionForPacking, error) {\n1169\t\tmissingSessions := make([]missingFullSessionForPacking, 0)\n1170\t\tfor sessionIdx := range len(summary.Sessions) {\n1171\t\t\t// Production passes a pre-built index; nil falls back to the per-call\n1172\t\t\t// predicate for tests that exercise this helper directly.\n1173\t\t\tvar ok bool\n1174\t\t\tif fullArtifacts != nil {\n1175\t\t\t\tok = fullArtifacts.Has(checkpointID, sessionIdx)\n1176\t\t\t} else {\n1177\t\t\t\tvar checkErr error\n1178\t\t\t\tok, checkErr = v2Store.HasFullSessionArtifacts(checkpointID, sessionIdx)\n1179\t\t\t\tif checkErr != nil {\n1180\t\t\t\t\treturn nil, fmt.Errorf(\"failed to check v2 session %d artifacts: %w\", sessio