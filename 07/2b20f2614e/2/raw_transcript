roduced no output\",\n933\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n934\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n935\t\t\t\tslog.Int(\"input_bytes\", len(transcript)),\n936\t\t\t)\n937\t\t\treturn nil\n938\t\t}\n939\t\treturn compacted\n940\t}\n941\t\n942\t// computeCompactOffset determines the transcript.jsonl line offset for a checkpoint\n943\t// by comparing a full compact (startLine=0) against the scoped compact. The difference\n944\t// is the number of compact lines before this checkpoint's data.\n945\tfunc computeCompactOffset(ctx context.Context, fullTranscript, fullCompact []byte, m checkpoint.CommittedMetadata) int {\n946\t\tstartLine := m.GetTranscriptStart()\n947\t\tif startLine == 0 || len(fullTranscript) == 0 || m.Agent == \"\" {\n948\t\t\treturn 0\n949\t\t}\n950\t\n951\t\tif len(fullCompact) == 0 {\n952\t\t\treturn 0\n953\t\t}\n954\t\n955\t\tscopedCompact, err := compact.Compact(redact.AlreadyRedacted(fullTranscript), compact.MetadataFields{\n956\t\t\tAgent:      string(m.Agent),\n957\t\t\tCLIVersion: versioninfo.Version,\n958\t\t\tStartLine:  startLine,\n959\t\t})\n960\t\tif err != nil {\n961\t\t\tlogging.Warn(ctx, \"compact transcript offset calculation failed during migration\",\n962\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n963\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n964\t\t\t\tslog.String(\"error\", err.Error()),\n965\t\t\t)\n966\t\t\treturn 0\n967\t\t}\n968\t\tif len(scopedCompact) == 0 {\n969\t\t\treturn 0\n970\t\t}\n971\t\n972\t\tfullLines := bytes.Count(fullCompact, []byte{'\\n'})\n973\t\tscopedLines := bytes.Count(scopedCompact, []byte{'\\n'})\n974\t\toffset := fullLines - scopedLines\n975\t\tif offset < 0 {\n976\t\t\tlogging.Warn(ctx, \"compact transcript offset was negative during migration, defaulting to 0\",\n977\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n978\t\t\t\tslog.Int(\"full_lines\", fullLines),\n979\t\t\t\tslog.Int(\"scoped_lines\", scopedLines),\n980\t\t\t)\n981\t\t\treturn 0\n982\t\t}\n983\t\treturn offset\n984\t}\n985\t\n986\tfunc collectTaskMetadataForMigratedFullGeneration(repo *git.Repository, cpID id.CheckpointID, summary *checkpoint.CheckpointSummary, v1ToV2SessionIdx map[int]int) (map[int][]plumbing.Hash, error) {\n987\t\trootTaskV2SessionIdx, attachRootTasks := latestMigratedV2SessionIndex(v1ToV2SessionIdx)\n988\t\treturn collectTaskMetadataForMigratedFullGenerationWithRootSession(repo, cpID, summary, v1ToV2SessionIdx, rootTaskV2SessionIdx, attachRootTasks)\n989\t}\n990\t\n991\tfunc collectTaskMetadataForMigratedFullGenerationWithRootSession(\n992\t\trepo *git.Repository,\n993\t\tcpID id.CheckpointID,\n994\t\tsummary *checkpoint.CheckpointSummary,\n995\t\tv1ToV2SessionIdx map[int]int,\n996\t\trootTaskV2SessionIdx int,\n997\t\tattachRootTasks bool,\n998\t) (map[int][]plumbing.Hash, error) {\n999\t\tv1Tree, err := resolveV1CheckpointTree(repo, cpID)\n1000\t\tif err != nil {\n1001\t\t\treturn nil, err\n1002\t\t}\n1003\t\n1004\t\ttaskTrees := make(map[int][]plumbing.Hash)\n1005\t\n1006\t\t// Legacy v1 layout stores task metadata at checkpoint root: <cp>/tasks/<tool-use-id>/...\n1007\t\t// Prefer attaching this tree to the latest session in v2.\n1008\t\tif rootTasksTree, rootTasksErr := v1Tree.Tree(\"tasks\"); rootTasksErr == nil {\n1009\t\t\tif attachRootTasks {\n1010\t\t\t\ttaskTrees[rootTaskV2SessionIdx] = append(taskTrees[rootTaskV2SessionIdx], rootTasksTree.Hash)\n1011\t\t\t}\n1012\t\t}\n1013\t\n1014\t\tfor sessionIdx := range len(summary.Sessions) {\n1015\t\t\tsessionDir := strconv.Itoa(sessionIdx)\n1016\t\t\tsessionTree, sessionErr := v1Tree.Tree(sessionDir)\n1017\t\t\tif sessionErr != nil {\n1018\t\t\t\tcontinue\n1019\t\t\t}\n1020\t\n1021\t\t\ttasksTree, tasksErr := sessionTree.Tree(\"tasks\")\n1022\t\t\tif tasksErr != nil {\n1023\t\t\t\tcontinue\n1024\t\t\t}\n1025\t\n1026\t\t\tv2SessionIdx, ok := v1ToV2SessionIdx[sessionIdx]\n1027\t\t\tif !ok {\n1028\t\t\t\tcontinue\n1029\t\t\t}\n1030\t\t\ttaskTrees[v2SessionIdx] = append(taskTrees[v2SessionIdx], tasksTree.Hash)\n1031\t\t}\n1032\t\n1033\t\treturn taskTrees, nil\n1034\t}\n1035\t\n1036\tfunc latestMigratedV2SessionIndex(v1ToV2SessionIdx map[int]int) (int, bool) {\n1037\t\tlatest := -1\n1038\t\tfor _, v2SessionIdx := range v1ToV2SessionIdx {\n1039\t\t\tif v2SessionIdx > latest {\n1040\t\t\t\tlatest = v2SessionIdx\n1041\t\t\t}\n1042\t\t}\n1043\t\tif latest < 0 {\n1044\t\t\treturn -1, false\n1045\t\t}\n1046\t\treturn latest, true\n1047\t}\n1048\t\n1049\tfunc resolveV1CheckpointTree(repo *git.Repository, cpID id.CheckpointID) (*object.Tree, error) {\n1050\t\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n1051\t\tref, err := repo.Reference(refName, true)\n1052\t\tif err != nil {\n1053\t\t\t// Try remote tracking branch\n1054\t\t\tremoteRefName := plumbing.NewRemoteReferenceName(migrateRemoteName, paths.MetadataBranchName)\n1055\t\t\tref, err = repo.Reference(remoteRefName, true)\n1056\t\t\tif err != nil {\n1057\t\t\t\treturn nil, fmt.Errorf(\"v1 branch not found: %w\", err)\n1058\t\t\t}\n1059\t\t}\n1060\t\n1061\t\tcommit, err := repo.CommitObject(ref.Hash())\n1062\t\tif err != nil {\n1063\t\t\treturn nil, fmt.Errorf(\"failed to get v1 commit: %w\", err)\n1064\t\t}\n1065\t\n1066\t\trootTree, err := commit.Tree()\n1067\t\tif err != nil {\n1068\t\t\treturn nil, fmt.Errorf(\"failed to get v1 tree: %w\", err)\n1069\t\t}\n1070\t\n1071\t\tcpTree, err := rootTree.Tree(cpID.Path())\n1072\t\tif err != nil {\n1073\t\t\treturn nil, fmt.Errorf(\"checkpoint %s not found in v1 tree: %w\", cpID, err)\n1074\t\t}\n1075\t\n1076\t\treturn cpTree, nil\n1077\t}\n1078\t\n1079\t// collectMissingFullCheckpointForPacking returns a migratedFullCheckpoint\n1080\t// scoped to the sessions that lack /full/* artifacts on this v2 checkpoint,\n1081\t// reading their content from v1 so the caller can hand it to the same\n1082\t// generationPacker fresh migrations use. Returns errAlreadyMigrated when\n1083\t// every session is