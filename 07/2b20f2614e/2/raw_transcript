o, info.CheckpointID, summary, v1ToV2SessionIdx)\n412\t\t\tif taskErr != nil {\n413\t\t\t\tlogging.Warn(ctx, \"failed to copy task metadata to v2\",\n414\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n415\t\t\t\t\tslog.String(\"error\", taskErr.Error()),\n416\t\t\t\t)\n417\t\t\t} else {\n418\t\t\t\tfullCheckpoint.taskTrees = taskTrees\n419\t\t\t}\n420\t\t}\n421\t\n422\t\tif compactFailed {\n423\t\t\toutcome.compactTranscriptSkipped = true\n424\t\t\tlogging.Warn(ctx, \"compact transcript not generated during checkpoint migration\",\n425\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n426\t\t\t\tslog.Int(\"migrated_sessions\", migratedSessions),\n427\t\t\t)\n428\t\t}\n429\t\tif skippedMissingSessions > 0 {\n430\t\t\tlogging.Warn(ctx, \"checkpoint migration skipped v1 sessions with missing transcript/session content\",\n431\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n432\t\t\t\tslog.Int(\"missing_sessions\", skippedMissingSessions),\n433\t\t\t)\n434\t\t}\n435\t\n436\t\treturn fullCheckpoint, outcome, nil\n437\t}\n438\t\n439\t// generationPacker buffers up to batchSize migrated checkpoints and flushes\n440\t// them into a single archived /full/<n> ref each time the buffer fills, so\n441\t// peak heap stays bounded by one batch worth of transcripts instead of\n442\t// growing with the total v1 list. The next generation number is resolved\n443\t// lazily on first flush so force-migration prune steps that remove existing\n444\t// archived refs are visible before we pick the next slot.\n445\ttype generationPacker struct {\n446\t\trepo           *git.Repository\n447\t\tv2Store        *checkpoint.V2GitStore\n448\t\tbatchSize      int\n449\t\tnextGeneration int\n450\t\tnumbered       bool\n451\t\tpending        []migratedFullCheckpoint\n452\t\tflushed        bool\n453\t\t// writtenRefs records every /full/<n> ref this packer creates so the\n454\t\t// caller can exclude them from the generation-metadata repair pass.\n455\t\twrittenRefs []plumbing.ReferenceName\n456\t}\n457\t\n458\tfunc newGenerationPacker(repo *git.Repository, v2Store *checkpoint.V2GitStore) *generationPacker {\n459\t\tbatchSize := migrateMaxCheckpointsPerGeneration\n460\t\tif batchSize <= 0 {\n461\t\t\tbatchSize = checkpoint.DefaultMaxCheckpointsPerGeneration\n462\t\t}\n463\t\treturn &generationPacker{\n464\t\t\trepo:      repo,\n465\t\t\tv2Store:   v2Store,\n466\t\t\tbatchSize: batchSize,\n467\t\t}\n468\t}\n469\t\n470\tfunc (p *generationPacker) add(ctx context.Context, cp migratedFullCheckpoint) error {\n471\t\tp.pending = append(p.pending, cp)\n472\t\tif len(p.pending) >= p.batchSize {\n473\t\t\treturn p.flush(ctx)\n474\t\t}\n475\t\treturn nil\n476\t}\n477\t\n478\tfunc (p *generationPacker) flush(ctx context.Context) error {\n479\t\tif len(p.pending) == 0 {\n480\t\t\treturn nil\n481\t\t}\n482\t\tif !p.numbered {\n483\t\t\tnext, err := p.v2Store.NextGenerationNumber()\n484\t\t\tif err != nil {\n485\t\t\t\treturn fmt.Errorf(\"list archived v2 generations: %w\", err)\n486\t\t\t}\n487\t\t\tp.nextGeneration = next\n488\t\t\tp.numbered = true\n489\t\t}\n490\t\trefName := plumbing.ReferenceName(fmt.Sprintf(\"%s%013d\", paths.V2FullRefPrefix, p.nextGeneration))\n491\t\tif err := writeMigratedFullGeneration(ctx, p.repo, refName, p.pending); err != nil {\n492\t\t\treturn err\n493\t\t}\n494\t\tp.writtenRefs = append(p.writtenRefs, refName)\n495\t\tp.nextGeneration++\n496\t\tp.pending = nil\n497\t\tp.flushed = true\n498\t\treturn nil\n499\t}\n500\t\n501\tfunc (p *generationPacker) finalize(ctx context.Context, ensureEmptyCurrent bool) error {\n502\t\tif err := p.flush(ctx); err != nil {\n503\t\t\treturn err\n504\t\t}\n505\t\tif p.flushed && ensureEmptyCurrent {\n506\t\t\treturn ensureEmptyV2FullCurrent(ctx, p.repo)\n507\t\t}\n508\t\treturn nil\n509\t}\n510\t\n511\tfunc writeMigratedFullGeneration(ctx context.Context, repo *git.Repository, refName plumbing.ReferenceName, checkpoints []migratedFullCheckpoint) error {\n512\t\tentries := make(map[string]object.TreeEntry)\n513\t\n514\t\tfor _, cp := range checkpoints {\n515\t\t\tfor _, session := range cp.sessions {\n516\t\t\t\tif err := writeMigratedFullSessionEntries(ctx, repo, cp, session, entries); err != nil {\n517\t\t\t\t\treturn fmt.Errorf(\"write full session entries for checkpoint %s session %d: %w\", cp.checkpointID, session.sessionIndex, err)\n518\t\t\t\t}\n519\t\t\t}\n520\t\t}\n521\t\n522\t\ttreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, entries)\n523\t\tif err != nil {\n524\t\t\treturn fmt.Errorf(\"build migrated generation tree: %w\", err)\n525\t\t}\n526\t\n527\t\tv2Store := checkpoint.NewV2GitStore(repo, migrateRemoteName)\n528\t\t// Reuse the transcripts already in memory rather than walking the tree\n529\t\t// we just built — same first/last-event range, no redundant blob reads.\n530\t\tgen, found := checkpoint.AggregateTranscriptTimestamps(migratedTranscripts(checkpoints))\n531\t\tif !found {\n532\t\t\tvar err error\n533\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n534\t\t\tif err != nil {\n535\t\t\t\treturn fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n536\t\t\t}\n537\t\t}\n538\t\tif !found {\n539\t\t\tgen, found = generationMetadataFromMigratedSessions(checkpoints)\n540\t\t}\n541\t\tif !found {\n542\t\t\treturn fmt.Errorf(\"no timestamps found for migrated generation %s\", refName)\n543\t\t}\n544\t\n545\t\ttreeHash, err = v2Store.AddGenerationJSONToTree(treeHash, gen)\n546\t\tif err != nil {\n547\t\t\treturn fmt.Errorf(\"add generation metadata: %w\", err)\n548\t\t}\n549\t\n550\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, treeHash, plumbing.ZeroHash,\n551\t\t\tfmt.Sprintf(\"Archive migrated generation: %s\\n\", refName),\n552\t\t\tmigrateAuthorName, migrateAuthorEmail)\n553\t\tif err != nil {\n554\t\t\treturn fmt.Errorf(\"create migrated generation commit: %w\", err)\n555\t\t}\n556\t\n557\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n558\t\t\treturn fmt.Errorf(\"update migrated generation ref %s: %w\", refName, err)\n559\t\t}\n560\t\treturn nil\n561\t}\n562\t\n563\tfunc migratedTranscripts(checkpoints []migratedFullCheckpoint) [][]byte {\n564\t\tvar transcripts [][]byte\n565\t\tfor _, cp := range checkpoints {\n566\t\t\tfor _, session := range cp.sessions {\n567\t\t\t\tif len(session.content.Transcript) == 0 {\n568\t\t\t\t\tcontinue\n569\t\t\t\t}\n570\t\t\t\ttranscripts = append(transcripts, session.content.Transcript)\n571\t\t\t}\n572\t\t}\n573\t\treturn transcripts\n574\t}\n575\t\n576\tfunc generationMetadataFromMigratedSessions(checkpoints []migratedFullCheckpoint) (checkpoint.GenerationMetadata, bool) {\n577\t\tvar gen checkpoint.GenerationMetadata\n578\t\tfound := false\n579\t\tfor _, cp := range checkpoints {\n580\t\t\tfor _, session := range cp.sessions {\n581\t\t\t\tcheckpoint.MergeGenerationTime(&gen, &found, session.content.Metadata.CreatedAt)\n582\t\t\t}\n583\t\t}\n584\t\treturn gen, found\n585\t}\n586\t\n587\tfunc writeMigratedFullSessionEntries(ctx context.Context, repo *git.Repository, cp migratedFullCheckpoint, session migratedFullSession, entries map[string]object.TreeEntry) error {\n588\t\tsessionPath := fmt.Sprintf(\"%s/%d/\", cp.checkpointID.Path(), session.sessionIndex)\n589\t\ttranscript := session.content.Transcript\n590\t\n591\t\tchunks, err := agent.ChunkTranscript(ctx, transcript, session.content.Metadata.Agent)\n592\t\tif err != nil {\n593\t\t\treturn fmt.Errorf(\"chunk transcript: %w\", err)\n594\t\t}\n595\t\tfor i, chunk := range chunks {\n596\t\t\tblobHash, blobErr := checkpoint.CreateBlobFromContent(repo, chunk)\n597\t\t\tif blobErr != nil {\n598\t\t\t\treturn fmt.Errorf(\"create transcript blob: %w\", blobErr)\n599\t\t\t}\n600\t\t\tpath := sessionPath + agent.ChunkFileName(paths.V2RawTranscriptFileName, i)\n601\t\t\tentries[path] = object.TreeEntry{\n602\t\t\t\tName: path,\n603\t\t\t\tMode: filemode.Regular,\n604\t\t\t\tHash: blobHash,\n605\t\t\t}\n606\t\t}\n607\t\n608\t\thashPath := sessionPath + paths.V2RawTranscriptHashFileName\n609\t\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n610\t\thashBlob, err := checkpoint.CreateBlobFromContent(repo, []byte(contentHash))\n611\t\tif err != nil {\n612\t\t\treturn fmt.Errorf(\"create transcript hash blob: %w\", err)\n613\t\t}\n614\t\tentries[hashPath] = object.TreeEntry{\n615\t\t\tName: hashPath,\n616\t\t\tMode: filemode.Regular,\n617\t\t\tHash: hashBlob,\n618\t\t}\n619\t\n620\t\tfor _, taskTreeHash := range cp.taskTrees[session.sessionIndex] {\n621\t\t\ttaskTree, treeErr := repo.TreeObject(taskTreeHash)\n622\t\t\tif treeErr != nil {\n623\t\t\t\treturn fmt.Errorf(\"read task metadata tree: %w\", treeErr)\n624\t\t\t}\n625\t\t\ttaskEntries := make(map[string]object.TreeEntry)\n626\t\t\tif flattenErr := checkpoint.FlattenTree(repo, taskTree, sessionPath+\"tasks\", taskEntries); flattenErr != nil {\n627\t\t\t\treturn fmt.Errorf(\"flatten task metadata tree: %w\", flattenErr)\n628\t\t\t}\n629\t\t\tfor path, entry := range taskEntries {\n630\t\t\t\tif _, exists := entries[path]; exists {\n631\t\t\t\t\tcontinue\n632\t\t\t\t}\n633\t\t\t\tentries[path] = entry\n634\t\t\t}\n635\t\t}\n636\t\n637\t\treturn nil\n638\t}\n639\t\n640\tfunc ensureEmptyV2FullCurrent(ctx context.Context, repo *git.Repository) error {\n641\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n642\t\tif _, err := repo.Reference(refName, true); err == nil {\n643\t\t\treturn nil\n644\t\t}\n645\t\n646\t\temptyTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, map[string]object.TreeEntry{})\n647\t\tif err != nil {\n648\t\t\treturn fmt.Errorf(\"build empty v2 full/current tree: %w\", err)\n649\t\t}\n650\t\n651\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, emptyTreeHash, plumbing.ZeroHash,\n652\t\t\t\"Start generation\\n\",\n653\t\t\tmigrateAuthorName, migrateAuthorEmail)\n654\t\tif err != nil {\n655\t\t\treturn fmt.Errorf(\"create empty v2 full/current commit: %w\", err)\n656\t\t}\n657\t\n658\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n659\t\t\treturn fmt.Errorf(\"update %s: %w\", refName, err)\n660\t\t}\n661\t\treturn nil\n662\t}\n663\t\n664\tfunc readV1SessionForMigration(ctx context.Context, v1Store *checkpoint.GitStore, checkpointID id.CheckpointID, sessionIdx int) (*checkpoint.SessionContent, bool, error) {\n665\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, checkpointID, sessionIdx)\n666\t\tif readErr != nil {\n667\t\t\tif errors.Is(readErr, checkpoint.ErrNoTranscript) || errors.Is(readErr, checkpoint.ErrCheckpointNotFound) {\n668\t\t\t\twarnMissingV1Session(ctx, checkpointID, sessionIdx, readErr)\n669\t\t\t\treturn nil, true, nil\n670\t\t\t}\n671\t\t\treturn nil, false, fmt.Errorf(\"read v1 session content: %w\", readErr)\n672\t\t}\n673\t\treturn content, false, nil\n674\t}\n675\t\n676\tfunc warnMissingV1Session(ctx context.Context, checkpointID id.CheckpointID, sessionIdx int, err error) {\n677\t\tlogging.Warn(ctx, \"skipping v1 session with missing transcript during checkpoint migration\",\n678\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n679\t\t\tslog.Int(\"session_index\", sessionIdx),\n680\t\t\tslog.String(\"error\", err.Error()),\n681\t\t)\n682\t}\n683\t\n684\tfunc pruneV2CheckpointForForce(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID) error {\n685\t\tfor _, refName := range []plumbing.ReferenceName{\n686\t\t\tplumbing.ReferenceName(paths.V2MainRefName),\n687\t\t\tplumbing.ReferenceName(paths.V2FullCurrentRefName),\n688\t\t} {\n689\t\t\tif err := pruneV2CheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n690\t\t\t\treturn err\n691\t\t\t}\n692\t\t}\n693\t\n694\t\tarchived, err := v2Store.ListArchivedGenerations()\n695\t\tif err != nil {\n696\t\t\treturn fmt.Errorf(\"failed to list archived v2 generations while pruning checkpoint %s: %w\", cpID, err)\n697\t\t}\n698\t\tfor _, generation := range archived {\n699\t\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + generation)\n700\t\t\tif err := pruneV2ArchivedCheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n701\t\t\t\treturn err\n702\t\t\t}\n703\t\t}\n704\t\n705\t\treturn nil\n706\t}\n707\t\n708\tfunc pruneV2CheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n709\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n710\t\tif err != nil {\n711\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n712\t\t\t\treturn nil\n713\t\t\t}\n714\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n715\t\t}\n716\t\n717\t\trootTree, err := repo.TreeObject(rootTreeHash)\n718\t\tif err != nil {\n719\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n720\t\t}\n721\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n722\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n723\t\t}\n724\t\n725\t\tshardPrefix := string(cpID[:2])\n726\t\tshardSuffix := string(cpID[2:])\n727\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n728\t\tif err != nil {\n729\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n730\t\t}\n731\t\tif newRoot == rootTreeHash {\n732\t\t\treturn nil\n733\t\t}\n734\t\n735\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n736\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n737\t\t\tmigrateAuthorName, migrateAuthorEmail)\n738\t\tif err != nil {\n739\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n740\t\t}\n741\t\n742\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n743\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n744\t\t}\n745\t\treturn nil\n746\t}\n747\t\n748\tfunc pruneV2ArchivedCheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n749\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n750\t\tif err != nil {\n751\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n752\t\t\t\treturn nil\n753\t\t\t}\n754\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n755\t\t}\n756\t\n757\t\trootTree, err := repo.TreeObject(rootTreeHash)\n758\t\tif err != nil {\n759\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n760\t\t}\n761\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n762\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n763\t\t}\n764\t\n765\t\tshardPrefix := string(cpID[:2])\n766\t\tshardSuffix := string(cpID[2:])\n767\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n768\t\tif err != nil {\n769\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n770\t\t}\n771\t\tif newRoot == rootTreeHash {\n772\t\t\treturn nil\n773\t\t}\n774\t\n775\t\tcount, err := v2Store.CountCheckpointsInTree(newRoot)\n776\t\tif err != nil {\n777\t\t\treturn fmt.Errorf(\"failed to count checkpoints in pruned %s: %w\", refName, err)\n778\t\t}\n779\t\tif count == 0 {\n780\t\t\tif err := repo.Storer.RemoveReference(refName); err != nil {\n781\t\t\t\treturn fmt.Errorf(\"failed to remove empty archived v2 generation %s: %w\", refName, err)\n782\t\t\t}\n783\t\t\treturn nil\n784\t\t}\n785\t\n786\t\tnewRoot, err = addRecomputedGenerationJSON(v2Store, newRoot)\n787\t\tif err != nil {\n788\t\t\treturn fmt.Errorf(\"failed to recompute generation metadata for %s: %w\", refName, err)\n789\t\t}\n790\t\n791\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n792\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n793\t\t\tmigrateAuthorName, migrateAuthorEmail)\n794\t\tif err != nil {\n795\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n796\t\t}\n797\t\n798\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n799\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n800\t\t}\n801\t\treturn nil\n802\t}\n803\t\n804\tfunc addRecomputedGenerationJSON(v2Store *checkpoint.V2GitStore, treeHash plumbing.Hash) (plumbing.Hash, error) {\n805\t\tgen, found, err := v2Store.ComputeGenerationTimestampsFromTrees(treeHash, nil)\n806\t\tif err != nil {\n807\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute raw transcript timestamps: %w\", err)\n808\t\t}\n809\t\tif !found {\n810\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n811\t\t\tif err != nil {\n812\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n813\t\t\t}\n814\t\t}\n815\t\tif !found {\n816\t\t\treturn treeHash, nil\n817\t\t}\n818\t\n819\t\tnewTreeHash, err := v2Store.AddGenerationJSONToTree(treeHash, gen)\n820\t\tif err != nil {\n821\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"add generation metadata: %w\", err)\n822\t\t}\n823\t\treturn newTreeHash, nil\n824\t}\n825\t\n826\tfunc pruneCheckpointFromRoot(repo *git.Repository, rootTreeHash plumbing.Hash, shardPrefix, shardSuffix string) (plumbing.Hash, error) {\n827\t\tnewRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n828\t\t\t[]string{shardPrefix},\n829\t\t\tnil,\n830\t\t\tcheckpoint.UpdateSubtreeOptions{\n831\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n832\t\t\t\tDeleteNames: []string{shardSuffix},\n833\t\t\t},\n834\t\t)\n835\t\tif err != nil {\n836\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune checkpoint from shard: %w\", err)\n837\t\t}\n838\t\tif newRoot == rootTreeHash {\n839\t\t\treturn newRoot, nil\n840\t\t}\n841\t\n842\t\tnewRootTree, err := repo.TreeObject(newRoot)\n843\t\tif err != nil {\n844\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to read pruned root tree: %w\", err)\n845\t\t}\n846\t\tshardTree, err := newRootTree.Tree(shardPrefix)\n847\t\tif err != nil {\n848\t\t\treturn newRoot, nil //nolint:nilerr // The shard prefix was already absent after pruning.\n849\t\t}\n850\t\tif len(shardTree.Entries) > 0 {\n851\t\t\treturn newRoot, nil\n852\t\t}\n853\t\n854\t\tprunedRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n855\t\t\tnil,\n856\t\t\tnil,\n857\t\t\tcheckpoint.UpdateSubtreeOptions{\n858\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n859\t\t\t\tDeleteNames: []string{shardPrefix},\n860\t\t\t},\n861\t\t)\n862\t\tif err != nil {\n863\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune empty shard prefix: %w\", err)\n864\t\t}\n865\t\treturn prunedRoot, nil\n866\t}\n867\t\n868\tfunc buildMigrateWriteOpts(content *checkpoint.SessionContent, info checkpoint.CommittedInfo, combinedAttribution *checkpoint.InitialAttribution) checkpoint.WriteCommittedOptions {\n869\t\tm := content.Metadata\n870\t\n871\t\tprompts := checkpoint.SplitPromptContent(content.Prompts)\n872\t\n873\t\treturn checkpoint.WriteCommittedOptions{\n874\t\t\tCheckpointID: info.CheckpointID,\n875\t\t\tSessionID:    m.SessionID,\n876\t\t\tCreatedAt:    m.CreatedAt,\n877\t\t\tStrategy:     m.Strategy,\n878\t\t\tBranch:       m.Branch,\n879\t\t\t// All transcripts read here come from persisted checkpoint storage,\n880\t\t\t// which is already redacted.\n881\t\t\tTranscript:                  redact.AlreadyRedacted(content.Transcript),\n882\t\t\tPrompts:                     prompts,\n883\t\t\tFilesTouched:                m.FilesTouched,\n884\t\t\tCheckpointsCount:            m.CheckpointsCount,\n885\t\t\tAgent:                       m.Agent,\n886\t\t\tModel:                       m.Model,\n887\t\t\tTurnID:                      m.TurnID,\n888\