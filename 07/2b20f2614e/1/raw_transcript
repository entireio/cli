 `git ls-remote` plus a transcript-blob walk per archived /full/<n>,\n100\t\t// minutes on big repos. When we did write archives, freshly-packed refs\n101\t\t// are excluded — their generation.json is already correct from\n102\t\t// AggregateTranscriptTimestamps in the packer.\n103\t\tvar repairResult *strategy.RepairV2GenerationMetadataResult\n104\t\tif len(freshlyPackedRefs) > 0 {\n105\t\t\tvar repairErr error\n106\t\t\trepairResult, repairErr = strategy.RepairV2GenerationMetadata(ctx, freshlyPackedRefs)\n107\t\t\tif repairErr != nil {\n108\t\t\t\treturn fmt.Errorf(\"failed to repair archived v2 generation metadata: %w\", repairErr)\n109\t\t\t}\n110\t\t\tprintV2GenerationRepairResult(out, cmd.ErrOrStderr(), repairResult)\n111\t\t}\n112\t\n113\t\tprintMigrateCompletion(out, result)\n114\t\tfmt.Fprintln(out, \"Note: V2 checkpoints are stored as custom refs under refs/entire/checkpoints/v2/*, not as a branch visible in the GitHub UI.\")\n115\t\tfmt.Fprintf(out, \"To inspect pushed v2 checkpoint refs locally, run: git ls-remote %s \\\"refs/entire/checkpoints/v2/*\\\"\\n\", migrateRemoteName)\n116\t\tfmt.Fprintln(out, `You may also open a checkpoint's details in the Entire web app and click the \"session logs\" link to view the log files and metadata.`)\n117\t\n118\t\tif result.failed > 0 {\n119\t\t\treturn NewSilentError(fmt.Errorf(\"%d checkpoint(s) failed to migrate\", result.failed))\n120\t\t}\n121\t\tif repairResult != nil && len(repairResult.Failed) > 0 {\n122\t\t\tfmt.Fprintf(out, \"%d archived generation(s) failed metadata repair. Check warnings above for details.\\n\", len(repairResult.Failed))\n123\t\t\treturn NewSilentError(fmt.Errorf(\"%d archived generation(s) failed metadata repair\", len(repairResult.Failed)))\n124\t\t}\n125\t\n126\t\treturn nil\n127\t}\n128\t\n129\tconst migrationLogFile = logging.LogsDir + \"/entire.log\"\n130\t\n131\tfunc printMigrateCompletion(out io.Writer, result *migrateResult) {\n132\t\tif result.total == 0 {\n133\t\t\tfmt.Fprintln(out, \"Nothing to migrate: no v1 checkpoints found\")\n134\t\t\tfmt.Fprintln(out)\n135\t\t\treturn\n136\t\t}\n137\t\n138\t\tfmt.Fprintf(out, \"Migration complete: %d migrated, %d skipped, %d failed\\n\",\n139\t\t\tresult.migrated, result.skipped, result.failed)\n140\t\n141\t\tif result.hasLoggedDetails() {\n142\t\t\tfmt.Fprintf(out, \"Details for skipped, missing, incomplete, or failed checkpoints were logged to %s.\\n\", migrationLogFile)\n143\t\t}\n144\t\n145\t\tfmt.Fprintln(out)\n146\t}\n147\t\n148\tfunc (r *migrateResult) hasLoggedDetails() bool {\n149\t\treturn r.skipped > 0 || r.failed > 0 || r.missingSessions > 0 || r.compactTranscriptSkipped > 0\n150\t}\n151\t\n152\tfunc printV2GenerationRepairResult(out, errOut io.Writer, result *strategy.RepairV2GenerationMetadataResult) {\n153\t\tif result == nil {\n154\t\t\treturn\n155\t\t}\n156\t\n157\t\tfor _, warning := range result.Warnings {\n158\t\t\tfmt.Fprintf(errOut, \"Warning: %s\\n\", warning)\n159\t\t}\n160\t\n161\t\tif len(result.Repaired) == 0 && len(result.Failed) == 0 {\n162\t\t\treturn\n163\t\t}\n164\t\n165\t\tfmt.Fprintf(out, \"Archived generation metadata repair: %d repaired, %d skipped, %d failed\\n\",\n166\t\t\tlen(result.Repaired), len(result.Skipped), len(result.Failed))\n167\t}\n168\t\n169\tvar (\n170\t\terrAlreadyMigrated          = errors.New(\"already migrated\")\n171\t\terrTranscriptNotGeneratable = errors.New(\"transcript.jsonl could not be generated\")\n172\t\terrNoMigratableSessions     = errors.New(\"no migratable v1 sessions\")\n173\t)\n174\t\n175\tconst (\n176\t\tmigrateRemoteName  = \"origin\"\n177\t\tmigrateAuthorName  = \"Entire Migration\"\n178\t\tmigrateAuthorEmail = \"migration@entire.dev\"\n179\t)\n180\t\n181\tvar migrateMaxCheckpointsPerGeneration = checkpoint.DefaultMaxCheckpointsPerGeneration\n182\t\n183\ttype migratedFullCheckpoint struct {\n184\t\tcheckpointID id.CheckpointID\n185\t\tsessions     []migratedFullSession\n186\t\ttaskTrees    map[int][]plumbing.Hash\n187\t}\n188\t\n189\ttype migratedFullSession struct {\n190\t\tsessionIndex int\n191\t\tcontent      *checkpoint.SessionContent\n192\t}\n193\t\n194\t// migrateCheckpointsV2 is the test entry point; it discards the\n195\t// freshly-packed refs list that production code uses to gate the repair pass.\n196\tfunc migrateCheckpointsV2(ctx context.Context, repo *git.Repository, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, progressOut io.Writer, force bool) (*migrateResult, error) {\n197\t\tresult, _, err := migrateCheckpointsV2Internal(ctx, repo, v1Store, v2Store, progressOut, force)\n198\t\treturn result, err\n199\t}\n200\t\n201\t// migrateCheckpointsV2Internal returns the /full/<n> refs the packer wrote so\n202\t// the caller can pass them as exclusions to the generation-metadata repair\n203\t// pass.\n204\tfunc migrateCheckpointsV2Internal(ctx context.Context, repo *git.Repository, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, progressOut io.Writer, force bool) (*migrateResult, []plumbing.ReferenceName, error) {\n205\t\tv1List, err := v1Store.ListCommitted(ctx)\n206\t\tif err != nil {\n207\t\t\treturn nil, nil, fmt.Errorf(\"failed to list v1 checkpoints: %w\", err)\n208\t\t}\n209\t\n210\t\tif len(v1List) == 0 {\n211\t\t\treturn &migrateResult{}, nil, nil\n212\t\t}\n213\t\n214\t\tsortMigratableCheckpoints(v1List)\n215\t\ttotal := len(v1List)\n216\t\tresult := &migrateResult{total: total}\n217\t\tprogress := startProgressBar(progressOut, \"Migrating checkpoints\", total)\n218\t\tdefer progress.Finish()\n219\t\n220\t\t_, fullCurrentRefErr := repo.Reference(plumbing.ReferenceName(paths.V2FullCurrentRefName), true)\n221\t\tfullCurrentExistsBefore := fullCurrentRefErr == nil\n222\t\n223\t\t// One up-front tree walk to make per-session \"are /full/* artifacts\n224\t\t// present?\" checks O(1) inside the migration loop.\n225\t\tfullArtifactsIndex, err := v2Store.BuildFullSessionArtifactsIndex()\n226\t\tif err != nil {\n227\t\t\treturn nil, nil, fmt.Errorf(\"build v2 /full/* presence index: %w\", err)\n228\t\t}\n229\t\n230\t\tpacker := newGenerationPacker(repo, v2Store)\n231\t\n232\t\tfor _, info := range v1List {\n233\t\t\tfullCheckpoint, outcome, migrateErr := migrateOneCheckpoint(ctx, repo, v1Store, v2Store, info, force, fullArtifactsIndex)\n234\t\t\tresult.missingSessions += outcome.missingSessions\n235\t\t\tif outcome.compactTranscriptSkipped {\n236\t\t\t\tresult.compactTranscriptSkipped++\n237\t\t\t}\n238\t\n239\t\t\tif migrateErr != nil {\n240\t\t\t\tswitch {\n241\t\t\t\tcase errors.Is(migrateErr, errAlreadyMigrated):\n242\t\t\t\t\tlogCheckpointMigrationSkip(ctx, info.CheckpointID, \"already in v2\", migrateErr)\n243\t\t\t\t\tresult.skipped++\n244\t\t\t\tcase errors.Is(migrateErr, errNoMigratableSessions):\n245\t\t\t\t\tlogCheckpointMigrationSkip(ctx, info.CheckpointID, \"no migratable v1 sessions\", migrateErr)\n246\t\t\t\t\tresult.skipped++\n247\t\t\t\tdefault:\n248\t\t\t\t\tlogging.Error(ctx, \"checkpoint migration failed\",\n249\t\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n250\t\t\t\t\t\tslog.String(\"error\", migrateErr.Error()),\n251\t\t\t\t\t)\n252\t\t\t\t\tresult.failed++\n253\t\t\t\t}\n254\t\t\t\tprogress.Increment()\n255\t\t\t\tcontinue\n256\t\t\t}\n257\t\n258\t\t\tif fullCheckpoint != nil {\n259\t\t\t\tif packErr := packer.add(ctx, *fullCheckpoint); packErr != nil {\n260\t\t\t\t\treturn result, packer.writtenRefs, fmt.Errorf(\"failed to pack migrated raw transcripts: %w\", packErr)\n261\t\t\t\t}\n262\t\t\t}\n263\t\t\tresult.migrated++\n264\t\t\tprogress.Increment()\n265\t\t}\n266\t\n267\t\tif err := packer.finalize(ctx, !fullCurrentExistsBefore); err != nil {\n268\t\t\treturn result, packer.writtenRefs, fmt.Errorf(\"failed to pack migrated raw transcripts: %w\", err)\n269\t\t}\n270\t\n271\t\treturn result, packer.writtenRefs, nil\n272\t}\n273\t\n274\tfunc logCheckpointMigrationSkip(ctx context.Context, checkpointID id.CheckpointID, reason string, err error) {\n275\t\tlogging.Info(ctx, \"checkpoint migration skipped\",\n276\t\t\tslog.String(\"checkpoint_id\", string(checkpointID)),\n277\t\t\tslog.String(\"reason\", reason),\n278\t\t\tslog.String(\"error\", err.Error()),\n279\t\t)\n280\t}\n281\t\n282\tfunc sortMigratableCheckpoints(checkpoints []checkpoint.CommittedInfo) {\n283\t\tsort.SliceStable(checkpoints, func(i, j int) bool {\n284\t\t\tleft := checkpoints[i].CreatedAt\n285\t\t\tright := checkpoints[j].CreatedAt\n286\t\t\tswitch {\n287\t\t\tcase left.IsZero() && right.IsZero():\n288\t\t\t\treturn checkpoints[i].CheckpointID.String() < checkpoints[j].CheckpointID.String()\n289\t\t\tcase left.IsZero():\n290\t\t\t\treturn false\n291\t\t\tcase right.IsZero():\n292\t\t\t\treturn true\n293\t\t\tcase left.Equal(right):\n294\t\t\t\treturn checkpoints[i].CheckpointID.String() < checkpoints[j].CheckpointID.String()\n295\t\t\tdefault:\n296\t\t\t\treturn left.Before(right)\n297\t\t\t}\n298\t\t})\n299\t}\n300\t\n301\ttype migrateCheckpointOutcome struct {\n302\t\tmissingSessions          int\n303\t\tcompactTranscriptSkipped bool\n304\t}\n305\t\n306\tfunc migrateOneCheckpoint(ctx context.Context, repo *git.Repository, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, info checkpoint.CommittedInfo, force bool, fullArtifacts checkpoint.FullSessionArtifactsIndex) (*migratedFullCheckpoint, migrateCheckpointOutcome, error) {\n307\t\tvar outcome migrateCheckpointOutcome\n308\t\n309\t\texisting, err := v2Store.ReadCommitted(ctx, info.CheckpointID)\n310\t\tif err != nil {\n311\t\t\treturn nil, outcome, fmt.Errorf(\"failed to check v2 for checkpoint %s: %w\", info.CheckpointID, err)\n312\t\t}\n313\t\n314\t\tif existing != nil && !force {\n315\t\t\t// Already in v2. Pack sessions whose /full/* artifacts are missing\n316\t\t\t// (resume an interrupted run) and backfill transcript.jsonl on /main\n317\t\t\t// where it's missing. With nothing to do on either front, return\n318\t\t\t// errAlreadyMigrated so the caller counts it as skipped.\n319\t\t\tfullCheckpoint, err := collectMissingFullCheckpointForPacking(ctx, repo, v1Store, v2Store, info, existing, fullArtifacts)\n320\t\t\tif err != nil && !errors.Is(err, errAlreadyMigrated) {\n321\t\t\t\treturn nil, outcome, err\n322\t\t\t}\n323\t\t\tbackfilled, backfillErr := backfillCompactTranscripts(ctx, v1Store, v2Store, info, existing)\n324\t\t\tif errors.Is(backfillErr, errTranscriptNotGeneratable) {\n325\t\t\t\toutcome.compactTranscriptSkipped = true\n326\t\t\t} else if backfillErr != nil && !errors.Is(backfillErr, errAlreadyMigrated) {\n327\t\t\t\treturn nil, outcome, backfillErr\n328\t\t\t}\n329\t\t\tif fullCheckpoint == nil {\n330\t\t\t\tif backfilled > 0 {\n331\t\t\t\t\treturn nil, outcome, nil\n332\t\t\t\t}\n333\t\t\t\treturn nil, outcome, errAlreadyMigrated\n334\t\t\t}\n335\t\t\treturn fullCheckpoint, outcome, nil\n336\t\t}\n337\t\n338\t\tif existing != nil && force {\n339\t\t\tif pruneErr := pruneV2CheckpointForForce(ctx, repo, v2Store, info.CheckpointID); pruneErr != nil {\n340\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to reset existing v2 checkpoint %s before force migration: %w\", info.CheckpointID, pruneErr)\n341\t\t\t}\n342\t\t}\n343\t\n344\t\tsummary, err := v1Store.ReadCommitted(ctx, info.CheckpointID)\n345\t\tif err != nil {\n346\t\t\treturn nil, outcome, fmt.Errorf(\"failed to read v1 summary: %w\", err)\n347\t\t}\n348\t\tif summary == nil {\n349\t\t\treturn nil, outcome, fmt.Errorf(\"v1 checkpoint %s has no summary\", info.CheckpointID)\n350\t\t}\n351\t\n352\t\tcompactFailed := false\n353\t\tshouldCopyTaskMetadata := false\n354\t\tskippedMissingSessions := 0\n355\t\tmigratedSessions := 0\n356\t\tv1ToV2SessionIdx := make(map[int]int, len(summary.Sessions))\n357\t\tfullCheckpoint := &migratedFullCheckpoint{\n358\t\t\tcheckpointID: info.CheckpointID,\n359\t\t}\n360\t\n361\t\tfor sessionIdx := range len(summary.Sessions) {\n362\t\t\tcontent, skipped, readErr := readV1SessionForMigration(ctx, v1Store, info.CheckpointID, sessionIdx)\n363\t\t\tif skipped {\n364\t\t\t\tskippedMissingSessions++\n365\t\t\t\toutcome.missingSessions++\n366\t\t\t\tcontinue\n367\t\t\t}\n368\t\t\tif readErr != nil {\n369\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to read v1 session %d: %w\", sessionIdx, readErr)\n370\t\t\t}\n371\t\t\tif content.Metadata.IsTask {\n372\t\t\t\tshouldCopyTaskMetadata = true\n373\t\t\t}\n374\t\n375\t\t\topts := buildMigrateWriteOpts(content, info, summary.CombinedAttribution)\n376\t\n377\t\t\tcompacted := tryCompactTranscript(ctx, content.Transcript, content.Metadata)\n378\t\t\tif compacted != nil {\n379\t\t\t\topts.CompactTranscript = compacted\n380\t\t\t\topts.CompactTranscriptStart = computeCompactOffset(ctx, content.Transcript, compacted, content.Metadata)\n381\t\t\t} else if len(content.Transcript) > 0 {\n382\t\t\t\tcompactFailed = true\n383\t\t\t}\n384\t\n385\t\t\tmainOpts := opts\n386\t\t\tmainOpts.Transcript = redact.AlreadyRedacted(nil)\n387\t\t\tv2SessionIdx, writeErr := v2Store.WriteCommittedWithSessionIndex(ctx, mainOpts)\n388\t\t\tif writeErr != nil {\n389\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to write v2 session %d: %w\", sessionIdx, writeErr)\n390\t\t\t}\n391\t\t\tv1ToV2SessionIdx[sessionIdx] = v2SessionIdx\n392\t\t\tfullCheckpoint.sessions = append(fullCheckpoint.sessions, migratedFullSession{\n393\t\t\t\tsessionIndex: v2SessionIdx,\n394\t\t\t\tcontent:      content,\n395\t\t\t})\n396\t\t\tmigratedSessions++\n397\t\t}\n398\t\n399\t\tif migratedSessions == 0 {\n400\t\t\treturn nil, outcome, fmt.Errorf(\"%w: v1 metadata lists %d session(s), but no transcript/session content exists for any of them\", errNoMigratableSessions, len(summary.Sessions))\n401\t\t}\n402\t\n403\t\tif shouldCopyTaskMetadata {\n404\t\t\ttaskTrees, taskErr := collectTaskMetadataForMigratedFullGeneration(repo, info.CheckpointID, summary, v1ToV2SessionIdx)\n405\t\t\tif taskErr != nil {\n406\t\t\t\tlogging.Warn(ctx, \"failed to copy task metadata to v2\",\n407\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n408\t\t\t\t\tslog.String(\"error\", taskErr.Error()),\n409\t\t\t\t)\n410\t\t\t} else {\n411\t\t\t\tfullCheckpoint.taskTrees = taskTrees\n412\t\t\t}\n413\t\t}\n414\t\n415\t\tif compactFailed {\n416\t\t\toutcome.compactTranscriptSkipped = true\n417\t\t\tlogging.Warn(ctx, \"compact transcript not generated during checkpoint migration\",\n418\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n419\t\t\t\tslog.Int(\"migrated_sessions\", migratedSessions),\n420\t\t\t)\n421\t\t}\n422\t\tif skippedMissingSessions > 0 {\n423\t\t\tlogging.Warn(ctx, \"checkpoint migration skipped v1 sessions with missing transcript/session content\",\n424\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n425\t\t\t\tslog.Int(\"missing_sessions\", skippedMissingSessions),\n426\t\t\t)\n427\t\t}\n428\t\n429\t\treturn fullCheckpoint, outcome, nil\n430\t}\n431\t\n432\t// generationPacker buffers up to batchSize migrated checkpoints and flushes\n433\t// them into a single archived /full/<n> ref each time the buffer fills, so\n434\t// peak heap stays bounded by one batch worth of transcripts instead of\n435\t// growing with the total v1 list. The next generation number is resolved\n436\t// lazily on first flush so force-migration prune steps that remove existing\n437\t// archived refs are visible before we pick the next slot.\n438\ttype generationPacker struct {\n439\t\trepo           *git.Repository\n440\t\tv2Store        *checkpoint.V2GitStore\n441\t\tbatchSize      int\n442\t\tnextGeneration int\n443\t\tnumbered       bool\n444\t\tpending        []migratedFullCheckpoint\n445\t\tflushed        bool\n446\t\t// writtenRefs records every /full/<n> ref this packer creates so the\n447\t\t// caller can exclude them from the generation-metadata repair pass.\n448\t\twrittenRefs []plumbing.ReferenceName\n449\t}\n450\t\n451\tfunc newGenerationPacker(repo *git.Repository, v2Store *checkpoint.V2GitStore) *generationPacker {\n452\t\tbatchSize := migrateMaxCheckpointsPerGeneration\n453\t\tif batchSize <= 0 {\n454\t\t\tbatchSize = checkpoint.DefaultMaxCheckpointsPerGeneration\n455\t\t}\n456\t\treturn &generationPacker{\n457\t\t\trepo:      repo,\n458\t\t\tv2Store:   v2Store,\n459\t\t\tbatchSize: batchSize,\n460\t\t}\n461\t}\n462\t\n463\tfunc (p *generationPacker) add(ctx context.Context, cp migratedFullCheckpoint) error {\n464\t\tp.pending = append(p.pending, cp)\n465\t\tif len(p.pending) >= p.batchSize {\n466\t\t\treturn p.flush(ctx)\n467\t\t}\n468\t\treturn nil\n469\t}\n470\t\n471\tfunc (p *generationPacker) flush(ctx context.Context) error {\n472\t\tif len(p.pending) == 0 {\n473\t\t\treturn nil\n474\t\t}\n475\t\tif !p.numbered {\n476\t\t\tnext, err := p.v2Store.NextGenerationNumber()\n477\t\t\tif err != nil {\n478\t\t\t\treturn fmt.Errorf(\"list archived v2 generations: %w\", err)\n479\t\t\t}\n480\t\t\tp.nextGeneration = next\n481\t\t\tp.numbered = true\n482\t\t}\n483\t\trefName := plumbing.ReferenceName(fmt.Sprintf(\"%s%013d\", paths.V2FullRefPrefix, p.nextGeneration))\n484\t\tif err := writeMigratedFullGeneration(ctx, p.repo, refName, p.pending); err != nil {\n485\t\t\treturn err\n486\t\t}\n487\t\tp.writtenRefs = append(p.writtenRefs, refName)\n488\t\tp.nextGeneration++\n489\t\tp.pending = nil\n490\t\tp.flushed = true\n491\t\treturn nil\n492\t}\n493\t\n494\tfunc (p *generationPacker) finalize(ctx context.Context, ensureEmptyCurrent bool) error {\n495\t\tif err := p.flush(ctx); err != nil {\n496\t\t\treturn err\n497\t\t}\n498\t\tif p.flushed && ensureEmptyCurrent {\n499\t\t\treturn ensureEmptyV2FullCurrent(ctx, p.repo)\n500\t\t}\n501\t\treturn nil\n502\t}\n503\t\n504\tfunc writeMigratedFullGeneration(ctx context.Context, repo *git.Repository, refName plumbing.ReferenceName, checkpoints []migratedFullCheckpoint) error {\n505\t\tentries := make(map[string]object.TreeEntry)\n506\t\n507\t\tfor _, cp := range checkpoints {\n508\t\t\tfor _, session := range cp.sessions {\n509\t\t\t\tif err := writeMigratedFullSessionEntries(ctx, repo, cp, session, entries); err != nil {\n510\t\t\t\t\treturn fmt.Errorf(\"write full session entries for checkpoint %s session %d: %w\", cp.checkpointID, session.sessionIndex, err)\n511\t\t\t\t}\n512\t\t\t}\n513\t\t}\n514\t\n515\t\ttreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, entries)\n516\t\tif err != nil {\n517\t\t\treturn fmt.Errorf(\"build migrated generation tree: %w\", err)\n518\t\t}\n519\t\n520\t\tv2Store := checkpoint.NewV2GitStore(repo, migrateRemoteName)\n521\t\t// Reuse the transcripts already in memory rather than walking the tree\n522\t\t// we just built — same first/last-event range, no redundant blob reads.\n523\t\tgen, found := checkpoint.AggregateTranscriptTimestamps(migratedTranscripts(checkpoints))\n524\t\tif !found {\n525\t\t\tvar err error\n526\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n527\t\t\tif err != nil {\n528\t\t\t\treturn fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n529\t\t\t}\n530\t\t}\n531\t\tif !found {\n532\t\t\tgen, found = generationMetadataFromMigratedSessions(checkpoints)\n533\t\t}\n534\t\tif !found {\n535\t\t\treturn fmt.Errorf(\"no timestamps found for migrated generation %s\", refName)\n536\t\t}\n537\t\n538\t\ttreeHash, err = v2Store.AddGenerationJSONToTree(treeHash, gen)\n539\t\tif err != nil {\n540\t\t\treturn fmt.Errorf(\"add generation metadata: %w\", err)\n541\t\t}\n542\t\n543\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, treeHash, plumbing.ZeroHash,\n544\t\t\tfmt.Sprintf(\"Archive migrated generation: %s\\n\", refName),\n545\t\t\tmigrateAuthorName, migrateAuthorEmail)\n546\t\tif err != nil {\n547\t\t\treturn fmt.Errorf(\"create migrated generation commit: %w\", err)\n548\t\t}\n549\t\n550\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n551\t\t\treturn fmt.Errorf(\"update migrated generation ref %s: %w\", refName, err)\n552\t\t}\n553\t\treturn nil\n554\t}\n555\t\n556\tfunc migratedTranscripts(checkpoints []migratedFullCheckpoint) [][]byte {\n557\t\tvar transcripts [][]byte\n558\t\tfor _, cp := range checkpoints {\n559\t\t\tfor _, session := range cp.sessions {\n560\t\t\t\tif len(session.content.Transcript) == 0 {\n561\t\t\t\t\tcontinue\n562\t\t\t\t}\n563\t\t\t\ttranscripts = append(transcripts, session.content.Transcript)\n564\t\t\t}\n565\t\t}\n566\t\treturn transcripts\n567\t}\n568\t\n569\tfunc generationMetadataFromMigratedSessions(checkpoints []migratedFullCheckpoint) (checkpoint.GenerationMetadata, bool) {\n570\t\tvar gen checkpoint.GenerationMetadata\n571\t\tfound := false\n572\t\tfor _, cp := range checkpoints {\n573\t\t\tfor _, session := range cp.sessions {\n574\t\t\t\tcheckpoint.MergeGenerationTime(&gen, &found, session.content.Metadata.CreatedAt)\n575\t\t\t}\n576\t\t}\n577\t\treturn gen, found\n578\t}\n579\t\n580\tfunc writeMigratedFullSessionEntries(ctx context.Context, repo *git.Repository, cp migratedFullCheckpoint, session migratedFullSession, entries map[string]object.TreeEntry) error {\n581\t\tsessionPath := fmt.Sprintf(\"%s/%d/\", cp.checkpointID.Path(), session.sessionIndex)\n582\t\ttranscript := session.content.Transcript\n583\t\n584\t\tchunks, err := agent.ChunkTranscript(ctx, transcript, session.content.Metadata.Agent)\n585\t\tif err != nil {\n586\t\t\treturn fmt.Errorf(\"chunk transcript: %w\", err)\n587\t\t}\n588\t\tfor i, chunk := range chunks {\n589\t\t\tblobHash, blobErr := checkpoint.CreateBlobFromContent(repo, chunk)\n590\t\t\tif blobErr != nil {\n591\t\t\t\treturn fmt.Errorf(\"create transcript blob: %w\", blobErr)\n592\t\t\t}\n593\t\t\tpath := sessionPath + agent.ChunkFileName(paths.V2RawTranscriptFileName, i)\n594\t\t\tentries[path] = object.TreeEntry{\n595\t\t\t\tName: path,\n596\t\t\t\tMode: filemode.Regular,\n597\t\t\t\tHash: blobHash,\n598\t\t\t}\n599\t\t}\n600\t\n601\t\thashPath := sessionPath + paths.V2RawTranscriptHashFileName\n602\t\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n603\t\thashBlob, err := checkpoint.CreateBlobFromContent(repo, []byte(contentHash))\n604\t\tif err != nil {\n605\t\t\treturn fmt.Errorf(\"create transcript hash blob: %w\", err)\n606\t\t}\n607\t\tentries[hashPath] = object.TreeEntry{\n608\t\t\tName: hashPath,\n609\t\t\tMode: filemode.Regular,\n610\t\t\tHash: hashBlob,\n611\t\t}\n612\t\n613\t\tfor _, taskTreeHash := range cp.taskTrees[session.sessionIndex] {\n614\t\t\ttaskTree, treeErr := repo.TreeObject(taskTreeHash)\n615\t\t\tif treeErr != nil {\n616\t\t\t\treturn fmt.Errorf(\"read task metadata tree: %w\", treeErr)\n617\t\t\t}\n618\t\t\ttaskEntries := make(map[string]object.TreeEntry)\n619\t\t\tif flattenErr := checkpoint.FlattenTree(repo, taskTree, sessionPath+\"tasks\", taskEntries); flattenErr != nil {\n620\t\t\t\treturn fmt.Errorf(\"flatten task metadata tree: %w\", flattenErr)\n621\t\t\t}\n622\t\t\tfor path, entry := range taskEntries {\n623\t\t\t\tif _, exists := entries[path]; exists {\n624\t\t\t\t\tcontinue\n625\t\t\t\t}\n626\t\t\t\tentries[path] = entry\n627\t\t\t}\n628\t\t}\n629\t\n630\t\treturn nil\n631\t}\n632\t\n633\tfunc ensureEmptyV2FullCurrent(ctx context.Context, repo *git.Repository) error {\n634\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n635\t\tif _, err := repo.Reference(refName, true); err == nil {\n636\t\t\treturn nil\n637\t\t}\n638\t\n639\t\temptyTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, map[string]object.TreeEntry{})\n640\t\tif err != nil {\n641\t\t\treturn fmt.Errorf(\"build empty v2 full/current tree: %w\", err)\n642\t\t}\n643\t\n644\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, emptyTreeHash, plumbing.ZeroHash,\n645\t\t\t\"Start generation\\n\",\n646\t\t\tmigrateAuthorName, migrateAuthorEmail)\n647\t\tif err != nil {\n648\t\t\treturn fmt.Errorf(\"create empty v2 full/current commit: %w\", err)\n649\t\t}\n650\t\n651\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n652\t\t\treturn fmt.Errorf(\"update %s: %w\", refName, err)\n653\t\t}\n654\t\treturn nil\n655\t}\n656\t\n657\tfunc readV1SessionForMigration(ctx context.Context, v1Store *checkpoint.GitStore, checkpointID id.CheckpointID, sessionIdx int) (*checkpoint.SessionContent, bool, error) {\n658\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, checkpointID, sessionIdx)\n659\t\tif readErr != nil {\n660\t\t\tif errors.Is(readErr, checkpoint.ErrNoTranscript) || errors.Is(readErr, checkpoint.ErrCheckpointNotFound) {\n661\t\t\t\twarnMissingV1Session(ctx, checkpointID, sessionIdx, readErr)\n662\t\t\t\treturn nil, true, nil\n663\t\t\t}\n664\t\t\treturn nil, false, fmt.Errorf(\"read v1 session content: %w\", readErr)\n665\t\t}\n666\t\treturn content, false, nil\n667\t}\n668\t\n669\tfunc warnMissingV1Session(ctx context.Context, checkpointID id.CheckpointID, sessionIdx int, err error) {\n670\t\tlogging.Warn(ctx, \"skipping v1 session with missing transcript during checkpoint migration\",\n671\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n672\t\t\tslog.Int(\"session_index\", sessionIdx),\n673\t\t\tslog.String(\"error\", err.Error()),\n674\t\t)\n675\t}\n676\t\n677\tfunc pruneV2CheckpointForForce(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID) error {\n678\t\tfor _, refName := range []plumbing.ReferenceName{\n679\t\t\tplumbing.ReferenceName(paths.V2MainRefName),\n680\t\t\tplumbing.ReferenceName(paths.V2FullCurrentRefName),\n681\t\t} {\n682\t\t\tif err := pruneV2CheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n683\t\t\t\treturn err\n684\t\t\t}\n685\t\t}\n686\t\n687\t\tarchived, err := v2Store.ListArchivedGenerations()\n688\t\tif err != nil {\n689\t\t\treturn fmt.Errorf(\"failed to list archived v2 generations while pruning checkpoint %s: %w\", cpID, err)\n690\t\t}\n691\t\tfor _, generation := range archived {\n692\t\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + generation)\n693\t\t\tif err := pruneV2ArchivedCheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n694\t\t\t\treturn err\n695\t\t\t}\n696\t\t}\n697\t\n698\t\treturn nil\n699\t}\n700\t\n701\tfunc pruneV2CheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n702\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n703\t\tif err != nil {\n704\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n705\t\t\t\treturn nil\n706\t\t\t}\n707\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n708\t\t}\n709\t\n710\t\trootTree, err := repo.TreeObject(rootTreeHash)\n711\t\tif err != nil {\n712\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n713\t\t}\n714\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n715\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n716\t\t}\n717\t\n718\t\tshardPrefix := string(cpID[:2])\n719\t\tshardSuffix := string(cpID[2:])\n720\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n721\t\tif err != nil {\n722\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n723\t\t}\n724\t\tif newRoot == rootTreeHash {\n725\t\t\treturn nil\n726\t\t}\n727\t\n728\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n729\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n730\t\t\tmigrateAuthorName, migrateAuthorEmail)\n731\t\tif err != nil {\n732\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n733\t\t}\n734\t\n735\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n736\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n737\t\t}\n738\t\treturn nil\n739\t}\n740\t\n741\tfunc pruneV2ArchivedCheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n742\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n743\t\tif err != nil {\n744\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n745\t\t\t\treturn nil\n746\t\t\t}\n747\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n748\t\t}\n749\t\n750\t\trootTree, err := repo.TreeObject(rootTreeHash)\n751\t\tif err != nil {\n752\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n753\t\t}\n754\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n755\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n756\t\t}\n757\t\n758\t\tshardPrefix := string(cpID[:2])\n759\t\tshardSuffix := string(cpID[2:])\n760\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n761\t\tif err != nil {\n762\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n763\t\t}\n764\t\tif newRoot == rootTreeHash {\n765\t\t\treturn nil\n766\t\t}\n767\t\n768\t\tcount, err := v2Store.CountCheckpointsInTree(newRoot)\n769\t\tif err != nil {\n770\t\t\treturn fmt.Errorf(\"failed to count checkpoints in pruned %s: %w\", refName, err)\n771\t\t}\n772\t\tif count == 0 {\n773\t\t\tif err := repo.Storer.RemoveReference(refName); err != nil {\n774\t\t\t\treturn fmt.Errorf(\"failed to remove empty archived v2 generation %s: %w\", refName, err)\n775\t\t\t}\n776\t\t\treturn nil\n777\t\t}\n778\t\n779\t\tnewRoot, err = addRecomputedGenerationJSON(v2Store, newRoot)\n780\t\tif err != nil {\n781\t\t\treturn fmt.Errorf(\"failed to recompute generation metadata for %s: %w\", refName, err)\n782\t\t}\n783\t\n784\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n785\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n786\t\t\tmigrateAuthorName, migrateAuthorEmail)\n787\t\tif err != nil {\n788\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n789\t\t}\n790\t\n791\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n792\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n793\t\t}\n794\t\treturn nil\n795\t}\n796\t\n797\tfunc addRecomputedGenerationJSON(v2Store *checkpoint.V2GitStore, treeHash plumbing.Hash) (plumbing.Hash, error) {\n798\t\tgen, found, err := v2Store.ComputeGenerationTimestampsFromTrees(treeHash, nil)\n799\t\tif err != nil {\n800\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute raw transcript timestamps: %w\", err)\n801\t\t}\n802\t\tif !found {\n803\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n804\t\t\tif err != nil {\n805\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n806\t\t\t}\n807\t\t}\n808\t\tif !found {\n809\t\t\treturn treeHash, nil\n810\t\t}\n811\t\n812\t\tnewTreeHash, err := v2Store.AddGenerationJSONToTree(treeHash, gen)\n813\t\tif err != nil {\n814\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"add generation metadata: %w\", err)\n815\t\t}\n816\t\treturn newTreeHash, nil\n817\t}\n818\t\n819\tfunc pruneCheckpointFromRoot(repo *git.Repository, rootTreeHash plumbing.Hash, shardPrefix, shardSuffix string) (plumbing.Hash, error) {\n820\t\tnewRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n821\t\t\t[]string{shardPrefix},\n822\t\t\tnil,\n823\t\t\tcheckpoint.UpdateSubtreeOptions{\n824\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n825\t\t\t\tDeleteNames: []string{shardSuffix},\n826\t\t\t},\n827\t\t)\n828\t\tif err != nil {\n829\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune checkpoint from shard: %w\", err)\n830\t\t}\n831\t\tif newRoot == rootTreeHash {\n832\t\t\treturn newRoot, nil\n833\t\t}\n834\t\n835\t\tnewRootTree, err := repo.TreeObject(newRoot)\n836\t\tif err != nil {\n837\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to read pruned root tree: %w\", err)\n838\t\t}\n839\t\tshardTree, err := newRootTree.Tree(shardPrefix)\n840\t\tif err != nil {\n841\t\t\treturn newRoot, nil //nolint:nilerr // The shard prefix was already absent after pruning.\n842\t\t}\n843\t\tif len(shardTree.Entries) > 0 {\n844\t\t\treturn newRoot, nil\n845\t\t}\n846\t\n847\t\tprunedRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n848\t\t\tnil,\n849\t\t\tnil,\n850\t\t\tcheckpoint.UpdateSubtreeOptions{\n851\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n852\t\t\t\tDeleteNames: []string{shardPrefix},\n853\t\t\t},\n854\t\t)\n855\t\tif err != nil {\n856\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune empty shard prefix: %w\", err)\n857\t\t}\n858\t\treturn prunedRoot, nil\n859\t}\n860\t\n861\tfunc buildMigrateWriteOpts(content *checkpoint.SessionContent, info checkpoint.CommittedInfo, combinedAttribution *checkpoint.InitialAttribution) checkpoint.WriteCommittedOptions {\n862\t\tm := content.Metadata\n863\t\n864\t\tprompts := checkpoint.SplitPromptContent(content.Prompts)\n865\t\n866\t\treturn checkpoint.WriteCommittedOptions{\n867\t\t\tCheckpointID: info.CheckpointID,\n868\t\t\tSessionID:    m.SessionID,\n869\t\t\tCreatedAt:    m.CreatedAt,\n870\t\t\tStrategy:     m.Strategy,\n871\t\t\tBranch:       m.Branch,\n872\t\t\t// All transcripts read here come from persisted checkpoint storage,\n873\t\t\t// which is already redacted.\n874\t\t\tTranscript:                  redact.AlreadyRedacted(content.Transcript),\n875\t\t\tPrompts:                     prompts,\n876\t\t\tFilesTouched:                m.FilesTouched,\n877\t\t\tCheckpointsCount:            m.CheckpointsCount,\n878\t\t\tAgent:                       m.Agent,\n879\t\t\tModel:                       m.Model,\n880\t\t\tTurnID:                      m.TurnID,\n881\t\t\tTokenUsage:                  m.TokenUsage,\n882\t\t\tSessionMetrics:              m.SessionMetrics,\n883\t\t\tInitialAttribution:          m.InitialAttribution,\n884\t\t\tPromptAttributionsJSON:      m.PromptAttributions,\n885\t\t\tCombinedAttribution:         combinedAttribution,\n886\t\t\tSummary:                     m.Summary,\n887\t\t\tCheckpointTranscriptStart:   m.GetTranscriptStart(),\n888\t\t\tTranscriptIdentifierAtStart: m.TranscriptIdentifierAtStart,\n889\t\t\tIsTask:                      m.IsTask,\n890\t\t\tToolUseID:                   m.ToolUseID,\n891\t\t\tAuthorName:                  migrateAuthorName,\n892\t\t\tAuthorEmail:                 migrateAuthorEmail,\n893\t\t}\n894\t}\n895\t\n896\tfunc tryCompactTranscript(ctx context.Context, transcript []byte, m checkpoint.CommittedMetadata) []byte {\n897\t\treturn compactTranscriptForStartLine(ctx, transcript, m, 0)\n898\t}\n899\t\n900\tfunc compactTranscriptForStartLine(ctx context.Context, transcript []byte, m checkpoint.CommittedMetadata, startLine int) []byte {\n901\t\tif len(transcript) == 0 {\n902\t\t\treturn nil\n903\t\t}\n904\t\tif m.Agent == \"\" {\n905\t\t\tlogging.Warn(ctx, \"compact transcript skipped: no agent type in checkpoint metadata\",\n906\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n907\t\t\t)\n908\t\t\treturn nil\n909\t\t}\n910\t\n911\t\tcompacted, err := compact.Compact(redact.AlreadyRedacted(transcript), compact.MetadataFields{\n912\t\t\tAgent:      string(m.Agent),\n913\t\t\tCLIVersion: versioninfo.Version,\n914\t\t\tStartLine:  startLine,\n915\t\t})\n916\t\tif err != nil {\n917\t\t\tlogging.Warn(ctx, \"compact transcript generation failed during migration\",\n918\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n919\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n920\t\t\t\tslog.String(\"error\", err.Error()),\n921\t\t\t)\n922\t\t\treturn nil\n923\t\t}\n924\t\tif len(compacted) == 0 {\n925\t\t\tlogging.Warn(ctx, \"transcript.jsonl generation produced no output\",\n926\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n927\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n928\t\t\t\tslog.Int(\"input_bytes\", len(transcript)),\n929\t\t\t)\n930\t\t\treturn nil\n931\t\t}\n932\t\treturn compacted\n933\t}\n934\t\n935\t// computeCompactOffset determines the transcript.jsonl line offset for a checkpoint\n936\t// by comparing a full compact (startLine=0) against the scoped compact. The difference\n937\t// is the number of compact lines before this checkpoint's data.\n938\tfunc computeCompactOffset(ctx context.Context, fullTranscript, fullCompact []byte, m checkpoint.CommittedMetadata) int {\n939\t\tstartLine := m.GetTranscriptStart()\n940\t\tif startLine == 0 || len(fullTranscript) == 0 || m.Agent == \"\" {\n941\t\t\treturn 0\n942\t\t}\n943\t\n944\t\tif len(fullCompact) == 0 {\n945\t\t\treturn 0\n946\t\t}\n947\t\n948\t\tscopedCompact, err := compact.Compact(redact.AlreadyRedacted(fullTranscript), compact.MetadataFields{\n949\t\t\tAgent:      string(m.Agent),\n950\t\t\tCLIVersion: versioninfo.Version,\n951\t\t\tStartLine:  startLine,\n952\t\t})\n953\t\tif err != nil {\n954\t\t\tlogging.Warn(ctx, \"compact transcript offset calculation failed during migration\",\n955\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n956\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n957\t\t\t\tslog.String(\"error\", err.Error()),\n958\t\t\t)\n959\t\t\treturn 0\n960\t\t}\n961\t\tif len(scopedCompact) == 0 {\n962\t\t\treturn 0\n963\t\t}\n964\t\n965\t\tfullLines := bytes.Count(fullCompact, []byte{'\\n'})\n966\t\tscopedLines := bytes.Count(scopedCompact, []byte{'\\n'})\n967\t\toffset := fullLines - scopedLines\n968\t\tif offset < 0 {\n969\t\t\tlogging.Warn(ctx, \"compact transcript offset was negative during migration, defaulting to 0\",\n970\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n971\t\t\t\tslog.Int(\"full_lines\", fullLines),\n972\t\t\t\tslog.Int(\"scoped_lines\", scopedLines),\n973\t\t\t)\n974\t\t\treturn 0\n975\t\t}\n976\t\treturn offset\n977\t}\n978\t\n979\tfunc collectTaskMetadataForMigratedFullGeneration(repo *git.Repository, cpID id.CheckpointID, summary *checkpoint.CheckpointSummary, v1ToV2SessionIdx map[int]int) (map[int][]plumbing.Hash, error) {\n980\t\trootTaskV2SessionIdx, attachRootTasks := latestMigratedV2SessionIndex(v1ToV2SessionIdx)\n981\t\treturn collectTaskMetadataForMigratedFullGenerationWithRootSession(repo, cpID, summary, v1ToV2SessionIdx, rootTaskV2SessionIdx, attachRootTasks)\n982\t}\n983\t\n984\tfunc collectTaskMetadataForMigratedFullGenerationWithRootSession(\n985\t\trepo *git.Repository,\n986\t\tcpID id.CheckpointID,\n987\t\tsummary *checkpoint.CheckpointSummary,\n988\t\tv1ToV2SessionIdx map[int]int,\n989\t\trootTaskV2SessionIdx int,\n990\t\tattachRootTasks bool,\n991\t) (map[int][]plumbing.Hash, error) {\n992\t\tv1Tree, err := resolveV1CheckpointTree(repo, cpID)\n993\t\tif err != nil {\n994\t\t\treturn nil, err\n995\t\t}\n996\t\n997\t\ttaskTrees := make(map[int][]plumbing.Hash)\n998\t\n999\t\t// Legacy v1 layout stores task metadata at checkpoint root: <cp>/tasks/<tool-use-id>/...\n1000\t\t// Prefer attaching this tree to the latest session in v2.\n1001\t\tif rootTasksTree, rootTasksErr := v1Tree.Tree(\"tasks\"); rootTasksErr == nil {\n1002\t\t\tif attachRootTasks {\n1003\t\t\t\ttaskTrees[rootTaskV2SessionIdx] = append(taskTrees[rootTaskV2SessionIdx], rootTasksTree.Hash)\n1004\t\t\t}\n1005\t\t}\n1006\t\n1007\t\tfor sessionIdx := range len(summary.Sessions) {\n1008\t\t\tsessionDir := strconv.Itoa(sessionIdx)\n1009\t\t\tsessionTree, sessionErr := v1Tree.Tree(sessionDir)\n1010\t\t\tif sessionErr != nil {\n1011\t\t\t\tcontinue\n1012\t\t\t}\n1013\t\n1014\t\t\ttasksTree, tasksErr := sessionTree.Tree(\"tasks\")\n1015\t\t\tif tasksErr != nil {\n1016\t\t\t\tcontinue\n1017\t\t\t}\n1018\t\n1019\t\t\tv2SessionIdx, ok := v1ToV2SessionIdx[sessionIdx]\n1020\t\t\tif !ok {\n1021\t\t\t\tcontinue\n1022\t\t\t}\n1023\t\t\ttaskTrees[v2SessionIdx] = append(taskTrees[v2SessionIdx], tasksTree.Hash)\n1024\t\t}\n1025\t\n1026\t\treturn taskTrees, nil\n1027\t}\n1028\t\n1029\tfunc latestMigratedV2SessionIndex(v1ToV2SessionIdx map[int]int) (int, bool) {\n1030\t\tlatest := -1\n1031\t\tfor _, v2SessionIdx := range v1ToV2SessionIdx {\n1032\t\t\tif v2SessionIdx > latest {\n1033\t\t\t\tlatest = v2SessionIdx\n1034\t\t\t}\n1035\t\t}\n1036\t\tif latest < 0 {\n1037\t\t\treturn -1, false\n1038\t\t}\n1039\t\treturn latest, true\n1040\t}\n1041\t\n1042\tfunc resolveV1CheckpointTree(repo *git.Repository, cpID id.CheckpointID) (*object.Tree, error) {\n1043\t\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n1044\t\tref, err := repo.Reference(refName, true)\n1045\t\tif err != nil {\n1046\t\t\t// Try remote tracking branch\n1047\t\t\tremoteRefName := plumbing.NewRemoteReferenceName(migrateRemoteName, paths.MetadataBranchName)\n1048\t\t\tref, err = repo.Reference(remoteRefName, true)\n1049\t\t\tif err != nil {\n1050\t\t\t\treturn nil, fmt.Errorf(\"v1 branch not found: %w\", err)\n1051\t\t\t}\n1052\t\t}\n1053\t\n1054\t\tcommit, err := repo.CommitObject(ref.Hash())\n1055\t\tif err != nil {\n1056\t\t\treturn nil, fmt.Errorf(\"failed to get v1 commit: %w\", err)\n1057\t\t}\n1058\t\n1059\t\trootTree, err := commit.Tree()\n1060\t\tif err != nil {\n1061\t\t\treturn nil, fmt.Errorf(\"failed to get v1 tree: %w\", err)\n1062\t\t}\n1063\t\n1064\t\tcpTree, err := rootTree.Tree(cpID.Path())\n1065\t\tif err != nil {\n1066\t\t\treturn nil, fmt.Errorf(\"checkpoint %s not found in v1 tree: %w\", cpID, err)\n1067\t\t}\n1068\t\n1069\t\treturn cpTree, nil\n1070\t}\n1071\t\n1072\t// collectMissingFullCheckpointForPacking returns a migratedFullCheckpoint\n1073\t// scoped to the sessions that lack /full/* artifacts on this v2 checkpoint,\n1074\t// reading their content from v1 so the caller can hand it to the same\n1075\t// generationPacker fresh migrations use. Returns errAlreadyMigrated when\n1076\t// every session is already packed.\n1077\tfunc collectMissingFullCheckpointForPacking(\n1078\t\tctx context.Context,\n1079\t\trepo *git.Repository,\n1080\t\tv1Store *checkpoint.GitStore,\n1081\t\tv2Store *checkpoint.V2GitStore,\n1082\t\tinfo checkpoint.CommittedInfo,\n1083\t\tv2Summary *checkpoint.CheckpointSummary,\n1084\t\tfullArtifacts checkpoint.FullSessionArtifactsIndex,\n1085\t) (*migratedFullCheckpoint, error) {\n1086\t\tmissingSessions, err := collectMissingFullSessionsForPacking(ctx, v2Store, info.CheckpointID, v2Summary, fullArtifacts)\n1087\t\tif err != nil {\n1088\t\t\treturn nil, err\n1089\t\t}\n1090\t\tif len(missingSessions) == 0 {\n1091\t\t\treturn nil, errAlreadyMigrated\n1092\t\t}\n1093\t\n1094\t\tv1Summary, err := v1Store.ReadCommitted(ctx, info.CheckpointID)\n1095\t\tif err != nil {\n1096\t\t\treturn nil, fmt.Errorf(\"failed to read v1 summary while resuming v2 migration: %w\", err)\n1097\t\t}\n1098\t\tif v1Summary == nil {\n1099\t\t\treturn nil, fmt.Errorf(\"v1 checkpoint %s has no summary\", info.CheckpointID)\n1100\t\t}\n1101\t\n1102\t\tv1BySessionID, err := collectV1SessionIndexesForPacking(ctx, v1Store, info.CheckpointID, v1Summary, missingSessions)\n1103\t\tif err != nil {\n1104\t\t\treturn nil, err\n1105\t\t}\n1106\t\n1107\t\tfullCheckpoint := &migratedFullCheckpoint{\n1108\t\t\tcheckpointID: info.CheckpointID,\n1109\t\t}\n1110\t\tv1ToV2SessionIdx := make(map[int]int)\n1111\t\n1112\t\tfor _, missingSession := range missingSessions {\n1113\t\t\tv1Session, ok, readErr := readV1SessionForMissingFullArtifact(ctx, v1Store, info.CheckpointID, v1Summary, v1BySessionID, missingSession)\n1114\t\t\tif readErr != nil {\n1115\t\t\t\treturn nil, readErr\n1116\t\t\t}\n1117\t\t\tif !ok {\n1118\t\t\t\treturn nil, fmt.Errorf(\"failed to find v1 session for v2 session %d while resuming migration\", missingSession.sessionIndex)\n1119\t\t\t}\n1120\t\n1121\t\t\tfullCheckpoint.sessions = append(fullCheckpoint.sessions, migratedFullSession{\n1122\t\t\t\tsessionIndex: missingSession.sessionIndex,\n1123\t\t\t\tcontent:      v1Session.content,\n1124\t\t\t})\n1125\t\t\tv1ToV2SessionIdx[v1Session.sessionIndex] = missingSession.sessionIndex\n1126\t\t}\n1127\t\n1128\t\tlatestV2SessionIdx :