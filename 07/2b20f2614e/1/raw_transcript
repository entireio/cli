49\t\tif err != nil {\n50\t\t\treturn nil, nil //nolint:nilnil,nilerr // metadata.json not found\n51\t\t}\n52\t\n53\t\tcontent, err := metadataFile.Contents()\n54\t\tif err != nil {\n55\t\t\treturn nil, fmt.Errorf(\"failed to read metadata.json: %w\", err)\n56\t\t}\n57\t\n58\t\tvar summary CheckpointSummary\n59\t\tif err := json.Unmarshal([]byte(content), &summary); err != nil {\n60\t\t\treturn nil, fmt.Errorf(\"failed to parse metadata.json: %w\", err)\n61\t\t}\n62\t\n63\t\treturn &summary, nil\n64\t}\n65\t\n66\t// ListCommitted lists all committed checkpoints from the v2 /main ref.\n67\t// Scans sharded paths: <id[:2]>/<id[2:]>/ directories containing metadata.json.\n68\tfunc (s *V2GitStore) ListCommitted(ctx context.Context) ([]CommittedInfo, error) {\n69\t\tif err := ctx.Err(); err != nil {\n70\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n71\t\t}\n72\t\n73\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n74\t\t_, rootTreeHash, err := s.GetRefState(refName)\n75\t\tif err != nil {\n76\t\t\treturn []CommittedInfo{}, nil //nolint:nilerr // No /main ref means empty list\n77\t\t}\n78\t\n79\t\trootTree, err := s.repo.TreeObject(rootTreeHash)\n80\t\tif err != nil {\n81\t\t\treturn []CommittedInfo{}, nil //nolint:nilerr // Unreadable tree means no listable entries\n82\t\t}\n83\t\n84\t\tvar checkpoints []CommittedInfo\n85\t\n86\t\t_ = WalkCheckpointShards(s.repo, rootTree, func(checkpointID id.CheckpointID, cpTreeHash plumbing.Hash) error { //nolint:errcheck // callback never returns errors\n87\t\t\tcheckpointTree, cpTreeErr := s.repo.TreeObject(cpTreeHash)\n88\t\t\tif cpTreeErr != nil {\n89\t\t\t\tlogging.Debug(ctx, \"v2 ListCommitted: skipping unreadable checkpoint tree\",\n90\t\t\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n91\t\t\t\t\tslog.String(\"error\", cpTreeErr.Error()))\n92\t\t\t\treturn nil\n93\t\t\t}\n94\t\n95\t\t\tinfo := CommittedInfo{CheckpointID: checkpointID}\n96\t\n97\t\t\tif metadataFile, fileErr := checkpointTree.File(paths.MetadataFileName); fileErr == nil {\n98\t\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n99\t\t\t\t\tvar summary CheckpointSummary\n100\t\t\t\t\tif unmarshalErr := json.Unmarshal([]byte(content), &summary); unmarshalErr != nil {\n101\t\t\t\t\t\tlogging.Debug(ctx, \"v2 ListCommitted: skipping malformed metadata\",\n102\t\t\t\t\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n103\t\t\t\t\t\t\tslog.String(\"error\", unmarshalErr.Error()))\n104\t\t\t\t\t} else {\n105\t\t\t\t\t\tinfo.CheckpointsCount = summary.CheckpointsCount\n106\t\t\t\t\t\tinfo.FilesTouched = summary.FilesTouched\n107\t\t\t\t\t\tinfo.SessionCount = len(summary.Sessions)\n108\t\n109\t\t\t\t\t\tif len(summary.Sessions) > 0 {\n110\t\t\t\t\t\t\tlatestIndex := len(summary.Sessions) - 1\n111\t\t\t\t\t\t\tlatestDir := strconv.Itoa(latestIndex)\n112\t\t\t\t\t\t\tif sessionTree, treeErr := checkpointTree.Tree(latestDir); treeErr == nil {\n113\t\t\t\t\t\t\t\tif sessionMetadataFile, smErr := sessionTree.File(paths.MetadataFileName); smErr == nil {\n114\t\t\t\t\t\t\t\t\tif sessionContent, scErr := sessionMetadataFile.Contents(); scErr == nil {\n115\t\t\t\t\t\t\t\t\t\tvar sessionMetadata CommittedMetadata\n116\t\t\t\t\t\t\t\t\t\tif json.Unmarshal([]byte(sessionContent), &sessionMetadata) == nil {\n117\t\t\t\t\t\t\t\t\t\t\tinfo.Agent = sessionMetadata.Agent\n118\t\t\t\t\t\t\t\t\t\t\tinfo.SessionID = sessionMetadata.SessionID\n119\t\t\t\t\t\t\t\t\t\t\tinfo.CreatedAt = sessionMetadata.CreatedAt\n120\t\t\t\t\t\t\t\t\t\t}\n121\t\t\t\t\t\t\t\t\t}\n122\t\t\t\t\t\t\t\t}\n123\t\t\t\t\t\t\t}\n124\t\t\t\t\t\t}\n125\t\t\t\t\t}\n126\t\t\t\t}\n127\t\t\t}\n128\t\n129\t\t\tcheckpoints = append(checkpoints, info)\n130\t\t\treturn nil\n131\t\t})\n132\t\n133\t\tsort.Slice(checkpoints, func(i, j int) bool {\n134\t\t\treturn checkpoints[i].CreatedAt.After(checkpoints[j].CreatedAt)\n135\t\t})\n136\t\n137\t\treturn checkpoints, nil\n138\t}\n139\t\n140\t// ReadSessionCompactTranscript reads transcript.jsonl for a session from the v2\n141\t// /main ref. Returns ErrNoTranscript when compact transcript is missing.\n142\tfunc (s *V2GitStore) ReadSessionCompactTranscript(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) ([]byte, error) {\n143\t\tif err := ctx.Err(); err != nil {\n144\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n145\t\t}\n146\t\n147\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n148\t\t_, rootTreeHash, err := s.GetRefState(refName)\n149\t\tif err != nil {\n150\t\t\treturn nil, ErrCheckpointNotFound\n151\t\t}\n152\t\n153\t\trootTree, err := s.repo.TreeObject(rootTreeHash)\n154\t\tif err != nil {\n155\t\t\treturn nil, ErrCheckpointNotFound\n156\t\t}\n157\t\n158\t\tcpTree, err := rootTree.Tree(checkpointID.Path())\n159\t\tif err != nil {\n160\t\t\treturn nil, ErrCheckpointNotFound\n161\t\t}\n162\t\n163\t\tsessionDir := strconv.Itoa(sessionIndex)\n164\t\tsessionTree, err := cpTree.Tree(sessionDir)\n165\t\tif err != nil {\n166\t\t\treturn nil, ErrCheckpointNotFound\n167\t\t}\n168\t\n169\t\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n170\t\tcompactFile, err := sessionFT.File(paths.CompactTranscriptFileName)\n171\t\tif err != nil {\n172\t\t\treturn nil, ErrNoTranscript\n173\t\t}\n174\t\n175\t\tcontent, err := compactFile.Contents()\n176\t\tif err != nil {\n177\t\t\treturn nil, ErrNoTranscript\n178\t\t}\n179\t\tif content == \"\" {\n180\t\t\treturn nil, ErrNoTranscript\n181\t\t}\n182\t\n183\t\treturn []byte(content), nil\n184\t}\n185\t\n186\t// ReadSessionMetadata reads only the session's metadata.json from the v2\n187\t// /main ref — cheaper than ReadSessionMetadataAndPrompts when the caller\n188\t// only needs metadata fields (e.g. SessionID). Returns ErrCheckpointNotFound\n189\t// if the checkpoint or session doesn't exist on /main.\n190\tfunc (s *V2GitStore) ReadSessionMetadata(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (CommittedMetadata, error) {\n191\t\tif err := ctx.Err(); err != nil {\n192\t\t\treturn CommittedMetadata{}, err //nolint:wrapcheck // Propagating context cancellation\n193\t\t}\n194\t\n195\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n196\t\t_, rootTreeHash, err := s.GetRefState(refName)\n197\t\tif err != nil {\n198\t\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n199\t\t}\n200\t\n201\t\trootTree, err := s.repo.TreeObject(rootTreeHash)\n202\t\tif err != nil {\n203\t\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n204\t\t}\n205\t\n206\t\tcpTree, err := rootTree.Tree(checkpointID.Path())\n207\t\tif err != nil {\n208\t\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n209\t\t}\n210\t\n211\t\tsessionTree, err := cpTree.Tree(strconv.Itoa(sessionIndex))\n212\t\tif err != nil {\n213\t\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n214\t\t}\n215\t\n216\t\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n217\t\tmetadataFile, err := sessionFT.File(paths.MetadataFileName)\n218\t\tif err != nil {\n219\t\t\treturn CommittedMetadata{}, fmt.Errorf(\"read session metadata file: %w\", err)\n220\t\t}\n221\t\tcontent, err := metadataFile.Contents()\n222\t\tif err != nil {\n223\t\t\treturn CommittedMetadata{}, fmt.Errorf(\"read session metadata contents: %w\", err)\n224\t\t}\n225\t\n226\t\tvar meta CommittedMetadata\n227\t\tif err := json.Unmarshal([]byte(content), &meta); err != nil {\n228\t\t\treturn CommittedMetadata{}, fmt.Errorf(\"parse session metadata: %w\", err)\n229\t\t}\n230\t\treturn meta, nil\n231\t}\n232\t\n233\t// ReadSessionMetadataAndPrompts reads a session's metadata and prompts from the\n234\t// v2 /main ref without requiring the raw transcript from /full/* refs.\n235\t// Used by explain when the raw transcript is unavailable but compact transcript\n236\t// (transcript.jsonl) on /main can substitute for display.\n237\t// Returns ErrCheckpointNotFound if the checkpoint or session doesn't exist on /main.\n238\tfunc (s *V2GitStore) ReadSessionMetadataAndPrompts(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error) {\n239\t\tif err := ctx.Err(); err != nil {\n240\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n241\t\t}\n242\t\n243\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n244\t\t_, rootTreeHash, err := s.GetRefState(refName)\n245\t\tif err != nil {\n246\t\t\treturn nil, ErrCheckpointNotFound\n247\t\t}\n248\t\n249\t\trootTree, err := s.repo.TreeObject(rootTreeHash)\n250\t\tif err != nil {\n251\t\t\treturn nil, ErrCheckpointNotFound\n252\t\t}\n253\t\n254\t\tcpTree, err := rootTree.Tree(checkpointID.Path())\n255\t\tif err != nil {\n256\t\t\treturn nil, ErrCheckpointNotFound\n257\t\t}\n258\t\n259\t\tsessionDir := strconv.Itoa(sessionIndex)\n260\t\tsessionTree, err := cpTree.Tree(sessionDir)\n261\t\tif err != nil {\n262\t\t\treturn nil, ErrCheckpointNotFound\n263\t\t}\n264\t\n265\t\tresult := &SessionContent{}\n266\t\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n267\t\n268\t\tif metadataFile, fileErr := sessionFT.File(paths.MetadataFileName); fileErr == nil {\n269\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n270\t\t\t\tif jsonErr := json.Unmarshal([]byte(content), &result.Metadata); jsonErr != nil {\n271\t\t\t\t\treturn nil, fmt.Errorf(\"failed to parse session metadata: %w\", jsonErr)\n272\t\t\t\t}\n273\t\t\t}\n274\t\t}\n275\t\n276\t\tif file, fileErr := sessionFT.File(paths.PromptFileName); fileErr == nil {\n277\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n278\t\t\t\tresult.Prompts = content\n279\t\t\t}\n280\t\t}\n281\t\n282\t\t// Read compact transcript from the same session tree (avoids a second tree walk).\n283\t\tif compactFile, fileErr := sessionFT.File(paths.CompactTranscriptFileName); fileErr == nil {\n284\t\t\tif content, contentErr := compactFile.Contents(); contentErr == nil && content != \"\" {\n285\t\t\t\tresult.Transcript = []byte(content)\n286\t\t\t}\n287\t\t}\n288\t\n289\t\treturn result, nil\n290\t}\n291\t\n292\t// ReadSessionContent reads a session's metadata and prompts from the v2 /main ref,\n293\t// and the raw transcript (raw_transcript) from /full/* refs (current + archived generations).\n294\t// This is the v2 equivalent of GitStore.ReadSessionContent — it reads the raw agent\n295\t// transcript, not the compact transcript.jsonl. Used by resume and RestoreLogsOnly.\n296\t// Returns ErrNoTranscript if the session exists but no raw transcript is available.\n297\t// Returns ErrCheckpointNotFound if the checkpoint or session doesn't exist on /main.\n298\tfunc (s *V2GitStore) ReadSessionContent(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error) {\n299\t\tif err := ctx.Err(); err != nil {\n300\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n301\t\t}\n302\t\n303\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n304\t\t_, rootTreeHash, err := s.GetRefState(refName)\n305\t\tif err != nil {\n306\t\t\treturn nil, ErrCheckpointNotFound\n307\t\t}\n308\t\n309\t\trootTree, err := s.repo.TreeObject(rootTreeHash)\n310\t\tif err != nil {\n311\t\t\treturn nil, ErrCheckpointNotFound\n312\t\t}\n313\t\n314\t\tcpTree, err := rootTree.Tree(checkpointID.Path())\n315\t\tif err != nil {\n316\t\t\treturn nil, ErrCheckpointNotFound\n317\t\t}\n318\t\n319\t\tsessionDir := strconv.Itoa(sessionIndex)\n320\t\tsessionTree, err := cpTree.Tree(sessionDir)\n321\t\tif err != nil {\n322\t\t\treturn nil, fmt.Errorf(\"session %d not found: %w\", sessionIndex, err)\n323\t\t}\n324\t\n325\t\tresult := &SessionContent{}\n326\t\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n327\t\n328\t\tif metadataFile, fileErr := sessionFT.File(paths.MetadataFileName); fileErr == nil {\n329\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n330\t\t\t\tif jsonErr := json.Unmarshal([]byte(content), &result.Metadata); jsonErr != nil {\n331\t\t\t\t\treturn nil, fmt.Errorf(\"failed to parse session metadata: %w\", jsonErr)\n332\t\t\t\t}\n333\t\t\t}\n334\t\t}\n335\t\n336\t\tif file, fileErr := sessionFT.File(paths.PromptFileName); fileErr == nil {\n337\t\t\tif content, contentErr := file.Contents(); contentErr == nil {\n338\t\t\t\tresult.Prompts = content\n339\t\t\t}\n340\t\t}\n341\t\n342\t\ttranscript, transcriptErr := s.readTranscriptFromFullRefs(ctx, checkpointID, sessionIndex, result.Metadata.Agent)\n343\t\tif transcriptErr != nil {\n344\t\t\treturn nil, fmt.Errorf(\"failed to read transcript from /full/* refs: %w\", transcriptErr)\n345\t\t}\n346\t\tif len(transcript) == 0 {\n347\t\t\treturn nil, ErrNoTranscript\n348\t\t}\n349\t\tresult.Transcript = transcript\n350\t\n351\t\treturn result, nil\n352\t}\n353\t\n354\t// readTranscriptFromFullRefs reads the raw transcript for a checkpoint session\n355\t// by searching /full/current first, then archived generations in reverse order.\n356\t// If not found locally, attempts to discover and fetch remote /full/* refs.\n357\tfunc (s *V2GitStore) readTranscriptFromFullRefs(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int, agentType types.AgentType) ([]byte, error) {\n358\t\tif err := ctx.Err(); err != nil {\n359\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n360\t\t}\n361\t\n362\t\tsessionPath := fmt.Sprintf(\"%s/%d\", checkpointID.Path(), sessionIndex)\n363\t\n364\t\t// Search locally first\n365\t\ttranscript, err := s.readTranscriptFromRef(plumbing.ReferenceName(paths.V2FullCurrentRefName), sessionPath, agentType)\n366\t\tif err == nil && len(transcript) > 0 {\n367\t\t\treturn transcript, nil\n368\t\t}\n369\t\n370\t\tarchived, err := s.ListArchivedGenerations()\n371\t\tif err != nil {\n372\t\t\treturn nil, err\n373\t\t}\n374\t\tfor i := len(archived) - 1; i >= 0; i-- {\n375\t\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + archived[i])\n376\t\t\ttranscript, err := s.readTranscriptFromRef(refName, sessionPath, agentType)\n377\t\t\tif err == nil && len(transcript) > 0 {\n378\t\t\t\treturn transcript, nil\n379\t\t\t}\n380\t\t}\n381\t\n382\t\t// Not found locally — try fetching remote /full/* refs\n383\t\tif fetchErr := s.fetchRemoteFullRefs(ctx); fetchErr != nil {\n384\t\t\tlogging.Debug(ctx, \"failed to fetch remote /full/* refs\",\n385\t\t\t\tslog.String(\"error\", fetchErr.Error()),\n386\t\t\t)\n387\t\t\treturn nil, nil\n388\t\t}\n389\t\n390\t\t// Search newly fetched refs only\n391\t\tnewArchived, err := s.ListArchivedGenerations()\n392\t\tif err != nil {\n393\t\t\treturn nil, nil //nolint:nilerr // Best-effort: fetch-on-demand failure shouldn't block resume\n394\t\t}\n395\t\texistingSet := make(map[string]bool, len(archived))\n396\t\tfor _, a := range archived {\n397\t\t\texistingSet[a] = true\n398\t\t}\n399\t\tfor i := len(newArchived) - 1; i >= 0; i-- {\n400\t\t\tif existingSet[newArchived[i]] {\n401\t\t\t\tcontinue\n402\t\t\t}\n403\t\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + newArchived[i])\n404\t\t\ttranscript, err := s.readTranscriptFromRef(refName, sessionPath, agentType)\n405\t\t\tif err == nil && len(transcript) > 0 {\n406\t\t\t\treturn transcript, nil\n407\t\t\t}\n408\t\t}\n409\t\n410\t\t// Also retry /full/current in case it was updated by the fetch\n411\t\ttranscript, err = s.readTranscriptFromRef(plumbing.ReferenceName(paths.V2FullCurrentRefName), sessionPath, agentType)\n412\t\tif err == nil && len(transcript) > 0 {\n413\t\t\treturn transcript, nil\n414\t\t}\n415\t\n416\t\treturn nil, nil\n417\t}\n418\t\n419\t// fetchRemoteFullRefs discovers and fetches /full/* refs from the configured\n420\t// FetchRemote that aren't local.\n421\tfunc (s *V2GitStore) fetchRemoteFullRefs(ctx context.Context) error {\n422\t\tctx, cancel := context.WithTimeout(ctx, 2*time.Minute)\n423\t\tdefer cancel()\n424\t\n425\t\tlsCmd := exec.CommandContext(ctx, \"git\", \"ls-remote\", s.FetchRemote, paths.V2FullRefPrefix+\"*\")\n426\t\toutput, err := lsCmd.Output()\n427\t\tif err != nil {\n428\t\t\treturn fmt.Errorf(\"ls-remote failed: %w\", err)\n429\t\t}\n430\t\n431\t\tvar refSpecs []string\n432\t\tfor _, line := range strings.Split(strings.TrimSpace(string(output)), \"\\n\") {\n433\t\t\tif line == \"\" {\n434\t\t\t\tcontinue\n435\t\t\t}\n436\t\t\tparts := strings.Fields(line)\n437\t\t\tif len(parts) < 2 {\n438\t\t\t\tcontinue\n439\t\t\t}\n440\t\t\tremoteRefName := parts[1]\n441\t\n442\t\t\t// Skip refs that already exist locally\n443\t\t\tif _, refErr := s.repo.Reference(plumbing.ReferenceName(remoteRefName), true); refErr == nil {\n444\t\t\t\tcontinue\n445\t\t\t}\n446\t\n447\t\t\trefSpecs = append(refSpecs, fmt.Sprintf(\"+%s:%s\", remoteRefName, remoteRefName))\n448\t\t}\n449\t\n450\t\tif len(refSpecs) == 0 {\n451\t\t\treturn nil\n452\t\t}\n453\t\n454\t\targs := append([]string{\"fetch\", \"--no-tags\", s.FetchRemote}, refSpecs...)\n455\t\tfetchCmd := exec.CommandContext(ctx, \"git\", args...)\n456\t\tif fetchOutput, fetchErr := fetchCmd.CombinedOutput(); fetchErr != nil {\n457\t\t\treturn fmt.Errorf(\"fetch failed: %s\", fetchOutput)\n458\t\t}\n459\t\n460\t\treturn nil\n461\t}\n462\t\n463\t// readTranscriptFromRef reads the raw transcript from a specific /full/* ref.\n464\t// Follows the same chunking convention as readTranscriptFromTree in committed.go:\n465\t// chunk 0 is the base file (raw_transcript), chunks 1+ are raw_transcript.001, .002, etc.\n466\t// When chunk files exist, all chunks (including chunk 0) are reassembled using\n467\t// agent-aware reassembly via agent.ReassembleTranscript.\n468\tfunc (s *V2GitStore) readTranscriptFromRef(refName plumbing.ReferenceName, sessionPath string, agentType types.AgentType) ([]byte, error) {\n469\t\t_, rootTreeHash, err := s.GetRefState(refName)\n470\t\tif err != nil {\n471\t\t\treturn nil, err\n472\t\t}\n473\t\n474\t\trootTree, err := s.repo.TreeObject(rootTreeHash)\n475\t\tif err != nil {\n476\t\t\treturn nil, fmt.Errorf(\"failed to read tree: %w\", err)\n477\t\t}\n478\t\n479\t\tsessionTree, err := rootTree.Tree(sessionPath)\n480\t\tif err != nil {\n481\t\t\treturn nil, fmt.Errorf(\"session path %s not found: %w\", sessionPath, err)\n482\t\t}\n483\t\n484\t\treturn readTranscriptFromObjectTree(sessionTree, agentType)\n485\t}\n486\t\n487\t// readTranscriptFromObjectTree reads and reassembles a transcript from a git tree object.\n488\t// Handles both chunked and non-chunked transcripts. Uses agent-aware reassembly\n489\t// when agentType is known, falling back to JSONL reassembly otherwise.\n490\tfunc readTranscriptFromObjectTree(tree *object.Tree, agentType types.AgentType) ([]byte, error) {\n491\t\tvar chunkFiles []string\n492\t\tvar hasBaseFile bool\n493\t\n494\t\tfor _, entry := range tree.Entries {\n495\t\t\tif entry.Name == paths.V2RawTranscriptFileName {\n496\t\t\t\thasBaseFile = true\n497\t\t\t}\n498\t\t\tif strings.HasPrefix(entry.Name, paths.V2RawTranscriptFileName+\".\") {\n499\t\t\t\tidx := agent.ParseChunkIndex(entry.Name, paths.V2RawTranscriptFileName)\n500\t\t\t\tif idx > 0 {\n501\t\t\t\t\tchunkFiles = append(chunkFiles, entry.Name)\n502\t\t\t\t}\n503\t\t\t}\n504\t\t}\n505\t\n506\t\t// If chunk files exist, reassemble all chunks (base file is chunk 0)\n507\t\tif len(chunkFiles) > 0 {\n508\t\t\tchunkFiles = agent.SortChunkFiles(chunkFiles, paths.V2RawTranscriptFileName)\n509\t\t\tif hasBaseFile {\n510\t\t\t\tchunkFiles = append([]string{paths.V2RawTranscriptFileName}, chunkFiles...)\n511\t\t\t}\n512\t\n513\t\t\tvar chunks [][]byte\n514\t\t\tfor _, chunkFile := range chunkFiles {\n515\t\t\t\tfile, fileErr := tree.File(chunkFile)\n516\t\t\t\tif fileErr != nil {\n517\t\t\t\t\tcontinue\n518\t\t\t\t}\n519\t\t\t\tcontent, contentErr := file.Contents()\n520\t\t\t\tif contentErr != nil {\n521\t\t\t\t\tcontinue\n522\t\t\t\t}\n523\t\t\t\tchunks = append(chunks, []byte(content))\n524\t\t\t}\n525\t\n526\t\t\tif len(chunks) > 0 {\n527\t\t\t\tresult, reassembleErr := agent.ReassembleTranscript(chunks, agentType)\n528\t\t\t\tif reassembleErr != nil {\n529\t\t\t\t\treturn nil, fmt.Errorf(\"failed to reassemble transcript: %w\", reassembleErr)\n530\t\t\t\t}\n531\t\t\t\treturn result, nil\n532\t\t\t}\n533\t\t}\n534\t\n535\t\t// No chunk files — read base file directly (non-chunked transcript)\n536\t\tif hasBaseFile {\n537\t\t\tfile, err := tree.File(paths.V2RawTranscriptFileName)\n538\t\t\tif err == nil {\n539\t\t\t\tcontent, contentErr := file.Contents()\n540\t\t\t\tif contentErr == nil {\n541\t\t\t\t\treturn []byte(content), nil\n542\t\t\t\t}\n543\t\t\t}\n544\t\t}\n545\t\n546\t\treturn nil, nil\n547\t}\n548\t\n549\t// ReadSessionContentByID finds the session with the given sessionID in a checkpoint\n550\t// and returns its content. Mirrors GitStore.ReadSessionContentByID for v2 refs.\n551\t// Returns ErrCheckpointNotFound if the checkpoint doesn't exist; returns a\n552\t// non-wrapped error (containing the session ID and checkpoint ID for context)\n553\t// if no session in the checkpoint matches sessionID.\n554\tfunc (s *V2GitStore) ReadSessionContentByID(ctx context.Context, checkpointID id.CheckpointID, sessionID string) (*SessionContent, error) {\n555\t\tsummary, err := s.ReadCommitted(ctx, checkpointID)\n556\t\tif err != nil {\n557\t\t\treturn nil, err\n558\t\t}\n559\t\tif summary == nil {\n560\t\t\treturn nil, ErrCheckpointNotFound\n561\t\t}\n562\t\n563\t\tfor i := range summary.Sessions {\n564\t\t\tcontent, readErr := s.ReadSessionContent(ctx, checkpointID, i)\n565\t\t\tif readErr != nil {\n566\t\t\t\tcontinue\n567\t\t\t}\n568\t\t\tif content != nil && content.Metadata.SessionID == sessionID {\n569\t\t\t\treturn content, nil\n570\t\t\t}\n571\t\t}\n572\t\n573\t\treturn nil, fmt.Errorf(\"session %q not found in checkpoint %s\", sessionID, checkpointID)\n574\t}\n575\t\n576\t// GetSessionLog reads the latest session's raw transcript and session ID from v2 refs.\n577\t// Convenience wrapper matching the GitStore.GetSessionLog signature.\n578\tfunc (s *V2GitStore) GetSessionLog(ctx context.Context, cpID id.CheckpointID) ([]byte, string, error) {\n579\t\tsummary, err := s.ReadCommitted(ctx, cpID)\n580\t\tif err != nil {\n581\t\t\treturn nil, \"\", err\n582\t\t}\n583\t\tif summary == nil {\n584\t\t\treturn nil, \"\", ErrCheckpointNotFound\n585\t\t}\n586\t\tif len(summary.Sessions) == 0 {\n587\t\t\treturn nil, \"\", ErrCheckpointNotFound\n588\t\t}\n589\t\n590\t\tlatestIndex := len(summary.Sessions) - 1\n591\t\tcontent, err := s.ReadSessionContent(ctx, cpID, latestIndex)\n592\t\tif err != nil {\n593\t\t\treturn nil, \"\", err\n594\t\t}\n595\t\treturn content.Transcript, content.Metadata.SessionID, nil\n596\t}\n597\t"}]},"uuid":"bda0c90d-8e13-4f78-ad43-520650a48c48","timestamp":"2026-05-05T21:19:49.281Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/ninawork/entire/devenv/cli/cmd/entire/cli/checkpoint/v2_read.go","content":"package checkpoint\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os/exec\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\n\t\"github.com/go-git/go-git/v6/plumbing\"\n\t\"github.com/go-git/go-git/v6/plumbing/object\"\n)\n\n// ReadCommitted reads the checkpoint summary from the v2 /main ref.\n// Returns nil, nil if the checkpoint doesn't exist (same contract as GitStore.ReadCommitted).\nfunc (s *V2GitStore) ReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*CheckpointSummary, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n\t_, rootTreeHash, err := s.GetRefState(refName)\n\tif err != nil {\n\t\treturn nil, nil //nolint:nilnil,nilerr // Ref doesn't exist means no checkpoint\n\t}\n\n\trootTree, err := s.repo.TreeObject(rootTreeHash)\n\tif err != nil {\n\t\treturn nil, nil //nolint:nilnil,nilerr // Tree not readable\n\t}\n\n\tcpTree, err := rootTree.Tree(checkpointID.Path())\n\tif err != nil {\n\t\treturn nil, nil //nolint:nilnil,nilerr // Checkpoint subtree not found\n\t}\n\n\tcpFT := s.wrapWithFetcher(ctx, cpTree)\n\tmetadataFile, err := cpFT.File(paths.MetadataFileName)\n\tif err != nil {\n\t\treturn nil, nil //nolint:nilnil,nilerr // metadata.json not found\n\t}\n\n\tcontent, err := metadataFile.Contents()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read metadata.json: %w\", err)\n\t}\n\n\tvar summary CheckpointSummary\n\tif err := json.Unmarshal([]byte(content), &summary); err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to parse metadata.json: %w\", err)\n\t}\n\n\treturn &summary, nil\n}\n\n// ListCommitted lists all committed checkpoints from the v2 /main ref.\n// Scans sharded paths: <id[:2]>/<id[2:]>/ directories containing metadata.json.\nfunc (s *V2GitStore) ListCommitted(ctx context.Context) ([]CommittedInfo, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n\t_, rootTreeHash, err := s.GetRefState(refName)\n\tif err != nil {\n\t\treturn []CommittedInfo{}, nil //nolint:nilerr // No /main ref means empty list\n\t}\n\n\trootTree, err := s.repo.TreeObject(rootTreeHash)\n\tif err != nil {\n\t\treturn []CommittedInfo{}, nil //nolint:nilerr // Unreadable tree means no listable entries\n\t}\n\n\tvar checkpoints []CommittedInfo\n\n\t_ = WalkCheckpointShards(s.repo, rootTree, func(checkpointID id.CheckpointID, cpTreeHash plumbing.Hash) error { //nolint:errcheck // callback never returns errors\n\t\tcheckpointTree, cpTreeErr := s.repo.TreeObject(cpTreeHash)\n\t\tif cpTreeErr != nil {\n\t\t\tlogging.Debug(ctx, \"v2 ListCommitted: skipping unreadable checkpoint tree\",\n\t\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n\t\t\t\tslog.String(\"error\", cpTreeErr.Error()))\n\t\t\treturn nil\n\t\t}\n\n\t\tinfo := CommittedInfo{CheckpointID: checkpointID}\n\n\t\tif metadataFile, fileErr := checkpointTree.File(paths.MetadataFileName); fileErr == nil {\n\t\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n\t\t\t\tvar summary CheckpointSummary\n\t\t\t\tif unmarshalErr := json.Unmarshal([]byte(content), &summary); unmarshalErr != nil {\n\t\t\t\t\tlogging.Debug(ctx, \"v2 ListCommitted: skipping malformed metadata\",\n\t\t\t\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n\t\t\t\t\t\tslog.String(\"error\", unmarshalErr.Error()))\n\t\t\t\t} else {\n\t\t\t\t\tinfo.CheckpointsCount = summary.CheckpointsCount\n\t\t\t\t\tinfo.FilesTouched = summary.FilesTouched\n\t\t\t\t\tinfo.SessionCount = len(summary.Sessions)\n\n\t\t\t\t\tif len(summary.Sessions) > 0 {\n\t\t\t\t\t\tlatestIndex := len(summary.Sessions) - 1\n\t\t\t\t\t\tlatestDir := strconv.Itoa(latestIndex)\n\t\t\t\t\t\tif sessionTree, treeErr := checkpointTree.Tree(latestDir); treeErr == nil {\n\t\t\t\t\t\t\tif sessionMetadataFile, smErr := sessionTree.File(paths.MetadataFileName); smErr == nil {\n\t\t\t\t\t\t\t\tif sessionContent, scErr := sessionMetadataFile.Contents(); scErr == nil {\n\t\t\t\t\t\t\t\t\tvar sessionMetadata CommittedMetadata\n\t\t\t\t\t\t\t\t\tif json.Unmarshal([]byte(sessionContent), &sessionMetadata) == nil {\n\t\t\t\t\t\t\t\t\t\tinfo.Agent = sessionMetadata.Agent\n\t\t\t\t\t\t\t\t\t\tinfo.SessionID = sessionMetadata.SessionID\n\t\t\t\t\t\t\t\t\t\tinfo.CreatedAt = sessionMetadata.CreatedAt\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tcheckpoints = append(checkpoints, info)\n\t\treturn nil\n\t})\n\n\tsort.Slice(checkpoints, func(i, j int) bool {\n\t\treturn checkpoints[i].CreatedAt.After(checkpoints[j].CreatedAt)\n\t})\n\n\treturn checkpoints, nil\n}\n\n// ReadSessionCompactTranscript reads transcript.jsonl for a session from the v2\n// /main ref. Returns ErrNoTranscript when compact transcript is missing.\nfunc (s *V2GitStore) ReadSessionCompactTranscript(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) ([]byte, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n\t_, rootTreeHash, err := s.GetRefState(refName)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\trootTree, err := s.repo.TreeObject(rootTreeHash)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tcpTree, err := rootTree.Tree(checkpointID.Path())\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tsessionDir := strconv.Itoa(sessionIndex)\n\tsessionTree, err := cpTree.Tree(sessionDir)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n\tcompactFile, err := sessionFT.File(paths.CompactTranscriptFileName)\n\tif err != nil {\n\t\treturn nil, ErrNoTranscript\n\t}\n\n\tcontent, err := compactFile.Contents()\n\tif err != nil {\n\t\treturn nil, ErrNoTranscript\n\t}\n\tif content == \"\" {\n\t\treturn nil, ErrNoTranscript\n\t}\n\n\treturn []byte(content), nil\n}\n\n// ReadSessionMetadata reads only the session's metadata.json from the v2\n// /main ref — cheaper than ReadSessionMetadataAndPrompts when the caller\n// only needs metadata fields (e.g. SessionID). Returns ErrCheckpointNotFound\n// if the checkpoint or session doesn't exist on /main.\nfunc (s *V2GitStore) ReadSessionMetadata(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (CommittedMetadata, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn CommittedMetadata{}, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n\t_, rootTreeHash, err := s.GetRefState(refName)\n\tif err != nil {\n\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n\t}\n\n\trootTree, err := s.repo.TreeObject(rootTreeHash)\n\tif err != nil {\n\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n\t}\n\n\tcpTree, err := rootTree.Tree(checkpointID.Path())\n\tif err != nil {\n\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n\t}\n\n\tsessionTree, err := cpTree.Tree(strconv.Itoa(sessionIndex))\n\tif err != nil {\n\t\treturn CommittedMetadata{}, ErrCheckpointNotFound\n\t}\n\n\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n\tmetadataFile, err := sessionFT.File(paths.MetadataFileName)\n\tif err != nil {\n\t\treturn CommittedMetadata{}, fmt.Errorf(\"read session metadata file: %w\", err)\n\t}\n\tcontent, err := metadataFile.Contents()\n\tif err != nil {\n\t\treturn CommittedMetadata{}, fmt.Errorf(\"read session metadata contents: %w\", err)\n\t}\n\n\tvar meta CommittedMetadata\n\tif err := json.Unmarshal([]byte(content), &meta); err != nil {\n\t\treturn CommittedMetadata{}, fmt.Errorf(\"parse session metadata: %w\", err)\n\t}\n\treturn meta, nil\n}\n\n// ReadSessionMetadataAndPrompts reads a session's metadata and prompts from the\n// v2 /main ref without requiring the raw transcript from /full/* refs.\n// Used by explain when the raw transcript is unavailable but compact transcript\n// (transcript.jsonl) on /main can substitute for display.\n// Returns ErrCheckpointNotFound if the checkpoint or session doesn't exist on /main.\nfunc (s *V2GitStore) ReadSessionMetadataAndPrompts(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n\t_, rootTreeHash, err := s.GetRefState(refName)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\trootTree, err := s.repo.TreeObject(rootTreeHash)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tcpTree, err := rootTree.Tree(checkpointID.Path())\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tsessionDir := strconv.Itoa(sessionIndex)\n\tsessionTree, err := cpTree.Tree(sessionDir)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tresult := &SessionContent{}\n\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n\n\tif metadataFile, fileErr := sessionFT.File(paths.MetadataFileName); fileErr == nil {\n\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n\t\t\tif jsonErr := json.Unmarshal([]byte(content), &result.Metadata); jsonErr != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"failed to parse session metadata: %w\", jsonErr)\n\t\t\t}\n\t\t}\n\t}\n\n\tif file, fileErr := sessionFT.File(paths.PromptFileName); fileErr == nil {\n\t\tif content, contentErr := file.Contents(); contentErr == nil {\n\t\t\tresult.Prompts = content\n\t\t}\n\t}\n\n\t// Read compact transcript from the same session tree (avoids a second tree walk).\n\tif compactFile, fileErr := sessionFT.File(paths.CompactTranscriptFileName); fileErr == nil {\n\t\tif content, contentErr := compactFile.Contents(); contentErr == nil && content != \"\" {\n\t\t\tresult.Transcript = []byte(content)\n\t\t}\n\t}\n\n\treturn result, nil\n}\n\n// ReadSessionContent reads a session's metadata and prompts from the v2 /main ref,\n// and the raw transcript (raw_transcript) from /full/* refs (current + archived generations).\n// This is the v2 equivalent of GitStore.ReadSessionContent — it reads the raw agent\n// transcript, not the compact transcript.jsonl. Used by resume and RestoreLogsOnly.\n// Returns ErrNoTranscript if the session exists but no raw transcript is available.\n// Returns ErrCheckpointNotFound if the checkpoint or session doesn't exist on /main.\nfunc (s *V2GitStore) ReadSessionContent(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n\t_, rootTreeHash, err := s.GetRefState(refName)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\trootTree, err := s.repo.TreeObject(rootTreeHash)\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tcpTree, err := rootTree.Tree(checkpointID.Path())\n\tif err != nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tsessionDir := strconv.Itoa(sessionIndex)\n\tsessionTree, err := cpTree.Tree(sessionDir)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"session %d not found: %w\", sessionIndex, err)\n\t}\n\n\tresult := &SessionContent{}\n\tsessionFT := s.wrapWithFetcher(ctx, sessionTree)\n\n\tif metadataFile, fileErr := sessionFT.File(paths.MetadataFileName); fileErr == nil {\n\t\tif content, contentErr := metadataFile.Contents(); contentErr == nil {\n\t\t\tif jsonErr := json.Unmarshal([]byte(content), &result.Metadata); jsonErr != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"failed to parse session metadata: %w\", jsonErr)\n\t\t\t}\n\t\t}\n\t}\n\n\tif file, fileErr := sessionFT.File(paths.PromptFileName); fileErr == nil {\n\t\tif content, contentErr := file.Contents(); contentErr == nil {\n\t\t\tresult.Prompts = content\n\t\t}\n\t}\n\n\ttranscript, transcriptErr := s.readTranscriptFromFullRefs(ctx, checkpointID, sessionIndex, result.Metadata.Agent)\n\tif transcriptErr != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read transcript from /full/* refs: %w\", transcriptErr)\n\t}\n\tif len(transcript) == 0 {\n\t\treturn nil, ErrNoTranscript\n\t}\n\tresult.Transcript = transcript\n\n\treturn result, nil\n}\n\n// readTranscriptFromFullRefs reads the raw transcript for a checkpoint session\n// by searching /full/current first, then archived generations in reverse order.\n// If not found locally, attempts to discover and fetch remote /full/* refs.\nfunc (s *V2GitStore) readTranscriptFromFullRefs(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int, agentType types.AgentType) ([]byte, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\tsessionPath := fmt.Sprintf(\"%s/%d\", checkpointID.Path(), sessionIndex)\n\n\t// Search locally first\n\ttranscript, err := s.readTranscriptFromRef(plumbing.ReferenceName(paths.V2FullCurrentRefName), sessionPath, agentType)\n\tif err == nil && len(transcript) > 0 {\n\t\treturn transcript, nil\n\t}\n\n\tarchived, err := s.ListArchivedGenerations()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfor i := len(archived) - 1; i >= 0; i-- {\n\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + archived[i])\n\t\ttranscript, err := s.readTranscriptFromRef(refName, sessionPath, agentType)\n\t\tif err == nil && len(transcript) > 0 {\n\t\t\treturn transcript, nil\n\t\t}\n\t}\n\n\t// Not found locally — try fetching remote /full/* refs\n\tif fetchErr := s.fetchRemoteFullRefs(ctx); fetchErr != nil {\n\t\tlogging.Debug(ctx, \"failed to fetch remote /full/* refs\",\n\t\t\tslog.String(\"error\", fetchErr.Error()),\n\t\t)\n\t\treturn nil, nil\n\t}\n\n\t// Search newly fetched refs only\n\tnewArchived, err := s.ListArchivedGenerations()\n\tif err != nil {\n\t\treturn nil, nil //nolint:nilerr // Best-effort: fetch-on-demand failure shouldn't block resume\n\t}\n\texistingSet := make(map[string]bool, len(archived))\n\tfor _, a := range archived {\n\t\texistingSet[a] = true\n\t}\n\tfor i := len(newArchived) - 1; i >= 0; i-- {\n\t\tif existingSet[newArchived[i]] {\n\t\t\tcontinue\n\t\t}\n\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + newArchived[i])\n\t\ttranscript, err := s.readTranscriptFromRef(refName, sessionPath, agentType)\n\t\tif err == nil && len(transcript) > 0 {\n\t\t\treturn transcript, nil\n\t\t}\n\t}\n\n\t// Also retry /full/current in case it was updated by the fetch\n\ttranscript, err = s.readTranscriptFromRef(plumbing.ReferenceName(paths.V2FullCurrentRefName), sessionPath, agentType)\n\tif err == nil && len(transcript) > 0 {\n\t\treturn transcript, nil\n\t}\n\n\treturn nil, nil\n}\n\n// fetchRemoteFullRefs discovers and fetches /full/* refs from the configured\n// FetchRemote that aren't local.\nfunc (s *V2GitStore) fetchRemoteFullRefs(ctx context.Context) error {\n\tctx, cancel := context.WithTimeout(ctx, 2*time.Minute)\n\tdefer cancel()\n\n\tlsCmd := exec.CommandContext(ctx, \"git\", \"ls-remote\", s.FetchRemote, paths.V2FullRefPrefix+\"*\")\n\toutput, err := lsCmd.Output()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ls-remote failed: %w\", err)\n\t}\n\n\tvar refSpecs []string\n\tfor _, line := range strings.Split(strings.TrimSpace(string(output)), \"\\n\") {\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tparts := strings.Fields(line)\n\t\tif len(parts) < 2 {\n\t\t\tcontinue\n\t\t}\n\t\tremoteRefName := parts[1]\n\n\t\t// Skip refs that already exist locally\n\t\tif _, refErr := s.repo.Reference(plumbing.ReferenceName(remoteRefName), true); refErr == nil {\n\t\t\tcontinue\n\t\t}\n\n\t\trefSpecs = append(refSpecs, fmt.Sprintf(\"+%s:%s\", remoteRefName, remoteRefName))\n\t}\n\n\tif len(refSpecs) == 0 {\n\t\treturn nil\n\t}\n\n\targs := append([]string{\"fetch\", \"--no-tags\", s.FetchRemote}, refSpecs...)\n\tfetchCmd := exec.CommandContext(ctx, \"git\", args...)\n\tif fetchOutput, fetchErr := fetchCmd.CombinedOutput(); fetchErr != nil {\n\t\treturn fmt.Errorf(\"fetch failed: %s\", fetchOutput)\n\t}\n\n\treturn nil\n}\n\n// readTranscriptFromRef reads the raw transcript from a specific /full/* ref.\n// Follows the same chunking convention as readTranscriptFromTree in committed.go:\n// chunk 0 is the base file (raw_transcript), chunks 1+ are raw_transcript.001, .002, etc.\n// When chunk files exist, all chunks (including chunk 0) are reassembled using\n// agent-aware reassembly via agent.ReassembleTranscript.\nfunc (s *V2GitStore) readTranscriptFromRef(refName plumbing.ReferenceName, sessionPath string, agentType types.AgentType) ([]byte, error) {\n\t_, rootTreeHash, err := s.GetRefState(refName)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\trootTree, err := s.repo.TreeObject(rootTreeHash)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read tree: %w\", err)\n\t}\n\n\tsessionTree, err := rootTree.Tree(sessionPath)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"session path %s not found: %w\", sessionPath, err)\n\t}\n\n\treturn readTranscriptFromObjectTree(sessionTree, agentType)\n}\n\n// readTranscriptFromObjectTree reads and reassembles a transcript from a git tree object.\n// Handles both chunked and non-chunked transcripts. Uses agent-aware reassembly\n// when agentType is known, falling back to JSONL reassembly otherwise.\nfunc readTranscriptFromObjectTree(tree *object.Tree, agentType types.AgentType) ([]byte, error) {\n\tvar chunkFiles []string\n\tvar hasBaseFile bool\n\n\tfor _, entry := range tree.Entries {\n\t\tif entry.Name == paths.V2RawTranscriptFileName {\n\t\t\thasBaseFile = true\n\t\t}\n\t\tif strings.HasPrefix(entry.Name, paths.V2RawTranscriptFileName+\".\") {\n\t\t\tidx := agent.ParseChunkIndex(entry.Name, paths.V2RawTranscriptFileName)\n\t\t\tif idx > 0 {\n\t\t\t\tchunkFiles = append(chunkFiles, entry.Name)\n\t\t\t}\n\t\t}\n\t}\n\n\t// If chunk files exist, reassemble all chunks (base file is chunk 0)\n\tif len(chunkFiles) > 0 {\n\t\tchunkFiles = agent.SortChunkFiles(chunkFiles, paths.V2RawTranscriptFileName)\n\t\tif hasBaseFile {\n\t\t\tchunkFiles = append([]string{paths.V2RawTranscriptFileName}, chunkFiles...)\n\t\t}\n\n\t\tvar chunks [][]byte\n\t\tfor _, chunkFile := range chunkFiles {\n\t\t\tfile, fileErr := tree.File(chunkFile)\n\t\t\tif fileErr != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tcontent, contentErr := file.Contents()\n\t\t\tif contentErr != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tchunks = append(chunks, []byte(content))\n\t\t}\n\n\t\tif len(chunks) > 0 {\n\t\t\tresult, reassembleErr := agent.ReassembleTranscript(chunks, agentType)\n\t\t\tif reassembleErr != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"failed to reassemble transcript: %w\", reassembleErr)\n\t\t\t}\n\t\t\treturn result, nil\n\t\t}\n\t}\n\n\t// No chunk files — read base file directly (non-chunked transcript)\n\tif hasBaseFile {\n\t\tfile, err := tree.File(paths.V2RawTranscriptFileName)\n\t\tif err == nil {\n\t\t\tcontent, contentErr := file.Contents()\n\t\t\tif contentErr == nil {\n\t\t\t\treturn []byte(content), nil\n\t\t\t}\n\t\t}\n\t}\n\n\treturn nil, nil\n}\n\n// ReadSessionContentByID finds the session with the given sessionID in a checkpoint\n// and returns its content. Mirrors GitStore.ReadSessionContentByID for v2 refs.\n// Returns ErrCheckpointNotFound if the checkpoint doesn't exist; returns a\n// non-wrapped error (containing the session ID and checkpoint ID for context)\n// if no session in the checkpoint matches sessionID.\nfunc (s *V2GitStore) ReadSessionContentByID(ctx context.Context, checkpointID id.CheckpointID, sessionID string) (*SessionContent, error) {\n\tsummary, err := s.ReadCommitted(ctx, checkpointID)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif summary == nil {\n\t\treturn nil, ErrCheckpointNotFound\n\t}\n\n\tfor i := range summary.Sessions {\n\t\tcontent, readErr := s.ReadSessionContent(ctx, checkpointID, i)\n\t\tif readErr != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif content != nil && content.Metadata.SessionID == sessionID {\n\t\t\treturn content, nil\n\t\t}\n\t}\n\n\treturn nil, fmt.Errorf(\"session %q not found in checkpoint %s\", sessionID, checkpointID)\n}\n\n// GetSessionLog reads the latest session's raw transcript and session ID from v2 refs.\n// Convenience wrapper matching the GitStore.GetSessionLog signature.\nfunc (s *V2GitStore) GetSessionLog(ctx context.Context, cpID id.CheckpointID) ([]byte, string, error) {\n\tsummary, err := s.ReadCommitted(ctx, cpID)\n\tif err != nil {\n\t\treturn nil, \"\", err\n\t}\n\tif summary == nil {\n\t\treturn nil, \"\", ErrCheckpointNotFound\n\t}\n\tif len(summary.Sessions) == 0 {\n\t\treturn nil, \"\", ErrCheckpointNotFound\n\t}\n\n\tlatestIndex := len(summary.Sessions) - 1\n\tcontent, err := s.ReadSessionContent(ctx, cpID, latestIndex)\n\tif err != nil {\n\t\treturn nil, \"\", err\n\t}\n\treturn content.Transcript, content.Metadata.SessionID, nil\n}\n","numLines":597,"startLine":1,"totalLines":597}},"sourceToolAssistantUUID":"7d0856f5-bd36-4b1a-8f4b-ea29350fc5ad","userType":"external","entrypoint":"cli","cwd":"/Users/ninawork/entire/devenv/cli","sessionId":"a057aa60-562f-4380-92ab-dd538561e096","version":"2.1.128","gitBranch":"more-migration-speedups"}
