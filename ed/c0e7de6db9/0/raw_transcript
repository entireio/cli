nerationTimestampsFromCommitHistory() GenerationMetadata {\n\tnow := time.Now().UTC()\n\tfallback := GenerationMetadata{OldestCheckpointAt: now, NewestCheckpointAt: now}\n\n\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n\tref, err := s.repo.Reference(refName, true)\n\tif err != nil {\n\t\treturn fallback\n\t}\n\n\tcommit, err := s.repo.CommitObject(ref.Hash())\n\tif err != nil {\n\t\treturn fallback\n\t}\n\n\tnewest := commit.Committer.When.UTC()\n\n\t// Walk parents to find the oldest commit in this generation\n\titer := commit\n\tfor len(iter.ParentHashes) > 0 {\n\t\tparent, parentErr := s.repo.CommitObject(iter.ParentHashes[0])\n\t\tif parentErr != nil {\n\t\t\tbreak\n\t\t}","numLines":80,"startLine":170,"totalLines":630}},"sourceToolAssistantUUID":"4e28cf67-fe44-43d6-811b-ef44713f8b45","userType":"external","entrypoint":"cli","cwd":"/Users/ninawork/entire/devenv/cli","sessionId":"2c55ba91-9feb-4e7e-b027-482db4d32e8b","version":"2.1.139","gitBranch":"main"}
