state\\n\\t\\tadoptReviewEnv(logCtx, &amp;updated)\\n\\t\\tif updated.Kind != state.Kind || updated.ReviewPrompt != state.ReviewPrompt || len(updated.ReviewSkills) != len(state.ReviewSkills) {\\n\\t\\t\\tif saveErr := strategy.SaveSessionState(ctx, &amp;updated); saveErr != nil {\\n\\t\\t\\t\\tlogging.Warn(logCtx, \\\"failed to save session state after review env adoption\\\",\\n\\t\\t\\t\\t\\tslog.String(\\\"error\\\", saveErr.Error()))\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n</code></pre></div>\\n</details>\"},{\"url\":\"https://github.com/entireio/cli/pull/1105#discussion_r3183190747\",\"body\":\"Fixed in 252d61d7d. The save guard now uses `slices.Equal(updated.ReviewSkills, state.ReviewSkills)` so any content change (not just length change) triggers a save. (Practical impact today is small because `adoptReviewEnv` short-circuits when `state.Kind != \\\"\\\"`, so the only transition is nil→populated; but defensive against future refactors that might remove the idempotency guard.)\",\"user\":{\"login\":\"peyton-alt\",\"name\":\"peyton-alt\",\"email\":null,\"avatar_url\":\"https://avatars.githubusercontent.com/u/249787869?v=4\",\"id\":249787869},\"id\":3183190747,\"pull_request_review_id\":4221961622,\"in_reply_to_id\":3183060208,\"created_at\":\"2026-05-04T17:10:56Z\",\"review\":null,\"side\":\"RIGHT\",\"line\":287,\"start_line\":280,\"path\":\"cmd/entire/cli/lifecycle.go\",\"body_html\":\"<p dir=\\\"auto\\\">Fixed in <a class=\\\"commit-link\\\" data-hovercard-type=\\\"commit\\\" data-hovercard-url=\\\"https://github.com/entireio/cli/commit/252d61d7dea3b94694590f5850b10b9f234cbb51/hovercard\\\" href=\\\"https://github.com/entireio/cli/commit/252d61d7dea3b94694590f5850b10b9f234cbb51\\\"><tt>252d61d</tt></a>. The save guard now uses <code class=\\\"notranslate\\\">slices.Equal(updated.ReviewSkills, state.ReviewSkills)</code> so any content change (not just length change) triggers a save. (Practical impact today is small because <code class=\\\"notranslate\\\">adoptReviewEn