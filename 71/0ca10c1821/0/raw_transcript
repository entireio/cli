audeCodeAgent) IsPreview() bool { return false }\n56\t\n57\t// DetectPresence checks if Claude Code is configured in the repository.\n58\tfunc (c *ClaudeCodeAgent) DetectPresence(ctx context.Context) (bool, error) {\n59\t\t// Get worktree root to check for .claude directory\n60\t\t// This is needed because the CLI may be run from a subdirectory\n61\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n62\t\tif err != nil {\n63\t\t\t// Not in a git repo, fall back to CWD-relative check\n64\t\t\trepoRoot = \".\"\n65\t\t}\n66\t\n67\t\t// Check for .claude directory\n68\t\tclaudeDir := filepath.Join(repoRoot, \".claude\")\n69\t\tif _, err := os.Stat(claudeDir); err == nil {\n70\t\t\treturn true, nil\n71\t\t}\n72\t\t// Check for .claude/settings.json\n73\t\tsettingsFile := filepath.Join(repoRoot, \".claude\", \"settings.json\")\n74\t\tif _, err := os.Stat(settingsFile); err == nil {\n75\t\t\treturn true, nil\n76\t\t}\n77\t\treturn false, nil\n78\t}\n79\t\n80\t// GetSessionID extracts the session ID from hook input.\n81\tfunc (c *ClaudeCodeAgent) GetSessionID(input *agent.HookInput) string {\n82\t\treturn input.SessionID\n83\t}\n84\t\n85\t// ResolveSessionFile returns the path to a Claude session file.\n86\t// Claude names files directly as <id>.jsonl.\n87\tfunc (c *ClaudeCodeAgent) ResolveSessionFile(sessionDir, agentSessionID string) string {\n88\t\treturn filepath.Join(sessionDir, agentSessionID+\".jsonl\")\n89\t}\n90\t\n91\t// ProtectedDirs returns directories that Claude uses for config/state.\n92\tfunc (c *ClaudeCodeAgent) ProtectedDirs() []string { return []string{\".claude\"} }\n93\t\n94\t// GetSessionDir returns the directory where Claude stores session transcripts.\n95\tfunc (c *ClaudeCodeAgent) GetSessionDir(repoPath string) (string, error) {\n96\t\t// Check for test environment override\n97\t\tif override := os.Getenv(\"ENTIRE_TEST_CLAUDE_PROJECT_DIR\"); override != \"\" {\n98\t\t\treturn override, nil\n99\t\t}\n100\t\n101\t\thomeDir, err := os.UserHomeDir()\n102\t\tif