755); err != nil {\n\t\tt.Fatalf(\"write exe: %v\", err)\n\t}\n\treturn exe\n}\n\nfunc TestDispatch_NoArgs(t *testing.T) {\n\tt.Parallel()\n\troot := &cobra.Command{Use: \"entire\"}\n\thandled, err := Dispatch(context.Background(), root, nil)\n\tif handled || err != nil {\n\t\tt.Errorf(\"Dispatch(nil) = (%v, %v); want (false, nil)\", handled, err)\n\t}\n}\n\nfunc TestDispatch_FlagsOnly(t *testing.T) {\n\tt.Parallel()\n\troot := &cobra.Command{Use: \"entire\"}\n\thandled, err := Dispatch(context.Background(), root, []string{\"--foo\", \"--bar\"})\n\tif handled || err != nil {\n\t\tt.Errorf(\"flags-only: handled=%v err=%v; want false,nil\", handled, err)\n\t}\n}\n\nfunc TestDispatch_BuiltinTakesPrecedence(t *testing.T) {\n\tt.Parallel()\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"uses Unix shebang scripts\")\n\t}\n\troot := withPluginRoot(t)\n\tinstallFakeScript(t, root, \"status\", \"#!/bin/sh\\nexit 0\\n\")\n\n\trootCmd := &cobra.Command{Use: \"entire\"}\n\trootCmd.AddCommand(&cobra.Command{Use: \"status\"})\n\n\thandled, err := Dispatch(context.Background(), rootCmd, []string{\"status\"})\n\tif handled || err != nil {\n\t\tt.Errorf(\"built-in shadow: handled=%v err=%v; want false,nil\", handled, err)\n\t}\n}\n\nfunc TestDispatch_RunsPlugin(t *testing.T) {\n\tt.Parallel()\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"uses Unix shebang scripts\")\n\t}\n\troot := withPluginRoot(t)\n\t// Fake plugin that exits 0 if first arg is \"ok\", else exits 7.\n\tinstallFakeScript(t, root, \"echo\", \"#!/bin/sh\\nif [ \\\"$1\\\" = \\\"ok\\\" ]; then exit 0; else exit 7; fi\\n\")\n\n\trootCmd := &cobra.Command{Use: \"entire\"}\n\thandled, err := Dispatch(context.Background(), rootCmd, []string{\"echo\", \"ok\"})\n\tif !handled {\n\t\tt.Fatalf(\"plugin not handled: err=%v\", err)\n\t}\n\tif err != nil {\n\t\tt.Errorf(\"Dispatch error: %v\", err)\n\t}\n}\n\nfunc TestDispatch_PropagatesExitCode(t *testing.T) {\n\tt.Parallel()\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"uses Unix shebang scripts\")\n\t}\n\troot := withPluginRoot(t)\n\tinstallFakeScript(t, root, \"fail\", \"#!/bin/sh\\nexit 42\\n\")\n\n\trootCmd := &cobra.Command{Use: \"entire\"}\n\thandled, err := Dispatch(context.Background(), rootCmd, []string{\"fail\"})\n\tif !handled {\n\t\tt.Fatalf(\"expected handled=true; err=%v\", err)\n\t}\n\tif err == nil {\n\t\tt.Fatalf(\"expected non-nil err for non-zero exit\")\n\t}\n\tvar exitErr *exec.ExitError\n\tif !asExitError(err, &exitErr) {\n\t\tt.Fatalf(\"err = %v; want *exec.ExitError\", err)\n\t}\n\tif got := exitErr.ExitCode(); got != 42 {\n\t\tt.Errorf(\"exit code = %d; want 42\", got)\n\t}\n\tif got := PropagateExitCode(err); got != 42 {\n\t\tt.Errorf(\"PropagateExitCode = %d; want 42\", got)\n\t}\n}\n\nfunc TestDispatch_InjectsPluginDataDir(t *testing.T) {\n\tt.Parallel()\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"uses Unix shebang scripts\")\n\t}\n\troot := withPluginRoot(t)\n\tout := filepath.Join(t.TempDir(), \"out\")\n\tbody := \"#!/bin/sh\\nprintf '%s' \\\"$ENTIRE_PLUGIN_DATA_DIR\\\" > \" + out + \"\\n\"\n\tinstallFakeScript(t, root, \"envprobe\", body)\n\n\trootCmd := &cobra.Command{Use: \"entire\"}\n\tif _, err := Dispatch(context.Background(), rootCmd, []string{\"envprobe\"}); err != nil {\n\t\tt.Fatalf(\"Dispatch: %v\", err)\n\t}\n\tgot, err := os.ReadFile(out)\n\tif err != nil {\n\t\tt.Fatalf(\"read out: %v\", err)\n\t}\n\twant := filepath.Join(root, Prefix+\"envprobe\", \"data\")\n\tif string(got) != want {\n\t\tt.Errorf(\"ENTIRE_PLUGIN_DATA_DIR = %q; want %q\", got, want)\n\t}\n}\n\nfunc TestDispatch_UnknownPluginFallsThrough(t *testing.T) {\n\tt.Parallel()\n\twithPluginRoot(t)\n\trootCmd := &cobra.Command{Use: \"entire\"}\n\thandled, err := Dispatch(context.Background(), rootCmd, []string{\"does-not-exist\"})\n\tif handled || err != nil {\n\t\tt.Errorf(\"unknown plugin: handled=%v err=%v; want false,nil\", handled, err)\n\t}\n}\n\nfunc TestDispatch_RejectsInvalidName(t *testing.T) {\n\tt.Parallel()\n\twithPluginRoot(t)\n\trootCmd := &cobra.Command{Use: \"entire\"}\n\thandled, err := Dispatch(context.Background(), rootCmd, []string{\"BadName\"})\n\tif handled || err != nil {\n\t\tt.Errorf(\"invalid name: handled=%v err=%v; want false,nil\", handled, err)\n\t}\n}\n\nfunc TestDispatch_FirstNonFlagIsCandidate(t *testing.T) {\n\tt.Parallel()\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"uses Unix shebang scripts\")\n\t}\n\troot := withPluginRoot(t)\n\tout := filepath.Join(t.TempDir(), \"out\")\n\tbody := \"#!/bin/sh\\nprintf '%s|' \\\"$@\\\" > \" + out + \"\\n\"\n\tinstallFakeScript(t, root, \"args\", body)\n\n\trootCmd := &cobra.Command{Use: \"entire\"}\n\t// Args before \"args\" are flags; args after pass through.\n\tif _, err := Dispatch(context.Background(), rootCmd, []string{\"--global-flag\", \"args\", \"--child-flag\", \"value\"}); err != nil {\n\t\tt.Fatalf(\"Dispatch: %v\", err)\n\t}\n\tgot, err := os.ReadFile(out)\n\tif err != nil {\n\t\tt.Fatalf(\"read out: %v\", err)\n\t}\n\tif !strings.Contains(string(got), \"--child-flag|value|\") {\n\t\tt.Errorf(\"child args = %q; want to contain --child-flag|value|\", got)\n\t}\n}\n\nfunc asExitError(err error, target **exec.ExitError) bool {\n\tfor cur := err; cur != nil; {\n\t\tif ee, ok := cur.(*exec.ExitError); ok {\n\t\t\t*target = ee\n\t\t\treturn true\n\t\t}\n\t\ttype unwrapper interface{ Unwrap() error }\n\t\tu, ok := cur.(unwrapper)\n\t\tif !ok {\n\t\t\treturn false\n\t\t}\n\t\tcur = u.Unwrap()\n\t}\n\treturn false\n}\n","structuredPatch":[{"oldStart":13,"oldLines":6,"newStart":13,"newLines":8,"lines":[" )"," "," // withPluginRoot redirects ENTIRE_PLUGIN_DIR for the duration of t.","+// Tests using this helper must NOT call t.Parallel(): t.Setenv mutates","+// process-global state."," func withPluginRoot(t *testing.T) string {","   t.Helper()","   root := t.TempDir()"]}],"userModified":false,"replaceAll":true},"sourceToolAssistantUUID":"b16e02a2-0253-4a5b-95f0-c6b0d5632b0f","userType":"external","entrypo