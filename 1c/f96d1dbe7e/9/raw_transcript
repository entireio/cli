x context.Context, msg string, attrs ...any) {\n   230\t\tlog(ctx, slog.LevelError, msg, attrs...)\n   231\t}\n   232\t\n   233\t// LogDuration logs a message with duration_ms calculated from the start time.\n   234\t// The level parameter specifies the log level (use slog.LevelDebug, slog.LevelInfo, etc).\n   235\t// Designed for use with defer:\n   236\t//\n   237\t//\tdefer logging.LogDuration(ctx, slog.LevelInfo, \"operation completed\", time.Now())\n   238\t//\n   239\t// Or with additional attrs:\n   240\t//\n   241\t//\tdefer logging.LogDuration(ctx, slog.LevelDebug, \"hook executed\", start,\n   242\t//\t    slog.String(\"hook\", hookName),\n   243\t//\t    slog.Bool(\"success\", true),\n   244\t//\t)\n   245\tfunc LogDuration(ctx context.Context, level slog.Level, msg string, start time.Time, attrs ...any) {\n   246\t\tdurationMs := time.Since(start).Milliseconds()\n   247\t\n   248\t\t// Prepend duration_ms to attrs\n   249\t\tallAttrs := make([]any, 0, len(attrs)+1)\n   250\t\tallAttrs = append(allAttrs, slog.Int64(\"duration_ms\", durationMs))\n   251\t\tallAttrs = append(allAttrs, attrs...)\n   252\t\n   253\t\tlog(ctx, level, msg, allAttrs...)\n   254\t}\n   255\t\n   256\t// log is the internal logging function that extracts context values and logs.\n   257\t//\n   258\t// The read lock is held across l.Log so Init/Close cannot close logBufWriter\n   259\t// mid-write; do not shrink the lock scope to a snapshot pattern.\n   260\tfunc log(ctx context.Context, level slog.Level, msg string, attrs ...any) {\n     1\tpackage logging\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\n     6\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n     7\t)\n     8\t\n     9\t// Context keys for logging values.\n    10\t// Using private types to avoid key collisions.\n    11\ttype contextKey int\n    12\t\n    13\tconst (\n    14\t\tsessionIDKey contextKey = iota\n    15\t\tparentSessionIDKey\n    16\t\ttoolCallIDKey\n    17\t\tcomponentKey\n    18\t\tagentKey\n    19\t)\n    20\t\n    21\t// WithSession adds a session ID to the context.\n    22\t// If the context already has a session ID, it becomes the parent session ID.\n    23\tfunc WithSession(ctx context.Context, sessionID string) context.Context {\n    24\t\t// If there's an existing session, it becomes the parent\n    25\t\texisting := SessionIDFromContext(ctx)\n    26\t\tif existing != \"\" && existing != sessionID {\n    27\t\t\tctx = context.WithValue(ctx, parentSessionIDKey, existing)\n    28\t\t}\n    29\t\treturn context.WithValue(ctx, sessionIDKey, sessionID)\n    30\t}\n    31\t\n    32\t// WithParentSession explicitly sets the parent session ID.\n    33\t// Use this when you need to set the parent explicitly rather than\n    34\t// having it inferred from an existing session.\n    35\tfunc WithParentSession(ctx context.Context, parentSessionID string) context.Context {\n    36\t\treturn context.WithValue(ctx, parentSessionIDKey, parentSessionID)\n    37\t}\n    38\t\n    39\t// WithToolCall adds a tool call ID to the context.\n    40\tfunc WithToolCall(ctx context.Context, toolCallID string) context.Context {\n    41\t\treturn context.WithValue(ctx, toolCallIDKey, toolCallID)\n    42\t}\n    43\t\n    44\t// WithComponent adds a component name to the context.\n    45\t// Component names help identify the subsystem generating logs (e.g., \"hooks\", \"strategy\", \"session\").\n    46\tfunc WithComponent(ctx context.Context, component string) context.Context {\n    47\t\treturn context.WithValue(ctx, componentKey, component)\n    48\t}\n    49\t\n    50\t// WithAgent adds an agent name to the context.\n    51\t// Agent names identify the AI agent generating activity (e.g., \"claude-code\", \"cursor\", \"aider\").\n    52\tfunc WithAgent(ctx context.Context, agentName types.AgentName) context.Context {\n    53\t\treturn context.WithValue(ctx, agentKey, string(agentName))\n    54\t}\n    55\t\n    56\t// SessionIDFromContext extracts the session ID from the context.\n    57\t// Returns empty string if not set.\n    58\tfunc SessionIDFromContext(ctx context.Context) string {\n    59\t\tif v := ctx.Value(sessionIDKey); v != nil {\n    60\t\t\tif s, ok := v.(string); ok {\n    61\t\t\t\treturn s\n    62\t\t\t}\n    63\t\t}\n    64\t\treturn \"\"\n    65\t}\n    66\t\n    67\t// ParentSessionIDFromContext extracts the parent session ID from the context.\n    68\t// Returns empty string if not set.\n    69\tfunc ParentSessionIDFromContext(ctx context.Context) string {\n    70\t\tif v := ctx.Value(parentSessionIDKey); v != nil {\n    71\t\t\tif s, ok := v.(string); ok {\n    72\t\t\t\treturn s\n    73\t\t\t}\n    74\t\t}\n    75\t\treturn \"\"\n    76\t}\n    77\t\n    78\t// ToolCallIDFromContext extracts the tool call ID from the context.\n    79\t// Returns empty string if not set.\n    80\tfunc ToolCallIDFromContext(ctx context.Context) string {\n    81\t\tif v := ctx.Value(toolCallIDKey); v != nil {\n    82\t\t\tif s, ok := v.(string); ok {\n    83\t\t\t\treturn s\n    84\t\t\t}\n    85\t\t}\n    86\t\treturn \"\"\n    87\t}\n    88\t\n    89\t// ComponentFromContext extracts the component name from the context.\n    90\t// Returns empty string if not set.\n    91\tfunc ComponentFromContext(ctx context.Context) string {\n    92\t\tif v := ctx.Value(componentKey); v != nil {\n    93\t\t\tif s, ok := v.(string); ok {\n    94\t\t\t\treturn s\n    95\t\t\t}\n    96\t\t}\n    97\t\treturn \"\"\n    98\t}\n    99\t\n   100\t// AgentFromContext extracts the agent name from the context.\n   101\t// Returns empty string if not set.\n   102\tfunc AgentFromContext(ctx context.Context) string {\n   103\t\tif v := ctx.Value(agentKey); v != nil {\n   104\t\t\tif s, ok := v.(string); ok {\n   105\t\t\t\treturn s\n   106\t\t\t}\n   107\t\t}\n   108\t\treturn \"\"\n   109\t}\n     1\tpackage logging\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"encoding/json\"\n     7\t\t\"log/slog\"\n     8\t\t\"os\"\n     9\t\t\"os/exec\"\n    10\t\t\"path/filepath\"\n    11\t\t\"strings\"\n    12\t\t\"sync\"\n    13\t\t\"testing\"\n    14\t\t\"time\"\n    15\t)\n    16\t\n    17\t// Test constants to avoid goconst warnings\n    18\tconst (\n    19\t\ttestSessionID = \"2025-01-15-test-session\"\n    20\t\ttestComponent = \"hooks\"\n    21\t\ttestAgent     = \"claude-code\"\n    22\t\tlevelINFO     = \"INFO\"\n    23\t)\n    24\t\n    25\t// testLogFilePath returns the expected log file path for a test temp directory.\n    26\tfunc testLogFilePath(tmpDir string) string {\n    27\t\treturn filepath.Join(tmpDir, \".entire\", \"logs\", \"entire.log\")\n    28\t}\n    29\t\n    30\tfunc TestParseLogLevel(t *testing.T) {\n    31\t\ttests := []struct {\n    32\t\t\tname     string\n    33\t\t\tenvValue string\n    34\t\t\twant     slog.Level\n    35\t\t}{\n    36\t\t\t{\"empty defaults to INFO\", \"\", slog.LevelInfo},\n    37\t\t\t{\"DEBUG lowercase\", \"debug\", slog.LevelDebug},\n    38\t\t\t{\"DEBUG uppercase\", \"DEBUG\", slog.LevelDebug},\n    39\t\t\t{\"INFO lowercase\", \"info\", slog.LevelInfo},\n    40\t\t\t{\"INFO uppercase\", \"INFO\", slog.LevelInfo},\n    41\t\t\t{\"WARN lowercase\", \"warn\", slog.LevelWarn},\n    42\t\t\t{\"WARN uppercase\", \"WARN\", slog.LevelWarn},\n    43\t\t\t{\"ERROR lowercase\", \"error\", slog.LevelError},\n    44\t\t\t{\"ERROR uppercase\", \"ERROR\", slog.LevelError},\n    45\t\t\t{\"invalid defaults to INFO\", \"invalid\", slog.LevelInfo},\n    46\t\t\t{\"warning alias\", \"warning\", slog.LevelWarn},\n    47\t\t}\n    48\t\n    49\t\tfor _, tt := range tests {\n    50\t\t\tt.Run(tt.name, func(t *testing.T) {\n    51\t\t\t\tgot := parseLogLevel(tt.envValue)\n    52\t\t\t\tif got != tt.want {\n    53\t\t\t\t\tt.Errorf(\"parseLogLevel(%q) = %v, want %v\", tt.envValue, got, tt.want)\n    54\t\t\t\t}\n    55\t\t\t})\n    56\t\t}\n    57\t}\n    58\t\n    59\tfunc TestInit_CreatesLogDirectory(t *testing.T) {\n    60\t\ttmpDir := t.TempDir()\n    61\t\tt.Chdir(tmpDir)\n    62\t\n    63\t\t// Initialize git repo so WorktreeRoot works\n    64\t\tinitGitRepo(t, tmpDir)\n    65\t\n    66\t\terr := Init(context.Background(), testSessionID)\n    67\t\tif err != nil {\n    68\t\t\tt.Fatalf(\"Init() error = %v\", err)\n    69\t\t}\n    70\t\tdefer Close()\n    71\t\n    72\t\tlogsDir := filepath.Join(tmpDir, \".entire\", \"logs\")\n    73\t\tif _, err := os.Stat(logsDir); os.IsNotExist(err) {\n    74\t\t\tt.Errorf(\"Init() did not create .entire/logs/ directory\")\n    75\t\t}\n    76\t}\n    77\t\n    78\tfunc TestInit_CreatesLogFile(t *testing.T) {\n    79\t\ttmpDir := t.TempDir()\n    80\t\tt.Chdir(tmpDir)\n    81\t\n    82\t\tinitGitRepo(t, tmpDir)\n    83\t\n    84\t\terr := Init(context.Background(), testSessionID)\n    85\t\tif err != nil {\n    86\t\t\tt.Fatalf(\"Init() error = %v\", err)\n    87\t\t}\n    88\t\tdefer Close()\n    89\t\n    90\t\tif _, err := os.Stat(testLogFilePath(tmpDir)); os.IsNotExist(err) {\n    91\t\t\tt.Errorf(\"Init() did not create log file at %s\", testLogFilePath(tmpDir))\n    92\t\t}\n    93\t}\n    94\t\n    95\tfunc TestInit_WritesJSONLogs(t *testing.T) {\n    96\t\ttmpDir := t.TempDir()\n    97\t\tt.Chdir(tmpDir)\n    98\t\n    99\t\tinitGitRepo(t, tmpDir)\n   100\t\n   101\t\tsessionID := \"2025-01-15-json-test\"\n   102\t\terr := Init(context.Background(), sessionID)\n   103\t\tif err != nil {\n   104\t\t\tt.Fatalf(\"Init() error = %v\", err)\n   105\t\t}\n   106\t\n   107\t\t// Log something\n   108\t\tInfo(context.Background(), \"test message\", slog.String(\"key\", \"value\"))\n   109\t\n   110\t\t// Close to flush\n   111\t\tClose()\n   112\t\n   113\t\t// Read log file\n   114\t\tcontent, err := os.ReadFile(testLogFilePath(tmpDir))\n   115\t\tif err != nil {\n   116\t\t\tt.Fatalf(\"Failed to read log file: %v\", err)\n   117\t\t}\n   118\t\n   119\t\t// Parse as JSON\n   120\t\tvar logEntry map[string]interface{}\n   121\t\tif err := json.Unmarshal(content, &logEntry); err != nil {\n   122\t\t\tt.Errorf(\"Log output is not valid JSON: %v\\nContent: %s\", err, content)\n   123\t\t}\n   124\t\n   125\t\t// Verify expected fields\n   126\t\tif msg, ok := logEntry[\"msg\"].(string); !ok || msg != \"test message\" {\n   127\t\t\tt.Errorf(\"Expected msg='test message', got %v\", logEntry[\"msg\"])\n   128\t\t}\n   129\t\tif key, ok := logEntry[\"key\"].(string); !ok || key != \"value\" {\n   130\t\t\tt.Errorf(\"Expected key='value', got %v\", logEntry[\"key\"])\n   131\t\t}\n   132\t\tif _, ok := logEntry[\"time\"]; !ok {\n   133\t\t\tt.Error(\"Expected 'time' field in log entry\")\n   134\t\t}\n   135\t\tif _, ok := logEntry[\"level\"]; !ok {\n   136\t\t\tt.Error(\"Expected 'level' field in log entry\")\n   137\t\t}\n   138\t}\n   139\t\n   140\tfunc TestInit_RespectsLogLevel(t *testing.T) {\n   141\t\ttmpDir := t.TempDir()\n   142\t\tt.Chdir(tmpDir)\n   143\t\n   144\t\tinitGitRepo(t, tmpDir)\n   145\t\n   146\t\t// Set log level to WARN\n   147\t\tt.Setenv(LogLevelEnvVar, \"WARN\")\n   148\t\n   149\t\tsessionID := \"2025-01-15-level-test\"\n   150\t\terr := Init(context.Background(), sessionID)\n   151\t\tif err != nil {\n   152\t\t\tt.Fatalf(\"Init() error = %v\", err)\n   153\t\t}\n   154\t\n   155\t\tctx := context.Background()\n   156\t\n   157\t\t// These should NOT be logged\n   158\t\tDebug(ctx, \"debug message\")\n   159\t\tInfo(ctx, \"info message\")\n   160\t\n   161\t\t// This SHOULD be logged\n   162\t\tWarn(ctx, \"warn message\")\n   163\t\n   164\t\tClose()\n   165\t\n   166\t\t// Read log file\n   167\t\tcontent, err := os.ReadFile(testLogFilePath(tmpDir))\n   168\t\tif err != nil {\n   169\t\t\tt.Fatalf(\"Failed to read log file: %v\", err)\n   170\t\t}\n   171\t\n   172\t\tcontentStr := string(content)\n   173\t\tif strings.Contains(contentStr, \"debug message\") {\n   174\t\t\tt.Error(\"DEBUG message should not be logged when level is WARN\")\n   175\t\t}\n   176\t\tif strings.Contains(contentStr, \"info message\") {\n   177\t\t\tt.Error(\"INFO message should not be logged when level is WARN\")\n   178\t\t}\n   179\t\tif !strings.Contains(contentStr, \"warn message\") {\n   180\t\t\tt.Error(\"WARN message should be logged when level is WARN\")\n   181\t\t}\n   182\t}\n   183\t\n   184\tfunc TestInit_InvalidLogLevelWarns(t *testing.T) {\n   185\t\ttmpDir := t.TempDir()\n   186\t\tt.Chdir(tmpDir)\n   187\t\n   188\t\tinitGitRepo(t, tmpDir)\n   189\t\n   190\t\t// Capture stderr\n   191\t\tvar buf bytes.Buffer\n   192\t\toldStderr := os.Stderr\n   193\t\tr, w, err := os.Pipe()\n   194\t\tif err != nil {\n   195\t\t\tt.Fatalf(\"Failed to create pipe: %v\", err)\n   196\t\t}\n   197\t\tos.Stderr = w\n   198\t\n   199\t\tt.Setenv(LogLevelEnvVar, \"INVALID_LEVEL\")\n   200\t\n   201\t\tsessionID := \"2025-01-15-invalid-level\"\n   202\t\terr = Init(context.Background(), sessionID)\n   203\t\tif err != nil {\n   204\t\t\tt.Fatalf(\"Init() error = %v\", err)\n   205\t\t}\n   206\t\n   207\t\tw.Close()\n   208\t\tos.Stderr = oldStderr\n   209\t\n   210\t\tif _, err := buf.ReadFrom(r); err != nil {\n   211\t\t\tt.Fatalf(\"Failed to read from pipe: %v\", err)\n   212\t\t}\n   213\t\tstderrOutput := buf.String()\n   214\t\n   215\t\tif !strings.Contains(stderrOutput, \"invalid log level\") {\n   216\t\t\tt.Errorf(\"Expected warning about invalid log level on stderr, got: %s\", stderrOutput)\n   217\t\t}\n   218\t\n   219\t\tClose()\n   220\t}\n   221\t\n   222\tfunc TestInit_FallsBackToStderrOnError(t *testing.T) {\n   223\t\ttmpDir := t.TempDir()\n   224\t\tt.Chdir(tmpDir)\n   225\t\n   226\t\tinitGitRepo(t, tmpDir)\n   227\t\n   228\t\t// Make logs directory unwritable (simulate permission error)\n   229\t\tlogsDir := filepath.Join(tmpDir, \".entire\", \"logs\")\n   230\t\tif err := os.MkdirAll(logsDir, 0o755); err != nil {\n   231\t\t\tt.Fatalf(\"Failed to create logs dir: %v\", err)\n   232\t\t}\n   233\t\n   234\t\t// Create a directory with the same name as the log file to cause an error\n   235\t\tif err := os.MkdirAll(testLogFilePath(tmpDir), 0o755); err != nil {\n   236\t\t\tt.Fatalf(\"Failed to create blocking dir: %v\", err)\n   237\t\t}\n   238\t\n   239\t\t// Init should not return error, but fall back to stderr\n   240\t\terr := Init(context.Background(), testSessionID)\n   241\t\tif err != nil {\n   242\t\t\tt.Errorf(\"Init() should not error, but got: %v\", err)\n   243\t\t}\n   244\t\n   245\t\t// Verify logger still works (writing to stderr)\n   246\t\tInfo(context.Background(), \"fallback test\")\n   247\t\n   248\t\tClose()\n   249\t}\n   250\t\n   251\tfunc TestClose_SafeToCallMultipleTimes(t *testing.T) {\n   252\t\ttmpDir := t.TempDir()\n   253\t\tt.Chdir(tmpDir)\n   254\t\n   255\t\tinitGitRepo(t, tmpDir)\n   256\t\n   257\t\tsessionID := \"2025-01-15-close-test\"\n   258\t\terr := Init(context.Background(), sessionID)\n   259\t\tif err != nil {\n   260\t\t\tt.Fatalf(\"Init() error = %v\", err)\n   261\t\t}\n   262\t\n   263\t\t// Should not panic\n   264\t\tClose()\n   265\t\tClose()\n   266\t\tClose()\n   267\t}\n   268\t\n   269\tfunc TestLogging_BeforeInit(_ *testing.T) {\n   270\t\t// Reset any global state\n   271\t\tresetLogger()\n   272\t\n   273\t\t// These should not panic, should use default stderr logger\n   274\t\tctx := context.Background()\n   275\t\tDebug(ctx, \"debug before init\")\n   276\t\tInfo(ctx, \"info before init\")\n   277\t\tWarn(ctx, \"warn before init\")\n   278\t\tError(ctx, \"error before init\")\n   279\t}\n   280\t\n   281\t// Helper to initialize a git repo for tests\n   282\tfunc initGitRepo(t *testing.T, dir string) {\n   283\t\tt.Helper()\n   284\t\tt.Chdir(dir)\n   285\t\tcmd := \"git init && git config user.email 'test@test.com' && git config user.name 'Test'\"\n   286\t\toutput, err := execCommand(t, \"sh\", \"-c\", cmd)\n   287\t\tif err != nil {\n   288\t\t\tt.Fatalf(\"Failed to init git repo: %v\\nOutput: %s\", err, output)\n   289\t\t}\n   290\t}\n   291\t\n   292