n   111\t\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n   112\t\t}\n   113\t\n   114\t\t// Claim the session for this agent. First-writer-wins: subsequent agents\n   115\t\t// firing SessionStart for the same session ID are no-ops. Used by\n   116\t\t// InitializeSession (TurnStart) and the dispatcher skip in\n   117\t\t// DispatchLifecycleEvent for cross-agent disambiguation when Cursor IDE\n   118\t\t// forwards hooks to both .cursor/hooks.json and .claude/settings.json.\n   119\t\tif _, hintErr := strategy.StoreAgentTypeHint(ctx, event.SessionID, ag.Type()); hintErr != nil {\n   120\t\t\tlogging.Warn(logCtx, \"failed to store agent hint on session start\",\n   121\t\t\t\tslog.String(\"error\", hintErr.Error()))\n   122\t\t}\n   123\t\n   124\t\t// Build informational message — warn early if repo has no commits yet,\n   125\t\t// since checkpoints require at least one commit to work.\n   126\t\tmessage := sessionStartMessage(ag.Name(), false)\n   127\t\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n   128\t\t\tmessage = sessionStartMessage(ag.Name(), true)\n   129\t\t}\n   130\t\n   131\t\t// Check for concurrent sessions and append count if any\n   132\t\t_, countSessionsSpan := perf.Start(ctx, \"count_active_sessions\")\n   133\t\tstrat := GetStrategy(ctx)\n   134\t\tif count, err := strat.CountOtherActiveSessionsWithCheckpoints(ctx, event.SessionID); err == nil && count > 0 {\n   135\t\t\tif ag.Name() == agent.AgentNameCodex {\n   136\t\t\t\tmessage += fmt.Sprintf(\" %d other active conversation(s) in this workspace will also be included. Use 'entire status' for more information.\", count)\n   137\t\t\t} else {\n   138\t\t\t\tmessage += fmt.Sprintf(\"\\n  %d other active conversation(s) in this workspace will also be included.\\n  Use 'entire status' for more information.\", count)\n   139\t\t\t}\n   140\t\t}\n   141\t\tcountSessionsSpan.End()\n   142\t\n   143\t\t// Codex-only: surface untru