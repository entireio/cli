9\t// and lets the user continue without blocking the commit.\n    70\t//\n    71\t// resolveCheckpointSummaryProvider's user-facing chatter (auto-select notice,\n    72\t// \"Using <provider>\" line, external_agents flag-flip note, persistence-failure\n    73\t// warning) is captured and routed through logging instead of printing inline\n    74\t// with the synthesis output. The persistence-failure path is also surfaced as\n    75\t// logging.Warn at the source (explain_summary_provider.go), so real failures\n    76\t// are not silenced — they live in .entire/logs/.\n    77\t//\n    78\t// Note: first call against an unconfigured repo will write\n    79\t// .entire/settings.local.json — see the lazySynthesisProvider doc above.\n    80\tfunc (lazySynthesisProvider) Synthesize(ctx context.Context, prompt string) (string, error) {\n    81\t\tvar captured bytes.Buffer\n    82\t\tprovider, err := resolveCheckpointSummaryProvider(ctx, &captured)\n    83\t\tlogProviderResolutionOutput(ctx, &captured)\n    84\t\tif err != nil {\n    85\t\t\treturn \"\", err\n    86\t\t}\n    87\t\tag, agErr := getSummaryAgent(provider.Name)\n    88\t\tif agErr != nil {\n    89\t\t\treturn \"\", agErr\n    90\t\t}\n    91\t\ttg, ok := agent.AsTextGenerator(ag)\n    92\t\tif !ok {\n    93\t\t\treturn \"\", fmt.Errorf(\"agent %s does not support text generation\", provider.Name)\n    94\t\t}\n    95\t\treturn tg.GenerateText(ctx, prompt, provider.Model) //nolint:wrapcheck // SynthesisSink owns display\n    96\t}\n    97\t\n    98\t// logProviderResolutionOutput routes captured output from resolveCheckpoint-\n    99\t// SummaryProvider through logging so it ends up in .entire/logs/ rather than\n   100\t// inline with the synthesis verdict. Lines starting with \"Warning:\" go to\n   101\t// Warn; other notices (auto-select reason, \"Using X for summary generation\",\n   102\t// external_agents flag-flip note) go to Info.\n   103\tfunc logProviderResolutionOutput(ctx context.Context, buf *bytes.Buffer) {\n   104\t\tfor _, line := range strings.Split(strings.TrimRight(buf.String(), \"\\n\"), \"\\n\") {\n   105\t\t\tif line == \"\" {\n   106\t\t\t\tcontinue\n   107\t\t\t}\n   108\t\t\tif strings.HasPrefix(line, \"Warning:\") {\n   109\t\t\t\tlogging.Warn(ctx, \"synthesis provider resolution\", \"message\", line)\n   110\t\t\t\tcontinue\n   111\t\t\t}\n   112\t\t\tlogging.Info(ctx, \"synthesis provider resolution\", \"message\", line)\n   113\t\t}\n   114\t}\n   115\t\n   116\t// launchableReviewerFor returns the AgentReviewer for known launchable agents,\n   117\t// or nil for non-launchable agents (cursor, opencode, factoryai-droid,\n   118\t// copilot-cli). This lives in the cli package to avoid the import cycle:\n   119\t//\n   120\t//\treview/cmd.go → claudecode/codex/geminicli → review\n   121\tfunc launchableReviewerFor(agentName string) reviewtypes.AgentReviewer {\n   122\t\tswitch agentName {\n   123\t\tcase string(agent.AgentNameClaudeCode):\n   124\t\t\treturn claudecode.NewReviewer()\n   125\t\tcase string(agent.AgentNameCodex):\n   126\t\t\treturn codex.NewReviewer()\n   127\t\tcase string(agent.AgentNameGemini):\n   128\t\t\treturn geminicli.NewReviewer()\n   129\t\tdefault:\n   130\t\t\treturn nil\n   131\t\t}\n   132\t}\n"}}
