/.entire/metadata/<sessionID>/prompt.txt\n   165\t// (the on-filesystem path lifecycle.go appends to on every turn), passed through\n   166\t// the existing reviewPromptText helper to match the committed-pipeline fallback\n   167\t// format (loops backwards for the newest non-empty prompt, collapses whitespace,\n   168\t// truncates).\n   169\t//\n   170\t// Best-effort: any error path returns \"\" so the run continues. Sessions whose\n   171\t// prompt.txt is missing or empty are skipped silently.\n   172\t//\n   173\t// Why filesystem-not-shadow-branch: for active sessions prompts are written to\n   174\t// disk at lifecycle.go:294-310 on every turn for mid-turn commit availability,\n   175\t// before SaveStep copies them onto the shadow branch. Filesystem is canonical\n   176\t// for in-progress reads; the shadow-branch copy is only canonical post-condensation.\n   177\tfunc reviewSessionContext(ctx context.Context, worktreeRoot, headSHA string) string {\n   178\t\tif worktreeRoot == \"\" || headSHA == \"\" {\n   179\t\t\treturn \"\"\n   180\t\t}\n   181\t\tstore, err := session.NewStateStore(ctx)\n   182\t\tif err != nil {\n   183\t\t\tlogging.Debug(ctx, \"review session context: open state store\", slog.String(\"error\", err.Error()))\n   184\t\t\treturn \"\"\n   185\t\t}\n   186\t\tstates, err := store.List(ctx)\n   187\t\tif err != nil {\n   188\t\t\tlogging.Debug(ctx, \"review session context: list session states\", slog.String(\"error\", err.Error()))\n   189\t\t\treturn \"\"\n   190\t\t}\n   191\t\n   192\t\t// Canonicalise the current worktree path once. State files written by\n   193\t\t// lifecycle hooks store whatever path the agent process was launched\n   194\t\t// from, which on macOS frequently differs from `paths.WorktreeRoot`\n   195\t\t// only by the /var → /private/var symlink. Comparing canonical forms\n   196\t\t// avoids missing matches that string equality would drop.\n   197\t\tworktreeCanon := canonicalisePath(worktreeRoot)\n   198\t\n   199\t\tvar lines []string\n   200\t\tfor _, st := range states {\n   201\t\t\tif st == nil {\n   202\t\t\t\tcontinue\n   203\t\t\t}\n   204\t\t\tif canonicalisePath(st.WorktreePath) != worktreeCanon {\n   205\t\t\t\tcontinue\n   206\t\t\t}\n   207\t\t\tif st.BaseCommit != headSHA {\n   208\t\t\t\tcontinue\n   209\t\t\t}\n   210\t\t\tif st.FullyCondensed {\n   211\t\t\t\tcontinue\n   212\t\t\t}\n   213\t\t\tif st.Kind == session.KindAgentReview {\n   214\t\t\t\tcontinue\n   215\t\t\t}\n   216\t\t\tline := formatReviewSessionLine(worktreeRoot, st)\n   217\t\t\tif line == \"\" {\n   218\t\t\t\tcontinue\n   219\t\t\t}\n   220\t\t\tlines = append(lines, line)\n   221\t\t}\n   222\t\tif len(lines) == 0 {\n   223\t\t\treturn \"\"\n   224\t\t}\n   225\t\treturn \"In-progress session context (uncommitted):\\n\" + strings.Join(lines, \"\\n\")\n   226\t}\n   227\t\n   228\t// canonicalisePath returns the symlink-resolved absolute form of p. Falls\n   229\t// back to p itself when EvalSymlinks fails (e.g., the path doesn't exist\n   230\t// yet) so callers always get a usable comparable value.\n   231\tfunc canonicalisePath(p string) string {\n   232\t\tif p == \"\" {\n   233\t\t\treturn \"\"\n   234\t\t}\n   235\t\tif resolved, err := filepath.EvalSymlinks(p); err == nil {\n   236\t\t\treturn resolved\n   237\t\t}\n   238\t\treturn p\n   239\t}\n   240\t\n   241\t// formatReviewSessionLine renders one entry of the in-progress section.\n   242\t// Returns \"\" when the session has no prompt content to report.\n   243\tfunc formatReviewSessionLine(worktreeRoot string, st *session.State) string {\n   244\t\tpromptPath := filepath.Join(worktreeRoot, paths.SessionMetadataDirFromSessionID(st.SessionID), paths.PromptFileName)\n   245\t\traw, err := os.ReadFile(promptPath) //nolint:gosec // path constructed from validated session ID + fixed constants\n   246\t\tif err != nil {\n   247\t\t\treturn \"\"\n   248\t\t}\n   249\t\tpromptText := reviewPromptText(string(raw))\n   250\t\tif promptText == \"\" {\n   251\t\t\treturn \"\"\n   252\t\t}\n   253\t\n   254\t\tshort := st.SessionID\n   255\t\tif len(short) > 8 {\n   256\t\t\tshort = short[:8]\n   257\t\t}\n   258\t\tagentName := string(st.AgentType)\n   259\t\tif agentName == \"\" {\n   260\t\t\tagentName = \"agent\"\n"}}
