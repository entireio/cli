0], loc[1]},\n   165\t\t\t\t\tlabel:  p.label,\n   166\t\t\t\t})\n   167\t\t\t}\n   168\t\t}\n   169\t\treturn regions\n   170\t}\n   171\t\n   172\t// compilePIIPatterns builds the pattern list from config.\n   173\t// Builtin regexes are pre-compiled package vars; only custom patterns\n   174\t// need compilation here.\n   175\tfunc compilePIIPatterns(cfg *PIIConfig) []piiPattern {\n   176\t\tvar patterns []piiPattern\n   177\t\tfor _, bp := range builtinPIIPatterns {\n   178\t\t\tif enabled, ok := cfg.Categories[bp.category]; ok && enabled {\n   179\t\t\t\tpatterns = append(patterns, piiPattern{regex: bp.regex, label: bp.label})\n   180\t\t\t}\n   181\t\t}\n   182\t\tfor label, pattern := range cfg.CustomPatterns {\n   183\t\t\tcompiled, err := regexp.Compile(pattern)\n   184\t\t\tif err != nil {\n   185\t\t\t\tslog.Warn(\"skipping invalid custom PII pattern\", slog.String(\"label\", label), slog.String(\"error\", err.Error()))\n   186\t\t\t\tcontinue\n   187\t\t\t}\n   188\t\t\tpatterns = append(patterns, piiPattern{regex: compiled, label: strings.ToUpper(label)})\n   189\t\t}\n   190\t\treturn patterns\n   191\t}\n   192\t\n   193\t// replacementToken returns the redaction placeholder for a given label.\n   194\t// Empty label (secrets) returns \"REDACTED\" for backward compatibility.\n   195\t// Non-empty label (PII) returns \"[REDACTED_<LABEL>]\".\n   196\tfunc replacementToken(label string) string {\n   197\t\tif label == \"\" {\n   198\t\t\treturn \"REDACTED\"\n   199\t\t}\n   200\t\treturn \"[REDACTED_\" + label + \"]\"\n   201\t}\n     1\tpackage redact\n     2\t\n     3\timport (\n     4\t\t\"log/slog\"\n     5\t\t\"regexp\"\n     6\t\t\"sync\"\n     7\t)\n     8\t\n     9\t// CustomRulesConfig configures inline custom_redactions and parsed rule packs.\n    10\ttype CustomRulesConfig struct {\n    11\t\t// Inline maps a label (used only in logs/diagnostics) to a Go RE2 regex\n    12\t\t// string. Failed compilations are logged via slog.Warn and dropped.\n    13\t\tInline map[string]string\n    14\t\n    15\t\t// Packs are pre-parsed rule packs (see LoadPacks). Per-rule regex\n    16\t\t// compilation failures are logged and dropped; sample mismatches are\n    17\t\t// logged but do not drop the rule.\n    18\t\tPacks []*Pack\n    19\t}\n    20\t\n    21\t// compiledCustomRule is a compiled regex retained across calls.\n    22\t// label is unused for replacement (custom rules always emit the bare REDACTED\n    23\t// token to match other secret layers), but is preserved for diagnostics.\n    24\ttype compiledCustomRule struct {\n    25\t\tlabel string\n    26\t\tregex *regexp.Regexp\n    27\t}\n    28\t\n    29\ttype customRulesState struct {\n    30\t\trules []compiledCustomRule\n    31\t}\n    32\t\n    33\tvar (\n    34\t\tcustomConfig   *customRulesState\n    35\t\tcustomConfigMu sync.RWMutex\n    36\t)\n    37\t\n    38\t// componentAttr tags every warning emitted by this package so log aggregators\n    39\t// can filter redaction failures with the same key the CLI uses elsewhere\n    40\t// (`logging.WithComponent(ctx, \"redaction\")`).\n    41\tvar componentAttr = slog.String(\"component\", \"redaction\")\n    42\t\n    43\t// ConfigureCustomRules compiles user-defined redaction rules and stores the\n    44\t// result for use by redact.String(). Sample-validation runs here too, so\n    45\t// failures surface the next time any process initializes redaction.\n    46\t//\n    47\t// Call once at process startup after loading settings. Thread-safe.\n    48\tfunc ConfigureCustomRules(cfg CustomRulesConfig) {\n    49\t\tstate := &customRulesState{}\n    50\t\n    51\t\tfor label, pattern := range cfg.Inline {\n    52\t\t\tcompiled, ok := compileCustomRule(\n    53\t\t\t\tlabel,\n    54\t\t\t\tpattern,\n    55\t\t\t\t\"skipping invalid custom_redactions pattern\",\n    56\t\t\t\tslog.String(\"label\", label),\n    57\t\t\t)\n    58\t\t\tif ok {\n    59\t\t\t\tstate.rules = append(state.rules, compiled)\n    60\t\t\t}\n    61\t\t}\n    62\t\n    63\t\tfor _, pack := range cfg.Packs {\n    64\t\t\tfor _, rule := range pack.Rules {\n    65\t\t\t\tcompiled, ok := compileCustomRule(\n    66\t\t\t\t\tpack.Name+\".\"+rule.ID,\n    67\t\t\t\t\trule.Regex,\n    68\t\t\t\t\t\"skipping invalid pack rule\",\n    69\t\t\t\t\tslog.String(\"pack\", pack.sourcePath),\n    70\t\t\t\t\tslog.String(\"rule\", rule.ID),\n    71\t\t\t\t)\n    72\t\t\t\tif ok {\n    73\t\t\t\t\tstate.rules = append(state.rules, compiled)\n    74\t\t\t\t\trunRuleSamples(pack, rule, compiled.regex)\n    75\t\t\t\t}\n    76\t\t\t}\n    77\t\t}\n    78\t\n    79\t\tcustomConfigMu.Lock()\n    80\t\tdefer customConfigMu.Unlock()\n    81\t\tcustomConfig = state\n    82\t}\n    83\t\n    84\tfunc compileCustomRule(label, pattern, warning string, attrs ...any) (compiledCustomRule, bool) {\n    85\t\tcompiled, err := regexp.Compile(pattern)\n    86\t\tif err != nil {\n    87\t\t\tall := make([]any, 0, len(attrs)+2)\n    88\t\t\tall = append(all, componentAttr)\n    89\t\t\tall = append(all, attrs...)\n    90\t\t\tall = append(all, slog.String(\"error\", err.Error()))\n    91\t\t\tslog.Warn(warning, all...)\n    92\t\t\treturn compiledCustomRule{}, false\n    93\t\t}\n    94\t\treturn compiledCustomRule{label: label, regex: compiled}, true\n    95\t}\n    96\t\n    97\t// runRuleSamples checks each sample against the compiled regex and logs a\n    98\t// warning per mismatch. Failures never drop the rule — sample validation\n    99\t// is informational, not gating.\n   100\tfunc runRuleSamples(pack *Pack, rule Rule, compiled *regexp.Regexp) {\n   101\t\tfor i, s := range rule.Samples {\n   102\t\t\tgot := compiled.MatchString(s.Input)\n   103\t\t\tif got != s.Redacted {\n   104\t\t\t\tslog.Warn(\"redactor pack sample mismatch\",\n   105\t\t\t\t\tcomponentAttr,\n   106\t\t\t\t\tslog.String(\"pack\", pack.sourcePath),\n   107\t\t\t\t\tslog.String(\"rule\", rule.ID),\n   108\t\t\t\t\tslog.Int(\"sample_index\", i),\n   109\t\t\t\t\tslog.Int(\"sample_length\", len(s.Input)),\n   110\t\t\t\t\tslog.Bool(\"expected\", s.Redacted),\n   111\t\t\t\t\tslog.Bool(\"got\", got))\n   112\t\t\t}\n   113\t\t}\n   114\t}\n   115\t\n   116\t// getCustomRulesConfig returns the currently-configured custom rules.\n   117\t// Returns nil if ConfigureCustomRules has never been called.\n   118\tfunc getCustomRulesConfig() *customRulesState {\n   119\t\tcustomConfigMu.RLock()\n   120\t\tdefer customConfigMu.RUnlock()\n   121\t\treturn customConfig\n   122\t}\n   123\t\n   124\t// detectCustomRules returns tagged regions for every match of every\n   125\t// configured custom rule. Returns nil if no rules are configured.\n   126\t//\n   127\t// All regions use an empty label so they are replaced with the bare\n   128\t// \"REDACTED\" token used by the built-in secret layers, not the\n   129\t// \"[REDACTED_<LABEL>]\" token used by PII.\n   130\tfunc detectCustomRules(cfg *customRulesState, s string) []taggedRegion {\n   131\t\tif cfg == nil || len(cfg.rules) == 0 || s == \"\" {\n   132\t\t\treturn nil\n   133\t\t}\n   134\t\tvar regions []taggedRegion\n   135\t\tfor _, rule := range cfg.rules {\n   136\t\t\tfor _, loc := range rule.regex.FindAllStringIndex(s, -1) {\n   137\t\t\t\tregions = append(regions, taggedRegion{region: region{loc[0], loc[1]}})\n   138\t\t\t}\n   139\t\t}\n   140\t\treturn regions\n   141\t}\n     1\tpackage redact\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"encoding/json\"\n     6\t\t\"errors\"\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"io/fs\"\n    10\t\t\"log/slog\"\n    11\t\t\"os\"\n    12\t\t\"path/filepath\"\n    13\t\t\"regexp\"\n    14\t\t\"strings\"\n    15\t\n    16\t\t\"gopkg.in/yaml.v3\"\n    17\t)\n    18\t\n    19\t// RedactorsDirName is the .entire subdirectory used for user-defined rule packs.\n    20\tconst RedactorsDirName = \"redactors\"\n    21\t\n    22\t// maxIdentifierLen caps the length of pack Name and rule ID values. Both fields\n    23\t// flow into slog attrs and into directory-derived diagnostics; the bound prevents\n    24\t// a runaway YAML scalar from blowing up log lines.\n    25\tconst maxIdentifierLen = 64\n    26\t\n    27\t// maxPackFileBytes caps the per-file size LoadPacks will parse. The trust\n    28\t// boundary is \"user owns repo,\" so this is not a security barrier — it is a\n    29\t// runaway-input guard that keeps an accidentally large YAML out of the\n    30\t// redaction startup path.\n    31\tconst maxPackFileBytes = 1 << 20 // 1 MiB\n    32\t\n    33\t// maxPackFiles caps how many pack files LoadPacks will accept under one\n    34\t// .entire/redactors/ tree. Same trust model as maxPackFileBytes: prevents a\n    35\t// runaway directory from stalling every CLI invocation.\n    36\tconst maxPackFiles = 256\n    37\t\n    38\t// identifierPattern restricts pack Name and rule ID to a conservative set of\n    39\t// characters that play well with filesystems, log greps, and JSON. Disallowing\n    40\t// whitespace and control characters avoids log-line injection from a malformed\n    41\t// pack scalar.\n    42\tvar identifierPattern = regexp.MustCompile(`^[A-Za-z0-9._-]+$`)\n    43\t\n    44\t// Pack is a versioned bundle of redaction rules loaded from a single file\n    45\t// under .entire/redactors/. Both YAML and JSON encodings are accepted; the\n    46\t// schema is identical.\n    47\ttype Pack struct {\n    48\t\tName        string `json:\"name\"                  yaml:\"name\"`\n    49\t\tVersion     string `json:\"version\"               yaml:\"version\"`\n    50\t\tDescription string `json:\"description,omitempty\" yaml:\"description\"`\n    51\t\tRules       []Rule `json:\"rules\"                 yaml:\"rules\"`\n    52\t\n    53\t\t// sourcePath is the file the pack was loaded from. Populated by\n    54\t\t// ParsePack; used in log lines so users can find the offending file.\n    55\t\tsourcePath string\n    56\t}\n    57\t\n    58\t// Rule is a single redaction rule within a Pack.\n    59\ttype Rule struct {\n    60\t\tID          string   `json:\"id\"                    yaml:\"id\"`\n    61\t\tDescription string   `json:\"description,omitempty\" yaml:\"description\"`\n    62\t\tRegex       string   `json:\"regex\"                 yaml:\"regex\"`\n    63\t\tSamples     []Sample `json:\"samples,omitempty\"     yaml:\"samples\"`\n    64\t}\n    65\t\n    66\t// Sample is a self-test entry for a Rule. The runner asserts whether the\n    67\t// rule's regex matching `Input` matches the `Redacted` expectation.\n    68\ttype Sample struct {\n    69\t\tInput    string `json:\"input\"    yaml:\"input\"`\n    70\t\tRedacted bool   `json:\"redacted\" yaml:\"redacted\"`\n    71\t}\n    72\t\n    73\t// ParsePack decodes a single pack file. sourcePath is used both to pick\n    74\t// the encoding (YAML by default; JSON only when the extension is .json)\n    75\t// and to enforce that the pack's `name` matches the filename stem.\n    76\t//\n    77\t// Precondition: sourcePath must be a vetted local file path (the production\n    78\t// caller is LoadPacks, which only invokes ParsePack with paths produced by\n    79\t// WalkDir under the configured .entire/redactors/ directory). Callers passing\n    80\t// arbitrary or remote paths must enforce their own trust model — ParsePack\n    81\t// does not sanitize sourcePath beyond reading its extension.\n    82\tfunc ParsePack(data []byte, sourcePath string) (*Pack, error) {\n    83\t\tvar pack Pack\n    84\t\tswitch strings.ToLower(filepath.Ext(sourcePath)) {\n    85\t\tcase \".json\":\n    86\t\t\tdecoder := json.NewDecoder(bytes.NewReader(data))\n    87\t\t\tdecoder.DisallowUnknownFields()\n    88\t\t\tif err := decoder.Decode(&pack); err != nil {\n    89\t\t\t\treturn nil, fmt.Errorf(\"parse %s: %w\", sourcePath, err)\n    90\t\t\t}\n    91\t\t\tvar extra any\n    92\t\t\tif err := decoder.Decode(&extra); err == nil {\n    93\t\t\t\treturn nil, fmt.Errorf(\"parse %s: trailing content after pack\", sourcePath)\n    94\t\t\t} else if !errors.Is(err, io.EOF) {\n    95\t\t\t\treturn nil, fmt.Errorf(\"parse %s: %w\", sourcePath, err)\n    96\t\t\t}\n    97\t\tdefault:\n    98\t\t\tdecoder := yaml.NewDecoder(bytes.NewReader(data))\n    99\t\t\tdecoder.KnownFields(true)\n   100\t\t\tif err := decoder.Decode(&pack); err != nil {\n   101\t\t\t\treturn nil, fmt.Errorf(\"parse %s: %w\", sourcePath, err)\n   102\t\t\t}\n   103\t\t\tvar extra any\n   104\t\t\tif err := decoder.Decode(&extra); err == nil {\n   105\t\t\t\treturn nil, fmt.Errorf(\"parse %s: trailing content after pack\", sourcePath)\n   106\t\t\t} else if !errors.Is(err, io.EOF) {\n   107\t\t\t\treturn nil, fmt.Errorf(\"parse %s: %w\", sourcePath, err)\n   108\t\t\t}\n   109\t\t}\n   110\t\tpack.sourcePath = sourcePath\n   111\t\tif err := validatePack(&pack); err != nil {\n   112\t\t\treturn nil, err\n   113\t\t}\n   114\t\treturn &pack, nil\n   115\t}\n   116\t\n   117\t// validatePack enforces required fields and schema invariants. Regex\n   118\t// compilation is NOT performed here — that happens during ConfigureCustomRules\n   119\t// so failures emit the same warn-and-skip path as inline rules.\n   120\tfunc validatePack(p *Pack) error {\n   121\t\tif p.Name == \"\" {\n   122\t\t\treturn fmt.Errorf(\"%s: missing required field 'name'\", p.sourcePath)\n   123\t\t}\n   124\t\tif err := validateIdentifier(\"name\", p.Name, p.sourcePath); err != nil {\n   125\t\t\treturn err\n   126\t\t}\n   127\t\tif p.Version == \"\" {\n   128\t\t\treturn fmt.Errorf(\"%s: missing required field 'version'\", p.sourcePath)\n   129\t\t}\n   130\t\tif len(p.Rules) == 0 {\n   131\t\t\treturn fmt.Errorf(\"%s: 'rules' must contain at least one entry\", p.sourcePath)\n   132\t\t}\n   133\t\n   134\t\t// Name must match filename stem so log lines and discovery stay consistent.\n   135\t\tstem := strings.TrimSuffix(filepath.Base(p.sourcePath), filepath.Ext(p.sourcePath))\n   136\t\tif stem != p.Name {\n   137\t\t\treturn fmt.