415\t\tif len(s) < 5 || s[0] != '<' || s[len(s)-1] != '>' {\n   416\t\t\treturn false\n   417\t\t}\n   418\t\treturn bracketedPlaceholderInteriorRE.MatchString(s[1 : len(s)-1])\n   419\t}\n   420\t\n   421\t// isRepeatedCharPlaceholder reports whether s is a run of a single masking\n   422\t// character commonly used to redact values in docs and screenshots, e.g.\n   423\t// \"***\", \"xxxx\", \"....\", \"----\". The minimum length of 3 keeps single-char\n   424\t// or 2-char values like `x` or `**` from being treated as masks.\n   425\tfunc isRepeatedCharPlaceholder(s string) bool {\n   426\t\tif len(s) < 3 {\n   427\t\t\treturn false\n   428\t\t}\n   429\t\tfirst := s[0]\n   430\t\tswitch first {\n   431\t\tcase '*', 'x', '.', '-':\n   432\t\tdefault:\n   433\t\t\treturn false\n   434\t\t}\n   435\t\tfor i := 1; i < len(s); i++ {\n   436\t\t\tif s[i] != first {\n   437\t\t\t\treturn false\n   438\t\t\t}\n   439\t\t}\n   440\t\treturn true\n   441\t}\n   442\t\n   443\tfunc isCredentialJSONSecretKey(key string, credentialContext bool) bool {\n   444\t\tnormalized := normalizeCredentialJSONKey(key)\n   445\t\tif credentialJSONKeyRegex.MatchString(normalized) {\n   446\t\t\treturn true\n   447\t\t}\n   448\t\treturn credentialContext && genericPasswordKeyRegex.MatchString(normalized)\n   449\t}\n   450\t\n   451\tfunc isCredentialJSONObject(obj map[string]any) bool {\n   452\t\tvar hasHost, hasUser bool\n   453\t\tfor key := range obj {\n   454\t\t\tswitch normalizeCredentialJSONKey(key) {\n   455\t\t\tcase \"host\", \"hostname\", \"server\", \"addr\", \"address\", \"datasource\", \"data_source\":\n   456\t\t\t\thasHost = true\n   457\t\t\tcase \"user\", \"username\", \"userid\", \"user_id\", \"uid\":\n   458\t\t\t\thasUser = true\n   459\t\t\t}\n   460\t\t\tif hasHost && hasUser {\n   461\t\t\t\treturn true\n   462\t\t\t}\n   463\t\t}\n   464\t\treturn fals…1803 tokens truncated…dEmail(email string) bool {\n   110\t\tlower := strings.ToLower(email)\n   111\t\tfor _,