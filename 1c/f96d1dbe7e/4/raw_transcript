componentAttr,\n   221\t\t\t\t\tslog.String(\"path\", path),\n   222\t\t\t\t\tslog.Int(\"max_files\", maxPackFiles))\n   223\t\t\t\treturn filepath.SkipAll\n   224\t\t\t}\n   225\t\n   226\t\t\tinfo, statErr := d.Info()\n   227\t\t\tif statErr != nil {\n   228\t\t\t\tslog.Warn(\"skipping redactor pack: stat failed\",\n   229\t\t\t\t\tcomponentAttr,\n   230\t\t\t\t\tslog.String(\"path\", path),\n   231\t\t\t\t\tslog.String(\"error\", statErr.Error()))\n   232\t\t\t\treturn nil\n   233\t\t\t}\n   234\t\t\tif info.Size() > maxPackFileBytes {\n   235\t\t\t\tslog.Warn(\"skipping redactor pack: file exceeds size cap\",\n   236\t\t\t\t\tcomponentAttr,\n   237\t\t\t\t\tslog.String(\"path\", path),\n   238\t\t\t\t\tslog.Int64(\"size_bytes\", info.Size()),\n   239\t\t\t\t\tslog.Int(\"max_bytes\", maxPackFileBytes))\n   240\t\t\t\treturn nil\n   241\t\t\t}\n   242\t\n   243\t\t\tdata, err := os.ReadFile(path) //nolint:gosec // path comes from WalkDir under a configured dir\n   244\t\t\tif err != nil {\n   245\t\t\t\tslog.Warn(\"skipping unreadable redactor pack\",\n   246\t\t\t\t\tcomponentAttr,\n   247\t\t\t\t\tslog.String(\"path\", path),\n   248\t\t\t\t\tslog.String(\"error\", err.Error()))\n   249\t\t\t\treturn nil\n   250\t\t\t}\n   251\t\t\tpack, err := ParsePack(data, path)\n   252\t\t\tif err != nil {\n   253\t\t\t\tslog.Warn(\"skipping invalid redactor pack\",\n   254\t\t\t\t\tcomponentAttr,\n   255\t\t\t\t\tslog.String(\"path\", path),\n   256\t\t\t\t\tslog.String(\"error\", err.Error()))\n   257\t\t\t\treturn nil\n   258\t\t\t}\n   259\t\t\tpacks = append(packs, pack)\n   260\t\t\treturn nil\n   261\t\t})\n   262\t\tif walkErr != nil {\n   263\t\t\treturn nil, fmt.Errorf(\"walk redactors dir %s: %w\", dir, walkErr)\n   264\t\t}\n   265\t\treturn packs, nil\n   266\t}\n"}}
