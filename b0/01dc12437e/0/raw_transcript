{"type":"pr-link","sessionId":"fbf9af8f-86ca-49c2-9f2a-3834d5f17605","prNumber":1159,"prUrl":"https://github.com/entireio/cli/pull/1159","prRepository":"entireio/cli","timestamp":"2026-05-11T13:43:52.320Z"}
