rbitrary repo for the current\\n+// suite-wide E2E checkpoints mode. Useful for repos created outside SetupRepo,\\n+// such as fresh clones in remote-resume scenarios.\\n+func ApplySuiteCheckpointsMode(t *testing.T, dir string) {\\n+\\tt.Helper()\\n+\\n+\\tswitch checkpointsMode() {\\n+\\tcase checkpointsModeLegacy:\\n+\\t\\treturn\\n+\\tcase checkpointsModeV2DualWrite:\\n+\\t\\tEnableCheckpointsV2(t, dir)\\n+\\tcase checkpointsModeV2Only:\\n+\\t\\tEnableCheckpointsVersion2(t, dir)\\n+\\tdefault:\\n+\\t\\tt.Fatalf(\\\"unsupported E2E_CHECKPOINTS_MODE %q (expected legacy, v2-dual-write, or v2-only)\\\", checkpointsMode())\\n+\\t}\\n+}\\n+\\n+func applySuiteCheckpointsMode(t *testing.T, dir string) {\\n+\\tt.Helper()\\n+\\tApplySuiteCheckpointsMode(t, dir)\\n+}\\n+\\n+func checkpointsMode() string {\\n+\\tswitch mode := os.Getenv(\\\"E2E_CHECKPOINTS_MODE\\\"); mode {\\n+\\tcase \\\"\\\", checkpointsModeLegacy:\\n+\\t\\treturn checkpointsModeLegacy\\n+\\tcase checkpointsModeV2DualWrite, checkpointsModeV2Only:\\n+\\t\\treturn mode\\n+\\tdefault:\\n+\\t\\treturn mode\\n+\\t}\"}]}},{\"isResolved\":false,\"isOutdated\":true,\"path\":\"e2e/testutil/assertions.go\",\"comments\":{\"nodes\":[{\"author\":{\"login\":\"copilot-pull-request-reviewer\"},\"body\":\"WaitForCheckpoint now polls `primaryCheckpointRef()` (v2 /main in both v2-dual-write and v2-only), but many other E2E assertions/utilities still hardcode `entire/checkpoints/v1` (e.g. AssertCheckpointExists / AssertCheckpointInLastN / ReadCheckpointMetadata). In v2-only this will consistently fail (no v1 ref), and in v2-dual-write it can introduce flakiness because the wait condition may be satisfied before the v1 branch advances.\\n\\nRecommend making the checkpoint-assertion helpers consistently mode-aware (use a single ref source for both waiting and subsequent reads), or in dual-write explicitly wait for both v1 and v2 refs to advance before proceeding. As-is, the suite-wide mode toggle looks incomplete.\",\"url\":\"h