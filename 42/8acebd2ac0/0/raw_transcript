ence":null,"stop_details":null,"usage":{"input_tokens":6,"cache_creation_input_tokens":28,"cache_read_input_tokens":112387,"output_tokens":2482,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":28,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":6,"output_tokens":2482,"cache_read_input_tokens":112387,"cache_creation_input_tokens":28,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28},"type":"message"}],"speed":"standard"}},"requestId":"req_011CaojBNiq6834Gc9sk9cdq","type":"assistant","uuid":"e7bfc172-6dc7-4e72-84a0-b93d16ecee98","timestamp":"2026-05-07T19:04:15.575Z","userType":"external","entrypoint":"cli","cwd":"/Users/ninawork/entire/devenv/cli","sessionId":"2258e038-9f02-499e-98ec-73c37394ea23","version":"2.1.132","gitBranch":"migration-performance-improvements"}
