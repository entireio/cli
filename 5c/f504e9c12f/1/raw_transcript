r)\n172\t}\n173\t\n174\t// fetchMetadataBranchIfMissing fetches the metadata branch from a URL only if it doesn't exist locally.\n175\t// This avoids network calls on every push — once the branch exists locally, this is a no-op.\n176\t// Fetch failures are silently swallowed (returns nil): the push will handle creating the\n177\t// branch on the remote. Only fatal errors (opening repo, creating local branch) are returned.\n178\tfunc fetchMetadataBranchIfMissing(ctx context.Context, remoteURL string) error {\n179\t\trepo, err := OpenRepository(ctx)\n180\t\tif err != nil {\n181\t\t\treturn fmt.Errorf(\"failed to open repository: %w\", err)\n182\t\t}\n183\t\n184\t\t// Check if branch already exists locally - if so, nothing to do\n185\t\tbranchRef := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n186\t\tif _, err := repo.Reference(branchRef, true); err == nil {\n187\t\t\treturn nil // Branch exists locally, skip fetch\n188\t\t}\n189\t\n190\t\t// Branch doesn't exist locally - try to fetch it from the URL.\n191\t\t// Fetch failures are not fatal: push will create it on the remote when it succeeds.\n192\t\tif err := FetchMetadataBranch(ctx, remoteURL); err != nil {\n193\t\t\treturn nil //nolint:nilerr // Fetch failure is expected when remote is unreachable or branch doesn't exist yet\n194\t\t}\n195\t\n196\t\tlogging.Info(ctx, \"checkpoint-remote: fetched metadata branch from URL\")\n197\t\treturn nil\n198\t}\n199\t\n200\t// fetchV2MainRefIfMissing fetches the v2 /main ref from a URL only if it doesn't\n201\t// exist locally. Delegates to FetchV2MainFromURL for the actual fetch.\n202\tfunc fetchV2MainRefIfMissing(ctx context.Context, remoteURL string) error {\n203\t\trepo, err := OpenRepository(ctx)\n204\t\tif err != nil {\n205\t\t\treturn fmt.Errorf(\"failed to open repository: %w\", err)\n206\t\t}\n207\t\n208\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n209\t\tif _, err := repo.Reference(refName, true); err == nil {\n210\t\t\treturn nil // Ref e