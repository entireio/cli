aForMigratedFullGenerationWithRootSession(repo, cpID, summary, v1ToV2SessionIdx, rootTaskV2SessionIdx, attachRootTasks)\n981\t}\n982\t\n983\tfunc collectTaskMetadataForMigratedFullGenerationWithRootSession(\n984\t\trepo *git.Repository,\n985\t\tcpID id.CheckpointID,\n986\t\tsummary *checkpoint.CheckpointSummary,\n987\t\tv1ToV2SessionIdx map[int]int,\n988\t\trootTaskV2SessionIdx int,\n989\t\tattachRootTasks bool,\n990\t) (map[int][]plumbing.Hash, error) {\n991\t\tv1Tree, err := resolveV1CheckpointTree(repo, cpID)\n992\t\tif err != nil {\n993\t\t\treturn nil, err\n994\t\t}\n995\t\n996\t\ttaskTrees := make(map[int][]plumbing.Hash)\n997\t\n998\t\t// Legacy v1 layout stores task metadata at checkpoint root: <cp>/tasks/<tool-use-id>/...\n999\t\t// Prefer attaching this tree to the latest session in v2.\n1000\t\tif rootTasksTree, rootTasksErr := v1Tree.Tree(\"tasks\"); rootTasksErr == nil {\n1001\t\t\tif attachRootTasks {\n1002\t\t\t\ttaskTrees[rootTaskV2SessionIdx] = append(taskTrees[rootTaskV2SessionIdx], rootTasksTree.Hash)\n1003\t\t\t}\n1004\t\t}\n1005\t\n1006\t\tfor sessionIdx := range len(summary.Sessions) {\n1007\t\t\tsessionDir := strconv.Itoa(sessionIdx)\n1008\t\t\tsessionTree, sessionErr := v1Tree.Tree(sessionDir)\n1009\t\t\tif sessionErr != nil {\n1010\t\t\t\tcontinue\n1011\t\t\t}\n1012\t\n1013\t\t\ttasksTree, tasksErr := sessionTree.Tree(\"tasks\")\n1014\t\t\tif tasksErr != nil {\n1015\t\t\t\tcontinue\n1016\t\t\t}\n1017\t\n1018\t\t\tv2SessionIdx, ok := v1ToV2SessionIdx[sessionIdx]\n1019\t\t\tif !ok {\n1020\t\t\t\tcontinue\n1021\t\t\t}\n1022\t\t\ttaskTrees[v2SessionIdx] = append(taskTrees[v2SessionIdx], tasksTree.Hash)\n1023\t\t}\n1024\t\n1025\t\treturn taskTrees, nil\n1026\t}\n1027\t\n1028\tfunc latestMigratedV2SessionIndex(v1ToV2SessionIdx map[int]int) (int, bool) {\n1029\t\tlatest := -1\n1030\t\tfor _, v2SessionIdx := range v1ToV2SessionIdx {\n1031\t\t\tif v2SessionIdx > latest {\n1032\t\t\t\tlatest = v2SessionIdx\n1033\t\t\t}\n1034\t\t}\n1035\t\tif latest < 