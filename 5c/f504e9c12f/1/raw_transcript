bleTerminalPrompt(cmd)\n88\t\toutput, err := cmd.CombinedOutput()\n89\t\tif err != nil {\n90\t\t\tredactedURL := RedactURL(remote)\n91\t\t\tmsg := strings.TrimSpace(strings.ReplaceAll(string(output), remote, redactedURL))\n92\t\t\tif msg != \"\" {\n93\t\t\t\treturn fmt.Errorf(\"git fetch-pack from %s: %s: %w\", redactedURL, msg, err)\n94\t\t\t}\n95\t\t\treturn fmt.Errorf(\"git fetch-pack from %s: %w\", redactedURL, err)\n96\t\t}\n97\t\treturn nil\n98\t}\n99\t\n100\t// PushResult holds raw porcelain output from git push.\n101\ttype PushResult struct {\n102\t\tOutput string\n103\t}\n104\t\n105\t// PushOptions configures a git push operation.\n106\ttype PushOptions struct {\n107\t\tRemote    string\n108\t\tRefSpecs  []string\n109\t\tExtraArgs []string // additional flags before remote\n110\t\tDir       string\n111\t}\n112\t\n113\t// Push runs git push --no-verify --porcelain with token injection.\n114\t// GIT_TERMINAL_PROMPT=0 is always set.\n115\tfunc Push(ctx context.Context, remote, refSpec string) (PushResult, error) {\n116\t\treturn PushWithOptions(ctx, PushOptions{\n117\t\t\tRemote:   remote,\n118\t\t\tRefSpecs: []string{refSpec},\n119\t\t})\n120\t}\n121\t\n122\t// PushWithOptions runs git push --no-verify --porcelain with token injection.\n123\t// GIT_TERMINAL_PROMPT=0 is always set.\n124\tfunc PushWithOptions(ctx context.Context, opts PushOptions) (PushResult, error) {\n125\t\tpushTarget, err := resolvePushCommandTarget(ctx, opts.Remote)\n126\t\tif err != nil {\n127\t\t\treturn PushResult{}, fmt.Errorf(\"resolve push target: %w\", err)\n128\t\t}\n129\t\n130\t\targs := []string{\"push\", \"--no-verify\", \"--porcelain\"}\n131\t\targs = append(args, opts.ExtraArgs...)\n132\t\targs = append(args, pushTarget)\n133\t\targs = append(args, opts.RefSpecs...)\n134\t\n135\t\tcmd := newCommand(ctx, args...)\n136\t\tif opts.Dir != \"\" {\n137\t\t\tcmd.Dir = opts.Dir\n138\t\t}\n139\t\tdisableTerminalPrompt(cmd)\n140\t\toutput, err := cmd.CombinedOutput()\n141\t\tif err != nil {\n142\t\t\treturn PushResult{Output: string(output)}, fmt.Errorf(\"git push: %w\", err)\n143\t\t}\n144\t\treturn PushResult{Output: string(output)}, nil\n145\t}\n146\t\n147\t// LsRemote runs git ls-remote with token injection.\n148\t// GIT_TERMINAL_PROMPT=0 is always set. Returns stdout only.\n149\tfunc LsRemote(ctx context.Context, remote string, patterns ...string) ([]byte, error) {\n150\t\treturn lsRemote(ctx, \"\", remote, patterns...)\n151\t}\n152\t\n153\t// LsRemoteInDir is like LsRemote but runs in a specific directory.\n154\tfunc LsRemoteInDir(ctx context.Context, dir, remote string, patterns ...string) ([]byte, error) {\n155\t\treturn lsRemote(ctx, dir, remote, patterns...)\n156\t}\n157\t\n158\tfunc lsRemote(ctx context.Context, dir, remote string, patterns ...string) ([]byte, error) {\n159\t\targs := append([]string{\"ls-remote\", remote}, patterns...)\n160\t\tcmd := newCommand(ctx, args...)\n161\t\tif dir != \"\" {\n162\t\t\tcmd.Dir = dir\n163\t\t}\n164\t\tdisableTerminalPrompt(cmd)\n165\t\tout, err := cmd.Output()\n166\t\tif err != nil {\n167\t\t\treturn out, fmt.Errorf(\"git ls-remote: %w\", err)\n168\t\t}\n169\t\treturn out, nil\n170\t}\n171\t\n172\t// IsURL returns true if the target looks like a URL rather than a git remote name.\n173\tfunc IsURL(target string) bool {\n174\t\treturn strings.Contains(target, \"://\") || strings.Contains(target, \"@\")\n175\t}\n176\t\n177\t// ResolveFetchTarget returns the git fetch target to use. When filtered\n178\t// fetches are enabled, configured remotes are resolved to their URL so git does\n179\t// not persist promisor settings onto the remote name.\n180\tfunc ResolveFetchTarget(ctx context.Context, target string) (string, error) {\n181\t\tif IsURL(target) || isLocalPath(target) || !settings.IsFilteredFetchesEnabled(ctx) {\n182\t\t\treturn target, nil\n183\t\t}\n184\t\turl, err := GetRemoteURL(ctx, target)\n185\t\tif err != nil {\n186\t\t\treturn \"\", fmt.Errorf(\"get remote URL: %w\", err)\n187\t\t}\n188\t\treturn url, nil\n189\t}\n190\t\n191\t// newCommand creates an exec.Cmd for a git operation that may need\n192\t// checkpoint token authentication. If ENTIRE_CHECKPOINT_TOKEN is set:\n193\t//   - if the target in args is (or resolves to) an SSH remote, the target is\n194\t//     rewritten in the args to the equivalent HTTPS URL so git uses HTTP\n195\t//     transport and our injected Authorization header applies;\n196\t//   - a Basic auth token is then injected via GIT_CONFIG_COUNT/GIT_CONFIG_KEY_*/\n197\t//     GIT_CONFIG_VALUE_* environment variables.\n198\t//\n199\t// If rewriting fails (unparseable URL, missing owner/repo) the command runs\n200\t// unmodified and a one-shot warning is printed.\n201\t// For empty/unset tokens, the command is returned unmodified.\n202\t//\n203\t// The remote is extracted from args by skipping the git subcommand and any flags\n204\t// (arguments starting with \"-\"). For example, in\n205\t// [\"push\", \"--no-verify\", \"origin\", \"main\"], the remote is \"origin\".\n206\tfunc newCommand(ctx context.Context, args ...string) *exec.Cmd {\n207\t\ttoken := strings.TrimSpace(os.Getenv(CheckpointTokenEnvVar))\n208\t\n209\t\tmkCmd := func(finalArgs []string) *exec.Cmd {\n210\t\t\tc := exec.CommandContext(ctx, \"git\", finalArgs...)\n211\t\t\tc.Stdin = nil // Disconnect stdin to prevent hanging in hook context\n212\t\t\treturn c\n213\t\t}\n214\t\n215\t\tif token == \"\" {\n216\t\t\treturn mkCmd(args)\n217\t\t}\n218\t\n219\t\tif !isValidToken(token) {\n220\t\t\tfmt.Fprintf(os.Stderr, \"[entire] Warning: %s contains invalid characters (CR, LF, or other control chars) — token ignored\\n\", CheckpointTokenEnvVar)\n221\t\t\treturn mkCmd(args)\n222\t\t}\n223\t\n224\t\ttarget := extractRemoteFromArgs(args)\n225\t\tif target == \"\" {\n226\t\t\treturn mkCmd(args)\n227\t\t}\n228\t\n229\t\tnewTarget, protocol := resolveTargetForTokenAuth(ctx, target)\n230\t\tif newTarget != target {\n231\t\t\targs = replaceFirstPositional(args, newTarget)\n232\t\t}\n233\t\n234\t\tcmd := mkCmd(args)\n235\t\n236\t\tswitch protocol {\n237\t\tcase ProtocolSSH:\n238\t\t\tsshTokenWarningOnce.Do(func() {\n239\t\t\t\tfmt.Fprintf(os.Stderr, \"[entire] Warning: %s is set but remote uses SSH — token ignored for SSH remotes\\n\", CheckpointTokenEnvVar)\n240\t\t\t})\n241\t\t\treturn cmd\n242\t\tcase ProtocolHTTPS:\n243\t\t\tcmd.Env = appendCheckpointTokenEnv(os.Environ(), token)\n244\t\t\treturn cmd\n245\t\tdefault:\n246\t\t\t// Unknown protocol (e.g., local path, or resolution failed) — don't inject\n247\t\t\treturn cmd\n248\t\t}\n249\t}\n250\t\n251\t// resolveTargetForTokenAuth resolves a git target (remote name or URL) to its\n252\t// effective protocol, rewriting SSH targets to the equivalent HTTPS URL so\n253\t// token-based auth can be applied. Returns the (possibly rewritten) target and\n254\t// its final protocol. Protocol is \"\" when resolution fails (local path,\n255\t// nonexistent remote, unparseable URL).\n256\t//\n257\t// This is only meaningful when ENTIRE_CHECKPOINT_TOKEN is set; callers gate on\n258\t// that themselves.\n259\tfunc resolveTargetForTokenAuth(ctx context.Context, target string) (string, string) {\n260\t\tif target == \"\" || isLocalPath(target) {\n261\t\t\treturn target, \"\"\n262\t\t}\n263\t\n264\t\trawURL := target\n265\t\tif !IsURL(target) {\n266\t\t\tvar err error\n267\t\t\trawURL, err = GetRemoteURL(ctx, target)\n268\t\t\tif err != nil {\n269\t\t\t\treturn target, \"\"\n270\t\t\t}\n271\t\t}\n272\t\n273\t\tinfo, err := ParseURL(rawURL)\n274\t\tif err != nil {\n275\t\t\treturn target, \"\"\n276\t\t}\n277\t\n278\t\tif info.Protocol == ProtocolSSH {\n279\t\t\tif httpsURL, ok := deriveTokenOriginURL(rawURL); ok {\n280\t\t\t\treturn httpsURL, ProtocolHTTPS\n281\t\t\t}\n282\t\t\treturn target, ProtocolSSH\n283\t\t}\n284\t\n285\t\treturn target, info.Protocol\n286\t}\n287\t\n288\t// replaceFirstPositional returns a copy of args with the first non-flag\n289\t// argument after args[0] (the git subcommand) replaced by newTarget. Callers\n290\t// use this to rewrite a remote name/URL after resolution without mutating the\n291\t// original slice.\n292\tfunc replaceFirstPositional(args []string, newTarget string) []string {\n293\t\tout := make([]string, len(args))\n294\t\tcopy(out, args)\n295\t\tfor i := 1; i < len(out); i++ {\n296\t\t\tif !strings.HasPrefix(out[i], \"-\") {\n297\t\t\t\tout[i] = newTarget\n298\t\t\t\treturn out\n299\t\t\t}\n300\t\t}\n301\t\treturn out\n302\t}\n303\t\n304\t// extractRemoteFromArgs finds the remote URL or name from git command args.\n305\t// It skips the subcommand (first arg) and any flags (args starting with \"-\"),\n306\t// returning the first positional argument, which is the remote for push/fetch/ls-remote.\n307\tfunc extractRemoteFromArgs(args []string) string {\n308\t\tif len(args) < 2 {\n309\t\t\treturn \"\"\n310\t\t}\n311\t\t// Skip subcommand (e.g., \"push\", \"fetch\", \"ls-remote\").\n312\t\tfor _, arg := range args[1:] {\n313\t\t\tif !strings.HasPrefix(arg, \"-\") {\n314\t\t\t\treturn arg\n315\t\t\t}\n316\t\t}\n317\t\treturn \"\"\n318\t}\n319\t\n320\t// appendCheckpointTokenEnv appends GIT_CONFIG_COUNT-based env vars to inject\n321\t// an Authorization header into git HTTP requests. The token is sent as a Basic\n322\t// credential with the format \"x-access-token:<token>\" (base64-encoded), which\n323\t// is compatible with GitHub's token authentication.\n324\t//\n325\t// Existing GIT_CONFIG_KEY_*/GIT_CONFIG_VALUE_* entries are preserved; the new\n326\t// http.extraHeader entry is appended at the next free index and\n327\t// GIT_CONFIG_COUNT is updated accordingly. This keeps caller-injected git\n328\t// config (e.g., safe.directory, custom CA settings) intact.\n329\tfunc appendCheckpointTokenEnv(baseEnv []string, token string) []string {\n330\t\texistingCount := 0\n331\t\tfor _, e := range baseEnv {\n332\t\t\trest, ok := strings.CutPrefix(e, \"GIT_CONFIG_COUNT=\")\n333\t\t\tif !ok {\n334\t\t\t\tcontinue\n335\t\t\t}\n336\t\t\tif n, err := strconv.Atoi(rest); err == nil && n > 0 {\n337\t\t\t\texistingCount = n\n338\t\t\t}\n339\t\t}\n340\t\n341\t\t// Strip the old GIT_CONFIG_COUNT entry (we'll emit a new one) but keep\n342\t\t// GIT_CONFIG_KEY_*/GIT_CONFIG_VALUE_* entries in place.\n343\t\tfiltered := make([]string, 0, len(baseEnv)+3)\n344\t\tfor _, e := range baseEnv {\n345\t\t\tif strings.HasPrefix(e, \"GIT_CONFIG_COUNT=\") {\n346\t\t\t\tcontinue\n347\t\t\t}\n348\t\t\tfiltered = append(filtered, e)\n349\t\t}\n350\t\n351\t\tidx := existingCount\n352\t\tencoded := base64.StdEncoding.EncodeToString([]byte(\"x-access-token:\" + token))\n353\t\treturn append(filtered,\n354\t\t\tfmt.Sprintf(\"GIT_CONFIG_COUNT=%d\", existingCount+1),\n355\t\t\tfmt.Sprintf(\"GIT_CONFIG_KEY_%d=http.extraHeader\", idx),\n356\t\t\tfmt.Sprintf(\"GIT_CONFIG_VALUE_%d=Authorization: Basic %s\", idx, encoded),\n357\t\t)\n358\t}\n359\t\n360\t// isValidToken returns false if the token contains control characters (bytes < 0x20\n361\t// or 0x7F). This prevents HTTP header injection via CR/LF or other control chars\n362\t// embedded in the token value.\n363\tfunc isValidToken(token string) bool {\n364\t\tfor _, b := range []byte(token) {\n365\t\t\tif b < 0x20 || b == 0x7F {\n366\t\t\t\treturn false\n367\t\t\t}\n368\t\t}\n369\t\treturn true\n370\t}\n371\t\n372\t// resolvePushCommandTarget returns the target to pass to git push. When a\n373\t// dedicated checkpoint_remote is configured, the checkpoint URL is returned so\n374\t// the push is routed to the separate checkpoint repo. Otherwise the remote\n375\t// name is returned unchanged so git uses its own config, updates the\n376\t// refs/remotes/<name>/<branch> tracking ref, and subsequent calls can use that\n377\t// tracking ref to skip redundant pushes.\n378\t//\n379\t// SSH→HTTPS coercion for token auth is handled by newCommand, which rewrites\n380\t// the command args or injects per-host config, rather than being baked into\n381\t// the target here.\n382\tfunc resolvePushCommandTarget(ctx context.Context, target string) (string, error) {\n383\t\tif target == \"\" || IsURL(target) || isLocalPath(target) {\n384\t\t\treturn target, nil\n385\t\t}\n386\t\n387\t\tpushTarget, enabled, err := PushURL(ctx, target)\n388\t\tif err != nil {\n389\t\t\treturn \"\", err\n390\t\t}\n391\t\tif !enabled || pushTarget == \"\" {\n392\t\t\treturn target, nil\n393\t\t}\n394\t\treturn pushTarget, nil\n395\t}\n396\t\n397\tfunc isLocalPath(target string) bool {\n398\t\treturn filepath.IsAbs(target) || strings.HasPrefix(target, \"./\") || strings.HasPrefix(target, \"../\")\n399\t}\n400\t\n401\t// disableTerminalPrompt sets GIT_TERMINAL_PROMPT=0 on the command,\n402\t// initializing cmd.Env from os.Environ() if nil.\n403\tfunc disableTerminalPrompt(cmd *exec.Cmd) {\n404\t\tif cmd.Env == nil {\n405\t\t\tcmd.Env = os.Environ()\n406\t\t}\n407\t\tcmd.Env = append(cmd.Env, \"GIT_TERMINAL_PROMPT=0\")\n408\t}\n409\t"}]},"uuid":"e385ada1-cf87-46b9-9606-d71f0668e574","timestamp":"2026-05-06T18:17:01.506Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/ninawork/entire/devenv/cli/cmd/entire/cli/checkpoint/remote/git.go","content":"package remote\n\nimport (\n\t\"context\"\n\t\"encoding/base64\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n)\n\n// CheckpointTokenEnvVar is the environment variable for providing an access token\n// used to authenticate git push/fetch operations for checkpoint branches.\n// The token is injected as an HTTP Basic Authorization header per RFC 7617:\n// the credentials string \"x-access-token:<token>\" is base64-encoded and sent as\n// \"Authorization: Basic <base64>\". This matches GitHub's token auth for Git HTTPS.\n// SSH remotes ignore the token (with a warning).\nconst CheckpointTokenEnvVar = \"ENTIRE_CHECKPOINT_TOKEN\"\n\nvar sshTokenWarningOnce sync.Once //nolint:gochecknoglobals // intentional per-process gate\n\n// Fetc