ad v1 session %d: %w\", sessionIdx, readErr)\n369\t\t\t}\n370\t\t\tif content.Metadata.IsTask {\n371\t\t\t\tshouldCopyTaskMetadata = true\n372\t\t\t}\n373\t\n374\t\t\topts := buildMigrateWriteOpts(content, info, summary.CombinedAttribution)\n375\t\n376\t\t\tcompacted := tryCompactTranscript(ctx, content.Transcript, content.Metadata)\n377\t\t\tif compacted != nil {\n378\t\t\t\topts.CompactTranscript = compacted\n379\t\t\t\topts.CompactTranscriptStart = computeCompactOffset(ctx, content.Transcript, compacted, content.Metadata)\n380\t\t\t} else if len(content.Transcript) > 0 {\n381\t\t\t\tcompactFailed = true\n382\t\t\t}\n383\t\n384\t\t\tmainOpts := opts\n385\t\t\tmainOpts.Transcript = redact.AlreadyRedacted(nil)\n386\t\t\tv2SessionIdx, writeErr := v2Store.WriteCommittedWithSessionIndex(ctx, mainOpts)\n387\t\t\tif writeErr != nil {\n388\t\t\t\treturn nil, outcome, fmt.Errorf(\"failed to write v2 session %d: %w\", sessionIdx, writeErr)\n389\t\t\t}\n390\t\t\tv1ToV2SessionIdx[sessionIdx] = v2SessionIdx\n391\t\t\tfullCheckpoint.sessions = append(fullCheckpoint.sessions, migratedFullSession{\n392\t\t\t\tsessionIndex: v2SessionIdx,\n393\t\t\t\tcontent:      content,\n394\t\t\t})\n395\t\t\tmigratedSessions++\n396\t\t}\n397\t\n398\t\tif migratedSessions == 0 {\n399\t\t\treturn nil, outcome, fmt.Errorf(\"%w: v1 metadata lists %d session(s), but no transcript/session content exists for any of them\", errNoMigratableSessions, len(summary.Sessions))\n400\t\t}\n401\t\n402\t\tif shouldCopyTaskMetadata {\n403\t\t\ttaskTrees, taskErr := collectTaskMetadataForMigratedFullGeneration(repo, info.CheckpointID, summary, v1ToV2SessionIdx)\n404\t\t\tif taskErr != nil {\n405\t\t\t\tlogging.Warn(ctx, \"failed to copy task metadata to v2\",\n406\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n407\t\t\t\t\tslog.String(\"error\", taskErr.Error()),\n408\t\t\t\t)\n409\t\t\t} else {\n410\t\t\t\tfullCheckpoint.taskTrees = taskTrees\n411\t\t\t}\n412\t\t}\n413\t\n414\t\tif compactFailed {\n415\t\t\toutcome.compactTranscriptSkipped = true\n416\t\t\tlogging.Warn(ctx, \"compact transcript not generated during checkpoint migration\",\n417\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n418\t\t\t\tslog.Int(\"migrated_sessions\", migratedSessions),\n419\t\t\t)\n420\t\t}\n421\t\tif skippedMissingSessions > 0 {\n422\t\t\tlogging.Warn(ctx, \"checkpoint migration skipped v1 sessions with missing transcript/session content\",\n423\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n424\t\t\t\tslog.Int(\"missing_sessions\", skippedMissingSessions),\n425\t\t\t)\n426\t\t}\n427\t\n428\t\treturn fullCheckpoint, outcome, nil\n429\t}\n430\t\n431\t// generationPacker buffers up to batchSize migrated checkpoints and flushes\n432\t// them into a single archived /full/<n> ref each time the buffer fills, so\n433\t// peak heap stays bounded by one batch worth of transcripts instead of\n434\t// growing with the total v1 list. The next generation number is resolved\n435\t// lazily on first flush so force-migration prune steps that remove existing\n436\t// archived refs are visible before we pick the next slot.\n437\ttype generationPacker struct {\n438\t\trepo           *git.Repository\n439\t\tv2Store        *checkpoint.V2GitStore\n440\t\tbatchSize      int\n441\t\tnextGeneration int\n442\t\tnumbered       bool\n443\t\tpending        []migratedFullCheckpoint\n444\t\tflushed        bool\n445\t\t// writtenRefs records every /full/<n> ref this packer creates so the\n446\t\t// caller can exclude them from the generation-metadata repair pass.\n447\t\twrittenRefs []plumbing.ReferenceName\n448\t}\n449\t\n450\tfunc newGenerationPacker(repo *git.Repository, v2Store *checkpoint.V2GitStore) *generationPacker {\n451\t\tbatchSize := migrateMaxCheckpointsPerGeneration\n452\t\tif batchSize <= 0 {\n453\t\t\tbatchSize = checkpoint.DefaultMaxCheckpointsPerGeneration\n454\t\t}\n455\t\treturn &generationPacker{\n456\t\t\trepo:      repo,\n457\t\t\tv2Store:   v2Store,\n458\t\t\tbatchSize: batchSize,\n459\t\t}\n460\t}\n461\t\n462\tfunc (p *generationPacker) add(ctx context.Context, cp migratedFullCheckpoint) error {\n463\t\tp.pending = append(p.pending, cp)\n464\t\tif len(p.pending) >= p.batchSize {\n465\t\t\treturn p.flush(ctx)\n466\t\t}\n467\t\treturn nil\n468\t}\n469\t\n470\tfunc (p *generationPacker) flush(ctx context.Context) error {\n471\t\tif len(p.pending) == 0 {\n472\t\t\treturn nil\n473\t\t}\n474\t\tif !p.numbered {\n475\t\t\tnext, err := p.v2Store.NextGenerationNumber()\n476\t\t\tif err != nil {\n477\t\t\t\treturn fmt.Errorf(\"list archived v2 generations: %w\", err)\n478\t\t\t}\n479\t\t\tp.nextGeneration = next\n480\t\t\tp.numbered = true\n481\t\t}\n482\t\trefName := plumbing.ReferenceName(fmt.Sprintf(\"%s%013d\", paths.V2FullRefPrefix, p.nextGeneration))\n483\t\tif err := writeMigratedFullGeneration(ctx, p.repo, refName, p.pending); err != nil {\n484\t\t\treturn err\n485\t\t}\n486\t\tp.writtenRefs = append(p.writtenRefs, refName)\n487\t\tp.nextGeneration++\n488\t\tp.pending = nil\n489\t\tp.flushed = true\n490\t\treturn nil\n491\t}\n492\t\n493\tfunc (p *generationPacker) finalize(ctx context.Context, ensureEmptyCurrent bool) error {\n494\t\tif err := p.flush(ctx); err != nil {\n495\t\t\treturn err\n496\t\t}\n497\t\tif p.flushed && ensureEmptyCurrent {\n498\t\t\treturn ensureEmptyV2FullCurrent(ctx, p.repo)\n499\t\t}\n500\t\treturn nil\n501\t}\n502\t\n503\tfunc writeMigratedFullGeneration(ctx context.Context, repo *git.Repository, refName plumbing.ReferenceName, checkpoints []migratedFullCheckpoint) error {\n504\t\tentries := make(map[string]object.TreeEntry)\n505\t\n506\t\tfor _, cp := range checkpoints {\n507\t\t\tfor _, session := range cp.sessions {\n508\t\t\t\tif err := writeMigratedFullSessionEntries(ctx, repo, cp, session, entries); err != nil {\n509\t\t\t\t\treturn fmt.Errorf(\"write full session entries for checkpoint %s session %d: %w\", cp.checkpointID, session.sessionIndex, err)\n510\t\t\t\t}\n511\t\t\t}\n512\t\t}\n513\t\n514\t\ttreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, entries)\n515\t\tif err != nil {\n516\t\t\treturn fmt.Errorf(\"build migrated generation tree: %w\", err)\n517\t\t}\n518\t\n519\t\tv2Store := checkpoint.NewV2GitStore(repo, migrateRemoteName)\n520\t\t// Reuse the transcripts already in memory rather than walking the tree\n521\t\t// we just built — same first/last-event range, no redundant blob reads.\n522\t\tgen, found := checkpoint.AggregateTranscriptTimestamps(migratedTranscripts(checkpoints))\n523\t\tif !found {\n524\t\t\tvar err error\n525\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n526\t\t\tif err != nil {\n527\t\t\t\treturn fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n528\t\t\t}\n529\t\t}\n530\t\tif !found {\n531\t\t\tgen, found = generationMetadataFromMigratedSessions(checkpoints)\n532\t\t}\n533\t\tif !found {\n534\t\t\treturn fmt.Errorf(\"no timestamps found for migrated generation %s\", refName)\n535\t\t}\n536\t\n537\t\ttreeHash, err = v2Store.AddGenerationJSONToTree(treeHash, gen)\n538\t\tif err != nil {\n539\t\t\treturn fmt.Errorf(\"add generation metadata: %w\", err)\n540\t\t}\n541\t\n542\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, treeHash, plumbing.ZeroHash,\n543\t\t\tfmt.Sprintf(\"Archive migrated generation: %s\\n\", refName),\n544\t\t\tmigrateAuthorName, migrateAuthorEmail)\n545\t\tif err != nil {\n546\t\t\treturn fmt.Errorf(\"create migrated generation commit: %w\", err)\n547\t\t}\n548\t\n549\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n550\t\t\treturn fmt.Errorf(\"update migrated generation ref %s: %w\", refName, err)\n551\t\t}\n552\t\treturn nil\n553\t}\n554\t\n555\tfunc migratedTranscripts(checkpoints []migratedFullCheckpoint) [][]byte {\n556\t\tvar transcripts [][]byte\n557\t\tfor _, cp := range checkpoints {\n558\t\t\tfor _, session := range cp.sessions {\n559\t\t\t\tif len(session.content.Transcript) == 0 {\n560\t\t\t\t\tcontinue\n561\t\t\t\t}\n562\t\t\t\ttranscripts = append(transcripts, session.content.Transcript)\n563\t\t\t}\n564\t\t}\n565\t\treturn transcripts\n566\t}\n567\t\n568\tfunc generationMetadataFromMigratedSessions(checkpoints []migratedFullCheckpoint) (checkpoint.GenerationMetadata, bool) {\n569\t\tvar gen checkpoint.GenerationMetadata\n570\t\tfound := false\n571\t\tfor _, cp := range checkpoints {\n572\t\t\tfor _, session := range cp.sessions {\n573\t\t\t\tcheckpoint.MergeGenerationTime(&gen, &found, session.content.Metadata.CreatedAt)\n574\t\t\t}\n575\t\t}\n576\t\treturn gen, found\n577\t}\n578\t\n579\tfunc writeMigratedFullSessionEntries(ctx context.Context, repo *git.Repository, cp migratedFullCheckpoint, session migratedFullSession, entries map[string]object.TreeEntry) error {\n580\t\tsessionPath := fmt.Sprintf(\"%s/%d/\", cp.checkpointID.Path(), session.sessionIndex)\n581\t\ttranscript := session.content.Transcript\n582\t\n583\t\tchunks, err := agent.ChunkTranscript(ctx, transcript, session.content.Metadata.Agent)\n584\t\tif err != nil {\n585\t\t\treturn fmt.Errorf(\"chunk transcript: %w\", err)\n586\t\t}\n587\t\tfor i, chunk := range chunks {\n588\t\t\tblobHash, blobErr := checkpoint.CreateBlobFromContent(repo, chunk)\n589\t\t\tif blobErr != nil {\n590\t\t\t\treturn fmt.Errorf(\"create transcript blob: %w\", blobErr)\n591\t\t\t}\n592\t\t\tpath := sessionPath + agent.ChunkFileName(paths.V2RawTranscriptFileName, i)\n593\t\t\tentries[path] = object.TreeEntry{\n594\t\t\t\tName: path,\n595\t\t\t\tMode: filemode.Regular,\n596\t\t\t\tHash: blobHash,\n597\t\t\t}\n598\t\t}\n599\t\n600\t\thashPath := sessionPath + paths.V2RawTranscriptHashFileName\n601\t\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n602\t\thashBlob, err := checkpoint.CreateBlobFromContent(repo, []byte(contentHash))\n603\t\tif err != nil {\n604\t\t\treturn fmt.Errorf(\"create transcript hash blob: %w\", err)\n605\t\t}\n606\t\tentries[hashPath] = object.TreeEntry{\n607\t\t\tName: hashPath,\n608\t\t\tMode: filemode.Regular,\n609\t\t\tHash: hashBlob,\n610\t\t}\n611\t\n612\t\tfor _, taskTreeHash := range cp.taskTrees[session.sessionIndex] {\n613\t\t\ttaskTree, treeErr := repo.TreeObject(taskTreeHash)\n614\t\t\tif treeErr != nil {\n615\t\t\t\treturn fmt.Errorf(\"read task metadata tree: %w\", treeErr)\n616\t\t\t}\n617\t\t\ttaskEntries := make(map[string]object.TreeEntry)\n618\t\t\tif flattenErr := checkpoint.FlattenTree(repo, taskTree, sessionPath+\"tasks\", taskEntries); flattenErr != nil {\n619\t\t\t\treturn fmt.Errorf(\"flatten task metadata tree: %w\", flattenErr)\n620\t\t\t}\n621\t\t\tfor path, entry := range taskEntries {\n622\t\t\t\tif _, exists := entries[path]; exists {\n623\t\t\t\t\tcontinue\n624\t\t\t\t}\n625\t\t\t\tentries[path] = entry\n626\t\t\t}\n627\t\t}\n628\t\n629\t\treturn nil\n630\t}\n631\t\n632\tfunc ensureEmptyV2FullCurrent(ctx context.Context, repo *git.Repository) error {\n633\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n634\t\tif _, err := repo.Reference(refName, true); err == nil {\n635\t\t\treturn nil\n636\t\t}\n637\t\n638\t\temptyTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, map[string]object.TreeEntry{})\n639\t\tif err != nil {\n640\t\t\treturn fmt.Errorf(\"build empty v2 full/current tree: %w\", err)\n641\t\t}\n642\t\n643\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, emptyTreeHash, plumbing.ZeroHash,\n644\t\t\t\"Start generation\\n\",\n645\t\t\tmigrateAuthorName, migrateAuthorEmail)\n646\t\tif err != nil {\n647\t\t\treturn fmt.Errorf(\"create empty v2 full/current commit: %w\", err)\n648\t\t}\n649\t\n650\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n651\t\t\treturn fmt.Errorf(\"update %s: %w\", refName, err)\n652\t\t}\n653\t\treturn nil\n654\t}\n655\t\n656\tfunc readV1SessionForMigration(ctx context.Context, v1Store *checkpoint.GitStore, checkpointID id.CheckpointID, sessionIdx int) (*checkpoint.SessionContent, bool, error) {\n657\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, checkpointID, sessionIdx)\n658\t\tif readErr != nil {\n659\t\t\tif errors.Is(readErr, checkpoint.ErrNoTranscript) || errors.Is(readErr, checkpoint.ErrCheckpointNotFound) {\n660\t\t\t\twarnMissingV1Session(ctx, checkpointID, sessionIdx, readErr)\n661\t\t\t\treturn nil, true, nil\n662\t\t\t}\n663\t\t\treturn nil, false, fmt.Errorf(\"read v1 session content: %w\", readErr)\n664\t\t}\n665\t\treturn content, false, nil\n666\t}\n667\t\n668\tfunc warnMissingV1Session(ctx context.Context, checkpointID id.CheckpointID, sessionIdx int, err error) {\n669\t\tlogging.Warn(ctx, \"skipping v1 session with missing transcript during checkpoint migration\",\n670\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n671\t\t\tslog.Int(\"session_index\", sessionIdx),\n672\t\t\tslog.String(\"error\", err.Error()),\n673\t\t)\n674\t}\n675\t\n676\tfunc pruneV2CheckpointForForce(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID) error {\n677\t\tfor _, refName := range []plumbing.ReferenceName{\n678\t\t\tplumbing.ReferenceName(paths.V2MainRefName),\n679\t\t\tplumbing.ReferenceName(paths.V2FullCurrentRefName),\n680\t\t} {\n681\t\t\tif err := pruneV2CheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n682\t\t\t\treturn err\n683\t\t\t}\n684\t\t}\n685\t\n686\t\tarchived, err := v2Store.ListArchivedGenerations()\n687\t\tif err != nil {\n688\t\t\treturn fmt.Errorf(\"failed to list archived v2 generations while pruning checkpoint %s: %w\", cpID, err)\n689\t\t}\n690\t\tfor _, generation := range archived {\n691\t\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + generation)\n692\t\t\tif err := pruneV2ArchivedCheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n693\t\t\t\treturn err\n694\t\t\t}\n695\t\t}\n696\t\n697\t\treturn nil\n698\t}\n699\t\n700\tfunc pruneV2CheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n701\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n702\t\tif err != nil {\n703\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n704\t\t\t\treturn nil\n705\t\t\t}\n706\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n707\t\t}\n708\t\n709\t\trootTree, err := repo.TreeObject(rootTreeHash)\n710\t\tif err != nil {\n711\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n712\t\t}\n713\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n714\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n715\t\t}\n716\t\n717\t\tshardPrefix := string(cpID[:2])\n718\t\tshardSuffix := string(cpID[2:])\n719\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n720\t\tif err != nil {\n721\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n722\t\t}\n723\t\tif newRoot == rootTreeHash {\n724\t\t\treturn nil\n725\t\t}\n726\t\n727\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n728\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n729\t\t\tmigrateAuthorName, migrateAuthorEmail)\n730\t\tif err != nil {\n731\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n732\t\t}\n733\t\n734\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n735\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n736\t\t}\n737\t\treturn nil\n738\t}\n739\t\n740\tfunc pruneV2ArchivedCheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n741\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n742\t\tif err != nil {\n743\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n744\t\t\t\treturn nil\n745\t\t\t}\n746\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n747\t\t}\n748\t\n749\t\trootTree, err := repo.TreeObject(rootTreeHash)\n750\t\tif err != nil {\n751\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n752\t\t}\n753\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n754\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n755\t\t}\n756\t\n757\t\tshardPrefix := string(cpID[:2])\n758\t\tshardSuffix := string(cpID[2:])\n759\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n760\t\tif err != nil {\n761\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n762\t\t}\n763\t\tif newRoot == rootTreeHash {\n764\t\t\treturn nil\n765\t\t}\n766\t\n767\t\tcount, err := v2Store.CountCheckpointsInTree(newRoot)\n768\t\tif err != nil {\n769\t\t\treturn fmt.Errorf(\"failed to count checkpoints in pruned %s: %w\", refName, err)\n770\t\t}\n771\t\tif count == 0 {\n772\t\t\tif err := repo.Storer.RemoveReference(refName); err != nil {\n773\t\t\t\treturn fmt.Errorf(\"failed to remove empty archived v2 generation %s: %w\", refName, err)\n774\t\t\t}\n775\t\t\treturn nil\n776\t\t}\n777\t\n778\t\tnewRoot, err = addRecomputedGenerationJSON(v2Store, newRoot)\n779\t\tif err != nil {\n780\t\t\treturn fmt.Errorf(\"failed to recompute generation metadata for %s: %w\", refName, err)\n781\t\t}\n782\t\n783\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n784\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n785\t\t\tmigrateAuthorName, migrateAuthorEmail)\n786\t\tif err != nil {\n787\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n788\t\t}\n789\t\n790\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n791\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n792\t\t}\n793\t\treturn nil\n794\t}\n795\t\n796\tfunc addRecomputedGenerationJSON(v2Store *checkpoint.V2GitStore, treeHash plumbing.Hash) (plumbing.Hash, error) {\n797\t\tgen, found, err := v2Store.ComputeGenerationTimestampsFromTrees(treeHash, nil)\n798\t\tif err != nil {\n799\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute raw transcript timestamps: %w\", err)\n800\t\t}\n801\t\tif !found {\n802\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n803\t\t\tif err != nil {\n804\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n805\t\t\t}\n806\t\t}\n807\t\tif !found {\n808\t\t\treturn treeHash, nil\n809\t\t}\n810\t\n811\t\tnewTreeHash, err := v2Store.AddGenerationJSONToTree(treeHash, gen)\n812\t\tif err != nil {\n813\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"add generation metadata: %w\", err)\n814\t\t}\n815\t\treturn newTreeHash, nil\n816\t}\n817\t\n818\tfunc pruneCheckpointFromRoot(repo *git.Repository, rootTreeHash plumbing.Hash, shardPrefix, shardSuffix string) (plumbing.Hash, error) {\n819\t\tnewRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n820\t\t\t[]string{shardPrefix},\n821\t\t\tnil,\n822\t\t\tcheckpoint.UpdateSubtreeOptions{\n823\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n824\t\t\t\tDeleteNames: []string{shardSuffix},\n825\t\t\t},\n826\t\t)\n827\t\tif err != nil {\n828\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune checkpoint from shard: %w\", err)\n829\t\t}\n830\t\tif newRoot == rootTreeHash {\n831\t\t\treturn newRoot, nil\n832\t\t}\n833\t\n834\t\tnewRootTree, err := repo.TreeObject(newRoot)\n835\t\tif err != nil {\n836\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to read pruned root tree: %w\", err)\n837\t\t}\n838\t\tshardTree, err := newRootTree.Tree(shardPrefix)\n839\t\tif err != nil {\n840\t\t\treturn newRoot, nil //nolint:nilerr // The shard prefix was already absent after pruning.