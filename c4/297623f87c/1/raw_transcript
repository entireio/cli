{"parentUuid":"780187f0-89b7-4066-89ea-b185f92deb8b","isSidechain":false,"promptId":"f73187d2-ae51-4903-8e9c-e6c9586ebc16","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013yZNXt31Y68oWMEydLxU8W","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"log/slog\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"slices\"\n14\t\t\"sort\"\n15\t\t\"strconv\"\n16\t\t\"strings\"\n17\t\t\"time\"\n18\t\n19\t\t\"github.com/charmbracelet/huh\"\n20\t\n21\t\tgit \"github.com/go-git/go-git/v6\"\n22\t\n23\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n24\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/external\"\n25\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/skilldiscovery\"\n26\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n27\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n28\t\tcheckpointID \"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n29\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/remote\"\n30\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n31\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n32\t\treviewenv \"github.com/entireio/cli/cmd/entire/cli/review\"\n33\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n34\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n35\t\t\"github.com/entireio/cli/cmd/entire/cli/trailers\"\n36\t\t\"github.com/spf13/cobra\"\n37\t)\n38\t\n39\tconst pendingReviewMarkerFilename = \"review-pending.json\"\n40\t\n41\t// agentChoice is one row in the spawn-time picker. Name is the agent\n42\t// registry key (used for marker/override); Label is the picker-visible\n43\t// string (\"<name>   (N skills configured)\" or \"<name>   (prompt-only)\").\n44\ttype agentChoice struct {\n45\t\tName  string\n46\t\tLabel string\n47\t}\n48\t\n49\t// runReviewDeps collects the runtime-injectable hooks runReview uses.\n50\t// Tests stub fields on this struct to drive branches that would otherwise\n51\t// require a real TTY. Production wiring leaves fields nil and defaults\n52\t// are resolved inside runReview.\n53\ttype runReviewDeps struct {\n54\t\tpromptForAgentFn func(ctx context.Context, eligible []agentChoice) (string, error)\n55\t}\n56\t\n57\t// PendingReviewMarker is written by `entire review` before spawning the agent.\n58\t// The next agent session's UserPromptSubmit hook reads it, tags the session\n59\t// kind/review-skills, then clears the marker (so a second review run doesn't\n60\t// inherit state from the first).\n61\t//\n62\t// WorktreePath scopes the marker to the worktree `entire review` was invoked\n63\t// from: multiple worktrees in one repo share .git/entire-sessions/, so without\n64\t// this field any session in any worktree could race to claim the marker. A\n65\t// blank WorktreePath (pre-fix markers) falls back to the legacy unscoped\n66\t// behavior — any session can adopt.\n67\ttype PendingReviewMarker struct {\n68\t\tAgentName string   `json:\"agent_name\"`\n69\t\tSkills    []string `json:\"skills\"`\n70\t\t// Prompt is the composed review prompt the agent will receive.\n71\t\t// Stored on the marker (rather than recomputed on adoption) so session\n72\t\t// metadata records exactly what the agent was asked to do.\n73\t\tPrompt       string    `json:\"prompt,omitempty\"`\n74\t\tStartingSHA  string    `json:\"starting_sha\"`\n75\t\tStartedAt    time.Time `json:\"started_at\"`\n76\t\tWorktreePath string    `json:\"worktree_path,omitempty\"`\n77\t}\n78\t\n79\tfunc pendingMarkerPath(ctx context.Context) (string, error) {\n80\t\tcommonDir, err := session.GetGitCommonDir(ctx)\n81\t\tif err != nil {\n82\t\t\treturn \"\", fmt.Errorf(\"locate git common dir: %w\", err)\n83\t\t}\n84\t\treturn filepath.Join(commonDir, session.SessionStateDirName, pendingReviewMarkerFilename), nil\n85\t}\n86\t\n87\t// WritePendingReviewMarker persists the marker. Overwrites any existing marker.\n88\tfunc WritePendingReviewMarker(ctx context.Context, m PendingReviewMarker) error {\n89\t\tpath, err := pendingMarkerPath(ctx)\n90\t\tif err != nil {\n91\t\t\treturn err\n92\t\t}\n93\t\tif err := os.MkdirAll(filepath.Dir(path), 0o750); err != nil {\n94\t\t\treturn fmt.Errorf(\"create sessions dir: %w\", err)\n95\t\t}\n96\t\tdata, err := json.MarshalIndent(m, \"\", \"  \")\n97\t\tif err != nil {\n98\t\t\treturn fmt.Errorf(\"marshal marker: %w\", err)\n99\t\t}\n100\t\tif err := os.WriteFile(path, data, 0o600); err != nil {\n101\t\t\treturn fmt.Errorf(\"write marker: %w\", err)\n102\t\t}\n103\t\treturn nil\n104\t}\n105\t\n106\t// ReadPendingReviewMarker returns the marker if one exists.\n107\t// ok=false with err=nil indicates \"no pending review.\"\n108\tfunc ReadPendingReviewMarker(ctx context.Context) (PendingReviewMarker, bool, error) {\n109\t\tpath, err := pendingMarkerPath(ctx)\n110\t\tif err != nil {\n111\t\t\treturn PendingReviewMarker{}, false, err\n112\t\t}\n113\t\tdata, err := os.ReadFile(path) //nolint:gosec // path derived from git dir\n114\t\tif errors.Is(err, os.ErrNotExist) {\n115\t\t\treturn PendingReviewMarker{}, false, nil\n116\t\t}\n117\t\tif err != nil {\n118\t\t\treturn PendingReviewMarker{}, false, fmt.Errorf(\"read marker: %w\", err)\n119\t\t}\n120\t\tvar m PendingReviewMarker\n121\t\tif err := json.Unmarshal(data, &m); err != nil {\n122\t\t\treturn PendingReviewMarker{}, false, fmt.Errorf(\"parse marker: %w\", err)\n123\t\t}\n124\t\treturn m, true, nil\n125\t}\n126\t\n127\t// ClearPendingReviewMarker removes the marker. Missing file is not an error.\n128\tfunc ClearPendingReviewMarker(ctx context.Context) error {\n129\t\tpath, err := pendingMarkerPath(ctx)\n130\t\tif err != nil {\n131\t\t\treturn err\n132\t\t}\n133\t\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n134\t\t\treturn fmt.Errorf(\"remove marker: %w\", err)\n135\t\t}\n136\t\treturn nil\n137\t}\n138\t\n139\t// Curated built-ins and install hints live in package skilldiscovery.\n140\t\n141\t// confirmFirstRunSetup prints a banner framing the picker as first-run\n142\t// setup (rather than the review itself) and waits for the user to confirm.\n143\t// Returns false if the user cancels; caller should bail gracefully.\n144\t//\n145\t// Signposting matters here because `entire review` with no config silently\n146\t// drops into the picker — users running the command to start a review can\n147\t// mistake the picker for the review. The banner + confirmation makes the\n148\t// setup phase explicit, and the trailing \"running review now\" line in the\n149\t// caller closes the loop on what comes next.\n150\tfunc confirmFirstRunSetup(out io.Writer) bool {\n151\t\tfmt.Fprintln(out, \"No review config found — let's set one up first.\")\n152\t\tfmt.Fprintln(out)\n153\t\tfmt.Fprintln(out, \"You'll pick skills for each installed agent. They're saved to\")\n154\t\tfmt.Fprintln(out, \".entire/settings.json; edit later with `entire review --edit`.\")\n155\t\tfmt.Fprintln(out, \"After setup, the review will run with your selection.\")\n156\t\tfmt.Fprintln(out)\n157\t\n158\t\tproceed := true\n159\t\tform := NewAccessibleForm(huh.NewGroup(\n160\t\t\thuh.NewConfirm().\n161\t\t\t\tTitle(\"Set up review skills now?\").\n162\t\t\t\tAffirmative(\"Yes\").\n163\t\t\t\tNegative(\"Cancel\").\n164\t\t\t\tValue(&proceed),\n165\t\t))\n166\t\tif err := form.Run(); err != nil {\n167\t\t\tfmt.Fprintln(out, \"Setup cancelled.\")\n168\t\t\treturn false\n169\t\t}\n170\t\tif !proceed {\n171\t\t\tfmt.Fprintln(out, \"Setup cancelled.\")\n172\t\t}\n173\t\treturn proceed\n174\t}\n175\t\n176\t// runReviewConfigPicker presents a huh multi-select for each installed agent\n177\t// that has curated review skills, and saves the selection to\n178\t// .entire/settings.json. Previously-saved skills are pre-checked via\n179\t// huh.Option.Selected(true), mirroring how `entire enable` preserves prior\n180\t// selections in its own agent picker.\n181\tfunc runReviewConfigPicker(ctx context.Context, out io.Writer) (map[string]settings.ReviewConfig, error) {\n182\t\tinstalled := GetAgentsWithHooksInstalled(ctx)\n183\t\tif len(installed) == 0 {\n184\t\t\treturn nil, errors.New(\n185\t\t\t\t\"no agents with hooks installed; \" +\n186\t\t\t\t\t\"run 'entire configure --agent <name>' to install hooks for one, \" +\n187\t\t\t\t\t\"or 'entire enable' to set up the repo\",\n188\t\t\t)\n189\t\t}\n190\t\n191\t\t// Narrow to agents that have a curated skills list; others need manual\n192\t\t// editing of settings.json under review.<agent-name>.\n193\t\ttype configurableAgent struct {\n194\t\t\tname types.AgentName\n195\t\t\tag   agent.Agent\n196\t\t}\n197\t\tvar configurable []configurableAgent\n198\t\tfor _, name := range installed {\n199\t\t\tif !skilldiscovery.IsEligible(string(name)) {\n200\t\t\t\tcontinue\n201\t\t\t}\n202\t\t\tag, err := agent.Get(name)\n203\t\t\tif err != nil {\n204\t\t\t\tcontinue\n205\t\t\t}\n206\t\t\tconfigurable = append(configurable, configurableAgent{name: name, ag: ag})\n207\t\t}\n208\t\tif len(configurable) == 0 {\n209\t\t\treturn nil, errors.New(\n210\t\t\t\t\"no installed agents have curated review skills; \" +\n211\t\t\t\t\t\"edit .entire/settings.json directly under review.<agent-name>\",\n212\t\t\t)\n213\t\t}\n214\t\n215\t\t// Load existing config so we can pre-check saved skills and seed saved\n216\t\t// prompts. A load error here means the settings file is malformed; log\n217\t\t// at Warn so users debugging \"my saved skills aren't pre-checked\" can\n218\t\t// see why, but keep going with an empty prefill — runReview already\n219\t\t// surfaces the same error distinctly when it's the first load.\n220\t\texisting := map[string]settings.ReviewConfig{}\n221\t\tif s, err := settings.Load(ctx); err != nil {\n222\t\t\tlogging.Warn(ctx, \"settings.Load failed when pre-filling picker\", slog.String(\"error\", err.Error()))\n223\t\t} else if s != nil {\n224\t\t\texisting = s.Review\n225\t\t}\n226\t\n227\t\t// Up-front header: make the order and count obvious so users can spot\n228\t\t// when an agent they expected isn't being offered (e.g., hooks not\n229\t\t// installed for it yet).\n230\t\tlabels := make([]string, 0, len(configurable))\n231\t\tfor _, c := range configurable {\n232\t\t\tlabels = append(labels, string(c.ag.Type()))\n233\t\t}\n234\t\tfmt.Fprintf(out, \"Configuring review for %d agent(s): %s\\n\", len(configurable), strings.Join(labels, \", \"))\n235\t\tfmt.Fprintln(out, \"(Previously-saved skills are pre-checked. Space to toggle, enter to confirm.)\")\n236\t\tfmt.Fprintln(out)\n237\t\n238\t\tselected := map[string]settings.ReviewConfig{}\n239\t\tfor i, c := range configurable {\n240\t\t\tcurated := skilldiscovery.CuratedBuiltinsFor(string(c.name))\n241\t\n242\t\t\t// Discover + dedupe + filter hints.\n243\t\t\tvar discovered []agent.DiscoveredSkill\n244\t\t\tif d, ok := c.ag.(agent.SkillDiscoverer); ok {\n245\t\t\t\tif ds, dErr := d.DiscoverReviewSkills(ctx); dErr == nil {\n246\t\t\t\t\tdiscovered = ds\n247\t\t\t\t} else {\n248\t\t\t\t\tlogging.Debug(ctx, \"review discovery failed\",\n249\t\t\t\t\t\tslog.String(\"agent\", string(c.name)), slog.String(\"error\", dErr.Error()))\n250\t\t\t\t}\n251\t\t\t}\n252\t\t\tbuiltinNames := builtinNameSet(curated)\n253\t\t\tdiscovered = filterOutBuiltinCollisions(discovered, builtinNames)\n254\t\n255\t\t\tdiscoveredSet := make(map[string]struct{}, len(discovered))\n256\t\t\tfor _, d := range discovered {\n257\t\t\t\tdiscoveredSet[d.Name] = struct{}{}\n258\t\t\t}\n259\t\t\tactiveHints := skilldiscovery.ActiveInstallHintsFor(string(c.name), discoveredSet)\n260\t\n261\t\t\t// Pre-populate pick slices from saved config so the picker preselects\n262\t\t\t// them. The header promises \"previously-saved skills are pre-checked\";\n263\t\t\t// without this split + Option.Selected(true) in buildReviewPickerFields,\n264\t\t\t// --edit with accept-defaults silently wipes the agent's saved skills.\n265\t\t\tbuiltinPicks, discoveredPicks := splitSavedPicks(\n266\t\t\t\texisting[string(c.name)].Skills, curated, discovered,\n267\t\t\t)\n268\t\t\tprompt := existing[string(c.name)].Prompt\n269\t\n270\t\t\tfields := buildReviewPickerFields(\n271\t\t\t\tstring(c.name), curated, discovered, activeHints, prompt,\n272\t\t\t\t&builtinPicks, &discoveredPicks, &prompt,\n273\t\t\t)\n274\t\n275\t\t\t// Prepend a non-blocking header Note so the agent being configured\n276\t\t\t// is always clearly visible. huh.Note defaults to skip:true — it\n277\t\t\t// renders above the first interactive field but doesn't pause the\n278\t\t\t// form. The previous attempt (type-asserting the first field's\n279\t\t\t// Title method) silently did nothing because huh's concrete Title\n280\t\t\t// methods return *MultiSelect[T]/*Text/*Note, not huh.Field.\n281\t\t\theader := huh.NewNote().\n282\t\t\t\tTitle(string(c.ag.Type())).\n283\t\t\t\tDescription(fmt.Sprintf(\"Agent %d of %d · pick review skills and optional instructions\", i+1, len(configurable)))\n284\t\t\tfields = append([]huh.Field{header}, fields...)\n285\t\n286\t\t\tform := NewAccessibleForm(huh.NewGroup(fields...))\n287\t\t\tif err := form.Run(); err != nil {\n288\t\t\t\treturn nil, fmt.Errorf(\"picker for %s: %w\", c.name, err)\n289\t\t\t}\n290\t\n291\t\t\tcfg := settings.ReviewConfig{\n292\t\t\t\tSkills: dedupeStrings(append(builtinPicks, discoveredPicks...)),\n293\t\t\t\tPrompt: strings.TrimSpace(prompt),\n294\t\t\t}\n295\t\t\tif !cfg.IsZero() {\n296\t\t\t\tselected[string(c.name)] = cfg\n297\t\t\t}\n298\t\t}\n299\t\t// Merge the picker's output with existing entries the picker could not\n300\t\t// surface. Without the merge, save would replace s.Review wholesale and\n301\t\t// silently drop entries the user had configured for external agents,\n302\t\t// uncurated agents, or agents whose hooks are temporarily uninstalled —\n303\t\t// exactly the \"edit settings.json manually\" case the help text suggests.\n304\t\toffered := make(map[string]struct{}, len(configurable))\n305\t\tfor _, c := range configurable {\n306\t\t\toffered[string(c.name)] = struct{}{}\n307\t\t}\n308\t\tmerged := mergePickerResults(existing, offered, selected)\n309\t\n310\t\t// The emptiness check runs on `merged`, not `selected`: a user\n311\t\t// deliberately deselecting all curated agents while keeping existing\n312\t\t// external-agent entries is a valid outcome that must be saveable. Only\n313\t\t// refuse if the final config would be empty — i.e., no picks/prompt\n314\t\t// AND no pre-existing entries to preserve.\n315\t\tif len(merged) == 0 {\n316\t\t\treturn nil, errors.New(\"no review skills or prompt configured\")\n317\t\t}\n318\t\n319\t\tif err := saveReviewConfig(ctx, merged); err != nil {\n320\t\t\treturn nil, err\n321\t\t}\n322\t\tfmt.Fprintln(out, \"Saved review config to .entire/settings.json. Edit directly or run `entire review --edit`.\")\n323\t\treturn merged, nil\n324\t}\n325\t\n326\t// mergePickerResults combines the picker's output with existing review\n327\t// config entries that the picker did not surface. Agents in `offered` are\n328\t// fully controlled by the picker: if they appear in `selected` with a\n329\t// non-zero config the entry is set, otherwise the entry is removed.\n330\t// Agents not in `offered` keep their existing config untouched.\n331\t//\n332\t// Exposed as a helper so tests can drive it directly — the picker itself\n333\t// can't run headless.\n334\tfunc mergePickerResults(existing map[string]settings.ReviewConfig, offered map[string]struct{}, selected map[string]settings.ReviewConfig) map[string]settings.ReviewConfig {\n335\t\tmerged := make(map[string]settings.ReviewConfig, len(existing)+len(selected))\n336\t\tfor name, cfg := range existing {\n337\t\t\tif _, wasOffered := offered[name]; !wasOffered {\n338\t\t\t\tmerged[name] = cfg\n339\t\t\t}\n340\t\t}\n341\t\tfor name, cfg := range selected {\n342\t\t\tmerged[name] = cfg\n343\t\t}\n344\t\treturn merged\n345\t}\n346\t\n347\tfunc newReviewCmd() *cobra.Command {\n348\t\treturn newReviewCmdWithDeps(runReviewDeps{})\n349\t}\n350\t\n351\t// newReviewCmdWithDeps returns the review subcommand wired against the\n352\t// provided deps. Tests use this constructor directly to inject stubs for\n353\t// branches that would otherwise require a real TTY. Callers should pass\n354\t// runReviewDeps{} in production; runReview fills in defaults for any nil\n355\t// fields.\n356\tfunc newReviewCmdWithDeps(deps runReviewDeps) *cobra.Command {\n357\t\tvar edit bool\n358\t\tvar agentOverride string\n359\t\n360\t\tcmd := &cobra.Command{\n361\t\t\tUse: \"review\",\n362\t\t\t// Hidden from `entire help` while the feature is still maturing —\n363\t\t\t// users who know about it can still run `entire review` / `entire\n364\t\t\t// review --help` and the command works normally. Remove when we're\n365\t\t\t// ready to advertise it in the top-level command list.\n366\t\t\tHidden: true,\n367\t\t\tShort:  \"Run configured review skills against the current branch\",\n368\t\t\tLong: `Run the review skills configured in .entire/settings.json against\n369\tthe current branch. On first run, an interactive picker writes the config.\n370\t\n371\tThe review session is recorded as part of the next checkpoint, so the\n372\treview metadata is permanently attached to the commit it covers.\n373\t\n374\tFlags:\n375\t  --edit         re-open the review config picker\n376\t  --agent NAME   select a specific configured agent when more than one is\n377\t                 configured (default: alphabetically first)\n378\t\n379\tSubcommands:\n380\t  attach <id>    tag an existing session as a review (equivalent to\n381\t                 'entire attach --review <id>')`,\n382\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n383\t\t\t\tctx := cmd.Context()\n384\t\t\t\t// Discover external agents so review configs that target them\n385\t\t\t\t// resolve correctly — without this, GetAgentsWithHooksInstalled\n386\t\t\t\t// and agent.Get can't see them, and `entire review` on an\n387\t\t\t\t// external-agent config fails even though hooks and `review\n388\t\t\t\t// attach` work. Mirrors the call in newReviewAttachCmd for\n389\t\t\t\t// consistent behavior across review entry points.\n390\t\t\t\texternal.DiscoverAndRegister(ctx)\n391\t\t\t\tif edit {\n392\t\t\t\t\t_, err := runReviewConfigPicker(ctx, cmd.OutOrStdout())\n393\t\t\t\t\treturn err\n394\t\t\t\t}\n395\t\t\t\treturn runReview(ctx, cmd, agentOverride, deps)\n396\t\t\t},\n397\t\t}\n398\t\tcmd.Flags().BoolVar(&edit, \"edit\", false, \"re-open the review config picker\")\n399\t\tcmd.Flags().StringVar(&agentOverride, \"agent\", \"\", \"select a specific configured agent (default: alphabetically first)\")\n400\t\tcmd.AddCommand(newReviewAttachCmd())\n401\t\treturn cmd\n402\t}\n403\t\n404\t// newReviewAttachCmd is a thin wrapper around `entire attach --review`. It\n405\t// shares all wiring with runAttach; only the UX surface differs, letting\n406\t// users discover review-attach through `entire review` in help output.\n407\tfunc newReviewAttachCmd() *cobra.Command {\n408\t\tvar (\n409\t\t\tforce      bool\n410\t\t\tagentFlag  string\n411\t\t\tskillsFlag []string\n412\t\t)\n413\t\tcmd := &cobra.Command{\n414\t\t\tUse:   \"attach <session-id>\",\n415\t\t\tShort: \"Tag an existing agent session as a review\",\n416\t\t\tLong: `Tag an existing agent session as an agent_review and link it to\n417\tthe current commit's checkpoint. Use this when you ran a review manually\n418\t(without 'entire review') and want the review metadata attached after\n419\tthe fact.\n420\t\n421\tThe first user prompt in the transcript is recorded as the review\n422\tprompt. Pass --skills to declare which skills were actually run; omit\n423\tto attach a review without a declared skills list.\n424\t\n425\tEquivalent to 'entire attach --review <session-id>' — provided here for\n426\tdiscoverability alongside the other review subcommands.`,\n427\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n428\t\t\t\tif len(args) != 1 {\n429\t\t\t\t\treturn cmd.Help()\n430\t\t\t\t}\n431\t\t\t\tif checkDisabledGuard(cmd.Context(), cmd.OutOrStdout()) {\n432\t\t\t\t\treturn nil\n433\t\t\t\t}\n434\t\t\t\t// Discover external agents so --agent <external-name> is\n435\t\t\t\t// recognized and auto-detection covers them. Mirrors the\n436\t\t\t\t// contract of `entire attach` so the two entry points stay\n437\t\t\t\t// behaviorally equivalent.\n438\t\t\t\texternal.DiscoverAndRegister(cmd.Context())\n439\t\t\t\treturn runAttachSurfaceReviewErrors(cmd, args[0], types.AgentName(agentFlag), attachOptions{\n440\t\t\t\t\tForce:                force,\n441\t\t\t\t\tReview:               true,\n442\t\t\t\t\tReviewSkillsOverride: skillsFlag,\n443\t\t\t\t})\n444\t\t\t},\n445\t\t}\n446\t\tcmd.Flags().BoolVarP(&force, \"force\", \"f\", false, \"Skip confirmation and amend the last commit with the checkpoint trailer\")\n447\t\tcmd.Flags().StringVarP(&agentFlag, \"agent\", \"a\", string(agent.DefaultAgentName), \"Agent that created the session\")\n448\t\tcmd.Flags().StringSliceVar(&skillsFlag, \"skills\", nil, \"Optional: declare which review skills were run in this session\")\n449\t\treturn cmd\n450\t}\n451\t\n452\tfunc runReview(ctx context.Context, cmd *cobra.Command, agentOverride string, deps runReviewDeps) error {\n453\t\tout := cmd.OutOrStdout()\n454\t\n455\t\t// 1. Pre-flight: must be in a git repo.\n456\t\tif _, err := paths.WorktreeRoot(ctx); err != nil {\n457\t\t\tcmd.SilenceUsage = true\n458\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Run `entire enable` first.\")\n459\t\t\treturn NewSilentError(errors.New(\"not a git repository\"))\n460\t\t}\n461\t\n462\t\t// 2. Load config. A load error means the settings file exists but is\n463\t\t// malformed (Load returns a default-filled object when the file is\n464\t\t// missing). Surface the error instead of silently opening the picker,\n465\t\t// which would cause saveReviewConfig to write over the user's other\n466\t\t// settings with an empty EntireSettings{}.\n467\t\ts, err := settings.Load(ctx)\n468\t\tif err != nil {\n469\t\t\tcmd.SilenceUsage = true\n470\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Failed to load settings: %v\\n\", err)\n471\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Fix `.entire/settings.json` and re-run `entire review`.\")\n472\t\t\treturn NewSilentError(err)\n473\t\t}\n474\t\tif s == nil || len(s.Review) == 0 {\n475\t\t\tif !confirmFirstRunSetup(out) {\n476\t\t\t\treturn nil\n477\t\t\t}\n478\t\t\tpicked, pickErr := runReviewConfigPicker(ctx, out)\n479\t\t\tif pickErr != nil {\n480\t\t\t\treturn pickErr\n481\t\t\t}\n482\t\t\tif s == nil {\n483\t\t\t\ts = &settings.EntireSettings{}\n484\t\t\t}\n485\t\t\ts.Review = picked\n486\t\t\tfmt.Fprintln(out)\n487\t\t\tfmt.Fprintln(out, \"Setup complete — running review now.\")\n488\t\t}\n489\t\n490\t\t// 3. Pick agent. When multiple agents are configured with hooks installed\n491\t\t// and no --agent override is provided, prompt the user to pick one.\n492\t\t// Skipped when --agent is passed, and skipped when only one eligible\n493\t\t// agent is configured (selectReviewAgent's alphabetical default handles\n494\t\t// the single-agent case deterministically).\n495\t\tif agentOverride == \"\" {\n496\t\t\teligible := computeEligibleConfigured(ctx, s)\n497\t\t\tif len(eligible) > 1 {\n498\t\t\t\tfn := deps.promptForAgentFn\n499\t\t\t\tif fn == nil {\n500\t\t\t\t\tfn = promptForAgent\n501\t\t\t\t}\n502\t\t\t\tpicked, pickErr := fn(ctx, eligible)\n503\t\t\t\tif pickErr != nil {\n504\t\t\t\t\tcmd.SilenceUsage = true\n505\t\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), pickErr.Error())\n506\t\t\t\t\treturn NewSilentError(pickErr)\n507\t\t\t\t}\n508\t\t\t\tif picked == \"\" {\n509\t\t\t\t\t// Defensive: a nil-or-empty return from the picker must NOT\n510\t\t\t\t\t// fall through to selectReviewAgent's alphabetical-first\n511\t\t\t\t\t// default. That's exactly the silent-masking shape the\n512\t\t\t\t\t// picker was added to eliminate. Refuse to proceed.\n513\t\t\t\t\tcmd.SilenceUsage = true\n514\t\t\t\t\temptyErr := errors.New(\"agent picker returned empty agent name\")\n515\t\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), emptyErr.Error())\n516\t\t\t\t\treturn NewSilentError(emptyErr)\n517\t\t\t\t}\n518\t\t\t\tagentOverride = picked\n519\t\t\t}\n520\t\t}\n521\t\n522\t\tagentName, cfg, err := selectReviewAgent(s.Review, agentOverride)\n523\t\tif err != nil {\n524\t\t\tcmd.SilenceUsage = true\n525\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n526\t\t\treturn NewSilentError(err)\n527\t\t}\n528\t\n529\t\t// 3.5. Verify hooks are installed for the selected agent. Without the\n530\t\t// agent's lifecycle hooks firing, UserPromptSubmit will never adopt the\n531\t\t// pending marker and the review metadata will never be recorded — a\n532\t\t// silent failure mode. Stale config (e.g. user ran `entire disable`\n533\t\t// without removing the agent from review settings) hits this same path.\n534\t\tif !slices.Contains(GetAgentsWithHooksInstalled(ctx), types.AgentName(agentName)) {\n535\t\t\tcmd.SilenceUsage = true\n536\t\t\tfmt.Fprintf(cmd.ErrOrStderr(),\n537\t\t\t\t\"Hooks are not installed for %q. Run `entire configure --agent %s` first, \"+\n538\t\t\t\t\t\"or remove %q from review settings.\\n\",\n539\t\t\t\tagentName, agentName, agentName)\n540\t\t\treturn NewSilentError(fmt.Errorf(\"hooks not installed for %s\", agentName))\n541\t\t}\n542\t\n543\t\t// 3.6. Verify configured skills are actually installed on disk. Catches\n544\t\t// the hand-edited-settings.json case where the user named a skill that\n545\t\t// doesn't exist; without this guard the agent would spawn and fail\n546\t\t// silently with \"I don't have that skill\".\n547\t\tag, agErr := agent.Get(types.AgentName(agentName))\n548\t\tif agErr != nil {\n549\t\t\treturn fmt.Errorf(\"resolve agent %s: %w\", agentName, agErr)\n550\t\t}\n551\t\tif err := verifyConfiguredSkillsInstalled(ctx, ag, cfg); err != nil {\n552\t\t\tcmd.SilenceUsage = true\n553\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n554\t\t\treturn NewSilentError(err)\n555\t\t}\n556\t\n557\t\t// 4. Re-run guard: check if HEAD's checkpoint already has a review.\n558\t\tif reviewed, meta := headHasReviewCheckpoint(ctx); reviewed {\n559\t\t\tvar proceed bool\n560\t\t\tform := NewAccessibleForm(huh.NewGroup(\n561\t\t\t\thuh.NewConfirm().\n562\t\t\t\t\tTitle(fmt.Sprintf(\"Already reviewed: %s. Proceed anyway?\", meta)).\n563\t\t\t\t\tValue(&proceed),\n564\t\t\t))\n565\t\t\tif err := form.Run(); err != nil {\n566\t\t\t\tfmt.Fprintln(out, \"prompt cancelled\")\n567\t\t\t\treturn err //nolint:wrapcheck // propagate huh cancellation\n568\t\t\t}\n569\t\t\tif !proceed {\n570\t\t\t\tfmt.Fprintln(out, \"Review cancelled.\")\n571\t\t\t\treturn nil\n572\t\t\t}\n573\t\t}\n574\t\n575\t\t// 5. Resolve HEAD + worktree root for the pending marker. WorktreePath\n576\t\t// scopes the marker so that a session in *another* worktree sharing the\n577\t\t// same .git/ can't race to claim it.\n578\t\theadSHA, err := currentHeadSHA(ctx)\n579\t\tif err != nil {\n580\t\t\treturn fmt.Errorf(\"resolve HEAD: %w\", err)\n581\t\t}\n582\t\tworktreeRoot, err := paths.WorktreeRoot(ctx)\n583\t\tif err != nil {\n584\t\t\treturn fmt.Errorf(\"resolve worktree root: %w\", err)\n585\t\t}\n586\t\n587\t\t// Best-effort: show the user what's in scope so they can tell whether\n588\t\t// the review target is what they expected. Scope is also used to append\n589\t\t// checkpoint context to the default generated skills prompt; custom\n590\t\t// Prompt configs still win verbatim.\n591\t\tvar scope reviewScope\n592\t\tif detectedScope, scopeErr := detectReviewScope(ctx); scopeErr == nil {\n593\t\t\tscope = detectedScope\n594\t\t\tfmt.Fprintln(out, formatReviewScope(scope))\n595\t\t} else {\n596\t\t\tlogging.Debug(ctx, \"review scope detection failed\", slog.String(\"error\", scopeErr.Error()))\n597\t\t}\n598\t\n599\t\t// 6. Compose the review prompt once, then write the pending marker. The\n600\t\t// composed prompt is carried on the marker so adoption records exactly\n601\t\t// what the agent was asked to do (the same string passed to LaunchCmd\n602\t\t// below), rather than recomposing on the hook side.\n603\t\tprompt := buildReviewPrompt(ctx, cfg, scope)\n604\t\tif err := WritePendingReviewMarker(ctx, PendingReviewMarker{\n605\t\t\tAgentName:    agentName,\n606\t\t\tSkills:       cfg.Skills,\n607\t\t\tPrompt:       prompt,\n608\t\t\tStartingSHA:  headSHA,\n609\t\t\tStartedAt:    time.Now().UTC(),\n610\t\t\tWorktreePath: worktreeRoot,\n611\t\t}); err != nil {\n612\t\t\treturn fmt.Errorf(\"write pending marker: %w\", err)\n613\t\t}\n614\t\n615\t\t// 7. Resolve launcher BEFORE installing the cleanup defer. Non-launchable\n616\t\t// agents (cursor, opencode, factoryai-droid, etc.) can't be spawned as\n617\t\t// subprocesses, so the marker must persist on disk for the user's\n618\t\t// manually-started session to adopt. If we registered the defer first,\n619\t\t// it would wipe the marker on this return path, silently breaking the\n620\t\t// hand-off the message promises.\n621\t\tlauncher, ok := agent.LauncherFor(types.AgentName(agentName))\n622\t\tif !ok {\n623\t\t\tfmt.Fprintf(out, \"%s does not support subprocess launch yet. Marker written.\\n\", agentName)\n624\t\t\tfmt.Fprintf(out, \"Start %s manually and use this prompt:\\n\\n%s\\n\", agentName, prompt)\n625\t\t\treturn nil\n626\t\t}\n627\t\n628\t\t// From this point on, the marker lives on disk until either (a) the\n629\t\t// spawned agent's hook adopts and clears it, or (b) we clear it here\n630\t\t// as a fallback. The defer covers every spawn/launch/run failure path,\n631\t\t// and also the case where the agent exits cleanly without ever firing\n632\t\t// UserPromptSubmit (e.g. user `/quit`s immediately). Leaving the marker\n633\t\t// in those cases would mis-tag the next unrelated session as a review.\n634\t\tdefer func() {\n635\t\t\t_, exists, readErr := ReadPendingReviewMarker(ctx)\n636\t\t\tif readErr != nil || !exists {\n637\t\t\t\treturn\n638\t\t\t}\n639\t\t\tif clearErr := ClearPendingReviewMarker(ctx); clearErr != nil {\n640\t\t\t\tlogging.Debug(ctx, \"cleanup unadopted review marker\", slog.String(\"error\", clearErr.Error()))\n641\t\t\t}\n642\t\t}()\n643\t\texecCmd, err := launcher.LaunchCmd(ctx, prompt)\n644\t\tif err != nil {\n645\t\t\treturn fmt.Errorf(\"launch %s: %w\", agentName, err)\n646\t\t}\n647\t\texecCmd.Env = appendReviewSpawnEnv(execCmd.Env, agentName, cfg.Skills, prompt, headSHA)\n648\t\tif err := execCmd.Run(); err != nil {\n649\t\t\treturn fmt.Errorf(\"agent exited: %w\", err)\n650\t\t}\n651\t\treturn nil\n652\t}\n653\t\n654\tfunc appendReviewSpawnEnv(base []string, agentName string, skills []string, prompt, startingSHA string) []string {\n655\t\tskillsJSON, _ := reviewenv.EncodeSkills(skills) //nolint:errcheck // json.Marshal([]string) cannot fail\n656\t\tif base == nil {\n657\t\t\tbase = os.Environ()\n658\t\t}\n659\t\tout := make([]string, 0, len(base)+5)\n660\t\tfor _, kv := range base {\n661\t\t\tif isReviewSpawnEnvEntry(kv) {\n662\t\t\t\tcontinue\n663\t\t\t}\n664\t\t\tout = append(out, kv)\n665\t\t}\n666\t\treturn append(out,\n667\t\t\treviewenv.EnvSession+\"=1\",\n668\t\t\treviewenv.EnvAgent+\"=\"+agentName,\n669\t\t\treviewenv.EnvSkills+\"=\"+skillsJSON,\n670\t\t\treviewenv.EnvPrompt+\"=\"+prompt,\n671\t\t\treviewenv.EnvStartingSHA+\"=\"+startingSHA,\n672\t\t)\n673\t}\n674\t\n675\tfunc isReviewSpawnEnvEntry(kv string) bool {\n676\t\tfor _, prefix := range []string{\n677\t\t\treviewenv.EnvSession + \"=\",\n678\t\t\treviewenv.EnvAgent + \"=\",\n679\t\t\treviewenv.EnvSkills + \"=\",\n680\t\t\treviewenv.EnvPrompt + \"=\",\n681\t\t\treviewenv.EnvStartingSHA + \"=\",\n682\t\t} {\n683\t\t\tif strings.HasPrefix(kv, prefix) {\n684\t\t\t\treturn true\n685\t\t\t}\n686\t\t}\n687\t\treturn false\n688\t}\n689\t\n690\t// computeEligibleConfigured returns the sorted list of agents that are both\n691\t// configured (non-zero ReviewConfig entry) AND have hooks installed. Only\n692\t// eligible agents are valid picker targets — spawning a review for an agent\n693\t// without hooks would silently drop the review metadata.\n694\tfunc computeEligibleConfigured(ctx context.Context, s *settings.EntireSettings) []agentChoice {\n695\t\tif s == nil {\n696\t\t\treturn nil\n697\t\t}\n698\t\tinstalled := GetAgentsWithHooksInstalled(ctx)\n699\t\tinstalledSet := make(map[types.AgentName]struct{}, len(installed))\n700\t\tfor _, name := range installed {\n701\t\t\tinstalledSet[name] = struct{}{}\n702\t\t}\n703\t\tout := make([]agentChoice, 0, len(s.Review))\n704\t\tfor name, cfg := range s.Review {\n705\t\t\tif cfg.IsZero() {\n706\t\t\t\tcontinue\n707\t\t\t}\n708\t\t\tif _, ok := installedSet[types.AgentName(name)]; !ok {\n709\t\t\t\tcontinue\n710\t\t\t}\n711\t\t\tout = append(out, agentChoice{Name: name, Label: labelForAgentChoice(name, cfg)})\n712\t\t}\n713\t\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\n714\t\treturn out\n715\t}\n716\t\n717\t// labelForAgentChoice builds the picker-visible label for an agent row.\n718\t// Annotates with \"(N skills configured)\" when skills are set, \"(prompt-only)\"\n719\t// when only a freeform prompt is configured, and falls back to the bare name\n720\t// otherwise (defensive — computeEligibleConfigured filters zero configs out\n721\t// before we get here).\n722\tfunc labelForAgentChoice(name string, cfg settings.ReviewConfig) string {\n723\t\tswitch {\n724\t\tcase len(cfg.Skills) > 0:\n725\t\t\treturn fmt.Sprintf(\"%s   (%d skills configured)\", name, len(cfg.Skills))\n726\t\tcase cfg.Prompt != \"\":\n727\t\t\treturn name + \"   (prompt-only)\"\n728\t\tdefault:\n729\t\t\treturn name\n730\t\t}\n731\t}\n732\t\n733\t// promptForAgent renders the single-select agent picker shown when more than\n734\t// one eligible agent is configured. Returns the chosen agent name. Respects\n735\t// accessibility mode via NewAccessibleForm.\n736\tfunc promptForAgent(ctx context.Context, eligible []agentChoice) (string, error) {\n737\t\tif err := ctx.Err(); err != nil {\n738\t\t\treturn \"\", fmt.Errorf(\"agent picker: %w\", err)\n739\t\t}\n740\t\tif len(eligible) == 0 {\n741\t\t\treturn \"\", errors.New(\"no eligible agents to prompt for\")\n742\t\t}\n743\t\toptions := make([]huh.Option[string], 0, len(eligible))\n744\t\tfor _, c := range eligible {\n745\t\t\toptions = append(options, huh.NewOption(c.Label, c.Name))\n746\t\t}\n747\t\tpicked := eligible[0].Name\n748\t\tform := NewAccessibleForm(huh.NewGroup(\n749\t\t\thuh.NewSelect[string]().\n750\t\t\t\tTitle(\"Which agent should run this review?\").\n751\t\t\t\tOptions(options...).\n752\t\t\t\tValue(&picked),\n753\t\t))\n754\t\tif err := form.Run(); err != nil {\n755\t\t\treturn \"\", fmt.Errorf(\"agent picker: %w\", err)\n756\t\t}\n757\t\treturn picked, nil\n758\t}\n759\t\n760\t// selectReviewAgent picks an agent from the configured review map.\n761\t//\n762\t// If override is non-empty, returns the config for that agent or an error\n763\t// listing the configured alternatives. Otherwise returns the alphabetically\n764\t// first configured agent — deterministic but user-overridable via --agent.\n765\tfunc selectReviewAgent(review map[string]settings.ReviewConfig, override string) (string, settings.ReviewConfig, error) {\n766\t\tif len(review) == 0 {\n767\t\t\treturn \"\", settings.ReviewConfig{}, errors.New(\"no review config found\")\n768\t\t}\n769\t\tvar names []string\n770\t\tfor name, cfg := range review {\n771\t\t\tif !cfg.IsZero() {\n772\t\t\t\tnames = append(names, name)\n773\t\t\t}\n774\t\t}\n775\t\tif len(names) == 0 {\n776\t\t\treturn \"\", settings.ReviewConfig{}, errors.New(\"no review config found\")\n777\t\t}\n778\t\tsort.Strings(names)\n779\t\tif override != \"\" {\n780\t\t\tif cfg, ok := review[override]; ok && !cfg.IsZero() {\n781\t\t\t\treturn override, cfg, nil\n782\t\t\t}\n783\t\t\treturn \"\", settings.ReviewConfig{}, fmt.Errorf(\n784\t\t\t\t\"agent %q is not configured for review; configured agents: %s\",\n785\t\t\t\toverride, strings.Join(names, \", \"),\n786\t\t\t)\n787\t\t}\n788\t\tpick := names[0]\n789\t\treturn pick, review[pick], nil\n790\t}\n791\t\n792\t// verifyConfiguredSkillsInstalled is the spawn-time backstop for the\n793\t// silent-failure vector. For each skill in cfg.Skills, check it's either a\n794\t// curated built-in or returned by the agent's SkillDiscoverer; fail with a\n795\t// user-facing error if any skill is missing. Empty Skills (prompt-only\n796\t// config) short-circuits to nil — a freeform prompt has no skill list to\n797\t// validate against.\n798\tfunc verifyConfiguredSkillsInstalled(ctx context.Context, ag agent.Agent, cfg settings.ReviewConfig) error {\n799\t\tif len(cfg.Skills) == 0 {\n800\t\t\treturn nil\n801\t\t}\n802\t\tbuiltins := builtinNameSet(skilldiscovery.CuratedBuiltinsFor(string(ag.Name())))\n803\t\tdiscoveredNames := map[string]struct{}{}\n804\t\tif d, ok := ag.(agent.SkillDiscoverer); ok {\n805\t\t\tif skills, err := d.DiscoverReviewSkills(ctx); err == nil {\n806\t\t\t\tfor _, s := range skills {\n807\t\t\t\t\tdiscoveredNames[s.Name] = struct{}{}\n808\t\t\t\t}\n809\t\t\t} else {\n810\t\t\t\tlogging.Debug(ctx, \"skill verification discovery failed\",\n811\t\t\t\t\tslog.String(\"agent\", string(ag.Name())), slog.String(\"error\", err.Error()))\n812\t\t\t}\n813\t\t}\n814\t\tvar missing []string\n815\t\tfor _, s := range cfg.Skills {\n816\t\t\tif _, ok := builtins[s]; ok {\n817\t\t\t\tcontinue\n818\t\t\t}\n819\t\t\tif _, ok := discoveredNames[s]; ok {\n820\t\t\t\tcontinue\n821\t\t\t}\n822\t\t\tmissing = append(missing, s)\n823\t\t}\n824\t\tif len(missing) == 0 {\n825\t\t\treturn nil\n826\t\t}\n827\t\treturn fmt.Errorf(\n828\t\t\t\"configured review skill(s) not installed: %s\\n\"+\n829\t\t\t\t\"run `entire review --edit` to reconfigure, or install the plugin and retry\",\n830\t\t\tstrings.Join(missing, \", \"),\n831\t\t)\n832\t}\n833\t\n834\t// composeReviewPrompt builds the prompt sent to the agent from a\n835\t// ReviewConfig. If the config carries an explicit Prompt it wins\n836\t// verbatim — the user's words are the source of truth. Otherwise the\n837\t// skills list is composed into the default \"run these in order\"\n838\t// template. Empty config returns \"\" (caller should avoid that case).\n839\tfunc composeReviewPrompt(cfg settings.ReviewConfig) string {\n840\t\tif cfg.Prompt != \"\" {\n841\t\t\treturn cfg.Prompt\n842\t\t}\n843\t\tif len(cfg.Skills) == 0 {\n844\t\t\treturn \"\"\n845\t\t}\n846\t\tvar sb strings.Builder\n847\t\tsb.WriteString(\"Please run these review skills in order:\\n\")\n848\t\tfor i, skill := range cfg.Skills {\n849\t\t\tfmt.Fprintf(&sb, \"  %d. %s\\n\", i+1, skill)\n850\t\t}\n851\t\treturn sb.String()\n852\t}\n853\t\n854\tfunc buildReviewPrompt(ctx context.Context, cfg settings.ReviewConfig, scope reviewScope) string {\n855\t\tprompt := composeReviewPrompt(cfg)\n856\t\tif prompt == \"\" || cfg.Prompt != \"\" {\n857\t\t\treturn prompt\n858\t\t}\n859\t\tbrief := renderReviewBrief(ctx, scope)\n860\t\tif brief == \"\" {\n861\t\t\treturn prompt\n862\t\t}\n863\t\treturn prompt + \"\\n\" + brief\n864\t}\n865\t\n866\ttype reviewBriefRow struct {\n867\t\tcommit     string\n868\t\tcheckpoint string\n869\t\tfiles      int\n870\t\tagent      string\n871\t\tsubject    string\n872\t}\n873\t\n874\ttype committedSessionMetadataReader interface {\n875\t\tReadSessionMetadata(ctx context.Context, checkpointID checkpointID.CheckpointID, sessionIndex int) (*checkpoint.CommittedMetadata, error)\n876\t}\n877\t\n878\tfunc renderReviewBrief(ctx context.Context, scope reviewScope) (brief string) {\n879\t\tdefer func() {\n880\t\t\tif r := recover(); r != nil {\n881\t\t\t\tlogging.Debug(ctx, \"review brief: panic while rendering\", slog.Any(\"panic\", r))\n882\t\t\t\tbrief = \"\"\n883\t\t\t}\n884\t\t}()\n885\t\n886\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n887\t\tif err != nil {\n888\t\t\tlogging.Debug(ctx, \"review brief: locate worktree root\", slog.String(\"error\", err.Error()))\n889\t\t\treturn \"\"\n890\t\t}\n891\t\treturn renderReviewBriefForRepo(ctx, repoRoot, scope)\n892\t}\n893\t\n894\tfunc renderReviewBriefForRepo(ctx context.Context, repoRoot string, scope reviewScope) (brief string) {\n895\t\tdefer func() {\n896\t\t\tif r := recover(); r != nil {\n897\t\t\t\tlogging.Debug(ctx, \"review brief: panic while rendering for repo\", slog.Any(\"panic\", r))\n898\t\t\t\tbrief = \"\"\n899\t\t\t}\n900\t\t}()\n901\t\n902\t\tif scope.BaseRef == \"\" {\n903\t\t\treturn \"\"\n904\t\t}\n905\t\thead := reviewScopeHeadRef(scope)\n906\t\tcommits, err := gitLines(ctx, repoRoot, \"rev-list\", scope.BaseRef+\"..\"+head)\n907\t\tif err != nil {\n908\t\t\tlogging.Debug(ctx, \"review brief: list commits\",\n909\t\t\t\tslog.String(\"base_ref\", scope.BaseRef),\n910\t\t\t\tslog.String(\"head\", head),\n911\t\t\t\tslog.String(\"error\", err.Error()))\n912\t\t\treturn \"\"\n913\t\t}\n914\t\tif len(commits) == 0 {\n915\t\t\treturn \"\"\n916\t\t}\n917\t\n918\t\trepo, err := git.PlainOpen(repoRoot)\n919\t\tif err != nil {\n920\t\t\tlogging.Debug(ctx, \"review brief: open repository\", slog.String(\"error\", err.Error()))\n921\t\t\treturn \"\"\n922\t\t}\n923\t\tv1Store := checkpoint.NewGitStore(repo)\n924\t\tv2URL, urlErr := remote.FetchURL(ctx)\n925\t\tif urlErr != nil {\n926\t\t\tlogging.Debug(ctx, \"review brief: no configured v2 fetch remote\", slog.String(\"error\", urlErr.Error()))\n927\t\t\tv2URL = \"\"\n928\t\t}\n929\t\tv2Store := checkpoint.NewV2GitStore(repo, v2URL)\n930\t\tpreferV2 := settings.IsCheckpointsV2Enabled(ctx)\n931\t\n932\t\trows := make([]reviewBriefRow, 0, len(commits))\n933\t\tfor _, commit := range commits {\n934\t\t\trow := reviewBriefRow{\n935\t\t\t\tcommit:     shortCommit(commit),\n936\t\t\t\tcheckpoint: \"-\",\n937\t\t\t\tfiles:      gitChangedFileCount(ctx, repoRoot, commit),\n938\t\t\t\tagent:      \"-\",\n939\t\t\t\tsubject:    truncateReviewSubject(gitString(ctx, repoRoot, \"show\", \"-s\", \"--format=%s\", commit)),\n940\t\t\t}\n941\t\n942\t\t\tmessage := gitString(ctx, repoRoot, \"show\", \"-s\", \"--format=%B\", commit)\n943\t\t\tif checkpointID, ok := trailers.ParseCheckpoint(message); ok {\n944\t\t\t\trow.checkpoint = checkpointID.String()\n945\t\t\t\treader, summary, resolveErr := checkpoint.ResolveCommittedReaderForCheckpoint(\n946\t\t\t\t\tctx,\n947\t\t\t\t\tcheckpointID,\n948\t\t\t\t\tv1Store,\n949\t\t\t\t\tv2Store,\n950\t\t\t\t\tpreferV2,\n951\t\t\t\t)\n952\t\t\t\tif resolveErr != nil || summary == nil {\n953\t\t\t\t\tlogging.Debug(ctx, \"review brief: unresolved checkpoint\",\n954\t\t\t\t\t\tslog.String(\"commit\", commit),\n955\t\t\t\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n956\t\t\t\t\t\tslog.Any(\"error\", resolveErr))\n957\t\t\t\t\trow.checkpoint = checkpointID.String() + \" (unresolved)\"\n958\t\t\t\t} else {\n959\t\t\t\t\trow.files = len(summary.FilesTouched)\n960\t\t\t\t\trow.agent = latestNonReviewAgent(ctx, reader, checkpointID, summary)\n961\t\t\t\t}\n962\t\t\t}\n963\t\n964\t\t\trows = append(rows, row)\n965\t\t}\n966\t\n967\t\treturn formatReviewBriefTable(rows)\n968\t}\n969\t\n970\tfunc reviewScopeHeadRef(scope reviewScope) string {\n971\t\tif scope.Branch != \"\" {\n972\t\t\treturn scope.Branch\n973\t\t}\n974\t\tif scope.HeadSHA != \"\" {\n975\t\t\treturn scope.HeadSHA\n976\t\t}\n977\t\treturn detachedHEADDisplay\n978\t}\n979\t\n980\tfunc gitLines(ctx context.Context, repoRoot string, args ...string) ([]string, error) {\n981\t\tfull := append([]string{\"-C\", repoRoot}, args...)\n982\t\toutput, err := exec.CommandContext(ctx, \"git\", full...).Output()\n983\t\tif err != nil {\n984\t\t\treturn nil, fmt.Errorf(\"git %s: %w\", strings.Join(args, \" \"), err)\n985\t\t}\n986\t\ttrimmed := strings.TrimSpace(string(output))\n987\t\tif trimmed == \"\" {\n988\t\t\treturn nil, nil\n989\t\t}\n990\t\tlines := strings.Split(trimmed, \"\\n\")\n991\t\tresult := lines[:0]\n992\t\tfor _, line := range lines {\n993\t\t\tif line = strings.TrimSpace(line); line != \"\" {\n994\t\t\t\tresult = append(result, line)\n995\t\t\t}\n996\t\t}\n997\t\treturn result, nil\n998\t}\n999\t\n1000\tfunc shortCommit(commit string) string {\n1001\t\tconst shortCommitLength = 12\n1002\t\tif len(commit) <= shortCommitLength {\n1003\t\t\treturn commit\n1004\t\t}\n1005\t\treturn commit[:shortCommitLength]\n1006\t}\n1007\t\n1008\tfunc truncateReviewSubject(subject string) string {\n1009\t\tconst maxSubjectLength = 64\n1010\t\tsubject = strings.TrimSpace(subject)\n1011\t\tif len(subject) <= maxSubjectLength {\n1012\t\t\treturn subject\n1013\t\t}\n1014\t\treturn strings.TrimSpace(subject[:maxSubjectLength-3]) + \"...\"\n1015\t}\n1016\t\n1017\tfunc gitChangedFileCount(ctx context.Context, repoRoot string, commit string) int {\n1018\t\tlines, err := gitLines(ctx, repoRoot, \"diff-tree\", \"--no-commit-id\", \"--name-only\", \"-r\", \"--root\", commit)\n1019\t\tif err != nil {\n1020\t\t\tlogging.Debug(ctx, \"review brief: count changed files\",\n1021\t\t\t\tslog.String(\"commit\", commit),\n1022\t\t\t\tslog.String(\"error\", err.Error()))\n1023\t\t\treturn 0\n1024\t\t}\n1025\t\treturn len(lines)\n1026\t}\n1027\t\n1028\tfunc latestNonReviewAgent(\n1029\t\tctx context.Context,\n1030\t\treader checkpoint.CommittedReader,\n1031\t\tcheckpointID checkpointID.CheckpointID,\n1032\t\tsummary *checkpoint.CheckpointSummary,\n1033\t) string {\n1034\t\tfor i := len(summary.Sessions) - 1; i >= 0; i-- {\n1035\t\t\tmetadata, err := readCommittedSessionMetadata(ctx, reader, checkpointID, i)\n1036\t\t\tif err != nil {\n1037\t\t\t\tlogging.Debug(ctx, \"review brief: read session metadata\",\n1038\t\t\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n1039\t\t\t\t\tslog.Int(\"session_index\", i),\n1040\t\t\t\t\tslog.String(\"error\", err.Error()))\n1041\t\t\t\tcontinue\n1042\t\t\t}\n1043\t\t\tif metadata == nil {\n1044\t\t\t\tcontinue\n1045\t\t\t}\n1046\t\t\tif session.Kind(metadata.Kind).IsReview() {\n1047\t\t\t\tcontinue\n1048\t\t\t}\n1049\t\t\tif metadata.Agent == \"\" {\n1050\t\t\t\tcontinue\n1051\t\t\t}\n1052\t\t\tag, err := agent.GetByAgentType(metadata.Agent)\n1053\t\t\tif err != nil {\n1054\t\t\t\treturn string(metadata.Agent)\n1055\t\t\t}\n1056\t\t\treturn string(ag.Name())\n1057\t\t}\n1058\t\treturn \"-\"\n1059\t}\n1060\t\n1061\tfunc readCommittedSessionMetadata(\n1062\t\tctx context.Context,\n1063\t\treader checkpoint.CommittedReader,\n1064\t\tcheckpointID checkpointID.CheckpointID,\n1065\t\tsessionIndex int,\n1066\t) (*checkpoint.CommittedMetadata, error) {\n1067\t\tif metadataReader, ok := reader.(committedSessionMetadataReader); ok {\n1068\t\t\tmetadata, err := metadataReader.ReadSessionMetadata(ctx, checkpointID, sessionIndex)\n1069\t\t\tif err != nil {\n1070\t\t\t\treturn nil, fmt.Errorf(\"read session metadata: %w\", err)\n1071\t\t\t}\n1072\t\t\treturn metadata, nil\n1073\t\t}\n1074\t\tcontent, err := reader.ReadSessionContent(ctx, checkpointID, sessionIndex)\n1075\t\tif err != nil {\n1076\t\t\treturn nil, fmt.Errorf(\"read session content: %w\", err)\n1077\t\t}\n1078\t\tif content == nil {\n1079\t\t\treturn nil, errors.New(\"session content is nil\")\n1080\t\t}\n1081\t\treturn &content.Metadata, nil\n1082\t}\n1083\t\n1084\tfunc formatReviewBriefTable(rows []reviewBriefRow) string {\n1085\t\tconst (\n1086\t\t\tcommitHeader     = \"commit\"\n1087\t\t\tcheckpointHeader = \"checkpoint\"\n1088\t\t\tfilesHeader      = \"files\"\n1089\t\t\tagentHeader      = \"agent\"\n1090\t\t\tsubjectHeader    = \"subject\"\n1091\t\t)\n1092\t\n1093\t\tcommitWidth := len(commitHeader)\n1094\t\tcheckpointWidth := len(checkpointHeader)\n1095\t\tfilesWidth := len(filesHeader)\n1096\t\tagentWidth := len(agentHeader)\n1097\t\tfor _, row := range rows {\n1098\t\t\tcommitWidth = max(commitWidth, len(row.commit))\n1099\t\t\tcheckpointWidth = max(checkpointWidth, len(row.checkpoint))\n1100\t\t\tfilesWidth = max(filesWidth, len(strconv.Itoa(row.files)))\n1101\t\t\tagentWidth = max(agentWidth, len(row.agent))\n1102\t\t}\n1103\t\n1104\t\tvar sb strings.Builder\n1105\t\tsb.WriteString(\"Commits in scope (newest first):\\n\\n\")\n1106\t\tfmt.Fprintf(&sb, \"  %-*s  %-*s  %*s  %-*s  %s\\n\",\n1107\t\t\tcommitWidth, commitHeader,\n1108\t\t\tcheckpointWidth, checkpointHeader,\n1109\t\t\tfilesWidth, filesHeader,\n1110\t\t\tagentWidth, agentHeader,\n1111\t\t\tsubjectHeader)\n1112\t\tfor _, row := range rows {\n1113\t\t\tfmt.Fprintf(&sb, \"  %-*s  %-*s  %*d  %-*s  %s\\n\",\n1114\t\t\t\tcommitWidth, row.commit,\n1115\t\t\t\tcheckpointWidth, row.checkpoint,\n1116\t\t\t\tfilesWidth, row.files,\n1117\t\t\t\tagentWidth, row.agent,\n1118\t\t\t\trow.subject)\n1119\t\t}\n1120\t\tsb.WriteString(\"\\n\")\n1121\t\tsb.WriteString(\"Use checkpoint IDs and commit hashes to inspect details:\\n\")\n1122\t\tsb.WriteString(\"  - `entire explain <id>` (for example `entire explain \")\n1123\t\tsb.WriteString(firstCheckpointExample(rows))\n1124\t\tsb.WriteString(\"`)\\n\")\n1125\t\tsb.WriteString(\"  - `entire explain <id> --raw-transcript` (for example `entire explain \")\n1126\t\tsb.WriteString(firstCheckpointExample(rows))\n1127\t\tsb.WriteString(\" --raw-transcript`) for the raw checkpoint transcript\\n\")\n1128\t\tsb.WriteString(\"  - `git show <commit>` for the commit diff\\n\")\n1129\t\treturn sb.String()\n1130\t}\n1131\t\n1132\tfunc firstCheckpointExample(rows []reviewBriefRow) string {\n1133\t\tfor _, row := range rows {\n1134\t\t\tif row.checkpoint != \"-\" && !strings.Contains(row.checkpoint, \" \") {\n1135\t\t\t\treturn row.checkpoint\n1136\t\t\t}\n1137\t\t}\n1138\t\treturn \"<id>\"\n1139\t}\n1140\t\n1141\t// currentHeadSHA returns the current HEAD commit hash as a 40-char hex string.\n1142\tfunc currentHeadSHA(ctx context.Context) (string, error) {\n1143\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n1144\t\tif err != nil {\n1145\t\t\treturn \"\", fmt.Errorf(\"locate repo root: %w\", err)\n1146\t\t}\n1147\t\texecCmd := exec.CommandContext(ctx, \"git\", \"-C\", repoRoot, \"rev-parse\", \"HEAD\")\n1148\t\toutput, err := execCmd.Output()\n1149\t\tif err != nil {\n1150\t\t\treturn \"\", fmt.Errorf(\"git rev-parse HEAD: %w\", err)\n1151\t\t}\n1152\t\treturn strings.TrimSpace(string(output)), nil\n1153\t}\n1154\t\n1155\t// reviewScope summarizes what's about to be reviewed, surfaced to the user\n1156\t// before the agent launches. Zero-valued fields mean \"not detected\" — format\n1157\t// helpers degrade gracefully.\n1158\ttype reviewScope struct {\n1159\t\tBranch       string // current branch short name; \"\" if detached\n1160\t\tHeadSHA      string // short HEAD SHA (always set when non-empty scope)\n1161\t\tBase         string // base branch (e.g. \"main\"); \"\" if unknown\n1162\t\tBaseRef      string // exact git ref for range commands (e.g. \"origin/main\"); \"\" if unknown\n1163\t\tAheadCommits int    // commits in baseRef..HEAD; 0 if BaseRef == \"\"\n1164\t\tFilesChanged int    // files in baseRef..HEAD diff; 0 if BaseRef == \"\"\n1165\t\tUncommitted  int    // files from `git status --porcelain`\n1166\t}\n1167\t\n1168\ttype baseBranchRef struct {\n1169\t\tdisplay string\n1170\t\tref     string\n1171\t}\n1172\t\n1173\t// detectReviewScope runs a handful of cheap `git` queries to describe the\n1174\t// set of changes the user is about to review. Best-effort: any individual\n1175\t// query that fails leaves the corresponding field at its zero value.\n1176\tfunc detectReviewScope(ctx context.Context) (reviewScope, error) {\n1177\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n1178\t\tif err != nil {\n1179\t\t\treturn reviewScope{}, fmt.Errorf(\"locate repo root: %w\", err)\n1180\t\t}\n1181\t\tvar s reviewScope\n1182\t\ts.Branch = gitString(ctx, repoRoot, \"rev-parse\", \"--abbrev-ref\", \"HEAD\")\n1183\t\tif s.Branch == detachedHEADDisplay {\n1184\t\t\ts.Branch = \"\"\n1185\t\t}\n1186\t\ts.HeadSHA = gitString(ctx, repoRoot, \"rev-parse\", \"--short\", \"HEAD\")\n1187\t\tbase := detectBaseBranchRef(ctx, repoRoot)\n1188\t\ts.Base = base.display\n1189\t\ts.BaseRef = base.ref\n1190\t\theadRef := s.Branch\n1191\t\tif headRef == \"\" {\n1192\t\t\theadRef = detachedHEADDisplay\n1193\t\t}\n1194\t\tif s.BaseRef != \"\" && (s.Branch == \"\" || s.BaseRef != s.Branch) {\n1195\t\t\tif n, ok := gitCount(ctx, repoRoot, \"rev-list\", \"--count\", s.BaseRef+\"..\"+headRef); ok {\n1196\t\t\t\ts.AheadCommits = n\n1197\t\t\t}\n1198\t\t\tif files := gitString(ctx, repoRoot, \"diff\", \"--name-only\", s.BaseRef+\"...\"+headRef); files != \"\" {\n1199\t\t\t\ts.FilesChanged = len(strings.Split(files, \"\\n\"))\n1200\t\t\t}\n1201\t\t}\n1202\t\tif status := gitString(ctx, repoRoot, \"status\", \"--porcelain\"); status != \"\" {\n1203\t\t\ts.Uncommitted = len(strings.Split(status, \"\\n\"))\n1204\t\t}\n1205\t\treturn s, nil\n1206\t}\n1207\t\n1208\t// detectBaseBranch resolves a base branch name by trying, in order:\n1209\t// origin/HEAD → origin/main → origin/master → local main → local master.\n1210\t// Returns \"\" if none match. Remote-tracking branches come first because they\n1211\t// reflect the team's convention; local branches are the fallback for repos\n1212\t// that haven't been `git fetch`'d recently.\n1213\tfunc detectBaseBranch(ctx context.Context, repoRoot string) string {\n1214\t\treturn detectBaseBranchRef(ctx, repoRoot).display\n1215\t}\n1216\t\n1217\tfunc detectBaseBranchRef(ctx context.Context, repoRoot string) baseBranchRef {\n1218\t\tif target := gitString(ctx, repoRoot, \"symbolic-ref\", \"--short\", \"refs/remotes/origin/HEAD\"); target != \"\" {\n1219\t\t\tif gitOK(ctx, repoRoot, \"rev-parse\", \"--verify\", \"--quiet\", target) {\n1220\t\t\t\treturn baseBranchRef{display: strings.TrimPrefix(target, \"origin/\"), ref: target}\n1221\t\t\t}\n1222\t\t}\n1223\t\tcandidates := []string{defaultBaseBranch, masterBaseBranch}\n1224\t\tfor _, candidate := range candidates {\n1225\t\t\tref := \"origin/\" + candidate\n1226\t\t\tif gitOK(ctx, repoRoot, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/remotes/\"+ref) {\n1227\t\t\t\treturn baseBranchRef{display: candidate, ref: ref}\n1228\t\t\t}\n1229\t\t}\n1230\t\tfor _, candidate := range candidates {\n1231\t\t\tif gitOK(ctx, repoRoot, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/heads/\"+candidate) {\n1232\t\t\t\treturn baseBranchRef{display: candidate, ref: candidate}\n1233\t\t\t}\n1234\t\t}\n1235\t\treturn baseBranchRef{}\n1236\t}\n1237\t\n1238\t// gitString runs `git -C repoRoot <args...>` and returns trimmed stdout, or\n1239\t// \"\" on any error.\n1240\tfunc gitString(ctx context.Context, repoRoot string, args ...string) string {\n1241\t\tfull := append([]string{\"-C\", repoRoot}, args...)\n1242\t\tout, err := exec.CommandContext(ctx, \"git\", full...).Output()\n1243\t\tif err != nil {\n1244\t\t\treturn \"\"\n1245\t\t}\n1246\t\treturn strings.TrimSpace(string(out))\n1247\t}\n1248\t\n1249\t// gitOK runs `git -C repoRoot <args...>` and reports whether it succeeded.\n1250\tfunc gitOK(ctx context.Context, repoRoot string, args ...string) bool {\n1251\t\tfull := append([]string{\"-C\", repoRoot}, args...)\n1252\t\treturn exec.CommandContext(ctx, \"git\", full...).Run() == nil\n1253\t}\n1254\t\n1255\t// gitCount runs a git command expected to output an integer and parses it.\n1256\tfunc gitCount(ctx context.Context, repoRoot string, args ...string) (int, bool) {\n1257\t\ts := gitString(ctx, repoRoot, args...)\n1258\t\tif s == \"\" {\n1259\t\t\treturn 0, false\n1260\t\t}\n1261\t\tn, err := strconv.Atoi(s)\n1262\t\tif err != nil {\n1263\t\t\treturn 0, false\n1264\t\t}\n1265\t\treturn n, true\n1266\t}\n1267\t\n1268\t// formatReviewScope renders a one-line summary for the user. Empty-review\n1269\t// cases fall back to \"no changes detected\".\n1270\tfunc formatReviewScope(s reviewScope) string {\n1271\t\thead := s.Branch\n1272\t\tif head == \"\" {\n1273\t\t\thead = detachedHEADDisplay + \" \" + s.HeadSHA\n1274\t\t}\n1275\t\thasBaseRange := s.Base != \"\" && (s.Branch == \"\" || s.Base != s.Branch || (s.BaseRef != \"\" && s.BaseRef != s.Branch))\n1276\t\tvar parts []string\n1277\t\tif hasBaseRange && (s.AheadCommits > 0 || s.FilesChanged > 0) {\n1278\t\t\tparts = append(parts,\n1279\t\t\t\tfmt.Sprintf(\"%d commits\", s.AheadCommits),\n1280\t\t\t\tfmt.Sprintf(\"%d files changed\", s.FilesChanged),\n1281\t\t\t)\n1282\t\t}\n1283\t\tif s.Uncommitted > 0 {\n1284\t\t\tparts = append(parts, fmt.Sprintf(\"%d uncommitted\", s.Uncommitted))\n1285\t\t}\n1286\t\tsuffix := \"no changes detected\"\n1287\t\tif len(parts) > 0 {\n1288\t\t\tsuffix = strings.Join(parts, \", \")\n1289\t\t}\n1290\t\tif hasBaseRange {\n1291\t\t\treturn fmt.Sprintf(\"Reviewing %s vs %s: %s\", head, s.Base, suffix)\n1292\t\t}\n1293\t\treturn fmt.Sprintf(\"Reviewing %s: %s\", head, suffix)\n1294\t}\n1295\t\n1296\t// headHasReviewCheckpoint checks whether HEAD's checkpoint metadata includes\n1297\t// a review session. Returns (true, infoString) if HasReview is set.\n1298\t// Single lookup: read the Entire-Checkpoint trailer from HEAD, then resolve\n1299\t// the CheckpointSummary via ResolveCommittedReaderForCheckpoint so v2-enabled\n1300\t// repos also work (v1 alone would miss v2-written summaries).\n1301\t//\n1302\t// Each early return logs at Debug so users debugging \"why is no review badge\n1303\t// showing?\" have breadcrumbs without the caller having to ask for five\n1304\t// distinct failure modes.\n1305\tfunc headHasReviewCheckpoint(ctx context.Context) (bool, string) {\n1306\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n1307\t\tif err != nil {\n1308\t\t\tlogging.Debug(ctx, \"head review check: locate worktree root\", slog.String(\"error\", err.Error()))\n1309\t\t\treturn false, \"\"\n1310\t\t}\n1311\t\texecCmd := exec.CommandContext(ctx, \"git\", \"-C\", repoRoot, \"log\", \"-1\", \"--format=%B\")\n1312\t\toutput, err := execCmd.Output()\n1313\t\tif err != nil {\n1314\t\t\tlogging.Debug(ctx, \"head review check: read HEAD commit message\", slog.String(\"error\", err.Error()))\n1315\t\t\treturn false, \"\"\n1316\t\t}\n1317\t\tcpID, ok := trailers.ParseCheckpoint(string(output))\n1318\t\tif !ok {\n1319\t\t\tlogging.Debug(ctx, \"head review check: no Entire-Checkpoint trailer on HEAD\")\n1320\t\t\treturn false, \"\"\n1321\t\t}\n1322\t\trepo, err := git.PlainOpen(repoRoot)\n1323\t\tif err != nil {\n1324\t\t\tlogging.Debug(ctx, \"head review check: open repository\", slog.String(\"error\", err.Error()))\n1325\t\t\treturn false, \"\"\n1326\t\t}\n1327\t\tv1Store := checkpoint.NewGitStore(repo)\n1328\t\tv2URL, urlErr := remote.FetchURL(ctx)\n1329\t\tif urlErr != nil {\n1330\t\t\tlogging.Debug(ctx, \"head review check: no configured v2 fetch remote\", slog.String(\"error\", urlErr.Error()))\n1331\t\t\tv2URL = \"\"\n1332\t\t}\n1333\t\tv2Store := checkpoint.NewV2GitStore(repo, v2URL)\n1334\t\t_, summary, err := checkpoint.ResolveCommittedReaderForCheckpoint(ctx, cpID, v1Store, v2Store, settings.IsCheckpointsV2Enabled(ctx))\n1335\t\tif err != nil || summary == nil {\n1336\t\t\tlogging.Debug(ctx, \"head review check: resolve checkpoint summary\",\n1337\t\t\t\tslog.String(\"checkpoint_id\", cpID.String()),\n1338\t\t\t\tslog.Any(\"error\", err))\n1339\t\t\treturn false, \"\"\n1340\t\t}\n1341\t\tif !summary.HasReview {\n1342\t\t\tlogging.Debug(ctx, \"head review check: summary HasReview is false\", slog.String(\"checkpoint_id\", cpID.String()))\n1343\t\t\treturn false, \"\"\n1344\t\t}\n1345\t\treturn true, fmt.Sprintf(\"checkpoint %s\", cpID)\n1346\t}\n1347\t\n1348\t// saveReviewConfig persists the review map into .entire/settings.json while\n1349\t// preserving all other settings. A Load error means the file exists but is\n1350\t// malformed — we must NOT silently overwrite it with an empty struct, or\n1351\t// every unrelated setting the user had configured would be wiped. Return the\n1352\t// error so the caller can surface it instead.\n1353\tfunc saveReviewConfig(ctx context.Context, review map[string]settings.ReviewConfig) error {\n1354\t\ts, err := settings.Load(ctx)\n1355\t\tif err != nil {\n1356\t\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n1357\t\t}\n1358\t\tif s == nil {\n1359\t\t\ts = &settings.EntireSettings{}\n1360\t\t}\n1361\t\ts.Review = review\n1362\t\tif err := settings.Save(ctx, s); err != nil {\n1363\t\t\treturn fmt.Errorf(\"save settings: %w\", err)\n1364\t\t}\n1365\t\treturn nil\n1366\t}\n1367\t\n1368\t// buildReviewPickerFields composes the per-agent group fields for the\n1369\t// review picker. Returns a slice of huh.Field in render order:\n1370\t//\n1371\t//\t0: built-in commands (multiselect) OR note\n1372\t//\t1: installed plugin skills (multiselect) OR note\n1373\t//\t2: install hints (note with all active hint messages) — OMITTED if empty\n1374\t//\t3: additional instructions (text) — always present\n1375\t//\n1376\t// splitSavedPicks partitions a flat saved-skills list into the subset that\n1377\t// matches built-in curated commands and the subset that matches discovered\n1378\t// plugin skills. Skill names that match neither (e.g., external-agent\n1379\t// entries, or skills that were uninstalled since save) are dropped from\n1380\t// both — they're preserved on the settings side via mergePickerResults\n1381\t// when they belong to a picker-unaware agent entry.\n1382\tfunc splitSavedPicks(saved []string, builtins []skilldiscovery.CuratedSkill, discovered []agent.DiscoveredSkill) ([]string, []string) {\n1383\t\tbuiltinNames := make(map[string]struct{}, len(builtins))\n1384\t\tfor _, b := range builtins {\n1385\t\t\tbuiltinNames[b.Name] = struct{}{}\n1386\t\t}\n1387\t\tdiscoveredNames := make(map[string]struct{}, len(discovered))\n1388\t\tfor _, d := range discovered {\n1389\t\t\tdiscoveredNames[d.Name] = struct{}{}\n1390\t\t}\n1391\t\tvar builtinPicks, discoveredPicks []string\n1392\t\tfor _, s := range saved {\n1393\t\t\tif _, ok := builtinNames[s]; ok {\n1394\t\t\t\tbuiltinPicks = append(builtinPicks, s)\n1395\t\t\t\tcontinue\n1396\t\t\t}\n1397\t\t\tif _, ok := discoveredNames[s]; ok {\n1398\t\t\t\tdiscoveredPicks = append(discoveredPicks, s)\n1399\t\t\t}\n1400\t\t}\n1401\t\treturn builtinPicks, discoveredPicks\n1402\t}\n1403\t\n1404\t// preselectedSet turns a slice pointer's current contents into a lookup\n1405\t// set for the picker's \"previously-saved\" pre-selection. Nil or empty\n1406\t// returns nil — the caller's `if _, ok := set[name]; ok` works either way.\n1407\tfunc preselectedSet(slice *[]string) map[string]struct{} {\n1408\t\tif slice == nil || len(*slice) == 0 {\n1409\t\t\treturn nil\n1410\t\t}\n1411\t\tout := make(map[string]struct{}, len(*slice))\n1412\t\tfor _, s := range *slice {\n1413\t\t\tout[s] = struct{}{}\n1414\t\t}\n1415\t\treturn out\n1416\t}\n1417\t\n1418\t// Pure function — no side effects, no huh form running — so unit-testable.\n1419\t// Value bindings (builtinPicksOut, discoveredPicksOut, promptOut) may be\n1420\t// nil when the caller only needs the field count (tests). When the out\n1421\t// slices contain values on entry, those values double as the pre-selected\n1422\t// set: matching options get Option.Selected(true) so the picker preserves\n1423\t// the saved config on accept-defaults.\n1424\tfunc buildReviewPickerFields(\n1425\t\tagentName string,\n1426\t\tbuiltins []skilldiscovery.CuratedSkill,\n1427\t\tdiscovered []agent.DiscoveredSkill,\n1428\t\tactiveHints []skilldiscovery.InstallHint,\n1429\t\tpreviousPrompt string,\n1430\t\tbuiltinPicksOut, discoveredPicksOut *[]string,\n1431\t\tpromptOut *string,\n1432\t) []huh.Field {\n1433\t\tvar fields []huh.Field\n1434\t\n1435\t\t// Picker labels show only the invocation name — no descriptions. Agent\n1436\t\t// descriptions in particular can be pages of embedded usage examples,\n1437\t\t// which makes the picker unreadable. Users recognize skills by name;\n1438\t\t// the stored value is the name either way.\n1439\t\t// Pre-populated contents of the output slices double as the \"previously\n1440\t\t// selected\" set so the picker preselects saved skills via\n1441\t\t// Option.Selected(true). Accepting defaults in --edit therefore\n1442\t\t// preserves the agent's saved config instead of wiping it.\n1443\t\tbuiltinPreselected := preselectedSet(builtinPicksOut)\n1444\t\tdiscoveredPreselected := preselectedSet(discoveredPicksOut)\n1445\t\n1446\t\tif len(builtins) > 0 {\n1447\t\t\topts := make([]huh.Option[string], 0, len(builtins))\n1448\t\t\tfor _, b := range builtins {\n1449\t\t\t\topt := huh.NewOption(b.Name, b.Name)\n1450\t\t\t\tif _, ok := builtinPreselected[b.Name]; ok {\n1451\t\t\t\t\topt = opt.Selected(true)\n1452\t\t\t\t}\n1453\t\t\t\topts = append(opts, opt)\n1454\t\t\t}\n1455\t\t\tms := huh.NewMultiSelect[string]().Title(\"Built-in commands\").Options(opts...)\n1456\t\t\tif builtinPicksOut != nil {\n1457\t\t\t\tms = ms.Value(builtinPicksOut)\n1458\t\t\t}\n1459\t\t\tfields = append(fields, ms)\n1460\t\t} else {\n1461\t\t\tfields = append(fields, huh.NewNote().\n1462\t\t\t\tTitle(\"Built-in commands\").\n1463\t\t\t\tDescription(fmt.Sprintf(\"No built-in review commands in %s.\", agentName)))\n1464\t\t}\n1465\t\n1466\t\tif len(discovered) > 0 {\n1467\t\t\topts := make([]huh.Option[string], 0, len(discovered))\n1468\t\t\tfor _, d := range discovered {\n1469\t\t\t\topt := huh.NewOption(d.Name, d.Name)\n1470\t\t\t\tif _, ok := discoveredPreselected[d.Name]; ok {\n1471\t\t\t\t\topt = opt.Selected(true)\n1472\t\t\t\t}\n1473\t\t\t\topts = append(opts, opt)\n1474\t\t\t}\n1475\t\t\tms := huh.NewMultiSelect[string]().Title(\"Installed plugin skills\").Options(opts...)\n1476\t\t\tif discoveredPicksOut != nil {\n1477\t\t\t\tms = ms.Value(discoveredPicksOut)\n1478\t\t\t}\n1479\t\t\tfields = append(fields, ms)\n1480\t\t} else {\n1481\t\t\tfields = append(fields, huh.NewNote().\n1482\t\t\t\tTitle(\"Installed plugin skills\").\n1483\t\t\t\tDescription(\"No plugin review skills detected on disk.\"))\n1484\t\t}\n1485\t\n1486\t\tif len(activeHints) > 0 {\n1487\t\t\tvar sb strings.Builder\n1488\t\t\tfor i, h := range activeHints {\n1489\t\t\t\tif i > 0 {\n1490\t\t\t\t\tsb.WriteString(\"\\n\")\n1491\t\t\t\t}\n1492\t\t\t\tsb.WriteString(\"• \")\n1493\t\t\t\tsb.WriteString(h.Message)\n1494\t\t\t}\n1495\t\t\tfields = append(fields, huh.NewNote().\n1496\t\t\t\tTitle(\"Install more\").\n1497\t\t\t\tDescription(sb.String()))\n1498\t\t}\n1499\t\n1500\t\ttext := huh.NewText().\n1501\t\t\tTitle(\"Additional instructions (optional)\").\n1502\t\t\tDescription(\"Used verbatim as the review prompt when set. Leave blank to use the default 'run these skills in order' template.\")\n1503\t\tif promptOut != nil {\n1504\t\t\t*promptOut = previousPrompt\n1505\t\t\ttext = text.Value(promptOut)\n1506\t\t}\n1507\t\tfields = append(fields, text)\n1508\t\n1509\t\treturn fields\n1510\t}\n1511\t\n1512\tfunc builtinNameSet(curated []skilldiscovery.CuratedSkill) map[string]struct{} {\n1513\t\tset := make(map[string]struct{}, len(curated))\n1514\t\tfor _, c := range curated {\n1515\t\t\tset[c.Name] = struct{}{}\n1516\t\t}\n1517\t\treturn set\n1518\t}\n1519\t\n1520\t// filterOutBuiltinCollisions drops any discovered skill whose name collides\n1521\t// with a curated built-in. Built-in wins because it carries a richer,\n1522\t// hand-authored description.\n1523\tfunc filterOutBuiltinCollisions(discovered []agent.DiscoveredSkill, builtins map[string]struct{}) []agent.DiscoveredSkill {\n1524\t\tif len(discovered) == 0 || len(builtins) == 0 {\n1525\t\t\treturn discovered\n1526\t\t}\n1527\t\tout := make([]agent.DiscoveredSkill, 0, len(discovered))\n1528\t\tfor _, d := range discovered {\n1529\t\t\tif _, clash := builtins[d.Name]; clash {\n1530\t\t\t\tcontinue\n1531\t\t\t}\n1532\t\t\tout = append(out, d)\n1533\t\t}\n1534\t\treturn out\n1535\t}\n1536\t\n1537\tfunc dedupeStrings(xs []string) []string {\n1538\t\tif len(xs) == 0 {\n1539\t\t\treturn xs\n1540\t\t}\n1541\t\tseen := make(map[string]struct{}, len(xs))\n1542\t\tout := make([]string, 0, len(xs))\n1543\t\tfor _, x := range xs {\n1544\t\t\tif _, ok := seen[x]; ok {\n1545\t\t\t\tcontinue\n1546\t\t\t}\n1547\t\t\tseen[x] = struct{}{}\n1548\t