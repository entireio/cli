{"parentUuid":"9b576222-ad80-4f44-9679-9b98153845b6","isSidechain":false,"promptId":"f73187d2-ae51-4903-8e9c-e6c9586ebc16","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ecduJw4d7km8chLKqCy7j","type":"tool_result","content":"1\t// lifecycle.go implements the generic lifecycle event dispatcher.\n2\t// It routes normalized events from any agent to the appropriate framework actions.\n3\t//\n4\t// The dispatcher inverts the current flow from \"agent handler calls framework functions\"\n5\t// to \"framework dispatcher calls agent methods.\" Agents are passive data providers;\n6\t// the dispatcher handles all orchestration: state transitions, strategy calls,\n7\t// file change detection, metadata generation.\n8\tpackage cli\n9\t\n10\timport (\n11\t\t\"context\"\n12\t\t\"errors\"\n13\t\t\"fmt\"\n14\t\t\"log/slog\"\n15\t\t\"os\"\n16\t\t\"path/filepath\"\n17\t\t\"slices\"\n18\t\t\"strings\"\n19\t\t\"time\"\n20\t\n21\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n22\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n23\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n24\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n25\t\t\"github.com/entireio/cli/cmd/entire/cli/review\"\n26\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n27\t\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n28\t\t\"github.com/entireio/cli/cmd/entire/cli/transcript\"\n29\t\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n30\t\t\"github.com/entireio/cli/perf\"\n31\t)\n32\t\n33\t// DispatchLifecycleEvent routes a normalized lifecycle event to the appropriate handler.\n34\t// Returns nil if the event was handled successfully.\n35\tfunc DispatchLifecycleEvent(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n36\t\tif ag == nil {\n37\t\t\treturn errors.New(\"agent cannot be nil\")\n38\t\t}\n39\t\tif event == nil {\n40\t\t\treturn errors.New(\"event cannot be nil\")\n41\t\t}\n42\t\n43\t\tswitch event.Type {\n44\t\tcase agent.SessionStart:\n45\t\t\treturn handleLifecycleSessionStart(ctx, ag, event)\n46\t\tcase agent.TurnStart:\n47\t\t\treturn handleLifecycleTurnStart(ctx, ag, event)\n48\t\tcase agent.TurnEnd:\n49\t\t\treturn handleLifecycleTurnEnd(ctx, ag, event)\n50\t\tcase agent.Compaction:\n51\t\t\treturn handleLifecycleCompaction(ctx, ag, event)\n52\t\tcase agent.SessionEnd:\n53\t\t\treturn handleLifecycleSessionEnd(ctx, ag, event)\n54\t\tcase agent.SubagentStart:\n55\t\t\treturn handleLifecycleSubagentStart(ctx, ag, event)\n56\t\tcase agent.SubagentEnd:\n57\t\t\treturn handleLifecycleSubagentEnd(ctx, ag, event)\n58\t\tcase agent.ModelUpdate:\n59\t\t\treturn handleLifecycleModelUpdate(ctx, ag, event)\n60\t\tdefault:\n61\t\t\treturn fmt.Errorf(\"unknown lifecycle event type: %d\", event.Type)\n62\t\t}\n63\t}\n64\t\n65\t// handleLifecycleSessionStart handles session start: shows banner, checks concurrent sessions,\n66\t// fires state machine transition.\n67\tfunc handleLifecycleSessionStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n68\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n69\t\tlogging.Info(logCtx, \"session-start\",\n70\t\t\tslog.String(\"event\", event.Type.String()),\n71\t\t\tslog.String(\"session_id\", event.SessionID),\n72\t\t\tslog.String(\"session_ref\", event.SessionRef),\n73\t\t\tslog.String(\"model\", event.Model),\n74\t\t)\n75\t\n76\t\tif event.SessionID == \"\" {\n77\t\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n78\t\t}\n79\t\tif err := validation.ValidateSessionID(event.SessionID); err != nil {\n80\t\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n81\t\t}\n82\t\n83\t\t// Build informational message — warn early if repo has no commits yet,\n84\t\t// since checkpoints require at least one commit to work.\n85\t\tmessage := sessionStartMessage(ag.Name(), false)\n86\t\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n87\t\t\tmessage = sessionStartMessage(ag.Name(), true)\n88\t\t}\n89\t\n90\t\t// Check for concurrent sessions and append count if any\n91\t\t_, countSessionsSpan := perf.Start(ctx, \"count_active_sessions\")\n92\t\tstrat := GetStrategy(ctx)\n93\t\tif count, err := strat.CountOtherActiveSessionsWithCheckpoints(ctx, event.SessionID); err == nil && count > 0 {\n94\t\t\tif ag.Name() == agent.AgentNameCodex {\n95\t\t\t\tmessage += fmt.Sprintf(\" %d other active conversation(s) in this workspace will also be included. Use 'entire status' for more information.\", count)\n96\t\t\t} else {\n97\t\t\t\tmessage += fmt.Sprintf(\"\\n  %d other active conversation(s) in this workspace will also be included.\\n  Use 'entire status' for more information.\", count)\n98\t\t\t}\n99\t\t}\n100\t\tcountSessionsSpan.End()\n101\t\n102\t\t// Output informational message if the agent supports hook responses.\n103\t\t// Claude Code reads JSON from stdout; agents that don't implement\n104\t\t// HookResponseWriter silently skip (avoids raw JSON in their terminal).\n105\t\t_, hookResponseSpan := perf.Start(ctx, \"write_hook_response\")\n106\t\tif event.ResponseMessage != \"\" {\n107\t\t\tmessage = event.ResponseMessage\n108\t\t}\n109\t\tif writer, ok := agent.AsHookResponseWriter(ag); ok {\n110\t\t\tif err := writer.WriteHookResponse(message); err != nil {\n111\t\t\t\thookResponseSpan.RecordError(err)\n112\t\t\t\thookResponseSpan.End()\n113\t\t\t\treturn fmt.Errorf(\"failed to write hook response: %w\", err)\n114\t\t\t}\n115\t\t}\n116\t\thookResponseSpan.End()\n117\t\n118\t\t// Store model hint if the agent provided model info on SessionStart\n119\t\tif event.Model != \"\" {\n120\t\t\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n121\t\t\t\tlogging.Warn(logCtx, \"failed to store model hint on session start\",\n122\t\t\t\t\tslog.String(\"error\", err.Error()))\n123\t\t\t}\n124\t\t}\n125\t\n126\t\t// Fire EventSessionStart for the current session (if state exists).\n127\t\tif state, loadErr := strategy.LoadSessionState(ctx, event.SessionID); loadErr != nil {\n128\t\t\tlogging.Warn(logCtx, \"failed to load session state on start\",\n129\t\t\t\tslog.String(\"error\", loadErr.Error()))\n130\t\t} else if state != nil {\n131\t\t\tpersistEventMetadataToState(event, state)\n132\t\t\tif transErr := strategy.TransitionAndLog(ctx, state, session.EventSessionStart, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n133\t\t\t\tlogging.Warn(logCtx, \"session start transition failed\",\n134\t\t\t\t\tslog.String(\"error\", transErr.Error()))\n135\t\t\t}\n136\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n137\t\t\t\tlogging.Warn(logCtx, \"failed to update session state on start\",\n138\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n139\t\t\t}\n140\t\t}\n141\t\n142\t\treturn nil\n143\t}\n144\t\n145\tfunc sessionStartMessage(agentName types.AgentName, emptyRepo bool) string {\n146\t\tif agentName == agent.AgentNameCodex {\n147\t\t\tif emptyRepo {\n148\t\t\t\treturn \"Entire CLI found no commits yet — checkpoints will activate after your first commit.\"\n149\t\t\t}\n150\t\t\treturn \"Entire CLI will link this conversation to your next commit.\"\n151\t\t}\n152\t\n153\t\tif emptyRepo {\n154\t\t\treturn \"\\n\\nEntire CLI found no commits yet — checkpoints will activate after your first commit.\"\n155\t\t}\n156\t\treturn \"\\n\\nEntire CLI will link this conversation to your next commit.\"\n157\t}\n158\t\n159\t// handleLifecycleModelUpdate persists the model name for the current session.\n160\t//\n161\t// If the session state file already exists (e.g., Gemini's BeforeModel fires\n162\t// after TurnStart), the model is written directly to state.ModelName — no hint\n163\t// file needed. Otherwise falls back to StoreModelHint for cross-process\n164\t// persistence (see its doc comment for the full rationale).\n165\tfunc handleLifecycleModelUpdate(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n166\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n167\t\tlogging.Info(logCtx, \"model-update\",\n168\t\t\tslog.String(\"session_id\", event.SessionID),\n169\t\t\tslog.String(\"model\", event.Model),\n170\t\t)\n171\t\n172\t\tif event.SessionID == \"\" || event.Model == \"\" {\n173\t\t\treturn nil\n174\t\t}\n175\t\n176\t\t// Prefer writing directly to session state when it exists\n177\t\tstate, loadErr := strategy.LoadSessionState(ctx, event.SessionID)\n178\t\tif loadErr != nil {\n179\t\t\tlogging.Debug(logCtx, \"could not load session state for model update, using hint file\",\n180\t\t\t\tslog.String(\"error\", loadErr.Error()))\n181\t\t}\n182\t\tif loadErr == nil && state != nil {\n183\t\t\tstate.ModelName = event.Model\n184\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n185\t\t\t\tlogging.Warn(logCtx, \"failed to update session state with model\",\n186\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n187\t\t\t}\n188\t\t\treturn nil\n189\t\t}\n190\t\n191\t\t// State doesn't exist yet (or failed to load) — use hint file (see StoreModelHint doc)\n192\t\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n193\t\t\tlogging.Warn(logCtx, \"failed to store model hint\",\n194\t\t\t\tslog.String(\"error\", err.Error()))\n195\t\t}\n196\t\n197\t\treturn nil\n198\t}\n199\t\n200\t// handleLifecycleTurnStart handles turn start: captures pre-prompt state,\n201\t// ensures strategy setup, initializes session.\n202\tfunc handleLifecycleTurnStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n203\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n204\t\tlogging.Info(logCtx, \"turn-start\",\n205\t\t\tslog.String(\"event\", event.Type.String()),\n206\t\t\tslog.String(\"session_id\", event.SessionID),\n207\t\t\tslog.String(\"session_ref\", event.SessionRef),\n208\t\t\tslog.String(\"model\", event.Model),\n209\t\t)\n210\t\n211\t\tsessionID := event.SessionID\n212\t\tif sessionID == \"\" {\n213\t\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n214\t\t}\n215\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n216\t\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n217\t\t}\n218\t\n219\t\t// Fill model from hint file if the agent didn't provide it on this hook\n220\t\tif event.Model == \"\" {\n221\t\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n222\t\t\t\tevent.Model = hint\n223\t\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n224\t\t\t\t\tslog.String(\"model\", hint))\n225\t\t\t}\n226\t\t}\n227\t\n228\t\t// Capture pre-prompt state (including transcript position via TranscriptAnalyzer)\n229\t\t_, captureSpan := perf.Start(ctx, \"capture_pre_prompt_state\")\n230\t\tif err := CapturePrePromptState(ctx, ag, sessionID, event.SessionRef); err != nil {\n231\t\t\tcaptureSpan.RecordError(err)\n232\t\t\tcaptureSpan.End()\n233\t\t\treturn err\n234\t\t}\n235\t\tcaptureSpan.End()\n236\t\n237\t\t// Append prompt to prompt.txt on filesystem so it's available for\n238\t\t// mid-turn commits (before SaveStep writes it to the shadow branch).\n239\t\t// Prompts are separated by \"\\n\\n---\\n\\n\" to support multiple turns.\n240\t\tif event.Prompt != \"\" {\n241\t\t\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n242\t\t\tif sessionDirAbs, absErr := paths.AbsPath(ctx, sessionDir); absErr == nil {\n243\t\t\t\tif mkErr := os.MkdirAll(sessionDirAbs, 0o750); mkErr == nil {\n244\t\t\t\t\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n245\t\t\t\t\texisting, readErr := os.ReadFile(promptPath) //nolint:gosec // session metadata path\n246\t\t\t\t\tvar content string\n247\t\t\t\t\tif readErr == nil && len(existing) > 0 {\n248\t\t\t\t\t\tcontent = string(existing) + \"\\n\\n---\\n\\n\" + event.Prompt\n249\t\t\t\t\t} else {\n250\t\t\t\t\t\tcontent = event.Prompt\n251\t\t\t\t\t}\n252\t\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil { //nolint:gosec // path from internal metadata, not user input\n253\t\t\t\t\t\tlogging.Warn(logCtx, \"failed to write prompt.txt\",\n254\t\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n255\t\t\t\t\t}\n256\t\t\t\t}\n257\t\t\t}\n258\t\t}\n259\t\n260\t\t// Ensure strategy setup and initialize session\n261\t\t_, initSpan := perf.Start(ctx, \"init_session\")\n262\t\tif err := strategy.EnsureSetup(ctx); err != nil {\n263\t\t\tlogging.Warn(logCtx, \"failed to ensure strategy setup\",\n264\t\t\t\tslog.String(\"error\", err.Error()))\n265\t\t}\n266\t\n267\t\tstrat := GetStrategy(ctx)\n268\t\tif err := strat.InitializeSession(ctx, sessionID, ag.Type(), event.SessionRef, event.Prompt, event.Model); err != nil {\n269\t\t\tlogging.Warn(logCtx, \"failed to initialize session state\",\n270\t\t\t\tslog.String(\"error\", err.Error()))\n271\t\t}\n272\t\n273\t\t// Best-effort: adopt ENTIRE_REVIEW_* env vars set by `entire review` on\n274\t\t// the spawned agent process. Each agent process has its own env, so there\n275\t\t// is no file race across worktrees. Errors in load/save must not fail the turn.\n276\t\tif state, loadErr := strategy.LoadSessionState(ctx, sessionID); loadErr != nil {\n277\t\t\tlogging.Warn(logCtx, \"failed to load session state for review env adoption\",\n278\t\t\t\tslog.String(\"error\", loadErr.Error()))\n279\t\t} else if state != nil {\n280\t\t\tupdated := *state\n281\t\t\tadoptReviewEnv(logCtx, &updated, string(ag.Name()))\n282\t\t\tif updated.Kind != state.Kind || updated.ReviewPrompt != state.ReviewPrompt || !slices.Equal(updated.ReviewSkills, state.ReviewSkills) {\n283\t\t\t\tif saveErr := strategy.SaveSessionState(ctx, &updated); saveErr != nil {\n284\t\t\t\t\tlogging.Warn(logCtx, \"failed to save session state after review env adoption\",\n285\t\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n286\t\t\t\t}\n287\t\t\t}\n288\t\t}\n289\t\tinitSpan.End()\n290\t\n291\t\treturn nil\n292\t}\n293\t\n294\t// handleLifecycleTurnEnd handles turn end: validates transcript, extracts metadata,\n295\t// detects file changes, saves step + checkpoint, transitions phase.\n296\t//\n297\t//nolint:maintidx // high complexity due to sequential orchestration of 8 steps (validation, extraction, file detection, filtering, token calc, step save, phase transition, cleanup) - splitting would obscure the flow\n298\tfunc handleLifecycleTurnEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n299\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n300\t\tlogging.Info(logCtx, \"turn-end\",\n301\t\t\tslog.String(\"event\", event.Type.String()),\n302\t\t\tslog.String(\"session_id\", event.SessionID),\n303\t\t\tslog.String(\"session_ref\", event.SessionRef),\n304\t\t\tslog.String(\"model\", event.Model),\n305\t\t)\n306\t\n307\t\tsessionID := event.SessionID\n308\t\tif sessionID == \"\" {\n309\t\t\tsessionID = unknownSessionID\n310\t\t}\n311\t\n312\t\t// Fill model from hint file if the agent didn't provide it on this hook\n313\t\tif event.Model == \"\" && sessionID != unknownSessionID {\n314\t\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n315\t\t\t\tevent.Model = hint\n316\t\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n317\t\t\t\t\tslog.String(\"model\", hint))\n318\t\t\t}\n319\t\t}\n320\t\n321\t\ttranscriptRef := event.SessionRef\n322\t\tif transcriptRef == \"\" {\n323\t\t\treturn errors.New(\"transcript file not specified\")\n324\t\t}\n325\t\n326\t\t// If agent implements TranscriptPreparer, materialize the transcript file.\n327\t\t// This must run BEFORE fileExists: agents like OpenCode lazily fetch transcripts\n328\t\t// via `opencode export`, so the file doesn't exist until PrepareTranscript creates it.\n329\t\t// Claude Code's PrepareTranscript just flushes (always succeeds). Agents without\n330\t\t// TranscriptPreparer (Gemini, Droid) are unaffected.\n331\t\t_, prepareSpan := perf.Start(ctx, \"prepare_and_validate_transcript\")\n332\t\tif preparer, ok := agent.AsTranscriptPreparer(ag); ok {\n333\t\t\tif err := preparer.PrepareTranscript(ctx, transcriptRef); err != nil {\n334\t\t\t\tlogging.Warn(logCtx, \"failed to prepare transcript\",\n335\t\t\t\t\tslog.String(\"error\", err.Error()))\n336\t\t\t}\n337\t\t}\n338\t\n339\t\tif !fileExists(transcriptRef) {\n340\t\t\tprepareSpan.RecordError(fmt.Errorf(\"transcript file not found: %s\", transcriptRef))\n341\t\t\tprepareSpan.End()\n342\t\t\treturn fmt.Errorf(\"transcript file not found: %s\", transcriptRef)\n343\t\t}\n344\t\n345\t\t// Early check: bail out quickly if the repo has no commits yet.\n346\t\t// Return nil (not an error) so the hook exits 0 — agents treat non-zero\n347\t\t// exit codes as hook failures. The user was already warned at session start.\n348\t\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n349\t\t\tprepareSpan.End()\n350\t\t\tlogging.Info(logCtx, \"skipping checkpoint - will activate after first commit\")\n351\t\t\treturn nil\n352\t\t}\n353\t\tprepareSpan.End()\n354\t\n355\t\t// Create session metadata directory\n356\t\t_, copySpan := perf.Start(ctx, \"copy_transcript\")\n357\t\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n358\t\tsessionDirAbs, err := paths.AbsPath(ctx, sessionDir)\n359\t\tif err != nil {\n360\t\t\tsessionDirAbs = sessionDir\n361\t\t}\n362\t\tif err := os.MkdirAll(sessionDirAbs, 0o750); err != nil {\n363\t\t\tcopySpan.RecordError(err)\n364\t\t\tcopySpan.End()\n365\t\t\treturn fmt.Errorf(\"failed to create session directory: %w\", err)\n366\t\t}\n367\t\n368\t\t// Copy transcript to session directory\n369\t\ttranscriptData, err := ag.ReadTranscript(transcriptRef)\n370\t\tif err != nil {\n371\t\t\tcopySpan.RecordError(err)\n372\t\t\tcopySpan.End()\n373\t\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n374\t\t}\n375\t\tlogFile := filepath.Join(sessionDirAbs, paths.TranscriptFileName)\n376\t\tif err := os.WriteFile(logFile, transcriptData, 0o600); err != nil {\n377\t\t\tcopySpan.RecordError(err)\n378\t\t\tcopySpan.End()\n379\t\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n380\t\t}\n381\t\tlogging.Debug(logCtx, \"copied transcript\",\n382\t\t\tslog.String(\"path\", sessionDir+\"/\"+paths.TranscriptFileName))\n383\t\tcopySpan.End()\n384\t\n385\t\t// Load pre-prompt state (captured on TurnStart)\n386\t\t_, extractSpan := perf.Start(ctx, \"extract_metadata\")\n387\t\tpreState, err := LoadPrePromptState(ctx, sessionID)\n388\t\tif err != nil {\n389\t\t\tlogging.Warn(logCtx, \"failed to load pre-prompt state\",\n390\t\t\t\tslog.String(\"error\", err.Error()))\n391\t\t}\n392\t\n393\t\t// Determine transcript offset\n394\t\ttranscriptOffset := resolveTranscriptOffset(ctx, preState, sessionID)\n395\t\n396\t\t// Backfill prompt.txt from transcript when prompt data is missing.\n397\t\t// This handles agents whose exec mode doesn't fire UserPromptSubmit (e.g., Factory AI\n398\t\t// Droid). The transcript is the source of truth — if ExtractPrompts returns nothing,\n399\t\t// there genuinely were no prompts. We track whether backfill occurred so we can\n400\t\t// update session state after SaveStep (which may reinitialize state).\n401\t\tvar backfilledPrompt string\n402\t\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n403\t\texistingPrompt, readPromptErr := os.ReadFile(promptPath) //nolint:gosec // file content is safe session metadata\n404\t\tif readPromptErr != nil && !os.IsNotExist(readPromptErr) {\n405\t\t\tlogging.Warn(logCtx, \"failed to read prompt.txt, skipping backfill\",\n406\t\t\t\tslog.String(\"error\", readPromptErr.Error()))\n407\t\t} else if len(existingPrompt) == 0 {\n408\t\t\tif extractor, ok := agent.AsPromptExtractor(ag); ok {\n409\t\t\t\tprompts, extractErr := extractor.ExtractPrompts(transcriptRef, transcriptOffset)\n410\t\t\t\tif extractErr != nil {\n411\t\t\t\t\tlogging.Warn(logCtx, \"failed to extract prompts from transcript\",\n412\t\t\t\t\t\tslog.String(\"error\", extractErr.Error()))\n413\t\t\t\t} else if len(prompts) > 0 {\n414\t\t\t\t\tcontent := strings.Join(prompts, \"\\n\\n---\\n\\n\")\n415\t\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil {\n416\t\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill prompt.txt from transcript\",\n417\t\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n418\t\t\t\t\t} else {\n419\t\t\t\t\t\tlogging.Debug(logCtx, \"backfilled prompt.txt from transcript\",\n420\t\t\t\t\t\t\tslog.Int(\"prompt_count\", len(prompts)))\n421\t\t\t\t\t\tbackfilledPrompt = prompts[len(prompts)-1]\n422\t\t\t\t\t}\n423\t\t\t\t}\n424\t\t\t}\n425\t\t}\n426\t\n427\t\t// Compute subagents directory for agents that support subagent extraction.\n428\t\t// Subagent transcripts live in <transcriptDir>/<modelSessionID>/subagents/\n429\t\tsubagentsDir := filepath.Join(filepath.Dir(transcriptRef), event.SessionID, \"subagents\")\n430\t\n431\t\t// Extract metadata via agent interface (modified files)\n432\t\tvar modifiedFiles []string\n433\t\n434\t\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n435\t\t\t// Extract modified files - prefer SubagentAwareExtractor if available to include subagent files\n436\t\t\tif subagentExtractor, subOk := agent.AsSubagentAwareExtractor(ag); subOk {\n437\t\t\t\tif files, fileErr := subagentExtractor.ExtractAllModifiedFiles(transcriptData, transcriptOffset, subagentsDir); fileErr != nil {\n438\t\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files (with subagents)\",\n439\t\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n440\t\t\t\t} else {\n441\t\t\t\t\tmodifiedFiles = files\n442\t\t\t\t}\n443\t\t\t} else {\n444\t\t\t\t// Fall back to basic extraction (main transcript only)\n445\t\t\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptRef, transcriptOffset); fileErr != nil {\n446\t\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files\",\n447\t\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n448\t\t\t\t} else {\n449\t\t\t\t\tmodifiedFiles = files\n450\t\t\t\t}\n451\t\t\t}\n452\t\t}\n453\t\textractSpan.End()\n454\t\n455\t\t// Generate commit message from last prompt (read from session state, set at TurnStart).\n456\t\t// In exec mode, session state LastPrompt may be empty because UserPromptSubmit never fires.\n457\t\t// Fall back to backfilledPrompt extracted from the transcript.\n458\t\t// Single load serves both prompt retrieval and backfill.\n459\t\t_, commitMsgSpan := perf.Start(ctx, \"generate_commit_message\")\n460\t\tlastPrompt := \"\"\n461\t\tif sessionState, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && sessionState != nil {\n462\t\t\tlastPrompt = sessionState.LastPrompt\n463\t\t\t// Backfill LastPrompt so `entire status` shows the prompt even when\n464\t\t\t// no files were modified (before the early return below).\n465\t\t\tif lastPrompt == \"\" && backfilledPrompt != \"\" {\n466\t\t\t\tlastPrompt = backfilledPrompt\n467\t\t\t\tsessionState.LastPrompt = backfilledPrompt\n468\t\t\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n469\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n470\t\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n471\t\t\t\t}\n472\t\t\t}\n473\t\t} else if backfilledPrompt != \"\" {\n474\t\t\tlastPrompt = backfilledPrompt\n475\t\t}\n476\t\tcommitMessage := generateCommitMessage(lastPrompt, ag.Type())\n477\t\tlogging.Debug(logCtx, \"using commit message\",\n478\t\t\tslog.Int(\"message_length\", len(commitMessage)))\n479\t\tcommitMsgSpan.End()\n480\t\n481\t\t// Get worktree root for path normalization\n482\t\t_, detectSpan := perf.Start(ctx, \"detect_file_changes\")\n483\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n484\t\tif err != nil {\n485\t\t\tdetectSpan.RecordError(err)\n486\t\t\tdetectSpan.End()\n487\t\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n488\t\t}\n489\t\n490\t\tvar preUntrackedFiles []string\n491\t\tif preState != nil {\n492\t\t\tlogging.Debug(logCtx, \"pre-prompt state\",\n493\t\t\t\tslog.Int(\"pre_existing_untracked_files\", len(preState.UntrackedFiles)))\n494\t\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n495\t\t}\n496\t\n497\t\t// Detect file changes via git status\n498\t\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n499\t\tif err != nil {\n500\t\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n501\t\t\t\tslog.String(\"error\", err.Error()))\n502\t\t}\n503\t\tdetectSpan.End()\n504\t\n505\t\t// Filter and normalize all paths\n506\t\t_, normalizeSpan := perf.Start(ctx, \"filter_and_normalize_paths\")\n507\t\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n508\t\tvar relNewFiles, relDeletedFiles []string\n509\t\tif changes != nil {\n510\t\t\trelNewFiles = FilterAndNormalizePaths(changes.New, repoRoot)\n511\t\t\trelDeletedFiles = FilterAndNormalizePaths(changes.Deleted, repoRoot)\n512\t\n513\t\t\t// Merge git-status modified files as a fallback for transcript parsing.\n514\t\t\t// Transcript parsing is the primary source for modified files, but it can miss\n515\t\t\t// files if the agent uses an unrecognized tool or the transcript format changes.\n516\t\t\t// Git status catches any tracked file with working-tree changes.\n517\t\t\trelModifiedFiles = mergeUnique(relModifiedFiles, FilterAndNormalizePaths(changes.Modified, repoRoot))\n518\t\t}\n519\t\n520\t\t// Filter transcript-extracted files to exclude files already committed to HEAD.\n521\t\t// When an agent commits files mid-turn, those files are condensed by PostCommit\n522\t\t// and should not be re-added to FilesTouched by SaveStep. A file is \"committed\"\n523\t\t// if it exists in HEAD with the same content as the working tree.\n524\t\trelModifiedFiles = filterToUncommittedFiles(ctx, relModifiedFiles, repoRoot)\n525\t\tnormalizeSpan.End()\n526\t\n527\t\t// Check if there are any changes\n528\t\ttotalChanges := len(relModifiedFiles) + len(relNewFiles) + len(relDeletedFiles)\n529\t\tif totalChanges == 0 {\n530\t\t\tlogging.Info(logCtx, \"no files modified during session, skipping checkpoint\")\n531\t\t\ttransitionSessionTurnEnd(ctx, sessionID, event)\n532\t\t\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n533\t\t\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n534\t\t\t\t\tslog.String(\"error\", cleanupErr.Error()))\n535\t\t\t}\n536\t\t\treturn nil\n537\t\t}\n538\t\n539\t\t// Log file changes\n540\t\tlogFileChanges(ctx, relModifiedFiles, relNewFiles, relDeletedFiles)\n541\t\n542\t\t// Get git author\n543\t\tauthor, err := GetGitAuthor(ctx)\n544\t\tif err != nil {\n545\t\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n546\t\t}\n547\t\n548\t\t// Get strategy and agent type\n549\t\tstrat := GetStrategy(ctx)\n550\t\tagentType := ag.Type()\n551\t\n552\t\t// Get transcript position/identifier from pre-prompt state\n553\t\tvar transcriptIdentifierAtStart string\n554\t\tvar transcriptLinesAtStart int\n555\t\tif preState != nil {\n556\t\t\ttranscriptIdentifierAtStart = preState.LastTranscriptIdentifier\n557\t\t\ttranscriptLinesAtStart = preState.TranscriptOffset\n558\t\t}\n559\t\n560\t\t// Calculate token usage - prefer SubagentAwareExtractor to include subagent tokens\n561\t\ttokenUsage := agent.CalculateTokenUsage(ctx, ag, transcriptData, transcriptLinesAtStart, subagentsDir)\n562\t\n563\t\t// Build fully-populated step context and delegate to strategy\n564\t\tstepCtx := strategy.StepContext{\n565\t\t\tSessionID:                sessionID,\n566\t\t\tModifiedFiles:            relModifiedFiles,\n567\t\t\tNewFiles:                 relNewFiles,\n568\t\t\tDeletedFiles:             relDeletedFiles,\n569\t\t\tMetadataDir:              sessionDir,\n570\t\t\tMetadataDirAbs:           sessionDirAbs,\n571\t\t\tCommitMessage:            commitMessage,\n572\t\t\tTranscriptPath:           transcriptRef,\n573\t\t\tAuthorName:               author.Name,\n574\t\t\tAuthorEmail:              author.Email,\n575\t\t\tAgentType:                agentType,\n576\t\t\tStepTranscriptIdentifier: transcriptIdentifierAtStart,\n577\t\t\tStepTranscriptStart:      transcriptLinesAtStart,\n578\t\t\tTokenUsage:               tokenUsage,\n579\t\t}\n580\t\n581\t\tif err := strat.SaveStep(ctx, stepCtx); err != nil {\n582\t\t\treturn fmt.Errorf(\"failed to save step: %w\", err)\n583\t\t}\n584\t\n585\t\t// Update session state with backfilled prompt after SaveStep.\n586\t\t// Done after SaveStep because SaveStep may reinitialize session state,\n587\t\t// which would overwrite an earlier LastPrompt update.\n588\t\tif backfilledPrompt != \"\" {\n589\t\t\tif state, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && state != nil && state.LastPrompt == \"\" {\n590\t\t\t\tstate.LastPrompt = backfilledPrompt\n591\t\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n592\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n593\t\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n594\t\t\t\t}\n595\t\t\t}\n596\t\t}\n597\t\n598\t\t// Transition session phase and cleanup\n599\t\ttransitionSessionTurnEnd(ctx, sessionID, event)\n600\t\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n601\t\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n602\t\t\t\tslog.String(\"error\", cleanupErr.Error()))\n603\t\t}\n604\t\n605\t\treturn nil\n606\t}\n607\t\n608\t// handleLifecycleCompaction handles context compaction: saves current progress\n609\t// but stays in ACTIVE phase (unlike TurnEnd which transitions to IDLE).\n610\t// Also resets the transcript offset since the transcript may be truncated.\n611\tfunc handleLifecycleCompaction(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n612\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n613\t\tlogging.Info(logCtx, \"compaction\",\n614\t\t\tslog.String(\"event\", event.Type.String()),\n615\t\t\tslog.String(\"session_id\", event.SessionID),\n616\t\t)\n617\t\n618\t\t// Fire EventCompaction to trigger ActionCondenseIfFilesTouched (stays in ACTIVE)\n619\t\tsessionID := event.SessionID\n620\t\tsessionState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n621\t\tif loadErr != nil {\n622\t\t\tlogging.Warn(logCtx, \"failed to load session state for compaction\",\n623\t\t\t\tslog.String(\"error\", loadErr.Error()))\n624\t\t}\n625\t\tif sessionState != nil {\n626\t\t\tpersistEventMetadataToState(event, sessionState)\n627\t\n628\t\t\tif transErr := strategy.TransitionAndLog(ctx, sessionState, session.EventCompaction, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n629\t\t\t\tlogging.Warn(logCtx, \"compaction transition failed\",\n630\t\t\t\t\tslog.String(\"error\", transErr.Error()))\n631\t\t\t}\n632\t\n633\t\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n634\t\t\t\tlogging.Warn(logCtx, \"failed to save session state after compaction\",\n635\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n636\t\t\t}\n637\t\t}\n638\t\n639\t\tlogging.Info(logCtx, \"context compaction detected\")\n640\t\treturn nil\n641\t}\n642\t\n643\t// handleLifecycleSessionEnd handles session end: marks the session as ended.\n644\tfunc handleLifecycleSessionEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n645\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n646\t\tlogging.Info(logCtx, \"session-end\",\n647\t\t\tslog.String(\"event\", event.Type.String()),\n648\t\t\tslog.String(\"session_id\", event.SessionID),\n649\t\t)\n650\t\n651\t\tif event.SessionID == \"\" {\n652\t\t\treturn nil // No session to update\n653\t\t}\n654\t\n655\t\t// Note: We intentionally don't clean up cached transcripts here.\n656\t\t// Post-session commits (carry-forward in ENDED phase) may still need\n657\t\t// the transcript to extract file changes. Cleanup is handled by\n658\t\t// `entire clean` or when the session state is fully removed.\n659\t\n660\t\tif err := markSessionEnded(ctx, event, event.SessionID); err != nil {\n661\t\t\tlogging.Warn(logCtx, \"failed to mark session ended\",\n662\t\t\t\tslog.String(\"error\", err.Error()))\n663\t\t\t// Don't attempt eager condense if we couldn't even mark the session ended —\n664\t\t\t// the session state may be in an inconsistent state.\n665\t\t\treturn nil\n666\t\t}\n667\t\n668\t\t// Eagerly condense session data so PostCommit doesn't have to process it.\n669\t\t// This prevents zombie ENDED sessions from accumulating and causing O(N)\n670\t\t// overhead on every future commit (GitHub issue #591).\n671\t\t// Fail-open: if this fails, PostCommit will still process it on the next commit.\n672\t\tstrat := GetStrategy(ctx)\n673\t\tif err := strat.CondenseAndMarkFullyCondensed(ctx, event.SessionID); err != nil {\n674\t\t\tlogging.Warn(logCtx, \"eager condense on session stop failed\",\n675\t\t\t\tslog.String(\"session_id\", event.SessionID),\n676\t\t\t\tslog.String(\"error\", err.Error()))\n677\t\t}\n678\t\n679\t\treturn nil\n680\t}\n681\t\n682\t// handleLifecycleSubagentStart handles subagent start: captures pre-task state.\n683\tfunc handleLifecycleSubagentStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n684\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n685\t\tlogging.Info(logCtx, \"subagent started\",\n686\t\t\tslog.String(\"event\", event.Type.String()),\n687\t\t\tslog.String(\"session_id\", event.SessionID),\n688\t\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n689\t\t\tslog.String(\"transcript\", event.SessionRef),\n690\t\t)\n691\t\n692\t\t// Capture pre-task state\n693\t\tif err := CapturePreTaskState(ctx, event.ToolUseID); err != nil {\n694\t\t\treturn fmt.Errorf(\"failed to capture pre-task state: %w\", err)\n695\t\t}\n696\t\n697\t\treturn nil\n698\t}\n699\t\n700\t// handleLifecycleSubagentEnd handles subagent end: detects changes, saves task checkpoint.\n701\tfunc handleLifecycleSubagentEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n702\t\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n703\t\tif event.SubagentType == \"\" && event.TaskDescription == \"\" {\n704\t\t\t// Extract subagent type and description from tool input\n705\t\t\tevent.SubagentType, event.TaskDescription = ParseSubagentTypeAndDescription(event.ToolInput)\n706\t\t}\n707\t\n708\t\t// Determine subagent transcript path\n709\t\ttranscriptDir := filepath.Dir(event.SessionRef)\n710\t\tvar subagentTranscriptPath string\n711\t\tif event.SubagentID != \"\" {\n712\t\t\tsubagentTranscriptPath = AgentTranscriptPath(transcriptDir, event.SubagentID)\n713\t\t\tif !fileExists(subagentTranscriptPath) {\n714\t\t\t\tsubagentTranscriptPath = \"\"\n715\t\t\t}\n716\t\t}\n717\t\n718\t\t// Log context\n719\t\tsubagentEndAttrs := []any{\n720\t\t\tslog.String(\"event\", event.Type.String()),\n721\t\t\tslog.String(\"session_id\", event.SessionID),\n722\t\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n723\t\t}\n724\t\tif event.SubagentID != \"\" {\n725\t\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"agent_id\", event.SubagentID))\n726\t\t}\n727\t\tif subagentTranscriptPath != \"\" {\n728\t\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"subagent_transcript\", subagentTranscriptPath))\n729\t\t}\n730\t\tlogging.Info(logCtx, \"subagent completed\", subagentEndAttrs...)\n731\t\n732\t\t// Extract modified files from hook payload and/or subagent transcript\n733\t\tvar modifiedFiles []string\n734\t\tmodifiedFiles = append(modifiedFiles, event.ModifiedFiles...)\n735\t\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n736\t\t\ttranscriptToScan := event.SessionRef\n737\t\t\tif subagentTranscriptPath != \"\" {\n738\t\t\t\ttranscriptToScan = subagentTranscriptPath\n739\t\t\t}\n740\t\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptToScan, 0); fileErr != nil {\n741\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files from subagent\",\n742\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n743\t\t\t} else {\n744\t\t\t\tmodifiedFiles = mergeUnique(modifiedFiles, files)\n745\t\t\t}\n746\t\t}\n747\t\n748\t\t// Load pre-task state and detect file changes.\n749\t\t// If no pre-task state exists (agent doesn't support pre-task hook), fall back\n750\t\t// to the session's pre-prompt state. Without either, DetectFileChanges receives\n751\t\t// nil and treats ALL untracked files as new — which would create spurious task\n752\t\t// checkpoints for pre-existing untracked files (e.g., .github/hooks/entire.json).\n753\t\tpreState, err := LoadPreTaskState(ctx, event.ToolUseID)\n754\t\tif err != nil {\n755\t\t\tlogging.Warn(logCtx, \"failed to load pre-task state\",\n756\t\t\t\tslog.String(\"error\", err.Error()))\n757\t\t}\n758\t\tvar preUntrackedFiles []string\n759\t\tif preState != nil {\n760\t\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n761\t\t}\n762\t\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n763\t\tif err != nil {\n764\t\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n765\t\t\t\tslog.String(\"error\", err.Error()))\n766\t\t}\n767\t\n768\t\t// Get worktree root and normalize paths\n769\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n770\t\tif err != nil {\n771\t\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n772\t\t}\n773\t\n774\t\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n775\t\tvar relNewFiles, relDeletedFiles []string\n776\t\tif changes != nil {\n777\t\t\trelNewFiles = FilterAndNormalizePaths(changes.New, repoRoot)\n778\t\t\trelDeletedFiles = FilterAndNormalizePaths(changes.Deleted, repoRoot)\n779\t\t\trelModifiedFiles = mergeUnique(relModifiedFiles, FilterAndNormalizePaths(changes.Modified, repoRoot))\n780\t\t}\n781\t\n782\t\t// If no changes, skip\n783\t\tif len(relModifiedFiles) == 0 && len(relNewFiles) == 0 && len(relDeletedFiles) == 0 {\n784\t\t\tlogging.Info(logCtx, \"no file changes detected, skipping task checkpoint\")\n785\t\t\t_ = CleanupPreTaskState(ctx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n786\t\t\treturn nil\n787\t\t}\n788\t\n789\t\t// Find checkpoint UUID from main transcript (best-effort)\n790\t\tvar checkpointUUID string\n791\t\t// Use the existing CLI-level checkpoint UUID finder\n792\t\tmainLines, _ := parseTranscriptForCheckpointUUID(event.SessionRef) //nolint:errcheck // best-effort\n793\t\tif mainLines != nil {\n794\t\t\tcheckpointUUID, _ = FindCheckpointUUID(mainLines, event.ToolUseID)\n795\t\t}\n796\t\n797\t\t// Get git author\n798\t\tauthor, err := GetGitAuthor(ctx)\n799\t\tif err != nil {\n800\t\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n801\t\t}\n802\t\n803\t\t// Build task checkpoint context\n804\t\tstrat := GetStrategy(ctx)\n805\t\tagentType := ag.Type()\n806\t\n807\t\ttaskStepCtx := strategy.TaskStepContext{\n808\t\t\tSessionID:              event.SessionID,\n809\t\t\tToolUseID:              event.ToolUseID,\n810\t\t\tAgentID:                event.SubagentID,\n811\t\t\tModifiedFiles:          relModifiedFiles,\n812\t\t\tNewFiles:               relNewFiles,\n813\t\t\tDeletedFiles:           relDeletedFiles,\n814\t\t\tTranscriptPath:         event.SessionRef,\n815\t\t\tSubagentTranscriptPath: subagentTranscriptPath,\n816\t\t\tCheckpointUUID:         checkpointUUID,\n817\t\t\tAuthorName:             author.Name,\n818\t\t\tAuthorEmail:            author.Email,\n819\t\t\tSubagentType:           event.SubagentType,\n820\t\t\tTaskDescription:        event.TaskDescription,\n821\t\t\tAgentType:              agentType,\n822\t\t}\n823\t\n824\t\tif err := strat.SaveTaskStep(ctx, taskStepCtx); err != nil {\n825\t\t\treturn fmt.Errorf(\"failed to save task step: %w\", err)\n826\t\t}\n827\t\n828\t\t_ = CleanupPreTaskState(ctx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n829\t\treturn nil\n830\t}\n831\t\n832\t// --- Helper functions ---\n833\t\n834\t// resolveTranscriptOffset determines the transcript offset to use for parsing.\n835\t// Prefers pre-prompt state, falls back to session state.\n836\tfunc resolveTranscriptOffset(ctx context.Context, preState *PrePromptState, sessionID string) int {\n837\t\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n838\t\tif preState != nil && preState.TranscriptOffset > 0 {\n839\t\t\tlogging.Debug(logCtx, \"pre-prompt state found, parsing transcript from offset\",\n840\t\t\t\tslog.Int(\"offset\", preState.TranscriptOffset))\n841\t\t\treturn preState.TranscriptOffset\n842\t\t}\n843\t\n844\t\t// Fall back to session state\n845\t\tsessionState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n846\t\tif loadErr != nil {\n847\t\t\tlogging.Warn(logCtx, \"failed to load session state\",\n848\t\t\t\tslog.String(\"error\", loadErr.Error()))\n849\t\t\treturn 0\n850\t\t}\n851\t\tif sessionState != nil && sessionState.CheckpointTranscriptStart > 0 {\n852\t\t\tlogging.Debug(logCtx, \"session state found, parsing transcript from offset\",\n853\t\t\t\tslog.Int(\"offset\", sessionState.CheckpointTranscriptStart))\n854\t\t\treturn sessionState.CheckpointTranscriptStart\n855\t\t}\n856\t\n857\t\treturn 0\n858\t}\n859\t\n860\t// parseTranscriptForCheckpointUUID is a thin wrapper around transcript parsing for checkpoint UUID lookup.\n861\t// Returns parsed transcript lines for use with FindCheckpointUUID.\n862\tfunc parseTranscriptForCheckpointUUID(transcriptPath string) ([]transcriptLine, error) {\n863\t\tlines, err := transcript.ParseFromFileAtLine(transcriptPath, 0)\n864\t\tif err != nil {\n865\t\t\treturn nil, fmt.Errorf(\"parsing transcript for checkpoint UUID: %w\", err)\n866\t\t}\n867\t\treturn lines, nil\n868\t}\n869\t\n870\t// transitionSessionTurnEnd transitions the session phase to IDLE and dispatches turn-end actions.\n871\tfunc transitionSessionTurnEnd(ctx context.Context, sessionID string, event *agent.Event) {\n872\t\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n873\t\tturnState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n874\t\tif loadErr != nil {\n875\t\t\tlogging.Warn(logCtx, \"failed to load session state for turn end\",\n876\t\t\t\tslog.String(\"error\", loadErr.Error()))\n877\t\t\treturn\n878\t\t}\n879\t\tif turnState == nil {\n880\t\t\treturn\n881\t\t}\n882\t\n883\t\tpersistEventMetadataToState(event, turnState)\n884\t\n885\t\tif err := strategy.TransitionAndLog(ctx, turnState, session.EventTurnEnd, session.TransitionContext{}, session.NoOpActionHandler{}); err != nil {\n886\t\t\tlogging.Warn(logCtx, \"turn-end transition failed\",\n887\t\t\t\tslog.String(\"error\", err.Error()))\n888\t\t}\n889\t\n890\t\t// Always dispatch to strategy for turn-end handling. The strategy reads\n891\t\t// work items from state (e.g. TurnCheckpointIDs), not the action list.\n892\t\tstrat := GetStrategy(ctx)\n893\t\tif err := strat.HandleTurnEnd(ctx, turnState); err != nil {\n894\t\t\tlogging.Warn(logCtx, \"turn-end action dispatch failed\",\n895\t\t\t\tslog.String(\"error\", err.Error()))\n896\t\t}\n897\t\n898\t\tif updateErr := strategy.SaveSessionState(ctx, turnState); updateErr != nil {\n899\t\t\tlogging.Warn(logCtx, \"failed to update session phase on turn end\",\n900\t\t\t\tslog.String(\"error\", updateErr.Error()))\n901\t\t}\n902\t}\n903\t\n904\t// markSessionEnded transitions the session to ENDED phase via the state machine.\n905\t// If event is non-nil, hook-provided metrics are persisted to state before saving.\n906\tfunc markSessionEnded(ctx context.Context, event *agent.Event, sessionID string) error {\n907\t\tstate, err := strategy.LoadSessionState(ctx, sessionID)\n908\t\tif err != nil {\n909\t\t\treturn fmt.Errorf(\"failed to load session state: %w\", err)\n910\t\t}\n911\t\tif state == nil {\n912\t\t\treturn nil // No state file, nothing to update\n913\t\t}\n914\t\n915\t\tif event != nil {\n916\t\t\tpersistEventMetadataToState(event, state)\n917\t\t}\n918\t\n919\t\tif transErr := strategy.TransitionAndLog(ctx, state, session.EventSessionStop, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n920\t\t\tlogging.Warn(logging.WithComponent(ctx, \"lifecycle\"), \"session stop transition failed\",\n921\t\t\t\tslog.String(\"error\", transErr.Error()))\n922\t\t}\n923\t\n924\t\tnow := time.Now()\n925\t\tstate.EndedAt = &now\n926\t\n927\t\tif err := strategy.SaveSessionState(ctx, state); err != nil {\n928\t\t\treturn fmt.Errorf(\"failed to save session state: %w\", err)\n929\t\t}\n930\t\treturn nil\n931\t}\n932\t\n933\t// logFileChanges logs the files modified, created, and deleted during a session.\n934\tfunc logFileChanges(ctx context.Context, modified, newFiles, deleted []string) {\n935\t\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n936\t\tlogging.Debug(logCtx, \"files changed during session\",\n937\t\t\tslog.Int(\"modified\", len(modified)),\n938\t\t\tslog.Int(\"new\", len(newFiles)),\n939\t\t\tslog.Int(\"deleted\", len(deleted)))\n940\t}\n941\t\n942\tfunc persistEventMetadataToState(event *agent.Event, state *strategy.SessionState) {\n943\t\t// Update ModelName if provided (model is known by turn-end even on first turn)\n944\t\tif event.Model != \"\" {\n945\t\t\tstate.ModelName = event.Model\n946\t\t}\n947\t\n948\t\t// Persist hook-provided session metrics (e.g., from Cursor hooks)\n949\t\tif event.DurationMs > 0 {\n950\t\t\tstate.SessionDurationMs = event.DurationMs\n951\t\t}\n952\t\t// Use hook-reported turn count if available (take max); otherwise\n953\t\t// increment on each TurnEnd event to count turns ourselves.\n954\t\tif event.TurnCount > 0 {\n955\t\t\tif event.TurnCount > state.SessionTurnCount {\n956\t\t\t\tstate.SessionTurnCount = event.TurnCount\n957\t\t\t}\n958\t\t} else if event.Type == agent.TurnEnd {\n959\t\t\tstate.SessionTurnCount++\n960\t\t}\n961\t\tif event.ContextTokens > 0 {\n962\t\t\tstate.ContextTokens = event.ContextTokens\n963\t\t}\n964\t\tif event.ContextWindowSize > 0 {\n965\t\t\tstate.ContextWindowSize = event.ContextWindowSize\n966\t\t}\n967\t}\n968\t\n969\t// adoptReviewEnv tags the session as a review session when ENTIRE_REVIEW_*\n970\t// env vars are present on the current process. `entire review` sets these\n971\t// vars on the spawned agent process; the lifecycle hook (a child of the agent)\n972\t// inherits them naturally. Agent and starting-SHA checks protect against stale\n973\t// ENTIRE_REVIEW_* values inherited from a parent shell or a nested invocation.\n974\t//\n975\t// Adoption is idempotent: if state.Kind is already set (subsequent turns of\n976\t// a review session) the function returns without modifying state.\n977\t//\n978\t// Failure modes are silent at the user level but logged for diagnostics:\n979\t//   - EnvSession unset or not \"1\": not a review session; return, no tagging.\n980\t//   - EnvAgent does not match the hook agent: leave session untagged.\n981\t//   - EnvStartingSHA does not match the session base commit: leave untagged.\n982\t//   - EnvSkills malformed JSON: log warning, leave session untagged to avoid\n983\t//     corrupting metadata with junk data.\n984\tfunc adoptReviewEnv(ctx context.Context, state *session.State, expectedAgent string) {\n985\t\t// Already tagged — don't re-apply on subsequent turns.\n986\t\tif state.Kind != \"\" {\n987\t\t\treturn\n988\t\t}\n989\t\tif os.Getenv(review.EnvSession) != \"1\" {\n990\t\t\treturn\n991\t\t}\n992\t\tenvAgent := os.Getenv(review.EnvAgent)\n993\t\tif envAgent != expectedAgent {\n994\t\t\tlogging.Warn(ctx, \"review env adoption skipped: agent mismatch\",\n995\t\t\t\tslog.String(\"env_agent\", envAgent),\n996\t\t\t\tslog.String(\"hook_agent\", expectedAgent))\n997\t\t\treturn\n998\t\t}\n999\t\tstartingSHA := os.Getenv(review.EnvStartingSHA)\n1000\t\tif startingSHA == \"\" || state.BaseCommit == \"\" || startingSHA != state.BaseCommit {\n1001\t\t\tlogging.Warn(ctx, \"review env adoption skipped: starting SHA mismatch\",\n1002\t\t\t\tslog.String(\"env_starting_sha\", startingSHA),\n1003\t\t\t\tslog.String(\"state_base_commit\", state.BaseCommit))\n1004\t\t\treturn\n1005\t\t}\n1006\t\tskills, err := review.DecodeSkills(os.Getenv(review.EnvSkills))\n1007\t\tif err != nil {\n1008\t\t\tlogging.Warn(ctx, \"review env adoption failed: invalid skills JSON\",\n1009\t\t\t\tslog.String(\"err\", err.Error()))\n1010\t\t\treturn\n1011\t\t}\n1012\t\tstate.Kind = session.KindAgentReview\n1013\t\tstate.ReviewSkills = skills\n1014\t\tstate.ReviewPrompt = os.Getenv(review.EnvPrompt)\n1015\t\tlogging.Debug(ctx, \"adopted review env\",\n1016\t\t\tslog.String(\"agent\", envAgent),\n1017\t\t\tslog.Int(\"skill_count\", len(skills)))\n1018\t}\n1019\t"}]},"uuid":"07d57b8d-6058-49c8-8992-309af7aee7e1","timestamp":"2026-05-06T11:24:11.275Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/lifecycle.go","content":"// lifecycle.go implements the generic lifecycle event dispatcher.\n// It routes normalized events from any agent to the appropriate framework actions.\n//\n// The dispatcher inverts the current flow from \"agent handler calls framework functions\"\n// to \"framework dispatcher calls agent methods.\" Agents are passive data providers;\n// the dispatcher handles all orchestration: state transitions, strategy calls,\n// file change detection, metadata generation.\npackage cli\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/review\"\n\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n\t\"github.com/entireio/cli/cmd/entire/cli/transcript\"\n\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n\t\"github.com/entireio/cli/perf\"\n)\n\n// DispatchLifecycleEvent routes a normalized lifecycle event to the appropriate handler.\n// Returns nil if the event was handled successfully.\nfunc DispatchLifecycleEvent(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tif ag == nil {\n\t\treturn errors.New(\"agent cannot be nil\")\n\t}\n\tif event == nil {\n\t\treturn errors.New(\"event cannot be nil\")\n\t}\n\n\tswitch event.Type {\n\tcase agent.SessionStart:\n\t\treturn handleLifecycleSessionStart(ctx, ag, event)\n\tcase agent.TurnStart:\n\t\treturn handleLifecycleTurnStart(ctx, ag, event)\n\tcase agent.TurnEnd:\n\t\treturn handleLifecycleTurnEnd(ctx, ag, event)\n\tcase agent.Compaction:\n\t\treturn handleLifecycleCompaction(ctx, ag, event)\n\tcase agent.SessionEnd:\n\t\treturn handleLifecycleSessionEnd(ctx, ag, event)\n\tcase agent.SubagentStart:\n\t\treturn handleLifecycleSubagentStart(ctx, ag, event)\n\tcase agent.SubagentEnd:\n\t\treturn handleLifecycleSubagentEnd(ctx, ag, event)\n\tcase agent.ModelUpdate:\n\t\treturn handleLifecycleModelUpdate(ctx, ag, event)\n\tdefault:\n\t\treturn fmt.Errorf(\"unknown lifecycle event type: %d\", event.Type)\n\t}\n}\n\n// handleLifecycleSessionStart handles session start: shows banner, checks concurrent sessions,\n// fires state machine transition.\nfunc handleLifecycleSessionStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"session-start\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"session_ref\", event.SessionRef),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tif event.SessionID == \"\" {\n\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n\t}\n\tif err := validation.ValidateSessionID(event.SessionID); err != nil {\n\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n\t}\n\n\t// Build informational message — warn early if repo has no commits yet,\n\t// since checkpoints require at least one commit to work.\n\tmessage := sessionStartMessage(ag.Name(), false)\n\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n\t\tmessage = sessionStartMessage(ag.Name(), true)\n\t}\n\n\t// Check for concurrent sessions and append count if any\n\t_, countSessionsSpan := perf.Start(ctx, \"count_active_sessions\")\n\tstrat := GetStrategy(ctx)\n\tif count, err := strat.CountOtherActiveSessionsWithCheckpoints(ctx, event.SessionID); err == nil && count > 0 {\n\t\tif ag.Name() == agent.AgentNameCodex {\n\t\t\tmessage += fmt.Sprintf(\" %d other active conversation(s) in this workspace will also be included. Use 'entire status' for more information.\", count)\n\t\t} else {\n\t\t\tmessage += fmt.Sprintf(\"\\n  %d other active conversation(s) in this workspace will also be included.\\n  Use 'entire status' for more information.\", count)\n\t\t}\n\t}\n\tcountSessionsSpan.End()\n\n\t// Output informational message if the agent supports hook responses.\n\t// Claude Code reads JSON from stdout; agents that don't implement\n\t// HookResponseWriter silently skip (avoids raw JSON in their terminal).\n\t_, hookResponseSpan := perf.Start(ctx, \"write_hook_response\")\n\tif event.ResponseMessage != \"\" {\n\t\tmessage = event.ResponseMessage\n\t}\n\tif writer, ok := agent.AsHookResponseWriter(ag); ok {\n\t\tif err := writer.WriteHookResponse(message); err != nil {\n\t\t\thookResponseSpan.RecordError(err)\n\t\t\thookResponseSpan.End()\n\t\t\treturn fmt.Errorf(\"failed to write hook response: %w\", err)\n\t\t}\n\t}\n\thookResponseSpan.End()\n\n\t// Store model hint if the agent provided model info on SessionStart\n\tif event.Model != \"\" {\n\t\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to store model hint on session start\",\n\t\t\t\tslog.String(\"error\", err.Error()))\n\t\t}\n\t}\n\n\t// Fire EventSessionStart for the current session (if state exists).\n\tif state, loadErr := strategy.LoadSessionState(ctx, event.SessionID); loadErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state on start\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t} else if state != nil {\n\t\tpersistEventMetadataToState(event, state)\n\t\tif transErr := strategy.TransitionAndLog(ctx, state, session.EventSessionStart, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n\t\t\tlogging.Warn(logCtx, \"session start transition failed\",\n\t\t\t\tslog.String(\"error\", transErr.Error()))\n\t\t}\n\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to update session state on start\",\n\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t}\n\t}\n\n\treturn nil\n}\n\nfunc sessionStartMessage(agentName types.AgentName, emptyRepo bool) string {\n\tif agentName == agent.AgentNameCodex {\n\t\tif emptyRepo {\n\t\t\treturn \"Entire CLI found no commits yet — checkpoints will activate after your first commit.\"\n\t\t}\n\t\treturn \"Entire CLI will link this conversation to your next commit.\"\n\t}\n\n\tif emptyRepo {\n\t\treturn \"\\n\\nEntire CLI found no commits yet — checkpoints will activate after your first commit.\"\n\t}\n\treturn \"\\n\\nEntire CLI will link this conversation to your next commit.\"\n}\n\n// handleLifecycleModelUpdate persists the model name for the current session.\n//\n// If the session state file already exists (e.g., Gemini's BeforeModel fires\n// after TurnStart), the model is written directly to state.ModelName — no hint\n// file needed. Otherwise falls back to StoreModelHint for cross-process\n// persistence (see its doc comment for the full rationale).\nfunc handleLifecycleModelUpdate(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"model-update\",\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tif event.SessionID == \"\" || event.Model == \"\" {\n\t\treturn nil\n\t}\n\n\t// Prefer writing directly to session state when it exists\n\tstate, loadErr := strategy.LoadSessionState(ctx, event.SessionID)\n\tif loadErr != nil {\n\t\tlogging.Debug(logCtx, \"could not load session state for model update, using hint file\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t}\n\tif loadErr == nil && state != nil {\n\t\tstate.ModelName = event.Model\n\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to update session state with model\",\n\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t}\n\t\treturn nil\n\t}\n\n\t// State doesn't exist yet (or failed to load) — use hint file (see StoreModelHint doc)\n\tif err := strategy.StoreModelHint(ctx, event.SessionID, event.Model); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to store model hint\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleTurnStart handles turn start: captures pre-prompt state,\n// ensures strategy setup, initializes session.\nfunc handleLifecycleTurnStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"turn-start\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"session_ref\", event.SessionRef),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tsessionID := event.SessionID\n\tif sessionID == \"\" {\n\t\treturn fmt.Errorf(\"no session_id in %s event\", event.Type)\n\t}\n\tif err := validation.ValidateSessionID(sessionID); err != nil {\n\t\treturn fmt.Errorf(\"invalid %s event: %w\", event.Type, err)\n\t}\n\n\t// Fill model from hint file if the agent didn't provide it on this hook\n\tif event.Model == \"\" {\n\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n\t\t\tevent.Model = hint\n\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n\t\t\t\tslog.String(\"model\", hint))\n\t\t}\n\t}\n\n\t// Capture pre-prompt state (including transcript position via TranscriptAnalyzer)\n\t_, captureSpan := perf.Start(ctx, \"capture_pre_prompt_state\")\n\tif err := CapturePrePromptState(ctx, ag, sessionID, event.SessionRef); err != nil {\n\t\tcaptureSpan.RecordError(err)\n\t\tcaptureSpan.End()\n\t\treturn err\n\t}\n\tcaptureSpan.End()\n\n\t// Append prompt to prompt.txt on filesystem so it's available for\n\t// mid-turn commits (before SaveStep writes it to the shadow branch).\n\t// Prompts are separated by \"\\n\\n---\\n\\n\" to support multiple turns.\n\tif event.Prompt != \"\" {\n\t\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n\t\tif sessionDirAbs, absErr := paths.AbsPath(ctx, sessionDir); absErr == nil {\n\t\t\tif mkErr := os.MkdirAll(sessionDirAbs, 0o750); mkErr == nil {\n\t\t\t\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n\t\t\t\texisting, readErr := os.ReadFile(promptPath) //nolint:gosec // session metadata path\n\t\t\t\tvar content string\n\t\t\t\tif readErr == nil && len(existing) > 0 {\n\t\t\t\t\tcontent = string(existing) + \"\\n\\n---\\n\\n\" + event.Prompt\n\t\t\t\t} else {\n\t\t\t\t\tcontent = event.Prompt\n\t\t\t\t}\n\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil { //nolint:gosec // path from internal metadata, not user input\n\t\t\t\t\tlogging.Warn(logCtx, \"failed to write prompt.txt\",\n\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\t// Ensure strategy setup and initialize session\n\t_, initSpan := perf.Start(ctx, \"init_session\")\n\tif err := strategy.EnsureSetup(ctx); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to ensure strategy setup\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\tstrat := GetStrategy(ctx)\n\tif err := strat.InitializeSession(ctx, sessionID, ag.Type(), event.SessionRef, event.Prompt, event.Model); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to initialize session state\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\t// Best-effort: adopt ENTIRE_REVIEW_* env vars set by `entire review` on\n\t// the spawned agent process. Each agent process has its own env, so there\n\t// is no file race across worktrees. Errors in load/save must not fail the turn.\n\tif state, loadErr := strategy.LoadSessionState(ctx, sessionID); loadErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for review env adoption\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t} else if state != nil {\n\t\tupdated := *state\n\t\tadoptReviewEnv(logCtx, &updated, string(ag.Name()))\n\t\tif updated.Kind != state.Kind || updated.ReviewPrompt != state.ReviewPrompt || !slices.Equal(updated.ReviewSkills, state.ReviewSkills) {\n\t\t\tif saveErr := strategy.SaveSessionState(ctx, &updated); saveErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to save session state after review env adoption\",\n\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t\t}\n\t\t}\n\t}\n\tinitSpan.End()\n\n\treturn nil\n}\n\n// handleLifecycleTurnEnd handles turn end: validates transcript, extracts metadata,\n// detects file changes, saves step + checkpoint, transitions phase.\n//\n//nolint:maintidx // high complexity due to sequential orchestration of 8 steps (validation, extraction, file detection, filtering, token calc, step save, phase transition, cleanup) - splitting would obscure the flow\nfunc handleLifecycleTurnEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"turn-end\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"session_ref\", event.SessionRef),\n\t\tslog.String(\"model\", event.Model),\n\t)\n\n\tsessionID := event.SessionID\n\tif sessionID == \"\" {\n\t\tsessionID = unknownSessionID\n\t}\n\n\t// Fill model from hint file if the agent didn't provide it on this hook\n\tif event.Model == \"\" && sessionID != unknownSessionID {\n\t\tif hint := strategy.LoadModelHint(ctx, sessionID); hint != \"\" {\n\t\t\tevent.Model = hint\n\t\t\tlogging.Debug(logCtx, \"loaded model from hint file\",\n\t\t\t\tslog.String(\"model\", hint))\n\t\t}\n\t}\n\n\ttranscriptRef := event.SessionRef\n\tif transcriptRef == \"\" {\n\t\treturn errors.New(\"transcript file not specified\")\n\t}\n\n\t// If agent implements TranscriptPreparer, materialize the transcript file.\n\t// This must run BEFORE fileExists: agents like OpenCode lazily fetch transcripts\n\t// via `opencode export`, so the file doesn't exist until PrepareTranscript creates it.\n\t// Claude Code's PrepareTranscript just flushes (always succeeds). Agents without\n\t// TranscriptPreparer (Gemini, Droid) are unaffected.\n\t_, prepareSpan := perf.Start(ctx, \"prepare_and_validate_transcript\")\n\tif preparer, ok := agent.AsTranscriptPreparer(ag); ok {\n\t\tif err := preparer.PrepareTranscript(ctx, transcriptRef); err != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to prepare transcript\",\n\t\t\t\tslog.String(\"error\", err.Error()))\n\t\t}\n\t}\n\n\tif !fileExists(transcriptRef) {\n\t\tprepareSpan.RecordError(fmt.Errorf(\"transcript file not found: %s\", transcriptRef))\n\t\tprepareSpan.End()\n\t\treturn fmt.Errorf(\"transcript file not found: %s\", transcriptRef)\n\t}\n\n\t// Early check: bail out quickly if the repo has no commits yet.\n\t// Return nil (not an error) so the hook exits 0 — agents treat non-zero\n\t// exit codes as hook failures. The user was already warned at session start.\n\tif repo, err := strategy.OpenRepository(ctx); err == nil && strategy.IsEmptyRepository(repo) {\n\t\tprepareSpan.End()\n\t\tlogging.Info(logCtx, \"skipping checkpoint - will activate after first commit\")\n\t\treturn nil\n\t}\n\tprepareSpan.End()\n\n\t// Create session metadata directory\n\t_, copySpan := perf.Start(ctx, \"copy_transcript\")\n\tsessionDir := paths.SessionMetadataDirFromSessionID(sessionID)\n\tsessionDirAbs, err := paths.AbsPath(ctx, sessionDir)\n\tif err != nil {\n\t\tsessionDirAbs = sessionDir\n\t}\n\tif err := os.MkdirAll(sessionDirAbs, 0o750); err != nil {\n\t\tcopySpan.RecordError(err)\n\t\tcopySpan.End()\n\t\treturn fmt.Errorf(\"failed to create session directory: %w\", err)\n\t}\n\n\t// Copy transcript to session directory\n\ttranscriptData, err := ag.ReadTranscript(transcriptRef)\n\tif err != nil {\n\t\tcopySpan.RecordError(err)\n\t\tcopySpan.End()\n\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\tlogFile := filepath.Join(sessionDirAbs, paths.TranscriptFileName)\n\tif err := os.WriteFile(logFile, transcriptData, 0o600); err != nil {\n\t\tcopySpan.RecordError(err)\n\t\tcopySpan.End()\n\t\treturn fmt.Errorf(\"failed to write transcript: %w\", err)\n\t}\n\tlogging.Debug(logCtx, \"copied transcript\",\n\t\tslog.String(\"path\", sessionDir+\"/\"+paths.TranscriptFileName))\n\tcopySpan.End()\n\n\t// Load pre-prompt state (captured on TurnStart)\n\t_, extractSpan := perf.Start(ctx, \"extract_metadata\")\n\tpreState, err := LoadPrePromptState(ctx, sessionID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load pre-prompt state\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\t// Determine transcript offset\n\ttranscriptOffset := resolveTranscriptOffset(ctx, preState, sessionID)\n\n\t// Backfill prompt.txt from transcript when prompt data is missing.\n\t// This handles agents whose exec mode doesn't fire UserPromptSubmit (e.g., Factory AI\n\t// Droid). The transcript is the source of truth — if ExtractPrompts returns nothing,\n\t// there genuinely were no prompts. We track whether backfill occurred so we can\n\t// update session state after SaveStep (which may reinitialize state).\n\tvar backfilledPrompt string\n\tpromptPath := filepath.Join(sessionDirAbs, paths.PromptFileName)\n\texistingPrompt, readPromptErr := os.ReadFile(promptPath) //nolint:gosec // file content is safe session metadata\n\tif readPromptErr != nil && !os.IsNotExist(readPromptErr) {\n\t\tlogging.Warn(logCtx, \"failed to read prompt.txt, skipping backfill\",\n\t\t\tslog.String(\"error\", readPromptErr.Error()))\n\t} else if len(existingPrompt) == 0 {\n\t\tif extractor, ok := agent.AsPromptExtractor(ag); ok {\n\t\t\tprompts, extractErr := extractor.ExtractPrompts(transcriptRef, transcriptOffset)\n\t\t\tif extractErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to extract prompts from transcript\",\n\t\t\t\t\tslog.String(\"error\", extractErr.Error()))\n\t\t\t} else if len(prompts) > 0 {\n\t\t\t\tcontent := strings.Join(prompts, \"\\n\\n---\\n\\n\")\n\t\t\t\tif writeErr := os.WriteFile(promptPath, []byte(content), 0o600); writeErr != nil {\n\t\t\t\t\tlogging.Warn(logCtx, \"failed to backfill prompt.txt from transcript\",\n\t\t\t\t\t\tslog.String(\"error\", writeErr.Error()))\n\t\t\t\t} else {\n\t\t\t\t\tlogging.Debug(logCtx, \"backfilled prompt.txt from transcript\",\n\t\t\t\t\t\tslog.Int(\"prompt_count\", len(prompts)))\n\t\t\t\t\tbackfilledPrompt = prompts[len(prompts)-1]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\t// Compute subagents directory for agents that support subagent extraction.\n\t// Subagent transcripts live in <transcriptDir>/<modelSessionID>/subagents/\n\tsubagentsDir := filepath.Join(filepath.Dir(transcriptRef), event.SessionID, \"subagents\")\n\n\t// Extract metadata via agent interface (modified files)\n\tvar modifiedFiles []string\n\n\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n\t\t// Extract modified files - prefer SubagentAwareExtractor if available to include subagent files\n\t\tif subagentExtractor, subOk := agent.AsSubagentAwareExtractor(ag); subOk {\n\t\t\tif files, fileErr := subagentExtractor.ExtractAllModifiedFiles(transcriptData, transcriptOffset, subagentsDir); fileErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files (with subagents)\",\n\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n\t\t\t} else {\n\t\t\t\tmodifiedFiles = files\n\t\t\t}\n\t\t} else {\n\t\t\t// Fall back to basic extraction (main transcript only)\n\t\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptRef, transcriptOffset); fileErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to extract modified files\",\n\t\t\t\t\tslog.String(\"error\", fileErr.Error()))\n\t\t\t} else {\n\t\t\t\tmodifiedFiles = files\n\t\t\t}\n\t\t}\n\t}\n\textractSpan.End()\n\n\t// Generate commit message from last prompt (read from session state, set at TurnStart).\n\t// In exec mode, session state LastPrompt may be empty because UserPromptSubmit never fires.\n\t// Fall back to backfilledPrompt extracted from the transcript.\n\t// Single load serves both prompt retrieval and backfill.\n\t_, commitMsgSpan := perf.Start(ctx, \"generate_commit_message\")\n\tlastPrompt := \"\"\n\tif sessionState, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && sessionState != nil {\n\t\tlastPrompt = sessionState.LastPrompt\n\t\t// Backfill LastPrompt so `entire status` shows the prompt even when\n\t\t// no files were modified (before the early return below).\n\t\tif lastPrompt == \"\" && backfilledPrompt != \"\" {\n\t\t\tlastPrompt = backfilledPrompt\n\t\t\tsessionState.LastPrompt = backfilledPrompt\n\t\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t\t}\n\t\t}\n\t} else if backfilledPrompt != \"\" {\n\t\tlastPrompt = backfilledPrompt\n\t}\n\tcommitMessage := generateCommitMessage(lastPrompt, ag.Type())\n\tlogging.Debug(logCtx, \"using commit message\",\n\t\tslog.Int(\"message_length\", len(commitMessage)))\n\tcommitMsgSpan.End()\n\n\t// Get worktree root for path normalization\n\t_, detectSpan := perf.Start(ctx, \"detect_file_changes\")\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\tdetectSpan.RecordError(err)\n\t\tdetectSpan.End()\n\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n\t}\n\n\tvar preUntrackedFiles []string\n\tif preState != nil {\n\t\tlogging.Debug(logCtx, \"pre-prompt state\",\n\t\t\tslog.Int(\"pre_existing_untracked_files\", len(preState.UntrackedFiles)))\n\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n\t}\n\n\t// Detect file changes via git status\n\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\tdetectSpan.End()\n\n\t// Filter and normalize all paths\n\t_, normalizeSpan := perf.Start(ctx, \"filter_and_normalize_paths\")\n\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n\tvar relNewFiles, relDeletedFiles []string\n\tif changes != nil {\n\t\trelNewFiles = FilterAndNormalizePaths(changes.New, repoRoot)\n\t\trelDeletedFiles = FilterAndNormalizePaths(changes.Deleted, repoRoot)\n\n\t\t// Merge git-status modified files as a fallback for transcript parsing.\n\t\t// Transcript parsing is the primary source for modified files, but it can miss\n\t\t// files if the agent uses an unrecognized tool or the transcript format changes.\n\t\t// Git status catches any tracked file with working-tree changes.\n\t\trelModifiedFiles = mergeUnique(relModifiedFiles, FilterAndNormalizePaths(changes.Modified, repoRoot))\n\t}\n\n\t// Filter transcript-extracted files to exclude files already committed to HEAD.\n\t// When an agent commits files mid-turn, those files are condensed by PostCommit\n\t// and should not be re-added to FilesTouched by SaveStep. A file is \"committed\"\n\t// if it exists in HEAD with the same content as the working tree.\n\trelModifiedFiles = filterToUncommittedFiles(ctx, relModifiedFiles, repoRoot)\n\tnormalizeSpan.End()\n\n\t// Check if there are any changes\n\ttotalChanges := len(relModifiedFiles) + len(relNewFiles) + len(relDeletedFiles)\n\tif totalChanges == 0 {\n\t\tlogging.Info(logCtx, \"no files modified during session, skipping checkpoint\")\n\t\ttransitionSessionTurnEnd(ctx, sessionID, event)\n\t\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n\t\t\t\tslog.String(\"error\", cleanupErr.Error()))\n\t\t}\n\t\treturn nil\n\t}\n\n\t// Log file changes\n\tlogFileChanges(ctx, relModifiedFiles, relNewFiles, relDeletedFiles)\n\n\t// Get git author\n\tauthor, err := GetGitAuthor(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n\t}\n\n\t// Get strategy and agent type\n\tstrat := GetStrategy(ctx)\n\tagentType := ag.Type()\n\n\t// Get transcript position/identifier from pre-prompt state\n\tvar transcriptIdentifierAtStart string\n\tvar transcriptLinesAtStart int\n\tif preState != nil {\n\t\ttranscriptIdentifierAtStart = preState.LastTranscriptIdentifier\n\t\ttranscriptLinesAtStart = preState.TranscriptOffset\n\t}\n\n\t// Calculate token usage - prefer SubagentAwareExtractor to include subagent tokens\n\ttokenUsage := agent.CalculateTokenUsage(ctx, ag, transcriptData, transcriptLinesAtStart, subagentsDir)\n\n\t// Build fully-populated step context and delegate to strategy\n\tstepCtx := strategy.StepContext{\n\t\tSessionID:                sessionID,\n\t\tModifiedFiles:            relModifiedFiles,\n\t\tNewFiles:                 relNewFiles,\n\t\tDeletedFiles:             relDeletedFiles,\n\t\tMetadataDir:              sessionDir,\n\t\tMetadataDirAbs:           sessionDirAbs,\n\t\tCommitMessage:            commitMessage,\n\t\tTranscriptPath:           transcriptRef,\n\t\tAuthorName:               author.Name,\n\t\tAuthorEmail:              author.Email,\n\t\tAgentType:                agentType,\n\t\tStepTranscriptIdentifier: transcriptIdentifierAtStart,\n\t\tStepTranscriptStart:      transcriptLinesAtStart,\n\t\tTokenUsage:               tokenUsage,\n\t}\n\n\tif err := strat.SaveStep(ctx, stepCtx); err != nil {\n\t\treturn fmt.Errorf(\"failed to save step: %w\", err)\n\t}\n\n\t// Update session state with backfilled prompt after SaveStep.\n\t// Done after SaveStep because SaveStep may reinitialize session state,\n\t// which would overwrite an earlier LastPrompt update.\n\tif backfilledPrompt != \"\" {\n\t\tif state, stateErr := strategy.LoadSessionState(ctx, sessionID); stateErr == nil && state != nil && state.LastPrompt == \"\" {\n\t\t\tstate.LastPrompt = backfilledPrompt\n\t\t\tif saveErr := strategy.SaveSessionState(ctx, state); saveErr != nil {\n\t\t\t\tlogging.Warn(logCtx, \"failed to backfill LastPrompt in session state\",\n\t\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t\t}\n\t\t}\n\t}\n\n\t// Transition session phase and cleanup\n\ttransitionSessionTurnEnd(ctx, sessionID, event)\n\tif cleanupErr := CleanupPrePromptState(ctx, sessionID); cleanupErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to cleanup pre-prompt state\",\n\t\t\tslog.String(\"error\", cleanupErr.Error()))\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleCompaction handles context compaction: saves current progress\n// but stays in ACTIVE phase (unlike TurnEnd which transitions to IDLE).\n// Also resets the transcript offset since the transcript may be truncated.\nfunc handleLifecycleCompaction(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"compaction\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t)\n\n\t// Fire EventCompaction to trigger ActionCondenseIfFilesTouched (stays in ACTIVE)\n\tsessionID := event.SessionID\n\tsessionState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n\tif loadErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for compaction\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t}\n\tif sessionState != nil {\n\t\tpersistEventMetadataToState(event, sessionState)\n\n\t\tif transErr := strategy.TransitionAndLog(ctx, sessionState, session.EventCompaction, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n\t\t\tlogging.Warn(logCtx, \"compaction transition failed\",\n\t\t\t\tslog.String(\"error\", transErr.Error()))\n\t\t}\n\n\t\tif saveErr := strategy.SaveSessionState(ctx, sessionState); saveErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to save session state after compaction\",\n\t\t\t\tslog.String(\"error\", saveErr.Error()))\n\t\t}\n\t}\n\n\tlogging.Info(logCtx, \"context compaction detected\")\n\treturn nil\n}\n\n// handleLifecycleSessionEnd handles session end: marks the session as ended.\nfunc handleLifecycleSessionEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"session-end\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t)\n\n\tif event.SessionID == \"\" {\n\t\treturn nil // No session to update\n\t}\n\n\t// Note: We intentionally don't clean up cached transcripts here.\n\t// Post-session commits (carry-forward in ENDED phase) may still need\n\t// the transcript to extract file changes. Cleanup is handled by\n\t// `entire clean` or when the session state is fully removed.\n\n\tif err := markSessionEnded(ctx, event, event.SessionID); err != nil {\n\t\tlogging.Warn(logCtx, \"failed to mark session ended\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t\t// Don't attempt eager condense if we couldn't even mark the session ended —\n\t\t// the session state may be in an inconsistent state.\n\t\treturn nil\n\t}\n\n\t// Eagerly condense session data so PostCommit doesn't have to process it.\n\t// This prevents zombie ENDED sessions from accumulating and causing O(N)\n\t// overhead on every future commit (GitHub issue #591).\n\t// Fail-open: if this fails, PostCommit will still process it on the next commit.\n\tstrat := GetStrategy(ctx)\n\tif err := strat.CondenseAndMarkFullyCondensed(ctx, event.SessionID); err != nil {\n\t\tlogging.Warn(logCtx, \"eager condense on session stop failed\",\n\t\t\tslog.String(\"session_id\", event.SessionID),\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleSubagentStart handles subagent start: captures pre-task state.\nfunc handleLifecycleSubagentStart(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tlogging.Info(logCtx, \"subagent started\",\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n\t\tslog.String(\"transcript\", event.SessionRef),\n\t)\n\n\t// Capture pre-task state\n\tif err := CapturePreTaskState(ctx, event.ToolUseID); err != nil {\n\t\treturn fmt.Errorf(\"failed to capture pre-task state: %w\", err)\n\t}\n\n\treturn nil\n}\n\n// handleLifecycleSubagentEnd handles subagent end: detects changes, saves task checkpoint.\nfunc handleLifecycleSubagentEnd(ctx context.Context, ag agent.Agent, event *agent.Event) error {\n\tlogCtx := logging.WithAgent(logging.WithComponent(ctx, \"lifecycle\"), ag.Name())\n\tif event.SubagentType == \"\" && event.TaskDescription == \"\" {\n\t\t// Extract subagent type and description from tool input\n\t\tevent.SubagentType, event.TaskDescription = ParseSubagentTypeAndDescription(event.ToolInput)\n\t}\n\n\t// Determine subagent transcript path\n\ttranscriptDir := filepath.Dir(event.SessionRef)\n\tvar subagentTranscriptPath string\n\tif event.SubagentID != \"\" {\n\t\tsubagentTranscriptPath = AgentTranscriptPath(transcriptDir, event.SubagentID)\n\t\tif !fileExists(subagentTranscriptPath) {\n\t\t\tsubagentTranscriptPath = \"\"\n\t\t}\n\t}\n\n\t// Log context\n\tsubagentEndAttrs := []any{\n\t\tslog.String(\"event\", event.Type.String()),\n\t\tslog.String(\"session_id\", event.SessionID),\n\t\tslog.String(\"tool_use_id\", event.ToolUseID),\n\t}\n\tif event.SubagentID != \"\" {\n\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"agent_id\", event.SubagentID))\n\t}\n\tif subagentTranscriptPath != \"\" {\n\t\tsubagentEndAttrs = append(subagentEndAttrs, slog.String(\"subagent_transcript\", subagentTranscriptPath))\n\t}\n\tlogging.Info(logCtx, \"subagent completed\", subagentEndAttrs...)\n\n\t// Extract modified files from hook payload and/or subagent transcript\n\tvar modifiedFiles []string\n\tmodifiedFiles = append(modifiedFiles, event.ModifiedFiles...)\n\tif analyzer, ok := agent.AsTranscriptAnalyzer(ag); ok {\n\t\ttranscriptToScan := event.SessionRef\n\t\tif subagentTranscriptPath != \"\" {\n\t\t\ttranscriptToScan = subagentTranscriptPath\n\t\t}\n\t\tif files, _, fileErr := analyzer.ExtractModifiedFilesFromOffset(transcriptToScan, 0); fileErr != nil {\n\t\t\tlogging.Warn(logCtx, \"failed to extract modified files from subagent\",\n\t\t\t\tslog.String(\"error\", fileErr.Error()))\n\t\t} else {\n\t\t\tmodifiedFiles = mergeUnique(modifiedFiles, files)\n\t\t}\n\t}\n\n\t// Load pre-task state and detect file changes.\n\t// If no pre-task state exists (agent doesn't support pre-task hook), fall back\n\t// to the session's pre-prompt state. Without either, DetectFileChanges receives\n\t// nil and treats ALL untracked files as new — which would create spurious task\n\t// checkpoints for pre-existing untracked files (e.g., .github/hooks/entire.json).\n\tpreState, err := LoadPreTaskState(ctx, event.ToolUseID)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to load pre-task state\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\tvar preUntrackedFiles []string\n\tif preState != nil {\n\t\tpreUntrackedFiles = preState.PreUntrackedFiles()\n\t}\n\tchanges, err := DetectFileChanges(ctx, preUntrackedFiles)\n\tif err != nil {\n\t\tlogging.Warn(logCtx, \"failed to compute file changes\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\t// Get worktree root and normalize paths\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get worktree root: %w\", err)\n\t}\n\n\trelModifiedFiles := FilterAndNormalizePaths(modifiedFiles, repoRoot)\n\tvar relNewFiles, relDeletedFiles []string\n\tif changes != nil {\n\t\trelNewFiles = FilterAndNormalizePaths(changes.New, repoRoot)\n\t\trelDeletedFiles = FilterAndNormalizePaths(changes.Deleted, repoRoot)\n\t\trelModifiedFiles = mergeUnique(relModifiedFiles, FilterAndNormalizePaths(changes.Modified, repoRoot))\n\t}\n\n\t// If no changes, skip\n\tif len(relModifiedFiles) == 0 && len(relNewFiles) == 0 && len(relDeletedFiles) == 0 {\n\t\tlogging.Info(logCtx, \"no file changes detected, skipping task checkpoint\")\n\t\t_ = CleanupPreTaskState(ctx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\t\treturn nil\n\t}\n\n\t// Find checkpoint UUID from main transcript (best-effort)\n\tvar checkpointUUID string\n\t// Use the existing CLI-level checkpoint UUID finder\n\tmainLines, _ := parseTranscriptForCheckpointUUID(event.SessionRef) //nolint:errcheck // best-effort\n\tif mainLines != nil {\n\t\tcheckpointUUID, _ = FindCheckpointUUID(mainLines, event.ToolUseID)\n\t}\n\n\t// Get git author\n\tauthor, err := GetGitAuthor(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n\t}\n\n\t// Build task checkpoint context\n\tstrat := GetStrategy(ctx)\n\tagentType := ag.Type()\n\n\ttaskStepCtx := strategy.TaskStepContext{\n\t\tSessionID:              event.SessionID,\n\t\tToolUseID:              event.ToolUseID,\n\t\tAgentID:                event.SubagentID,\n\t\tModifiedFiles:          relModifiedFiles,\n\t\tNewFiles:               relNewFiles,\n\t\tDeletedFiles:           relDeletedFiles,\n\t\tTranscriptPath:         event.SessionRef,\n\t\tSubagentTranscriptPath: subagentTranscriptPath,\n\t\tCheckpointUUID:         checkpointUUID,\n\t\tAuthorName:             author.Name,\n\t\tAuthorEmail:            author.Email,\n\t\tSubagentType:           event.SubagentType,\n\t\tTaskDescription:        event.TaskDescription,\n\t\tAgentType:              agentType,\n\t}\n\n\tif err := strat.SaveTaskStep(ctx, taskStepCtx); err != nil {\n\t\treturn fmt.Errorf(\"failed to save task step: %w\", err)\n\t}\n\n\t_ = CleanupPreTaskState(ctx, event.ToolUseID) //nolint:errcheck // best-effort cleanup\n\treturn nil\n}\n\n// --- Helper functions ---\n\n// resolveTranscriptOffset determines the transcript offset to use for parsing.\n// Prefers pre-prompt state, falls back to session state.\nfunc resolveTranscriptOffset(ctx context.Context, preState *PrePromptState, sessionID string) int {\n\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n\tif preState != nil && preState.TranscriptOffset > 0 {\n\t\tlogging.Debug(logCtx, \"pre-prompt state found, parsing transcript from offset\",\n\t\t\tslog.Int(\"offset\", preState.TranscriptOffset))\n\t\treturn preState.TranscriptOffset\n\t}\n\n\t// Fall back to session state\n\tsessionState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n\tif loadErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t\treturn 0\n\t}\n\tif sessionState != nil && sessionState.CheckpointTranscriptStart > 0 {\n\t\tlogging.Debug(logCtx, \"session state found, parsing transcript from offset\",\n\t\t\tslog.Int(\"offset\", sessionState.CheckpointTranscriptStart))\n\t\treturn sessionState.CheckpointTranscriptStart\n\t}\n\n\treturn 0\n}\n\n// parseTranscriptForCheckpointUUID is a thin wrapper around transcript parsing for checkpoint UUID lookup.\n// Returns parsed transcript lines for use with FindCheckpointUUID.\nfunc parseTranscriptForCheckpointUUID(transcriptPath string) ([]transcriptLine, error) {\n\tlines, err := transcript.ParseFromFileAtLine(transcriptPath, 0)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"parsing transcript for checkpoint UUID: %w\", err)\n\t}\n\treturn lines, nil\n}\n\n// transitionSessionTurnEnd transitions the session phase to IDLE and dispatches turn-end actions.\nfunc transitionSessionTurnEnd(ctx context.Context, sessionID string, event *agent.Event) {\n\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n\tturnState, loadErr := strategy.LoadSessionState(ctx, sessionID)\n\tif loadErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to load session state for turn end\",\n\t\t\tslog.String(\"error\", loadErr.Error()))\n\t\treturn\n\t}\n\tif turnState == nil {\n\t\treturn\n\t}\n\n\tpersistEventMetadataToState(event, turnState)\n\n\tif err := strategy.TransitionAndLog(ctx, turnState, session.EventTurnEnd, session.TransitionContext{}, session.NoOpActionHandler{}); err != nil {\n\t\tlogging.Warn(logCtx, \"turn-end transition failed\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\t// Always dispatch to strategy for turn-end handling. The strategy reads\n\t// work items from state (e.g. TurnCheckpointIDs), not the action list.\n\tstrat := GetStrategy(ctx)\n\tif err := strat.HandleTurnEnd(ctx, turnState); err != nil {\n\t\tlogging.Warn(logCtx, \"turn-end action dispatch failed\",\n\t\t\tslog.String(\"error\", err.Error()))\n\t}\n\n\tif updateErr := strategy.SaveSessionState(ctx, turnState); updateErr != nil {\n\t\tlogging.Warn(logCtx, \"failed to update session phase on turn end\",\n\t\t\tslog.String(\"error\", updateErr.Error()))\n\t}\n}\n\n// markSessionEnded transitions the session to ENDED phase via the state machine.\n// If event is non-nil, hook-provided metrics are persisted to state before saving.\nfunc markSessionEnded(ctx context.Context, event *agent.Event, sessionID string) error {\n\tstate, err := strategy.LoadSessionState(ctx, sessionID)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to load session state: %w\", err)\n\t}\n\tif state == nil {\n\t\treturn nil // No state file, nothing to update\n\t}\n\n\tif event != nil {\n\t\tpersistEventMetadataToState(event, state)\n\t}\n\n\tif transErr := strategy.TransitionAndLog(ctx, state, session.EventSessionStop, session.TransitionContext{}, session.NoOpActionHandler{}); transErr != nil {\n\t\tlogging.Warn(logging.WithComponent(ctx, \"lifecycle\"), \"session stop transition failed\",\n\t\t\tslog.String(\"error\", transErr.Error()))\n\t}\n\n\tnow := time.Now()\n\tstate.EndedAt = &now\n\n\tif err := strategy.SaveSessionState(ctx, state); err != nil {\n\t\treturn fmt.Errorf(\"failed to save session state: %w\", err)\n\t}\n\treturn nil\n}\n\n// logFileChanges logs the files modified, created, and deleted during a session.\nfunc logFileChanges(ctx context.Context, modified, newFiles, deleted []string) {\n\tlogCtx := logging.WithComponent(ctx, \"lifecycle\")\n\tlogging.Debug(logCtx, \"files changed during session\",\n\t\tslog.Int(\"modified\", len(modified)),\n\t\tslog.Int(\"new\", len(newFiles)),\n\t\tslog.Int(\"deleted\", len(deleted)))\n}\n\nfunc persistEventMetadataToState(event *agent.Event, state *strategy.SessionState) {\n\t// Update ModelName if provided (model is known by turn-end even on first turn)\n\tif event.Model != \"\" {\n\t\tstate.ModelName = event.Model\n\t}\n\n\t// Persist hook-provided session metrics (e.g., from Cursor hooks)\n\tif event.DurationMs > 0 {\n\t\tstate.SessionDurationMs = event.DurationMs\n\t}\n\t// Use hook-reported turn count if available (take max); otherwise\n\t// increment on each TurnEnd event to count turns ourselves.\n\tif event.TurnCount > 0 {\n\t\tif event.TurnCount > state.SessionTurnCount {\n\t\t\tstate.SessionTurnCount = event.TurnCount\n\t\t}\n\t} else if event.Type == agent.TurnEnd {\n\t\tstate.SessionTurnCount++\n\t}\n\tif event.ContextTokens > 0 {\n\t\tstate.ContextTokens = event.ContextTokens\n\t}\n\tif event.ContextWindowSize > 0 {\n\t\tstate.ContextWindowSize = event.ContextWindowSize\n\t}\n}\n\n// adoptReviewEnv tags the session as a review session when ENTIRE_REVIEW_*\n// env vars are present on the current process. `entire review` sets these\n// vars on the spawned agent process; the lifecycle hook (a child of the agent)\n// inherits them naturally. Agent and starting-SHA checks protect against stale\n// ENTIRE_REVIEW_* values inherited from a parent shell or a nested invocation.\n//\n// Adoption is idempotent: if state.Kind is already set (subsequent turns of\n// a review session) the function returns without modifying state.\n//\n// Failure modes are silent at the user level but logged for diagnostics:\n//   - EnvSession unset or not \"1\": not a review session; return, no tagging.\n//   - EnvAgent does not match the hook agent: leave session untagged.\n//   - EnvStartingSHA does not match the session base commit: leave untagged.\n//   - EnvSkills malformed JSON: log warning, leave session untagged to avoid\n//     corrupting metadata with junk data.\nfunc adoptReviewEnv(ctx context.Context, state *session.State, expectedAgent string) {\n\t// Already tagged — don't re-apply on subsequent turns.\n\tif state.Kind != \"\" {\n\t\treturn\n\t}\n\tif os.Getenv(review.EnvSession) != \"1\" {\n\t\treturn\n\t}\n\tenvAgent := os.Getenv(review.EnvAgent)\n\tif envAgent != expectedAgent {\n\t\tlogging.Warn(ctx, \"review env adoption skipped: agent mismatch\",\n\t\t\tslog.String(\"env_agent\", envAgent),\n\t\t\tslog.String(\"hook_agent\", expectedAgent))\n\t\treturn\n\t}\n\tstartingSHA := os.Getenv(review.EnvStartingSHA)\n\tif startingSHA == \"\" || state.BaseCommit == \"\" || startingSHA != state.BaseCommit {\n\t\tlogging.Warn(ctx, \"review env adoption skipped: starting SHA mismatch\",\n\t\t\tslog.String(\"env_starting_sha\", startingSHA),\n\t\t\tslog.String(\"state_base_commit\", state.BaseCommit))\n\t\treturn\n\t}\n\tskills, err := review.DecodeSkills(os.Getenv(review.EnvSkills))\n\tif err != nil {\n\t\tlogging.Warn(ctx, \"review env adoption failed: invalid skills JSON\",\n\t\t\tslog.String(\"err\", err.Error()))\n\t\treturn\n\t}\n\tstate.Kind = session.KindAgentReview\n\tstate.ReviewSkills = skills\n\tstate.ReviewPrompt = os.Getenv(review.EnvPrompt)\n\tlogging.Debug(ctx, \"adopted review env\",\n\t\tslog.String(\"agent\", envAgent),\n\t\tslog.Int(\"skill_count\", len(skills)))\n}\n","numLines":1019,"startLine":1,"totalLines":1019}},"sourceToolAssistantUUID":"9b576222-ad80-4f44-9679-9b98153845b6","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"d8167230-6b75-41a9-879d-79e6d5be291c","version":"2.1.129","gitBranch":"feat/entire-review-v2-a1"}
