tring\n   151→\tResponses []string // Multiple responses can occur between tool calls\n   152→\tFiles     []string\n   153→}\n   154→\n   155→// ExtractAllPromptResponses extracts all user prompt and assistant response pairs from a transcript.\n   156→// Returns pairs in chronological order (oldest first).\n   157→// Each pair contains the user's prompt, assistant's text response, and files modified.\n   158→func ExtractAllPromptResponses(transcript []transcriptLine) []PromptResponsePair {\n   159→\tvar pairs []PromptResponsePair\n   160→\n   161→\t// Find all user prompts (messages with string content, not tool results)\n   162→\tvar userIndices []int\n   163→\tfor i, line := range transcript {\n   164→\t\tif line.Type == transcriptTypeUser {\n   165→\t\t\tvar msg userMessage\n   166→\t\t\tif err := json.Unmarshal(line.Message, &msg); err != nil {\n   167→\t\t\t\tcontinue\n   168→\t\t\t}\n   169→\t\t\t// Only count messages with string content (real user prompts)\n   170→\t\t\tif _, ok := msg.Content.(string); ok {\n   171→\t\t\t\tuserIndices = append(userIndices, i)\n   172→\t\t\t} else if arr, ok := msg.Content.([]interface{}); ok {\n   173→\t\t\t\t// Check if array has text blocks (also a real user prompt)\n   174→\t\t\t\tfor _, item := range arr {\n   175→\t\t\t\t\tif m, ok := item.(map[string]interface{}); ok {\n   176→\t\t\t\t\t\tif m[\"type\"] == contentTypeText {\n   177→\t\t\t\t\t\t\tuserIndices = append(userIndices, i)\n   178→\t\t\t\t\t\t\tbreak\n   179→\t\t\t\t\t\t}\n   180→\t\t\t\t\t}\n   181→\t\t\t\t}\n   182→\t\t\t}\n   183→\t\t}\n   184→\t}\n   185→\n   186→\t// For each user prompt, extract the prompt text, following assistant response, and files\n   187→\tfor idx, userIdx := range userIndices {\n   188→\t\t// Determine the range for this prompt's conversation\n   189→\t\tendIdx := len(transcript)\n   190→\t\tif idx < len(userIndices)-1 {\n   191→\t\t\tendIdx = userIndices[idx+1]\n   192→\t\t}\n   193→\n   194→\t\t// Extract prompt text\n   195→\t\tprompt := extractUserPromptAt(transcript, userIdx)\n   196→\t\tif prompt == \"\" {\n   197→\t\t\tcontinue\n   198→\t\t}\n   199→\n   200→\t\t// Extract assistant responses and files from this range\n   201→\t\tslice := transcript[userIdx:endIdx]\n   202→\t\tresponses := extractAssistantResponses(slice)\n   203→\t\tfiles := extractModifiedFiles(slice)\n   204→\n   205→\t\tpairs = append(pairs, PromptResponsePair{\n   206→\t\t\tPrompt:    prompt,\n   207→\t\t\tResponses: responses,\n   208→\t\t\tFiles:     files,\n   209→\t\t})\n   210→\t}\n   211→\n   212→\treturn pairs\n   213→}\n   214→\n   215→// extractUserPromptAt extracts the user prompt at the given index.\n   216→// IDE-injected context tags (like <ide_opened_file>) are stripped from the result.\n   217→func extractUserPromptAt(transcript []transcriptLine, idx int) string {\n   218→\tif idx >= len(transcript) || transcript[idx].Type != transcriptTypeUser {\n   219→\t\treturn \"\"\n   220→\t}\n   221→\n   222→\tvar msg userMessage\n   223→\tif err := json.Unmarshal(transcript[idx].Message, &msg); err != nil {\n   224→\t\treturn \"\"\n   225→\t}\n   226→\n   227→\t// Handle string content\n   228→\tif str, ok := msg.Content.(string); ok {\n   229→\t\treturn textutil.StripIDEContextTags(str)\n   230→\t}\n   231→\n   232→\t// Handle array content (only if it contains text blocks)\n   233→\tif arr, ok := msg.Content.([]interface{}); ok {\n   234→\t\tvar texts []string\n   235→\t\tfor _, item := range arr {\n   236→\t\t\tif m, ok := item.(map[string]interface{}); ok {\n   237→\t\t\t\tif m[\"type\"] == contentTypeText {\n   238→\t\t\t\t\tif text, ok := m[\"text\"].(string); ok {\n   239→\t\t\t\t\t\ttexts = append(texts, text)\n   240→\t\t\t\t\t}\n   241→\t\t\t\t}\n   242→\t\t\t}\n   243→\t\t}\n   244→\t\tif len(texts) > 0 {\n   245→\t\t\treturn textutil.StripIDEContextTags(strings.Join(texts, \"\\n\\n\"))\n   246→\t\t}\n   247→\t}\n   248→\n   249→\treturn \"\"\n   250→}\n   251→\n   252→// extractAssistantResponse