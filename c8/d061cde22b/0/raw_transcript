48→\tTimestamp time.Time\n    49→\n    50→\t// IsTaskCheckpoint indicates if this is a task checkpoint (vs a session checkpoint)\n    51→\tIsTaskCheckpoint bool\n    52→\n    53→\t// ToolUseID is the tool use ID for task checkpoints (empty for session checkpoints)\n    54→\tToolUseID string\n    55→}\n    56→\n    57→// PromptResponse represents a single user prompt and assistant response pair.\n    58→type PromptResponse struct {\n    59→\t// Prompt is the user's message\n    60→\tPrompt string\n    61→\n    62→\t// Response is the assistant's response\n    63→\tResponse string\n    64→\n    65→\t// Files is the list of files modified during this prompt/response\n    66→\tFiles []string\n    67→}\n    68→\n    69→// CheckpointDetails contains detailed information extracted from a checkpoint's transcript.\n    70→// This is used by the explain command to display checkpoint content.\n    71→type CheckpointDetails struct {\n    72→\t// Interactions contains all prompt/response pairs in this checkpoint.\n    73→\t// For strategies like auto-commit/commit, this typically has one entry.\n    74→\t// For strategies like shadow, this may have multiple entries.\n    75→\tInteractions []PromptResponse\n    76→\n    77→\t// Files is the aggregate list of all files modified in this checkpoint.\n    78→\t// This is a convenience field that combines files from all interactions.\n    79→\tFiles []string\n    80→}\n    81→\n    82→// ListSessions returns all sessions from the entire/sessions branch,\n    83→// plus any additional sessions from strategies implementing SessionSource.\n    84→// It automatically discovers all registered strategies and merges their sessions.\n    85→func ListSessions() ([]Session, error) {\n    86→\trepo, err := OpenRepository()\n    87→\tif err != nil {\n    88→\t\treturn nil, fmt.Errorf(\"failed to open git repository: %w\", err)\n    89→\t}\n    90→\n    91→\t// Get checkpoints from the entire/sessions branch\n    92→\tcheckpoints, err := ListCheckpoints()\n    93→\tif err != nil {\n    94→\t\treturn nil, fmt.Errorf(\"failed to list checkpoints: %w\", err)\n    95→\t}\n    96→\n    97→\t// Group checkpoints by session ID\n    98→\t// For multi-session checkpoints, expand SessionIDs array so each session gets the checkpoint\n    99→\tsessionMap := make(map[string]*Session)\n   100→\tfor _, cp := range checkpoints {\n   101→\t\t// Determine which session IDs this checkpoint belongs to\n   102→\t\t// Multi-session checkpoints have SessionIDs populated; single-session use SessionID\n   103→\t\tsessionIDs := cp.SessionIDs\n   104→\t\tif len(sessionIDs) == 0 {\n   105→\t\t\tsessionIDs = []string{cp.SessionID}\n   106→\t\t}\n   107→\n   108→\t\tfor _, sessionID := range sessionIDs {\n   109→\t\t\tif sessionID == \"\" {\n   110→\t\t\t\tcontinue\n   111→\t\t\t}\n   112→\n   113→\t\t\tif existing, ok := sessionMap[sessionID]; ok {\n   114→\t\t\t\texisting.Checkpoints = append(existing.Checkpoints, Checkpoint{\n   115→\t\t\t\t\tCheckpointID:     cp.CheckpointID,\n   116→\t\t\t\t\tMessage:          \"Checkpoint: \" + cp.CheckpointID,\n   117→\t\t\t\t\tTimestamp:        cp.CreatedAt,\n   118→\t\t\t\t\tIsTaskCheckpoint: cp.IsTask,\n   119→\t\t\t\t\tToolUseID:        cp.ToolUseID,\n   120→\t\t\t\t})\n   121→\t\t\t} else {\n   122→\t\t\t\t// Get description from the checkpoint tree\n   123→\t\t\t\tdescription := getDescriptionForCheckpoint(repo, cp.CheckpointID)\n   124→\n   125→\t\t\t\tsessionMap[sessionID] = &Session{\n   126→\t\t\t\t\tID:          sessionID,\n   127→\t\t\t\t\tDescription: description,\n   128→\t\t\t\t\tStrategy:    \"\", // Will be set from metadata if available\n   129→\t\t\t\t\tStartTime:   cp.CreatedAt,\n   130→\t\t\t\t\tCheckpoints: []Checkpoint{{\n   131→\t\t\t\t\t\tCheckpointID:     cp.CheckpointID,\n   132→\t\t\t\t\t\tMessage:          \"Checkpoint: \" + cp.CheckpointID,\n   133→\t\t\t\t\t\tTimestamp:        cp.CreatedAt,\n   134→\t\t\t\t\t\tIsTaskCheckpoint: cp.IsTask,\n   135→\t\t\t\t\t\tToolUseI