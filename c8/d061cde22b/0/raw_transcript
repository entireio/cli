// When true, all working directory files are captured (not just modified)\n   114→\tIsFirstCheckpoint bool\n   115→}\n   116→\n   117→// ReadTemporaryResult contains the result of reading a temporary checkpoint.\n   118→type ReadTemporaryResult struct {\n   119→\t// CommitHash is the hash of the checkpoint commit\n   120→\tCommitHash plumbing.Hash\n   121→\n   122→\t// TreeHash is the hash of the tree containing the checkpoint state\n   123→\tTreeHash plumbing.Hash\n   124→\n   125→\t// SessionID is the session identifier from the commit trailer\n   126→\tSessionID string\n   127→\n   128→\t// MetadataDir is the metadata directory path from the commit trailer\n   129→\tMetadataDir string\n   130→\n   131→\t// Timestamp is when the checkpoint was created\n   132→\tTimestamp time.Time\n   133→}\n   134→\n   135→// TemporaryInfo contains summary information about a shadow branch.\n   136→type TemporaryInfo struct {\n   137→\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n   138→\tBranchName string\n   139→\n   140→\t// BaseCommit is the short commit hash this branch is based on\n   141→\tBaseCommit string\n   142→\n   143→\t// LatestCommit is the hash of the latest commit on the branch\n   144→\tLatestCommit plumbing.Hash\n   145→\n   146→\t// SessionID is the session identifier from the latest commit\n   147→\tSessionID string\n   148→\n   149→\t// Timestamp is when the latest checkpoint was created\n   150→\tTimestamp time.Time\n   151→}\n   152→\n   153→// WriteCommittedOptions contains options for writing a committed checkpoint.\n   154→type WriteCommittedOptions struct {\n   155→\t// CheckpointID is the stable 12-hex-char identifier\n   156→\tCheckpointID string\n   157→\n   158→\t// SessionID is the session identifier\n   159→\tSessionID string\n   160→\n   161→\t// Strategy is the name of the strategy that created this checkpoint\n   162→\tStrategy string\n   163→\n   164→\t// Transcript is the session transcript content (full.jsonl)\n   165→