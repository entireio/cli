handle arbitrarily long lines.\n    65→// Returns:\n    66→//   - lines: parsed transcript lines from startLine onwards (malformed lines skipped)\n    67→//   - totalLines: total number of lines in the file (including malformed ones)\n    68→//   - error: any error encountered during reading\n    69→//\n    70→// The startLine parameter is 0-indexed (startLine=0 reads from the beginning).\n    71→// This is useful for incremental parsing when you've already processed some lines.\n    72→func parseTranscriptFromLine(path string, startLine int) ([]transcriptLine, int, error) {\n    73→\tfile, err := os.Open(path) //nolint:gosec // path is a controlled transcript file path\n    74→\tif err != nil {\n    75→\t\treturn nil, 0, fmt.Errorf(\"failed to open transcript: %w\", err)\n    76→\t}\n    77→\tdefer func() { _ = file.Close() }()\n    78→\n    79→\tvar lines []transcriptLine\n    80→\treader := bufio.NewReader(file)\n    81→\n    82→\ttotalLines := 0\n    83→\tfor {\n    84→\t\tlineBytes, err := reader.ReadBytes('\\n')\n    85→\t\tif err != nil && err != io.EOF {\n    86→\t\t\treturn nil, 0, fmt.Errorf(\"failed to read transcript: %w\", err)\n    87→\t\t}\n    88→\n    89→\t\t// Handle empty line or EOF without content\n    90→\t\tif len(lineBytes) == 0 {\n    91→\t\t\tif err == io.EOF {\n    92→\t\t\t\tbreak\n    93→\t\t\t}\n    94→\t\t\tcontinue\n    95→\t\t}\n    96→\n    97→\t\t// Count all lines for totalLines, but only parse after startLine\n    98→\t\tif totalLines >= startLine {\n    99→\t\t\tvar line transcriptLine\n   100→\t\t\tif err := json.Unmarshal(lineBytes, &line); err == nil {\n   101→\t\t\t\tlines = append(lines, line)\n   102→\t\t\t}\n   103→\t\t}\n   104→\t\ttotalLines++\n   105→\n   106→\t\tif err == io.EOF {\n   107→\t\t\tbreak\n   108→\t\t}\n   109→\t}\n   110→\n   111→\treturn lines, totalLines, nil\n   112→}\n   113→\n   114→// parseTranscriptFromBytes parses transcript content from a byte slice.\n   115→// Uses bufio.Reader to handle arbitra