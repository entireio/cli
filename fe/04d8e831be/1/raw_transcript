// arrive, but the orchestrator's classifyStatus has access to\n   144\t\t\t// process-level signals (Wait error, ctx cancellation) that the\n   145\t\t\t// event stream never surfaces. Without this sync, an agent that\n   146\t\t\t// the orchestrator classified Cancelled (Ctrl+C path, no Finished\n   147\t\t\t// emitted) or Failed (process exit non-zero, no Finished emitted)\n   148\t\t\t// would still render as \"running\" in the final frame.\n   149\t\t\t//\n   150\t\t\t// Preserve any already-set status from the event stream — if the\n   151\t\t\t// stream said Failed (RunError), the summary may say Succeeded\n   152\t\t\t// (process exit 0); RunError stickiness wins. Only overwrite when\n   153\t\t\t// the row is still in AgentStatusUnknown.\n   154\t\t\tnow := time.Now()\n   155\t\t\tfor i, run := range msg.summary.AgentRuns {\n   156\t\t\t\tif i >= len(m.rows) {\n   157\t\t\t\t\tbreak\n   158\t\t\t\t}\n   159\t\t\t\tif m.rows[i].status == reviewtypes.AgentStatusUnknown {\n   160\t\t\t\t\tm.rows[i].status = run.Status\n   161\t\t\t\t}\n   162\t\t\t\tif m.rows[i].runEnd.IsZero() && !m.rows[i].runStart.IsZero() {\n   163\t\t\t\t\tm.rows[i].runEnd = now\n   164\t\t\t\t}\n   165\t\t\t}\n   166\t\t\treturn m, nil\n   167\t\n   168\t\tcase tickMsg:\n   169\t\t\tvar spinCmd tea.Cmd\n   170\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n   171\t\t\treturn m, tea.Batch(spinCmd, tickCmd())\n   172\t\n   173\t\tcase spinner.TickMsg:\n   174\t\t\tvar spinCmd tea.Cmd\n   175\t\t\tm.spinner, spinCmd = m.spinner.Update(msg)\n   176\t\t\treturn m, spinCmd\n   177\t\n   178\t\tcase tea.WindowSizeMsg:\n   179\t\t\tm.termWidth = msg.Width\n   180\t\t\tm.termHeight = msg.Height\n   181\t\t\tm.detail.SetWidth(m.detailViewportWidth())\n   182\t\t\tm.detail.SetHeight(m.detailViewportHeight())\n   183\t\t\tm = m.refreshDetailContent()\n   184\t\t\treturn m, nil\n   185\t\n   186\t\tcase tea.KeyPressMsg:\n   187\t\t\treturn m.handleKey(msg)\n   188\t\n   189\t\tcase tea.MouseWheelMs