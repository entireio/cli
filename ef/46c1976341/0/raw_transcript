\t\t// Use the lifecycle dispatcher for all hooks\n137\t\tvar hookErr error\n138\t\tag, agentErr := agent.Get(agentName)\n139\t\tif agentErr != nil {\n140\t\t\treturn fmt.Errorf(\"failed to get agent %q: %w\", agentName, agentErr)\n141\t\t}\n142\t\n143\t\thandler, ok := agent.AsHookSupport(ag)\n144\t\tif !ok {\n145\t\t\treturn fmt.Errorf(\"agent %q does not support hooks\", agentName)\n146\t\t}\n147\t\n148\t\t// Use cmd.InOrStdin() to support testing with cmd.SetIn()\n149\t\tevent, parseErr := handler.ParseHookEvent(ctx, hookName, cmd.InOrStdin())\n150\t\tif parseErr != nil {\n151\t\t\treturn fmt.Errorf(\"failed to parse hook event: %w\", parseErr)\n152\t\t}\n153\t\n154\t\tif event != nil {\n155\t\t\t// Lifecycle event — use the generic dispatcher\n156\t\t\thookErr = DispatchLifecycleEvent(ctx, ag, event)\n157\t\t} else if agentName == agent.AgentNameClaudeCode && hookName == claudecode.HookNamePostTodo {\n158\t\t\t// PostTodo is Claude-specific: creates incremental checkpoints during subagent execution\n159\t\t\thookErr = handleClaudeCodePostTodo(ctx)\n160\t\t}\n161\t\t// Other pass-through hooks (nil event, no special handling) are no-ops\n162\t\n163\t\tspan.RecordError(hookErr)\n164\t\treturn hookErr\n165\t}\n166\t\n167\t// newAgentHookVerbCmdWithLogging creates a command for a specific hook verb with structured logging.\n168\t// It uses the lifecycle dispatcher (ParseHookEvent → DispatchLifecycleEvent) as the primary path.\n169\t// PostTodo is handled directly as it's Claude-specific and not part of the lifecycle dispatcher.\n170\tfunc newAgentHookVerbCmdWithLogging(agentName types.AgentName, hookName string) *cobra.Command {\n171\t\treturn &cobra.Command{\n172\t\t\tUse:    hookName,\n173\t\t\tHidden: true,\n174\t\t\tShort:  \"Called on \" + hookName,\n175\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n176\t\t\t\treturn executeAgentHook(cmd, agentName, hookName, false)\n177\t\t\t},\n178\t\t}\n179\t}"},"type":"attachment","uuid":"6e60c674-8027-4059-bcc4