{"parentUuid":"914c7359-4fe6-4b82-b2c6-bf4b5aabcd83","isSidechain":false,"promptId":"7a016416-35a4-4f37-8708-810b63fa16de","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GHBGxR7pQrREfmafNoDvup","type":"tool_result","content":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// picker.go implements the interactive review skills picker and agent selection\n4\t// helpers. pickConfig presents a huh multi-select per installed agent and saves\n5\t// the selection to .entire/settings.json.\n6\tpackage review\n7\t\n8\timport (\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"io\"\n13\t\t\"log/slog\"\n14\t\t\"os\"\n15\t\t\"sort\"\n16\t\t\"strings\"\n17\t\n18\t\t\"charm.land/huh/v2\"\n19\t\n20\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n21\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/skilldiscovery\"\n22\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n23\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n24\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n25\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n26\t)\n27\t\n28\t// AgentChoice is one row in the spawn-time picker. Name is the agent\n29\t// registry key (used for marker/override); Label is the picker-visible\n30\t// string (\"<name>   (N skills configured)\" or \"<name>   (prompt-only)\").\n31\ttype AgentChoice struct {\n32\t\tName  string\n33\t\tLabel string\n34\t}\n35\t\n36\t// newAccessibleForm creates a huh form with accessibility mode enabled when\n37\t// the ACCESSIBLE env var is set. Mirrors cli.NewAccessibleForm without\n38\t// requiring an import of the cli package (which would be circular).\n39\tfunc newAccessibleForm(groups ...*huh.Group) *huh.Form {\n40\t\tform := huh.NewForm(groups...).WithTheme(huh.ThemeFunc(huh.ThemeDracula))\n41\t\tif os.Getenv(\"ACCESSIBLE\") != \"\" {\n42\t\t\tform = form.WithAccessible(true)\n43\t\t}\n44\t\treturn form\n45\t}\n46\t\n47\t// ConfirmFirstRunSetup prints a banner framing the picker as first-run\n48\t// setup (rather than the review itself) and waits for the user to confirm.\n49\t// Returns false if the user cancels; caller should bail gracefully.\n50\t//\n51\t// Signposting matters here because `entire review` with no config silently\n52\t// drops into the picker — users running the command to start a review can\n53\t// mistake the picker for the review. The banner + confirmation makes the\n54\t// setup phase explicit, and the trailing \"running review now\" line in the\n55\t// caller closes the loop on what comes next.\n56\tfunc ConfirmFirstRunSetup(ctx context.Context, out io.Writer) bool {\n57\t\tfmt.Fprintln(out, \"No review config found — let's set one up first.\")\n58\t\tfmt.Fprintln(out)\n59\t\tfmt.Fprintln(out, \"You'll pick skills for each installed agent. They're saved to\")\n60\t\tfmt.Fprintln(out, \".entire/settings.json; edit later with `entire review --edit`.\")\n61\t\tfmt.Fprintln(out, \"After setup, the review will run with your selection.\")\n62\t\tfmt.Fprintln(out)\n63\t\n64\t\tproceed := true\n65\t\tform := newAccessibleForm(huh.NewGroup(\n66\t\t\thuh.NewConfirm().\n67\t\t\t\tTitle(\"Set up review skills now?\").\n68\t\t\t\tAffirmative(\"Yes\").\n69\t\t\t\tNegative(\"Cancel\").\n70\t\t\t\tValue(&proceed),\n71\t\t))\n72\t\tif err := form.RunWithContext(ctx); err != nil {\n73\t\t\tfmt.Fprintln(out, \"Setup cancelled.\")\n74\t\t\treturn false\n75\t\t}\n76\t\tif !proceed {\n77\t\t\tfmt.Fprintln(out, \"Setup cancelled.\")\n78\t\t}\n79\t\treturn proceed\n80\t}\n81\t\n82\t// RunReviewConfigPicker presents a huh multi-select for each installed agent\n83\t// that has curated review skills, and saves the selection to\n84\t// .entire/settings.json. Previously-saved skills are pre-checked via\n85\t// huh.Option.Selected(true), mirroring how `entire enable` preserves prior\n86\t// selections in its own agent picker.\n87\t//\n88\t// getInstalled is injected to avoid an import cycle with the cli package.\n89\tfunc RunReviewConfigPicker(ctx context.Context, out io.Writer, getInstalled func(context.Context) []types.AgentName) (map[string]settings.ReviewConfig, error) {\n90\t\tinstalled := getInstalled(ctx)\n91\t\tif len(installed) == 0 {\n92\t\t\treturn nil, errors.New(\n93\t\t\t\t\"no agents with hooks installed; \" +\n94\t\t\t\t\t\"run 'entire configure --agent <name>' to install hooks for one, \" +\n95\t\t\t\t\t\"or 'entire enable' to set up the repo\",\n96\t\t\t)\n97\t\t}\n98\t\n99\t\t// Narrow to agents that have a curated skills list; others need manual\n100\t\t// editing of settings.json under review.<agent-name>.\n101\t\ttype configurableAgent struct {\n102\t\t\tname types.AgentName\n103\t\t\tag   agent.Agent\n104\t\t}\n105\t\tvar configurable []configurableAgent\n106\t\tfor _, name := range installed {\n107\t\t\tif !skilldiscovery.IsEligible(string(name)) {\n108\t\t\t\tcontinue\n109\t\t\t}\n110\t\t\tag, err := agent.Get(name)\n111\t\t\tif err != nil {\n112\t\t\t\tcontinue\n113\t\t\t}\n114\t\t\tconfigurable = append(configurable, configurableAgent{name: name, ag: ag})\n115\t\t}\n116\t\tif len(configurable) == 0 {\n117\t\t\treturn nil, errors.New(\n118\t\t\t\t\"no installed agents have curated review skills; \" +\n119\t\t\t\t\t\"edit .entire/settings.json directly under review.<agent-name>\",\n120\t\t\t)\n121\t\t}\n122\t\n123\t\t// Load existing config so we can pre-check saved skills and seed saved\n124\t\t// prompts. A load error here means the settings file is malformed; log\n125\t\t// at Warn so users debugging \"my saved skills aren't pre-checked\" can\n126\t\t// see why, but keep going with an empty prefill — runReview already\n127\t\t// surfaces the same error distinctly when it's the first load.\n128\t\texisting := map[string]settings.ReviewConfig{}\n129\t\texistingFixAgent := \"\"\n130\t\tif s, err := settings.Load(ctx); err != nil {\n131\t\t\tlogging.Warn(ctx, \"settings.Load failed when pre-filling picker\", slog.String(\"error\", err.Error()))\n132\t\t} else if s != nil {\n133\t\t\texisting = s.Review\n134\t\t\texistingFixAgent = s.ReviewFixAgent\n135\t\t}\n136\t\n137\t\t// Up-front header: make the order and count obvious so users can spot\n138\t\t// when an agent they expected isn't being offered (e.g., hooks not\n139\t\t// installed for it yet).\n140\t\tlabels := make([]string, 0, len(configurable))\n141\t\tfor _, c := range configurable {\n142\t\t\tlabels = append(labels, string(c.ag.Type()))\n143\t\t}\n144\t\tfmt.Fprintf(out, \"Configuring review for %d agent(s): %s\\n\", len(configurable), strings.Join(labels, \", \"))\n145\t\tfmt.Fprintln(out, \"(Previously-saved skills are pre-checked. Space to toggle, enter to confirm.)\")\n146\t\tfmt.Fprintln(out)\n147\t\n148\t\tselected := map[string]settings.ReviewConfig{}\n149\t\tfor i, c := range configurable {\n150\t\t\tcurated := skilldiscovery.CuratedBuiltinsFor(string(c.name))\n151\t\n152\t\t\t// Discover + dedupe + filter hints.\n153\t\t\tvar discovered []agent.DiscoveredSkill\n154\t\t\tif d, ok := c.ag.(agent.SkillDiscoverer); ok {\n155\t\t\t\tif ds, dErr := d.DiscoverReviewSkills(ctx); dErr == nil {\n156\t\t\t\t\tdiscovered = ds\n157\t\t\t\t} else {\n158\t\t\t\t\tlogging.Debug(ctx, \"review discovery failed\",\n159\t\t\t\t\t\tslog.String(\"agent\", string(c.name)), slog.String(\"error\", dErr.Error()))\n160\t\t\t\t}\n161\t\t\t}\n162\t\t\tbuiltinNames := builtinNameSet(curated)\n163\t\t\tdiscovered = filterOutBuiltinCollisions(discovered, builtinNames)\n164\t\n165\t\t\tdiscoveredSet := make(map[string]struct{}, len(discovered))\n166\t\t\tfor _, d := range discovered {\n167\t\t\t\tdiscoveredSet[d.Name] = struct{}{}\n168\t\t\t}\n169\t\t\tactiveHints := skilldiscovery.ActiveInstallHintsFor(string(c.name), discoveredSet)\n170\t\n171\t\t\t// Pre-populate pick slices from saved config so the picker preselects\n172\t\t\t// them. The header promises \"previously-saved skills are pre-checked\";\n173\t\t\t// without this split + Option.Selected(true) in BuildReviewPickerFields,\n174\t\t\t// --edit with accept-defaults silently wipes the agent's saved skills.\n175\t\t\tbuiltinPicks, discoveredPicks := SplitSavedPicks(\n176\t\t\t\texisting[string(c.name)].Skills, curated, discovered,\n177\t\t\t)\n178\t\t\tprompt := existing[string(c.name)].Prompt\n179\t\n180\t\t\tfields := BuildReviewPickerFields(\n181\t\t\t\tstring(c.name), curated, discovered, activeHints, prompt,\n182\t\t\t\t&builtinPicks, &discoveredPicks, &prompt,\n183\t\t\t)\n184\t\n185\t\t\t// Prepend a non-blocking header Note so the agent being configured\n186\t\t\t// is always clearly visible.\n187\t\t\theader := huh.NewNote().\n188\t\t\t\tTitle(string(c.ag.Type())).\n189\t\t\t\tDescription(fmt.Sprintf(\"Agent %d of %d · pick review skills and optional instructions\", i+1, len(configurable)))\n190\t\t\tfields = append([]huh.Field{header}, fields...)\n191\t\n192\t\t\tform := newAccessibleForm(huh.NewGroup(fields...))\n193\t\t\tif err := form.RunWithContext(ctx); err != nil {\n194\t\t\t\treturn nil, fmt.Errorf(\"picker for %s: %w\", c.name, err)\n195\t\t\t}\n196\t\n197\t\t\tcfg := settings.ReviewConfig{\n198\t\t\t\tSkills: dedupeStrings(append(builtinPicks, discoveredPicks...)),\n199\t\t\t\tPrompt: strings.TrimSpace(prompt),\n200\t\t\t}\n201\t\t\tif !cfg.IsZero() {\n202\t\t\t\tselected[string(c.name)] = cfg\n203\t\t\t}\n204\t\t}\n205\t\t// Merge the picker's output with existing entries the picker could not\n206\t\t// surface. Without the merge, save would replace s.Review wholesale and\n207\t\t// silently drop entries the user had configured for external agents,\n208\t\t// uncurated agents, or agents whose hooks are temporarily uninstalled.\n209\t\toffered := make(map[string]struct{}, len(configurable))\n210\t\tfor _, c := range configurable {\n211\t\t\toffered[string(c.name)] = struct{}{}\n212\t\t}\n213\t\tmerged := MergePickerResults(existing, offered, selected)\n214\t\n215\t\t// The emptiness check runs on `merged`, not `selected`.\n216\t\tif len(merged) == 0 {\n217\t\t\treturn nil, errors.New(\"no review skills or prompt configured\")\n218\t\t}\n219\t\n220\t\tfixAgent, err := pickReviewFixAgentPreference(ctx, merged, existingFixAgent)\n221\t\tif err != nil {\n222\t\t\treturn nil, err\n223\t\t}\n224\t\tif err := saveReviewConfigAndFixAgent(ctx, merged, fixAgent); err != nil {\n225\t\t\treturn nil, err\n226\t\t}\n227\t\tfmt.Fprintln(out, \"Saved review config to .entire/settings.json. Edit directly or run `entire review --edit`.\")\n228\t\treturn merged, nil\n229\t}\n230\t\n231\t// MergePickerResults combines the picker's output with existing review\n232\t// config entries that the picker did not surface. Agents in `offered` are\n233\t// fully controlled by the picker: if they appear in `selected` with a\n234\t// non-zero config the entry is set, otherwise the entry is removed.\n235\t// Agents not in `offered` keep their existing config untouched.\n236\t//\n237\t// Exported so tests can drive it directly — the picker itself\n238\t// can't run headless.\n239\tfunc MergePickerResults(existing map[string]settings.ReviewConfig, offered map[string]struct{}, selected map[string]settings.ReviewConfig) map[string]settings.ReviewConfig {\n240\t\tmerged := make(map[string]settings.ReviewConfig, len(existing)+len(selected))\n241\t\tfor name, cfg := range existing {\n242\t\t\tif _, wasOffered := offered[name]; !wasOffered {\n243\t\t\t\tmerged[name] = cfg\n244\t\t\t}\n245\t\t}\n246\t\tfor name, cfg := range selected {\n247\t\t\tmerged[name] = cfg\n248\t\t}\n249\t\treturn merged\n250\t}\n251\t\n252\t// SaveReviewConfig persists the review map into .entire/settings.json while\n253\t// preserving all other settings. A Load error means the file exists but is\n254\t// malformed — we must NOT silently overwrite it with an empty struct, or\n255\t// every unrelated setting the user had configured would be wiped. Return the\n256\t// error so the caller can surface it instead.\n257\tfunc SaveReviewConfig(ctx context.Context, review map[string]settings.ReviewConfig) error {\n258\t\ts, err := settings.Load(ctx)\n259\t\tif err != nil {\n260\t\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n261\t\t}\n262\t\tif s == nil {\n263\t\t\ts = &settings.EntireSettings{}\n264\t\t}\n265\t\ts.Review = review\n266\t\tif err := settings.Save(ctx, s); err != nil {\n267\t\t\treturn fmt.Errorf(\"save settings: %w\", err)\n268\t\t}\n269\t\treturn nil\n270\t}\n271\t\n272\tfunc SaveReviewFixAgent(ctx context.Context, agentName string) error {\n273\t\ts, err := settings.Load(ctx)\n274\t\tif err != nil {\n275\t\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n276\t\t}\n277\t\tif s == nil {\n278\t\t\ts = &settings.EntireSettings{}\n279\t\t}\n280\t\ts.ReviewFixAgent = agentName\n281\t\tif err := settings.Save(ctx, s); err != nil {\n282\t\t\treturn fmt.Errorf(\"save settings: %w\", err)\n283\t\t}\n284\t\treturn nil\n285\t}\n286\t\n287\tfunc saveReviewConfigAndFixAgent(ctx context.Context, review map[string]settings.ReviewConfig, fixAgent string) error {\n288\t\ts, err := settings.Load(ctx)\n289\t\tif err != nil {\n290\t\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n291\t\t}\n292\t\tif s == nil {\n293\t\t\ts = &settings.EntireSettings{}\n294\t\t}\n295\t\ts.Review = review\n296\t\ts.ReviewFixAgent = fixAgent\n297\t\tif err := settings.Save(ctx, s); err != nil {\n298\t\t\treturn fmt.Errorf(\"save settings: %w\", err)\n299\t\t}\n300\t\treturn nil\n301\t}\n302\t\n303\tfunc pickReviewFixAgentPreference(ctx context.Context, review map[string]settings.ReviewConfig, current string) (string, error) {\n304\t\tchoices := reviewFixAgentChoices(review)\n305\t\tswitch len(choices) {\n306\t\tcase 0:\n307\t\t\treturn current, nil\n308\t\tcase 1:\n309\t\t\treturn choices[0].Name, nil\n310\t\tdefault:\n311\t\t\treturn promptForReviewFixAgent(ctx, choices, current)\n312\t\t}\n313\t}\n314\t\n315\t// ComputeEligibleConfigured returns the sorted list of agents that are both\n316\t// configured (non-zero ReviewConfig entry) AND have hooks installed. Only\n317\t// eligible agents are valid picker targets — spawning a review for an agent\n318\t// without hooks would silently drop the review metadata.\n319\tfunc ComputeEligibleConfigured(s *settings.EntireSettings, installed []types.AgentName) []AgentChoice {\n320\t\tif s == nil {\n321\t\t\treturn nil\n322\t\t}\n323\t\tinstalledSet := make(map[types.AgentName]struct{}, len(installed))\n324\t\tfor _, name := range installed {\n325\t\t\tinstalledSet[name] = struct{}{}\n326\t\t}\n327\t\tout := make([]AgentChoice, 0, len(s.Review))\n328\t\tfor name, cfg := range s.Review {\n329\t\t\tif cfg.IsZero() {\n330\t\t\t\tcontinue\n331\t\t\t}\n332\t\t\tif _, ok := installedSet[types.AgentName(name)]; !ok {\n333\t\t\t\tcontinue\n334\t\t\t}\n335\t\t\tout = append(out, AgentChoice{Name: name, Label: labelForAgentChoice(name, cfg)})\n336\t\t}\n337\t\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\n338\t\treturn out\n339\t}\n340\t\n341\t// labelForAgentChoice builds the picker-visible label for an agent row.\n342\tfunc labelForAgentChoice(name string, cfg settings.ReviewConfig) string {\n343\t\tswitch {\n344\t\tcase len(cfg.Skills) > 0:\n345\t\t\treturn fmt.Sprintf(\"%s   (%d skills configured)\", name, len(cfg.Skills))\n346\t\tcase cfg.Prompt != \"\":\n347\t\t\treturn name + \"   (prompt-only)\"\n348\t\tdefault:\n349\t\t\treturn name\n350\t\t}\n351\t}\n352\t\n353\t// computeLaunchableEligible returns the subset of ComputeEligibleConfigured\n354\t// that also have a non-nil AgentReviewer (i.e., are launchable by the CLI).\n355\t// Used by the dispatch fork in cmd.go to decide whether to route to the\n356\t// multi-agent path.\n357\t//\n358\t// reviewerFor is deps.ReviewerFor injected at the cmd layer; it returns nil\n359\t// for non-launchable agents (cursor, opencode, factoryai-droid, copilot-cli).\n360\tfunc computeLaunchableEligible(\n361\t\ts *settings.EntireSettings,\n362\t\tinstalled []types.AgentName,\n363\t\treviewerFor func(string) reviewtypes.AgentReviewer,\n364\t) []AgentChoice {\n365\t\teligible := ComputeEligibleConfigured(s, installed)\n366\t\tout := make([]AgentChoice, 0, len(eligible))\n367\t\tfor _, c := range eligible {\n368\t\t\tif reviewerFor(c.Name) != nil {\n369\t\t\t\tout = append(out, c)\n370\t\t\t}\n371\t\t}\n372\t\treturn out\n373\t}\n374\t\n375\t// PromptForAgent renders the single-select agent picker shown when more than\n376\t// one eligible agent is configured. Returns the chosen agent name. Respects\n377\t// accessibility mode via newAccessibleForm.\n378\tfunc PromptForAgent(ctx context.Context, eligible []AgentChoice) (string, error) {\n379\t\tif err := ctx.Err(); err != nil {\n380\t\t\treturn \"\", fmt.Errorf(\"agent picker: %w\", err)\n381\t\t}\n382\t\tif len(eligible) == 0 {\n383\t\t\treturn \"\", errors.New(\"no eligible agents to prompt for\")\n384\t\t}\n385\t\toptions := make([]huh.Option[string], 0, len(eligible))\n386\t\tfor _, c := range eligible {\n387\t\t\toptions = append(options, huh.NewOption(c.Label, c.Name))\n388\t\t}\n389\t\tpicked := eligible[0].Name\n390\t\tform := newAccessibleForm(huh.NewGroup(\n391\t\t\thuh.NewSelect[string]().\n392\t\t\t\tTitle(\"Which agent should run this review?\").\n393\t\t\t\tOptions(options...).\n394\t\t\t\tValue(&picked),\n395\t\t))\n396\t\tif err := form.RunWithContext(ctx); err != nil {\n397\t\t\treturn \"\", fmt.Errorf(\"agent picker: %w\", err)\n398\t\t}\n399\t\treturn picked, nil\n400\t}\n401\t\n402\t// SelectReviewAgent picks an agent from the configured review map.\n403\t//\n404\t// If override is non-empty, returns the config for that agent or an error\n405\t// listing the configured alternatives. Otherwise returns the alphabetically\n406\t// first configured agent — deterministic but user-overridable via --agent.\n407\tfunc SelectReviewAgent(review map[string]settings.ReviewConfig, override string) (string, settings.ReviewConfig, error) {\n408\t\tif len(review) == 0 {\n409\t\t\treturn \"\", settings.ReviewConfig{}, errors.New(\"no review config found\")\n410\t\t}\n411\t\tvar names []string\n412\t\tfor name, cfg := range review {\n413\t\t\tif !cfg.IsZero() {\n414\t\t\t\tnames = append(names, name)\n415\t\t\t}\n416\t\t}\n417\t\tif len(names) == 0 {\n418\t\t\treturn \"\", settings.ReviewConfig{}, errors.New(\"no review config found\")\n419\t\t}\n420\t\tsort.Strings(names)\n421\t\tif override != \"\" {\n422\t\t\tif cfg, ok := review[override]; ok && !cfg.IsZero() {\n423\t\t\t\treturn override, cfg, nil\n424\t\t\t}\n425\t\t\treturn \"\", settings.ReviewConfig{}, fmt.Errorf(\n426\t\t\t\t\"agent %q is not configured for review; configured agents: %s\",\n427\t\t\t\toverride, strings.Join(names, \", \"),\n428\t\t\t)\n429\t\t}\n430\t\tpick := names[0]\n431\t\treturn pick, review[pick], nil\n432\t}\n433\t\n434\t// VerifyConfiguredSkillsInstalled is the spawn-time backstop for the\n435\t// silent-failure vector. For each skill in cfg.Skills, check it's either a\n436\t// curated built-in or returned by the agent's SkillDiscoverer; fail with a\n437\t// user-facing error if any skill is missing. Empty Skills (prompt-only\n438\t// config) short-circuits to nil — a freeform prompt has no skill list to\n439\t// validate against.\n440\tfunc VerifyConfiguredSkillsInstalled(ctx context.Context, ag agent.Agent, cfg settings.ReviewConfig) error {\n441\t\tif len(cfg.Skills) == 0 {\n442\t\t\treturn nil\n443\t\t}\n444\t\tbuiltins := builtinNameSet(skilldiscovery.CuratedBuiltinsFor(string(ag.Name())))\n445\t\tdiscoveredNames := map[string]struct{}{}\n446\t\tif d, ok := ag.(agent.SkillDiscoverer); ok {\n447\t\t\tif skills, err := d.DiscoverReviewSkills(ctx); err == nil {\n448\t\t\t\tfor _, s := range skills {\n449\t\t\t\t\tdiscoveredNames[s.Name] = struct{}{}\n450\t\t\t\t}\n451\t\t\t} else {\n452\t\t\t\tlogging.Debug(ctx, \"skill verification discovery failed\",\n453\t\t\t\t\tslog.String(\"agent\", string(ag.Name())), slog.String(\"error\", err.Error()))\n454\t\t\t}\n455\t\t}\n456\t\tvar missing []string\n457\t\tfor _, s := range cfg.Skills {\n458\t\t\tif _, ok := builtins[s]; ok {\n459\t\t\t\tcontinue\n460\t\t\t}\n461\t\t\tif _, ok := discoveredNames[s]; ok {\n462\t\t\t\tcontinue\n463\t\t\t}\n464\t\t\tmissing = append(missing, s)\n465\t\t}\n466\t\tif len(missing) == 0 {\n467\t\t\treturn nil\n468\t\t}\n469\t\treturn fmt.Errorf(\n470\t\t\t\"configured review skill(s) not installed: %s\\n\"+\n471\t\t\t\t\"run `entire review --edit` to reconfigure, or install the plugin and retry\",\n472\t\t\tstrings.Join(missing, \", \"),\n473\t\t)\n474\t}\n475\t\n476\t// BuildReviewPickerFields composes the per-agent group fields for the\n477\t// review picker. Returns a slice of huh.Field in render order:\n478\t//\n479\t//\t0: built-in commands (multiselect) OR note\n480\t//\t1: installed plugin skills (multiselect) OR note\n481\t//\t2: install hints (note with all active hint messages) — OMITTED if empty\n482\t//\t3: additional instructions (text) — always present\n483\tfunc BuildReviewPickerFields(\n484\t\tagentName string,\n485\t\tbuiltins []skilldiscovery.CuratedSkill,\n486\t\tdiscovered []agent.DiscoveredSkill,\n487\t\tactiveHints []skilldiscovery.InstallHint,\n488\t\tpreviousPrompt string,\n489\t\tbuiltinPicksOut, discoveredPicksOut *[]string,\n490\t\tpromptOut *string,\n491\t) []huh.Field {\n492\t\tvar fields []huh.Field\n493\t\n494\t\tif builtinPicksOut != nil && len(*builtinPicksOut) == 0 &&\n495\t\t\tlen(builtins) == 1 && strings.TrimSpace(previousPrompt) == \"\" {\n496\t\t\t*builtinPicksOut = []string{builtins[0].Name}\n497\t\t}\n498\t\n499\t\tbuiltinPreselected := preselectedSet(builtinPicksOut)\n500\t\tdiscoveredPreselected := preselectedSet(discoveredPicksOut)\n501\t\n502\t\tif len(builtins) > 0 {\n503\t\t\topts := make([]huh.Option[string], 0, len(builtins))\n504\t\t\tfor _, b := range builtins {\n505\t\t\t\topt := huh.NewOption(b.Name, b.Name)\n506\t\t\t\tif _, ok := builtinPreselected[b.Name]; ok {\n507\t\t\t\t\topt = opt.Selected(true)\n508\t\t\t\t}\n509\t\t\t\topts = append(opts, opt)\n510\t\t\t}\n511\t\t\tms := huh.NewMultiSelect[string]().\n512\t\t\t\tTitle(\"Built-in commands\").\n513\t\t\t\tOptions(opts...).\n514\t\t\t\tHeight(len(opts) + 1)\n515\t\t\tif builtinPicksOut != nil {\n516\t\t\t\tms = ms.Value(builtinPicksOut)\n517\t\t\t}\n518\t\t\tfields = append(fields, ms)\n519\t\t} else {\n520\t\t\tfields = append(fields, huh.NewNote().\n521\t\t\t\tTitle(\"Built-in commands\").\n522\t\t\t\tDescription(fmt.Sprintf(\"No built-in review commands in %s.\", agentName)))\n523\t\t}\n524\t\n525\t\tif len(discovered) > 0 {\n526\t\t\topts := make([]huh.Option[string], 0, len(discovered))\n527\t\t\tfor _, d := range discovered {\n528\t\t\t\topt := huh.NewOption(d.Name, d.Name)\n529\t\t\t\tif _, ok := discoveredPreselected[d.Name]; ok {\n530\t\t\t\t\topt = opt.Selected(true)\n531\t\t\t\t}\n532\t\t\t\topts = append(opts, opt)\n533\t\t\t}\n534\t\t\tms := huh.NewMultiSelect[string]().\n535\t\t\t\tTitle(\"Installed plugin skills\").\n536\t\t\t\tOptions(opts...).\n537\t\t\t\tHeight(len(opts) + 1)\n538\t\t\tif discoveredPicksOut != nil {\n539\t\t\t\tms = ms.Value(discoveredPicksOut)\n540\t\t\t}\n541\t\t\tfields = append(fields, ms)\n542\t\t} else {\n543\t\t\tfields = append(fields, huh.NewNote().\n544\t\t\t\tTitle(\"Installed plugin skills\").\n545\t\t\t\tDescription(\"No plugin review skills detected on disk.\"))\n546\t\t}\n547\t\n548\t\tif len(activeHints) > 0 {\n549\t\t\tvar sb strings.Builder\n550\t\t\tfor i, h := range activeHints {\n551\t\t\t\tif i > 0 {\n552\t\t\t\t\tsb.WriteString(\"\\n\")\n553\t\t\t\t}\n554\t\t\t\tsb.WriteString(\"• \")\n555\t\t\t\tsb.WriteString(h.Message)\n556\t\t\t}\n557\t\t\tfields = append(fields, huh.NewNote().\n558\t\t\t\tTitle(\"Install more\").\n559\t\t\t\tDescription(sb.String()))\n560\t\t}\n561\t\n562\t\ttext := huh.NewText().\n563\t\t\tTitle(\"Additional instructions (optional)\").\n564\t\t\tDescription(\"Added after selected skills. If no skills are selected, this becomes the full review prompt.\")\n565\t\tif promptOut != nil {\n566\t\t\t*promptOut = previousPrompt\n567\t\t\ttext = text.Value(promptOut)\n568\t\t}\n569\t\tfields = append(fields, text)\n570\t\n571\t\treturn fields\n572\t}\n573\t\n574\t// SplitSavedPicks partitions a flat saved-skills list into the subset that\n575\t// matches built-in curated commands and the subset that matches discovered\n576\t// plugin skills. Skill names that match neither are dropped from both — they're\n577\t// preserved on the settings side via MergePickerResults when they belong to a\n578\t// picker-unaware agent entry.\n579\tfunc SplitSavedPicks(saved []string, builtins []skilldiscovery.CuratedSkill, discovered []agent.DiscoveredSkill) ([]string, []string) {\n580\t\tbuiltinNames := make(map[string]struct{}, len(builtins))\n581\t\tfor _, b := range builtins {\n582\t\t\tbuiltinNames[b.Name] = struct{}{}\n583\t\t}\n584\t\tdiscoveredNames := make(map[string]struct{}, len(discovered))\n585\t\tfor _, d := range discovered {\n586\t\t\tdiscoveredNames[d.Name] = struct{}{}\n587\t\t}\n588\t\tvar builtinPicks, discoveredPicks []string\n589\t\tfor _, s := range saved {\n590\t\t\tif _, ok := builtinNames[s]; ok {\n591\t\t\t\tbuiltinPicks = append(builtinPicks, s)\n592\t\t\t\tcontinue\n593\t\t\t}\n594\t\t\tif _, ok := discoveredNames[s]; ok {\n595\t\t\t\tdiscoveredPicks = append(discoveredPicks, s)\n596\t\t\t}\n597\t\t}\n598\t\treturn builtinPicks, discoveredPicks\n599\t}\n600\t\n601\t// preselectedSet turns a slice pointer's current contents into a lookup\n602\t// set for the picker's \"previously-saved\" pre-selection.\n603\tfunc preselectedSet(slice *[]string) map[string]struct{} {\n604\t\tif slice == nil || len(*slice) == 0 {\n605\t\t\treturn nil\n606\t\t}\n607\t\tout := make(map[string]struct{}, len(*slice))\n608\t\tfor _, s := range *slice {\n609\t\t\tout[s] = struct{}{}\n610\t\t}\n611\t\treturn out\n612\t}\n613\t\n614\tfunc builtinNameSet(curated []skilldiscovery.CuratedSkill) map[string]struct{} {\n615\t\tset := make(map[string]struct{}, len(curated))\n616\t\tfor _, c := range curated {\n617\t\t\tset[c.Name] = struct{}{}\n618\t\t}\n619\t\treturn set\n620\t}\n621\t\n622\t// filterOutBuiltinCollisions drops any discovered skill whose name collides\n623\t// with a curated built-in. Built-in wins because it carries a richer,\n624\t// hand-authored description.\n625\tfunc filterOutBuiltinCollisions(discovered []agent.DiscoveredSkill, builtins map[string]struct{}) []agent.DiscoveredSkill {\n626\t\tif len(discovered) == 0 || len(builtins) == 0 {\n627\t\t\treturn discovered\n628\t\t}\n629\t\tout := make([]agent.DiscoveredSkill, 0, len(discovered))\n630\t\tfor _, d := range discovered {\n631\t\t\tif _, clash := builtins[d.Name]; clash {\n632\t\t\t\tcontinue\n633\t\t\t}\n634\t\t\tout = append(out, d)\n635\t\t}\n636\t\treturn out\n637\t}\n638\t\n639\tfunc dedupeStrings(xs []string) []string {\n640\t\tif len(xs) == 0 {\n641\t\t\treturn xs\n642\t\t}\n643\t\tseen := make(map[string]struct{}, len(xs))\n644\t\tout := make([]string, 0, len(xs))\n645\t\tfor _, x := range xs {\n646\t\t\tif _, ok := seen[x]; ok {\n647\t\t\t\tcontinue\n648\t\t\t}\n649\t\t\tseen[x] = struct{}{}\n650\t\t\tout = append(out, x)\n651\t\t}\n652\t\treturn out\n653\t}\n654\t"}]},"uuid":"254aeaed-25ec-4e92-9022-8431710f9a9d","timestamp":"2026-05-13T18:36:56.682Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-2/cmd/entire/cli/review/picker.go","content":"// Package review — see env.go for package-level rationale.\n//\n// picker.go implements the interactive review skills picker and agent selection\n// helpers. pickConfig presents a huh multi-select per installed agent and saves\n// the selection to .entire/settings.json.\npackage review\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"charm.land/huh/v2\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/skilldiscovery\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n)\n\n// AgentChoice is one row in the spawn-time picker. Name is the agent\n// registry key (used for marker/override); Label is the picker-visible\n// string (\"<name>   (N skills configured)\" or \"<name>   (prompt-only)\").\ntype AgentChoice struct {\n\tName  string\n\tLabel string\n}\n\n// newAccessibleForm creates a huh form with accessibility mode enabled when\n// the ACCESSIBLE env var is set. Mirrors cli.NewAccessibleForm without\n// requiring an import of the cli package (which would be circular).\nfunc newAccessibleForm(groups ...*huh.Group) *huh.Form {\n\tform := huh.NewForm(groups...).WithTheme(huh.ThemeFunc(huh.ThemeDracula))\n\tif os.Getenv(\"ACCESSIBLE\") != \"\" {\n\t\tform = form.WithAccessible(true)\n\t}\n\treturn form\n}\n\n// ConfirmFirstRunSetup prints a banner framing the picker as first-run\n// setup (rather than the review itself) and waits for the user to confirm.\n// Returns false if the user cancels; caller should bail gracefully.\n//\n// Signposting matters here because `entire review` with no config silently\n// drops into the picker — users running the command to start a review can\n// mistake the picker for the review. The banner + confirmation makes the\n// setup phase explicit, and the trailing \"running review now\" line in the\n// caller closes the loop on what comes next.\nfunc ConfirmFirstRunSetup(ctx context.Context, out io.Writer) bool {\n\tfmt.Fprintln(out, \"No review config found — let's set one up first.\")\n\tfmt.Fprintln(out)\n\tfmt.Fprintln(out, \"You'll pick skills for each installed agent. They're saved to\")\n\tfmt.Fprintln(out, \".entire/settings.json; edit later with `entire review --edit`.\")\n\tfmt.Fprintln(out, \"After setup, the review will run with your selection.\")\n\tfmt.Fprintln(out)\n\n\tproceed := true\n\tform := newAccessibleForm(huh.NewGroup(\n\t\thuh.NewConfirm().\n\t\t\tTitle(\"Set up review skills now?\").\n\t\t\tAffirmative(\"Yes\").\n\t\t\tNegative(\"Cancel\").\n\t\t\tValue(&proceed),\n\t))\n\tif err := form.RunWithContext(ctx); err != nil {\n\t\tfmt.Fprintln(out, \"Setup cancelled.\")\n\t\treturn false\n\t}\n\tif !proceed {\n\t\tfmt.Fprintln(out, \"Setup cancelled.\")\n\t}\n\treturn proceed\n}\n\n// RunReviewConfigPicker presents a huh multi-select for each installed agent\n// that has curated review skills, and saves the selection to\n// .entire/settings.json. Previously-saved skills are pre-checked via\n// huh.Option.Selected(true), mirroring how `entire enable` preserves prior\n// selections in its own agent picker.\n//\n// getInstalled is injected to avoid an import cycle with the cli package.\nfunc RunReviewConfigPicker(ctx context.Context, out io.Writer, getInstalled func(context.Context) []types.AgentName) (map[string]settings.ReviewConfig, error) {\n\tinstalled := getInstalled(ctx)\n\tif len(installed) == 0 {\n\t\treturn nil, errors.New(\n\t\t\t\"no agents with hooks installed; \" +\n\t\t\t\t\"run 'entire configure --agent <name>' to install hooks for one, \" +\n\t\t\t\t\"or 'entire enable' to set up the repo\",\n\t\t)\n\t}\n\n\t// Narrow to agents that have a curated skills list; others need manual\n\t// editing of settings.json under review.<agent-name>.\n\ttype configurableAgent struct {\n\t\tname types.AgentName\n\t\tag   agent.Agent\n\t}\n\tvar configurable []configurableAgent\n\tfor _, name := range installed {\n\t\tif !skilldiscovery.IsEligible(string(name)) {\n\t\t\tcontinue\n\t\t}\n\t\tag, err := agent.Get(name)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tconfigurable = append(configurable, configurableAgent{name: name, ag: ag})\n\t}\n\tif len(configurable) == 0 {\n\t\treturn nil, errors.New(\n\t\t\t\"no installed agents have curated review skills; \" +\n\t\t\t\t\"edit .entire/settings.json directly under review.<agent-name>\",\n\t\t)\n\t}\n\n\t// Load existing config so we can pre-check saved skills and seed saved\n\t// prompts. A load error here means the settings file is malformed; log\n\t// at Warn so users debugging \"my saved skills aren't pre-checked\" can\n\t// see why, but keep going with an empty prefill — runReview already\n\t// surfaces the same error distinctly when it's the first load.\n\texisting := map[string]settings.ReviewConfig{}\n\texistingFixAgent := \"\"\n\tif s, err := settings.Load(ctx); err != nil {\n\t\tlogging.Warn(ctx, \"settings.Load failed when pre-filling picker\", slog.String(\"error\", err.Error()))\n\t} else if s != nil {\n\t\texisting = s.Review\n\t\texistingFixAgent = s.ReviewFixAgent\n\t}\n\n\t// Up-front header: make the order and count obvious so users can spot\n\t// when an agent they expected isn't being offered (e.g., hooks not\n\t// installed for it yet).\n\tlabels := make([]string, 0, len(configurable))\n\tfor _, c := range configurable {\n\t\tlabels = append(labels, string(c.ag.Type()))\n\t}\n\tfmt.Fprintf(out, \"Configuring review for %d agent(s): %s\\n\", len(configurable), strings.Join(labels, \", \"))\n\tfmt.Fprintln(out, \"(Previously-saved skills are pre-checked. Space to toggle, enter to confirm.)\")\n\tfmt.Fprintln(out)\n\n\tselected := map[string]settings.ReviewConfig{}\n\tfor i, c := range configurable {\n\t\tcurated := skilldiscovery.CuratedBuiltinsFor(string(c.name))\n\n\t\t// Discover + dedupe + filter hints.\n\t\tvar discovered []agent.DiscoveredSkill\n\t\tif d, ok := c.ag.(agent.SkillDiscoverer); ok {\n\t\t\tif ds, dErr := d.DiscoverReviewSkills(ctx); dErr == nil {\n\t\t\t\tdiscovered = ds\n\t\t\t} else {\n\t\t\t\tlogging.Debug(ctx, \"review discovery failed\",\n\t\t\t\t\tslog.String(\"agent\", string(c.name)), slog.String(\"error\", dErr.Error()))\n\t\t\t}\n\t\t}\n\t\tbuiltinNames := builtinNameSet(curated)\n\t\tdiscovered = filterOutBuiltinCollisions(discovered, builtinNames)\n\n\t\tdiscoveredSet := make(map[string]struct{}, len(discovered))\n\t\tfor _, d := range discovered {\n\t\t\tdiscoveredSet[d.Name] = struct{}{}\n\t\t}\n\t\tactiveHints := skilldiscovery.ActiveInstallHintsFor(string(c.name), discoveredSet)\n\n\t\t// Pre-populate pick slices from saved config so the picker preselects\n\t\t// them. The header promises \"previously-saved skills are pre-checked\";\n\t\t// without this split + Option.Selected(true) in BuildReviewPickerFields,\n\t\t// --edit with accept-defaults silently wipes the agent's saved skills.\n\t\tbuiltinPicks, discoveredPicks := SplitSavedPicks(\n\t\t\texisting[string(c.name)].Skills, curated, discovered,\n\t\t)\n\t\tprompt := existing[string(c.name)].Prompt\n\n\t\tfields := BuildReviewPickerFields(\n\t\t\tstring(c.name), curated, discovered, activeHints, prompt,\n\t\t\t&builtinPicks, &discoveredPicks, &prompt,\n\t\t)\n\n\t\t// Prepend a non-blocking header Note so the agent being configured\n\t\t// is always clearly visible.\n\t\theader := huh.NewNote().\n\t\t\tTitle(string(c.ag.Type())).\n\t\t\tDescription(fmt.Sprintf(\"Agent %d of %d · pick review skills and optional instructions\", i+1, len(configurable)))\n\t\tfields = append([]huh.Field{header}, fields...)\n\n\t\tform := newAccessibleForm(huh.NewGroup(fields...))\n\t\tif err := form.RunWithContext(ctx); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"picker for %s: %w\", c.name, err)\n\t\t}\n\n\t\tcfg := settings.ReviewConfig{\n\t\t\tSkills: dedupeStrings(append(builtinPicks, discoveredPicks...)),\n\t\t\tPrompt: strings.TrimSpace(prompt),\n\t\t}\n\t\tif !cfg.IsZero() {\n\t\t\tselected[string(c.name)] = cfg\n\t\t}\n\t}\n\t// Merge the picker's output with existing entries the picker could not\n\t// surface. Without the merge, save would replace s.Review wholesale and\n\t// silently drop entries the user had configured for external agents,\n\t// uncurated agents, or agents whose hooks are temporarily uninstalled.\n\toffered := make(map[string]struct{}, len(configurable))\n\tfor _, c := range configurable {\n\t\toffered[string(c.name)] = struct{}{}\n\t}\n\tmerged := MergePickerResults(existing, offered, selected)\n\n\t// The emptiness check runs on `merged`, not `selected`.\n\tif len(merged) == 0 {\n\t\treturn nil, errors.New(\"no review skills or prompt configured\")\n\t}\n\n\tfixAgent, err := pickReviewFixAgentPreference(ctx, merged, existingFixAgent)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := saveReviewConfigAndFixAgent(ctx, merged, fixAgent); err != nil {\n\t\treturn nil, err\n\t}\n\tfmt.Fprintln(out, \"Saved review config to .entire/settings.json. Edit directly or run `entire review --edit`.\")\n\treturn merged, nil\n}\n\n// MergePickerResults combines the picker's output with existing review\n// config entries that the picker did not surface. Agents in `offered` are\n// fully controlled by the picker: if they appear in `selected` with a\n// non-zero config the entry is set, otherwise the entry is removed.\n// Agents not in `offered` keep their existing config untouched.\n//\n// Exported so tests can drive it directly — the picker itself\n// can't run headless.\nfunc MergePickerResults(existing map[string]settings.ReviewConfig, offered map[string]struct{}, selected map[string]settings.ReviewConfig) map[string]settings.ReviewConfig {\n\tmerged := make(map[string]settings.ReviewConfig, len(existing)+len(selected))\n\tfor name, cfg := range existing {\n\t\tif _, wasOffered := offered[name]; !wasOffered {\n\t\t\tmerged[name] = cfg\n\t\t}\n\t}\n\tfor name, cfg := range selected {\n\t\tmerged[name] = cfg\n\t}\n\treturn merged\n}\n\n// SaveReviewConfig persists the review map into .entire/settings.json while\n// preserving all other settings. A Load error means the file exists but is\n// malformed — we must NOT silently overwrite it with an empty struct, or\n// every unrelated setting the user had configured would be wiped. Return the\n// error so the caller can surface it instead.\nfunc SaveReviewConfig(ctx context.Context, review map[string]settings.ReviewConfig) error {\n\ts, err := settings.Load(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n\t}\n\tif s == nil {\n\t\ts = &settings.EntireSettings{}\n\t}\n\ts.Review = review\n\tif err := settings.Save(ctx, s); err != nil {\n\t\treturn fmt.Errorf(\"save settings: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc SaveReviewFixAgent(ctx context.Context, agentName string) error {\n\ts, err := settings.Load(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n\t}\n\tif s == nil {\n\t\ts = &settings.EntireSettings{}\n\t}\n\ts.ReviewFixAgent = agentName\n\tif err := settings.Save(ctx, s); err != nil {\n\t\treturn fmt.Errorf(\"save settings: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc saveReviewConfigAndFixAgent(ctx context.Context, review map[string]settings.ReviewConfig, fixAgent string) error {\n\ts, err := settings.Load(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n\t}\n\tif s == nil {\n\t\ts = &settings.EntireSettings{}\n\t}\n\ts.Review = review\n\ts.ReviewFixAgent = fixAgent\n\tif err := settings.Save(ctx, s); err != nil {\n\t\treturn fmt.Errorf(\"save settings: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc pickReviewFixAgentPreference(ctx context.Context, review map[string]settings.ReviewConfig, current string) (string, error) {\n\tchoices := reviewFixAgentChoices(review)\n\tswitch len(choices) {\n\tcase 0:\n\t\treturn current, nil\n\tcase 1:\n\t\treturn choices[0].Name, nil\n\tdefault:\n\t\treturn promptForReviewFixAgent(ctx, choices, current)\n\t}\n}\n\n// ComputeEligibleConfigured returns the sorted list of agents that are both\n// configured (non-zero ReviewConfig entry) AND have hooks installed. Only\n// eligible agents are valid picker targets — spawning a review for an agent\n// without hooks would silently drop the review metadata.\nfunc ComputeEligibleConfigured(s *settings.EntireSettings, installed []types.AgentName) []AgentChoice {\n\tif s == nil {\n\t\treturn nil\n\t}\n\tinstalledSet := make(map[types.AgentName]struct{}, len(installed))\n\tfor _, name := range installed {\n\t\tinstalledSet[name] = struct{}{}\n\t}\n\tout := make([]AgentChoice, 0, len(s.Review))\n\tfor name, cfg := range s.Review {\n\t\tif cfg.IsZero() {\n\t\t\tcontinue\n\t\t}\n\t\tif _, ok := installedSet[types.AgentName(name)]; !ok {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, AgentChoice{Name: name, Label: labelForAgentChoice(name, cfg)})\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\n\treturn out\n}\n\n// labelForAgentChoice builds the picker-visible label for an agent row.\nfunc labelForAgentChoice(name string, cfg settings.ReviewConfig) string {\n\tswitch {\n\tcase len(cfg.Skills) > 0:\n\t\treturn fmt.Sprintf(\"%s   (%d skills configured)\", name, len(cfg.Skills))\n\tcase cfg.Prompt != \"\":\n\t\treturn name + \"   (prompt-only)\"\n\tdefault:\n\t\treturn name\n\t}\n}\n\n// computeLaunchableEligible returns the subset of ComputeEligibleConfigured\n// that also have a non-nil AgentReviewer (i.e., are launchable by the CLI).\n// Used by the dispatch fork in cmd.go to decide whether to route to the\n// multi-agent path.\n//\n// reviewerFor is deps.ReviewerFor injected at the cmd layer; it returns nil\n// for non-launchable agents (cursor, opencode, factoryai-droid, copilot-cli).\nfunc computeLaunchableEligible(\n\ts *settings.EntireSettings,\n\tinstalled []types.AgentName,\n\treviewerFor func(string) reviewtypes.AgentReviewer,\n) []AgentChoice {\n\teligible := ComputeEligibleConfigured(s, installed)\n\tout := make([]AgentChoice, 0, len(eligible))\n\tfor _, c := range eligible {\n\t\tif reviewerFor(c.Name) != nil {\n\t\t\tout = append(out, c)\n\t\t}\n\t}\n\treturn out\n}\n\n// PromptForAgent renders the single-select agent picker shown when more than\n// one eligible agent is configured. Returns the chosen agent name. Respects\n// accessibility mode via newAccessibleForm.\nfunc PromptForAgent(ctx context.Context, eligible []AgentChoice) (string, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn \"\", fmt.Errorf(\"agent picker: %w\", err)\n\t}\n\tif len(eligible) == 0 {\n\t\treturn \"\", errors.New(\"no eligible agents to prompt for\")\n\t}\n\toptions := make([]huh.Option[string], 0, len(eligible))\n\tfor _, c := range eligible {\n\t\toptions = append(options, huh.NewOption(c.Label, c.Name))\n\t}\n\tpicked := eligible[0].Name\n\tform := newAccessibleForm(huh.NewGroup(\n\t\thuh.NewSelect[string]().\n\t\t\tTitle(\"Which agent should run this review?\").\n\t\t\tOptions(options...).\n\t\t\tValue(&picked),\n\t))\n\tif err := form.RunWithContext(ctx); err != nil {\n\t\treturn \"\", fmt.Errorf(\"agent picker: %w\", err)\n\t}\n\treturn picked, nil\n}\n\n// SelectReviewAgent picks an agent from the configured review map.\n//\n// If override is non-empty, returns the config for that agent or an error\n// listing the configured alternatives. Otherwise returns the alphabetically\n// first configured agent — deterministic but user-overridable via --agent.\nfunc SelectReviewAgent(review map[string]settings.ReviewConfig, override string) (string, settings.ReviewConfig, error) {\n\tif len(review) == 0 {\n\t\treturn \"\", settings.ReviewConfig{}, errors.New(\"no review config found\")\n\t}\n\tvar names []string\n\tfor name, cfg := range review {\n\t\tif !cfg.IsZero() {\n\t\t\tnames = append(names, name)\n\t\t}\n\t}\n\tif len(names) == 0 {\n\t\treturn \"\", settings.ReviewConfig{}, errors.New(\"no review config found\")\n\t}\n\tsort.Strings(names)\n\tif override != \"\" {\n\t\tif cfg, ok := review[override]; ok && !cfg.IsZero() {\n\t\t\treturn override, cfg, nil\n\t\t}\n\t\treturn \"\", settings.ReviewConfig{}, fmt.Errorf(\n\t\t\t\"agent %q is not configured for review; configured agents: %s\",\n\t\t\toverride, strings.Join(names, \", \"),\n\t\t)\n\t}\n\tpick := names[0]\n\treturn pick, review[pick], nil\n}\n\n// VerifyConfiguredSkillsInstalled is the spawn-time backstop for the\n// silent-failure vector. For each skill in cfg.Skills, check it's either a\n// curated built-in or returned by the agent's SkillDiscoverer; fail with a\n// user-facing error if any skill is missing. Empty Skills (prompt-only\n// config) short-circuits to nil — a freeform prompt has no skill list to\n// validate against.\nfunc VerifyConfiguredSkillsInstalled(ctx context.Context, ag agent.Agent, cfg settings.ReviewConfig) error {\n\tif len(cfg.Skills) == 0 {\n\t\treturn nil\n\t}\n\tbuiltins := builtinNameSet(skilldiscovery.CuratedBuiltinsFor(string(ag.Name())))\n\tdiscoveredNames := map[string]struct{}{}\n\tif d, ok := ag.(agent.SkillDiscoverer); ok {\n\t\tif skills, err := d.DiscoverReviewSkills(ctx); err == nil {\n\t\t\tfor _, s := range skills {\n\t\t\t\tdiscoveredNames[s.Name] = struct{}{}\n\t\t\t}\n\t\t} else {\n\t\t\tlogging.Debug(ctx, \"skill verification discovery failed\",\n\t\t\t\tslog.String(\"agent\", string(ag.Name())), slog.String(\"error\", err.Error()))\n\t\t}\n\t}\n\tvar missing []string\n\tfor _, s := range cfg.Skills {\n\t\tif _, ok := builtins[s]; ok {\n\t\t\tcontinue\n\t\t}\n\t\tif _, ok := discoveredNames[s]; ok {\n\t\t\tcontinue\n\t\t}\n\t\tmissing = append(missing, s)\n\t}\n\tif len(missing) == 0 {\n\t\treturn nil\n\t}\n\treturn fmt.Errorf(\n\t\t\"configured review skill(s) not installed: %s\\n\"+\n\t\t\t\"run `entire review --edit` to reconfigure, or install the plugin and retry\",\n\t\tstrings.Join(missing, \", \"),\n\t)\n}\n\n// BuildReviewPickerFields composes the per-agent group fields for the\n// review picker. Returns a slice of huh.Field in render order:\n//\n//\t0: built-in commands (multiselect) OR note\n//\t1: installed plugin skills (multiselect) OR note\n//\t2: install hints (note with all active hint messages) — OMITTED if empty\n//\t3: additional instructions (text) — always present\nfunc BuildReviewPickerFields(\n\tagentName string,\n\tbuiltins []skilldiscovery.CuratedSkill,\n\tdiscovered []agent.DiscoveredSkill,\n\tactiveHints []skilldiscovery.InstallHint,\n\tpreviousPrompt string,\n\tbuiltinPicksOut, discoveredPicksOut *[]string,\n\tpromptOut *string,\n) []huh.Field {\n\tvar fields []huh.Field\n\n\tif builtinPicksOut != nil && len(*builtinPicksOut) == 0 &&\n\t\tlen(builtins) == 1 && strings.TrimSpace(previousPrompt) == \"\" {\n\t\t*builtinPicksOut = []string{builtins[0].Name}\n\t}\n\n\tbuiltinPreselected := preselectedSet(builtinPicksOut)\n\tdiscoveredPreselected := preselectedSet(discoveredPicksOut)\n\n\tif len(builtins) > 0 {\n\t\topts := make([]huh.Option[string], 0, len(builtins))\n\t\tfor _, b := range builtins {\n\t\t\topt := huh.NewOption(b.Name, b.Name)\n\t\t\tif _, ok := builtinPreselected[b.Name]; ok {\n\t\t\t\topt = opt.Selected(true)\n\t\t\t}\n\t\t\topts = append(opts, opt)\n\t\t}\n\t\tms := huh.NewMultiSelect[string]().\n\t\t\tTitle(\"Built-in commands\").\n\t\t\tOptions(opts...).\n\t\t\tHeight(len(opts) + 1)\n\t\tif builtinPicksOut != nil {\n\t\t\tms = ms.Value(builtinPicksOut)\n\t\t}\n\t\tfields = append(fields, ms)\n\t} else {\n\t\tfields = append(fields, huh.NewNote().\n\t\t\tTitle(\"Built-in commands\").\n\t\t\tDescription(fmt.Sprintf(\"No built-in review commands in %s.\", agentName)))\n\t}\n\n\tif len(discovered) > 0 {\n\t\topts := make([]huh.Option[string], 0, len(discovered))\n\t\tfor _, d := range discovered {\n\t\t\topt := huh.NewOption(d.Name, d.Name)\n\t\t\tif _, ok := discoveredPreselected[d.Name]; ok {\n\t\t\t\topt = opt.Selected(true)\n\t\t\t}\n\t\t\topts = append(opts, opt)\n\t\t}\n\t\tms := huh.NewMultiSelect[string]().\n\t\t\tTitle(\"Installed plugin skills\").\n\t\t\tOptions(opts...).\n\t\t\tHeight(len(opts) + 1)\n\t\tif discoveredPicksOut != nil {\n\t\t\tms = ms.Value(discoveredPicksOut)\n\t\t}\n\t\tfields = append(fields, ms)\n\t} else {\n\t\tfields = append(fields, huh.NewNote().\n\t\t\tTitle(\"Installed plugin skills\").\n\t\t\tDescription(\"No plugin review skills detected on disk.\"))\n\t}\n\n\tif len(activeHints) > 0 {\n\t\tvar sb strings.Builder\n\t\tfor i, h := range activeHints {\n\t\t\tif i > 0 {\n\t\t\t\tsb.WriteString(\"\\n\")\n\t\t\t}\n\t\t\tsb.WriteString(\"• \")\n\t\t\tsb.WriteString(h.Message)\n\t\t}\n\t\tfields = append(fields, huh.NewNote().\n\t\t\tTitle(\"Install more\").\n\t\t\tDescription(sb.String()))\n\t}\n\n\ttext := huh.NewText().\n\t\tTitle(\"Additional instructions (optional)\").\n\t\tDescription(\"Added after selected skills. If no skills are selected, this becomes the full review prompt.\")\n\tif promptOut != nil {\n\t\t*promptOut = previousPrompt\n\t\ttext = text.Value(promptOut)\n\t}\n\tfields = append(fields, text)\n\n\treturn fields\n}\n\n// SplitSavedPicks partitions a flat saved-skills list into the subset that\n// matches built-in curated commands and the subset that matches discovered\n// plugin skills. Skill names that match neither are dropped from both — they're\n// preserved on the settings side via MergePickerResults when they belong to a\n// picker-unaware agent entry.\nfunc SplitSavedPicks(saved []string, builtins []skilldiscovery.CuratedSkill, discovered []agent.DiscoveredSkill) ([]string, []string) {\n\tbuiltinNames := make(map[string]struct{}, len(builtins))\n\tfor _, b := range builtins {\n\t\tbuiltinNames[b.Name] = struct{}{}\n\t}\n\tdiscoveredNames := make(map[string]struct{}, len(discovered))\n\tfor _, d := range discovered {\n\t\tdiscoveredNames[d.Name] = struct{}{}\n\t}\n\tvar builtinPicks, discoveredPicks []string\n\tfor _, s := range saved {\n\t\tif _, ok := builtinNames[s]; ok {\n\t\t\tbuiltinPicks = append(builtinPicks, s)\n\t\t\tcontinue\n\t\t}\n\t\tif _, ok := discoveredNames[s]; ok {\n\t\t\tdiscoveredPicks = append(discoveredPicks, s)\n\t\t}\n\t}\n\treturn builtinPicks, discoveredPicks\n}\n\n// preselectedSet turns a slice pointer's current contents into a lookup\n// set for the picker's \"previously-saved\" pre-selection.\nfunc preselectedSet(slice *[]string) map[string]struct{} {\n\tif slice == nil || len(*slice) == 0 {\n\t\treturn nil\n\t}\n\tout := make(map[string]struct{}, len(*slice))\n\tfor _, s := range *slice {\n\t\tout[s] = struct{}{}\n\t}\n\treturn out\n}\n\nfunc builtinNameSet(curated []skilldiscovery.CuratedSkill) map[string]struct{} {\n\tset := make(map[string]struct{}, len(curated))\n\tfor _, c := range curated {\n\t\tset[c.Name] = struct{}{}\n\t}\n\treturn set\n}\n\n// filterOutBuiltinCollisions drops any discovered skill whose name collides\n// with a curated built-in. Built-in wins because it carries a richer,\n// hand-authored description.\nfunc filterOutBuiltinCollisions(discovered []agent.DiscoveredSkill, builtins map[string]struct{}) []agent.DiscoveredSkill {\n\tif len(discovered) == 0 || len(builtins) == 0 {\n\t\treturn discovered\n\t}\n\tout := make([]agent.DiscoveredSkill, 0, len(discovered))\n\tfor _, d := range discovered {\n\t\tif _, clash := builtins[d.Name]; clash {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, d)\n\t}\n\treturn out\n}\n\nfunc dedupeStrings(xs []string) []string {\n\tif len(xs) == 0 {\n\t\treturn xs\n\t}\n\tseen := make(map[string]struct{}, len(xs))\n\tout := make([]string, 0, len(xs))\n\tfor _, x := range xs {\n\t\tif _, ok := seen[x]; ok {\n\t\t\tcontinue\n\t\t}\n\t\tseen[x] = struct{}{}\n\t\tout = append(out, x)\n\t}\n\treturn out\n}\n","numLines":654,"startLine":1,"totalLines":654}},"sourceToolAssistantUUID":"914c7359-4fe6-4b82-b2c6-bf4b5aabcd83","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-2","sessionId":"c91325f1-f623-48a0-8787-23aa038adae3","version":"2.1.140","gitBranch":"slow-codex-in-review"}
