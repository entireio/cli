{"parentUuid":"3b2a1bf4-8c51-4cdc-b159-c02045f2556f","isSidechain":false,"promptId":"891d5982-ea2f-4717-8ede-ff99d7b73714","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0157WjVe9twkBVgRkcBjHiWV","type":"tool_result","content":"1\t// Package settings provides configuration loading for Entire.\n2\t// This package is separate from cli to allow strategy package to import it\n3\t// without creating an import cycle (cli imports strategy).\n4\tpackage settings\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"context\"\n9\t\t\"encoding/json\"\n10\t\t\"fmt\"\n11\t\t\"os\"\n12\t\t\"path/filepath\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"sync\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n19\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n20\t)\n21\t\n22\tconst (\n23\t\t// EntireSettingsFile is the path to the Entire settings file\n24\t\tEntireSettingsFile = \".entire/settings.json\"\n25\t\t// EntireSettingsLocalFile is the path to the local settings override file (not committed)\n26\t\tEntireSettingsLocalFile = \".entire/settings.local.json\"\n27\t\t// defaultGenerationRetentionDays is the default retention window for archived\n28\t\t// checkpoints v2 raw-transcript generations when no override is configured.\n29\t\tdefaultGenerationRetentionDays = 14\n30\t)\n31\t\n32\tvar checkpointsVersionWarningOnce sync.Once\n33\t\n34\t// Commit linking mode constants.\n35\tconst (\n36\t\t// CommitLinkingAlways auto-links commits to sessions without prompting.\n37\t\tCommitLinkingAlways = \"always\"\n38\t\t// CommitLinkingPrompt prompts the user on each commit (default for existing users).\n39\t\tCommitLinkingPrompt = \"prompt\"\n40\t)\n41\t\n42\t// EntireSettings represents the .entire/settings.json configuration\n43\ttype EntireSettings struct {\n44\t\t// Enabled indicates whether Entire is active. When false, CLI commands\n45\t\t// show a disabled message and hooks exit silently. Defaults to true.\n46\t\tEnabled bool `json:\"enabled\"`\n47\t\n48\t\t// LocalDev indicates whether to use \"go run\" instead of the \"entire\" binary\n49\t\t// This is used for development when the binary is not installed\n50\t\tLocalDev bool `json:\"local_dev,omitempty\"`\n51\t\n52\t\t// LogLevel sets the logging verbosity (debug, info, warn, error).\n53\t\t// Can be overridden by ENTIRE_LOG_LEVEL environment variable.\n54\t\t// Defaults to \"info\".\n55\t\tLogLevel string `json:\"log_level,omitempty\"`\n56\t\n57\t\t// StrategyOptions contains strategy-specific configuration\n58\t\tStrategyOptions map[string]any `json:\"strategy_options,omitempty\"`\n59\t\n60\t\t// AbsoluteGitHookPath embeds the full binary path in git hooks instead of\n61\t\t// bare \"entire\". This is needed for GUI git clients (Xcode, Tower, etc.)\n62\t\t// that don't source shell profiles and can't find \"entire\" on PATH.\n63\t\tAbsoluteGitHookPath bool `json:\"absolute_git_hook_path,omitempty\"`\n64\t\n65\t\t// Telemetry controls anonymous usage analytics.\n66\t\t// nil = not asked yet (show prompt), true = opted in, false = opted out\n67\t\tTelemetry *bool `json:\"telemetry,omitempty\"`\n68\t\n69\t\t// Redaction configures PII redaction behavior for transcripts and metadata.\n70\t\tRedaction *RedactionSettings `json:\"redaction,omitempty\"`\n71\t\n72\t\t// Review maps agent name (e.g. \"claude-code\") to the review config for\n73\t\t// that agent. When empty, `entire review` triggers the first-run picker.\n74\t\tReview map[string]ReviewConfig `json:\"review,omitempty\"`\n75\t\n76\t\t// ReviewFixAgent is the default agent used when applying aggregate or\n77\t\t// multi-agent review findings with `entire review --fix`.\n78\t\tReviewFixAgent string `json:\"review_fix_agent,omitempty\"`\n79\t\n80\t\t// CommitLinking controls how commits are linked to agent sessions.\n81\t\t// \"always\" = auto-link without prompting, \"prompt\" = ask on each commit.\n82\t\t// Defaults to \"prompt\" (preserves existing user behavior).\n83\t\tCommitLinking string `json:\"commit_linking,omitempty\"`\n84\t\n85\t\t// ExternalAgents enables discovery and registration of external agent\n86\t\t// plugins (entire-agent-* binaries on $PATH). Defaults to false.\n87\t\tExternalAgents bool `json:\"external_agents,omitempty\"`\n88\t\n89\t\t// SummaryGeneration stores provider preferences for explain --generate.\n90\t\t// This is separate from strategy_options.summarize, which controls\n91\t\t// checkpoint auto-summarize behavior.\n92\t\tSummaryGeneration *SummaryGenerationSettings `json:\"summary_generation,omitempty\"`\n93\t\n94\t\t// Vercel indicates that the repository uses Vercel and the metadata branch\n95\t\t// should include a vercel.json that disables deployments for Entire branches.\n96\t\tVercel bool `json:\"vercel,omitempty\"`\n97\t\n98\t\t// SummaryTimeoutSeconds is an optional hard deadline (in seconds) for\n99\t\t// `entire explain --generate` summary generation. Zero or negative means\n100\t\t// \"unset\" -- the caller picks the default. Not yet consumed by the\n101\t\t// generate path; present so settings round-trip for a follow-up change\n102\t\t// that wires it into the deadline selection.\n103\t\tSummaryTimeoutSeconds int `json:\"summary_timeout_seconds,omitempty\"`\n104\t\n105\t\t// SignCheckpointCommits controls whether checkpoint commits are signed.\n106\t\t// nil/true = sign (default), false = skip signing.\n107\t\tSignCheckpointCommits *bool `json:\"sign_checkpoint_commits,omitempty\"`\n108\t\n109\t\t// Deprecated: no longer used. Exists to tolerate old settings files\n110\t\t// that still contain \"strategy\": \"auto-commit\" or similar.\n111\t\tStrategy string `json:\"strategy,omitempty\"`\n112\t}\n113\t\n114\t// SummaryGenerationSettings configures provider selection for on-demand\n115\t// checkpoint summaries generated by explain --generate.\n116\ttype SummaryGenerationSettings struct {\n117\t\t// Provider is the selected summary provider agent name\n118\t\t// (for example \"claude-code\", \"codex\", or \"gemini\").\n119\t\tProvider string `json:\"provider,omitempty\"`\n120\t\n121\t\t// Model is an optional model hint passed to the selected provider.\n122\t\tModel string `json:\"model,omitempty\"`\n123\t}\n124\t\n125\t// Validate returns an error if the settings combination is semantically invalid.\n126\t// A model without a provider is meaningless: the model hint needs a provider to\n127\t// route to. The load path calls Validate() after merging, catching hand-edited\n128\t// files that land in this state.\n129\tfunc (s *SummaryGenerationSettings) Validate() error {\n130\t\tif s == nil {\n131\t\t\treturn nil\n132\t\t}\n133\t\tif s.Model != \"\" && s.Provider == \"\" {\n134\t\t\treturn fmt.Errorf(\"summary_generation.model %q set without summary_generation.provider\", s.Model)\n135\t\t}\n136\t\treturn nil\n137\t}\n138\t\n139\t// SetProvider updates the provider and optionally the model, clearing any stale\n140\t// model from the previous provider when switching without a replacement.\n141\t// An empty newProvider preserves the current provider; an empty newModel\n142\t// preserves the current model unless the provider is changing, in which case\n143\t// the old model is cleared to avoid passing (say) a Claude model to Codex.\n144\tfunc (s *SummaryGenerationSettings) SetProvider(newProvider, newModel string) {\n145\t\tif s == nil {\n146\t\t\treturn\n147\t\t}\n148\t\tif newProvider != \"\" && s.Provider != \"\" && s.Provider != newProvider && newModel == \"\" {\n149\t\t\ts.Model = \"\"\n150\t\t}\n151\t\tif newProvider != \"\" {\n152\t\t\ts.Provider = newProvider\n153\t\t}\n154\t\tif newModel != \"\" {\n155\t\t\ts.Model = newModel\n156\t\t}\n157\t}\n158\t\n159\t// RedactionSettings configures redaction behavior beyond the default secret detection.\n160\ttype RedactionSettings struct {\n161\t\tPII *PIISettings `json:\"pii,omitempty\"`\n162\t}\n163\t\n164\t// PIISettings configures PII detection categories.\n165\t// When Enabled is true, email and phone default to true; address defaults to false.\n166\ttype PIISettings struct {\n167\t\tEnabled        bool              `json:\"enabled\"`\n168\t\tEmail          *bool             `json:\"email,omitempty\"`\n169\t\tPhone          *bool             `json:\"phone,omitempty\"`\n170\t\tAddress        *bool             `json:\"address,omitempty\"`\n171\t\tCustomPatterns map[string]string `json:\"custom_patterns,omitempty\"`\n172\t}\n173\t\n174\t// GetCommitLinking returns the effective commit linking mode.\n175\t// Returns the explicit value if set, otherwise defaults to \"prompt\"\n176\t// to preserve existing user behavior.\n177\tfunc (s *EntireSettings) GetCommitLinking() string {\n178\t\tif s.CommitLinking != \"\" {\n179\t\t\treturn s.CommitLinking\n180\t\t}\n181\t\treturn CommitLinkingPrompt\n182\t}\n183\t\n184\t// SummaryTimeoutValue returns the configured hard deadline for\n185\t// `entire explain --generate` summary generation. Zero means \"unset\" --\n186\t// the caller picks the default. Negative values are treated as unset.\n187\tfunc (s *EntireSettings) SummaryTimeoutValue() time.Duration {\n188\t\tif s.SummaryTimeoutSeconds < 1 {\n189\t\t\treturn 0\n190\t\t}\n191\t\treturn time.Duration(s.SummaryTimeoutSeconds) * time.Second\n192\t}\n193\t\n194\t// ReviewConfig holds the per-agent review configuration. Both fields are\n195\t// optional; together they describe what `entire review` should ask the\n196\t// agent to do.\n197\t//\n198\t// Precedence when composing the review prompt sent to the agent:\n199\t//   - If Prompt is non-empty, it is used verbatim.\n200\t//   - Otherwise, Skills are composed into a default template\n201\t//     (\"Please run these review skills in order: 1. /X 2. /Y\").\n202\t//\n203\t// Skills are always recorded on the checkpoint metadata regardless of\n204\t// which path composed the prompt — they're the structured, queryable\n205\t// tag alongside ReviewPrompt (which is the ground truth).\n206\ttype ReviewConfig struct {\n207\t\t// Skills is the list of slash-prefixed skill invocations configured\n208\t\t// for this agent. May be empty when Prompt carries the full request.\n209\t\tSkills []string `json:\"skills,omitempty\"`\n210\t\n211\t\t// Prompt, when non-empty, carries saved review instructions. When\n212\t\t// Skills is non-empty it is appended after the selected skills; when\n213\t\t// Skills is empty it is the full prompt for prompt-only review configs.\n214\t\tPrompt string `json:\"prompt,omitempty\"`\n215\t}\n216\t\n217\t// IsZero reports whether the config is effectively unset.\n218\tfunc (c ReviewConfig) IsZero() bool {\n219\t\treturn len(c.Skills) == 0 && c.Prompt == \"\"\n220\t}\n221\t\n222\t// ReviewConfigFor returns the configured review config for the given agent.\n223\t// Returns a zero-value config when the agent has no entry; callers should\n224\t// check IsZero (or the individual fields) to decide whether configuration\n225\t// is present.\n226\tfunc (s *EntireSettings) ReviewConfigFor(agentName string) ReviewConfig {\n227\t\tif s == nil {\n228\t\t\treturn ReviewConfig{}\n229\t\t}\n230\t\treturn s.Review[agentName]\n231\t}\n232\t\n233\t// Load loads the Entire settings from .entire/settings.json,\n234\t// then applies any overrides from .entire/settings.local.json if it exists.\n235\t// Returns default settings if neither file exists.\n236\t// Works correctly from any subdirectory within the repository.\n237\tfunc Load(ctx context.Context) (*EntireSettings, error) {\n238\t\t// Get absolute paths for settings files\n239\t\tsettingsFileAbs, err := paths.AbsPath(ctx, EntireSettingsFile)\n240\t\tif err != nil {\n241\t\t\tsettingsFileAbs = EntireSettingsFile // Fallback to relative\n242\t\t}\n243\t\tlocalSettingsFileAbs, err := paths.AbsPath(ctx, EntireSettingsLocalFile)\n244\t\tif err != nil {\n245\t\t\tlocalSettingsFileAbs = EntireSettingsLocalFile // Fallback to relative\n246\t\t}\n247\t\n248\t\treturn loadMergedSettings(settingsFileAbs, localSettingsFileAbs)\n249\t}\n250\t\n251\tfunc loadMergedSettings(settingsFileAbs, localSettingsFileAbs string) (*EntireSettings, error) {\n252\t\t// Load base settings\n253\t\tsettings, err := loadFromFile(settingsFileAbs)\n254\t\tif err != nil {\n255\t\t\treturn nil, fmt.Errorf(\"reading settings file: %w\", err)\n256\t\t}\n257\t\n258\t\t// Apply local overrides if they exist\n259\t\tlocalData, err := os.ReadFile(localSettingsFileAbs) //nolint:gosec // path is from AbsPath or constant\n260\t\tif err != nil {\n261\t\t\tif !os.IsNotExist(err) {\n262\t\t\t\treturn nil, fmt.Errorf(\"reading local settings file: %w\", err)\n263\t\t\t}\n264\t\t\t// Local file doesn't exist, continue without overrides\n265\t\t} else {\n266\t\t\tif err := mergeJSON(settings, localData); err != nil {\n267\t\t\t\treturn nil, fmt.Errorf(\"merging local settings: %w\", err)\n268\t\t\t}\n269\t\t}\n270\t\n271\t\t// Re-validate after merge. Individual files are validated by loadFromFile,\n272\t\t// but mergeJSON patches fields independently and can produce combinations\n273\t\t// (e.g. model without provider when the local override sets only a model\n274\t\t// on top of a base with no provider) that neither file alone contained.\n275\t\tif err := settings.SummaryGeneration.Validate(); err != nil {\n276\t\t\treturn nil, fmt.Errorf(\"merged settings invalid: %w\", err)\n277\t\t}\n278\t\n279\t\treturn settings, nil\n280\t}\n281\t\n282\t// LoadFromFile loads settings from a specific file path without merging local overrides.\n283\t// Returns default settings if the file doesn't exist.\n284\t// Use this when you need to display individual settings files separately.\n285\tfunc LoadFromFile(filePath string) (*EntireSettings, error) {\n286\t\treturn loadFromFile(filePath)\n287\t}\n288\t\n289\t// LoadFromBytes parses settings from raw JSON bytes without merging local overrides.\n290\t// Use this when you have settings content from a non-file source (e.g., git show).\n291\tfunc LoadFromBytes(data []byte) (*EntireSettings, error) {\n292\t\ts := &EntireSettings{Enabled: true}\n293\t\tdec := json.NewDecoder(bytes.NewReader(data))\n294\t\tdec.DisallowUnknownFields()\n295\t\tif err := dec.Decode(s); err != nil {\n296\t\t\treturn nil, fmt.Errorf(\"parsing settings: %w\", err)\n297\t\t}\n298\t\treturn s, nil\n299\t}\n300\t\n301\t// loadFromFile loads settings from a specific file path.\n302\t// Returns default settings if the file doesn't exist.\n303\tfunc loadFromFile(filePath string) (*EntireSettings, error) {\n304\t\tsettings := &EntireSettings{\n305\t\t\tEnabled: true, // Default to enabled\n306\t\t}\n307\t\n308\t\tdata, err := os.ReadFile(filePath) //nolint:gosec // path is from caller\n309\t\tif err != nil {\n310\t\t\tif os.IsNotExist(err) {\n311\t\t\t\treturn settings, nil\n312\t\t\t}\n313\t\t\treturn nil, fmt.Errorf(\"%w\", err)\n314\t\t}\n315\t\n316\t\tdec := json.NewDecoder(bytes.NewReader(data))\n317\t\tdec.DisallowUnknownFields()\n318\t\tif err := dec.Decode(settings); err != nil {\n319\t\t\treturn nil, fmt.Errorf(\"parsing settings file: %w\", err)\n320\t\t}\n321\t\n322\t\t// Validate commit_linking if set\n323\t\tif settings.CommitLinking != \"\" && settings.CommitLinking != CommitLinkingAlways && settings.CommitLinking != CommitLinkingPrompt {\n324\t\t\treturn nil, fmt.Errorf(\"invalid commit_linking value %q: must be %q or %q\", settings.CommitLinking, CommitLinkingAlways, CommitLinkingPrompt)\n325\t\t}\n326\t\n327\t\t// SummaryGeneration is NOT validated here — individual files may\n328\t\t// legitimately contain only a model (provider comes from another file).\n329\t\t// Validation happens after merge in Load().\n330\t\n331\t\treturn settings, nil\n332\t}\n333\t\n334\t// mergeJSON merges JSON data into existing settings.\n335\t// Only non-zero values from the JSON override existing settings.\n336\tfunc mergeJSON(settings *EntireSettings, data []byte) error {\n337\t\t// Validate that there are no unknown keys using strict decoding.\n338\t\tdec := json.NewDecoder(bytes.NewReader(data))\n339\t\tdec.DisallowUnknownFields()\n340\t\tvar temp EntireSettings\n341\t\tif err := dec.Decode(&temp); err != nil {\n342\t\t\treturn fmt.Errorf(\"parsing JSON: %w\", err)\n343\t\t}\n344\t\n345\t\t// Parse into a map to check which fields are present.\n346\t\tvar raw map[string]json.RawMessage\n347\t\tif err := json.Unmarshal(data, &raw); err != nil {\n348\t\t\treturn fmt.Errorf(\"parsing JSON: %w\", err)\n349\t\t}\n350\t\n351\t\tif err := mergeScalarFields(settings, raw); err != nil {\n352\t\t\treturn err\n353\t\t}\n354\t\tif err := mergeStrategyOptions(settings, raw); err != nil {\n355\t\t\treturn err\n356\t\t}\n357\t\tif err := mergeSummaryGeneration(settings, raw); err != nil {\n358\t\t\treturn err\n359\t\t}\n360\t\tif err := mergeCommitLinking(settings, raw); err != nil {\n361\t\t\treturn err\n362\t\t}\n363\t\n364\t\t// Merge redaction sub-fields if present (field-level, not wholesale replace).\n365\t\tif redactionRaw, ok := raw[\"redaction\"]; ok {\n366\t\t\tif settings.Redaction == nil {\n367\t\t\t\tsettings.Redaction = &RedactionSettings{}\n368\t\t\t}\n369\t\t\tif err := mergeRedaction(settings.Redaction, redactionRaw); err != nil {\n370\t\t\t\treturn fmt.Errorf(\"parsing redaction field: %w\", err)\n371\t\t\t}\n372\t\t}\n373\t\n374\t\treturn nil\n375\t}\n376\t\n377\t// mergeScalarFields merges simple bool, *bool, string, and int fields from raw JSON.\n378\tfunc mergeScalarFields(settings *EntireSettings, raw map[string]json.RawMessage) error {\n379\t\tif err := mergeRawBool(raw, \"enabled\", &settings.Enabled); err != nil {\n380\t\t\treturn err\n381\t\t}\n382\t\tif err := mergeRawBool(raw, \"local_dev\", &settings.LocalDev); err != nil {\n383\t\t\treturn err\n384\t\t}\n385\t\tif err := mergeRawBool(raw, \"absolute_git_hook_path\", &settings.AbsoluteGitHookPath); err != nil {\n386\t\t\treturn err\n387\t\t}\n388\t\tif err := mergeRawBool(raw, \"external_agents\", &settings.ExternalAgents); err != nil {\n389\t\t\treturn err\n390\t\t}\n391\t\tif err := mergeRawBool(raw, \"vercel\", &settings.Vercel); err != nil {\n392\t\t\treturn err\n393\t\t}\n394\t\tif err := mergeRawBoolPtr(raw, \"telemetry\", &settings.Telemetry); err != nil {\n395\t\t\treturn err\n396\t\t}\n397\t\tif err := mergeRawBoolPtr(raw, \"sign_checkpoint_commits\", &settings.SignCheckpointCommits); err != nil {\n398\t\t\treturn err\n399\t\t}\n400\t\tif err := mergeRawStringNonEmpty(raw, \"log_level\", &settings.LogLevel); err != nil {\n401\t\t\treturn err\n402\t\t}\n403\t\tif err := mergeRawStringNonEmpty(raw, \"review_fix_agent\", &settings.ReviewFixAgent); err != nil {\n404\t\t\treturn err\n405\t\t}\n406\t\tif err := mergeRawInt(raw, \"summary_timeout_seconds\", &settings.SummaryTimeoutSeconds); err != nil {\n407\t\t\treturn err\n408\t\t}\n409\t\treturn nil\n410\t}\n411\t\n412\tfunc mergeRawBool(raw map[string]json.RawMessage, key string, dst *bool) error {\n413\t\tv, ok := raw[key]\n414\t\tif !ok {\n415\t\t\treturn nil\n416\t\t}\n417\t\treturn unmarshalField(key, v, dst)\n418\t}\n419\t\n420\tfunc mergeRawBoolPtr(raw map[string]json.RawMessage, key string, dst **bool) error {\n421\t\tv, ok := raw[key]\n422\t\tif !ok {\n423\t\t\treturn nil\n424\t\t}\n425\t\tvar b bool\n426\t\tif err := unmarshalField(key, v, &b); err != nil {\n427\t\t\treturn err\n428\t\t}\n429\t\t*dst = &b\n430\t\treturn nil\n431\t}\n432\t\n433\tfunc mergeRawStringNonEmpty(raw map[string]json.RawMessage, key string, dst *string) error {\n434\t\tv, ok := raw[key]\n435\t\tif !ok {\n436\t\t\treturn nil\n437\t\t}\n438\t\tvar s string\n439\t\tif err := unmarshalField(key, v, &s); err != nil {\n440\t\t\treturn err\n441\t\t}\n442\t\tif s != \"\" {\n443\t\t\t*dst = s\n444\t\t}\n445\t\treturn nil\n446\t}\n447\t\n448\tfunc mergeRawInt(raw map[string]json.RawMessage, key string, dst *int) error {\n449\t\tv, ok := raw[key]\n450\t\tif !ok {\n451\t\t\treturn nil\n452\t\t}\n453\t\treturn unmarshalField(key, v, dst)\n454\t}\n455\t\n456\tfunc unmarshalField(key string, data json.RawMessage, dst any) error {\n457\t\tif err := json.Unmarshal(data, dst); err != nil {\n458\t\t\treturn fmt.Errorf(\"parsing %s field: %w\", key, err)\n459\t\t}\n460\t\treturn nil\n461\t}\n462\t\n463\tfunc mergeStrategyOptions(settings *EntireSettings, raw map[string]json.RawMessage) error {\n464\t\toptionsRaw, ok := raw[\"strategy_options\"]\n465\t\tif !ok {\n466\t\t\treturn nil\n467\t\t}\n468\t\tvar opts map[string]any\n469\t\tif err := unmarshalField(\"strategy_options\", optionsRaw, &opts); err != nil {\n470\t\t\treturn err\n471\t\t}\n472\t\tif settings.StrategyOptions == nil {\n473\t\t\tsettings.StrategyOptions = opts\n474\t\t} else {\n475\t\t\tfor k, v := range opts {\n476\t\t\t\tsettings.StrategyOptions[k] = v\n477\t\t\t}\n478\t\t}\n479\t\treturn nil\n480\t}\n481\t\n482\tfunc mergeSummaryGeneration(settings *EntireSettings, raw map[string]json.RawMessage) error {\n483\t\tsummaryRaw, ok := raw[\"summary_generation\"]\n484\t\tif !ok {\n485\t\t\treturn nil\n486\t\t}\n487\t\tif settings.SummaryGeneration == nil {\n488\t\t\tsettings.SummaryGeneration = &SummaryGenerationSettings{}\n489\t\t}\n490\t\n491\t\tvar summaryFields map[string]json.RawMessage\n492\t\tif err := unmarshalField(\"summary_generation\", summaryRaw, &summaryFields); err != nil {\n493\t\t\treturn err\n494\t\t}\n495\t\n496\t\t_, modelInOverride := summaryFields[\"model\"]\n497\t\n498\t\tif providerRaw, ok := summaryFields[\"provider\"]; ok {\n499\t\t\tvar provider string\n500\t\t\tif err := unmarshalField(\"summary_generation.provider\", providerRaw, &provider); err != nil {\n501\t\t\t\treturn err\n502\t\t\t}\n503\t\t\t// If the override switches providers without also setting a model,\n504\t\t\t// the base's model was tuned to the old provider and would likely\n505\t\t\t// cause a runtime failure when handed to the new one (e.g. codex\n506\t\t\t// rejecting \"sonnet\"). Clear it so the new provider falls back to\n507\t\t\t// its own default.\n508\t\t\tif provider != settings.SummaryGeneration.Provider && !modelInOverride {\n509\t\t\t\tsettings.SummaryGeneration.Model = \"\"\n510\t\t\t}\n511\t\t\tsettings.SummaryGeneration.Provider = provider\n512\t\t}\n513\t\n514\t\tif modelRaw, ok := summaryFields[\"model\"]; ok {\n515\t\t\tvar model string\n516\t\t\tif err := unmarshalField(\"summary_generation.model\", modelRaw, &model); err != nil {\n517\t\t\t\treturn err\n518\t\t\t}\n519\t\t\tsettings.SummaryGeneration.Model = model\n520\t\t}\n521\t\treturn nil\n522\t}\n523\t\n524\tfunc mergeCommitLinking(settings *EntireSettings, raw map[string]json.RawMessage) error {\n525\t\tcommitLinkingRaw, ok := raw[\"commit_linking\"]\n526\t\tif !ok {\n527\t\t\treturn nil\n528\t\t}\n529\t\tvar cl string\n530\t\tif err := unmarshalField(\"commit_linking\", commitLinkingRaw, &cl); err != nil {\n531\t\t\treturn err\n532\t\t}\n533\t\tif cl == \"\" {\n534\t\t\treturn nil\n535\t\t}\n536\t\tswitch cl {\n537\t\tcase CommitLinkingAlways, CommitLinkingPrompt:\n538\t\t\tsettings.CommitLinking = cl\n539\t\tdefault:\n540\t\t\treturn fmt.Errorf(\"invalid commit_linking value %q: must be %q or %q\", cl, CommitLinkingAlways, CommitLinkingPrompt)\n541\t\t}\n542\t\treturn nil\n543\t}\n544\t\n545\t// mergeRedaction merges redaction overrides into existing RedactionSettings.\n546\t// Only fields present in the override JSON are applied.\n547\tfunc mergeRedaction(dst *RedactionSettings, data json.RawMessage) error {\n548\t\tvar raw map[string]json.RawMessage\n549\t\tif err := json.Unmarshal(data, &raw); err != nil {\n550\t\t\treturn fmt.Errorf(\"parsing redaction: %w\", err)\n551\t\t}\n552\t\tif piiRaw, ok := raw[\"pii\"]; ok {\n553\t\t\tif dst.PII == nil {\n554\t\t\t\tdst.PII = &PIISettings{}\n555\t\t\t}\n556\t\t\tif err := mergePIISettings(dst.PII, piiRaw); err != nil {\n557\t\t\t\treturn err\n558\t\t\t}\n559\t\t}\n560\t\treturn nil\n561\t}\n562\t\n563\t// mergePIISettings merges PII overrides into existing PIISettings.\n564\t// Only fields present in the override JSON are applied; missing fields\n565\t// are preserved from the base settings.\n566\tfunc mergePIISettings(dst *PIISettings, data json.RawMessage) error {\n567\t\tvar raw map[string]json.RawMessage\n568\t\tif err := json.Unmarshal(data, &raw); err != nil {\n569\t\t\treturn fmt.Errorf(\"parsing pii: %w\", err)\n570\t\t}\n571\t\tif v, ok := raw[\"enabled\"]; ok {\n572\t\t\tif err := json.Unmarshal(v, &dst.Enabled); err != nil {\n573\t\t\t\treturn fmt.Errorf(\"parsing pii.enabled: %w\", err)\n574\t\t\t}\n575\t\t}\n576\t\tif v, ok := raw[\"email\"]; ok {\n577\t\t\tvar b bool\n578\t\t\tif err := json.Unmarshal(v, &b); err != nil {\n579\t\t\t\treturn fmt.Errorf(\"parsing pii.email: %w\", err)\n580\t\t\t}\n581\t\t\tdst.Email = &b\n582\t\t}\n583\t\tif v, ok := raw[\"phone\"]; ok {\n584\t\t\tvar b bool\n585\t\t\tif err := json.Unmarshal(v, &b); err != nil {\n586\t\t\t\treturn fmt.Errorf(\"parsing pii.phone: %w\", err)\n587\t\t\t}\n588\t\t\tdst.Phone = &b\n589\t\t}\n590\t\tif v, ok := raw[\"address\"]; ok {\n591\t\t\tvar b bool\n592\t\t\tif err := json.Unmarshal(v, &b); err != nil {\n593\t\t\t\treturn fmt.Errorf(\"parsing pii.address: %w\", err)\n594\t\t\t}\n595\t\t\tdst.Address = &b\n596\t\t}\n597\t\tif v, ok := raw[\"custom_patterns\"]; ok {\n598\t\t\tvar cp map[string]string\n599\t\t\tif err := json.Unmarshal(v, &cp); err != nil {\n600\t\t\t\treturn fmt.Errorf(\"parsing pii.custom_patterns: %w\", err)\n601\t\t\t}\n602\t\t\tif dst.CustomPatterns == nil {\n603\t\t\t\tdst.CustomPatterns = cp\n604\t\t\t} else {\n605\t\t\t\tfor k, val := range cp {\n606\t\t\t\t\tdst.CustomPatterns[k] = val\n607\t\t\t\t}\n608\t\t\t}\n609\t\t}\n610\t\treturn nil\n611\t}\n612\t\n613\t// IsSetUp returns true if Entire has been set up in the current repository.\n614\t// This checks if .entire/settings.json exists.\n615\t// Use this to avoid creating files/directories in repos where Entire was never enabled.\n616\tfunc IsSetUp(ctx context.Context) bool {\n617\t\tsettingsFileAbs, err := paths.AbsPath(ctx, EntireSettingsFile)\n618\t\tif err != nil {\n619\t\t\treturn false\n620\t\t}\n621\t\t_, err = os.Stat(settingsFileAbs)\n622\t\treturn err == nil\n623\t}\n624\t\n625\t// IsSetUpAny returns true if Entire has been set up in the current repository,\n626\t// checking both .entire/settings.json and .entire/settings.local.json.\n627\t// Use this to detect any prior setup, even if only local settings exist.\n628\tfunc IsSetUpAny(ctx context.Context) bool {\n629\t\tif IsSetUp(ctx) {\n630\t\t\treturn true\n631\t\t}\n632\t\tlocalFileAbs, err := paths.AbsPath(ctx, EntireSettingsLocalFile)\n633\t\tif err != nil {\n634\t\t\treturn false\n635\t\t}\n636\t\t_, err = os.Lstat(localFileAbs)\n637\t\treturn err == nil\n638\t}\n639\t\n640\t// IsSetUpAndEnabled returns true if Entire is both set up and enabled.\n641\t// This checks if .entire/settings.json exists AND has enabled: true.\n642\t// Use this for hooks that should be no-ops when Entire is not active.\n643\tfunc IsSetUpAndEnabled(ctx context.Context) bool {\n644\t\tif !IsSetUp(ctx) {\n645\t\t\treturn false\n646\t\t}\n647\t\ts, err := Load(ctx)\n648\t\tif err != nil {\n649\t\t\treturn false\n650\t\t}\n651\t\treturn s.Enabled\n652\t}\n653\t\n654\t// IsCheckpointsV2Enabled checks if checkpoints v2 is enabled in settings.\n655\t// Returns false by default if settings cannot be loaded or the key is missing.\n656\tfunc IsCheckpointsV2Enabled(ctx context.Context) bool {\n657\t\tsettings, err := Load(ctx)\n658\t\tif err != nil {\n659\t\t\treturn false\n660\t\t}\n661\t\treturn settings.IsCheckpointsV2Enabled()\n662\t}\n663\t\n664\t// CheckpointsVersion returns the configured checkpoints format version, or 1\n665\t// if settings cannot be loaded or the value is unset/invalid.\n666\tfunc CheckpointsVersion(ctx context.Context) int {\n667\t\ts, err := Load(ctx)\n668\t\tif err != nil {\n669\t\t\treturn 1\n670\t\t}\n671\t\tversion := s.CheckpointsVersion()\n672\t\tif s.StrategyOptions != nil {\n673\t\t\tif configured, ok := s.StrategyOptions[\"checkpoints_version\"]; ok {\n674\t\t\t\tif _, supported := parseCheckpointsVersion(configured); !supported {\n675\t\t\t\t\tcheckpointsVersionWarningOnce.Do(func() {\n676\t\t\t\t\t\tfmt.Fprintf(os.Stderr,\n677\t\t\t\t\t\t\t\"[entire] unsupported strategy_options.checkpoints_version %v detected in settings. Falling back to the default version (1).\\n\",\n678\t\t\t\t\t\t\tconfigured,\n679\t\t\t\t\t\t)\n680\t\t\t\t\t})\n681\t\t\t\t}\n682\t\t\t}\n683\t\t}\n684\t\treturn version\n685\t}\n686\t\n687\t// IsPushV2RefsEnabled checks if pushing v2 refs is enabled in settings.\n688\t// Returns false by default if settings cannot be loaded or flags are missing.\n689\tfunc IsPushV2RefsEnabled(ctx context.Context) bool {\n690\t\ts, err := Load(ctx)\n691\t\tif err != nil {\n692\t\t\treturn false\n693\t\t}\n694\t\treturn s.IsPushV2RefsEnabled()\n695\t}\n696\t\n697\t// IsFilteredFetchesEnabled checks if filtered fetches should be used.\n698\t// When enabled, filtered fetches always resolve remote names to URLs first so\n699\t// git does not persist promisor settings onto named remotes in local config.\n700\t// Returns false by default.\n701\tfunc IsFilteredFetchesEnabled(ctx context.Context) bool {\n702\t\ts, err := Load(ctx)\n703\t\tif err != nil {\n704\t\t\treturn false\n705\t\t}\n706\t\treturn s.IsFilteredFetchesEnabled()\n707\t}\n708\t\n709\t// IsSummarizeEnabled checks if auto-summarize is enabled in settings.\n710\t// Returns false by default if settings cannot be loaded or the key is missing.\n711\tfunc IsSummarizeEnabled(ctx context.Context) bool {\n712\t\tsettings, err := Load(ctx)\n713\t\tif err != nil {\n714\t\t\treturn false\n715\t\t}\n716\t\treturn settings.IsSummarizeEnabled()\n717\t}\n718\t\n719\t// IsSummarizeEnabled checks if auto-summarize is enabled in this settings instance.\n720\tfunc (s *EntireSettings) IsSummarizeEnabled() bool {\n721\t\tif s.StrategyOptions == nil {\n722\t\t\treturn false\n723\t\t}\n724\t\tsummarizeOpts, ok := s.StrategyOptions[\"summarize\"].(map[string]any)\n725\t\tif !ok {\n726\t\t\treturn false\n727\t\t}\n728\t\tenabled, ok := summarizeOpts[\"enabled\"].(bool)\n729\t\tif !ok {\n730\t\t\treturn false\n731\t\t}\n732\t\treturn enabled\n733\t}\n734\t\n735\t// CheckpointRemoteConfig holds the structured checkpoint remote configuration.\n736\t// Stored in strategy_options.checkpoint_remote as {\"provider\": \"github\", \"repo\": \"org/repo\"}.\n737\ttype CheckpointRemoteConfig struct {\n738\t\tProvider string // e.g., \"github\"\n739\t\tRepo     string // e.g., \"org/checkpoints-repo\"\n740\t}\n741\t\n742\t// Owner returns the owner portion of the repo field (before the slash).\n743\t// Returns empty string if the repo field doesn't contain a slash.\n744\tfunc (c *CheckpointRemoteConfig) Owner() string {\n745\t\tparts := strings.SplitN(c.Repo, \"/\", 2)\n746\t\tif len(parts) < 2 {\n747\t\t\treturn \"\"\n748\t\t}\n749\t\treturn parts[0]\n750\t}\n751\t\n752\t// GetCheckpointRemote returns the configured checkpoint remote.\n753\t// Expects a structured object: {\"provider\": \"github\", \"repo\": \"org/repo\"}.\n754\t// Returns nil if not configured, wrong type, or missing required fields.\n755\tfunc (s *EntireSettings) GetCheckpointRemote() *CheckpointRemoteConfig {\n756\t\tif s.StrategyOptions == nil {\n757\t\t\treturn nil\n758\t\t}\n759\t\tval, ok := s.StrategyOptions[\"checkpoint_remote\"]\n760\t\tif !ok {\n761\t\t\treturn nil\n762\t\t}\n763\t\tm, ok := val.(map[string]any)\n764\t\tif !ok {\n765\t\t\treturn nil\n766\t\t}\n767\t\tprovider, providerOK := m[\"provider\"].(string)\n768\t\trepo, repoOK := m[\"repo\"].(string)\n769\t\tif !providerOK || !repoOK || provider == \"\" || repo == \"\" {\n770\t\t\treturn nil\n771\t\t}\n772\t\tif !strings.Contains(repo, \"/\") {\n773\t\t\treturn nil\n774\t\t}\n775\t\treturn &CheckpointRemoteConfig{Provider: provider, Repo: repo}\n776\t}\n777\t\n778\t// IsCheckpointsV2Enabled checks if checkpoints v2 is enabled.\n779\t// Returns true when either checkpoints_v2 is set or checkpoints_version is 2.\n780\tfunc (s *EntireSettings) IsCheckpointsV2Enabled() bool {\n781\t\tif s.CheckpointsVersion() == 2 {\n782\t\t\treturn true\n783\t\t}\n784\t\tif s.StrategyOptions == nil {\n785\t\t\treturn false\n786\t\t}\n787\t\tval, ok := s.StrategyOptions[\"checkpoints_v2\"].(bool)\n788\t\treturn ok && val\n789\t}\n790\t\n791\t// CheckpointsVersion returns the configured checkpoints format version from\n792\t// strategy_options.checkpoints_version. Returns 1 when unset, invalid, or\n793\t// unsupported. The currently supported versions are 1 and 2.\n794\tfunc (s *EntireSettings) CheckpointsVersion() int {\n795\t\tif s.StrategyOptions == nil {\n796\t\t\treturn 1\n797\t\t}\n798\t\tval, ok := s.StrategyOptions[\"checkpoints_version\"]\n799\t\tif !ok {\n800\t\t\treturn 1\n801\t\t}\n802\t\tversion, ok := parseCheckpointsVersion(val)\n803\t\tif ok {\n804\t\t\treturn version\n805\t\t}\n806\t\treturn 1\n807\t}\n808\t\n809\tfunc parseCheckpointsVersion(val any) (int, bool) {\n810\t\tv, ok := val.(int)\n811\t\tif ok && (v == 1 || v == 2) {\n812\t\t\treturn v, true\n813\t\t}\n814\t\tfloatV, ok := val.(float64)\n815\t\tif ok && (floatV == 1 || floatV == 2) {\n816\t\t\treturn int(floatV), true\n817\t\t}\n818\t\tstringV, ok := val.(string)\n819\t\tif ok {\n820\t\t\tparsed, err := strconv.Atoi(stringV)\n821\t\t\tif err == nil && (parsed == 1 || parsed == 2) {\n822\t\t\t\treturn parsed, true\n823\t\t\t}\n824\t\t}\n825\t\treturn 1, false\n826\t}\n827\t\n828\t// IsPushV2RefsEnabled checks if pushing v2 refs is enabled.\n829\t// checkpoints_version: 2 forces v2 ref pushes on, regardless of push_v2_refs.\n830\tfunc (s *EntireSettings) IsPushV2RefsEnabled() bool {\n831\t\tif s.CheckpointsVersion() == 2 {\n832\t\t\treturn true\n833\t\t}\n834\t\tif !s.IsCheckpointsV2Enabled() {\n835\t\t\treturn false\n836\t\t}\n837\t\tif s.StrategyOptions == nil {\n838\t\t\treturn false\n839\t\t}\n840\t\tval, ok := s.StrategyOptions[\"push_v2_refs\"].(bool)\n841\t\treturn ok && val\n842\t}\n843\t\n844\t// GetFullTranscriptGenerationRetentionDays returns the retention window for\n845\t// archived checkpoints v2 /full/* generations. Invalid, missing, or\n846\t// non-positive values fall back to the documented default.\n847\tfunc (s *EntireSettings) GetFullTranscriptGenerationRetentionDays() int {\n848\t\tif s.StrategyOptions == nil {\n849\t\t\treturn defaultGenerationRetentionDays\n850\t\t}\n851\t\n852\t\tval, ok := s.StrategyOptions[\"full_transcript_generation_retention_days\"]\n853\t\tif !ok {\n854\t\t\treturn defaultGenerationRetentionDays\n855\t\t}\n856\t\n857\t\tswitch days := val.(type) {\n858\t\tcase int:\n859\t\t\tif days > 0 {\n860\t\t\t\treturn days\n861\t\t\t}\n862\t\tcase float64:\n863\t\t\tintDays := int(days)\n864\t\t\tif intDays > 0 && days == float64(intDays) {\n865\t\t\t\treturn intDays\n866\t\t\t}\n867\t\t}\n868\t\n869\t\treturn defaultGenerationRetentionDays\n870\t}\n871\t\n872\t// IsFilteredFetchesEnabled checks if fetches should use --filter=blob:none.\n873\t// When enabled, filtered fetches always use resolved URLs rather than remote\n874\t// names to avoid persisting promisor settings onto named remotes.\n875\tfunc (s *EntireSettings) IsFilteredFetchesEnabled() bool {\n876\t\tif s.StrategyOptions == nil {\n877\t\t\treturn false\n878\t\t}\n879\t\tval, ok := s.StrategyOptions[\"filtered_fetches\"].(bool)\n880\t\treturn ok && val\n881\t}\n882\t\n883\t// IsPushSessionsDisabled checks if push_sessions is disabled in settings.\n884\t// Returns true if push_sessions is explicitly set to false.\n885\tfunc (s *EntireSettings) IsPushSessionsDisabled() bool {\n886\t\tif s.StrategyOptions == nil {\n887\t\t\treturn false\n888\t\t}\n889\t\tval, exists := s.StrategyOptions[\"push_sessions\"]\n890\t\tif !exists {\n891\t\t\treturn false\n892\t\t}\n893\t\tif boolVal, ok := val.(bool); ok {\n894\t\t\treturn !boolVal // disabled = !push_sessions\n895\t\t}\n896\t\treturn false\n897\t}\n898\t\n899\t// IsExternalAgentsEnabled checks if external agent discovery is enabled in settings.\n900\t// Returns false by default if settings cannot be loaded or the key is missing.\n901\tfunc IsExternalAgentsEnabled(ctx context.Context) bool {\n902\t\ts, err := Load(ctx)\n903\t\tif err != nil {\n904\t\t\treturn false\n905\t\t}\n906\t\treturn s.ExternalAgents\n907\t}\n908\t\n909\t// IsSignCheckpointCommitsEnabled returns true if checkpoint commits should be signed.\n910\t// Defaults to true when the setting is not explicitly set.\n911\tfunc (s *EntireSettings) IsSignCheckpointCommitsEnabled() bool {\n912\t\treturn s.SignCheckpointCommits == nil || *s.SignCheckpointCommits\n913\t}\n914\t\n915\t// IsSignCheckpointCommitsEnabled checks if checkpoint commit signing is enabled in settings.\n916\t// Returns true by default if settings cannot be loaded or the key is missing.\n917\tfunc IsSignCheckpointCommitsEnabled(ctx context.Context) bool {\n918\t\ts, err := Load(ctx)\n919\t\tif err != nil {\n920\t\t\treturn true\n921\t\t}\n922\t\treturn s.IsSignCheckpointCommitsEnabled()\n923\t}\n924\t\n925\t// Save saves the settings to .entire/settings.json.\n926\tfunc Save(ctx context.Context, settings *EntireSettings) error {\n927\t\treturn saveToFile(ctx, settings, EntireSettingsFile)\n928\t}\n929\t\n930\t// SaveLocal saves the settings to .entire/settings.local.json.\n931\tfunc SaveLocal(ctx context.Context, settings *EntireSettings) error {\n932\t\treturn saveToFile(ctx, settings, EntireSettingsLocalFile)\n933\t}\n934\t\n935\t// saveToFile saves settings to the specified file path.\n936\tfunc saveToFile(ctx context.Context, settings *EntireSettings, filePath string) error {\n937\t\t// Get absolute path for the file\n938\t\tfilePathAbs, err := paths.AbsPath(ctx, filePath)\n939\t\tif err != nil {\n940\t\t\tfilePathAbs = filePath // Fallback to relative\n941\t\t}\n942\t\n943\t\t// Ensure directory exists\n944\t\tdir := filepath.Dir(filePathAbs)\n945\t\tif err := os.MkdirAll(dir, 0o750); err != nil {\n946\t\t\treturn fmt.Errorf(\"creating settings directory: %w\", err)\n947\t\t}\n948\t\n949\t\tdata, err := jsonutil.MarshalIndentWithNewline(settings, \"\", \"  \")\n950\t\tif err != nil {\n951\t\t\treturn fmt.Errorf(\"marshaling settings: %w\", err)\n952\t\t}\n953\t\n954\t\t//nolint:gosec // G306: settings file is config, not secrets; 0o644 is appropriate\n955\t\tif err := os.WriteFile(filePathAbs, data, 0o644); err != nil {\n956\t\t\treturn fmt.Errorf(\"writing settings file: %w\", err)\n957\t\t}\n958\t\treturn nil\n959\t}\n960\t"}]},"uuid":"1753f54f-ffaa-4641-9866-718e2403c9a3","timestamp":"2026-05-13T20:22:24.036Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-2/cmd/entire/cli/settings/settings.go","content":"// Package settings provides configuration loading for Entire.\n// This package is separate from cli to allow strategy package to import it\n// without creating an import cycle (cli imports strategy).\npackage settings\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n)\n\nconst (\n\t// EntireSettingsFile is the path to the Entire settings file\n\tEntireSettingsFile = \".entire/settings.json\"\n\t// EntireSettingsLocalFile is the path to the local settings override file (not committed)\n\tEntireSettingsLocalFile = \".entire/settings.local.json\"\n\t// defaultGenerationRetentionDays is the default retention window for archived\n\t// checkpoints v2 raw-transcript generations when no override is configured.\n\tdefaultGenerationRetentionDays = 14\n)\n\nvar checkpointsVersionWarningOnce sync.Once\n\n// Commit linking mode constants.\nconst (\n\t// CommitLinkingAlways auto-links commits to sessions without prompting.\n\tCommitLinkingAlways = \"always\"\n\t// CommitLinkingPrompt prompts the user on each commit (default for existing users).\n\tCommitLinkingPrompt = \"prompt\"\n)\n\n// EntireSettings represents the .entire/settings.json configuration\ntype EntireSettings struct {\n\t// Enabled indicates whether Entire is active. When false, CLI commands\n\t// show a disabled message and hooks exit silently. Defaults to true.\n\tEnabled bool `json:\"enabled\"`\n\n\t// LocalDev indicates whether to use \"go run\" instead of the \"entire\" binary\n\t// This is used for development when the binary is not installed\n\tLocalDev bool `json:\"local_dev,omitempty\"`\n\n\t// LogLevel sets the logging verbosity (debug, info, warn, error).\n\t// Can be overridden by ENTIRE_LOG_LEVEL environment variable.\n\t// Defaults to \"info\".\n\tLogLevel string `json:\"log_level,omitempty\"`\n\n\t// StrategyOptions contains strategy-specific configuration\n\tStrategyOptions map[string]any `json:\"strategy_options,omitempty\"`\n\n\t// AbsoluteGitHookPath embeds the full binary path in git hooks instead of\n\t// bare \"entire\". This is needed for GUI git clients (Xcode, Tower, etc.)\n\t// that don't source shell profiles and can't find \"entire\" on PATH.\n\tAbsoluteGitHookPath bool `json:\"absolute_git_hook_path,omitempty\"`\n\n\t// Telemetry controls anonymous usage analytics.\n\t// nil = not asked yet (show prompt), true = opted in, false = opted out\n\tTelemetry *bool `json:\"telemetry,omitempty\"`\n\n\t// Redaction configures PII redaction behavior for transcripts and metadata.\n\tRedaction *RedactionSettings `json:\"redaction,omitempty\"`\n\n\t// Review maps agent name (e.g. \"claude-code\") to the review config for\n\t// that agent. When empty, `entire review` triggers the first-run picker.\n\tReview map[string]ReviewConfig `json:\"review,omitempty\"`\n\n\t// ReviewFixAgent is the default agent used when applying aggregate or\n\t// multi-agent review findings with `entire review --fix`.\n\tReviewFixAgent string `json:\"review_fix_agent,omitempty\"`\n\n\t// CommitLinking controls how commits are linked to agent sessions.\n\t// \"always\" = auto-link without prompting, \"prompt\" = ask on each commit.\n\t// Defaults to \"prompt\" (preserves existing user behavior).\n\tCommitLinking string `json:\"commit_linking,omitempty\"`\n\n\t// ExternalAgents enables discovery and registration of external agent\n\t// plugins (entire-agent-* binaries on $PATH). Defaults to false.\n\tExternalAgents bool `json:\"external_agents,omitempty\"`\n\n\t// SummaryGeneration stores provider preferences for explain --generate.\n\t// This is separate from strategy_options.summarize, which controls\n\t// checkpoint auto-summarize behavior.\n\tSummaryGeneration *SummaryGenerationSettings `json:\"summary_generation,omitempty\"`\n\n\t// Vercel indicates that the repository uses Vercel and the metadata branch\n\t// should include a vercel.json that disables deployments for Entire branches.\n\tVercel bool `json:\"vercel,omitempty\"`\n\n\t// SummaryTimeoutSeconds is an optional hard deadline (in seconds) for\n\t// `entire explain --generate` summary generation. Zero or negative means\n\t// \"unset\" -- the caller picks the default. Not yet consumed by the\n\t// generate path; present so settings round-trip for a follow-up change\n\t// that wires it into the deadline selection.\n\tSummaryTimeoutSeconds int `json:\"summary_timeout_seconds,omitempty\"`\n\n\t// SignCheckpointCommits controls whether checkpoint commits are signed.\n\t// nil/true = sign (default), false = skip signing.\n\tSignCheckpointCommits *bool `json:\"sign_checkpoint_commits,omitempty\"`\n\n\t// Deprecated: no longer used. Exists to tolerate old settings files\n\t// that still contain \"strategy\": \"auto-commit\" or similar.\n\tStrategy string `json:\"strategy,omitempty\"`\n}\n\n// SummaryGenerationSettings configures provider selection for on-demand\n// checkpoint summaries generated by explain --generate.\ntype SummaryGenerationSettings struct {\n\t// Provider is the selected summary provider agent name\n\t// (for example \"claude-code\", \"codex\", or \"gemini\").\n\tProvider string `json:\"provider,omitempty\"`\n\n\t// Model is an optional model hint passed to the selected provider.\n\tModel string `json:\"model,omitempty\"`\n}\n\n// Validate returns an error if the settings combination is semantically invalid.\n// A model without a provider is meaningless: the model hint needs a provider to\n// route to. The load path calls Validate() after merging, catching hand-edited\n// files that land in this state.\nfunc (s *SummaryGenerationSettings) Validate() error {\n\tif s == nil {\n\t\treturn nil\n\t}\n\tif s.Model != \"\" && s.Provider == \"\" {\n\t\treturn fmt.Errorf(\"summary_generation.model %q set without summary_generation.provider\", s.Model)\n\t}\n\treturn nil\n}\n\n// SetProvider updates the provider and optionally the model, clearing any stale\n// model from the previous provider when switching without a replacement.\n// An empty newProvider preserves the current provider; an empty newModel\n// preserves the current model unless the provider is changing, in which case\n// the old model is cleared to avoid passing (say) a Claude model to Codex.\nfunc (s *SummaryGenerationSettings) SetProvider(newProvider, newModel string) {\n\tif s == nil {\n\t\treturn\n\t}\n\tif newProvider != \"\" && s.Provider != \"\" && s.Provider != newProvider && newModel == \"\" {\n\t\ts.Model = \"\"\n\t}\n\tif newProvider != \"\" {\n\t\ts.Provider = newProvider\n\t}\n\tif newModel != \"\" {\n\t\ts.Model = newModel\n\t}\n}\n\n// RedactionSettings configures redaction behavior beyond the default secret detection.\ntype RedactionSettings struct {\n\tPII *PIISettings `json:\"pii,omitempty\"`\n}\n\n// PIISettings configures PII detection categories.\n// When Enabled is true, email and phone default to true; address defaults to false.\ntype PIISettings struct {\n\tEnabled        bool              `json:\"enabled\"`\n\tEmail          *bool             `json:\"email,omitempty\"`\n\tPhone          *bool             `json:\"phone,omitempty\"`\n\tAddress        *bool             `json:\"address,omitempty\"`\n\tCustomPatterns map[string]string `json:\"custom_patterns,omitempty\"`\n}\n\n// GetCommitLinking returns the effective commit linking mode.\n// Returns the explicit value if set, otherwise defaults to \"prompt\"\n// to preserve existing user behavior.\nfunc (s *EntireSettings) GetCommitLinking() string {\n\tif s.CommitLinking != \"\" {\n\t\treturn s.CommitLinking\n\t}\n\treturn CommitLinkingPrompt\n}\n\n// SummaryTimeoutValue returns the configured hard deadline for\n// `entire explain --generate` summary generation. Zero means \"unset\" --\n// the caller picks the default. Negative values are treated as unset.\nfunc (s *EntireSettings) SummaryTimeoutValue() time.Duration {\n\tif s.SummaryTimeoutSeconds < 1 {\n\t\treturn 0\n\t}\n\treturn time.Duration(s.SummaryTimeoutSeconds) * time.Second\n}\n\n// ReviewConfig holds the per-agent review configuration. Both fields are\n// optional; together they describe what `entire review` should ask the\n// agent to do.\n//\n// Precedence when composing the review prompt sent to the agent:\n//   - If Prompt is non-empty, it is used verbatim.\n//   - Otherwise, Skills are composed into a default template\n//     (\"Please run these review skills in order: 1. /X 2. /Y\").\n//\n// Skills are always recorded on the checkpoint metadata regardless of\n// which path composed the prompt — they're the structured, queryable\n// tag alongside ReviewPrompt (which is the ground truth).\ntype ReviewConfig struct {\n\t// Skills is the list of slash-prefixed skill invocations configured\n\t// for this agent. May be empty when Prompt carries the full request.\n\tSkills []string `json:\"skills,omitempty\"`\n\n\t// Prompt, when non-empty, carries saved review instructions. When\n\t// Skills is non-empty it is appended after the selected skills; when\n\t// Skills is empty it is the full prompt for prompt-only review configs.\n\tPrompt string `json:\"prompt,omitempty\"`\n}\n\n// IsZero reports whether the config is effectively unset.\nfunc (c ReviewConfig) IsZero() bool {\n\treturn len(c.Skills) == 0 && c.Prompt == \"\"\n}\n\n// ReviewConfigFor returns the configured review config for the given agent.\n// Returns a zero-value config when the agent has no entry; callers should\n// check IsZero (or the individual fields) to decide whether configuration\n// is present.\nfunc (s *EntireSettings) ReviewConfigFor(agentName string) ReviewConfig {\n\tif s == nil {\n\t\treturn ReviewConfig{}\n\t}\n\treturn s.Review[agentName]\n}\n\n// Load loads the Entire settings from .entire/settings.json,\n// then applies any overrides from .entire/settings.local.json if it exists.\n// Returns default settings if neither file exists.\n// Works correctly from any subdirectory within the repository.\nfunc Load(ctx context.Context) (*EntireSettings, error) {\n\t// Get absolute paths for settings files\n\tsettingsFileAbs, err := paths.AbsPath(ctx, EntireSettingsFile)\n\tif err != nil {\n\t\tsettingsFileAbs = EntireSettingsFile // Fallback to relative\n\t}\n\tlocalSettingsFileAbs, err := paths.AbsPath(ctx, EntireSettingsLocalFile)\n\tif err != nil {\n\t\tlocalSettingsFileAbs = EntireSettingsLocalFile // Fallback to relative\n\t}\n\n\treturn loadMergedSettings(settingsFileAbs, localSettingsFileAbs)\n}\n\nfunc loadMergedSettings(settingsFileAbs, localSettingsFileAbs string) (*EntireSettings, error) {\n\t// Load base settings\n\tsettings, err := loadFromFile(settingsFileAbs)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"reading settings file: %w\", err)\n\t}\n\n\t// Apply local overrides if they exist\n\tlocalData, err := os.ReadFile(localSettingsFileAbs) //nolint:gosec // path is from AbsPath or constant\n\tif err != nil {\n\t\tif !os.IsNotExist(err) {\n\t\t\treturn nil, fmt.Errorf(\"reading local settings file: %w\", err)\n\t\t}\n\t\t// Local file doesn't exist, continue without overrides\n\t} else {\n\t\tif err := mergeJSON(settings, localData); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"merging local settings: %w\", err)\n\t\t}\n\t}\n\n\t// Re-validate after merge. Individual files are validated by loadFromFile,\n\t// but mergeJSON patches fields independently and can produce combinations\n\t// (e.g. model without provider when the local override sets only a model\n\t// on top of a base with no provider) that neither file alone contained.\n\tif err := settings.SummaryGeneration.Validate(); err != nil {\n\t\treturn nil, fmt.Errorf(\"merged settings invalid: %w\", err)\n\t}\n\n\treturn settings, nil\n}\n\n// LoadFromFile loads settings from a specific file path without merging local overrides.\n// Returns default settings if the file doesn't exist.\n// Use this when you need to display individual settings files separately.\nfunc LoadFromFile(filePath string) (*EntireSettings, error) {\n\treturn loadFromFile(filePath)\n}\n\n// LoadFromBytes parses settings from raw JSON bytes without merging local overrides.\n// Use this when you have settings content from a non-file source (e.g., git show).\nfunc LoadFromBytes(data []byte) (*EntireSettings, error) {\n\ts := &EntireSettings{Enabled: true}\n\tdec := json.NewDecoder(bytes.NewReader(data))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(s); err != nil {\n\t\treturn nil, fmt.Errorf(\"parsing settings: %w\", err)\n\t}\n\treturn s, nil\n}\n\n// loadFromFile loads settings from a specific file path.\n// Returns default settings if the file doesn't exist.\nfunc loadFromFile(filePath string) (*EntireSettings, error) {\n\tsettings := &EntireSettings{\n\t\tEnabled: true, // Default to enabled\n\t}\n\n\tdata, err := os.ReadFile(filePath) //nolint:gosec // path is from caller\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn settings, nil\n\t\t}\n\t\treturn nil, fmt.Errorf(\"%w\", err)\n\t}\n\n\tdec := json.NewDecoder(bytes.NewReader(data))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(settings); err != nil {\n\t\treturn nil, fmt.Errorf(\"parsing settings file: %w\", err)\n\t}\n\n\t// Validate commit_linking if set\n\tif settings.CommitLinking != \"\" && settings.CommitLinking != CommitLinkingAlways && settings.CommitLinking != CommitLinkingPrompt {\n\t\treturn nil, fmt.Errorf(\"invalid commit_linking value %q: must be %q or %q\", settings.CommitLinking, CommitLinkingAlways, CommitLinkingPrompt)\n\t}\n\n\t// SummaryGeneration is NOT validated here — individual files may\n\t// legitimately contain only a model (provider comes from another file).\n\t// Validation happens after merge in Load().\n\n\treturn settings, nil\n}\n\n// mergeJSON merges JSON data into existing settings.\n// Only non-zero values from the JSON override existing settings.\nfunc mergeJSON(settings *EntireSettings, data []byte) error {\n\t// Validate that there are no unknown keys using strict decoding.\n\tdec := json.NewDecoder(bytes.NewReader(data))\n\tdec.DisallowUnknownFields()\n\tvar temp EntireSettings\n\tif err := dec.Decode(&temp); err != nil {\n\t\treturn fmt.Errorf(\"parsing JSON: %w\", err)\n\t}\n\n\t// Parse into a map to check which fields are present.\n\tvar raw map[string]json.RawMessage\n\tif err := json.Unmarshal(data, &raw); err != nil {\n\t\treturn fmt.Errorf(\"parsing JSON: %w\", err)\n\t}\n\n\tif err := mergeScalarFields(settings, raw); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeStrategyOptions(settings, raw); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeSummaryGeneration(settings, raw); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeCommitLinking(settings, raw); err != nil {\n\t\treturn err\n\t}\n\n\t// Merge redaction sub-fields if present (field-level, not wholesale replace).\n\tif redactionRaw, ok := raw[\"redaction\"]; ok {\n\t\tif settings.Redaction == nil {\n\t\t\tsettings.Redaction = &RedactionSettings{}\n\t\t}\n\t\tif err := mergeRedaction(settings.Redaction, redactionRaw); err != nil {\n\t\t\treturn fmt.Errorf(\"parsing redaction field: %w\", err)\n\t\t}\n\t}\n\n\treturn nil\n}\n\n// mergeScalarFields merges simple bool, *bool, string, and int fields from raw JSON.\nfunc mergeScalarFields(settings *EntireSettings, raw map[string]json.RawMessage) error {\n\tif err := mergeRawBool(raw, \"enabled\", &settings.Enabled); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawBool(raw, \"local_dev\", &settings.LocalDev); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawBool(raw, \"absolute_git_hook_path\", &settings.AbsoluteGitHookPath); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawBool(raw, \"external_agents\", &settings.ExternalAgents); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawBool(raw, \"vercel\", &settings.Vercel); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawBoolPtr(raw, \"telemetry\", &settings.Telemetry); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawBoolPtr(raw, \"sign_checkpoint_commits\", &settings.SignCheckpointCommits); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawStringNonEmpty(raw, \"log_level\", &settings.LogLevel); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawStringNonEmpty(raw, \"review_fix_agent\", &settings.ReviewFixAgent); err != nil {\n\t\treturn err\n\t}\n\tif err := mergeRawInt(raw, \"summary_timeout_seconds\", &settings.SummaryTimeoutSeconds); err != nil {\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc mergeRawBool(raw map[string]json.RawMessage, key string, dst *bool) error {\n\tv, ok := raw[key]\n\tif !ok {\n\t\treturn nil\n\t}\n\treturn unmarshalField(key, v, dst)\n}\n\nfunc mergeRawBoolPtr(raw map[string]json.RawMessage, key string, dst **bool) error {\n\tv, ok := raw[key]\n\tif !ok {\n\t\treturn nil\n\t}\n\tvar b bool\n\tif err := unmarshalField(key, v, &b); err != nil {\n\t\treturn err\n\t}\n\t*dst = &b\n\treturn nil\n}\n\nfunc mergeRawStringNonEmpty(raw map[string]json.RawMessage, key string, dst *string) error {\n\tv, ok := raw[key]\n\tif !ok {\n\t\treturn nil\n\t}\n\tvar s string\n\tif err := unmarshalField(key, v, &s); err != nil {\n\t\treturn err\n\t}\n\tif s != \"\" {\n\t\t*dst = s\n\t}\n\treturn nil\n}\n\nfunc mergeRawInt(raw map[string]json.RawMessage, key string, dst *int) error {\n\tv, ok := raw[key]\n\tif !ok {\n\t\treturn nil\n\t}\n\treturn unmarshalField(key, v, dst)\n}\n\nfunc unmarshalField(key string, data json.RawMessage, dst any) error {\n\tif err := json.Unmarshal(data, dst); err != nil {\n\t\treturn fmt.Errorf(\"parsing %s field: %w\", key, err)\n\t}\n\treturn nil\n}\n\nfunc mergeStrategyOptions(settings *EntireSettings, raw map[string]json.RawMessage) error {\n\toptionsRaw, ok := raw[\"strategy_options\"]\n\tif !ok {\n\t\treturn nil\n\t}\n\tvar opts map[string]any\n\tif err := unmarshalField(\"strategy_options\", optionsRaw, &opts); err != nil {\n\t\treturn err\n\t}\n\tif settings.StrategyOptions == nil {\n\t\tsettings.StrategyOptions = opts\n\t} else {\n\t\tfor k, v := range opts {\n\t\t\tsettings.StrategyOptions[k] = v\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc mergeSummaryGeneration(settings *EntireSettings, raw map[string]json.RawMessage) error {\n\tsummaryRaw, ok := raw[\"summary_generation\"]\n\tif !ok {\n\t\treturn nil\n\t}\n\tif settings.SummaryGeneration == nil {\n\t\tsettings.SummaryGeneration = &SummaryGenerationSettings{}\n\t}\n\n\tvar summaryFields map[string]json.RawMessage\n\tif err := unmarshalField(\"summary_generation\", summaryRaw, &summaryFields); err != nil {\n\t\treturn err\n\t}\n\n\t_, modelInOverride := summaryFields[\"model\"]\n\n\tif providerRaw, ok := summaryFields[\"provider\"]; ok {\n\t\tvar provider string\n\t\tif err := unmarshalField(\"summary_generation.provider\", providerRaw, &provider); err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// If the override switches providers without also setting a model,\n\t\t// the base's model was tuned to the old provider and would likely\n\t\t// cause a runtime failure when handed to the new one (e.g. codex\n\t\t// rejecting \"sonnet\"). Clear it so the new provider falls back to\n\t\t// its own default.\n\t\tif provider != settings.SummaryGeneration.Provider && !modelInOverride {\n\t\t\tset