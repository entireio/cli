{"parentUuid":"43dfc83f-b850-477e-9317-dd5d9c94f9c9","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/review-fix-2/cmd/entire/cli/hook_registry.go","snippet":"1\t// hook_registry.go provides hook command registration for agents.\n2\t// The lifecycle dispatcher (DispatchLifecycleEvent) handles all lifecycle events.\n3\t// PostTodo is the only hook that's handled directly (not via lifecycle dispatcher).\n4\tpackage cli\n5\t\n6\timport (\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"log/slog\"\n10\t\n11\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/claudecode\"\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/geminicli\"\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n18\t\t\"github.com/entireio/cli/perf\"\n19\t\n20\t\t\"github.com/spf13/cobra\"\n21\t)\n22\t\n23\t// agentHookLogCleanup stores the cleanup function for agent hook logging.\n24\t// Set by PersistentPreRunE, called by PersistentPostRunE.\n25\tvar agentHookLogCleanup func()\n26\t\n27\t// currentHookAgentName stores the agent name for the currently executing hook.\n28\t// Set by newAgentHookVerbCmdWithLogging before calling the handler.\n29\t// This allows handlers to know which agent invoked the hook without guessing.\n30\tvar currentHookAgentName types.AgentName\n31\t\n32\t// GetCurrentHookAgent returns the agent for the currently executing hook.\n33\t// Returns the agent based on the hook command structure (e.g., \"entire hooks claude-code ...\")\n34\t// rather than guessing from directory presence.\n35\t// Falls back to GetAgent() if not in a hook context.\n36\tfunc GetCurrentHookAgent() (agent.Agent, error) {\n37\t\tif currentHookAgentName == \"\" {\n38\t\t\treturn nil, errors.New(\"not in a hook context: agent name not set\")\n39\t\t}\n40\t\n41\t\tag, err := agent.Get(currentHookAgentName)\n42\t\tif err != nil {\n43\t\t\treturn nil, fmt.Errorf(\"getting hook agent %q: %w\", currentHookAgentName, err)\n44\t\t}\n45\t\treturn ag, nil\n46\t}\n47\t\n48\t// newAgentHooksCmd creates a hooks subcommand for an agent that implements HookSupport.\n49\t// It dynamically creates subcommands for each hook the agent supports.\n50\tfunc newAgentHooksCmd(agentName types.AgentName, handler agent.HookSupport) *cobra.Command {\n51\t\tcmd := &cobra.Command{\n52\t\t\tUse:    string(agentName),\n53\t\t\tShort:  handler.Description() + \" hook handlers\",\n54\t\t\tHidden: true,\n55\t\t\tPersistentPreRunE: func(cmd *cobra.Command, _ []string) error {\n56\t\t\t\tagentHookLogCleanup = initHookLogging(cmd.Context())\n57\t\t\t\treturn nil\n58\t\t\t},\n59\t\t\tPersistentPostRunE: func(_ *cobra.Command, _ []string) error {\n60\t\t\t\tif agentHookLogCleanup != nil {\n61\t\t\t\t\tagentHookLogCleanup()\n62\t\t\t\t}\n63\t\t\t\treturn nil\n64\t\t\t},\n65\t\t}\n66\t\n67\t\tfor _, hookName := range handler.HookNames() {\n68\t\t\tcmd.AddCommand(newAgentHookVerbCmdWithLogging(agentName, hookName))\n69\t\t}\n70\t\n71\t\treturn cmd\n72\t}\n73\t\n74\t// getHookType returns the hook type based on the hook name.\n75\t// Returns \"subagent\" for task-related hooks (pre-task, post-task, post-todo),\n76\t// \"tool\" for tool-related hooks (before-tool, after-tool),\n77\t// \"agent\" for all other agent hooks.\n78\tfunc getHookType(hookName string) string {\n79\t\tswitch hookName {\n80\t\tcase claudecode.HookNamePreTask, claudecode.HookNamePostTask, claudecode.HookNamePostTodo:\n81\t\t\treturn \"subagent\"\n82\t\tcase geminicli.HookNameBeforeTool, geminicli.HookNameAfterTool:\n83\t\t\treturn \"tool\"\n84\t\tdefault:\n85\t\t\treturn \"agent\"\n86\t\t}\n87\t}\n88\t\n89\t// executeAgentHook runs the core hook execution logic for a given agent and hook name.\n90\t// It handles git repo