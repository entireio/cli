ror\"; message: string }\n\t| { status: \"found\"; trail: TrailInfo };\n\nfunction getTrailForBranch(cwd: string): TrailLookup {\n\tconst branch = getGitBranch(cwd);\n\tconst remote = getGitRemote(cwd);\n\tif (!branch || !remote) return { status: \"none\" };\n\n\ttry {\n\t\tconst entireBin = process.env.ENTIRE_BIN || \"entire\";\n\t\tconst json = execSync(`${entireBin} trail list --json`, {\n\t\t\tcwd,\n\t\t\tencoding: \"utf-8\",\n\t\t\ttimeout: 10000,\n\t\t}).trim();\n\n\t\tconst trails = JSON.parse(json) as Array<{ number?: number; branch?: string; title?: string }>;\n\t\tconst trail = trails.find((t) => t.branch === branch);\n\t\tif (!trail?.number) return { status: \"no-trail\", branch };\n\n\t\tconst slug = trail.title\n\t\t\t?.toLowerCase()\n\t\t\t.replace(/[^a-z0-9]+/g, \"-\")\n\t\t\t.replace(/^-+|-+$/g, \"\")\n\t\t\t.slice(0, 60);\n\n\t\tconst url = `https://entire.io/gh/${remote.org}/${remote.repo}/trails/${trail.number}${slug ? `/${slug}` : \"\"}`;\n\n\t\treturn { status: \"found\", trail: { number: trail.number, title: trail.title ?? branch, branch, url } };\n\t} catch (err) {\n\t\tconst stderr = (err as { stderr?: Buffer | string }).stderr;\n\t\tconst stderrText = typeof stderr === \"string\" ? stderr : stderr?.toString() ?? \"\";\n\t\tconst message = (stderrText || (err as Error).message || \"\").trim().split(\"\\n\")[0] ?? \"error\";\n\t\treturn { status: \"error\", message };\n\t}\n}\n\nfunction formatReviewComment(trail: TrailInfo, comment: NonNullable<TrailStreamEvent[\"data\"]>[\"comment\"]): string {\n\tconst author = comment?.author || \"unknown\";\n\tconst body = (comment?.body || \"\").trim();\n\tconst replies = comment?.replies ?? [];\n\tconst replyText = replies\n\t\t.filter((reply) => (reply.body || \"\").trim() !== \"\")\n\t\t.map((reply) => `\\n\\nReply from ${reply.author || \"unknown\"}:\\n${(reply.body || \"\").trim()}`)\n\t\t.join(\"\");\n\n\treturn [\n\t\t`A new Entire Trail review comment arrived on trail #${trail.number} (${trail.title}).`,\n\t\t`URL: ${trail.url}`,\n\t\t`Author: ${author}`,\n\t\t\"\",\n\t\tbody || \"(empty comment)\",\n\t\treplyText,\n\t\t\"\",\n\t\t\"Please inspect the repository, determine whether code changes are needed, and address the review comment.\",\n\t]\n\t\t.filter(Boolean)\n\t\t.join(\"\\n\");\n}\n\nexport default function (pi: ExtensionAPI) {\n\tlet watcher: ChildProcessWithoutNullStreams | undefined;\n\tlet watchedTrail: TrailInfo | undefined;\n\tlet watcherBuffer = \"\";\n\tlet initialReplayRemaining = 0;\n\tlet drainingInitialReplay = false;\n\tconst seenCommentIds = new Set<string>();\n\n\tfunction update(cwd: string, ui: { theme: { fg: (c: string, t: string) => string }; setStatus: (id: string, text: string | undefined) => void }) {\n\t\tconst result = getTrailForBranch(cwd);\n\t\tif (result.status === \"none\") {\n\t\t\tui.setStatus(\"trail-link\", undefined);\n\t\t\treturn;\n\t\t}\n\n\t\tif (result.status === \"no-trail\") {\n\t\t\tui.setStatus(\"trail-link\", ui.theme.fg(\"dim\", `no trail for ${result.branch}`));\n\t\t\treturn;\n\t\t}\n\n\t\tif (result.status === \"error\") {\n\t\t\tui.setStatus(\"trail-link\", ui.theme.fg(\"dim\", `trail: ${result.message}`));\n\t\t\treturn;\n\t\t}\n\n\t\tconst trail = result.trail;\n\t\t// OSC 8 hyperlink for clickable link in supported terminals\n\t\tconst label = `#${trail.number} ${trail.title}`;\n\t\tconst hyperlink = `\\x1b]8;;${trail.url}\\x07${label}\\x1b]8;;\\x07`;\n\t\tui.setStatus(\"trail-link\", ui.theme.fg(\"dim\", \"trail \") + ui.theme.fg(\"accent\", hyperlink));\n\t}\n\n\tfunction stopWatcher() {\n\t\tif (!watcher) return;\n\t\twatcher.kill(\"SIGTERM\");\n\t\twatcher = undefined;\n\t\twatchedTrail = undefined;\n\t\twatcherBuffer = \"\";\n\t\tinitialReplayRemaining = 0;\n\t\tdrainingInitialReplay = false;\n\t\tseenCommentIds.clear();\n\t}\n\n\tfunction handleStreamLine(line: string) {\n\t\tif (!line.trim()) return;\n\n\t\tlet event: TrailStreamEvent;\n\t\ttry {\n\t\t\tevent = JSON.parse(line) as TrailStreamEvent;\n\t\t} catch {\n\t\t\treturn;\n\t\t}\n\n\t\tif (event.event === \"ready\") {\n\t\t\tinitialReplayRemaining = Math.max(0, event.data?.commentCount ?? 0);\n\t\t\tdrainingInitialReplay = initialReplayRemaining > 0;\n\t\t\treturn;\n\t\t}\n\n\t\tif (event.event !== \"comment\") return;\n\t\tconst trail = watchedTrail;\n\t\tconst comment = event.data?.comment;\n\t\tif (!trail || !comment) return;\n\n\t\tconst id = comment.id || \"\";\n\t\tif (drainingInitialReplay) {\n\t\t\tif (id) seenCommentIds.add(id);\n\t\t\tinitialReplayRemaining--;\n\t\t\tif (initialReplayRemaining <= 0) {\n\t\t\t\tdrainingInitialReplay = false;\n\t\t\t}\n\t\t\treturn;\n\t\t}\n\n\t\t// Avoid re-injecting if the stream reconnects and replays a comment we\n\t\t// already handled. Edits to an already-seen comment are ignored by design;\n\t\t// the goal is to alert on new review comments.\n\t\tif (id && seenCommentIds.has(id)) return;\n\t\tif (id) seenCommentIds.add(id);\n\n\t\ttry {\n\t\t\tpi.sendUserMessage(formatReviewComment(trail, comment), { deliverAs: \"steer\" });\n\t\t} catch {\n\t\t\ttry {\n\t\t\t\tpi.sendUserMessage(formatReviewComment(trail, comment));\n\t\t\t} catch {\n\t\t\t\t// Never crash Pi because the watcher failed to inject.\n\t\t\t}\n\t\t}\n\t}\n\n\tfunction startWatcher(cwd: string, ctx: { ui: { notify: (message: string, level?: string) => void; setStatus: (id: string, text: string | undefined) => void; theme: { fg: (c: string, t: string) => string } } }) {\n\t\tconst result = getTrailForBranch(cwd);\n\t\tif (result.status !== \"found\") {\n\t\t\tconst message = result.status === \"no-trail\" ? `No trail found for branch ${result.branch}.` : result.status === \"error\" ? `Cannot resolve trail: ${result.message}` : \"Cannot resolve current branch/repo trail.\";\n\t\t\tctx.ui.notify(message, \"error\");\n\t\t\treturn;\n\t\t}\n\n\t\tstopWatcher();\n\t\twatchedTrail = result.trail;\n\t\tconst entireBin = process.env.ENTIRE_BIN || \"entire\";\n\t\twatcher = spawn(entireBin, [\"trail\", \"watch\", String(result.trail.number), \"--json\"], {\n\t\t\tcwd,\n\t\t\tenv: process.env,\n\t\t\tstdio: [\"ignore\", \"pipe\", \"pipe\"],\n\t\t});\n\n\t\tctx.ui.notify(`Watching trail #${result.trail.number} review comments.`, \"info\");\n\t\tctx.ui.setStatus(\"trail-watch\", ctx.ui.theme.fg(\"accent\", `watching #${result.trail.number}`));\n\n\t\twatcher.stdout.on(\"data\", (chunk: Buffer) => {\n\t\t\twatcherBuffer += chunk.toString(\"utf8\");\n\t\t\tlet idx = watcherBuffer.indexOf(\"\\n\");\n\t\t\twhile (idx >= 0) {\n\t\t\t\tconst line = watcherBuffer.slice(0, idx);\n\t\t\t\twatcherBuffer = watcherBuffer.slice(idx + 1);\n\t\t\t\thandleStreamLine(line);\n\t\t\t\tidx = watcherBuffer.indexOf(\"\\n\");\n\t\t\t}\n\t\t});\n\n\t\twatcher.stderr.on(\"data\", (chunk: Buffer) => {\n\t\t\tconst text = chunk.toString(\"utf8\").trim();\n\t\t\tif (!text) return;\n\t\t\tif (text.includes(\"Watching trail\") || text.includes(\"server requested reconnect\")) return;\n\t\t\tctx.ui.setStatus(\"trail-watch\", ctx.ui.theme.fg(\"dim\", `trail watch: ${text.split(\"\\n\")[0]}`));\n\t\t});\n\n\t\twatcher.on(\"exit\", (code, signal) => {\n\t\t\tif (!watchedTrail) return;\n\t\t\tconst exitedTrail = watchedTrail;\n\t\t\twatcher = undefined;\n\t\t\twatchedTrail = undefined;\n\t\t\tctx.ui.setStatus(\"trail-watch\", undefined);\n\t\t\tif (code !== 0 && signal !== \"SIGTERM\") {\n\t\t\t\tctx.ui.notify(`Trail watcher for #${exitedTrail.number} stopped (exit ${code ?? signal ?? \"unknown\"}).`, \"error\");\n\t\t\t}\n\t\t});\n\t}\n\n\tpi.registerCommand(\"trail-watch\", {\n\t\tdescription: \"Watch active Entire trail review comments and send them to this Pi session\",\n\t\thandler: async (args: string, ctx: any) => {\n\t\t\tconst action = args.trim();\n\t\t\tif (action === \"stop\" || action === \"off\") {\n\t\t\t\tstopWatcher();\n\t\t\t\tctx.ui.setStatus(\"trail-watch\", undefined);\n\t\t\t\tctx.ui.notify(\"Stopped trail review watcher.\", \"info\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tst