{"type":"message","id":"aa8f66f5","parentId":"319c653a","timestamp":"2026-05-11T06:33:53.402Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_061f472de89db580016a0178030f9481918836be8692f79bf7\",\"type\":\"reasoning\",\"encrypted_content\":\"REDACTED\",\"summary\":[]}"},{"type":"toolCall","id":"call_r66fBI2hGCmgBL8aDMZoveW0|fc_061f472de89db580016a01780caf9c8191a979e28272a03b21","name":"write","arguments":{"path":"/Users/dip/.pi/agent/extensions/trail-link.ts","content":"/**\n * Trail Link Extension\n *\n * Shows a clickable trail link in the Pi footer for the current git branch.\n * Uses `entire trail list --json` to resolve the trail number, then constructs\n * a direct link to the trail detail page on entire.io.\n *\n * Watches the active branch's Trail code-review stream by default and injects\n * new live review comments into the active Pi session as user messages.\n */\n\nimport type { ExtensionAPI } from \"@earendil-works/pi-coding-agent\";\nimport { execSync, spawn, type ChildProcessWithoutNullStreams } from \"node:child_process\";\n\ninterface TrailInfo {\n\tnumber: number;\n\ttitle: string;\n\tbranch: string;\n\turl: string;\n}\n\ninterface TrailStreamEvent {\n\tevent?: string;\n\tdata?: {\n\t\tcommentCount?: number;\n\t\tresumed?: boolean;\n\t\tcomment?: {\n\t\t\tid?: string;\n\t\t\tauthor?: string;\n\t\t\tbody?: string;\n\t\t\treplies?: Array<{ id?: string; author?: string; body?: string }>;\n\t\t};\n\t\tcommentId?: string;\n\t};\n}\n\ntype TrailLookup =\n\t| { status: \"none\" }\n\t| { status: \"no-trail\"; branch: string }\n\t| { status: \"error\"; message: string }\n\t| { status: \"found\"; trail: TrailInfo };\n\ntype ExtensionCtx = {\n\tcwd: string;\n\tui: {\n\t\tnotify: (message: string, level?: string) => void;\n\t\tsetStatus: (id: string, text: string | undefined) => void;\n\t\ttheme: { fg: (color: string, text: string) => string };\n\t};\n};\n\nfunction getGitRemote(cwd: string): { org: string; repo: string } | null {\n\ttry {\n\t\tconst remote = execSync(\"git remote get-url origin\", { cwd, encoding: \"utf-8\" }).trim();\n\t\tconst match = remote.match(/github\\.com[/:]([^/]+)\\/([^/.]+)/);\n\t\treturn match ? { org: match[1]!, repo: match[2]! } : null;\n\t} catch {\n\t\treturn null;\n\t}\n}\n\nfunction getGitBranch(cwd: string): string | null {\n\ttry {\n\t\treturn execSync(\"git branch --show-current\", { cwd, encoding: \"utf-8\" }).trim() || null;\n\t} catch {\n\t\treturn null;\n\t}\n}\n\nfunction getTrailForBranch(cwd: string): TrailLookup {\n\tconst branch = getGitBranch(cwd);\n\tconst remote = getGitRemote(cwd);\n\tif (!branch || !remote) return { status: \"none\" };\n\n\ttry {\n\t\tconst entireBin = process.env.ENTIRE_BIN || \"entire\";\n\t\tconst json = execSync(`${entireBin} trail list --json`, {\n\t\t\tcwd,\n\t\t\tencoding: \"utf-8\",\n\t\t\ttimeout: 10000,\n\t\t}).trim();\n\n\t\tconst trails = JSON.parse(json) as Array<{ number?: number; branch?: string; title?: string }>;\n\t\tconst trail = trails.find((t) => t.branch === branch);\n\t\tif (!trail?.number) return { status: \"no-trail\", branch };\n\n\t\tconst slug = trail.title\n\t\t\t?.toLowerCase()\n\t\t\t.replace(/[^a-z0-9]+/g, \"-\")\n\t\t\t.replace(/^-+|-+$/g, \"\")\n\t\t\t.slice(0, 60);\n\n\t\tconst url = `https://entire.io/gh/${remote.org}/${remote.repo}/trails/${trail.number}${slug ? `/${slug}` : \"\"}`;\n\n\t\treturn { status: \"found\", trail: { number: trail.number, title: trail.title ?? branch, branch, url } };\n\t} catch (err) {\n\t\tconst stderr = (err as { stderr?: Buffer | string }).stderr;\n\t\tconst stderrText = typeof stderr === \"string\" ? stderr : stderr?.toString() ?? \"\";\n\t\tconst message = (stderrText || (err as Error).message || \"\").trim().split(\"\\n\")[0] ?? \"error\";\n\t\treturn { status: \"error\", message };\n\t}\n}\n\nfunction formatReviewComment(trail: TrailInfo, comment: NonNullable<TrailStreamEvent[\"data\"]>[\"comment\"]): string {\n\tconst author = comment?.author || \"unknown\";\n\tconst body = (comment?.body || \"\").trim();\n\tconst replies = comment?.replies ?? [];\n\tconst replyText = replies\n\t\t.filter((reply) => (reply.body || \"\").trim() !== \"\")\n\t\t.map((reply) => `\\n\\nReply from ${reply.author || \"unknown\"}:\\n${(reply.body || \"\").trim()}`)\n\t\t.join(\"\");\n\n\treturn [\n\t\t`A new Entire Trail review comment arrived on trail #${trail.number} (${trail.title}).`,\n\t\t`URL: ${trail.url}`,\n\t\t`Author: ${author}`,\n\t\t\"\",\n\t\tbody || \"(empty comment)\",\n\t\treplyText,\n\t\t\"\",\n\t\t\"Please inspect the repository, determine whether code changes are needed, and address the review comment.\",\n\t]\n\t\t.filter(Boolean)\n\t\t.join(\"\\n\");\n}\n\nfunction trailLookupMessage(result: Exclude<TrailLookup, { status: \"found\" }>): string {\n\tif (result.status === \"no-trail\") return `No trail found for branch ${result.branch}.`;\n\tif (result.status === \"error\") return `Cannot resolve trail: ${result.message}`;\n\treturn \"Cannot resolve current branch/repo trail.\";\n}\n\nexport default function (pi: ExtensionAPI) {\n\tlet watcher: ChildProcessWithoutNullStreams | undefined;\n\tlet watchedTrail: TrailInfo | undefined;\n\tlet watcherBuffer = \"\";\n\tlet initialReplayRemaining = 0;\n\tlet drainingInitialReplay = false;\n\tlet paused = false;\n\tconst seenCommentIds = new Set<string>();\n\n\tfunction updateTrailLink(cwd: string, ui: ExtensionCtx[\"ui\"]) {\n\t\tconst result = getTrailForBranch(cwd);\n\t\tif (result.status === \"none\") {\n\t\t\tui.setStatus(\"trail-link\", undefined);\n\t\t\treturn;\n\t\t}\n\n\t\tif (result.status === \"no-trail\") {\n\t\t\tui.setStatus(\"trail-link\", ui.theme.fg(\"dim\", `no trail for ${result.branch}`));\n\t\t\treturn;\n\t\t}\n\n\t\tif (result.status === \"error\") {\n\t\t\tui.setStatus(\"trail-link\", ui.theme.fg(\"dim\", `trail: ${result.message}`));\n\t\t\treturn;\n\t\t}\n\n\t\tconst trail = result.trail;\n\t\t// OSC 8 hyperlink for click