mmentIds.has(id)) return;\n\t\tif (id) seenCommentIds.add(id);\n\n\t\tconst message = formatReviewComment(trail, comment);\n\t\ttry {\n\t\t\tpi.sendUserMessage(message, { deliverAs: \"steer\" });\n\t\t} catch {\n\t\t\ttry {\n\t\t\t\tpi.sendUserMessage(message);\n\t\t\t} catch {\n\t\t\t\t// Never crash Pi because the watcher failed to inject.\n\t\t\t}\n\t\t}\n\t}\n\n\tfunction ensureWatcher(ctx: ExtensionCtx, opts: { notify?: boolean; silentMissing?: boolean; forceRestart?: boolean } = {}) {\n\t\tif (paused) {\n\t\t\tctx.ui.setStatus(\"trail-watch\", ctx.ui.theme.fg(\"dim\", \"trail watch paused\"));\n\t\t\treturn false;\n\t\t}\n\n\t\tconst result = getTrailForBranch(ctx.cwd);\n\t\tif (result.status !== \"found\") {\n\t\t\tstopWatcher();\n\t\t\tctx.ui.setStatus(\"trail-watch\", undefined);\n\t\t\tif (!opts.silentMissing) ctx.ui.notify(trailLookupMessage(result), \"error\");\n\t\t\treturn false;\n\t\t}\n\n\t\tif (!opts.forceRestart && watcher && watchedTrail?.number === result.trail.number) {\n\t\t\tctx.ui.setStatus(\"trail-watch\", ctx.ui.theme.fg(\"accent\", `watching #${result.trail.number}`));\n\t\t\tif (opts.notify) ctx.ui.notify(`Already watching trail #${result.trail.number}.`, \"info\");\n\t\t\treturn true;\n\t\t}\n\n\t\tstopWatcher();\n\t\tresetStreamState();\n\n\t\tconst entireBin = process.env.ENTIRE_BIN || \"entire\";\n\t\tconst child = spawn(entireBin, [\"trail\", \"watch\", String(result.trail.number), \"--json\"], {\n\t\t\tcwd: ctx.cwd,\n\t\t\tenv: process.env,\n\t\t\tstdio: [\"ignore\", \"pipe\", \"pipe\"],\n\t\t});\n\n\t\twatcher = child;\n\t\twatchedTrail = result.trail;\n\t\tctx.ui.setStatus(\"trail-watch\", ctx.ui.theme.fg(\"accent\", `watching #${result.trail.number}`));\n\t\tif (opts.notify) ctx.ui.notify(`Watching trail #${result.trail.number} review comments.`, \"info\");\n\n\t\tchild.stdout.on(\"data\", (chunk: Buffer) => {\n\t\t\tif (watcher !== child) return;\n\t\t\twatcherBuffer += chunk.toString(\"utf8\");\n\t\t\tlet idx = watcherBuffer.in