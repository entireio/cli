d := newCursorImportCmd()\n55\t\tvar buf bytes.Buffer\n56\t\tcmd.SetOut(&buf)\n57\t\tcmd.SetErr(&buf)\n58\t\tcmd.SetArgs(append([]string{archivePath}, args...))\n59\t\treturn cmd.ExecuteContext(context.Background())\n60\t}\n61\t\n62\tfunc readImportedDB(t *testing.T, path string) (map[string]string, map[string][]byte) {\n63\t\tt.Helper()\n64\t\tdb, err := sql.Open(\"sqlite\", \"file:\"+path+\"?mode=ro\")\n65\t\tif err != nil {\n66\t\t\tt.Fatalf(\"open: %v\", err)\n67\t\t}\n68\t\tdefer db.Close()\n69\t\tmeta := map[string]string{}\n70\t\trows, err := db.QueryContext(context.Background(), \"SELECT key, value FROM meta\")\n71\t\tif err != nil {\n72\t\t\tt.Fatalf(\"query meta: %v\", err)\n73\t\t}\n74\t\tfor rows.Next() {\n75\t\t\tvar k, v string\n76\t\t\tif err := rows.Scan(&k, &v); err != nil {\n77\t\t\t\tt.Fatalf(\"scan meta: %v\", err)\n78\t\t\t}\n79\t\t\tmeta[k] = v\n80\t\t}\n81\t\trows.Close()\n82\t\n83\t\tblobs := map[string][]byte{}\n84\t\trows, err = db.QueryContext(context.Background(), \"SELECT id, data FROM blobs\")\n85\t\tif err != nil {\n86\t\t\tt.Fatalf(\"query blobs: %v\", err)\n87\t\t}\n88\t\tfor rows.Next() {\n89\t\t\tvar id string\n90\t\t\tvar data []byte\n91\t\t\tif err := rows.Scan(&id, &data); err != nil {\n92\t\t\t\tt.Fatalf(\"scan blob: %v\", err)\n93\t\t\t}\n94\t\t\tblobs[id] = data\n95\t\t}\n96\t\trows.Close()\n97\t\treturn meta, blobs\n98\t}\n99\t\n100\tfunc TestCursorImport_Roundtrip(t *testing.T) {\n101\t\t// Cannot t.Parallel: sets HOME and cwd for the command.\n102\t\ttmp := t.TempDir()\n103\t\tt.Setenv(\"HOME\", tmp)\n104\t\tt.Chdir(tmp)\n105\t\n106\t\tarchive := importFixtureArchive()\n107\t\terr := runImport(t, archive, \"--workspace-hash\", testImportWorkspace)\n108\t\tif err != nil {\n109\t\t\tt.Fatalf(\"import: %v\", err)\n110\t\t}\n111\t\n112\t\tdbPath := filepath.Join(tmp, \".cursor\", \"chats\", testImportWorkspace, testImportAgentID, \"store.db\")\n113\t\tgotMeta, gotBlobs := readImportedDB(t, dbPath)\n114\t\tif gotMeta[\"model\"] != testImportModel {\n115\t\t\tt.Errorf(\"meta model = %q, want gpt-5\", gotMeta[\"model\"])\n116\t\t}\n117\t\tif string(gotBlobs[\"b1\"]) != \"hello\" {\n118\t\t\tt.Errorf(\"blob b1 = %q, want hello\", gotBlobs[\"b1\"])\n119\t\t}\n120\t\tif !bytes.Equal(gotBlobs[\"b2\"], []byte{0x00, 0xff, 0x42}) {\n121\t\t\tt.Errorf(\"blob b2 bytes mismatch: %x\", gotBlobs[\"b2\"])\n122\t\t}\n123\t}\n124\t\n125\tfunc TestCursorImport_RefusesOverwriteWithoutForce(t *testing.T) {\n126\t\t// Cannot t.Parallel: sets HOME and cwd.\n127\t\ttmp := t.TempDir()\n128\t\tt.Setenv(\"HOME\", tmp)\n129\t\tt.Chdir(tmp)\n130\t\n131\t\tarchive := importFixtureArchive()\n132\t\n133\t\t// First import succeeds.\n134\t\tif err := runImport(t, archive, \"--workspace-hash\", testImportWorkspace); err != nil {\n135\t\t\tt.Fatalf(\"first import: %v\", err)\n136\t\t}\n137\t\n138\t\tdbPath := filepath.Join(tmp, \".cursor\", \"chats\", testImportWorkspace, testImportAgentID, \"store.db\")\n139\t\tbefore, err := os.ReadFile(dbPath)\n140\t\tif err != nil {\n141\t\t\tt.Fatalf(\"read before: %v\", err)\n142\t\t}\n143\t\n144\t\t// Mutate the archive so a successful overwrite would be observable.\n145\t\tarchive.Store.Meta[\"model\"] = \"different\"\n146\t\n147\t\t// Second import without --force must fail and leave the existing DB untouched.\n148\t\tif err := runImport(t, archive, \"--workspace-hash\", testImportWorkspace); err == nil {\n149\t\t\tt.Fatal(\"expected error on overwrite without --force\")\n150\t\t}\n151\t\n152\t\tafter, err := os.ReadFile(dbPath)\n153\t\tif err != nil {\n154\t\t\tt.Fatalf(\"read after: %v\", err)\n155\t\t}\n156\t\tif !bytes.Equal(before, after) {\n157\t\t\tt.Errorf(\"DB file was mutated when --force not passed\")\n158\t\t}\n159\t}\n160\t\n161\tfunc TestCursorImport_ForceOverwriteReplacesContents(t *testing.T) {\n162\t\t// Cannot t.Parallel: sets HOME and cwd.\n163\t\ttmp := t.TempDir()\n164\t\tt.Setenv(\"HOME\", tmp)\n165\t\tt.Chdir(tmp)\n166\t\n167\t\tarchive := importFixtureArchive()\n168\t\tif err := runImport(t, archive, \"--workspace-hash\", testImportWorkspace); err != nil {\n169\t\t\tt.Fatalf(\"first import: %v\", err)\n170\t\t}\n171\t\n172\t\tarchive.Store.Meta[\"model\"] = \"swapped\"\n173\t\tif err := runImport(t, archive, \"--workspace-hash\", testImportWorkspace, \"--force\"); err != nil {\n174\t\t\tt.Fatalf(\"forced import: %v\", err)\n175\t\t}\n176\t\n177\t\tdbPath := filepath.Join(tmp, \".cursor\", \"chats\", testImportWorkspace, testImportAgentID, \"store.db\")\n178\t\tgotMeta, _ := readImportedDB(t, dbPath)\n179\t\tif gotMeta[\"model\"] != \"swapped\" {\n180\t\t\tt.Errorf(\"after --force, meta model = %q, want swapped\", gotMeta[\"model\"])\n181\t\t}\n182\t}\n183\t\n184\tfunc TestCursorImport_CrossMachineNoFlags(t *testing.T) {\n185\t\t// Cannot t.Parallel: sets HOME and cwd.\n186\t\t// Simulates: export on machine A at /path-A, import on machine B at /path-B,\n187\t\t// different absolute paths. No --workspace-hash flag.\n188\t\ttmp := t.TempDir()\n189\t\tt.Setenv(\"HOME\", tmp)\n190\t\n191\t\t// Different repo root than the original export site.\n192\t\trepoB := filepath.Join(tmp, \"different\", \"path\", \"repo-b\")\n193\t\tif err := os.MkdirAll(repoB, 0o755); err != nil {\n194\t\t\tt.Fatalf(\"mkdir repo-b: %v\", err)\n195\t\t}\n196\t\tt.Chdir(repoB)\n197\t\n198\t\tarchive := importFixtureArchive()\n199\t\tif err := runImport(t, archive); err != nil {\n200\t\t\tt.Fatalf(\"import without flags: %v\", err)\n201\t\t}\n202\t\n203\t\t// Computed destination should be hash of repo-B.\n204\t\texpectedHash := cursorWorkspaceHash(repoB)\n205\t\tdbPath := filepath.Join(tmp, \".cursor\", \"chats\", expectedHash, testImportAgentID, \"store.db\")\n206\t\tmeta, _ := readImportedDB(t, dbPath)\n207\t\tif meta[\"model\"] != testImportModel {\n208\t\t\tt.Errorf(\"meta model = %q, want gpt-5\", meta[\"model\"])\n209\t\t}\n210\t}\n211\t\n212\tfunc TestCursorImport_RejectsUnknownFormat(t *testing.T) {\n213\t\t// Cannot t.Parallel: sets HOME a