ache(),\n451\t\t}\n452\t}\n453\t\n454\t// flushMain pushes any buffered /main entries through WriteCommittedMainBatch\n455\t// and times the call into a flush_main span + cumulative counter.\n456\tfunc (s *migrateLoopState) flushMain(ctx, loopCtx context.Context, v2Store *checkpoint.V2GitStore) error {\n457\t\tif len(s.pendingMain) == 0 {\n458\t\t\treturn nil\n459\t\t}\n460\t\t_, span := perf.Start(loopCtx, \"flush_main\")\n461\t\tstart := time.Now()\n462\t\t_, err := v2Store.WriteCommittedMainBatch(ctx, s.pendingMain)\n463\t\ts.totalFlushMain += time.Since(start)\n464\t\tif err != nil {\n465\t\t\tspan.RecordError(err)\n466\t\t\tspan.End()\n467\t\t\treturn fmt.Errorf(\"failed to write batched v2 /main entries: %w\", err)\n468\t\t}\n469\t\tspan.End()\n470\t\ts.pendingMain = s.pendingMain[:0]\n471\t\treturn nil\n472\t}\n473\t\n474\t// packCurrentBatch flushes /main, resolves the next archive slot if needed,\n475\t// then archives pendingFull into a /full/<n> ref. Records perf spans for\n476\t// flush_main and pack_full_generation; rolls into cumulative counters.\n477\tfunc (s *migrateLoopState) packCurrentBatch(ctx, loopCtx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, batchSize int) error {\n478\t\t// Flush /main entries first so the index ref can never lag behind the\n479\t\t// data ref on a mid-batch crash.\n480\t\tif err := s.flushMain(ctx, loopCtx, v2Store); err != nil {\n481\t\t\treturn err\n482\t\t}\n483\t\tif s.nextGeneration == 0 {\n484\t\t\t// Resolve the archive slot only when the first full batch is ready;\n485\t\t\t// force migration may prune existing archived refs earlier in the loop.\n486\t\t\tnext, err := v2Store.NextGenerationNumber()\n487\t\t\tif err != nil {\n488\t\t\t\treturn fmt.Errorf(\"list archived v2 generations: %w\", err)\n489\t\t\t}\n490\t\t\ts.nextGeneration = next\n491\t\t}\n492\t\trefName := checkpoint.ArchivedGenerationRefName(s.nextGeneration)\n493\t\t_, packSpan := perf.Start(loopCtx, \"pack_full_generation\"