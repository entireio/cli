{"parentUuid":"72e32209-4ed3-495b-a44d-ca2a9327c2b1","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/alisha/.marvin/worktrees/cli/checkpoint-export-cli/cmd/entire/cli/sessions.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"sort\"\n13\t\t\"strings\"\n14\t\t\"time\"\n15\t\n16\t\t\"charm.land/huh/v2\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n18\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n19\t\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n20\t\t\"github.com/entireio/cli/cmd/entire/cli/stringutil\"\n21\t\t\"github.com/spf13/cobra\"\n22\t)\n23\t\n24\t// streamTranscriptToStdout copies the contents of the file at path to w.\n25\t// Cancellation is wired through a goroutine that closes the file on\n26\t// <-ctx.Done(), so io.ReadAll returns promptly when the user hits Ctrl-C on a\n27\t// multi-MB transcript instead of blocking until EOF.\n28\t//\n29\t// Snapshot semantics: the read is bounded to the file size observed at open\n30\t// (via io.LimitReader) so writes the agent appends after command start are\n31\t// excluded. Output shaping is content-aware:\n32\t//\n33\t//   - Whole-document JSON transcripts (e.g. Gemini's session-*.json) are\n34\t//     emitted intact. Trimming would cut off the closing brace.\n35\t//   - JSONL transcripts (Claude Code, Cursor, Codex, etc.) get a trailing\n36\t//     partial-line trim so consumers never see a truncated record.\n37\t//\n38\t// path comes from a session-state file that Entire writes exclusively\n39\t// under the user's own .git/. The path is therefore as trusted as any\n40\t// other entry the local user has on disk; we do not validate it against a\n41\t// confinement root.\n42\tfunc streamTranscriptToStdout(ctx context.Context, w io.Writer, path string) error {\n43\t\tf, err := os.Open(path) //nolint:gosec // see comment above on trust model\n44\t\tif err != nil {\n45\t\t\treturn fmt.Errorf(\"open transcript: %w\", err)\n46\t\t}\n47\t\n48\t\t// Bound the snapshot to the file size at open. Without this, io.ReadAll\n49\t\t// would also include bytes the agent appends while the read is in flight,\n50\t\t// silently extending the \"snapshot\" past command-start.\n51\t\tvar snapshotSize int64 = -1\n52\t\tif info, statErr := f.Stat(); statErr == nil {\n53\t\t\tsnapshotSize = info.Size()\n54\t\t}\n55\t\n56\t\tcloseOnDone := make(chan struct{})\n57\t\tgo func() {\n58\t\t\tselect {\n59\t\t\tcase <-ctx.Done():\n60\t\t\t\t_ = f.Close()\n61\t\t\tcase <-closeOnDone:\n62\t\t\t}\n63\t\t}()\n64\t\tdefer func() {\n65\t\t\tclose(closeOnDone)\n66\t\t\t_ = f.Close()\n67\t\t}()\n68\t\n69\t\tvar reader io.Reader = f\n70\t\tif snapshotSize >= 0 {\n71\t\t\treader = io.LimitReader(f, snapshotSize)\n72\t\t}\n73\t\tbuf, err := io.ReadAll(reader)\n74\t\tif err != nil {\n75\t\t\tif ctxErr := ctx.Err(); ctxErr != nil {\n76\t\t\t\treturn ctxErr //nolint:wrapcheck // propagating context cancellation\n77\t\t\t}\n78\t\t\treturn fmt.Errorf(\"read transcript: %w\", err)\n79\t\t}\n80\t\n81\t\tif _, err := w.Write(shapeTranscriptSnapshot(buf)); err != nil {\n82\t\t\treturn fmt.Errorf(\"write transcript: %w\", err)\n83\t\t}\n84\t\treturn nil\n85\t}\n86\t\n87\t// shapeTranscriptSnapshot returns the snapshot bytes a consumer should see.\n88\t// If the buffer is a single valid JSON document (Gemini-style), it is emitted\n89\t// intact. Otherwise it is treated as JSONL and trimmed to the last newline so\n90\t// no partial trailing record reaches the consumer.\n91\tfunc shapeTranscriptSnapshot(buf []byte) []byte {\n92\t\tif json.Valid(buf) {\n93\t\t\treturn buf\n94\t\t}\n95\t\tif i := bytes.LastIndexByte(buf, '\\n'); i >= 0 {\n96\t\t\treturn buf[:i+1]\n97\t\t}\n98\t\t// Single non-terminated, non-JSON record (vanishingly rare for live\n99\t\t// transcripts) — return empty rather than a truncated record.\n100\t\treturn