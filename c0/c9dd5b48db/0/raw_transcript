\t}\n154\t\n155\t\tcmd.Flags().BoolVar(&allFlag, \"all\", false, \"Stop all active sessions\")\n156\t\tcmd.Flags().BoolVarP(&forceFlag, \"force\", \"f\", false, \"Skip confirmation prompt\")\n157\t\n158\t\treturn cmd\n159\t}\n160\t\n161\t// runStop is the main logic for the stop command.\n162\tfunc runStop(ctx context.Context, cmd *cobra.Command, sessionID string, all, force bool) error {\n163\t\t// --session path: stop a specific session by explicit ID (no worktree scoping).\n164\t\tif sessionID != \"\" {\n165\t\t\treturn runStopSession(ctx, cmd, sessionID, force)\n166\t\t}\n167\t\n168\t\t// List all session states\n169\t\tstates, err := strategy.ListSessionStates(ctx)\n170\t\tif err != nil {\n171\t\t\treturn fmt.Errorf(\"failed to list sessions: %w\", err)\n172\t\t}\n173\t\n174\t\tactiveSessions := filterActiveSessions(states)\n175\t\n176\t\t// --all path: stop all active sessions across all worktrees.\n177\t\tif all {\n178\t\t\treturn runStopAll(ctx, cmd, activeSessions, force)\n179\t\t}\n180\t\n181\t\t// No-flags path: show all active sessions across all worktrees.\n182\t\t// This aligns with `entire status` which displays sessions globally.\n183\t\t// Users see worktree labels in the multi-select to make informed choices.\n184\t\tif len(activeSessions) == 0 {\n185\t\t\tfmt.Fprintln(cmd.OutOrStdout(), \"No active sessions.\")\n186\t\t\treturn nil\n187\t\t}\n188\t\n189\t\t// One active session: confirm + stop.\n190\t\tif len(activeSessions) == 1 {\n191\t\t\treturn runStopSession(ctx, cmd, activeSessions[0].SessionID, force)\n192\t\t}\n193\t\n194\t\t// Multiple active sessions: show TUI multi-select.\n195\t\treturn runStopMultiSelect(ctx, cmd, activeSessions, force)\n196\t}\n197\t\n198\t// filterActiveSessions returns sessions that have not been explicitly ended.\n199\t// A session is considered ended if Phase == PhaseEnded OR EndedAt is set.\n200\t// This matches the logic in status.go's writeActiveSessions for consistency:\n201\t// any session visible in `entire status` should also be visible in `sessions stop`.\n202\tfunc filterActiveSessions(states []*strategy.SessionState) []*strategy.SessionState {\n203\t\tvar active []*strategy.SessionState\n204\t\tfor _, s := range states {\n205\t\t\tif s == nil {\n206\t\t\t\tcontinue\n207\t\t\t}\n208\t\t\tif s.Phase != session.PhaseEnded && s.EndedAt == nil {\n209\t\t\t\tactive = append(active, s)\n210\t\t\t}\n211\t\t}\n212\t\treturn active\n213\t}\n214\t\n215\t// sessionWorktreeLabel returns the worktree display label for a session.\n216\t// Uses WorktreeID if available, falls back to the last path component of\n217\t// WorktreePath, or \"(unknown)\" for empty values (legacy sessions without\n218\t// worktree tracking). Matches status.go's unknownPlaceholder convention.\n219\tfunc sessionWorktreeLabel(s *strategy.SessionState) string {\n220\t\tif s.WorktreeID != \"\" {\n221\t\t\treturn s.WorktreeID\n222\t\t}\n223\t\tif s.WorktreePath != \"\" {\n224\t\t\treturn filepath.Base(s.WorktreePath)\n225\t\t}\n226\t\treturn unknownPlaceholder\n227\t}\n228\t\n229\t// sessionPhaseLabel returns the display status for a session.\n\n... [544 lines truncated] ..."},"type":"attachment","uuid":"33d53da5-a96c-4f90-8aa9-3d2f400fa6b6","timestamp":"2026-05-07T18:18:20.559Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/cli/checkpoint-export-cli","sessionId":"b3179a8b-1600-460b-a2e3-d256f3557add","version":"2.1.132","gitBranch":"checkpoint-export-cli"}
