\n49\t\treturn runExplainCheckpointJSON(ctx, w, errW, opts)\n50\t}\n51\t\n52\t// resolveExplainCheckpointID resolves a target (positional, --checkpoint, or\n53\t// --commit) to a fully-qualified checkpoint ID using the existing lookup\n54\t// infrastructure (including remote metadata fetch on miss).\n55\tfunc resolveExplainCheckpointID(ctx context.Context, errW io.Writer, opts explainExportOptions) (id.CheckpointID, *explainCheckpointLookup, error) {\n56\t\tif opts.commitRef != \"\" {\n57\t\t\trepo, err := openRepository(ctx)\n58\t\t\tif err != nil {\n59\t\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"not a git repository: %w\", err)\n60\t\t\t}\n61\t\t\thash, _, err := resolveCommitUnambiguous(repo, opts.commitRef)\n62\t\t\tif err != nil {\n63\t\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"commit not found: %s: %w\", opts.commitRef, err)\n64\t\t\t}\n65\t\t\tcommit, err := repo.CommitObject(hash)\n66\t\t\tif err != nil {\n67\t\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"failed to read commit: %w\", err)\n68\t\t\t}\n69\t\t\tcpID, found := trailers.ParseCheckpoint(commit.Message)\n70\t\t\tif !found {\n71\t\t\t\treturn id.CheckpointID(\"\"), nil, fmt.Errorf(\"commit %s has no Entire-Checkpoint trailer\", commit.Hash)\n72\t\t\t}\n73\t\t\tlookup, lookupErr := newExplainCheckpointLookup(ctx)\n74\t\t\tif lookupErr != nil {\n75\t\t\t\treturn id.CheckpointID(\"\"), nil, lookupErr\n76\t\t\t}\n77\t\t\treturn cpID, lookup, nil\n78\t\t}\n79\t\n80\t\tprefix := opts.checkpointFlag\n81\t\tif prefix == \"\" {\n82\t\t\tprefix = opts.target\n83\t\t}\n84\t\tif prefix == \"\" {\n85\t\t\treturn id.CheckpointID(\"\"), nil, errors.New(\"missing checkpoint target\")\n86\t\t}\n87\t\n88\t\tlookup, lookupErr := newExplainCheckpointLookup(ctx)\n89\t\tif lookupErr != nil {\n90\t\t\treturn id.CheckpointID(\"\"), nil, lookupErr\n91\t\t}\n92\t\n93\t\tmatches := matchCheckpointPrefix(lookup, prefix)\n94\t\tif len(matches) == 0 {\n95\t\t\tstop := startSpinner(errW, \"Fetching c