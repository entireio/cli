ssions as ended.\n152\t\n153\tFires EventSessionStop through the state machine with a no-op action handler,\n154\tso no condensation or checkpoint-writing occurs. To flush pending work, commit first.\n155\t\n156\tExamples:\n157\t  entire sessions stop                     No sessions: exits. One session: confirm and stop. Multiple: show selector\n158\t  entire sessions stop <session-id>        Stop a specific session by ID\n159\t  entire sessions stop --all               Stop all active sessions\n160\t  entire sessions stop --force             Skip confirmation prompt`,\n161\t\t\tArgs: cobra.MaximumNArgs(1),\n162\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n163\t\t\t\tctx := cmd.Context()\n164\t\n165\t\t\t\tvar sessionID string\n166\t\t\t\tif len(args) > 0 {\n167\t\t\t\t\tsessionID = args[0]\n168\t\t\t\t}\n169\t\n170\t\t\t\tif allFlag && sessionID != \"\" {\n171\t\t\t\t\treturn errors.New(\"--all and session ID argument are mutually exclusive\")\n172\t\t\t\t}\n173\t\n174\t\t\t\treturn runStop(ctx, cmd, sessionID, allFlag, forceFlag)\n175\t\t\t},\n176\t\t}\n177\t\n178\t\tcmd.Flags().BoolVar(&allFlag, \"all\", false, \"Stop all active sessions\")\n179\t\tcmd.Flags().BoolVarP(&forceFlag, \"force\", \"f\", false, \"Skip confirmation prompt\")\n180\t\n181\t\treturn cmd\n182\t}\n183\t\n184\t// runStop is the main logic for the stop command.\n185\tfunc runStop(ctx context.Context, cmd *cobra.Command, sessionID string, all, force bool) error {\n186\t\t// --session path: stop a specific session by explicit ID (no worktree scoping).\n187\t\tif sessionID != \"\" {\n188\t\t\treturn runStopSession(ctx, cmd, sessionID, force)\n189\t\t}\n190\t\n191\t\t// List all session states\n192\t\tstates, err := strategy.ListSessionStates(ctx)\n193\t\tif err != nil {\n194\t\t\treturn fmt.Errorf(\"failed to list sessions: %w\", err)\n195\t\t}\n196\t\n197\t\tactiveSessions := filterActiveSessions(states)\n198\t\n199\t\t// --all path: stop all active sessions across all worktrees.\n200\t\tif all {\n201\t\t\treturn runStopAll(ctx, cmd, activeSessions, force)\n202\t\t}\n203\t\n204\t\t// No-flags path: show all active sessions across all worktrees.\n205\t\t// This aligns with `entire status` which displays sessions globally.\n206\t\t// Users see worktree labels in the multi-select to make informed choices.\n207\t\tif len(activeSessions) == 0 {\n208\t\t\tfmt.Fprintln(cmd.OutOrStdout(), \"No active sessions.\")\n209\t\t\treturn nil\n210\t\t}\n211\t\n212\t\t// One active session: confirm + stop.\n213\t\tif len(activeSessions) == 1 {\n214\t\t\treturn runStopSession(ctx, cmd, activeSessions[0].SessionID, force)\n215\t\t}\n216\t\n217\t\t// Multiple active sessions: show TUI multi-select.\n218\t\treturn runStopMultiSelect(ctx, cmd, activeSessions, force)\n219\t}\n220\t\n221\t// filterActiveSessions returns sessions that have not been explicitly ended.\n222\t// A session is considered ended if Phase == PhaseEnded OR EndedAt is set.\n223\t// This matches the logic in status.go's writeActiveSessions for consistency:\n224\t// any session visible in `entire status` should also be visible in `sessions stop`.\n\n... [604 lines truncated] ..."},"type":"attachment","uuid":"a6e06447-81c9-4cd0-9a1d-8dde64af7123","timestamp":"2026-05-07T19:43:44.397Z","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/cli/checkpoint-export-cli","sessionId":"b3179a8b-1600-460b-a2e3-d256f3557add","version":"2.1.132","gitBranch":"checkpoint-export-cli"}
