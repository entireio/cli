nMetrics `json:\"session_metrics,omitempty\"`\n493\t\n494\t\t// AI-generated summary of the checkpoint\n495\t\tSummary *Summary `json:\"summary,omitempty\"`\n496\t\n497\t\t// InitialAttribution is line-level attribution calculated at commit time\n498\t\tInitialAttribution *InitialAttribution `json:\"initial_attribution,omitempty\"`\n499\t\n500\t\t// PromptAttributions is the raw per-prompt attribution data used to compute InitialAttribution.\n501\t\t// Diagnostic field — shows which prompt recorded which \"user\" lines.\n502\t\tPromptAttributions json.RawMessage `json:\"prompt_attributions,omitempty\"`\n503\t\n504\t\t// Kind identifies the session purpose (e.g., \"agent_review\"). Empty for normal sessions.\n505\t\tKind string `json:\"kind,omitempty\"`\n506\t\n507\t\t// ReviewSkills lists the review skills that were run (only set when Kind is a review kind).\n508\t\t// May be empty when a review was attached post-hoc without declared skills.\n509\t\tReviewSkills []string `json:\"review_skills,omitempty\"`\n510\t\n511\t\t// ReviewPrompt is the actual text of the review request (composed prompt\n512\t\t// for spawn, first user prompt for attach). Only set when Kind is a\n513\t\t// review kind.\n514\t\tReviewPrompt string `json:\"review_prompt,omitempty\"`\n515\t}\n516\t\n517\t// GetTranscriptStart returns the transcript line offset at which this checkpoint's data begins.\n518\t// Returns 0 for new checkpoints (start from beginning). For data written by older CLI versions,\n519\t// falls back to the deprecated TranscriptLinesAtStart field.\n520\tfunc (m CommittedMetadata) GetTranscriptStart() int {\n521\t\tif m.CheckpointTranscriptStart > 0 {\n522\t\t\treturn m.CheckpointTranscriptStart\n523\t\t}\n524\t\treturn m.TranscriptLinesAtStart\n525\t}\n526\t\n527\t// SessionFilePaths contains the absolute paths to session files from the git tree root.\n528\t// Paths include the full checkpoint path prefix (e.g., \"/a1/b2c3d4e5f6/1/metadata.json\").\n529\t// Used in CheckpointSummary.Sessions to map session IDs to their file locations.\n530\ttype SessionFilePaths struct {\n531\t\tMetadata    string `json:\"metadata\"`\n532\t\tTranscript  string `json:\"transcript,omitempty\"`\n533\t\tContentHash string `json:\"content_hash,omitempty\"`\n534\t\tPrompt      string `json:\"prompt\"`\n535\t}\n536\t\n537\t// CheckpointSummary is the root-level metadata.json for a checkpoint.\n538\t// It contains aggregated statistics from all sessions and a map of session IDs\n539\t// to their file paths. Session-specific data (including initial_attribution)\n540\t// is stored in the session's subdirectory metadata.json.\n541\t//\n542\t// Structure on entire/checkpoints/v1 branch:\n543\t//\n544\t//\t<checkpoint-id[:2]>/<checkpoint-id[2:]>/\n545\t//\t├── metadata.json         # This CheckpointSummary\n546\t//\t├── 1/                    # First session\n547\t//\t│   ├── metadata.json     # Session-specific CommittedMetadata\n548\t//\t│   ├── full.jsonl\n549\t//\t│   ├── prompt.txt\n550\t//\t│   └── content_hash.txt\n551\t//\t├── 2/                    # Second session\n552\t//\t└── 3/                    # Third session...\n553\t//\n554\t//nolint:revive // Named CheckpointSummary to avoid conflict with existing Summary struct\n555\ttype CheckpointSummary struct {\n556\t\tCLIVersion          string              `json:\"cli_version,omitempty\"`\n557\t\tCheckpointID        id.CheckpointID     `json:\"checkpoint_id\"`\n558\t\tStrategy            string              `json:\"strategy\"`\n559\t\tBranch              string              `json:\"branch,omitempty\"`\n560\t\tCheckpointsCount    int                 `json:\"checkpoints_count\"`\n561\t\tFilesTouched        []string            `json:\"files_touched\"`\n562\t\tSessions            []SessionFilePaths  `json:\"sessions\"`\n563\t\tTokenUsage          *agent.TokenUsage   `json:\"token_usage,omitempty\"`\n564\t\tCombinedAttribution *InitialAttribution `json:\"combined_attribution,omitempty\"`\n565\t\n566\t\t// HasReview