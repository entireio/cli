re\"), 0o755))\n53\t\trequire.NoError(t, os.WriteFile(\n54\t\t\tfilepath.Join(tmpDir, \".entire\", \"settings.json\"),\n55\t\t\t[]byte(`{\"enabled\": true, \"strategy_options\": {\"checkpoints_v2\": true}}`),\n56\t\t\t0o600,\n57\t\t))\n58\t\n59\t\treturn repo\n60\t}\n61\t\n62\tfunc writeV2CheckpointForExport(t *testing.T, repo *git.Repository, cpID id.CheckpointID, opts checkpoint.WriteCommittedOptions) {\n63\t\tt.Helper()\n64\t\tstore := checkpoint.NewV2GitStore(repo, \"origin\")\n65\t\topts.CheckpointID = cpID\n66\t\tif opts.AuthorName == \"\" {\n67\t\t\topts.AuthorName = exportTestAuthorName\n68\t\t}\n69\t\tif opts.AuthorEmail == \"\" {\n70\t\t\topts.AuthorEmail = exportTestAuthorEmail\n71\t\t}\n72\t\tif opts.Strategy == \"\" {\n73\t\t\topts.Strategy = \"manual-commit\"\n74\t\t}\n75\t\trequire.NoError(t, store.WriteCommitted(context.Background(), opts))\n76\t}\n77\t\n78\tfunc TestRunExplainExport_JSONSingleCheckpoint(t *testing.T) {\n79\t\trepo := setupExportRepo(t)\n80\t\n81\t\tcpID := id.MustCheckpointID(\"aaaa11112222\")\n82\t\twriteV2CheckpointForExport(t, repo, cpID, checkpoint.WriteCommittedOptions{\n83\t\t\tSessionID:         \"session-json\",\n84\t\t\tTranscript:        redact.AlreadyRedacted([]byte(`{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}` + \"\\n\")),\n85\t\t\tCompactTranscript: []byte(`{\"v\":1,\"type\":\"user\"}` + \"\\n\"),\n86\t\t})\n87\t\n88\t\tvar stdout, stderr bytes.Buffer\n89\t\terr := runExplainExport(context.Background(), &stdout, &stderr, explainExportOptions{\n90\t\t\ttarget:       \"aaaa1111\",\n91\t\t\tjson:         true,\n92\t\t\tsessionIndex: -1,\n93\t\t})\n94\t\trequire.NoError(t, err)\n95\t\n96\t\tvar envelope checkpointExportJSON\n97\t\trequire.NoError(t, json.Unmarshal(stdout.Bytes(), &envelope), \"output: %s\", stdout.String())\n98\t\n99\t\trequire.Equal(t, cpID.String(), envelope.CheckpointID)\n100\t\trequire.Equal(t, 1, envelope.SessionCount)\n101\t\trequire.Len(t, envelope.Sessions, 1)