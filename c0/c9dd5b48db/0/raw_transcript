closeOnDone)\n52\t\t\t_ = f.Close()\n53\t\t}()\n54\t\n55\t\t// Read into memory so we can shape-clean the trailing partial line. A\n56\t\t// single session transcript is bounded (low MB to ~100 MB at the\n57\t\t// extreme), which is fine for buffered handling.\n58\t\tbuf, err := io.ReadAll(f)\n59\t\tif err != nil {\n60\t\t\tif ctxErr := ctx.Err(); ctxErr != nil {\n61\t\t\t\treturn ctxErr //nolint:wrapcheck // propagating context cancellation\n62\t\t\t}\n63\t\t\treturn fmt.Errorf(\"read transcript: %w\", err)\n64\t\t}\n65\t\n66\t\tif i := bytes.LastIndexByte(buf, '\\n'); i >= 0 {\n67\t\t\tbuf = buf[:i+1]\n68\t\t} else {\n69\t\t\t// File holds a single non-terminated record — return empty rather\n70\t\t\t// than a truncated record. Vanishingly rare for live transcripts.\n71\t\t\tbuf = nil\n72\t\t}\n73\t\n74\t\tif _, err := w.Write(buf); err != nil {\n75\t\t\treturn fmt.Errorf(\"write transcript: %w\", err)\n76\t\t}\n77\t\treturn nil\n78\t}\n79\t\n80\tfunc newSessionsCmd() *cobra.Command {\n81\t\tcmd := &cobra.Command{\n82\t\t\tUse:     \"session\",\n83\t\t\tAliases: []string{\"sessions\"},\n84\t\t\tShort:   \"Manage agent sessions tracked by Entire\",\n85\t\t\tLong: `View and manage agent sessions tracked by Entire.\n86\t\n87\tCommands:\n88\t  list     List all sessions across all worktrees\n89\t  info     Show detailed information for a specific session\n90\t  stop     Stop one or more active sessions\n91\t  current  Show the active session for the current worktree\n92\t  attach   Attach an existing agent session\n93\t  resume   Switch to a branch and resume its session\n94\t\n95\tExamples:\n96\t  entire session list                      List all sessions\n97\t  entire session info <session-id>         Show session details\n98\t  entire session info <session-id> --json  Output as JSON\n99\t  entire session stop                      Interactive stop\n100\t  entire session current                   Active session for cwd\n101\t  entire session attach <session-id>      