// reviewEnvPrefixes.\n42\tvar investigateEnvPrefixes = []string{\n43\t\t\"ENTIRE_INVESTIGATE_SESSION=\",\n44\t\t\"ENTIRE_INVESTIGATE_AGENT=\",\n45\t\t\"ENTIRE_INVESTIGATE_RUN_ID=\",\n46\t\t\"ENTIRE_INVESTIGATE_ROUND=\",\n47\t\t\"ENTIRE_INVESTIGATE_TURN=\",\n48\t\t\"ENTIRE_INVESTIGATE_TOPIC=\",\n49\t\t\"ENTIRE_INVESTIGATE_PROMPT=\",\n50\t\t\"ENTIRE_INVESTIGATE_FINDINGS_DOC=\",\n51\t\t\"ENTIRE_INVESTIGATE_TIMELINE_DOC=\",\n52\t\t\"ENTIRE_INVESTIGATE_STARTING_SHA=\",\n53\t}\n54\t\n55\t// LaunchFixAgent starts a normal coding agent session with the given\n56\t// prompt. ENTIRE_REVIEW_* and ENTIRE_INVESTIGATE_* env entries are stripped\n57\t// from the child process so the fix session is not tagged as a review or\n58\t// investigate.\n59\t//\n60\t// agentName must be a launchable agent registry name. Returns nil on clean\n61\t// exit, or a wrapped error on cancellation / non-zero exit. Output / input\n62\t// are connected to the calling process's stdio so the user can interact\n63\t// with the fix session in their terminal.\n64\tfunc LaunchFixAgent(ctx context.Context, agentName string, prompt string) error {\n65\t\tag, err := agent.Get(agenttypes.AgentName(agentName))\n66\t\tif err != nil {\n67\t\t\treturn fmt.Errorf(\"resolve fix agent %s: %w\", agentName, err)\n68\t\t}\n69\t\tlauncher, ok := agent.LauncherFor(ag.Name())\n70\t\tif !ok {\n71\t\t\treturn fmt.Errorf(\"agent %s cannot be launched for fix sessions\", agentName)\n72\t\t}\n73\t\tcmd, err := launcher.LaunchCmd(ctx, prompt)\n74\t\tif err != nil {\n75\t\t\treturn fmt.Errorf(\"build fix command: %w\", err)\n76\t\t}\n77\t\tcmd.Env = withoutReviewOrInvestigateEnv(cmd.Env)\n78\t\tif len(cmd.Env) == 0 {\n79\t\t\tcmd.Env = withoutReviewOrInvestigateEnv(os.Environ())\n80\t\t}\n81\t\tif err := cmd.Run(); err != nil {\n82\t\t\tif errors.Is(err, context.Canceled) {\n83\t\t\t\treturn fmt.Errorf(\"fix agent cancelled: %w\", err)\n84\t\t\t}\n85\t\t\tvar exitErr *exec.ExitError\n86\t\t\tif errors.As(err, &exitErr) {\n87\t\t\