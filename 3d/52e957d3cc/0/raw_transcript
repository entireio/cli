wPrompt string `json:\"review_prompt,omitempty\"`\n118\t\n119\t\t// TurnID is a unique identifier for the current agent turn.\n120\t\t// Lifecycle:\n121\t\t//   - Generated fresh in InitializeSession at each turn start\n122\t\t//   - Shared across all checkpoints within the same turn\n123\t\t//   - Used to correlate related checkpoints when a turn's work spans multiple commits\n124\t\t//   - Persists until the next InitializeSession call generates a new one\n125\t\tTurnID string `json:\"turn_id,omitempty\"`\n126\t\n127\t\t// TurnCheckpointIDs tracks all checkpoint IDs condensed during the current turn.\n128\t\t// Lifecycle:\n129\t\t//   - Set in PostCommit when a checkpoint is condensed for an ACTIVE session\n130\t\t//   - Consumed in HandleTurnEnd to finalize all checkpoints with the full transcript\n131\t\t//   - Cleared in HandleTurnEnd after finalization completes\n132\t\t//   - Cleared in InitializeSession when a new prompt starts\n133\t\t//   - Cleared when session is reset (ResetSession deletes the state file entirely)\n134\t\tTurnCheckpointIDs []string `json:\"turn_checkpoint_ids,omitempty\"`\n135\t\n136\t\t// LastInteractionTime is updated on agent-interaction events (TurnStart,\n137\t\t// TurnEnd, SessionStop, Compaction) but NOT on git commit hooks.\n138\t\t// Used for stale session detection in \"entire doctor\".\n139\t\tLastInteractionTime *time.Time `json:\"last_interaction_time,omitempty\"`\n140\t\n141\t\t// StepCount is the number of checkpoints/steps created in this session.\n142\t\t// JSON tag kept as \"checkpoint_count\" for backward compatibility with existing state files.\n143\t\tStepCount int `json:\"checkpoint_count\"`\n144\t\n145\t\t// CheckpointTranscriptStart is the transcript line offset where the current\n146\t\t// checkpoint cycle began. Set to 0 at session start, updated to current\n147\t\t// transcript length after each condensation. Used to scope the transcript\n148\t\t// for checkpoint condensation: \"everything since last checkpoint