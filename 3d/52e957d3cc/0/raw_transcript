{"parentUuid":"968db799-ee9e-4170-9d9a-4e12654dc33b","isSidechain":false,"promptId":"5115a40f-3bbe-4e18-b349-376c9f5882f9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UVWAi2Rq5fbrjhTSVhsGNq","type":"tool_result","content":"1\t// Package checkpoint provides types and interfaces for checkpoint storage.\n2\t//\n3\t// A Checkpoint captures a point-in-time within a session, containing either\n4\t// full state (Temporary) or metadata with a commit reference (Committed).\n5\t//\n6\t// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\n7\tpackage checkpoint\n8\t\n9\timport (\n10\t\t\"context\"\n11\t\t\"encoding/json\"\n12\t\t\"errors\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n18\t\t\"github.com/entireio/cli/redact\"\n19\t\n20\t\t\"github.com/go-git/go-git/v6/plumbing\"\n21\t)\n22\t\n23\t// Errors returned by checkpoint operations.\n24\tvar (\n25\t\t// ErrCheckpointNotFound is returned when a checkpoint ID doesn't exist.\n26\t\tErrCheckpointNotFound = errors.New(\"checkpoint not found\")\n27\t\n28\t\t// ErrNoTranscript is returned when a checkpoint exists but has no transcript.\n29\t\tErrNoTranscript = errors.New(\"no transcript found for checkpoint\")\n30\t)\n31\t\n32\t// Checkpoint represents a save point within a session.\n33\ttype Checkpoint struct {\n34\t\t// ID is the unique checkpoint identifier\n35\t\tID string\n36\t\n37\t\t// SessionID is the session this checkpoint belongs to\n38\t\tSessionID string\n39\t\n40\t\t// Timestamp is when this checkpoint was created\n41\t\tTimestamp time.Time\n42\t\n43\t\t// Type indicates temporary (full state) or committed (metadata only)\n44\t\tType Type\n45\t\n46\t\t// Message is a human-readable description of the checkpoint\n47\t\tMessage string\n48\t}\n49\t\n50\t// Type indicates the storage location and lifecycle of a checkpoint.\n51\ttype Type int\n52\t\n53\tconst (\n54\t\t// Temporary checkpoints contain full state (code + metadata) and are stored\n55\t\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n56\t\tTemporary Type = iota\n57\t\n58\t\t// Committed checkpoints contain metadata + commit reference and are stored\n59\t\t// on the entire/checkpoints/v1 branch. They are the permanent record.\n60\t\tCommitted\n61\t)\n62\t\n63\t// Store provides low-level primitives for reading and writing checkpoints.\n64\t// This is used by strategies to implement their storage approach.\n65\t//\n66\t// The interface matches the GitStore implementation signatures directly:\n67\t// - WriteTemporary takes WriteTemporaryOptions and returns a result with commit hash and skip status\n68\t// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n69\t// - List methods return implementation-specific info types for richer data\n70\ttype Store interface {\n71\t\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n72\t\t// Shadow branches are named entire/<base-commit-short-hash>.\n73\t\t// Returns a result containing the commit hash and whether the checkpoint was skipped.\n74\t\t// Checkpoints are skipped (deduplicated) when the tree hash matches the previous checkpoint.\n75\t\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (WriteTemporaryResult, error)\n76\t\n77\t\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n78\t\t// baseCommit is the commit hash the session is based on.\n79\t\t// worktreeID is the internal git worktree identifier (empty for main worktree).\n80\t\t// Returns nil, nil if the shadow branch doesn't exist.\n81\t\tReadTemporary(ctx context.Context, baseCommit, worktreeID string) (*ReadTemporaryResult, error)\n82\t\n83\t\t// ListTemporary lists all shadow branches with their checkpoint info.\n84\t\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n85\t\n86\t\t// WriteCommitted writes a committed checkpoint to the entire/checkpoints/v1 branch.\n87\t\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n88\t\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n89\t\n90\t\t// ReadCommitted reads a committed checkpoint's summary by ID.\n91\t\t// Returns only the CheckpointSummary (paths + aggregated stats), not actual content.\n92\t\t// Use ReadSessionContent to read actual transcript/prompts.\n93\t\t// Returns nil, nil if the checkpoint does not exist.\n94\t\tReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*CheckpointSummary, error)\n95\t\n96\t\t// ReadSessionContent reads the actual content for a specific session within a checkpoint.\n97\t\t// sessionIndex is 0-based (0 for first session, 1 for second, etc.).\n98\t\t// Returns the session's metadata, transcript, and prompts.\n99\t\tReadSessionContent(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error)\n100\t\n101\t\t// ReadSessionContentByID reads a session's content by its session ID.\n102\t\t// Useful when you have the session ID but don't know its index within the checkpoint.\n103\t\tReadSessionContentByID(ctx context.Context, checkpointID id.CheckpointID, sessionID string) (*SessionContent, error)\n104\t\n105\t\t// ListCommitted lists all committed checkpoints.\n106\t\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n107\t\n108\t\t// UpdateCommitted replaces the transcript and prompts for an existing\n109\t\t// committed checkpoint. Used at stop time to finalize checkpoints with the full\n110\t\t// session transcript (prompt to stop event).\n111\t\t// Returns ErrCheckpointNotFound if the checkpoint doesn't exist.\n112\t\tUpdateCommitted(ctx context.Context, opts UpdateCommittedOptions) error\n113\t}\n114\t\n115\t// WriteTemporaryResult contains the result of writing a temporary checkpoint.\n116\ttype WriteTemporaryResult struct {\n117\t\t// CommitHash is the hash of the created or existing checkpoint commit\n118\t\tCommitHash plumbing.Hash\n119\t\n120\t\t// Skipped is true if the checkpoint was skipped due to no changes\n121\t\t// (tree hash matched the previous checkpoint)\n122\t\tSkipped bool\n123\t}\n124\t\n125\t// WriteTemporaryOptions contains options for writing a temporary checkpoint.\n126\ttype WriteTemporaryOptions struct {\n127\t\t// SessionID is the session identifier\n128\t\tSessionID string\n129\t\n130\t\t// BaseCommit is the commit hash this session is based on\n131\t\tBaseCommit string\n132\t\n133\t\t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n134\t\t// Used to create worktree-specific shadow branch names\n135\t\tWorktreeID string\n136\t\n137\t\t// ModifiedFiles are files that have been modified (relative paths)\n138\t\tModifiedFiles []string\n139\t\n140\t\t// NewFiles are files that have been created (relative paths)\n141\t\tNewFiles []string\n142\t\n143\t\t// DeletedFiles are files that have been deleted (relative paths)\n144\t\tDeletedFiles []string\n145\t\n146\t\t// MetadataDir is the relative path to the metadata directory\n147\t\tMetadataDir string\n148\t\n149\t\t// MetadataDirAbs is the absolute path to the metadata directory\n150\t\tMetadataDirAbs string\n151\t\n152\t\t// CommitMessage is the commit subject line\n153\t\tCommitMessage string\n154\t\n155\t\t// AuthorName is the name to use for commits\n156\t\tAuthorName string\n157\t\n158\t\t// AuthorEmail is the email to use for commits\n159\t\tAuthorEmail string\n160\t\n161\t\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n162\t\t// When true, all working directory files are captured (not just modified)\n163\t\tIsFirstCheckpoint bool\n164\t}\n165\t\n166\t// ReadTemporaryResult contains the result of reading a temporary checkpoint.\n167\ttype ReadTemporaryResult struct {\n168\t\t// CommitHash is the hash of the checkpoint commit\n169\t\tCommitHash plumbing.Hash\n170\t\n171\t\t// TreeHash is the hash of the tree containing the checkpoint state\n172\t\tTreeHash plumbing.Hash\n173\t\n174\t\t// SessionID is the session identifier from the commit trailer\n175\t\tSessionID string\n176\t\n177\t\t// MetadataDir is the metadata directory path from the commit trailer\n178\t\tMetadataDir string\n179\t\n180\t\t// Timestamp is when the checkpoint was created\n181\t\tTimestamp time.Time\n182\t}\n183\t\n184\t// TemporaryInfo contains summary information about a shadow branch.\n185\ttype TemporaryInfo struct {\n186\t\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n187\t\tBranchName string\n188\t\n189\t\t// BaseCommit is the short commit hash this branch is based on\n190\t\tBaseCommit string\n191\t\n192\t\t// LatestCommit is the hash of the latest commit on the branch\n193\t\tLatestCommit plumbing.Hash\n194\t\n195\t\t// SessionID is the session identifier from the latest commit\n196\t\tSessionID string\n197\t\n198\t\t// Timestamp is when the latest checkpoint was created\n199\t\tTimestamp time.Time\n200\t}\n201\t\n202\t// WriteCommittedOptions contains options for writing a committed checkpoint.\n203\ttype WriteCommittedOptions struct {\n204\t\t// CheckpointID is the stable 12-hex-char identifier\n205\t\tCheckpointID id.CheckpointID\n206\t\n207\t\t// SessionID is the session identifier\n208\t\tSessionID string\n209\t\n210\t\t// CreatedAt is when the checkpoint was originally created.\n211\t\t// When zero, writers use the current time. Migration sets this to preserve\n212\t\t// the original v1 checkpoint time in v2 metadata and retention decisions.\n213\t\tCreatedAt time.Time\n214\t\n215\t\t// Strategy is the name of the strategy that created this checkpoint\n216\t\tStrategy string\n217\t\n218\t\t// Branch is the branch name where the checkpoint was created (empty if detached HEAD)\n219\t\tBranch string\n220\t\n221\t\t// Transcript is the session transcript content (full.jsonl).\n222\t\t// Must be pre-redacted (via redact.JSONLBytes or redact.AlreadyRedacted for trusted sources).\n223\t\tTranscript redact.RedactedBytes\n224\t\n225\t\t// Prompts contains user prompts from the session\n226\t\tPrompts []string\n227\t\n228\t\t// FilesTouched are files modified during the session\n229\t\tFilesTouched []string\n230\t\n231\t\t// CheckpointsCount is the number of checkpoints in this session\n232\t\tCheckpointsCount int\n233\t\n234\t\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n235\t\tEphemeralBranch string\n236\t\n237\t\t// AuthorName is the name to use for commits\n238\t\tAuthorName string\n239\t\n240\t\t// AuthorEmail is the email to use for commits\n241\t\tAuthorEmail string\n242\t\n243\t\t// MetadataDir is a directory containing additional metadata files to copy\n244\t\t// If set, all files in this directory will be copied to the checkpoint path\n245\t\t// This is useful for copying task metadata files, subagent transcripts, etc.\n246\t\tMetadataDir string\n247\t\n248\t\t// Task checkpoint fields (for task/subagent checkpoints)\n249\t\tIsTask    bool   // Whether this is a task checkpoint\n250\t\tToolUseID string // Tool use ID for task checkpoints\n251\t\n252\t\t// Additional task checkpoint fields for subagent checkpoints\n253\t\tAgentID                string // Subagent identifier\n254\t\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n255\t\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n256\t\tSubagentTranscriptPath string // Path to subagent's transcript file\n257\t\n258\t\t// Incremental checkpoint fields\n259\t\tIsIncremental       bool   // Whether this is an incremental checkpoint\n260\t\tIncrementalSequence int    // Checkpoint sequence number\n261\t\tIncrementalType     string // Tool type that triggered this checkpoint\n262\t\tIncrementalData     []byte // Tool input payload for this checkpoint\n263\t\n264\t\t// Commit message fields (used for task checkpoints)\n265\t\tCommitSubject string // Subject line for the metadata commit (overrides default)\n266\t\n267\t\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n268\t\tAgent types.AgentType\n269\t\n270\t\t// Model is the LLM model used during the session (e.g., \"claude-sonnet-4-20250514\")\n271\t\tModel string\n272\t\n273\t\t// TurnID correlates checkpoints from the same agent turn.\n274\t\tTurnID string\n275\t\n276\t\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n277\t\tTranscriptIdentifierAtStart string // Last identifier when checkpoint started (UUID for Claude, message ID for Gemini)\n278\t\tCheckpointTranscriptStart   int    // Transcript line offset at start of this checkpoint's data\n279\t\n280\t\t// CheckpointTranscriptStart is written to both CommittedMetadata.CheckpointTranscriptStart\n281\t\t// and the deprecated CommittedMetadata.TranscriptLinesAtStart for backward compatibility.\n282\t\n283\t\t// CompactTranscriptStart is the transcript.jsonl line offset at checkpoint start.\n284\t\t// V2 /main writes this to checkpoint_transcript_start; v1 continues to use\n285\t\t// CheckpointTranscriptStart (full.jsonl).\n286\t\tCompactTranscriptStart int\n287\t\n288\t\t// TokenUsage contains the token usage for this checkpoint\n289\t\tTokenUsage *agent.TokenUsage\n290\t\n291\t\t// SessionMetrics contains hook-provided session metrics (duration, turns, context usage)\n292\t\tSessionMetrics *SessionMetrics\n293\t\n294\t\t// InitialAttribution is line-level attribution calculated at commit time\n295\t\t// comparing checkpoint tree (agent work) to committed tree (may include human edits)\n296\t\tInitialAttribution *InitialAttribution\n297\t\n298\t\t// PromptAttributionsJSON is the raw PromptAttributions data, JSON-encoded.\n299\t\t// Persisted for diagnostic purposes — shows exactly which prompt recorded\n300\t\t// which \"user\" lines, enabling root cause analysis of attribution bugs.\n301\t\t// Uses json.RawMessage to avoid importing session package.\n302\t\tPromptAttributionsJSON json.RawMessage\n303\t\n304\t\t// CombinedAttribution is holistic attribution across all sessions.\n305\t\t// Used during migration to preserve v1 root summary attribution.\n306\t\t// During normal condensation this is nil (computed post-commit via UpdateCheckpointSummary).\n307\t\tCombinedAttribution *InitialAttribution\n308\t\n309\t\t// Summary is an optional AI-generated summary for this checkpoint.\n310\t\t// This field may be nil when:\n311\t\t//   - summarization is disabled in settings\n312\t\t//   - summary generation failed (non-blocking, logged as warning)\n313\t\t//   - the transcript was empty or too short to summarize\n314\t\t//   - the checkpoint predates the summarization feature\n315\t\tSummary *Summary\n316\t\n317\t\t// CompactTranscript is the Entire Transcript Format (transcript.jsonl) bytes.\n318\t\t// Written to v2 /main ref alongside metadata. May be nil if compaction\n319\t\t// was not performed (unknown agent, compaction error, empty transcript).\n320\t\tCompactTranscript []byte\n321\t\n322\t\t// Kind identifies the session purpose (e.g., \"agent_review\"). Empty for normal sessions.\n323\t\tKind string\n324\t\n325\t\t// ReviewSkills is the snapshot of skills used (only meaningful when Kind is a review kind).\n326\t\t// May be empty when a review is attached post-hoc without declared skills.\n327\t\tReviewSkills []string\n328\t\n329\t\t// ReviewPrompt is the actual text of the review request (composed prompt\n330\t\t// for spawn, first user prompt for attach). Only meaningful when Kind is\n331\t\t// a review kind.\n332\t\tReviewPrompt string\n333\t\n334\t\t// HasReview is set by the caller when this session should mark its\n335\t\t// checkpoint as reviewed. The caller computes this (e.g. via\n336\t\t// session.Kind.IsReview) because checkpoint can't import session\n337\t\t// — the session package imports checkpoint, creating a cycle.\n338\t\tHasReview bool\n339\t}\n340\t\n341\t// UpdateCommittedOptions contains options for updating an existing committed checkpoint.\n342\t// Uses replace semantics: the transcript and prompts are fully replaced,\n343\t// not appended. At stop time we have the complete session transcript and want every\n344\t// checkpoint to contain it identically.\n345\ttype UpdateCommittedOptions struct {\n346\t\t// CheckpointID identifies the checkpoint to update\n347\t\tCheckpointID id.CheckpointID\n348\t\n349\t\t// SessionID identifies which session slot to update within the checkpoint\n350\t\tSessionID string\n351\t\n352\t\t// Transcript is the full session transcript (replaces existing).\n353\t\t// Must be pre-redacted (via redact.JSONLBytes or redact.AlreadyRedacted for trusted sources).\n354\t\tTranscript redact.RedactedBytes\n355\t\n356\t\t// Prompts contains all user prompts (replaces existing)\n357\t\tPrompts []string\n358\t\n359\t\t// Agent identifies the agent type (needed for transcript chunking)\n360\t\tAgent types.AgentType\n361\t\n362\t\t// CompactTranscript is the updated Entire Transcript Format bytes.\n363\t\t// If non-nil, replaces the existing transcript.jsonl on v2 /main.\n364\t\tCompactTranscript []byte\n365\t\n366\t\t// PrecomputedBlobs, if non-nil, provides chunk blob hashes and the\n367\t\t// content-hash blob hash computed once for this transcript. When set,\n368\t\t// UpdateCommitted skips the per-call ChunkTranscript + zlib work and\n369\t\t// reuses these hashes. Used by finalizeAllTurnCheckpoints to avoid\n370\t\t// re-compressing identical content N times.\n371\t\tPrecomputedBlobs *PrecomputedTranscriptBlobs\n372\t}\n373\t\n374\t// PrecomputedTranscriptBlobs holds blob hashes for a transcript that was\n375\t// chunked and written to the object store once, for reuse across multiple\n376\t// UpdateCommitted calls sharing the same transcript content.\n377\t//\n378\t// Blob hashes are content-addressed (SHA-1 of chunk bytes), so the same\n379\t// PrecomputedTranscriptBlobs works for both v1 (full.jsonl) and v2\n380\t// (raw_transcript) paths — only the tree-entry filename differs.\n381\t//\n382\t// Callers should avoid constructing this for empty transcripts; agent.ChunkTranscript\n383\t// would otherwise produce a single zero-length chunk and a hash for an empty\n384\t// blob, which downstream stores would never reference.\n385\ttype PrecomputedTranscriptBlobs struct {\n386\t\t// ChunkHashes are the blob hashes for each transcript chunk, in order.\n387\t\t// Always non-empty when built via PrecomputeTranscriptBlobs (a non-empty\n388\t\t// transcript chunks to at least one entry; callers should skip precompute\n389\t\t// for empty transcripts).\n390\t\tChunkHashes []plumbing.Hash\n391\t\n392\t\t// ContentHashBlob is the blob hash of the \"sha256:<hex>\" content-hash\n393\t\t// string for the transcript.\n394\t\tContentHashBlob plumbing.Hash\n395\t\n396\t\t// ContentHash is the \"sha256:<hex>\" string itself, so the short-circuit\n397\t\t// path can compare without re-reading the blob.\n398\t\tContentHash string\n399\t}\n400\t\n401\t// isUsable reports whether the precomputed blobs satisfy the invariants that\n402\t// consumers depend on: a non-zero content-hash blob and at least one chunk\n403\t// hash. Callers should fall back to the fresh-write path when this is false.\n404\tfunc (p *PrecomputedTranscriptBlobs) isUsable() bool {\n405\t\treturn p != nil && !p.ContentHashBlob.IsZero() && len(p.ChunkHashes) > 0\n406\t}\n407\t\n408\t// CommittedInfo contains summary information about a committed checkpoint.\n409\ttype CommittedInfo struct {\n410\t\t// CheckpointID is the stable 12-hex-char identifier\n411\t\tCheckpointID id.CheckpointID\n412\t\n413\t\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n414\t\tSessionID string\n415\t\n416\t\t// CreatedAt is when the checkpoint was created\n417\t\tCreatedAt time.Time\n418\t\n419\t\t// CheckpointsCount is the total number of checkpoints across all sessions\n420\t\tCheckpointsCount int\n421\t\n422\t\t// FilesTouched are files modified during all sessions\n423\t\tFilesTouched []string\n424\t\n425\t\t// Agent identifies the agent that created this checkpoint\n426\t\tAgent types.AgentType\n427\t\n428\t\t// IsTask indicates if this is a task checkpoint\n429\t\tIsTask bool\n430\t\n431\t\t// ToolUseID is the tool use ID for task checkpoints\n432\t\tToolUseID string\n433\t\n434\t\t// Multi-session support\n435\t\tSessionCount int      // Number of sessions (1 if single session)\n436\t\tSessionIDs   []string // All session IDs that contributed\n437\t}\n438\t\n439\t// SessionContent contains the actual content for a session.\n440\t// This is used when reading full session data (transcript, prompts, context)\n441\t// as opposed to just the metadata/summary.\n442\ttype SessionContent struct {\n443\t\t// Metadata contains the session-specific metadata\n444\t\tMetadata CommittedMetadata\n445\t\n446\t\t// Transcript is the session transcript content\n447\t\tTranscript []byte\n448\t\n449\t\t// Prompts contains user prompts from this session\n450\t\tPrompts string\n451\t}\n452\t\n453\t// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\n454\ttype CommittedMetadata struct {\n455\t\tCLIVersion       string          `json:\"cli_version,omitempty\"`\n456\t\tCheckpointID     id.CheckpointID `json:\"checkpoint_id\"`\n457\t\tSessionID        string          `json:\"session_id\"`\n458\t\tStrategy         string          `json:\"strategy\"`\n459\t\tCreatedAt        time.Time       `json:\"created_at\"`\n460\t\tBranch           string          `json:\"branch,omitempty\"` // Branch where checkpoint was created (empty if detached HEAD)\n461\t\tCheckpointsCount int             `json:\"checkpoints_count\"`\n462\t\tFilesTouched     []string        `json:\"files_touched\"`\n463\t\n464\t\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n465\t\tAgent types.AgentType `json:\"agent,omitempty\"`\n466\t\n467\t\t// Model is the LLM model used during the session (e.g., \"claude-sonnet-4-20250514\").\n468\t\t// Always written to metadata (empty string when unknown) so consumers can rely on the field's presence.\n469\t\tModel string `json:\"model\"`\n470\t\n471\t\t// TurnID correlates checkpoints from the same agent turn.\n472\t\t// When a turn's work spans multiple commits, each gets its own checkpoint\n473\t\t// but they share the same TurnID for future aggregation/deduplication.\n474\t\tTurnID string `json:\"turn_id,omitempty\"`\n475\t\n476\t\t// Task checkpoint fields (only populated for task checkpoints)\n477\t\tIsTask    bool   `json:\"is_task,omitempty\"`\n478\t\tToolUseID string `json:\"tool_use_id,omitempty\"`\n479\t\n480\t\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n481\t\tTranscriptIdentifierAtStart string `json:\"transcript_identifier_at_start,omitempty\"` // Last identifier when checkpoint started (UUID for Claude, message ID for Gemini)\n482\t\tCheckpointTranscriptStart   int    `json:\"checkpoint_transcript_start,omitempty\"`    // Transcript line offset at start of this checkpoint's data\n483\t\n484\t\t// Deprecated: Use CheckpointTranscriptStart instead. Written for backward compatibility with older CLI versions.\n485\t\tTranscriptLinesAtStart int `json:\"transcript_lines_at_start,omitempty\"`\n486\t\n487\t\t// Token usage for this checkpoint\n488\t\tTokenUsage *agent.TokenUsage `json:\"token_usage,omitempty\"`\n489\t\n490\t\t// SessionMetrics contains hook-provided session metrics (duration, turns, context usage).\n491\t\t// Populated for agents that provide these metrics via hooks (e.g., Cursor).\n492\t\tSessionMetrics *SessionMetrics `json:\"session_metrics,omitempty\"`\n493\t\n494\t\t// AI-generated summary of the checkpoint\n495\t\tSummary *Summary `json:\"summary,omitempty\"`\n496\t\n497\t\t// InitialAttribution is line-level attribution calculated at commit time\n498\t\tInitialAttribution *InitialAttribution `json:\"initial_attribution,omitempty\"`\n499\t\n500\t\t// PromptAttributions is the raw per-prompt attribution data used to compute InitialAttribution.\n501\t\t// Diagnostic field — shows which prompt recorded which \"user\" lines.\n502\t\tPromptAttributions json.RawMessage `json:\"prompt_attributions,omitempty\"`\n503\t\n504\t\t// Kind identifies the session purpose (e.g., \"agent_review\"). Empty for normal sessions.\n505\t\tKind string `json:\"kind,omitempty\"`\n506\t\n507\t\t// ReviewSkills lists the review skills that were run (only set when Kind is a review kind).\n508\t\t// May be empty when a review was attached post-hoc without declared skills.\n509\t\tReviewSkills []string `json:\"review_skills,omitempty\"`\n510\t\n511\t\t// ReviewPrompt is the actual text of the review request (composed prompt\n512\t\t// for spawn, first user prompt for attach). Only set when Kind is a\n513\t\t// review kind.\n514\t\tReviewPrompt string `json:\"review_prompt,omitempty\"`\n515\t}\n516\t\n517\t// GetTranscriptStart returns the transcript line offset at which this checkpoint's data begins.\n518\t// Returns 0 for new checkpoints (start from beginning). For data written by older CLI versions,\n519\t// falls back to the deprecated TranscriptLinesAtStart field.\n520\tfunc (m CommittedMetadata) GetTranscriptStart() int {\n521\t\tif m.CheckpointTranscriptStart > 0 {\n522\t\t\treturn m.CheckpointTranscriptStart\n523\t\t}\n524\t\treturn m.TranscriptLinesAtStart\n525\t}\n526\t\n527\t// SessionFilePaths contains the absolute paths to session files from the git tree root.\n528\t// Paths include the full checkpoint path prefix (e.g., \"/a1/b2c3d4e5f6/1/metadata.json\").\n529\t// Used in CheckpointSummary.Sessions to map session IDs to their file locations.\n530\ttype SessionFilePaths struct {\n531\t\tMetadata    string `json:\"metadata\"`\n532\t\tTranscript  string `json:\"transcript,omitempty\"`\n533\t\tContentHash string `json:\"content_hash,omitempty\"`\n534\t\tPrompt      string `json:\"prompt\"`\n535\t}\n536\t\n537\t// CheckpointSummary is the root-level metadata.json for a checkpoint.\n538\t// It contains aggregated statistics from all sessions and a map of session IDs\n539\t// to their file paths. Session-specific data (including initial_attribution)\n540\t// is stored in the session's subdirectory metadata.json.\n541\t//\n542\t// Structure on entire/checkpoints/v1 branch:\n543\t//\n544\t//\t<checkpoint-id[:2]>/<checkpoint-id[2:]>/\n545\t//\t├── metadata.json         # This CheckpointSummary\n546\t//\t├── 1/                    # First session\n547\t//\t│   ├── metadata.json     # Session-specific CommittedMetadata\n548\t//\t│   ├── full.jsonl\n549\t//\t│   ├── prompt.txt\n550\t//\t│   └── content_hash.txt\n551\t//\t├── 2/                    # Second session\n552\t//\t└── 3/                    # Third session...\n553\t//\n554\t//nolint:revive // Named CheckpointSummary to avoid conflict with existing Summary struct\n555\ttype CheckpointSummary struct {\n556\t\tCLIVersion          string              `json:\"cli_version,omitempty\"`\n557\t\tCheckpointID        id.CheckpointID     `json:\"checkpoint_id\"`\n558\t\tStrategy            string              `json:\"strategy\"`\n559\t\tBranch              string              `json:\"branch,omitempty\"`\n560\t\tCheckpointsCount    int                 `json:\"checkpoints_count\"`\n561\t\tFilesTouched        []string            `json:\"files_touched\"`\n562\t\tSessions            []SessionFilePaths  `json:\"sessions\"`\n563\t\tTokenUsage          *agent.TokenUsage   `json:\"token_usage,omitempty\"`\n564\t\tCombinedAttribution *InitialAttribution `json:\"combined_attribution,omitempty\"`\n565\t\n566\t\t// HasReview is the umbrella \"any review happened\" flag: true when at least\n567\t\t// one session in this checkpoint has a review-kind Kind (currently\n568\t\t// \"agent_review\"). When new review kinds are introduced they should also\n569\t\t// cause this flag to be set so callers can keep asking \"was this reviewed\n570\t\t// in any way?\" without caring about the variant.\n571\t\tHasReview bool `json:\"has_review,omitempty\"`\n572\t}\n573\t\n574\t// SessionMetrics contains hook-provided session metrics from agents that report\n575\t// them via lifecycle hooks (e.g., Cursor). These supplement transcript-derived\n576\t// metrics for agents whose transcripts lack usage/timing data.\n577\ttype SessionMetrics struct {\n578\t\tDurationMs        int64 `json:\"duration_ms,omitempty\"`\n579\t\tTurnCount         int   `json:\"turn_count,omitempty\"`\n580\t\tContextTokens     int   `json:\"context_tokens,omitempty\"`\n581\t\tContextWindowSize int   `json:\"context_window_size,omitempty\"`\n582\t}\n583\t\n584\t// Summary contains AI-generated summary of a checkpoint.\n585\ttype Summary struct {\n586\t\tIntent    string           `json:\"intent\"`     // What user wanted to accomplish\n587\t\tOutcome   string           `json:\"outcome\"`    // What was achieved\n588\t\tLearnings LearningsSummary `json:\"learnings\"`  // Categorized learnings\n589\t\tFriction  []string         `json:\"friction\"`   // Problems/annoyances encountered\n590\t\tOpenItems []string         `json:\"open_items\"` // Tech debt, unfinished work\n591\t}\n592\t\n593\t// LearningsSummary contains learnings grouped by scope.\n594\ttype LearningsSummary struct {\n595\t\tRepo     []string       `json:\"repo\"`     // Codebase-specific patterns/conventions\n596\t\tCode     []CodeLearning `json:\"code\"`     // File/module specific findings\n597\t\tWorkflow []string       `json:\"workflow\"` // General dev practices\n598\t}\n599\t\n600\t// CodeLearning captures a learning tied to a specific code location.\n601\ttype CodeLearning struct {\n602\t\tPath    string `json:\"path\"`               // File path\n603\t\tLine    int    `json:\"line,omitempty\"`     // Start line number\n604\t\tEndLine int    `json:\"end_line,omitempty\"` // End line for ranges (optional)\n605\t\tFinding string `json:\"finding\"`            // What was learned\n606\t}\n607\t\n608\t// InitialAttribution captures line-level attribution metrics at commit time.\n609\t// This is a point-in-time snapshot comparing the checkpoint tree (agent work)\n610\t// against the committed tree (may include human edits).\n611\t//\n612\t// Attribution Metrics:\n613\t//   - TotalCommitted keeps the historical \"net additions\" view for compatibility\n614\t//   - TotalLinesChanged measures total committed line changes (adds + modifies + removes)\n615\t//   - AgentPercentage represents \"of the lines changed in this commit, what percentage came from the agent\"\n616\t//   - AgentRemoved tracks committed deletions performed by the agent\n617\ttype InitialAttribution struct {\n618\t\tCalculatedAt      time.Time `json:\"calculated_at\"`\n619\t\tAgentLines        int       `json:\"agent_lines\"`              // Lines added by agent that remain in the commit\n620\t\tAgentRemoved      int       `json:\"agent_removed\"`            // Lines removed by agent that remain removed in the commit\n621\t\tHumanAdded        int       `json:\"human_added\"`              // Lines added by human (excluding modifications)\n622\t\tHumanModified     int       `json:\"human_modified\"`           // Lines modified by human (estimate: min(added, removed))\n623\t\tHumanRemoved      int       `json:\"human_removed\"`            // Lines removed by human (excluding modifications)\n624\t\tTotalCommitted    int       `json:\"total_committed\"`          // Net additions in commit (legacy additions-focused metric)\n625\t\tTotalLinesChanged int       `json:\"total_lines_changed\"`      // Total committed line changes (adds + modifies + removes)\n626\t\tAgentPercentage   float64   `json:\"agent_percentage\"`         // (agent_lines + agent_removed) / total_lines_changed * 100\n627\t\tMetricVersion     int       `json:\"metric_version,omitempty\"` // 0/absent = legacy (additions-only %), 2 = changed-lines %\n628\t}\n629\t\n630\t// Info provides summary information for listing checkpoints.\n631\t// This is the generic checkpoint info type.\n632\ttype Info struct {\n633\t\t// ID is the checkpoint identifier\n634\t\tID string\n635\t\n636\t\t// SessionID identifies the session\n637\t\tSessionID string\n638\t\n639\t\t// Type indicates temporary or committed\n640\t\tType Type\n641\t\n642\t\t// CreatedAt is when the checkpoint was created\n643\t\tCreatedAt time.Time\n644\t\n645\t\t// Message is a summary description\n646\t\tMessage string\n647\t}\n648\t\n649\t// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n650\t// Task checkpoints are created when a subagent completes and contain both\n651\t// code changes and task-specific metadata.\n652\ttype WriteTemporaryTaskOptions struct {\n653\t\t// SessionID is the session identifier\n654\t\tSessionID string\n655\t\n656\t\t// BaseCommit is the commit hash this session is based on\n657\t\tBaseCommit string\n658\t\n659\t\t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n660\t\t// Used to create worktree-specific shadow branch names\n661\t\tWorktreeID string\n662\t\n663\t\t// ToolUseID is the unique identifier for this Task tool invocation\n664\t\tToolUseID string\n665\t\n666\t\t// AgentID is the subagent identifier\n667\t\tAgentID string\n668\t\n669\t\t// ModifiedFiles are files that have been modified (relative paths)\n670\t\tModifiedFiles []string\n671\t\n672\t\t// NewFiles are files that have been created (relative paths)\n673\t\tNewFiles []string\n674\t\n675\t\t// DeletedFiles are files that have been deleted (relative paths)\n676\t\tDeletedFiles []string\n677\t\n678\t\t// TranscriptPath is the path to the main session transcript\n679\t\tTranscriptPath string\n680\t\n681\t\t// SubagentTranscriptPath is the path to the subagent's transcript\n682\t\tSubagentTranscriptPath string\n683\t\n684\t\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n685\t\tCheckpointUUID string\n686\t\n687\t\t// CommitMessage is the commit message (already formatted)\n688\t\tCommitMessage string\n689\t\n690\t\t// AuthorName is the name to use for commits\n691\t\tAuthorName string\n692\t\n693\t\t// AuthorEmail is the email to use for commits\n694\t\tAuthorEmail string\n695\t\n696\t\t// IsIncremental indicates this is an incremental checkpoint\n697\t\tIsIncremental bool\n698\t\n699\t\t// IncrementalSequence is the checkpoint sequence number\n700\t\tIncrementalSequence int\n701\t\n702\t\t// IncrementalType is the tool that triggered this checkpoint\n703\t\tIncrementalType string\n704\t\n705\t\t// IncrementalData is the tool_input payload for this checkpoint\n706\t\tIncrementalData []byte\n707\t}\n708\t\n709\t// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n710\t// Used by ListTemporaryCheckpoints to provide rewind point data.\n711\ttype TemporaryCheckpointInfo struct {\n712\t\t// CommitHash is the hash of the checkpoint commit\n713\t\tCommitHash plumbing.Hash\n714\t\n715\t\t// Message is the first line of the commit message\n716\t\tMessage string\n717\t\n718\t\t// SessionID is the session identifier from the Entire-Session trailer\n719\t\tSessionID string\n720\t\n721\t\t// MetadataDir is the metadata directory path from trailers\n722\t\tMetadataDir string\n723\t\n724\t\t// IsTaskCheckpoint indicates if this is a task checkpoint\n725\t\tIsTaskCheckpoint bool\n726\t\n727\t\t// ToolUseID is the tool use ID for task checkpoints\n728\t\tToolUseID string\n729\t\n730\t\t// Timestamp is when the checkpoint was created\n731\t\tTimestamp time.Time\n732\t}\n733\t"}]},"uuid":"3e28ac8d-448d-4104-86a2-a47b8731f931","timestamp":"2026-05-09T00:05:32.087Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/alisha/.marvin/worktrees/cli/entire-labs-investigate/cmd/entire/cli/checkpoint/checkpoint.go","content":"// Package checkpoint provides types and interfaces for checkpoint storage.\n//\n// A Checkpoint captures a point-in-time within a session, containing either\n// full state (Temporary) or metadata with a commit reference (Committed).\n//\n// See docs/architecture/sessions-and-checkpoints.md for the full domain model.\npackage checkpoint\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/redact\"\n\n\t\"github.com/go-git/go-git/v6/plumbing\"\n)\n\n// Errors returned by checkpoint operations.\nvar (\n\t// ErrCheckpointNotFound is returned when a checkpoint ID doesn't exist.\n\tErrCheckpointNotFound = errors.New(\"checkpoint not found\")\n\n\t// ErrNoTranscript is returned when a checkpoint exists but has no transcript.\n\tErrNoTranscript = errors.New(\"no transcript found for checkpoint\")\n)\n\n// Checkpoint represents a save point within a session.\ntype Checkpoint struct {\n\t// ID is the unique checkpoint identifier\n\tID string\n\n\t// SessionID is the session this checkpoint belongs to\n\tSessionID string\n\n\t// Timestamp is when this checkpoint was created\n\tTimestamp time.Time\n\n\t// Type indicates temporary (full state) or committed (metadata only)\n\tType Type\n\n\t// Message is a human-readable description of the checkpoint\n\tMessage string\n}\n\n// Type indicates the storage location and lifecycle of a checkpoint.\ntype Type int\n\nconst (\n\t// Temporary checkpoints contain full state (code + metadata) and are stored\n\t// on shadow branches (entire/<commit-hash>). Used for intra-session rewind.\n\tTemporary Type = iota\n\n\t// Committed checkpoints contain metadata + commit reference and are stored\n\t// on the entire/checkpoints/v1 branch. They are the permanent record.\n\tCommitted\n)\n\n// Store provides low-level primitives for reading and writing checkpoints.\n// This is used by strategies to implement their storage approach.\n//\n// The interface matches the GitStore implementation signatures directly:\n// - WriteTemporary takes WriteTemporaryOptions and returns a result with commit hash and skip status\n// - ReadTemporary takes baseCommit (not sessionID) since shadow branches are keyed by commit\n// - List methods return implementation-specific info types for richer data\ntype Store interface {\n\t// WriteTemporary writes a temporary checkpoint (full state) to a shadow branch.\n\t// Shadow branches are named entire/<base-commit-short-hash>.\n\t// Returns a result containing the commit hash and whether the checkpoint was skipped.\n\t// Checkpoints are skipped (deduplicated) when the tree hash matches the previous checkpoint.\n\tWriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (WriteTemporaryResult, error)\n\n\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n\t// baseCommit is the commit hash the session is based on.\n\t// worktreeID is the internal git worktree identifier (empty for main worktree).\n\t// Returns nil, nil if the shadow branch doesn't exist.\n\tReadTemporary(ctx context.Context, baseCommit, worktreeID string) (*ReadTemporaryResult, error)\n\n\t// ListTemporary lists all shadow branches with their checkpoint info.\n\tListTemporary(ctx context.Context) ([]TemporaryInfo, error)\n\n\t// WriteCommitted writes a committed checkpoint to the entire/checkpoints/v1 branch.\n\t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n\tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n\n\t// ReadCommitted reads a committed checkpoint's summary by ID.\n\t// Returns only the CheckpointSummary (paths + aggregated stats), not actual content.\n\t// Use ReadSessionContent to read actual transcript/prompts.\n\t// Returns nil, nil if the checkpoint does not exist.\n\tReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*CheckpointSummary, error)\n\n\t// ReadSessionContent reads the actual content for a specific session within a checkpoint.\n\t// sessionIndex is 0-based (0 for first session, 1 for second, etc.).\n\t// Returns the session's metadata, transcript, and prompts.\n\tReadSessionContent(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error)\n\n\t// ReadSessionContentByID reads a session's content by its session ID.\n\t// Useful when you have the session ID but don't know its index within the checkpoint.\n\tReadSessionContentByID(ctx context.Context, checkpointID id.CheckpointID, sessionID string) (*SessionContent, error)\n\n\t// ListCommitted lists all committed checkpoints.\n\tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n\n\t// UpdateCommitted replaces the transcript and prompts for an existing\n\t// committed checkpoint. Used at stop time to finalize checkpoints with the full\n\t// session transcript (prompt to stop event).\n\t// Returns ErrCheckpointNotFound if the checkpoint doesn't exist.\n\tUpdateCommitted(ctx context.Context, opts UpdateCommittedOptions) error\n}\n\n// WriteTemporaryResult contains the result of writing a temporary checkpoint.\ntype WriteTemporaryResult struct {\n\t// CommitHash is the hash of the created or existing checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// Skipped is true if the checkpoint was skipped due to no changes\n\t// (tree hash matched the previous checkpoint)\n\tSkipped bool\n}\n\n// WriteTemporaryOptions contains options for writing a temporary checkpoint.\ntype WriteTemporaryOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n\t// Used to create worktree-specific shadow branch names\n\tWorktreeID string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// MetadataDir is the relative path to the metadata directory\n\tMetadataDir string\n\n\t// MetadataDirAbs is the absolute path to the metadata directory\n\tMetadataDirAbs string\n\n\t// CommitMessage is the commit subject line\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n\t// When true, all working directory files are captured (not just modified)\n\tIsFirstCheckpoint bool\n}\n\n// ReadTemporaryResult contains the result of reading a temporary checkpoint.\ntype ReadTemporaryResult struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// TreeHash is the hash of the tree containing the checkpoint state\n\tTreeHash plumbing.Hash\n\n\t// SessionID is the session identifier from the commit trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from the commit trailer\n\tMetadataDir string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n\n// TemporaryInfo contains summary information about a shadow branch.\ntype TemporaryInfo struct {\n\t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n\tBranchName string\n\n\t// BaseCommit is the short commit hash this branch is based on\n\tBaseCommit string\n\n\t// LatestCommit is the hash of the latest commit on the branch\n\tLatestCommit plumbing.Hash\n\n\t// SessionID is the session identifier from the latest commit\n\tSessionID string\n\n\t// Timestamp is when the latest checkpoint was created\n\tTimestamp time.Time\n}\n\n// WriteCommittedOptions contains options for writing a committed checkpoint.\ntype WriteCommittedOptions struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID id.CheckpointID\n\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// CreatedAt is when the checkpoint was originally created.\n\t// When zero, writers use the current time. Migration sets this to preserve\n\t// the original v1 checkpoint time in v2 metadata and retention decisions.\n\tCreatedAt time.Time\n\n\t// Strategy is the name of the strategy that created this checkpoint\n\tStrategy string\n\n\t// Branch is the branch name where the checkpoint was created (empty if detached HEAD)\n\tBranch string\n\n\t// Transcript is the session transcript content (full.jsonl).\n\t// Must be pre-redacted (via redact.JSONLBytes or redact.AlreadyRedacted for trusted sources).\n\tTranscript redact.RedactedBytes\n\n\t// Prompts contains user prompts from the session\n\tPrompts []string\n\n\t// FilesTouched are files modified during the session\n\tFilesTouched []string\n\n\t// CheckpointsCount is the number of checkpoints in this session\n\tCheckpointsCount int\n\n\t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n\tEphemeralBranch string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// MetadataDir is a directory containing additional metadata files to copy\n\t// If set, all files in this directory will be copied to the checkpoint path\n\t// This is useful for copying task metadata files, subagent transcripts, etc.\n\tMetadataDir string\n\n\t// Task checkpoint fields (for task/subagent checkpoints)\n\tIsTask    bool   // Whether this is a task checkpoint\n\tToolUseID string // Tool use ID for task checkpoints\n\n\t// Additional task checkpoint fields for subagent checkpoints\n\tAgentID                string // Subagent identifier\n\tCheckpointUUID         string // UUID for transcript truncation when rewinding\n\tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n\tSubagentTranscriptPath string // Path to subagent's transcript file\n\n\t// Incremental checkpoint fields\n\tIsIncremental       bool   // Whether this is an incremental checkpoint\n\tIncrementalSequence int    // Checkpoint sequence number\n\tIncrementalType     string // Tool type that triggered this checkpoint\n\tIncrementalData     []byte // Tool input payload for this checkpoint\n\n\t// Commit message fields (used for task checkpoints)\n\tCommitSubject string // Subject line for the metadata commit (overrides default)\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent types.AgentType\n\n\t// Model is the LLM model used during the session (e.g., \"claude-sonnet-4-20250514\")\n\tModel string\n\n\t// TurnID correlates checkpoints from the same agent turn.\n\tTurnID string\n\n\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n\tTranscriptIdentifierAtStart string // Last identifier when checkpoint started (UUID for Claude, message ID for Gemini)\n\tCheckpointTranscriptStart   int    // Transcript line offset at start of this checkpoint's data\n\n\t// CheckpointTranscriptStart is written to both CommittedMetadata.CheckpointTranscriptStart\n\t// and the deprecated CommittedMetadata.TranscriptLinesAtStart for backward compatibility.\n\n\t// CompactTranscriptStart is the transcript.jsonl line offset at checkpoint start.\n\t// V2 /main writes this to checkpoint_transcript_start; v1 continues to use\n\t// CheckpointTranscriptStart (full.jsonl).\n\tCompactTranscriptStart int\n\n\t// TokenUsage contains the token usage for this checkpoint\n\tTokenUsage *agent.TokenUsage\n\n\t// SessionMetrics contains hook-provided session metrics (duration, turns, context usage)\n\tSessionMetrics *SessionMetrics\n\n\t// InitialAttribution is line-level attribution calculated at commit time\n\t// comparing checkpoint tree (agent work) to committed tree (may include human edits)\n\tInitialAttribution *InitialAttribution\n\n\t// PromptAttributionsJSON is the raw PromptAttributions data, JSON-encoded.\n\t// Persisted for diagnostic purposes — shows exactly which prompt recorded\n\t// which \"user\" lines, enabling root cause analysis of attribution bugs.\n\t// Uses json.RawMessage to avoid importing session package.\n\tPromptAttributionsJSON json.RawMessage\n\n\t// CombinedAttribution is holistic attribution across all sessions.\n\t// Used during migration to preserve v1 root summary attribution.\n\t// During normal condensation this is nil (computed post-commit via UpdateCheckpointSummary).\n\tCombinedAttribution *InitialAttribution\n\n\t// Summary is an optional AI-generated summary for this checkpoint.\n\t// This field may be nil when:\n\t//   - summarization is disabled in settings\n\t//   - summary generation failed (non-blocking, logged as warning)\n\t//   - the transcript was empty or too short to summarize\n\t//   - the checkpoint predates the summarization feature\n\tSummary *Summary\n\n\t// CompactTranscript is the Entire Transcript Format (transcript.jsonl) bytes.\n\t// Written to v2 /main ref alongside metadata. May be nil if compaction\n\t// was not performed (unknown agent, compaction error, empty transcript).\n\tCompactTranscript []byte\n\n\t// Kind identifies the session purpose (e.g., \"agent_review\"). Empty for normal sessions.\n\tKind string\n\n\t// ReviewSkills is the snapshot of skills used (only meaningful when Kind is a review kind).\n\t// May be empty when a review is attached post-hoc without declared skills.\n\tReviewSkills []string\n\n\t// ReviewPrompt is the actual text of the review request (composed prompt\n\t// for spawn, first user prompt for attach). Only meaningful when Kind is\n\t// a review kind.\n\tReviewPrompt string\n\n\t// HasReview is set by the caller when this session should mark its\n\t// checkpoint as reviewed. The caller computes this (e.g. via\n\t// session.Kind.IsReview) because checkpoint can't import session\n\t// — the session package imports checkpoint, creating a cycle.\n\tHasReview bool\n}\n\n// UpdateCommittedOptions contains options for updating an existing committed checkpoint.\n// Uses replace semantics: the transcript and prompts are fully replaced,\n// not appended. At stop time we have the complete session transcript and want every\n// checkpoint to contain it identically.\ntype UpdateCommittedOptions struct {\n\t// CheckpointID identifies the checkpoint to update\n\tCheckpointID id.CheckpointID\n\n\t// SessionID identifies which session slot to update within the checkpoint\n\tSessionID string\n\n\t// Transcript is the full session transcript (replaces existing).\n\t// Must be pre-redacted (via redact.JSONLBytes or redact.AlreadyRedacted for trusted sources).\n\tTranscript redact.RedactedBytes\n\n\t// Prompts contains all user prompts (replaces existing)\n\tPrompts []string\n\n\t// Agent identifies the agent type (needed for transcript chunking)\n\tAgent types.AgentType\n\n\t// CompactTranscript is the updated Entire Transcript Format bytes.\n\t// If non-nil, replaces the existing transcript.jsonl on v2 /main.\n\tCompactTranscript []byte\n\n\t// PrecomputedBlobs, if non-nil, provides chunk blob hashes and the\n\t// content-hash blob hash computed once for this transcript. When set,\n\t// UpdateCommitted skips the per-call ChunkTranscript + zlib work and\n\t// reuses these hashes. Used by finalizeAllTurnCheckpoints to avoid\n\t// re-compressing identical content N times.\n\tPrecomputedBlobs *PrecomputedTranscriptBlobs\n}\n\n// PrecomputedTranscriptBlobs holds blob hashes for a transcript that was\n// chunked and written to the object store once, for reuse across multiple\n// UpdateCommitted calls sharing the same transcript content.\n//\n// Blob hashes are content-addressed (SHA-1 of chunk bytes), so the same\n// PrecomputedTranscriptBlobs works for both v1 (full.jsonl) and v2\n// (raw_transcript) paths — only the tree-entry filename differs.\n//\n// Callers should avoid constructing this for empty transcripts; agent.ChunkTranscript\n// would otherwise produce a single zero-length chunk and a hash for an empty\n// blob, which downstream stores would never reference.\ntype PrecomputedTranscriptBlobs struct {\n\t// ChunkHashes are the blob hashes for each transcript chunk, in order.\n\t// Always non-empty when built via PrecomputeTranscriptBlobs (a non-empty\n\t// transcript chunks to at least one entry; callers should skip precompute\n\t// for empty transcripts).\n\tChunkHashes []plumbing.Hash\n\n\t// ContentHashBlob is the blob hash of the \"sha256:<hex>\" content-hash\n\t// string for the transcript.\n\tContentHashBlob plumbing.Hash\n\n\t// ContentHash is the \"sha256:<hex>\" string itself, so the short-circuit\n\t// path can compare without re-reading the blob.\n\tContentHash string\n}\n\n// isUsable reports whether the precomputed blobs satisfy the invariants that\n// consumers depend on: a non-zero content-hash blob and at least one chunk\n// hash. Callers should fall back to the fresh-write path when this is false.\nfunc (p *PrecomputedTranscriptBlobs) isUsable() bool {\n\treturn p != nil && !p.ContentHashBlob.IsZero() && len(p.ChunkHashes) > 0\n}\n\n// CommittedInfo contains summary information about a committed checkpoint.\ntype CommittedInfo struct {\n\t// CheckpointID is the stable 12-hex-char identifier\n\tCheckpointID id.CheckpointID\n\n\t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n\tSessionID string\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// CheckpointsCount is the total number of checkpoints across all sessions\n\tCheckpointsCount int\n\n\t// FilesTouched are files modified during all sessions\n\tFilesTouched []string\n\n\t// Agent identifies the agent that created this checkpoint\n\tAgent types.AgentType\n\n\t// IsTask indicates if this is a task checkpoint\n\tIsTask bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Multi-session support\n\tSessionCount int      // Number of sessions (1 if single session)\n\tSessionIDs   []string // All session IDs that contributed\n}\n\n// SessionContent contains the actual content for a session.\n// This is used when reading full session data (transcript, prompts, context)\n// as opposed to just the metadata/summary.\ntype SessionContent struct {\n\t// Metadata contains the session-specific metadata\n\tMetadata CommittedMetadata\n\n\t// Transcript is the session transcript content\n\tTranscript []byte\n\n\t// Prompts contains user prompts from this session\n\tPrompts string\n}\n\n// CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\ntype CommittedMetadata struct {\n\tCLIVersion       string          `json:\"cli_version,omitempty\"`\n\tCheckpointID     id.CheckpointID `json:\"checkpoint_id\"`\n\tSessionID        string          `json:\"session_id\"`\n\tStrategy         string          `json:\"strategy\"`\n\tCreatedAt        time.Time       `json:\"created_at\"`\n\tBranch           string          `json:\"branch,omitempty\"` // Branch where checkpoint was created (empty if detached HEAD)\n\tCheckpointsCount int             `json:\"checkpoints_count\"`\n\tFilesTouched     []string        `json:\"files_touched\"`\n\n\t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n\tAgent types.AgentType `json:\"agent,omitempty\"`\n\n\t// Model is the LLM model used during the session (e.g., \"claude-sonnet-4-20250514\").\n\t// Always written to metadata (empty string when unknown) so consumers can rely on the field's presence.\n\tModel string `json:\"model\"`\n\n\t// TurnID correlates checkpoints from the same agent turn.\n\t// When a turn's work spans multiple commits, each gets its own checkpoint\n\t// but they share the same TurnID for future aggregation/deduplication.\n\tTurnID string `json:\"turn_id,omitempty\"`\n\n\t// Task checkpoint fields (only populated for task checkpoints)\n\tIsTask    bool   `json:\"is_task,omitempty\"`\n\tToolUseID string `json:\"tool_use_id,omitempty\"`\n\n\t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n\tTranscriptIdentifierAtStart string `json:\"transcript_identifier_at_start,omitempty\"` // Last identifier when checkpoint started (UUID for Claude, message ID for Gemini)\n\tCheckpointTranscriptStart   int    `json:\"checkpoint_transcript_start,omitempty\"`    // Transcript line offset at start of this checkpoint's data\n\n\t// Deprecated: Use CheckpointTranscriptStart instead. Written for backward compatibility with older CLI versions.\n\tTranscriptLinesAtStart int `json:\"transcript_lines_at_start,omitempty\"`\n\n\t// Token usage for this checkpoint\n\tTokenUsage *agent.TokenUsage `json:\"token_usage,omitempty\"`\n\n\t// SessionMetrics contains hook-provided session metrics (duration, turns, context usage).\n\t// Populated for agents that provide these metrics via hooks (e.g., Cursor).\n\tSessionMetrics *SessionMetrics `json:\"session_metrics,omitempty\"`\n\n\t// AI-generated summary of the checkpoint\n\tSummary *Summary `json:\"summary,omitempty\"`\n\n\t// InitialAttribution is line-level attribution calculated at commit time\n\tInitialAttribution *InitialAttribution `json:\"initial_attribution,omitempty\"`\n\n\t// PromptAttributions is the raw per-prompt attribution data used to compute InitialAttribution.\n\t// Diagnostic field — shows which prompt recorded which \"user\" lines.\n\tPromptAttributions json.RawMessage `json:\"prompt_attributions,omitempty\"`\n\n\t// Kind identifies the session purpose (e.g., \"agent_review\"). Empty for normal sessions.\n\tKind string `json:\"kind,omitempty\"`\n\n\t// ReviewSkills lists the review skills that were run (only set when Kind is a review kind).\n\t// May be empty when a review was attached post-hoc without declared skills.\n\tReviewSkills []string `json:\"review_skills,omitempty\"`\n\n\t// ReviewPrompt is the actual text of the review request (composed prompt\n\t// for spawn, first user prompt for attach). Only set when Kind is a\n\t// review kind.\n\tReviewPrompt string `json:\"review_prompt,omitempty\"`\n}\n\n// GetTranscriptStart returns the transcript line offset at which this checkpoint's data begins.\n// Returns 0 for new checkpoints (start from beginning). For data written by older CLI versions,\n// falls back to the deprecated TranscriptLinesAtStart field.\nfunc (m CommittedMetadata) GetTranscriptStart() int {\n\tif m.CheckpointTranscriptStart > 0 {\n\t\treturn m.CheckpointTranscriptStart\n\t}\n\treturn m.TranscriptLinesAtStart\n}\n\n// SessionFilePaths contains the absolute paths to session files from the git tree root.\n// Paths include the full checkpoint path prefix (e.g., \"/a1/b2c3d4e5f6/1/metadata.json\").\n// Used in CheckpointSummary.Sessions to map session IDs to their file locations.\ntype SessionFilePaths struct {\n\tMetadata    string `json:\"metadata\"`\n\tTranscript  string `json:\"transcript,omitempty\"`\n\tContentHash string `json:\"content_hash,omitempty\"`\n\tPrompt      string `json:\"prompt\"`\n}\n\n// CheckpointSummary is the root-level metadata.json for a checkpoint.\n// It contains aggregated statistics from all sessions and a map of session IDs\n// to their file paths. Session-specific data (including initial_attribution)\n// is stored in the session's subdirectory metadata.json.\n//\n// Structure on entire/checkpoints/v1 branch:\n//\n//\t<checkpoint-id[:2]>/<checkpoint-id[2:]>/\n//\t├── metadata.json         # This CheckpointSummary\n//\t├── 1/                    # First session\n//\t│   ├── metadata.json     # Session-specific CommittedMetadata\n//\t│   ├── full.jsonl\n//\t│   ├── prompt.txt\n//\t│   └── content_hash.txt\n//\t├── 2/                    # Second session\n//\t└── 3/                    # Third session...\n//\n//nolint:revive // Named CheckpointSummary to avoid conflict with existing Summary struct\ntype CheckpointSummary struct {\n\tCLIVersion          string              `json:\"cli_version,omitempty\"`\n\tCheckpointID        id.CheckpointID     `json:\"checkpoint_id\"`\n\tStrategy            string              `json:\"strategy\"`\n\tBranch              string              `json:\"branch,omitempty\"`\n\tCheckpointsCount    int                 `json:\"checkpoints_count\"`\n\tFilesTouched        []string            `json:\"files_touched\"`\n\tSessions            []SessionFilePaths  `json:\"sessions\"`\n\tTokenUsage          *agent.TokenUsage   `json:\"token_usage,omitempty\"`\n\tCombinedAttribution *InitialAttribution `json:\"combined_attribution,omitempty\"`\n\n\t// HasReview is the umbrella \"any review happened\" flag: true when at least\n\t// one session in this checkpoint has a review-kind Kind (currently\n\t// \"agent_review\"). When new review kinds are introduced they should also\n\t// cause this flag to be set so callers can keep asking \"was this reviewed\n\t// in any way?\" without caring about the variant.\n\tHasReview bool `json:\"has_review,omitempty\"`\n}\n\n// SessionMetrics contains hook-provided session metrics from agents that report\n// them via lifecycle hooks (e.g., Cursor). These supplement transcript-derived\n// metrics for agents whose transcripts lack usage/timing data.\ntype SessionMetrics struct {\n\tDurationMs        int64 `json:\"duration_ms,omitempty\"`\n\tTurnCount         int   `json:\"turn_count,omitempty\"`\n\tContextTokens     int   `json:\"context_tokens,omitempty\"`\n\tContextWindowSize int   `json:\"context_window_size,omitempty\"`\n}\n\n// Summary contains AI-generated summary of a checkpoint.\ntype Summary struct {\n\tIntent    string           `json:\"intent\"`     // What user wanted to accomplish\n\tOutcome   string           `json:\"outcome\"`    // What was achieved\n\tLearnings LearningsSummary `json:\"learnings\"`  // Categorized learnings\n\tFriction  []string         `json:\"friction\"`   // Problems/annoyances encountered\n\tOpenItems []string         `json:\"open_items\"` // Tech debt, unfinished work\n}\n\n// LearningsSummary contains learnings grouped by scope.\ntype LearningsSummary struct {\n\tRepo     []string       `json:\"repo\"`     // Codebase-specific patterns/conventions\n\tCode     []CodeLearning `json:\"code\"`     // File/module specific findings\n\tWorkflow []string       `json:\"workflow\"` // General dev practices\n}\n\n// CodeLearning captures a learning tied to a specific code location.\ntype CodeLearning struct {\n\tPath    string `json:\"path\"`               // File path\n\tLine    int    `json:\"line,omitempty\"`     // Start line number\n\tEndLine int    `json:\"end_line,omitempty\"` // End line for ranges (optional)\n\tFinding string `json:\"finding\"`            // What was learned\n}\n\n// InitialAttribution captures line-level attribution metrics at commit time.\n// This is a point-in-time snapshot comparing the checkpoint tree (agent work)\n// against the committed tree (may include human edits).\n//\n// Attribution Metrics:\n//   - TotalCommitted keeps the historical \"net additions\" view for compatibility\n//   - TotalLinesChanged measures total committed line changes (adds + modifies + removes)\n//   - AgentPercentage represents \"of the lines changed in this commit, what percentage came from the agent\"\n//   - AgentRemoved tracks committed deletions performed by the agent\ntype InitialAttribution struct {\n\tCalculatedAt      time.Time `json:\"calculated_at\"`\n\tAgentLines        int       `json:\"agent_lines\"`              // Lines added by agent that remain in the commit\n\tAgentRemoved      int       `json:\"agent_removed\"`            // Lines removed by agent that remain removed in the commit\n\tHumanAdded        int       `json:\"human_added\"`              // Lines added by human (excluding modifications)\n\tHumanModified     int       `json:\"human_modified\"`           // Lines modified by human (estimate: min(added, removed))\n\tHumanRemoved      int       `json:\"human_removed\"`            // Lines removed by human (excluding modifications)\n\tTotalCommitted    int       `json:\"total_committed\"`          // Net additions in commit (legacy additions-focused metric)\n\tTotalLinesChanged int       `json:\"total_lines_changed\"`      // Total committed line changes (adds + modifies + removes)\n\tAgentPercentage   float64   `json:\"agent_percentage\"`         // (agent_lines + agent_removed) / total_lines_changed * 100\n\tMetricVersion     int       `json:\"metric_version,omitempty\"` // 0/absent = legacy (additions-only %), 2 = changed-lines %\n}\n\n// Info provides summary information for listing checkpoints.\n// This is the generic checkpoint info type.\ntype Info struct {\n\t// ID is the checkpoint identifier\n\tID string\n\n\t// SessionID identifies the session\n\tSessionID string\n\n\t// Type indicates temporary or committed\n\tType Type\n\n\t// CreatedAt is when the checkpoint was created\n\tCreatedAt time.Time\n\n\t// Message is a summary description\n\tMessage string\n}\n\n// WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n// Task checkpoints are created when a subagent completes and contain both\n// code changes and task-specific metadata.\ntype WriteTemporaryTaskOptions struct {\n\t// SessionID is the session identifier\n\tSessionID string\n\n\t// BaseCommit is the commit hash this session is based on\n\tBaseCommit string\n\n\t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n\t// Used to create worktree-specific shadow branch names\n\tWorktreeID string\n\n\t// ToolUseID is the unique identifier for this Task tool invocation\n\tToolUseID string\n\n\t// AgentID is the subagent identifier\n\tAgentID string\n\n\t// ModifiedFiles are files that have been modified (relative paths)\n\tModifiedFiles []string\n\n\t// NewFiles are files that have been created (relative paths)\n\tNewFiles []string\n\n\t// DeletedFiles are files that have been deleted (relative paths)\n\tDeletedFiles []string\n\n\t// TranscriptPath is the path to the main session transcript\n\tTranscriptPath string\n\n\t// SubagentTranscriptPath is the path to the subagent's transcript\n\tSubagentTranscriptPath string\n\n\t// CheckpointUUID is the UUID for transcript truncation when rewinding\n\tCheckpointUUID string\n\n\t// CommitMessage is the commit message (already formatted)\n\tCommitMessage string\n\n\t// AuthorName is the name to use for commits\n\tAuthorName string\n\n\t// AuthorEmail is the email to use for commits\n\tAuthorEmail string\n\n\t// IsIncremental indicates this is an incremental checkpoint\n\tIsIncremental bool\n\n\t// IncrementalSequence is the checkpoint sequence number\n\tIncrementalSequence int\n\n\t// IncrementalType is the tool that triggered this checkpoint\n\tIncrementalType string\n\n\t// IncrementalData is the tool_input payload for this checkpoint\n\tIncrementalData []byte\n}\n\n// TemporaryCheckpointInfo contains information about a single commit on a shadow branch.\n// Used by ListTemporaryCheckpoints to provide rewind point data.\ntype TemporaryCheckpointInfo struct {\n\t// CommitHash is the hash of the checkpoint commit\n\tCommitHash plumbing.Hash\n\n\t// Message is the first line of the commit message\n\tMessage string\n\n\t// SessionID is the session identifier from the Entire-Session trailer\n\tSessionID string\n\n\t// MetadataDir is the metadata directory path from trailers\n\tMetadataDir string\n\n\t// IsTaskCheckpoint indicates if this is a task checkpoint\n\tIsTaskCheckpoint bool\n\n\t// ToolUseID is the tool use ID for task checkpoints\n\tToolUseID string\n\n\t// Timestamp is when the checkpoint was created\n\tTimestamp time.Time\n}\n","numLines":733,"startLine":1,"totalLines":733}},"sourceToolAssistantUUID":"968db799-ee9e-4170-9d9a-4e12654dc33b","userType":"external","entrypoint":"cli","cwd":"/Users/alisha/.marvin/worktrees/cli/entire-labs-investigate","sessionId":"3fbf