}\n139\t\tremoveTmp = false\n140\t\treturn nil\n141\t}\n142\t\n143\t// Load reads the run state for runID. Returns (nil, nil) when the file does\n144\t// not exist (treat as \"no such run\").\n145\tfunc (s *StateStore) Load(ctx context.Context, runID string) (*RunState, error) {\n146\t\t_ = ctx // Reserved for future use\n147\t\n148\t\tif err := validateRunID(runID); err != nil {\n149\t\t\treturn nil, fmt.Errorf(\"invalid run ID: %w\", err)\n150\t\t}\n151\t\n152\t\tdata, err := os.ReadFile(s.runStatePath(runID))\n153\t\tif err != nil {\n154\t\t\tif os.IsNotExist(err) {\n155\t\t\t\treturn nil, nil //nolint:nilnil // nil,nil indicates run not found\n156\t\t\t}\n157\t\t\treturn nil, fmt.Errorf(\"read run state: %w\", err)\n158\t\t}\n159\t\n160\t\tvar st RunState\n161\t\tif err := json.Unmarshal(data, &st); err != nil {\n162\t\t\treturn nil, fmt.Errorf(\"unmarshal run state: %w\", err)\n163\t\t}\n164\t\treturn &st, nil\n165\t}\n166\t\n167\t// List returns all persisted run states. Returns nil (and no error) when the\n168\t// state directory does not exist.\n169\tfunc (s *StateStore) List(ctx context.Context) ([]*RunState, error) {\n170\t\tentries, err := os.ReadDir(s.dir)\n171\t\tif err != nil {\n172\t\t\tif os.IsNotExist(err) {\n173\t\t\t\treturn nil, nil\n174\t\t\t}\n175\t\t\treturn nil, fmt.Errorf(\"read investigations state directory: %w\", err)\n176\t\t}\n177\t\n178\t\tvar states []*RunState\n179\t\tfor _, entry := range entries {\n180\t\t\tif entry.IsDir() {\n181\t\t\t\tcontinue\n182\t\t\t}\n183\t\t\tname := entry.Name()\n184\t\t\tif !strings.HasSuffix(name, \".json\") {\n185\t\t\t\tcontinue\n186\t\t\t}\n187\t\t\tif strings.HasSuffix(name, \".tmp\") {\n188\t\t\t\tcontinue\n189\t\t\t}\n190\t\t\trunID := strings.TrimSuffix(name, \".json\")\n191\t\t\tif err := validateRunID(runID); err != nil {\n192\t\t\t\t// Skip files that don't match the run-ID format — they are not\n193\t\t\t\t// ours.\n194\t\t\t\tcontinue\n195\t\t\t}\n196\t\t\tst, loadErr := s.Load(ctx, runID)\n