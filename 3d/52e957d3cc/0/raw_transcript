tions passed to the\n36\t\t// agent verbatim (e.g. `[\"/pr-review-toolkit:review-pr\",\"/test-auditor\"]`).\n37\t\t// Use EncodeSkills / DecodeSkills to round-trip the value safely.\n38\t\tEnvSkills = \"ENTIRE_REVIEW_SKILLS\"\n39\t\n40\t\t// EnvPrompt is the full prompt text sent to the agent at review start. The\n41\t\t// lifecycle hook stores this so the checkpoint records what the agent was\n42\t\t// asked to review.\n43\t\tEnvPrompt = \"ENTIRE_REVIEW_PROMPT\"\n44\t\n45\t\t// EnvStartingSHA is the git commit SHA that was HEAD when `entire review`\n46\t\t// was invoked. The lifecycle hook requires this to match the session's\n47\t\t// initial base_commit before tagging the session, so stale env from an old\n48\t\t// HEAD does not mark a later normal session as a review.\n49\t\tEnvStartingSHA = \"ENTIRE_REVIEW_STARTING_SHA\"\n50\t)\n51\t\n52\t// EncodeSkills serialises a slice of skill invocation strings to a JSON value\n53\t// suitable for storing in the ENTIRE_REVIEW_SKILLS environment variable.\n54\t// An empty or nil slice encodes to the literal string \"[]\".\n55\tfunc EncodeSkills(skills []string) (string, error) {\n56\t\tif len(skills) == 0 {\n57\t\t\treturn \"[]\", nil\n58\t\t}\n59\t\tb, err := json.Marshal(skills)\n60\t\tif err != nil {\n61\t\t\treturn \"\", fmt.Errorf(\"encode skills: %w\", err)\n62\t\t}\n63\t\treturn string(b), nil\n64\t}\n65\t\n66\t// DecodeSkills deserialises a value previously produced by EncodeSkills.\n67\t// An empty string decodes to a nil slice (no skills configured).\n68\t// Any other value that is not valid JSON returns an error.\n69\tfunc DecodeSkills(encoded string) ([]string, error) {\n70\t\tif encoded == \"\" {\n71\t\t\treturn nil, nil\n72\t\t}\n73\t\tvar skills []string\n74\t\tif err := json.Unmarshal([]byte(encoded), &skills); err != nil {\n75\t\t\treturn nil, fmt.Errorf(\"decode skills: %w\", err)\n76\t\t}\n77\t\treturn skills, nil\n78\t}\n79\t\n80\t// AppendReviewEnv adds the ENTIRE_REVIEW_* env vars to base, returning\n