\n44\t\tCompletedRounds int          `json:\"completed_rounds\"`\n45\t\tTurn            int          `json:\"turn\"`           // overall turn index across rounds\n46\t\tNextAgentIdx    int          `json:\"next_agent_idx\"` // index into Agents for the NEXT turn\n47\t\tStances         []TurnStance `json:\"stances,omitempty\"`\n48\t\tFindingsDoc     string       `json:\"findings_doc\"` // absolute path\n49\t\tTimelineDoc     string       `json:\"timeline_doc\"` // absolute path\n50\t\tStartingSHA     string       `json:\"starting_sha\"`\n51\t\tStartedAt       time.Time    `json:\"started_at\"`\n52\t\tUpdatedAt       time.Time    `json:\"updated_at\"`\n53\t}\n54\t\n55\t// TurnStance is one agent's recorded stance for a turn.\n56\t//\n57\t// Round here is the 1-indexed round the turn belongs to (turn 1 of round\n58\t// 1, turn N+1 starts round 2, etc.) — distinct from\n59\t// RunState.CompletedRounds, which counts finished rounds.\n60\ttype TurnStance struct {\n61\t\tRound           int    `json:\"round\"`\n62\t\tTurn            int    `json:\"turn\"` // overall turn number\n63\t\tAgent           string `json:\"agent\"`\n64\t\tStance          string `json:\"stance\"` // \"approve\" | \"request-changes\" | \"abstain\" | \"unknown\"\n65\t\tPlanChanged     bool   `json:\"plan_changed\"`\n66\t\tTimelineChanged bool   `json:\"timeline_changed\"`\n67\t\tNote            string `json:\"note,omitempty\"`\n68\t}\n69\t\n70\t// StateStore is the runs-state directory wrapper.\n71\ttype StateStore struct {\n72\t\tdir string\n73\t}\n74\t\n75\t// NewStateStore creates a StateStore rooted at\n76\t// <git-common-dir>/entire-investigations/state. Resolves the common dir via\n77\t// session.GetGitCommonDir, so this requires a git repository context.\n78\tfunc NewStateStore(ctx context.Context) (*StateStore, error) {\n79\t\tcommonDir, err := session.GetGitCommonDir(ctx)\n80\t\tif err != nil {\n81\t\t\treturn nil, fmt.Errorf(\"get git common dir: %w\", err)\n82\t\t}\n83\t\treturn &StateSto