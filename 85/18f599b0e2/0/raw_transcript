{"parentUuid":"d362493a-37f5-4b6e-8f74-59a92bdc1bbd","isSidechain":false,"promptId":"adab621f-8365-4b99-847d-20d9fa3c297c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SrXG32NV7cX9LvD1Zso6n4","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"log/slog\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/charmbracelet/huh\"\n19\t\n20\t\tgit \"github.com/go-git/go-git/v6\"\n21\t\n22\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n23\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n24\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n25\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/remote\"\n26\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n27\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n28\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n29\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n30\t\t\"github.com/entireio/cli/cmd/entire/cli/trailers\"\n31\t\t\"github.com/spf13/cobra\"\n32\t)\n33\t\n34\tconst pendingReviewMarkerFilename = \"review-pending.json\"\n35\t\n36\t// PendingReviewMarker is written by `entire review` before spawning the agent.\n37\t// The next agent session's UserPromptSubmit hook reads it, tags the session\n38\t// kind/review-skills, then clears the marker (so a second review run doesn't\n39\t// inherit state from the first).\n40\t//\n41\t// WorktreePath scopes the marker to the worktree `entire review` was invoked\n42\t// from: multiple worktrees in one repo share .git/entire-sessions/, so without\n43\t// this field any session in any worktree could race to claim the marker. A\n44\t// blank WorktreePath (pre-fix markers) falls back to the legacy unscoped\n45\t// behavior — any session can adopt.\n46\ttype PendingReviewMarker struct {\n47\t\tAgentName    string    `json:\"agent_name\"`\n48\t\tSkills       []string  `json:\"skills\"`\n49\t\tStartingSHA  string    `json:\"starting_sha\"`\n50\t\tStartedAt    time.Time `json:\"started_at\"`\n51\t\tWorktreePath string    `json:\"worktree_path,omitempty\"`\n52\t}\n53\t\n54\tfunc pendingMarkerPath(ctx context.Context) (string, error) {\n55\t\tcommonDir, err := session.GetGitCommonDir(ctx)\n56\t\tif err != nil {\n57\t\t\treturn \"\", fmt.Errorf(\"locate git common dir: %w\", err)\n58\t\t}\n59\t\treturn filepath.Join(commonDir, session.SessionStateDirName, pendingReviewMarkerFilename), nil\n60\t}\n61\t\n62\t// WritePendingReviewMarker persists the marker. Overwrites any existing marker.\n63\tfunc WritePendingReviewMarker(ctx context.Context, m PendingReviewMarker) error {\n64\t\tpath, err := pendingMarkerPath(ctx)\n65\t\tif err != nil {\n66\t\t\treturn err\n67\t\t}\n68\t\tif err := os.MkdirAll(filepath.Dir(path), 0o750); err != nil {\n69\t\t\treturn fmt.Errorf(\"create sessions dir: %w\", err)\n70\t\t}\n71\t\tdata, err := json.MarshalIndent(m, \"\", \"  \")\n72\t\tif err != nil {\n73\t\t\treturn fmt.Errorf(\"marshal marker: %w\", err)\n74\t\t}\n75\t\tif err := os.WriteFile(path, data, 0o600); err != nil {\n76\t\t\treturn fmt.Errorf(\"write marker: %w\", err)\n77\t\t}\n78\t\treturn nil\n79\t}\n80\t\n81\t// ReadPendingReviewMarker returns the marker if one exists.\n82\t// ok=false with err=nil indicates \"no pending review.\"\n83\tfunc ReadPendingReviewMarker(ctx context.Context) (PendingReviewMarker, bool, error) {\n84\t\tpath, err := pendingMarkerPath(ctx)\n85\t\tif err != nil {\n86\t\t\treturn PendingReviewMarker{}, false, err\n87\t\t}\n88\t\tdata, err := os.ReadFile(path) //nolint:gosec // path derived from git dir\n89\t\tif errors.Is(err, os.ErrNotExist) {\n90\t\t\treturn PendingReviewMarker{}, false, nil\n91\t\t}\n92\t\tif err != nil {\n93\t\t\treturn PendingReviewMarker{}, false, fmt.Errorf(\"read marker: %w\", err)\n94\t\t}\n95\t\tvar m PendingReviewMarker\n96\t\tif err := json.Unmarshal(data, &m); err != nil {\n97\t\t\treturn PendingReviewMarker{}, false, fmt.Errorf(\"parse marker: %w\", err)\n98\t\t}\n99\t\treturn m, true, nil\n100\t}\n101\t\n102\t// ClearPendingReviewMarker removes the marker. Missing file is not an error.\n103\tfunc ClearPendingReviewMarker(ctx context.Context) error {\n104\t\tpath, err := pendingMarkerPath(ctx)\n105\t\tif err != nil {\n106\t\t\treturn err\n107\t\t}\n108\t\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n109\t\t\treturn fmt.Errorf(\"remove marker: %w\", err)\n110\t\t}\n111\t\treturn nil\n112\t}\n113\t\n114\t// curatedSkill represents a known review skill/command surfaced by the\n115\t// first-run picker. Users can add custom skills by editing\n116\t// .entire/settings.json directly.\n117\ttype curatedSkill struct {\n118\t\tName string\n119\t\tDesc string\n120\t}\n121\t\n122\t// curatedReviewSkills groups known review skills by agent name (as a string\n123\t// matching types.AgentName values). Agents not listed here still work via\n124\t// the picker — users just see an empty list and should edit settings.json\n125\t// manually to add skills.\n126\tvar curatedReviewSkills = map[string][]curatedSkill{\n127\t\t\"claude-code\": {\n128\t\t\t{Name: \"/pr-review-toolkit:review-pr\", Desc: \"Full PR review\"},\n129\t\t\t{Name: \"/pr-review-toolkit:code-reviewer\", Desc: \"Code review for standards\"},\n130\t\t\t{Name: \"/test-auditor\", Desc: \"Test coverage audit\"},\n131\t\t\t{Name: \"/verification-before-completion\", Desc: \"Verify before marking done\"},\n132\t\t\t{Name: \"/requesting-code-review\", Desc: \"Prepare code for review\"},\n133\t\t\t{Name: \"/pr-review-toolkit:silent-failure-hunter\", Desc: \"Find suppressed errors\"},\n134\t\t},\n135\t\t\"codex\": {\n136\t\t\t{Name: \"/codex:review\", Desc: \"Codex review\"},\n137\t\t\t{Name: \"/codex:adversarial-review\", Desc: \"Adversarial review — red-team\"},\n138\t\t},\n139\t}\n140\t\n141\t// sameWorktreePath compares two worktree paths after filepath.Clean. Both\n142\t// paths come from paths.WorktreeRoot, so an exact-bytes match is expected in\n143\t// the common case; Clean is defense-in-depth against trailing slashes and\n144\t// duplicate separators.\n145\tfunc sameWorktreePath(a, b string) bool {\n146\t\treturn filepath.Clean(a) == filepath.Clean(b)\n147\t}\n148\t\n149\t// adoptPendingReviewMarkerInto reads any pending review marker and applies it\n150\t// to the given session state. Returns (newState, modified, error). If the\n151\t// state already has Kind set (e.g., a subsequent turn of a review session),\n152\t// the marker is left in place and modified=false — adoption only happens on\n153\t// first tag. The marker is cleared on successful first adoption.\n154\t//\n155\t// Worktree scoping: when the marker carries a WorktreePath, only a session\n156\t// whose own WorktreePath matches will adopt it. This prevents a Claude\n157\t// session in worktree A from racing to claim a marker that was meant for a\n158\t// session `entire review` just launched in worktree B (both worktrees share\n159\t// the same .git/entire-sessions/ directory where the marker lives).\n160\t// Pre-fix markers with no WorktreePath fall back to unscoped adoption.\n161\tfunc adoptPendingReviewMarkerInto(ctx context.Context, s session.State) (session.State, bool, error) {\n162\t\t// Already tagged — don't re-apply on subsequent turns.\n163\t\tif s.Kind != \"\" {\n164\t\t\treturn s, false, nil\n165\t\t}\n166\t\tm, ok, err := ReadPendingReviewMarker(ctx)\n167\t\tif err != nil {\n168\t\t\treturn s, false, err\n169\t\t}\n170\t\tif !ok {\n171\t\t\treturn s, false, nil\n172\t\t}\n173\t\tif m.WorktreePath != \"\" && !sameWorktreePath(m.WorktreePath, s.WorktreePath) {\n174\t\t\t// Marker belongs to a different worktree — leave it for the session\n175\t\t\t// `entire review` actually spawned, which will reach its own hook\n176\t\t\t// and claim the marker.\n177\t\t\treturn s, false, nil\n178\t\t}\n179\t\ts.Kind = session.KindAgentReview\n180\t\ts.ReviewSkills = m.Skills\n181\t\tif err := ClearPendingReviewMarker(ctx); err != nil {\n182\t\t\t// Tagging succeeded; leftover marker self-heals on next session start\n183\t\t\t// (since Kind is now set, the next turn will return modified=false\n184\t\t\t// and the marker will be re-cleared on any next review session).\n185\t\t\tlogging.Warn(ctx, \"failed to clear pending review marker\", slog.String(\"error\", err.Error()))\n186\t\t}\n187\t\treturn s, true, nil\n188\t}\n189\t\n190\t// runReviewConfigPicker presents a huh multi-select for each installed agent\n191\t// that has curated review skills, and saves the selection to\n192\t// .entire/settings.json. Previously-saved skills are pre-checked via\n193\t// huh.Option.Selected(true), mirroring how `entire enable` preserves prior\n194\t// selections in its own agent picker.\n195\tfunc runReviewConfigPicker(ctx context.Context, out io.Writer) (map[string][]string, error) {\n196\t\tinstalled := GetAgentsWithHooksInstalled(ctx)\n197\t\tif len(installed) == 0 {\n198\t\t\treturn nil, errors.New(\"no agents installed; run 'entire enable' first\")\n199\t\t}\n200\t\n201\t\t// Narrow to agents that have a curated skills list; others need manual\n202\t\t// editing of settings.json under review.<agent-name>.\n203\t\ttype configurableAgent struct {\n204\t\t\tname types.AgentName\n205\t\t\tag   agent.Agent\n206\t\t}\n207\t\tvar configurable []configurableAgent\n208\t\tfor _, name := range installed {\n209\t\t\tcurated, ok := curatedReviewSkills[string(name)]\n210\t\t\tif !ok || len(curated) == 0 {\n211\t\t\t\tcontinue\n212\t\t\t}\n213\t\t\tag, err := agent.Get(name)\n214\t\t\tif err != nil {\n215\t\t\t\tcontinue\n216\t\t\t}\n217\t\t\tconfigurable = append(configurable, configurableAgent{name: name, ag: ag})\n218\t\t}\n219\t\tif len(configurable) == 0 {\n220\t\t\treturn nil, errors.New(\n221\t\t\t\t\"no installed agents have curated review skills; \" +\n222\t\t\t\t\t\"edit .entire/settings.json directly under review.<agent-name>\",\n223\t\t\t)\n224\t\t}\n225\t\n226\t\t// Load existing config so we can pre-check saved skills. A load error\n227\t\t// here means the settings file is malformed; log at Warn so users\n228\t\t// debugging \"my saved skills aren't pre-checked\" can see why, but keep\n229\t\t// going with an empty prefill — runReview already surfaces the same\n230\t\t// error distinctly when it's the first load.\n231\t\texisting := map[string][]string{}\n232\t\tif s, err := settings.Load(ctx); err != nil {\n233\t\t\tlogging.Warn(ctx, \"settings.Load failed when pre-filling picker\", slog.String(\"error\", err.Error()))\n234\t\t} else if s != nil {\n235\t\t\texisting = s.Review\n236\t\t}\n237\t\n238\t\t// Up-front header: make the order and count obvious so users can spot\n239\t\t// when an agent they expected isn't being offered (e.g., hooks not\n240\t\t// installed for it yet).\n241\t\tlabels := make([]string, 0, len(configurable))\n242\t\tfor _, c := range configurable {\n243\t\t\tlabels = append(labels, string(c.ag.Type()))\n244\t\t}\n245\t\tfmt.Fprintf(out, \"Configuring review skills for %d agent(s): %s\\n\", len(configurable), strings.Join(labels, \", \"))\n246\t\tfmt.Fprintln(out, \"(Previously-saved skills are pre-checked. Space to toggle, enter to confirm.)\")\n247\t\tfmt.Fprintln(out)\n248\t\n249\t\tselected := map[string][]string{}\n250\t\tfor i, c := range configurable {\n251\t\t\tcurated := curatedReviewSkills[string(c.name)]\n252\t\t\tsavedSet := map[string]struct{}{}\n253\t\t\tfor _, s := range existing[string(c.name)] {\n254\t\t\t\tsavedSet[s] = struct{}{}\n255\t\t\t}\n256\t\n257\t\t\toptions := make([]huh.Option[string], 0, len(curated))\n258\t\t\tfor _, s := range curated {\n259\t\t\t\topt := huh.NewOption(fmt.Sprintf(\"%s — %s\", s.Name, s.Desc), s.Name)\n260\t\t\t\tif _, ok := savedSet[s.Name]; ok {\n261\t\t\t\t\topt = opt.Selected(true)\n262\t\t\t\t}\n263\t\t\t\toptions = append(options, opt)\n264\t\t\t}\n265\t\n266\t\t\t// huh populates picks from Option.Selected(true) — do NOT pre-seed,\n267\t\t\t// matching the convention used in detectOrSelectAgent (setup.go).\n268\t\t\tvar picks []string\n269\t\t\ttitle := fmt.Sprintf(\"[%d/%d] Review skills for %s\", i+1, len(configurable), c.ag.Type())\n270\t\t\tform := NewAccessibleForm(huh.NewGroup(\n271\t\t\t\thuh.NewMultiSelect[string]().\n272\t\t\t\t\tTitle(title).\n273\t\t\t\t\tDescription(fmt.Sprintf(\"Agent: %s\", c.ag.Type())).\n274\t\t\t\t\tOptions(options...).\n275\t\t\t\t\tValue(&picks),\n276\t\t\t))\n277\t\t\tif err := form.Run(); err != nil {\n278\t\t\t\treturn nil, fmt.Errorf(\"picker for %s: %w\", c.name, err)\n279\t\t\t}\n280\t\t\tif len(picks) > 0 {\n281\t\t\t\tselected[string(c.name)] = picks\n282\t\t\t}\n283\t\t}\n284\t\tif len(selected) == 0 {\n285\t\t\treturn nil, errors.New(\"no review skills selected\")\n286\t\t}\n287\t\tif err := saveReviewConfig(ctx, selected); err != nil {\n288\t\t\treturn nil, err\n289\t\t}\n290\t\tfmt.Fprintln(out, \"Saved review config to .entire/settings.json. Edit directly or run `entire review --edit`.\")\n291\t\treturn selected, nil\n292\t}\n293\t\n294\tfunc newReviewCmd() *cobra.Command {\n295\t\tvar edit bool\n296\t\tvar trackOnly bool\n297\t\n298\t\tcmd := &cobra.Command{\n299\t\t\tUse:   \"review\",\n300\t\t\tShort: \"Run configured review skills against the current branch\",\n301\t\t\tLong: `Run the review skills configured in .entire/settings.json against\n302\tthe current branch. On first run, an interactive picker writes the config.\n303\t\n304\tThe review session is recorded as part of the next checkpoint, so the\n305\treview metadata is permanently attached to the commit it covers.`,\n306\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n307\t\t\t\tctx := cmd.Context()\n308\t\t\t\tif edit {\n309\t\t\t\t\t_, err := runReviewConfigPicker(ctx, cmd.OutOrStdout())\n310\t\t\t\t\treturn err\n311\t\t\t\t}\n312\t\t\t\treturn runReview(ctx, cmd, trackOnly)\n313\t\t\t},\n314\t\t}\n315\t\tcmd.Flags().BoolVar(&edit, \"edit\", false, \"re-open the review config picker\")\n316\t\tcmd.Flags().BoolVar(&trackOnly, \"track-only\", false, \"write pending marker without spawning agent\")\n317\t\treturn cmd\n318\t}\n319\t\n320\tfunc runReview(ctx context.Context, cmd *cobra.Command, trackOnly bool) error {\n321\t\tout := cmd.OutOrStdout()\n322\t\n323\t\t// 1. Pre-flight: must be in a git repo.\n324\t\tif _, err := paths.WorktreeRoot(ctx); err != nil {\n325\t\t\tcmd.SilenceUsage = true\n326\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Run `entire enable` first.\")\n327\t\t\treturn NewSilentError(errors.New(\"not a git repository\"))\n328\t\t}\n329\t\n330\t\t// 2. Load config. A load error means the settings file exists but is\n331\t\t// malformed (Load returns a default-filled object when the file is\n332\t\t// missing). Surface the error instead of silently opening the picker,\n333\t\t// which would cause saveReviewConfig to write over the user's other\n334\t\t// settings with an empty EntireSettings{}.\n335\t\ts, err := settings.Load(ctx)\n336\t\tif err != nil {\n337\t\t\tcmd.SilenceUsage = true\n338\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Failed to load settings: %v\\n\", err)\n339\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Fix `.entire/settings.json` and re-run `entire review`.\")\n340\t\t\treturn NewSilentError(err)\n341\t\t}\n342\t\tif s == nil || len(s.Review) == 0 {\n343\t\t\tpicked, pickErr := runReviewConfigPicker(ctx, out)\n344\t\t\tif pickErr != nil {\n345\t\t\t\treturn pickErr\n346\t\t\t}\n347\t\t\tif s == nil {\n348\t\t\t\ts = &settings.EntireSettings{}\n349\t\t\t}\n350\t\t\ts.Review = picked\n351\t\t}\n352\t\n353\t\t// 3. Pick agent.\n354\t\tagentName, skills, err := selectReviewAgent(s.Review)\n355\t\tif err != nil {\n356\t\t\treturn err\n357\t\t}\n358\t\n359\t\t// 4. Re-run guard: check if HEAD's checkpoint already has a review.\n360\t\tif reviewed, meta := headHasReviewCheckpoint(ctx); reviewed {\n361\t\t\tvar proceed bool\n362\t\t\tform := NewAccessibleForm(huh.NewGroup(\n363\t\t\t\thuh.NewConfirm().\n364\t\t\t\t\tTitle(fmt.Sprintf(\"Already reviewed: %s. Proceed anyway?\", meta)).\n365\t\t\t\t\tValue(&proceed),\n366\t\t\t))\n367\t\t\tif err := form.Run(); err != nil {\n368\t\t\t\tfmt.Fprintln(out, \"prompt cancelled\")\n369\t\t\t\treturn err //nolint:wrapcheck // propagate huh cancellation\n370\t\t\t}\n371\t\t\tif !proceed {\n372\t\t\t\tfmt.Fprintln(out, \"Review cancelled.\")\n373\t\t\t\treturn nil\n374\t\t\t}\n375\t\t}\n376\t\n377\t\t// 5. Resolve HEAD + worktree root for the pending marker. WorktreePath\n378\t\t// scopes the marker so that a session in *another* worktree sharing the\n379\t\t// same .git/ can't race to claim it.\n380\t\theadSHA, err := currentHeadSHA(ctx)\n381\t\tif err != nil {\n382\t\t\treturn fmt.Errorf(\"resolve HEAD: %w\", err)\n383\t\t}\n384\t\tworktreeRoot, err := paths.WorktreeRoot(ctx)\n385\t\tif err != nil {\n386\t\t\treturn fmt.Errorf(\"resolve worktree root: %w\", err)\n387\t\t}\n388\t\n389\t\t// 6. Write pending marker (agent hook will adopt it).\n390\t\tif err := WritePendingReviewMarker(ctx, PendingReviewMarker{\n391\t\t\tAgentName:    agentName,\n392\t\t\tSkills:       skills,\n393\t\t\tStartingSHA:  headSHA,\n394\t\t\tStartedAt:    time.Now().UTC(),\n395\t\t\tWorktreePath: worktreeRoot,\n396\t\t}); err != nil {\n397\t\t\treturn fmt.Errorf(\"write pending marker: %w\", err)\n398\t\t}\n399\t\n400\t\tif trackOnly {\n401\t\t\t// Marker must persist — the user will start the agent manually and\n402\t\t\t// its hook will adopt the marker.\n403\t\t\tfmt.Fprintln(out, \"Pending review marker written.\")\n404\t\t\tfmt.Fprintf(out, \"Start %s and run these skills manually: %s\\n\", agentName, strings.Join(skills, \", \"))\n405\t\t\treturn nil\n406\t\t}\n407\t\n408\t\t// From this point on, the marker lives on disk until either (a) the\n409\t\t// spawned agent's hook adopts and clears it, or (b) we clear it here\n410\t\t// as a fallback. The defer covers every spawn/launch/run failure path,\n411\t\t// and also the case where the agent exits cleanly without ever firing\n412\t\t// UserPromptSubmit (e.g. user `/quit`s immediately). Leaving the marker\n413\t\t// in those cases would mis-tag the next unrelated session as a review.\n414\t\tdefer func() {\n415\t\t\t_, exists, readErr := ReadPendingReviewMarker(ctx)\n416\t\t\tif readErr != nil || !exists {\n417\t\t\t\treturn\n418\t\t\t}\n419\t\t\tif clearErr := ClearPendingReviewMarker(ctx); clearErr != nil {\n420\t\t\t\tlogging.Debug(ctx, \"cleanup unadopted review marker\", slog.String(\"error\", clearErr.Error()))\n421\t\t\t}\n422\t\t}()\n423\t\n424\t\t// 7. Spawn agent with the composed initial prompt.\n425\t\tlauncher, ok := agent.LauncherFor(types.AgentName(agentName))\n426\t\tif !ok {\n427\t\t\tfmt.Fprintf(out, \"%s does not support subprocess launch yet. Falling back to --track-only.\\n\", agentName)\n428\t\t\tfmt.Fprintf(out, \"Start %s manually and run: %s\\n\", agentName, strings.Join(skills, \", \"))\n429\t\t\treturn nil\n430\t\t}\n431\t\t// Best-effort: show the user what's in scope so they can tell whether\n432\t\t// the review target is what they expected. Failures are silent — scope\n433\t\t// is informational, not load-bearing.\n434\t\tif scope, scopeErr := detectReviewScope(ctx); scopeErr == nil {\n435\t\t\tfmt.Fprintln(out, formatReviewScope(scope))\n436\t\t}\n437\t\tprompt := composeReviewPrompt(skills)\n438\t\texecCmd, err := launcher.LaunchCmd(ctx, prompt)\n439\t\tif err != nil {\n440\t\t\treturn fmt.Errorf(\"launch %s: %w\", agentName, err)\n441\t\t}\n442\t\tif err := execCmd.Run(); err != nil {\n443\t\t\treturn fmt.Errorf(\"agent exited: %w\", err)\n444\t\t}\n445\t\treturn nil\n446\t}\n447\t\n448\t// selectReviewAgent picks an agent from the configured review map. v1: single\n449\t// agent. If multiple are configured, returns the one that sorts first by name\n450\t// (deterministic default). Returns an error if the map is empty.\n451\tfunc selectReviewAgent(review map[string][]string) (string, []string, error) {\n452\t\tif len(review) == 0 {\n453\t\t\treturn \"\", nil, errors.New(\"no review skills configured\")\n454\t\t}\n455\t\t// Deterministic pick: alphabetical by agent name.\n456\t\tvar names []string\n457\t\tfor name, skills := range review {\n458\t\t\tif len(skills) > 0 {\n459\t\t\t\tnames = append(names, name)\n460\t\t\t}\n461\t\t}\n462\t\tif len(names) == 0 {\n463\t\t\treturn \"\", nil, errors.New(\"no review skills configured\")\n464\t\t}\n465\t\tsort.Strings(names)\n466\t\tpick := names[0]\n467\t\treturn pick, review[pick], nil\n468\t}\n469\t\n470\t// composeReviewPrompt builds the initial prompt the agent receives.\n471\tfunc composeReviewPrompt(skills []string) string {\n472\t\tvar sb strings.Builder\n473\t\tsb.WriteString(\"Please run these review skills in order:\\n\")\n474\t\tfor i, skill := range skills {\n475\t\t\tfmt.Fprintf(&sb, \"  %d. %s\\n\", i+1, skill)\n476\t\t}\n477\t\treturn sb.String()\n478\t}\n479\t\n480\t// currentHeadSHA returns the current HEAD commit hash as a 40-char hex string.\n481\tfunc currentHeadSHA(ctx context.Context) (string, error) {\n482\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n483\t\tif err != nil {\n484\t\t\treturn \"\", fmt.Errorf(\"locate repo root: %w\", err)\n485\t\t}\n486\t\texecCmd := exec.CommandContext(ctx, \"git\", \"-C\", repoRoot, \"rev-parse\", \"HEAD\")\n487\t\toutput, err := execCmd.Output()\n488\t\tif err != nil {\n489\t\t\treturn \"\", fmt.Errorf(\"git rev-parse HEAD: %w\", err)\n490\t\t}\n491\t\treturn strings.TrimSpace(string(output)), nil\n492\t}\n493\t\n494\t// reviewScope summarizes what's about to be reviewed, surfaced to the user\n495\t// before the agent launches. Zero-valued fields mean \"not detected\" — format\n496\t// helpers degrade gracefully.\n497\ttype reviewScope struct {\n498\t\tBranch       string // current branch short name; \"\" if detached\n499\t\tHeadSHA      string // short HEAD SHA (always set when non-empty scope)\n500\t\tBase         string // base branch (e.g. \"main\"); \"\" if unknown\n501\t\tAheadCommits int    // commits in base..HEAD; 0 if Base == \"\"\n502\t\tFilesChanged int    // files in base..HEAD diff; 0 if Base == \"\"\n503\t\tUncommitted  int    // files from `git status --porcelain`\n504\t}\n505\t\n506\t// detectReviewScope runs a handful of cheap `git` queries to describe the\n507\t// set of changes the user is about to review. Best-effort: any individual\n508\t// query that fails leaves the corresponding field at its zero value.\n509\tfunc detectReviewScope(ctx context.Context) (reviewScope, error) {\n510\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n511\t\tif err != nil {\n512\t\t\treturn reviewScope{}, fmt.Errorf(\"locate repo root: %w\", err)\n513\t\t}\n514\t\tvar s reviewScope\n515\t\ts.Branch = gitString(ctx, repoRoot, \"rev-parse\", \"--abbrev-ref\", \"HEAD\")\n516\t\tif s.Branch == detachedHEADDisplay {\n517\t\t\ts.Branch = \"\"\n518\t\t}\n519\t\ts.HeadSHA = gitString(ctx, repoRoot, \"rev-parse\", \"--short\", \"HEAD\")\n520\t\ts.Base = detectBaseBranch(ctx, repoRoot)\n521\t\tif s.Base != \"\" && s.Branch != \"\" && s.Base != s.Branch {\n522\t\t\tif n, ok := gitCount(ctx, repoRoot, \"rev-list\", \"--count\", s.Base+\"..\"+s.Branch); ok {\n523\t\t\t\ts.AheadCommits = n\n524\t\t\t}\n525\t\t\tif files := gitString(ctx, repoRoot, \"diff\", \"--name-only\", s.Base+\"...\"+s.Branch); files != \"\" {\n526\t\t\t\ts.FilesChanged = len(strings.Split(files, \"\\n\"))\n527\t\t\t}\n528\t\t}\n529\t\tif status := gitString(ctx, repoRoot, \"status\", \"--porcelain\"); status != \"\" {\n530\t\t\ts.Uncommitted = len(strings.Split(status, \"\\n\"))\n531\t\t}\n532\t\treturn s, nil\n533\t}\n534\t\n535\t// detectBaseBranch resolves a base branch name by trying, in order:\n536\t// origin/HEAD → origin/main → origin/master → local main → local master.\n537\t// Returns \"\" if none match. Remote-tracking branches come first because they\n538\t// reflect the team's convention; local branches are the fallback for repos\n539\t// that haven't been `git fetch`'d recently.\n540\tfunc detectBaseBranch(ctx context.Context, repoRoot string) string {\n541\t\tif target := gitString(ctx, repoRoot, \"symbolic-ref\", \"--short\", \"refs/remotes/origin/HEAD\"); target != \"\" {\n542\t\t\treturn strings.TrimPrefix(target, \"origin/\")\n543\t\t}\n544\t\tcandidates := []string{defaultBaseBranch, masterBaseBranch}\n545\t\tfor _, candidate := range candidates {\n546\t\t\tif gitOK(ctx, repoRoot, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/remotes/origin/\"+candidate) {\n547\t\t\t\treturn candidate\n548\t\t\t}\n549\t\t}\n550\t\tfor _, candidate := range candidates {\n551\t\t\tif gitOK(ctx, repoRoot, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/heads/\"+candidate) {\n552\t\t\t\treturn candidate\n553\t\t\t}\n554\t\t}\n555\t\treturn \"\"\n556\t}\n557\t\n558\t// gitString runs `git -C repoRoot <args...>` and returns trimmed stdout, or\n559\t// \"\" on any error.\n560\tfunc gitString(ctx context.Context, repoRoot string, args ...string) string {\n561\t\tfull := append([]string{\"-C\", repoRoot}, args...)\n562\t\tout, err := exec.CommandContext(ctx, \"git\", full...).Output()\n563\t\tif err != nil {\n564\t\t\treturn \"\"\n565\t\t}\n566\t\treturn strings.TrimSpace(string(out))\n567\t}\n568\t\n569\t// gitOK runs `git -C repoRoot <args...>` and reports whether it succeeded.\n570\tfunc gitOK(ctx context.Context, repoRoot string, args ...string) bool {\n571\t\tfull := append([]string{\"-C\", repoRoot}, args...)\n572\t\treturn exec.CommandContext(ctx, \"git\", full...).Run() == nil\n573\t}\n574\t\n575\t// gitCount runs a git command expected to output an integer and parses it.\n576\tfunc gitCount(ctx context.Context, repoRoot string, args ...string) (int, bool) {\n577\t\ts := gitString(ctx, repoRoot, args...)\n578\t\tif s == \"\" {\n579\t\t\treturn 0, false\n580\t\t}\n581\t\tn, err := strconv.Atoi(s)\n582\t\tif err != nil {\n583\t\t\treturn 0, false\n584\t\t}\n585\t\treturn n, true\n586\t}\n587\t\n588\t// formatReviewScope renders a one-line summary for the user. Empty-review\n589\t// cases fall back to \"no changes detected\".\n590\tfunc formatReviewScope(s reviewScope) string {\n591\t\thead := s.Branch\n592\t\tif head == \"\" {\n593\t\t\thead = detachedHEADDisplay + \" \" + s.HeadSHA\n594\t\t}\n595\t\tvar parts []string\n596\t\tif s.Base != \"\" && s.Branch != \"\" && s.Base != s.Branch && (s.AheadCommits > 0 || s.FilesChanged > 0) {\n597\t\t\tparts = append(parts,\n598\t\t\t\tfmt.Sprintf(\"%d commits\", s.AheadCommits),\n599\t\t\t\tfmt.Sprintf(\"%d files changed\", s.FilesChanged),\n600\t\t\t)\n601\t\t}\n602\t\tif s.Uncommitted > 0 {\n603\t\t\tparts = append(parts, fmt.Sprintf(\"%d uncommitted\", s.Uncommitted))\n604\t\t}\n605\t\tsuffix := \"no changes detected\"\n606\t\tif len(parts) > 0 {\n607\t\t\tsuffix = strings.Join(parts, \", \")\n608\t\t}\n609\t\tif s.Base != \"\" && s.Branch != \"\" && s.Base != s.Branch {\n610\t\t\treturn fmt.Sprintf(\"Reviewing %s vs %s: %s\", head, s.Base, suffix)\n611\t\t}\n612\t\treturn fmt.Sprintf(\"Reviewing %s: %s\", head, suffix)\n613\t}\n614\t\n615\t// headHasReviewCheckpoint checks whether HEAD's checkpoint metadata includes\n616\t// a review session. Returns (true, infoString) if HasReview is set.\n617\t// Single lookup: read the Entire-Checkpoint trailer from HEAD, then resolve\n618\t// the CheckpointSummary via ResolveCommittedReaderForCheckpoint so v2-enabled\n619\t// repos also work (v1 alone would miss v2-written summaries).\n620\t//\n621\t// Each early return logs at Debug so users debugging \"why is no review badge\n622\t// showing?\" have breadcrumbs without the caller having to ask for five\n623\t// distinct failure modes.\n624\tfunc headHasReviewCheckpoint(ctx context.Context) (bool, string) {\n625\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n626\t\tif err != nil {\n627\t\t\tlogging.Debug(ctx, \"head review check: locate worktree root\", slog.String(\"error\", err.Error()))\n628\t\t\treturn false, \"\"\n629\t\t}\n630\t\texecCmd := exec.CommandContext(ctx, \"git\", \"-C\", repoRoot, \"log\", \"-1\", \"--format=%B\")\n631\t\toutput, err := execCmd.Output()\n632\t\tif err != nil {\n633\t\t\tlogging.Debug(ctx, \"head review check: read HEAD commit message\", slog.String(\"error\", err.Error()))\n634\t\t\treturn false, \"\"\n635\t\t}\n636\t\tcpID, ok := trailers.ParseCheckpoint(string(output))\n637\t\tif !ok {\n638\t\t\tlogging.Debug(ctx, \"head review check: no Entire-Checkpoint trailer on HEAD\")\n639\t\t\treturn false, \"\"\n640\t\t}\n641\t\trepo, err := git.PlainOpen(repoRoot)\n642\t\tif err != nil {\n643\t\t\tlogging.Debug(ctx, \"head review check: open repository\", slog.String(\"error\", err.Error()))\n644\t\t\treturn false, \"\"\n645\t\t}\n646\t\tv1Store := checkpoint.NewGitStore(repo)\n647\t\tv2URL, urlErr := remote.FetchURL(ctx)\n648\t\tif urlErr != nil {\n649\t\t\tlogging.Debug(ctx, \"head review check: no configured v2 fetch remote\", slog.String(\"error\", urlErr.Error()))\n650\t\t\tv2URL = \"\"\n651\t\t}\n652\t\tv2Store := checkpoint.NewV2GitStore(repo, v2URL)\n653\t\t_, summary, err := checkpoint.ResolveCommittedReaderForCheckpoint(ctx, cpID, v1Store, v2Store, settings.IsCheckpointsV2Enabled(ctx))\n654\t\tif err != nil || summary == nil {\n655\t\t\tlogging.Debug(ctx, \"head review check: resolve checkpoint summary\",\n656\t\t\t\tslog.String(\"checkpoint_id\", cpID.String()),\n657\t\t\t\tslog.Any(\"error\", err))\n658\t\t\treturn false, \"\"\n659\t\t}\n660\t\tif !summary.HasReview {\n661\t\t\tlogging.Debug(ctx, \"head review check: summary HasReview is false\", slog.String(\"checkpoint_id\", cpID.String()))\n662\t\t\treturn false, \"\"\n663\t\t}\n664\t\treturn true, fmt.Sprintf(\"checkpoint %s\", cpID)\n665\t}\n666\t\n667\t// saveReviewConfig persists the review map into .entire/settings.json while\n668\t// preserving all other settings. A Load error means the file exists but is\n669\t// malformed — we must NOT silently overwrite it with an empty struct, or\n670\t// every unrelated setting the user had configured would be wiped. Return the\n671\t// error so the caller can surface it instead.\n672\tfunc saveReviewConfig(ctx context.Context, review map[string][]string) error {\n673\t\ts, err := settings.Load(ctx)\n674\t\tif err != nil {\n675\t\t\treturn fmt.Errorf(\"load settings before save: %w\", err)\n676\t\t}\n677\t\tif s == nil {\n678\t\t\ts = &settings.EntireSettings{}\n679\t\t}\n680\t\ts.Review = review\n681\t\tif err := settings.Save(ctx, s); err != nil {\n682\t\t\treturn fmt.Errorf(\"save settings: %w\", err)\n683\t\t}\n684\t\treturn nil\n685\t}\n686\t"}]},"uuid":"27e00fdc-543f-4d77-9a82-fbce958b35bc","timestamp":"2026-04-22T08:14:30.914Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/review.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/charmbracelet/huh\"\n\n\tgit \"github.com/go-git/go-git/v6\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/remote\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n\t\"github.com/entireio/cli/cmd/entire/cli/trailers\"\n\t\"github.com/spf13/cobra\"\n)\n\nconst pendingReviewMarkerFilename = \"review-pending.json\"\n\n// PendingReviewMarker is written by `entire review` before spawning the agent.\n// The next agent session's UserPromptSubmit hook reads it, tags the session\n// kind/review-skills, then clears the marker (so a second review run doesn't\n// inherit state from the first).\n//\n// WorktreePath scopes the marker to the worktree `entire review` was invoked\n// from: multiple worktrees in one repo share .git/entire-sessions/, so without\n// this field any session in any worktree could race to claim the marker. A\n// blank WorktreePath (pre-fix markers) falls back to the legacy unscoped\n// behavior — any session can adopt.\ntype PendingReviewMarker struct {\n\tAgentName    string    `json:\"agent_name\"`\n\tSkills       []string  `json:\"skills\"`\n\tStartingSHA  string    `json:\"starting_sha\"`\n\tStartedAt    time.Time `json:\"started_at\"`\n\tWorktreePath string    `json:\"worktree_path,omitempty\"`\n}\n\nfunc pendingMarkerPath(ctx context.Context) (string, error) {\n\tcommonDir, err := session.GetGitCommonDir(ctx)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"locate git common dir: %w\", err)\n\t}\n\treturn filepath.Join(commonDir, session.SessionStateDirName, pendingReviewMarkerFilename), nil\n}\n\n// WritePendingReviewMarker persists the marker. Overwrites any existing marker.\nfunc WritePendingReviewMarker(ctx context.Context, m PendingReviewMarker) error {\n\tpath, err := pendingMarkerPath(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := os.MkdirAll(filepath.Dir(path), 0o750); err != nil {\n\t\treturn fmt.Errorf(\"create sessions dir: %w\", err)\n\t}\n\tdata, err := json.MarshalIndent(m, \"\", \"  \")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"marshal marker: %w\", err)\n\t}\n\tif err := os.WriteFile(path, data, 0o600); err != nil {\n\t\treturn fmt.Errorf(\"write marker: %w\", err)\n\t}\n\treturn nil\n}\n\n// ReadPendingReviewMarker returns the marker if one exists.\n// ok=false with err=nil indicates \"no pending review.\"\nfunc ReadPendingReviewMarker(ctx context.Context) (PendingReviewMarker, bool, error) {\n\tpath, err := pendingMarkerPath(ctx)\n\tif err != nil {\n\t\treturn PendingReviewMarker{}, false, err\n\t}\n\tdata, err := os.ReadFile(path) //nolint:gosec // path derived from git dir\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn PendingReviewMarker{}, false, nil\n\t}\n\tif err != nil {\n\t\treturn PendingReviewMarker{}, false, fmt.Errorf(\"read marker: %w\", err)\n\t}\n\tvar m PendingReviewMarker\n\tif err := json.Unmarshal(data, &m); err != nil {\n\t\treturn PendingReviewMarker{}, false, fmt.Errorf(\"parse marker: %w\", err)\n\t}\n\treturn m, true, nil\n}\n\n// ClearPendingReviewMarker removes the marker. Missing file is not an error.\nfunc ClearPendingReviewMarker(ctx context.Context) error {\n\tpath, err := pendingMarkerPath(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"remove marker: %w\", err)\n\t}\n\treturn nil\n}\n\n// curatedSkill represents a known review skill/command surfaced by the\n// first-run picker. Users can add custom skills by editing\n// .entire/settings.json directly.\ntype curatedSkill struct {\n\tName string\n\tDesc string\n}\n\n// curatedReviewSkills groups known review skills by agent name (as a string\n// matching types.AgentName values). Agents not listed here still work via\n// the picker — users just see an empty list and should edit settings.json\n// manually to add skills.\nvar curatedReviewSkills = map[string][]curatedSkill{\n\t\"claude-code\": {\n\t\t{Name: \"/pr-review-toolkit:review-pr\", Desc: \"Full PR review\"},\n\t\t{Name: \"/pr-review-toolkit:code-reviewer\", Desc: \"Code review for standards\"},\n\t\t{Name: \"/test-auditor\", Desc: \"Test coverage audit\"},\n\t\t{Name: \"/verification-before-completion\", Desc: \"Verify before marking done\"},\n\t\t{Name: \"/requesting-code-review\", Desc: \"Prepare code for review\"},\n\t\t{Name: \"/pr-review-toolkit:silent-failure-hunter\", Desc: \"Find suppressed errors\"},\n\t},\n\t\"codex\": {\n\t\t{Name: \"/codex:review\", Desc: \"Codex review\"},\n\t\t{Name: \"/codex:adversarial-review\", Desc: \"Adversarial review — red-team\"},\n\t},\n}\n\n// sameWorktreePath compares two worktree paths after filepath.Clean. Both\n// paths come from paths.WorktreeRoot, so an exact-bytes match is expected in\n// the common case; Clean is defense-in-depth against trailing slashes and\n// duplicate separators.\nfunc sameWorktreePath(a, b string) bool {\n\treturn filepath.Clean(a) == filepath.Clean(b)\n}\n\n// adoptPendingReviewMarkerInto reads any pending review marker and applies it\n// to the given session state. Returns (newState, modified, error). If the\n// state already has Kind set (e.g., a subsequent turn of a review session),\n// the marker is left in place and modified=false — adoption only happens on\n// first tag. The marker is cleared on successful first adoption.\n//\n// Worktree scoping: when the marker carries a WorktreePath, only a session\n// whose own WorktreePath matches will adopt it. This prevents a Claude\n// session in worktree A from racing to claim a marker that was meant for a\n// session `entire review` just launched in worktree B (both worktrees share\n// the same .git/entire-sessions/ directory where the marker lives).\n// Pre-fix markers with no WorktreePath fall back to unscoped adoption.\nfunc adoptPendingReviewMarkerInto(ctx context.Context, s session.State) (session.State, bool, error) {\n\t// Already tagged — don't re-apply on subsequent turns.\n\tif s.Kind != \"\" {\n\t\treturn s, false, nil\n\t}\n\tm, ok, err := ReadPendingReviewMarker(ctx)\n\tif err != nil {\n\t\treturn s, false, err\n\t}\n\tif !ok {\n\t\treturn s, false, nil\n\t}\n\tif m.WorktreePath != \"\" && !sameWorktreePath(m.WorktreePath, s.WorktreePath) {\n\t\t// Marker belongs to a different worktree — leave it for the session\n\t\t// `entire review` actually spawned, which will reach its own hook\n\t\t// and claim the marker.\n\t\treturn s, false, nil\n\t}\n\ts.Kind = session.KindAgentReview\n\ts.ReviewSkills = m.Skills\n\tif err := ClearPendingReviewMarker(ctx); err != nil {\n\t\t// Tagging succeeded; leftover marker self-heals on next session start\n\t\t// (since Kind is now set, the next turn will return modified=false\n\t\t// and the marker will be re-cleared on any next review session).\n\t\tlogging.Warn(ctx, \"failed to clear pending review marker\", slog.String(\"error\", err.Error()))\n\t}\n\treturn s, true, nil\n}\n\n// runReviewConfigPicker presents a huh multi-select for each installed agent\n// that has curated review skills, and saves the selection to\n// .entire/settings.json. Previously-saved skills are pre-checked via\n// huh.Option.Selected(true), mirroring how `entire enable` preserves prior\n// selections in its own agent picker.\nfunc runReviewConfigPicker(ctx context.Context, out io.Writer) (map[string][]string, error) {\n\tinstalled := GetAgentsWithHooksInstalled(ctx)\n\tif len(installed) == 0 {\n\t\treturn nil, errors.New(\"no agents installed; run 'entire enable' first\")\n\t}\n\n\t// Narrow to agents that have a curated skills list; others need manual\n\t// editing of settings.json under review.<agent-name>.\n\ttype configurableAgent struct {\n\t\tname types.AgentName\n\t\tag   agent.Agent\n\t}\n\tvar configurable []configurableAgent\n\tfor _, name := range installed {\n\t\tcurated, ok := curatedReviewSkills[string(name)]\n\t\tif !ok || len(curated) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tag, err := agent.Get(name)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tconfigurable = append(configurable, configurableAgent{name: name, ag: ag})\n\t}\n\tif len(configurable) == 0 {\n\t\treturn nil, errors.New(\n\t\t\t\"no installed agents have curated review skills; \" +\n\t\t\t\t\"edit .entire/settings.json directly under review.<agent-name>\",\n\t\t)\n\t}\n\n\t// Load existing config so we can pre-check saved skills. A load error\n\t// here means the settings file is malformed; log at Warn so users\n\t// debugging \"my saved skills aren't pre-checked\" can see why, but keep\n\t// going with an empty prefill — runReview already surfaces the same\n\t// error distinctly when it's the first load.\n\texisting := map[string][]string{}\n\tif s, err := settings.Load(ctx); err != nil {\n\t\tlogging.Warn(ctx, \"settings.Load failed when pre-filling picker\", slog.String(\"error\", err.Error()))\n\t} else if s != nil {\n\t\texisting = s.Review\n\t}\n\n\t// Up-front header: make the order and count obvious so users can spot\n\t// when an agent they expected isn't being offered (e.g., hooks not\n\t// installed for it yet).\n\tlabels := make([]string, 0, len(configurable))\n\tfor _, c := range configurable {\n\t\tlabels = append(labels, string(c.ag.Type()))\n\t}\n\tfmt.Fprintf(out, \"Configuring review skills for %d agent(s): %s\\n\", len(configurable), strings.Join(labels, \", \"))\n\tfmt.Fprintln(out, \"(Previously-saved skills are pre-checked. Space to toggle, enter to confirm.)\")\n\tfmt.Fprintln(out)\n\n\tselected := map[string][]string{}\n\tfor i, c := range configurable {\n\t\tcurated := curatedReviewSkills[string(c.name)]\n\t\tsavedSet := map[string]struct{}{}\n\t\tfor _, s := range existing[string(c.name)] {\n\t\t\tsavedSet[s] = struct{}{}\n\t\t}\n\n\t\toptions := make([]huh.Option[string], 0, len(curated))\n\t\tfor _, s := range curated {\n\t\t\topt := huh.NewOption(fmt.Sprintf(\"%s — %s\", s.Name, s.Desc), s.Name)\n\t\t\tif _, ok := savedSet[s.Name]; ok {\n\t\t\t\topt = opt.Selected(true)\n\t\t\t}\n\t\t\toptions = append(options, opt)\n\t\t}\n\n\t\t// huh populates picks from Option.Selected(true) — do NOT pre-seed,\n\t\t// matching the convention used in detectOrSelectAgent (setup.go).\n\t\tvar picks []string\n\t\ttitle := fmt.Sprintf(\"[%d/%d] Review skills for %s\", i+1, len(configurable), c.ag.Type())\n\t\tform := NewAccessibleForm(huh.NewGroup(\n\t\t\thuh.NewMultiSelect[string]().\n\t\t\t\tTitle(title).\n\t\t\t\tDescription(fmt.Sprintf(\"Agent: %s\", c.ag.Type())).\n\t\t\t\tOptions(options...).\n\t\t\t\tValue(&picks),\n\t\t))\n\t\tif err := form.Run(); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"picker for %s: %w\", c.name, err)\n\t\t}\n\t\tif len(picks) > 0 {\n\t\t\tselected[string(c.name)] = picks\n\t\t}\n\t}\n\tif len(selected) == 0 {\n\t\treturn nil, errors.New(\"no review skills selected\")\n\t}\n\tif err := saveReviewConfig(ctx, selected); err != nil {\n\t\treturn nil, err\n\t}\n\tfmt.Fprintln(out, \"Saved review config to .entire/settings.json. Edit directly or run `entire review --edit`.\")\n\treturn selected, nil\n}\n\nfunc newReviewCmd() *cobra.Command {\n\tvar edit bool\n\tvar trackOnly bool\n\n\tcmd := &cobra.Command{\n\t\tUse:   \"review\",\n\t\tShort: \"Run configured review skills against the current branch\",\n\t\tLong: `Run the review skills configured in .entire/settings.json against\nthe current branch. On first run, an interactive picker writes the config.\n\nThe review session is recorded as part of the next checkpoint, so the\nreview metadata is permanently attached to the commit it covers.`,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\tctx := cmd.Context()\n\t\t\tif edit {\n\t\t\t\t_, err := runReviewConfigPicker(ctx, cmd.OutOrStdout())\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn runReview(ctx, cmd, trackOnly)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&edit, \"edit\", false, \"re-open the review config picker\")\n\tcmd.Flags().BoolVar(&trackOnly, \"track-only\", false, \"write pending marker without spawning agent\")\n\treturn cmd\n}\n\nfunc runReview(ctx context.Context, cmd *cobra.Command, trackOnly bool) error {\n\tout := cmd.OutOrStdout()\n\n\t// 1. Pre-flight: must be in a git repo.\n\tif _, err := paths.WorktreeRoot(ctx); err != nil {\n\t\tcmd.SilenceUsage = true\n\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Run `entire enable` first.\")\n\t\treturn NewSilentError(errors.New(\"not a git repository\"))\n\t}\n\n\t// 2. Load config. A load error means the settings file exists but is\n\t// malformed (Load returns a default-filled object when the file is\n\t// missing). Surface the error instead of silently opening the picker,\n\t// which would cause saveReviewConfig to write over the user's other\n\t// settings with an empty EntireSettings{}.\n\ts, err := settings.Load(ctx)\n\tif err != nil {\n\t\tcmd.SilenceUsage = true\n\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Failed to load settings: %v\\n\", err)\n\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Fix `.entire/settings.json` and re-run `entire review`.\")\n\t\treturn NewSilentError(err)\n\t}\n\tif s == nil || len(s.Review) == 0 {\n\t\tpicked, pickErr := runReviewConfigPicker(ctx, out)\n\t\tif pickErr != nil {\n\t\t\treturn pickErr\n\t\t}\n\t\tif s == nil {\n\t\t\ts = &settings.EntireSettings{}\n\t\t}\n\t\ts.Review = picked\n\t}\n\n\t// 3. Pick agent.\n\tagentName, skills, err := selectReviewAgent(s.Review)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// 4. Re-run guard: check if HEAD's checkpoint already has a review.\n\tif reviewed, meta := headHasReviewCheckpoint(ctx); reviewed {\n\t\tvar proceed bool\n\t\tform := NewAccessibleForm(huh.NewGroup(\n\t\t\thuh.NewConfirm().\n\t\t\t\tTitle(fmt.Sprintf(\"Already reviewed: %s. Proceed anyway?\", meta)).\n\t\t\t\tValue(&proceed),\n\t\t))\n\t\tif err := form.Run(); err != nil {\n\t\t\tfmt.Fprintln(out, \"prompt cancelled\")\n\t\t\treturn err //nolint:wrapcheck // propagate huh cancellation\n\t\t}\n\t\tif !proceed {\n\t\t\tfmt.Fprintln(out, \"Review cancelled.\")\n\t\t\treturn nil\n\t\t}\n\t}\n\n\t// 5. Resolve HEAD + worktree root for the pending marker. WorktreePath\n\t// scopes the marker so that a session in *another* worktree sharing the\n\t// same .git/ can't race to claim it.\n\theadSHA, err := currentHeadSHA(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"resolve HEAD: %w\", err)\n\t}\n\tworktreeRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"resolve worktree root: %w\", err)\n\t}\n\n\t// 6. Write pending marker (agent hook will adopt it).\n\tif err := WritePendingReviewMarker(ctx, PendingReviewMarker{\n\t\tAgentName:    agentName,\n\t\tSkills:       skills,\n\t\tStartingSHA:  headSHA,\n\t\tStartedAt:    time.Now().UTC(),\n\t\tWorktreePath: worktreeRoot,\n\t}); err != nil {\n\t\treturn fmt.Errorf(\"write pending marker: %w\", err)\n\t}\n\n\tif trackOnly {\n\t\t// Marker must persist — the user will start the agent manually and\n\t\t// its hook will adopt the marker.\n\t\tfmt.Fprintln(out, \"Pending review marker written.\")\n\t\tfmt.Fprintf(out, \"Start %s and run these skills manually: %s\\n\", agentName, strings.Join(skills, \", \"))\n\t\treturn nil\n\t}\n\n\t// From this point on, the marker lives on disk until either (a) the\n\t// spawned agent's hook adopts and clears it, or (b) we clear it here\n\t// as a fallback. The defer covers every spawn/launch/run failure path,\n\t// and also the case where the agent exits cleanly without ever firing\n\t// UserPromptSubmit (e.g. user `/quit`s immediately). Leaving the marker\n\t// in those cases would mis-tag the next unrelated session as a review.\n\tdefer func() {\n\t\t_, exists, readErr := ReadPendingReviewMarker(ctx)\n\t\tif readErr != nil || !exists {\n\t\t\treturn\n\t\t}\n\t\tif clearErr := ClearPendingReviewMarker(ctx); clearErr != nil {\n\t\t\tlogging.Debug(ctx, \"cleanup unadopted review marker\", slog.String(\"error\", clearErr.Error()))\n\t\t}\n\t}()\n\n\t// 7. Spawn agent with the composed initial prompt.\n\tlauncher, ok := agent.LauncherFor(types.AgentName(agentName))\n\tif !ok {\n\t\tfmt.Fprintf(out, \"%s does not support subprocess launch yet. Falling back to --track-only.\\n\", agentName)\n\t\tfmt.Fprintf(out, \"Start %s manually and run: %s\\n\", agentName, strings.Join(skills, \", \"))\n\t\treturn nil\n\t}\n\t// Best-effort: show the user what's in scope so they can tell whether\n\t// the review target is what they expected. Failures are silent — scope\n\t// is informational, not load-bearing.\n\tif scope, scopeErr := detectReviewScope(ctx); scopeErr == nil {\n\t\tfmt.Fprintln(out, formatReviewScope(scope))\n\t}\n\tprompt := composeReviewPrompt(skills)\n\texecCmd, err := launcher.LaunchCmd(ctx, prompt)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"launch %s: %w\", agentName, err)\n\t}\n\tif err := execCmd.Run(); err != nil {\n\t\treturn fmt.Errorf(\"agent exited: %w\", err)\n\t}\n\treturn nil\n}\n\n// selectReviewAgent picks an agent from the configured review map. v1: single\n// agent. If multiple are configured, returns the one that sorts first by name\n// (deterministic default). Returns an error if the map is empty.\nfunc selectReviewAgent(review map[string][]string) (string, []string, error) {\n\tif len(review) == 0 {\n\t\treturn \"\", nil, errors.New(\"no review skills configured\")\n\t}\n\t// Deterministic pick: alphabetical by agent name.\n\tvar names []string\n\tfor name, skills := range review {\n\t\tif len(skills) > 0 {\n\t\t\tnames = append(names, name)\n\t\t}\n\t}\n\tif len(names) == 0 {\n\t\treturn \"\", nil, errors.New(\"no review skills configured\")\n\t}\n\tsort.Strings(names)\n\tpick := names[0]\n\treturn pick, review[pick], nil\n}\n\n// composeReviewPrompt builds the initial prompt the agent receives.\nfunc composeReviewPrompt(skills []string) string {\n\tvar sb strings.Builder\n\tsb.WriteString(\"Please run these review skills in order:\\n\")\n\tfor i, skill := range skills {\n\t\tfmt.Fprintf(&sb, \"  %d. %s\\n\", i+1, skill)\n\t}\n\treturn sb.String()\n}\n\n// currentHeadSHA returns the current HEAD commit hash as a 40-char hex string.\nfunc currentHeadSHA(ctx context.Context) (string, error) {\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"locate repo root: %w\", err)\n\t}\n\texecCmd := exec.CommandContext(ctx, \"git\", \"-C\", repoRoot, \"rev-parse\", \"HEAD\")\n\toutput, err := execCmd.Output()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"git rev-parse HEAD: %w\", err)\n\t}\n\treturn strings.TrimSpace(string(output)), nil\n}\n\n// reviewScope summarizes what's about to be reviewed, surfaced to the user\n// before the agent launches. Zero-valued fields mean \"not detected\" — format\n// helpers degrade gracefully.\ntype reviewScope struct {\n\tBranch       string // current branch short name; \"\" if detached\n\tHeadSHA      string // short HEAD SHA (always set when non-empty scope)\n\tBase         string // base branch (e.g. \"main\"); \"\" if unknown\n\tAheadCommits int    // commits in base..HEAD; 0 if Base == \"\"\n\tFilesChanged int    // files in base..HEAD diff; 0 if Base == \"\"\n\tUncommitted  int    // files from `git status --porcelain`\n}\n\n// detectReviewScope runs a handful of cheap `git` queries to describe the\n// set of changes the user is about to review. Best-effort: any individual\n// query that fails leaves the corresponding field at its zero value.\nfunc detectReviewScope(ctx context.Context) (reviewScope, error) {\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn reviewScope{}, fmt.Errorf(\"locate repo root: %w\", err)\n\t}\n\tvar s reviewScope\n\ts.Branch = gitString(ctx, repoRoot, \"rev-parse\", \"--abbrev-ref\", \"HEAD\")\n\tif s.Branch == detachedHEADDisplay {\n\t\ts.Branch = \"\"\n\t}\n\ts.HeadSHA = gitString(ctx, repoRoot, \"rev-parse\", \"--short\", \"HEAD\")\n\ts.Base = detectBaseBranch(ctx, repoRoot)\n\tif s.Base != \"\" && s.Branch != \"\" && s.Base != s.Branch {\n\t\tif n, ok := gitCount(ctx, repoRoot, \"rev-list\", \"--count\", s.Base+\"..\"+s.Branch); ok {\n\t\t\ts.AheadCommits = n\n\t\t}\n\t\tif files := gitString(ctx, repoRoot, \"diff\", \"--name-only\", s.Base+\"...\"+s.Branch); files != \"\" {\n\t\t\ts.FilesChanged = len(strings.Split(files, \"\\n\"))\n\t\t}\n\t}\n\tif status := gitString(ctx, repoRoot, \"status\", \"--porcelain\"); status != \"\" {\n\t\ts.Uncommitted = len(strings.Split(status, \"\\n\"))\n\t}\n\treturn s, nil\n}\n\n// detectBaseBranch resolves a base branch name by trying, in order:\n// origin/HEAD → origin/main → origin/master → local main → local master.\n// Returns \"\" if none match. Remote-tracking branches come first because they\n// reflect the team's convention; local branches are the fallback for repos\n// that haven't been `git fetch`'d recently.\nfunc detectBaseBranch(ctx context.Context, repoRoot string) string {\n\tif target := gitString(ctx, repoRoot, \"symbolic-ref\", \"--short\", \"refs/remotes/origin/HEAD\"); target != \"\" {\n\t\treturn strings.TrimPrefix(target, \"origin/\")\n\t}\n\tcandidates := []string{defaultBaseBranch, masterBaseBranch}\n\tfor _, candidate := range candidates {\n\t\tif gitOK(ctx, repoRoot, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/remotes/origin/\"+candidate) {\n\t\t\treturn candidate\n\t\t}\n\t}\n\tfor _, candidate := range candidates {\n\t\tif gitOK(ctx, repoRoot, \"rev-parse\", \"--verify\", \"--quiet\", \"refs/heads/\"+candidate) {\n\t\t\treturn candidate\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// gitString runs `git -C repoRoot <args...>` and returns trimmed stdout, or\n// \"\" on any error.\nfunc gitString(ctx context.Context, repoRoot string, args ...string) string {\n\tfull := append([]string{\"-C\", repoRoot}, args...)\n\tout, err := exec.CommandContext(ctx, \"git\", full...).Output()\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\treturn strings.TrimSpace(string(out))\n}\n\n// gitOK runs `git -C repoRoot <args...>` and reports whether it succeeded.\nfunc gitOK(ctx context.Context, repoRoot string, args ...string) bool {\n\tfull := append([]string{\"-C\", repoRoot}, args...)\n\treturn exec.CommandContext(ctx, \"git\", full...).Run() == nil\n}\n\n// gitCount runs a git command expected to output an integer and parses it.\nfunc gitCount(ctx context.Context, repoRoot string, args ...string) (int, bool) {\n\ts := gitString(ctx, repoRoot, args...)\n\tif s == \"\" {\n\t\treturn 0, false\n\t}\n\tn, err := strconv.Atoi(s)\n\tif err != nil {\n\t\treturn 0, false\n\t}\n\treturn n, true\n}\n\n// formatReviewScope renders a one-line summary for the user. Empty-review\n// cases fall back to \"no changes detected\".\nfunc formatReviewScope(s reviewScope) string {\n\thead := s.Branch\n\tif head == \"\" {\n\t\thead = detachedHEADDisplay + \" \" + s.HeadSHA\n\t}\n\tvar parts []string\n\tif s.Base != \"\" && s.Branch != \"\" && s.Base != s.Branch && (s.AheadCommits > 0 || s.FilesChanged > 0) {\n\t\tparts = append(parts,\n\t\t\tfmt.Sprintf(\"%d commits\", s.AheadCommits),\n\t\t\tfmt.Sprintf(\"%d files changed\", s.FilesChanged),\n\t\t)\n\t}\n\tif s.Uncommitted > 0 {\n\t\tparts = append(parts, fmt.Sprintf(\"%d uncommitted\", s.Uncommitted))\n\t}\n\tsuffix := \"no changes detected\"\n\tif len(parts) > 0 {\n\t\tsuffix = strings.Join(parts, \", \")\n\t}\n\tif s.Base != \"\" && s.Branch != \"\" && s.Base != s.Branch {\n\t\treturn fmt.Sprintf(\"Reviewing %s vs %s: %s\", head, s.Base, suffix)\n\t}\n\treturn fmt.Sprintf(\"Reviewing %s: %s\", head, suffix)\n}\n\n// headHasReviewCheckpoint checks whether HEAD's checkpoint metadata includes\n// a review session. Returns (true, infoString) if HasReview is set.\n// Single lookup: read the Entire-Checkpoint trailer from HEAD, then resolve\n// the CheckpointSummary via ResolveCommittedReaderForCheckpoint so v2-enabled\n// repos also work (v1 alone would miss v2-written summaries).\n//\n// Each early return logs at Debug so users debugging \"why is no review badge\n// showing?\" have breadcrumbs without the caller having to ask for five\n// distinct failure modes.\nfunc headHasReviewCheckpoint(ctx context.Context) (bool, string) {\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\tlogging.Debug(ctx, \"head review check: locate worktree root\", slog.String(\"error\", err.Error()))\n\t\treturn false, \"\"\n\t}\n\texecCmd := exec.CommandContext(ctx, \"git\", \"-C\", repoRoot, \"log\", \"-1\", \"--format=%B\")\n\toutput, err := execCmd.Output()\n\tif err != nil {\n\t\tlogging.Debug(ctx, \"head review check: read HEAD commit message\", slog.String(\"error\", err.Error()))\n\t\treturn false, \"\"\n\t}\n\tcpID, ok := trailers.ParseCheckpoint(string(output))\n\tif !ok {\n\t\tlogging.Debug(ctx, \"head review check: no Entire-C