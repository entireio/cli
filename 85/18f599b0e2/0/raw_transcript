\t\t// Set up a fake Claude project dir that's empty\n54\t\tt.Setenv(\"ENTIRE_TEST_CLAUDE_PROJECT_DIR\", t.TempDir())\n55\t\t// Redirect HOME so the fallback search doesn't walk real ~/.claude/projects\n56\t\tt.Setenv(\"HOME\", t.TempDir())\n57\t\n58\t\tvar out bytes.Buffer\n59\t\terr := runAttach(context.Background(), &out, \"nonexistent-session-id\", agent.AgentNameClaudeCode, true)\n60\t\tif err == nil {\n61\t\t\tt.Fatal(\"expected error for missing transcript\")\n62\t\t}\n63\t}\n64\t\n65\tfunc TestAttach_Success(t *testing.T) {\n66\t\tsetupAttachTestRepo(t)\n67\t\n68\t\tsessionID := \"test-attach-session-001\"\n69\t\tsetupClaudeTranscript(t, sessionID, `{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"create a hello world file\"},\"uuid\":\"uuid-1\"}\n70\t{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"tu_1\",\"name\":\"Write\",\"input\":{\"file_path\":\"hello.txt\",\"content\":\"world\"}}]},\"uuid\":\"uuid-2\"}\n71\t{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"tu_1\",\"content\":\"wrote file\"}]},\"uuid\":\"uuid-3\"}\n72\t{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Done! I created hello.txt.\"}]},\"uuid\":\"uuid-4\"}\n73\t`)\n74\t\n75\t\tvar out bytes.Buffer\n76\t\terr := runAttach(context.Background(), &out, sessionID, agent.AgentNameClaudeCode, true)\n77\t\tif err != nil {\n78\t\t\tt.Fatalf(\"runAttach failed: %v\", err)\n79\t\t}\n80\t\n81\t\t// Verify session state was created\n82\t\tstore, err := session.NewStateStore(context.Background())\n83\t\tif err != nil {\n84\t\t\tt.Fatal(err)\n85\t\t}\n86\t\tstate, err := store.Load(context.Background(), sessionID)\n87\t\tif err != nil {\n88\t\t\tt.Fatal(err)\n89\t\t}\n90\t\tif state == nil {\n91\t\t\tt.Fatal(\"expected session state to be created\")\n92\t\t\treturn\n93\t\t}\n94\t\tif state.SessionID != sessionID {\n95\t\t\tt.Errorf(\"session I