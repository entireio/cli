{"parentUuid":"702402e0-ed4a-4f86-957b-ecd728ca95b4","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli/cmd/entire/cli/review_test.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/testutil\"\n15\t)\n16\t\n17\tconst (\n18\t\ttestReviewSkill = \"/pr-review-toolkit:review-pr\"\n19\t\ttestMainBranch  = \"main\"\n20\t)\n21\t\n22\tfunc TestReviewMarker_RoundTrip(t *testing.T) {\n23\t\ttmp := t.TempDir()\n24\t\ttestutil.InitRepo(t, tmp)\n25\t\ttestutil.WriteFile(t, tmp, \"f.txt\", \"x\")\n26\t\ttestutil.GitAdd(t, tmp, \"f.txt\")\n27\t\ttestutil.GitCommit(t, tmp, \"init\")\n28\t\tt.Chdir(tmp)\n29\t\n30\t\tm := PendingReviewMarker{\n31\t\t\tAgentName:   \"claude-code\",\n32\t\t\tSkills:      []string{testReviewSkill},\n33\t\t\tStartingSHA: \"deadbeef\",\n34\t\t\tStartedAt:   time.Now().UTC(),\n35\t\t}\n36\t\tctx := context.Background()\n37\t\tif err := WritePendingReviewMarker(ctx, m); err != nil {\n38\t\t\tt.Fatalf(\"write: %v\", err)\n39\t\t}\n40\t\tgot, ok, err := ReadPendingReviewMarker(ctx)\n41\t\tif err != nil {\n42\t\t\tt.Fatalf(\"read: %v\", err)\n43\t\t}\n44\t\tif !ok {\n45\t\t\tt.Fatal(\"expected marker present\")\n46\t\t}\n47\t\tif got.AgentName != m.AgentName || got.StartingSHA != m.StartingSHA {\n48\t\t\tt.Errorf(\"roundtrip mismatch: %+v\", got)\n49\t\t}\n50\t\tif err := ClearPendingReviewMarker(ctx); err != nil {\n51\t\t\tt.Fatalf(\"clear: %v\", err)\n52\t\t}\n53\t\t_, ok, err = ReadPendingReviewMarker(ctx)\n54\t\tif err != nil {\n55\t\t\tt.Fatalf(\"read-after-clear: %v\", err)\n56\t\t}\n57\t\tif ok {\n58\t\t\tt.Error(\"expected marker absent after clear\")\n59\t\t}\n60\t\n61\t\t// Ensure the file lived under .git/entire-sessions/, not the worktree.\n62\t\tgitDir := filepath.Join(tmp, \".git\")\n63\t\tentries, err := filepath.Glob(filepath.Join(gitDir, \"entire-sessions\", \"*\"))\n64\t\tif err != nil {\n65\t\t\tt.Fatalf(\"glob sessions dir: %v\", err)\n66\t\t}\n67\t\t_ = entries // sanity check only\n68\t}\n69\t\n70\tfunc TestReviewCmd_Help(t *testing.T) {\n71\t\tt.Parallel()\n72\t\trootCmd := NewRootCmd()\n73\t\tbuf := &bytes.Buffer{}\n74\t\trootCmd.SetOut(buf)\n75\t\trootCmd.SetArgs([]string{\"review\", \"--help\"})\n76\t\tif err := rootCmd.Execute(); err != nil {\n77\t\t\tt.Fatalf(\"execute: %v\", err)\n78\t\t}\n79\t\tout := buf.String()\n80\t\tif !strings.Contains(out, \"review\") {\n81\t\t\tt.Errorf(\"--help output missing 'review': %s\", out)\n82\t\t}\n83\t}\n84\t\n85\tfunc TestSaveReviewConfig_PersistsSettings(t *testing.T) {\n86\t\t// NOTE: uses t.Chdir, so no t.Parallel.\n87\t\ttmp := t.TempDir()\n88\t\ttestutil.InitRepo(t, tmp)\n89\t\tt.Chdir(tmp)\n90\t\n91\t\terr := saveReviewConfig(context.Background(), map[string][]string{\n92\t\t\t\"claude-code\": {testReviewSkill, \"/test-auditor\"},\n93\t\t})\n94\t\tif err != nil {\n95\t\t\tt.Fatal(err)\n96\t\t}\n97\t\n98\t\ts, err := settings.Load(context.Background())\n99\t\tif err != nil {\n100\t\t\tt.Fatalf(\"load settings: %v\", err)\n101\t\t}\n102\t\tif len(s.Review[\"claude-code\"]) != 2 {\n103\t\t\tt.Errorf(\"expected 2 skills saved, got %v\", s.Review)\n104\t\t}\n105\t\tif s.Review[\"claude-code\"][0] != testReviewSkill {\n106\t\t\tt.Errorf(\"first skill = %q\", s.Review[\"claude-code\"][0])\n107\t\t}\n108\t}\n109\t\n110\tfunc TestRunReview_TrackOnlyWritesMarker(t *testing.T) {\n111\t\t// t.Chdir + first-run picker — no t.Parallel.\n112\t\ttmp := t.TempDir()\n113\t\ttestutil.InitRepo(t, tmp)\n114\t\ttestutil.WriteFile(t, tmp, \"f.txt\", \"x\")\n115\t\ttestutil.GitAdd(t, tmp, \"f.txt\")\n116\t\ttestutil.GitCommit(t, tmp, \"init\")\n117\t\tt.Chdir(tmp)\n118\t\n119\t\t// Seed config so first-run picker doesn't fire.\n120\t