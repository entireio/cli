cker when\n39\t// discovery didn't surface the plugin already. Messages are free-form text;\n40\t// ProvidesAny is the suppression fingerprint.\n41\t//\n42\t// Install commands below are placeholders until marketplace URLs are pinned.\n43\t// Tests do not assert on Message text — only on ProvidesAny semantics — so\n44\t// prose revisions do not break the suite.\n45\tvar installHints = map[string][]InstallHint{\n46\t\t\"claude-code\": {\n47\t\t\t{\n48\t\t\t\tMessage: \"Install `pr-review-toolkit` via `claude plugin install entireio/pr-review-toolkit`\",\n49\t\t\t\tProvidesAny: []string{\n50\t\t\t\t\t\"/pr-review-toolkit:review-pr\",\n51\t\t\t\t\t\"/pr-review-toolkit:code-reviewer\",\n52\t\t\t\t\t\"/pr-review-toolkit:silent-failure-hunter\",\n53\t\t\t\t},\n54\t\t\t},\n55\t\t\t{\n56\t\t\t\tMessage:     \"Install `test-auditor` via the superpowers plugin\",\n57\t\t\t\tProvidesAny: []string{\"/test-auditor\"},\n58\t\t\t},\n59\t\t},\n60\t\t\"codex\": {\n61\t\t\t{\n62\t\t\t\tMessage:     \"Install `codex-review-pack` via `codex plugins add <url>`\",\n63\t\t\t\tProvidesAny: []string{\"/codex:adversarial-review\"},\n64\t\t\t},\n65\t\t},\n66\t\t\"gemini-cli\": {\n67\t\t\t{\n68\t\t\t\tMessage:     \"Install `gemini-code-review` via `gemini extensions install <url>`\",\n69\t\t\t\tProvidesAny: nil,\n70\t\t\t},\n71\t\t},\n72\t}\n73\t\n74\t// CuratedBuiltinsFor returns the curated built-in list for agentName, or\n75\t// an empty slice if the agent is unknown. Callers must treat the return\n76\t// value as read-only.\n77\tfunc CuratedBuiltinsFor(agentName string) []CuratedSkill {\n78\t\treturn curatedBuiltins[agentName]\n79\t}\n80\t\n81\t// ActiveInstallHintsFor returns the subset of installHints[agentName] whose\n82\t// ProvidesAny does NOT intersect the discovered set. When ProvidesAny is\n83\t// nil, the hint is always active.\n84\t//\n85\t// discovered is a set of skill names (map for O(1) membership); pass nil\n86\t// or an empty map when no skills have been discovered.\n87\tf