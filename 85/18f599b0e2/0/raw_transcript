iew attach.\n45\t\tReviewSkills []string\n46\t}\n47\t\n48\tfunc newAttachCmd() *cobra.Command {\n49\t\tvar (\n50\t\t\tforce      bool\n51\t\t\tagentFlag  string\n52\t\t\treviewFlag bool\n53\t\t\tskillsFlag []string\n54\t\t)\n55\t\tcmd := &cobra.Command{\n56\t\t\tUse:   \"attach <session-id>\",\n57\t\t\tShort: \"Attach an existing agent session\",\n58\t\t\tLong: `Attach an existing agent session that wasn't captured by hooks.\n59\t\n60\tThis creates a checkpoint from the session's transcript and links it to the\n61\tlast commit. Use this when hooks failed to fire or weren't installed when\n62\tthe session started, or to attach a research session.\n63\t\n64\tIf the last commit already has a checkpoint, the session is added to it.\n65\tOtherwise a new checkpoint is created.\n66\t\n67\tUse --review to tag the attached session as an agent review. The skills\n68\tlist defaults to whatever is configured under review.<agent> in\n69\t.entire/settings.json; pass --skills to override.\n70\t\n71\tWorks with any registered agent, including external agents enabled via\n72\texternal_agents in settings. Run 'entire configure' to see the full list.`,\n73\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n74\t\t\t\tif len(args) != 1 {\n75\t\t\t\t\treturn cmd.Help()\n76\t\t\t\t}\n77\t\t\t\tif checkDisabledGuard(cmd.Context(), cmd.OutOrStdout()) {\n78\t\t\t\t\treturn nil\n79\t\t\t\t}\n80\t\t\t\t// Discover external agents so --agent <external-name> is recognized\n81\t\t\t\t// and so auto-detection can find transcripts from external agents.\n82\t\t\t\texternal.DiscoverAndRegister(cmd.Context())\n83\t\t\t\tagentName := types.AgentName(agentFlag)\n84\t\t\t\topts := attachOptions{Force: force}\n85\t\t\t\tif reviewFlag {\n86\t\t\t\t\tskills, err := resolveReviewSkills(cmd.Context(), agentName, skillsFlag)\n87\t\t\t\t\tif err != nil {\n88\t\t\t\t\t\tcmd.SilenceUsage = true\n89\t\t\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n90\t\t\t\t\t\treturn NewSilentError(err)\n91\t\t\t\t\t}\n92\t\t\t\t\topts.ReviewSkills = skills\n93\t\t\t\t}\n94\t\t\t\treturn runAttach(cmd.Context(), cmd.OutOrStdout(), args[0], agentName, opts)\n95\t\t\t},\n96\t\t}\n97\t\tcmd.Flags().BoolVarP(&force, \"force\", \"f\", false, \"Skip confirmation and amend the last commit with the checkpoint trailer\")\n98\t\tcmd.Flags().StringVarP(&agentFlag, \"agent\", \"a\", string(agent.DefaultAgentName), \"Agent that created the session (see 'entire configure' for registered agents, including external)\")\n99\t\tcmd.Flags().BoolVar(&reviewFlag, \"review\", false, \"Tag the attached session as an agent review\")\n100\t\tcmd.Flags().StringSliceVar(&skillsFlag, \"skills\", nil, \"Review skills that were run (default: configured skills for the agent). Only used with --review\")\n101\t\treturn cmd\n102\t}\n103\t\n104\t// resolveReviewSkills returns the skills list to record on an attach-as-review.\n105\t// If flagSkills is non-empty, it wins. Otherwise the configured review skills\n106\t// for the agent are used; if none are configured, returns an error pointing\n107\t// the user at `entire review --edit`.\n108\tfunc resolveReviewSkills(ctx context.Context, agentName types.AgentName, flagSkills []string) ([]string, error) {\n109\t\tif len(flagSkills) > 0 {\n110\t\t\treturn flagSkills, nil\n111\t\t}\n112\t\ts, err := settings.Load(ctx)\n113\t\tif err != nil {\n114\t\t\treturn nil, fmt.Errorf(\"load settings: %w\", err)\n115\t\t}\n116\t\tif s != nil {\n117\t\t\tif skills := s.ReviewSkillsFor(string(agentName)); len(skills) > 0 {\n118\t\t\t\treturn skills, nil\n119\t\t\t}\n120\t\t}\n121\t\treturn nil, fmt.Errorf(\n122\t\t\t\"no review skills configured for agent %q and --skills not provided; run `entire review --edit`\",\n123\t\t\tagentName,\n124\t\t)\n125\t}\n126\t\n127\tfunc runAttach(ctx context.Context, w io.Writer, sessionID string, agentName types.AgentName, opts attachOptions) error {\n128\t\t// Initialize structured logger so logging.Warn/Info write to .entire/logs/ not stder