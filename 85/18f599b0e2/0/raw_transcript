eturn err\n90\t\t}\n91\t\n92\t\texistingState, err := validateAttachPreconditions(ctx, repo, sessionID)\n93\t\tif err != nil {\n94\t\t\treturn err\n95\t\t}\n96\t\n97\t\theadCommit, err := getHeadCommit(repo)\n98\t\tif err != nil {\n99\t\t\treturn err\n100\t\t}\n101\t\n102\t\t// If session already has a checkpoint, just offer to link it.\n103\t\tif existingState != nil && !existingState.LastCheckpointID.IsEmpty() {\n104\t\t\tcpID := existingState.LastCheckpointID.String()\n105\t\t\tfmt.Fprintf(w, \"Session %s already has checkpoint %s\\n\", sessionID, cpID)\n106\t\t\tif err := promptAmendCommit(logCtx, w, headCommit, cpID, force); err != nil {\n107\t\t\t\tlogging.Warn(logCtx, \"failed to amend commit\", \"error\", err)\n108\t\t\t\tfmt.Fprintf(w, \"\\nCopy to your commit message to attach:\\n\\n  Entire-Checkpoint: %s\\n\", cpID)\n109\t\t\t}\n110\t\t\treturn nil\n111\t\t}\n112\t\n113\t\t// Resolve agent and transcript path.\n114\t\tag, transcriptPath, err := resolveAgentAndTranscript(logCtx, w, sessionID, agentName, existingState)\n115\t\tif err != nil {\n116\t\t\treturn err\n117\t\t}\n118\t\n119\t\ttranscriptData, err := ag.ReadTranscript(transcriptPath)\n120\t\tif err != nil {\n121\t\t\treturn fmt.Errorf(\"failed to read transcript: %w\", err)\n122\t\t}\n123\t\n124\t\t// Normalize Gemini transcripts for storage.\n125\t\tstoredTranscript := transcriptData\n126\t\tif ag.Type() == agent.AgentTypeGemini {\n127\t\t\tif normalized, normErr := geminicli.NormalizeTranscript(transcriptData); normErr == nil {\n128\t\t\t\tstoredTranscript = normalized\n129\t\t\t} else {\n130\t\t\t\tlogging.Warn(logCtx, \"failed to normalize Gemini transcript, storing raw\", \"error\", normErr)\n131\t\t\t}\n132\t\t}\n133\t\n134\t\tmeta := extractTranscriptMetadata(transcriptData)\n135\t\n136\t\t// Determine checkpoint ID: reuse from HEAD if one exists, otherwise generate new.\n137\t\tcheckpointID, isExistingCheckpoint := resolveCheckpointID(headCommit)\n138\t\n139\t\t// Refresh the metadata branch if HEAD already references a checkpoint.\n140\t\t// Returns a possibly-freshly-opened repo handle; see refreshForExistingCheckpoint.\n141\t\trepo = refreshForExistingCheckpoint(ctx, logCtx, repo, isExistingCheckpoint)\n142\t\n143\t\t// Write directly to entire/checkpoints/v1.\n144\t\tstore := cpkg.NewGitStore(repo)\n145\t\tif err := verifyCheckpointLocallyAvailable(ctx, store, checkpointID, isExistingCheckpoint); err != nil {\n146\t\t\treturn err\n147\t\t}\n148\t\n149\t\tauthor, err := GetGitAuthor(ctx)\n150\t\tif err != nil {\n151\t\t\treturn fmt.Errorf(\"failed to get git author: %w\", err)\n152\t\t}\n153\t\n154\t\tvar prompts []string\n155\t\tif meta.FirstPrompt != \"\" {\n156\t\t\tprompts = []string{meta.FirstPrompt}\n157\t\t}\n158\t\n159\t\ttokenUsage := agent.CalculateTokenUsage(logCtx, ag, transcriptData, 0, \"\")\n160\t\n161\t\t_, redactSpan := perf.Start(ctx, \"redact_transcript\")\n162\t\tredactedTranscript, redactErr := redact.JSONLBytes(storedTranscript)\n163\t\tredactSpan.End()\n164\t\tif redactErr != nil {\n165\t\t\treturn fmt.Errorf(\"failed to redact transcript: %w\", redactErr)\n166\t\t}\n167\t\n168\t\twriteOpts := cpkg.WriteCommittedOptions{\n169\t\t\tCheckpointID: checkpointID,\n170\t\t\tSessionID:    sessionID,\n171\t\t\tStrategy:     strategy.StrategyNameManualCommit,\n172\t\t\tTranscript:   redactedTranscript,\n173\t\t\tPrompts:      prompts,\n174\t\t\tAuthorName:   author.Name,\n175\t\t\tAuthorEmail:  author.Email,\n176\t\t\tAgent:        ag.Type(),\n177\t\t\tModel:        meta.Model,\n178\t\t\tTokenUsage:   tokenUsage,\n179\t\t}\n180\t\n181\t\tif compacted := compactTranscriptForStartLine(logCtx, redactedTranscript.Bytes(), cpkg.CommittedMetadata{\n182\t\t\tCheckpointID: checkpointID,\n183\t\t\tAgent:        ag.Type(),\n184\t\t}, 0); compacted != nil {\n185\t\t\twriteOpts.CompactTranscript = compacted\n186\t\t}\n187\t\n188\t\tv2 := settings.CheckpointsVersion(logCtx) == 2\n189\t\tif !v2 {\n190\t\t\tif err := store.WriteCommitted(ctx, writeOpts); err != nil {\n191\t\t\t\treturn fmt.Errorf(\"failed to write checkpoint: %w\", err)\n192\t\t\t}\n193\t\t}\n194\t\t// IsCheckpointsV2Enabled is true whenever v2 writes are enabled, including\n195\t\t// both v2-only mode (checkpoints_version == 2) and dual-write mode. Only\n196\t\t// v2-only mode propagates the error.\n197\t\tif settings.IsCheckpointsV2Enabled(logCtx) {\n198\t\t\tif err := writeAttachCheckpointV2(logCtx, repo, writeOpts); err != nil {\n199\t\t\t\tif v2 {\n200\t\t\t\t\treturn fmt.Errorf(\"failed to write checkpoint to v2: %w\", err)\n201\t\t\t\t}\n202\t\t\t\tlogging.Warn(logCtx, \"attach v2 dual-write failed\", \"error\", err)\n203\t\t\t}\n204\t\t}\n205\t\n206\t\t// Create or update session state.\n207\t\tif err := saveAttachSessionState(logCtx, existingState, sessionID, ag.Type(), transcriptPath, checkpointID, meta, tokenUsage); err != nil {\n208\t\t\tlogging.Warn(logCtx, \"failed to save session state\", \"error\", err)\n209\t\t}\n210\t\n211\t\tfmt.Fprintf(w, \"Attached session %s\\n\", sessionID)\n212\t\tif isExistingCheckpoint {\n213\t\t\tfmt.Fprintf(w, \"  Added to existing checkpoint %s\\n\", checkpointID)\n214\t\t\treturn nil\n215\t\t}\n216\t\n\n... [309 lines truncated] ..."},"type":"attachment","uuid":"40164678-b849-4acc-b901-9a4957d1fa83","timestamp":"2026-04-23T16:16:51.269Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli","sessionId":"9a29d9ba-5e22-4e92-a5d0-017356e28328","version":"2.1.117","gitBranch":"soph/attach-checkpoint-safety"}
