ate or transcript auto-detection), not at the cobra layer — the\n46\t\t// --agent flag's default points at claude-code, which would otherwise\n47\t\t// make a Gemini session incorrectly look up review.claude-code config.\n48\t\tReview bool\n49\t\t// ReviewSkillsOverride, when non-empty, overrides the agent's\n50\t\t// configured review skills. Empty means \"read review.<agent> from\n51\t\t// settings after resolving the real agent\". Ignored when Review=false.\n52\t\tReviewSkillsOverride []string\n53\t}\n54\t\n55\tfunc newAttachCmd() *cobra.Command {\n56\t\tvar (\n57\t\t\tforce      bool\n58\t\t\tagentFlag  string\n59\t\t\treviewFlag bool\n60\t\t\tskillsFlag []string\n61\t\t)\n62\t\tcmd := &cobra.Command{\n63\t\t\tUse:   \"attach <session-id>\",\n64\t\t\tShort: \"Attach an existing agent session\",\n65\t\t\tLong: `Attach an existing agent session that wasn't captured by hooks.\n66\t\n67\tThis creates a checkpoint from the session's transcript and links it to the\n68\tlast commit. Use this when hooks failed to fire or weren't installed when\n69\tthe session started, or to attach a research session.\n70\t\n71\tIf the last commit already has a checkpoint, the session is added to it.\n72\tOtherwise a new checkpoint is created.\n73\t\n74\tUse --review to tag the attached session as an agent review. The\n75\tfirst user prompt in the transcript is recorded as the review prompt.\n76\tPass --skills to declare which skills were actually run; omit to\n77\tattach a review without a declared skills list.\n78\t\n79\tWorks with any registered agent, including external agents enabled via\n80\texternal_agents in settings. Run 'entire configure' to see the full list.`,\n81\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n82\t\t\t\tif len(args) != 1 {\n83\t\t\t\t\treturn cmd.Help()\n84\t\t\t\t}\n85\t\t\t\tif checkDisabledGuard(cmd.Context(), cmd.OutOrStdout()) {\n86\t\t\t\t\treturn nil\n87\t\t\t\t}\n88\t\t\t\t// Discover external agents so --agent <external-name> is recognized\n89\t\t\t\t// and so auto-detection can find transcripts from external agents.\n90\t\t\t\texternal.DiscoverAndRegister(cmd.Context())\n91\t\t\t\tagentName := types.AgentName(agentFlag)\n92\t\t\t\topts := attachOptions{\n93\t\t\t\t\tForce:                force,\n94\t\t\t\t\tReview:               reviewFlag,\n95\t\t\t\t\tReviewSkillsOverride: skillsFlag,\n96\t\t\t\t}\n97\t\t\t\treturn runAttachSurfaceReviewErrors(cmd, args[0], agentName, opts)\n98\t\t\t},\n99\t\t}\n100\t\tcmd.Flags().BoolVarP(&force, \"force\", \"f\", false, \"Skip confirmation and amend the last commit with the checkpoint trailer\")\n101\t\tcmd.Flags().StringVarP(&agentFlag, \"agent\", \"a\", string(agent.DefaultAgentName), \"Agent that created the session (see 'entire configure' for registered agents, including external)\")\n102\t\tcmd.Flags().BoolVar(&reviewFlag, \"review\", false, \"Tag the attached session as an agent review\")\n103\t\tcmd.Flags().StringSliceVar(&skillsFlag, \"skills\", nil, \"Optional: declare which review skills were run in this session. Only used with --review\")\n104\t\treturn cmd\n105\t}\n106\t\n107\t// resolveReviewSkills returns the skills list to record on an\n108\t// attach-as-review. Only the user's --skills flag counts: configured\n109\t// settings.Review[agent] is the spawn-path default (\"what I'd run if I\n110\t// used 'entire review'\"), not a claim about what actually happened in a\n111\t// given manual session. Silently attaching configured skills would\n112\t// misrepresent the session as having run skills it may not have.\n113\t//\n114\t// Empty is a valid result — the attach still tags the session as a\n115\t// review via Kind + ReviewPrompt (the session's first user prompt). The\n116\t// skills list is a queryable convenience, not the source of truth.\n117\tfunc resolveReviewSkills(flagSkills []string) []string {\n118\t\tif len(flagSkills) == 0 {\n119\t\t\treturn nil\n120\t\t}\n121\t\treturn flagSkills\n122\t}\n123\t\n124\t// runAttachSurfaceReviewErrors 