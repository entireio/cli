er\n          }\n        }\n      >\n    }\n\n    const codex = body.agents.codex.me\n    expect(codex.labels).toEqual([{ label: \"investigation\", count: 1 }])\n    expect(codex.skills).toEqual([{ skill: \"codex:codex-rescue\", count: 1 }])\n    expect(codex.toolMix.shell).toBe(2)\n    expect(codex.toolMix.fileOps).toBe(1)\n    expect(codex.transcriptTokens).toBe(1234)\n    expect(codex.filesChanged).toBe(5)\n  })\n})\n"}}
