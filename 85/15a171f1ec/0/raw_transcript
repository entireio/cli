{"timestamp":"2026-05-08T13:58:17.501Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_f7PvoP9pTrhZRcMZJilWIy2G","output":"Chunk ID: db3afe\nWall time: 0.2013 seconds\nProcess exited with code 0\nOriginal token count: 6695\nOutput:\n// GET /api/v1/me/recap — per-agent recap aggregates for the CLI.\n//\n// Returns, for every agent the user has used in the window (and optionally\n// every agent any contributor used on a scoped repo):\n//   - me side: checkpoints + tokens + transcriptTokens + filesChanged +\n//     labels + skills + mcpServers + toolMix\n//   - contributors side: the same shape aggregated across all contributors\n//     to the specified repo. Only populated when ?repo=org/name is supplied;\n//     otherwise both per-agent contributors and the top-level contributors\n//     summary are null (cross-repo team aggregation has no coherent\n//     \"everyone else\" set without a single repo as the reference frame).\n//\n// This endpoint consolidates three CLI operations into one request:\n//   1. GET /api/v1/me/checkpoints       → list my checkpoints\n//   2. POST /checkpoints/analyses/batch → analyses for each cp\n//   3. GET /:org/:repo/overview/*       → contributor aggregates\n//\n// Without this endpoint the CLI has to do all three itself and attribute\n// analyses to agents via the commits endpoint — a lot of round trips and\n// brittle client-side joining. Centralizing on the server matches the\n// pattern established by /me/activity (PR #1590).\n\nimport type { Context } from \"hono\"\nimport { Hono } from \"hono\"\nimport { describeRoute, resolver } from \"hono-openapi\"\nimport { z } from \"zod\"\n\nimport type { Env, Variables } from \"../env\"\nimport { getAgentId, getAgentLabel, type AgentId } from \"../lib/agents\"\nimport { getDb } from \"../lib/db\"\nimport type { UserCheckpoint } from \"../lib/db/checkpoints\"\nimport type { AnalysisFacetsByAgent } from \"../lib/db/db-types\"\nimport { recordSpanError } from \"../lib/telemetry\"\nimport { TOOL_MIX_CATEGORY_KEYS, type StoredCheckpointAnalysis } from \"../types\"\nimport { parseTimeframeParams } from \"./cache\"\n\n// REMOVE AFTER 24h PRODUCTION SOAK along with the legacy mergeAnalysesInto\n// path it gates. Toggle this off to revert to the JS aggregator without\n// redeploying — kept as a fast-rollback escape hatch for the initial\n// rollout. Cloudflare Workers env vars are statically configured so the\n// flag should be replaced with KV-backed config if it ever needs to live\n// longer than 24h.\nconst USE_FACET_AGGREGATOR = true\n\n// recapRoutes is mounted inside meRoutes at /me/recap. Bearer-auth is\n// applied at the meRoutes level (requireBearerAuth); duplicating it here\n// would double-execute the middleware.\nconst recapRoutes = new Hono<{ Bindings: Env; Variables: Variables }>()\n\nconst errorSchema = z.object({ error: z.string() })\n\nconst labelCountSchema = z.object({ label: z.string(), count: z.number() })\nconst skillCountSchema = z.object({ skill: z.string(), count: z.number() })\nconst mcpCountSchema = z.object({ name: z.string(), count: z.number() })\nconst toolMixSchema = z.object({\n  shell: z.number(),\n  fileOps: z.number(),\n  search: z.number(),\n  mcp: z.number(),\n  agent: z.number(),\n  other: z.number(),\n})\n\n// AgentAggregate is the per-side per-agent payload. Same shape on both\n// me and contributors sides so the CLI renderer can treat them uniformly.\n// Derived from the Zod schema so the response contract and the TS type\n// can't drift — there's a single source of truth.\nconst agentAggregateSchema = z.object({\n  sessions: z.number(),\n  checkpoints: z.number(),\n  tokens: z.number(),\n  transcriptTokens: z.number(),\n  filesChanged: z.number(),\n  labels: z.array(labelCountSchema),\n  skills: z.array(skillCountSchema),\n  mcpServers: z.array(mcpCountSchema),\n  toolMix: toolMixSchema,\n})\ntype AgentAggregate = z.infer<typeof agentAggregateSchema>\ntype AgentAggregates = Partial<Record<AgentId, AgentAggregate>>\n\nconst summaryTotalsSchema = z.object({\n  sessions: z.number(),\n  checkpoints: z.number(),\n  tokens: z.number(),\n})\n\nconst perAgentEntrySchema = z.object({\n  agentId: z.string(),\n  agentLabel: z.string(),\n  me: agentAggregateSchema,\n  contributors: agentAggregateSchema.nullable(),\n})\n\nconst recapResponseSchema = z.object({\n  timeframe: z.string(),\n  repo: z.string().nullable(),\n  since: z.string(),\n  until: z.string(),\n  agents: z.record(z.string(), perAgentEntrySchema),\n  summary: z.object({\n    me: summaryTotalsSchema,\n    team: summaryTotalsSchema.nullable(),\n    repoCount: z.number(),\n    activeDays: z.number(),\n    analysis: z.object({\n      complete: z.number(),\n      pending: z.number(),\n      failed: z.number(),\n    }),\n  }),\n  contributors: z\n    .object({\n      distinctUsers: z.number(),\n      totalTokens: z.number(),\n      totalCheckpoints: z.number(),\n    })\n    .nullable(),\n  daily: z.array(z.object({ date: z.string(), count: z.number() })),\n  updated_at: z.string(),\n})\n\nrecapRoutes.get(\n  \"/\",\n  describeRoute({\n    tags: [\"Me\"],\n    summary: \"Per-agent recap aggregates for the authenticated user\",\n    description:\n      \"Returns per-agent aggregates (checkpoints, labels, skills, MCP servers, \" +\n      \"tool-profile mix) for the authenticated user's activity in the requested \" +\n      \"window. When ?repo=org/name is supplied, each agent row also carries a \" +\n      \"`contributors` counterpart aggregated across every contributor on the \" +\n      \"repo — what powers the 'you vs. team' columns in `entire recap`.\",\n    parameters: [\n      {\n        name: \"timeframe\",\n        in: \"query\",\n        required: false,\n        description: \"Window of activity to aggregate. Defaults to last-6-months.\",\n        schema: {\n          type: \"string\",\n          enum: [\"last-month\", \"last-3-months\", \"last-6-months\"],\n        },\n      },\n      {\n        name: \"repo\",\n        in: \"query\",\n        required: false,\n        description:\n          \"Restrict me-side aggregates and enable the contributors side. \" +\n          \"Format: 'org/name'. Without it, me-side aggregates span every repo \" +\n          \"the user has checkpoints on and the contributors side is null.\",\n        schema: { type: \"string\" },\n      },\n      {\n        name: \"limit\",\n        in: \"query\",\n        required: false,\n        description:\n          \"Optional max checkpoints to consider (1-1000). Omit for an uncapped aggregate.\",\n        schema: { type: \"integer\", minimum: 1, maximum: 1000 },\n      },\n      {\n        name: \"since\",\n        in: \"query\",\n        required: false,\n        description:\n          \"ISO-8601 lower bound for the activity window. When provided \" +\n          \"together with `until`, takes precedence over `timeframe`. The CLI \" +\n          \"uses this so its --day / --week / --month ranges line up exactly \" +\n          \"with the server's aggregation window.\",\n        schema: { type: \"string\", format: \"date-time\" },\n      },\n      {\n        name: \"until\",\n        in: \"query\",\n        required: false,\n        description:\n          \"ISO-8601 upper bound for the activity window. Must be supplied \" +\n          \"alongside `since` to override the `timeframe` enum.\",\n        schema: { type: \"string\", format: \"date-time\" },\n      },\n    ],\n    responses: {\n      200: {\n        description: \"Per-agent recap aggregates\",\n        content: { \"application/json\": { schema: resolver(recapResponseSchema) } },\n      },\n      400: {\n        description:\n          \"Invalid since/until (must be supplied together as ISO-8601, with since <= until)\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      401: {\n        description: \"Not authenticated\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      404: {\n        description: \"Authenticated user record not found\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n      500: {\n        description: \"Failed to build recap\",\n        content: { \"application/json\": { schema: resolver(errorSchema) } },\n      },\n    },\n  }),\n  async (c) => {\n    const userId = c.get(\"userId\") as string\n    const window = parseRecapWindow(c)\n    if (!window.ok) {\n      return c.json({ error: window.error }, 400)\n    }\n    const { limit, startDate, endDate } = window\n    const repoParam = c.req.query(\"repo\")?.trim() || null\n\n    try {\n      const db = getDb(c.env)\n      const user = await db.users.getWithCache(c.env.ENTIRE_CACHE, userId)\n      if (!user) return c.json({ error: \"User not found\" }, 404)\n\n      // Pull me-side from repo_checkpoints filtered to the user's commits.\n      // Team-side is only meaningful when the request scopes to a single\n      // repo — without that, \"everyone else\" has no coherent reference\n      // frame across all the user's repos. Skipping the team query when\n      // ?repo= is absent saves a heavy join and matches the documented\n      // contract that contributors is null in the cross-repo case.\n      const since = startDate.toISOString()\n      const until = endDate.toISOString()\n      const [myCheckpoints, teamCheckpoints] = await Promise.all([\n        db.checkpoints.getByUser(\n          userId,\n          user.github_id,\n          since,\n          until,\n          limit,\n          repoParam ?? undefined,\n        ),\n        repoParam\n          ? db.checkpoints.getTeamOnUserRepos(\n              userId,\n              user.github_id,\n              since,\n              until,\n              limit,\n              repoParam,\n            )\n          : Promise.resolve([]),\n      ])\n\n      // Base per-agent counts + tokens come straight off the checkpoint\n      // rows (input_tokens + output_tokens). No custom aggregator needed.\n      const meByAgent = aggregateCheckpointsByAgent(myCheckpoints)\n      const teamByAgent = aggregateCheckpointsByAgent(teamCheckpoints)\n\n      // Merge analysis-derived fields (labels, skills, mcpServers, toolMix,\n      // transcriptTokens, filesChanged) for both sides. Analyses live on\n      // repo_checkpoint_analyses keyed by (repo_id, checkpoint_id). The two\n      // sides are disjoint (different checkpoint sets) so parallelizing is\n      // safe — saves one full set of analysis round trips.\n      if (USE_FACET_AGGREGATOR) {\n        const [meFacets, teamFacets] = await Promise.all([\n          db.analyses.aggregateFacetsByAgent(\n            myCheckpoints.map((cp) => ({\n              repo_id: cp.repo_id,\n              checkpoint_id: cp.checkpoint_id,\n              agent: cp.agent,\n            })),\n          ),\n          // teamCheckpoints is empty when repoParam is null (the upstream\n          // getTeamOnUserRepos call is skipped in that case), so the\n          // aggregator would just return an empty Map. Short-circuiting\n          // here saves one no-op DB round trip.\n          repoParam\n            ? db.analyses.aggregateFacetsByAgent(\n                teamCheckpoints.map((cp) => ({\n                  repo_id: cp.repo_id,\n                  checkpoint_id: cp.checkpoint_id,\n                  agent: cp.agent,\n                })),\n              )\n            : Promise.resolve(new Map<string, AnalysisFacetsByAgent>()),\n        ])\n        mergeFacetsIntoAggregates(meByAgent, meFacets)\n        mergeFacetsIntoAggregates(teamByAgent, teamFacets)\n        await Promise.all([\n          mergeMissingFacetAnalysesInto(db, meByAgent, myCheckpoints, meFacets),\n          mergeMissingFacetAnalysesInto(db, teamByAgent, teamCheckpoints, teamFacets),\n        ])\n      } else {\n        await Promise.all([\n          mergeAnalysesInto(db, meByAgent, myCheckpoints),\n          mergeAnalysesInto(db, teamByAgent, teamCheckpoints),\n        ])\n      }\n\n      // Daily activity from the user's own checkpoints — powers the CLI\n      // activity strip. Computed here so CLI doesn't need a second call.\n      const daily = buildDailyActivity(myCheckpoints, startDate, endDate)\n\n      // Contributors summary is only meaningful for a scoped repo. Count\n      // distinct *authors* (commit_author_github_id) — counting commit_sha\n      // would conflate \"team has 50 commits this week\" with \"50 distinct\n      // contributors\", which is wrong. The +1 for distinctUsers counts the\n      // requesting user themselves, but only when they actually have at\n      // least one checkpoint in the window — otherwise they're not a\n      // contributor in this window and counting them would over-state the\n      // team size.\n      let contribSummary: {\n        distinctUsers: number\n        totalTokens: number\n        totalCheckpoints: number\n      } | null = null\n      if (repoParam) {\n        const teamAuthorIds = new Set<number>()\n        for (const cp of teamCheckpoints) {\n          if (typeof cp.commit_author_github_id === \"number\") {\n            teamAuthorIds.add(cp.commit_author_github_id)\n          }\n        }\n        contribSummary = {\n          distinctUsers: teamAuthorIds.size + (myCheckpoints.length > 0 ? 1 : 0),\n          totalTokens: sumTokens(myCheckpoints) + sumTokens(teamCheckpoints),\n          totalCheckpoints: myCheckpoints.length + teamCheckpoints.length,\n        }\n      }\n\n      // Assemble final per-agent map. Agents that appear on either side.\n      // Each agent's contributors field is null when ?repo= is absent\n      // (no team data was fetched), matching the top-level contributors null.\n      const allAgents = new Set<AgentId>([\n        ...(Object.keys(meByAgent) as AgentId[]),\n        ...(Object.keys(teamByAgent) as AgentId[]),\n      ])\n      const agents: Record<\n        string,\n        {\n          agentId: string\n          agentLabel: string\n          me: AgentAggregate\n          contributors: AgentAggregate | null\n        }\n      > = {}\n      for (const agentId of allAgents) {\n        agents[agentId] = {\n          agentId,\n          agentLabel: getAgentLabel(agentId),\n          me: meByAgent[agentId] ?? emptyAggregate(),\n          contributors: repoParam ? (teamByAgent[agentId] ?? null) : null,\n        }\n      }\n\n      const summary = {\n        me: summarizeAggregates(meByAgent),\n        team: repoParam ? summarizeAggregates(teamByAgent) : null,\n        repoCount: countRepos(myCheckpoints),\n        activeDays: daily.filter((day) => day.count > 0).length,\n        analysis: { complete: 0, pending: 0, failed: 0 },\n      }\n\n      return c.json({\n        timeframe: c.req.query(\"timeframe\") ?? \"last-6-months\",\n        repo: repoParam,\n        since,\n        until,\n        agents,\n        summary,\n        contributors: contribSummary,\n        daily,\n        updated_at: new Date().toISOString(),\n      })\n    } catch (err) {\n      console.error(\"Failed to build recap:\", err)\n      recordSpanError(err)\n      return c.json({ error: \"Failed to build recap\" }, 500)\n    }\n  },\n)\n\n// parseRecapWindow accepts either explicit `since`/`until` ISO8601 params\n// or falls back to the timeframe enum (last-month / last-3-months /\n// last-6-months). Explicit dates give the CLI precise control so its\n// --day / --week / --month ranges line up exactly with the server's\n// aggregation boundaries.\n//\n// Returns a discriminated union so partial / malformed / inverted ranges\n// surface as 400s instead of silently degrading to the default window —\n// a CLI fat-finger on `--since` should not return 6 months of data.\ntype RecapWindow =\n  | { ok: true; limit: number | null; startDate: Date; endDate: Date }\n  | { ok: false; error: string }\n\nfunction parseRecapWindow(c: Context<{ Bindings: Env; Variables: Variables }>): RecapWindow {\n  const sinceParam = c.req.query(\"since\")\n  const untilParam = c.req.query(\"until\")\n  if (sinceParam || untilParam) {\n    if (!sinceParam || !untilParam) {\n      return { ok: false, error: \"since and until must be provided together\" }\n    }\n    const startDate = new Date(sinceParam)\n    const endDate = new Date(untilParam)\n    if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime())) {\n      return { ok: false, error: \"since and until must be valid ISO-8601 dates\" }\n    }\n    if (startDate.getTime() > endDate.getTime()) {\n      return { ok: false, error: \"since must be on or before until\" }\n    }\n    const limit = parseRecapLimit(c.req.query(\"limit\"))\n    return { ok: true, limit, startDate, endDate }\n  }\n  const fallback = parseTimeframeParams(c)\n  return {\n    ok: true,\n    limit: parseRecapLimit(c.req.query(\"limit\")),\n    startDate: fallback.startDate,\n    endDate: fallback.endDate,\n  }\n}\n\nfunction parseRecapLimit(limitParam: string | undefined): number | null {\n  if (!limitParam) return null\n  const parsedLimit = parseInt(limitParam, 10)\n  if (Number.isNaN(parsedLimit) || parsedLimit <= 0) return null\n  return Math.min(parsedLimit, 1000)\n}\n\n// aggregateCheckpointsByAgent groups UserCheckpoint rows by their agent\n// field and sums checkpoint counts + tokens. Token sum uses input_tokens\n// + output_tokens from the checkpoint row directly — no analyses required.\nfunction aggregateCheckpointsByAgent(cps: UserCheckpoint[]): AgentAggregates {\n  const buckets = new Map<\n    AgentId,\n    { aggregate: AgentAggregate; sessionIds: Set<string>; fallbackSessions: number }\n  >()\n  for (const cp of cps) {\n    const agentId = getAgentId(cp.agent)\n    let bucket = buckets.get(agentId)\n    if (!bucket) {\n      bucket = { aggregate: emptyAggregate(), sessionIds: new Set(), fallbackSessions: 0 }\n      buckets.set(agentId, bucket)\n    }\n    const agg = bucket.aggregate\n    agg.checkpoints += 1\n    agg.tokens += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n\n    if (cp.session_ids && cp.session_ids.length > 0) {\n      for (const sessionId of cp.session_ids) {\n        bucket.sessionIds.add(sessionId)\n      }\n    } else {\n      bucket.fallbackSessions += Math.max(cp.session_count ?? 1, 0)\n    }\n  }\n\n  const out: AgentAggregates = {}\n  for (const [agentId, bucket] of buckets) {\n    bucket.aggregate.sessions = bucket.sessionIds.size + bucket.fallbackSessions\n    out[agentId] = bucket.aggregate\n  }\n  return out\n}\n\nfunction sumTokens(cps: UserCheckpoint[]): number {\n  let total = 0\n  for (const cp of cps) {\n    total += (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0)\n  }\n  return total\n}\n\n// buildDailyActivity produces one entry per day in the window [start, end).\n// Days with no checkpoints return count=0 so the CLI renders a continuous\n// strip without gaps.\nfunction buildDailyActivity(\n  cps: UserCheckpoint[],\n  start: Date,\n  end: Date,\n): Array<{ date: string; count: number }> {\n  const days: string[] = []\n  const cursor = new Date(start)\n  cursor.setUTCHours(0, 0, 0, 0)\n  const endDay = new Date(end)\n  endDay.setUTCHours(0, 0, 0, 0)\n  while (cursor <= endDay) {\n    days.push(cursor.toISOString().slice(0, 10))\n    cursor.setUTCDate(cursor.getUTCDate() + 1)\n  }\n  const counts: Record<string, number> = Object.fromEntries(days.map((d) => [d, 0]))\n  for (const cp of cps) {\n    if (!cp.commit_date) continue\n    // Parse and format as UTC. Slicing the raw string mis-buckets dates\n    // with timezone offsets (e.g. `2026-04-20T23:30:00-07:00` would slice\n    // to `2026-04-20` but actually falls on `2026-04-21` in UTC).\n    const parsed = new Date(cp.commit_date)\n    if (Number.isNaN(parsed.getTime())) continue\n    const day = parsed.toISOString().slice(0, 10)\n    if (counts[day] !== undefined) counts[day] += 1\n  }\n  return days.map((date) => ({ date, count: counts[date] ?? 0 }))\n}\n\n// mergeAnalysesInto fetches analysis rows for the given checkpoints and\n// merges their labels, skills, mcpServers, toolMix, transcriptTokens, and\n// filesChanged onto the existing per-agent aggregate. Groups analysis\n// lookups by repo_id so one query per repo (N+1 by repo, not by checkpoint).\nasync function mergeAnalysesInto(\n  db: ReturnType<typeof getDb>,\n  byAgent: AgentAggregates,\n  cps: UserCheckpoint[],\n): Promise<void> {\n  if (cps.length === 0) return\n  const byRepo = new Map<string, string[]>()\n  for (const cp of cps) {\n    if (!cp.repo_id || !cp.checkpoint_id) continue\n    const arr = byRepo.get(cp.repo_id) ?? []\n    arr.push(cp.checkpoint_id)\n    byRepo.set(cp.repo_id, arr)\n  }\n  // Key by `${repo_id}:${checkpoint_id}` rather than checkpoint_id alone —\n  // checkpoint_id is only unique inside a repo (DB has a uniqueness\n  // constraint on (repo_id, checkpoint_id)), so cross-repo aggregation\n  // could otherwise overwrite an analysis with one from a different repo\n  // that happens to share the same checkpoint_id.\n  const analysisKey = (repoId: string, cpId: string) => `${repoId}:${cpId}`\n  const analysesById = new Map<string, StoredCheckpointAnalysis>()\n  // Fan out one query per repo in parallel. For users active across many\n  // repos (the no-?repo= path on me-side, which can span every repo the\n  // user has activity on), serializing these queries was the dominant\n  // route latency. Each task writes disjoint keys into the shared Map\n  // (keyed by repo_id), so there's no cross-task race.\n  await Promise.all(\n    [...byRepo].map(async ([rid, ids]) => {\n      const rows = await db.analyses.getByCheckpointIds(rid, ids)\n      for (const row of rows) {\n        if (row.status !== \"complete\" || !row.analysis_json) continue\n        try {\n          analysesById.set(analysisKey(rid, row.checkpoint_id), JSON.parse(row.analysis_json))\n        } catch (err) {\n          // A `status=\"complete\"` row with unparseable analysis_json is a real\n          // anomaly — the producer wrote garbage. Surface to telemetry rather\n          // than silently dropping; otherwise we'd return a perfectly-shaped\n          // response with systematically understated labels/skills/toolMix\n          // for the agent that owned this checkpoint.\n          recordSpanError(err)\n          console.error(\n            `recap: malformed analysis_json repo=${rid} cp=${row.checkpoint_id}: ${\n              err instanceof Error ? err.message : String(err)\n            }`,\n          )\n        }\n      }\n    }),\n  )\n  // Accumulate label / skill / mcp counts per agent then flatten.\n  const labelCounts: Partial<Record<AgentId, Record<string, number>>> = {}\n  const skillCounts: Partial<Record<AgentId, Record<string, number>>> = {}\n  const mcpCounts: Partial<Record<AgentId, Record<string, number>>> = {}\n  for (const cp of cps) {\n    const agent = getAgentId(cp.agent)\n    const agg = byAgent[agent]\n    if (!agg) continue\n    const analysis = analysesById.get(analysisKey(cp.repo_id, cp.checkpoint_id))\n    if (!analysis) continue\n    agg.transcriptTokens += analysis.total_transcript_tokens ?? 0\n    agg.filesChanged += analysis.totalFilesChanged ?? 0\n    for (const lbl of analysis.extraction?.labels ?? []) {\n      const m = (labelCounts[agent] ??= {})\n      m[lbl] = (m[lbl] ?? 0) + 1\n    }\n    for (const sk of analysis.skillsUsed ?? []) {\n      const m = (skillCounts[agent] ??= {})\n      m[sk] = (m[sk] ?? 0) + 1\n    }\n    for (const mcp of analysis.mcpServersUsed ?? []) {\n      const m = (mcpCounts[agent] ??= {})\n      m[mcp.name] = (m[mcp.name] ?? 0) + (mcp.count ?? 1)\n    }\n    if (analysis.toolProfile?.categories) {\n      const cats = analysis.toolProfile.categories\n      agg.toolMix.shell += cats.shell?.count ?? 0\n      agg.toolMix.fileOps += cats.fileOps?.count ?? 0\n      agg.toolMix.search += cats.search?.count ?? 0\n      agg.toolMix.mcp += cats.mcp?.count ?? 0\n      agg.toolMix.agent += cats.agent?.count ?? 0\n      agg.toolMix.other += cats.other?.count ?? 0\n    }\n  }\n  for (const [agent, m] of Object.entries(labelCounts)) {\n    byAgent[agent as AgentId]!.labels = Object.entries(m).map(([label, count]) => ({\n      label,\n      count,\n    }))\n  }\n  for (const [agent, m] of Object.entries(skillCounts)) {\n    byAgent[agent as AgentId]!.skills = Object.entries(m).map(([skill, count]) => ({\n      skill,\n      count,\n    }))\n  }\n  for (const [agent, m] of Object.entries(mcpCounts)) {\n    byAgent[agent as AgentId]!.mcpServers = Object.entries(m).map(([name, count]) => ({\n      name,\n      count,\n    }))\n  }\n}\n\n// mergeFacetsIntoAggregates overlays per-agent facet aggregates (computed in\n// SQL via aggregateFacetsByAgent) onto the per-agent count rollups. Replaces\n// the previous JS-side mergeAnalysesInto + per-checkpoint analysis_json fetch.\n//\n// labels, skills, and mcpServers are REPLACED wholesale (the SQL aggregate is\n// the truth); transcriptTokens/filesChanged are scalar overwrites; toolMix is\n// OVERLAID for known keys only — AgentAggregate.toolMix has a fixed key set\n// (shell/fileOps/search/mcp/agent/other) and we don't want stray facet names\n// from a malformed analysis to pollute the response shape.\nfunction mergeFacetsIntoAggregates(\n  byAgent: AgentAggregates,\n  facets: Map<string, AnalysisFacetsByAgent>,\n): void {\n  const toolMixKeys = new Set<string>(TOOL_MIX_CATEGORY_KEYS)\n  for (const [agent, f] of facets) {\n    const agg = byAgent[getAgentId(agent)]\n    if (!agg) continue\n    agg.labels = f.labels.map((l) => ({ label: l.name, count: l.count }))\n    agg.skills = f.skills.map((s) => ({ skill: s.name, count: s.count }))\n    agg.mcpServers = f.mcpServers.map((m) => ({ name: m.name, count: m.count }))\n    agg.transcriptTokens = f.transcriptTokens\n    agg.filesChanged = f.filesChanged\n    for (const t of f.toolMix) {\n      if (toolMixKeys.has(t.name)) {\n        ;(agg.toolMix as Record<string, number>)[t.name] = t.coun