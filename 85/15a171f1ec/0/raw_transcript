export const rateLimitUnauthenticated = createMiddleware<{\n  Bindings: Env\n  Variables: Variables\n}>(async (c, next) => {\n  const userId = c.get(\"userId\")\n  if (userId) {\n    await next()\n    return\n  }\n\n  const ip = c.req.header(\"cf-connecting-ip\") || \"unknown\"\n  const limited = await enforceRateLimit(\n    c,\n    `ratelimit:unauth:${ip}`,\n    RATE_LIMIT_MAX_REQUESTS,\n    RATE_LIMIT_WINDOW_SECONDS,\n  )\n\n  if (limited) {\n    return limited\n  }\n\n  await next()\n})\n\nexport const rateLimitAuthenticated = createMiddleware<{\n  Bindings: Env\n  Variables: Variables\n}>(async (c, next) => {\n  const userId = c.get(\"userId\")\n  if (!userId) {\n    return c.json({ error: \"Not authenticated\" }, 401)\n  }\n\n  const limited = await enforceRateLimit(\n    c,\n    `ratelimit:auth:${userId}`,\n    AUTH_RATE_LIMIT_MAX_REQUESTS,\n    AUTH_RATE_LIMIT_WINDOW_SECONDS,\n  )\n\n  if (limited) {\n    return limited\n  }\n\n  await next()\n})\n\nexport const requireAuth = createMiddleware<{\n  Bindings: Env\n  Variables: AuthenticatedVariables\n}>(async (c, next) => {\n  return requireSessionAuth(c, next)\n})\n\n// Require Bearer token auth (for CLI/API clients using ent_ tokens)\nexport const requireBearerAuth = createMiddleware<{\n  Bindings: Env\n  Variables: AuthenticatedVariables\n}>(async (c, next) => {\n  const authHeader = c.req.header(\"Authorization\")\n\n  if (!authHeader) {\n    return c.json({ error: \"Not authenticated\" }, 401)\n  }\n\n  const parts = authHeader.split(\" \")\n  if (parts.length !== 2 || parts[0] !== \"Bearer\") {\n    return c.json({ error: \"Not authenticated\" }, 401)\n  }\n\n  const token = parts[1]\n  const db = getDb(c.env)\n\n  // ent_ tokens and JWTs must stay on disjoint validation paths.\n  if (token.startsWith(API_TOKEN_PREFIX)) {\n    const hash = await sha256Hex(token)\n    const lookup = await db.apiTokens.findByTokenHash(hash)\n\n    if (!lookup) {\n      return c.json({ error: \"Not authenticated\" }, 401)\n 