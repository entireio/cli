l cross-repo regression\n    // is now structurally impossible without the SQL aggregator itself\n    // being broken (covered by the aggregator's own tests).\n    mockGetByUser.mockResolvedValue([\n      makeCheckpoint({\n        repo_id: \"repo-A\",\n        checkpoint_id: \"shared\",\n        agent: \"Claude Code\",\n      }),\n      makeCheckpoint({\n        repo_id: \"repo-B\",\n        checkpoint_id: \"shared\",\n        agent: \"Codex\",\n      }),\n    ])\n    // Under the SQL facet aggregator the (repo_id, checkpoint_id) scoping is\n    // enforced server-side: the route hands the full (repo_id, checkpoint_id,\n    // agent) triple to aggregateFacetsByAgent and trusts the resulting\n    // per-agent map verbatim. Mock that map directly here.\n    mockAggregateFacetsByAgent.mockResolvedValue(\n      new Map([\n        [\n          \"Claude Code\",\n          {\n            labels: [{ name: \"bug_fix\", count: 1 }],\n            skills: [],\n            toolMix: [],\n            mcpServers: [],\n            transcriptTokens: 0,\n            filesChanged: 0,\n          },\n        ],\n        [\n          \"Codex\",\n          {\n            labels: [{ name: \"refactor\", count: 1 }],\n            skills: [],\n            toolMix: [],\n            mcpServers: [],\n            transcriptTokens: 0,\n            filesChanged: 0,\n          },\n        ],\n      ]),\n    )\n\n    const res = await get(\"/\")\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as {\n      agents: Record<\n        string,\n        { agentId: string; agentLabel: string; me: { labels: Array<{ label: string }> } }\n      >\n    }\n\n    const claude = body.agents.claude\n    const codex = body.agents.codex\n    expect(claude.agentId).toBe(\"claude\")\n    expect(claude.agentLabel).toBe(\"Claude Code\")\n    expect(claude.me.labels.map((l) => l.label)).toEqual([\"bug_fix\"])\n    expect(codex.me.labels.map((l) => l.label)).toEqual([\"refactor\"])\n\n    // The route must pass the full (repo_id, checkpoint_id, agent) triple so\n    // the SQL aggregator can scope correctly. Verify the call shape.\n    expect(mockAggregateFacetsByAgent).toHaveBeenCalledWith([\n      { repo_id: \"repo-A\", checkpoint_id: \"shared\", agent: \"Claude Code\" },\n      { repo_id: \"repo-B\", checkpoint_id: \"shared\", agent: \"Codex\" },\n    ])\n  })\n\n  it(\"uses aggregateFacetsByAgent output verbatim for team qualitative aggregates\", async () => {\n    mockGetByUser.mockResolvedValue([\n      {\n        repo_id: \"r\",\n        checkpoint_id: \"cp-1\",\n        agent: \"Claude Code\",\n        input_tokens: 100,\n        output_tokens: 50,\n      },\n    ])\n    mockGetTeamOnUserRepos.mockResolvedValue([\n      {\n        repo_id: \"r\",\n        checkpoint_id: \"cp-team-1\",\n        agent: \"Claude Code\",\n        commit_author_github_id: 999,\n        input_tokens: 200,\n        output_tokens: 100,\n      },\n    ])\n    mockAggregateFacetsByAgent\n      .mockResolvedValueOnce(new Map()) // me-side facets — empty\n      .mockResolvedValueOnce(\n        new Map([\n          [\n            \"Claude Code\",\n            {\n              labels: [\n                { name: \"bug_fix\", count: 5 },\n                { name: \"refactor\", count: 2 },\n              ],\n              skills: [{ name: \"debugging\", count: 3 }],\n              toolMix: [\n                { name: \"shell\", count: 12 },\n                { name: \"fileOps\", count: 8 },\n              ],\n              mcpServers: [],\n              transcriptTokens: 0,\n              filesChanged: 0,\n            },\n          ],\n        ]),\n      )\n\n    const res = await get(\"/?repo=org/app\")\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as {\n      agents: Record<\n        string,\n        {\n          contributors: {\n            labels: Array<{ label: string; count: number }>\n            skills: Array<{ skill: string; count: number }>\n            toolMix: Record<string, number>\n          } | null\n        }\n      >\n    }\n    expect(body.agents.claude.contributors!.labels).toEqual([\n      { label: \"bug_fix\", count: 5 },\n      { label: \"refactor\", count: 2 },\n    ])\n    expect(body.agents.claude.contributors!.skills).toEqual([{ skill: \"debugging\", count: 3 }])\n    expect(body.agents.claude.contributors!.toolMix.shell).toBe(12)\n  })\n\n  it(\"normalizes agent keys and includes distinct session counts\", async () => {\n    mockGetByUser.mockResolvedValue([\n      makeCheckpoint({\n        checkpoint_id: \"cp-1\",\n        agent: \"Claude Code\",\n        session_ids: [\"s-a\", \"s-b\"],\n      }),\n      makeCheckpoint({\n        checkpoint_id: \"cp-2\",\n        agent: \"claude-code\",\n        session_ids: [\"s-b\", \"s-c\"],\n      }),\n      makeCheckpoint({\n        checkpoint_id: \"cp-3\",\n        agent: \"Codex\",\n        session_ids: null,\n        session_count: 2,\n      }),\n    ])\n    mockGetTeamOnUserRepos.mockResolvedValue([\n      makeCheckpoint({\n        checkpoint_id: \"team-1\",\n        agent: \"Claude Code\",\n        session_ids: [\"team-s-1\"],\n        commit_author_github_id: 999,\n      }),\n    ])\n\n    const res = await get(\"/?repo=org/app\")\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as {\n      agents: Record<\n        string,\n        {\n          agentId: string\n          agentLabel: string\n          me: { sessions: number; checkpoints: number }\n          contributors: { sessions: number; checkpoints: number } | null\n        }\n      >\n    }\n\n    expect(Object.keys(body.agents).sort()).toEqual([\"claude\", \"codex\"])\n    expect(body.agents.claude.agentLabel).toBe(\"Claude Code\")\n    expect(body.agents.claude.me.sessions).toBe(3)\n    expect(body.agents.claude.me.checkpoints).toBe(2)\n    expect(body.agents.codex.me.sessions).toBe(2)\n    expect(body.agents.claude.contributors!.sessions).toBe(1)\n  })\n\n  it(\"returns top-level recap summary totals for CLI rendering\", async () => {\n    mockGetByUser.mockResolvedValue([\n      makeCheckpoint({\n        checkpoint_id: \"cp-1\",\n        repo_full_name: \"org/app\",\n        agent: \"Claude Code\",\n        session_ids: [\"s-a\"],\n        input_tokens: 100,\n        output_tokens: 50,\n      }),\n      makeCheckpoint({\n        checkpoint_id: \"cp-2\",\n        repo_full_name: \"org/other\",\n        agent: \"Codex\",\n        session_ids: [\"s-b\"],\n        input_tokens: 200,\n        output_tokens: 25,\n      }),\n    ])\n    mockGetTeamOnUserRepos.mockResolvedValue([\n      makeCheckpoint({\n        checkpoint_id: \"team-1\",\n        repo_full_name: \"org/app\",\n        agent: \"Claude Code\",\n        session_ids: [\"team-s-1\", \"team-s-2\"],\n        commit_author_github_id: 999,\n        input_tokens: 300,\n        output_tokens: 20,\n      }),\n    ])\n\n    const res = await get(\"/?repo=org/app\")\n    expect(res.status).toBe(200)\n    const body = (await res.json()) as {\n      summary: {\n        me: { sessions: number; checkpoints: number; tokens: number }\n        team: { sessions: number; checkpoints: number; tokens: number } | null\n        repoCount: number\n        activeDays: number\n        analysis: { complete: number; pending: number; failed: number }\n      }\n    }\n\n    expect(body.summary.me).toEqual({ sessions: 2, checkpoints: 2, tokens: 375 })\n    expect(body.summary.team).toEqual({ sessions: 2, checkpoints: 1, tokens: 320 })\n    expect(body.summary.repoCount).toBe(2)\n    expect(body.summary.activeDays).toBe(1)\n    expect(body.summary.analysis).toEqual({ complete: 0, pending: 0, failed: 0 })\n  })\n\n  it(\"issues me-side and team-side facet aggregations in parallel, not serially\", async () => {\n    // The parallelism contract under the SQL-aggregator path: when ?repo= is\n    // supplied, both me-side and team-side aggregateFacetsByAgent calls must be\n    // initiated before either resolves. A seq