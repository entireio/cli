nSummary) RunSummary\n\n\t// EnrichAgentRun optionally updates a single agent run after that agent\n\t// exits, before the overall multi-agent run has necessarily completed.\n\t//\n\t// Timing: called on the per-agent forwarding goroutine in RunMulti,\n\t// after proc.Wait() returns and after any synthetic RunError is queued.\n\t// Only the returned Tokens field is consumed (emitted as a synthetic\n\t// Tokens event so sinks see live token totals before sibling agents\n\t// finish); other field changes are discarded. Returning Tokens{In:0,\n\t// Out:0} suppresses emission entirely.\n\t//\n\t// Contract: nil is valid (no enrichment). The callback must be\n\t// goroutine-safe across N agents and must not block on a sink. A panic\n\t// is recovered; no synthetic Tokens event is emitted on panic.\n\tEnrichAgentRun func(context.Context, AgentRun) AgentRun","originalFile":"// Package types defines the per-agent abstraction interfaces for `entire review`.\n//\n// AgentReviewer is the contract every supported agent (claude-code, codex,\n// gemini-cli, future additions) implements in its own package. The orchestrator\n// in cmd/entire/cli/review/run.go consumes this interface, never importing\n// concrete agent packages — that's how new agents land as additive files\n// without touching shared code.\n//\n// Events flow as a stream: implementations spawn the agent process, parse\n// stdout into a sequence of typed Events (Started, AssistantText, ToolCall,\n// Tokens, Finished, RunError), and surface them via Process.Events. Per-agent\n// quirks (codex's chrome stripping, gemini's stdin requirement, claude's argv\n// shape) are entirely encapsulated inside each agent's adapter — shared code\n// only sees the cleaned event stream.\n//\n// Living in a subpackage (not the review root package) avoids import cycles:\n// per-agent reviewers and the orchestrator both depend on these types\n// without depending on each other.\npackage types\n\nimport \"context\"\n\n// AgentReviewer drives a single agent's review run.\ntype AgentReviewer interface {\n\t// Name returns the agent's registry key (e.g., \"claude-code\", \"codex\",\n\t// \"gemini-cli\"). Stable identifier; do not change after release without\n\t// updating settings migration.\n\tName() string\n\n\t// Start spawns the agent with the given run configuration. The returned\n\t// Process exposes streaming events via Events() and a Wait() that returns\n\t// when the process exits.\n\t//\n\t// Implementations MUST set the ENTIRE_REVIEW_* env vars on the spawned\n\t// child process (see cmd/entire/cli/review/env.go) so the agent's\n\t// lifecycle hooks adopt the session as a review session.\n\t//\n\t// Errors from Start indicate failure to construct or launch the process\n\t// (e.g., binary not on PATH at exec.Cmd.Start time, invalid argv). Once\n\t// Start returns nil, errors during the run flow through Process.Events\n\t// (as RunError) and Process.Wait.\n\tStart(ctx context.Context, run RunConfig) (Process, error)\n}\n\n// Process represents a running agent review.\ntype Process interface {\n\t// Events returns a channel that emits structured events as the agent\n\t// produces output. The channel is closed when the process exits — cleanly,\n\t// with error, or via context cancellation. Consumers should range over it.\n\tEvents() <-chan Event\n\n\t// Wait blocks until the process exits and returns:\n\t//   - nil on clean exit (exit code 0)\n\t//   - ctx.Err() on cancellation\n\t//   - an error wrapping *exec.ExitError on non-zero exit\n\t//   - other error types for I/O or pipe failures\n\t//\n\t// Wait must be called exactly once per Process. It is safe to call Wait\n\t// after the Events channel has closed. Consumers must drain Events until\n\t// close before calling Wait; otherwise an implementation that forwards\n\t// parsed events from another goroutine may block while sending.\n\tWait() error\n}\n\n// RunConfig is the immutable per-run configuration passed to AgentReviewer.Start.\n//\n// All fields are optional from a marshalling standpoint (zero value is valid),\n// but Skills is typically non-empty in practice — it carries the skill\n// invocations (e.g., \"/pr-review-toolkit:review-pr\") the configured agent\n// should run.\ntype RunConfig struct {\n\t// PromptOverride, when non-empty, is the exact prompt sent to the agent.\n\t// It preserves settings.ReviewConfig.Prompt's existing verbatim-override\n\t// contract: configured skills are still recorded as structured metadata,\n\t// but they are not prepended to the prompt text.\n\tPromptOverride string\n\n\t// Skills are skill invocation strings passed to the agent verbatim.\n\tSkills []string\n\n\t// AlwaysPrompt is the per-agent always-prompt configured in settings.\n\t// Concatenated with Skills + PerRunPrompt + a scope clause to form the\n\t// composed agent prompt.\n\tAlwaysPrompt string\n\n\t// PerRunPrompt is optional textarea input from a single invocation.\n\tPerRunPrompt string\n\n\t// ScopeBaseRef is the git ref the review is scoped against (typically the\n\t// closest ancestor branch). Used to compose the scope clause and as the\n\t// base for `git diff` operations the agent may perform.\n\tScopeBaseRef string\n\n\t// CheckpointContext is best-effort context derived from checkpoints in the\n\t// branch review scope. It is appended to generated prompts so every agent\n\t// can use checkpoint IDs, file summaries, and transcript lookup commands\n\t// while reviewing. PromptOverride remains verbatim and does not receive\n\t// this context.\n\tCheckpointContext string\n\n\t// StartingSHA is HEAD at invocation time, propagated to the lifecycle\n\t// hook via ENTIRE_REVIEW_STARTING_SHA so checkpoint metadata records\n\t// the commit that was reviewed.\n\tStartingSHA string\n\n\t// EnrichSummary optionally updates the completed run summary before sinks\n\t// receive RunFinished. It is used for post-process data such as token\n\t// totals that are only available after agent lifecycle hooks flush state.\n\tEnrichSummary func(context.Context, RunSummary) RunSummary\n\n\t// EnrichAgentRun optionally updates a single agent run after that agent\n\t// exits, before the overall multi-agent run has necessarily completed.\n\tEnrichAgentRun func(context.Context, AgentRun) AgentRun\n}\n\n// Event is the sealed sum type emitted by Process.Events. The unexported\n// isEvent method prevents external packages from adding event variants;\n// adding a new event requires updating this file (and every consumer's\n// type switch — that's intentional, since a new event variant is a contract\n// change).\ntype Event interface{ isEvent() }\n\n// Started signals the agent has begun the review. Adapters typically emit\n// this once at the top of the event stream.\ntype Started struct{}\n\nfunc (Started) isEvent() {}\n\n// AssistantText is narrative output from the agent (the actual review\n// response, not tool-call chrome or session metadata).\ntype AssistantText struct {\n\tText string\n}\n\nfunc (AssistantText) isEvent() {}\n\n// ToolCall reports a tool invocation by the agent. Args is an opaque\n// adapter-defined string — typically JSON for agents that emit structured\n// tool input (e.g., claude-code), or a single-line summary for those that\n// don't (e.g., codex). Shared consumers should treat Args as display-only\n// and not parse it; structured tool data is intentionally not part of this\n// contract.\ntype ToolCall struct {\n\tName string\n\tArgs string\n}\n\nfunc (ToolCall) isEvent() {}\n\n// Tokens reports cumulative token counts (running totals, not deltas).\n// Adapters may emit multiple Tokens events during a run; each emission\n// supersedes the prior, so consumers should overwrite (not sum) on receipt.\n// Adapters that only receive aggregate shutdown totals should emit at most one\n// final Tokens event rather than inventing deltas.\ntype Tokens struct {\n\tIn  int\n\tOut int\n}\n\nfunc (Tokens) isEvent() {}\n\n// Finished signals the agent has produced its final output and the event\n// stream is about to end. Success indicates the agent self-reported a\n// clean task completion. Success=false means the agent finished its event\n// stream but signaled it did not complete the review task — distinct from\n// process exit failure (which surfaces via Process.Wait, not as an event).\n//\n// Adapters typically emit this once at the bottom of the event stream,\n// before the channel closes.\ntype Finished struct {\n\tSuccess bool\n}\n\nfunc (Finished) isEvent() {}\n\n// RunError reports a non-fatal error during the run (e.g., hook failure,\n// transient stream parse error). Fatal errors that stop the agent surface\n// via Process.Wait, not as events.\ntype RunError struct {\n\tErr error\n}\n\nfunc (RunError) isEvent() {}\n","structuredPatch":[{"oldStart":106,"oldLines":10,"newStart":106,"newLines":31,"lines":["   // EnrichSummary optionally updates the completed run summary before sinks","   // receive RunFinished. It is used for post-process data such as token","   // totals that are only available after agent lifecycle hooks flush state.","+  //","+  // Timing: called on the orchestrator goroutine after every per-agent","+  // goroutine has exited, immediately before Sink.RunFinished is fanned","+  // out. The full RunSummary is consumed; any field the callback","+  // returns reaches the sinks.","+  //","+  // Contract: nil is valid (no enrichment). The callback must not block on","+  // a sink (deadlock) and should honor ctx for cancellation when doing I/O.","+  // A panic is recovered by the orchestrator and the un-enriched summary","+  // is forwarded to sinks unchanged.","   EnrichSummary func(context.Context, RunSummary) RunSummary"," ","   // EnrichAgentRun optionally updates a single agent run after that agent","   // exits, before the overall multi-agent run has necessarily completed.","+  //","+  // Timing: called on the per-agent forwarding goroutine in RunMulti,","+  // after proc.Wait() returns and after any synthetic RunError is queued.","+  // Only the returned Tokens field is consumed (emitted as a synthetic","+  // Tokens event so sinks see live token totals before sibling agents","+  // finish); other field changes are discarded. Returning Tokens{In:0,","+  // Out:0} suppresses emission entirely.","+  //","+  // Contract: nil is valid (no enrichment). The callback must be","+  // goroutine-safe across N agents and must not block on a sink. A panic","+  // is recovered; no synthetic Tokens event is emitted on panic.","   EnrichAgentRun func(context.Context, AgentRun) AgentRun"," }"," "]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"55b13c87-80d6-4c99-b7f7-9b35bc7a1c7c","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"e755fa5c-b328-4df6-9d0e-c68b395e061e","version":"2.1.139","gitBranch":"pr-1167-review"}
{"parentUuid":"7250f1a7-ef06-40c9-a567-3357b31e2212","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/run.go","snippet":"1\t// Package review — see env.go for package-level rationale.\n2\t//\n3\t// run.go implements the single-agent orchestrator. CU8 generalizes\n4\t// to N agents with a sibling RunMulti that re-uses the same\n5\t// AgentRun classification and Sink fan-out.\n6\tpackage review\n7\t\n8\timport (\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"time\"\n13\t\n14\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n15\t)\n16\t\n17\t// Run executes a single-agent review. Events from the agent are forwarded\n18\t// to all sinks via AgentEvent as they arrive; on completion, RunFinished\n19\t// is called on each sink with the populated RunSummary.\n20\t//\n21\t// Returns the summary plus the agent's terminal error (nil on clean exit,\n22\t// ctx.Err() on cancellation, an error wrapping *exec.ExitError on non-zero\n23\t// exit, or an agent-level error when the event stream reports failure).\n24\t// Callers can inspect both: the summary is always populated even on error.\n25\tfunc Run(\n26\t\tctx context.Context,\n27\t\treviewer reviewtypes.AgentReviewer,\n28\t\tcfg reviewtypes.RunConfig,\n29\t\tsinks []reviewtypes.Sink,\n30\t) (reviewtypes.RunSummary, error) {\n31\t\tstarted := time.Now()\n32\t\n33\t\tproc, err := reviewer.Start(ctx, cfg)\n34\t\tif err != nil {\n35\t\t\t// Construction failed — classify (cancellation vs failure), fan out, return.\n36\t\t\t// No event-stream signals available since Start failed before producing any.\n37\t\t\tfinished := time.Now()\n38\t\t\tstatus := classifyStatus(ctx, err, eventOutcome{})\n39\t\t\tsummary := reviewtypes.RunSummary{\n40\t\t\t\tStartedAt:  started,\n41\t\t\t\tFinishedAt: finished,\n42\t\t\t\tCancelled:  status == reviewtypes.AgentStatusCancelled,\n43\t\t\t\tAgentRuns: []reviewtypes.AgentRun{{\n44\t\t\t\t\tName:      reviewer.Name(),\n45\t\t\t\t\tStatus:    status,\n46\t\t\t\t\tErr:       err,\n47\t\t\t\t\tStartedAt: started,\n48\t\t\t\t\tDuration:  finished.Sub(started),\n49\t\t\t\t}},\n50\t\t\t}\n51\t\t\tfor _, sink := range sinks {\n52\t\t\t\tsink.RunFinished(summary)\n53\t\t\t}\n54\t\t\treturn summary, err //nolint:wrapcheck // interface-boundary passthrough; wrapping breaks classifyStatus's ctx.Err() identity check for cancelled-during-Start scenarios\n55\t\t}\n56\t\n57\t\tvar (\n58\t\t\tbuffer       []reviewtypes.Event\n59\t\t\ttokens       reviewtypes.Tokens\n60\t\t\tfinishedSeen bool // saw Finished{...} event from the parser\n61\t\t\tfinishedOk   bool // its Success field\n62\t\t\tsawRunError  bool // saw at least one RunError event\n63\t\t\tfirstRunErr  error\n64\t\t)\n65\t\tfor ev := range proc.Events() {\n66\t\t\tbuffer = append(buffer, ev)\n67\t\t\tswitch e := ev.(type) {\n68\t\t\tcase reviewtypes.Tokens:\n69\t\t\t\ttokens = e // Tokens is cumulative per CU2 contract — overwrite.\n70\t\t\tcase reviewtypes.Finished:\n71\t\t\t\tfinishedSeen = true\n72\t\t\t\tfinishedOk = e.Success\n73\t\t\tcase reviewtypes.RunError:\n74\t\t\t\tsawRunError = true\n75\t\t\t\tif firstRunErr == nil {\n76\t\t\t\t\tfirstRunErr = e.Err\n77\t\t\t\t}\n78\t\t\t}\n79\t\t\tfor _, sink := range sinks {\n80\t\t\t\tsink.AgentEvent(reviewer.Name(), ev)\n81\t\t\t}\n82\t\t}\n83\t\n84\t\twaitErr := proc.Wait()\n85\t\tfinished := time.Now()\n86\t\tif shouldEmitSyntheticRunError(ctx, waitErr) {\n87\t\t\tsynthEvent := reviewtypes.RunError{Err: waitErr}\n88\t\t\tbuffer = append(buffer, synthEvent)\n89\t\t\tsawRunError = true\n90\t\t\tif firstRunErr == nil {\n91\t\t\t\tfirstRunErr = waitErr\n92\t\t\t}\n93\t\t\tfor _, sink := range sinks {\n94\t\t\t\tsink.AgentEvent(reviewer.Name(), synthEvent)\n95\t\t\t}\n96\t\t}\n97\t\tstatus := classifyStatus(ctx, waitErr, eventOutcome{finishedSeen: finishedSeen, finishedOk: finishedOk, sawRunError: sawRunError})\n98\t\trunErr := waitErr\n99\t\tif runErr == nil && status == reviewtypes.AgentStatusFailed {\n100\t\t\trunErr = agentRunFailureError(reviewer.Name(), firstRunErr)\n101\t\t}\n102\t\n103\t\tsummary := reviewtypes.RunSummary{\n104\t\t\tStartedAt:  started,\n105\t\t\tFinishedAt: finished,\n106\t\t\tCancelled:  status == reviewtypes.AgentStatusCancelled,\n107\t\t\tAgentRuns: []reviewtypes.AgentRun{{\n108\t\t\t\tName:      reviewer.Name(),\n109\t\t\t\tStatus:    status,\n110\t\t\t\tTokens:    tokens,\n111\t\t\t\tBuffer:    buffer,\n112\t\t\t\tStartedAt: started,\n113\t\t\t\tDuration:  finished.Sub(started),\n114\t\t\t\tErr:       runErr,\n115\t\t\t}},\n116\t\t}\n117\t\tsummary = enrichRunSummary(ctx, cfg, summary)\n118\t\tfor _, sink := range sinks {\n119\t\t\tsink.RunFinished(summary)\n120\t\t}\n121\t\treturn summary, runErr\n122\t}\n123\t\n124\tfunc enrichRunSummary(ctx context.Context, cfg reviewtypes.RunConfig, summary reviewtypes.RunSummary) reviewtypes.RunSummary {\n125\t\tif cfg.EnrichSummary == nil {\n126\t\t\treturn summary\n127\t\t}\n128\t\treturn cfg.EnrichSummary(ctx, summary)\n129\t}\n130\t\n131\tfunc shouldEmitSyntheticRunError(ctx context.Context, waitErr error) bool {\n132\t\tif waitErr == nil {\n133\t\t\treturn false\n134\t\t}\n135\t\tif ctx.Err() != nil {\n136\t\t\treturn false\n137\t\t}\n138\t\tif errors.Is(waitErr, context.Canceled) || errors.Is(waitErr, context.DeadlineExceeded) {\n139\t\t\treturn false\n140\t\t}\n141\t\treturn true\n142\t}\n143\t\n144\tfunc agentRunFailureError(agent string, cause error) error {\n145\t\tif cause != nil {\n146\t\t\treturn fmt.Errorf(\"review agent %s reported failure: %w\", agent, cause)\n147\t\t}\n148\t\treturn fmt.Errorf(\"review agent %s reported failure\", agent)\n149\t}\n150\t\n151\t// eventOutcome summarises agent-level signals observed in the event stream.\n152\t// Used by classifyStatus to downgrade a process-level \"exit 0\" run that the\n153\t// parser flagged as torn (RunError + Finished{Success: false}) — a clean\n154\t// process exit doesn't imply a clean review result.\n155\ttype eventOutcome struct {\n156\t\tfinishedSeen bool // a Finished event was emitted (parser ran to completion)\n157\t\tfinishedOk   bool // Finished.Success\n158\t\tsawRunError  bool // at least one RunError event was emitted\n159\t}\n160\t\n161\t// classifyStatus maps a process Wait error AND the event-stream outcome to\n162\t// a terminal AgentStatus.\n163\t//\n164\t// Order matters: ctx-cancelled + signal-killed delivers an *exec.ExitError\n165\t// with exit code -1, which would otherwise be misclassified as Failed.\n166\t// Check ctx.Err() FIRST so cancelled runs are reported as Cancelled.\n167\t// (Reference: PR #1018 commit 8e82e407a.)\n168\t//\n169\t// Event-level signals override process-level success: if the parser saw a\n170\t// RunError or emitted Finished{Success: false}, the run is Failed even when\n171\t// the process exits 0. This catches torn stdout streams the parser surfaces\n172\t// via RunError + Finished{Success: false} (CU3 fix-loop guarantee).\n173\tfunc classifyStatus(ctx context.Context, waitErr error, outcome eventOutcome) reviewtypes.AgentStatus {\n174\t\tif ctx.Err() != nil {\n175\t\t\treturn reviewtypes.AgentStatusCancelled\n176\t\t}\n177\t\tif waitErr != nil {\n178\t\t\treturn reviewtypes.AgentStatusFailed\n179\t\t}\n180\t\t// Process exited cleanly (exit 0). Honor agent-level signals.\n181\t\tif outcome.sawRunError {\n182\t\t\treturn reviewtypes.AgentStatusFailed\n183\t\t}\n184\t\tif outcome.finishedSeen && !outcome.finishedOk {\n185\t\t\treturn reviewtypes.AgentStatusFailed\n186\t\t}\n187\t\treturn reviewtypes.AgentStatusSucceeded\n188\t}"},"type":"attachment","uuid":"6eebcc1b-78cb-4477-a6f9-dfe05e541978","timestamp":"2026-05-12T04:07:04.114Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli","sessionId":"e755fa5c-b328-4df6-9d0e-c68b395e061e","version":"2.1.139","gitBranch":"pr-1167-review"}
