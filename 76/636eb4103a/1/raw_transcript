{"parentUuid":"699867cc-a6b6-41fe-b780-6a17a70be97b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/cmd/entire/cli/review/manifest.go","snippet":"1\tpackage review\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"sort\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n15\t\tagenttypes \"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n17\t\treviewtypes \"github.com/entireio/cli/cmd/entire/cli/review/types\"\n18\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n19\t)\n20\t\n21\tconst localReviewManifestVersion = 1\n22\t\n23\t// LocalReviewManifest records one local `entire review` invocation. It lets\n24\t// `entire review --fix <session-id>` use a single session id as the lookup\n25\t// handle while still loading sibling agent outputs from the same review run.\n26\ttype LocalReviewManifest struct {\n27\t\tVersion         int              `json:\"version\"`\n28\t\tWorktreePath    string           `json:\"worktree_path\"`\n29\t\tCreatedAt       time.Time        `json:\"created_at\"`\n30\t\tStartingSHA     string           `json:\"starting_sha,omitempty\"`\n31\t\tSources         []ManifestSource `json:\"sources\"`\n32\t\tAggregateOutput string           `json:\"aggregate_output,omitempty\"`\n33\t}\n34\t\n35\ttype ManifestSource struct {\n36\t\tSessionID string `json:\"session_id\"`\n37\t\tAgent     string `json:\"agent\"`\n38\t\tLabel     string `json:\"label\"`\n39\t\tStatus    string `json:\"status,omitempty\"`\n40\t\tOutput    string `json:\"output,omitempty\"`\n41\t}\n42\t\n43\tfunc buildLocalReviewManifestFromSummary(\n44\t\tworktreeRoot string,\n45\t\theadSHA string,\n46\t\tsummary reviewtypes.RunSummary,\n47\t\tstates []*session.State,\n48\t\taggregateOutput string,\n49\t) LocalReviewManifest {\n50\t\tmanifest := LocalReviewManifest{\n51\t\t\tVersion:         localReviewManifestVersion,\n52\t\t\tWorktreePath:    worktreeRoot,\n53\t\t\tCreatedAt:       summary.StartedAt,\n54\t\t\tStartingSHA:     headSHA,\n55\t\t\tAggregateOutput: strings.TrimSpace(aggregateOutput),\n56\t\t}\n57\t\tusedSessions := map[string]bool{}\n58\t\tfor _, run := range summary.AgentRuns {\n59\t\t\tst := matchReviewSessionState(worktreeRoot, headSHA, summary.StartedAt, run.Name, states, usedSessions)\n60\t\t\tif st == nil || st.SessionID == \"\" {\n61\t\t\t\tcontinue\n62\t\t\t}\n63\t\t\tusedSessions[st.SessionID] = true\n64\t\t\tmanifest.Sources = append(manifest.Sources, ManifestSource{\n65\t\t\t\tSessionID: st.SessionID,\n66\t\t\t\tAgent:     run.Name,\n67\t\t\t\tLabel:     labelForReviewAgent(run.Name),\n68\t\t\t\tStatus:    run.Status.String(),\n69\t\t\t\tOutput:    agentRunOutput(run),\n70\t\t\t})\n71\t\t}\n72\t\treturn manifest\n73\t}\n74\t\n75\tfunc localReviewManifestFromCurrentState(\n76\t\tctx context.Context,\n77\t\tworktreeRoot string,\n78\t\theadSHA string,\n79\t\tsummary reviewtypes.RunSummary,\n80\t\taggregateOutput string,\n81\t) (LocalReviewManifest, []*session.State, error) {\n82\t\tstore, err := session.NewStateStore(ctx)\n83\t\tif err != nil {\n84\t\t\treturn LocalReviewManifest{}, nil, fmt.Errorf(\"create session state store: %w\", err)\n85\t\t}\n86\t\tstates, err := store.List(ctx)\n87\t\tif err != nil {\n88\t\t\treturn LocalReviewManifest{}, nil, fmt.Errorf(\"list session states: %w\", err)\n89\t\t}\n90\t\treturn buildLocalReviewManifestFromSummary(worktreeRoot, headSHA, summary, states, aggregateOutput), states, nil\n91\t}\n92\t\n93\t// explainEmptyManifest returns a single-line diagnostic explaining why\n94\t// matchReviewSessionState produced no matches for any agent run in summary,\n95\t// plus a sentinel flag indicating the function fell through every known\n96\t// rejection cause. The sentinel means matcher and explainer drifted and\n97\t// cal