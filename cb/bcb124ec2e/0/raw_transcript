y/require\"\n)\n\n// TestOPFSmoke is a one-off smoke for the OpenAI Privacy Filter integration.\n// It configures OPF in the test repo, drives a Vogon session whose prompt\n// mentions \"Alice Smith\", commits to trigger condensation, then asserts the\n// condensed transcript has the name replaced with [REDACTED_PERSON].\n//\n// Requires `opf` installed locally.\nfunc TestOPFSmoke(t *testing.T) {\n\ttestutil.ForEachNamedAgent(t, 3*time.Minute, []string{\"vogon\"}, func(t *testing.T, s *testutil.RepoState, ctx context.Context) {\n\t\t// Commit the enable artifacts so the worktree is clean.\n\t\ts.Git(t, \"add\", \".\")\n\t\ts.Git(t, \"commit\", \"-m\", \"Enable entire\")\n\n\t\t// Inject OPF settings into the test repo.\n\t\ttestutil.PatchSettings(t, s.Dir, map[string]any{\n\t\t\t\"redaction\": map[string]any{\n\t\t\t\t\"openai_privacy_filter\": map[string]any{\n\t\t\t\t\t\"enabled\":         true,\n\t\t\t\t\t\"categories\":      map[string]any{\"private_person\": true},\n\t\t\t\t\t\"command\":         \"opf\",\n\t\t\t\t\t\"timeout_seconds\": 120,\n\t\t\t\t\t\"on_failure\":      \"warn\",\n\t\t\t\t},\n\t\t\t},\n\t\t})\n\n\t\ts.Git(t, \"checkout\", \"-b\", \"feature\")\n\n\t\t// Drive Vogon with a prompt that puts \"Alice Smith\" into the transcript.\n\t\tprompt := \"create a file at greeting.txt with content 'Hello from Alice Smith, who lives in San Francisco'\"\n\t\t_, err := s.RunPrompt(t, ctx, prompt)\n\t\trequire.NoError(t, err, \"agent failed\")\n\n\t\t// Commit triggers condensation — OPF should fire.\n\t\ts.Git(t, \"add\", \".\")\n\t\ts.Git(t, \"commit\", \"-m\", \"test OPF condensation\")\n\t\ttestutil.WaitForCheckpoint(t, s, 30*time.Second)\n\n\t\tcheckpointID := testutil.AssertHasCheckpointTrailer(t, s.Dir, \"HEAD\")\n\t\tt.Logf(\"checkpoint id: %s\", checkpointID)\n\n\t\t// Read back the condensed transcript via `entire explain`.\n\t\tout := entire.Explain(t, s.Dir, checkpointID)\n\t\tt.Logf(\"=== explain output ===\\n%s\\n=== end explain ===\", out)\n\n\t\t// The literal name should be gone, replaced with the OPF token.\n\t\tif strings.Contains(out, \"Alice Smith\") {\n\t\t\tt.Errorf(\"FAIL: 'Alice Smith' was NOT redacted in condensed transcript\")\n\t\t}\n\t\tassert.Contains(t, out, \"REDACTED_PERSON\", \"want OPF to redact Alice Smith to [REDACTED_PERSON]\")\n\t})\n}\n","userModified":false},"sourceToolAssistantUUID":"614dde8d-19a2-4bb7-9c6b-09001da00749","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact","sessionId":"fb93c4d8-9548-4a4c-97e6-364245c50453","version":"2.1.140","gitBranch":"feat/openai-privacy-filter"}
