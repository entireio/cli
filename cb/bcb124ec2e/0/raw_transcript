ring())\n135\t\t\tif errMsg == \"\" {\n136\t\t\t\treturn nil, fmt.Errorf(\"opf exited with error: %w\", err)\n137\t\t\t}\n138\t\t\treturn nil, fmt.Errorf(\"opf exited with error: %s: %w\", errMsg, err)\n139\t\t}\n140\t\n141\t\t// Single concatenated input → opf emits one JSON object.\n142\t\tvar parsed opfOutput\n143\t\tif err := json.Unmarshal(stdout.Bytes(), &parsed); err != nil {\n144\t\t\treturn nil, fmt.Errorf(\"opf output not parseable as JSON: %w (stdout: %q)\", err, stdout.String())\n145\t\t}\n146\t\n147\t\t// OPF returns character offsets (Python str slicing), not byte\n148\t\t// offsets. For ASCII-only text the two agree; for multi-byte UTF-8\n149\t\t// (e.g. box-drawing characters in Claude Code's `★ Insight ─────`\n150\t\t// formatting) they diverge by N bytes per multi-byte char ahead of\n151\t\t// the span. We must translate char→byte before partitioning, since\n152\t\t// `starts` is byte-indexed (built from buf.Len()) and applyRegions\n153\t\t// in the redact package also slices by byte.\n154\t\tout := make([][]Span, len(inputs))\n155\t\tfor _, p := range parsed.DetectedSpans {\n156\t\t\tbyteStart := charToByteOffset(batched, p.Start)\n157\t\t\tbyteEnd := charToByteOffset(batched, p.End)\n158\t\t\tif byteStart < 0 || byteEnd < 0 {\n159\t\t\t\tcontinue // offset out of range — drop\n160\t\t\t}\n161\t\t\tidx := partitionIndex(starts, byteStart, byteEnd, batchSeparator)\n162\t\t\tif idx < 0 {\n163\t\t\t\tcontinue // span crosses a separator boundary — drop it\n164\t\t\t}\n165\t\t\tbase := starts[idx]\n166\t\t\tout[idx] = append(out[idx], Span{\n167\t\t\t\tStart: byteStart - base,\n168\t\t\t\tEnd:   byteEnd - base,\n169\t\t\t\tLabel: p.Label,\n170\t\t\t})\n171\t\t}\n172\t\treturn out, nil\n173\t}\n174\t\n175\t// charToByteOffset converts a 0-based character (rune) offset into a byte\n176\t// offset within s. Returns -1 if charOff is past the end of s. For\n177\t// charOff == 0 this returns 0; for charOff equal to the number of runes\n178\t// in s, this returns len(s) (the end-of-string position).\n179\tfunc charToByteOffset(s string, charOff int) int {\n180\t\tif charOff < 0 {\n181\t\t\treturn -1\n182\t\t}\n183\t\tif charOff == 0 {\n184\t\t\treturn 0\n185\t\t}\n186\t\tbyteOff := 0\n187\t\tfor i := range charOff {\n188\t\t\tif byteOff >= len(s) {\n189\t\t\t\tif i == charOff-1 && byteOff == len(s) {\n190\t\t\t\t\treturn byteOff\n191\t\t\t\t}\n192\t\t\t\treturn -1\n193\t\t\t}\n194\t\t\t_, size := utf8.DecodeRuneInString(s[byteOff:])\n195\t\t\tbyteOff += size\n196\t\t}\n197\t\treturn byteOff\n198\t}\n199\t\n200\t// partitionIndex returns the input index that contains the [spanStart, spanEnd)\n201\t// region within the concatenated batch input, or -1 if the region crosses\n202\t// a separator boundary or is outside any input.\n203\t//\n204\t// starts[i] is the byte offset where inputs[i] begins in the concatenation.\n205\t// Each input ends at starts[i+1] - len(sep) (the separator follows it), or\n206\t// at the end of the batched string for the last input.\n207\tfunc partitionIndex(starts []int, spanStart, spanEnd int, sep string) int {\n\n... [26 lines truncated] ..."},"type":"attachment","uuid":"61ec6694-b6a5-4f33-97c0-28cf237c863b","timestamp":"2026-05-14T17:42:44.106Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact","sessionId":"fb93c4d8-9548-4a4c-97e6-364245c50453","version":"2.1.140","gitBranch":"feat/openai-privacy-filter"}
