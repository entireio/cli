{"parentUuid":"46030104-9f44-4ca4-8840-b3dac5042db4","isSidechain":false,"promptId":"05c5909c-6394-4968-bc08-aac55753d9e2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019uTDedTzauN239UD5KNktB","type":"tool_result","content":"1\tpackage redact\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"math\"\n9\t\t\"net/url\"\n10\t\t\"regexp\"\n11\t\t\"sort\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\n15\t\t\"github.com/betterleaks/betterleaks/detect\"\n16\t)\n17\t\n18\t// secretPattern matches high-entropy strings that may be secrets.\n19\t// Note: / is excluded to prevent matching entire file paths as single tokens.\n20\t// Base64 and JWT tokens are still caught via high-entropy segments between slashes.\n21\tvar secretPattern = regexp.MustCompile(`[A-Za-z0-9+_=-]{10,}`)\n22\t\n23\t// credentialedURIPattern matches URLs that embed userinfo with a password, such\n24\t// as REDACTED or REDACTED These often have\n25\t// moderate entropy and are not reliably covered by vendor-specific scanners.\n26\tvar credentialedURIPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9+.-]{1,31}://[^\\s/?#@\"'` + \"`\" + `<>:]*:[^\\s/?#@\"'` + \"`\" + `<>]+@[^\\s\"'` + \"`\" + `<>]+`)\n27\t\n28\t// dbPasswordKeyShape matches a DB-prefixed credential key (vendor prefix +\n29\t// optional `_word`/`-word` segments + `password`/`passwd`/`pwd`). Used to\n30\t// compose both the env-var assignment regex and the JSON-key regex so the\n31\t// vendor list stays in one place.\n32\tconst dbPasswordKeyShape = `(?:db|database|pg|postgres|postgresql|mysql|mariadb|redis|mongo|mongodb|sqlserver|mssql|jdbc)(?:[_-]+[a-z0-9]+)*[_-]*(?:password|passwd|pwd)` //nolint:gosec // regex literal, not a credential\n33\t\n34\tvar (\n35\t\tjdbcPattern          = regexp.MustCompile(`(?i)\\bjdbc:[^\\s\"'<>` + \"`\" + `]+`)\n36\t\tdatabaseURLPattern   = regexp.MustCompile(`(?i)\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis)://[^\\s\"'<>` + \"`\" + `]+`)\n37\t\tkeywordDSNPattern    = regexp.MustCompile(`(?i)\\b[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)(?:\\s+[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)){2,}`)\n38\t\tsemicolonConnPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)(?:;[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)){2,}`)\n39\t\t// credentialValuePattern requires the prefix to start at a non-alphanumeric\n40\t\t// boundary, so APP_DB_PASSWORD matches via the leading `_` but mydbpassword\n41\t\t// does not.\n42\t\tcredentialValuePattern = regexp.MustCompile(`(?i)(?:^|[^A-Za-z0-9])(` + dbPasswordKeyShape + `)\\s*=\\s*(\"[^\"]*\"|'[^']*'|[^\\s,;&]+)`)\n43\t\n44\t\tkeywordHostPattern      = regexp.MustCompile(`(?i)(?:^|\\s)host=`)\n45\t\tkeywordUserPattern      = regexp.MustCompile(`(?i)(?:^|\\s)user=`)\n46\t\tsemicolonServerPattern  = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:server|data source|datasource|addr|address|network address)\\s*=`)\n47\t\tsemicolonUserPattern    = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:user id|userid|user|uid)\\s*=`)\n48\t\tpasswordAssignmentRegex = regexp.MustCompile(`(?i)(?:^|[?&;\\s])(?:password|pwd)=(\"[^\"]*\"|'[^']*'|[^&;\\s\"']+)`)\n49\t\t// credentialJSONKeyRegex operates on output of normalizeCredentialJSONKey\n50\t\t// (already lowercased, `-`/` `/`.` → `_`), so the `(?i)` flag is unnecessary.\n51\t\tcredentialJSONKeyRegex  = regexp.MustCompile(`^` + dbPasswordKeyShape + `$`)\n52\t\tgenericPasswordKeyRegex = regexp.MustCompile(`(?i)^(?:password|passwd|pwd)$`)\n53\t)\n54\t\n55\t// entropyThreshold is the minimum Shannon entropy for a string to be considered\n56\t// a secret. 4.5 was chosen through trial and error: high enough to avoid false\n57\t// positives on common words and identifiers, low enough to catch typical API keys\n58\t// and tokens which tend to have entropy well above 5.0.\n59\tconst entropyThreshold = 4.5\n60\t\n61\t// RedactedPlaceholder is the replacement text used for redacted secrets.\n62\tconst RedactedPlaceholder = \"REDACTED\"\n63\t\n64\t// placeholderSecretValues lists lowercase values that should be treated as\n65\t// non-secrets when they appear as a credential value: prior redactions\n66\t// (REDACTED / [REDACTED] / <REDACTED>), common documentation placeholders,\n67\t// and obviously-non-real defaults. Values matched by shape (mask runs,\n68\t// `<…>` brackets, `${…}` shell expansion) are handled separately.\n69\tvar placeholderSecretValues = func() map[string]struct{} {\n70\t\tlower := strings.ToLower(RedactedPlaceholder)\n71\t\tvalues := []string{\n72\t\t\tlower, \"[\" + lower + \"]\", \"<\" + lower + \">\",\n73\t\t\t\"changeme\", \"example\", \"placeholder\",\n74\t\t\t\"your_password\", \"your_db_password\", \"your_secret\",\n75\t\t\t\"secret_here\",\n76\t\t}\n77\t\tout := make(map[string]struct{}, len(values))\n78\t\tfor _, v := range values {\n79\t\t\tout[v] = struct{}{}\n80\t\t}\n81\t\treturn out\n82\t}()\n83\t\n84\t// RedactedBytes represents transcript data that has been through secret\n85\t// redaction. Consumers that require pre-redacted input (e.g., compact.Compact,\n86\t// checkpoint stores) accept this type to enforce the contract at compile time.\n87\t//\n88\t// Produced by JSONLBytes (primary constructor) or trusted wrappers for data\n89\t// previously persisted by checkpoint writers.\n90\ttype RedactedBytes struct {\n91\t\tdata []byte\n92\t}\n93\t\n94\t// Bytes returns the underlying byte slice.\n95\tfunc (r RedactedBytes) Bytes() []byte {\n96\t\treturn r.data\n97\t}\n98\t\n99\t// Len returns the number of bytes in the redacted payload.\n100\tfunc (r RedactedBytes) Len() int {\n101\t\treturn len(r.data)\n102\t}\n103\t\n104\t// AlreadyRedacted wraps transcript bytes known to already be redacted by a\n105\t// prior write path. Use this ONLY for trusted sources such as persisted\n106\t// checkpoint transcripts or controlled test fixtures. For fresh transcript\n107\t// input, use JSONLBytes.\n108\tfunc AlreadyRedacted(data []byte) RedactedBytes {\n109\t\treturn RedactedBytes{data: data}\n110\t}\n111\t\n112\tvar (\n113\t\tbetterleaksDetector     *detect.Detector\n114\t\tbetterleaksDetectorOnce sync.Once\n115\t)\n116\t\n117\tfunc getDetector() *detect.Detector {\n118\t\tbetterleaksDetectorOnce.Do(func() {\n119\t\t\td, err := detect.NewDetectorDefaultConfig()\n120\t\t\tif err != nil {\n121\t\t\t\treturn\n122\t\t\t}\n123\t\t\tbetterleaksDetector = d\n124\t\t})\n125\t\treturn betterleaksDetector\n126\t}\n127\t\n128\t// region represents a byte range to redact.\n129\ttype region struct{ start, end int }\n130\t\n131\t// taggedRegion extends region with a label for typed replacement tokens.\n132\t// Empty label = secret (produces \"REDACTED\"). Non-empty = PII (produces \"[REDACTED_<LABEL>]\").\n133\ttype taggedRegion struct {\n134\t\tregion\n135\t\n136\t\tlabel string\n137\t}\n138\t\n139\ttype jsonReplacement struct {\n140\t\tkey      string\n141\t\toriginal string\n142\t\tredacted string\n143\t}\n144\t\n145\ttype connectionStringRule struct {\n146\t\tpattern   *regexp.Regexp\n147\t\thasSecret func(string) bool\n148\t}\n149\t\n150\tvar connectionStringRules = []connectionStringRule{\n151\t\t{pattern: jdbcPattern, hasSecret: hasJDBCPassword},\n152\t\t{pattern: databaseURLPattern, hasSecret: hasDatabaseURLSecret},\n153\t\t{pattern: keywordDSNPattern, hasSecret: hasKeywordDSNPassword},\n154\t\t{pattern: semicolonConnPattern, hasSecret: hasSemicolonConnectionPassword},\n155\t}\n156\t\n157\t// String replaces secrets and PII in s using layered detection:\n158\t// 1. Entropy-based: high-entropy alphanumeric sequences (threshold 4.5)\n159\t// 2. Pattern-based: betterleaks regex rules (260+ known secret formats)\n160\t// 3. Credentialed URIs: URLs containing userinfo passwords\n161\t// 4. Database connection strings: JDBC, keyword DSNs, and semicolon strings\n162\t// 5. User-defined custom rules: configured via ConfigureCustomRules\n163\t// 6. Bounded credential key/value pairs: DB_PASSWORD=...\n164\t// 7. PII detection: email, phone, address patterns (only when configured via ConfigurePII)\n165\t// A string is redacted if ANY method flags it.\n166\tfunc String(s string) string {\n167\t\tvar regions []taggedRegion\n168\t\n169\t\t// 1. Entropy-based detection (secrets — always on).\n170\t\tfor _, loc := range secretPattern.FindAllStringIndex(s, -1) {\n171\t\t\tstart, end := loc[0], loc[1]\n172\t\n173\t\t\t// Don't consume characters that are part of JSON/string escape sequences.\n174\t\t\t// Example: in \"controller.go\\nmodel.go\", the regex could match \"nmodel\"\n175\t\t\t// (consuming the 'n' from '\\n'), and after replacement the '\\' would be\n176\t\t\t// followed by 'R' from \"REDACTED\", creating invalid escape '\\R'.\n177\t\t\t// Only skip for known JSON escape letters to avoid trimming real secrets\n178\t\t\t// that happen to follow a literal backslash in decoded content.\n179\t\t\tif start > 0 && s[start-1] == '\\\\' {\n180\t\t\t\tswitch s[start] {\n181\t\t\t\tcase 'n', 't', 'r', 'b', 'f', 'u', '\"', '\\\\', '/':\n182\t\t\t\t\tstart++\n183\t\t\t\t\tif end-start < 10 {\n184\t\t\t\t\t\tcontinue\n185\t\t\t\t\t}\n186\t\t\t\t}\n187\t\t\t}\n188\t\n189\t\t\tif shannonEntropy(s[start:end]) > entropyThreshold {\n190\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n191\t\t\t}\n192\t\t}\n193\t\n194\t\t// 2. Pattern-based detection via betterleaks (secrets — always on).\n195\t\tif d := getDetector(); d != nil {\n196\t\t\tfor _, f := range d.DetectString(s) {\n197\t\t\t\tif f.Secret == \"\" {\n198\t\t\t\t\tcontinue\n199\t\t\t\t}\n200\t\t\t\tsearchFrom := 0\n201\t\t\t\tfor {\n202\t\t\t\t\tidx := strings.Index(s[searchFrom:], f.Secret)\n203\t\t\t\t\tif idx < 0 {\n204\t\t\t\t\t\tbreak\n205\t\t\t\t\t}\n206\t\t\t\t\tabsIdx := searchFrom + idx\n207\t\t\t\t\tregions = append(regions, taggedRegion{region: region{absIdx, absIdx + len(f.Secret)}})\n208\t\t\t\t\tsearchFrom = absIdx + len(f.Secret)\n209\t\t\t\t}\n210\t\t\t}\n211\t\t}\n212\t\n213\t\t// 3. Credentialed URIs (secrets — always on).\n214\t\tfor _, loc := range credentialedURIPattern.FindAllStringIndex(s, -1) {\n215\t\t\tregions = append(regions, taggedRegion{region: region{loc[0], loc[1]}})\n216\t\t}\n217\t\n218\t\t// 4. Database and connection-string detection (secrets — always on).\n219\t\tregions = append(regions, detectConnectionStrings(s)...)\n220\t\n221\t\t// 5. User-defined custom rules (secrets — only runs when configured).\n222\t\tregions = append(regions, detectCustomRules(getCustomRulesConfig(), s)...)\n223\t\n224\t\t// 6. Bounded credential key/value detection (secrets — always on).\n225\t\tregions = append(regions, detectCredentialValues(s)...)\n226\t\n227\t\t// 7. PII detection (opt-in — only runs when configured).\n228\t\tregions = append(regions, detectPII(getPIIConfig(), s)...)\n229\t\n230\t\tif len(regions) == 0 {\n231\t\t\treturn s\n232\t\t}\n233\t\n234\t\t// Merge overlapping regions and build result.\n235\t\tsort.Slice(regions, func(i, j int) bool {\n236\t\t\tif regions[i].start != regions[j].start {\n237\t\t\t\treturn regions[i].start < regions[j].start\n238\t\t\t}\n239\t\t\tif regions[i].end != regions[j].end {\n240\t\t\t\treturn regions[i].end > regions[j].end // larger region first\n241\t\t\t}\n242\t\t\treturn regions[i].label < regions[j].label // deterministic tie-break\n243\t\t})\n244\t\tmerged := []taggedRegion{regions[0]}\n245\t\tfor _, r := range regions[1:] {\n246\t\t\tlast := &merged[len(merged)-1]\n247\t\t\tif r.start <= last.end {\n248\t\t\t\tif r.end > last.end {\n249\t\t\t\t\tlast.end = r.end\n250\t\t\t\t}\n251\t\t\t\t// Keep the existing label (first/larger region wins)\n252\t\t\t} else {\n253\t\t\t\tmerged = append(merged, r)\n254\t\t\t}\n255\t\t}\n256\t\n257\t\tvar b strings.Builder\n258\t\tprev := 0\n259\t\tfor _, r := range merged {\n260\t\t\tb.WriteString(s[prev:r.start])\n261\t\t\tb.WriteString(replacementToken(r.label))\n262\t\t\tprev = r.end\n263\t\t}\n264\t\tb.WriteString(s[prev:])\n265\t\treturn b.String()\n266\t}\n267\t\n268\tfunc detectConnectionStrings(s string) []taggedRegion {\n269\t\tif !strings.ContainsRune(s, '=') {\n270\t\t\treturn nil\n271\t\t}\n272\t\tvar regions []taggedRegion\n273\t\tfor _, rule := range connectionStringRules {\n274\t\t\tregions = append(regions, detectConnectionStringRule(s, rule)...)\n275\t\t}\n276\t\treturn regions\n277\t}\n278\t\n279\tfunc detectConnectionStringRule(s string, rule connectionStringRule) []taggedRegion {\n280\t\tvar regions []taggedRegion\n281\t\tfor _, loc := range rule.pattern.FindAllStringIndex(s, -1) {\n282\t\t\tstart, end := loc[0], trimConnectionStringEnd(s, loc[0], loc[1])\n283\t\t\tif start >= end {\n284\t\t\t\tcontinue\n285\t\t\t}\n286\t\t\tif rule.hasSecret(s[start:end]) {\n287\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n288\t\t\t}\n289\t\t}\n290\t\treturn regions\n291\t}\n292\t\n293\tfunc trimConnectionStringEnd(s string, start, end int) int {\n294\t\tfor end > start {\n295\t\t\tswitch s[end-1] {\n296\t\t\tcase '.', ',', ';', ':', '!', '?', ')', ']':\n297\t\t\t\tend--\n298\t\t\tdefault:\n299\t\t\t\treturn end\n300\t\t\t}\n301\t\t}\n302\t\treturn end\n303\t}\n304\t\n305\tfunc hasJDBCPassword(candidate string) bool {\n306\t\tif !strings.HasPrefix(strings.ToLower(candidate), \"jdbc:\") {\n307\t\t\treturn false\n308\t\t}\n309\t\treturn hasNonPlaceholderPasswordAssignment(candidate)\n310\t}\n311\t\n312\tfunc hasDatabaseURLSecret(candidate string) bool {\n313\t\tu, err := url.Parse(candidate)\n314\t\tif err != nil || u.Scheme == \"\" || u.Host == \"\" {\n315\t\t\treturn false\n316\t\t}\n317\t\tfor key, values := range u.Query() {\n318\t\t\tif !isPasswordQueryKey(key) {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tfor _, value := range values {\n322\t\t\t\tif hasNonPlaceholderPasswordValue(value) {\n323\t\t\t\t\treturn true\n324\t\t\t\t}\n325\t\t\t}\n326\t\t}\n327\t\treturn false\n328\t}\n329\t\n330\tfunc isPasswordQueryKey(key string) bool {\n331\t\treturn strings.EqualFold(key, \"password\") || strings.EqualFold(key, \"pwd\")\n332\t}\n333\t\n334\tfunc hasKeywordDSNPassword(candidate string) bool {\n335\t\treturn keywordHostPattern.MatchString(candidate) &&\n336\t\t\tkeywordUserPattern.MatchString(candidate) &&\n337\t\t\thasNonPlaceholderPasswordAssignment(candidate)\n338\t}\n339\t\n340\tfunc hasSemicolonConnectionPassword(candidate string) bool {\n341\t\treturn semicolonServerPattern.MatchString(candidate) &&\n342\t\t\tsemicolonUserPattern.MatchString(candidate) &&\n343\t\t\thasNonPlaceholderPasswordAssignment(candidate)\n344\t}\n345\t\n346\tfunc detectCredentialValues(s string) []taggedRegion {\n347\t\tvar regions []taggedRegion\n348\t\tfor _, loc := range credentialValuePattern.FindAllStringSubmatchIndex(s, -1) {\n349\t\t\tif len(loc) < 6 || loc[4] < 0 || loc[5] < 0 {\n350\t\t\t\tcontinue\n351\t\t\t}\n352\t\t\tstart, end := unquoteRange(s, loc[4], loc[5])\n353\t\t\tif hasNonPlaceholderPasswordValue(s[start:end]) {\n354\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n355\t\t\t}\n356\t\t}\n357\t\treturn regions\n358\t}\n359\t\n360\tfunc unquoteRange(s string, start, end int) (int, int) {\n361\t\tif end-start < 2 {\n362\t\t\treturn start, end\n363\t\t}\n364\t\tfirst, last := s[start], s[end-1]\n365\t\tif (first == '\"' && last == '\"') || (first == '\\'' && last == '\\'') {\n366\t\t\treturn start + 1, end - 1\n367\t\t}\n368\t\treturn start, end\n369\t}\n370\t\n371\tfunc hasNonPlaceholderPasswordAssignment(candidate string) bool {\n372\t\tfor _, loc := range passwordAssignmentRegex.FindAllStringSubmatchIndex(candidate, -1) {\n373\t\t\tif len(loc) >= 4 && loc[2] >= 0 && loc[3] >= 0 {\n374\t\t\t\tstart, end := unquoteRange(candidate, loc[2], loc[3])\n375\t\t\t\tif hasNonPlaceholderPasswordValue(candidate[start:end]) {\n376\t\t\t\t\treturn true\n377\t\t\t\t}\n378\t\t\t}\n379\t\t}\n380\t\treturn false\n381\t}\n382\t\n383\tfunc hasNonPlaceholderPasswordValue(value string) bool {\n384\t\treturn value != \"\" && !isPlaceholderSecretValue(value)\n385\t}\n386\t\n387\tfunc isPlaceholderSecretValue(value string) bool {\n388\t\ttrimmed := strings.Trim(strings.TrimSpace(value), `\"'`)\n389\t\tif trimmed == \"\" {\n390\t\t\treturn true\n391\t\t}\n392\t\tif isBracketedPlaceholder(trimmed) {\n393\t\t\treturn true\n394\t\t}\n395\t\tnormalized := strings.ToLower(trimmed)\n396\t\tif strings.HasPrefix(normalized, \"${\") && strings.HasSuffix(normalized, \"}\") {\n397\t\t\treturn true\n398\t\t}\n399\t\tif _, ok := placeholderSecretValues[normalized]; ok {\n400\t\t\treturn true\n401\t\t}\n402\t\treturn isRepeatedCharPlaceholder(normalized)\n403\t}\n404\t\n405\t// bracketedPlaceholderInteriorRE matches the inside of a \"<…>\" placeholder\n406\t// shape: lowercase letters joined by `-` or `_`. Digits, mixed case, and\n407\t// special chars are rejected so values like `<hunter2>` or `<RealPassword>`\n408\t// still fall through to redaction.\n409\tvar bracketedPlaceholderInteriorRE = regexp.MustCompile(`^[a-z][a-z_-]*$`)\n410\t\n411\t// isBracketedPlaceholder reports whether s is a \"<name>\" doc placeholder\n412\t// (e.g. \"<password>\", \"<your-db-password>\"). The minimum total length of 5\n413\t// keeps this from firing on `<a>` / `<ab>`.\n414\tfunc isBracketedPlaceholder(s string) bool {\n415\t\tif len(s) < 5 || s[0] != '<' || s[len(s)-1] != '>' {\n416\t\t\treturn false\n417\t\t}\n418\t\treturn bracketedPlaceholderInteriorRE.MatchString(s[1 : len(s)-1])\n419\t}\n420\t\n421\t// isRepeatedCharPlaceholder reports whether s is a run of a single masking\n422\t// character commonly used to redact values in docs and screenshots, e.g.\n423\t// \"***\", \"xxxx\", \"....\", \"----\". The minimum length of 3 keeps single-char\n424\t// or 2-char values like `x` or `**` from being treated as masks.\n425\tfunc isRepeatedCharPlaceholder(s string) bool {\n426\t\tif len(s) < 3 {\n427\t\t\treturn false\n428\t\t}\n429\t\tfirst := s[0]\n430\t\tswitch first {\n431\t\tcase '*', 'x', '.', '-':\n432\t\tdefault:\n433\t\t\treturn false\n434\t\t}\n435\t\tfor i := 1; i < len(s); i++ {\n436\t\t\tif s[i] != first {\n437\t\t\t\treturn false\n438\t\t\t}\n439\t\t}\n440\t\treturn true\n441\t}\n442\t\n443\tfunc isCredentialJSONSecretKey(key string, credentialContext bool) bool {\n444\t\tnormalized := normalizeCredentialJSONKey(key)\n445\t\tif credentialJSONKeyRegex.MatchString(normalized) {\n446\t\t\treturn true\n447\t\t}\n448\t\treturn credentialContext && genericPasswordKeyRegex.MatchString(normalized)\n449\t}\n450\t\n451\tfunc isCredentialJSONObject(obj map[string]any) bool {\n452\t\tvar hasHost, hasUser bool\n453\t\tfor key := range obj {\n454\t\t\tswitch normalizeCredentialJSONKey(key) {\n455\t\t\tcase \"host\", \"hostname\", \"server\", \"addr\", \"address\", \"datasource\", \"data_source\":\n456\t\t\t\thasHost = true\n457\t\t\tcase \"user\", \"username\", \"userid\", \"user_id\", \"uid\":\n458\t\t\t\thasUser = true\n459\t\t\t}\n460\t\t\tif hasHost && hasUser {\n461\t\t\t\treturn true\n462\t\t\t}\n463\t\t}\n464\t\treturn false\n465\t}\n466\t\n467\tfunc normalizeCredentialJSONKey(key string) string {\n468\t\tkey = strings.ToLower(strings.TrimSpace(key))\n469\t\tkey = strings.ReplaceAll(key, \"-\", \"_\")\n470\t\tkey = strings.ReplaceAll(key, \" \", \"_\")\n471\t\t// Flattened-config exporters (Spring, dotnet, Hashicorp Vault) emit dotted keys\n472\t\t// like \"db.password\" or \"mysql.root.password\"; treat them like underscored.\n473\t\tkey = strings.ReplaceAll(key, \".\", \"_\")\n474\t\treturn key\n475\t}\n476\t\n477\t// Bytes is a convenience wrapper around String for []byte content.\n478\tfunc Bytes(b []byte) []byte {\n479\t\ts := string(b)\n480\t\tredacted := String(s)\n481\t\tif redacted == s {\n482\t\t\treturn b\n483\t\t}\n484\t\treturn []byte(redacted)\n485\t}\n486\t\n487\t// JSONLBytes redacts secrets in JSONL-formatted byte content and returns\n488\t// the result as RedactedBytes, certifying the output has been through redaction.\n489\tfunc JSONLBytes(b []byte) (RedactedBytes, error) {\n490\t\ts := string(b)\n491\t\tredacted, err := JSONLContent(s)\n492\t\tif err != nil {\n493\t\t\treturn RedactedBytes{}, err\n494\t\t}\n495\t\tif redacted == s {\n496\t\t\treturn RedactedBytes{data: b}, nil\n497\t\t}\n498\t\treturn RedactedBytes{data: []byte(redacted)}, nil\n499\t}\n500\t\n501\t// JSONLContent parses each line as JSON to determine which string values\n502\t// need redaction, then performs targeted replacements on the raw JSON bytes.\n503\t// Lines with no secrets are returned unchanged, preserving original formatting.\n504\t//\n505\t// For multi-line JSON content (e.g., pretty-printed single JSON objects like\n506\t// OpenCode export), the function first attempts to parse the entire content as\n507\t// a single JSON value. This ensures field-aware redaction (which skips ID fields)\n508\t// is used instead of falling back to entropy-based detection on raw text lines,\n509\t// which would corrupt high-entropy identifiers.\n510\tfunc JSONLContent(content string) (string, error) {\n511\t\t// Try parsing the entire content as a single JSON value first.\n512\t\t// Uses a streaming decoder to avoid copying the full content into []byte.\n513\t\t// After decoding, attempts a second Decode to confirm EOF — if it succeeds,\n514\t\t// the content is JSONL (multiple values) and we fall through to line-by-line.\n515\t\ttrimmed := strings.TrimSpace(content)\n516\t\tif len(trimmed) > 0 {\n517\t\t\tdec := json.NewDecoder(strings.NewReader(trimmed))\n518\t\t\tvar parsed any\n519\t\t\tif err := dec.Decode(&parsed); err == nil && isSingleJSONValue(dec) {\n520\t\t\t\t// Content is a single JSON value (object/array) — redact field-aware.\n521\t\t\t\tresult, err := applyJSONReplacements(content, collectJSONLReplacements(parsed))\n522\t\t\t\tif err != nil {\n523\t\t\t\t\treturn \"\", err\n524\t\t\t\t}\n525\t\t\t\treturn result, nil\n526\t\t\t}\n527\t\t}\n528\t\n529\t\t// Fall back to line-by-line JSONL processing.\n530\t\tlines := strings.Split(content, \"\\n\")\n531\t\tvar b strings.Builder\n532\t\tfor i, line := range lines {\n533\t\t\tif i > 0 {\n534\t\t\t\tb.WriteByte('\\n')\n535\t\t\t}\n536\t\t\tlineTrimmed := strings.TrimSpace(line)\n537\t\t\tif lineTrimmed == \"\" {\n538\t\t\t\tb.WriteString(line)\n539\t\t\t\tcontinue\n540\t\t\t}\n541\t\t\tvar parsed any\n542\t\t\tif err := json.Unmarshal([]byte(lineTrimmed), &parsed); err != nil {\n543\t\t\t\tb.WriteString(String(line))\n544\t\t\t\tcontinue\n545\t\t\t}\n546\t\t\tresult, err := applyJSONReplacements(line, collectJSONLReplacements(parsed))\n547\t\t\tif err != nil {\n548\t\t\t\treturn \"\", err\n549\t\t\t}\n550\t\t\tb.WriteString(result)\n551\t\t}\n552\t\treturn b.String(), nil\n553\t}\n554\t\n555\t// applyJSONReplacements applies collected (original, redacted) string pairs\n556\t// to the raw JSON text, replacing JSON-encoded originals with their redacted forms.\n557\t// Returns s unchanged if repls is empty.\n558\tfunc applyJSONReplacements(s string, repls []jsonReplacement) (string, error) {\n559\t\tif len(repls) == 0 {\n560\t\t\treturn s, nil\n561\t\t}\n562\t\tfor _, r := range repls {\n563\t\t\torigJSON, err := jsonEncodeString(r.original)\n564\t\t\tif err != nil {\n565\t\t\t\treturn \"\", err\n566\t\t\t}\n567\t\t\treplJSON, err := jsonEncodeString(r.redacted)\n568\t\t\tif err != nil {\n569\t\t\t\treturn \"\", err\n570\t\t\t}\n571\t\t\tif r.key == \"\" {\n572\t\t\t\ts = strings.ReplaceAll(s, origJSON, replJSON)\n573\t\t\t\tcontinue\n574\t\t\t}\n575\t\t\tkeyJSON, err := jsonEncodeString(r.key)\n576\t\t\tif err != nil {\n577\t\t\t\treturn \"\", err\n578\t\t\t}\n579\t\t\ts = replaceKeyedJSONValue(s, keyJSON, origJSON, replJSON)\n580\t\t}\n581\t\treturn s, nil\n582\t}\n583\t\n584\t// replaceKeyedJSONValue replaces every occurrence of origJSON that follows\n585\t// keyJSON + optional whitespace + ':' + optional whitespace. Restricts\n586\t// substitution to value positions so a key's own redacted text is not\n587\t// rewritten when it collides with another field's value.\n588\tfunc replaceKeyedJSONValue(s, keyJSON, origJSON, replJSON string) string {\n589\t\tif !strings.Contains(s, keyJSON) {\n590\t\t\treturn s\n591\t\t}\n592\t\tvar b strings.Builder\n593\t\tb.Grow(len(s))\n594\t\ti := 0\n595\t\tfor i < len(s) {\n596\t\t\tj := strings.Index(s[i:], keyJSON)\n597\t\t\tif j < 0 {\n598\t\t\t\tb.WriteString(s[i:])\n599\t\t\t\tbreak\n600\t\t\t}\n601\t\t\tkeyEnd := i + j + len(keyJSON)\n602\t\t\tb.WriteString(s[i : i+j])\n603\t\t\tb.WriteString(keyJSON)\n604\t\t\tp := keyEnd\n605\t\t\tfor p < len(s) && isJSONWhitespace(s[p]) {\n606\t\t\t\tp++\n607\t\t\t}\n608\t\t\tif p >= len(s) || s[p] != ':' {\n609\t\t\t\ti = keyEnd\n610\t\t\t\tcontinue\n611\t\t\t}\n612\t\t\tp++\n613\t\t\tfor p < len(s) && isJSONWhitespace(s[p]) {\n614\t\t\t\tp++\n615\t\t\t}\n616\t\t\tif p+len(origJSON) <= len(s) && s[p:p+len(origJSON)] == origJSON {\n617\t\t\t\tb.WriteString(s[keyEnd:p])\n618\t\t\t\tb.WriteString(replJSON)\n619\t\t\t\ti = p + len(origJSON)\n620\t\t\t\tcontinue\n621\t\t\t}\n622\t\t\ti = keyEnd\n623\t\t}\n624\t\treturn b.String()\n625\t}\n626\t\n627\tfunc isJSONWhitespace(c byte) bool {\n628\t\treturn c == ' ' || c == '\\t' || c == '\\n' || c == '\\r'\n629\t}\n630\t\n631\t// isSingleJSONValue returns true if the decoder has reached EOF (no more\n632\t// top-level values). This distinguishes a single JSON value (e.g., pretty-printed\n633\t// object) from JSONL (multiple concatenated values). We attempt a second Decode\n634\t// and require io.EOF rather than relying on dec.More(), which is documented for\n635\t// use inside arrays/objects and not for top-level value boundaries.\n636\tfunc isSingleJSONValue(dec *json.Decoder) bool {\n637\t\tvar discard json.RawMessage\n638\t\treturn dec.Decode(&discard) == io.EOF\n639\t}\n640\t\n641\t// collectJSONLReplacements walks a parsed JSON value and collects unique string\n642\t// replacements for values that need redaction.\n643\tfunc collectJSONLReplacements(v any) []jsonReplacement {\n644\t\tseen := make(map[string]bool)\n645\t\tvar repls []jsonReplacement\n646\t\tvar walk func(key string, credentialContext bool, v any)\n647\t\twalk = func(key string, credentialContext bool, v any) {\n648\t\t\tswitch val := v.(type) {\n649\t\t\tcase map[string]any:\n650\t\t\t\tif shouldSkipJSONLObject(val) {\n651\t\t\t\t\treturn\n652\t\t\t\t}\n653\t\t\t\tchildCredentialContext := credentialContext || isCredentialJSONObject(val)\n654\t\t\t\tfor k, child := range val {\n655\t\t\t\t\tif shouldSkipJSONLField(k) {\n656\t\t\t\t\t\tcontinue\n657\t\t\t\t\t}\n658\t\t\t\t\twalk(k, childCredentialContext, child)\n659\t\t\t\t}\n660\t\t\tcase []any:\n661\t\t\t\tfor _, child := range val {\n662\t\t\t\t\twalk(\"\", credentialContext, child)\n663\t\t\t\t}\n664\t\t\tcase string:\n665\t\t\t\tredacted := String(val)\n666\t\t\t\tif redacted == val && isCredentialJSONSecretKey(key, credentialContext) && hasNonPlaceholderPasswordValue(val) {\n667\t\t\t\t\tredacted = RedactedPlaceholder\n668\t\t\t\t}\n669\t\t\t\tif redacted != val {\n670\t\t\t\t\tseenKey := key + \"\\x00\" + val\n671\t\t\t\t\tif !seen[seenKey] {\n672\t\t\t\t\t\tseen[seenKey] = true\n673\t\t\t\t\t\trepls = append(repls, jsonReplacement{key: key, original: val, redacted: redacted})\n674\t\t\t\t\t}\n675\t\t\t\t}\n676\t\t\t}\n677\t\t}\n678\t\twalk(\"\", false, v)\n679\t\treturn repls\n680\t}\n681\t\n682\t// shouldSkipJSONLField returns true if a JSON key should be excluded from scanning/redaction.\n683\t// Skips \"signature\" (exact), ID fields (ending in \"id\"/\"ids\"), and common path/directory fields.\n684\tfunc shouldSkipJSONLField(key string) bool {\n685\t\tif key == \"signature\" {\n686\t\t\treturn true\n687\t\t}\n688\t\tlower := strings.ToLower(key)\n689\t\n690\t\t// Skip ID fields\n691\t\tif strings.HasSuffix(lower, \"id\") || strings.HasSuffix(lower, \"ids\") {\n692\t\t\treturn true\n693\t\t}\n694\t\n695\t\t// Skip common path and directory fields from agent transcripts.\n696\t\t// These appear frequently in tool calls and are structural, not secrets.\n697\t\tswitch lower {\n698\t\tcase \"filepath\", \"file_path\", \"cwd\", \"root\", \"directory\", \"dir\", \"path\":\n699\t\t\treturn true\n700\t\t}\n701\t\n702\t\treturn false\n703\t}\n704\t\n705\t// shouldSkipJSONLObject returns true if the object has \"type\":\"image\" or \"type\":\"image_url\".\n706\tfunc shouldSkipJSONLObject(obj map[string]any) bool {\n707\t\tt, ok := obj[\"type\"].(string)\n708\t\treturn ok && (strings.HasPrefix(t, \"image\") || t == \"base64\")\n709\t}\n710\t\n711\tfunc shannonEntropy(s string) float64 {\n712\t\tif len(s) == 0 {\n713\t\t\treturn 0\n714\t\t}\n715\t\tfreq := make(map[byte]int)\n716\t\tfor i := range len(s) {\n717\t\t\tfreq[s[i]]++\n718\t\t}\n719\t\tlength := float64(len(s))\n720\t\tvar entropy float64\n721\t\tfor _, count := range freq {\n722\t\t\tp := float64(count) / length\n723\t\t\tentropy -= p * math.Log2(p)\n724\t\t}\n725\t\treturn entropy\n726\t}\n727\t\n728\t// jsonEncodeString returns the JSON encoding of s without HTML escaping.\n729\tfunc jsonEncodeString(s string) (string, error) {\n730\t\tvar buf bytes.Buffer\n731\t\tenc := json.NewEncoder(&buf)\n732\t\tenc.SetEscapeHTML(false)\n733\t\tif err := enc.Encode(s); err != nil {\n734\t\t\treturn \"\", fmt.Errorf(\"json encode string: %w\", err)\n735\t\t}\n736\t\treturn strings.TrimSuffix(buf.String(), \"\\n\"), nil\n737\t}\n738\t"}]},"uuid":"e1d2751f-8e07-4c52-b04f-b3b33cda90b5","timestamp":"2026-05-13T00:25:51.036Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact/redact/redact.go","content":"package redact\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"math\"\n\t\"net/url\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/betterleaks/betterleaks/detect\"\n)\n\n// secretPattern matches high-entropy strings that may be secrets.\n// Note: / is excluded to prevent matching entire file paths as single tokens.\n// Base64 and JWT tokens are still caught via high-entropy segments between slashes.\nvar secretPattern = regexp.MustCompile(`[A-Za-z0-9+_=-]{10,}`)\n\n// credentialedURIPattern matches URLs that embed userinfo with a password, such\n// as REDACTED or REDACTED These often have\n// moderate entropy and are not reliably covered by vendor-specific scanners.\nvar credentialedURIPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9+.-]{1,31}://[^\\s/?#@\"'` + \"`\" + `<>:]*:[^\\s/?#@\"'` + \"`\" + `<>]+@[^\\s\"'` + \"`\" + `<>]+`)\n\n// dbPasswordKeyShape matches a DB-prefixed credential key (vendor prefix +\n// optional `_word`/`-word` segments + `password`/`passwd`/`pwd`). Used to\n// compose both the env-var assignment regex and the JSON-key regex so the\n// vendor list stays in one place.\nconst dbPasswordKeyShape = `(?:db|database|pg|postgres|postgresql|mysql|mariadb|redis|mongo|mongodb|sqlserver|mssql|jdbc)(?:[_-]+[a-z0-9]+)*[_-]*(?:password|passwd|pwd)` //nolint:gosec // regex literal, not a credential\n\nvar (\n\tjdbcPattern          = regexp.MustCompile(`(?i)\\bjdbc:[^\\s\"'<>` + \"`\" + `]+`)\n\tdatabaseURLPattern   = regexp.MustCompile(`(?i)\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis)://[^\\s\"'<>` + \"`\" + `]+`)\n\tkeywordDSNPattern    = regexp.MustCompile(`(?i)\\b[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)(?:\\s+[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)){2,}`)\n\tsemicolonConnPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)(?:;[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)){2,}`)\n\t// credentialValuePattern requires the prefix to start at a non-alphanumeric\n\t// boundary, so APP_DB_PASSWORD matches via the leading `_` but mydbpassword\n\t// does not.\n\tcredentialValuePattern = regexp.MustCompile(`(?i)(?:^|[^A-Za-z0-9])(` + dbPasswordKeyShape + `)\\s*=\\s*(\"[^\"]*\"|'[^']*'|[^\\s,;&]+)`)\n\n\tkeywordHostPattern      = regexp.MustCompile(`(?i)(?:^|\\s)host=`)\n\tkeywordUserPattern      = regexp.MustCompile(`(?i)(?:^|\\s)user=`)\n\tsemicolonServerPattern  = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:server|data source|datasource|addr|address|network address)\\s*=`)\n\tsemicolonUserPattern    = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:user id|userid|user|uid)\\s*=`)\n\tpasswordAssignmentRegex = regexp.MustCompile(`(?i)(?:^|[?&;\\s])(?:password|pwd)=(\"[^\"]*\"|'[^']*'|[^&;\\s\"']+)`)\n\t// credentialJSONKeyRegex operates on output of normalizeCredentialJSONKey\n\t// (already lowercased, `-`/` `/`.` → `_`), so the `(?i)` flag is unnecessary.\n\tcredentialJSONKeyRegex  = regexp.MustCompile(`^` + dbPasswordKeyShape + `$`)\n\tgenericPasswordKeyRegex = regexp.MustCompile(`(?i)^(?:password|passwd|pwd)$`)\n)\n\n// entropyThreshold is the minimum Shannon entropy for a string to be considered\n// a secret. 4.5 was chosen through trial and error: high enough to avoid false\n// positives on common words and identifiers, low enough to catch typical API keys\n// and tokens which tend to have entropy well above 5.0.\nconst entropyThreshold = 4.5\n\n// RedactedPlaceholder is the replacement text used for redacted secrets.\nconst RedactedPlaceholder = \"REDACTED\"\n\n// placeholderSecretValues lists lowercase values that should be treated as\n// non-secrets when they appear as a credential value: prior redactions\n// (REDACTED / [REDACTED] / <REDACTED>), common documentation placeholders,\n// and obviously-non-real defaults. Values matched by shape (mask runs,\n// `<…>` brackets, `${…}` shell expansion) are handled separately.\nvar placeholderSecretValues = func() map[string]struct{} {\n\tlower := strings.ToLower(RedactedPlaceholder)\n\tvalues := []string{\n\t\tlower, \"[\" + lower + \"]\", \"<\" + lower + \">\",\n\t\t\"changeme\", \"example\", \"placeholder\",\n\t\t\"your_password\", \"your_db_password\", \"your_secret\",\n\t\t\"secret_here\",\n\t}\n\tout := make(map[string]struct{}, len(values))\n\tfor _, v := range values {\n\t\tout[v] = struct{}{}\n\t}\n\treturn out\n}()\n\n// RedactedBytes represents transcript data that has been through secret\n// redaction. Consumers that require pre-redacted input (e.g., compact.Compact,\n// checkpoint stores) accept this type to enforce the contract at compile time.\n//\n// Produced by JSONLBytes (primary constructor) or trusted wrappers for data\n// previously persisted by checkpoint writers.\ntype RedactedBytes struct {\n\tdata []byte\n}\n\n// Bytes returns the underlying byte slice.\nfunc (r RedactedBytes) Bytes() []byte {\n\treturn r.data\n}\n\n// Len returns the number of bytes in the redacted payload.\nfunc (r RedactedBytes) Len() int {\n\treturn len(r.data)\n}\n\n// AlreadyRedacted wraps transcript bytes known to already be redacted by a\n// prior write path. Use this ONLY for trusted sources such as persisted\n// checkpoint transcripts or controlled test fixtures. For fresh transcript\n// input, use JSONLBytes.\nfunc AlreadyRedacted(data []byte) RedactedBytes {\n\treturn RedactedBytes{data: data}\n}\n\nvar (\n\tbetterleaksDetector     *detect.Detector\n\tbetterleaksDetectorOnce sync.Once\n)\n\nfunc getDetector() *detect.Detector {\n\tbetterleaksDetectorOnce.Do(func() {\n\t\td, err := detect.NewDetectorDefaultConfig()\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tbetterleaksDetector = d\n\t})\n\treturn betterleaksDetector\n}\n\n// region represents a byte range to redact.\ntype region struct{ start, end int }\n\n// taggedRegion extends region with a label for typed replacement tokens.\n// Empty label = secret (produces \"REDACTED\"). Non-empty = PII (produces \"[REDACTED_<LABEL>]\").\ntype taggedRegion struct {\n\tregion\n\n\tlabel string\n}\n\ntype jsonReplacement struct {\n\tkey      string\n\toriginal string\n\tredacted string\n}\n\ntype connectionStringRule struct {\n\tpattern   *regexp.Regexp\n\thasSecret func(string) bool\n}\n\nvar connectionStringRules = []connectionStringRule{\n\t{pattern: jdbcPattern, hasSecret: hasJDBCPassword},\n\t{pattern: databaseURLPattern, hasSecret: hasDatabaseURLSecret},\n\t{pattern: keywordDSNPattern, hasSecret: hasKeywordDSNPassword},\n\t{pattern: semicolonConnPattern, hasSecret: hasSemicolonConnectionPassword},\n}\n\n// String replaces secrets and PII in s using layered detection:\n// 1. Entropy-based: high-entropy alphanumeric sequences (threshold 4.5)\n// 2. Pattern-based: betterleaks regex rules (260+ known secret formats)\n// 3. Credentialed URIs: URLs containing userinfo passwords\n// 4. Database connection strings: JDBC, keyword DSNs, and semicolon strings\n// 5. User-defined custom rules: configured via ConfigureCustomRules\n// 6. Bounded credential key/value pairs: DB_PASSWORD=...\n// 7. PII detection: email, phone, address patterns (only when configured via ConfigurePII)\n// A string is redacted if ANY method flags it.\nfunc String(s string) string {\n\tvar regions []taggedRegion\n\n\t// 1. Entropy-based detection (secrets — always on).\n\tfor _, loc := range secretPattern.FindAllStringIndex(s, -1) {\n\t\tstart, end := loc[0], loc[1]\n\n\t\t// Don't consume characters that are part of JSON/string escape sequences.\n\t\t// Example: in \"controller.go\\nmodel.go\", the regex could match \"nmodel\"\n\t\t// (consuming the 'n' from '\\n'), and after replacement the '\\' would be\n\t\t// followed by 'R' from \"REDACTED\", creating invalid escape '\\R'.\n\t\t// Only skip for known JSON escape letters to avoid trimming real secrets\n\t\t// that happen to follow a literal backslash in decoded content.\n\t\tif start > 0 && s[start-1] == '\\\\' {\n\t\t\tswitch s[start] {\n\t\t\tcase 'n', 't', 'r', 'b', 'f', 'u', '\"', '\\\\', '/':\n\t\t\t\tstart++\n\t\t\t\tif end-start < 10 {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tif shannonEntropy(s[start:end]) > entropyThreshold {\n\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n\t\t}\n\t}\n\n\t// 2. Pattern-based detection via betterleaks (secrets — always on).\n\tif d := getDetector(); d != nil {\n\t\tfor _, f := range d.DetectString(s) {\n\t\t\tif f.Secret == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tsearchFrom := 0\n\t\t\tfor {\n\t\t\t\tidx := strings.Index(s[searchFrom:], f.Secret)\n\t\t\t\tif idx < 0 {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tabsIdx := searchFrom + idx\n\t\t\t\tregions = append(regions, taggedRegion{region: region{absIdx, absIdx + len(f.Secret)}})\n\t\t\t\tsearchFrom = absIdx + len(f.Secret)\n\t\t\t}\n\t\t}\n\t}\n\n\t// 3. Credentialed URIs (secrets — always on).\n\tfor _, loc := range credentialedURIPattern.FindAllStringIndex(s, -1) {\n\t\tregions = append(regions, taggedRegion{region: region{loc[0], loc[1]}})\n\t}\n\n\t// 4. Database and connection-string detection (secrets — always on).\n\tregions = append(regions, detectConnectionStrings(s)...)\n\n\t// 5. User-defined custom rules (secrets — only runs when configured).\n\tregions = append(regions, detectCustomRules(getCustomRulesConfig(), s)...)\n\n\t// 6. Bounded credential key/value detection (secrets — always on).\n\tregions = append(regions, detectCredentialValues(s)...)\n\n\t// 7. PII detection (opt-in — only runs when configured).\n\tregions = append(regions, detectPII(getPIIConfig(), s)...)\n\n\tif len(regions) == 0 {\n\t\treturn s\n\t}\n\n\t// Merge overlapping regions and build result.\n\tsort.Slice(regions, func(i, j int) bool {\n\t\tif regions[i].start != regions[j].start {\n\t\t\treturn regions[i].start < regions[j].start\n\t\t}\n\t\tif regions[i].end != regions[j].end {\n\t\t\treturn regions[i].end > regions[j].end // larger region first\n\t\t}\n\t\treturn regions[i].label < regions[j].label // deterministic tie-break\n\t})\n\tmerged := []taggedRegion{regions[0]}\n\tfor _, r := range regions[1:] {\n\t\tlast := &merged[len(merged)-1]\n\t\tif r.start <= last.end {\n\t\t\tif r.end > last.end {\n\t\t\t\tlast.end = r.end\n\t\t\t}\n\t\t\t// Keep the existing label (first/larger region wins)\n\t\t} else {\n\t\t\tmerged = append(merged, r)\n\t\t}\n\t}\n\n\tvar b strings.Builder\n\tprev := 0\