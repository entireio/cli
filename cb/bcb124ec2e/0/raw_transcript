{"parentUuid":"f7ff053e-919c-413e-9f7e-4158d69a81fd","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact/redact/opf_runtime/shellout_test.go","snippet":"1\tpackage opf_runtime\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"os/exec\"\n7\t\t\"strings\"\n8\t\t\"sync\"\n9\t\t\"testing\"\n10\t\t\"time\"\n11\t)\n12\t\n13\t// shCmd returns a Cmd that runs the given shell snippet via `sh -c`.\n14\t// Matches the claudecode test pattern.\n15\tfunc shCmd(ctx context.Context, script string) *exec.Cmd {\n16\t\treturn exec.CommandContext(ctx, \"sh\", \"-c\", script)\n17\t}\n18\t\n19\tfunc TestShellOut_Success(t *testing.T) {\n20\t\tt.Parallel()\n21\t\trt := &shellOut{\n22\t\t\tcommand:        \"opf\",\n23\t\t\ttimeoutSeconds: 5,\n24\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n25\t\t\t\tout := `{\"detected_spans\":[{\"label\":\"private_person\",\"start\":0,\"end\":5,\"text\":\"Alice\"}]}`\n26\t\t\t\treturn shCmd(ctx, \"printf '%s' '\"+out+\"'\")\n27\t\t\t},\n28\t\t}\n29\t\tspans, err := rt.Redact(context.Background(), \"Alice is here.\", []string{\"private_person\"})\n30\t\tif err != nil {\n31\t\t\tt.Fatalf(\"Redact: %v\", err)\n32\t\t}\n33\t\tif len(spans) != 1 {\n34\t\t\tt.Fatalf(\"spans: want 1, got %d\", len(spans))\n35\t\t}\n36\t\tif spans[0].Label != \"private_person\" || spans[0].Start != 0 || spans[0].End != 5 {\n37\t\t\tt.Errorf(\"span mismatch: %+v\", spans[0])\n38\t\t}\n39\t}\n40\t\n41\tfunc TestShellOut_NonZeroExit(t *testing.T) {\n42\t\tt.Parallel()\n43\t\trt := &shellOut{\n44\t\t\tcommand:        \"opf\",\n45\t\t\ttimeoutSeconds: 5,\n46\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n47\t\t\t\treturn shCmd(ctx, \"echo boom >&2; exit 2\")\n48\t\t\t},\n49\t\t}\n50\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n51\t\tif err == nil {\n52\t\t\tt.Fatalf(\"want error, got nil\")\n53\t\t}\n54\t\tif !strings.Contains(err.Error(), \"boom\") {\n55\t\t\tt.Errorf(\"err: want stderr passthrough, got %q\", err)\n56\t\t}\n57\t}\n58\t\n59\tfunc TestShellOut_GarbledOutput(t *testing.T) {\n60\t\tt.Parallel()\n61\t\trt := &shellOut{\n62\t\t\tcommand:        \"opf\",\n63\t\t\ttimeoutSeconds: 5,\n64\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n65\t\t\t\treturn shCmd(ctx, \"printf 'not json'\")\n66\t\t\t},\n67\t\t}\n68\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n69\t\tif err == nil {\n70\t\t\tt.Fatalf(\"want error, got nil\")\n71\t\t}\n72\t}\n73\t\n74\tfunc TestShellOut_Timeout(t *testing.T) {\n75\t\tt.Parallel()\n76\t\trt := &shellOut{\n77\t\t\tcommand:        \"opf\",\n78\t\t\ttimeoutSeconds: 1,\n79\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n80\t\t\t\treturn shCmd(ctx, \"sleep 5\")\n81\t\t\t},\n82\t\t}\n83\t\tstart := time.Now()\n84\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n85\t\tif err == nil {\n86\t\t\tt.Fatalf(\"want timeout error, got nil\")\n87\t\t}\n88\t\tif elapsed := time.Since(start); elapsed > 3*time.Second {\n89\t\t\tt.Errorf(\"timeout did not cancel quickly enough: %v\", elapsed)\n90\t\t}\n91\t\tif !errors.Is(err, context.DeadlineExceeded) && !strings.Contains(err.Error(), \"timeout\") {\n92\t\t\tt.Errorf(\"err: want timeout, got %q\", err)\n93\t\t}\n94\t}\n95\t\n96\tfunc TestShellOut_CommandNotFound(t *testing.T) {\n97\t\tt.Parallel()\n98\t\t// Use real NewShellOut (no injection) so we exercise exec.CommandContext\n99\t\t// against a non-existent path.\n100\t\trt := NewShellOut(\"/nonexistent/opf-binary\", 5)\n101\t\t_, err := rt.Redact(context.Background(), \"x\", []string{\"private_person\"})\n102\t\tif err == nil {\n103\t\t\tt.Fatalf(\"want error, got nil\")\n104\t\t}\n105\t}\n106\t\n107\tfunc TestShellOut_ParentContextCanceled(t *testing.T) {\n108\t\tt.Parallel()\n109\t\t// Parent-context cancellation must produce a clear \"canceled\" message,\n110\t\t// not be misreported as a generic \"opf exited with error\" (the bug we\n111\t\t// fixed). The child callCtx will surface context.Canceled via cascade,\n112\t\t// not context.DeadlineExceeded, so the timeout branch alone is insufficient.\n113\t\trt := &shellOut{\n114\t\t\tcommand:        \"opf\",\n115\t\t\ttimeoutSeconds: 30,\n116\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n117\t\t\t\treturn shCmd(ctx, \"sleep 5\")\n118\t\t\t},\n119\t\t}\n120\t\tctx, cancel := context.WithCancel(context.Background())\n121\t\tgo func() {\n122\t\t\ttime.Sleep(50 * time.Millisecond)\n123\t\t\tcancel()\n124\t\t}()\n125\t\t_, err := rt.Redact(ctx, \"x\", []string{\"private_person\"})\n126\t\tif err == nil {\n127\t\t\tt.Fatalf(\"want cancellation error, got nil\")\n128\t\t}\n129\t\tif !errors.Is(err, context.Canceled) {\n130\t\t\tt.Errorf(\"err: want context.Canceled in chain, got %q\", err)\n131\t\t}\n132\t\tif !strings.Contains(err.Error(), \"canceled\") {\n133\t\t\tt.Errorf(\"err: want 'canceled' message, got %q\", err)\n134\t\t}\n135\t}\n136\t\n137\t// TestShellOut_RedactBatch_PartitionsSpansByInput verifies that batched\n138\t// calls correctly partition opf's single JSON output back to per-input\n139\t// span slices. The concatenated batch input has known boundaries; spans\n140\t// returned by opf are mapped to whichever input contains them.\n141\t//\n142\t// Inputs: [\"Alice here\", \"no match\", \"secret abc\"]\n143\t// Concatenation: \"Alice here\" + sep + \"no match\" + sep + \"secret abc\"\n144\t//   - \"Alice here\"  starts at 0, ends at 10\n145\t//   - sep at        10\n146\t//   - \"no match\"    starts at 11 (sep is 1 byte), ends at 19\n147\t//   - sep at        19\n148\t//   - \"secret abc\"  starts at 20, ends at 30\n149\t//\n150\t// Simulate opf returning spans at 0-5 (Alice) and 27-30 (abc).\n151\tfunc TestShellOut_RedactBatch_PartitionsSpansByInput(t *testing.T) {\n152\t\tt.Parallel()\n153\t\trt := &shellOut{\n154\t\t\tcommand:        \"opf\",\n155\t\t\ttimeoutSeconds: 5,\n156\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n157\t\t\t\t// Span 1: \"Alice\" at [0,5] → input 0\n158\t\t\t\t// Span 2: \"abc\" at [27,30] → input 2 (base 20, local [7,10])\n159\t\t\t\tout := `{\"detected_spans\":[{\"label\":\"private_person\",\"start\":0,\"end\":5},{\"label\":\"secret\",\"start\":27,\"end\":30}]}`\n160\t\t\t\treturn shCmd(ctx, \"printf '%s' \"+shellQuote(out))\n161\t\t\t},\n162\t\t}\n163\t\tinputs := []string{\"Alice here\", \"no match\", \"secret abc\"}\n164\t\tbatches, err := rt.RedactBatch(context.Background(), inputs, []string{\"private_person\", \"secret\"})\n165\t\tif err != nil {\n166\t\t\tt.Fatalf(\"RedactBatch: %v\", err)\n167\t\t}\n168\t\tif len(batches) != 3 {\n169\t\t\tt.Fatalf(\"want 3 output slices, got %d\", len(batches))\n170\t\t}\n171\t\tif len(batches[0]) != 1 || batches[0][0].Label != \"private_person\" ||\n172\t\t\tbatches[0][0].Start != 0 || batches[0][0].End != 5 {\n173\t\t\tt.Errorf(\"input 0: want private_person at [0,5], got %+v\", batches[0])\n174\t\t}\n175\t\tif len(batches[1]) != 0 {\n176\t\t\tt.Errorf(\"input 1: want empty, got %+v\", batches[1])\n177\t\t}\n178\t\tif len(batches[2]) != 1 || batches[2][0].Label != \"secret\" ||\n179\t\t\tbatches[2][0].Start != 7 || batches[2][0].End != 10 {\n180\t\t\tt.Errorf(\"input 2: want secret at local [7,10], got %+v\", batches[2])\n181\t\t}\n182\t}\n183\t\n184\t// TestShellOut_RedactBatch_DropsSpansCrossingBoundary verifies that a\n185\t// span overlapping the batch separator (which shouldn't happen in\n186\t// practice but could if opf hallucinates) is dropped rather than\n187\t// mis-assigned to either input.\n188\tfunc TestShellOut_RedactBatch_DropsSpansCrossingBoundary(t *testing.T) {\n189\t\tt.Parallel()\n190\t\trt := &shellOut{\n191\t\t\tcommand:        \"opf\",\n192\t\t\ttimeoutSeconds: 5,\n193\t\t\tCommandRunner: func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n194\t\t\t\t// Concatenated: \"Alice here\\x1eno match\" (lengths 10+1+8)\n195\t\t\t\t// Span [8,13] crosses the separator at offset 10.\n196\t\t\t\tout := `{\"detected_spans\":[{\"label\":\"private_person\",\"start\":8,\"end\":13}]}`\n197\t\t\t\treturn shCmd(ctx, \"printf '%s' \"+shellQuote(out))\n198\t\t\t},\n199\t\t}\n200\t\tbatches, err := rt.RedactBatch(context.Background(),\n201\t\t\t[]string{\"Alice here\", \"no match\"}, []string{\"private_person\"})\n202\t\tif err != nil {\n203\t\t\tt.Fatalf(\"RedactBatch: %v\", err)\n204\t\t}\n205\t\tif len(batches[0]) != 0 || len(batches[1]) != 0 {\n206\t\t\tt.Errorf(\"cross-boundary span should be dropped; got %+v / %+v\", batches[0], batches[1])\n207\t\t}\n208\t}\n209\t\n210\t// TestShellOut_RedactBatch_MultiByteUTF8Offsets verifies that character\n211\t// offsets from opf are correctly translated to byte offsets for slicing.\n212\t// opf returns 0-based rune offsets (Python str semantics); our redactor\n213\t// uses byte offsets. For ASCII the two agree, but for multi-byte UTF-8\n214\t// (e.g. '─' which is 3 bytes) they diverge — using the rune offset as a\n215\t// byte offset would slice mid-character and produce garbled '�'s.\n216\t//\n217\t// Input: \"Alice Smith ─ Bob Jones\"\n\n... [115 lines truncated] ..."},"type":"attachment","uuid":"c0fab9f5-b0b5-4801-be0f-645419a2ac9f","timestamp":"2026-05-14T17:42:44.106Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact","sessionId":"fb93c4d8-9548-4a4c-97e6-364245c50453","version":"2.1.140","gitBranch":"feat/openai-privacy-filter"}
{"parentUuid":"c0fab9f5-b0b5-4801-be0f-645419a2ac9f","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact/redact/opf_runtime/shellout.go","snippet":"1\tpackage opf_runtime\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"os/exec\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t\t\"unicode/utf8\"\n13\t)\n14\t\n15\t// shellOut runs the user-installed `opf` binary per call. Cold-start every\n16\t// invocation is intentional for v1 — see the spec's runtime decision section.\n17\t// Daemon mode (a future implementation of Runtime) reuses this same wire\n18\t// format so callers do not change.\n19\ttype shellOut struct {\n20\t\tcommand        string\n21\t\ttimeoutSeconds int\n22\t\n23\t\t// CommandRunner builds the *exec.Cmd that is run for each Redact call.\n24\t\t// Tests override this with a closure that returns a Cmd wrapping a shell\n25\t\t// snippet, mirroring the pattern in cmd/entire/cli/agent/claudecode.\n26\t\t// Production callers go through NewShellOut, which defaults this to\n27\t\t// exec.CommandContext.\n28\t\tCommandRunner func(ctx context.Context, name string, args ...string) *exec.Cmd\n29\t}\n30\t\n31\t// opfOutput is the subset of OPF's typed JSON output we consume.\n32\t// The `text` field on each span (and the top-level `redacted_text`)\n33\t// is intentionally omitted — callers reconstruct redacted text from the\n34\t// input plus Start/End offsets so the rendering style stays consistent\n35\t// with the other seven redaction layers.\n36\ttype opfOutput struct {\n37\t\tDetectedSpans []struct {\n38\t\t\tLabel string `json:\"label\"`\n39\t\t\tStart int    `json:\"start\"`\n40\t\t\tEnd   int    `json:\"end\"`\n41\t\t} `json:\"detected_spans\"`\n42\t}\n43\t\n44\t// Redact runs OPF on a single input. Convenience wrapper around RedactBatch\n45\t// for callers that only have one text to redact.\n46\tfunc (s *shellOut) Redact(ctx context.Context, text string, categories []string) ([]Span, error) {\n47\t\tif len(categories) == 0 {\n48\t\t\treturn nil, nil\n49\t\t}\n50\t\tbatch, err := s.RedactBatch(ctx, []string{text}, categories)\n51\t\tif err != nil {\n52\t\t\treturn nil, err\n53\t\t}\n54\t\tif len(batch) == 0 {\n55\t\t\treturn nil, nil\n56\t\t}\n57\t\treturn batch[0], nil\n58\t}\n59\t\n60\t// batchSeparator joins inputs into a single opf invocation. opf treats\n61\t// '\\n' as a per-input delimiter and runs a fresh inference pass per line —\n62\t// so a newline-joined batch processes each input as a separate forward\n63\t// pass through the model, which is no faster than per-call shell-out.\n64\t// Joining with a non-newline separator instead causes opf to treat the\n65\t// concatenation as ONE input and do ONE inference pass, amortizing the\n66\t// model load and forward-pass cost across all inputs.\n67\t//\n68\t// The chosen separator must:\n69\t//  1. Not appear in real text (so it doesn't collide with real content)\n70\t//  2. Look like whitespace to opf's tokenizer (so it doesn't confuse\n71\t//     span boundaries)\n72\t//\n73\t// ASCII RECORD SEPARATOR (U+001E) satisfies both: it's a control char\n74\t// not used in normal prose, and tokenizers generally treat control chars\n75\t// as whitespace.\n76\tconst batchSeparator = \"\\x1e\"\n77\t\n78\t// RedactBatch sends multiple inputs to opf as a single invocation, in a\n79\t// single inference pass. The inputs are joined with batchSeparator and\n80\t// any embedded newlines are flattened to spaces (1-byte → 1-byte, so\n81\t// offsets stay valid). opf emits one JSON object covering the whole\n82\t// concatenated text; we partition its spans back to per-input slices\n83\t// based on the boundary positions we tracked.\n84\t//\n85\t// Why not just join with '\\n' and decode N JSON objects? Empirically,\n86\t// opf processes a newline-joined batch as N sequential inference passes\n87\t// (one per line), each taking ~2