src, []byte(\"#!/bin/sh\\nexit 0\\n\"), 0o755); err != nil {\n287\t\t\tt.Fatalf(\"write src: %v\", err)\n288\t\t}\n289\t\t_, err := InstallPluginFromPath(InstallPluginOptions{SourcePath: src, Force: true})\n290\t\tif err == nil {\n291\t\t\tt.Fatalf(\"expected self-install rejection; got nil\")\n292\t\t}\n293\t\tif _, statErr := os.Stat(src); statErr != nil {\n294\t\t\tt.Errorf(\"self-install attempt deleted the source: %v\", statErr)\n295\t\t}\n296\t}\n297\t\n298\t// TestMaterializeManagedEntry_HappyPath is a smoke test that the helper\n299\t// completes successfully on a normal write-capable destination. On Unix it\n300\t// exits through the symlink branch; the hardlink and copy fallbacks exist\n301\t// for Windows-without-Developer-Mode and aren't portably triggerable from an\n302\t// in-process test (forcing os.Symlink to fail without mocks would require a\n303\t// non-portable filesystem setup). The other tests in this file exercise\n304\t// InstallPluginFromPath end-to-end, which calls into here.\n305\tfunc TestMaterializeManagedEntry_HappyPath(t *testing.T) {\n306\t\tt.Parallel()\n307\t\tif runtime.GOOS == windowsGOOS {\n308\t\t\tt.Skip(\"test exercises Unix file modes\")\n309\t\t}\n310\t\tsrcDir := t.TempDir()\n311\t\tsrc := filepath.Join(srcDir, \"src-bin\")\n312\t\tbody := []byte(\"#!/bin/sh\\nexit 0\\n\")\n313\t\tif err := os.WriteFile(src, body, 0o755); err != nil {\n314\t\t\tt.Fatalf(\"write src: %v\", err)\n315\t\t}\n316\t\tsrcInfo, err := os.Stat(src)\n317\t\tif err != nil {\n318\t\t\tt.Fatalf(\"stat src: %v\", err)\n319\t\t}\n320\t\n321\t\tdest := filepath.Join(t.TempDir(), \"out\")\n322\t\tif err := materializeManagedEntry(src, dest, srcInfo); err != nil {\n323\t\t\tt.Fatalf(\"materializeManagedEntry: %v\", err)\n324\t\t}\n325\t\tgot, err := os.ReadFile(dest)\n326\t\tif err != nil {\n327\t\t\tt.Fatalf(\"read result: %v\", err)\n328\t\t}\n329\t\tif string(got) != string(body) {\n330\t\t\tt.Errorf(\"dest content mismatch: got %q want %q\", got, body)\n331\t\t}\n332\t}\n333\t\n334\tfunc TestRemoveInstalledPlugin_RemovesAllVariants(t *testing.T) { //nolint:paralleltest // mutates env\n335\t\t// Simulate a corrupted state with two variants for the same bare name\n336\t\t// (the situation `entire plugin install` now prevents but legacy state\n337\t\t// or hand-edits could produce). RemoveInstalledPlugin must clean up\n338\t\t// every match, not just the first one FindInstalledPlugin returns.\n339\t\tif runtime.GOOS == windowsGOOS {\n340\t\t\tt.Skip(\"file-naming below is Unix-style\")\n341\t\t}\n342\t\troot := withPluginDir(t)\n343\t\tbinDir := filepath.Join(root, \"bin\")\n344\t\tif err := os.MkdirAll(binDir, 0o750); err != nil {\n345\t\t\tt.Fatalf(\"mkdir: %v\", err)\n346\t\t}\n347\t\t// On Unix, bareNameFromBinaryName preserves dots, so to produce two\n348\t\t// entries with identical bare names we need names that the helper\n349\t\t// folds together. We can't natively get that on Unix, so this test\n350\t\t// asserts the loop behavior by placing one entry and verifying the\n351\t\t// removal path iterates correctly even when only a single match\n352\t\t// exists. The Windows-specific multi-variant path is covered by the\n353\t\t// implementation reading installedVariantsByBareName.\n354\t\tbody := []byte(\"#!/bin/sh\\nexit 0\\n\")\n355\t\tif err := os.WriteFile(filepath.Join(binDir, \"entire-foo\"), body, 0o755); err != nil {\n356\t\t\tt.Fatalf(\"write entry: %v\", err)\n357\t\t}\n358\t\tif err := RemoveInstalledPlugin(\"foo\"); err != nil {\n359\t\t\tt.Fatalf(\"RemoveInstalledPlugin: %v\", err)\n360\t\t}\n361\t\tif _, err := os.Stat(filepath.Join(binDir, \"entire-foo\")); !errors.Is(err, os.ErrNotExist) {\n362\t\t\tt.Errorf(\"entire-foo still present after remove: %v\", err)\n363\t\t}\n364\t}\n365\t\n366\tfunc TestInstallPluginFromPath_TmpDoesNotClobberDottedPlugin(t *testing.T) { //nolint:paralleltest // mutates env\n367\t\tif runtime.GOOS == windowsGOOS {\n368\t\t\tt.Skip(\"symlink path is Unix-only here\")\n3