5\t\tif a == b {\n456\t\t\tt.Errorf(\"two calls returned the same path: %q\", a)\n457\t\t}\n458\t\t// Tmp prefix must not match the listing filter (which keys off\n459\t\t// \"entire-\"); the dot-prefix achieves that.\n460\t\tif !strings.HasPrefix(filepath.Base(a), \".install-\") {\n461\t\t\tt.Errorf(\"tmp path %q does not start with .install-\", a)\n462\t\t}\n463\t}\n464\t\n465\tfunc TestRemoveEnvKey(t *testing.T) {\n466\t\tt.Parallel()\n467\t\tin := []string{\"FOO=1\", \"BAR=2\", \"FOO=3\", \"BAZ=4\"}\n468\t\tgot := removeEnvKey(in, \"FOO\")\n469\t\twant := []string{\"BAR=2\", \"BAZ=4\"}\n470\t\tif !equalStringSlices(got, want) {\n471\t\t\tt.Errorf(\"removeEnvKey = %v, want %v\", got, want)\n472\t\t}\n473\t}\n474\t\n475\tfunc equalStringSlices(a, b []string) bool {\n476\t\tif len(a) != len(b) {\n477\t\t\treturn false\n478\t\t}\n479\t\tfor i := range a {\n480\t\t\tif a[i] != b[i] {\n481\t\t\t\treturn false\n482\t\t\t}\n483\t\t}\n484\t\treturn true\n485\t}\n486\t\n487\tfunc TestInstallPluginFromPath_AtomicForceReplace(t *testing.T) { //nolint:paralleltest // mutates env\n488\t\tif runtime.GOOS == windowsGOOS {\n489\t\t\tt.Skip(\"symlink/atomic-rename behavior is Unix-focused here\")\n490\t\t}\n491\t\twithPluginDir(t)\n492\t\tsrcDir := t.TempDir()\n493\t\tsrc := filepath.Join(srcDir, \"entire-foo\")\n494\t\tif err := os.WriteFile(src, []byte(\"#!/bin/sh\\nexit 0\\n\"), 0o755); err != nil {\n495\t\t\tt.Fatalf(\"write src: %v\", err)\n496\t\t}\n497\t\tif _, err := InstallPluginFromPath(InstallPluginOptions{SourcePath: src}); err != nil {\n498\t\t\tt.Fatalf(\"first install: %v\", err)\n499\t\t}\n500\t\tbinDir, err := PluginBinDir()\n501\t\tif err != nil {\n502\t\t\tt.Fatalf(\"PluginBinDir: %v\", err)\n503\t\t}\n504\t\tdest := filepath.Join(binDir, \"entire-foo\")\n505\t\tif _, err := os.Lstat(dest); err != nil {\n506\t\t\tt.Fatalf(\"first install missing: %v\", err)\n507\t\t}\n508\t\n509\t\t// Force-install from the same source. The replace should succeed and\n510\t\t//