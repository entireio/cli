{"parentUuid":"0dfbf8af-dadb-4bcf-8fa5-be20fc950a7f","isSidechain":false,"promptId":"c2a49211-3d76-4656-8d90-fa7135bc261a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LxKRs5Sfr97qyTpXdKcWgF","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"crypto/rand\"\n5\t\t\"encoding/hex\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"runtime\"\n12\t\t\"sort\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/external\"\n16\t)\n17\t\n18\t// Managed plugin storage. The kubectl-style dispatcher in plugin.go resolves\n19\t// `entire-<name>` binaries from $PATH, period. To let `entire plugin install`\n20\t// be additive rather than a parallel mechanism, this file provides:\n21\t//\n22\t//  1. PluginBinDir() — a per-user managed dir that main.go prepends to PATH\n23\t//     before the dispatcher runs. Anything dropped here (or symlinked here)\n24\t//     becomes invocable as `entire <name>` without the user fiddling with PATH.\n25\t//\n26\t//  2. PluginDataDir(name) — a per-plugin durable storage dir, passed to plugins\n27\t//     as ENTIRE_PLUGIN_DATA_DIR. Independent of where the binary itself lives\n28\t//     so plugins installed via PATH and via the managed dir get the same\n29\t//     contract.\n30\t//\n31\t// Honors ENTIRE_PLUGIN_DIR as a parent-dir override; falls back to\n32\t// XDG_DATA_HOME, then a platform default.\n33\t\n34\tconst (\n35\t\tpluginEnvPluginDir      = \"ENTIRE_PLUGIN_DIR\"\n36\t\tpluginManagedBinSubdir  = \"bin\"\n37\t\tpluginManagedDataSubdir = \"data\"\n38\t\tpluginEnvPluginData     = \"ENTIRE_PLUGIN_DATA_DIR\"\n39\t\t// Path segments for the managed plugin tree. Kept as separate\n40\t\t// segments (rather than \"entire/plugins\") so filepath.Join produces\n41\t\t// platform-native separators on Windows.\n42\t\tpluginManagedTopDir = \"entire\"\n43\t\tpluginManagedSubDir = \"plugins\"\n44\t)\n45\t\n46\t// pluginParentDir returns the per-user directory that holds the managed\n47\t// plugin storage. Resolution, in order:\n48\t//\n49\t//  1. ENTIRE_PLUGIN_DIR (cross-platform override).\n50\t//  2. On Windows: LOCALAPPDATA if set, else ~\\AppData\\Local\\entire\\plugins.\n51\t//  3. On Unix: XDG_DATA_HOME if set, else ~/.local/share/entire/plugins.\n52\t//\n53\t// XDG_DATA_HOME is deliberately ignored on Windows even when set (e.g. in\n54\t// MSYS/Cygwin) — Windows users expect Windows conventions, and routing\n55\t// through XDG would produce a surprising location.\n56\t//\n57\t// os.UserHomeDir is called only when no env-var branch resolves, so a\n58\t// degenerate environment with $LOCALAPPDATA or $XDG_DATA_HOME but no home\n59\t// still returns a usable path.\n60\tfunc pluginParentDir() (string, error) {\n61\t\tif v := os.Getenv(pluginEnvPluginDir); v != \"\" {\n62\t\t\treturn v, nil\n63\t\t}\n64\t\tif runtime.GOOS == windowsGOOS {\n65\t\t\tif appData := os.Getenv(\"LOCALAPPDATA\"); appData != \"\" {\n66\t\t\t\treturn filepath.Join(appData, pluginManagedTopDir, pluginManagedSubDir), nil\n67\t\t\t}\n68\t\t\thome, err := os.UserHomeDir()\n69\t\t\tif err != nil {\n70\t\t\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n71\t\t\t}\n72\t\t\treturn filepath.Join(home, \"AppData\", \"Local\", pluginManagedTopDir, pluginManagedSubDir), nil\n73\t\t}\n74\t\tif v := os.Getenv(\"XDG_DATA_HOME\"); v != \"\" {\n75\t\t\treturn filepath.Join(v, pluginManagedTopDir, pluginManagedSubDir), nil\n76\t\t}\n77\t\thome, err := os.UserHomeDir()\n78\t\tif err != nil {\n79\t\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n80\t\t}\n81\t\treturn filepath.Join(home, \".local\", \"share\", pluginManagedTopDir, pluginManagedSubDir), nil\n82\t}\n83\t\n84\t// PluginBinDir returns the managed install directory. Binaries (or symlinks)\n85\t// placed here are auto-discovered by the kubectl-style dispatcher because\n86\t// main.go prepends this dir to PATH before MaybeRunPlugin runs.\n87\tfunc PluginBinDir() (string, error) {\n88\t\tparent, err := pluginParentDir()\n89\t\tif err != nil {\n90\t\t\treturn \"\", err\n91\t\t}\n92\t\treturn filepath.Join(parent, pluginManagedBinSubdir), nil\n93\t}\n94\t\n95\t// PluginDataDir returns the per-plugin data directory for the given bare name\n96\t// (e.g. \"pgr\" for `entire-pgr`). The returned path is not created — that's\n97\t// the plugin's responsibility on first use.\n98\t//\n99\t// Returns an error for names the dispatcher would never invoke (empty,\n100\t// flag-shaped, agent-protocol-reserved, \".\"/\"..\" path-traversal, slashes).\n101\t// This guarantees ENTIRE_PLUGIN_DATA_DIR always points inside the managed\n102\t// data subtree.\n103\tfunc PluginDataDir(name string) (string, error) {\n104\t\tif err := validatePluginName(name); err != nil {\n105\t\t\treturn \"\", err\n106\t\t}\n107\t\tparent, err := pluginParentDir()\n108\t\tif err != nil {\n109\t\t\treturn \"\", err\n110\t\t}\n111\t\treturn filepath.Join(parent, pluginManagedDataSubdir, name), nil\n112\t}\n113\t\n114\t// validatePluginName mirrors the dispatcher's isPluginCandidate rules and\n115\t// returns a descriptive error for invalid names. Used by every entry point\n116\t// that takes a plugin name from outside the dispatcher (data dir resolution,\n117\t// managed-dir install).\n118\tfunc validatePluginName(name string) error {\n119\t\tif name == \"\" {\n120\t\t\treturn errors.New(\"plugin name is empty\")\n121\t\t}\n122\t\tif strings.HasPrefix(name, \"-\") {\n123\t\t\treturn fmt.Errorf(\"plugin name %q must not start with '-'\", name)\n124\t\t}\n125\t\tif strings.HasPrefix(name, \"agent-\") {\n126\t\t\treturn fmt.Errorf(\"plugin name %q is reserved for the external agent protocol\", name)\n127\t\t}\n128\t\tif strings.ContainsAny(name, `/\\`) {\n129\t\t\treturn fmt.Errorf(\"plugin name %q must not contain path separators\", name)\n130\t\t}\n131\t\tif name == \".\" || name == \"..\" {\n132\t\t\treturn fmt.Errorf(\"plugin name %q is not a valid identifier\", name)\n133\t\t}\n134\t\treturn nil\n135\t}\n136\t\n137\t// EnsurePluginBinDir creates the managed install dir if it doesn't exist.\n138\tfunc EnsurePluginBinDir() (string, error) {\n139\t\tdir, err := PluginBinDir()\n140\t\tif err != nil {\n141\t\t\treturn \"\", err\n142\t\t}\n143\t\tif err := os.MkdirAll(dir, 0o750); err != nil {\n144\t\t\treturn \"\", fmt.Errorf(\"create plugin bin dir: %w\", err)\n145\t\t}\n146\t\treturn dir, nil\n147\t}\n148\t\n149\t// PrependPluginBinDirToPATH prepends the managed bin dir to the process's\n150\t// PATH so the kubectl dispatcher discovers managed-installed plugins.\n151\t// Idempotent against an already-prepended dir.\n152\t//\n153\t// Returns a restore closure the caller invokes to revert PATH to its\n154\t// previous value. Restoring matters when no plugin runs: built-in commands\n155\t// and the subprocesses they spawn (git, hooks, less, …) should see the\n156\t// user's original PATH, not one with the managed plugin dir prepended.\n157\t// When a plugin *is* dispatched, callers can simply skip the restore — the\n158\t// process exits anyway, and the plugin child intentionally inherits the\n159\t// prepended PATH so it can spawn sibling managed plugins.\n160\t//\n161\t// Errors and no-op cases (already-prepended, lookup failure) return a\n162\t// no-op restore so callers always have a safe func to call.\n163\tfunc PrependPluginBinDirToPATH() func() {\n164\t\tdir, err := PluginBinDir()\n165\t\tif err != nil || dir == \"\" {\n166\t\t\treturn func() {}\n167\t\t}\n168\t\tprev := os.Getenv(\"PATH\")\n169\t\tsep := string(os.PathListSeparator)\n170\t\tif prev == \"\" {\n171\t\t\tif err := os.Setenv(\"PATH\", dir); err != nil {\n172\t\t\t\treturn func() {}\n173\t\t\t}\n174\t\t\treturn func() { _ = os.Setenv(\"PATH\", \"\") }\n175\t\t}\n176\t\t// Idempotent: if the first entry already matches, leave PATH alone.\n177\t\t// Windows PATH lookups are case-insensitive (`C:\\Foo` and `c:\\foo`\n178\t\t// resolve identically), so a case-different first entry is the same\n179\t\t// dir and we should not double-prepend.\n180\t\tfirst := prev\n181\t\tif i := strings.Index(prev, sep); i >= 0 {\n182\t\t\tfirst = prev[:i]\n183\t\t}\n184\t\tif pathEntriesEqual(first, dir) {\n185\t\t\treturn func() {}\n186\t\t}\n187\t\tif err := os.Setenv(\"PATH\", dir+sep+prev); err != nil {\n188\t\t\treturn func() {}\n189\t\t}\n190\t\treturn func() { _ = os.Setenv(\"PATH\", prev) }\n191\t}\n192\t\n193\t// pathEntriesEqual reports whether two PATH entries refer to the same dir.\n194\t// filepath.Clean normalizes trailing separators and (on Windows) slash\n195\t// orientation; case folding handles Windows' case-insensitive lookup.\n196\tfunc pathEntriesEqual(a, b string) bool {\n197\t\ta = filepath.Clean(a)\n198\t\tb = filepath.Clean(b)\n199\t\tif runtime.GOOS == windowsGOOS {\n200\t\t\treturn strings.EqualFold(a, b)\n201\t\t}\n202\t\treturn a == b\n203\t}\n204\t\n205\t// InstalledPlugin describes a single entry in the managed bin dir.\n206\ttype InstalledPlugin struct {\n207\t\t// Name is the bare plugin name (without the `entire-` prefix and any\n208\t\t// platform-specific extension).\n209\t\tName string\n210\t\t// Path is the absolute path inside the managed bin dir.\n211\t\tPath string\n212\t\t// Symlink is true when Path is a symlink to a source location elsewhere\n213\t\t// (the typical local-dev install). LinkTarget is populated in that case.\n214\t\tSymlink    bool\n215\t\tLinkTarget string\n216\t}\n217\t\n218\t// ListInstalledPlugins enumerates entries in the managed bin dir whose name\n219\t// starts with `entire-`. Sorted by bare name. A missing dir returns no error\n220\t// and an empty slice.\n221\tfunc ListInstalledPlugins() ([]*InstalledPlugin, error) {\n222\t\tdir, err := PluginBinDir()\n223\t\tif err != nil {\n224\t\t\treturn nil, err\n225\t\t}\n226\t\tentries, err := os.ReadDir(dir)\n227\t\tif err != nil {\n228\t\t\tif errors.Is(err, os.ErrNotExist) {\n229\t\t\t\treturn nil, nil\n230\t\t\t}\n231\t\t\treturn nil, fmt.Errorf(\"read plugin bin dir: %w\", err)\n232\t\t}\n233\t\n234\t\tvar out []*InstalledPlugin\n235\t\tfor _, e := range entries {\n236\t\t\tfull := e.Name()\n237\t\t\tif !strings.HasPrefix(full, pluginBinaryPrefix) {\n238\t\t\t\tcontinue\n239\t\t\t}\n240\t\t\tbare := bareNameFromBinaryName(full)\n241\t\t\tif bare == \"\" {\n242\t\t\t\tcontinue\n243\t\t\t}\n244\t\t\tpath := filepath.Join(dir, full)\n245\t\t\tinfo, err := os.Lstat(path)\n246\t\t\tif err != nil {\n247\t\t\t\tcontinue\n248\t\t\t}\n249\t\t\tip := &InstalledPlugin{Name: bare, Path: path}\n250\t\t\tif info.Mode()&os.ModeSymlink != 0 {\n251\t\t\t\tip.Symlink = true\n252\t\t\t\tif target, err := os.Readlink(path); err == nil {\n253\t\t\t\t\tip.LinkTarget = target\n254\t\t\t\t}\n255\t\t\t}\n256\t\t\tout = append(out, ip)\n257\t\t}\n258\t\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\n259\t\treturn out, nil\n260\t}\n261\t\n262\t// FindInstalledPlugin returns the entry for the given bare name, or nil if\n263\t// it isn't installed in the managed dir.\n264\tfunc FindInstalledPlugin(name string) (*InstalledPlugin, error) {\n265\t\tall, err := ListInstalledPlugins()\n266\t\tif err != nil {\n267\t\t\treturn nil, err\n268\t\t}\n269\t\tfor _, p := range all {\n270\t\t\tif p.Name == name {\n271\t\t\t\treturn p, nil\n272\t\t\t}\n273\t\t}\n274\t\treturn nil, nil //nolint:nilnil // not-installed signal\n275\t}\n276\t\n277\t// InstallPluginOptions configures InstallPluginFromPath.\n278\ttype InstallPluginOptions struct {\n279\t\t// SourcePath is the absolute (or working-dir-relative) path to the plugin\n280\t\t// executable. Its basename — minus any platform extension — must match\n281\t\t// `entire-<name>` so the dispatcher can resolve it.\n282\t\tSourcePath string\n283\t\t// Force replaces an already-installed plugin with the same name.\n284\t\tForce bool\n285\t}\n286\t\n287\t// InstallPluginFromPath symlinks SourcePath into the managed bin dir. The\n288\t// caller is responsible for built-in conflict checks (resolvePlugin already\n289\t// gates dispatch on rootCmd.Find — installing a name that shadows a built-in\n290\t// is allowed but the built-in still wins at runtime).\n291\t//\n292\t// Refuses names the dispatcher will never invoke (agent-protocol prefix,\n293\t// flag-shaped, \".\"/\"..\", slashes), and refuses self-install when the source\n294\t// is the same file as the would-be managed entry. The replace step is\n295\t// atomic: a new symlink is created at <dest>.tmp and renamed onto <dest>,\n296\t// so a failed --force never leaves the previous install missing.\n297\tfunc InstallPluginFromPath(opts InstallPluginOptions) (*InstalledPlugin, error) {\n298\t\tsrc, err := filepath.Abs(opts.SourcePath)\n299\t\tif err != nil {\n300\t\t\treturn nil, fmt.Errorf(\"resolve source path: %w\", err)\n301\t\t}\n302\t\tsrcInfo, err := os.Stat(src)\n303\t\tif err != nil {\n304\t\t\treturn nil, fmt.Errorf(\"stat source: %w\", err)\n305\t\t}\n306\t\tif srcInfo.IsDir() {\n307\t\t\treturn nil, fmt.Errorf(\"source must be a file, got directory: %s\", src)\n308\t\t}\n309\t\tbase := filepath.Base(src)\n310\t\tbare := bareNameFromBinaryName(base)\n311\t\tif bare == \"\" {\n312\t\t\treturn nil, fmt.Errorf(\"source basename %q must start with %q and have a runnable name\", base, pluginBinaryPrefix)\n313\t\t}\n314\t\tif err := validatePluginName(bare); err != nil {\n315\t\t\treturn nil, fmt.Errorf(\"derived plugin name from %q is not dispatchable: %w\", base, err)\n316\t\t}\n317\t\tif runtime.GOOS != windowsGOOS && srcInfo.Mode()&0o111 == 0 {\n318\t\t\treturn nil, fmt.Errorf(\"source %s is not executable (chmod +x)\", src)\n319\t\t}\n320\t\n321\t\tbinDir, err := EnsurePluginBinDir()\n322\t\tif err != nil {\n323\t\t\treturn nil, err\n324\t\t}\n325\t\tdest := filepath.Join(binDir, base)\n326\t\n327\t\t// Reject self-install: the source path already equals the managed\n328\t\t// destination path. Without this guard, `--force` would atomically\n329\t\t// rename a tmp symlink onto its own target file and the underlying\n330\t\t// binary would be unlinked.\n331\t\t//\n332\t\t// We deliberately do NOT use os.SameFile here. The legitimate\n333\t\t// repeat-install case has dest as a symlink we created on a prior\n334\t\t// install; SameFile would resolve dest through the symlink to src\n335\t\t// and falsely trip. Path equality is the precise risky case.\n336\t\tif filepath.Clean(src) == filepath.Clean(dest) {\n337\t\t\treturn nil, fmt.Errorf(\"source %s is already the managed entry; nothing to install\", src)\n338\t\t}\n339\t\n340\t\t// Conflict check on the bare name (not the exact filename). On Windows,\n341\t\t// entire-foo.exe / .bat / .cmd all map to bare name \"foo\"; checking only\n342\t\t// the destination filename would let a second install of a different\n343\t\t// extension silently coexist with the first, with PATHEXT ordering then\n344\t\t// deciding which one runs. List all variants and require --force when\n345\t\t// any exist.\n346\t\tconflicts, err := installedVariantsByBareName(bare)\n347\t\tif err != nil {\n348\t\t\treturn nil, err\n349\t\t}\n350\t\tif len(conflicts) > 0 && !opts.Force {\n351\t\t\treturn nil, fmt.Errorf(\"plugin %q already installed at %s; use --force to replace\", bare, conflicts[0].Path)\n352\t\t}\n353\t\t// With --force, remove every variant other than the one we're about to\n354\t\t// atomically overwrite. The same-extension case is handled by the\n355\t\t// rename below, which atomically replaces dest.\n356\t\tfor _, c := range conflicts {\n357\t\t\tif filepath.Clean(c.Path) == filepath.Clean(dest) {\n358\t\t\t\tcontinue\n359\t\t\t}\n360\t\t\tif err := os.Remove(c.Path); err != nil && !errors.Is(err, os.ErrNotExist) {\n361\t\t\t\treturn nil, fmt.Errorf(\"remove existing variant %s: %w\", c.Path, err)\n362\t\t\t}\n363\t\t}\n364\t\n365\t\t// Atomic replace via tmp + rename. Rename is atomic on POSIX and\n366\t\t// replaces an existing target on Windows (Go's os.Rename uses\n367\t\t// MoveFileEx with MOVEFILE_REPLACE_EXISTING). If linking or rename\n368\t\t// fails, the previously installed plugin (if any) is unaffected.\n369\t\t//\n370\t\t// The tmp path uses a random suffix and a `.install-` prefix that does\n371\t\t// NOT match `entire-`. This protects against two distinct hazards:\n372\t\t//   1. A user can have a legitimate plugin named \"foo.tmp\" (file\n373\t\t//      \"entire-foo.tmp\"), which a naive `dest + \".tmp\"` would clobber.\n374\t\t//   2. ListInstalledPlugins filters by `entire-` prefix, so a tmp that\n375\t\t//      starts with `.install-` will not appear in `entire plugin list`\n376\t\t//      while the install is in progress.\n377\t\ttmpDest, err := makeInstallTmpPath(binDir)\n378\t\tif err != nil {\n379\t\t\treturn nil, err\n380\t\t}\n381\t\tif err := materializeManagedEntry(src, tmpDest, srcInfo); err != nil {\n382\t\t\treturn nil, fmt.Errorf(\"install plugin: %w\", err)\n383\t\t}\n384\t\tif err := os.Rename(tmpDest, dest); err != nil {\n385\t\t\t_ = os.Remove(tmpDest) // best-effort cleanup; previous install is intact\n386\t\t\treturn nil, fmt.Errorf(\"install plugin: %w\", err)\n387\t\t}\n388\t\treturn FindInstalledPlugin(bare)\n389\t}\n390\t\n391\t// installedVariantsByBareName returns every managed entry whose bare name\n392\t// matches name. On Unix this is at most one entry; on Windows multiple\n393\t// extensions can map to the same bare name.\n394\tfunc installedVariantsByBareName(name string) ([]*InstalledPlugin, error) {\n395\t\tall, err := ListInstalledPlugins()\n396\t\tif err != nil {\n397\t\t\treturn nil, err\n398\t\t}\n399\t\tvar out []*InstalledPlugin\n400\t\tfor _, p := range all {\n401\t\t\tif p.Name == name {\n402\t\t\t\tout = append(out, p)\n403\t\t\t}\n404\t\t}\n405\t\treturn out, nil\n406\t}\n407\t\n408\t// makeInstallTmpPath returns a unique scratch path inside binDir for the\n409\t// in-progress install. The `.install-` prefix is deliberately distinct from\n410\t// pluginBinaryPrefix so ListInstalledPlugins ignores it; a 16-char hex\n411\t// suffix from crypto/rand makes collisions vanishingly unlikely and keeps\n412\t// concurrent installs safe from each other.\n413\tfunc makeInstallTmpPath(binDir string) (string, error) {\n414\t\tvar b [8]byte\n415\t\tif _, err := rand.Read(b[:]); err != nil {\n416\t\t\treturn \"\", fmt.Errorf(\"generate install tmp suffix: %w\", err)\n417\t\t}\n418\t\treturn filepath.Join(binDir, \".install-\"+hex.EncodeToString(b[:])), nil\n419\t}\n420\t\n421\t// materializeManagedEntry creates dest as a reference to src, falling back\n422\t// through symlink → hardlink → copy in that order.\n423\t//\n424\t// Symlink-first preserves the dev-loop property that rebuilding the source\n425\t// is immediately reflected in the managed entry. The fallbacks exist for\n426\t// Windows: os.Symlink there requires Developer Mode or admin, and silently\n427\t// breaks `entire plugin install` for typical users without either. Mirrors\n428\t// the pattern in setup_test.go's copyExecutable.\n429\t//\n430\t// On a successful copy the file mode of the source is preserved so the\n431\t// executable bit survives.\n432\tfunc materializeManagedEntry(src, dest string, srcInfo os.FileInfo) error {\n433\t\tif err := os.Symlink(src, dest); err == nil {\n434\t\t\treturn nil\n435\t\t}\n436\t\tif err := os.Link(src, dest); err == nil {\n437\t\t\treturn nil\n438\t\t}\n439\t\treturn copyFileStreaming(src, dest, srcInfo)\n440\t}\n441\t\n442\t// copyFileStreaming copies src to dest in fixed-size buffers, preserving the\n443\t// source's executable mode. Plugin binaries can be tens of megabytes; using\n444\t// io.Copy avoids the heap spike of reading the whole file into memory.\n445\tfunc copyFileStreaming(src, dest string, srcInfo os.FileInfo) error {\n446\t\tmode := srcInfo.Mode().Perm()\n447\t\tif mode == 0 {\n448\t\t\tmode = 0o755\n449\t\t}\n450\t\tin, err := os.Open(src) //nolint:gosec // src is the user-provided plugin executable; reading it is the point\n451\t\tif err != nil {\n452\t\t\treturn fmt.Errorf(\"open source for copy fallback: %w\", err)\n453\t\t}\n454\t\tdefer in.Close()\n455\t\n456\t\t// G304: dest is always inside the managed bin dir. The basename comes\n457\t\t// from a validated plugin name (validatePluginName ran upstream), and\n458\t\t// the parent dir comes from EnsurePluginBinDir.\n459\t\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode) //nolint:gosec // dest is constrained to the managed bin dir\n460\t\tif err != nil {\n461\t\t\treturn fmt.Errorf(\"open destination for copy fallback: %w\", err)\n462\t\t}\n463\t\tif _, err := io.Copy(out, in); err != nil {\n464\t\t\t_ = out.Close()\n465\t\t\t_ = os.Remove(dest)\n466\t\t\treturn fmt.Errorf(\"copy fallback: %w\", err)\n467\t\t}\n468\t\tif err := out.Close(); err != nil {\n469\t\t\t_ = os.Remove(dest)\n470\t\t\treturn fmt.Errorf(\"close destination after copy fallback: %w\", err)\n471\t\t}\n472\t\treturn nil\n473\t}\n474\t\n475\t// RemoveInstalledPlugin removes every managed-dir entry whose bare name\n476\t// matches name. Symlinks are unlinked without touching the source file.\n477\t//\n478\t// Iterating all variants matters on Windows, where entire-foo.exe,\n479\t// entire-foo.bat, and entire-foo.cmd all map to bare name \"foo\" and could\n480\t// otherwise leave a runnable variant behind after `entire plugin remove foo`.\n481\t// On Unix the loop typically runs once.\n482\tfunc RemoveInstalledPlugin(name string) error {\n483\t\tvariants, err := installedVariantsByBareName(name)\n484\t\tif err != nil {\n485\t\t\treturn err\n486\t\t}\n487\t\tif len(variants) == 0 {\n488\t\t\treturn fmt.Errorf(\"plugin %q is not installed in the managed directory\", name)\n489\t\t}\n490\t\tfor _, p := range variants {\n491\t\t\tif err := os.Remove(p.Path); err != nil && !errors.Is(err, os.ErrNotExist) {\n492\t\t\t\treturn fmt.Errorf(\"remove plugin entry %s: %w\", p.Path, err)\n493\t\t\t}\n494\t\t}\n495\t\treturn nil\n496\t}\n497\t\n498\t// bareNameFromBinaryName turns a plugin executable's basename into the bare\n499\t// name the dispatcher uses (e.g. \"entire-pgr\" → \"pgr\"). Returns \"\" if the\n500\t// input doesn't match the expected shape.\n501\t//\n502\t// Extension stripping is platform-conditional:\n503\t//\n504\t//   - On Windows, .exe/.bat/.cmd are the natural extensions for executables\n505\t//     and exec.LookPath resolves them via PATHEXT, so we strip them so the\n506\t//     bare name a user types (\"pgr\") matches both the managed-list display\n507\t//     and the dispatcher's lookup.\n508\t//\n509\t//   - On Unix, exec.LookPath matches the exact filename. If we stripped here,\n510\t//     \"entire-pgr.exe\" would be listed as \"pgr\" and the user would type\n511\t//     \"entire pgr\", but the dispatcher's exec.LookPath(\"entire-pgr\") would\n512\t//     not find \"entire-pgr.exe\". Leaving the dot in place keeps the listed\n513\t//     name aligned with the only invocation that actually resolves\n514\t//     (\"entire pgr.exe\"), avoiding silent shadowing surprises.\n515\tfunc bareNameFromBinaryName(base string) string {\n516\t\tif !strings.HasPrefix(base, pluginBinaryPrefix) {\n517\t\t\treturn \"\"\n518\t\t}\n519\t\tcleaned := base\n520\t\tif runtime.GOOS == windowsGOOS {\n521\t\t\t// Reuse the canonical Windows-executable-extension list from\n522\t\t\t// agent/external rather than maintaining a parallel copy. plugin.go\n523\t\t\t// already depends on this package for isAgentProtocolBinary, so\n524\t\t\t// there's no new layering cost.\n525\t\t\tcleaned = external.StripExeExt(base)\n526\t\t}\n527\t\tbare := strings.TrimPrefix(cleaned, pluginBinaryPrefix)\n528\t\tif bare == \"\" {\n529\t\t\treturn \"\"\n530\t\t}\n531\t\treturn bare\n532\t}\n533\t"}]},"uuid":"50f30f0d-cfbc-4f59-b1ca-037a106ef714","timestamp":"2026-05-07T10:21:35.448Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/plugin_store.go","content":"package cli\n\nimport (\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/external\"\n)\n\n// Managed plugin storage. The kubectl-style dispatcher in plugin.go resolves\n// `entire-<name>` binaries from $PATH, period. To let `entire plugin install`\n// be additive rather than a parallel mechanism, this file provides:\n//\n//  1. PluginBinDir() — a per-user managed dir that main.go prepends to PATH\n//     before the dispatcher runs. Anything dropped here (or symlinked here)\n//     becomes invocable as `entire <name>` without the user fiddling with PATH.\n//\n//  2. PluginDataDir(name) — a per-plugin durable storage dir, passed to plugins\n//     as ENTIRE_PLUGIN_DATA_DIR. Independent of where the binary itself lives\n//     so plugins installed via PATH and via the managed dir get the same\n//     contract.\n//\n// Honors ENTIRE_PLUGIN_DIR as a parent-dir override; falls back to\n// XDG_DATA_HOME, then a platform default.\n\nconst (\n\tpluginEnvPluginDir      = \"ENTIRE_PLUGIN_DIR\"\n\tpluginManagedBinSubdir  = \"bin\"\n\tpluginManagedDataSubdir = \"data\"\n\tpluginEnvPluginData     = \"ENTIRE_PLUGIN_DATA_DIR\"\n\t// Path segments for the managed plugin tree. Kept as separate\n\t// segments (rather than \"entire/plugins\") so filepath.Join produces\n\t// platform-native separators on Windows.\n\tpluginManagedTopDir = \"entire\"\n\tpluginManagedSubDir = \"plugins\"\n)\n\n// pluginParentDir returns the per-user directory that holds the managed\n// plugin storage. Resolution, in order:\n//\n//  1. ENTIRE_PLUGIN_DIR (cross-platform override).\n//  2. On Windows: LOCALAPPDATA if set, else ~\\AppData\\Local\\entire\\plugins.\n//  3. On Unix: XDG_DATA_HOME if set, else ~/.local/share/entire/plugins.\n//\n// XDG_DATA_HOME is deliberately ignored on Windows even when set (e.g. in\n// MSYS/Cygwin) — Windows users expect Windows conventions, and routing\n// through XDG would produce a surprising location.\n//\n// os.UserHomeDir is called only when no env-var branch resolves, so a\n// degenerate environment with $LOCALAPPDATA or $XDG_DATA_HOME but no home\n// still returns a usable path.\nfunc pluginParentDir() (string, error) {\n\tif v := os.Getenv(pluginEnvPluginDir); v != \"\" {\n\t\treturn v, nil\n\t}\n\tif runtime.GOOS == windowsGOOS {\n\t\tif appData := os.Getenv(\"LOCALAPPDATA\"); appData != \"\" {\n\t\t\treturn filepath.Join(appData, pluginManagedTopDir, pluginManagedSubDir), nil\n\t\t}\n\t\thome, err := os.UserHomeDir()\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n\t\t}\n\t\treturn filepath.Join(home, \"AppData\", \"Local\", pluginManagedTopDir, pluginManagedSubDir), nil\n\t}\n\tif v := os.Getenv(\"XDG_DATA_HOME\"); v != \"\" {\n\t\treturn filepath.Join(v, pluginManagedTopDir, pluginManagedSubDir), nil\n\t}\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve home dir: %w\", err)\n\t}\n\treturn filepath.Join(home, \".local\", \"share\", pluginManagedTopDir, pluginManagedSubDir), nil\n}\n\n// PluginBinDir returns the managed install directory. Binaries (or symlinks)\n// placed here are auto-discovered by the kubectl-style dispatcher because\n// main.go prepends this dir to PATH before MaybeRunPlugin runs.\nfunc PluginBinDir() (string, error) {\n\tparent, err := pluginParentDir()\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn filepath.Join(parent, pluginManagedBinSubdir), nil\n}\n\n// PluginDataDir returns the per-plugin data directory for the given bare name\n// (e.g. \"pgr\" for `entire-pgr`). The returned path is not created — that's\n// the plugin's responsibility on first use.\n//\n// Returns an error for names the dispatcher would never invoke (empty,\n// flag-shaped, agent-protocol-reserved, \".\"/\"..\" path-traversal, slashes).\n// This guarantees ENTIRE_PLUGIN_DATA_DIR always points inside the managed\n// data subtree.\nfunc PluginDataDir(name string) (string, error) {\n\tif err := validatePluginName(name); err != nil {\n\t\treturn \"\", err\n\t}\n\tparent, err := pluginParentDir()\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn filepath.Join(parent, pluginManagedDataSubdir, name), nil\n}\n\n// validatePluginName mirrors the dispatcher's isPluginCandidate rules and\n// returns a descriptive error for invalid names. Used by every entry point\n// that takes a plugin name from outside the dispatcher (data dir resolution,\n// managed-dir install).\nfunc validatePluginName(name string) error {\n\tif name == \"\" {\n\t\treturn errors.New(\"plugin name is empty\")\n\t}\n\tif strings.HasPrefix(name, \"-\") {\n\t\treturn fmt.Errorf(\"plugin name %q must not start with '-'\", name)\n\t}\n\tif strings.HasPrefix(name, \"agent-\") {\n\t\treturn fmt.Errorf(\"plugin name %q is reserved for the external agent protocol\", name)\n\t}\n\tif strings.ContainsAny(name, `/\\`) {\n\t\treturn fmt.Errorf(\"plugin name %q must not contain path separators\", name)\n\t}\n\tif name == \".\" || name == \"..\" {\n\t\treturn fmt.Errorf(\"plugin name %q is not a valid identifier\", name)\n\t}\n\treturn nil\n}\n\n// EnsurePluginBinDir creates the managed install dir if it doesn't exist.\nfunc EnsurePluginBinDir() (string, error) {\n\tdir, err := PluginBinDir()\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := os.MkdirAll(dir, 0o750); err != nil {\n\t\treturn \"\", fmt.Errorf(\"create plugin bin dir: %w\", err)\n\t}\n\treturn dir, nil\n}\n\n// PrependPluginBinDirToPATH prepends the managed bin dir to the process's\n// PATH so the kubectl dispatcher discovers managed-installed plugins.\n// Idempotent against an already-prepended dir.\n//\n// Returns a restore closure the caller invokes to revert PATH to its\n// previous value. Restoring matters when no plugin runs: built-in commands\n// and the subprocesses they spawn (git, hooks, less, …) should see the\n// user's original PATH, not one with the managed plugin dir prepended.\n// When a plugin *is* dispatched, callers can simply skip the restore — the\n// process exits anyway, and the plugin child intentionally inherits the\n// prepended PATH so it can spawn sibling managed plugins.\n//\n// Errors and no-op cases (already-prepended, lookup failure) return a\n// no-op restore so callers always have a safe func to call.\nfunc PrependPluginBinDirToPATH() func() {\n\tdir, err := PluginBinDir()\n\tif err != nil || dir == \"\" {\n\t\treturn func() {}\n\t}\n\tprev := os.Getenv(\"PATH\")\n\tsep := string(os.PathListSeparator)\n\tif prev == \"\" {\n\t\tif err := os.Setenv(\"PATH\", dir); err != nil {\n\t\t\treturn func() {}\n\t\t}\n\t\treturn func() { _ = os.Setenv(\"PATH\", \"\") }\n\t}\n\t// Idempotent: if the first entry already matches, leave PATH alone.\n\t// Windows PATH lookups are case-insensitive (`C:\\Foo` and `c:\\foo`\n\t// resolve identically), so a case-different first entry is the same\n\t// dir and we should not double-prepend.\n\tfirst := prev\n\tif i := strings.Index(prev, sep); i >= 0 {\n\t\tfirst = prev[:i]\n\t}\n\tif pathEntriesEqual(first, dir) {\n\t\treturn func() {}\n\t}\n\tif err := os.Setenv(\"PATH\", dir+sep+prev); err != nil {\n\t\treturn func() {}\n\t}\n\treturn func() { _ = os.Setenv(\"PATH\", prev) }\n}\n\n// pathEntriesEqual reports whether two PATH entries refer to the same dir.\n// filepath.Clean normalizes trailing separators and (on Windows) slash\n// orientation; case folding handles Windows' case-insensitive lookup.\nfunc pathEntriesEqual(a, b string) bool {\n\ta = filepath.Clean(a)\n\tb = filepath.Clean(b)\n\tif runtime.GOOS == windowsGOOS {\n\t\treturn strings.EqualFold(a, b)\n\t}\n\treturn a == b\n}\n\n// InstalledPlugin describes a single entry in the managed bin dir.\ntype InstalledPlugin struct {\n\t// Name is the bare plugin name (without the `entire-` prefix and any\n\t// platform-specific extension).\n\tName string\n\t// Path is the absolute path inside the managed bin dir.\n\tPath string\n\t// Symlink is true when Path is a symlink to a source location elsewhere\n\t// (the typical local-dev install). LinkTarget is populated in that case.\n\tSymlink    bool\n\tLinkTarget string\n}\n\n// ListInstalledPlugins enumerates entries in the managed bin dir whose name\n// starts with `entire-`. Sorted by bare name. A missing dir returns no error\n// and an empty slice.\nfunc ListInstalledPlugins() ([]*InstalledPlugin, error) {\n\tdir, err := PluginBinDir()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn nil, nil\n\t\t}\n\t\treturn nil, fmt.Errorf(\"read plugin bin dir: %w\", err)\n\t}\n\n\tvar out []*InstalledPlugin\n\tfor _, e := range entries {\n\t\tfull := e.Name()\n\t\tif !strings.HasPrefix(full, pluginBinaryPrefix) {\n\t\t\tcontinue\n\t\t}\n\t\tbare := bareNameFromBinaryName(full)\n\t\tif bare == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tpath := filepath.Join(dir, full)\n\t\tinfo, err := os.Lstat(path)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tip := &InstalledPlugin{Name: bare, Path: path}\n\t\tif info.Mode()&os.ModeSymlink != 0 {\n\t\t\tip.Symlink = true\n\t\t\tif target, err := os.Readlink(path); err == nil {\n\t\t\t\tip.LinkTarget = target\n\t\t\t}\n\t\t}\n\t\tout = append(out, ip)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })\n\treturn out, nil\n}\n\n// FindInstalledPlugin returns the entry for the given bare name, or nil if\n// it isn't installed in the managed dir.\nfunc FindInstalledPlugin(name string) (*InstalledPlugin, error) {\n\tall, err := ListInstalledPlugins()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfor _, p := range all {\n\t\tif p.Name == name {\n\t\t\treturn p, nil\n\t\t}\n\t}\n\treturn nil, nil //nolint:nilnil // not-installed signal\n}\n\n// InstallPluginOptions configures InstallPluginFromPath.\ntype InstallPluginOptions struct {\n\t// SourcePath is the absolute (or working-dir-relative) path to the plugin\n\t// executable. Its basename — minus any platform extension — must match\n\t// `entire-<name>` so the dispatcher can resolve it.\n\tSourcePath string\n\t// Force replaces an already-installed plugin with the same name.\n\tForce bool\n}\n\n// InstallPluginFromPath symlinks SourcePath into the managed bin dir. The\n// caller is responsible for built-in conflict checks (resolvePlugin already\n// gates dispatch on rootCmd.Find — installing a name that shadows a built-in\n// is allowed but the built-in still wins at runtime).\n//\n// Refuses names the dispatcher will never invoke (agent-protocol prefix,\n// flag-shaped, \".\"/\"..\", slashes), and refuses self-install when the source\n// is the same file as the would-be managed entry. The replace step is\n// atomic: a new symlink is created at <dest>.tmp and renamed onto <dest>,\n// so a failed --force never leaves the previous install missing.\nfunc InstallPluginFromPath(opts InstallPluginOptions) (*InstalledPlugin, error) {\n\tsrc, err := filepath.Abs(opts.SourcePath)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"resolve source path: %w\", err)\n\t}\n\tsrcInfo, err := os.Stat(src)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"stat source: %w\", err)\n\t}\n\tif srcInfo.IsDir() {\n\t\treturn nil, fmt.Errorf(\"source must be a file, got directory: %s\", src)\n\t}\n\tbase := filepath.Base(src)\n\tbare := bareNameFromBinaryName(base)\n\tif bare == \"\" {\n\t\treturn nil, fmt.Errorf(\"source basename %q must start with %q and have a runnable name\", base, pluginBinaryPrefix)\n\t}\n\tif err := validatePluginName(bare); err != nil {\n\t\treturn nil, fmt.Errorf(\"derived plugin name from %q is not dispatchable: %w\", base, err)\n\t}\n\tif runtime.GOOS != windowsGOOS && srcInfo.Mode()&0o111 == 0 {\n\t\treturn nil, fmt.Errorf(\"source %s is not executable (chmod +x)\", src)\n\t}\n\n\tbinDir, err := EnsurePluginBinDir()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdest := filepath.Join(binDir, base)\n\n\t// Reject self-install: the source path already equals the managed\n\t// destination path. Without this guard, `--force` would atomically\n\t// rename a tmp symlink onto its own target file and the underlying\n\t// binary would be unlinked.\n\t//\n\t// We deliberately do NOT use os.SameFile here. The legitimate\n\t// repeat-install case has dest as a symlink we created on a prior\n\t// install; SameFile would resolve dest through the symlink to src\n\t// and falsely trip. Path equality is the precise risky case.\n\tif filepath.Clean(src) == filepath.Clean(dest) {\n\t\treturn nil, fmt.Errorf(\"source %s is already the managed entry; nothing to install\", src)\n\t}\n\n\t// Conflict check on the bare name (not the exact filename). On Windows,\n\t// entire-foo.exe / .bat / .cmd all map to bare name \"foo\"; checking only\n\t// the destination filename would let a second install of a different\n\t// extension silently coexist with the first, with PATHEXT ordering then\n\t// deciding which one runs. List all variants and require --force when\n\t// any exist.\n\tconflicts, err := installedVariantsByBareName(bare)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(conflicts) > 0 && !opts.Force {\n\t\treturn nil, fmt.Errorf(\"plugin %q already installed at %s; use --force to replace\", bare, conflicts[0].Path)\n\t}\n\t// With --force, remove every variant other than the one we're about to\n\t// atomically overwrite. The same-extension case is handled by the\n\t// rename below, which atomically replaces dest.\n\tfor _, c := range conflicts {\n\t\tif filepath.Clean(c.Path) == filepath.Clean(dest) {\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.Remove(c.Path); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\treturn nil, fmt.Errorf(\"remove existing variant %s: %w\", c.Path, err)\n\t\t}\n\t}\n\n\t// Atomic replace via tmp + rename. Rename is atomic on POSIX and\n\t// replaces an existing target on Windows (Go's os.Rename uses\n\t// MoveFileEx with MOVEFILE_RE