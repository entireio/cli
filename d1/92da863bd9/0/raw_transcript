x := range []string{\n\t\tEnvSession + \"=\",\n\t\tEnvAgent + \"=\",\n\t\tEnvSkills + \"=\",\n\t\tEnvPrompt + \"=\",\n\t\tEnvStartingSHA + \"=\",\n\t} {\n\t\tif strings.HasPrefix(kv, prefix) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","exit_code":0,"duration":{"secs":0,"nanos":6834},"formatted_output":"","status":"completed"}}
