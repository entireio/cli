func (m reviewTUIModel) headerLine() string {\n   361\t\treturn fmt.Sprintf(\"%-20s  %-10s  %-8s  %-8s  %s\",\n   362\t\t\t\"AGENT\", \"STATUS\", \"DURATION\", \"TOKENS\", \"PREVIEW\")\n   363\t}\n   364\t\n   365\t// renderRow renders one agent row.\n   366\tfunc (m reviewTUIModel) renderRow(row agentRow) string {\n   367\t\tname := stringutil.TruncateRunes(row.name, 20, \"…\")\n   368\t\n   369\t\tvar statusStr string\n   370\t\tswitch row.status {\n   371\t\tcase reviewtypes.AgentStatusSucceeded:\n   372\t\t\tstatusStr = \"✓ done\"\n   373\t\tcase reviewtypes.AgentStatusFailed:\n   374\t\t\tstatusStr = \"✗ failed\"\n   375\t\tcase reviewtypes.AgentStatusCancelled:\n   376\t\t\tstatusStr = \"— cancel\"\n   377\t\tcase reviewtypes.AgentStatusUnknown:\n   378\t\t\tif row.runStart.IsZero() {\n   379\t\t\t\tstatusStr = \"queued\"\n   380\t\t\t} else {\n   381\t\t\t\tstatusStr = m.spinner.View() + \" running\"\n   382\t\t\t}\n   383\t\t}\n   384\t\n   385\t\tdurStr := \"\"\n   386\t\tif !row.runStart.IsZero() {\n   387\t\t\tif !row.runEnd.IsZero() {\n   388\t\t\t\tdurStr = formatDuration(row.runEnd.Sub(row.runStart))\n   389\t\t\t} else {\n   390\t\t\t\tdurStr = formatDuration(time.Since(row.runStart))\n   391\t\t\t}\n   392\t\t}\n   393\t\n   394\t\ttokStr := \"\"\n   395\t\tif row.tokens.In > 0 || row.tokens.Out > 0 {\n   396\t\t\ttokStr = fmt.Sprintf(\"%s/%s\", formatCompact(row.tokens.In), formatCompact(row.tokens.Out))\n   397\t\t}\n   398\t\n   399\t\tpreview := stringutil.TruncateRunes(row.preview, 40, \"…\")\n   400\t\n   401\t\treturn fmt.Sprintf(\"%-20s  %-10s  %-8s  %-8s  %s\",\n   402\t\t\tname, statusStr, durStr, tokStr, preview)\n   403\t}\n   404\t\n   405\t// countsLine produces the summary line shown after the run finishes.\n   406\tfunc (m reviewTUIModel) countsLine() string {\n   407\t\tsucc, fail, canc := 0, 0, 0\n   408\t\tfor _, r := range m.summary.AgentRuns {\n   409\t\t\tswitch r.Status {\n   410\t\t\tcase reviewtypes.AgentStatusSucceeded:\n   411\t\t\t\tsucc++\n   412\t\t\tcase reviewtypes.AgentStatusFailed:\n   413\t\t\t\tfail++\n   414\t\t\tcase reviewtypes.AgentStatusCancelled:\n   415\t\t\t\tcanc++\n   416\t\t\tcase reviewtypes.AgentStatusUnknown:\n   417\t\t\t\t// not counted\n   418\t\t\t}\n   419\t\t}\n   420\t\treturn fmt.Sprintf(\"%d agent(s) done — %d succeeded, %d failed, %d cancelled\",\n   421\t\t\tlen(m.summary.AgentRuns), succ, fail, canc)\n   422\t}\n   423\t\n   424\t// formatDuration formats a duration compactly for the table column.\n   425\tfunc formatDuration(d time.Duration) string {\n   426\t\tif d < time.Second {\n   427\t\t\treturn fmt.Sprintf(\"%dms\", d.Milliseconds())\n   428\t\t}\n   429\t\tif d < time.Minute {\n   430\t\t\treturn fmt.Sprintf(\"%.1fs\", d.Seconds())\n   431\t\t}\n   432\t\treturn fmt.Sprintf(\"%dm%ds\", int(d.Minutes()), int(d.Seconds())%60)\n   433\t}\n   434\t\n   435\t// formatCompact formats a token count as e.g. \"1.2k\" or \"450\".\n   436\tfunc formatCompact(n int) string {\n   437\t\tif n >= 1000 {\n   438\t\t\treturn fmt.Sprintf(\"%.1fk\", float64(n)/1000)\n   439\t\t}\n   440\t\treturn strconv.Itoa(n)\n   441\t}\n"}}
