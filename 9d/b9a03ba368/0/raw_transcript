{"parentUuid":"82a548d8-34b7-4a3b-b916-729aeaa60617","isSidechain":false,"promptId":"cd3a38bb-7823-4b99-992e-32d2fd2b3b52","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QA6Y9ymSDvMCfqE3q4UvrG","type":"tool_result","content":"1\tpackage strategy\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"log/slog\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n18\t)\n19\t\n20\t// Session state management functions shared across all strategies.\n21\t// SessionState is stored in .git/entire-sessions/{session_id}.json\n22\t\n23\t// getSessionStateDir returns the path to the session state directory.\n24\t// This is stored in the git common dir so it's shared across all worktrees.\n25\tfunc getSessionStateDir(ctx context.Context) (string, error) {\n26\t\tcommonDir, err := GetGitCommonDir(ctx)\n27\t\tif err != nil {\n28\t\t\treturn \"\", err\n29\t\t}\n30\t\treturn filepath.Join(commonDir, session.SessionStateDirName), nil\n31\t}\n32\t\n33\t// sessionStateFile returns the path to a session state file.\n34\tfunc sessionStateFile(ctx context.Context, sessionID string) (string, error) {\n35\t\tstateDir, err := getSessionStateDir(ctx)\n36\t\tif err != nil {\n37\t\t\treturn \"\", err\n38\t\t}\n39\t\treturn filepath.Join(stateDir, sessionID+\".json\"), nil\n40\t}\n41\t\n42\t// LoadSessionState loads the session state for the given session ID.\n43\t// Returns (nil, nil) when session file doesn't exist or session is stale (not an error condition).\n44\t// Stale sessions are automatically deleted by the underlying StateStore.\n45\tfunc LoadSessionState(ctx context.Context, sessionID string) (*SessionState, error) {\n46\t\tstore, err := session.NewStateStore(ctx)\n47\t\tif err != nil {\n48\t\t\treturn nil, fmt.Errorf(\"failed to create state store: %w\", err)\n49\t\t}\n50\t\n51\t\tstate, err := store.Load(ctx, sessionID)\n52\t\tif err != nil {\n53\t\t\treturn nil, fmt.Errorf(\"failed to load session state: %w\", err)\n54\t\t}\n55\t\treturn state, nil\n56\t}\n57\t\n58\t// SaveSessionState saves the session state atomically.\n59\tfunc SaveSessionState(ctx context.Context, state *SessionState) error {\n60\t\tstore, err := session.NewStateStore(ctx)\n61\t\tif err != nil {\n62\t\t\treturn fmt.Errorf(\"failed to create state store: %w\", err)\n63\t\t}\n64\t\n65\t\tif err := store.Save(ctx, state); err != nil {\n66\t\t\treturn fmt.Errorf(\"failed to save session state: %w\", err)\n67\t\t}\n68\t\treturn nil\n69\t}\n70\t\n71\t// ListSessionStates returns all session states from the state directory.\n72\t// This is a package-level function that doesn't require a specific strategy instance.\n73\tfunc ListSessionStates(ctx context.Context) ([]*SessionState, error) {\n74\t\tstore, err := session.NewStateStore(ctx)\n75\t\tif err != nil {\n76\t\t\treturn nil, fmt.Errorf(\"failed to create state store: %w\", err)\n77\t\t}\n78\t\n79\t\tstates, err := store.List(ctx)\n80\t\tif err != nil {\n81\t\t\treturn nil, fmt.Errorf(\"failed to list session states: %w\", err)\n82\t\t}\n83\t\treturn states, nil\n84\t}\n85\t\n86\t// FindMostRecentSession returns the session ID of the most recently interacted session\n87\t// (by LastInteractionTime) in the current worktree. Returns empty string if no sessions exist.\n88\t// Scoping to the current worktree prevents cross-worktree pollution in log routing.\n89\t// Falls back to unfiltered search if the worktree path can't be determined.\n90\tfunc FindMostRecentSession(ctx context.Context) string {\n91\t\tstates, err := ListSessionStates(ctx)\n92\t\tif err != nil || len(states) == 0 {\n93\t\t\treturn \"\"\n94\t\t}\n95\t\n96\t\t// Scope to current worktree to prevent cross-worktree pollution.\n97\t\tworktreePath, wpErr := paths.WorktreeRoot(ctx)\n98\t\tif wpErr == nil && worktreePath != \"\" {\n99\t\t\tvar filtered []*SessionState\n100\t\t\tfor _, s := range states {\n101\t\t\t\tif s.WorktreePath == worktreePath {\n102\t\t\t\t\tfiltered = append(filtered, s)\n103\t\t\t\t}\n104\t\t\t}\n105\t\t\tif len(filtered) > 0 {\n106\t\t\t\tstates = filtered\n107\t\t\t}\n108\t\t\t// If no sessions match the worktree, fall back to all sessions\n109\t\t}\n110\t\n111\t\tvar best *SessionState\n112\t\tfor _, s := range states {\n113\t\t\tif s.LastInteractionTime == nil {\n114\t\t\t\tcontinue\n115\t\t\t}\n116\t\t\tif best == nil || s.LastInteractionTime.After(*best.LastInteractionTime) {\n117\t\t\t\tbest = s\n118\t\t\t}\n119\t\t}\n120\t\tif best != nil {\n121\t\t\treturn best.SessionID\n122\t\t}\n123\t\n124\t\t// Fallback: return most recently started session\n125\t\tfor _, s := range states {\n126\t\t\tif best == nil || s.StartedAt.After(best.StartedAt) {\n127\t\t\t\tbest = s\n128\t\t\t}\n129\t\t}\n130\t\tif best != nil {\n131\t\t\treturn best.SessionID\n132\t\t}\n133\t\treturn \"\"\n134\t}\n135\t\n136\t// TransitionAndLog runs a session phase transition, applies actions via the\n137\t// handler, and logs the transition. Returns the first handler error from\n138\t// ApplyTransition (if any) so callers can surface it. The error is also\n139\t// logged internally for diagnostics.\n140\t// This is the single entry point for all state machine transitions to ensure\n141\t// consistent logging of phase changes.\n142\tfunc TransitionAndLog(goCtx context.Context, state *SessionState, event session.Event, ctx session.TransitionContext, handler session.ActionHandler) error {\n143\t\toldPhase := state.Phase\n144\t\tresult := session.Transition(oldPhase, event, ctx)\n145\t\tlogCtx := logging.WithComponent(goCtx, \"session\")\n146\t\n147\t\thandlerErr := session.ApplyTransition(goCtx, state, result, handler)\n148\t\tif handlerErr != nil {\n149\t\t\tlogging.Error(logCtx, \"action handler error during transition\",\n150\t\t\t\tslog.String(\"session_id\", state.SessionID),\n151\t\t\t\tslog.String(\"event\", event.String()),\n152\t\t\t\tslog.Any(\"error\", handlerErr),\n153\t\t\t)\n154\t\t}\n155\t\n156\t\tif result.NewPhase != oldPhase {\n157\t\t\tlogging.Info(logCtx, \"phase transition\",\n158\t\t\t\tslog.String(\"session_id\", state.SessionID),\n159\t\t\t\tslog.String(\"event\", event.String()),\n160\t\t\t\tslog.String(\"from\", string(oldPhase)),\n161\t\t\t\tslog.String(\"to\", string(result.NewPhase)),\n162\t\t\t)\n163\t\t} else {\n164\t\t\tlogging.Debug(logCtx, \"phase unchanged\",\n165\t\t\t\tslog.String(\"session_id\", state.SessionID),\n166\t\t\t\tslog.String(\"event\", event.String()),\n167\t\t\t\tslog.String(\"phase\", string(result.NewPhase)),\n168\t\t\t\tslog.Any(\"result\", result),\n169\t\t\t)\n170\t\t}\n171\t\n172\t\tif handlerErr != nil {\n173\t\t\treturn fmt.Errorf(\"transition %s: %w\", event, handlerErr)\n174\t\t}\n175\t\treturn nil\n176\t}\n177\t\n178\t// StoreModelHint writes the LLM model name to a lightweight hint file\n179\t// (.git/entire-sessions/{session_id}.model) for cross-process persistence.\n180\t//\n181\t// Why a separate file instead of SessionState?\n182\t//\n183\t// SessionState requires BaseCommit (used for shadow branch naming, checkpoint\n184\t// writing, doctor classification, etc.) and is only created during TurnStart\n185\t// when the git repo is fully inspected. Some agents report the model on earlier\n186\t// hooks that fire as separate CLI processes before TurnStart:\n187\t//\n188\t//   - Claude Code sends \"model\" on SessionStart (before any TurnStart)\n189\t//   - Gemini CLI sends \"llm_request.model\" on BeforeModel (after TurnStart,\n190\t//     so handleLifecycleModelUpdate writes to SessionState directly when it\n191\t//     exists and only falls back to this hint file otherwise)\n192\t//\n193\t// The hint is read by handleLifecycleTurnStart/TurnEnd when event.Model is\n194\t// empty, passed to InitializeSession, and persisted in state.ModelName. After\n195\t// that the hint file is redundant — it sits unused until ClearSessionState\n196\t// removes it alongside the session state file.\n197\tfunc StoreModelHint(ctx context.Context, sessionID, model string) error {\n198\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n199\t\t\treturn fmt.Errorf(\"invalid session ID: %w\", err)\n200\t\t}\n201\t\tif model == \"\" {\n202\t\t\treturn nil\n203\t\t}\n204\t\n205\t\tstateDir, err := getSessionStateDir(ctx)\n206\t\tif err != nil {\n207\t\t\treturn fmt.Errorf(\"failed to get session state directory: %w\", err)\n208\t\t}\n209\t\tif err := os.MkdirAll(stateDir, 0o750); err != nil {\n210\t\t\treturn fmt.Errorf(\"failed to create session state directory: %w\", err)\n211\t\t}\n212\t\n213\t\thintFile := filepath.Join(stateDir, sessionID+\".model\")\n214\t\tif err := os.WriteFile(hintFile, []byte(model), 0o600); err != nil {\n215\t\t\treturn fmt.Errorf(\"failed to write model hint file: %w\", err)\n216\t\t}\n217\t\treturn nil\n218\t}\n219\t\n220\t// LoadModelHint reads the LLM model name from the hint file for the given session.\n221\t// Returns empty string if the hint file doesn't exist or can't be read.\n222\tfunc LoadModelHint(ctx context.Context, sessionID string) string {\n223\t\tif err := validation.ValidateSessionID(sessionID); err != nil {\n224\t\t\treturn \"\"\n225\t\t}\n226\t\n227\t\tstateDir, err := getSessionStateDir(ctx)\n228\t\tif err != nil {\n229\t\t\tlogging.Warn(logging.WithComponent(ctx, \"session\"), \"failed to resolve state dir for model hint\",\n230\t\t\t\tslog.String(\"session_id\", sessionID),\n231\t\t\t\tslog.Any(\"error\", err))\n232\t\t\treturn \"\"\n233\t\t}\n234\t\n235\t\thintPath := filepath.Join(stateDir, sessionID+\".model\")\n236\t\tdata, err := os.ReadFile(hintPath) //nolint:gosec // sessionID is validated above\n237\t\tif err != nil {\n238\t\t\tif !os.IsNotExist(err) {\n239\t\t\t\tlogging.Warn(logging.WithComponent(ctx, \"session\"), \"failed to read model hint file\",\n240\t\t\t\t\tslog.String(\"path\", hintPath),\n241\t\t\t\t\tslog.Any(\"error\", err))\n242\t\t\t}\n243\t\t\treturn \"\"\n244\t\t}\n245\t\treturn strings.TrimSpace(string(data))\n246\t}\n247\t\n248\t// StoreAgentTypeHint records the agent type that owns a session before\n249\t// SessionState exists. Used by the lifecycle dispatcher when SessionStart fires\n250\t// (state isn't created until TurnStart, so we need a place to remember which\n251\t// agent claimed the session first).\n252\t//\n253\t// Semantics: first writer wins. When multiple agents fire hooks for the same\n254\t// session ID — e.g., Cursor IDE running cursor-agent while also forwarding to\n255\t// Claude Code's hook system — only the agent that fires SessionStart first\n256\t// gets recorded. Subsequent calls return nil without overwriting.\n257\t//\n258\t// At TurnStart, InitializeSession reads this hint to override agentType when\n259\t// the hook firing isn't the same agent that owns the session. After the state\n260\t// file is written, the hint is unused but remains until ClearSessionState\n261\t// removes it alongside the state file.\n262\t//\n263\t// Returns (created=true) when this call wrote the hint, (created=false) when\n264\t// the hint already existed (no-op) or agentType was empty/Unknown.\n265\t//\n266\t// Banner display is gated separately via ClaimSessionStartBanner — winning\n267\t// the ownership claim does NOT mean this agent should also print the banner,\n268\t// because the winner may not implement HookResponseWriter (e.g., Cursor).\n269\tfunc StoreAgentTypeHint(ctx context.Context, sessionID string, agentType types.AgentType) (created bool, err error) {\n270\t\tif vErr := validation.ValidateSessionID(sessionID); vErr != nil {\n271\t\t\treturn false, fmt.Errorf(\"invalid session ID: %w\", vErr)\n272\t\t}\n273\t\tif agentType == \"\" || agentType == agent.AgentType