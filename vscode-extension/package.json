{
  "name": "entire-checkpoint-intelligence",
  "displayName": "Entire Checkpoint Intelligence",
  "description": "VS Code Extension providing Repository -> GitHub Milestone -> Requirement Workflow & Audit Dashboard",
  "version": "1.0.0",
  "publisher": "entireio",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:entire-requirements-view",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "entire-intelligence-sidebar",
          "title": "Entire Intelligence",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "entire-intelligence-sidebar": [
        {
          "id": "entire-requirements-view",
          "name": "GitHub Requirement Workflow",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "entire.openRequirementsView",
        "title": "Entire Intelligence: Open Requirement Workflow"
      }
    ]
  }
}
