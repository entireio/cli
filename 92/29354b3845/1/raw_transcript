TranscriptPath == \"\" || state.AgentType == \"\" {\n1801\t\t\treturn false\n1802\t\t}\n1803\t\n1804\t\t// Re-resolve transcript path — handles agents that relocate transcripts mid-session.\n1805\t\tif _, resolveErr := resolveTranscriptPath(state); resolveErr != nil {\n1806\t\t\tlogging.Debug(logCtx, \"hasNewTranscriptWork: transcript path resolution failed\",\n1807\t\t\t\tslog.String(\"session_id\", state.SessionID),\n1808\t\t\t\tslog.Any(\"error\", resolveErr),\n1809\t\t\t)\n1810\t\t\treturn false\n1811\t\t}\n1812\t\n1813\t\tag, err := agent.GetByAgentType(state.AgentType)\n1814\t\tif err != nil {\n1815\t\t\treturn false\n1816\t\t}\n1817\t\n1818\t\t// Ensure transcript file is up-to-date (OpenCode creates/refreshes it via `opencode export`).\n1819\t\t// Only wait for flush when the session is active — for idle/ended sessions the\n1820\t\t// transcript is already fully flushed (the Stop hook completed the flush).\n1821\t\tif state.Phase.IsActive() {\n1822\t\t\tif preparer, ok := agent.AsTranscriptPreparer(ag); ok {\n1823\t\t\t\tif prepErr := preparer.PrepareTranscript(ctx, state.TranscriptPath); prepErr != nil {\n1824\t\t\t\t\tlogging.Debug(logCtx, \"prepare transcript failed\",\n1825\t\t\t\t\t\tslog.String(\"session_id\", state.SessionID),\n1826\t\t\t\t\t\tslog.String(\"agent_type\", string(state.AgentType)),\n1827\t\t\t\t\t\tslog.String(\"transcript_path\", state.TranscriptPath),\n1828\t\t\t\t\t\tslog.Any(\"error\", prepErr),\n1829\t\t\t\t\t)\n1830\t\t\t\t}\n1831\t\t\t}\n1832\t\t}\n1833\t\tanalyzer, ok := agent.AsTranscriptAnalyzer(ag)\n1834\t\tif !ok {\n1835\t\t\treturn false\n1836\t\t}\n1837\t\n1838\t\tcurrentPos, err := analyzer.GetTranscriptPosition(state.TranscriptPath)\n1839\t\tif err != nil {\n1840\t\t\tlogging.Debug(logCtx, \"hasNewTranscriptWork: GetTranscriptPosition failed\",\n1841\t\t\t\tslog.String(\"session_id\", state.SessionID),\n1842\t\t\t\tslog.String(\"transcript_path\", state.TranscriptPath),\n1843\t\t\t\tslog.Any(\"error\", err),\n1844\t\t\t)