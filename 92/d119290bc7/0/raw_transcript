n   117→\t\t}\n   118→\t\tif i > 0 {\n   119→\t\t\tresult = append(result, []byte(\"\\n\\n--- Next commit ---\\n\\n\")...)\n   120→\t\t}\n   121→\t\tresult = append(result, log...)\n   122→\t}\n   123→\n   124→\tif len(result) == 0 {\n   125→\t\treturn s.getSessionLogFromShadow(sessionID)\n   126→\t}\n   127→\n   128→\treturn result, nil\n   129→}\n   130→\n   131→// getSessionLogFromShadow gets transcript from active shadow branch.\n   132→func (s *ManualCommitStrategy) getSessionLogFromShadow(sessionID string) ([]byte, error) {\n   133→\trepo, err := OpenRepository()\n   134→\tif err != nil {\n   135→\t\treturn nil, fmt.Errorf(\"failed to open git repository: %w\", err)\n   136→\t}\n   137→\n   138→\tstate, err := s.loadSessionState(sessionID)\n   139→\tif err != nil || state == nil {\n   140→\t\treturn nil, fmt.Errorf(\"no active session: %s\", sessionID)\n   141→\t}\n   142→\n   143→\tshadowBranchName := getShadowBranchNameForCommit(state.BaseCommit)\n   144→\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n   145→\tref, err := repo.Reference(refName, true)\n   146→\tif err != nil {\n   147→\t\treturn nil, fmt.Errorf(\"failed to get shadow branch reference: %w\", err)\n   148→\t}\n   149→\n   150→\tcommit, err := repo.CommitObject(ref.Hash())\n   151→\tif err != nil {\n   152→\t\treturn nil, fmt.Errorf(\"failed to get commit object: %w\", err)\n   153→\t}\n   154→\n   155→\ttree, err := commit.Tree()\n   156→\tif err != nil {\n   157→\t\treturn nil, fmt.Errorf(\"failed to get commit tree: %w\", err)\n   158→\t}\n   159→\n   160→\tmetadataDir := paths.SessionMetadataDir(sessionID)\n   161→\tif file, fileErr := tree.File(metadataDir + \"/\" + paths.TranscriptFileName); fileErr == nil {\n   162→\t\tif content, contentErr := file.Contents(); contentErr == nil {\n   163→\t\t\treturn []byte(content), nil\n   164→\t\t}\n   165→\t}\n   166→\tif file, fileErr := tree.File(metadataDir + \"/\" + paths.TranscriptFileNameLegacy); fileErr == nil {\n   167→\t\tif