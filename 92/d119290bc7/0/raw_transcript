itHash) == 12 {\n    24→\t\tlog, err := s.getCheckpointLog(commitHash)\n    25→\t\tif err == nil {\n    26→\t\t\t// Find session ID from metadata (best-effort lookup)\n    27→\t\t\tcheckpoints, _ := s.listCheckpoints() //nolint:errcheck // Best-effort session ID lookup\n    28→\t\t\tfor _, cp := range checkpoints {\n    29→\t\t\t\tif cp.CheckpointID == commitHash {\n    30→\t\t\t\t\treturn log, cp.SessionID, nil\n    31→\t\t\t\t}\n    32→\t\t\t}\n    33→\t\t\treturn log, \"\", nil\n    34→\t\t}\n    35→\t}\n    36→\n    37→\t// Try to look up by commit\n    38→\thash, err := repo.ResolveRevision(plumbing.Revision(commitHash))\n    39→\tif err == nil {\n    40→\t\tcommit, err := repo.CommitObject(*hash)\n    41→\t\tif err == nil {\n    42→\t\t\t// Check for Entire-Checkpoint trailer\n    43→\t\t\tcheckpointID, hasTrailer := paths.ParseCheckpointTrailer(commit.Message)\n    44→\t\t\tif hasTrailer && checkpointID != \"\" {\n    45→\t\t\t\tlog, logErr := s.getCheckpointLog(checkpointID)\n    46→\t\t\t\tif logErr == nil {\n    47→\t\t\t\t\t// Find session ID\n    48→\t\t\t\t\tcheckpoints, _ := s.listCheckpoints() //nolint:errcheck // Best-effort session ID lookup\n    49→\t\t\t\t\tfor _, cp := range checkpoints {\n    50→\t\t\t\t\t\tif cp.CheckpointID == checkpointID {\n    51→\t\t\t\t\t\t\treturn log, cp.SessionID, nil\n    52→\t\t\t\t\t\t}\n    53→\t\t\t\t\t}\n    54→\t\t\t\t\treturn log, \"\", nil\n    55→\t\t\t\t}\n    56→\t\t\t}\n    57→\n    58→\t\t\t// Fall back to Entire-Session trailer\n    59→\t\t\tsessionID, found := paths.ParseSessionTrailer(commit.Message)\n    60→\t\t\tif found {\n    61→\t\t\t\tlog, err := s.getSessionLogBySessionID(sessionID)\n    62→\t\t\t\tif err == nil {\n    63→\t\t\t\t\treturn log, sessionID, nil\n    64→\t\t\t\t}\n    65→\t\t\t}\n    66→\n    67→\t\t\t// Try metadata trailer (shadow branch commit)\n    68→\t\t\tmetadataDir, found := paths.ParseMetadataTrailer(commit.Message)\n    69→\t\t\tif found {\n    70→\t\t\t\tsessionID := file