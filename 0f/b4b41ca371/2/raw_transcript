sion.KindAgentReview,\n527\t\t\t\tWorktreePath: \"/repo\",\n528\t\t\t\tBaseCommit:   \"abc123\",\n529\t\t\t\tStartedAt:    started.Add(-time.Hour), // way before the review run\n530\t\t\t\tAgentType:    agenttypes.AgentType(\"Claude Code\"),\n531\t\t\t},\n532\t\t}\n533\t\tgot := explainEmptyManifest(\"/repo\", \"abc123\", summary, states)\n534\t\tif !strings.Contains(got, \"started before the review run\") {\n535\t\t\tt.Errorf(\"reason = %q, want 'started before the review run'\", got)\n536\t\t}\n537\t}\n538\t\n539\t// TestExplainEmptyManifest_DumpAllReasons emits the diagnostic for every\n540\t// known cause so a `-v` run shows the exact warning text users will see.\n541\t// Useful for visual smoke checks when iterating on wording.\n542\tfunc TestExplainEmptyManifest_DumpAllReasons(t *testing.T) {\n543\t\tt.Parallel()\n544\t\tstarted := time.Now()\n545\t\tsummary := reviewtypes.RunSummary{\n546\t\t\tStartedAt: started,\n547\t\t\tAgentRuns: []reviewtypes.AgentRun{{Name: \"claude-code\"}},\n548\t\t}\n549\t\tcases := []struct {\n550\t\t\tlabel  string\n551\t\t\tstates []*session.State\n552\t\t}{\n553\t\t\t{\"no states\", nil},\n554\t\t\t{\"none tagged\", []*session.State{\n555\t\t\t\t{SessionID: \"s1\", WorktreePath: \"/repo\", BaseCommit: \"abc123\", StartedAt: started.Add(time.Second)},\n556\t\t\t}},\n557\t\t\t{\"worktree mismatch\", []*session.State{\n558\t\t\t\t{SessionID: \"s1\", Kind: session.KindAgentReview, WorktreePath: \"/other\", BaseCommit: \"abc123\", StartedAt: started.Add(time.Second), AgentType: agenttypes.AgentType(\"Claude Code\")},\n559\t\t\t}},\n560\t\t\t{\"SHA mismatch\", []*session.State{\n561\t\t\t\t{SessionID: \"s1\", Kind: session.KindAgentReview, WorktreePath: \"/repo\", BaseCommit: \"deadbeef\", StartedAt: started.Add(time.Second), AgentType: agenttypes.AgentType(\"Claude Code\")},\n562\t\t\t}},\n563\t\t\t{\"started before window\", []*session.State{\n564\t\t\t\t{SessionID: \"s1\", Kind: session.KindAgentReview, WorktreePath: \"/repo\", Base