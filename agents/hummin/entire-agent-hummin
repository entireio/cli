#!/usr/bin/env node
// entire-agent-hummin - Entire external agent plugin for the hummin coding agent.
//
// hummin (https://github.com/rennf93/hummin) is a fork of the pi coding agent
// with the config directory renamed .pi -> .hummin, the binary renamed
// pi -> hummin, and sessions stored under ~/.hummin/agent/sessions/. Session
// files keep pi's JSONL format, so the session handling here mirrors the
// behavior of Entire's in-tree pi agent.
//
// Implements the external agent protocol documented in
// docs/architecture/external-agent-protocol.md: subcommands, JSON on
// stdin/stdout, stateless invocations, exit 0 on success and non-zero with a
// stderr message on error.
//
// Requires Node.js >= 20. No npm dependencies.
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const PROTOCOL_VERSION = 1;
const PLUGIN_VERSION = "0.1.0";
const AGENT_NAME = "hummin";
const AGENT_TYPE = "Hummin";
const AGENT_BINARY = "hummin";
const CONFIG_DIR = ".hummin"; // hummin's protected (excluded) repo dir
const AGENT_HOME_ENV = "PI_CODING_AGENT_DIR"; // hummin's home override (default ~/.hummin/agent)
const SESSION_STORE_ENV = "PI_CODING_AGENT_SESSION_DIR"; // replaces the session store outright, no per-repo nesting
const NESTED_MARKER_ENV = "ENTIRE_PI_NESTED"; // pi-fork nested-process marker used by the installed extension
const MAX_CHUNK_SIZE = 50 * 1024 * 1024; // matches agent.MaxChunkSize in the CLI

const EXTENSION_REL_DIR = path.join(".hummin", "extensions", "entire");
const EXTENSION_REL_FILE = path.join(EXTENSION_REL_DIR, "index.ts");
const ENTIRE_MARKER = "Auto-generated by `entire enable --agent hummin`";
const ENTIRE_CMD_PLACEHOLDER = "__ENTIRE_CMD__";

// hummin hook event names, forwarded verbatim by the installed extension.
const HookSessionStart = "session_start";
const HookBeforeAgentStart = "before_agent_start";
const HookAgentEnd = "agent_end";
const HookSessionShutdown = "session_shutdown";

// Declared capabilities gate which optional subcommands the CLI calls.
const CAPABILITIES = {
  hooks: true,
  transcript_analyzer: true,
  transcript_preparer: false,
  token_calculator: true,
  compact_transcript: false,
  text_generator: false,
  streaming_text_generator: false,
  hook_response_writer: false,
  subagent_aware_extractor: false,
};

// --- output helpers -------------------------------------------------------

function fail(message) {
  process.stderr.write(`entire-agent-hummin: ${message}\n`);
  process.exit(1);
}

function emitJSON(value) {
  process.stdout.write(JSON.stringify(value) + "\n");
}

function readStdin() {
  if (process.stdin.isTTY) return Buffer.alloc(0);
  try {
    return fs.readFileSync(0);
  } catch (err) {
    fail(`failed to read stdin: ${err.message}`);
  }
}

function readStdinJSON(what) {
  const raw = readStdin();
  const text = raw.toString("utf8").trim();
  if (text === "") fail(`empty stdin; expected ${what} JSON`);
  try {
    return JSON.parse(text);
  } catch (err) {
    fail(`invalid ${what} JSON on stdin: ${err.message}`);
  }
}

// --- flag parsing ---------------------------------------------------------

// Accepts both "--flag value" and "--flag=value", the two shapes the CLI and
// this test suite produce.
function parseFlags(args) {
  const flags = new Map();
  const positional = [];
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq >= 0) {
        flags.set(arg.slice(2, eq), arg.slice(eq + 1));
      } else if (i + 1 < args.length && !args[i + 1].startsWith("--")) {
        flags.set(arg.slice(2), args[i + 1]);
        i++;
      } else {
        flags.set(arg.slice(2), "");
      }
    } else {
      positional.push(arg);
    }
  }
  return { flags, positional };
}

function requireFlag(flags, name) {
  const value = flags.get(name);
  if (value === undefined || value === "") fail(`missing required flag --${name}`);
  return value;
}

// --- hummin session layout ------------------------------------------------

// Encodes an absolute repo path the way hummin names its per-project session
// directories: the leading separator is removed, "/", "\" and ":" become "-",
// and the result is wrapped in "--" on both sides. /Users/foo/repo encodes as
// --Users-foo-repo--. Leading and trailing separators are absorbed, so /a/b/
// and /a/b encode the same way. Mirrors encodeRepoPathForPi in the CLI's
// in-tree pi agent.
function encodeRepoPath(repoPath) {
  if (!repoPath) return "";
  let body = repoPath.replace(/[\/\\:]/g, "-");
  body = body.replace(/^-+/, "").replace(/-+$/, "");
  return "--" + body + "--";
}

function agentHomeDir() {
  const override = process.env[AGENT_HOME_ENV];
  if (override) return override;
  return path.join(os.homedir(), CONFIG_DIR, "agent");
}

// Returns the directory where hummin stores sessions for repoPath.
// PI_CODING_AGENT_SESSION_DIR replaces the store outright (hummin uses the
// value as the directory itself, with no per-repo nesting); it is honored as
// is, exactly as hummin does.
function getSessionDir(repoPath) {
  const storeOverride = process.env[SESSION_STORE_ENV];
  if (storeOverride) return storeOverride;
  if (!repoPath) fail("--repo-path is required");
  return path.join(agentHomeDir(), "sessions", encodeRepoPath(repoPath));
}

// Extracts the session ID from a hummin session filename.
// Pattern: <timestamp>_<uuid>.jsonl -> returns <uuid>. Falls back to the
// basename without extension if the pattern doesn't match. Mirrors
// extractSessionIDFromPath in the CLI's in-tree pi agent.
function extractSessionIDFromPath(p) {
  if (!p) return "";
  let base = path.basename(p);
  base = base.replace(/\.jsonl$/, "");
  const i = base.lastIndexOf("_");
  if (i >= 0) return base.slice(i + 1);
  return base;
}

// Resolves the session file for sessionID in sessionDir. hummin names files
// <timestamp>_<id>.jsonl, so look for *_<id>.jsonl and prefer the
// lexicographically latest match (most recent timestamp). Absolute ids pass
// through unchanged. Mirrors PiAgent.ResolveSessionFile.
function resolveSessionFile(sessionDir, sessionID) {
  if (path.isAbsolute(sessionID)) return sessionID;
  if (sessionDir && sessionID) {
    const matches = listSessionsByID(sessionDir, sessionID);
    if (matches.length > 0) return matches[0];
  }
  if (!sessionDir) return sessionID;
  return path.join(sessionDir, sessionID + ".jsonl");
}

function listSessionsByID(sessionDir, sessionID) {
  if (!sessionDir || !sessionID) return [];
  let entries;
  try {
    entries = fs.readdirSync(sessionDir);
  } catch {
    return [];
  }
  const suffix = "_" + sessionID + ".jsonl";
  return entries
    .filter((name) => name.endsWith(suffix))
    .map((name) => path.join(sessionDir, name))
    .sort()
    .reverse();
}

// --- pi-fork JSONL transcript primitives ----------------------------------

// Counts newline-terminated (or final unterminated) lines, including blank
// lines. Mirrors pijsonl.CountLines.
function countLines(data) {
  if (data.length === 0) return 0;
  let n = 0;
  for (const b of data) if (b === 0x0a) n++;
  if (data[data.length - 1] !== 0x0a) n++;
  return n;
}

// Splits a buffer into lines on 0x0A, dropping the newline bytes. An empty
// buffer yields no lines; a trailing newline does not yield a trailing empty
// line beyond what strings.Split semantics require (kept identical to the Go
// implementation, which iterates strings.Split output).
function splitBufferLines(data) {
  const lines = [];
  let start = 0;
  for (let i = 0; i < data.length; i++) {
    if (data[i] === 0x0a) {
      lines.push(data.subarray(start, i));
      start = i + 1;
    }
  }
  lines.push(data.subarray(start));
  return lines;
}

// Returns data with the first n newline-terminated lines removed. Mirrors
// pijsonl.SkipLines.
function skipLines(data, n) {
  if (n <= 0) return data;
  let off = 0;
  for (let i = 0; i < n && off < data.length; i++) {
    const idx = data.indexOf(0x0a, off);
    if (idx < 0) return null;
    off = idx + 1;
  }
  return data.subarray(off);
}

// Walks the transcript tree and returns the set of entry IDs on the active
// conversation branch (root -> most recent message), or null when the
// transcript has no tree structure (callers treat null as "everything is
// active"). Resolving over truncated data yields a disconnected tree, so
// callers must pass FULL transcript bytes. Mirrors pijsonl.ResolveActiveBranch.
function resolveActiveBranch(data) {
  const parentOf = new Map();
  let lastMessageID = "";
  let hasTree = false;
  for (const line of splitBufferLines(data)) {
    if (line.length === 0) continue;
    let node;
    try {
      node = JSON.parse(line.toString("utf8"));
    } catch {
      continue;
    }
    if (!node || typeof node.id !== "string" || node.id === "") continue;
    if (node.parentId !== undefined && node.parentId !== null) {
      parentOf.set(node.id, node.parentId);
      if (node.parentId !== "") hasTree = true;
    }
    if (node.type === "message") lastMessageID = node.id;
  }
  if (!hasTree || lastMessageID === "") return null;
  const active = new Set();
  let cur = lastMessageID;
  while (cur !== undefined && cur !== null && cur !== "") {
    if (active.has(cur)) break; // cycle protection
    active.add(cur);
    if (!parentOf.has(cur)) break;
    cur = parentOf.get(cur);
  }
  return active;
}

// Invokes fn(entry) for every message entry on the active branch starting at
// line fromOffset. Active-branch resolution runs on the FULL data; unparsable
// lines, non-message entries and off-branch entries are skipped. Mirrors
// pijsonl.ForEachActiveMessage.
function forEachActiveMessage(data, fromOffset, fn) {
  if (data.length === 0) return;
  const active = resolveActiveBranch(data);
  const content = skipLines(data, fromOffset);
  if (content === null || content.length === 0) return;
  for (const line of splitBufferLines(content)) {
    if (line.length === 0) continue;
    let entry;
    try {
      entry = JSON.parse(line.toString("utf8"));
    } catch {
      continue;
    }
    if (!entry || entry.type !== "message") continue;
    if (active && !active.has(entry.id)) continue;
    fn(entry);
  }
}

// Decodes message content that is a plain JSON string; returns "" for arrays.
function decodeStringContent(raw) {
  if (raw === undefined || raw === null) return "";
  if (typeof raw === "string") return raw;
  return "";
}

// Extracts the model identifier from the most recent assistant message on the
// active branch. Mirrors PiAgent.ExtractModel.
function extractModel(data) {
  let model = "";
  forEachActiveMessage(data, 0, (entry) => {
    const msg = entry.message;
    if (msg && msg.role === "assistant" && typeof msg.model === "string" && msg.model !== "") {
      model = msg.model;
    }
  });
  return model;
}

// Splits JSONL content at line boundaries. A single line larger than maxSize
// is an error because a JSON object cannot be split. Chunks carry no trailing
// newline; reassembleJSONL restores the separators. Byte-for-byte port of
// agent.ChunkJSONL.
function chunkJSONL(data, maxSize) {
  if (data.length === 0) return [];
  const NL = Buffer.from("\n");
  const chunks = [];
  let current = [];
  let currentLen = 0;
  const lines = splitBufferLines(data);
  for (let i = 0; i < lines.length; i++) {
    const lineLen = lines[i].length + 1; // line + newline
    if (lineLen > maxSize) {
      throw new Error(
        `JSONL line ${i + 1} exceeds maximum chunk size (${lineLen} bytes > ${maxSize} bytes); cannot split a single JSON object`
      );
    }
    if (currentLen + lineLen > maxSize && currentLen > 0) {
      chunks.push(Buffer.concat(joinWith(current, NL)));
      current = [];
      currentLen = 0;
    }
    current.push(lines[i]);
    currentLen += lineLen;
  }
  if (currentLen > 0) chunks.push(Buffer.concat(joinWith(current, NL)));
  return chunks;
}

function joinWith(buffers, sep) {
  const out = [];
  for (let i = 0; i < buffers.length; i++) {
    if (i > 0) out.push(sep);
    out.push(buffers[i]);
  }
  return out;
}

// Concatenates JSONL chunks with newlines. Byte-for-byte port of
// agent.ReassembleJSONL.
function reassembleJSONL(chunks) {
  return Buffer.concat(joinWith(chunks, Buffer.from("\n")));
}

// --- transcript analyzer --------------------------------------------------

// File-modifying tools in hummin. Mirrors the in-tree pi agent's list.
const FILE_MODIFICATION_TOOLS = new Set(["write", "edit"]);

function contentItems(msg) {
  if (!msg || !Array.isArray(msg.content)) return [];
  return msg.content.filter((item) => item && typeof item === "object");
}

function extractModifiedFiles(data, startOffset) {
  const totalLines = countLines(data);
  const seen = new Set();
  const files = [];
  forEachActiveMessage(data, startOffset, (entry) => {
    const msg = entry.message;
    if (!msg || msg.role !== "assistant") return;
    for (const item of contentItems(msg)) {
      if (item.type !== "toolCall") continue;
      if (!FILE_MODIFICATION_TOOLS.has(item.name)) continue;
      let args = item.arguments;
      if (typeof args === "string") {
        try {
          args = JSON.parse(args);
        } catch {
          continue;
        }
      }
      const p = args && typeof args === "object" ? args.path : undefined;
      if (typeof p === "string" && p !== "" && !seen.has(p)) {
        seen.add(p);
        files.push(p);
      }
    }
  });
  return { files, totalLines };
}

function extractPrompts(data, fromOffset) {
  const prompts = [];
  forEachActiveMessage(data, fromOffset, (entry) => {
    const msg = entry.message;
    if (!msg || msg.role !== "user") return;
    const text = decodeStringContent(msg.content);
    if (text !== "") {
      prompts.push(text);
      return;
    }
    for (const item of contentItems(msg)) {
      if (item.type === "text" && typeof item.text === "string" && item.text !== "") {
        prompts.push(item.text);
      }
    }
  });
  return prompts;
}

function calculateTokens(data, fromOffset) {
  const usage = {
    input_tokens: 0,
    cache_creation_tokens: 0,
    cache_read_tokens: 0,
    output_tokens: 0,
    api_call_count: 0,
    subagent_tokens: null,
  };
  forEachActiveMessage(data, fromOffset, (entry) => {
    const msg = entry.message;
    if (!msg || msg.role !== "assistant" || !msg.usage) return;
    usage.input_tokens += numOrZero(msg.usage.input);
    usage.output_tokens += numOrZero(msg.usage.output);
    usage.cache_read_tokens += numOrZero(msg.usage.cacheRead);
    usage.cache_creation_tokens += numOrZero(msg.usage.cacheWrite);
    usage.api_call_count += 1;
  });
  return usage;
}

function numOrZero(v) {
  return typeof v === "number" && Number.isFinite(v) ? v : 0;
}

// --- hook payload parsing -------------------------------------------------

// Maps a hummin extension payload (the JSON the installed extension pipes to
// `entire hooks hummin <event>`) to a protocol Event, or null when the payload
// has no lifecycle significance. Mirrors the in-tree pi agent's ParseHookEvent.
function parseHookEvent(hookName, payload) {
  let sessionID = "";
  if (payload && typeof payload.session_id === "string") sessionID = payload.session_id;
  if (sessionID === "" && payload && typeof payload.session_file === "string") {
    sessionID = extractSessionIDFromPath(payload.session_file);
  }

  // A sessionless payload names no session we can track; it must not borrow a
  // repo-global session identity (nested hummin --no-session subagent guard).
  // session_shutdown is exempt: the extension sends it with no session
  // identity at all, and it is deliberately not a lifecycle event.
  if (hookName !== HookSessionShutdown && sessionID === "") return null;

  const now = new Date().toISOString();
  const sessionFile =
    payload && typeof payload.session_file === "string" ? payload.session_file : "";

  switch (hookName) {
    case HookSessionStart:
      return { type: 1, session_id: sessionID, timestamp: now };
    case HookBeforeAgentStart: {
      const event = { type: 2, session_id: sessionID, timestamp: now };
      if (sessionFile) event.session_ref = sessionFile;
      if (payload && typeof payload.prompt === "string" && payload.prompt !== "") {
        event.prompt = payload.prompt;
      }
      return event;
    }
    case HookAgentEnd: {
      const event = { type: 3, session_id: sessionID, timestamp: now };
      if (sessionFile) {
        event.session_ref = sessionFile;
        // hummin never reports the model through hooks; backfill it from the
        // most recent active-branch assistant message, as the in-tree pi
        // agent does. Best effort: an unreadable transcript leaves it empty.
        try {
          const model = extractModel(fs.readFileSync(sessionFile));
          if (model !== "") event.model = model;
        } catch {
          // no model available
        }
      }
      return event;
    }
    case HookSessionShutdown:
      // hummin fires session_shutdown and agent_end on session teardown as
      // separate child processes; SessionEnd is left for the framework to
      // derive, exactly as for the in-tree pi agent.
      return null;
    default:
      return null;
  }
}

// --- hook installation ----------------------------------------------------

function repoRootForHooks() {
  return process.env.ENTIRE_REPO_ROOT || process.cwd();
}

// Renders the hummin extension that forwards lifecycle events to
// `entire hooks hummin <event>`. Adapted from the CLI's embedded pi extension:
// same events, same nested-process guard, paths and names changed for hummin.
function renderExtension() {
  const template = `// Entire CLI extension for hummin
// Auto-generated by \`entire enable --agent hummin\` (entire-agent-hummin)
// Do not edit manually - changes will be overwritten on next install.
//
// Forwards hummin lifecycle events to \`entire hooks hummin <event>\` so Entire
// can create checkpoints, capture transcripts, and offer rewind/resume.

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { execFile } from "node:child_process";

export default function (pi: ExtensionAPI) {
  // A hummin subagent is a nested \`hummin\` process (subagent extensions spawn
  // one per task with cwd inside the project, where hummin auto-discovers this
  // same project-local extension), so it would otherwise forward its own
  // lifecycle as the user's session. Mark this process so any hummin it spawns
  // knows it is nested. The marker holds the PID of the top-level hummin that
  // set it; hummin builds a new extension instance in the same process on
  // /reload, /new and /resume, and that instance must still forward lifecycle.
  // A nested hummin leaves the marker as it found it. Entire's own hook
  // subprocesses inherit this marker, so the CLI side must never treat it as a
  // skip signal.
  const marker = process.env.${NESTED_MARKER_ENV};
  const nested = Boolean(marker) && marker !== String(process.pid);
  if (!marker) process.env.${NESTED_MARKER_ENV} = String(process.pid);

  const ENTIRE_CMD = '${ENTIRE_CMD_PLACEHOLDER}';

  // fireHook pipes data to \`entire hooks hummin <hookName>\` and ignores the
  // result. Best effort - never block the agent on a hook failure.
  function fireHook(hookName: string, data: Record<string, unknown>): void {
    try {
      const child = execFile(
        "sh",
        ["-c", \`\${ENTIRE_CMD} hooks hummin \${hookName}\`],
        { timeout: 10000, windowsHide: true, maxBuffer: 4 * 1024 * 1024 },
        () => {},
      );
      // A hook that exits without reading its payload (or a missing \`entire\`)
      // fails this write with EPIPE, emitted asynchronously as a stream error
      // that the try/catch cannot see. Unhandled, it would crash hummin.
      child.stdin?.on("error", () => {});
      child.stdin?.end(JSON.stringify(data));
    } catch {
      // ignore - hooks must never take the agent down
    }
  }

  // Agent-driven bash subprocesses inherit a real TTY but cannot answer hook
  // prompts. Disable git/Entire terminal prompts for bash calls so Entire
  // treats agent-driven commits as non-interactive. Registered even when
  // nested: Entire's git hooks live in .git/hooks independently of this
  // extension, so a nested subagent that commits needs this hardening too.
  pi.on("tool_call", async (event) => {
    if (event.toolName !== "bash") return;
    const input = event.input as { command?: string };
    if (typeof input.command !== "string" || input.command.includes("GIT_TERMINAL_PROMPT=")) {
      return;
    }
    input.command = "export GIT_TERMINAL_PROMPT=0\\n" + input.command;
  });

  // Everything below forwards session lifecycle to Entire, which only the
  // top-level hummin may do.
  if (nested) return;

  pi.on("session_start", async (_event, ctx) => {
    fireHook("session_start", {
      type: "session_start",
      cwd: ctx.cwd,
      session_file: ctx.sessionManager.getSessionFile(),
    });
  });

  pi.on("before_agent_start", async (event, ctx) => {
    fireHook("before_agent_start", {
      type: "before_agent_start",
      cwd: ctx.cwd,
      session_file: ctx.sessionManager.getSessionFile(),
      prompt: event.prompt,
    });
  });

  pi.on("agent_end", async (_event, ctx) => {
    fireHook("agent_end", {
      type: "agent_end",
      cwd: ctx.cwd,
      session_file: ctx.sessionManager.getSessionFile(),
    });
  });

  pi.on("session_shutdown", async () => {
    fireHook("session_shutdown", { type: "session_shutdown" });
  });
}
`;
  return template.split(ENTIRE_CMD_PLACEHOLDER).join("entire");
}

// Refuses when any prefix of relPath under root exists as a symlink. A
// symlinked .hummin arriving with the checkout would otherwise be resolved
// before any boundary exists; this mirrors the root-anchor rule the CLI
// applies to hook configs (docs/development/filesystem-safety.md).
function assertNoSymlinkPrefix(root, relPath) {
  let cur = root;
  const parts = relPath.split(path.sep);
  for (let i = 0; i < parts.length - 1; i++) {
    cur = path.join(cur, parts[i]);
    let st;
    try {
      st = fs.lstatSync(cur);
    } catch {
      return; // missing prefix: nothing to refuse, mkdir will create it fresh
    }
    if (st.isSymbolicLink()) fail(`refusing to write through symlink at ${cur}`);
  }
}

// Refuses to write through a symlinked session file. The CLI's preflight
// already constrains the reference to the session store; this keeps a planted
// in-store symlink from redirecting the write.
function assertNotSymlink(p) {
  try {
    const st = fs.lstatSync(p);
    if (st.isSymbolicLink()) fail(`refusing to write through symlink at ${p}`);
  } catch (err) {
    if (err.code !== "ENOENT") fail(`inspect ${p}: ${err.message}`);
  }
}

function installHooks(force) {
  const root = repoRootForHooks();
  const file = path.join(root, EXTENSION_REL_FILE);
  const content = renderExtension();

  if (!force) {
    let existing = null;
    try {
      existing = fs.readFileSync(file, "utf8");
    } catch (err) {
      if (err.code !== "ENOENT") fail(`read ${file}: ${err.message}`);
    }
    if (existing !== null) {
      if (existing === content) {
        emitJSON({ hooks_installed: 0 });
        return;
      }
      if (!existing.includes(ENTIRE_MARKER)) {
        fail(`refusing to overwrite foreign file at ${file}; remove it or pass --force`);
      }
    }
  }

  assertNoSymlinkPrefix(root, EXTENSION_REL_FILE);
  fs.mkdirSync(path.join(root, EXTENSION_REL_DIR), { recursive: true, mode: 0o755 });
  // 0644 because hummin reads the extension itself.
  fs.writeFileSync(file, content, { mode: 0o644 });
  emitJSON({ hooks_installed: 1 });
}

function uninstallHooks() {
  const root = repoRootForHooks();
  const dir = path.join(root, EXTENSION_REL_DIR);
  // The directory, not just the file: hummin discovers extensions by
  // directory, so an empty .hummin/extensions/entire left behind is a
  // half-uninstalled extension.
  try {
    const st = fs.lstatSync(dir);
    if (st.isSymbolicLink()) fail(`refusing to remove symlink at ${dir}`);
    fs.rmSync(dir, { recursive: true });
  } catch (err) {
    if (err.code !== "ENOENT") fail(`remove ${dir}: ${err.message}`);
  }
}

function areHooksInstalled() {
  const root = repoRootForHooks();
  const file = path.join(root, EXTENSION_REL_FILE);
  let data;
  try {
    data = fs.readFileSync(file, "utf8");
  } catch (err) {
    if (err.code === "ENOENT") {
      emitJSON({ installed: false });
      return;
    }
    // Unknown state, not "no hooks": the caller must treat this as "hooks may
    // still be installed".
    fail(`read ${file}: ${err.message}`);
  }
  emitJSON({ installed: data.includes(ENTIRE_MARKER) });
}

// --- session read/write ---------------------------------------------------

function getHookSessionID(input) {
  let id = "";
  if (input && typeof input.session_id === "string") id = input.session_id;
  if (id === "" && input && typeof input.session_ref === "string") {
    id = extractSessionIDFromPath(input.session_ref);
  }
  if (id === "" && input && input.raw_data && typeof input.raw_data === "object") {
    if (typeof input.raw_data.session_id === "string") id = input.raw_data.session_id;
    else if (typeof input.raw_data.session_file === "string") {
      id = extractSessionIDFromPath(input.raw_data.session_file);
    }
  }
  return id;
}

// Refuses a session reference that is relative or carries dot segments, and -
// when a repo path is known - one that resolves outside the session store this
// plugin itself reports. Defense in depth mirroring the CLI's own preflight;
// a hostile caller could still write where its own permissions allow.
function checkSessionRefForWrite(ref, repoPath) {
  if (!path.isAbsolute(ref)) fail(`session_ref must be an absolute path, got ${ref}`);
  const parts = ref.split(path.sep);
  for (const part of parts) {
    if (part === "." || part === "..") fail(`session_ref must not contain "." or ".." segments: ${ref}`);
  }
  const storeOverride = process.env[SESSION_STORE_ENV];
  let store;
  if (storeOverride) {
    store = storeOverride;
  } else {
    if (!repoPath) return; // no store to check against; the CLI skips this too
    store = getSessionDir(repoPath);
  }
  const resolved = path.resolve(ref);
  const storeResolved = path.resolve(store);
  if (resolved !== storeResolved && !resolved.startsWith(storeResolved + path.sep)) {
    fail(`session_ref ${ref} is outside the session store ${storeResolved}`);
  }
}

function readSession(input) {
  if (!input || typeof input !== "object") fail("read-session: expected HookInput JSON on stdin");
  let sessionID = getHookSessionID(input);
  let ref = typeof input.session_ref === "string" ? input.session_ref : "";
  if (ref === "") {
    const repoRoot = process.env.ENTIRE_REPO_ROOT || process.cwd();
    if (sessionID === "") fail("read-session: hook input carries no session id or session_ref");
    ref = resolveSessionFile(getSessionDir(repoRoot), sessionID);
  }
  if (sessionID === "") sessionID = extractSessionIDFromPath(ref);

  let data;
  try {
    data = fs.readFileSync(ref);
  } catch (err) {
    fail(`read-session: cannot read ${ref}: ${err.message}`);
  }

  // Parse the session header (first line, type "session") for the id, start
  // time and cwd. Fall back to the hook input and the environment.
  let header = null;
  for (const line of splitBufferLines(data)) {
    if (line.length === 0) continue;
    try {
      const parsed = JSON.parse(line.toString("utf8"));
      if (parsed && parsed.type === "session") header = parsed;
    } catch {
      // tolerate a damaged header line
    }
    break; // header is the first line only
  }

  const session = {
    session_id: (header && typeof header.id === "string" && header.id !== "" ? header.id : sessionID) || "",
    agent_name: AGENT_NAME,
    repo_path:
      (header && typeof header.cwd === "string" && header.cwd !== "" ? header.cwd : "") ||
      process.env.ENTIRE_REPO_ROOT ||
      "",
    session_ref: ref,
    start_time: header && typeof header.timestamp === "string" ? header.timestamp : "",
    native_data: data.toString("base64"),
    modified_files: [],
    new_files: [],
    deleted_files: [],
  };
  emitJSON(session);
}

function writeSession(session) {
  if (!session || typeof session !== "object") fail("write-session: expected AgentSession JSON on stdin");
  const ref = typeof session.session_ref === "string" ? session.session_ref : "";
  if (ref === "") fail("write-session: session has empty session_ref");
  const repoPath = typeof session.repo_path === "string" ? session.repo_path : "";
  checkSessionRefForWrite(ref, repoPath);
  const native = typeof session.native_data === "string" ? session.native_data : "";
  if (native === "") fail("write-session: session has empty native_data");
  let data;
  try {
    data = Buffer.from(native, "base64");
  } catch (err) {
    fail(`write-session: invalid base64 native_data: ${err.message}`);
  }
  if (data.length === 0) fail("write-session: session has empty native_data");
  assertNotSymlink(ref);
  fs.mkdirSync(path.dirname(ref), { recursive: true, mode: 0o755 });
  fs.writeFileSync(ref, data, { mode: 0o600 });
}

// --- detect ---------------------------------------------------------------

// Reports whether the hummin binary is on PATH. Executable-bit aware on POSIX
// so a non-executable leftover does not count as present.
function detectPresent() {
  const pathVar = process.env.PATH || "";
  const exts = process.platform === "win32" ? [".exe", ".cmd", ".bat"] : [""];
  for (const dir of pathVar.split(path.delimiter)) {
    if (dir === "") continue;
    for (const ext of exts) {
      const full = path.join(dir, AGENT_BINARY + ext);
      let st;
      try {
        st = fs.statSync(full);
      } catch {
        continue;
      }
      if (!st.isFile()) continue;
      if (process.platform !== "win32" && (st.mode & 0o111) === 0) continue;
      return true;
    }
  }
  return false;
}

// --- command dispatch -----------------------------------------------------

function cmdInfo() {
  emitJSON({
    protocol_version: PROTOCOL_VERSION,
    version: PLUGIN_VERSION,
    name: AGENT_NAME,
    type: AGENT_TYPE,
    description: "Hummin coding agent integration for Entire (external reference plugin)",
    protected_dirs: [CONFIG_DIR],
    hook_names: [HookSessionStart, HookBeforeAgentStart, HookAgentEnd, HookSessionShutdown],
    caller_env_vars: ["PI_SESSION_ID"],
    capabilities: CAPABILITIES,
  });
}

function main(args) {
  const command = args[0];
  const rest = args.slice(1);
  const { flags } = parseFlags(rest);

  switch (command) {
    case "info":
      cmdInfo();
      return;

    case "detect":
      emitJSON({ present: detectPresent() });
      return;

    case "get-session-id": {
      const input = readStdinJSON("hook input");
      emitJSON({ session_id: getHookSessionID(input) });
      return;
    }

    case "get-session-dir":
      emitJSON({ session_dir: getSessionDir(requireFlag(flags, "repo-path")) });
      return;

    case "resolve-session-file": {
      const dir = requireFlag(flags, "session-dir");
      const id = requireFlag(flags, "session-id");
      emitJSON({ session_file: resolveSessionFile(dir, id) });
      return;
    }

    case "read-session":
      readSession(readStdinJSON("hook input"));
      return;

    case "write-session":
      writeSession(readStdinJSON("agent session"));
      return;

    case "read-transcript": {
      const ref = requireFlag(flags, "session-ref");
      let data;
      try {
        data = fs.readFileSync(ref);
      } catch (err) {
        fail(`read-transcript: cannot read ${ref}: ${err.message}`);
      }
      process.stdout.write(data);
      return;
    }

    case "chunk-transcript": {
      const sizeArg = flags.get("max-size");
      let maxSize = MAX_CHUNK_SIZE;
      if (sizeArg !== undefined && sizeArg !== "") {
        maxSize = Number(sizeArg);
        if (!Number.isInteger(maxSize) || maxSize <= 0) fail(`invalid --max-size: ${sizeArg}`);
      }
      const data = readStdin();
      let chunks;
      try {
        chunks = chunkJSONL(data, maxSize);
      } catch (err) {
        fail(`chunk-transcript: ${err.message}`);
      }
      emitJSON({ chunks: chunks.map((c) => c.toString("base64")) });
      return;
    }

    case "reassemble-transcript": {
      const input = readStdinJSON("chunks");
      const encoded = Array.isArray(input && input.chunks) ? input.chunks : [];
      const chunks = encoded.map((c) => Buffer.from(c, "base64"));
      process.stdout.write(reassembleJSONL(chunks));
      return;
    }

    case "format-resume-command": {
      const id = (flags.get("session-id") || "").trim();
      // hummin accepts a partial UUID via --session (verified against
      // packages/coding-agent/src/cli/args.ts). Empty id falls back to
      // --continue, which reopens the most recent session.
      emitJSON({ command: id === "" ? `${AGENT_BINARY} --continue` : `${AGENT_BINARY} --session ${id}` });
      return;
    }

    // transcript_analyzer capability
    case "get-transcript-position": {
      const p = requireFlag(flags, "path");
      let data;
      try {
        data = fs.readFileSync(p);
      } catch (err) {
        if (err.code === "ENOENT") {
          emitJSON({ position: 0 }); // missing files report 0, consistent with the in-tree pi agent
          return;
        }
        fail(`get-transcript-position: cannot read ${p}: ${err.message}`);
      }
      emitJSON({ position: countLines(data) });
      return;
    }

    case "extract-modified-files": {
      const p = requireFlag(flags, "path");
      const offset = Number(flags.get("offset") || 0);
      if (!Number.isInteger(offset) || offset < 0) fail(`invalid --offset: ${flags.get("offset")}`);
      let data;
      try {
        data = fs.readFileSync(p);
      } catch (err) {
        fail(`extract-modified-files: cannot read ${p}: ${err.message}`);
      }
      const { files, totalLines } = extractModifiedFiles(data, offset);
      emitJSON({ files, current_position: totalLines });
      return;
    }

    case "extract-prompts": {
      const ref = requireFlag(flags, "session-ref");
      const offset = Number(flags.get("offset") || 0);
      if (!Number.isInteger(offset) || offset < 0) fail(`invalid --offset: ${flags.get("offset")}`);
      let data;
      try {
        data = fs.readFileSync(ref);
      } catch (err) {
        fail(`extract-prompts: cannot read ${ref}: ${err.message}`);
      }
      emitJSON({ prompts: extractPrompts(data, offset) });
      return;
    }

    // token_calculator capability
    case "calculate-tokens": {
      const offset = Number(flags.get("offset") || 0);
      if (!Number.isInteger(offset) || offset < 0) fail(`invalid --offset: ${flags.get("offset")}`);
      const data = readStdin();
      emitJSON(calculateTokens(data, offset));
      return;
    }

    // hooks capability
    case "parse-hook": {
      const hookName = requireFlag(flags, "hook");
      const payload = readStdinJSON("hook payload");
      const event = parseHookEvent(hookName, payload);
      emitJSON(event === null ? null : event);
      return;
    }

    case "install-hooks":
      installHooks(flags.has("force"));
      return;

    case "uninstall-hooks":
      uninstallHooks();
      return;

    case "are-hooks-installed":
      areHooksInstalled();
      return;

    default:
      fail(`unknown command ${command || "(none)"}; expected an external agent protocol subcommand`);
  }
}

main(process.argv.slice(2));
