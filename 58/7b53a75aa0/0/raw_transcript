e checked recently (within 24 hours)\n58\t\tif time.Since(cache.LastCheckTime) < checkInterval {\n59\t\t\treturn\n60\t\t}\n61\t\n62\t\t// Fetch the latest version from the appropriate channel\n63\t\tvar latestVersion string\n64\t\tif isNightly(currentVersion) {\n65\t\t\tlatestVersion, err = fetchLatestNightlyVersion(ctx)\n66\t\t} else {\n67\t\t\tlatestVersion, err = fetchLatestVersion(ctx)\n68\t\t}\n69\t\n70\t\t// Always update cache to avoid retrying on every CLI invocation\n71\t\tcache.LastCheckTime = time.Now()\n72\t\tif saveErr := saveCache(cache); saveErr != nil {\n73\t\t\tlogging.Debug(ctx, \"version check: failed to save cache\",\n74\t\t\t\t\"error\", saveErr.Error())\n75\t\t}\n76\t\n77\t\tif err != nil {\n78\t\t\tlogging.Debug(ctx, \"version check: failed to fetch latest version\",\n79\t\t\t\t\"error\", err.Error())\n80\t\t\treturn\n81\t\t}\n82\t\n83\t\t// Show notification and offer an interactive upgrade when outdated\n84\t\tif isOutdated(currentVersion, latestVersion) {\n85\t\t\tif cache.SkippedVersion == versionCacheKey(latestVersion) {\n86\t\t\t\treturn\n87\t\t\t}\n88\t\n89\t\t\taction := MaybeAutoUpdate(ctx, w, currentVersion, latestVersion)\n90\t\t\tif action == autoUpdateActionSkipUntilNextVersion {\n91\t\t\t\tcache.SkippedVersion = versionCacheKey(latestVersion)\n92\t\t\t\tif saveErr := saveCache(cache); saveErr != nil {\n93\t\t\t\t\tlogging.Debug(ctx, \"version check: failed to save skipped version\",\n94\t\t\t\t\t\t\"error\", saveErr.Error())\n95\t\t\t\t}\n96\t\t\t}\n97\t\t}\n98\t}\n99\t\n100\t// globalConfigDirPath returns the expanded path to the global config directory (~/.config/entire).\n101\tfunc globalConfigDirPath() (string, error) {\n102\t\thome, err := os.UserHomeDir()\n103\t\tif err != nil {\n104\t\t\treturn \"\", fmt.Errorf(\"getting home directory: %w\", err)\n105\t\t}\n106\t\treturn filepath.Join(home, globalConfigDirName), nil\n107\t}\n108\t\n109\t// ensureGlobalConfigDir creates the global config directory if it doesn't exist.\n110\tfunc ensureGlobalConfigDir() error {\n111\t\tconfigDir, err := globalConfigDirPath()\n112\t\tif err != nil {\n113\t\t\treturn err\n114\t\t}\n115\t\n116\t\t//nolint:gosec // ~/.config/entire is user home directory, 0o755 is appropriate\n117\t\tif err := os.MkdirAll(configDir, 0o755); err != nil {\n118\t\t\treturn fmt.Errorf(\"creating config directory: %w\", err)\n119\t\t}\n120\t\n121\t\treturn nil\n122\t}\n123\t\n124\t// cacheFilePath returns the full path to the version check cache file.\n125\tfunc cacheFilePath() (string, error) {\n126\t\tconfigDir, err := globalConfigDirPath()\n127\t\tif err != nil {\n128\t\t\treturn \"\", err\n129\t\t}\n130\t\treturn filepath.Join(configDir, cacheFileName), nil\n131\t}\n132\t\n133\t// loadCache loads the version check cache from disk.\n134\t// Returns an error if the file doesn't exist or is corrupted.\n135\tfunc loadCache() (*VersionCache, error) {\n136\t\tfilePath, err := cacheFilePath()\n137\t\tif err != nil {\n138\t\t\treturn nil, err\n139\t\t}\n140\t\n141\t\tdata, err := os.ReadFile(filePath) //nolint:gosec // cacheFilePath is safe\n142\t\tif err != nil {\n143\t\t\treturn nil, fmt.Errorf(\"reading cache file: %w\", err)\n144\t\t}\n145\t\n146\t\tvar cache VersionCache\n147\t\tif err := json.Unmarshal(data, &cache); err != nil {\n148\t\t\treturn nil, fmt.Errorf(\"parsing cache: %w\", err)\n149\t\t}\n150\t\n151\t\treturn &cache, nil\n152\t}\n153\t\n154\t// saveCache saves the version check cache to disk.\n155\t// Uses atomic write semantics (write to temp file, then rename).\n156\tfunc saveCache(cache *VersionCache) error {\n157\t\tfilePath, err := cacheFilePath()\n158\t\tif err != nil {\n159\t\t\treturn err\n160\t\t}\n161\t\n162\t\t// Marshal to JSON\n163\t\tdata, err := json.MarshalIndent(cache, \"\", \"  \")\n164\t\tif err != nil {\n165\t\t\treturn fmt.Errorf(\"marshaling cache: %w\", err)\n166\t\t}\n167\t\n168\t\t// Write to temp file first (atomic write)\n169\t\tdir := filepath.Dir(filePath)\n170\t\ttmpFile, err := os.CreateTemp(dir, \".version_check_tmp_\")\n171\t\tif err != nil {\n172\t\t\treturn fmt.Errorf(\"creating temp file: %w\", err)\n173\t\t}\n174\t\tdefer os.Remove(tmpFile.Name())\n175\t\n176\t\tif _, err := tmpFile.Write(data); err != nil {\n177\t\t\t_ = tmpFile.Close() // cleanup on error path\n178\t\t\treturn fmt.Errorf(\"writing cache: %w\", err)\n179\t\t}\n180\t\n181\t\tif err := tmpFile.Close(); err != nil {\n182\t\t\treturn fmt.Errorf(\"closing temp file: %w\", err)\n183\t\t}\n184\t\n185\t\t// Rename temp file to final location\n186\t\n187\t\tif err := os.Rename(tmpFile.Name(), filePath); err != nil {\n188\t\t\treturn fmt.Errorf(\"renaming cache file: %w\", err)\n189\t\t}\n190\t\n191\t\treturn nil\n192\t}\n193\t\n194\t// fetchLatestVersion fetches the latest stable version tag from the GitHub API.\n195\tfunc fetchLatestVersion(ctx context.Context) (string, error) {\n196\t\tctx, cancel := context.WithTimeout(ctx, httpTimeout)\n197\t\tdefer cancel()\n198\t\n199\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, githubAPIURL, nil)\n200\t\tif err != nil {\n201\t\t\treturn \"\", fmt.Errorf(\"creating request: %w\", err)\n202\t\t}\n203\t\n204\t\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n205\t\treq.Header.Set(\"User-Agent\", \"entire-cli\")\n206\t\n207\t\tclient := &http.Client{}\n208\t\tresp, err := client.Do(req)\n209\t\tif err != nil {\n210\t\t\treturn \"\", fmt.Errorf(\"fetching release info: %w\", err)\n211\t\t}\n212\t\tdefer resp.Body.Close()\n213\t\n214\t\tif resp.StatusCode != http.StatusOK {\n215\t\t\treturn \"\", fmt.Errorf(\"unexpected status code: %d\", resp.StatusCode)\n216\t\t}\n217\t\n218\t\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n219\t\tif err != nil {\n220\t\t\treturn \"\", fmt.Errorf(\"reading response: %w\", err)\n221\t\t}\n222\t\n223\t\tversion, err := parseGitHubRelease(body)\n224\t\tif err != nil {\n225\t\t\treturn \"\", fmt.Errorf(\"parsing release: %w\", err)\n226\t\t}\n227\t\treturn version, nil\n228\t}\n229\t\n230\t// isNightly returns true if the version string is a nightly build.\n231\tfunc isNightly(version string) bool {\n232\t\tif !strings.HasPrefix(version, \"v\") {\n233\t\t\tversion = \"v\" + version\n234\t\t}\n235\t\treturn strings.Contains(semver.Prerelease(version), \"nightly\")\n236\t}\n237\t\n238\t// fetchLatestNightlyVersion fetches the latest nightly version tag from the GitHub releases list.\n239\tfunc fetchLatestNightlyVersion(ctx context.Context) (string, error) {\n240\t\tctx, cancel := context.WithTimeout(ctx, httpTimeout)\n241\t\tdefer cancel()\n242\t\n243\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, githubReleasesURL+\"?per_page=20\", nil)\n244\t\tif err != nil {\n245\t\t\treturn \"\", fmt.Errorf(\"creating request: %w\", err)\n246\t\t}\n247\t\n248\t\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n249\t\treq.Header.Set(\"User-Agent\", \"entire-cli/\"+versioninfo.Version)\n250\t\n251\t\tclient := &http.Client{}\n252\t\tresp, err := client.Do(req)\n253\t\tif err != nil {\n254\t\t\treturn \"\", fmt.Errorf(\"fetching releases: %w\", err)\n255\t\t}\n256\t\tdefer resp.Body.Close()\n257\t\n258\t\tif resp.StatusCode != http.StatusOK {\n259\t\t\treturn \"\", fmt.Errorf(\"unexpected status code: %d\", resp.StatusCode)\n260\t\t}\n261\t\n262\t\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n263\t\tif err != nil {\n264\t\t\treturn \"\", fmt.Errorf(\"reading response: %w\", err)\n265\t\t}\n266\t\n267\t\tvar releases []GitHubRelease\n268\t\tif err := json.Unmarshal(body, &releases); err != nil {\n269\t\t\treturn \"\", fmt.Errorf(\"parsing JSON: %w\", err)\n270\t\t}\n271\t\n272\t\tfor _, r := range releases {\n273\t\t\tif r.Prerelease && strings.Contains(r.TagName, \"-nightly.\") {\n274\t\t\t\treturn r.TagName, nil\n275\t\t\t}\n276\t\t}\n277\t\n278\t\treturn \"\", errors.New(\"no nightly release found\")\n279\t}\n280\t\n281\t// parseGitHubRelease parses the GitHub API response and returns the latest stable version tag.\n282\t// Filters out prerelease versions.\n283\tfunc parseGitHubRelease(body []byte) (string, error) {\n284\t\tvar release GitHubRelease\n285\t\tif err := json.Unmarshal(body, &release); err != nil {\n286\t\t\treturn \"\", fmt.Errorf(\"parsing JSON: %w\", err)\n287\t\t}\n288\t\n289\t\tif release.Prerelease {\n290\t\t\treturn \"\", errors.New(\"only prerelease versions available\")\n291\t\t}\n292\t\n293\t\tif release.TagName == \"\" {\n294\t\t\treturn \"\", errors.New(\"empty tag name\")\n295\t\t}\n296\t\n297\t\treturn release.TagName, nil\n298\t}\n299\t\n300\t// isOutdated compares current and latest versions using semantic versioning.\n301\t// Returns true if current < latest.\n302\tfunc isOutdated(current, latest string) bool {\n303\t\t// Ensure versions have \"v\" prefix for semver package\n304\t\tif !strings.HasPrefix(current, \"v\") {\n305\t\t\tcurrent = \"v\" + current\n306\t\t}\n307\t\tif !strings.HasPrefix(latest, \"v\") {\n308\t\t\tlatest = \"v\" + latest\n309\t\t}\n310\t\n311\t\t// Skip notification for dev builds (e.g., \"1.0.0-dev-xxx\").\n312\t\t// These are local development builds and shouldn't trigger update notifications.\n313\t\t// Normal prereleases (e.g., \"1.0.0-rc1\") should still be compared normally.\n314\t\tif strings.Contains(semver.Prerelease(current), \"dev\") {\n315\t\t\treturn false\n316\t\t}\n317\t\n318\t\t// semver.Compare returns -1 if current < latest\n319\t\treturn semver.Compare(current, latest) < 0\n320\t}\n321\t\n322\tfunc versionCacheKey(version string) string {\n323\t\tif version == \"\" || strings.HasPrefix(version, \"v\") {\n324\t\t\treturn version\n325\t\t}\n326\t\treturn \"v\" + version\n327\t}\n328\t\n329\tfunc displayVersion(version string) string {\n330\t\treturn strings.TrimPrefix(version, \"v\")\n331\t}\n332\t\n333\tfunc releaseNotesURL(version string) string {\n334\t\treturn downloadsURL + \"/tag/\" + versionCacheKey(version)\n335\t}\n336\t\n337\t// executablePath is the function used to get the current exe