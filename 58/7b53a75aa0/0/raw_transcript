{"parentUuid":"fbeb8f0c-9bb0-45d4-b045-0628cad237fd","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gtrrz-victor/wks/cli/cli/test-auto.sh","snippet":"1\t#!/bin/sh\n2\t# Manual smoke test for the auto-update prompt.\n3\t#\n4\t# Builds entire with a stale version (0.0.1) into a fake install path that\n5\t# matches one of the install-manager detectors, stubs the installer\n6\t# command on PATH, runs a tiny local HTTP server that mocks the GitHub\n7\t# releases API (so we don't hit the real GitHub and get rate-limited),\n8\t# and invokes `entire version` so the version check fires the 3-option\n9\t# prompt.\n10\t#\n11\t# Usage:\n12\t#   ./test-auto.sh [brew|mise|scoop|bash]\n13\t#\n14\t# Defaults to brew. The bash variant exercises the curl-bash fallback\n15\t# used when no install manager is detected.\n16\t#\n17\t# To verify \"Skip until next version\" persistence, pick option 3 and\n18\t# re-run with --keep-home (the cached skipped version then suppresses\n19\t# the prompt):\n20\t#   ./test-auto.sh mise\n21\t#   ./test-auto.sh mise --keep-home\n22\t\n23\tset -eu\n24\t\n25\tINSTALLER=\"${1:-brew}\"\n26\tKEEP_HOME=0\n27\tif [ \"${2:-}\" = \"--keep-home\" ]; then\n28\t  KEEP_HOME=1\n29\tfi\n30\t\n31\tTEST_ROOT=/private/tmp/entire-autoupdate-test\n32\tFAKE_HOME=\"$TEST_ROOT/home\"\n33\tFAKE_BIN=\"$TEST_ROOT/bin\"\n34\tMOCK_PORT=18723\n35\tLATEST_TAG=\"v9.9.9\"\n36\t\n37\tcase \"$INSTALLER\" in\n38\t  brew)\n39\t    FAKE_INSTALL=\"$TEST_ROOT/fakebrew/Cellar/entire/0.0.1/bin\"\n40\t    SHIM_NAME=brew\n41\t    EXPECT_CMD=\"brew upgrade entire\"\n42\t    ;;\n43\t  mise)\n44\t    FAKE_INSTALL=\"$TEST_ROOT/fakemise/mise/installs/entire/0.0.1/bin\"\n45\t    SHIM_NAME=mise\n46\t    EXPECT_CMD=\"mise upgrade entire\"\n47\t    ;;\n48\t  scoop)\n49\t    FAKE_INSTALL=\"$TEST_ROOT/fakescoop/scoop/apps/entire/current\"\n50\t    SHIM_NAME=scoop\n51\t    EXPECT_CMD=\"scoop update entire/cli\"\n52\t    ;;\n53\t  bash)\n54\t    # No install-manager pattern matches → unknown → curl-bash fallback.\n55\t    # Option 1 runs `curl -fsSL https://entire.io/install.sh | bash`, so\n56\t    # we shim curl to a no-op to avoid hitting the network.\n57\t    FAKE_INSTALL=\"$TEST_ROOT/fakebash/usr/local/bin\"\n58\t    SHIM_NAME=curl\n59\t    EXPECT_CMD=\"curl -fsSL https://entire.io/install.sh | bash\"\n60\t    ;;\n61\t  *)\n62\t    echo \"unknown installer: $INSTALLER (want: brew|mise|scoop|bash)\" >&2\n63\t    exit 1\n64\t    ;;\n65\tesac\n66\t\n67\tif [ \"$KEEP_HOME\" -eq 0 ]; then\n68\t  rm -rf \"$TEST_ROOT\"\n69\tfi\n70\tmkdir -p \"$FAKE_HOME\" \"$FAKE_BIN\" \"$FAKE_INSTALL\"\n71\t\n72\tcat > \"$FAKE_BIN/$SHIM_NAME\" <<EOF\n73\t#!/bin/sh\n74\techo \"[fake $SHIM_NAME] $SHIM_NAME \\$*\"\n75\texit 0\n76\tEOF\n77\tchmod +x \"$FAKE_BIN/$SHIM_NAME\"\n78\t\n79\t# Mock GitHub releases API so we don't get rate-limited and can pin the\n80\t# \"latest\" version deterministically. Both endpoints return the same\n81\t# stable release; the binary is built as a stable version (0.0.1) so\n82\t# fetchLatestVersion() is the one that fires.\n83\tpython3 -c \"\n84\timport http.server, json, sys\n85\tport, tag = int(sys.argv[1]), sys.argv[2]\n86\tclass H(http.server.BaseHTTPRequestHandler):\n87\t    def do_GET(self):\n88\t        self.send_response(200)\n89\t        self.send_header('Content-Type', 'application/json')\n90\t        self.end_headers()\n91\t        if 'releases/latest' in self.path:\n92\t            body = {'tag_name': tag, 'prerelease': False}\n93\t        else:\n94\t            body = [{'tag_name': tag, 'prerelease': False}]\n95\t        self.wfile.write(json.dumps(body).encode())\n96\t    def log_message(self, *a, **kw):\n97\t        pass\n98\thttp.server.HTTPServer(('127.0.0.1', port), H).serve_forever()\n99\t\" \"$MOCK_PORT\" \"$LATEST_TAG\" >\"$TEST_ROOT/mock.log\" 2>&1 &\n100\tMOCK_PID=$!\n101\ttrap 'kill \"$MOCK_PID\" 2>/dev/null || true' EXIT INT TERM\n102\t\n103\t# Wait until the mock is accepting connections (max ~2s).\n104\ti=0\n105\twhile ! curl -fsS \"http://127.0.0.1:$MOCK_PORT/releases/latest\" >/dev/null 2>&1; do\n106\t  i=$((i + 1))\n107\t  if [ \"$i\" -gt 20 ]; then\n108\t    echo \"mock server failed to start; log:\" >&2\n109\t    cat \"$TEST_ROOT/mock.log\" >&2\n110\t    exit 1\n111\t  fi\n112\t  sleep 0.1\n113\tdone\n114\t\n115\t# Build with both GitHub URLs pointed at the mock server. The version\n116\t# check fetches /releases/latest for stable channels (our case) and\n117\t# /releases?per_page=20 for nightly.\n118\tgo build \\\n119\t  -ldflags \"-X github.com/entireio/cli/cmd/entire/cli/versioninfo.Version=0.0.1 \\\n120\t            -X github.com/entireio/cli/cmd/entire/cli/versioncheck.githubAPIURL=http://127.0.0.1:$MOCK_PORT/releases/latest \\\n121\t            -X github.com/entireio/cli/cmd/entire/cli/versioncheck.githubReleasesURL=http://127.0.0.1:$MOCK_PORT/releases\" \\\n122\t  -o \"$FAKE_INSTALL/entire\" \\\n123\t  ./cmd/entire\n124\t\n125\techo\n126\techo \"=== Testing installer: $INSTALLER ===\"\n127\techo \"Binary path: $FAKE_INSTALL/entire\"\n128\techo \"Expected option 1 command: $EXPECT_CMD\"\n129\techo \"HOME: $FAKE_HOME (keep-home=$KEEP_HOME)\"\n130\techo \"Mock GitHub: http://127.0.0.1:$MOCK_PORT (latest=$LATEST_TAG)\"\n131\techo\n132\t\n133\tenv -u CI -u ENTIRE_TEST_TTY \\\n134\t  HOME=\"$FAKE_HOME\" \\\n135\t  PATH=\"$FAKE_BIN:$PATH\" \\\n136\t  \"$FAKE_INSTALL/entire\" version"},"type":"attachment","uuid":"c691e969-9a7a-47f5-b182-8620dc6d2c51","timestamp":"2026-04-30T11:34:07.137Z","userType":"external","entrypoint":"cli","cwd":"/Users/gtrrz-victor/wks/cli/cli","sessionId":"51ee7b0f-9a32-4475-bb49-5a2c38ca73d9","version":"2.1.119","gitBranch":"align-auto-update-flows-for-all-installers","slug":"i-did-see-this-curious-cosmos"}
