\t\tt.Fatalf(\"installer called %d times, want 1\", f.installCalls)\n350\t\t\t\t}\n351\t\t\t\tif f.lastCommand != tt.wantCmd {\n352\t\t\t\t\tt.Errorf(\"installer got %q, want %q\", f.lastCommand, tt.wantCmd)\n353\t\t\t\t}\n354\t\t\t\tif action != autoUpdateActionUpdate {\n355\t\t\t\t\tt.Errorf(\"action = %q, want %q\", action, autoUpdateActionUpdate)\n356\t\t\t\t}\n357\t\t\t\tif !strings.Contains(buf.String(), \"Update complete\") {\n358\t\t\t\t\tt.Errorf(\"missing success message: %q\", buf.String())\n359\t\t\t\t}\n360\t\t\t})\n361\t\t}\n362\t}\n363\t\n364\tfunc TestMaybeAutoUpdate_AllInstallers_KillSwitchPrintsManualHint(t *testing.T) {\n365\t\tfor _, tt := range nonWindowsAutoInstallers() {\n366\t\t\tt.Run(tt.name, func(t *testing.T) {\n367\t\t\t\tf := newAutoUpdateFixture(t)\n368\t\t\t\ttt.setup(t)\n369\t\t\t\tt.Setenv(envKillSwitch, \"1\")\n370\t\n371\t\t\t\tvar buf bytes.Buffer\n372\t\t\t\tMaybeAutoUpdate(context.Background(), &buf, \"1.0.0\", \"v2.0.0\")\n373\t\n374\t\t\t\tif f.installCalls != 0 {\n375\t\t\t\t\tt.Errorf(\"installer called with kill-switch set\")\n376\t\t\t\t}\n377\t\t\t\tassertManualHint(t, buf.String(), tt.wantCmd)\n378\t\t\t})\n379\t\t}\n380\t}\n381\t\n382\tfunc TestMaybeAutoUpdate_AllInstallers_UserSkips(t *testing.T) {\n383\t\tfor _, tt := range nonWindowsAutoInstallers() {\n384\t\t\tt.Run(tt.name, func(t *testing.T) {\n385\t\t\t\tf := newAutoUpdateFixture(t)\n386\t\t\t\ttt.setup(t)\n387\t\t\t\tf.chooseValue = autoUpdateActionSkip\n388\t\n389\t\t\t\tvar buf bytes.Buffer\n390\t\t\t\taction := MaybeAutoUpdate(context.Background(), &buf, \"1.0.0\", \"v2.0.0\")\n391\t\n392\t\t\t\tif f.installCalls != 0 {\n393\t\t\t\t\tt.Errorf(\"installer called after user chose skip\")\n394\t\t\t\t}\n395\t\t\t\tif action != autoUpdateActionSkip {\n396\t\t\t\t\tt.Errorf(\"action = %q, want %q\", action, autoUpdateActionSkip)\n397\t\t\t\t}\n398\t\t\t})\n399\t\t}"}]},"uuid":"a475d25a-fa4b-49b8-bccf-1cdbd8b40ede","timestamp":"2026-04-30T12:27:47.101Z","toolUseRe