().\n    Title(fmt.Sprintf(\"Update available! %s -> %s\",\n        displayVersion(currentVersion), displayVersion(latestVersion))).\n    Description(\"Release notes: \" + releaseNotesURL(latestVersion)).\n    Options(\n        huh.NewOption(fmt.Sprintf(\"Update now (runs `%s`)\", cmdStr), autoUpdateActionUpdate),\n        huh.NewOption(\"Skip\", autoUpdateActionSkip),\n        huh.NewOption(\"Skip until next version\", autoUpdateActionSkipUntilNextVersion),\n    ).\n    Value(&action)\nform := huh.NewForm(huh.NewGroup(sel)).WithTheme(huh.ThemeDracula())\nif os.Getenv(\"ACCESSIBLE\") != \"\" {\n    form = form.WithAccessible(true)\n}\nerr := form.Run()\n```\n\nThat'd give you arrow-key TUI by default + plain prompt when `ACCESSIBLE=1`. **But** it breaks the \"preserve the brew wording byte-for-byte\" requirement you set earlier — the brew prompt as merged in PR #1057 uses the exact `\"1. Update now (runs ...)\\n2. Skip\\n3. Skip until next version\\n\\nPress enter to continue\\nChoose an option [1]: \"` string sequence, which `huh` won't render.\n\n**Recommendation:** keep what's there. The hand-rolled prompt IS already the equivalent of huh's accessible mode — it's the simplest plain-text fallback. If we add huh on top, we get a fancier default view but lose the wording lock-in and the deterministic tests. If you want the fancy TUI as a separate follow-up, do it in its own PR with a fresh wording review."}],"stop_reason":"end_turn","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":458,"cache_read_input_tokens":190054,"output_tokens":2363,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":458,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":1,"output_tokens":2363,"cache_read_input_tokens":190054,"cache_creation_input_tokens":458,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens"