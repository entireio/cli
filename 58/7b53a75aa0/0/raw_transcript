{"parentUuid":"4c67fe4b-df65-4944-8fbd-ca4e7dece469","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gtrrz-victor/wks/cli/cli/cmd/entire/cli/versioncheck/autoupdate.go","snippet":"1\tpackage versioncheck\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"runtime\"\n11\t\n12\t\t\"github.com/charmbracelet/huh\"\n13\t\n14\t\t\"github.com/entireio/cli/cmd/entire/cli/interactive\"\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n16\t)\n17\t\n18\t// envKillSwitch disables the interactive update prompt regardless of TTY.\n19\tconst envKillSwitch = \"ENTIRE_NO_AUTO_UPDATE\"\n20\t\n21\t// AutoUpdateAction describes the result of an update prompt.\n22\ttype AutoUpdateAction string\n23\t\n24\tconst (\n25\t\tautoUpdateActionSkip                 AutoUpdateAction = \"skip\"\n26\t\tautoUpdateActionUpdate               AutoUpdateAction = \"update\"\n27\t\tautoUpdateActionSkipUntilNextVersion AutoUpdateAction = \"skip_until_next_version\"\n28\t)\n29\t\n30\t// chooseUpdateFn is the signature for the update-prompt seam. The\n31\t// concrete implementation renders a huh.Select with the installer\n32\t// command interpolated into option 1.\n33\ttype chooseUpdateFn func(currentVersion, latestVersion, cmdStr string) (AutoUpdateAction, error)\n34\t\n35\t// Test seams.\n36\tvar (\n37\t\trunInstaller                 = realRunInstaller\n38\t\tchooseUpdate  chooseUpdateFn = realChooseUpdate\n39\t\tisTerminalOut                = interactive.IsTerminalWriter\n40\t)\n41\t\n42\t// MaybeAutoUpdate prints an update notification and offers an interactive\n43\t// upgrade. Silent on every failure path — it must never interrupt the CLI.\n44\t//\n45\t// The same 3-option prompt (update / skip / skip until next version) is\n46\t// shown for every install manager that supports auto-installation\n47\t// (brew, mise, scoop, curl-bash). The only thing that varies between\n48\t// installers is the shell command interpolated into option 1.\n49\t//\n50\t// If the installer command fails, a hint with the exact command is\n51\t// printed so the user can retry manually. The 24h version-check cache\n52\t// is not invalidated on failure: we don't want to re-prompt on every\n53\t// invocation while an upstream issue (network, auth, repo outage) is\n54\t// still in place.\n55\t//\n56\t// When the prompt cannot be shown (kill switch set, or non-interactive\n57\t// environment like CI / agent subprocess / no TTY) the installer\n58\t// command is printed so the user still learns what to run manually.\n59\t//\n60\t// On Windows + unknown install manager the POSIX curl-pipe-bash fallback\n61\t// can't auto-run and there's no native equivalent, so we point the user\n62\t// at the releases download page instead.\n63\tfunc MaybeAutoUpdate(ctx context.Context, w io.Writer, currentVersion, latestVersion string) AutoUpdateAction {\n64\t\tif !canAutoInstall() {\n65\t\t\tprintNotification(w, currentVersion, latestVersion)\n66\t\t\tfmt.Fprintf(w, \"To update, download the latest release from:\\n  %s\\n\", downloadsURL)\n67\t\t\treturn autoUpdateActionSkip\n68\t\t}\n69\t\n70\t\tcmdStr := updateCommand(currentVersion)\n71\t\n72\t\tif os.Getenv(envKillSwitch) != \"\" || !interactive.CanPromptInteractively() || !isTerminalOut(w) {\n73\t\t\tprintNotification(w, currentVersion, latestVersion)\n74\t\t\tfmt.Fprintf(w, \"To update, run:\\n  %s\\n\", cmdStr)\n75\t\t\treturn autoUpdateActionSkip\n76\t\t}\n77\t\n78\t\taction, err := chooseUpdate(currentVersion, latestVersion, cmdStr)\n79\t\tif err != nil {\n80\t\t\tlogging.Debug(ctx, \"auto-update: prompt failed\", \"error\", err.Error())\n81\t\t\treturn autoUpdateActionSkip\n82\t\t}\n83\t\n84\t\tswitch action {\n85\t\tcase autoUpdateActionUpdate:\n86\t\t\tfmt.Fprintf(w, \"\\nUpdating Entire CLI: %s\\n\", cmdStr)\n87\t\t\tif err := runInstaller(ctx, cmdStr); err != nil {\n88\t\t\t\tfmt.Fprintf(w, \"Update failed: %v\\nTry again later running:\\n  %s\\n\", err, cmdStr)\n89\t\t\t\treturn autoUpdateActionUpdate\n90\t\t\t}\n91\t\t\tfmt.Fprintln(w, \"Update complete. Re-run entire to use the new version.\")\n92\t\t\treturn autoUpdateActionUpdate\n93\t\tcase autoUpdateActionSkipUntilNextVersion:\n94\t\t\treturn autoUpdateActionSkipUntilNextVersion\n95\t\tcase autoUpdateActionSkip:\n96\t\t\treturn autoUpdateActionSkip\n97\t\tdefault:\n98\t\t\treturn autoUpdateActionSkip\n99\t\t}\n100\t}\n101\t\n102\t// realChooseUpdate renders a huh.Select with the three update actions.\n103\t// In normal mode this is an arrow-key TUI; when ACCESSIBLE is set huh\n104\t// falls back to a plain numbered prompt readable by screen readers.\n105\tfunc realChooseUpdate(currentVersion, latestVersion, cmdStr string) (AutoUpdateAction, error) {\n106\t\taction := autoUpdateActionUpdate\n107\t\tsel := huh.NewSelect[AutoUpdateAction]().\n108\t\t\tTitle(fmt.Sprintf(\"Update available! %s -> %s\",\n109\t\t\t\tdisplayVersion(currentVersion), displayVersion(latestVersion))).\n110\t\t\tDescription(\"Release notes: \"+releaseNotesURL(latestVersion)).\n111\t\t\tOptions(\n112\t\t\t\thuh.NewOption(fmt.Sprintf(\"Update now (runs `%s`)\", cmdStr), autoUpdateActionUpdate),\n113\t\t\t\thuh.NewOption(\"Skip\", autoUpdateActionSkip),\n114\t\t\t\thuh.NewOption(\"Skip until next version\", autoUpdateActionSkipUntilNextVersion),\n115\t\t\t).\n116\t\t\tValue(&action)\n117\t\tform := huh.NewForm(huh.NewGroup(sel)).WithTheme(huh.ThemeDracula())\n118\t\tif os.Getenv(\"ACCESSIBLE\") != \"\" {\n119\t\t\tform = form.WithAccessible(true)\n120\t\t}\n121\t\tif err := form.Run(); err != nil {\n122\t\t\tif errors.Is(err, huh.ErrUserAborted) || errors.Is(err, huh.ErrTimeout) {\n123\t\t\t\treturn autoUpdateActionSkip, nil\n124\t\t\t}\n125\t\t\treturn autoUpdateActionSkip, fmt.Errorf(\"update prompt: %w\", err)\n126\t\t}\n127\t\treturn action, nil\n128\t}\n129\t\n130\t// realRunInstaller shells out to the installer command, streaming stdin/stdout/stderr\n131\t// so password prompts and progress output reach the user.\n132\tfunc realRunInstaller(ctx context.Context, cmdStr string) error {\n133\t\tvar c *exec.Cmd\n134\t\tif runtime.GOOS == goosWindows {\n135\t\t\tc = exec.CommandContext(ctx, \"cmd\", \"/C\", cmdStr)\n136\t\t} else {\n137\t\t\tc = exec.CommandContext(ctx, \"sh\", \"-c\", cmdStr)\n138\t\t}\n139\t\tc.Stdin = os.Stdin\n140\t\tc.Stdout = os.Stdout\n141\t\tc.Stderr = os.Stderr\n142\t\tif err := c.Run(); err != nil {\n143\t\t\treturn fmt.Errorf(\"installer exited: %w\", err)\n144\t\t}\n145\t\treturn nil\n146\t}"},"type":"attachment","uuid":"e670b042-1748-4271-8a13-d92a3c54f489","timestamp":"2026-04-30T11:40:13.979Z","userType":"external","entrypoint":"cli","cwd":"/Users/gtrrz-victor/wks/cli/cli","sessionId":"51ee7b0f-9a32-4475-bb49-5a2c38ca73d9","version":"2.1.119","gitBranch":"align-auto-update-flows-for-all-installers","slug":"i-did-see-this-curious-cosmos"}
