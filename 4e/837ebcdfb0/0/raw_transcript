fName := plumbing.ReferenceName(paths.V2FullRefPrefix + gen.Name)\n\t\tif err := DeleteRefCLI(ctx, refName.String(), gen.RefOID); err != nil {\n\t\t\tfailed = append(failed, gen.Name)\n\t\t\tcontinue\n\t\t}\n\t\tdeleted = append(deleted, gen.Name)\n\t}\n\n\treturn deleted, failed, nil\n","exit_code":0,"duration":{"secs":0,"nanos":4792},"formatted_output":"","status":"completed"}}
