nt(ctx, p.repo)\n501\t\t}\n502\t\treturn nil\n503\t}\n504\t\n505\tfunc (p *generationPacker) writePendingToCurrent(ctx context.Context) error {\n506\t\tif len(p.pending) == 0 {\n507\t\t\treturn nil\n508\t\t}\n509\t\n510\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n511\t\tparentHash, rootTreeHash, err := p.v2Store.GetRefState(refName)\n512\t\tentries := make(map[string]object.TreeEntry)\n513\t\tif err != nil {\n514\t\t\tif !errors.Is(err, plumbing.ErrReferenceNotFound) {\n515\t\t\t\treturn fmt.Errorf(\"read v2 full/current ref: %w\", err)\n516\t\t\t}\n517\t\t\tparentHash = plumbing.ZeroHash\n518\t\t} else if rootTreeHash != plumbing.ZeroHash {\n519\t\t\trootTree, treeErr := p.repo.TreeObject(rootTreeHash)\n520\t\t\tif treeErr != nil {\n521\t\t\t\treturn fmt.Errorf(\"read v2 full/current tree: %w\", treeErr)\n522\t\t\t}\n523\t\t\texistingEntries, err := flattenMigratedFullEntries(p.repo, rootTree)\n524\t\t\tif err != nil {\n525\t\t\t\treturn fmt.Errorf(\"flatten v2 full/current tree: %w\", err)\n526\t\t\t}\n527\t\t\tfor _, entry := range existingEntries {\n528\t\t\t\tif entry.Name == paths.GenerationFileName {\n529\t\t\t\t\tcontinue\n530\t\t\t\t}\n531\t\t\t\tentries[entry.Name] = entry\n532\t\t\t}\n533\t\t}\n534\t\n535\t\tpendingEntries, err := buildMigratedFullEntrySet(ctx, p.repo, p.pending)\n536\t\tif err != nil {\n537\t\t\treturn fmt.Errorf(\"write migrated full/current entries: %w\", err)\n538\t\t}\n539\t\tfor _, rawPaths := range pendingEntries.rawArtifactPaths {\n540\t\t\tfor key := range entries {\n541\t\t\t\tif rawPaths.matches(key) {\n542\t\t\t\t\tdelete(entries, key)\n543\t\t\t\t}\n544\t\t\t}\n545\t\t}\n546\t\tfor _, entry := range pendingEntries.rawEntries {\n547\t\t\tentries[entry.Name] = entry\n548\t\t}\n549\t\tfor _, entry := range pendingEntries.taskEntries {\n550\t\t\tif _, exists := entries[entry.Name]; exists {\n551\t\t\t\tcontinue\n552\t\t\t}\n553\t\t\tentries[entry.Name] = entry\n554\t\t}\n555\t\n556\t\ttreeHash, err := checkp