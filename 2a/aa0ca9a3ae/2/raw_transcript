is much faster than filesystem walk. The base tree from HEAD already contains\n92\t\t\t// all unchanged tracked files. We also capture user's pre-existing deletions.\n93\t\t\tresult, err := collectChangedFiles(ctx, s.repo)\n94\t\t\tif err != nil {\n95\t\t\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to collect changed files: %w\", err)\n96\t\t\t}\n97\t\t\tallFiles = result.Changed\n98\t\t\t// Merge user's pre-existing deletions with agent's deletions\n99\t\t\tallDeletedFiles = result.Deleted\n100\t\t\tallDeletedFiles = append(allDeletedFiles, opts.DeletedFiles...)\n101\t\t} else {\n102\t\t\t// For subsequent checkpoints, only include modified/new files.\n103\t\t\t// Filter out gitignored files — agent transcripts may report files like .env\n104\t\t\t// that exist on disk but are gitignored. Without filtering, secrets in gitignored\n105\t\t\t// files would leak into the shadow branch and could be pushed to remotes.\n106\t\t\tcandidateFiles := make([]string, 0, len(opts.ModifiedFiles)+len(opts.NewFiles))\n107\t\t\tcandidateFiles = append(candidateFiles, opts.ModifiedFiles...)\n108\t\t\tcandidateFiles = append(candidateFiles, opts.NewFiles...)\n109\t\t\tallFiles = filterGitIgnoredFiles(ctx, s.repo, candidateFiles)\n110\t\t\tallDeletedFiles = opts.DeletedFiles\n111\t\t}\n112\t\n113\t\t// Build tree with changes\n114\t\ttreeHash, err := s.buildTreeWithChanges(ctx, baseTreeHash, allFiles, allDeletedFiles, opts.MetadataDir, opts.MetadataDirAbs)\n115\t\tif err != nil {\n116\t\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to build tree: %w\", err)\n117\t\t}\n118\t\n119\t\t// Deduplication: skip if tree hash matches the last checkpoint\n120\t\tif lastTreeHash != plumbing.ZeroHash && treeHash == lastTreeHash {\n121\t\t\treturn WriteTemporaryResult{\n122\t\t\t\tCommitHash: parentHash,\n123\t\t\t\tSkipped:    true,\n124\t\t\t}, nil\n125\t\t}\n126\t\n127\t\t// Create checkpoint commit with trailers\n128\t\tcommitMsg := trailers.FormatShadowCommit(opts.CommitMessage, opts.MetadataDir, opts.SessionID)\n129\t\n130\t\tcommitHash, err := s.createCommit(ctx, treeHash, parentHash, commitMsg, opts.AuthorName, opts.AuthorEmail)\n131\t\tif err != nil {\n132\t\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to create commit: %w\", err)\n133\t\t}\n134\t\n135\t\t// Update branch reference\n136\t\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n137\t\tnewRef := plumbing.NewHashReference(refName, commitHash)\n138\t\tif err := s.repo.Storer.SetReference(newRef); err != nil {\n139\t\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to update branch reference: %w\", err)\n140\t\t}\n141\t\n142\t\treturn WriteTemporaryResult{\n143\t\t\tCommitHash: commitHash,\n144\t\t\tSkipped:    false,\n145\t\t}, nil\n146\t}\n147\t\n148\t// ReadTemporary reads the latest checkpoint from a shadow branch.\n149\t// Returns nil if the shadow branch doesn't exist.\n150\t// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\n151\tfunc (s *GitStore) ReadTemporary(ctx context.Context, baseCommit, worktreeID string) (*ReadTemporaryResult, error) {\n152\t\tif err := ctx.Err(); err != nil {\n153\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n154\t\t}\n155\t\n156\t\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n157\t\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n158\t\n159\t\tref, err := s.repo.Reference(refName, true)\n160\t\tif err != nil {\n161\t\t\treturn nil, nil //nolint:nilnil,nilerr // Branch not found is an expected case\n162\t\t}\n163\t\n164\t\tcommit, err := s.repo.CommitObject(ref.Hash())\n165\t\tif err != nil {\n166\t\t\treturn nil, fmt.Errorf(\"failed to get commit object: %w\", err)\n167\t\t}\n168\t\n169\t\t// Extract session ID and metadata dir from commit trailers\n170\t\tsessionID, _ := trailers.ParseSession(commit.Message)\n171\t\tmetadataDir, _ := trailers.ParseMetadata(commit.Message)\n172\t\n173\t\treturn &ReadTemporaryResult{\n174\t\t\tCommitHash:  ref.Hash(),\n175\t\t\tTreeHash:    commit.TreeHash,\n176\t\t\tSessionID:   sessionID,\n177\t\t\tMetadataDir: metadataDir,\n178\t\t\tTimestamp:   commit.Author.When,\n179\t\t}, nil\n180\t}\n181\t\n182\t// ListTemporary lists all shadow branches with their checkpoint info.\n183\tfunc (s *GitStore) ListTemporary(ctx context.Context) ([]TemporaryInfo, error) {\n184\t\tif err := ctx.Err(); err != nil {\n185\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n186\t\t}\n187\t\n188\t\titer, err := s.repo.Branches()\n189\t\tif err != nil {\n190\t\t\treturn nil, fmt.Errorf(\"failed to list branches: %w\", err)\n191\t\t}\n192\t\n193\t\tvar results []TemporaryInfo\n194\t\terr = iter.ForEach(func(ref *plumbing.Reference) error {\n195\t\t\tif err := ctx.Err(); err != nil {\n196\t\t\t\treturn err //nolint:wrapcheck // Propagating context cancellation\n197\t\t\t}\n198\t\t\tbranchName := ref.Name().Short()\n199\t\t\tif !strings.HasPrefix(branchName, ShadowBranchPrefix) {\n200\t\t\t\treturn nil\n201\t\t\t}\n202\t\n203\t\t\t// Skip the sessions branch\n204\t\t\tif branchName == paths.MetadataBranchName {\n205\t\t\t\treturn nil\n206\t\t\t}\n207\t\n208\t\t\tcommit, commitErr := s.repo.CommitObject(ref.Hash())\n209\t\t\tif commitErr != nil {\n210\t\t\t\t//nolint:nilerr // Skip branches we can't read (non-fatal)\n211\t\t\t\treturn nil\n212\t\t\t}\n213\t\n214\t\t\tsessionID, _ := trailers.ParseSession(commit.Message)\n215\t\n216\t\t\t// Extract base commit from branch name (handles new \"entire/<commit>-<worktreeHash>\" format)\n217\t\t\tbaseCommit, _, _ := ParseShadowBranchName(branchName)\n218\t\n219\t\t\tresults = append(results, TemporaryInfo{\n220\t\t\t\tBranchName:   branchName,\n221\t\t\t\tBaseCommit:   baseCommit,\n222\t\t\t\tLatestCommit: ref.Hash(),\n223\t\t\t\tSessionID:    sessionID,\n224\t\t\t\tTimestamp:    commit.Author.When,\n225\t\t\t})\n226\t\n227\t\t\treturn nil\n228\t\t})\n229\t\n230\t\tif err != nil {\n231\t\t\treturn nil, fmt.Errorf(\"failed to iterate branches: %w\", err)\n232\t\t}\n233\t\n234\t\treturn results, nil\n235\t}\n236\t\n237\t// WriteTemporaryTask writes a task checkpoint to a shadow branch.\n238\t// Task checkpoints include both code changes and task-specific metadata.\n239\t// Returns the commit hash of the created checkpoint.\n240\tfunc (s *GitStore) WriteTemporaryTask(ctx context.Context, opts WriteTemporaryTaskOptions) (plumbing.Hash, error) {\n241\t\t// Validate base commit - required for shadow branch naming\n242\t\tif opts.BaseCommit == \"\" {\n243\t\t\treturn plumbing.ZeroHash, errors.New(\"BaseCommit is required for task checkpoint\")\n244\t\t}\n245\t\n246\t\t// Validate identifiers to prevent path traversal and malformed data\n247\t\tif err := validation.ValidateSessionID(opts.SessionID); err != nil {\n248\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\n249\t\t}\n250\t\tif err := validation.ValidateToolUseID(opts.ToolUseID); err != nil {\n251\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\n252\t\t}\n253\t\tif err := validation.ValidateAgentID(opts.AgentID); err != nil {\n254\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\n255\t\t}\n256\t\n257\t\t// Get shadow branch name\n258\t\tshadowBranchName := ShadowBranchNameForCommit(opts.BaseCommit, opts.WorktreeID)\n259\t\n260\t\t// Get or create shadow branch\n261\t\tparentHash, baseTreeHash, err := s.getOrCreateShadowBranch(shadowBranchName)\n262\t\tif err != nil {\n263\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get shadow branch: %w\", err)\n264\t\t}\n265\t\n266\t\t// Collect all files to include in the commit.\n267\t\t// Filter out gitignored files — subagent transcripts may report files like .env\n268\t\t// that exist on disk but are gitignored. Without filtering, secrets would leak\n269\t\t// into the shadow branch.\n270\t\tcandidateFiles := make([]string, 0, len(opts.ModifiedFiles)+len(opts.NewFiles))\n271\t\tcandidateFiles = append(candidateFiles, opts.ModifiedFiles...)\n272\t\tcandidateFiles = append(candidateFiles, opts.NewFiles...)\n273\t\tallFiles := filterGitIgnoredFiles(ctx, s.repo, candidateFiles)\n274\t\n275\t\t// Build new tree with code changes (no metadata dir yet)\n276\t\tnewTreeHash, err := s.buildTreeWithChanges(ctx, baseTreeHash, allFiles, opts.DeletedFiles, \"\", \"\")\n277\t\tif err != nil {\n278\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to build tree: %w\", err)\n279\t\t}\n280\t\n281\t\t// Add task metadata to tree\n282\t\tnewTreeHash, err = s.addTaskMetadataToTree(ctx, newTreeHash, opts)\n283\t\tif err != nil {\n284\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to add task metadata: %w\", err)\n285\t\t}\n286\t\n287\t\t// Create the commit\n288\t\tcommitHash, err := s.createCommit(ctx, newTreeHash, parentHash, opts.CommitMessage, opts.AuthorName, opts.AuthorEmail)\n289\t\tif err != nil {\n290\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to create commit: %w\", err)\n291\t\t}\n292\t\n293\t\t// Update shadow branch reference\n294\t\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n295\t\tref := plumbing.NewHashReference(refName, commitHash)\n296\t\tif err := s.repo.Storer.SetReference(ref); err != nil {\n297\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to update shadow branch reference: %w\", err)\n298\t\t}\n299\t\n300\t\treturn commitHash, nil\n301\t}\n302\t\n303\t// addTaskMetadataToTree adds task checkpoint metadata to a git tree.\n304\t// When IsIncremental is true, only adds the incremental checkpoint file.\n305\t//\n306\t// Uses ApplyTreeChanges (tree surgery) instead of FlattenTree+BuildTreeFromEntries,\n307\t// so only affected subtrees are read/rebuilt.\n308\tfunc (s *GitStore) addTaskMetadataToTree(ctx context.Context, baseTreeHash plumbing.Hash, opts WriteTemporaryTaskOptions) (plumbing.Hash, error) {\n309\t\t// Compute metadata paths\n310\t\tsessionMetadataDir := paths.EntireMetadataDir + \"/\" + opts.SessionID\n311\t\ttaskMetadataDir := sessionMetadataDir + \"/tasks/\" + opts.ToolUseID\n312\t\n313\t\tvar changes []TreeChange\n314\t\n315\t\tif opts.IsIncremental {\n316\t\t\t// Incremental checkpoint: only add the checkpoint file\n317\t\t\tvar incData json.RawMessage\n318\t\t\tif opts.IncrementalData != nil {\n319\t\t\t\tredacted, redactErr := redact.JSONLBytes(opts.IncrementalData)\n320\t\t\t\tif redactErr != nil {\n321\t\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to redact incremental checkpoint: %w\", redactErr)\n322\t\t\t\t}\n323\t\t\t\tincData = json.RawMessage(redacted.Bytes())\n324\t\t\t}\n325\t\t\tincrementalCheckpoint := struct {\n326\t\t\t\tType      string          `json:\"type\"`\n327\t\t\t\tToolUseID string          `json:\"tool_use_id\"`\n328\t\t\t\tTimestamp time.Time       `json:\"timestamp\"`\n329\t\t\t\tData      json.RawMessage `json:\"data\"`\n330\t\t\t}{\n331\t\t\t\tType:      opts.IncrementalType,\n332\t\t\t\tToolUseID: opts.ToolUseID,\n333\t\t\t\tTimestamp: time.Now().UTC(),\n334\t\t\t\tData:      incData,\n335\t\t\t}\n336\t\t\tcpData, err := jsonutil.MarshalIndentWithNewline(incrementalCheckpoint, \"\", \"  \")\n337\t\t\tif err != nil {\n338\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to marshal incremental checkpoint: %w\", err)\n339\t\t\t}\n340\t\n341\t\t\tcpBlobHash, err := CreateBlobFromContent(s.repo, cpData)\n342\t\t\tif err != nil {\n343\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to create incremental checkpoint blob: %w\", err)\n344\t\t\t}\n345\t\t\tcpFilename := fmt.Sprintf(\"%03d-%s.json\", opts.IncrementalSequence, opts.ToolUseID)\n346\t\t\tcpPath := taskMetadataDir + \"/checkpoints/\" + cpFilename\n347\t\t\tchanges = append(changes, TreeChange{\n348\t\t\t\tPath:  cpPath,\n349\t\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: cpBlobHash},\n350\t\t\t})\n351\t\t} else {\n352\t\t\t// Final checkpoint: add transcripts and checkpoint.json\n353\t\n354\t\t\t// Add session transcript (with chunking support for large transcripts)\n355\t\t\tif opts.TranscriptPath != \"\" {\n356\t\t\t\tif transcriptContent, readErr := os.ReadFile(opts.TranscriptPath); readErr == nil {\n357\t\t\t\t\tagentType := agent.DetectAgentTypeFromContent(transcriptContent)\n358\t\n359\t\t\t\t\t// Chunk if necessary\n360\t\t\t\t\tchunks, chunkErr := agent.ChunkTranscript(ctx, transcriptContent, agentType)\n361\t\t\t\t\tif chunkErr != nil {\n362\t\t\t\t\t\tlogging.Warn(ctx, \"failed to chunk transcript, checkpoint will be saved without transcript\",\n363\t\t\t\t\t\t\tslog.String(\"error\", chunkErr.Error()),\n364\t\t\t\t\t\t\tslog.String(\"session_id\", opts.SessionID),\n365\t\t\t\t\t\t)\n366\t\t\t\t\t} else {\n367\t\t\t\t\t\tfor i, chunk := range chunks {\n368\t\t\t\t\t\t\tchunkPath := sessionMetadataDir + \"/\" + agent.ChunkFileName(paths.TranscriptFileName, i)\n369\t\t\t\t\t\t\tblobHash, blobErr := CreateBlobFromContent(s.repo, chunk)\n370\t\t\t\t\t\t\tif blobErr != nil {\n371\t\t\t\t\t\t\t\tlogging.Warn(ctx, \"failed to create blob for transcript chunk\",\n372\t\t\t\t\t\t\t\t\tslog.String(\"error\", blobErr.Error()),\n373\t\t\t\t\t\t\t\t\tslog.String(\"session_id\", opts.SessionID),\n374\t\t\t\t\t\t\t\t\tslog.Int(\"chunk_index\", i),\n375\t\t\t\t\t\t\t\t)\n376\t\t\t\t\t\t\t\tcontinue\n377\t\t\t\t\t\t\t}\n378\t\t\t\t\t\t\tchanges = append(changes, TreeChange{\n379\t\t\t\t\t\t\t\tPath:  chunkPath,\n380\t\t\t\t\t\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: blobHash},\n381\t\t\t\t\t\t\t})\n382\t\t\t\t\t\t}\n383\t\t\t\t\t}\n384\t\t\t\t}\n385\t\t\t}\n386\t\n387\t\t\t// Add subagent transcript if available\n388\t\t\tif opts.SubagentTranscriptPath != \"\" && opts.AgentID != \"\" {\n389\t\t\t\tif agentContent, readErr := os.ReadFile(opts.SubagentTranscriptPath); readErr == nil {\n390\t\t\t\t\tredacted, jsonlErr := redact.JSONLBytes(agentContent)\n391\t\t\t\t\tif jsonlErr != nil {\n392\t\t\t\t\t\tlogging.Warn(ctx, \"subagent transcript is not valid JSONL, falling back to plain redaction\",\n393\t\t\t\t\t\t\tslog.String(\"path\", opts.SubagentTranscriptPath),\n394\t\t\t\t\t\t\tslog.String(\"error\", jsonlErr.Error()),\n395\t\t\t\t\t\t)\n396\t\t\t\t\t\tagentContent = redact.Bytes(agentContent)\n397\t\t\t\t\t} else {\n398\t\t\t\t\t\tagentContent = redacted.Bytes()\n399\t\t\t\t\t}\n400\t\t\t\t\tif blobHash, blobErr := CreateBlobFromContent(s.repo, agentContent); blobErr == nil {\n401\t\t\t\t\t\tagentPath := taskMetadataDir + \"/agent-\" + opts.AgentID + \".jsonl\"\n402\t\t\t\t\t\tchanges = append(changes, TreeChange{\n403\t\t\t\t\t\t\tPath:  agentPath,\n404\t\t\t\t\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: blobHash},\n405\t\t\t\t\t\t})\n406\t\t\t\t\t}\n407\t\t\t\t}\n408\t\t\t}\n409\t\n410\t\t\t// Add checkpoint.json\n411\t\t\tcheckpointJSON := fmt.Sprintf(`{\n412\t  \"session_id\": %q,\n413\t  \"tool_use_id\": %q,\n414\t  \"checkpoint_uuid\": %q,\n415\t  \"agent_id\": %q\n416\t}`, opts.SessionID, opts.ToolUseID, opts.CheckpointUUID, opts.AgentID)\n417\t\n418\t\t\tblobHash, err := CreateBlobFromContent(s.repo, []byte(checkpointJSON))\n419\t\t\tif err != nil {\n420\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to create checkpoint blob: %w\", err)\n421\t\t\t}\n422\t\t\tcheckpointPath := taskMetadataDir + \"/checkpoint.json\"\n423\t\t\tchanges = append(changes, TreeChange{\n424\t\t\t\tPath:  checkpointPath,\n425\t\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: blobHash},\n426\t\t\t})\n427\t\t}\n428\t\n429\t\treturn ApplyTreeChanges(ctx, s.repo, baseTreeHash, changes)\n430\t}\n431\t\n432\t// ListTemporaryCheckpoints lists all checkpoint commits on a shadow branch.\n433\t// This returns individual commits (rewind points), not just branch info.\n434\t// The sessionID filter, if provided, limits results to commits from that session.\n435\t// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\n436\tfunc (s *GitStore) ListTemporaryCheckpoints(ctx context.Context, baseCommit, worktreeID, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n437\t\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n438\t\treturn s.listCheckpointsForBranch(ctx, shadowBranchName, sessionID, limit)\n439\t}\n440\t\n441\t// ListCheckpointsForBranch lists checkpoint commits for a shadow branch by name.\n442\t// Use this when you already have the full branch name (e.g., from ListTemporary).\n443\t// The sessionID filter, if provided, limits results to commits from that session.\n444\tfunc (s *GitStore) ListCheckpointsForBranch(ctx context.Context, branchName, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n445\t\treturn s.listCheckpointsForBranch(ctx, branchName, sessionID, limit)\n446\t}\n447\t\n448\t// listCheckpointsForBranch lists checkpoint commits for a specific shadow branch name.\n449\t// This is an internal helper used by ListTemporaryCheckpoints, ListCheckpointsForBranch, and ListAllTemporaryCheckpoints.\n450\tfunc (s *GitStore) listCheckpointsForBranch(ctx context.Context, shadowBranchName, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n451\t\tif err := ctx.Err(); err != nil {\n452\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n453\t\t}\n454\t\n455\t\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n456\t\n457\t\tref, err := s.repo.Reference(refName, true)\n458\t\tif err != nil {\n459\t\t\treturn nil, nil //nolint:nilerr // No shadow branch is expected case\n460\t\t}\n461\t\n462\t\titer, err := s.repo.Log(&git.LogOptions{From: ref.Hash()})\n463\t\tif err != nil {\n464\t\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n465\t\t}\n466\t\n467\t\tvar results []TemporaryCheckpointInfo\n468\t\tcount := 0\n469\t\n470\t\terr = iter.ForEach(func(c *object.Commit) error {\n471\t\t\tif err := ctx.Err(); err != nil {\n472\t\t\t\treturn err //nolint:wrapcheck // Propagating context cancellation\n473\t\t\t}\n474\t\t\tif count >= limit*5 { // Scan more to allow for session filtering\n475\t\t\t\treturn errStop\n476\t\t\t}\n477\t\t\tcount++\n478\t\n479\t\t\t// Verify commit belongs to target session via Entire-Session trailer\n480\t\t\tcommitSessionID, hasTrailer := trailers.ParseSession(c.Message)\n481\t\t\tif !hasTrailer {\n482\t\t\t\treturn nil // Skip commits without session trailer\n483\t\t\t}\n484\t\t\tif sessionID != \"\" && commitSessionID != sessionID {\n485\t\t\t\treturn nil // Skip commits from other sessions\n486\t\t\t}\n487\t\n488\t\t\t// Get first line of message\n489\t\t\tmessage := c.Message\n490\t\t\tif idx := strings.Index(message, \"\\n\"); idx > 0 {\n491\t\t\t\tmessage = message[:idx]\n492\t\t\t}\n493\t\n494\t\t\tinfo := TemporaryCheckpointInfo{\n495\t\t\t\tCommitHash: c.Hash,\n496\t\t\t\tMessage:    message,\n497\t\t\t\tSessionID:  commitSessionID,\n498\t\t\t\tTimestamp:  c.Author.When,\n499\t\t\t}\n500\t\n501\t\t\t// Check for task checkpoint first\n502\t\t\ttaskMetadataDir, foundTask := trailers.ParseTaskMetadata(c.Message)\n503\t\t\tif foundTask {\n504\t\t\t\tinfo.IsTaskCheckpoint = true\n505\t\t\t\tinfo.MetadataDir = taskMetadataDir\n506\t\t\t\tinfo.ToolUseID = extractToolUseIDFromPath(taskMetadataDir)\n507\t\t\t} else {\n508\t\t\t\tmetadataDir, found := trailers.ParseMetadata(c.Message)\n509\t\t\t\tif found {\n510\t\t\t\t\tinfo.MetadataDir = metadataDir\n511\t\t\t\t}\n512\t\t\t}\n513\t\n514\t\t\tresults = append(results, info)\n515\t\n516\t\t\tif len(results) >= limit {\n517\t\t\t\treturn errStop\n518\t\t\t}\n519\t\t\treturn nil\n520\t\t})\n521\t\n522\t\tif err != nil && !errors.Is(err, errStop) {\n523\t\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n524\t\t}\n525\t\n526\t\treturn results, nil\n527\t}\n528\t\n529\t// ListAllTemporaryCheckpoints lists checkpoint commits from ALL shadow branches.\n530\t// This is used for checkpoint lookup when the base commit is unknown (e.g., HEAD advanced since session start).\n531\t// The sessionID filter, if provided, limits results to commits from that session.\n532\tfunc (s *GitStore) ListAllTemporaryCheckpoints(ctx context.Context, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n533\t\tif err := ctx.Err(); err != nil {\n534\t\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n535\t\t}\n536\t\n537\t\t// List all shadow branches\n538\t\tbranches, err := s.ListTemporary(ctx)\n539\t\tif err != nil {\n540\t\t\treturn nil, fmt.Errorf(\"failed to list shadow branches: %w\", err)\n541\t\t}\n542\t\n543\t\tvar results []TemporaryCheckpointInfo\n544\t\n545\t\t// Iterate through each shadow branch and collect checkpoints\n546\t\tfor _, branch := range branches {\n547\t\t\t// Use the branch name directly to get checkpoints\n548\t\t\tbranchCheckpoints, branchErr := s.listCheckpointsForBranch(ctx, branch.BranchName, sessionID, limit)\n549\t\t\tif branchErr != nil {\n550\t\t\t\tif errors.Is(branchErr, context.Canceled) || errors.Is(branchErr, context.DeadlineExceeded) {\n551\t\t\t\t\treturn nil, branchErr\n552\t\t\t\t}\n553\t\t\t\tcontinue // Skip branches we can't read\n554\t\t\t}\n555\t\t\tresults = append(results, branchCheckpoints...)\n556\t\t\tif len(results) >= limit {\n557\t\t\t\tresults = results[:limit]\n558\t\t\t\tbreak\n559\t\t\t}\n560\t\t}\n561\t\n562\t\treturn results, nil\n563\t}\n564\t\n565\t// extractToolUseIDFromPath extracts the ToolUseID from a task metadata directory path.\n566\t// Task metadata dirs have format: .entire/metadata/<session>/tasks/<toolUseID>\n567\tfunc extractToolUseIDFromPath(metadataDir string) string {\n568\t\tparts := strings.Split(metadataDir, \"/\")\n569\t\tif len(parts) >= 2 && parts[len(parts)-2] == \"tasks\" {\n570\t\t\treturn parts[len(parts)-1]\n571\t\t}\n572\t\treturn \"\"\n573\t}\n574\t\n575\t// errStop is a sentinel error used to break out of git log iteration.\n576\tvar errStop = errors.New(\"stop iteration\")\n577\t\n578\t// GetTranscriptFromCommit retrieves the transcript from a specific commit's tree.\n579\t// This is used for shadow branch checkpoints where the transcript is stored in the commit tree\n580\t// rather than on the entire/checkpoints/v1 branch.\n581\t// commitHash is the commit to read from, metadataDir is the path within the tree.\n582\t// agentType is used for reassembling chunked transcripts in the correct format.\n583\t// Handles both chunked and non-chunked transcripts.\n584\tfunc (s *GitStore) GetTranscriptFromCommit(ctx context.Context, commitHash plumbing.Hash, metadataDir string, agentType types.AgentType) ([]byte, error) {\n585\t\tcommit, err := s.repo.CommitObject(commitHash)\n586\t\tif err != nil {\n587\t\t\treturn nil, fmt.Errorf(\"failed to get commit: %w\", err)\n588\t\t}\n589\t\n590\t\ttree, err := commit.Tree()\n591\t\tif err != nil {\n592\t\t\treturn nil, fmt.Errorf(\"failed to get commit tree: %w\", err)\n593\t\t}\n594\t\n595\t\t// Try to get the metadata subtree for chunk detection\n596\t\tsubTree, subTreeErr := tree.Tree(metadataDir)\n597\t\tif subTreeErr == nil {\n598\t\t\t// Use the helper function that handles chunking.\n599\t\t\t// Wrap in FetchingTree with nil fetcher (temporary reads are always local).\n600\t\t\tft := &FetchingTree{inner: subTree}\n601\t\t\ttranscript, err := readTranscriptFromTree(ctx, ft, agentType)\n602\t\t\tif err == nil && transcript != nil {\n603\t\t\t\treturn transcript, nil\n604\t\t\t}\n605\t\t}\n606\t\n607\t\t// Fall back to direct file access (for backwards compatibility)\n608\t\ttranscriptPath := metadataDir + \"/\" + paths.TranscriptFileName\n609\t\tif file, fileErr := tree.File(transcriptPath); fileErr == nil {\n610\t\t\tcontent, contentErr := file.Contents()\n611\t\t\tif contentErr == nil {\n612\t\t\t\treturn []byte(content), nil\n613\t\t\t}\n614\t\t}\n615\t\n616\t\ttranscriptPath = metadataDir + \"/\" + paths.TranscriptFileNameLegacy\n617\t\tif file, fileErr := tree.File(transcriptPath); fileErr == nil {\n618\t\t\tcontent, contentErr := file.Contents()\n619\t\t\tif contentErr == nil {\n620\t\t\t\treturn []byte(content), nil\n621\t\t\t}\n622\t\t}\n623\t\n624\t\treturn nil, ErrNoTranscript\n625\t}\n626\t\n627\t// ShadowBranchExists checks if a shadow branch exists for the given base commit and worktree.\n628\t// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\n629\tfunc (s *GitStore) ShadowBranchExists(baseCommit, worktreeID string) bool {\n630\t\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n631\t\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n632\t\t_, err := s.repo.Reference(refName, true)\n633\t\treturn err == nil\n634\t}\n635\t\n636\t// DeleteShadowBranch deletes the shadow branch for the given base commit and worktree.\n637\t// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\n638\t// Uses git CLI instead of go-git's RemoveReference because go-git v5 doesn't properly\n639\t// persist deletions with packed refs or worktrees.\n640\tfunc (s *GitStore) DeleteShadowBranch(ctx context.Context, baseCommit, worktreeID string) error {\n641\t\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n642\t\tcmd := exec.CommandContext(ctx, \"git\", \"branch\", \"-D\", \"--\", shadowBranchName)\n643\t\tif output, err := cmd.CombinedOutput(); err != nil {\n644\t\t\treturn fmt.Errorf(\"failed to delete shadow branch %s: %s: %w\", shadowBranchName, strings.TrimSpace(string(output)), err)\n645\t\t}\n646\t\treturn nil\n647\t}\n648\t\n649\t// ShadowBranchNameForCommit returns the shadow branch name for a base commit hash\n650\t// and worktree identifier. The worktree ID should be empty for the main worktree\n651\t// or the internal git worktree name for linked worktrees.\n652\t// Format: entire/<commit[:7]>-<hash(worktreeID)[:6]>\n653\tfunc ShadowBranchNameForCommit(baseCommit, worktreeID string) string {\n654\t\tcommitPart := baseCommit\n655\t\tif len(baseCommit) >= ShadowBranchHashLength {\n656\t\t\tcommitPart = baseCommit[:ShadowBranchHashLength]\n657\t\t}\n658\t\tworktreeHash := HashWorktreeID(worktreeID)\n659\t\treturn ShadowBranchPrefix + commitPart + \"-\" + worktreeHash\n660\t}\n661\t\n662\t// ParseShadowBranchName extracts the commit prefix and worktree hash from a shadow branch name.\n663\t// Input format: \"entire/<commit[:7]>-<worktreeHash[:6]>\"\n664\t// Returns (commitPrefix, worktreeHash, ok). Returns (\"\", \"\", false) if not a valid shadow branch.\n665\tfunc ParseShadowBranchName(branchName string) (commitPrefix, worktreeHash string, ok bool) {\n666\t\tif !strings.HasPrefix(branchName, ShadowBranchPrefix) {\n667\t\t\treturn \"\", \"\", false\n668\t\t}\n669\t\tsuffix := strings.TrimPrefix(branchName, ShadowBranchPrefix)\n670\t\n671\t\t// Find the last dash - everything before is commit prefix, after is worktree hash\n672\t\tlastDash := strings.LastIndex(suffix, \"-\")\n673\t\tif lastDash == -1 || lastDash == 0 || lastDash == len(suffix)-1 {\n674\t\t\t// No dash, or dash at start/end - invalid format\n675\t\t\t// Could be old format \"entire/<commit[:7]>\" without worktree hash\n676\t\t\treturn suffix, \"\", true // Return as commit prefix with empty worktree hash\n677\t\t}\n678\t\n679\t\treturn suffix[:lastDash], suffix[lastDash+1:], true\n680\t}\n681\t\n682\t// getOrCreateShadowBranch gets or creates the shadow branch for checkpoints.\n683\t// Returns (parentHash, baseTreeHash, error).\n684\tfunc (s *GitStore) getOrCreateShadowBranch(branchName string) (plumbing.Hash, plumbing.Hash, error) {\n685\t\trefName := plumbing.NewBranchReferenceName(branchName)\n686\t\tref, err := s.repo.Reference(refName, true)\n687\t\n688\t\tif err == nil {\n689\t\t\t// Branch exists\n690\t\t\tcommit, err := s.repo.CommitObject(ref.Hash())\n691\t\t\tif err != nil {\n692\t\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get commit object: %w\", err)\n693\t\t\t}\n694\t\t\treturn ref.Hash(), commit.TreeHash, nil\n695\t\t}\n696\t\n697\t\t// Branch doesn't exist, use current HEAD's tree as base\n698\t\thead, err := s.repo.Head()\n699\t\tif err != nil {\n700\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get HEAD: %w\", err)\n701\t\t}\n702\t\n703\t\theadCommit, err := s.repo.CommitObject(head.Hash())\n704\t\tif err != nil {\n705\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get HEAD commit: %w\", err)\n706\t\t}\n707\t\n708\t\treturn plumbing.ZeroHash, headCommit.TreeHash, nil\n709\t}\n710\t\n711\t// buildTreeWithChanges builds a git tree with the given changes.\n712\t// metadataDir is the relative path for git tree entries, metadataDirAbs is the absolute path\n713\t// for filesystem operations (needed when CLI is run from a subdirectory).\n714\t//\n715\t// Uses ApplyTreeChanges (tree surgery) instead of FlattenTree+BuildTreeFromEntries,\n716\t// so only affected subtrees are read/rebuilt — O(changed dirs) instead of O(total files).\n717\tfunc (s *GitStore) buildTreeWithChanges(\n718\t\tctx context.Context,\n719\t\tbaseTreeHash plumbing.Hash,\n720\t\tmodifiedFiles, deletedFiles []string,\n721\t\tmetadataDir, metadataDirAbs string,\n722\t) (plumbing.Hash, error) {\n723\t\t// Get worktree root for resolving file paths\n724\t\t// This is critical because fileExists() and createBlobFromFile() use os.Stat()\n725\t\t// which resolves relative to CWD. The modifiedFiles are repo-relative paths,\n726\t\t// so we must resolve them against repo root, not CWD.\n727\t\trepoRoot, err := paths.WorktreeRoot(ctx)\n728\t\tif err != nil {\n729\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get worktree root: %w\", err)\n730\t\t}\n731\t\n732\t\t// Build list of tree changes\n733\t\tchanges := make([]TreeChange, 0, len(modifiedFiles)+len(deletedFiles))\n734\t\n735\t\t// Deleted files → nil Entry means deletion\n736\t\tfor _, file := range deletedFiles {\n737\t\t\trelPath, relErr := normalizeRepoRelativeTreePath(repoRoot, file)\n738\t\t\tif relErr != nil {\n739\t\t\t\tlogInvalidGitTreePath(ctx, \"delete shadow branch entry\", file, relErr)\n740\t\t\t\tcontinue\n741\t\t\t}\n742\t\t\tchanges = append(changes, TreeChange{Path: relPath, Entry: nil})\n743\t\t}\n744\t\n745\t\t// Modified/new files → create blobs from disk\n746\t\tfor _, file := range modifiedFiles {\n747\t\t\trelPath, relErr := normalizeRepoRelativeTreePath(repoRoot, file)\n748\t\t\tif relErr != nil {\n749\t\t\t\tlogInvalidGitTreePath(ctx, \"add shadow branch entry\", file, relErr)\n750\t\t\t\tcontinue\n751\t\t\t}\n752\t\n753\t\t\tabsPath := filepath.Join(repoRoot, filepath.FromSlash(relPath))\n754\t\t\tif !fileExists(absPath) {\n755\t\t\t\t// File disappeared since detection — treat as deletion\n756\t\t\t\tchanges = append(changes, TreeChange{Path: relPath, Entry: nil})\n757\t\t\t\tcontinue\n758\t\t\t}\n759\t\n760\t\t\tblobHash, mode, blobErr := createBlobFromFile(s.repo, absPath)\n761\t\t\tif blobErr != nil {\n762\t\t\t\t// Skip files that can't be staged (may have been deleted since detection)\n763\t\t\t\tcontinue\n764\t\t\t}\n765\t\n766\t\t\tchanges = append(changes, TreeChange{\n767\t\t\t\tPath: relPath,\n768\t\t\t\tEntry: &object.TreeEntry{\n769\t\t\t\t\tMode: mode,\n770\t\t\t\t\tHash: blobHash,\n771\t\t\t\t},\n772\t\t\t})\n773\t\t}\n774\t\n775\t\t// Metadata directory files\n776\t\tif metadataDir != \"\" && metadataDirAbs != \"\" {\n777\t\t\tmetadataRel, relErr := normalizeRepoRelativeTreePath(repoRoot, metadataDir)\n778\t\t\tif relErr != nil {\n779\t\t\t\tlogInvalidGitTreePath(ctx, \"add metadata directory\", metadataDir, relErr)\n780\t\t\t} else {\n781\t\t\t\tmetaChanges, metaErr := addDirectoryToChanges(s.repo, metadataDirAbs, metadataRel)\n782\t\t\t\tif metaErr != nil {\n783\t\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to add metadata directory: %w\", metaErr)\n784\t\t\t\t}\n785\t\t\t\tchanges = append(changes, metaChanges...)\n786\t\t\t}\n787\t\t}\n788\t\n789\t\treturn ApplyTreeChanges(ctx, s.repo, baseTreeHash, changes)\n790\t}\n791\t\n792\t// createCommit creates a commit object.\n793\tfunc (s *GitStore) createCommit(ctx context.Context, treeHash, parentHash plumbing.Hash, message, authorName, authorEmail string) (plumbing.Hash, error) {\n794\t\treturn CreateCommit(ctx, s.repo, treeHash, parentHash, message, authorName, authorEmail)\n795\t}\n796\t\n797\t// Helper functions extracted from strategy/common.go\n798\t// These are exported for use by strategy package (push_common.go, session_test.go)\n799\t\n800\t// FlattenTree recursively flattens a tree into a map of full paths to entries.\n801\tfunc FlattenTree(repo *git.Repository, tree *object.Tree, prefix string, entries map[string]object.TreeEntry) error {\n802\t\tfor _, entry := range tree.Entries {\n803\t\t\tfullPath := entry.Name\n804\t\t\tif prefix != \"\" {\n805\t\t\t\tfullPath = prefix + \"/\" + entry.Name\n806\t\t\t}\n807\t\n808\t\t\tif entry.Mode == filemode.Dir {\n809\t\t\t\t// Recurse into subtree\n810\t\t\t\tsubtree, err := repo.TreeObject(entry.Hash)\n811\t\t\t\tif err != nil {\n812\t\t\t\t\treturn fmt.Errorf(\"failed to get subtree %s: %w\", fullPath, err)\n813\t\t\t\t}\n814\t\t\t\tif err := FlattenTree(repo, subtree, fullPath, entries); err != nil {\n815\t\t\t\t\treturn err\n816\t\t\t\t}\n817\t\t\t} else {\n818\t\t\t\tentries[fullPath] = object.TreeEntry{\n819\t\t\t\t\tName: fullPath,\n820\t\t\t\t\tMode: entry.Mode,\n821\t\t\t\t\tHash: entry.Hash,\n822\t\t\t\t}\n823\t\t\t}\n824\t\t}\n825\t\treturn nil\n826\t}\n827\t\n828\t// fileExists checks if a file exists at the given path.\n829\tfunc fileExists(path string) bool {\n830\t\t_, err := os.Stat(path)\n831\t\treturn err == nil\n832\t}\n833\t\n834\t// createBlobFromFile creates a blob object from a file in the working directory.\n835\tfunc createBlobFromFile(repo *git.Repository, filePath string) (plumbing.Hash, filemode.FileMode, error) {\n836\t\tinfo, err := os.Stat(filePath)\n837\t\tif err != nil {\n838\t\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to stat file: %w\", err)\n839\t\t}\n840\t\n841\t\t// Determine file mode\n842\t\tmode := filemode.Regular\n843\t\tif info.Mode()&0o111 != 0 {\n844\t\t\tmode = filemode.Executable\n845\t\t}\n846\t\tif info.Mode()&os.ModeSymlink != 0 {\n847\t\t\tmode = filemode.Symlink\n848\t\t}\n849\t\n850\t\t// Read file contents\n851\t\tcontent, err := os.ReadFile(filePath) //nolint:gosec // filePath comes from walking the repository\n852\t\tif err != nil {\n853\t\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to read file: %w\", err)\n854\t\t}\n855\t\n856\t\t// Create blob object\n857\t\tobj := repo.Storer.NewEncodedObject()\n858\t\tobj.SetType(plumbing.BlobObject)\n859\t\tobj.SetSize(int64(len(content)))\n860\t\n861\t\twriter, err := obj.Writer()\n862\t\tif err != nil {\n863\t\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to get object writer: %w\", err)\n864\t\t}\n865\t\n866\t\t_, err = writer.Write(content)\n867\t\tif err != nil {\n868\t\t\t_ = writer.Close()\n869\t\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to write blob content: %w\", err)\n870\t\t}\n871\t\tif err := writer.Close(); err != nil {\n872\t\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to close blob writer: %w\", err)\n873\t\t}\n874\t\n875\t\thash, err := repo.Storer.SetEncodedObject(obj)\n876\t\tif err != nil {\n877\t\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to store blob object: %w\", err)\n878\t\t}\n879\t\n880\t\treturn hash, mode, nil\n881\t}\n882\t\n883\t// addDirectoryToEntriesWithAbsPath recursively adds all files in a directory to the entries map.\n884\tfunc addDirectoryToEntriesWithAbsPath(repo *git.Repository, dirPathAbs, dirPathRel string, entries map[string]object.TreeEntry) error {\n885\t\terr := filepath.Walk(dirPathAbs, func(path string, info os.FileInfo, err error) error {\n886\t\t\tif err != nil {\n887\t\t\t\treturn err\n888\t\t\t}\n889\t\n890\t\t\t// Skip symlinks to prevent reading files outside the metadata directory.\n891\t\t\t// A symlink could point to sensitive files (e.g., /etc/passwd) which would\n892\t\t\t// then be captured in the checkpoint and stored in git history.\n893\t\t\t// NOTE: filepath.Walk uses os.Stat (follows symlinks), so info.Mode() never\n894\t\t\t// reports ModeSymlink. We use os.Lstat to check the entry itself.\n895\t\t\t// This check MUST come before IsDir() because Walk follows symlinked\n896\t\t\t// directories and would recurse into them otherwise.\n897\t\t\tlinfo, lstatErr := os.Lstat(path)\n898\t\t\tif lstatErr != nil {\n899\t\t\t\treturn fmt.Errorf(\"failed to lstat %s: %w\", path, lstatErr)\n900\t\t\t}\n901\t\t\tif linfo.Mode()&os.ModeSymlink != 0 {\n902\t\t\t\tif info.IsDir() {\n903\t\t\t\t\treturn filepath.SkipDir\n904\t\t\t\t}\n905\t\t\t\treturn nil\n906\t\t\t}\n907\t\n908\t\t\tif info.IsDir() {\n909\t\t\t\treturn nil\n910\t\t\t}\n911\t\n912\t\t\t// Calculate relative path within the directory, then join with dirPathRel for tree entry\n913\t\t\trelWithinDir, err := filepath.Rel(dirPathAbs, path)\n914\t\t\tif err != nil {\n915\t\t\t\treturn fmt.Errorf(\"failed to get relative path for %s: %w\", path, err)\n916\t\t\t}\n917\t\n918\t\t\t// Prevent path traversal via symlinks pointing outside the metadata dir\n919\t\t\tif strings.HasPrefix(relWithinDir, \"..\") {\n920\t\t\t\treturn fmt.Errorf(\"path traversal detected: %s\", relWithinDir)\n921\t\t\t}\n922\t\n923\t\t\ttreePath := filepath.ToSlash(filepath.Join(dirPathRel, relWithinDir))\n924\t\n925\t\t\t// Use redacted blob creation for metadata files (transcripts, prompts, etc.)\n926\t\t\t// to ensure PII and secrets are redacted before writing to git.\n927\t\t\tblobHash, mode, err := createRedactedBlobFromFile(repo, path, treePath)\n928\t\t\tif err != nil {\n929\t\t\t\treturn fmt.Errorf(\"failed to create blob for %s: %w\", path, err)\n930\t\t\t}\n931\t\t\tentries[treePath] = object.TreeEntry{\n932\t\t\t\tName: treePath,\n933\t\t\t\tMode: mode,\n934\t\t\t\tHash: blobHash,\n935\t\t\t}\n936\t\t\treturn nil\n937\t\t})\n938\t\tif err != nil {\n939\t\t\treturn fmt.Errorf(\"failed to walk directory %s: %w\", dirPathAbs, err)\n940\t\t}\n941\t\treturn nil\n942\t}\n943\t\n944\t// treeNode represents a node in our tree structure.\n945\ttype treeNode struct {\n946\t\tentries map[string]*treeNode // subdirectories\n947\t\tfiles   []object.TreeEntry   // files in this directory\n948\t}\n949\t\n950\t// addDirectoryToChanges walks a filesystem directory and returns TreeChange entries\n951\t// for each file, suitable for use with ApplyTreeChanges.\n952\t// dirPathAbs is the absolute filesystem path; dirPathRel is the git tree-relative path.\n953\tfunc addDirectoryToChanges(repo *git.Repository, dirPathAbs, dirPathRel string) ([]TreeChange, error) {\n954\t\tvar changes []TreeChange\n955\t\terr := filepath.Walk(dirPathAbs, func(path string, info os.FileInfo, err error) error {\n956\t\t\tif err != nil {\n957\t\t\t\treturn err\n958\t\t\t}\n959\t\n960\t\t\t// Skip symlinks (same security rationale as addDirectoryToEntriesWithAbsPath)\n961\t\t\tlinfo, lstatErr := os.Lstat(path)\n962\t\t\tif lstatErr != nil {\n963\t\t\t\treturn fmt.Errorf(\"failed to lstat %s: %w\", path, lstatErr)\n964\t\t\t}\n965\t\t\tif linfo.Mode()&os.ModeSymlink != 0 {\n966\t\t\t\tif info.IsDir() {\n967\t\t\t\t\treturn filepath.SkipDir\n968\t\t\t\t}\n969\t\t\t\treturn nil\n970\t\t\t}\n971\t\n972\t\t\tif info.IsDir() {\n973\t\t\t\treturn nil\n974\t\t\t}\n975\t\n976\t\t\trelWithinDir, relErr := filepath.Rel(dirPathAbs, path)\n977\t\t\tif relErr != nil {\n978\t\t\t\treturn fmt.Errorf(\"failed to get relative path for %s: %w\", path, relErr)\n979\t\t\t}\n980\t\t\tif strings.HasPrefix(relWithinDir, \"..\") {\n981\t\t\t\treturn fmt.Errorf(\"path traversal detected: %s\", relWithinDir)\n982\t\t\t}\n983\t\n984\t\t\ttreePath := filepath.ToSlash(filepath.Join(dirPathRel, relWithinDir))\n985\t\n986\t\t\tblobHash, mode, blobErr := createRedactedBlobFromFile(repo, path, treePath)\n987\t\t\tif blobErr != nil {\n988\t\t\t\treturn fmt.Errorf(\"failed to create blob for %s: %w\", path, blobErr)\n989\t\t\t}\n990\t\t\tchanges = append(changes, TreeChange{\n991\t\t\t\tPath:  treePath,\n992\t\t\t\tEntry: &object.TreeEntry{Mode: mode, Hash: blobHash},\n993\t\t\t})\n994\t\t\treturn nil\n995\t\t})\n996\t\tif err != nil {\n997\t\t\treturn nil, fmt.Errorf(\"failed to walk directory %s: %w\", dirPathAbs, err)\n998\t\t}\n999\t\treturn changes, nil\n1000\t}\n1001\t\n1002\t// BuildTreeFromEntries builds a proper git tree structure from flattened file entries.\n1003\t// Exported for use by strategy package (push_common.go, session_test.go)\n1004\tfunc BuildTreeFromEntries(ctx context.Context, repo *git.Repository, entries map[string]object.TreeEntry) (plumbing.Hash, error) {\n1005\t\t// Build a tree structure\n1006\t\troot := &treeNode{\n1007\t\t\tentries: make(map[string]*treeNode),\n1008\t\t\tfiles:   []object.TreeEntry{},\n1009\t\t}\n1010\t\n1011\t\t// Insert all entries into the tree structure\n1012\t\tfor fullPath, entry := range entries {\n1013\t\t\tnormalizedPath, err := normalizeGitTreePath(fullPath)\n1014\t\t\tif err != nil {\n1015\t\t\t\tlogInvalidGitTreePath(ctx, \"build tree entry\", fullPath, err)\n1016\t\t\t\tcontinue\n1017\t\t\t}\n1018\t\t\tparts := strings.Split(normalizedPath, \"/\")\n1019\t\t\tinsertIntoTree(root, parts, entry)\n1020\t\t}\n1021\t\n1022\t\t// Recursively build tree objects from bottom up\n1023\t\treturn buildTreeObject(repo, root)\n1024\t}\n1025\t\n1026\tfunc normalizeRepoRelativeTreePath(repoRoot, path string) (string, error) {\n1027\t\tif rel := paths.ToRelativePath(path, repoRoot); rel != \"\" && rel != \".\" {\n1028\t\t\treturn normalizeGitTreePath(rel)\n1029\t\t}\n1030\t\n1031\t\treturn normalizeGitTreePath(path)\n1032\t}\n1033\t\n1034\t// insertIntoTree inserts a file entry into the tree structure.\n1035\tfunc insertIntoTree(node *treeNode, pathParts []string, entry object.TreeEntry) {\n1036\t\tif len(pathParts) == 1 {\n1037\t\t\t// This is a file in the current directory\n1038\t\t\tnode.files = append(node.files, object.TreeEntry{\n1039\t\t\t\tName: pathParts[0],\n1040\t\t\t\tMode: entry.Mode,\n1041\t\t\t\tHash: entry.Hash,\n1042\t\t\t})\n1043\t\t\treturn\n1044\t\t}\n1045\t\n1046\t\t// This is in a subdirectory\n1047\t\tdirName := pathParts[0]\n1048\t\tif node.entries[dirName] == nil {\n1049\t\t\tnode.entries[dirName] = &treeNode{\n1050\t\t\t\tentries: make(map[string]*treeNode),\n1051\t\t\t\tfiles:   []object.TreeEntry{},\n1052\t\t\t}\n1053\t\t}\n1054\t\tinsertIntoTree(node.entries[dirName], pathParts[1:], entry)\n1055\t}\n1056\t\n1057\t// buildTreeObject recursively builds tree objects from a treeNode.\n1058\tfunc buildTreeObject(repo *git.Repository, node *treeNode) (plumbing.Hash, error) {\n1059\t\tvar treeEntries []object.TreeEntry\n1060\t\n1061\t\t// Add files\n1062\t\ttreeEntries = append(treeEntries, node.files...)\n1063\t\n1064\t\t// Recursively build subtrees\n1065\t\tfor name, subnode := range node.entries {\n1066\t\t\tsubHash, err := buildTreeObject(repo, subnode)\n1067\t\t\tif err != nil {\n1068\t\t\t\treturn plumbing.ZeroHash, err\n1069\t\t\t}\n1070\t\t\ttreeEntries = append(treeEntries, object.TreeEntry{\n1071\t\t\t\tName: name,\n1072\t\t\t\tMode: filemode.Dir,\n1073\t\t\t\tHash: subHash,\n1074\t\t\t})\n1075\t\t}\n1076\t\n1077\t\t// Sort entries (git requires sorted entries)\n1078\t\tsortTreeEntries(treeEntries)\n1079\t\n1080\t\t// Create tree object\n1081\t\ttree := &object.Tree{Entries: treeEntries}\n1082\t\n1083\t\tobj := repo.Storer.NewEncodedObject()\n1084\t\tif err := tree.Encode(obj); err != nil {\n1085\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to encode tree: %w\", err)\n1086\t\t}\n1087\t\n1088\t\thash, err := repo.Storer.SetEncodedObject(obj)\n1089\t\tif err != nil {\n1090\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to store tree: %w\", err)\n1091\t\t}\n1092\t\n1093\t\treturn hash, nil\n1094\t}\n1095\t\n1096\t// sortTreeEntries sorts tree entries in git's required order.\n1097\t// Git sorts tree entries by name, with directories having a trailing /\n1098\tfunc sortTreeEntries(entries []object.TreeEntry) {\n1099\t\tsort.Slice(entries, func(i, j int) bool {\n1100\t\t\tnameI := entries[i].Name\n1101\t\t\tnameJ := entries[j].Name\n1102\t\t\tif entries[i].Mode == filemode.Dir {\n1103\t\t\t\tnameI += \"/\"\n1104\t\t\t}\n1105\t\t\tif entries[j].Mode == filemode.Dir {\n1106\t\t\t\tnameJ += \"/\"\n1107\t\t\t}\n1108\t\t\treturn nameI < nameJ\n1109\t\t})\n1110\t}\n1111\t\n1112\t// collectChangedFiles collects all changed files (modified tracked + untracked non-ignored)\n1113\t// using git CLI. This is much faster than filesystem walk and respects all gitignore sources\n1114\t// including global gitignore (core.excludesfile).\n1115\t//\n1116\t// Uses git CLI instead of go-git because go-git's worktree.Status() does not respect\n1117\t// global gitignore, which can cause globally ignored files to appear as untracked.\n1118\t// See: https://github.com/entireio/cli/pull/129\n1119\t//\n1120\t// changedFilesResult contains both changed and deleted files from git status.\n1121\ttype changedFilesResult struct {\n1122\t\tChanged []string // Files to include (modified, added, untracked, renamed, etc.)\n1123\t\tDeleted []string // Files that were deleted (need to be excluded from checkpoint tree)\n1124\t}\n1125\t\n1126\t// filterGitIgnoredFiles removes gitignored files from the list using `git check-ignore`.\n1127\t// This prevents secrets in gitignored files (e.g., .env) from leaking into shadow branch\n1128\t// commits when agents report them as modified/new in their transcripts.\n1129\t// On failure, fails closed (returns nil) to avoid leaking secrets.\n1130\tfunc filterGitIgnoredFiles(ctx context.Context, repo *git.Repository, files []string) []string {\n1131\t\tif len(files) == 0 {\n1132\t\t\treturn files\n1133\t\t}\n1134\t\n1135\t\twt, err := repo.Worktree()\n1136\t\tif err != nil {\n1137\t\t\tlogging.Warn(logging.WithComponent(ctx, \"checkpoint\"),\n1138\t\t\t\t\"failed to inspect worktree for gitignore filtering, excluding all files from checkpoint\",\n1139\t\t\t\tslog.String(\"error\", err.Error()))\n1140\t\t\treturn nil\n1141\t\t}\n1142\t\trepoRoot := wt.Filesystem.Root()\n1143\t\n1144\t\t// Use git check-ignore to identify which files are ignored.\n1145\t\t// Pass files via stdin (-z for NUL-separated, --stdin) to handle special characters.\n1146\t\t// Use --no-index so even tracked files that still match ignore rules are filtered.\n1147\t\tcmd := exec.CommandContext(ctx, \"git\", \"check-ignore\", \"--no-index\", \"-z\", \"--stdin\")\n1148\t\tcmd.Dir = repoRoot\n1149\t\tcmd.Stdin = strings.NewReader(strings.Join(files, \"\\x00\") + \"\\x00\")\n1150\t\n1151\t\toutput, err := cmd.Output()\n1152\t\tif err != nil {\n1153\t\t\texitErr := &exec.ExitError{}\n1154\t\t\tif errors.As(err, &exitErr) && exitErr.ExitCode() == 1 {\n1155\t\t\t\t// Exit code 1 means no files are ignored — all files are safe.\n1156\t\t\t\treturn files\n1157\t\t\t}\n1158\t\t\t// Any other failure (exit 128, git not found, etc.): fail closed.\n1159\t\t\t// A missing checkpoint is better than leaked secrets.\n1160\t\t\tlogging.Warn(logging.WithComponent(ctx, \"checkpoint\"),\n1161\t\t\t\t\"git check-ignore failed, excluding all files from checkpoint\",\n1162\t\t\t\tslog.String(\"error\", err.Error()))\n1163\t\t\treturn nil\n1164\t\t}\n1165\t\n1166\t\t// Parse NUL-separated output of ignored file names\n1167\t\tignored := make(map[string]struct{})\n1168\t\tfor _, name := range strings.Split(string(output), \"\\x00\") {\n1169\t\t\tif name != \"\" {\n1170\t\t\t\tignored[name] = struct{}{}\n1171\t\t\t}\n1172\t\t}\n1173\t\n1174\t\t// Filter: keep only files that are not ignored\n1175\t\tvar kept []string\n1176\t\tfilteredCount := 0\n1177\t\tfor _, file := range files {\n1178\t\t\tif _, isIgnored := ignored[file]; isIgnored {\n1179\t\t\t\tfilteredCount++\n1180\t\t\t\tcontinue\n1181\t\t\t}\n1182\t\t\tkept = append(kept, file)\n1183\t\t}\n1184\t\n1185\t\tif filteredCount > 0 {\n1186\t\t\tlogging.Debug(logging.WithComponent(ctx, \"checkpoint\"),\n1187\t\t\t\t\"filtered gitignored files from checkpoint\",\n1188\t\t\t\tslog.Int(\"count\", filteredCount))\n1189\t\t}\n1190\t\n1191\t\treturn kept\n1192\t}\n1193\t\n1194\t// collectChangedFiles returns all changed files from git status for the first checkpoint.\n1195\t//\n1196\t// For the first checkpoint, we need to capture:\n1197\t// - Modified tracked files (user's uncommitted changes)\n1198\t// - Untracked non-ignored files (new files not yet added to git)\n1199\t// - Renamed/copied files (both source removal and destination)\n1200\t// - Deleted files (to exclude from checkpoint tree)\n1201\t//\n1202\t// The base tree from HEAD already contains all unchanged tracked files.\n1203\t//\n1204\t// Uses `git status --porcelain -z` for reliable parsing of filenames with special characters.\n1205\tfunc collectChangedFiles(ctx context.Context, repo *git.Repository) (changedFilesResult, error) {\n1206\t\t// Get worktree root directory for running git command\n1207\t\twt, err := repo.Worktree()\n1208\t\tif err != nil {\n1209\t\t\treturn changedFilesResult{}, fmt.Errorf(\"failed to get worktree: %w\", err)\n1210\t\t}\n1211\t\trepoRoot := wt.Filesystem.Root()\n1212\t\n1213\t\t// Use -z for NUL-separated output (handles quoted filenames with spaces/special chars)\n1214\t\t// Use -uall to list individual untracked files instead of collapsed directories.\n1215\t\t// Note: CLAUDE.md warns against -uall for user-facing display, but we need the full list\n1216\t\t// for checkpointing.\n1217\t\tcmd := exec.CommandContext(ctx, \"git\", \"status\", \"--porcelain\", \"-z\", \"-uall\")\n1218\t\tcmd.Dir = repoRoot\n1219\t\toutput, err := cmd.Output()\n1220\t\tif err != nil {\n1221\t\t\treturn changedFilesResult{}, fmt.Errorf(\"failed to get git status in %s: %w\", repoRoot, err)\n1222\t\t}\n1223\t\n1224\t\tchangedSeen := make(map[string]struct{})\n1225\t\tdeletedSeen := make(map[string]struct{})\n1226\t\n1227\t\t// Parse NUL-separated output\n1228\t\t// Format: XY filename\\0 (for most entries)\n1229\t\t// For renames/copies: XY newname\\0oldname\\0\n1230\t\tentries := strings.Split(string(output), \"\\x00\")\n1231\t\n1232\t\tfor i := 0; i < len(entries); i++ {\n1233\t\t\tentry := entries[i]\n1234\t\t\tif len(entry) < 3 {\n1235\t\t\t\tcontinue\n1236\t\t\t}\n1237\t\n1238\t\t\t// git status --porcelain format: XY filename\n1239\t\t\t// X = staging status, Y = worktree status\n1240\t\t\tstaging := entry[0]\n1241\t\t\twtStatus := entry[1]\n1242\t\t\tfilename := entry[3:] // No TrimSpace needed with -z format\n1243\t\n1244\t\t\t// Handle R/C (rename/copy) first - they have a second entry we must skip\n1245\t\t\t// even if the new filename is an infrastructure path\n1246\t\t\tif staging == 'R' || staging == 'C' {\n1247\t\t\t\t// Renamed or copied: current entry is new name, next entry is old name\n1248\t\t\t\tif !paths.IsInfrastructurePath(filename) {\n1249\t\t\t\t\tchangedSeen[filename] = struct{}{}\n1250\t\t\t\t}\n1251\t\t\t\t// The old name follows as the next NUL-separated entry - must always skip it\n1252\t\t\t\tif i+1 < len(entries) && entries[i+1] != \"\" {\n1253\t\t\t\t\toldName := entries[i+1]\n1254\t\t\t\t\tif staging == 'R' && !paths.IsInfrastructurePath(oldName) {\n1255\t\t\t\t\t\t// For renames, old file is effectively deleted\n1256\t\t\t\t\t\tdeletedSeen[oldName] = struct{}{}\n1257\t\t\t\t\t}\n1258\t\t\t\t\ti++ // Skip the old name entry\n1259\t\t\t\t}\n1260\t\t\t\tcontinue\n1261\t\t\t}\n1262\t\n1263\t\t\t// Skip .entire directory for non-R/C entries\n1264\t\t\tif paths.IsInfrastructurePath(filename) {\n1265\t\t\t\tcontinue\n1266\t\t\t}\n1267\t\n1268\t\t\t// Handle different status codes\n1269\t\t\tswitch {\n1270\t\t\tcase staging == 'D' || wtStatus == 'D':\n1271\t\t\t\t// Deleted file - track separately\n1272\t\t\t\tdeletedSeen[filename] = struct{}{}\n1273\t\n1274\t\t\tcase wtStatus == 'M' || wtStatus == 'A':\n1275\t\t\t\t// Modified or added in worktree\n1276\t\t\t\tchangedSeen[filename] = struct{}{}\n1277\t\n1278\t\t\tcase staging == '?' && wtStatus == '?':\n1279\t\t\t\t// Untracked file\n1280\t\t\t\tchangedSeen[filename] = struct{}{}\n1281\t\n1282\t\t\tcase staging == 'A' || staging == 'M':\n1283\t\t\t\t// Staged add or modify\n1284\t\t\t\tchangedSeen[filename] = struct{}{}\n1285\t\n1286\t\t\tcase staging == 'T' || wtStatus == 'T':\n1287\t\t\t\t// Type change (e.g., file to symlink)\n1288\t\t\t\tchangedSeen[filename] = struct{}{}\n1289\t\n1290\t\t\tcase staging == 'U' || wtStatus == 'U':\n1291\t\t\t\t// Unmerged (conflict) - include current file state\n1292\t\t\t\tchangedSeen[filename] = struct{}{}\n1293\t\t\t}\n1294\t\t}\n1295\t\n1296\t\tchanged := make([]string, 0, len(changedSeen))\n1297\t\tfor file := range changedSeen {\n1298\t\t\tchanged = append(changed, file)\n1299\t\t}\n1300\t\n1301\t\tdeleted := make([]string, 0, len(deletedSeen))\n1302\t\tfor file := range deletedSeen {\n1303\t\t\tdeleted = append(deleted, file)\n1304\t\t}\n1305\t\n1306\t\treturn changedFilesResult{Changed: changed, Deleted: deleted}, nil\n1307\t}\n1308\t"}]},"uuid":"b1520734-8af6-4ee0-9972-61ec97f743f1","timestamp":"2026-04-24T12:28:55.383Z","toolUseResult":{"type":"text","file":{"filePath":"/home/coder/git/entireio/cli-sign/cmd/entire/cli/checkpoint/temporary.go","content":"package checkpoint\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/trailers\"\n\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n\t\"github.com/entireio/cli/redact\"\n\n\t\"github.com/go-git/go-git/v6\"\n\t\"github.com/go-git/go-git/v6/plumbing\"\n\t\"github.com/go-git/go-git/v6/plumbing/filemode\"\n\t\"github.com/go-git/go-git/v6/plumbing/object\"\n)\n\nconst (\n\t// ShadowBranchPrefix is the prefix for shadow branches.\n\tShadowBranchPrefix = \"entire/\"\n\n\t// ShadowBranchHashLength is the number of hex characters used in shadow branch names.\n\t// Shadow branches are named \"entire/<hash>\" using the first 7 characters of the commit hash.\n\tShadowBranchHashLength = 7\n\n\t// WorktreeIDHashLength is the number of hex characters used for worktree ID hash.\n\tWorktreeIDHashLength = 6\n)\n\n// HashWorktreeID returns a short hash of the worktree identifier.\n// Used to create unique shadow branch names per worktree.\nfunc HashWorktreeID(worktreeID string) string {\n\th := sha256.Sum256([]byte(worktreeID))\n\treturn hex.EncodeToString(h[:])[:WorktreeIDHashLength]\n}\n\n// WriteTemporary writes a temporary checkpoint to a shadow branch.\n// Shadow branches are named entire/<base-commit-short-hash>.\n// Returns the result containing commit hash and whether it was skipped.\n// If the new tree hash matches the last checkpoint's tree hash, the checkpoint\n// is skipped to avoid duplicate commits (deduplication).\nfunc (s *GitStore) WriteTemporary(ctx context.Context, opts WriteTemporaryOptions) (WriteTemporaryResult, error) {\n\t// Validate base commit - required for shadow branch naming\n\tif opts.BaseCommit == \"\" {\n\t\treturn WriteTemporaryResult{}, errors.New(\"BaseCommit is required for temporary checkpoint\")\n\t}\n\n\t// Validate session ID to prevent path traversal\n\tif err := validation.ValidateSessionID(opts.SessionID); err != nil {\n\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"invalid temporary checkpoint options: %w\", err)\n\t}\n\n\t// Get shadow branch name\n\tshadowBranchName := ShadowBranchNameForCommit(opts.BaseCommit, opts.WorktreeID)\n\n\t// Get or create shadow branch\n\tparentHash, baseTreeHash, err := s.getOrCreateShadowBranch(shadowBranchName)\n\tif err != nil {\n\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to get shadow branch: %w\", err)\n\t}\n\n\t// Get the last checkpoint's tree hash for deduplication\n\tvar lastTreeHash plumbing.Hash\n\tif parentHash != plumbing.ZeroHash {\n\t\tif lastCommit, err := s.repo.CommitObject(parentHash); err == nil {\n\t\t\tlastTreeHash = lastCommit.TreeHash\n\t\t}\n\t}\n\n\t// Collect all files to include\n\tvar allFiles []string\n\tvar allDeletedFiles []string\n\tif opts.IsFirstCheckpoint {\n\t\t// For the first checkpoint, capture all changed files (modified tracked + untracked)\n\t\t// using `git status --porcelain -z` which respects both repo and global .gitignore.\n\t\t// This is much faster than filesystem walk. The base tree from HEAD already contains\n\t\t// all unchanged tracked files. We also capture user's pre-existing deletions.\n\t\tresult, err := collectChangedFiles(ctx, s.repo)\n\t\tif err != nil {\n\t\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to collect changed files: %w\", err)\n\t\t}\n\t\tallFiles = result.Changed\n\t\t// Merge user's pre-existing deletions with agent's deletions\n\t\tallDeletedFiles = result.Deleted\n\t\tallDeletedFiles = append(allDeletedFiles, opts.DeletedFiles...)\n\t} else {\n\t\t// For subsequent checkpoints, only include modified/new files.\n\t\t// Filter out gitignored files — agent transcripts may report files like .env\n\t\t// that exist on disk but are gitignored. Without filtering, secrets in gitignored\n\t\t// files would leak into the shadow branch and could be pushed to remotes.\n\t\tcandidateFiles := make([]string, 0, len(opts.ModifiedFiles)+len(opts.NewFiles))\n\t\tcandidateFiles = append(candidateFiles, opts.ModifiedFiles...)\n\t\tcandidateFiles = append(candidateFiles, opts.NewFiles...)\n\t\tallFiles = filterGitIgnoredFiles(ctx, s.repo, candidateFiles)\n\t\tallDeletedFiles = opts.DeletedFiles\n\t}\n\n\t// Build tree with changes\n\ttreeHash, err := s.buildTreeWithChanges(ctx, baseTreeHash, allFiles, allDeletedFiles, opts.MetadataDir, opts.MetadataDirAbs)\n\tif err != nil {\n\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to build tree: %w\", err)\n\t}\n\n\t// Deduplication: skip if tree hash matches the last checkpoint\n\tif lastTreeHash != plumbing.ZeroHash && treeHash == lastTreeHash {\n\t\treturn WriteTemporaryResult{\n\t\t\tCommitHash: parentHash,\n\t\t\tSkipped:    true,\n\t\t}, nil\n\t}\n\n\t// Create checkpoint commit with trailers\n\tcommitMsg := trailers.FormatShadowCommit(opts.CommitMessage, opts.MetadataDir, opts.SessionID)\n\n\tcommitHash, err := s.createCommit(ctx, treeHash, parentHash, commitMsg, opts.AuthorName, opts.AuthorEmail)\n\tif err != nil {\n\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to create commit: %w\", err)\n\t}\n\n\t// Update branch reference\n\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n\tnewRef := plumbing.NewHashReference(refName, commitHash)\n\tif err := s.repo.Storer.SetReference(newRef); err != nil {\n\t\treturn WriteTemporaryResult{}, fmt.Errorf(\"failed to update branch reference: %w\", err)\n\t}\n\n\treturn WriteTemporaryResult{\n\t\tCommitHash: commitHash,\n\t\tSkipped:    false,\n\t}, nil\n}\n\n// ReadTemporary reads the latest checkpoint from a shadow branch.\n// Returns nil if the shadow branch doesn't exist.\n// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\nfunc (s *GitStore) ReadTemporary(ctx context.Context, baseCommit, worktreeID string) (*ReadTemporaryResult, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n\n\tref, err := s.repo.Reference(refName, true)\n\tif err != nil {\n\t\treturn nil, nil //nolint:nilnil,nilerr // Branch not found is an expected case\n\t}\n\n\tcommit, err := s.repo.CommitObject(ref.Hash())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get commit object: %w\", err)\n\t}\n\n\t// Extract session ID and metadata dir from commit trailers\n\tsessionID, _ := trailers.ParseSession(commit.Message)\n\tmetadataDir, _ := trailers.ParseMetadata(commit.Message)\n\n\treturn &ReadTemporaryResult{\n\t\tCommitHash:  ref.Hash(),\n\t\tTreeHash:    commit.TreeHash,\n\t\tSessionID:   sessionID,\n\t\tMetadataDir: metadataDir,\n\t\tTimestamp:   commit.Author.When,\n\t}, nil\n}\n\n// ListTemporary lists all shadow branches with their checkpoint info.\nfunc (s *GitStore) ListTemporary(ctx context.Context) ([]TemporaryInfo, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\titer, err := s.repo.Branches()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to list branches: %w\", err)\n\t}\n\n\tvar results []TemporaryInfo\n\terr = iter.ForEach(func(ref *plumbing.Reference) error {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn err //nolint:wrapcheck // Propagating context cancellation\n\t\t}\n\t\tbranchName := ref.Name().Short()\n\t\tif !strings.HasPrefix(branchName, ShadowBranchPrefix) {\n\t\t\treturn nil\n\t\t}\n\n\t\t// Skip the sessions branch\n\t\tif branchName == paths.MetadataBranchName {\n\t\t\treturn nil\n\t\t}\n\n\t\tcommit, commitErr := s.repo.CommitObject(ref.Hash())\n\t\tif commitErr != nil {\n\t\t\t//nolint:nilerr // Skip branches we can't read (non-fatal)\n\t\t\treturn nil\n\t\t}\n\n\t\tsessionID, _ := trailers.ParseSession(commit.Message)\n\n\t\t// Extract base commit from branch name (handles new \"entire/<commit>-<worktreeHash>\" format)\n\t\tbaseCommit, _, _ := ParseShadowBranchName(branchName)\n\n\t\tresults = append(results, TemporaryInfo{\n\t\t\tBranchName:   branchName,\n\t\t\tBaseCommit:   baseCommit,\n\t\t\tLatestCommit: ref.Hash(),\n\t\t\tSessionID:    sessionID,\n\t\t\tTimestamp:    commit.Author.When,\n\t\t})\n\n\t\treturn nil\n\t})\n\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to iterate branches: %w\", err)\n\t}\n\n\treturn results, nil\n}\n\n// WriteTemporaryTask writes a task checkpoint to a shadow branch.\n// Task checkpoints include both code changes and task-specific metadata.\n// Returns the commit hash of the created checkpoint.\nfunc (s *GitStore) WriteTemporaryTask(ctx context.Context, opts WriteTemporaryTaskOptions) (plumbing.Hash, error) {\n\t// Validate base commit - required for shadow branch naming\n\tif opts.BaseCommit == \"\" {\n\t\treturn plumbing.ZeroHash, errors.New(\"BaseCommit is required for task checkpoint\")\n\t}\n\n\t// Validate identifiers to prevent path traversal and malformed data\n\tif err := validation.ValidateSessionID(opts.SessionID); err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\n\t}\n\tif err := validation.ValidateToolUseID(opts.ToolUseID); err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\n\t}\n\tif err := validation.ValidateAgentID(opts.AgentID); err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"invalid task checkpoint options: %w\", err)\n\t}\n\n\t// Get shadow branch name\n\tshadowBranchName := ShadowBranchNameForCommit(opts.BaseCommit, opts.WorktreeID)\n\n\t// Get or create shadow branch\n\tparentHash, baseTreeHash, err := s.getOrCreateShadowBranch(shadowBranchName)\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get shadow branch: %w\", err)\n\t}\n\n\t// Collect all files to include in the commit.\n\t// Filter out gitignored files — subagent transcripts may report files like .env\n\t// that exist on disk but are gitignored. Without filtering, secrets would leak\n\t// into the shadow branch.\n\tcandidateFiles := make([]string, 0, len(opts.ModifiedFiles)+len(opts.NewFiles))\n\tcandidateFiles = append(candidateFiles, opts.ModifiedFiles...)\n\tcandidateFiles = append(candidateFiles, opts.NewFiles...)\n\tallFiles := filterGitIgnoredFiles(ctx, s.repo, candidateFiles)\n\n\t// Build new tree with code changes (no metadata dir yet)\n\tnewTreeHash, err := s.buildTreeWithChanges(ctx, baseTreeHash, allFiles, opts.DeletedFiles, \"\", \"\")\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to build tree: %w\", err)\n\t}\n\n\t// Add task metadata to tree\n\tnewTreeHash, err = s.addTaskMetadataToTree(ctx, newTreeHash, opts)\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to add task metadata: %w\", err)\n\t}\n\n\t// Create the commit\n\tcommitHash, err := s.createCommit(ctx, newTreeHash, parentHash, opts.CommitMessage, opts.AuthorName, opts.AuthorEmail)\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to create commit: %w\", err)\n\t}\n\n\t// Update shadow branch reference\n\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n\tref := plumbing.NewHashReference(refName, commitHash)\n\tif err := s.repo.Storer.SetReference(ref); err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to update shadow branch reference: %w\", err)\n\t}\n\n\treturn commitHash, nil\n}\n\n// addTaskMetadataToTree adds task checkpoint metadata to a git tree.\n// When IsIncremental is true, only adds the incremental checkpoint file.\n//\n// Uses ApplyTreeChanges (tree surgery) instead of FlattenTree+BuildTreeFromEntries,\n// so only affected subtrees are read/rebuilt.\nfunc (s *GitStore) addTaskMetadataToTree(ctx context.Context, baseTreeHash plumbing.Hash, opts WriteTemporaryTaskOptions) (plumbing.Hash, error) {\n\t// Compute metadata paths\n\tsessionMetadataDir := paths.EntireMetadataDir + \"/\" + opts.SessionID\n\ttaskMetadataDir := sessionMetadataDir + \"/tasks/\" + opts.ToolUseID\n\n\tvar changes []TreeChange\n\n\tif opts.IsIncremental {\n\t\t// Incremental checkpoint: only add the checkpoint file\n\t\tvar incData json.RawMessage\n\t\tif opts.IncrementalData != nil {\n\t\t\tredacted, redactErr := redact.JSONLBytes(opts.IncrementalData)\n\t\t\tif redactErr != nil {\n\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to redact incremental checkpoint: %w\", redactErr)\n\t\t\t}\n\t\t\tincData = json.RawMessage(redacted.Bytes())\n\t\t}\n\t\tincrementalCheckpoint := struct {\n\t\t\tType      string          `json:\"type\"`\n\t\t\tToolUseID string          `json:\"tool_use_id\"`\n\t\t\tTimestamp time.Time       `json:\"timestamp\"`\n\t\t\tData      json.RawMessage `json:\"data\"`\n\t\t}{\n\t\t\tType:      opts.IncrementalType,\n\t\t\tToolUseID: opts.ToolUseID,\n\t\t\tTimestamp: time.Now().UTC(),\n\t\t\tData:      incData,\n\t\t}\n\t\tcpData, err := jsonutil.MarshalIndentWithNewline(incrementalCheckpoint, \"\", \"  \")\n\t\tif err != nil {\n\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to marshal incremental checkpoint: %w\", err)\n\t\t}\n\n\t\tcpBlobHash, err := CreateBlobFromContent(s.repo, cpData)\n\t\tif err != nil {\n\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to create incremental checkpoint blob: %w\", err)\n\t\t}\n\t\tcpFilename := fmt.Sprintf(\"%03d-%s.json\", opts.IncrementalSequence, opts.ToolUseID)\n\t\tcpPath := taskMetadataDir + \"/checkpoints/\" + cpFilename\n\t\tchanges = append(changes, TreeChange{\n\t\t\tPath:  cpPath,\n\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: cpBlobHash},\n\t\t})\n\t} else {\n\t\t// Final checkpoint: add transcripts and checkpoint.json\n\n\t\t// Add session transcript (with chunking support for large transcripts)\n\t\tif opts.TranscriptPath != \"\" {\n\t\t\tif transcriptContent, readErr := os.ReadFile(opts.TranscriptPath); readErr == nil {\n\t\t\t\tagentType := agent.DetectAgentTypeFromContent(transcriptContent)\n\n\t\t\t\t// Chunk if necessary\n\t\t\t\tchunks, chunkErr := agent.ChunkTranscript(ctx, transcriptContent, agentType)\n\t\t\t\tif chunkErr != nil {\n\t\t\t\t\tlogging.Warn(ctx, \"failed to chunk transcript, checkpoint will be saved without transcript\",\n\t\t\t\t\t\tslog.String(\"error\", chunkErr.Error()),\n\t\t\t\t\t\tslog.String(\"session_id\", opts.SessionID),\n\t\t\t\t\t)\n\t\t\t\t} else {\n\t\t\t\t\tfor i, chunk := range chunks {\n\t\t\t\t\t\tchunkPath := sessionMetadataDir + \"/\" + agent.ChunkFileName(paths.TranscriptFileName, i)\n\t\t\t\t\t\tblobHash, blobErr := CreateBlobFromContent(s.repo, chunk)\n\t\t\t\t\t\tif blobErr != nil {\n\t\t\t\t\t\t\tlogging.Warn(ctx, \"failed to create blob for transcript chunk\",\n\t\t\t\t\t\t\t\tslog.String(\"error\", blobErr.Error()),\n\t\t\t\t\t\t\t\tslog.String(\"session_id\", opts.SessionID),\n\t\t\t\t\t\t\t\tslog.Int(\"chunk_index\", i),\n\t\t\t\t\t\t\t)\n\t\t\t\t\t\t\tcontinue\n\t\t\t\t\t\t}\n\t\t\t\t\t\tchanges = append(changes, TreeChange{\n\t\t\t\t\t\t\tPath:  chunkPath,\n\t\t\t\t\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: blobHash},\n\t\t\t\t\t\t})\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\t// Add subagent transcript if available\n\t\tif opts.SubagentTranscriptPath != \"\" && opts.AgentID != \"\" {\n\t\t\tif agentContent, readErr := os.ReadFile(opts.SubagentTranscriptPath); readErr == nil {\n\t\t\t\tredacted, jsonlErr := redact.JSONLBytes(agentContent)\n\t\t\t\tif jsonlErr != nil {\n\t\t\t\t\tlogging.Warn(ctx, \"subagent transcript is not valid JSONL, falling back to plain redaction\",\n\t\t\t\t\t\tslog.String(\"path\", opts.SubagentTranscriptPath),\n\t\t\t\t\t\tslog.String(\"error\", jsonlErr.Error()),\n\t\t\t\t\t)\n\t\t\t\t\tagentContent = redact.Bytes(agentContent)\n\t\t\t\t} else {\n\t\t\t\t\tagentContent = redacted.Bytes()\n\t\t\t\t}\n\t\t\t\tif blobHash, blobErr := CreateBlobFromContent(s.repo, agentContent); blobErr == nil {\n\t\t\t\t\tagentPath := taskMetadataDir + \"/agent-\" + opts.AgentID + \".jsonl\"\n\t\t\t\t\tchanges = append(changes, TreeChange{\n\t\t\t\t\t\tPath:  agentPath,\n\t\t\t\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: blobHash},\n\t\t\t\t\t})\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\t// Add checkpoint.json\n\t\tcheckpointJSON := fmt.Sprintf(`{\n  \"session_id\": %q,\n  \"tool_use_id\": %q,\n  \"checkpoint_uuid\": %q,\n  \"agent_id\": %q\n}`, opts.SessionID, opts.ToolUseID, opts.CheckpointUUID, opts.AgentID)\n\n\t\tblobHash, err := CreateBlobFromContent(s.repo, []byte(checkpointJSON))\n\t\tif err != nil {\n\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to create checkpoint blob: %w\", err)\n\t\t}\n\t\tcheckpointPath := taskMetadataDir + \"/checkpoint.json\"\n\t\tchanges = append(changes, TreeChange{\n\t\t\tPath:  checkpointPath,\n\t\t\tEntry: &object.TreeEntry{Mode: filemode.Regular, Hash: blobHash},\n\t\t})\n\t}\n\n\treturn ApplyTreeChanges(ctx, s.repo, baseTreeHash, changes)\n}\n\n// ListTemporaryCheckpoints lists all checkpoint commits on a shadow branch.\n// This returns individual commits (rewind points), not just branch info.\n// The sessionID filter, if provided, limits results to commits from that session.\n// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\nfunc (s *GitStore) ListTemporaryCheckpoints(ctx context.Context, baseCommit, worktreeID, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n\treturn s.listCheckpointsForBranch(ctx, shadowBranchName, sessionID, limit)\n}\n\n// ListCheckpointsForBranch lists checkpoint commits for a shadow branch by name.\n// Use this when you already have the full branch name (e.g., from ListTemporary).\n// The sessionID filter, if provided, limits results to commits from that session.\nfunc (s *GitStore) ListCheckpointsForBranch(ctx context.Context, branchName, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n\treturn s.listCheckpointsForBranch(ctx, branchName, sessionID, limit)\n}\n\n// listCheckpointsForBranch lists checkpoint commits for a specific shadow branch name.\n// This is an internal helper used by ListTemporaryCheckpoints, ListCheckpointsForBranch, and ListAllTemporaryCheckpoints.\nfunc (s *GitStore) listCheckpointsForBranch(ctx context.Context, shadowBranchName, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n\n\tref, err := s.repo.Reference(refName, true)\n\tif err != nil {\n\t\treturn nil, nil //nolint:nilerr // No shadow branch is expected case\n\t}\n\n\titer, err := s.repo.Log(&git.LogOptions{From: ref.Hash()})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get commit log: %w\", err)\n\t}\n\n\tvar results []TemporaryCheckpointInfo\n\tcount := 0\n\n\terr = iter.ForEach(func(c *object.Commit) error {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn err //nolint:wrapcheck // Propagating context cancellation\n\t\t}\n\t\tif count >= limit*5 { // Scan more to allow for session filtering\n\t\t\treturn errStop\n\t\t}\n\t\tcount++\n\n\t\t// Verify commit belongs to target session via Entire-Session trailer\n\t\tcommitSessionID, hasTrailer := trailers.ParseSession(c.Message)\n\t\tif !hasTrailer {\n\t\t\treturn nil // Skip commits without session trailer\n\t\t}\n\t\tif sessionID != \"\" && commitSessionID != sessionID {\n\t\t\treturn nil // Skip commits from other sessions\n\t\t}\n\n\t\t// Get first line of message\n\t\tmessage := c.Message\n\t\tif idx := strings.Index(message, \"\\n\"); idx > 0 {\n\t\t\tmessage = message[:idx]\n\t\t}\n\n\t\tinfo := TemporaryCheckpointInfo{\n\t\t\tCommitHash: c.Hash,\n\t\t\tMessage:    message,\n\t\t\tSessionID:  commitSessionID,\n\t\t\tTimestamp:  c.Author.When,\n\t\t}\n\n\t\t// Check for task checkpoint first\n\t\ttaskMetadataDir, foundTask := trailers.ParseTaskMetadata(c.Message)\n\t\tif foundTask {\n\t\t\tinfo.IsTaskCheckpoint = true\n\t\t\tinfo.MetadataDir = taskMetadataDir\n\t\t\tinfo.ToolUseID = extractToolUseIDFromPath(taskMetadataDir)\n\t\t} else {\n\t\t\tmetadataDir, found := trailers.ParseMetadata(c.Message)\n\t\t\tif found {\n\t\t\t\tinfo.MetadataDir = metadataDir\n\t\t\t}\n\t\t}\n\n\t\tresults = append(results, info)\n\n\t\tif len(results) >= limit {\n\t\t\treturn errStop\n\t\t}\n\t\treturn nil\n\t})\n\n\tif err != nil && !errors.Is(err, errStop) {\n\t\treturn nil, fmt.Errorf(\"error iterating commits: %w\", err)\n\t}\n\n\treturn results, nil\n}\n\n// ListAllTemporaryCheckpoints lists checkpoint commits from ALL shadow branches.\n// This is used for checkpoint lookup when the base commit is unknown (e.g., HEAD advanced since session start).\n// The sessionID filter, if provided, limits results to commits from that session.\nfunc (s *GitStore) ListAllTemporaryCheckpoints(ctx context.Context, sessionID string, limit int) ([]TemporaryCheckpointInfo, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn nil, err //nolint:wrapcheck // Propagating context cancellation\n\t}\n\n\t// List all shadow branches\n\tbranches, err := s.ListTemporary(ctx)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to list shadow branches: %w\", err)\n\t}\n\n\tvar results []TemporaryCheckpointInfo\n\n\t// Iterate through each shadow branch and collect checkpoints\n\tfor _, branch := range branches {\n\t\t// Use the branch name directly to get checkpoints\n\t\tbranchCheckpoints, branchErr := s.listCheckpointsForBranch(ctx, branch.BranchName, sessionID, limit)\n\t\tif branchErr != nil {\n\t\t\tif errors.Is(branchErr, context.Canceled) || errors.Is(branchErr, context.DeadlineExceeded) {\n\t\t\t\treturn nil, branchErr\n\t\t\t}\n\t\t\tcontinue // Skip branches we can't read\n\t\t}\n\t\tresults = append(results, branchCheckpoints...)\n\t\tif len(results) >= limit {\n\t\t\tresults = results[:limit]\n\t\t\tbreak\n\t\t}\n\t}\n\n\treturn results, nil\n}\n\n// extractToolUseIDFromPath extracts the ToolUseID from a task metadata directory path.\n// Task metadata dirs have format: .entire/metadata/<session>/tasks/<toolUseID>\nfunc extractToolUseIDFromPath(metadataDir string) string {\n\tparts := strings.Split(metadataDir, \"/\")\n\tif len(parts) >= 2 && parts[len(parts)-2] == \"tasks\" {\n\t\treturn parts[len(parts)-1]\n\t}\n\treturn \"\"\n}\n\n// errStop is a sentinel error used to break out of git log iteration.\nvar errStop = errors.New(\"stop iteration\")\n\n// GetTranscriptFromCommit retrieves the transcript from a specific commit's tree.\n// This is used for shadow branch checkpoints where the transcript is stored in the commit tree\n// rather than on the entire/checkpoints/v1 branch.\n// commitHash is the commit to read from, metadataDir is the path within the tree.\n// agentType is used for reassembling chunked transcripts in the correct format.\n// Handles both chunked and non-chunked transcripts.\nfunc (s *GitStore) GetTranscriptFromCommit(ctx context.Context, commitHash plumbing.Hash, metadataDir string, agentType types.AgentType) ([]byte, error) {\n\tcommit, err := s.repo.CommitObject(commitHash)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get commit: %w\", err)\n\t}\n\n\ttree, err := commit.Tree()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get commit tree: %w\", err)\n\t}\n\n\t// Try to get the metadata subtree for chunk detection\n\tsubTree, subTreeErr := tree.Tree(metadataDir)\n\tif subTreeErr == nil {\n\t\t// Use the helper function that handles chunking.\n\t\t// Wrap in FetchingTree with nil fetcher (temporary reads are always local).\n\t\tft := &FetchingTree{inner: subTree}\n\t\ttranscript, err := readTranscriptFromTree(ctx, ft, agentType)\n\t\tif err == nil && transcript != nil {\n\t\t\treturn transcript, nil\n\t\t}\n\t}\n\n\t// Fall back to direct file access (for backwards compatibility)\n\ttranscriptPath := metadataDir + \"/\" + paths.TranscriptFileName\n\tif file, fileErr := tree.File(transcriptPath); fileErr == nil {\n\t\tcontent, contentErr := file.Contents()\n\t\tif contentErr == nil {\n\t\t\treturn []byte(content), nil\n\t\t}\n\t}\n\n\ttranscriptPath = metadataDir + \"/\" + paths.TranscriptFileNameLegacy\n\tif file, fileErr := tree.File(transcriptPath); fileErr == nil {\n\t\tcontent, contentErr := file.Contents()\n\t\tif contentErr == nil {\n\t\t\treturn []byte(content), nil\n\t\t}\n\t}\n\n\treturn nil, ErrNoTranscript\n}\n\n// ShadowBranchExists checks if a shadow branch exists for the given base commit and worktree.\n// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\nfunc (s *GitStore) ShadowBranchExists(baseCommit, worktreeID string) bool {\n\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n\trefName := plumbing.NewBranchReferenceName(shadowBranchName)\n\t_, err := s.repo.Reference(refName, true)\n\treturn err == nil\n}\n\n// DeleteShadowBranch deletes the shadow branch for the given base commit and worktree.\n// worktreeID should be empty for main worktree or the internal git worktree name for linked worktrees.\n// Uses git CLI instead of go-git's RemoveReference because go-git v5 doesn't properly\n// persist deletions with packed refs or worktrees.\nfunc (s *GitStore) DeleteShadowBranch(ctx context.Context, baseCommit, worktreeID string) error {\n\tshadowBranchName := ShadowBranchNameForCommit(baseCommit, worktreeID)\n\tcmd := exec.CommandContext(ctx, \"git\", \"branch\", \"-D\", \"--\", shadowBranchName)\n\tif output, err := cmd.CombinedOutput(); err != nil {\n\t\treturn fmt.Errorf(\"failed to delete shadow branch %s: %s: %w\", shadowBranchName, strings.TrimSpace(string(output)), err)\n\t}\n\treturn nil\n}\n\n// ShadowBranchNameForCommit returns the shadow branch name for a base commit hash\n// and worktree identifier. The worktree ID should be empty for the main worktree\n// or the internal git worktree name for linked worktrees.\n// Format: entire/<commit[:7]>-<hash(worktreeID)[:6]>\nfunc ShadowBranchNameForCommit(baseCommit, worktreeID string) string {\n\tcommitPart := baseCommit\n\tif len(baseCommit) >= ShadowBranchHashLength {\n\t\tcommitPart = baseCommit[:ShadowBranchHashLength]\n\t}\n\tworktreeHash := HashWorktreeID(worktreeID)\n\treturn ShadowBranchPrefix + commitPart + \"-\" + worktreeHash\n}\n\n// ParseShadowBranchName extracts the commit prefix and worktree hash from a shadow branch name.\n// Input format: \"entire/<commit[:7]>-<worktreeHash[:6]>\"\n// Returns (commitPrefix, worktreeHash, ok). Returns (\"\", \"\", false) if not a valid shadow branch.\nfunc ParseShadowBranchName(branchName string) (commitPrefix, worktreeHash string, ok bool) {\n\tif !strings.HasPrefix(branchName, ShadowBranchPrefix) {\n\t\treturn \"\", \"\", false\n\t}\n\tsuffix := strings.TrimPrefix(branchName, ShadowBranchPrefix)\n\n\t// Find the last dash - everything before is commit prefix, after is worktree hash\n\tlastDash := strings.LastIndex(suffix, \"-\")\n\tif lastDash == -1 || lastDash == 0 || lastDash == len(suffix)-1 {\n\t\t// No dash, or dash at start/end - invalid format\n\t\t// Could be old format \"entire/<commit[:7]>\" without worktree hash\n\t\treturn suffix, \"\", true // Return as commit prefix with empty worktree hash\n\t}\n\n\treturn suffix[:lastDash], suffix[lastDash+1:], true\n}\n\n// getOrCreateShadowBranch gets or creates the shadow branch for checkpoints.\n// Returns (parentHash, baseTreeHash, error).\nfunc (s *GitStore) getOrCreateShadowBranch(branchName string) (plumbing.Hash, plumbing.Hash, error) {\n\trefName := plumbing.NewBranchReferenceName(branchName)\n\tref, err := s.repo.Reference(refName, true)\n\n\tif err == nil {\n\t\t// Branch exists\n\t\tcommit, err := s.repo.CommitObject(ref.Hash())\n\t\tif err != nil {\n\t\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get commit object: %w\", err)\n\t\t}\n\t\treturn ref.Hash(), commit.TreeHash, nil\n\t}\n\n\t// Branch doesn't exist, use current HEAD's tree as base\n\thead, err := s.repo.Head()\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get HEAD: %w\", err)\n\t}\n\n\theadCommit, err := s.repo.CommitObject(head.Hash())\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, plumbing.ZeroHash, fmt.Errorf(\"failed to get HEAD commit: %w\", err)\n\t}\n\n\treturn plumbing.ZeroHash, headCommit.TreeHash, nil\n}\n\n// buildTreeWithChanges builds a git tree with the given changes.\n// metadataDir is the relative path for git tree entries, metadataDirAbs is the absolute path\n// for filesystem operations (needed when CLI is run from a subdirectory).\n//\n// Uses ApplyTreeChanges (tree surgery) instead of FlattenTree+BuildTreeFromEntries,\n// so only affected subtrees are read/rebuilt — O(changed dirs) instead of O(total files).\nfunc (s *GitStore) buildTreeWithChanges(\n\tctx context.Context,\n\tbaseTreeHash plumbing.Hash,\n\tmodifiedFiles, deletedFiles []string,\n\tmetadataDir, metadataDirAbs string,\n) (plumbing.Hash, error) {\n\t// Get worktree root for resolving file paths\n\t// This is critical because fileExists() and createBlobFromFile() use os.Stat()\n\t// which resolves relative to CWD. The modifiedFiles are repo-relative paths,\n\t// so we must resolve them against repo root, not CWD.\n\trepoRoot, err := paths.WorktreeRoot(ctx)\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get worktree root: %w\", err)\n\t}\n\n\t// Build list of tree changes\n\tchanges := make([]TreeChange, 0, len(modifiedFiles)+len(deletedFiles))\n\n\t// Deleted files → nil Entry means deletion\n\tfor _, file := range deletedFiles {\n\t\trelPath, relErr := normalizeRepoRelativeTreePath(repoRoot, file)\n\t\tif relErr != nil {\n\t\t\tlogInvalidGitTreePath(ctx, \"delete shadow branch entry\", file, relErr)\n\t\t\tcontinue\n\t\t}\n\t\tchanges = append(changes, TreeChange{Path: relPath, Entry: nil})\n\t}\n\n\t// Modified/new files → create blobs from disk\n\tfor _, file := range modifiedFiles {\n\t\trelPath, relErr := normalizeRepoRelativeTreePath(repoRoot, file)\n\t\tif relErr != nil {\n\t\t\tlogInvalidGitTreePath(ctx, \"add shadow branch entry\", file, relErr)\n\t\t\tcontinue\n\t\t}\n\n\t\tabsPath := filepath.Join(repoRoot, filepath.FromSlash(relPath))\n\t\tif !fileExists(absPath) {\n\t\t\t// File disappeared since detection — treat as deletion\n\t\t\tchanges = append(changes, TreeChange{Path: relPath, Entry: nil})\n\t\t\tcontinue\n\t\t}\n\n\t\tblobHash, mode, blobErr := createBlobFromFile(s.repo, absPath)\n\t\tif blobErr != nil {\n\t\t\t// Skip files that can't be staged (may have been deleted since detection)\n\t\t\tcontinue\n\t\t}\n\n\t\tchanges = append(changes, TreeChange{\n\t\t\tPath: relPath,\n\t\t\tEntry: &object.TreeEntry{\n\t\t\t\tMode: mode,\n\t\t\t\tHash: blobHash,\n\t\t\t},\n\t\t})\n\t}\n\n\t// Metadata directory files\n\tif metadataDir != \"\" && metadataDirAbs != \"\" {\n\t\tmetadataRel, relErr := normalizeRepoRelativeTreePath(repoRoot, metadataDir)\n\t\tif relErr != nil {\n\t\t\tlogInvalidGitTreePath(ctx, \"add metadata directory\", metadataDir, relErr)\n\t\t} else {\n\t\t\tmetaChanges, metaErr := addDirectoryToChanges(s.repo, metadataDirAbs, metadataRel)\n\t\t\tif metaErr != nil {\n\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to add metadata directory: %w\", metaErr)\n\t\t\t}\n\t\t\tchanges = append(changes, metaChanges...)\n\t\t}\n\t}\n\n\treturn ApplyTreeChanges(ctx, s.repo, baseTreeHash, changes)\n}\n\n// createCommit creates a commit object.\nfunc (s *GitStore) createCommit(ctx context.Context, treeHash, parentHash plumbing.Hash, message, authorName, authorEmail string) (plumbing.Hash, error) {\n\treturn CreateCommit(ctx, s.repo, treeHash, parentHash, message, authorName, authorEmail)\n}\n\n// Helper functions extracted from strategy/common.go\n// These are exported for use by strategy package (push_common.go, session_test.go)\n\n// FlattenTree recursively flattens a tree into a map of full paths to entries.\nfunc FlattenTree(repo *git.Repository, tree *object.Tree, prefix string, entries map[string]object.TreeEntry) error {\n\tfor _, entry := range tree.Entries {\n\t\tfullPath := entry.Name\n\t\tif prefix != \"\" {\n\t\t\tfullPath = prefix + \"/\" + entry.Name\n\t\t}\n\n\t\tif entry.Mode == filemode.Dir {\n\t\t\t// Recurse into subtree\n\t\t\tsubtree, err := repo.TreeObject(entry.Hash)\n\t\t\tif err != nil {\n\t\t\t\treturn fmt.Errorf(\"failed to get subtree %s: %w\", fullPath, err)\n\t\t\t}\n\t\t\tif err := FlattenTree(repo, subtree, fullPath, entries); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t} else {\n\t\t\tentries[fullPath] = object.TreeEntry{\n\t\t\t\tName: fullPath,\n\t\t\t\tMode: entry.Mode,\n\t\t\t\tHash: entry.Hash,\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\n// fileExists checks if a file exists at the given path.\nfunc fileExists(path string) bool {\n\t_, err := os.Stat(path)\n\treturn err == nil\n}\n\n// createBlobFromFile creates a blob object from a file in the working directory.\nfunc createBlobFromFile(repo *git.Repository, filePath string) (plumbing.Hash, filemode.FileMode, error) {\n\tinfo, err := os.Stat(filePath)\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to stat file: %w\", err)\n\t}\n\n\t// Determine file mode\n\tmode := filemode.Regular\n\tif info.Mode()&0o111 != 0 {\n\t\tmode = filemode.Executable\n\t}\n\tif info.Mode()&os.ModeSymlink != 0 {\n\t\tmode = filemode.Symlink\n\t}\n\n\t// Read file contents\n\tcontent, err := os.ReadFile(filePath) //nolint:gosec // filePath comes from walking the repository\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to read file: %w\", err)\n\t}\n\n\t// Create blob object\n\tobj := repo.Storer.NewEncodedObject()\n\tobj.SetType(plumbing.BlobObject)\n\tobj.SetSize(int64(len(content)))\n\n\twriter, err := obj.Writer()\n\tif err != nil {\n\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to get object writer: %w\", err)\n\t}\n\n\t_, err = writer.Write(content)\n\tif err != nil {\n\t\t_ = writer.Close()\n\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"failed to write blob content: %w\", err)\n\t}\n\tif err := writer.Close(); err != nil {\n\t\treturn plumbing.ZeroHash, 0, fmt.Errorf(\"f