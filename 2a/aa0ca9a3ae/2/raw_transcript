== remoteRef.Hash() {\n349\t\t\treturn nil\n350\t\t}\n351\t\n352\t\t// Find merge base\n353\t\trepoPath, err := getRepoPath(repo)\n354\t\tif err != nil {\n355\t\t\treturn fmt.Errorf(\"failed to get repo path: %w\", err)\n356\t\t}\n357\t\tmergeBase, err := getMergeBase(ctx, repoPath, localRef.Hash().String(), remoteRef.Hash().String())\n358\t\tif err != nil {\n359\t\t\treturn fmt.Errorf(\"failed to find merge base: %w\", err)\n360\t\t}\n361\t\n362\t\t// If local is ancestor of remote (merge base == local), fast-forward to remote\n363\t\tif mergeBase == localRef.Hash() {\n364\t\t\tref := plumbing.NewHashReference(plumbing.NewBranchReferenceName(branchName), remoteRef.Hash())\n365\t\t\tif err := repo.Storer.SetReference(ref); err != nil {\n366\t\t\t\treturn fmt.Errorf(\"failed to fast-forward branch ref: %w\", err)\n367\t\t\t}\n368\t\t\tif usedTempRef {\n369\t\t\t\t_ = repo.Storer.RemoveReference(fetchedRefName) //nolint:errcheck // cleanup is best-effort\n370\t\t\t}\n371\t\t\treturn nil\n372\t\t}\n373\t\n374\t\t// Collect commits reachable from local but not from remote and cherry-pick\n375\t\t// them onto the remote tip. This preserves local-only commits even when the\n376\t\t// local metadata branch already contains old merge commits, while avoiding\n377\t\t// replaying shared ancestors older than the true merge-base.\n378\t\tlocalCommits, err := collectCommitsSince(ctx, repo, repoPath, localRef.Hash(), remoteRef.Hash())\n379\t\tif err != nil {\n380\t\t\treturn fmt.Errorf(\"failed to collect local commits: %w\", err)\n381\t\t}\n382\t\n383\t\tif len(localCommits) == 0 {\n384\t\t\t// No local-only commits — just point to remote\n385\t\t\tref := plumbing.NewHashReference(plumbing.NewBranchReferenceName(branchName), remoteRef.Hash())\n386\t\t\tif err := repo.Storer.SetReference(ref); err != nil {\n387\t\t\t\treturn fmt.Errorf(\"failed to update branch ref: %w\", err)\n388\t\t\t}\n389\t\t\tif usedTempRef {\n390\t\t\t\t_ = repo.Storer.RemoveReference(fetchedRefName) //nol