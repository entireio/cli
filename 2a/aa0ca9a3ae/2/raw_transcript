from git push.\n93\ttype PushResult struct {\n94\t\tOutput string\n95\t}\n96\t\n97\t// Push runs git push --no-verify --porcelain with token injection.\n98\t// GIT_TERMINAL_PROMPT=0 is always set.\n99\tfunc Push(ctx context.Context, remote, refSpec string) (PushResult, error) {\n100\t\tpushTarget, err := resolvePushCommandTarget(ctx, remote)\n101\t\tif err != nil {\n102\t\t\treturn PushResult{}, fmt.Errorf(\"resolve push target: %w\", err)\n103\t\t}\n104\t\n105\t\tcmd := newCommand(ctx, \"push\", \"--no-verify\", \"--porcelain\", pushTarget, refSpec)\n106\t\tdisableTerminalPrompt(cmd)\n107\t\toutput, err := cmd.CombinedOutput()\n108\t\tif err != nil {\n109\t\t\treturn PushResult{Output: string(output)}, fmt.Errorf(\"git push: %w\", err)\n110\t\t}\n111\t\treturn PushResult{Output: string(output)}, nil\n112\t}\n113\t\n114\t// LsRemote runs git ls-remote with token injection.\n115\t// GIT_TERMINAL_PROMPT=0 is always set. Returns stdout only.\n116\tfunc LsRemote(ctx context.Context, remote string, patterns ...string) ([]byte, error) {\n117\t\treturn lsRemote(ctx, \"\", remote, patterns...)\n118\t}\n119\t\n120\t// LsRemoteInDir is like LsRemote but runs in a specific directory.\n121\tfunc LsRemoteInDir(ctx context.Context, dir, remote string, patterns ...string) ([]byte, error) {\n122\t\treturn lsRemote(ctx, dir, remote, patterns...)\n123\t}\n124\t\n125\tfunc lsRemote(ctx context.Context, dir, remote string, patterns ...string) ([]byte, error) {\n126\t\targs := append([]string{\"ls-remote\", remote}, patterns...)\n127\t\tcmd := newCommand(ctx, args...)\n128\t\tif dir != \"\" {\n129\t\t\tcmd.Dir = dir\n130\t\t}\n131\t\tdisableTerminalPrompt(cmd)\n132\t\tout, err := cmd.Output()\n133\t\tif err != nil {\n134\t\t\treturn out, fmt.Errorf(\"git ls-remote: %w\", err)\n135\t\t}\n136\t\treturn out, nil\n137\t}\n138\t\n139\t// IsURL returns true if the target looks like a URL rather than a git remote name.\n140\tfunc IsURL(target string) bool {\n141\t\treturn strings.Contains(targ