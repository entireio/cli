\t// settings, so the checkpoint_remote must be present in HEAD:.entire/settings.json\n132\t// (not just in settings.local.json or uncommitted local changes).\n133\t// Uses sync.Once to avoid duplicates when multiple branches/refs are pushed in a\n134\t// single pre-push invocation.\n135\tfunc printSettingsCommitHint(ctx context.Context, target string) {\n136\t\tif !remote.IsURL(target) {\n137\t\t\treturn\n138\t\t}\n139\t\tsettingsHintOnce.Do(func() {\n140\t\t\tif isCheckpointRemoteCommitted(ctx) {\n141\t\t\t\treturn\n142\t\t\t}\n143\t\t\tfmt.Fprintln(os.Stderr, \"[entire] Note: Checkpoints were pushed to a separate checkpoint remote, but .entire/settings.json does not contain checkpoint_remote in the latest commit. entire.io will not be able to discover these checkpoints until checkpoint_remote is committed and pushed in .entire/settings.json.\")\n144\t\t})\n145\t}\n146\t\n147\t// printCheckpointsV2MigrationHint prints a hint when the committed project\n148\t// settings enable checkpoints_version: 2 AND there are v1 checkpoints that have\n149\t// not yet been mirrored into v2. Suppressed when v2 already has every v1\n150\t// checkpoint (nothing to migrate) so the hint does not become noise once the\n151\t// migration is done.\n152\tfunc printCheckpointsV2MigrationHint(ctx context.Context) {\n153\t\tcheckpointsV2MigrationHintOnce.Do(func() {\n154\t\t\tif !isCheckpointsVersion2Committed(ctx) {\n155\t\t\t\treturn\n156\t\t\t}\n157\t\t\tif !hasUnmigratedV1Checkpoints(ctx) {\n158\t\t\t\treturn\n159\t\t\t}\n160\t\t\tfmt.Fprintln(os.Stderr, \"[entire] Note: .entire/settings.json sets checkpoints_version: 2. Run 'entire migrate --checkpoints v2' to migrate existing checkpoints to v2.\")\n161\t\t\tfmt.Fprintln(os.Stderr, \"[entire] Use 'entire migrate --checkpoints v2 --force' to rewrite all checkpoints in v2.\")\n162\t\t})\n163\t}\n164\t\n165\t// hasUnmigratedV1Checkpoints reports whether any v1 checkpoint has no matching\n166\t// entry in v2. Any failure opening the repo or listing either store is treated\n167\t// as \"no migration needed\" so we stay silent instead of printing a speculative\n168\t// hint — the hint is advisory and should never be the reason a push gets noisy.\n169\tfunc hasUnmigratedV1Checkpoints(ctx context.Context) bool {\n170\t\trepo, err := OpenRepository(ctx)\n171\t\tif err != nil {\n172\t\t\treturn false\n173\t\t}\n174\t\tv1List, err := checkpoint.NewGitStore(repo).ListCommitted(ctx)\n175\t\tif err != nil || len(v1List) == 0 {\n176\t\t\treturn false\n177\t\t}\n178\t\tv2List, err := checkpoint.NewV2GitStore(repo, \"\").ListCommitted(ctx)\n179\t\tif err != nil {\n180\t\t\treturn false\n181\t\t}\n182\t\tv2Set := make(map[string]struct{}, len(v2List))\n183\t\tfor _, info := range v2List {\n184\t\t\tv2Set[info.CheckpointID.String()] = struct{}{}\n185\t\t}\n186\t\tfor _, info := range v1List {\n187\t\t\tif _, ok := v2Set[info.CheckpointID.String()]; !ok {\n188\t\t\t\treturn true\n189\t\t\t}\n190\t\t}\n191\t\treturn false\n192\t}\n193\t\n194\t// isCheckpointRemoteCommitted returns true if the committed .entire/settings.json\n195\t// at HEAD contains a valid checkpoint_remote configuration. This is the true\n196\t// discoverability check: entire.io reads from committed project settings, not from\n197\t// local overrides or uncommitted changes.\n198\tfunc isCheckpointRemoteCommitted(ctx context.Context) bool {\n199\t\tcmd := exec.CommandContext(ctx, \"git\", \"show\", \"HEAD:.entire/settings.json\")\n200\t\toutput, err := cmd.Output()\n201\t\tif err != nil {\n202\t\t\treturn false // file doesn't exist at HEAD\n203\t\t}\n204\t\t// Parse the committed content and check for checkpoint_remote\n205\t\tcommitted, err := settings.LoadFromBytes(output)\n206\t\tif err != nil {\n207\t\t\treturn false\n208\t\t}\n209\t\treturn committed.GetCheckpointRemote() != nil\n210\t}\n211\t\n212\t// isCheckpointsVersion2Committed returns true if the committed .entire/settings.json\n213\t// at HEAD sets checkpoints_version to 2.\n214\tfunc isCheckpointsVersion2Committed(ctx context.Context) bool {\n215\t\tcmd := exec.CommandContext(ctx, \"git\", \"show\", \"HEAD:.entire/settings.json\")\n216\t\toutput, err := cmd.Output()\n217\t\tif err != nil {\n218\t\t\treturn false\n219\t\t}\n220\t\tcommitted, err := settings.LoadFromBytes(output)\n221\t\tif err != nil {\n222\t\t\treturn false\n223\t\t}\n224\t\treturn committed.CheckpointsVersion() == 2\n225\t}\n226\t\n227\t// pushResult describes what happened during a push attempt.\n228\ttype pushResult struct {\n229\t\t// upToDate is true when the remote already had all commits (nothing transferred).\n230\t\tupToDate bool\n231\t}\n232\t\n233\t// parsePushResult checks git push --porcelain output for ref status flags.\n234\t// In porcelain mode, each ref gets a tab-delimited status line:\n235\t//\n236\t//\t<flag>\\t<from>:<to>\\t<summary>\n237\t//\n238\t// where flag '=' means the ref was already up-to-date. This is locale-independent,\n239\t// unlike the human-readable \"Everything up-to-date\" message.\n240\tfunc parsePushResult(output string) pushResult {\n241\t\tfor _, line := range strings.Split(output, \"\\n\") {\n242\t\t\tif strings.HasPrefix(line, \"=\\t\") {\n243\t\t\t\treturn pushResult{upToDate: true}\n244\t\t\t}\n245\t\t}\n246\t\treturn pushResult{upToDate: false}\n247\t}\n248\t\n249\t// finishPush stops the progress dots and prints \"already up-to-date\" or \"done\"\n250\t// depending on the push result. Only prints the settings commit hint when new\n251\t// content was actually pushed.\n252\tfunc finishPush(ctx context.Context, stop func(string), result pushResult, target string) {\n253\t\tif result.upToDate {\n254\t\t\tstop(\" already up-to-date\")\n255\t\t} else {\n256\t\t\tstop(\" done\")\n257\t\t\tprintSettingsCommitHint(ctx, target)\n258\t\t}\n259\t\tprintCheckpointsV2MigrationHint(ctx)\n260\t}\n261\t\n262\t// tryPushSessionsCommon attempts to push the sessions branch.\n263\tfunc tryPushSessionsCommon(ctx context.Context, remoteName, branchName string) (pushResult, error) {\n264\t\tctx, cancel := context.WithTimeout(ctx, 2*time.Minute)\n265\t\tdefer cancel()\n266\t\n267\t\tresult, err := remote.Push(ctx, remoteName, branchName)\n268\t\toutputStr := result.Output\n269\t\tif err != nil {\n270\t\t\tif strings.Contains(outputStr, \"non-fast-forward\") ||\n271\t\t\t\tstrings.Contains(outputStr, \"rejected\") {\n272\t\t\t\treturn pushResult{}, errors.New(\"non-fast-forward\")\n273\t\t\t}\n274\t\t\treturn pushResult{}, fmt.Errorf(\"push failed: %s\", outputStr)\n275\t\t}\n276\t\n277\t\treturn parsePushResult(outputStr), nil\n278\t}\n279\t\n280\t// fetchAndRebaseSessionsCommon fetches remote sessions and rebases local commits\n281\t// on top of the remote tip. Since checkpoint shards use unique paths, rebases\n282\t// always apply cleanly.\n283\t// The target can be a remote name or a URL.\n284\tfunc fetchAndRebaseSessionsCommon(ctx context.Context, target, branchName string) error {\n285\t\tctx, cancel := context.WithTimeout(ctx, 2*time.Minute)\n286\t\tdefer cancel()\n287\t\n288\t\tfetchTarget, err := remote.ResolveFetchTarget(ctx, target)\n289\t\tif err != nil {\n290\t\t\treturn fmt.Errorf(\"resolve fetch target: %w\", err)\n291\t\t}\n292\t\n293\t\t// Determine fetch refspec. When the resolved fetch target is a URL, use a\n294\t\t// temp ref; when it's still a remote name, use the standard remote-tracking\n295\t\t// ref.\n296\t\tvar fetchedRefName plumbing.ReferenceName\n297\t\tvar refSpec string\n298\t\tusedTempRef := remote.IsURL(fetchTarget)\n299\t\tif usedTempRef {\n300\t\t\ttmpRef := \"refs/entire-fetch-tmp/\" + branchName\n301\t\t\trefSpec = fmt.Sprintf(\"+refs/heads/%s:%s\", branchName, tmpRef)\n302\t\t\tfetchedRefName = plumbing.ReferenceName(tmpRef)\n303\t\t} else {\n304\t\t\trefSpec = fmt.Sprintf(\"+refs/heads/%s:refs/remotes/%s/%s\", branchName, target, branchName)\n305\t\t\tfetchedRefName = plumbing.NewRemoteReferenceName(target, branchName)\n306\t\t}\n307\t\n308\t\t// Use git CLI for fetch (go-git's