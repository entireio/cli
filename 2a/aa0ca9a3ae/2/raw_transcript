{"parentUuid":"be89c337-445e-4b3f-93d9-03e9cd0983d9","isSidechain":false,"promptId":"76fb1f86-9659-4048-8ac0-036e42897396","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QMxWz3pPbhU8Rm1iYsh8QY","type":"tool_result","content":"1\tpackage strategy\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"log/slog\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"strings\"\n12\t\t\"sync\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n16\t\tremote \"github.com/entireio/cli/cmd/entire/cli/checkpoint/remote\"\n17\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n18\t\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n19\t\n20\t\t\"github.com/go-git/go-git/v6\"\n21\t\t\"github.com/go-git/go-git/v6/plumbing\"\n22\t\t\"github.com/go-git/go-git/v6/plumbing/object\"\n23\t)\n24\t\n25\t// disconnectedOnce ensures the disconnection warning runs at most once per process.\n26\tvar disconnectedOnce sync.Once //nolint:gochecknoglobals // intentional per-process gate\n27\t\n28\t// IsMetadataDisconnected checks whether the local metadata branch\n29\t// and the provided fetched or remote-tracking ref exist but share no common\n30\t// ancestor.\n31\tfunc IsMetadataDisconnected(ctx context.Context, repo *git.Repository, remoteRefName plumbing.ReferenceName) (bool, error) {\n32\t\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n33\t\tlocalRef, err := repo.Reference(refName, true)\n34\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n35\t\t\treturn false, nil\n36\t\t}\n37\t\tif err != nil {\n38\t\t\treturn false, fmt.Errorf(\"failed to check local metadata branch: %w\", err)\n39\t\t}\n40\t\n41\t\tremoteRef, err := repo.Reference(remoteRefName, true)\n42\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n43\t\t\treturn false, nil\n44\t\t}\n45\t\tif err != nil {\n46\t\t\treturn false, fmt.Errorf(\"failed to check remote metadata branch: %w\", err)\n47\t\t}\n48\t\n49\t\tif localRef.Hash() == remoteRef.Hash() {\n50\t\t\treturn false, nil\n51\t\t}\n52\t\n53\t\trepoPath, err := getRepoPath(repo)\n54\t\tif err != nil {\n55\t\t\treturn false, err\n56\t\t}\n57\t\n58\t\treturn isDisconnected(ctx, repoPath, localRef.Hash().String(), remoteRef.Hash().String())\n59\t}\n60\t\n61\t// WarnIfMetadataDisconnected checks (once per process) whether the metadata\n62\t// branch is disconnected and prints a warning to stderr if so.\n63\t// It does NOT fix the problem — users are directed to 'entire doctor'.\n64\t//\n65\t// Uses sync.Once, so a transient failure on the first call permanently suppresses\n66\t// the warning. This is acceptable because the check is advisory only and\n67\t// 'entire doctor' is the authoritative repair path.\n68\tfunc WarnIfMetadataDisconnected() {\n69\t\tdisconnectedOnce.Do(func() {\n70\t\t\tctx := context.Background()\n71\t\t\trepo, err := OpenRepository(ctx)\n72\t\t\tif err != nil {\n73\t\t\t\tlogging.Debug(ctx, \"metadata disconnection check: could not open repository\",\n74\t\t\t\t\tslog.String(\"error\", err.Error()))\n75\t\t\t\treturn\n76\t\t\t}\n77\t\t\tdisconnected, err := IsMetadataDisconnected(ctx, repo, plumbing.NewRemoteReferenceName(\"origin\", paths.MetadataBranchName))\n78\t\t\tif err != nil {\n79\t\t\t\tlogging.Debug(ctx, \"metadata disconnection check failed\",\n80\t\t\t\t\tslog.String(\"error\", err.Error()))\n81\t\t\t\treturn\n82\t\t\t}\n83\t\t\tif !disconnected {\n84\t\t\t\treturn\n85\t\t\t}\n86\t\t\tfmt.Fprintln(os.Stderr, \"[entire] Warning: Local and remote session metadata branches are disconnected.\")\n87\t\t\tfmt.Fprintln(os.Stderr, \"[entire] Some checkpoints from remote may not be visible. Run 'entire doctor' to fix.\")\n88\t\t})\n89\t}\n90\t\n91\t// ReconcileDisconnectedMetadataBranch detects and repairs disconnected local/remote\n92\t// entire/checkpoints/v1 branches. Disconnected means no common ancestor, which\n93\t// only happens due to the empty-orphan bug. Diverged (shared ancestor) is normal\n94\t// and handled by the push path's tree merge.\n95\t//\n96\t// Repair strategy: cherry-pick local commits onto remote tip, preserving all data.\n97\t// Checkpoint shards use unique paths (<id[:2]>/<id[2:]>/), so cherry-picks always\n98\t// apply cleanly.\n99\t//\n100\t// Progress messages are written to w (typically os.Stderr for hooks or\n101\t// cmd.ErrOrStderr() for commands).\n102\t// The remote ref can be either a remote-tracking ref or a temporary fetched ref.\n103\tfunc ReconcileDisconnectedMetadataBranch(\n104\t\tctx context.Context,\n105\t\trepo *git.Repository,\n106\t\tremoteRefName plumbing.ReferenceName,\n107\t\tw io.Writer,\n108\t) error {\n109\t\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n110\t\n111\t\t// Check local branch\n112\t\tlocalRef, err := repo.Reference(refName, true)\n113\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n114\t\t\treturn nil // No local branch — nothing to reconcile\n115\t\t}\n116\t\tif err != nil {\n117\t\t\treturn fmt.Errorf(\"failed to check local metadata branch: %w\", err)\n118\t\t}\n119\t\n120\t\t// Check remote-tracking branch\n121\t\tremoteRef, err := repo.Reference(remoteRefName, true)\n122\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n123\t\t\treturn nil // No remote branch — nothing to reconcile\n124\t\t}\n125\t\tif err != nil {\n126\t\t\treturn fmt.Errorf(\"failed to check remote metadata branch: %w\", err)\n127\t\t}\n128\t\n129\t\tlocalHash := localRef.Hash()\n130\t\tremoteHash := remoteRef.Hash()\n131\t\n132\t\t// Same hash — nothing to do\n133\t\tif localHash == remoteHash {\n134\t\t\treturn nil\n135\t\t}\n136\t\n137\t\t// Check if disconnected using git merge-base\n138\t\trepoPath, err := getRepoPath(repo)\n139\t\tif err != nil {\n140\t\t\treturn err\n141\t\t}\n142\t\n143\t\tdisconnected, err := isDisconnected(ctx, repoPath, localHash.String(), remoteHash.String())\n144\t\tif err != nil {\n145\t\t\treturn fmt.Errorf(\"failed to check metadata branch ancestry: %w\", err)\n146\t\t}\n147\t\tif !disconnected {\n148\t\t\t// Shared ancestry (diverged or ancestor) — not our problem\n149\t\t\treturn nil\n150\t\t}\n151\t\n152\t\t// Disconnected — cherry-pick local commits onto remote tip\n153\t\tfmt.Fprintln(w, \"[entire] Detected disconnected session metadata (local and remote share no common ancestor)\")\n154\t\n155\t\t// Collect local commits oldest-first\n156\t\tlocalCommits, err := collectCommitChain(repo, localHash)\n157\t\tif err != nil {\n158\t\t\treturn fmt.Errorf(\"failed to collect local commits: %w\", err)\n159\t\t}\n160\t\n161\t\t// Filter out empty-tree commits (the orphan bug commit)\n162\t\tvar dataCommits []*object.Commit\n163\t\tfor _, c := range localCommits {\n164\t\t\ttree, treeErr := c.Tree()\n165\t\t\tif treeErr != nil {\n166\t\t\t\treturn fmt.Errorf(\"failed to read tree for commit %s: %w\", c.Hash.String()[:7], treeErr)\n167\t\t\t}\n168\t\t\tif len(tree.Entries) > 0 {\n169\t\t\t\tdataCommits = append(dataCommits, c)\n170\t\t\t}\n171\t\t}\n172\t\n173\t\tif len(dataCommits) == 0 {\n174\t\t\t// Local only had empty orphan — just point to remote\n175\t\t\tref := plumbing.NewHashReference(refName, remoteHash)\n176\t\t\tif err := repo.Storer.SetReference(ref); err != nil {\n177\t\t\t\treturn fmt.Errorf(\"failed to reset metadata branch to remote: %w\", err)\n178\t\t\t}\n179\t\t\tfmt.Fprintln(w, \"[entire] Done — local had no checkpoint data, reset to remote\")\n180\t\t\treturn nil\n181\t\t}\n182\t\n183\t\tfmt.Fprintf(w, \"[entire] Cherry-picking %d local checkpoint(s) onto remote...\\n\", len(dataCommits))\n184\t\n185\t\tnewTip, err := cherryPickOnto(ctx, repo, remoteHash, dataCommits)\n186\t\tif err != nil {\n187\t\t\treturn fmt.Errorf(\"failed to cherry-pick local commits onto remote: %w\", err)\n188\t\t}\n189\t\n190\t\t// Update local branch ref\n191\t\tref := plumbing.NewHashReference(refName, newTip)\n192\t\tif err := repo.Storer.SetReference(ref); err != nil {\n193\t\t\treturn fmt.Errorf(\"failed to update metadata branch: %w\", err)\n194\t\t}\n195\t\n196\t\tfmt.Fprintln(w, \"[entire] Done — all local and remote checkpoints preserved\")\n197\t\treturn nil\n198\t}\n199\t\n200\t// v2DoctorTmpRef is the temporary ref used by doctor to fetch and compare the remote v2 /main.\n201\t// Uses the refs/entire-fetch-tmp/ namespace consistent with checkpoint_remote.go.\n202\tconst v2DoctorTmpRef = \"refs/entire-fetch-tmp/doctor-v2-main\"\n203\t\n204\t// IsV2MainDisconnected checks whether the local v2 /main ref and the remote\n205\t// v2 /main ref exist but share no common ancestor. Uses git ls-remote to\n206\t// discover the remote ref (custom refs don't have remote-tracking refs).\n207\t//\n208\t// remote is the git remote name, URL, or local path to check against.\n209\t// Returns (false, nil) if either ref doesn't exist or they share ancestry.\n210\tfunc IsV2MainDisconnected(ctx context.Context, repo *git.Repository, remote string) (bool, error) {\n211\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n212\t\n213\t\tlocalRef, err := repo.Reference(refName, true)\n214\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n215\t\t\treturn false, nil\n216\t\t}\n217\t\tif err != nil {\n218\t\t\treturn false, fmt.Errorf(\"failed to check local v2 /main ref: %w\", err)\n219\t\t}\n220\t\n221\t\trepoPath, err := getRepoPath(repo)\n222\t\tif err != nil {\n223\t\t\treturn false, err\n224\t\t}\n225\t\n226\t\tremoteHash, err := lsRemoteRef(ctx, repoPath, remote, paths.V2MainRefName)\n227\t\tif err != nil {\n228\t\t\treturn false, fmt.Errorf(\"failed to ls-remote v2 /main: %w\", err)\n229\t\t}\n230\t\tif remoteHash == plumbing.ZeroHash {\n231\t\t\treturn false, nil // Remote doesn't have the ref\n232\t\t}\n233\t\n234\t\tif localRef.Hash() == remoteHash {\n235\t\t\treturn false, nil\n236\t\t}\n237\t\n238\t\t// Fetch remote ref to temporary local ref for merge-base check.\n239\t\t// Use the fetched hash (not ls-remote hash) since the remote may have advanced.\n240\t\tif fetchErr := fetchRefToTemp(ctx, repoPath, remote, paths.V2MainRefName, v2DoctorTmpRef); fetchErr != nil {\n241\t\t\treturn false, fmt.Errorf(\"failed to fetch remote v2 /main: %w\", fetchErr)\n242\t\t}\n243\t\tdefer cleanupTmpRef(repo)\n244\t\n245\t\tfetchedHash, err := resolveRefHash(repo, v2DoctorTmpRef)\n246\t\tif err != nil {\n247\t\t\treturn false, fmt.Errorf(\"failed to read fetched v2 /main ref: %w\", err)\n248\t\t}\n249\t\n250\t\tif localRef.Hash() == fetchedHash {\n251\t\t\treturn false, nil\n252\t\t}\n253\t\n254\t\treturn isDisconnected(ctx, repoPath, localRef.Hash().String(), fetchedHash.String())\n255\t}\n256\t\n257\t// ReconcileDisconnectedV2Ref detects and repairs disconnected local/remote\n258\t// v2 /main refs. Same strategy as v1: cherry-pick local commits onto remote tip.\n259\t// The remote is discovered via git ls-remote and fetched to a temp ref.\n260\t//\n261\t// remote is the git remote name, URL, or local path.\n262\tfunc ReconcileDisconnectedV2Ref(\n263\t\tctx context.Context,\n264\t\trepo *git.Repository,\n265\t\tremote string,\n266\t\tw io.Writer,\n267\t) error {\n268\t\trefName := plumbing.ReferenceName(paths.V2MainRefName)\n269\t\n270\t\tlocalRef, err := repo.Reference(refName, true)\n271\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n272\t\t\treturn nil\n273\t\t}\n274\t\tif err != nil {\n275\t\t\treturn fmt.Errorf(\"failed to check local v2 /main ref: %w\", err)\n276\t\t}\n277\t\n278\t\trepoPath, err := getRepoPath(repo)\n279\t\tif err != nil {\n280\t\t\treturn err\n281\t\t}\n282\t\n283\t\tremoteHash, err := lsRemoteRef(ctx, repoPath, remote, paths.V2MainRefName)\n284\t\tif err != nil {\n285\t\t\treturn fmt.Errorf(\"failed to ls-remote v2 /main: %w\", err)\n286\t\t}\n287\t\tif remoteHash == plumbing.ZeroHash {\n288\t\t\treturn nil\n289\t\t}\n290\t\n291\t\tif localRef.Hash() == remoteHash {\n292\t\t\treturn nil\n293\t\t}\n294\t\n295\t\tif fetchErr := fetchRefToTemp(ctx, repoPath, remote, paths.V2MainRefName, v2DoctorTmpRef); fetchErr != nil {\n296\t\t\treturn fmt.Errorf(\"failed to fetch remote v2 /main: %w\", fetchErr)\n297\t\t}\n298\t\tdefer cleanupTmpRef(repo)\n299\t\n300\t\t// Use the fetched hash (not ls-remote hash) since the remote may have advanced.\n301\t\tfetchedHash, err := resolveRefHash(repo, v2DoctorTmpRef)\n302\t\tif err != nil {\n303\t\t\treturn fmt.Errorf(\"failed to read fetched v2 /main ref: %w\", err)\n304\t\t}\n305\t\n306\t\tif localRef.Hash() == fetchedHash {\n307\t\t\treturn nil\n308\t\t}\n309\t\n310\t\tdisconnected, err := isDisconnected(ctx, repoPath, localRef.Hash().String(), fetchedHash.String())\n311\t\tif err != nil {\n312\t\t\treturn fmt.Errorf(\"failed to check v2 /main ancestry: %w\", err)\n313\t\t}\n314\t\tif !disconnected {\n315\t\t\treturn nil\n316\t\t}\n317\t\n318\t\tfmt.Fprintln(w, \"[entire] Detected disconnected v2 /main refs (local and remote share no common ancestor)\")\n319\t\n320\t\tlocalCommits, err := collectCommitChain(repo, localRef.Hash())\n321\t\tif err != nil {\n322\t\t\treturn fmt.Errorf(\"failed to collect local commits: %w\", err)\n323\t\t}\n324\t\n325\t\tvar dataCommits []*object.Commit\n326\t\tfor _, c := range localCommits {\n327\t\t\ttree, treeErr := c.Tree()\n328\t\t\tif treeErr != nil {\n329\t\t\t\treturn fmt.Errorf(\"failed to read tree for commit %s: %w\", c.Hash.String()[:7], treeErr)\n330\t\t\t}\n331\t\t\tif len(tree.Entries) > 0 {\n332\t\t\t\tdataCommits = append(dataCommits, c)\n333\t\t\t}\n334\t\t}\n335\t\n336\t\tif len(dataCommits) == 0 {\n337\t\t\tref := plumbing.NewHashReference(refName, fetchedHash)\n338\t\t\tif setErr := repo.Storer.SetReference(ref); setErr != nil {\n339\t\t\t\treturn fmt.Errorf(\"failed to reset v2 /main to remote: %w\", setErr)\n340\t\t\t}\n341\t\t\tfmt.Fprintln(w, \"[entire] Done — local had no checkpoint data, reset to remote\")\n342\t\t\treturn nil\n343\t\t}\n344\t\n345\t\tfmt.Fprintf(w, \"[entire] Cherry-picking %d local checkpoint(s) onto remote...\\n\", len(dataCommits))\n346\t\n347\t\tnewTip, err := cherryPickOnto(ctx, repo, fetchedHash, dataCommits)\n348\t\tif err != nil {\n349\t\t\treturn fmt.Errorf(\"failed to cherry-pick local commits onto remote: %w\", err)\n350\t\t}\n351\t\n352\t\tref := plumbing.NewHashReference(refName, newTip)\n353\t\tif setErr := repo.Storer.SetReference(ref); setErr != nil {\n354\t\t\treturn fmt.Errorf(\"failed to update v2 /main ref: %w\", setErr)\n355\t\t}\n356\t\n357\t\tfmt.Fprintln(w, \"[entire] Done — all local and remote checkpoints preserved\")\n358\t\treturn nil\n359\t}\n360\t\n361\t// lsRemoteRef runs git ls-remote and returns the hash for a specific ref.\n362\t// Returns plumbing.ZeroHash if the ref doesn't exist on the remote.\n363\tfunc lsRemoteRef(ctx context.Context, repoPath, remoteName, refName string) (plumbing.Hash, error) {\n364\t\tctx, cancel := context.WithTimeout(ctx, 10*time.Second)\n365\t\tdefer cancel()\n366\t\n367\t\tfetchTarget, err := remote.ResolveFetchTarget(ctx, remoteName)\n368\t\tif err != nil {\n369\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"resolve fetch target for ls-remote: %w\", err)\n370\t\t}\n371\t\n372\t\toutput, err := remote.LsRemoteInDir(ctx, repoPath, fetchTarget, refName)\n373\t\tif err != nil {\n374\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"git ls-remote %s failed: %w\", remote.RedactURL(fetchTarget), err)\n375\t\t}\n376\t\n377\t\tline := strings.TrimSpace(string(output))\n378\t\tif line == \"\" {\n379\t\t\treturn plumbing.ZeroHash, nil\n380\t\t}\n381\t\n382\t\tparts := strings.Fields(line)\n383\t\tif len(parts) < 2 {\n384\t\t\treturn plumbing.ZeroHash, nil\n385\t\t}\n386\t\n387\t\treturn plumbing.NewHash(parts[0]), nil\n388\t}\n389\t\n390\t// fetchRefToTemp fetches a remote ref to a temporary local ref for comparison.\n391\tfunc fetchRefToTemp(ctx context.Context, repoPath, remoteName, srcRef, dstRef string) error {\n392\t\tctx, cancel := context.WithTimeout(ctx, 30*time.Second)\n393\t\tdefer cancel()\n394\t\n395\t\tfetchTarget, err := remote.ResolveFetchTarget(ctx, remoteName)\n396\t\tif err != nil {\n397\t\t\treturn fmt.Errorf(\"resolve fetch target for doctor v2 fetch: %w\", err)\n398\t\t}\n399\t\n400\t\trefspec := fmt.Sprintf(\"+%s:%s\", srcRef, dstRef)\n401\t\toutput, err := remote.Fetch(ctx, remote.FetchOptions{\n402\t\t\tRemote:   fetchTarget,\n403\t\t\tRefSpecs: []string{refspec},\n404\t\t\tNoTags:   true,\n405\t\t\tDir:      repoPath,\n406\t\t})\n407\t\tif err != nil {\n408\t\t\tredactedURL := remote.RedactURL(fetchTarget)\n409\t\t\tmsg := strings.TrimSpace(strings.ReplaceAll(string(output), fetchTarget, redactedURL))\n410\t\t\tif msg != \"\" {\n411\t\t\t\treturn fmt.Errorf(\"git fetch %s failed: %s: %w\", redactedURL, msg, err)\n412\t\t\t}\n413\t\t\treturn fmt.Errorf(\"git fetch %s failed: %w\", redactedURL, err)\n414\t\t}\n415\t\treturn nil\n416\t}\n417\t\n418\t// resolveRefHash reads the commit hash that a ref points to.\n419\tfunc resolveRefHash(repo *git.Repository, refName string) (plumbing.Hash, error) {\n420\t\tref, err := repo.Reference(plumbing.ReferenceName(refName), true)\n421\t\tif err != nil {\n422\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"ref %s not found: %w\", refName, err)\n423\t\t}\n424\t\treturn ref.Hash(), nil\n425\t}\n426\t\n427\t// cleanupTmpRef deletes the temporary ref used by doctor checks.\n428\tfunc cleanupTmpRef(repo *git.Repository) {\n429\t\t_ = repo.Storer.RemoveReference(plumbing.ReferenceName(v2DoctorTmpRef)) //nolint:errcheck // best-effort cleanup\n430\t}\n431\t\n432\t// isDisconnected checks if two commits have no common ancestor using git merge-base.\n433\t// Returns (true, nil) if disconnected, (false, nil) if they share ancestry,\n434\t// or (false, error) if git merge-base failed for another reason.\n435\t//\n436\t// git merge-base exit codes:\n437\t//   - 0: common ancestor found (shared ancestry)\n438\t//   - 1: no common ancestor (disconnected)\n439\t//   - 128+: error (corrupt repo, invalid hash, etc.)\n440\tfunc isDisconnected(ctx context.Context, repoPath, hashA, hashB string) (bool, error) {\n441\t\tctx, cancel := context.WithTimeout(ctx, 10*time.Second)\n442\t\tdefer cancel()\n443\t\tcmd := exec.CommandContext(ctx, \"git\", \"merge-base\", hashA, hashB)\n444\t\tcmd.Dir = repoPath\n445\t\tif err := cmd.Run(); err != nil {\n446\t\t\tvar exitErr *exec.ExitError\n447\t\t\tif errors.As(err, &exitErr) && exitErr.ExitCode() == 1 {\n448\t\t\t\treturn true, nil // No common ancestor — disconnected\n449\t\t\t}\n450\t\t\treturn false, fmt.Errorf(\"git merge-base failed: %w\", err)\n451\t\t}\n452\t\treturn false, nil // Shared ancestry\n453\t}\n454\t\n455\t// collectCommitChain walks from tip to root following first parent, returns oldest-first.\n456\tfunc collectCommitChain(repo *git.Repository, tip plumbing.Hash) ([]*object.Commit, error) {\n457\t\tvar chain []*object.Commit\n458\t\tcurrent := tip\n459\t\n460\t\treachedRoot := false\n461\t\tfor range MaxCommitTraversalDepth {\n462\t\t\tcommit, err := repo.CommitObject(current)\n463\t\t\tif err != nil {\n464\t\t\t\treturn nil, fmt.Errorf(\"failed to get commit %s: %w\", current, err)\n465\t\t\t}\n466\t\t\tchain = append(chain, commit)\n467\t\n468\t\t\tif len(commit.ParentHashes) == 0 {\n469\t\t\t\treachedRoot = true\n470\t\t\t\tbreak\n471\t\t\t}\n472\t\t\tcurrent = commit.ParentHashes[0]\n473\t\t}\n474\t\n475\t\tif !reachedRoot {\n476\t\t\treturn nil, fmt.Errorf(\"commit chain exceeded %d commits without reaching root; aborting reconciliation\", MaxCommitTraversalDepth)\n477\t\t}\n478\t\n479\t\t// Reverse to oldest-first\n480\t\tfor i, j := 0, len(chain)-1; i < j; i, j = i+1, j-1 {\n481\t\t\tchain[i], chain[j] = chain[j], chain[i]\n482\t\t}\n483\t\n484\t\treturn chain, nil\n485\t}\n486\t\n487\t// cherryPickOnto applies each commit's delta onto base, building a linear chain.\n488\t// For each commit, it computes the full diff from its parent (additions, modifications,\n489\t// and deletions), then applies that delta onto the current tip's tree.\n490\tfunc cherryPickOnto(ctx context.Context, repo *git.Repository, base plumbing.Hash, commits []*object.Commit) (plumbing.Hash, error) {\n491\t\tcurrentTip := base\n492\t\n493\t\tfor _, commit := range commits {\n494\t\t\t// Get the commit's tree entries\n495\t\t\tcommitTree, err := commit.Tree()\n496\t\t\tif err != nil {\n497\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get tree for commit %s: %w\", commit.Hash, err)\n498\t\t\t}\n499\t\n500\t\t\tcommitEntries := make(map[string]object.TreeEntry)\n501\t\t\tif err := checkpoint.FlattenTree(repo, commitTree, \"\", commitEntries); err != nil {\n502\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to flatten commit tree: %w\", err)\n503\t\t\t}\n504\t\n505\t\t\t// Get parent's tree entries (empty if root commit)\n506\t\t\tparentEntries := make(map[string]object.TreeEntry)\n507\t\t\tif len(commit.ParentHashes) > 0 {\n508\t\t\t\tparentCommit, pErr := repo.CommitObject(commit.ParentHashes[0])\n509\t\t\t\tif pErr != nil {\n510\t\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get parent commit %s: %w\", commit.ParentHashes[0], pErr)\n511\t\t\t\t}\n512\t\t\t\tparentTree, ptErr := parentCommit.Tree()\n513\t\t\t\tif ptErr != nil {\n514\t\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get parent tree for commit %s: %w\", commit.ParentHashes[0], ptErr)\n515\t\t\t\t}\n516\t\t\t\tif err := checkpoint.FlattenTree(repo, parentTree, \"\", parentEntries); err != nil {\n517\t\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to flatten parent tree for commit %s: %w\", commit.ParentHashes[0], err)\n518\t\t\t\t}\n519\t\t\t}\n520\t\n521\t\t\t// Compute full delta: additions, modifications, and deletions\n522\t\t\tadded := make(map[string]object.TreeEntry)\n523\t\t\tfor path, entry := range commitEntries {\n524\t\t\t\tparentEntry, exists := parentEntries[path]\n525\t\t\t\tif !exists || parentEntry.Hash != entry.Hash {\n526\t\t\t\t\tadded[path] = entry // New or modified\n527\t\t\t\t}\n528\t\t\t}\n529\t\t\tvar deleted []string\n530\t\t\tfor path := range parentEntries {\n531\t\t\t\tif _, exists := commitEntries[path]; !exists {\n532\t\t\t\t\tdeleted = append(deleted, path) // Removed in this commit\n533\t\t\t\t}\n534\t\t\t}\n535\t\n536\t\t\tif len(added) == 0 && len(deleted) == 0 {\n537\t\t\t\tcontinue // Skip no-op commits\n538\t\t\t}\n539\t\n540\t\t\t// Get current tip's tree and apply delta\n541\t\t\ttipCommit, err := repo.CommitObject(currentTip)\n542\t\t\tif err != nil {\n543\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get tip commit: %w\", err)\n544\t\t\t}\n545\t\t\ttipTree, err := tipCommit.Tree()\n546\t\t\tif err != nil {\n547\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to get tip tree: %w\", err)\n548\t\t\t}\n549\t\n550\t\t\tmergedEntries := make(map[string]object.TreeEntry)\n551\t\t\tif err := checkpoint.FlattenTree(repo, tipTree, \"\", mergedEntries); err != nil {\n552\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to flatten tip tree: %w\", err)\n553\t\t\t}\n554\t\t\tfor path, entry := range added {\n555\t\t\t\tmergedEntries[path] = entry\n556\t\t\t}\n557\t\t\tfor _, path := range deleted {\n558\t\t\t\tdelete(mergedEntries, path)\n559\t\t\t}\n560\t\n561\t\t\tmergedTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, mergedEntries)\n562\t\t\tif err != nil {\n563\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to build merged tree: %w\", err)\n564\t\t\t}\n565\t\n566\t\t\t// Create new commit on top of current tip, preserving original message/author\n567\t\t\tnewHash, err := createCherryPickCommit(ctx, repo, mergedTreeHash, currentTip, commit)\n568\t\t\tif err != nil {\n569\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to create cherry-pick commit: %w\", err)\n570\t\t\t}\n571\t\n572\t\t\tcurrentTip = newHash\n573\t\t}\n574\t\n575\t\treturn currentTip, nil\n576\t}\n577\t\n578\t// createCherryPickCommit creates a new commit on top of parent, preserving the\n579\t// original commit's message and author.\n580\tfunc createCherryPickCommit(ctx context.Context, repo *git.Repository, tre