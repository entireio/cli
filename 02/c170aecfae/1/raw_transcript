m-json\",\n605\t\t\t\"--verbose\",\n606\t\t\t\"--model\", model,\n607\t\t\t\"--setting-sources\", \"\")\n608\t\n609\t\tcmd.Dir = os.TempDir()\n610\t\tcmd.Env = agent.StripGitEnv(os.Environ())\n611\t\tcmd.Stdin = strings.NewReader(prompt)\n612\t\n613\t\tstdout, err := cmd.StdoutPipe()\n614\t\tif err != nil {\n615\t\t\treturn \"\", fmt.Errorf(\"claude stream stdout pipe: %w\", err)\n616\t\t}\n617\t\tvar stderr bytes.Buffer\n618\t\tcmd.Stderr = &stderr\n619\t\n620\t\tif err := cmd.Start(); err != nil {\n621\t\t\treturn \"\", fmt.Errorf(\"claude stream start: %w\", err)\n622\t\t}\n623\t\n624\t\tfinal, malformed, parseErr := streamClaudeResponse(stdout, makeProgressDispatcher(progress))\n625\t\n626\t\t// Drain any unread stdout so the subprocess can exit cleanly even if the\n627\t\t// scanner aborted early (e.g. bufio.ErrTooLong on an oversized line).\n628\t\t// Without this, a blocked pipe would deadlock cmd.Wait().\n629\t\tif _, drainErr := io.Copy(io.Discard, stdout); drainErr != nil {\n630\t\t\tlogging.Debug(ctx, \"draining claude stream stdout\", slog.String(\"error\", drainErr.Error()))\n631\t\t}\n632\t\twaitErr := cmd.Wait()\n633\t\n634\t\tif malformed > 0 {\n635\t\t\tlogging.Warn(ctx, \"skipped malformed claude stream lines\", slog.Int(\"count\", malformed))\n636\t\t}\n637\t\n638\t\t// Specific envelope error outranks a generic ctx-cancel message.\n639\t\tif final != nil && final.IsError {\n640\t\t\treturn \"\", envelopeErrorMessage(final)\n641\t\t}\n642\t\n643\t\tif ctx.Err() != nil {\n644\t\t\tif errors.Is(ctx.Err(), context.DeadlineExceeded) {\n645\t\t\t\treturn \"\", context.DeadlineExceeded\n646\t\t\t}\n647\t\t\treturn \"\", context.Canceled\n648\t\t}\n649\t\n650\t\tif final != nil {\n651\t\t\tif final.Result == nil {\n652\t\t\t\treturn \"\", errors.New(\"claude returned empty result\")\n653\t\t\t}\n654\t\t\tif progress != nil {\n655\t\t\t\tprogress(agent.GenerationProgress{\n656\t\t\t\t\tPhase:        agent.PhaseDone,\n657\t\t\t\t\tOutputTokens: outputTokensFromUsage(final.Usage),\n658\t\t\t\t\tDurationMs:   final.DurationMs,\n659\t\t\t\t})\n660\t\t\t}\n661\t\t\treturn *final.Result, nil\n662\t\t}\n663\t\n664\t\t// No envelope: check if the CLI rejected streaming flags (older version).\n665\t\tif waitErr != nil {\n666\t\t\tstderrStr := stderr.String()\n667\t\t\tif looksLikeUnrecognizedFlag(stderrStr) {\n668\t\t\t\tlogging.Warn(ctx, \"claude CLI rejected stream-json flags; falling back to non-streaming (no progress output)\",\n669\t\t\t\t\tslog.String(\"stderr\", strings.TrimSpace(stderrStr)))\n670\t\t\t\treturn c.GenerateText(ctx, prompt, model)\n671\t\t\t}\n672\t\t\tif stderrStr != \"\" {\n673\t\t\t\treturn \"\", fmt.Errorf(\"claude stream failed: %s: %w\", strings.TrimSpace(stderrStr), waitErr)\n674\t\t\t}\n675\t\t\treturn \"\", fmt.Errorf(\"claude stream failed: %w\", waitErr)\n676\t\t}\n677\t\n678\t\tif parseErr != nil {\n679\t\t\treturn \"\", fmt.Errorf(\"claude stream parse: %w\", parseErr)\n680\t\t}\n681\t\treturn \"\", errors.New(\"claude exited without producing a result\")\n682\t}\n683\t\n684\t// envelopeErrorMessage formats an is_error result envelope as a user-facing\n685\t// error. Preserves the CLI's result text and HTTP status when present.\n686\tfunc envelopeErrorMessage(final *streamEvent) error {\n687\t\tmsg := \"claude CLI reported error\"\n688\t\tif final.Result != nil && *final.Result != \"\" {\n689\t\t\tmsg = fmt.Sprintf(\"%s: %s\", msg, *final.Result)\n690\t\t}\n691\t\tif final.APIErrorStatus != nil {\n692\t\t\tmsg = fmt.Sprintf(\"%s (HTTP %d)\", msg, *final.APIErrorStatus)\n693\t\t}\n694\t\treturn errors.New(msg)\n695\t}\n696\t\n697\t// makeProgressDispatcher returns a per-event handler that translates raw\n698\t// stream events into agent.GenerationProgress callbacks. PhaseDone is\n699\t// emitted by GenerateTextStreaming after cmd.Wait, because it needs data\n700\t// from the parsed final envelope.\n701\tfunc makeProgressDispatcher(progress agent.ProgressFn) func(streamEvent) {\n702\t\tif progress == nil {\n703\t\t\treturn func(streamEvent) {}\n704\t\t}\n705\t\tvar outputTokensEstimate int\n706\t\treturn func(ev streamEvent) {\n707\t\t\tswitch {\n708\t\t\tcase ev.Type == \"system\" && ev.Subtype == \"status\" && ev.Status == \"requesting\":\n709\t\t\t\tprogress(agent.GenerationProgress{Phase: agent.PhaseConnecting})\n710\t\t\tcase ev.Type == \"stream_event\" && ev.Event.Type == \"message_start\":\n711\t\t\t\tp := agent.GenerationProgress{Phase: agent.PhaseFirstToken, TTFTms: ev.TTFTms}\n712\t\t\t\tif ev.Event.Message != nil && ev.Event.Message.Usage != nil {\n713\t\t\t\t\tp.InputTokens = ev.Event.Message.Usage.InputTokens\n714\t\t\t\t\tp.CachedInputTokens = ev.Event.Message.Usage.CacheReadInputTokens\n715\t\t\t\t}\n716\t\t\t\tprogress(p)\n717\t\t\tcase ev.Type == \"stream_event\" && ev.Event.Type == \"content_block_delta\" && ev.Event.Delta != nil:\n718\t\t\t\ttext := ev.Event.Delta.Text\n719\t\t\t\tif text == \"\" {\n720\t\t\t\t\ttext = ev.Event.Delta.Thinking\n721\t\t\t\t}\n722\t\t\t\toutputTokensEstimate += len(text) / 4 // rough estimate: ~4 chars/token\n723\t\t\t\tprogress(agent.GenerationProgress{Phase: agent.PhaseGenerating, OutputTokens: outputTokensEstimate})\n724\t\t\t}\n725\t\t}\n726\t}\n727\t\n728\tfunc outputTokensFromUsage(u *messageUsage) int {\n729\t\tif u == nil {\n730\t\t\treturn 0\n731\t\t}\n732\t\treturn u.OutputTokens\n733\t}\n734\t\n735\t// looksLikeUnrecognizedFlag returns true if stderr indicates the CLI\n736\t// rejected one of the streaming-specific flags (older Claude CLI). Requires\n737\t// both a rejection phrase AND a streaming flag name to avoid false-positives\n738\t// on unrelated errors that happen to contain \"unknown option\".\n739\tfunc looksLikeUnrecognizedFlag(stderr string) bool {\n740\t\tlower := strings.ToLower(stderr)\n741\t\thasRejectPhrase := strings.Contains(lower, \"unrecognized option\") ||\n742\t\t\tstrings.Contains(lower, \"unknown flag\") ||\n743\t\t\tstrings.Contains(lower, \"unknown option\") ||\n744\t\t\tstrings.Contains(lower, \"invalid option\")\n745\t\tif !hasRejectPhrase {\n746\t\t\treturn false\n747\t\t}\n748\t\treturn strings.Contains(lower, \"stream-json\") ||\n749\t\t\tstrings.Contains(lower, \"verbose\") ||\n750\t\t\tstrings.Contains(lower, \"include-partial\")\n751\t}\n752\t```\n753\t\n754\t- [ ] **Step 2:** Run `mise run fmt && mise run lint`. Expected: clean. If the linter complains about `logging.Warn`/`logging.Debug` arguments, double-check they match existing usage in the package — grep `logging.Warn` in `cmd/entire/cli/agent/claudecode` for examples.\n755\t\n756\t### Task 3.2: Add streaming generator tests\n757\t\n758\t**Files:**\n759\t- Create: `cmd/entire/cli/agent/claudecode/generate_streaming_test.go`\n760\t\n761\t- [ ] **Step 1:** Confirm no existing fake-command helper to reuse. Run:\n762\t\n763\t```bash\n764\tgrep -rn \"func fakeCmd\\|func.*CommandRunner\\|type fakeExec\" cmd/entire/cli/agent/claudecode/*_test.go\n765\t```\n766\t\n767\tExpected (verified at plan-writing time against `origin/main`): **no matches**. If the grep returns matches that an implementer didn't expect, stop and reuse the existing helper — duplication threshold (75 tokens) would otherwise be flagged by `mise run dup`. With no matches, proceed to step 2 and introduce the new helper.\n768\t\n769\t- [ ] **Step 2:** Write the test file. `commandRunner` is a function field on `ClaudeCodeAgent` (verified in `claudecode/claude.go` and `generate.go`) — the fake builds an `*exec.Cmd` from `sh -c` so the same shape works on Linux and macOS CI runners (the project does not support Windows CI):\n770\t\n771\t```go\n772\tpackage claudecode\n773\t\n774\timport (\n775\t\t\"context\"\n776\t\t\"errors\"\n777\t\t\"os\"\n778\t\t\"os/exec\"\n779\t\t\"path/filepath\"\n780\t\t\"strings\"\n781\t\t\"testing\"\n782\t\n783\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n784\t)\n785\t\n786\tfunc TestGenerateTextStreaming_Success(t *testing.T) {\n787\t\tt.Parallel()\n788\t\n789\t\tfixture, err := os.ReadFile(filepath.Join(\"testdata\", \"stream_success.jsonl\"))\n790\t\tif err != nil {\n791\t\t\tt.Fatalf(\"read fixture: %v\", err)\n792\t\t}\n793\t\n794\t\tagentInst := &ClaudeCodeAgent{\n795\t\t\tCommandRunner: fakeStreamCmd(string(fixture), \"\", 0),\n796\t\t}\n797\t\n798\t\tvar phases []agent.ProgressPhase\n799\t\tresult, err := agentInst.GenerateTextStreaming(\n800\t\t\tcontext.Background(), \"test prompt\", \"haiku\",\n801\t\t\tfunc(p agent.GenerationProgress) {\n802\t\t\t\tphases = append(phases, p.Phase)\n803\t\t\t},\n804\t\t)\n805\t\tif err != nil {\n806\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n807\t\t}\n808\t\tif result != \"Hello, world.\" {\n809\t\t\tt.Errorf(\"result = %q, want %q\", result, \"Hello, world.\")\n810\t\t}\n811\t\t// We expect Connecting, FirstToken, Generating x2 from the stream,\n812\t\t// plus a final Done emitted by GenerateTextStreaming itself.\n813\t\twant := []agent.ProgressPhase{\n814\t\t\tagent.PhaseConnecting,\n815\t\t\tagent.PhaseFirstToken,\n816\t\t\tagent.PhaseGenerating,\n817\t\t\tagent.PhaseGenerating,\n818\t\t\tagent.PhaseDone,\n819\t\t}\n820\t\tif !equalPhases(phases, want) {\n821\t\t\tt.Errorf(\"phases = %v, want %v\", phases, want)\n822\t\t}\n823\t}\n824\t\n825\tfunc TestGenerateTextStreaming_FallbackOnUnrecognizedFlag(t *testing.T) {\n826\t\tt.Parallel()\n827\t\n828\t\t// Old CLI: exit non-zero with stderr complaining about --output-format=stream-json.\n829\t\t// Fallback path is exercised by routing the *second* call (GenerateText) to a\n830\t\t// canned non-streaming envelope.\n831\t\tstreamCall := fakeStreamCmd(\"\", \"error: unknown flag: --output-format=stream-json\", 1)\n832\t\tnonStreamCall := fakeStreamCmd(`{\"is_error\":false,\"result\":\"fallback ok\",\"subtype\":\"success\"}`, \"\", 0)\n833\t\tcalls := 0\n834\t\tagentInst := &ClaudeCodeAgent{\n835\t\t\tCommandRunner: func(ctx context.Context, name string, args ...string) *exec.Cmd {\n836\t\t\t\tcalls++\n837\t\t\t\tif calls == 1 {\n838\t\t\t\t\treturn streamCall(ctx, name, args...)\n839\t\t\t\t}\n840\t\t\t\treturn nonStreamCall(ctx, name, args...)\n841\t\t\t},\n842\t\t}\n843\t\n844\t\tresult, err := agentInst.GenerateTextStreaming(context.Background(), \"test\", \"haiku\", nil)\n845\t\tif err != nil {\n846\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n847\t\t}\n848\t\tif result != \"fallback ok\" {\n849\t\t\tt.Errorf(\"result = %q, want %q\", result, \"fallback ok\")\n850\t\t}\n851\t\tif calls != 2 {\n852\t\t\tt.Errorf(\"expected 2 subprocess invocations (streaming + fallback), got %d\", calls)\n853\t\t}\n854\t}\n855\t\n856\tfunc TestGenerateTextStreaming_EnvelopeErrorOverridesCancel(t *testing.T) {\n857\t\tt.Parallel()\n858\t\n859\t\tfixture, err := os.ReadFile(filepath.Join(\"testdata\", \"stream_error_404.jsonl\"))\n860\t\tif err != nil {\n861\t\t\tt.Fatalf(\"read fixture: %v\", err)\n862\t\t}\n863\t\n864\t\tctx, cancel := context.WithCancel(context.Background())\n865\t\tcancel() // pre-cancel\n866\t\n867\t\tagentInst := &ClaudeCodeAgent{\n868\t\t\tCommandRunner: fakeStreamCmd(string(fixture), \"\", 0),\n869\t\t}\n870\t\t_, err = agentInst.GenerateTextStreaming(ctx, \"test\", \"haiku\", nil)\n871\t\tif err == nil {\n872\t\t\tt.Fatal(\"expected error\")\n873\t\t}\n874\t\tif errors.Is(err, context.Canceled) {\n875\t\t\tt.Errorf(\"expected envelope error, got Canceled\")\n876\t\t}\n877\t\tif !strings.Contains(err.Error(), \"404\") {\n878\t\t\tt.Errorf(\"error %q should mention 404\", err)\n879\t\t}\n880\t}\n881\t\n882\tfunc equalPhases(a, b []agent.ProgressPhase) bool {\n883\t\tif len(a) != len(b) {\n884\t\t\treturn false\n885\t\t}\n886\t\tfor i := range a {\n887\t\t\tif a[i] != b[i] {\n888\t\t\t\treturn false\n889\t\t\t}\n890\t\t}\n891\t\treturn true\n892\t}\n893\t\n894\t// fakeStreamCmd returns a CommandRunner factory whose *exec.Cmd, when Start()'d\n895\t// and Wait()'d, produces stdout/stderr/exit-code as configured. Implementation\n896\t// uses 'sh -c' to write fixture data; on Windows runners we'd