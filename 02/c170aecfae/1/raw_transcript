         int           `json:\"ttft_ms,omitempty\"` // time-to-first-token; on outer stream_event envelope\n286\t\tUsage          *messageUsage `json:\"usage\"`\n287\t}\n288\t\n289\t// streamInnerEvent holds the nested \"event\" payload for type=stream_event.\n290\ttype streamInnerEvent struct {\n291\t\tType    string         `json:\"type\"` // \"message_start\" | \"content_block_delta\" | \"message_delta\" | ...\n292\t\tDelta   *streamDelta   `json:\"delta,omitempty\"`\n293\t\tMessage *streamMessage `json:\"message,omitempty\"`\n294\t}\n295\t\n296\t// streamDelta carries the content-block delta payload.\n297\ttype streamDelta struct {\n298\t\tType     string `json:\"type\"` // \"text_delta\" | \"thinking_delta\" | ...\n299\t\tText     string `json:\"text,omitempty\"`\n300\t\tThinking string `json:\"thinking,omitempty\"`\n301\t}\n302\t\n303\t// streamMessage is the partial-message payload on message_start. Only the\n304\t// usage field is currently consumed by callers; other fields are ignored.\n305\ttype streamMessage struct {\n306\t\tUsage *messageUsage `json:\"usage,omitempty\"`\n307\t}\n308\t\n309\t// streamClaudeResponse reads NDJSON-encoded events from r, invokes onEvent\n310\t// for every successfully decoded event, and returns the final result event\n311\t// once the stream ends. Malformed lines are skipped to keep the stream\n312\t// resilient against single-line corruption; the count is returned so callers\n313\t// can log schema drift even on otherwise-successful runs.\n314\tfunc streamClaudeResponse(r io.Reader, onEvent func(streamEvent)) (*streamEvent, int, error) {\n315\t\tscanner := bufio.NewScanner(r)\n316\t\tscanner.Buffer(make([]byte, 64*1024), streamBufferMax)\n317\t\tvar final *streamEvent\n318\t\tvar malformedLines int\n319\t\tfor scanner.Scan() {\n320\t\t\tline := scanner.Bytes()\n321\t\t\tif len(line) == 0 {\n322\t\t\t\tcontinue\n323\t\t\t}\n324\t\t\tvar ev streamEvent\n325\t\t\tif err := json.Unmarshal(line, &ev); err != nil {\n326\t\t\t\tmalformedLines++\n327\t\t\t\tcontinue // best-effort: skip and keep streaming\n328\t\t\t}\n329\t\t\tif onEvent != nil {\n330\t\t\t\tonEvent(ev)\n331\t\t\t}\n332\t\t\tif ev.Type == \"result\" {\n333\t\t\t\tcaptured := ev\n334\t\t\t\tfinal = &captured\n335\t\t\t}\n336\t\t}\n337\t\tif err := scanner.Err(); err != nil {\n338\t\t\treturn nil, malformedLines, fmt.Errorf(\"reading claude stream: %w\", err)\n339\t\t}\n340\t\tif final == nil {\n341\t\t\tif malformedLines > 0 {\n342\t\t\t\treturn nil, malformedLines, fmt.Errorf(\"claude stream ended without a result event (%d malformed lines skipped)\", malformedLines)\n343\t\t\t}\n344\t\t\treturn nil, 0, errors.New(\"claude stream ended without a result event\")\n345\t\t}\n346\t\treturn final, malformedLines, nil\n347\t}\n348\t```\n349\t\n350\t- [ ] **Step 3:** Search for existing definition of `messageUsage` in the `claudecode` package: `grep -rn \"type messageUsage\" cmd/entire/cli/agent/claudecode/`. If it doesn't already exist, add it to `response.go` adjacent to `streamMessage`:\n351\t\n352\t```go\n353\t// messageUsage mirrors the Claude usage block carried in message_start and\n354\t// result events. Field names match the streaming JSON output.\n355\ttype messageUsage struct {\n356\t\tInputTokens          int `json:\"input_tokens,omitempty\"`\n357\t\tOutputTokens         int `json:\"output_tokens,omitempty\"`\n358\t\tCacheReadInputTokens int `json:\"cache_read_input_tokens,omitempty\"`\n359\t}\n360\t```\n361\t\n362\t- [ ] **Step 4:** Run `mise run fmt && mise run lint`. Expected: clean.\n363\t\n364\t### Task 2.2: Add fixture data\n365\t\n366\t**Files:**\n367\t- Create: `cmd/entire/cli/agent/claudecode/testdata/stream_success.jsonl`\n368\t- Create: `cmd/entire/cli/agent/claudecode/testdata/stream_error_404.jsonl`\n369\t\n370\t- [ ] **Step 1:** Create `cmd/entire/cli/agent/claudecode/testdata/stream_success.jsonl` with this **minimal** synthetic sequence (NOT the full Claude CLI output from #964 — we want one event per phas