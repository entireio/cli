{"parentUuid":"46ce1d52-06bf-4111-9e58-04fba20e0d35","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/explain-streaming/cmd/entire/cli/agent/claudecode/generate_streaming_test.go","snippet":"1\tpackage claudecode\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t\n12\t\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n13\t)\n14\t\n15\tfunc TestGenerateTextStreaming_Success(t *testing.T) {\n16\t\tt.Parallel()\n17\t\n18\t\tfixture, err := os.ReadFile(filepath.Join(\"testdata\", \"stream_success.jsonl\"))\n19\t\tif err != nil {\n20\t\t\tt.Fatalf(\"read fixture: %v\", err)\n21\t\t}\n22\t\n23\t\tagentInst := &ClaudeCodeAgent{\n24\t\t\tCommandRunner: fakeStreamCmd(string(fixture), \"\", 0),\n25\t\t}\n26\t\n27\t\tvar phases []agent.ProgressPhase\n28\t\tresult, err := agentInst.GenerateTextStreaming(\n29\t\t\tcontext.Background(), \"test prompt\", \"haiku\",\n30\t\t\tfunc(p agent.GenerationProgress) {\n31\t\t\t\tphases = append(phases, p.Phase)\n32\t\t\t},\n33\t\t)\n34\t\tif err != nil {\n35\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n36\t\t}\n37\t\tif result != \"Hello, world.\" {\n38\t\t\tt.Errorf(\"result = %q, want %q\", result, \"Hello, world.\")\n39\t\t}\n40\t\t// We expect Connecting, FirstToken, Generating x2 from the stream,\n41\t\t// plus a final Done emitted by GenerateTextStreaming itself.\n42\t\twant := []agent.ProgressPhase{\n43\t\t\tagent.PhaseConnecting,\n44\t\t\tagent.PhaseFirstToken,\n45\t\t\tagent.PhaseGenerating,\n46\t\t\tagent.PhaseGenerating,\n47\t\t\tagent.PhaseDone,\n48\t\t}\n49\t\tif !equalPhases(phases, want) {\n50\t\t\tt.Errorf(\"phases = %v, want %v\", phases, want)\n51\t\t}\n52\t}\n53\t\n54\tfunc TestGenerateTextStreaming_FallbackOnUnrecognizedFlag(t *testing.T) {\n55\t\tt.Parallel()\n56\t\n57\t\t// Old CLI: exit non-zero with stderr complaining about --output-format=stream-json.\n58\t\t// Fallback path is exercised by routing the *second* call (GenerateText) to a\n59\t\t// canned non-streaming envelope.\n60\t\tstreamCall := fakeStreamCmd(\"\", \"error: unknown flag: --output-format=stream-json\", 1)\n61\t\tnonStreamCall := fakeStreamCmd(`{\"is_error\":false,\"result\":\"fallback ok\",\"subtype\":\"success\"}`, \"\", 0)\n62\t\tcalls := 0\n63\t\tagentInst := &ClaudeCodeAgent{\n64\t\t\tCommandRunner: func(ctx context.Context, name string, args ...string) *exec.Cmd {\n65\t\t\t\tcalls++\n66\t\t\t\tif calls == 1 {\n67\t\t\t\t\treturn streamCall(ctx, name, args...)\n68\t\t\t\t}\n69\t\t\t\treturn nonStreamCall(ctx, name, args...)\n70\t\t\t},\n71\t\t}\n72\t\n73\t\tresult, err := agentInst.GenerateTextStreaming(context.Background(), \"test\", \"haiku\", nil)\n74\t\tif err != nil {\n75\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n76\t\t}\n77\t\tif result != \"fallback ok\" {\n78\t\t\tt.Errorf(\"result = %q, want %q\", result, \"fallback ok\")\n79\t\t}\n80\t\tif calls != 2 {\n81\t\t\tt.Errorf(\"expected 2 subprocess invocations (streaming + fallback), got %d\", calls)\n82\t\t}\n83\t}\n84\t\n85\tfunc TestGenerateTextStreaming_EnvelopeErrorSurfaced(t *testing.T) {\n86\t\tt.Parallel()\n87\t\n88\t\t// Verify that an is_error envelope (e.g. HTTP 404) from the result event\n89\t\t// is surfaced as a typed error containing the API status. The production\n90\t\t// code checks envelope.IsError BEFORE checking ctx.Err(), so an envelope\n91\t\t// error wins over context cancellation if both are present — the\n92\t\t// precedence is verifiable by inspection of generate_streaming.go (the\n93\t\t// envelope check at the top of the post-Wait branch precedes the\n94\t\t// ctx.Err() check). This test exercises the envelope-error surfacing\n95\t\t// path; the precedence ordering itself is not testable here without\n96\t\t// deterministic timing control over the subprocess lifecycle.\n97\t\tfixture, err := os.ReadFile(filepath.Join(\"testdata\", \"stream_error_404.jsonl\"))\n98\t\tif err != nil {\n99\t\t\tt.Fatalf(\"read fixture: %v\", err)\n100\t\t}\n101\t\n102\t\tagentInst := &ClaudeCodeAgent{\n103\t\t\tCommandRunner: fakeStreamCmd(string(fixture), \"\", 0),\n104\t\t}\n105\t\t_, err = agentInst.GenerateTextStreaming(context.Background(), \"test\", \"haiku\", nil)\n106\t\tif err == nil {\n107\t\t\tt.Fatal(\"expected error from is_error envelope\")\n108\t\t}\n109\t\tif errors.Is(err, context.Canceled) {\n110\t\t\tt.Errorf(\"expected envelope error, got Canceled\")\n111\t\t}\n112\t\tif !strings.Contains(err.Error(), \"404\") {\n113\t\t\tt.Errorf(\"error %q should mention 404\", err)\n114\t\t}\n115\t}\n116\t\n117\tfunc equalPhases(a, b []agent.ProgressPhase) bool {\n118\t\tif len(a) != len(b) {\n119\t\t\treturn false\n120\t\t}\n121\t\tfor i := range a {\n122\t\t\tif a[i] != b[i] {\n123\t\t\t\treturn false\n124\t\t\t}\n125\t\t}\n126\t\treturn true\n127\t}\n128\t\n129\t// fakeStreamCmd returns a CommandRunner factory whose *exec.Cmd, when Start()'d\n130\t// and Wait()'d, produces stdout/stderr/exit-code as configured. Implementation\n131\t// uses 'sh -c' to write fixture data; on Windows runners we'd need PowerShell,\n132\t// but our CI is Linux/macOS.\n133\tfunc fakeStreamCmd(stdout, stderr string, exitCode int) func(ctx context.Context, name string, args ...string) *exec.Cmd {\n134\t\treturn func(ctx context.Context, _ string, _ ...string) *exec.Cmd {\n135\t\t\tscript := buildFakeShellScript(stdout, stderr, exitCode)\n136\t\t\treturn exec.CommandContext(ctx, \"sh\", \"-c\", script)\n137\t\t}\n138\t}\n139\t\n140\tfunc buildFakeShellScript(stdout, stderr string, exitCode int) string {\n141\t\tvar sb strings.Builder\n142\t\tif stdout != \"\" {\n143\t\t\tsb.WriteString(\"cat <<'__EOF__'\\n\")\n144\t\t\tsb.WriteString(stdout)\n145\t\t\tif !strings.HasSuffix(stdout, \"\\n\") {\n146\t\t\t\tsb.WriteString(\"\\n\")\n147\t\t\t}\n148\t\t\tsb.WriteString(\"__EOF__\\n\")\n149\t\t}\n150\t\tif stderr != \"\" {\n151\t\t\tsb.WriteString(\"cat <<'__EOF__' 1>&2\\n\")\n152\t\t\tsb.WriteString(stderr)\n153\t\t\tif !strings.HasSuffix(stderr, \"\\n\") {\n154\t\t\t\tsb.WriteString(\"\\n\")\n155\t\t\t}\n156\t\t\tsb.WriteString(\"__EOF__\\n\")\n157\t\t}\n158\t\tif exitCode != 0 {\n159\t\t\tsb.WriteString(\"exit \")\n160\t\t\tsb.WriteString(itoa(exitCode))\n161\t\t\tsb.WriteString(\"\\n\")\n162\t\t}\n163\t\treturn sb.String()\n164\t}\n165\t\n166\tfunc itoa(n int) string {\n167\t\tif n == 0 {\n168\t\t\treturn \"0\"\n169\t\t}\n170\t\tneg := n < 0\n171\t\tif neg {\n172\t\t\tn = -n\n173\t\t}\n174\t\tvar buf [12]byte\n175\t\ti := len(buf)\n176\t\tfor n > 0 {\n177\t\t\ti--\n178\t\t\tbuf[i] = byte('0' + n%10)\n179\t\t\tn /= 10\n180\t\t}\n181\t\tif neg {\n182\t\t\ti--\n183\t\t\tbuf[i] = '-'\n184\t\t}\n185\t\treturn string(buf[i:])\n186\t}"},"type":"attachment","uuid":"18b00436-31ca-4abb-a4b5-3443fd1142d1","timestamp":"2026-05-15T14:25:53.723Z","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/redact-2","sessionId":"4944fa51-d7dd-4310-b62f-7802a196cd45","version":"2.1.140","gitBranch":"redact-2"}
