"):\n2147\t\t\treturn FailureCategoryNetwork, \"couldn't reach provider API -- check network/VPN\"\n2148\t\tcase containsAnyLower(lower, \"unauthorized\", \"401\", \"not logged in\", \"authentication failed\", \"auth token\"):\n2149\t\t\treturn FailureCategoryAuth, \"provider rejected credentials -- re-authenticate with the provider CLI\"\n2150\t\tcase containsAnyLower(lower, \"rate limit\", \"429\", \"quota exceeded\", \"too many requests\"):\n2151\t\t\treturn FailureCategoryRateLimit, \"provider rate-limit -- wait and retry\"\n2152\t\tcase containsAnyLower(lower, \"service unavailable\", \"503\", \"502\", \"bad gateway\", \"internal server error\", \"500\"):\n2153\t\t\treturn FailureCategoryServerError, \"provider API degraded -- try again shortly\"\n2154\t\tcase containsAnyLower(lower, \"model not found\", \"invalid model\", \"unknown model\"):\n2155\t\t\treturn FailureCategoryModelNotFound, \"model rejected -- check --model flag or settings\"\n2156\t\tdefault:\n2157\t\t\treturn FailureCategoryUnknown, \"\"\n2158\t\t}\n2159\t}\n2160\t\n2161\t// containsAnyLower returns true if lower (which the caller has already\n2162\t// lowercased) contains any of the given substrings. Substrings should\n2163\t// already be lowercase.\n2164\tfunc containsAnyLower(lower string, substrings ...string) bool {\n2165\t\tfor _, s := range substrings {\n2166\t\t\tif strings.Contains(lower, s) {\n2167\t\t\t\treturn true\n2168\t\t\t}\n2169\t\t}\n2170\t\treturn false\n2171\t}\n2172\t```\n2173\t\n2174\t- [ ] **Step 2:** Write `cmd/entire/cli/summarize/classify_test.go`:\n2175\t\n2176\t```go\n2177\tpackage summarize\n2178\t\n2179\timport (\n2180\t\t\"strings\"\n2181\t\t\"testing\"\n2182\t)\n2183\t\n2184\tfunc TestClassifyStderr_Network(t *testing.T) {\n2185\t\tt.Parallel()\n2186\t\tcases := []string{\n2187\t\t\t\"dial tcp api.example.com:443: connection refused\",\n2188\t\t\t\"curl: (6) Could not resolve host: api.example.com\",\n2189\t\t\t\"network unreachable\",\n2190\t\t\t\"name or servi