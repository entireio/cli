f s.lastGenerateAt.IsZero() {\n1487\t\t\ts.lastGenerateAt = now\n1488\t\t\ts.lastGenerateTokens = p.OutputTokens\n1489\t\t\treturn true\n1490\t\t}\n1491\t\tif now.Sub(s.lastGenerateAt) >= 500*time.Millisecond {\n1492\t\t\ts.lastGenerateAt = now\n1493\t\t\ts.lastGenerateTokens = p.OutputTokens\n1494\t\t\treturn true\n1495\t\t}\n1496\t\tif s.lastGenerateTokens > 0 && p.OutputTokens >= s.lastGenerateTokens*5/4 {\n1497\t\t\ts.lastGenerateAt = now\n1498\t\t\ts.lastGenerateTokens = p.OutputTokens\n1499\t\t\treturn true\n1500\t\t}\n1501\t\treturn false\n1502\t}\n1503\t\n1504\tfunc (s *summaryProgressWriter) handle(p agent.GenerationProgress) {\n1505\t\tif s.attempt != nil {\n1506\t\t\ts.attempt.streaming = true\n1507\t\t\ts.attempt.phasesReached[p.Phase] = true\n1508\t\t}\n1509\t\n1510\t\tswitch p.Phase {\n1511\t\tcase agent.PhaseConnecting:\n1512\t\t\ts.printLine(s.arrow + \" Sending request to provider...\")\n1513\t\tcase agent.PhaseFirstToken:\n1514\t\t\ts.printLine(fmt.Sprintf(\n1515\t\t\t\t\"%s Provider responded (TTFT %s, %s cached input tokens) -- generating...\",\n1516\t\t\t\ts.arrow, formatMs(p.TTFTms), formatTokenCount(p.CachedInputTokens)))\n1517\t\tcase agent.PhaseGenerating:\n1518\t\t\tif !s.shouldEmitGenerating(p) {\n1519\t\t\t\treturn\n1520\t\t\t}\n1521\t\t\ts.updateLine(fmt.Sprintf(\n1522\t\t\t\t\"%s Writing summary... (~%s tokens)\",\n1523\t\t\t\ts.arrow, formatTokenCount(p.OutputTokens)))\n1524\t\tcase agent.PhaseDone:\n1525\t\t\ts.printLine(fmt.Sprintf(\n1526\t\t\t\t\"%s Summary generated (%s, %s output tokens)\",\n1527\t\t\t\ts.check, formatMs(p.DurationMs), formatTokenCount(p.OutputTokens)))\n1528\t\t}\n1529\t}\n1530\t\n1531\tfunc (s *summaryProgressWriter) printLine(line string) {\n1532\t\tif s.inplace && s.lastLine != \"\" {\n1533\t\t\tfmt.Fprint(s.w, \"\\r\\033[2K\")\n1534\t\t}\n1535\t\tfmt.Fprintln(s.w, line)\n1536\t\ts.lastLine = \"\"\n1537\t}\n1538\t\n1539\tfunc (s *summaryProgressWriter) updateLine(line string) {\n1540\t\tif s.lastLine == line {