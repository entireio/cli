{\n396\t\t\t\t_, _ = io.Copy(io.Discard, stdout)\n397\t\t\t\treturn \"\", nil\n398\t\t\t},\n399\t\t\tLooksLikeUnrecognizedFlag: func(stderr string) bool {\n400\t\t\t\treturn strings.Contains(stderr, \"unknown flag\") && strings.Contains(stderr, \"stream-json\")\n401\t\t\t},\n402\t\t}\n403\t\n404\t\t_, err := tmpl.Generate(context.Background(), \"prompt\", \"model\", nil)\n405\t\tif !errors.Is(err, agent.ErrUnrecognizedStreamingFlag) {\n406\t\t\tt.Errorf(\"err = %v, want ErrUnrecognizedStreamingFlag\", err)\n407\t\t}\n408\t}\n409\t\n410\tfunc TestStreamingGeneratorTemplate_Generate_NonZeroExitWrapsError(t *testing.T) {\n411\t\tt.Parallel()\n412\t\n413\t\ttmpl := &agent.StreamingGeneratorTemplate{\n414\t\t\tAgentName:   \"fake\",\n415\t\t\tDisplayName: \"fake\",\n416\t\t\tBuildCmd: func(ctx context.Context, prompt, model string) *exec.Cmd {\n417\t\t\t\treturn testutil.FakeStreamCmd(\"partial\\n\", \"boom\\n\", 1)(ctx, \"fake\", []string{}...)\n418\t\t\t},\n419\t\t\tParser: func(stdout io.Reader, progress agent.ProgressFn) (string, error) {\n420\t\t\t\t_, _ = io.Copy(io.Discard, stdout)\n421\t\t\t\treturn \"\", nil\n422\t\t\t},\n423\t\t}\n424\t\n425\t\t_, err := tmpl.Generate(context.Background(), \"prompt\", \"model\", nil)\n426\t\tvar failure *agent.TextGenerationError\n427\t\tif !errors.As(err, &failure) {\n428\t\t\tt.Fatalf(\"err = %v, want *TextGenerationError\", err)\n429\t\t}\n430\t\tif !strings.Contains(failure.Stderr, \"boom\") {\n431\t\t\tt.Errorf(\"stderr captured = %q, want substring 'boom'\", failure.Stderr)\n432\t\t}\n433\t\tif failure.StdoutBytes == 0 {\n434\t\t\tt.Errorf(\"stdoutBytes = 0, want > 0 (subprocess emitted 'partial\\\\n')\")\n435\t\t}\n436\t}\n437\t\n438\tfunc TestStreamingGeneratorTemplate_Generate_ContextCancelled(t *testing.T) {\n439\t\tt.Parallel()\n440\t\n441\t\tctx, cancel := context.WithCancel(context.Background())\n442\t\tcancel()\n443\t\n444\t\ttmpl := &agent.StreamingGeneratorTemplate{\n445\t\t\tAgentName:   \"fake\",\n446\t\t\tDis