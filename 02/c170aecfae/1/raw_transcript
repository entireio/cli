ontext.Context, _ string, _ ...string) *exec.Cmd {\n99\t\t\tscript := BuildFakeShellScript(stdout, stderr, exitCode)\n100\t\t\treturn exec.CommandContext(ctx, \"sh\", \"-c\", script)\n101\t\t}\n102\t}\n103\t\n104\t// BuildFakeShellScript renders a shell snippet that emits the given stdout,\n105\t// stderr, and exit code. Exported so callers that need a customized fake\n106\t// (e.g. multi-stage stdout) can compose against it.\n107\tfunc BuildFakeShellScript(stdout, stderr string, exitCode int) string {\n108\t\tvar sb strings.Builder\n109\t\tif stdout != \"\" {\n110\t\t\tsb.WriteString(\"cat <<'__EOF__'\\n\")\n111\t\t\tsb.WriteString(stdout)\n112\t\t\tif !strings.HasSuffix(stdout, \"\\n\") {\n113\t\t\t\tsb.WriteString(\"\\n\")\n114\t\t\t}\n115\t\t\tsb.WriteString(\"__EOF__\\n\")\n116\t\t}\n117\t\tif stderr != \"\" {\n118\t\t\tsb.WriteString(\"cat <<'__EOF__' 1>&2\\n\")\n119\t\t\tsb.WriteString(stderr)\n120\t\t\tif !strings.HasSuffix(stderr, \"\\n\") {\n121\t\t\t\tsb.WriteString(\"\\n\")\n122\t\t\t}\n123\t\t\tsb.WriteString(\"__EOF__\\n\")\n124\t\t}\n125\t\tif exitCode != 0 {\n126\t\t\tsb.WriteString(\"exit \")\n127\t\t\tsb.WriteString(strconv.Itoa(exitCode))\n128\t\t\tsb.WriteString(\"\\n\")\n129\t\t}\n130\t\treturn sb.String()\n131\t}\n132\t```\n133\t\n134\tNote: drops the `itoa` reinvention from claudecode (one of the carry-forward items from the PR #964 review).\n135\t\n136\t- [ ] **Step 3:** In `cmd/entire/cli/agent/claudecode/generate_streaming_test.go`:\n137\t  - Add import: `\"github.com/entireio/cli/cmd/entire/cli/agent/testutil\"`\n138\t  - Replace local `fakeStreamCmd(...)` calls with `testutil.FakeStreamCmd(...)`\n139\t  - Delete the local `fakeStreamCmd`, `buildFakeShellScript`, `itoa` function definitions.\n140\t\n141\t- [ ] **Step 4:** Run `mise run fmt && mise run lint`. Expected: clean.\n142\t\n143\t- [ ] **Step 5:** Run claudecode tests to confirm the migration:\n144\t\n145\t```bash\n146\tgo test ./cmd/entire/cli/agent/claudecode -run TestGenerateTextStreaming -v\n147\t```\n148\t\n149\tExpected: all 3 tests PASS.\n150\t\n151\t### Task 1.2: Add `StreamingGeneratorTemplate`\n152\t\n153\t**Files:**\n154\t- Create: `cmd/entire/cli/agent/streaming_template.go`\n155\t\n156\t- [ ] **Step 1:** Write the template:\n157\t\n158\t```go\n159\tpackage agent\n160\t\n161\timport (\n162\t\t\"bytes\"\n163\t\t\"context\"\n164\t\t\"errors\"\n165\t\t\"fmt\"\n166\t\t\"io\"\n167\t\t\"log/slog\"\n168\t\t\"os\"\n169\t\t\"os/exec\"\n170\t\t\"strings\"\n171\t\n172\t\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n173\t)\n174\t\n175\t// StreamingGeneratorTemplate is the shared subprocess-lifecycle wrapper for\n176\t// streaming text generators. Per-agent code provides BuildCmd (argv) and\n177\t// Parser (stdout → progress events); the template handles Start, drain,\n178\t// Wait, stderr capture, and error wrapping.\n179\t//\n180\t// Parallels review/types/template.ReviewerTemplate (established in PR #1192).\n181\t//\n182\t// Fields must be non-nil before Generate is called; nil values cause\n183\t// Generate to return ErrTemplateMisconfigured.\n184\ttype StreamingGeneratorTemplate struct {\n185\t\t// AgentName is an identifier used in log entries (e.g., \"codex\").\n186\t\tAgentName string\n187\t\n188\t\t// DisplayName is the user-facing CLI binary name used in *TextGenerationError\n189\t\t// wrapping (e.g., \"codex\"). Often the same as AgentName but kept separate\n190\t\t// for cases where they differ (e.g., Cursor's agent is named \"cursor\"\n191\t\t// but its binary is \"agent\").\n192\t\tDisplayName string\n193\t\n194\t\t// BuildCmd constructs the *exec.Cmd for one streaming call. Implementations\n195\t\t// MUST set cmd.Stdin to the prompt and cmd.Args to the agent's\n196\t\t// streaming-mode invocation. The template will set cmd.Dir = os.TempDir()\n197\t\t// and cmd.Env = StripGitEnv(os.Environ()) before Start.\n198\t\tBuildCmd func(ctx context.Context, prompt, model string) *exec.Cmd\n199\t\n200\t\t// Parser consumes the agent