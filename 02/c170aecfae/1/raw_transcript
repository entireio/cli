ry = \"auth\"\n\tFailureCategoryRateLimit     FailureCategory = \"rate_limit\"\n\tFailureCategoryServerError   FailureCategory = \"server_error\"\n\tFailureCategoryModelNotFound FailureCategory = \"model_not_found\"\n)\n\n// ClassifyStderr inspects captured subprocess stderr against known phrases\n// and returns a category plus a user-facing hint. Returns FailureCategoryUnknown\n// and an empty hint when no pattern matches.\n//\n// All matching is substring + case-insensitive. Phrases were selected from\n// real CLI failure output of Codex, Cursor, Copilot, and Gemini at the time\n// of writing. Patterns may rot over time as CLIs change their stderr; the\n// raw stderr is always shown to users so misclassification is recoverable.\nfunc ClassifyStderr(stderr string) (FailureCategory, string) {\n\tlower := strings.ToLower(stderr)\n\tswitch {\n\tcase containsAnyLower(lower, \"connection refused\", \"could not resolve\", \"no route to host\",\n\t\t\"network unreachable\", \"name or service not known\", \"dial tcp\"):\n\t\treturn FailureCategoryNetwork, \"couldn't reach provider API -- check network/VPN\"\n\tcase containsAnyLower(lower, \"unauthorized\", \"401\", \"not logged in\", \"authentication failed\", \"auth token\"):\n\t\treturn FailureCategoryAuth, \"provider rejected credentials -- re-authenticate with the provider CLI\"\n\tcase containsAnyLower(lower, \"rate limit\", \"429\", \"quota exceeded\", \"too many requests\"):\n\t\treturn FailureCategoryRateLimit, \"provider rate-limit -- wait and retry\"\n\tcase containsAnyLower(lower, \"service unavailable\", \"503\", \"502\", \"bad gateway\", \"internal server error\", \"500\"):\n\t\treturn FailureCategoryServerError, \"provider API degraded -- try again shortly\"\n\tcase containsAnyLower(lower, \"model not found\", \"invalid model\", \"unknown model\"):\n\t\treturn FailureCategoryModelNotFound, \"model rejected -- check --model flag or settings\"\n\tdefault:\n\t\treturn FailureCategoryUnknown, \"\"\n\t}\n}\n\n// containsAnyLower returns true if lower (which the caller has already\n// lowercased) contains any of the given substrings. Substrings should\n// already be lowercase.\nfunc containsAnyLower(lower string, substrings ...string) bool {\n\tfor _, s := range substrings {\n\t\tif strings.Contains(lower, s) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n```\n\n- [ ] **Step 2:** Write `cmd/entire/cli/summarize/classify_test.go`:\n\n```go\npackage summarize\n\nimport (\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestClassifyStderr_Network(t *testing.T) {\n\tt.Parallel()\n\tcases := []string{\n\t\t\"dial tcp api.example.com:443: connection refused\",\n\t\t\"curl: (6) Could not resolve host: api.example.com\",\n\t\t\"network unreachable\",\n\t\t\"name or service not known\",\n\t}\n\tfor _, in := range cases {\n\t\tt.Run(in, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tcat, hint := ClassifyStderr(in)\n\t\t\tif cat != FailureCategoryNetwork {\n\t\t\t\tt.Errorf(\"ClassifyStderr(%q) category = %q, want network\", in, cat)\n\t\t\t}\n\t\t\tif !strings.Contains(hint, \"reach provider API\") {\n\t\t\t\tt.Errorf(\"hint = %q, want substring 'reach provider API'\", hint)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestClassifyStderr_Auth(t *testing.T) {\n\tt.Parallel()\n\tcases := []string{\n\t\t\"HTTP 401 Unauthorized\",\n\t\t\"authentication failed: invalid token\",\n\t\t\"You are not logged in. Run `provider login` first.\",\n\t\t\"missing or invalid auth token\",\n\t}\n\tfor _, in := range cases {\n\t\tt.Run(in, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tcat, _ := ClassifyStderr(in)\n\t\t\tif cat != FailureCategoryAuth {\n\t\t\t\tt.Errorf(\"ClassifyStderr(%q) = %q, want auth\", in, cat)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestClassifyStderr_RateLimit(t *testing.T) {\n\tt.Parallel()\n\tcases := []string{\n\t\t\"HTTP 429 Too Many Requests\",\n\t\t\"rate limit exceeded for organization\",\n\t\t\"quota exceeded for project xyz\",\n\t}\n\tfor _, in := range cases {\n\t\tt.Run(in, func(t *test