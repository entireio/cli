ng(\"exit \")\n\t\tsb.WriteString(itoa(exitCode))\n\t\tsb.WriteString(\"\\n\")\n\t}\n\treturn sb.String()\n}\n\nfunc itoa(n int) string {\n\tif n == 0 {\n\t\treturn \"0\"\n\t}\n\tneg := n < 0\n\tif neg {\n\t\tn = -n\n\t}\n\tvar buf [12]byte\n\ti := len(buf)\n\tfor n > 0 {\n\t\ti--\n\t\tbuf[i] = byte('0' + n%10)\n\t\tn /= 10\n\t}\n\tif neg {\n\t\ti--\n\t\tbuf[i] = '-'\n\t}\n\treturn string(buf[i:])\n}\n```\n\nVerify:\n\n```bash\ngo test ./cmd/entire/cli/agent/claudecode -run TestGenerateTextStreaming -v 2>&1 | tail -20\n```\n\nExpected: all 3 tests PASS.\n\n```bash\ngo test ./cmd/entire/cli/agent/claudecode 2>&1 | tail -5\n```\n\nExpected: full package PASS, no regressions.\n\n### Task 3.3: Verify and commit chunk 3\n\nStep 1: Run `mise run fmt && mise run lint 2>&1 | tail -10`. **Read the literal output.** It must say `0 issues`. If you see ANY diagnostic — including new goconst warnings about repeated string literals like `\"system\"`, `\"requesting\"`, `\"stream_event\"`, `\"message_start\"`, `\"content_block_delta\"`, `\"text_delta\"` — fix by extracting constants BEFORE committing.\n\nStep 2: Run `mise run test:ci 2>&1 | tail -10`. All green.\n\nStep 3: Commit:\n\n```bash\ngit add cmd/entire/cli/agent/claudecode/generate_streaming.go cmd/entire/cli/agent/claudecode/generate_streaming_test.go\ngit commit -m \"$(cat <<'EOF'\nfeat(claudecode): implement StreamingTextGenerator\n\nClaudeCodeAgent.GenerateTextStreaming runs `claude --print --output-format\nstream-json --verbose`, pipes stdout through streamClaudeResponse, and\ndispatches per-phase agent.GenerationProgress callbacks. Falls back to\nGenerateText when stderr indicates the CLI rejected streaming flags\n(older Claude CLI builds), so callers can always assume the streaming\npath is at-worst-no-worse.\n\nEnvelope errors (is_error=true on the result event) outrank ctx-cancel\nsentinels — users get the typed auth/rate-limit/HTTP-status diagnostic\nfrom PR #963 even when ctx happens to be done.\n\nCo-Authored-B