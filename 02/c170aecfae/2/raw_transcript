ecode(&discard) == io.EOF\n784\t}\n785\t\n786\t// collectJSONLReplacements walks a parsed JSON value and collects unique\n787\t// string replacements via the supplied per-leaf redactor. JSONLContent\n788\t// passes String; the OPF-enabled flow passes a closure that combines the\n789\t// regex layers with cached batched OPF spans.\n790\tfunc collectJSONLReplacements(v any, redactor func(string) string) []jsonReplacement {\n791\t\tseen := make(map[string]bool)\n792\t\tvar repls []jsonReplacement\n793\t\tvar walk func(key string, credentialContext bool, v any)\n794\t\twalk = func(key string, credentialContext bool, v any) {\n795\t\t\tswitch val := v.(type) {\n796\t\t\tcase map[string]any:\n797\t\t\t\tif shouldSkipJSONLObject(val) {\n798\t\t\t\t\treturn\n799\t\t\t\t}\n800\t\t\t\tchildCredentialContext := credentialContext || isCredentialJSONObject(val)\n801\t\t\t\tfor k, child := range val {\n802\t\t\t\t\tif shouldSkipJSONLField(k) {\n803\t\t\t\t\t\tcontinue\n804\t\t\t\t\t}\n805\t\t\t\t\twalk(k, childCredentialContext, child)\n806\t\t\t\t}\n807\t\t\tcase []any:\n808\t\t\t\tfor _, child := range val {\n809\t\t\t\t\twalk(\"\", credentialContext, child)\n810\t\t\t\t}\n811\t\t\tcase string:\n812\t\t\t\tredacted := redactor(val)\n813\t\t\t\tif redacted == val && isCredentialJSONSecretKey(key, credentialContext) && hasNonPlaceholderPasswordValue(val) {\n814\t\t\t\t\tredacted = RedactedPlaceholder\n815\t\t\t\t}\n816\t\t\t\tif redacted != val {\n817\t\t\t\t\tseenKey := key + \"\\x00\" + val\n818\t\t\t\t\tif !seen[seenKey] {\n819\t\t\t\t\t\tseen[seenKey] = true\n820\t\t\t\t\t\trepls = append(repls, jsonReplacement{key: key, original: val, redacted: redacted})\n821\t\t\t\t\t}\n822\t\t\t\t}\n823\t\t\t}\n824\t\t}\n825\t\twalk(\"\", false, v)\n826\t\treturn repls\n827\t}\n828\t\n829\t// shouldSkipJSONLField returns true if a JSON key should be excluded from scanning/redaction.\n830\t// Skips \"signature\" (exact), ID fields (ending in \"id\"/\"ids\"), and common path/directory field