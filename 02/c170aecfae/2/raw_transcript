transcript would\n623\t// take many minutes per commit.\n624\t//\n625\t// Falls back to the plain JSONLContent flow when OPF is unconfigured, the\n626\t// breaker is tripped, no categories are enabled, or the batch call errors.\n627\tfunc JSONLContentWithPrivacyFilter(ctx context.Context, content string) (string, error) {\n628\t\tcfg := getOPFConfig()\n629\t\tif cfg == nil || !cfg.Enabled || cfg.runtime == nil || opfBreakerTripped.Load() {\n630\t\t\treturn jsonlContentImpl(content, String)\n631\t\t}\n632\t\tcats := enabledCategories(cfg)\n633\t\tif len(cats) == 0 {\n634\t\t\treturn jsonlContentImpl(content, String)\n635\t\t}\n636\t\n637\t\t// Pass 1: collect eligible (has-space, deduped) leaves. The collector\n638\t\t// closure returns identity so the JSONL walker doesn't mutate content.\n639\t\tseen := make(map[string]struct{})\n640\t\tvar inputs []string\n641\t\tif _, err := jsonlContentImpl(content, func(v string) string {\n642\t\t\tif strings.ContainsRune(v, ' ') {\n643\t\t\t\tif _, ok := seen[v]; !ok {\n644\t\t\t\t\tseen[v] = struct{}{}\n645\t\t\t\t\tinputs = append(inputs, v)\n646\t\t\t\t}\n647\t\t\t}\n648\t\t\treturn v\n649\t\t}); err != nil {\n650\t\t\treturn \"\", err\n651\t\t}\n652\t\n653\t\t// Pass 2: single batched OPF call.\n654\t\tspansByInput := make(map[string][]Span, len(inputs))\n655\t\tif len(inputs) > 0 {\n656\t\t\tfmt.Fprintln(opfStderr, \"→ OpenAI Privacy Filter: scanning transcript…\")\n657\t\t\tstart := time.Now()\n658\t\t\tbatched, err := cfg.runtime.RedactBatch(ctx, inputs, cats)\n659\t\t\tif err != nil {\n660\t\t\t\thandleOPFFailure(ctx, cfg, err)\n661\t\t\t\treturn jsonlContentImpl(content, String)\n662\t\t\t}\n663\t\t\tfmt.Fprintf(opfStderr, \"✓ OpenAI Privacy Filter: done (%.1fs)\\n\", time.Since(start).Seconds())\n664\t\t\tif len(batched) < len(inputs) {\n665\t\t\t\tslog.Warn(\"OPF runtime returned fewer span slices than inputs\",\n666\t\t\t\t\tslog.String(\"component\", \"redaction\"),\n667\t\t\t\t\tslog.Int(\"inputs\", len(inputs)),\