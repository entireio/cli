ariadb|mongodb(?:\\+srv)?|redis)://[^\\s\"'<>` + \"`\" + `]+`)\n40\t\tkeywordDSNPattern    = regexp.MustCompile(`(?i)\\b[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)(?:\\s+[a-z_][a-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|[^\\s\"']+)){2,}`)\n41\t\tsemicolonConnPattern = regexp.MustCompile(`(?i)\\b[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)(?:;[a-z][a-z0-9 _-]*=(?:\\{[^}]*\\}|\"[^\"]*\"|'[^']*'|[^=;\"'\\s]+)){2,}`)\n42\t\t// credentialValuePattern requires the prefix to start at a non-alphanumeric\n43\t\t// boundary, so APP_DB_PASSWORD matches via the leading `_` but mydbpassword\n44\t\t// does not.\n45\t\tcredentialValuePattern = regexp.MustCompile(`(?i)(?:^|[^A-Za-z0-9])(` + dbPasswordKeyShape + `)\\s*=\\s*(\"[^\"]*\"|'[^']*'|[^\\s,;&]+)`)\n46\t\n47\t\tkeywordHostPattern      = regexp.MustCompile(`(?i)(?:^|\\s)host=`)\n48\t\tkeywordUserPattern      = regexp.MustCompile(`(?i)(?:^|\\s)user=`)\n49\t\tsemicolonServerPattern  = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:server|data source|datasource|addr|address|network address)\\s*=`)\n50\t\tsemicolonUserPattern    = regexp.MustCompile(`(?i)(?:^|;)\\s*(?:user id|userid|user|uid)\\s*=`)\n51\t\tpasswordAssignmentRegex = regexp.MustCompile(`(?i)(?:^|[?&;\\s])(?:password|pwd)=(\"[^\"]*\"|'[^']*'|[^&;\\s\"']+)`)\n52\t\t// credentialJSONKeyRegex operates on output of normalizeCredentialJSONKey\n53\t\t// (already lowercased, `-`/` `/`.` → `_`), so the `(?i)` flag is unnecessary.\n54\t\tcredentialJSONKeyRegex  = regexp.MustCompile(`^` + dbPasswordKeyShape + `$`)\n55\t\tgenericPasswordKeyRegex = regexp.MustCompile(`(?i)^(?:password|passwd|pwd)$`)\n56\t)\n57\t\n58\t// entropyThreshold is the minimum Shannon entropy for a string to be considered\n59\t// a secret. 4.5 was chosen through trial and error: high enough to avoid false\n60\t// positives on common words and identifiers, low enough to catch typical API keys\n61\t// and tokens which tend to have entropy well above 5.0.\n62\tconst entropyThreshold = 4.5\n63\t\n64\t// RedactedPlaceholder is the replacement text used for redacted secrets.\n65\tconst RedactedPlaceholder = \"REDACTED\"\n66\t\n67\t// placeholderSecretValues lists lowercase values that should be treated as\n68\t// non-secrets when they appear as a credential value: prior redactions\n69\t// (REDACTED / [REDACTED] / <REDACTED>), common documentation placeholders,\n70\t// and obviously-non-real defaults. Values matched by shape (mask runs,\n71\t// `<…>` brackets, `${…}` shell expansion) are handled separately.\n72\tvar placeholderSecretValues = func() map[string]struct{} {\n73\t\tlower := strings.ToLower(RedactedPlaceholder)\n74\t\tvalues := []string{\n75\t\t\tlower, \"[\" + lower + \"]\", \"<\" + lower + \">\",\n76\t\t\t\"changeme\", \"example\", \"placeholder\",\n77\t\t\t\"your_password\", \"your_db_password\", \"your_secret\",\n78\t\t\t\"secret_here\",\n79\t\t}\n80\t\tout := make(map[string]struct{}, len(values))\n81\t\tfor _, v := range values {\n82\t\t\tout[v] = struct{}{}\n83\t\t}\n84\t\treturn out\n85\t}()\n86\t\n87\t// RedactedBytes represents transcript data that has been through secret\n88\t// redaction. Consumers that require pre-redacted input (e.g., compact.Compact,\n89\t// checkpoint stores) accept this type to enforce the contract at compile time.\n90\t//\n91\t// Produced by JSONLBytes (primary constructor) or trusted wrappers for data\n92\t// previously persisted by checkpoint writers.\n93\ttype RedactedBytes struct {\n94\t\tdata []byte\n95\t}\n96\t\n97\t// Bytes returns the underlying byte slice.\n98\tfunc (r RedactedBytes) Bytes() []byte {\n99\t\treturn r.data\n100\t}\n101\t\n102\t// Len returns the number of bytes in the redacted payload.\n103\tfunc (r RedactedBytes) Len() int {\n104\t\treturn len(r.data)\n105\t}\n106\t\n107\t// AlreadyRedacted wraps transcript bytes known to already be redacted by a\n108\t// prior write path. Use this ONLY for trusted sources such as persisted\n109\t// checkpoint transcripts or controlled test fixtures. For fresh transcript\n110\t// input, use JSONLBytes.\n111\tfunc AlreadyRedacted(data []byte) RedactedBytes {\n112\t\treturn RedactedBytes{data: data}\n113\t}\n114\t\n115\tvar (\n116\t\tbetterleaksDetector     *detect.Detector\n117\t\tbetterleaksDetectorOnce sync.Once\n118\t)\n119\t\n120\tfunc getDetector() *detect.Detector {\n121\t\tbetterleaksDetectorOnce.Do(func() {\n122\t\t\td, err := detect.NewDetectorDefaultConfig()\n123\t\t\tif err != nil {\n124\t\t\t\treturn\n125\t\t\t}\n126\t\t\tbetterleaksDetector = d\n127\t\t})\n128\t\treturn betterleaksDetector\n129\t}\n130\t\n131\t// region represents a byte range to redact.\n132\ttype region struct{ start, end int }\n133\t\n134\t// taggedRegion extends region with a label for typed replacement tokens.\n135\t// Empty label = secret (produces \"REDACTED\"). Non-empty = PII (produces \"[REDACTED_<LABEL>]\").\n136\ttype taggedRegion struct {\n137\t\tregion\n138\t\n139\t\tlabel string\n140\t}\n141\t\n142\ttype jsonReplacement struct {\n143\t\tkey      string\n144\t\toriginal string\n145\t\tredacted string\n146\t}\n147\t\n148\ttype connectionStringRule struct {\n149\t\tpattern   *regexp.Regexp\n150\t\thasSecret func(string) bool\n151\t}\n152\t\n153\tvar connectionStringRules = []connectionStringRule{\n154\t\t{pattern: jdbcPattern, hasSecret: hasJDBCPassword},\n155\t\t{pattern: databaseURLPattern, hasSecret: hasDatabaseURLSecret},\n156\t\t{pattern: keywordDSNPattern, hasSecret: hasKeywordDSNPassword},\n157\t\t{pattern: semicolonConnPattern, hasSecret: hasSemicolonConnectionPassword},\n158\t}\n159\t\n160\t// String replaces secrets and PII in s using layered detection:\n161\t// 1. Entropy-based: high-entropy alphanumeric sequences (threshold 4.5)\n162\t// 2. Pattern-based: betterleaks regex rules (260+ known secret formats)\n163\t// 3. Credentialed URIs: URLs containing userinfo passwords\n164\t// 4. Database connection strings: JDBC, keyword DSNs, and semicolon strings\n165\t// 5. User-defined custom rules: configured via ConfigureCustomRules\n166\t// 6. Bounded credential key/value pairs: DB_PASSWORD=...\n167\t// 7. PII detection: email, phone, address patterns (only when configured via ConfigurePII)\n168\t// A string is redacted if ANY method flags it.\n169\tfunc String(s string) string {\n170\t\treturn applyRegions(s, detectAllLayers(s))\n171\t}\n172\t\n173\t// detectAllLayers runs the seven always-on/opt-in regex-based redaction\n174\t// layers and returns their tagged regions. The OpenAI Privacy Filter\n175\t// (layer 8) is NOT included — callers that want it append detectOPF spans\n176\t// to the result before passing to applyRegions. See StringWithPrivacyFilter\n177\t// for the augmented flow.\n178\tfunc detectAllLayers(s string) []taggedRegion {\n179\t\tvar regions []taggedRegion\n180\t\n181\t\t// 1. Entropy-based detection (secrets — always on).\n182\t\tfor _, loc := range secretPattern.FindAllStringIndex(s, -1) {\n183\t\t\tstart, end := loc[0], loc[1]\n184\t\n185\t\t\t// Don't consume characters that are part of JSON/string escape sequences.\n186\t\t\t// Example: in \"controller.go\\nmodel.go\", the regex could match \"nmodel\"\n187\t\t\t// (consuming the 'n' from '\\n'), and after replacement the '\\' would be\n188\t\t\t// followed by 'R' from \"REDACTED\", creating invalid escape '\\R'.\n189\t\t\t// Only skip for known JSON escape letters to avoid trimming real secrets\n190\t\t\t// that happen to follow a literal backslash in decoded content.\n191\t\t\tif start > 0 && s[start-1] == '\\\\' {\n192\t\t\t\tswitch s[start] {\n193\t\t\t\tcase 'n', 't', 'r', 'b', 'f', 'u', '\"', '\\\\', '/':\n194\t\t\t\t\tstart++\n195\t\t\t\t\tif end-start < 10 {\n196\t\t\t\t\t\tcontinue\n197\t\t\t\t\t}\n198\t\t\t\t}\n199\t\t\t}\n200\t\n201\t\t\tif shannonEntropy(s[start:end]) > entropyThreshold {\n202\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n203\t\t\t}\n204\t\t}\n205\t\n206\t\t// 2. Pattern-based detection via betterleaks (secrets — always on).\n207\t\tif d := getDetector(); d != nil {\n208\t\t\tfor _, f := range d.DetectString(s) {\n209\t\t\t\tif f.Secret == \"\" {\n210\t\t\t\t\tcontinue\n211\t\t\t\t}\n212\t\t\t\tsearchFrom := 0\n213\t\t\t\tfor {\n214\t\t\t\t\tidx := strings.Index(s[searchFrom:], f.Secret)\n215\t\t\t\t\tif idx < 0 {\n216\t\t\t\t\t\tbreak\n217\t\t\t\t\t}\n218\t\t\t\t\tabsIdx := searchFrom + idx\n219\t\t\t\t\tregions = append(regions, taggedRegion{region: region{absIdx, absIdx + len(f.Secret)}})\n220\t\t\t\t\tsearchFrom = absIdx + len(f.Secret)\n221\t\t\t\t}\n222\t\t\t}\n223\t\t}\n224\t\n225\t\t// 3. Credentialed URIs (secrets — always on).\n226\t\tfor _, loc := range credentialedURIPattern.FindAllStringIndex(s, -1) {\n227\t\t\tregions = append(regions, taggedRegion{region: region{loc[0], loc[1]}})\n228\t\t}\n229\t\n230\t\t// 4. Database and connection-string detection (secrets — always on).\n231\t\tregions = append(regions, detectConnectionStrings(s)...)\n232\t\n233\t\t// 5. User-defined custom rules (secrets — only runs when configured).\n234\t\tregions = append(regions, detectCustomRules(getCustomRulesConfig(), s)...)\n235\t\n236\t\t// 6. Bounded credential key/value detection (secrets — always on).\n237\t\tregions = append(regions, detectCredentialValues(s)...)\n238\t\n239\t\t// 7. PII detection (opt-in — only runs when configured).\n240\t\tregions = append(regions, detectPII(getPIIConfig(), s)...)\n241\t\n242\t\treturn regions\n243\t}\n244\t\n245\t// applyRegions sorts, merges, and replaces the given regions in s, returning\n246\t// the redacted string. Returns s unchanged when regions is empty.\n247\tfunc applyRegions(s string, regions []taggedRegion) string {\n248\t\tif len(regions) == 0 {\n249\t\t\treturn s\n250\t\t}\n251\t\n252\t\tsort.Slice(regions, func(i, j int) bool {\n253\t\t\tif regions[i].start != regions[j].start {\n254\t\t\t\treturn regions[i].start < regions[j].start\n255\t\t\t}\n256\t\t\tif regions[i].end != regions[j].end {\n257\t\t\t\treturn regions[i].end > regions[j].end // larger region first\n258\t\t\t}\n259\t\t\treturn regions[i].label < regions[j].label // deterministic tie-break\n260\t\t})\n261\t\tmerged := []taggedRegion{regions[0]}\n262\t\tfor _, r := range regions[1:] {\n263\t\t\tlast := &merged[len(merged)-1]\n264\t\t\tif r.start <= last.end {\n265\t\t\t\tif r.end > last.end {\n266\t\t\t\t\tlast.end = r.end\n267\t\t\t\t}\n268\t\t\t\t// Keep the existing label (first/larger region wins)\n269\t\t\t} else {\n270\t\t\t\tmerged = append(merged, r)\n271\t\t\t}\n272\t\t}\n273\t\n274\t\tvar b strings.Builder\n275\t\tprev := 0\n276\t\tfor _, r := range merged {\n277\t\t\tb.WriteString(s[prev:r.start])\n278\t\t\tb.WriteString(replacementToken(r.label))\n279\t\t\tprev = r.end\n280\t\t}\n281\t\tb.WriteString(s[prev:])\n282\t\treturn b.String()\n283\t}\n284\t\n285\tfunc detectConnectionStrings(s string) []taggedRegion {\n286\t\tif !strings.ContainsRune(s, '=') {\n287\t\t\treturn nil\n288\t\t}\n289\t\tvar regions []taggedRegion\n290\t\tfor _, rule := range connectionStringRules {\n291\t\t\tregions = append(regions, detectConnectionStringRule(s, rule)...)\n292\t\t}\n293\t\treturn regions\n294\t}\n295\t\n296\tfunc detectConnectionStringRule(s string, rule connectionStringRule) []taggedRegion {\n297\t\tvar regions []taggedRegion\n298\t\tfor _, loc := range rule.pattern.FindAllStringIndex(s, -1) {\n299\t\t\tstart, end := loc[0], trimConnectionStringEnd(s, loc[0], loc[1])\n300\t\t\tif start >= end {\n301\t\t\t\tcontinue\n302\t\t\t}\n303\t\t\tif rule.hasSecret(s[start:end]) {\n304\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n305\t\t\t}\n306\t\t}\n307\t\treturn regions\n308\t}\n309\t\n310\tfunc trimConnectionStringEnd(s string, start, end int) int {\n311\t\tfor end > start {\n312\t\t\tswitch s[end-1] {\n313\t\t\tcase '.', ',', ';', ':', '!', '?', ')', ']':\n314\t\t\t\tend--\n315\t\t\tdefault:\n316\t\t\t\treturn end\n317\t\t\t}\n318\t\t}\n319\t\treturn end\n320\t}\n321\t\n322\tfunc hasJDBCPassword(candidate string) bool {\n323\t\tif !strings.HasPrefix(strings.ToLower(candidate), \"jdbc:\") {\n324\t\t\treturn false\n325\t\t}\n326\t\treturn hasNonPlaceholderPasswordAssignment(candidate)\n327\t}\n328\t\n329\tfunc hasDatabaseURLSecret(candidate string) bool {\n330\t\tu, err := url.Parse(candidate)\n331\t\tif err != nil || u.Scheme == \"\" || u.Host == \"\" {\n332\t\t\treturn false\n333\t\t}\n334\t\tfor key, values := range u.Query() {\n335\t\t\tif !isPasswordQueryKey(key) {\n336\t\t\t\tcontinue\n337\t\t\t}\n338\t\t\tfor _, value := range values {\n339\t\t\t\tif hasNonPlaceholderPasswordValue(value) {\n340\t\t\t\t\treturn true\n341\t\t\t\t}\n342\t\t\t}\n343\t\t}\n344\t\treturn false\n345\t}\n346\t\n347\tfunc isPasswordQueryKey(key string) bool {\n348\t\treturn strings.EqualFold(key, \"password\") || strings.EqualFold(key, \"pwd\")\n349\t}\n350\t\n351\tfunc hasKeywordDSNPassword(candidate string) bool {\n352\t\treturn keywordHostPattern.MatchString(candidate) &&\n353\t\t\tkeywordUserPattern.MatchString(candidate) &&\n354\t\t\thasNonPlaceholderPasswordAssignment(candidate)\n355\t}\n356\t\n357\tfunc hasSemicolonConnectionPassword(candidate string) bool {\n358\t\treturn semicolonServerPattern.MatchString(candidate) &&\n359\t\t\tsemicolonUserPattern.MatchString(candidate) &&\n360\t\t\thasNonPlaceholderPasswordAssignment(candidate)\n361\t}\n362\t\n363\tfunc detectCredentialValues(s string) []taggedRegion {\n364\t\tvar regions []taggedRegion\n365\t\tfor _, loc := range credentialValuePattern.FindAllStringSubmatchIndex(s, -1) {\n366\t\t\tif len(loc) < 6 || loc[4] < 0 || loc[5] < 0 {\n367\t\t\t\tcontinue\n368\t\t\t}\n369\t\t\tstart, end := unquoteRange(s, loc[4], loc[5])\n370\t\t\tif hasNonPlaceholderPasswordValue(s[start:end]) {\n371\t\t\t\tregions = append(regions, taggedRegion{region: region{start, end}})\n372\t\t\t}\n373\t\t}\n374\t\treturn regions\n375\t}\n376\t\n377\tfunc unquoteRange(s string, start, end int) (int, int) {\n378\t\tif end-start < 2 {\n379\t\t\treturn start, end\n380\t\t}\n381\t\tfirst, last := s[start], s[end-1]\n382\t\tif (first == '\"' && last == '\"') || (first == '\\'' && last == '\\'') {\n383\t\t\treturn start + 1, end - 1\n384\t\t}\n385\t\treturn start, end\n386\t}\n387\t\n388\tfunc hasNonPlaceholderPasswordAssignment(candidate string) bool {\n389\t\tfor _, loc := range passwordAssignmentRegex.FindAllStringSubmatchIndex(candidate, -1) {\n390\t\t\tif len(loc) >= 4 && loc[2] >= 0 && loc[3] >= 0 {\n391\t\t\t\tstart, end := unquoteRange(candidate, loc[2], loc[3])\n392\t\t\t\tif hasNonPlaceholderPasswordValue(candidate[start:end]) {\n393\t\t\t\t\treturn true\n394\t\t\t\t}\n395\t\t\t}\n396\t\t}\n397\t\treturn false\n398\t}\n399\t\n400\tfunc hasNonPlaceholderPasswordValue(value string) bool {\n401\t\treturn value != \"\" && !isPlaceholderSecretValue(value)\n402\t}\n403\t\n404\tfunc isPlaceholderSecretValue(value string) bool {\n405\t\ttrimmed := strings.Trim(strings.TrimSpace(value), `\"'`)\n406\t\tif trimmed == \"\" {\n407\t\t\treturn true\n408\t\t}\n409\t\tif isBracketedPlaceholder(trimmed) {\n410\t\t\treturn true\n411\t\t}\n412\t\tnormalized := strings.ToLower(trimmed)\n413\t\tif strings.HasPrefix(normalized, \"${\") && strings.HasSuffix(normalized, \"}\") {\n414\t\t\treturn true\n415\t\t}\n416\t\tif _, ok := placeholderSecretValues[normalized]; ok {\n417\t\t\treturn true\n418\t\t}\n419\t\treturn isRepeatedCharPlaceholder(normalized)\n420\t}\n421\t\n422\t// bracketedPlaceholderInteriorRE matches the inside of a \"<…>\" placeholder\n423\t// shape: lowercase letters joined by `-` or `_`. Digits, mixed case, and\n424\t// special chars are rejected so values like `<hunter2>` or `<RealPassword>`\n425\t// still fall through to redaction.\n426\tvar bracketedPlaceholderInteriorRE = regexp.MustCompile(`^[a-z][a-z_-]*$`)\n427\t\n428\t// isBracketedPlaceholder reports whether s is a \"<name>\" doc placeholder\n429\t// (e.g. \"<password>\", \"<your-db-password>\"). The minimum total length of 5\n430\t// keeps this from firing on `<a>` / `<ab>`.\n431\tfunc isBracketedPlaceholder(s string) bool {\n432\t\tif len(s) < 5 || s[0] != '<' || s[len(s)-1] != '>' {\n433\t\t\treturn false\n434\t\t}\n435\t\treturn bracketedPlaceholderInteriorRE.MatchString(s[1 : len(s)-1])\n436\t}\n437\t\n438\t// isRepeatedCharPlaceholder reports whether s is a run of a single masking\n439\t// character commonly used to redact values in docs and screenshots, e.g.\n440\t// \"***\", \"xxxx\", \"....\", \"----\". The minimum length of 3 keeps single-char\n441\t// or 2-char values like `x` or `**` from being treated as masks.\n442\tfunc isRepeatedCharPlaceholder(s string) bool {\n443\t\tif len(s) < 3 {\n444\t\t\treturn false\n445\t\t}\n446\t\tfirst := s[0]\n447\t\tswitch first {\n448\t\tcase '*', 'x', '.', '-':\n449\t\tdefault:\n450\t\t\treturn false\n451\t\t}\n452\t\tfor i := 1; i < len(s); i++ {\n453\t\t\tif s[i] != first {\n454\t\t\t\treturn false\n455\t\t\t}\n456\t\t}\n457\t\treturn true\n458\t}\n459\t\n460\tfunc isCredentialJSONSecretKey(key string, credentialContext bool) bool {\n461\t\tnormalized := normalizeCredentialJSONKey(key)\n462\t\tif credentialJSONKeyRegex.MatchString(normalized) {\n463\t\t\treturn true\n464\t\t}\n465\t\treturn credentialContext && genericPasswordKeyRegex.MatchString(normalized)\n466\t}\n467\t\n468\tfunc isCredentialJSONObject(obj map[string]any) bool {\n469\t\tvar hasHost, hasUser bool\n470\t\tfor key := range obj {\n471\t\t\tswitch normalizeCredentialJSONKey(key) {\n472\t\t\tcase \"host\", \"hostname\", \"server\", \"addr\", \"address\", \"datasource\", \"data_source\":\n473\t\t\t\thasHost = true\n474\t\t\tcase \"user\", \"username\", \"userid\", \"user_id\", \"uid\":\n475\t\t\t\thasUser = true\n476\t\t\t}\n477\t\t\tif hasHost && hasUser {\n478\t\t\t\treturn true\n479\t\t\t}\n480\t\t}\n481\t\treturn false\n482\t}\n483\t\n484\tfunc normalizeCredentialJSONKey(key string) string {\n485\t\tkey = strings.ToLower(strings.TrimSpace(key))\n486\t\tkey = strings.ReplaceAll(key, \"-\", \"_\")\n487\t\tkey = strings.ReplaceAll(key, \" \", \"_\")\n488\t\t// Flattened-config exporters (Spring, dotnet, Hashicorp Vault) emit dotted keys\n489\t\t// like \"db.password\" or \"mysql.root.password\"; treat them like underscored.\n490\t\tkey = strings.ReplaceAll(key, \".\", \"_\")\n491\t\treturn key\n492\t}\n493\t\n494\t// Bytes is a convenience wrapper around String for []byte content.\n495\tfunc Bytes(b []byte) []byte {\n496\t\ts := string(b)\n497\t\tredacted := String(s)\n498\t\tif redacted == s {\n499\t\t\treturn b\n500\t\t}\n501\t\treturn []byte(redacted)\n502\t}\n503\t\n504\t// JSONLBytes redacts secrets in JSONL-formatted byte content and returns\n505\t// the result as RedactedBytes, certifying the output has been through redaction.\n506\tfunc JSONLBytes(b []byte) (RedactedBytes, error) {\n507\t\ts := string(b)\n508\t\tredacted, err := JSONLContent(s)\n509\t\tif err != nil {\n510\t\t\treturn RedactedBytes{}, err\n511\t\t}\n512\t\tif redacted == s {\n513\t\t\treturn RedactedBytes{data: b}, nil\n514\t\t}\n515\t\treturn RedactedBytes{data: []byte(redacted)}, nil\n516\t}\n517\t\n518\t// JSONLBytesWithPrivacyFilter augments JSONLBytes with the OpenAI Privacy\n519\t// Filter. Use only at condensation/export boundaries; per-turn writes must\n520\t// use JSONLBytes.\n521\tfunc JSONLBytesWithPrivacyFilter(ctx context.Context, b []byte) (RedactedBytes, error) {\n522\t\ts := string(b)\n523\t\tredacted, err := JSONLContentWithPrivacyFilter(ctx, s)\n524\t\tif err != nil {\n525\t\t\treturn RedactedBytes{}, err\n526\t\t}\n527\t\tif redacted == s {\n528\t\t\treturn RedactedBytes{data: b}, nil\n529\t\t}\n530\t\treturn RedactedBytes{data: []byte(redacted)}, nil\n531\t}\n532\t\n533\t// BytesWithPrivacyFilter augments Bytes with the OpenAI Privacy Filter for\n534\t// raw (non-JSONL) byte content. Used by checkpoint write paths that handle\n535\t// metadata files which may or may not be JSONL.\n536\tfunc BytesWithPrivacyFilter(ctx context.Context, b []byte) []byte {\n537\t\ts := string(b)\n538\t\tredacted := StringWithPrivacyFilter(ctx, s)\n539\t\tif redacted == s {\n540\t\t\treturn b\n541\t\t}\n542\t\treturn []byte(redacted)\n543\t}\n544\t\n545\t// JSONLContent parses each line as JSON to determine which string values\n546\t// need redaction, then performs targeted replacements on the raw JSON bytes.\n547\t// Lines with no secrets are returned unchanged, preserving original formatting.\n548\t//\n549\t// For multi-line JSON content (e.g., pretty-printed single JSON objects like\n550\t// OpenCode export), the function first attempts to parse the entire content as\n551\t// a single JSON value. This ensures field-aware redaction (which skips ID fields)\n552\t// is used instead of falling back to entropy-based detection on raw text lines,\n553\t// which would corrupt high-entropy identifiers.\n554\tfunc JSONLContent(content string) (string, error) {\n555\t\treturn jsonlContentImpl(content, String)\n556\t}\n557\t\n558\t// jsonlContentImpl is the body of JSONLContent parameterized by a per-leaf\n559\t// redactor. JSONLContent passes String (regex layers only). The OPF-enabled\n560\t// flow uses two passes: one with a collector that records leaves and returns\n561\t// identity, one with a redactor that combines regex layers with cached OPF\n562\t// spans for the recorded leaves.\n563\tfunc jsonlContentImpl(content string, redactor func(string) string) (string, error) {\n564\t\t// Try parsing the entire content as a single JSON value first.\n565\t\t// Uses a streaming decoder to avoid copying the full content into []byte.\n566\t\t// After decoding, attempts a second Decode to confirm EOF — if it succeeds,\n567\t\t// the content is JSONL (multiple values) and we fall through to line-by-line.\n568\t\ttrimmed := strings.TrimSpace(content)\n569\t\tif len(trimmed) > 0 {\n570\t\t\tdec := json.NewDecoder(strings.NewReader(trimmed))\n571\t\t\tvar parsed any\n572\t\t\tif err := dec.Decode(&parsed); err == nil && isSingleJSONValue(dec) {\n573\t\t\t\t// Content is a single JSON value (object/array)