Call once at process startup after loading\n51\t// settings. Thread-safe. Subsequent calls replace the previous configuration\n52\t// and reset the circuit breaker (a new config might fix what broke the prior\n53\t// one).\n54\tfunc ConfigurePrivacyFilter(cfg OPFConfig) {\n55\t\tcfgCopy := cfg\n56\t\tif cfgCopy.Timeout <= 0 {\n57\t\t\tcfgCopy.Timeout = 30\n58\t\t}\n59\t\tif cfgCopy.Command == \"\" {\n60\t\t\tcfgCopy.Command = \"opf\"\n61\t\t}\n62\t\tcfgCopy.runtime = newShellOut(cfgCopy.Command, cfgCopy.Timeout)\n63\t\topfConfigMu.Lock()\n64\t\topfConfig = &cfgCopy\n65\t\topfConfigMu.Unlock()\n66\t\topfBreakerTripped.Store(false)\n67\t}\n68\t\n69\t// ConfigurePrivacyFilterWithRuntime is the test-only variant that takes an\n70\t// explicit runtime instead of constructing one.\n71\tfunc ConfigurePrivacyFilterWithRuntime(cfg OPFConfig, rt opfRuntime) {\n72\t\tcfgCopy := cfg\n73\t\tif cfgCopy.Timeout <= 0 {\n74\t\t\tcfgCopy.Timeout = 30\n75\t\t}\n76\t\tcfgCopy.runtime = rt\n77\t\topfConfigMu.Lock()\n78\t\topfConfig = &cfgCopy\n79\t\topfConfigMu.Unlock()\n80\t\topfBreakerTripped.Store(false)\n81\t}\n82\t\n83\tfunc getOPFConfig() *OPFConfig {\n84\t\topfConfigMu.RLock()\n85\t\tdefer opfConfigMu.RUnlock()\n86\t\treturn opfConfig\n87\t}\n88\t\n89\t// GetOPFConfigForTest returns the current OPF configuration, or nil if\n90\t// never configured. The \"ForTest\" suffix signals test-only intent — callers\n91\t// must be limited to test files in other packages.\n92\tfunc GetOPFConfigForTest() *OPFConfig {\n93\t\treturn getOPFConfig()\n94\t}\n95\t\n96\t// ResetOPFConfigForTest clears configuration and the circuit breaker. Used\n97\t// by tests in other packages to return to a \"never configured\" state.\n98\tfunc ResetOPFConfigForTest() {\n99\t\tresetOPFConfig()\n100\t}\n101\t\n102\tfunc resetOPFConfig() {\n103\t\topfConfigMu.Lock()\n104\t\topfConfig = nil\n105\t\topfConfigMu.Unlock()\n106\t\topfBreakerTripped.Store(false)\n107\t}\n108\t\n109\t// opfLabelMap maps OPF native labels