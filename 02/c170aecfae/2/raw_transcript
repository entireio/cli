NoError(t, err)\n\n\t// Move local v1 ref to point at the applied commit (simulating a\n\t// commit that's already been rewritten by a prior push attempt).\n\tref := plumbing.NewHashReference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), appliedHash)\n\trequire.NoError(t, repo.Storer.SetReference(ref))\n\n\t// Now call rewrite — should reparent the applied commit (since\n\t// no remote ref exists, this is \"bootstrap\" and the commit is\n\t// unpushed by definition).\n\tnewTip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\n\tnewCommit, err := repo.CommitObject(newTip)\n\trequire.NoError(t, err)\n\n\t// The trailer should appear exactly once.\n\toccurrences := strings.Count(newCommit.Message, trailers.OPFAppliedTrailerKey+\": \"+trailers.OPFAppliedTrailerValue)\n\tif occurrences != 1 {\n\t\tt.Errorf(\"expected exactly 1 OPF-Applied trailer, got %d:\\n%s\", occurrences, newCommit.Message)\n\t}\n\n\t// Tree should be preserved verbatim (already-applied path).\n\tif newCommit.TreeHash != appliedCommit.TreeHash {\n\t\tt.Errorf(\"re-parented applied commit has different tree: got %s, want %s\",\n\t\t\tnewCommit.TreeHash.String()[:7], appliedCommit.TreeHash.String()[:7])\n\t}\n}","new_string":"// REDACTED\n// covers the idempotency contract: re-running the rewrite on an\n// already-applied tip must NOT add a second Entire-OPF-Applied trailer\n// (the rebuilt commit keeps the trailer it already has), AND the tree\n// hash MUST be preserved verbatim (no re-redaction of already-redacted\n// content).\n//\n// We exercise the production path twice rather than synthesizing an\n// applied commit by hand: the first run produces a v1 commit with the\n// trailer; the second run sees the trailer and should re-parent only\n// (no tree changes, no trailer duplication).\nfunc REDACTED(t *testing.T) {\n\tredact.ResetOPFConfigForTest()\n\tt.Cleanup(redact.ResetOPFConfigForTest)\n\tredact.ConfigurePrivacyFilterWithRuntime(redact.OPFConfig{\n\t\tEnabled:    true,\n\t\tCategories: map[string]bool{\"private_person\": true},\n\t}, &fakeOPFForRewrite{})\n\n\trepo, _ := setupV1Repo(t)\n\n\t// First run: produces a commit with the OPF-Applied trailer.\n\tfirstTip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\tfirstCommit, err := repo.CommitObject(firstTip)\n\trequire.NoError(t, err)\n\trequire.True(t, trailers.HasOPFApplied(firstCommit.Message),\n\t\t\"first run should have produced an applied commit\")\n\tfirstTreeHash := firstCommit.TreeHash\n\n\t// Second run on the same local tip with no remote ref yet (still\n\t// bootstrap; the first-run commit is \"unpushed\" since we never\n\t// pushed it). The rewrite should see HasOPFApplied=true on the\n\t// commit and take the re-parent-only path.\n\tsecondTip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\n\tsecondCommit, err := repo.CommitObject(secondTip)\n\trequire.NoError(t, err)\n\n\t// Trailer must appear exactly once.\n\texpectedTrailer := trailers.OPFAppliedTrailerKey + \": \" + trailers.OPFAppliedTrailerValue\n\toccurrences := strings.Count(secondCommit.Message, expectedTrailer)\n\tif occurrences != 1 {\n\t\tt.Errorf(\"expected exactly 1 %q trailer, got %d:\\n%s\",\n\t\t\texpectedTrailer, occurrences, secondCommit.Message)\n\t}\n\n\t// Tree hash must be preserved (no re-redaction).\n\tif secondCommit.TreeHash != firstTreeHash {\n\t\tt.Errorf(\"re-parented applied commit has different tree: got %s, want %s\",\n\t\t\tsecondCommit.TreeHash.String()[:7], firstTreeHash.String()[:7])\n\t}\n}"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2914,"cache_read_input_tokens":433333,"output_tokens":3583,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tok