rst run produces a v1 commit with the\n// trailer; the second run sees the trailer and should re-parent only\n// (no tree changes, no trailer duplication).\nfunc REDACTED(t *testing.T) {\n\tredact.ResetOPFConfigForTest()\n\tt.Cleanup(redact.ResetOPFConfigForTest)\n\tredact.ConfigurePrivacyFilterWithRuntime(redact.OPFConfig{\n\t\tEnabled:    true,\n\t\tCategories: map[string]bool{\"private_person\": true},\n\t}, &fakeOPFForRewrite{})\n\n\trepo, _ := setupV1Repo(t)\n\n\t// First run: produces a commit with the OPF-Applied trailer.\n\tfirstTip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\tfirstCommit, err := repo.CommitObject(firstTip)\n\trequire.NoError(t, err)\n\trequire.True(t, trailers.HasOPFApplied(firstCommit.Message),\n\t\t\"first run should have produced an applied commit\")\n\tfirstTreeHash := firstCommit.TreeHash\n\n\t// Second run on the same local tip with no remote ref yet (still\n\t// bootstrap; the first-run commit is \"unpushed\" since we never\n\t// pushed it). The rewrite should see HasOPFApplied=true on the\n\t// commit and take the re-parent-only path.\n\tsecondTip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\n\tsecondCommit, err := repo.CommitObject(secondTip)\n\trequire.NoError(t, err)\n\n\t// Trailer must appear exactly once.\n\texpectedTrailer := trailers.OPFAppliedTrailerKey + \": \" + trailers.OPFAppliedTrailerValue\n\toccurrences := strings.Count(secondCommit.Message, expectedTrailer)\n\tif occurrences != 1 {\n\t\tt.Errorf(\"expected exactly 1 %q trailer, got %d:\\n%s\",\n\t\t\texpectedTrailer, occurrences, secondCommit.Message)\n\t}\n\n\t// Tree hash must be preserved (no re-redaction).\n\tif secondCommit.TreeHash != firstTreeHash {\n\t\tt.Errorf(\"re-parented applied commit has different tree: got %s, want %s\",\n\t\t\tsecondCommit.TreeHash.String()[:7], firstTreeHash.String()[:7])\n\t}\n}","originalFile":"package strategy\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/testutil\"\n\t\"github.com/entireio/cli/cmd/entire/cli/trailers\"\n\t\"github.com/entireio/cli/redact\"\n\t\"github.com/go-git/go-git/v6\"\n\t\"github.com/go-git/go-git/v6/plumbing\"\n\t\"github.com/go-git/go-git/v6/plumbing/object\"\n\t\"github.com/stretchr/testify/require\"\n)\n\n// fakeOPFForRewrite is the test double used by rewrite tests. It tags any\n// occurrence of the literal \"PERSONABC\" in the input as a private_person\n// span so we can assert OPF actually ran over a commit's blobs after the\n// rewrite. Implementations of opfRuntime must be safe for concurrent use.\n//\n// We use a sentinel substring rather than relying on real OPF inference\n// because the rewrite tests should be deterministic and offline.\ntype fakeOPFForRewrite struct{}\n\nfunc (f *fakeOPFForRewrite) Redact(_ context.Context, text string, _ []string) ([]redact.Span, error) {\n\treturn findSentinelSpans(text), nil\n}\n\nfunc (f *fakeOPFForRewrite) RedactBatch(_ context.Context, inputs []string, _ []string) ([][]redact.Span, error) {\n\tout := make([][]redact.Span, len(inputs))\n\tfor i, in := range inputs {\n\t\tout[i] = findSentinelSpans(in)\n\t}\n\treturn out, nil\n}\n\nfunc findSentinelSpans(s string) []redact.Span {\n\tvar spans []redact.Span\n\tconst sentinel = \"PERSONABC\"\n\tidx := 0\n\tfor {\n\t\thit := strings.Index(s[idx:], sentinel)\n\t\tif hit < 0 {\n\t\t\tbreak\n\t\t}\n\t\tstart := idx + hit\n\t\tend := start + len(sentinel)\n\t\tspans = append(spans, redact.Span{Start: start, End: end, Label: \"private_person\"})\n\t\tidx = end\n\t}\n\treturn spans\n}\n\n// setupV1Repo creates a repo with one user commit and writes a single v1\n// checkpoint whose transcript contains the OPF sentinel \"PERSONABC\".\n// Returns the repo + the v1 commit hash.\nfunc setupV1Repo(t *testing.T) (*git.Repository, plumbing.Hash) {\n\tt.Helper()\n\n\ttempDir := t.TempDir()\n\ttestutil.InitRepo(t, tempDir)\n\trepo, err := git.PlainOpen(tempDir)\n\trequire.NoError(t, err)\n\n\twt, err := repo.Worktree()\n\trequire.NoError(t, err)\n\trequire.NoError(t, os.WriteFile(filepath.Join(tempDir, \"README.md\"), []byte(\"# Test\"), 0o644))\n\t_, err = wt.Add(\"README.md\")\n\trequire.NoError(t, err)\n\t_, err = wt.Commit(\"Initial commit\", &git.CommitOptions{\n\t\tAuthor: &object.Signature{Name: \"Test\", Email: \"test@test.com\"},\n\t})\n\trequire.NoError(t, err)\n\n\tstore := checkpoint.NewGitStore(repo)\n\tcpID := id.MustCheckpointID(\"a1b2c3d4e5f6\")\n\ttranscript := redact.AlreadyRedacted([]byte(\n\t\t`{\"role\":\"user\",\"content\":\"Hello, PERSONABC asked about the report\"}` + \"\\n\"))\n\n\trequire.NoError(t, store.WriteCommitted(context.Background(), checkpoint.WriteCommittedOptions{\n\t\tCheckpointID: cpID,\n\t\tSessionID:    \"test-session\",\n\t\tStrategy:     \"manual-commit\",\n\t\tTranscript:   transcript,\n\t\tPrompts:      []string{\"Look up PERSONABC in the database\"},\n\t\tAuthorName:   \"Test\",\n\t\tAuthorEmail:  \"test@test.com\",\n\t}))\n\n\tref, err := repo.Reference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), true)\n\trequire.NoError(t, err)\n\treturn repo, ref.Hash()\n}\n\n// TestRewriteUnpushedV1WithOPF_HappyPath_RewritesAndTagsApplied verifies\n// the core pre-push flow: a single unpushed v1 commit lacking the\n// Entire-OPF-Applied trailer gets rewritten with OPF-extended blobs and\n// the trailer is added. The local v1 ref atomically moves to the new tip.\n//\n// Asserts:\n//   - The new tip hash differs from the original (rewrite happened)\n//   - The new commit carries the Entire-OPF-Applied: true trailer\n//   - The blobs no longer contain the sentinel substring \"PERSONABC\"\n//     (OPF replaced it with [REDACTED_PERSON])\nfunc TestRewriteUnpushedV1WithOPF_HappyPath_RewritesAndTagsApplied(t *testing.T) {\n\tredact.ResetOPFConfigForTest()\n\tt.Cleanup(redact.ResetOPFConfigForTest)\n\tredact.ConfigurePrivacyFilterWithRuntime(redact.OPFConfig{\n\t\tEnabled:    true,\n\t\tCategories: map[string]bool{\"private_person\": true},\n\t}, &fakeOPFForRewrite{})\n\n\trepo, originalTip := setupV1Repo(t)\n\n\tnewTip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\tif newTip == originalTip {\n\t\tt.Fatalf(\"rewrite returned same tip %s; expected new tip after OPF-rewrite\", newTip.String()[:7])\n\t}\n\n\t// New commit should carry the OPF-applied trailer.\n\tnewCommit, err := repo.CommitObject(newTip)\n\trequire.NoError(t, err)\n\tif !trailers.HasOPFApplied(newCommit.Message) {\n\t\tt.Errorf(\"new commit missing Entire-OPF-Applied trailer:\\n%s\", newCommit.Message)\n\t}\n\n\t// Local ref should now point to the new tip.\n\tref, err := repo.Reference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), true)\n\trequire.NoError(t, err)\n\tif ref.Hash() != newTip {\n\t\tt.Errorf(\"local v1 ref = %s, want %s (newTip)\", ref.Hash().String()[:7], newTip.String()[:7])\n\t}\n\n\t// Walk the new tree and verify the transcript blob no longer\n\t// contains the sentinel — it should have been replaced by the\n\t// REDACTED_PERSON token.\n\ttree, err := newCommit.Tree()\n\trequire.NoError(t, err)\n\tfoundSentinel := false\n\trequire.NoError(t, tree.Files().ForEach(func(f *object.File) error {\n\t\tif strings.HasSuffix(f.Name, \".jsonl\") || strings.HasSuffix(f.Name, \".txt\") {\n\t\t\tcontent, err := f.Contents()\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif strings.Contains(content, \"PERSONABC\") {\n\t\t\t\tfoundSentinel = true\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}))\n\tif foundSentinel {\n\t\tt.Error(\"rewritten tree still contains the OPF sentinel 'PERSONABC' — OPF rewrite did not redact\")\n\t}\n}\n\n// REDACTED\n// covers the idempotency contract for mixed [applied, unapplied] history:\n// a commit that already has Entire-OPF-Applied: true must be re-parented\n// (so the linear chain stays intact when an unapplied commit below it\n// gets rewritten with a new SHA) WITHOUT duplicating the trailer.\n//\n// This test builds an applied v1 commit by hand on top of the standard\n// setup, calls the rewrite (with OPF disabled would be no-op; we keep\n// it enabled to force the path), and asserts the trailer appears once.\nfunc REDACTED(t *testing.T) {\n\tredact.ResetOPFConfigForTest()\n\tt.Cleanup(redact.ResetOPFConfigForTest)\n\tredact.ConfigurePrivacyFilterWithRuntime(redact.OPFConfig{\n\t\tEnabled:    true,\n\t\tCategories: map[string]bool{\"private_person\": true},\n\t}, &fakeOPFForRewrite{})\n\n\trepo, originalTip := setupV1Repo(t)\n\n\t// Synthesize an \"already applied\" tip by appending the trailer\n\t// directly to the existing commit's message and writing a new\n\t// commit object with the same tree.\n\torigCommit, err := repo.CommitObject(originalTip)\n\trequire.NoError(t, err)\n\n\tappliedCommit := &object.Commit{\n\t\tAuthor:       origCommit.Author,\n\t\tCommitter:    origCommit.Committer,\n\t\tMessage:      trailers.AppendOPFAppliedTrailer(origCommit.Message),\n\t\tTreeHash:     origCommit.TreeHash,\n\t\tParentHashes: origCommit.ParentHashes,\n\t}\n\tobj := repo.Storer.NewEncodedObject()\n\trequire.NoError(t, appliedCommit.Encode(obj))\n\tappliedHash, err := repo.Storer.SetEncodedObject(obj)\n\trequire.NoError(t, err)\n\n\t// Move local v1 ref to point at the applied commit (simulating a\n\t// commit that's already been rewritten by a prior push attempt).\n\tref := plumbing.NewHashReference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), appliedHash)\n\trequire.NoError(t, repo.Storer.SetReference(ref))\n\n\t// Now call rewrite — should reparent the applied commit (since\n\t// no remote ref exists, this is \"bootstrap\" and the commit is\n\t// unpushed by definition).\n\tnewTip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\n\tnewCommit, err := repo.CommitObject(newTip)\n\trequire.NoError(t, err)\n\n\t// The trailer should appear exactly once.\n\toccurrences := strings.Count(newCommit.Message, trailers.OPFAppliedTrailerKey+\": \"+trailers.OPFAppliedTrailerValue)\n\tif occurrences != 1 {\n\t\tt.Errorf(\"expected exactly 1 OPF-Applied trailer, got %d:\\n%s\", occurrences, newCommit.Message)\n\t}\n\n\t// Tree should be preserved verbatim (already-applied path).\n\tif newCommit.TreeHash != appliedCommit.TreeHash {\n\t\tt.Errorf(\"re-parented applied commit has different tree: got %s, want %s\",\n\t\t\tnewCommit.TreeHash.String()[:7], appliedCommit.TreeHash.String()[:7])\n\t}\n}\n\n// REDACTED covers\n// the case where entire/checkpoints/v1 doesn't exist locally (no\n// checkpoints have been written yet). The rewrite should return the\n// zero hash with no error so the caller skips the push step naturally.\nfunc REDACTED(t *testing.T) {\n\tredact.ResetOPFConfigForTest()\n\tt.Cleanup(redact.ResetOPFConfigForTest)\n\tredact.ConfigurePrivacyFilterWithRuntime(redact.OPFConfig{\n\t\tEnabled:    true,\n\t\tCategories: map[string]bool{\"private_person\": true},\n\t}, &fakeOPFForRewrite{})\n\n\ttempDir := t.TempDir()\n\ttestutil.InitRepo(t, tempDir)\n\trepo, err := git.PlainOpen(tempDir)\n\trequire.NoError(t, err)\n\n\ttip, err := RewriteUnpushedV1WithOPF(context.Background(), repo, \"origin\")\n\trequire.NoError(t, err)\n\tif !tip.IsZero() {\n\t\tt.Errorf(\"expected zero hash when v1 ref is missing, got %s\", tip.String()[:7])\n\t}\n}\n","structuredPatch":[{"oldStart":161,"oldLines":16,"newStart":161,"newLines":18,"lines":["   }"," }"," ","-// REDACTED","-// covers the idempotency contract for mixed [applied, unapplied] history:","-// a commit that already has Entire-OPF-Applied: true must be re-parented","-// (so the linear chain stays intact when an unapplied commit below it","-// gets rewri