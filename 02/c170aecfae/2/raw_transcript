ches[1]), true\n122\t\t}\n123\t\treturn \"\", false\n124\t}\n125\t\n126\t// ParseCheckpoint extracts the checkpoint ID from a commit message.\n127\t// Returns the CheckpointID and true if found, empty ID and false otherwise.\n128\tfunc ParseCheckpoint(commitMessage string) (checkpointID.CheckpointID, bool) {\n129\t\tmatches := checkpointTrailerRegex.FindStringSubmatch(commitMessage)\n130\t\tif len(matches) > 1 {\n131\t\t\tidStr := strings.TrimSpace(matches[1])\n132\t\t\t// Validate it's a proper checkpoint ID\n133\t\t\tif cpID, err := checkpointID.NewCheckpointID(idStr); err == nil {\n134\t\t\t\treturn cpID, true\n135\t\t\t}\n136\t\t}\n137\t\treturn checkpointID.EmptyCheckpointID, false\n138\t}\n139\t\n140\t// ParseAllCheckpoints extracts all checkpoint IDs from a commit message.\n141\t// Returns a slice of CheckpointIDs (may be empty if none found).\n142\t// Duplicate IDs are deduplicated while preserving order.\n143\t// This is useful for squash merge commits that contain multiple Entire-Checkpoint trailers.\n144\tfunc ParseAllCheckpoints(commitMessage string) []checkpointID.CheckpointID {\n145\t\tmatches := checkpointTrailerRegex.FindAllStringSubmatch(commitMessage, -1)\n146\t\tif len(matches) == 0 {\n147\t\t\treturn nil\n148\t\t}\n149\t\n150\t\tseen := make(map[string]bool)\n151\t\tids := make([]checkpointID.CheckpointID, 0, len(matches))\n152\t\tfor _, match := range matches {\n153\t\t\tif len(match) > 1 {\n154\t\t\t\tidStr := strings.TrimSpace(match[1])\n155\t\t\t\tif !seen[idStr] {\n156\t\t\t\t\tif cpID, err := checkpointID.NewCheckpointID(idStr); err == nil {\n157\t\t\t\t\t\tseen[idStr] = true\n158\t\t\t\t\t\tids = append(ids, cpID)\n159\t\t\t\t\t}\n160\t\t\t\t}\n161\t\t\t}\n162\t\t}\n163\t\treturn ids\n164\t}\n165\t\n166\t// ParseAllSessions extracts all session IDs from a commit message.\n167\t// Returns a slice of session IDs (may be empty if none found).\n168\t// Duplicate session IDs are deduplicated while preserving order.\n169\t// This is useful for c