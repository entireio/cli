tput)), \"\\n\") {\n311\t\t\tif line == \"\" {\n312\t\t\t\tcontinue\n313\t\t\t}\n314\t\t\tparts := strings.Fields(line)\n315\t\t\tif len(parts) < 2 {\n316\t\t\t\tcontinue\n317\t\t\t}\n318\t\t\trefName := parts[1]\n319\t\t\tsuffix := strings.TrimPrefix(refName, paths.V2FullRefPrefix)\n320\t\t\tif suffix == \"current\" || !checkpoint.GenerationRefPattern.MatchString(suffix) {\n321\t\t\t\tcontinue\n322\t\t\t}\n323\t\t\t// Only check for existence, not hash equality. A locally-present archive\n324\t\t\t// could be stale if another machine updated it via rotation conflict recovery,\n325\t\t\t// but that's unlikely and the checkpoints are still on /main regardless.\n326\t\t\tif _, err := repo.Reference(plumbing.ReferenceName(refName), true); err != nil {\n327\t\t\t\tremoteOnly = append(remoteOnly, suffix)\n328\t\t\t}\n329\t\t}\n330\t\n331\t\tsort.Strings(remoteOnly)\n332\t\treturn remoteOnly, nil\n333\t}\n334\t\n335\t// handleRotationConflict handles the case where remote /full/current was rotated.\n336\t// Merges local /full/current into the latest remote archived generation to avoid\n337\t// duplicating checkpoint data, then adopts remote's /full/current as local.\n338\tfunc handleRotationConflict(ctx context.Context, target, fetchTarget string, repo *git.Repository, refName, tmpRefName plumbing.ReferenceName, remoteOnlyArchives []string) error {\n339\t\t// Use the latest remote-only archive\n340\t\tlatestArchive := remoteOnlyArchives[len(remoteOnlyArchives)-1]\n341\t\tarchiveRefName := plumbing.ReferenceName(paths.V2FullRefPrefix + latestArchive)\n342\t\n343\t\t// Fetch the latest archived generation\n344\t\tarchiveTmpRef := plumbing.ReferenceName(\"refs/entire-fetch-tmp/archive-\" + latestArchive)\n345\t\tarchiveRefSpec := fmt.Sprintf(\"+%s:%s\", archiveRefName, archiveTmpRef)\n346\t\tif output, fetchErr := remote.Fetch(ctx, remote.FetchOptions{\n347\t\t\tRemote:    fetchTarget,\n348\t\t\tRefSpecs:  []string{archiveRefSpec},\n349\t\t\tNoTags:    true,\n350\t\t\tExtraA