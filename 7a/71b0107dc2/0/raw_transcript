ngs.Split(line, \"\\t\")\n164\t\tif len(fields) < 2 || fields[0] == \"\" {\n165\t\t\treturn v2RefPushResult{}, false\n166\t\t}\n167\t\n168\t\trefName, ok := pushStatusRef(fields[1])\n169\t\tif !ok {\n170\t\t\treturn v2RefPushResult{}, false\n171\t\t}\n172\t\n173\t\tswitch fields[0][0] {\n174\t\tcase '!':\n175\t\t\terr := classifyPushOutput(strings.Join(fields[2:], \"\\t\"))\n176\t\t\treturn v2RefPushResult{\n177\t\t\t\trefName: refName,\n178\t\t\t\terr:     fmt.Errorf(\"failed to push %s: %w\", shortRefName(refName), err),\n179\t\t\t}, true\n180\t\tcase '=':\n181\t\t\treturn v2RefPushResult{\n182\t\t\t\trefName: refName,\n183\t\t\t\tresult:  pushResult{upToDate: true},\n184\t\t\t}, true\n185\t\tdefault:\n186\t\t\treturn v2RefPushResult{refName: refName}, true\n187\t\t}\n188\t}\n189\t\n190\tfunc pushStatusRef(statusRef string) (plumbing.ReferenceName, bool) {\n191\t\t_, dst, ok := strings.Cut(statusRef, \":\")\n192\t\tif !ok || dst == \"\" {\n193\t\t\treturn \"\", false\n194\t\t}\n195\t\treturn plumbing.ReferenceName(dst), true\n196\t}\n197\t\n198\t// fetchAndMergeRef fetches a remote custom ref and merges it into the local ref.\n199\t// Uses the same tree-flattening merge as v1 (sharded paths are unique, so no conflicts).\n200\t//\n201\t// For /full/current: if the remote has archived generations not present locally,\n202\t// another machine rotated. In that case, local data is merged into the latest\n203\t// archived generation instead of into /full/current (see handleRotationConflict).\n204\tfunc fetchAndMergeRef(ctx context.Context, target string, refName plumbing.ReferenceName) error {\n205\t\tctx, cancel := context.WithTimeout(ctx, 2*time.Minute)\n206\t\tdefer cancel()\n207\t\n208\t\tfetchTarget, err := remote.ResolveFetchTarget(ctx, target)\n209\t\tif err != nil {\n210\t\t\treturn fmt.Errorf(\"resolve fetch target: %w\", err)\n211\t\t}\n212\t\n213\t\t// Fetch to a temp ref\n214\t\ttmpRefSuffix := strings.ReplaceAll(string(refName), \"/\", \"-\")\n215\t\ttmpRef