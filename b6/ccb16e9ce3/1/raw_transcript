agent.TokenUsage, error) {\n96\t\treturn c.CalculateTotalTokenUsage(transcriptData, fromOffset, \"\")\n97\t}\n98\t\n99\t// --- Internal hook parsing functions ---\n100\t\n101\tfunc (c *ClaudeCodeAgent) parseSessionStart(stdin io.Reader) (*agent.Event, error) {\n102\t\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n103\t\tif err != nil {\n104\t\t\treturn nil, err\n105\t\t}\n106\t\treturn &agent.Event{\n107\t\t\tType:       agent.SessionStart,\n108\t\t\tSessionID:  raw.SessionID,\n109\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n110\t\t\tModel:      raw.Model,\n111\t\t\tTimestamp:  time.Now(),\n112\t\t}, nil\n113\t}\n114\t\n115\tfunc (c *ClaudeCodeAgent) parseTurnStart(stdin io.Reader) (*agent.Event, error) {\n116\t\traw, err := agent.ReadAndParseHookInput[userPromptSubmitRaw](stdin)\n117\t\tif err != nil {\n118\t\t\treturn nil, err\n119\t\t}\n120\t\treturn &agent.Event{\n121\t\t\tType:       agent.TurnStart,\n122\t\t\tSessionID:  raw.SessionID,\n123\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n124\t\t\tPrompt:     raw.Prompt,\n125\t\t\tTimestamp:  time.Now(),\n126\t\t}, nil\n127\t}\n128\t\n129\tfunc (c *ClaudeCodeAgent) parseTurnEnd(stdin io.Reader) (*agent.Event, error) {\n130\t\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n131\t\tif err != nil {\n132\t\t\treturn nil, err\n133\t\t}\n134\t\treturn &agent.Event{\n135\t\t\tType:       agent.TurnEnd,\n136\t\t\tSessionID:  raw.SessionID,\n137\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n138\t\t\tModel:      raw.Model,\n139\t\t\tTimestamp:  time.Now(),\n140\t\t}, nil\n141\t}\n142\t\n143\tfunc (c *ClaudeCodeAgent) parseSessionEnd(stdin io.Reader) (*agent.Event, error) {\n144\t\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n145\t\tif err != nil {\n146\t\t\treturn nil, err\n147\t\t}\n148\t\treturn &agent.Event{\n149\t\t\tType:       agent.SessionEnd,\n150\t\t\tSessionID:  raw.SessionID,\n151\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n152\t\t\tModel:      raw.Model,\n153\t\t\tTimestamp:  time.Now(),\n154\t\t}, nil\n155\t}\n156\t\n157\tfunc (c *ClaudeCodeAgent) parseSubagentStart(stdin io.Reader) (*agent.Event, error) {\n158\t\traw, err := agent.ReadAndParseHookInput[taskHookInputRaw](stdin)\n159\t\tif err != nil {\n160\t\t\treturn nil, err\n161\t\t}\n162\t\treturn &agent.Event{\n163\t\t\tType:       agent.SubagentStart,\n164\t\t\tSessionID:  raw.SessionID,\n165\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n166\t\t\tToolUseID:  raw.ToolUseID,\n167\t\t\tToolInput:  raw.ToolInput,\n168\t\t\tTimestamp:  time.Now(),\n169\t\t}, nil\n170\t}\n171\t\n172\tfunc (c *ClaudeCodeAgent) parseSubagentEnd(stdin io.Reader) (*agent.Event, error) {\n173\t\traw, err := agent.ReadAndParseHookInput[postToolHookInputRaw](stdin)\n174\t\tif err != nil {\n175\t\t\treturn nil, err\n176\t\t}\n177\t\tevent := &agent.Event{\n178\t\t\tType:       agent.SubagentEnd,\n179\t\t\tSessionID:  raw.SessionID,\n180\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n181\t\t\tToolUseID:  raw.ToolUseID,\n182\t\t\tToolInput:  raw.ToolInput,\n183\t\t\tTimestamp:  time.Now(),\n184\t\t}\n185\t\tif raw.ToolResponse.AgentID != \"\" {\n186\t\t\tevent.SubagentID = raw.ToolResponse.AgentID\n187\t\t}\n188\t\treturn event, nil\n189\t}\n190\t\n191\t// claudeWorktreeMarker is the substring that appears in an encoded project-dir\n192\t// segment when Claude Code is invoked from inside its worktree feature.\n193\t// SanitizePathForClaude replaces every non-alphanumeric character with '-',\n194\t// so a CWD ending in \"/.claude/worktrees/<branch>\" produces a project segment\n195\t// containing \"--claude-worktrees-<branch-encoded>\".\n196\tconst claudeWorktreeMarker = \"--claude-worktrees-\"\n197\t\n198\t// resolveTranscriptPath returns the canonical path to a Claude transcript file,\n199\t// recovering from the Claude Code worktree-feature mismatch where\n200\t// transcript_path encodes the worktree CWD (e.g. .claude/worktrees/<branch>) but\n201\t// the file is stored under the parent repo's project dir.\n202\t//\n203\t// When the reported path doesn't exist, the resolver strips the worktree marker\n204\t// from the project segment and checks the parent-repo candidate. The lookup is\n205\t// fully deterministic — no directory scanning, no chance of crossing into an\n206\t// unrelated project that happens to share a session ID.\n207\t//\n208\t// The fallback is gated to keep risk minimal:\n209\t//   - Only triggers on os.IsNotExist (permission/IO errors are returned as-is\n210\t//     so real problems aren't masked).\n211\t//   - Only triggers when the reported path is under the Claude projects base\n212\t//     dir.\n213\t//   - Only triggers when the project segment contains claudeWorktreeMarker.\n214\t//   - The session ID is validated with validation.ValidateAgentSessionID\n215\t//     before being used in filepath.Join, blocking traversal via hostile hook\n216\t//     input.\n217\t//   - The candidate path must itself exist before being returned.\n218\tfunc (c *ClaudeCodeAgent) resolveTranscriptPath(sessionRef, sessionID string) string {\n219\t\tif sessionRef == \"\" || sessionID == \"\" {\n220\t\t\treturn sessionRef\n221\t\t}\n222\t\tif _, err := os.Stat(sessionRef); err == nil {\n223\t\t\treturn sessionRef\n224\t\t} else if !os.IsNotExist(err) {\n225\t\t\treturn sessionRef\n226\t\t}\n227\t\tif err := validation.ValidateAgentSessionID(sessionID); err != nil {\n228\t\t\treturn sessionRef\n229\t\t}\n230\t\tbase, err := c.GetSessionBaseDir()\n231\t\tif err != nil {\n232\t\t\treturn sessionRef\n233\t\t}\n234\t\tcandidate := worktreeParentCandidate(filepath.Clean(base), filepath.Clean(sessionRef), sessionID)\n235\t\tif candidate == \"\" {\n236\t\t\treturn sessionRef\n237\t\t}\n238\t\tif _, err := os.Stat(candidate); err != nil {\n239\t\t\treturn sessionRef\n240\t\t}\n241\t\tlogging.Info(logging.WithComponent(context.Background(), \"agent.claudecode\"),\n242\t\t\t\"resolved transcript via worktree fallback\",\n243\t\t\tslog.String(\"reported\", sessionRef),\n244\t\t\tslog.String(\"found\", candidate),\n245\t\t\tslog.String(\"session_id\", sessionID),\n246\t\t)\n247\t\treturn candidate\n248\t}\n249\t\n250\t// worktreeParentCandidate returns the parent-repo equivalent of a reported\n251\t// transcript path when the project segment carries the Claude Code worktree\n252\t// marker. Returns \"\" if reported is not under base, has no project segment,\n253\t// or has no worktree marker. Callers must validate sessionID before calling.\n254\t//\n255\t// strings.LastIndex (not Index) is used because the *synthetic* worktree\n256\t// marker is always the trailing occurrence in the project segment: Claude\n257\t// appends \"/.claude/worktrees/<branch>\" to the cwd, and SanitizePathForClaude\n258\t// preserves left-to-right order, so the suffix carrying the bug is the last\n259\t// one. Cutting at the first match would mis-strip repos whose sanitized root\n260\t// already contains the token (e.g. repos checked out under a directory\n261\t// literally named \"...--claude-worktrees-...\").\n262\tfunc worktreeParentCandidate(base, reported, sessionID string) string {\n263\t\tsep := string(os.PathSeparator)\n264\t\tprefix := base + sep\n265\t\tif !strings.HasPrefix(reported, prefix) {\n266\t\t\treturn \"\"\n267\t\t}\n268\t\tprojectSeg, _, ok := strings.Cut(reported[len(prefix):], sep)\n269\t\tif !ok || projectSeg == \"\" {\n270\t\t\treturn \"\"\n271\t\t}\n272\t\tidx := strings.LastIndex(projectSeg, claudeWorktreeMarker)\n273\t\tif idx <= 0 {\n274\t\t\treturn \"\"\n275\t\t}\n276\t\treturn filepath.Join(base, projectSeg[:idx], sessionID+\".jsonl\")\n277\t}\n278\t\n279\t// --- Transcript flush sentinel ---\n280\t\n281\t// stopHookSentinel is the string that appears in Claude Code's hook_progress\n282\t// entry when the stop hook has been invoked, indicating the transcript is fully flushed.\n283\tconst stopHookSentinel = \"hooks claude-code stop\"\n284\t\n285\t// waitForTranscriptFlush polls the transcript file for the stop hook sentinel.\n286\t// Falls back silently after a timeout.\n287\tfunc waitForTranscriptFlush(ctx context.Context, transcriptPath string, hookStartTime time.Time) {\n288\t\tconst (\n289\t\t\tmaxWait      = 3 * time.Second\n290\t\t\tpollInterval = 50 * time.Millisecond\n291\t\t\ttailBytes    = 4096\n292\t\t\tmaxSkew      = 2 * time.Second\n293\t\t)\n294\t\n295\t\tlogCtx := logging.WithComponent(ctx, \"agent.claudecode\")\n296\t\n297\t\t// Fast path: skip the poll loop when the sentinel can't possibly appear.\n298\t\t// - File doesn't exist: nothing to poll.\n299\t\t// - File is stale (unmodified for 2+ min): agent isn't running anymore.\n300\t\t//   This avoids 3s timeouts per stale \"active\" session (e.g., agent crashed\n301\t\t//   without firing stop hook).\n302\t\tconst staleThreshold = 2 * time.Minute\n303\t\tinfo, err := os.Stat(transcriptPath)\n304\t\tif err != nil {\n305\t\t\t// Most likely the file doesn't exist; other errors (permission, etc.)\n306\t\t\t// would also prevent polling, so skip the wait either way.\n307\t\t\treturn\n308\t\t}\n309\t\tfileAge := time.Since(info.ModTime())\n310\t\tif fileAge > staleThreshold {\n311\t\t\tlogging.Debug(logCtx, \"transcript file is stale, skipping sentinel wait\",\n312\t\t\t\tslog.Duration(\"file_age\", fileAge),\n313\t\t\t)\n314\t\t\treturn\n315\t\t}\n316\t\n317\t\tdeadline := time.Now().Add(maxWait)\n318\t\tfor time.Now().Before(deadline) {\n319\t\t\tif checkStopSentinel(transcriptPath, tailBytes, hookStartTime, maxSkew) {\n320\t\t\t\tlogging.Debug(logCtx, \"transcript flush sentinel found\",\n321\t\t\t\t\tslog.Duration(\"wait\", time.Since(hookStartTime)),\n322\t\t\t\t)\n323\t\t\t\treturn\n324\t\t\t}\n325\t\t\ttime.Sleep(pollInterval)\n326\t\t}\n327\t\tlogging.Warn(logCtx, \"transcript flush sentinel not found within timeout, proceeding\",\n328\t\t\tslog.Duration(\"timeout\", maxWait),\n329\t\t)\n330\t}\n331\t\n332\t// checkStopSentinel reads the tail of the transcript file and looks for the sentinel.\n333\tfunc checkStopSentinel(path string, tailBytes int64, hookStartTime time.Time, maxSkew time.Duration) bool {\n334\t\tf, err := os.Open(path) //nolint:gosec // path comes from agent hook input\n335\t\tif err != nil {\n336\t\t\treturn false\n337\t\t}\n338\t\tdefer f.Close()\n339\t\n340\t\tinfo, err := f.Stat()\n341\t\tif err != nil {\n342\t\t\treturn false\n343\t\t}\n344\t\toffset := info.Size() - tailBytes\n345\t\tif offset < 0 {\n346\t\t\toffset = 0\n347\t\t}\n348\t\tbuf := make([]byte, info.Size()-offset)\n349\t\tif _, err := f.ReadAt(buf, offset); err != nil {\n350\t\t\treturn false\n351\t\t}\n352\t\n353\t\tlines := strings.Split(string(buf), \"\\n\")\n354\t\tfor _, line := range lines {\n355\t\t\tline = strings.TrimSpace(line)\n356\t\t\tif line == \"\" || !strings.Contains(line, stopHookSentinel) {\n357\t\t\t\tcontinue\n358\t\t\t}\n359\t\n360\t\t\tvar entry struct {\n361\t\t\t\tTimestamp string `json:\"timestamp\"`\n362\t\t\t}\n363\t\t\tif json.Unmarshal([]byte(line), &entry) != nil || entry.Timestamp == \"\" {\n364\t\t\t\tcontinue\n365\t\t\t}\n366\t\t\tts, err := time.Parse(time.RFC3339Nano, entry.Timestamp)\n367\t\t\tif err != nil {\n368\t\t\t\tts, err = time.Parse(time.RFC3339, entry.Timestamp)\n369\t\t\t\tif err != nil {\n370\t\t\t\t\tcontinue\n371\t\t\t\t}\n372\t\t\t}\n373\t\t\t// Validate timestamp is within acceptable range:\n374\t\t\t// - Not too far in the past (before hook started minus skew)\n375\t\t\t// - Not too far in the future (after hook started plus skew)\n376\t\t\tlowerBound := hookStartTime.Add(-maxSkew)\n377\t\t\tupperBound := hookStartTime.Add(maxSkew)\n378\t\t\tif ts.After(lowerBound) && ts.Before(upperBound) {\n379\t\t\t\treturn true\n380\t\t\t}\n381\t\t}\n382\t\treturn false\n383\t}\n384\t"}]},"uuid":"23b5121f-2fa1-485e-b9d2-1de689f4961f","timestamp":"2026-05-11T14:09:36.258Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/agent/claudecode/lifecycle.go","content":"package claudecode\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/validation\"\n)\n\n// Compile-time interface assertions for new interfaces.\nvar (\n\t_ agent.TranscriptAnalyzer     = (*ClaudeCodeAgent)(nil)\n\t_ agent.TranscriptPreparer     = (*ClaudeCodeAgent)(nil)\n\t_ agent.TokenCalculator        = (*ClaudeCodeAgent)(nil)\n\t_ agent.SubagentAwareExtractor = (*ClaudeCodeAgent)(nil)\n\t_ agent.HookResponseWriter     = (*ClaudeCodeAgent)(nil)\n)\n\n// WriteHookResponse outputs a JSON hook response to stdout.\n// Claude Code reads this JSON and displays the systemMessage to the user.\nfunc (c *ClaudeCodeAgent) WriteHookResponse(message string) error {\n\tresp := struct {\n\t\tSystemMessage string `json:\"systemMessage,omitempty\"`\n\t}{SystemMessage: message}\n\tif err := json.NewEncoder(os.Stdout).Encode(resp); err != nil {\n\t\treturn fmt.Errorf(\"failed to encode hook response: %w\", err)\n\t}\n\treturn nil\n}\n\n// HookNames returns the hook verbs Claude Code supports.\n// These become subcommands: entire hooks claude-code <verb>\nfunc (c *ClaudeCodeAgent) HookNames() []string {\n\treturn []string{\n\t\tHookNameSessionStart,\n\t\tHookNameSessionEnd,\n\t\tHookNameStop,\n\t\tHookNameUserPromptSubmit,\n\t\tHookNamePreTask,\n\t\tHookNamePostTask,\n\t\tHookNamePostTodo,\n\t}\n}\n\n// ParseHookEvent translates a Claude Code hook into a normalized lifecycle Event.\n// Returns nil if the hook has no lifecycle significance.\nfunc (c *ClaudeCodeAgent) ParseHookEvent(_ context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n\tswitch hookName {\n\tcase HookNameSessionStart:\n\t\treturn c.parseSessionStart(stdin)\n\tcase HookNameUserPromptSubmit:\n\t\treturn c.parseTurnStart(stdin)\n\tcase HookNameStop:\n\t\treturn c.parseTurnEnd(stdin)\n\tcase HookNameSessionEnd:\n\t\treturn c.parseSessionEnd(stdin)\n\tcase HookNamePreTask:\n\t\treturn c.parseSubagentStart(stdin)\n\tcase HookNamePostTask:\n\t\treturn c.parseSubagentEnd(stdin)\n\tcase HookNamePostTodo:\n\t\t// PostTodo is Claude-specific; handled outside the generic dispatcher.\n\t\treturn nil, nil //nolint:nilnil // nil event = no lifecycle action\n\tdefault:\n\t\treturn nil, nil //nolint:nilnil // Unknown hooks have no lifecycle action\n\t}\n}\n\n// ReadTranscript reads the raw JSONL transcript bytes for a session.\nfunc (c *ClaudeCodeAgent) ReadTranscript(sessionRef string) ([]byte, error) {\n\tdata, err := os.ReadFile(sessionRef) //nolint:gosec // Path comes from agent hook input\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read transcript: %w\", err)\n\t}\n\treturn data, nil\n}\n\n// PrepareTranscript waits for Claude Code's async transcript flush to complete.\n// Claude writes a hook_progress sentinel entry after flushing all pending writes.\nfunc (c *ClaudeCodeAgent) PrepareTranscript(ctx context.Context, sessionRef string) error {\n\twaitForTranscriptFlush(ctx, sessionRef, time.Now())\n\treturn nil\n}\n\n// CalculateTokenUsage computes token usage from the transcript starting at the given line offset.\nfunc (c *ClaudeCodeAgent) CalculateTokenUsage(transcriptData []byte, fromOffset int) (*agent.TokenUsage, error) {\n\treturn c.CalculateTotalTokenUsage(transcriptData, fromOffset, \"\")\n}\n\n// --- Internal hook parsing functions ---\n\nfunc (c *ClaudeCodeAgent) parseSessionStart(stdin io.Reader) (*agent.Event, error) {\n\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &agent.Event{\n\t\tType:       agent.SessionStart,\n\t\tSessionID:  raw.SessionID,\n\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n\t\tModel:      raw.Model,\n\t\tTimestamp:  time.Now(),\n\t}, nil\n}\n\nfunc (c *ClaudeCodeAgent) parseTurnStart(stdin io.Reader) (*agent.Event, error) {\n\traw, err := agent.ReadAndParseHookInput[userPromptSubmitRaw](stdin)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &agent.Event{\n\t\tType:       agent.TurnStart,\n\t\tSessionID:  raw.SessionID,\n\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n\t\tPrompt:     raw.Prompt,\n\t\tTimestamp:  time.Now(),\n\t}, nil\n}\n\nfunc (c *ClaudeCodeAgent) parseTurnEnd(stdin io.Reader) (*agent.Event, error) {\n\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &agent.Event{\n\t\tType:       agent.TurnEnd,\n\t\tSessionID:  raw.SessionID,\n\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n\t\tModel:      raw.Model,\n\t\tTimestamp:  time.Now(),\n\t}, nil\n}\n\nfunc (c *ClaudeCodeAgent) parseSessionEnd(stdin io.Reader) (*agent.Event, error) {\n\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &agent.Event{\n\t\tType:       agent.SessionEnd,\n\t\tSessionID:  raw.SessionID,\n\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n\t\tModel:      raw.Model,\n\t\tTimestamp:  time.Now(),\n\t}, nil\n}\n\nfunc (c *ClaudeCodeAgent) parseSubagentStart(stdin io.Reader) (*agent.Event, error) {\n\traw, err := agent.ReadAndParseHookInput[taskHookInputRaw](stdin)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &agent.Event{\n\t\tType:       agent.SubagentStart,\n\t\tSessionID:  raw.SessionID,\n\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n\t\tToolUseID:  raw.ToolUseID,\n\t\tToolInput:  raw.ToolInput,\n\t\tTimestamp:  time.Now(),\n\t}, nil\n}\n\nfunc (c *ClaudeCodeAgent) parseSubagentEnd(stdin io.Reader) (*agent.Event, error) {\n\traw, err := agent.ReadAndParseHookInput[postToolHookInputRaw](stdin)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tevent := &agent.Event{\n\t\tType:       agent.SubagentEnd,\n\t\tSessionID:  raw.SessionID,\n\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n\t\tToolUseID:  raw.ToolUseID,\n\t\tToolInput:  raw.ToolInput,\n\t\tTimestamp:  time.Now(),\n\t}\n\tif raw.ToolResponse.AgentID != \"\" {\n\t\tevent.SubagentID = raw.ToolResponse.AgentID\n\t}\n\treturn event, nil\n}\n\n// claudeWorktreeMarker is the substring that appears in an encoded project-dir\n// segment when Claude Code is invoked from inside its worktree feature.\n// SanitizePathForClaude replaces every non-alphanumeric character with '-',\n// so a CWD ending in \"/.claude/worktrees/<branch>\" produces a project segment\n// containing \"--claude-worktrees-<branch-encoded>\".\nconst claudeWorktreeMarker = \"--claude-worktrees-\"\n\n// resolveTranscriptPath returns the canonical path to a Claude transcript file,\n// recovering from the Claude Code worktree-feature mismatch where\n// transcript_path encodes the worktree CWD (e.g. .claude/worktrees/<branch>) but\n// the file is stored under the parent repo's project dir.\n//\n// When the reported path doesn't exist, the resolver strips the worktree marker\n// from the project segment and checks the parent-repo candidate. The lookup is\n// fully deterministic — no directory scanning, no chance of crossing into an\n// unrelated project that happens to share a session ID.\n//\n// The fallback is gated to keep risk minimal:\n//   - Only triggers on os.IsNotExist (permission/IO errors are returned as-is\n//     so real problems aren't masked).\n//   - Only triggers when the reported path is under the Claude projects base\n//     dir.\n//   - Only triggers when the project segment contains claudeWorktreeMarker.\n//   - The session ID is validated with validation.ValidateAgentSessionID\n//     before being used in filepath.Join, block