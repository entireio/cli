366\t\t\t{\n367\t\t\t\thookName:      HookNamePreTask,\n368\t\t\t\texpectedType:  agent.SubagentStart,\n369\t\t\t\tinputTemplate: `{\"session_id\": \"s5\", \"transcript_path\": \"/t\", \"tool_use_id\": \"t1\", \"tool_input\": {}}`,\n370\t\t\t},\n371\t\t\t{\n372\t\t\t\thookName:      HookNamePostTask,\n373\t\t\t\texpectedType:  agent.SubagentEnd,\n374\t\t\t\tinputTemplate: `{\"session_id\": \"s6\", \"transcript_path\": \"/t\", \"tool_use_id\": \"t2\", \"tool_input\": {}, \"tool_response\": {}}`,\n375\t\t\t},\n376\t\t\t{\n377\t\t\t\thookName:      HookNamePostTodo,\n378\t\t\t\texpectNil:     true,\n379\t\t\t\tinputTemplate: `{\"session_id\": \"s7\", \"transcript_path\": \"/t\"}`,\n380\t\t\t},\n381\t\t}\n382\t\n383\t\tfor _, tc := range testCases {\n384\t\t\tt.Run(tc.hookName, func(t *testing.T) {\n385\t\t\t\tt.Parallel()\n386\t\n387\t\t\t\tag := &ClaudeCodeAgent{}\n388\t\t\t\tevent, err := ag.ParseHookEvent(context.Background(), tc.hookName, strings.NewReader(tc.inputTemplate))\n389\t\n390\t\t\t\tif err != nil {\n391\t\t\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n392\t\t\t\t}\n393\t\n394\t\t\t\tif tc.expectNil {\n395\t\t\t\t\tif event != nil {\n396\t\t\t\t\t\tt.Errorf(\"expected nil event, got %+v\", event)\n397\t\t\t\t\t}\n398\t\t\t\t\treturn\n399\t\t\t\t}\n400\t\n401\t\t\t\trequire.NotNil(t, event, \"expected event, got nil\")\n402\t\t\t\tif event.Type != tc.expectedType {\n403\t\t\t\t\tt.Errorf(\"expected event type %v, got %v\", tc.expectedType, event.Type)\n404\t\t\t\t}\n405\t\t\t})\n406\t\t}\n407\t}\n408\t\n409\tfunc TestReadAndParse_ValidInput(t *testing.T) {\n410\t\tt.Parallel()\n411\t\n412\t\tinput := `{\"session_id\": \"test-123\", \"transcript_path\": \"/path/to/transcript\"}`\n413\t\n414\t\tresult, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(input))\n415\t\n416\t\tif err != nil {\n417\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n418\t\t}\n419\t\trequire.NotNil(t, result, \"expected result, got nil\")\n420\t\tif result.SessionID != \"test-123\" {\n421\t\t\tt.Errorf(\"expected session_id 'test-123', got %q\", result.SessionID)\n422\t\t}\n423\t\tif result.TranscriptPath != \"/path/to/transcript\" {\n424\t\t\tt.Errorf(\"expected transcript_path '/path/to/transcript', got %q\", result.TranscriptPath)\n425\t\t}\n426\t}\n427\t\n428\tfunc TestReadAndParse_EmptyInput(t *testing.T) {\n429\t\tt.Parallel()\n430\t\n431\t\t_, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(\"\"))\n432\t\n433\t\tif err == nil {\n434\t\t\tt.Fatal(\"expected error for empty input\")\n435\t\t}\n436\t\tif !strings.Contains(err.Error(), \"empty hook input\") {\n437\t\t\tt.Errorf(\"expected 'empty hook input' error, got: %v\", err)\n438\t\t}\n439\t}\n440\t\n441\tfunc TestReadAndParse_InvalidJSON(t *testing.T) {\n442\t\tt.Parallel()\n443\t\n444\t\t_, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(\"not valid json\"))\n445\t\n446\t\tif err == nil {\n447\t\t\tt.Fatal(\"expected error for invalid JSON\")\n448\t\t}\n449\t\tif !strings.Contains(err.Error(), \"failed to parse hook input\") {\n450\t\t\tt.Errorf(\"expected 'failed to parse hook input' error, got: %v\", err)\n451\t\t}\n452\t}\n453\t\n454\tfunc TestReadAndParse_PartialJSON(t *testing.T) {\n455\t\tt.Parallel()\n456\t\n457\t\t// JSON with only some fields - should still parse (missing fields are zero values)\n458\t\tinput := `{\"session_id\": \"partial-only\"}`\n459\t\n460\t\tresult, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(input))\n461\t\n462\t\tif err != nil {\n463\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n464\t\t}\n465\t\tif result.SessionID != \"partial-only\" {\n466\t\t\tt.Errorf(\"expected session_id 'partial-only', got %q\", result.SessionID)\n467\t\t}\n468\t\tif result.TranscriptPath != \"\" {\n469\t\t\tt.Errorf(\"expected empty transcript_path, got %q\", result.TranscriptPath)\n470\t\t}\n471\t}\n472\t\n473\tfunc TestReadAndParse_ExtraFields(t *testing.T) {\n474\t\tt.Parallel()\n475\t\n476\t\t// JSON with extra fields - should ignore them\n477\t\tinput := `{\"session_id\": \"test\", \"transcript_path\": \"/t\", \"extra_field\": \"ignored\", \"another\": 123}`\n478\t\n479\t\tresult, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(input))\n480\t\n481\t\tif err != nil {\n482\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n483\t\t}\n484\t\tif result.SessionID != \"test\" {\n485\t\t\tt.Errorf(\"expected session_id 'test', got %q\", result.SessionID)\n486\t\t}\n487\t}\n488\t\n489\tfunc TestWaitForTranscriptFlush_StaleFile_SkipsWait(t *testing.T) {\n490\t\tt.Parallel()\n491\t\n492\t\t// Create a transcript file and backdate its mtime to make it \"stale\"\n493\t\ttranscriptFile := filepath.Join(t.TempDir(), \"transcript.jsonl\")\n494\t\tif err := os.WriteFile(transcriptFile, []byte(`{\"type\":\"human\"}`+\"\\n\"), 0o644); err != nil {\n495\t\t\tt.Fatalf(\"failed to write transcript: %v\", err)\n496\t\t}\n497\t\tstaleTime := time.Now().Add(-10 * time.Minute)\n498\t\tif err := os.Chtimes(transcriptFile, staleTime, staleTime); err != nil {\n499\t\t\tt.Fatalf(\"failed to set mtime: %v\", err)\n500\t\t}\n501\t\n502\t\t// waitForTranscriptFlush should return almost instantly for stale files\n503\t\t// (not wait the full 3 seconds)\n504\t\tstart := time.Now()\n505\t\twaitForTranscriptFlush(context.Background(), transcriptFile, time.Now())\n506\t\telapsed := time.Since(start)\n507\t\n508\t\tif elapsed > 500*time.Millisecond {\n509\t\t\tt.Errorf(\"expected fast return for stale transcript, but took %v\", elapsed)\n510\t\t}\n511\t}\n512\t\n513\tfunc TestWaitForTranscriptFlush_RecentFile_WaitsForSentinel(t *testing.T) {\n514\t\tt.Parallel()\n515\t\n516\t\t// Create a transcript file with recent mtime (no sentinel present)\n517\t\ttranscriptFile := filepath.Join(t.TempDir(), \"transcript.jsonl\")\n518\t\tif err := os.WriteFile(transcriptFile, []byte(`{\"type\":\"human\"}`+\"\\n\"), 0o644); err != nil {\n519\t\t\tt.Fatalf(\"failed to write transcript: %v\", err)\n520\t\t}\n521\t\t// File was just created, so mtime is now — should NOT skip the wait\n522\t\n523\t\tstart := time.Now()\n524\t\twaitForTranscriptFlush(context.Background(), transcriptFile, time.Now())\n525\t\telapsed := time.Since(start)\n526\t\n527\t\t// Should wait close to maxWait (3s) since no sentinel will be found\n528\t\tif elapsed < 2*time.Second {\n529\t\t\tt.Errorf(\"expected to wait ~3s for recent file without sentinel, but only took %v\", elapsed)\n530\t\t}\n531\t}\n532\t\n533\tfunc TestWaitForTranscriptFlush_NonexistentFile_ReturnsImmediately(t *testing.T) {\n534\t\tt.Parallel()\n535\t\n536\t\t// File doesn't exist — os.Stat fails, return immediately (nothing to poll).\n537\t\tstart := time.Now()\n538\t\twaitForTranscriptFlush(context.Background(), \"/nonexistent/transcript.jsonl\", time.Now())\n539\t\telapsed := time.Since(start)\n540\t\n541\t\tif elapsed > 500*time.Millisecond {\n542\t\t\tt.Errorf(\"expected immediate return for nonexistent file, but took %v\", elapsed)\n543\t\t}\n544\t}\n545\t\n546\tconst testClaudeProjectsBase = \"/home/u/.claude/projects\"\n547\t\n548\tfunc TestWorktreeParentCandidate(t *testing.T) {\n549\t\tt.Parallel()\n550\t\n551\t\treported := filepath.Join(testClaudeProjectsBase, \"-Users-foo-Development-repo--claude-worktrees-feature\", \"sess-1.jsonl\")\n552\t\tgot := worktreeParentCandidate(testClaudeProjectsBase, reported, \"sess-1\")\n553\t\twant := filepath.Join(testClaudeProjectsBase, \"-Users-foo-Development-repo\", \"sess-1.jsonl\")\n554\t\tif got != want {\n555\t\t\tt.Errorf(\"worktreeParentCandidate = %q, want %q\", got, want)\n556\t\t}\n557\t}\n558\t\n559\tfunc TestWorktreeParentCandidate_NoMarker(t *testing.T) {\n560\t\tt.Parallel()\n561\t\n562\t\treported := filepath.Join(testClaudeProjectsBase, \"-Users-foo-Development-repo\", \"sess-1.jsonl\")\n563\t\tif got := worktreeParentCandidate(testClaudeProjectsBase, reported, \"sess-1\"); got != \"\" {\n564\t\t\tt.Errorf(\"expected empty (no marker), got %q\", got)\n565\t\t}\n566\t}\n567\t\n568\tfunc TestWorktreeParentCandidate_OutsideBase(t *testing.T) {\n569\t\tt.Parallel()\n570\t\n571\t\tif got := worktreeParentCandidate(\"/a/base\", \"/somewhere/else/sess-1.jsonl\", \"sess-1\"); got != \"\" {\n572\t\t\tt.Errorf(\"expected empty (outside base), got %q\", got)\n573\t\t}\n574\t}\n575\t\n576\t// TestWorktreeParentCandidate_MarkerInRepoRoot covers a repo whose sanitized\n577\t// root already contains the literal \"--claude-worktrees-\" token (e.g. checked\n578\t// out under a directory literally named \"acme--claude-worktrees-tools\"). Only\n579\t// the trailing, synthetic occurrence — the suffix Claude appends from\n580\t// .claude/worktrees/<branch> — should be stripped. Cutting at the first\n581\t// occurrence would point at the wrong project dir and re-introduce the\n582\t// dropped-checkpoint bug for that class of repos.\n583\tfunc TestWorktreeParentCandidate_MarkerInRepoRoot(t *testing.T) {\n584\t\tt.Parallel()\n585\t\n586\t\tparent := \"-Users-me-acme--claude-worktrees-tools-repo\"\n587\t\tworktree := parent + \"--claude-worktrees-feature\"\n588\t\treported := filepath.Join(testClaudeProjectsBase, worktree, \"sess-1.jsonl\")\n589\t\tgot := worktreeParentCandidate(testClaudeProjectsBase, reported, \"sess-1\")\n590\t\twant := filepath.Join(testClaudeProjectsBase, parent, \"sess-1.jsonl\")\n591\t\tif got != want {\n592\t\t\tt.Errorf(\"worktreeParentCandidate = %q, want %q (must strip only the trailing synthetic marker)\", got, want)\n593\t\t}\n594\t}\n595\t\n596\tfunc TestWorktreeParentCandidate_MarkerAtStart(t *testing.T) {\n597\t\tt.Parallel()\n598\t\n599\t\t// Marker at index 0 of the project segment is meaningless — there is no\n600\t\t// parent path to recover. Helper returns \"\".\n601\t\treported := filepath.Join(testClaudeProjectsBase, \"--claude-worktrees-feature\", \"sess-1.jsonl\")\n602\t\tif got := worktreeParentCandidate(testClaudeProjectsBase, reported, \"sess-1\"); got != \"\" {\n603\t\t\tt.Errorf(\"expected empty (marker at start), got %q\", got)\n604\t\t}\n605\t}\n606\t\n607\tfunc TestResolveTranscriptPath_PassthroughWhenExists(t *testing.T) {\n608\t\tt.Parallel()\n609\t\n610\t\ttranscript := filepath.Join(t.TempDir(), \"real.jsonl\")\n611\t\tif err := os.WriteFile(transcript, []byte(\"{}\\n\"), 0o600); err != nil {\n612\t\t\tt.Fatalf(\"write: %v\", err)\n613\t\t}\n614\t\tag := &ClaudeCodeAgent{}\n615\t\tgot := ag.resolveTranscriptPath(transcript, \"any-session-id\")\n616\t\tif got != transcript {\n617\t\t\tt.Errorf(\"resolveTranscriptPath returned %q, want passthrough %q\", got, transcript)\n618\t\t}\n619\t}\n620\t\n621\tfunc TestResolveTranscriptPath_EmptyInputs(t *testing.T) {\n622\t\tt.Parallel()\n623\t\n624\t\tag := &ClaudeCodeAgent{}\n625\t\tif got := ag.resolveTranscriptPath(\"\", \"id\"); got != \"\" {\n626\t\t\tt.Errorf(\"empty sessionRef should pass through; got %q\", got)\n627\t\t}\n628\t\tif got := ag.resolveTranscriptPath(\"/some/path\", \"\"); got != \"/some/path\" {\n629\t\t\tt.Errorf(\"empty sessionID should pass through; got %q\", got)\n630\t\t}\n631\t}\n632\t\n633\t// TestResolveTranscriptPath_WorktreeFallback simulates the Claude Code worktree\n634\t// bug: the agent reports a transcript_path under a \"--claude-worktrees-<branch>\"\n635\t// project dir that doesn't exist, while the actual transcript was written under\n636\t// the parent repo's project dir. The resolver should find the real file by\n637\t// scanning the projects base dir for the session ID.\n638\tfunc TestResolveTranscriptPath_WorktreeFallback(t *testing.T) {\n639\t\t// Cannot t.Parallel() — uses t.Setenv on HOME (process-global).\n640\t\ttmpHome := t.TempDir()\n641\t\tt.Setenv(\"HOME\", tmpHome)\n642\t\n643\t\tbase := filepath.Join(tmpHome, \".claude\", \"projects\")\n644\t\tparentDir := filepath.Join(base, \"-Users-foo-Development-repo\")\n645\t\tif err := os.MkdirAll(parentDir, 0o755); err != nil {\n646\t\t\tt.Fatalf(\"mkdir parent project: %v\", err)\n647\t\t}\n648\t\tsessionID := \"wt-session-uuid\"\n649\t\trealPath := filepath.Join(parentDir, sessionID+\".jsonl\")\n650\t\tif err := os.WriteFile(realPath, []byte(\"{}\\n\"), 0o600); err != nil {\n651\t\t\tt.Fatalf(\"write transcript: %v\", err)\n652\t\t}\n653\t\n654\t\t// Reported path encodes the worktree CWD — does not exist on disk.\n655\t\treported := filepath.Join(base, \"-Users-foo-Development-repo--claude-worktrees-feature\", sessionID+\".jsonl\")\n656\t\n657\t\tag := &ClaudeCodeAgent{}\n658\t\tgot := ag.resolveTranscriptPath(reported, sessionID)\n659\t\tif got != realPath {\n660\t\t\tt.Errorf(\"resolveTranscriptPath = %q, want %q (real location)\", got, realPath)\n661\t\t}\n662\t}\n663\t\n664\t// TestResolveTranscriptPath_NoMarker_Passthrough verifies that when the\n665\t// reported path is under the projects base but the project segment does not\n666\t// carry the worktree marker, the resolver returns the original path unchanged\n667\t// rather than fabricating a candidate.\n668\tfunc TestResolveTranscriptPath_NoMarker_Passthrough(t *testing.T) {\n669\t\t// Cannot t.Parallel() — uses t.Setenv on HOME.\n670\t\ttmpHome := t.TempDir()\n671\t\tt.Setenv(\"HOME\", tmpHome)\n672\t\n673\t\tbase := filepath.Join(tmpHome, \".claude\", \"projects\")\n674\t\tif err := os.MkdirAll(base, 0o755); err != nil {\n675\t\t\tt.Fatalf(\"mkdir base: %v\", err)\n676\t\t}\n677\t\treported := filepath.Join(base, \"-Users-foo-Development-repo\", \"missing.jsonl\")\n678\t\n679\t\tag := &ClaudeCodeAgent{}\n680\t\tgot := ag.resolveTranscriptPath(reported, \"any-id\")\n681\t\tif got != reported {\n682\t\t\tt.Errorf(\"resolveTranscriptPath = %q, want passthrough %q\", got, reported)\n683\t\t}\n684\t}\n685\t\n686\t// TestResolveTranscriptPath_OutsideBaseDir verifies the resolver does not scan\n687\t// when the reported path is outside the Claude projects base dir — scanning\n688\t// elsewhere couldn't produce a more correct answer and just adds I/O.\n689\tfunc TestResolveTranscriptPath_OutsideBaseDir(t *testing.T) {\n690\t\t// Cannot t.Parallel() — uses t.Setenv on HOME.\n691\t\ttmpHome := t.TempDir()\n692\t\tt.Setenv(\"HOME\", tmpHome)\n693\t\n694\t\t// A real transcript exists under the projects base, but the reported path\n695\t\t// is somewhere else entirely. Resolver should not redirect.\n696\t\tbase := filepath.Join(tmpHome, \".claude\", \"projects\")\n697\t\tdir := filepath.Join(base, \"some-project\")\n698\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n699\t\t\tt.Fatalf(\"mkdir: %v\", err)\n700\t\t}\n701\t\tsessionID := \"outside-session\"\n702\t\tif err := os.WriteFile(filepath.Join(dir, sessionID+\".jsonl\"), []byte(\"{}\\n\"), 0o600); err != nil {\n703\t\t\tt.Fatalf(\"write transcript: %v\", err)\n704\t\t}\n705\t\n706\t\treported := filepath.Join(t.TempDir(), \"elsewhere\", sessionID+\".jsonl\") // not under base\n707\t\tag := &ClaudeCodeAgent{}\n708\t\tgot := ag.resolveTranscriptPath(reported, sessionID)\n709\t\tif got != reported {\n710\t\t\tt.Errorf(\"resolveTranscriptPath = %q, want passthrough %q (path outside base)\", got, reported)\n711\t\t}\n712\t}\n713\t\n714\t// TestResolveTranscriptPath_RejectsTraversalSessionID verifies that a session\n715\t// ID containing path separators is rejected before being used in filepath.Join.\n716\tfunc TestResolveTranscriptPath_RejectsTraversalSessionID(t *testing.T) {\n717\t\t// Cannot t.Parallel() — uses t.Setenv on HOME.\n718\t\ttmpHome := t.TempDir()\n719\t\tt.Setenv(\"HOME\", tmpHome)\n720\t\n721\t\tbase := filepath.Join(tmpHome, \".claude\", \"projects\", \"proj\")\n722\t\tif err := os.MkdirAll(base, 0o755); err != nil {\n723\t\t\tt.Fatalf(\"mkdir: %v\", err)\n724\t\t}\n725\t\t// A file with a traversal-shaped name exists; the resolver must NOT match it.\n726\t\ttraversalID := \"../../etc/passwd\"\n727\t\treported := filepath.Join(tmpHome, \".claude\", \"projects\", \"proj\", \"missing.jsonl\")\n728\t\n729\t\tag := &ClaudeCodeAgent{}\n730\t\tgot := ag.resolveTranscriptPath(reported, traversalID)\n731\t\t