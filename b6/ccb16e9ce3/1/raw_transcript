tx, state.SessionID)\n96\t\t\t\t\tcontinue\n97\t\t\t\t}\n98\t\t\t}\n99\t\n100\t\t\tstates = append(states, state)\n101\t\t}\n102\t\treturn states, nil\n103\t}\n104\t\n105\t// isWarnableStaleEndedSession reports whether an ENDED session is still both\n106\t// expensive in PostCommit and actionable via 'entire doctor'.\n107\tfunc isWarnableStaleEndedSession(repo *git.Repository, state *SessionState) bool {\n108\t\tif state.Phase != session.PhaseEnded || state.FullyCondensed || state.StepCount <= 0 {\n109\t\t\treturn false\n110\t\t}\n111\t\n112\t\t// Re-check shadow branch existence even though listAllSessionStates already\n113\t\t// filters orphaned sessions. This is intentional: PostCommit deletes shadow\n114\t\t// branches during condensation, so a branch that existed at list-load time\n115\t\t// may be gone by the time we reach the warning check. Without this re-check\n116\t\t// we would warn about sessions that this commit just cleaned up.\n117\t\tshadowBranch := getShadowBranchNameForCommit(state.BaseCommit, state.WorktreeID)\n118\t\trefName := plumbing.NewBranchReferenceName(shadowBranch)\n119\t\t_, err := repo.Reference(refName, true)\n120\t\treturn err == nil\n121\t}\n122\t\n123\t// countWarnableStaleEndedSessions returns the number of ENDED sessions that\n124\t// still remain slow and fixable after PostCommit finishes processing.\n125\tfunc countWarnableStaleEndedSessions(repo *git.Repository, sessions []*SessionState) int {\n126\t\tn := 0\n127\t\tfor _, state := range sessions {\n128\t\t\tif isWarnableStaleEndedSession(repo, state) {\n129\t\t\t\tn++\n130\t\t\t}\n131\t\t}\n132\t\treturn n\n133\t}\n134\t\n135\t// findSessionsForWorktree finds all sessions for the given worktree path.\n136\t//\n137\t// When invoked from a linked worktree (where the current worktree differs from\n138\t// the main worktree resolved via git --git-common-dir), sessions registered\n139\t// against the main worktree are also returned. Agent-managed worktrees — like\n140\t// Claude Code's .claude/worktrees/<branch> feature — spawn a sub-process that\n141\t// inherits a session whose UserPromptSubmit fired in the main worktree; the\n142\t// hook handler must still be able to find that session when prepare-commit-msg\n143\t// / post-commit / etc. run from inside the linked worktree at commit time.\n144\t//\n145\t// Sessions registered against unrelated linked worktrees (e.g. a sibling\n146\t// worktree) are never returned: the widening is one-directional (linked →\n147\t// main), so commits in worktree A don't pick up sessions from worktree B.\n148\t// From the main worktree, behavior is unchanged: only sessions whose\n149\t// WorktreePath equals the main path are returned.\n150\tfunc (s *ManualCommitStrategy) findSessionsForWorktree(ctx context.Context, worktreePath string) ([]*SessionState, error) {\n151\t\tallStates, err := s.listAllSessionStates(ctx)\n152\t\tif err != nil {\n153\t\t\treturn nil, err\n154\t\t}\n155\t\n156\t\t// Resolve the main worktree path to decide whether to widen the match.\n157\t\t// Failure to resolve degrades gracefully to exact match — i.e. the prior\n158\t\t// behavior — so this fallback can't make any caller worse off.\n159\t\tmainPath := \"\"\n160\t\tif p, mainErr := paths.MainWorktreeRoot(ctx); mainErr == nil {\n161\t\t\tmainPath = p\n162\t\t}\n163\t\twidenToMain := mainPath != \"\" && mainPath != worktreePath\n164\t\n165\t\tvar matching []*SessionState\n166\t\tfor _, state := range allStates {\n167\t\t\tif state.WorktreePath == worktreePath {\n168\t\t\t\tmatching = append(matching, state)\n169\t\t\t\tcontinue\n170\t\t\t}\n171\t\t\tif widenToMain && state.WorktreePath == mainPath {\n172\t\t\t\tmatching = append(matching, state)\n173\t\t\t}\n174\t\t}\n175\t\treturn matching, nil\n176\t}\n177\t\n178\ttype rewritePair struct {\n179\t\tOldSHA string\n180\t\tNewSHA string\n181\t}\n182\t\n183\tfunc remapRewriteSHA(sha string, rewrites []rewritePair) (string, bool) {\n184\t\tfor _, pair := range rewrites {\n185\t\t\tif sha == pair.OldSHA {\n186\t\t\t\treturn pair.NewSHA, true\n187\t\t\t}\n188\t\t}\n189\t\treturn sha, false\n190\t}\n191\t\n192\tfunc shadowBranchExistsForBaseCommit(repo *git.Repository, baseCommit, worktreeID string) bool {\n193\t\tif repo == nil || baseCommit == \"\" {\n194\t\t\treturn false\n195\t\t}\n196\t\n197\t\trefName := plumbing.NewBranchReferenceName(checkpoint.ShadowBranchNameForCommit(baseCommit, worktreeID))\n198\t\t_, err := repo.Reference(refName, true)\n199\t\treturn err == nil\n200\t}\n201\t\n202\tfunc (s *ManualCommitStrategy) remapSessionForRewrite(ctx context.Context, repo *git.Repository, state *SessionState, rewrites []rewritePair) (bool, error) {\n203\t\tif state == nil {\n204\t\t\treturn false, nil\n205\t\t}\n206\t\n207\t\tnewBaseCommit, baseChanged := remapRewriteSHA(state.BaseCommit, rewrites)\n208\t\tnewAttrBaseCommit, attrChanged := remapRewriteSHA(state.AttributionBaseCommit, rewrites)\n209\t\tif !baseChanged && !attrChanged {\n210\t\t\treturn false, nil\n211\t\t}\n212\t\n213\t\thadShadowBranch := shadowBranchExistsForBaseCommit(repo, state.BaseCommit, state.WorktreeID)\n214\t\tif baseChanged {\n215\t\t\tchanged, err := s.migrateShadowBranchToBaseCommit(ctx, repo, state, newBaseCommit)\n216\t\t\tif err != nil {\n217\t\t\t\treturn false, fmt.Errorf(\"failed to migrate rewritten shadow branch: %w\", err)\n218\t\t\t}\n219\t\t\tbaseChanged = changed\n220\t\t}\n221\t\n222\t\t// If a shadow branch existed, preserve AttributionBaseCommit so future\n223\t\t// attribution still diffs against the original checkpoint base captured on\n224\t\t// that branch. Without a shadow branch, keep attribution in sync with the\n225\t\t// rewritten commit lineage.\n226\t\tif attrChanged && !hadShadowBranch {\n227\t\t\tstate.AttributionBaseCommit = newAttrBaseCommit\n228\t\t}\n229\t\n230\t\treturn baseChanged || attrChanged, nil\n231\t}\n232\t\n233\t// findSessionsForCommit finds all sessions where base_commit matches the given SHA.\n234\tfunc (s *ManualCommitStrategy) findSessionsForCommit(ctx context.Context, baseCommitSHA string) ([]*SessionState, error) {\n235\t\tallStates, err := s.listAllSessionStates(ctx)\n236\t\tif err != nil {\n237\t\t\treturn nil, err\n238\t\t}\n239\t\n240\t\tvar matching []*SessionState\n241\t\tfor _, state := range allStates {\n242\t\t\tif state.BaseCommit == baseCommitSHA {\n243\t\t\t\tmatching = append(matching, state)\n244\t\t\t}\n245\t\t}\n246\t\treturn matching, nil\n247\t}\n248\t\n249\t// FindSessionsForCommit is the exported version of findSessionsForCommit.\n250\t// Used by the rewind reset command to find sessions to clean up.\n251\tfunc (s *ManualCommitStrategy) FindSessionsForCommit(ctx context.Context, baseCommitSHA string) ([]*SessionState, error) {\n252\t\treturn s.findSessionsForCommit(ctx, baseCommitSHA)\n253\t}\n254\t\n255\t// ClearSessionState is the exported version of clearSessionState.\n256\t// Used by the rewind reset command to clean up session state files.\n257\tfunc (s *ManualCommitStrategy) ClearSessionState(ctx context.Context, sessionID string) error {\n258\t\treturn s.clearSessionState(ctx, sessionID)\n259\t}\n260\t\n261\t// CountOtherActiveSessionsWithCheckpoints counts how many other active sessions\n262\t// from the SAME worktree (different from currentSessionID) have created checkpoints\n263\t// on the SAME base commit (current HEAD). This is used to show an informational message\n264\t// about concurrent sessions that will be included in the next commit.\n265\t// Returns 0, nil if no such sessions exist.\n266\tfunc (s *ManualCommitStrategy) CountOtherActiveSessionsWithCheckpoints(ctx context.Context, currentSessionID string) (int, error) {\n267\t\tcurrentWorktree, err := paths.WorktreeRoot(ctx)\n268\t\tif err != nil {\n269\t\t\treturn 0, fmt.Errorf(\"failed to get worktree root: %w\", err)\n270\t\t}\n271\t\n272\t\t// Get current HEAD to compare with session base commits\n273\t\trepo, err := OpenRepository(ctx)\n274\t\tif err != nil {\n275\t\t\treturn 0, err\n276\t\t}\n277\t\thead, err := repo.Head()\n278\t\tif err != nil {\n279\t\t\treturn 0, fmt.Errorf(\"failed to get HEAD: %w\", err)\n280\t\t}\n281\t\tcurrentHead := head.Hash().String()\n282\t\n283\t\tallStates, err := s.listAllSessionStates(ctx)\n284\t\tif err != nil {\n285\t\t\treturn 0, err\n286\t\t}\n287\t\n288\t\tcount := 0\n289\t\tfor _, state := range allStates {\n290\t\t\t// Only consider sessions from the same worktree with checkpoints\n291\t\t\t// AND based on the same commit (current HEAD)\n292\t\t\t// Sessions from different base commits are independent and shouldn't be counted\n293\t\t\tif state.SessionID != currentSessionID &&\n294\t\t\t\tstate.WorktreePath == currentWorktree &&\n295\t\t\t\tstate.StepCount > 0 &&\n296\t\t\t\tstate.BaseCommit == currentHead {\n297\t\t\t\tcount++\n298\t\t\t}\n299\t\t}\n300\t\treturn count, nil\n301\t}\n302\t\n303\t// initializeSession creates a new session state or updates a partial one.\n304\t// A partial state may exist if the concurrent session warning was shown.\n305\t// agentType is the human-readable name of the agent (e.g., \"Claude Code\").\n306\t// transcriptPath is the path to the live transcript file (for mid-session commit detection).\n307\t// userPrompt is the user's prompt text (stored truncated as LastPrompt for display).\n308\t// model is the LLM model identifier (e.g., \"claude-sonnet-4-20250514\"); empty if unknown.\n309\tfunc (s *ManualCommitStrategy) initializeSession(ctx context.Context, repo *git.Repository, sessionID string, agentType types.AgentType, transcriptPath string, userPrompt string, model string) (*SessionState, error) {\n310\t\thead, err := repo.Head()\n311\t\tif err != nil {\n312\t\t\treturn nil, fmt.Errorf(\"failed to get HEAD: %w\", err)\n313\t\t}\n314\t\n315\t\tworktreePath, err := paths.WorktreeRoot(ctx)\n316\t\tif err != nil {\n317\t\t\treturn nil, fmt.Errorf(\"failed to get worktree path: %w\", err)\n318\t\t}\n319\t\n320\t\t// Get worktree ID for shadow branch naming\n321\t\tworktreeID, err := paths.GetWorktreeID(worktreePath)\n322\t\tif err != nil {\n323\t\t\treturn nil, fmt.Errorf(\"failed to get worktree ID: %w\", err)\n324\t\t}\n325\t\n326\t\t// Capture untracked files at session start to preserve them during rewind\n327\t\tuntrackedFiles, err := collectUntrackedFiles(ctx)\n328\t\tif err != nil {\n329\t\t\t// Non-fatal: continue even if we can't collect untracked files\n330\t\t\tuntrackedFiles = nil\n331\t\t}\n332\t\n333\t\t// Generate TurnID for the first turn\n334\t\tturnID, err := id.Generate()\n335\t\tif err != nil {\n336\t\t\treturn nil, fmt.Errorf(\"failed to generate turn ID: %w\", err)\n337\t\t}\n338\t\n339\t\tnow := time.Now()\n340\t\theadHash := head.Hash().String()\n341\t\tstate := &SessionState{\n342\t\t\tSessionID:             sessionID,\n343\t\t\tCLIVersion:            versioninfo.Version,\n344\t\t\tBaseCommit:            headHash,\n345\t\t\tAttributionBaseCommit: headHash,\n346\t\t\tWorktreePath:          worktreePath,\n347\t\t\tWorktreeID:            worktreeID,\n348\t\t\tStartedAt:             now,\n349\t\t\tLastInteractionTime:   &now,\n350\t\t\tTurnID:                turnID.String(),\n351\t\t\tStepCount:             0,\n352\t\t\tUntrackedFilesAtStart: untrackedFiles,\n353\t\t\tAgentType:             agentType,\n354\t\t\tModelName:             model,\n355\t\t\tTranscriptPath:        transcriptPath,\n356\t\t\tLastPrompt:            truncatePromptForStorage(userPrompt),\n357\t\t}\n358\t\n359\t\tif err := s.saveSessionState(ctx, state); err != nil {\n360\t\t\treturn nil, err\n361\t\t}\n362\t\n363\t\treturn state, nil\n364\t}\n365\t\n366\t// getShadowBranchNameForCommit returns the shadow branch name for the given base commit and worktree ID.\n367\t// worktreeID should be empty for the main worktree or the internal git worktree name for linked worktrees.\n368\tfunc getShadowBranchNameForCommit(baseCommit, worktreeID string) string {\n369\t\treturn checkpoint.ShadowBranchNameForCommit(baseCommit, worktreeID)\n370\t}\n371\t"}]},"uuid":"abd7c18e-057a-4964-bcf7-ae8d49f5441c","timestamp":"2026-05-11T14:09:17.210Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/strategy/manual_commit_session.go","content":"package strategy\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/session\"\n\t\"github.com/entireio/cli/cmd/entire/cli/versioninfo\"\n\n\t\"github.com/go-git/go-git/v6\"\n\t\"github.com/go-git/go-git/v6/plumbing\"\n)\n\n// Shadow strategy session state methods.\n// Uses session.StateStore for persistence.\n\n// loadSessionState loads session state using the StateStore.\nfunc (s *ManualCommitStrategy) loadSessionState(ctx context.Context, sessionID string) (*SessionState, error) {\n\tstore, err := s.getStateStore(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tstate, err := store.Load(ctx, sessionID)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to load session state: %w\", err)\n\t}\n\treturn state, nil\n}\n\n// saveSessionState saves session state using the StateStore.\nfunc (s *ManualCommitStrategy) saveSessionState(ctx context.Context, state *SessionState) error {\n\tstore, err := s.getStateStore(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := store.Save(ctx, state); err != nil {\n\t\treturn fmt.Errorf(\"failed to save session state: %w\", err)\n\t}\n\treturn nil\n}\n\n// clearSessionState clears session state using the StateStore.\nfunc (s *ManualCommitStrategy) clearSessionState(ctx context.Context, sessionID string) error {\n\tstore, err := s.getStateStore(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := store.Clear(ctx, sessionID); err != nil {\n\t\treturn fmt.Errorf(\"failed to clear session state: %w\", err)\n\t}\n\treturn nil\n}\n\n// listAllSessionStates returns all active session states.\n// It filters out orphaned sessions whose shadow branch no longer exists.\nfunc (s *ManualCommitStrategy) listAllSessionStates(ctx context.Context) ([]*SessionState, error) {\n\tstore, err := s.getStateStore(ctx)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get state store: %w\", err)\n\t}\n\n\tsessionStates, err := store.List(ctx)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to list session states: %w\", err)\n\t}\n\n\tif len(sessionStates) == 0 {\n\t\treturn nil, nil\n\t}\n\n\trepo, err := OpenRepository(ctx)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to open git repository: %w\", err)\n\t}\n\n\tvar states []*SessionState\n\tfor _, sessionState := range sessionStates {\n\t\tstate := sessionState\n\n\t\t// Skip and cleanup orphaned sessions whose shadow branch no longer exists.\n\t\t// Keep active sessions (shadow branch may not be created yet) and sessions\n\t\t// with LastCheckpointID (needed for checkpoint ID reuse on subsequent commits).\n\t\t// Clean up everything else: stale pre-state-machine sessions (empty phase),\n\t\t// IDLE/ENDED sessions that were never condensed, etc.\n\t\tshadowBranch := getShadowBranchNameForCommit(state.BaseCommit, state.WorktreeID)\n\t\trefName := plumbing.NewBranchReferenceName(shadowBranch)\n\t\tif _, err := repo.Reference(refName, true); err != nil {\n\t\t\tif !state.Phase.IsActive() && state.LastCheckpointID.IsEmpty() {\n\t\t\t\t//nolint:errcheck,gosec // G104: Cleanup is best-effort, shouldn't fail the list operation\n\t\t\t\tstore.Clear(ctx, state.SessionID)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\n\t\tstates = append(states, state)\n\t}\n\treturn states, nil\n}\n\n// isWarnableStaleEndedSession reports whether an ENDED session is still both\n// expensive in PostCommit and actionable via 'entire doctor'.\nfunc isWarnableStaleEndedSession(repo *git.Repository, state *SessionState) bool {\n\tif state.Phase != session.PhaseEnded || state.FullyCondensed || state.StepCount <= 0 {\n\t\treturn false\n\t}\n\n\t// Re-check shadow branch existence even though listAllSessionStates already\n\t// filters orphaned sessions. This is intentional: PostCommit deletes shadow\n\t// branches during condensation, so a branch that existed at list-load time\n\t// may be gone by the time we reach the warning check. Without this re-check\n\t// we would warn about sessions that this commit just cleaned up.\n\tshadowBranch := getShadowBranchNameForCommit(state.BaseCommit, state.WorktreeID)\n\trefName := plumbing.NewBranchReferenceName(shadowBranch)\n\t_, err := repo.Reference(refName, true)\n\treturn err == nil\n}\n\n// countWarnableStaleEndedSessions returns the number of ENDED sessions that\n// still remain slow and fixable after PostCommit finishes processing.\nfunc countWarnableStaleEndedSessions(repo *git.Repository, sessions []*SessionState) int {\n\tn := 0\n\tfor _, state := range sessions {\n\t\tif isWarnableStaleEndedSession(repo, state) {\n\t\t\tn++\n\t\t}\n\t}\n\treturn n\n}\n\n// findSessionsForWorktree finds all sessions for the given worktree path.\n//\n// When invoked from a linked worktree (where the current worktree differs from\n// the main worktree resolved via git --git-common-dir), sessions registered\n// against the main worktree are also returned. Agent-managed worktrees — like\n// Claude Code's .claude/worktrees/<branch> feature — spawn a sub-process that\n// inherits a session whose UserPromptSubmit fired in the main worktree; the\n// hook handler must still be able to find that session when prepare-commit-msg\n// / post-commit / etc. run from inside the linked worktree at commit time.\n//\n// Sessions registered against unrelated linked worktrees (e.g. a sibling\n// worktree) are never returned: the widening is one-directional (linked →\n// main), so commits in worktree A don't pick up sessions from worktree B.\n// From the main worktree, behavior is unchanged: only sessions whose\n// WorktreePath equals the main path are returned.\nfunc (s *ManualCommitStrategy) findSessionsForWorktree(ctx context.Context, worktreePath string) ([]*SessionState, error) {\n\tallStates, err := s.listAllSessionStates(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\t// Resolve the main worktree path to decide whether to widen the match.\n\t// Failure to resolve degrades gracefully to exact match — i.e. the prior\n\t// behavior — so this fallback can't make any caller worse off.\n\tmainPath := \"\"\n\tif p, mainErr := paths.MainWorktreeRoot(ctx); mainErr == nil {\n\t\tmainPath = p\n\t}\n\twidenToMain := mainPath != \"\" && mainPath != worktreePath\n\n\tvar matching []*SessionState\n\tfor _, state := range allStates {\n\t\tif state.WorktreePath == worktreePath {\n\t\t\tmatching = append(matching, state)\n\t\t\tcontinue\n\t\t}\n\t\tif widenToMain && state.WorktreePath == mainPath {\n\t\t\tmatching = append(matching, state)\n\t\t}\n\t}\n\treturn matching, nil\n}\n\ntype rewritePair struct {\n\tOldSHA string\n\tNewSHA string\n}\n\nfunc remapRewriteSHA(sha string, rewrites []rewritePair) (string, bool) {\n\tfor _, pair := range rewrites {\n\t\tif sha == pair.OldSHA {\n\t\t\treturn pair.NewSHA, true\n\t\t}\n\t}\n\treturn sha, false\n}\n\nfunc shadowBranchExistsForBaseCommit(repo *git.Repository, baseCommit, worktreeID string) bool {\n\tif repo == nil || baseCommit == \"\" {\n\t\treturn false\n\t}\n\n\trefName := plumbing.NewBranchReferenceName(checkpoint.ShadowBranchNameForCommit(baseCommit, worktreeID))\n\t_, err := repo.Reference(refName, true)\n\treturn err == nil\n}\n\nfunc (s *ManualCommitStrategy) remapSessionForRewrite(ctx context.Context, repo *git.Repository, state *SessionState, rewrites []rewritePair) (bool, error) {\n\tif state == nil {\n\t\treturn false, nil\n\t}\n\n\tnewBaseCommit, baseChanged := remapRewriteSHA(state.BaseCommit, rewrites)\n\tnewAttrBaseCommit, attrChanged := remapRewriteSHA(state.AttributionBaseCommit, rewrites)\n\tif !baseChanged &