ionID)\n203\t\t}\n204\t\tif event.ToolUseID != \"toolu_abc123\" {\n205\t\t\tt.Errorf(\"expected tool_use_id 'toolu_abc123', got %q\", event.ToolUseID)\n206\t\t}\n207\t\tif event.ToolInput == nil {\n208\t\t\tt.Error(\"expected tool_input to be set\")\n209\t\t}\n210\t}\n211\t\n212\tfunc TestParseHookEvent_SubagentEnd(t *testing.T) {\n213\t\tt.Parallel()\n214\t\n215\t\tag := &ClaudeCodeAgent{}\n216\t\tinputData := map[string]any{\n217\t\t\t\"session_id\":      \"main-session\",\n218\t\t\t\"transcript_path\": \"/tmp/main.jsonl\",\n219\t\t\t\"tool_use_id\":     \"toolu_xyz789\",\n220\t\t\t\"tool_input\":      json.RawMessage(`{\"prompt\": \"task done\"}`),\n221\t\t\t\"tool_response\": map[string]string{\n222\t\t\t\t\"agentId\": \"agent-subagent-001\",\n223\t\t\t},\n224\t\t}\n225\t\tinputBytes, marshalErr := json.Marshal(inputData)\n226\t\tif marshalErr != nil {\n227\t\t\tt.Fatalf(\"failed to marshal test input: %v\", marshalErr)\n228\t\t}\n229\t\n230\t\tevent, err := ag.ParseHookEvent(context.Background(), HookNamePostTask, strings.NewReader(string(inputBytes)))\n231\t\n232\t\tif err != nil {\n233\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n234\t\t}\n235\t\trequire.NotNil(t, event, \"expected event, got nil\")\n236\t\tif event.Type != agent.SubagentEnd {\n237\t\t\tt.Errorf(\"expected event type %v, got %v\", agent.SubagentEnd, event.Type)\n238\t\t}\n239\t\tif event.ToolUseID != \"toolu_xyz789\" {\n240\t\t\tt.Errorf(\"expected tool_use_id 'toolu_xyz789', got %q\", event.ToolUseID)\n241\t\t}\n242\t\tif event.SubagentID != \"agent-subagent-001\" {\n243\t\t\tt.Errorf(\"expected subagent_id 'agent-subagent-001', got %q\", event.SubagentID)\n244\t\t}\n245\t}\n246\t\n247\tfunc TestParseHookEvent_SubagentEnd_NoAgentID(t *testing.T) {\n248\t\tt.Parallel()\n249\t\n250\t\tag := &ClaudeCodeAgent{}\n251\t\tinputData := map[string]any{\n252\t\t\t\"session_id\":      \"main-session\",\n253\t\t\t\"transcript_path\": \"/tmp/main.jsonl\",\n254\t\t\t\"tool_use_id\":     \"toolu_no_agent\