ng tag, worktree path\n97\t// mismatch, BaseCommit mismatch, StartedAt window, or AgentType mismatch.\n98\t//\n99\t// The diagnostic surfaces in the user-facing warning printed by\n100\t// warnManifestNotWritten when the manifest has no sources, so the user can\n101\t// distinguish a true env-handshake failure from one of the four other\n102\t// post-tag filter rejections.\n103\t//\n104\t// Filter precedence in this function matches matchReviewSessionState so the\n105\t// reported cause aligns with what the matcher actually decided.\n106\tfunc explainEmptyManifest(\n107\t\tworktreeRoot string,\n108\t\theadSHA string,\n109\t\tsummary reviewtypes.RunSummary,\n110\t\tstates []*session.State,\n111\t) string {\n112\t\tif len(states) == 0 {\n113\t\t\treturn \"no session states found (lifecycle hook never created session state for any agent in this run)\"\n114\t\t}\n115\t\ttagged := make([]*session.State, 0, len(states))\n116\t\tfor _, st := range states {\n117\t\t\tif st != nil && st.Kind == session.KindAgentReview {\n118\t\t\t\ttagged = append(tagged, st)\n119\t\t\t}\n120\t\t}\n121\t\tif len(tagged) == 0 {\n122\t\t\treturn fmt.Sprintf(\"found %d session state(s) but none tagged as a review session (env-var handshake did not reach the hook)\", len(states))\n123\t\t}\n124\t\t// At least one tagged session exists. Check each post-tag filter against\n125\t\t// any one of the run's agents — we just need one representative cause.\n126\t\t// Pick the first agent in summary.AgentRuns since they all share the\n127\t\t// same worktree/SHA/StartedAt window.\n128\t\tvar runName string\n129\t\tif len(summary.AgentRuns) > 0 {\n130\t\t\trunName = summary.AgentRuns[0].Name\n131\t\t}\n132\t\twantType := agentTypeForReviewAgent(runName)\n133\t\tfor _, st := range tagged {\n134\t\t\tif worktreeRoot != \"\" && st.WorktreePath != \"\" && st.WorktreePath != worktreeRoot {\n135\t\t\t\treturn fmt.Sprintf(\"found %d tagged review session(s) but worktree path mismatch: state=%q, run=%q\", len(tagged), st.WorktreePath, worktreeRoot)\n136\t\t\t}\n137\t\t}\n138\t\tfor _, st := range tagged {\n139\t\t\tif headSHA != \"\" && st.BaseCommit != \"\" && st.BaseCommit != headSHA {\n140\t\t\t\treturn fmt.Sprintf(\"found %d tagged review session(s) but BaseCommit mismatch: state=%q, run=%q (HEAD moved between review start and first agent turn?)\", len(tagged), st.BaseCommit, headSHA)\n141\t\t\t}\n142\t\t}\n143\t\tfor _, st := range tagged {\n144\t\t\tif !summary.StartedAt.IsZero() && st.StartedAt.Before(summary.StartedAt.Add(-5*time.Second)) {\n145\t\t\t\treturn fmt.Sprintf(\"found %d tagged review session(s) but they started before the review run window (stale session state from a prior run?)\", len(tagged))\n146\t\t\t}\n147\t\t}\n148\t\tfor _, st := range tagged {\n149\t\t\tif wantType != \"\" && st.AgentType != \"\" && st.AgentType != wantType {\n150\t\t\t\treturn fmt.Sprintf(\"found %d tagged review session(s) but AgentType mismatch: state=%q, run=%q\", len(tagged), st.AgentType, wantType)\n151\t\t\t}\n152\t\t}\n153\t\treturn fmt.Sprintf(\"found %d tagged review session(s) but matcher rejected all of them (no filter explained the rejection — please report this as a bug)\", len(tagged))\n154\t}\n155\t\n156\tfunc matchReviewSessionState(\n157\t\tworktreeRoot string,\n158\t\theadSHA string,\n159\t\trunStartedAt time.Time,\n160\t\tagentName string,\n161\t\tstates []*session.State,\n162\t\tused map[string]bool,\n163\t) *session.State {\n164\t\twantAgentType := agentTypeForReviewAgent(agentName)\n165\t\tvar best *session.State\n166\t\tfor _, st := range states {\n167\t\t\tif st == nil || used[st.SessionID] || st.Kind != session.KindAgentReview {\n168\t\t\t\tcontinue\n169\t\t\t}\n170\t\t\tif worktreeRoot != \"\" && st.WorktreePath != \"\" && st.WorktreePath != worktreeRoot {\n171\t\t\t\tcontinue\n172\t\t\t}\n173\t\t\tif headSHA != \"\" && st.BaseCommit != \"\" && st.BaseCommit != headSHA {\n174\t\t\t\tcontinue\n175\t\t\t}\n176\t\t\tif !runStartedAt.IsZero() && st.StartedAt.Before(runStartedAt.Add(-5*time.Second)) {\n177\t\t\t\tcontinue\n178\t\t\t}\n179\t\t\tif wantAgentType != \"\" && st.AgentType != \"\" && st.AgentType != wantAgentType {\n180\t\t\t\tcontinue\n181\t\t\t}\n182\t\t\tif best == nil || st.StartedAt.After(best.StartedAt) {\n183\t\t\t\tbest = st\n184\t\t\t}\n185\t\t}\n186\t\treturn best\n187\t}\n188\t\n189\tfunc agentTypeForReviewAgent(agentName string) agenttypes.AgentType {\n190\t\tag, err := agent.Get(agenttypes.AgentName(agentName))\n191\t\tif err != nil {\n192\t\t\treturn \"\"\n193\t\t}\n194\t\treturn ag.Type()\n195\t}\n196\t\n197\tfunc labelForReviewAgent(agentName string) string {\n198\t\tif typ := agentTypeForReviewAgent(agentName); typ != \"\" {\n199\t\t\treturn string(typ)\n200\t\t}\n201\t\treturn agentName\n202\t}\n203\t\n204\tfunc agentRunOutput(run reviewtypes.AgentRun) string {\n205\t\tif narrative := joinAssistantText(run.Buffer); narrative != \"\" {\n206\t\t\treturn narrative\n207\t\t}\n208\t\tif run.Err != nil {\n209\t\t\treturn \"Failed: \" + run.Err.Error()\n210\t\t}\n211\t\treturn \"\"\n212\t}\n213\t\n214\tfunc writeLocalReviewManifest(ctx context.Context, manifest LocalReviewManifest) error {\n215\t\tif len(manifest.Sources) == 0 {\n216\t\t\treturn errors.New(\"review manifest has no sources\")\n217\t\t}\n218\t\tif manifest.Version == 0 {\n219\t\t\tmanifest.Version = localReviewManifestVersion\n220\t\t}\n221\t\tif manifest.CreatedAt.IsZero() {\n222\t\t\tmanifest.CreatedAt = time.Now()\n223\t\t}\n224\t\n225\t\tdir, err := localReviewManifestDir(ctx)\n226\t\tif err != nil {\n227\t\t\treturn err\n228\t\t}\n229\t\tif err := os.MkdirAll(dir, 0o700); err != nil {\n230\t\t\treturn fmt.Errorf(\"create review manifest dir: %w\", err)\n231\t\t}\n232\t\n233\t\tb, err := json.MarshalIndent(manifest, \"\", \"  \")\n234\t\tif err != nil {\n235\t\t\treturn fmt.Errorf(\"encode review manifest: %w\", err)\n236\t\t}\n237\t\tpath := filepath.Join(dir, localReviewManifestFilename(manifest))\n238\t\tif err := os.WriteFile(path, b, 0o600); err != nil {\n239\t\t\treturn fmt.Errorf(\"write review manifest: %w\", err)\n240\t\t}\n241\t\treturn nil\n242\t}\n243\t\n244\tfunc resolveLocalReviewManifestBySessionID(ctx context.Context, worktreeRoot, sessionID string) (LocalReviewManifest, ManifestSource, error) {\n245\t\tmanifests, err := loadLocalReviewManifests(ctx, worktreeRoot)\n246\t\tif err != nil {\n247\t\t\treturn LocalReviewManifest{}, ManifestSource{}, err\n248\t\t}\n249\t\n250\t\tvar (\n251\t\t\tmatches       []LocalReviewManifest\n252\t\t\tsourceMatches []ManifestSource\n253\t\t)\n254\t\tfor _, manifest := range manifests {\n255\t\t\tfor _, source := range manifest.Sources {\n256\t\t\t\tif source.SessionID == sessionID || strings.HasPrefix(source.SessionID, sessionID) {\n257\t\t\t\t\tmatches = append(matches, manifest)\n258\t\t\t\t\tsourceMatches = append(sourceMatches, source)\n259\t\t\t\t\tbreak\n260\t\t\t\t}\n261\t\t\t}\n262\t\t}\n263\t\tswitch len(matches) {\n264\t\tcase 0:\n265\t\t\treturn LocalReviewManifest{}, ManifestSource{}, fmt.Errorf(\"review session %q not found\", sessionID)\n266\t\tcase 1:\n267\t\t\treturn matches[0], sourceMatches[0], nil\n268\t\tdefault:\n269\t\t\treturn LocalReviewManifest{}, ManifestSource{}, fmt.Errorf(\"review session prefix %q is ambiguous\", sessionID)\n270\t\t}\n271\t}\n272\t\n273\tfunc loadLocalReviewManifests(ctx context.Context, worktreeRoot string) ([]LocalReviewManifest, error) {\n274\t\tdir, err := localReviewManifestDir(ctx)\n275\t\tif err != nil {\n276\t\t\treturn nil, err\n277\t\t}\n278\t\tentries, err := os.ReadDir(dir)\n279\t\tif errors.Is(err, os.ErrNotExist) {\n280\t\t\treturn nil, nil\n281\t\t}\n282\t\tif err != nil {\n283\t\t\treturn nil, fmt.Errorf(\"read review manifest dir: %w\", err)\n284\t\t}\n285\t\n286\t\tmanifests := make([]LocalReviewManifest, 0, len(entries))\n287\t\tfor _, entry := range entries {\n288\t\t\tif entry.IsDir() || filepath.Ext(entry.Name()) != \".json\" {\n289\t\t\t\tcontinue\n290\t\t\t}\n291\t\t\tb, 