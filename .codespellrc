[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip = .git*,go.sum,.codespellrc,.npm,.cache
check-hidden = true
# Ignore camelCase and PascalCase identifiers (common in Go code)
ignore-regex = \b[a-z]+[A-Z]\w*\b|\b[A-Z][a-z]+[A-Z]\w*\b
# strat - variable abbreviation for "strategy" (not "start" or "strata")
# decorder - golangci-lint linter name (not "decoder")
ignore-words-list = strat,decorder
