#!/bin/bash
#MISE description="Generate Windows PE VERSIONINFO resources (.syso) for entire and git-remote-entire"
#MISE quiet=true

set -euo pipefail

version="${1:?usage: mise run winres <version>}"

base="${version%%-*}"
IFS='.' read -r major minor patch <<<"$base"
major="${major:-0}"
minor="${minor:-0}"
patch="${patch:-0}"

build=0
version_string="$version"
case "$version" in
*-nightly.*)
    # Nightly tags end in the commit: 0.10.7-nightly.<stamp>.<short sha>.
    sha="${version##*.}"
    if [[ ! "$sha" =~ ^[0-9a-f]{4,}$ ]]; then
        echo "winres: no commit sha at the end of nightly version '$version'" >&2
        exit 1
    fi
    # The fourth VERSIONINFO field is a uint16, so it carries the first four
    # hex digits of that commit (81a05d785 -> 0x81a0 -> 33184). That is enough
    # to tell apart the nightlies sharing one patch version — roughly a release
    # cycle's worth, under 1% chance of a clash — and it points straight back at
    # a commit, which a timestamp would not. Ordering is deliberately not a
    # property here: nothing compares these numerically, and the whole tag is in
    # the FileVersion string either way. Stable releases keep build 0.
    build=$((16#${sha:0:4}))
    # Lead the version string with the same four components as the fixed
    # fields. goversioninfo parses the string's leading x.y.z[.w] and warns on
    # every invocation when it disagrees with them — and it always disagrees
    # once the fourth field is non-zero. It also ties the bare 33184 that
    # Explorer's "File version" row shows back to the commit beside it.
    version_string="$major.$minor.$patch.$build-${version#*-}"
    ;;
esac

# goversioninfo does not range-check these fields. It packs them as "%04x%04x"
# and parses the result as a uint32, so a value above 65535 silently shifts into
# the patch field (-ver-build 20260920 yields 0.10.28981.10296) rather than
# failing the release.
for field in major minor patch build; do
    value="${!field}"
    if ((value < 0 || value > 65535)); then
        echo "winres: $field=$value is outside the uint16 VERSIONINFO range (0-65535)" >&2
        exit 1
    fi
done

generate() {
    local pkg="$1" desc="$2" original_name="$3"
    local common_flags=(
        -company "Entire"
        -copyright "Copyright (c) 2026 Entire Inc."
        -description "$desc"
        -product-name "Entire CLI"
        -internal-name "$original_name"
        -original-name "$original_name"
        -ver-major "$major" -ver-minor "$minor" -ver-patch "$patch" -ver-build "$build"
        -product-ver-major "$major" -product-ver-minor "$minor" -product-ver-patch "$patch" -product-ver-build "$build"
        -file-version "$version_string"
        -product-version "$version_string"
    )
    goversioninfo -64 -arm=false -o "${pkg}/rsrc_windows_amd64.syso" "${common_flags[@]}" winres/versioninfo.json
    goversioninfo -64 -arm -o "${pkg}/rsrc_windows_arm64.syso" "${common_flags[@]}" winres/versioninfo.json
}

generate "cmd/entire" "Entire CLI" "entire.exe"
generate "cmd/git-remote-entire" "Git remote helper for entire:// URLs" "git-remote-entire.exe"
