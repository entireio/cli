#!/bin/sh
#MISE description="Lint for secret-shaped literals that remote push protection rejects"

# Some credential shapes are rejected by the forge on push, not merely flagged.
# GitHub push protection refuses an AWS Access Key ID outright, and because this
# repo stores its own agent transcripts as checkpoints and pushes them, one such
# literal in a test fixture reaches a transcript whenever someone edits redaction
# code — and the checkpoint carrying it is then refused on every push, forever.
#
# Fixtures must therefore assemble these values at runtime instead of spelling
# them out. See redact.awsKeyFixture in redact/redact_test.go.
#
# Only patterns the forge REFUSES belong here. Shapes it merely flags, or ones
# whose real tokens are checksum-validated so synthetic values never trip it
# (ghp_ and friends), are deliberately absent.

# --untracked: the file most likely to carry a new literal is the fixture that
# was just written and not yet staged, which a plain git grep never sees. Exit 1
# from git grep means no matches; anything above 1 is git itself failing, and
# a guard that passes because git failed is worse than no guard.
hits="$(git grep --untracked -InE 'AKIA[0-9A-Z]{16}' -- .)"
status=$?
if [ "$status" -gt 1 ]; then
  echo "git grep failed (exit $status)" >&2
  exit "$status"
fi

if [ -n "$hits" ]; then
  echo "Secret-shaped literals found that push protection will reject:"
  echo ""
  echo "$hits"
  echo ""
  echo "Assemble the value at runtime instead of inlining it."
  echo "See redact.awsKeyFixture in redact/redact_test.go."
  exit 1
fi
