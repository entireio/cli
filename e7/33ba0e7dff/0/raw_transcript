trip common suffixes: \"code\", \"cli\"\n\tfor _, suffix := range []string{\"code\", \"cli\"} {\n\t\tif len(lower) > len(suffix) && lower[len(lower)-len(suffix):] == suffix {\n\t\t\tstripped := lower[:len(lower)-len(suffix)]\n\t\t\tif id, ok := known[stripped]; ok {\n\t\t\t\treturn id\n\t\t\t}\n\t\t}\n\t}\n\n\t// Factory AI Droid\n\tif len(lower) >= 15 && lower[:15] == \"factoryaidroid\" {\n\t\treturn \"droid\"\n\t}\n\n\treturn \"unknown\"\n}\n\nfunc derefOr(p *int, def int) int {\n\tif p == nil {\n\t\treturn def\n\t}\n\treturn *p\n}\n","structuredPatch":[{"oldStart":189,"oldLines":8,"newStart":189,"newLines":12,"lines":["   run := 1","   longest = 1","   for i := 1; i < len(dates); i++ {","-    prev, _ := time.Parse(\"2006-01-02\", dates[i-1])","-    curr, _ := time.Parse(\"2006-01-02\", dates[i])","+    prev, errP := time.Parse(\"2006-01-02\", dates[i-1])","+    curr, errC := time.Parse(\"2006-01-02\", dates[i])","+    if errP != nil || errC != nil {","+      run = 1","+      continue","+    }","     if curr.Sub(prev).Hours() <= 25 { // 1 day with some tolerance","       run++","     } else {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"80ca14c6-bbb3-493c-9a5d-4835bf75b2e8","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"06af762d-fb18-426b-8b89-e1a11aba933b","version":"2.1.104","gitBranch":"soph/stats","slug":"adaptive-wiggling-lemon"}
