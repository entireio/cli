\t  // Longest streak\n57\t  const sortedDates = Array.from(datesWithActivity).sort()\n58\t  let streak = 0\n59\t  let run = 0\n60\t\n61\t  for (let i = 0; i < sortedDates.length; i++) {\n62\t    if (i === 0) {\n63\t      run = 1\n64\t    } else {\n65\t      const diffDays = differenceInCalendarDays(\n66\t        parseLocalDate(sortedDates[i]),\n67\t        parseLocalDate(sortedDates[i - 1]),\n68\t      )\n69\t      run = diffDays === 1 ? run + 1 : 1\n70\t    }\n71\t    if (run > streak) streak = run\n72\t  }\n73\t\n74\t  return { currentStreak, streak }\n75\t}\n76\t\n77\texport function computeStats(\n78\t  checkpoints: UserCheckpoint[],\n79\t  streaks: { currentStreak: number; streak: number } = { currentStreak: 0, streak: 0 },\n80\t): ContributionStats {\n81\t  if (checkpoints.length === 0) {\n82\t    return {\n83\t      tasks: 0,\n84\t      orchestration: 0,\n85\t      iteration: 0,\n86\t      throughput: 0,\n87\t      continuity: { hours: 0, ...streaks },\n88\t    }\n89\t  }\n90\t\n91\t  // Use || instead of ?? because checkpoints always have agent involvement.\n92\t  // A value of 0 or null indicates a CLI error, so we default to 1.\n93\t  const totalSteps = checkpoints.reduce((sum, cp) => sum + (cp.steps || 1), 0)\n94\t  const count = checkpoints.length\n95\t\n96\t  // orchestration = sum(steps) / (sum(steps) + count) * 100\n97\t  const orchestration = (totalSteps / (totalSteps + count)) * 100\n98\t\n99\t  // iteration = avg(sessionCount)\n100\t  const totalSessionCount = checkpoints.reduce((sum, cp) => sum + (cp.session_count || 1), 0)\n101\t  const iteration = totalSessionCount / count\n102\t\n103\t  // throughput = average total tokens per checkpoint (in thousands)\n104\t  const checkpointsWithTokens = checkpoints.filter(\n105\t    (cp) => cp.input_tokens != null || cp.output_tokens != null,\n106\t  )\n107\t  const totalTokens = checkpointsWithTokens.reduce(\n108\t    (sum, cp) => sum + (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0),\n109\t    0,\n110\t  )\n111\t  const throughput =\n112\t    checkpointsWithTokens.length > 0 ? totalTokens / checkpointsWithTokens.length / 1000 : 0\n113\t\n114\t  // continuity.hours = max(steps) * 2 / 60 (estimate: 2 min/step)\n115\t  const maxSteps = Math.max(...checkpoints.map((cp) => cp.steps || 1))\n116\t  const hours = (maxSteps * 2) / 60\n117\t\n118\t  return {\n119\t    tasks: count,\n120\t    orchestration: Math.round(orchestration),\n121\t    iteration: Math.round(iteration * 10) / 10,\n122\t    throughput,\n123\t    continuity: {\n124\t      hours: Math.round(hours * 10) / 10,\n125\t      ...streaks,\n126\t    },\n127\t  }\n128\t}\n129\t\n130\texport function computeChartData(checkpoints: UserCheckpoint[]): DailyContribution[] {\n131\t  // Group checkpoints by date\n132\t  const byDate = new Map<string, AgentContributions>()\n133\t\n134\t  for (const cp of checkpoints) {\n135\t    const date = toLocalDateString(cp.commit_date)\n136\t    if (!byDate.has(date)) {\n137\t      byDate.set(date, {\n138\t        claude: 0,\n139\t        gemini: 0,\n140\t        amp: 0,\n141\t        codex: 0,\n142\t        opencode: 0,\n143\t        copilot: 0,\n144\t        pi: 0,\n145\t        cursor: 0,\n146\t        droid: 0,\n147\t        kiro: 0,\n148\t        unknown: 0,\n149\t      })\n150\t    }\n151\t\n152\t    const agents = byDate.get(date)!\n153\t    // Add steps to the appropriate agent bucket\n154\t    const agentType = getAgentId(cp.agent)\n155\t    const steps = cp.steps || 1\n156\t    agents[agentType] += steps\n157\t  }\n158\t\n159\t  // Convert to array and sort by date\n160\t  const result: DailyContribution[] = []\n161\t  for (const [date, agents] of byDate) {\n162\t    result.push({ date, agents })\n163\t  }\n164\t  result.sort((a, b) => a.date.localeCompare(b.date))\n165\t\n166\t  return result\n167\t}\n168\t\n169\texport function computeHourlyChartData(checkpoints: UserCheckpoint[]): HourlyContribution[] {\n170\t  // Group checkpoints by date + hour + agent\n171\t  const b