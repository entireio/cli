\t\t\t\tseen[id] = struct{}{}\n386\t\t\t\t\tresult = append(result, id)\n387\t\t\t\t}\n388\t\t\t}\n389\t\t}\n390\t\t// Stable sort\n391\t\tsort.Strings(result)\n392\t\treturn result\n393\t}\n394\t\n395\tfunc formatCommitDate(dateStr string) string {\n396\t\tt, err := time.Parse(\"2006-01-02\", dateStr)\n397\t\tif err != nil {\n398\t\t\treturn dateStr\n399\t\t}\n400\t\tnow := time.Now().Local()\n401\t\ttoday := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())\n402\t\td := today.Sub(t)\n403\t\n404\t\tswitch {\n405\t\tcase d < 24*time.Hour:\n406\t\t\treturn t.Format(\"Monday 2 Jan\") + \" (today)\"\n407\t\tcase d < 48*time.Hour:\n408\t\t\treturn t.Format(\"Monday 2 Jan\") + \" (yesterday)\"\n409\t\tdefault:\n410\t\t\treturn t.Format(\"Monday 2 Jan\")\n411\t\t}\n412\t}\n413\t\n414\tfunc padOrTruncate(s string, width int) string {\n415\t\tif len(s) > width {\n416\t\t\treturn s[:width-1] + \"…\"\n417\t\t}\n418\t\treturn s + strings.Repeat(\" \", width-len(s))\n419\t}\n420\t"}]},"uuid":"b47d41d8-db67-422d-a5b1-ffe6940b059f","timestamp":"2026-04-21T14:14:31.082Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/stats_render.go","content":"package cli\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"math\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/charmbracelet/lipgloss\"\n)\n\n// statsStyles holds styles for the stats command output.\ntype statsStyles struct {\n\tcolorEnabled bool\n\twidth        int\n\n\tbold    lipgloss.Style\n\tdim     lipgloss.Style\n\tlabel   lipgloss.Style // section labels like THROUGHPUT\n\tvalue   lipgloss.Style // big stat numbers\n\tunit    lipgloss.Style // unit suffixes (k, x, h, day)\n\tdesc    lipgloss.Style // descriptions below values\n\trepoNm  lipgloss.Style // repo names in bar chart\n\tcommitH lipgloss.Style // commit hash\n\tcommitM lipgloss.Style // commit message\n\tadd     lipgloss.Style // +additions\n\tdel     lipgloss.Style // -deletions\n\tmuted   lipgloss.Style // muted text\n}\n\nfunc newStatsStyles(w io.Writer) statsStyles {\n\tuseColor := shouldUseColor(w)\n\twidth := getTerminalWidth(w)\n\n\ts := statsStyles{\n\t\tcolorEnabled: useColor,\n\t\twidth:        width,\n\t}\n\n\tif useColor {\n\t\ts.bold = lipgloss.NewStyle().Bold(true)\n\t\ts.dim = lipgloss.NewStyle().Faint(true)\n\t\ts.label = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")).Bold(true)\n\t\ts.value = lipgloss.NewStyle().Bold(true)\n\t\ts.unit = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n\t\ts.desc = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n\t\ts.repoNm = lipgloss.NewStyle().Foreground(lipgloss.Color(\"7\"))\n\t\ts.commitH = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n\t\ts.commitM = lipgloss.NewStyle().Bold(true)\n\t\ts.add = lipgloss.NewStyle().Foreground(lipgloss.Color(\"2\"))\n\t\ts.del = lipgloss.NewStyle().Foreground(lipgloss.Color(\"1\"))\n\t\ts.muted = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n\t}\n\n\treturn s\n}\n\nfunc (s statsStyles) render(style lipgloss.Style, text string) string {\n\tif !s.colorEnabled {\n\t\treturn text\n\t}\n\treturn style.Render(text)\n}\n\n// Agent display config for terminal rendering.\ntype agentDisplay struct {\n\tLabel string\n\tColor string // ANSI 256 color code\n\tChar  rune   // block character for bar charts\n}\n\nvar agentDisplayMap = map[string]agentDisplay{\n\t\"claude\":   {Label: \"Claude Code\", Color: \"208\", Char: '█'},\n\t\"gemini\":   {Label: \"Gemini\", Color: \"141\", Char: '█'},\n\t\"amp\":      {Label: \"Amp\", Color: \"219\", Char: '█'},\n\t\"codex\":    {Label: \"Codex\", Color: \"75\", Char: '█'},\n\t\"opencode\": {Label: \"OpenCode\", Color: \"37\", Char: '█'},\n\t\"copilot\":  {Label: \"Copilot\", Color: \"117\", Char: '█'},\n\t\"pi\":       {Label: \"Pi\", Color: \"204\", Char: '█'},\n\t\"cursor\":   {Label: \"Cursor\", Color: \"114\", Char: '█'},\n\t\"droid\":    {Label: \"Droid\", Color: \"215\", Char: '█'},\n\t\"kiro\":     {Label: \"Kiro\", Color: \"222\", Char: '█'},\n\t\"unknown\":  {Label: \"Unknown\", Color: \"245\", Char: '░'},\n}\n\n// Stable agent order for consistent rendering.\nvar agentOrder = []string{\n\t\"claude\", \"codex\", \"gemini\", \"amp\", \"opencode\",\n\t\"copilot\", \"pi\", \"cursor\", \"droid\", \"kiro\", \"unknown\",\n}\n\nfunc renderStats(w io.Writer, sty statsStyles, stats contributionStats, repos []repoContribution, days []commitDay, totalCheckpoints int) {\n\tfmt.Fprintln(w)\n\trenderStatCards(w, sty, stats)\n\tfmt.Fprintln(w)\n\trenderAgentBreakdown(w, sty, totalCheckpoints, repos)\n\tfmt.Fprintln(w)\n\trenderRepoChart(w, sty, repos)\n\tfmt.Fprintln(w)\n\trenderCommitList(w, sty, days)\n}\n\nfunc renderStatCards(w io.Writer, sty statsStyles, stats contributionStats) {\n\t// Render 4 stat cards in a single row.\n\tcards := []struct {\n\t\tlabel string\n\t\tvalue string\n\t\tunit  string\n\t\tdesc  string\n\t}{\n\t\t{\"THROUGHPUT\", fmt.Sprintf(\"%.1f\", stats.Throughput), \"k\", \"Avg. tokens/checkpoint\"},\n\t\t{\"ITERATION\", fmt.Sprintf(\"%.1f\", stats.Iteration), \"x\", \"Avg steps/checkpoint\"},\n\t\t{\"CONTINUITY\", fmt.Sprintf(\"%.1f\", stats.ContinuityH), \"h\", \"Peak session length\"},\n\t\t{\"STREAK\", strconv.Itoa(stats.Streak), \" day\", fmt.Sprintf(\"%d current\", stats.CurrentStreak)},\n\t}\n\n\t// Calculate card width: distribute evenly across terminal width\n\tcardWidth := (sty.width - 3) / 4 // 3 separators\n\tif cardWidth < 16 {\n\t\tcardWidth = 16\n\t}\n\n\tvar topParts, midParts, botParts []string\n\tfor _, c := range cards {\n\t\tlbl := padOrTruncate(c.label, cardWidth)\n\t\tval := c.value + c.unit\n\t\tvalLine := padOrTruncate(val, cardWidth)\n\t\tdsc := padOrTruncate(c.desc, cardWidth)\n\n\t\ttopParts = append(topParts, sty.render(sty.label, lbl))\n\t\tmidParts = append(midParts, sty.render(sty.value, c.value)+sty.render(sty.unit, c.unit)+\n\t\t\tstrings.Repeat(\" \", max(0, cardWidth-len(c.value)-len(c.unit))))\n\t\t_ = valLine // use the formatted parts instead\n\t\tbotParts = append(botParts, sty.render(sty.desc, dsc))\n\t}\n\n\tsep := sty.render(sty.dim, \" │ \")\n\tfmt.Fprintln(w, strings.Join(topParts, sep))\n\tfmt.Fprintln(w, strings.Join(midParts, sep))\n\tfmt.Fprintln(w, strings.Join(botParts, sep))\n}\n\nfunc renderAgentBreakdown(w io.Writer, sty statsStyles, totalCheckpoints int, repos []repoContribution) {\n\t// Aggregate agent counts across all repos.\n\tagentTotals := make(map[string]int)\n\tfor _, r := range repos {\n\t\tfor agent, count := range r.Agents {\n\t\t\tagentTotals[agent] += count\n\t\t}\n\t}\n\n\tif totalCheckpoints == 0 {\n\t\treturn\n\t}\n\n\t// Build breakdown line: \"Claude Code 36% · Codex 52% · ...\"\n\tvar parts []string\n\tfor _, id := range agentOrder {\n\t\tcount, ok := agentTotals[id]\n\t\tif !ok || count == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tpct := float64(count) / float64(totalCheckpoints) * 100\n\t\tdisplay := agentDisplayMap[id]\n\t\tif sty.colorEnabled {\n\t\t\tagentStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(display.Color))\n\t\t\tparts = append(parts, agentStyle.Render(fmt.Sprintf(\"● %s %d%%\", display.Label, int(math.Round(pct)))))\n\t\t} else {\n\t\t\tparts = append(parts, fmt.Sprintf(\"%s %d%%\", display.Label, int(math.Round(pct))))\n\t\t}\n\t}\n\n\tfmt.Fprintf(w, \"%s  %s\\n\",\n\t\tsty.render(sty.label, \"CONTRIBUTIONS\"),\n\t\tsty.render(sty.muted, fmt.Sprintf(\"%d checkpoints\", totalCheckpoints)))\n\tfmt.Fprintln(w, strings.Join(parts, sty.render(sty.dim, \"  \")))\n}\n\nfunc renderRepoChart(w io.Writer, sty statsStyles, repos []repoContribution) {\n\tif len(repos) == 0 {\n\t\treturn\n\t}\n\n\tfmt.Fprintln(w, sty.render(sty.label, \"REPOSITORIES\"))\n\n\tmaxRepos := 5\n\tif len(repos) < maxRepos {\n\t\tmaxRepos = len(repos)\n\t}\n\tdisplay := repos[:maxRepos]\n\n\t// Find max count for scaling\n\tmaxCount := display[0].Total\n\n\t// Find longest repo name for alignment\n\tmaxNameLen := 0\n\tfor _, r := range display {\n\t\tif len(r.Repo) > maxNameLen {\n\t\t\tmaxNameLen = len(r.Repo)\n\t\t}\n\t}\n\tif maxNameLen > 30 {\n\t\tmaxNameLen = 30\n\t}\n\n\t// Bar width: total width - name column - count column - spacing\n\tcountWidth := len(strconv.Itoa(maxCount))\n\tbarWidth := sty.width - maxNameLen - countWidth - 4\n\tif barWidth < 10 {\n\t\tbarWidth = 10\n\t}\n\n\tfor _, r := range display {\n\t\tname := r.Repo\n\t\tif len(name) > maxNameLen {\n\t\t\tname = name[:maxNameLen-1] + \"…\"\n\t\t}\n\t\tname = fmt.Sprintf(\"%-*s\", maxNameLen, name)\n\n\t\t// Build the bar with agent-colored segments\n\t\tbar := renderAgentBar(sty, r.Agents, maxCount, barWidth)\n\n\t\tcount := fmt.Sprintf(\"%*d\", countWidth, r.Total)\n\n\t\tfmt.Fprintf(w, \"%s %s %s\\n\",\n\t\t\tsty.render(sty.repoNm, name),\n\t\t\tbar,\n\t\t\tsty.render(sty.muted, count))\n\t}\n}\n\nfunc renderAgentBar(sty statsStyles, agents map[string]int, maxCount, barWidth int) string {\n\tif maxCount == 0 {\n\t\treturn strings.Repeat(\" \", barWidth)\n\t}\n\n\tvar b strings.Builder\n\n\tfilled := 0\n\tfor _, id := range agentOrder {\n\t\tcount, ok := agents[id]\n\t\tif !ok || count == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tsegWidth := int(math.Round(float64(count) / float64(maxCount) * float64(barWidth)))\n\t\tif segWidth < 1 && count > 0 {\n\t\t\tsegWidth = 1\n\t\t}\n\t\tif filled+segWidth > barWidth {\n\t\t\tsegWidth = barWidth - filled\n\t\t}\n\t\tif segWidth <= 0 {\n\t\t\tcontinue\n\t\t}\n\n\t\tdisplay := agentDisplayMap[id]\n\t\tseg := strings.Repeat(string(display.Char), segWidth)\n\t\tif sty.colorEnabled {\n\t\t\tagentStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(display.Color))\n\t\t\tb.WriteString(agentStyle.Render(seg))\n\t\t} else {\n\t\t\tb.WriteString(seg)\n\t\t}\n\t\tfilled += segWidth\n\t}\n\n\t// Fill remaining with dim background\n\tif filled < barWidth {\n\t\tbg := strings.Repeat(\"░\", barWidth-filled)\n\t\tb.WriteString(sty.render(sty.dim, bg))\n\t}\n\n\treturn b.String()\n}\n\nfunc renderCommitList(w io.Writer, sty statsStyles, days []commitDay) {\n\tif len(days) == 0 {\n\t\treturn\n\t}\n\n\tmaxDays := 3\n\tif len(days) < maxDays {\n\t\tmaxDays = len(days)\n\t}\n\n\tfor _, day := range days[:maxDays] {\n\t\tdisplayDate := formatCommitDate(day.Date)\n\t\tcommitWord := \"commits\"\n\t\tif len(day.Commits) == 1 {\n\t\t\tcommitWord = \"commit\"\n\t\t}\n\n\t\tfmt.Fprintf(w, \"%s  %s\\n\",\n\t\t\tsty.render(sty.bold, displayDate),\n\t\t\tsty.render(sty.muted, fmt.Sprintf(\"%d %s\", len(day.Commits), commitWord)))\n\n\t\tfor _, c := range day.Commits {\n\t\t\tsha := c.CommitSHA\n\t\t\tif len(sha) > 7 {\n\t\t\t\tsha = sha[:7]\n\t\t\t}\n\n\t\t\tmsg := \"(no message)\"\n\t\t\tif c.CommitMsg != nil && *c.CommitMsg != \"\" {\n\t\t\t\tmsg = firstLine(*c.CommitMsg)\n\t\t\t}\n\n\t\t\t// Truncate message to fit\n\t\t\tmaxMsg := sty.width - 10 - len(c.RepoFullName) - 20\n\t\t\tif maxMsg < 20 {\n\t\t\t\tmaxMsg = 20\n\t\t\t}\n\t\t\tif len(msg) > maxMsg {\n\t\t\t\tmsg = msg[:maxMsg-3] + \"...\"\n\t\t\t}\n\n\t\t\t// Agent badges\n\t\t\tvar badges []string\n\t\t\tuniqueAgents := uniqueCommitAgents(c)\n\t\t\tfor _, a := range uniqueAgents {\n\t\t\t\tdisplay := agentDisplayMap[a]\n\t\t\t\tif sty.colorEnabled {\n\t\t\t\t\tagentStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(display.Color))\n\t\t\t\t\tbadges = append(badges, agentStyle.Render(display.Label))\n\t\t\t\t} else {\n\t\t\t\t\tbadges = append(badges, display.Label)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Diff stats\n\t\t\tdiffStats := fmt.Sprintf(\"+%d / -%d\", c.Additions, c.Deletions)\n\t\t\tfileStats := fmt.Sprintf(\"%d files\", c.FilesChanged)\n\t\t\tif c.FilesChanged == 1 {\n\t\t\t\tfileStats = \"1 file\"\n\t\t\t}\n\n\t\t\t// Checkpoint count\n\t\t\tcpCount := len(c.Checkpoints)\n\t\t\tcpStr := \"\"\n\t\t\tif cpCount > 0 {\n\t\t\t\tif cpCount == 1 {\n\t\t\t\t\tcpStr = \"1 checkpoint\"\n\t\t\t\t} else {\n\t\t\t\t\tcpStr = fmt.Sprintf(\"%d checkpoints\", cpCount)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Line 1: hash  message  repo  [agent badges]\n\t\t\tfmt.Fprintf(w, \"%s %s %s\",\n\t\t\t\tsty.render(sty.commitH, sha),\n\t\t\t\tsty.render(sty.commitM, msg),\n\t\t\t\tsty.render(sty.muted, c.RepoFullName))\n\t\t\tfor _, badge := range badges {\n\t\t\t\tfmt.Fprintf(w, \"  %s\", badge)\n\t\t\t}\n\t\t\tfmt.Fprintln(w)\n\n\t\t\t// Line 2: stats\n\t\t\tvar statParts []string\n\t\t\tstatParts = append(statParts,\n\t\t\t\tsty.render(sty.add, fmt.Sprintf(\"+%d\", c.Additions))+\n\t\t\t\t\tsty.render(sty.muted, \" / \")+\n\t\t\t\t\tsty.render(sty.del, fmt.Sprintf(\"-%d\", c.Deletions)))\n\t\t\t_ = diffStats // used the colored version above\n\t\t\tstatParts = append(statParts, sty.render(sty.muted, fileStats))\n\t\t\tif cpStr != \"\" {\n\t\t\t\tstatParts = append(statParts, sty.render(sty.muted, cpStr))\n\t\t\t}\n\n\t\t\tfmt.Fprintf(w, \"        %s\\n\", strings.Join(statParts, sty.render(sty.dim, \"  \")))\n\t\t}\n\t\tfmt.Fprintln(w)\n\t}\n}\n\nfunc uniqueCommitAgents(c userCommit) []string {\n\tseen := make(map[string]struct{})\n\tvar result []string\n\tfor _, cp := range c.Checkpoints {\n\t\tfor _, a := range cp.Agents {\n\t\t\tid := normalizeAgentString(a)\n\t\t\tif _, ok := seen[id]; !ok {\n\t\t\t\tseen[id] = struct{}{}\n\t\t\t\tresult = append(result, id)\n\t\t\t}\n\t\t}\n\t}\n\t// Stable sort\n\tsort.Strings(result)\n\treturn result\n}\n\nfunc formatCommitDate(dateStr string) string {\n\tt, err := time.Parse(\"2006-01-02\", dateStr)\n\tif err != nil {\n\t\treturn dateStr\n\t}\n\tnow := time.Now().Local()\n\ttoday := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())\n\td := today.Sub(t)\n\n\tswitch {\n\tcase d < 24*time.Hour:\n\t\treturn t.Format(\"Monday 2 Jan\") + \" (today)\"\n\tcase d < 48*time.Hour:\n\t\treturn t.Format(\"Monday 2 Jan\") + \" (yesterday)\"\n\tdefault:\n\t\treturn t.Format(\"Monday 2 Jan\")\n\t}\n}\n\nfunc padOrTruncate(s string, width int) string {\n\tif len(s) > width {\n\t\treturn s[:width-1] + \"…\"\n\t}\n\treturn s + strings.Repeat(\" \", width-len(s))\n}\n