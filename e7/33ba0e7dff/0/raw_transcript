ext, client *api.Client) ([]userCheckpoint, []string, error) {\n62\t\tpath := fmt.Sprintf(\"/api/v1/stats/checkpoints?timeframe=%s&limit=%d\", statsTimeframe, statsLimit)\n63\t\tresp, err := client.Get(ctx, path)\n64\t\tif err != nil {\n65\t\t\treturn nil, nil, fmt.Errorf(\"GET checkpoints: %w\", err)\n66\t\t}\n67\t\tdefer resp.Body.Close()\n68\t\n69\t\tif err := api.CheckResponse(resp); err != nil {\n70\t\t\treturn nil, nil, fmt.Errorf(\"checkpoints response: %w\", err)\n71\t\t}\n72\t\n73\t\tvar result userCheckpointsResponse\n74\t\tif err := api.DecodeJSON(resp, &result); err != nil {\n75\t\t\treturn nil, nil, fmt.Errorf(\"decode checkpoints: %w\", err)\n76\t\t}\n77\t\treturn result.Checkpoints, result.StreakDates, nil\n78\t}\n79\t\n80\tfunc fetchCommits(ctx context.Context, client *api.Client) ([]userCommit, error) {\n81\t\tpath := fmt.Sprintf(\"/api/v1/stats/commits?timeframe=%s&limit=%d\", statsTimeframe, statsLimit)\n82\t\tresp, err := client.Get(ctx, path)\n83\t\tif err != nil {\n84\t\t\treturn nil, fmt.Errorf(\"GET commits: %w\", err)\n85\t\t}\n86\t\tdefer resp.Body.Close()\n87\t\n88\t\tif err := api.CheckResponse(resp); err != nil {\n89\t\t\treturn nil, fmt.Errorf(\"commits response: %w\", err)\n90\t\t}\n91\t\n92\t\tvar result userCommitsResponse\n93\t\tif err := api.DecodeJSON(resp, &result); err != nil {\n94\t\t\treturn nil, fmt.Errorf(\"decode commits: %w\", err)\n95\t\t}\n96\t\treturn result.Commits, nil\n97\t}\n98\t\n99\t// computeContributionStats mirrors the frontend's computeStats + computeStreaks.\n100\tfunc computeContributionStats(checkpoints []userCheckpoint, streakDates []string) contributionStats {\n101\t\tstats := contributionStats{}\n102\t\tif len(checkpoints) == 0 {\n103\t\t\treturn stats\n104\t\t}\n105\t\n106\t\tstats.Tasks = len(checkpoints)\n107\t\n108\t\t// Throughput: avg total tokens per checkpoint (in thousands)\n109\t\tvar tokenSum int\n110\t\tvar tokenCount int\n111\t\tfor _, cp := range checkpoints {\n112\t\t\tif cp.InputTokens !=