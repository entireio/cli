s/platform/users/hooks/useUserDashboardData.ts","content":"import { useQuery } from \"@tanstack/react-query\"\nimport { differenceInCalendarDays } from \"date-fns\"\n\nimport { getAgentId } from \"@/lib/agents\"\nimport { toLocalDateString, parseLocalDate } from \"@/lib/date\"\n\nimport {\n  fetchUserCheckpoints,\n  fetchUserCommits,\n  type UserCheckpoint,\n  type UserCommit,\n} from \"../api\"\nimport type {\n  TimeframeType,\n  ContributionStats,\n  DailyContribution,\n  HourlyContribution,\n  AgentContributions,\n  RepoContribution,\n} from \"../types\"\n\ninterface UseUserDashboardDataResult {\n  stats: ContributionStats\n  chartData: DailyContribution[]\n  hourlyChartData: HourlyContribution[]\n  repoData: RepoContribution[]\n  recentCommits: UserCommit[]\n  isLoading: boolean\n  error: Error | null\n  commitsError: Error | null\n}\n\ninterface UseUserDashboardDataOptions {\n  includeCommits?: boolean\n}\n\nexport function computeStreaks(timestamps: string[]): { currentStreak: number; streak: number } {\n  if (timestamps.length === 0) return { currentStreak: 0, streak: 0 }\n\n  const datesWithActivity = new Set(timestamps.map((ts) => toLocalDateString(ts)))\n\n  // Current streak (from today or yesterday backwards)\n  const today = new Date()\n  let currentStreak = 0\n  const checkDate = new Date(today)\n\n  if (!datesWithActivity.has(toLocalDateString(checkDate))) {\n    checkDate.setDate(checkDate.getDate() - 1)\n  }\n\n  while (datesWithActivity.has(toLocalDateString(checkDate))) {\n    currentStreak++\n    checkDate.setDate(checkDate.getDate() - 1)\n  }\n\n  // Longest streak\n  const sortedDates = Array.from(datesWithActivity).sort()\n  let streak = 0\n  let run = 0\n\n  for (let i = 0; i < sortedDates.length; i++) {\n    if (i === 0) {\n      run = 1\n    } else {\n      const diffDays = differenceInCalendarDays(\n        parseLocalDate(sortedDates[i]),\n        parseLocalDate(sortedDates[i - 1]),\n      )\n      run = diffDays === 1 ? run + 1 : 1\n    }