unt) / 1000.0\n117\t\t}\n118\t\n119\t\t// Iteration: avg session_count per checkpoint\n120\t\tvar sessionSum int\n121\t\tfor _, cp := range checkpoints {\n122\t\t\tsessionSum += derefOr(cp.SessionCount, 1)\n123\t\t}\n124\t\tstats.Iteration = float64(sessionSum) / float64(len(checkpoints))\n125\t\n126\t\t// Continuity: max(steps) * 2 / 60 (2 min/step estimate)\n127\t\tvar maxSteps int\n128\t\tfor _, cp := range checkpoints {\n129\t\t\ts := derefOr(cp.Steps, 1)\n130\t\t\tif s > maxSteps {\n131\t\t\t\tmaxSteps = s\n132\t\t\t}\n133\t\t}\n134\t\tstats.ContinuityH = float64(maxSteps) * 2.0 / 60.0\n135\t\n136\t\t// Streaks from streakDates\n137\t\tstats.Streak, stats.CurrentStreak = computeStreaks(streakDates)\n138\t\n139\t\treturn stats\n140\t}\n141\t\n142\t// computeStreaks mirrors the frontend's computeStreaks.\n143\tfunc computeStreaks(timestamps []string) (longest, current int) {\n144\t\tif len(timestamps) == 0 {\n145\t\t\treturn 0, 0\n146\t\t}\n147\t\n148\t\t// Collect unique local dates\n149\t\tdateSet := make(map[string]struct{})\n150\t\tfor _, ts := range timestamps {\n151\t\t\tt, err := time.Parse(time.RFC3339, ts)\n152\t\t\tif err != nil {\n153\t\t\t\tt, err = time.Parse(time.RFC3339Nano, ts)\n154\t\t\t\tif err != nil {\n155\t\t\t\t\tcontinue\n156\t\t\t\t}\n157\t\t\t}\n158\t\t\tdateSet[t.Local().Format(\"2006-01-02\")] = struct{}{}\n159\t\t}\n160\t\n161\t\tif len(dateSet) == 0 {\n162\t\t\treturn 0, 0\n163\t\t}\n164\t\n165\t\t// Current streak: from today or yesterday backward\n166\t\ttoday := time.Now().Local().Format(\"2006-01-02\")\n167\t\tcheck := time.Now().Local()\n168\t\tif _, ok := dateSet[today]; !ok {\n169\t\t\tcheck = check.AddDate(0, 0, -1)\n170\t\t}\n171\t\tfor {\n172\t\t\tif _, ok := dateSet[check.Format(\"2006-01-02\")]; !ok {\n173\t\t\t\tbreak\n174\t\t\t}\n175\t\t\tcurrent++\n176\t\t\tcheck = check.AddDate(0, 0, -1)\n177\t\t}\n178\t\n179\t\t// Longest streak\n180\t\tdates := make([]string, 0, len(dateSet))\n181\t\tfor d := range dateSet {\n182\t\t