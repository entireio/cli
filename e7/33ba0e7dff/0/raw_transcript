 - count column - spacing\n207\t\tcountWidth := len(strconv.Itoa(maxCount))\n208\t\tbarWidth := sty.width - maxNameLen - countWidth - 4\n209\t\tif barWidth < 10 {\n210\t\t\tbarWidth = 10\n211\t\t}\n212\t\n213\t\tfor _, r := range display {\n214\t\t\tname := r.Repo\n215\t\t\tif len(name) > maxNameLen {\n216\t\t\t\tname = name[:maxNameLen-1] + \"…\"\n217\t\t\t}\n218\t\t\tname = fmt.Sprintf(\"%-*s\", maxNameLen, name)\n219\t\n220\t\t\t// Build the bar with agent-colored segments\n221\t\t\tbar := renderAgentBar(sty, r.Agents, maxCount, barWidth)\n222\t\n223\t\t\tcount := fmt.Sprintf(\"%*d\", countWidth, r.Total)\n224\t\n225\t\t\tfmt.Fprintf(w, \"%s %s %s\\n\",\n226\t\t\t\tsty.render(sty.repoNm, name),\n227\t\t\t\tbar,\n228\t\t\t\tsty.render(sty.muted, count))\n229\t\t}\n230\t}\n231\t\n232\tfunc renderAgentBar(sty statsStyles, agents map[string]int, maxCount, barWidth int) string {\n233\t\tif maxCount == 0 {\n234\t\t\treturn strings.Repeat(\" \", barWidth)\n235\t\t}\n236\t\n237\t\tvar b strings.Builder\n238\t\n239\t\tfilled := 0\n240\t\tfor _, id := range agentOrder {\n241\t\t\tcount, ok := agents[id]\n242\t\t\tif !ok || count == 0 {\n243\t\t\t\tcontinue\n244\t\t\t}\n245\t\t\tsegWidth := int(math.Round(float64(count) / float64(maxCount) * float64(barWidth)))\n246\t\t\tif segWidth < 1 && count > 0 {\n247\t\t\t\tsegWidth = 1\n248\t\t\t}\n249\t\t\tif filled+segWidth > barWidth {\n250\t\t\t\tsegWidth = barWidth - filled\n251\t\t\t}\n252\t\t\tif segWidth <= 0 {\n253\t\t\t\tcontinue\n254\t\t\t}\n255\t\n256\t\t\tdisplay := agentDisplayMap[id]\n257\t\t\tseg := strings.Repeat(string(display.Char), segWidth)\n258\t\t\tif sty.colorEnabled {\n259\t\t\t\tagentStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(display.Color))\n260\t\t\t\tb.WriteString(agentStyle.Render(seg))\n261\t\t\t} else {\n262\t\t\t\tb.WriteString(seg)\n263\t\t\t}\n264\t\t\tfilled += segWidth\n265\t\t}\n266\t\n267\t\t// Fill remaining with dim background\n268\t\tif filled < barWidth {\n269\t\t\tbg := strings.