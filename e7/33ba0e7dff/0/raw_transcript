ount = checkpoints.length\n              const sessionCount = checkpoints.reduce(\n                (total, checkpoint) => total + checkpoint.sessionCount,\n                0,\n              )\n              const fileCount = commit.filesChanged ?? commit.fileStats?.length ?? 0\n              const commitTitle = commit.commitMessage ?? \"Untitled commit\"\n              const uniqueAgents = [\n                ...new Set(checkpoints.flatMap((checkpoint) => checkpoint.agents)),\n              ]\n              const showUnknownAgentBadge = uniqueAgents.length === 0 && sessionCount > 0\n\n              return (\n                <ListViewItem\n                  key={commit.commitSha}\n                  index={commit._index}\n                  href={\n                    getCommitHref\n                      ? getCommitHref(commit)\n                      : `/gh/${encodeURIComponent(org ?? \"\")}/${encodeURIComponent(repo ?? \"\")}/commit/${encodeURIComponent(commit.commitSha)}`\n                  }\n                  className=\"flex flex-wrap items-center gap-x-2.5 gap-y-2 px-4 py-3 transition-colors hover:bg-hover md:h-12 md:flex-nowrap md:py-0\"\n                  aria-label={`${commitTitle}, ${commit.additions ?? 0} additions, ${commit.deletions ?? 0} deletions, ${fileCount} ${fileCount === 1 ? \"file\" : \"files\"}, ${checkpointCount} ${checkpointCount === 1 ? \"checkpoint\" : \"checkpoints\"}, by ${commit.commitAuthorUsername ?? \"unknown author\"}`}\n                >\n                  <span className=\"shrink-0 font-mono text-xs text-muted\">\n                    {commit.commitSha.slice(0, 7)}\n                  </span>\n                  <span\n                    className={`min-w-0 truncate text-sm font-semibold ${checkpointCount > 0 ? \"text-default\" : \"text-muted\"}`}\n                  >\n                    {commitTitle}\n                  </span>\n                  {renderCommitMeta?.(commit)}\n                  {uniqueAgents.length > 0 &&\n                    uniqueAgents.map((agent) => {\n                      const config = getAgent(agent)\n                      return (\n                        <Badge key={agent} className={`shrink-0 ${config.colorClass} agent-badge`}>\n                          {config.label}\n                        </Badge>\n                      )\n                    })}\n                  {showUnknownAgentBadge && (\n                    <Badge className={`shrink-0 ${getAgent(null).colorClass} agent-badge`}>\n                      {getAgent(null).label}\n                    </Badge>\n                  )}\n                  <span className=\"mt-1 flex basis-full items-center justify-start gap-4 font-mono text-xs text-muted md:mt-0 md:ml-auto md:shrink-0 md:basis-auto md:justify-start\">\n                    <LineCounts\n                      additions={commit.additions ?? 0}\n                      deletions={commit.deletions ?? 0}\n                    />\n                    <span>\n                      {fileCount} {fileCount === 1 ? \"file\" : \"files\"}\n                    </span>\n                    {checkpointCount > 0 && (\n                      <span>\n                        {checkpointCount} checkpoint{checkpointCount === 1 ? \"\" : \"s\"}\n                      </span>\n                    )}\n                    {showAvatar && (\n                      <GitHubAvatar\n                        username={commit.commitAuthorUsername ?? undefined}\n                        className=\"size-5\"\n                      />\n                    )}\n                  </span>\n                </ListViewItem>\n              )\n            })}\n          </ul>\n        </li>\n      ))}\n    </ListView>\n  )\n}\n","numLines":150,"startLine":1,"totalLines":150}},"sourceToolAssistantUUID":"9c3496cc-135b-49b4-add9-aeebb216a8b2","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"06af762d-fb18-426b-8b89-e1a11aba933b","version":"2.1.104","gitBra