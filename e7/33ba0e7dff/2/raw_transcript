  const count = checkpoints.length\n\n  // Use || (not ??) because 0 or null steps indicates a CLI error, default to 1\n  const totalSteps = checkpoints.reduce((sum, cp) => sum + (cp.steps || 1), 0)\n  const orchestration = Math.round((totalSteps / (totalSteps + count)) * 100)\n\n  const totalSessionCount = checkpoints.reduce((sum, cp) => sum + (cp.session_count || 1), 0)\n  const iteration = Math.round((totalSessionCount / count) * 10) / 10\n\n  const withTokens = checkpoints.filter((cp) => cp.input_tokens != null || cp.output_tokens != null)\n  const totalTokens = withTokens.reduce(\n    (sum, cp) => sum + (cp.input_tokens ?? 0) + (cp.output_tokens ?? 0),\n    0,\n  )\n  const throughput = withTokens.length > 0 ? totalTokens / withTokens.length / 1000 : 0\n\n  return { tasks: count, orchestration, iteration, throughput }\n}\n\nexport function computeDailyContributions(\n  checkpoints: UserCheckpoint[],\n  conv: TimezoneConverter,\n): DailyContribution[] {\n  const byDate = new Map<string, Record<AgentId, number>>()\n\n  for (const cp of checkpoints) {\n    if (!cp.commit_date) continue\n    const date = conv.toDate(new Date(cp.commit_date))\n    let agents = byDate.get(date)\n    if (!agents) {\n      agents = emptyAgentContributions()\n      byDate.set(date, agents)\n    }\n    agents[getAgentId(cp.agent)] += cp.steps || 1\n  }\n\n  return Array.from(byDate, ([date, agents]) => ({ date, agents })).sort((a, b) =>\n    a.date.localeCompare(b.date),\n  )\n}\n\nexport function computeHourlyContributions(\n  checkpoints: UserCheckpoint[],\n  conv: TimezoneConverter,\n): HourlyContribution[] {\n  const byKey = new Map<string, HourlyContribution>()\n\n  for (const cp of checkpoints) {\n    if (!cp.commit_date) continue\n    const d = new Date(cp.commit_date)\n    const date = conv.toDate(d)\n    const hour = conv.toHour(d)\n    const agent = getAgentId(cp.agent)\n\n    const key = `${date}-${hour}-${agent}`\n    let entry = byKey.get(key)\n    if (!entry) {\n      entry