r result userCheckpointsResponse\n112\t\tif err := api.DecodeJSON(resp, &result); err != nil {\n113\t\t\treturn nil, nil, fmt.Errorf(\"decode checkpoints: %w\", err)\n114\t\t}\n115\t\treturn result.Checkpoints, result.StreakDates, nil\n116\t}\n117\t\n118\tfunc fetchCommits(ctx context.Context, client *api.Client) ([]userCommit, error) {\n119\t\tpath := fmt.Sprintf(\"/api/v1/stats/commits?timeframe=%s&limit=%d\", activityTimeframe, activityLimit)\n120\t\tresp, err := client.Get(ctx, path)\n121\t\tif err != nil {\n122\t\t\treturn nil, fmt.Errorf(\"GET commits: %w\", err)\n123\t\t}\n124\t\tdefer resp.Body.Close()\n125\t\n126\t\tif err := api.CheckResponse(resp); err != nil {\n127\t\t\treturn nil, fmt.Errorf(\"commits response: %w\", err)\n128\t\t}\n129\t\n130\t\tvar result userCommitsResponse\n131\t\tif err := api.DecodeJSON(resp, &result); err != nil {\n132\t\t\treturn nil, fmt.Errorf(\"decode commits: %w\", err)\n133\t\t}\n134\t\treturn result.Commits, nil\n135\t}\n136\t\n137\t// computeContributionStats mirrors the frontend's computeStats + computeStreaks.\n138\tfunc computeContributionStats(checkpoints []userCheckpoint, streakDates []string) contributionStats {\n139\t\tstats := contributionStats{}\n140\t\tif len(checkpoints) == 0 {\n141\t\t\treturn stats\n142\t\t}\n143\t\n144\t\tstats.Tasks = len(checkpoints)\n145\t\n146\t\tvar tokenSum, tokenCount, sessionSum, maxSteps int\n147\t\tfor _, cp := range checkpoints {\n148\t\t\tif cp.InputTokens != nil || cp.OutputTokens != nil {\n149\t\t\t\ttokenSum += derefOr(cp.InputTokens, 0) + derefOr(cp.OutputTokens, 0)\n150\t\t\t\ttokenCount++\n151\t\t\t}\n152\t\t\tsessionSum += derefOr(cp.SessionCount, 1)\n153\t\t\tif s := derefOr(cp.Steps, 1); s > maxSteps {\n154\t\t\t\tmaxSteps = s\n155\t\t\t}\n156\t\t}\n157\t\n158\t\tif tokenCount > 0 {\n159\t\t\tstats.Throughput = float64(tokenSum) / float64(tokenCount) / 1000.0\n160\t\t}\n161\t\tstats.Iteration = float64(sessionSum) / float64(len(checkpoints))\n162\t\t// 2 min/step is the frontend's heuristic for turn duration\n163\t\tstats.ContinuityH = float64(maxSteps) * 2.0 / 60.0\n164\t\tstats.Streak, stats.CurrentStreak = computeStreaks(streakDates)\n165\t\n166\t\treturn stats\n167\t}\n168\t\n169\tfunc computeStreaks(timestamps []string) (longest, current int) {\n170\t\tif len(timestamps) == 0 {\n171\t\t\treturn 0, 0\n172\t\t}\n173\t\n174\t\tdateSet := make(map[string]struct{})\n175\t\tfor _, ts := range timestamps {\n176\t\t\tt, err := parseFlexibleTime(ts)\n177\t\t\tif err != nil {\n178\t\t\t\tcontinue\n179\t\t\t}\n180\t\t\tdateSet[t.Local().Format(\"2006-01-02\")] = struct{}{}\n181\t\t}\n182\t\n183\t\tif len(dateSet) == 0 {\n184\t\t\treturn 0, 0\n185\t\t}\n186\t\n187\t\t// Current streak: from today or yesterday backward\n188\t\ttoday := time.Now().Local().Format(\"2006-01-02\")\n189\t\tcheck := time.Now().Local()\n190\t\tif _, ok := dateSet[today]; !ok {\n191\t\t\tcheck = check.AddDate(0, 0, -1)\n192\t\t}\n193\t\tfor {\n194\t\t\tif _, ok := dateSet[check.Format(\"2006-01-02\")]; !ok {\n195\t\t\t\tbreak\n196\t\t\t}\n197\t\t\tcurrent++\n198\t\t\tcheck = check.AddDate(0, 0, -1)\n199\t\t}\n200\t\n201\t\tdates := make([]string, 0, len(dateSet))\n202\t\tfor d := range dateSet {\n203\t\t\tdates = append(dates, d)\n204\t\t}\n205\t\tsort.Strings(dates)\n206\t\n207\t\trun := 1\n208\t\tlongest = 1\n209\t\tfor i := 1; i < len(dates); i++ {\n210\t\t\tprev, errP := time.Parse(\"2006-01-02\", dates[i-1])\n211\t\t\tcurr, errC := time.Parse(\"2006-01-02\", dates[i])\n212\t\t\tif errP != nil || errC != nil {\n213\t\t\t\trun = 1\n214\t\t\t\tcontinue\n215\t\t\t}\n216\t\t\tif curr.Sub(prev).Hours() <= 25 { // 1 day with some tolerance\n217\t\t\t\trun++\n218\t\t\t} else {\n219\t\t\t\trun = 1\n220\t\t\t}\n221\t\t\tif run > longest {\n222\t\t\t\tlongest = run\n223\t\t\t}\n224\t\t}\n225\t\n226\t\treturn longest, current\n227\t}\n228\t\n229\tfunc computeRepoContributions(checkpoints []userCheckpoint) []repoContribution {\n230\t\tbyRepo := make(map[string]*repoContri