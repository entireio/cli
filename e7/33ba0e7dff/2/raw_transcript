      int                    `json:\"files_changed\"`\n45\t\tCheckpoints            []userCommitCheckpoint `json:\"checkpoints\"`\n46\t\tRepoFullName           string                 `json:\"repo_full_name\"`\n47\t\tIsPrivate              bool                   `json:\"is_private\"`\n48\t\tCheckpointRepoFullName *string                `json:\"checkpoint_repo_full_name\"`\n49\t}\n50\t\n51\t// userCommitsResponse is the API response for GET /api/v1/stats/commits.\n52\ttype userCommitsResponse struct {\n53\t\tCommits   []userCommit `json:\"commits\"`\n54\t\tTimeframe string       `json:\"timeframe\"`\n55\t\tUpdatedAt string       `json:\"updated_at\"`\n56\t}\n57\t\n58\t// Computed types used for rendering.\n59\t\n60\ttype contributionStats struct {\n61\t\tTasks         int\n62\t\tThroughput    float64 // avg tokens/checkpoint in thousands\n63\t\tIteration     float64 // avg session_count per checkpoint\n64\t\tContinuityH   float64 // peak session length in hours\n65\t\tStreak        int     // longest consecutive days\n66\t\tCurrentStreak int     // current streak from today\n67\t}\n68\t\n69\ttype repoContribution struct {\n70\t\tRepo   string\n71\t\tTotal  int\n72\t\tAgents map[string]int // agentID -> checkpoint count\n73\t}\n74\t\n75\t// hourlyPoint is a single data point for the contribution chart.\n76\ttype hourlyPoint struct {\n77\t\tDate    string // \"2006-01-02\"\n78\t\tHour    int\n79\t\tValue   int // step count\n80\t\tAgentID string\n81\t}\n82\t\n83\t// commitDay groups commits by date for display.\n84\ttype commitDay struct {\n85\t\tDate    string\n86\t\tCommits []userCommit\n87\t}"},"type":"attachment","uuid":"4d7680ab-62e0-4a73-8ec1-9c7dab0b2e44","timestamp":"2026-04-22T14:49:45.307Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"ca23ad5c-2676-470b-99f5-98e30bac81e2","version":"2.1.117","gitBranch":"soph/stats"}
{"parentUuid":"4d7680ab-62e0-4a73-8ec1-9c7dab0b2e44","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/activity_render.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"math\"\n7\t\t\"os\"\n8\t\t\"sort\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/charmbracelet/lipgloss\"\n14\t\t\"golang.org/x/term\"\n15\t)\n16\t\n17\ttype activityStyles struct {\n18\t\tcolorEnabled bool\n19\t\twidth        int\n20\t\n21\t\tbold    lipgloss.Style\n22\t\tdim     lipgloss.Style\n23\t\tlabel   lipgloss.Style\n24\t\tvalue   lipgloss.Style\n25\t\tunit    lipgloss.Style\n26\t\tdesc    lipgloss.Style\n27\t\trepoNm  lipgloss.Style\n28\t\tcommitH lipgloss.Style\n29\t\tcommitM lipgloss.Style\n30\t\tadd     lipgloss.Style\n31\t\tdel     lipgloss.Style\n32\t\tmuted   lipgloss.Style\n33\t}\n34\t\n35\t// getFullTerminalWidth returns the terminal width without the 80-char cap\n36\t// used by other commands. Activity benefits from wide output for bar charts.\n37\tfunc getFullTerminalWidth(w io.Writer) int {\n38\t\tif f, ok := w.(*os.File); ok {\n39\t\t\tif width, _, err := term.GetSize(int(f.Fd())); err == nil && width > 0 { //nolint:gosec // G115: uintptr->int is safe for fd\n40\t\t\t\treturn width\n41\t\t\t}\n42\t\t}\n43\t\tfor _, f := range []*os.File{os.Stdout, os.Stderr} {\n44\t\t\tif f == nil {\n45\t\t\t\tcontinue\n46\t\t\t}\n47\t\t\tif width, _, err := term.GetSize(int(f.Fd())); err == nil && width > 0 { //nolint:gosec // G115: uintptr->int is safe for fd\n48\t\t\t\treturn width\n49\t\t\t}\n50\t\t}\n51\t\treturn 80\n52\t}\n53\t\n54\tfunc newActivityStyles(w io.Writer) activityStyles {\n55\t\tuseColor := shouldUseColor(w)\n56\t\twidth := getFullTerminalWidth(w)\n57\t\n58\t\ts := activityStyles{\n59\t\t\tcolorEnabled: useColor,\n60\t\t\twidth:        width,\n61\t\t}\n62\t\n63\t\tif useColor {\n64\t\t\ts.bold = lipgloss.NewStyle().Bold(true)\n65\t\t\ts.dim = lipgloss.NewStyle().Faint(true)\n66\t\t\ts.label = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")).Bold(true)\n67\t\t\ts.value = lipgloss.NewStyle().Bold(true)\n68\t\t\ts.unit = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n69\t\t\ts.desc = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n70\t\t\ts.repoNm = lipgloss.NewStyle().Foreground(lipgloss.Color(\"7\"))\n71\t\t\ts.commitH = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n72\t\t\ts.commitM = lipgloss.NewStyle().Bold(true)\n73\t\t\ts.add = lipgloss.NewStyle().Foreground(lipgloss.Color(\"2\"))\n74\t\t\ts.del = lipgloss.NewStyle().Foreground(lipgloss.Color(\"1\"))\n75\t\t\ts.muted = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\"))\n76\t\t}\n77\t\n78\t\treturn s\n79\t}\n80\t\n81\tfunc (s activityStyles) render(style lipgloss.Style, text string) string {\n82\t\tif !s.colorEnabled {\n83\t\t\treturn text\n84\t\t}\n85\t\treturn style.Render(text)\n86\t}\n87\t\n88\tfunc (s activityStyles) renderAgent(agentID, text string) string {\n89\t\tif !s.colorEnabled {\n90\t\t\treturn text\n91\t\t}\n92\t\tdisplay := agentDisplayMap[agentID]\n93\t\treturn lipgloss.NewStyle().Foreground(lipgloss.Color(display.Color)).Render(text)\n94\t}\n95\t\n96\ttype agentDisplay struct {\n97\t\tLabel string\n98\t\tColor string // ANSI 256 color code\n99\t\tChar  rune   // block character for bar charts\n100\t}\n101\t\n102\t// Agent colors match the dark-mode CSS variables from entire.io (Tailwind 400-level).\n103\t// Lipgloss resolves hex to the best representation for the terminal's color profile.\n104\tvar agentDisplayMap = map[string]agentDisplay{\n105\t\t\"claude\":   {Label: \"Claude Code\", Color: \"#fb923c\", Char: '▓'}, // orange-400\n106\t\t\"gemini\":   {Label: \"Gemini\", Color: \"#60a5fa\", Char: '▓'},      // blue-400\n107\t\t\"amp\":      {Label: \"Amp\", Color: \"#f87171\", Char: '▓'},         // red-400\n108\t\t\"codex\":    {Label: \"Codex\", Color: \"#818cf8\", Char: '▓'},       // indigo-400\n109\t\t\"opencode\": {Label: \"OpenCode\", Color: \"#22d3ee\", Char: '▓'},    // cyan-400\n110\t\t\"copilot\":  {Label: \"Copilot\", Color: \"#a78bfa\", Char: '▓'},     // violet-400\n111\t\t\"pi\":       {Label: \"Pi\", Color: \"#fbbf24\", Char: '▓'},          // amber-400\n112\t\t\"cursor\":   {Label: \"Cursor\", Color: \"#38bdf8\", Char: '▓'},      // sky-400\n113\t\t\"droid\":    {Label: \"Droid\", Color: \"#f472b6\", Char: '▓'},       // pink-400\n114\t\t\"kiro\":     {Label: \"Kiro\", Color: \"#c084fc\", Char: '▓'},        // purple-400\n115\t\t\"unknown\":  {Label: \"Unknown\", Color: \"245\", Char: '░'},\n116\t}\n117\t\n118\tvar agentOrder = []string{\n119\t\t\"claude\", \"codex\", \"gemini\", \"amp\", \"opencode\",\n120\t\t\"copilot\", \"pi\", \"cursor\", \"droid\", \"kiro\", \"unknown\",\n121\t}\n122\t\n123\tfunc renderActivity(w io.Writer, sty activityStyles, stats contributionStats, repos []repoContribution, hourly []hourlyPoint, days []commitDay) {\n124\t\tfmt.Fprintln(w)\n125\t\trenderStatCards(w, sty, stats)\n126\t\tfmt.Fprintln(w)\n127\t\trenderContributionChart(w, sty, hourly, repos)\n128\t\tfmt.Fprintln(w)\n129\t\trenderRepoChart(w, sty, repos)\n130\t\tfmt.Fprintln(w)\n131\t\trenderCommitList(w, sty, days)\n132\t}\n133\t\n134\tfunc renderStatCards(w io.Writer, sty activityStyles, stats contributionStats) {\n135\t\tcards := []struct {\n136\t\t\tlabel string\n137\t\t\tvalue string\n138\t\t\tunit  string\n139\t\t\tdesc  string\n140\t\t}{\n141\t\t\t{\"THROUGHPUT\", fmt.Sprintf(\"%.1f\", stats.Throughput), \"k\", \"Avg. tokens/checkpoint\"},\n142\t\t\t{\"ITERATION\", fmt.Sprintf(\"%.1f\", stats.Iteration), \"x\", \"Avg sessions/checkpoint\"},\n143\t\t\t{\"CONTINUITY\", fmt.Sprintf(\"%.1f\", stats.ContinuityH), \"h\", \"Peak session length\"},\n144\t\t\t{\"STREAK\", strconv.Itoa(stats.Streak), \" day\", fmt.Sprintf(\"%d current\", stats.CurrentStreak)},\n145\t\t}\n146\t\n147\t\tcardWidth := (sty.width - 3) / 4 // 3 separators\n148\t\tif cardWidth < 16 {\n149\t\t\tcardWidth = 16\n150\t\t}\n151\t\n152\t\tvar topParts, midParts, botParts []string\n153\t\tfor _, c := range cards {\n154\t\t\tlbl := padOrTruncate(c.label, cardWidth)\n155\t\t\tdsc := padOrTruncate(c.desc, cardWidth)\n156\t\n157\t\t\ttopParts = append(topParts, sty.render(sty.label, lbl))\n158\t\t\tmidParts = append(midParts, sty.render(sty.value, c.value)+sty.render(sty.unit, c.unit)+\n159\t\t\t\tstrings.Repeat(\" \", max(0, cardWidth-len(c.value)-len(c.unit))))\n160\t\t\tbotParts = append(botParts, sty.render(sty.desc, dsc))\n161\t\t}\n162\t\n163\t\tsep := sty.render(sty.dim, \" │ \")\n164\t\tfmt.Fprintln(w, strings.Join(topParts, sep))\n165\t\tfmt.Fprintln(w, strings.Join(midParts, sep))\n166\t\tfmt.Fprintln(w, strings.Join(botParts, sep))\n167\t}\n168\t\n169\tfunc renderContributionChart(w io.Writer, sty activityStyles, hourly []hourlyPoint, repos []repoContribution) {\n170\t\trenderDotChart(w, sty, hourly, repos)\n171\t}\n172\t\n173\tfunc renderDotChart(w io.Writer, sty activityStyles, hourly []hourlyPoint, repos []repoContribution) {\n174\t\tagentTotals := make(map[string]int)\n175\t\ttotal := 0\n176\t\tfor _, r := range repos {\n177\t\t\ttotal += r.Total\n178\t\t\tfor agent, count := range r.Agents {\n179\t\t\t\tagentTotals[agent] += count\n180\t\t\t}\n181\t\t}\n182\t\n183\t\ttotalLabel := \"\"\n184\t\tif total > 0 {\n185\t\t\ttotalLabel = sty.render(sty.muted, fmt.Sprintf(\"  %d checkpoints\", total))\n186\t\t}\n187\t\tfmt.Fprintf(w, \"%s%s\\n\", sty.render(sty.label, \"CONTRIBUTIONS\"), totalLabel)\n188\t\n189\t\tif len(hourly) == 0 {\n190\t\t\tfmt.Fprintln(w, sty.render(sty.muted, \"  No activity data\"))\n191\t\t\treturn\n192\t\t}\n193\t\n194\t\tnow := time.Now().Local()\n195\t\ttoday := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())\n196\t\tnumDays := 30\n197\t\n198\t\t// 4 hour bands: 0-5, 6-11, 12-17, 18-23\n199\t\ttype hourBand struct {\n200\t\t\tlabel  string\n201\t\t\tlo, hi int\n202\t\t}\n203\t\tbands := []hourBand{\n204\t\t\t{\" 0\", 0, 5},\n205\t\t\t{\" 6\", 6, 11},\n206\t\t\t{\"12\", 12, 17},\n207\t\t\t{\"18\", 18, 23},\n208\t\t}\n209\t\n210\t\t// Grid: [band][day] -> best point\n211\t\ttype cell struct {\n212\t\t\tvalue   int\n213\t\t\tagentID string\n214\t\t}\n215\t\tgrid := make([][]cell, len(bands))\n216\t\tfor i := range grid {\n217\t\t\tgrid[i] = make([]cell, numDays)\n218\t\t}\n219\t\n220\t\tfor _, p := range hourly {\n221\t\t\tpt, err := time.ParseInLocation(\"2006-01-02\", p.Date, time.Local)\n222\t\t\tif err != nil {\n223\t\t\t\tcontinue\n224\t\t\t}\n225\t\t\tdayIdx := int(today.Sub(pt).Hours() / 24)\n226\t\t\tcol := numDays - 1 - dayIdx\n227\t\t\tif col < 0 || col >= numDays {\n228\t\t\t\tcontinue\n229\t\t\t}\n230\t\t\tband := -1\n231\t\t\tfor i, hb := range bands {\n232\t\t\t\tif p.Hour >= hb.lo && p.Hour <= hb.hi {\n233\t\t\t\t\tband = i\n234\t\t\t\t\tbreak\n235\t\t\t\t}\n236\t\t\t}\n237\t\t\tif band < 0 {\n238\t\t\t\tcontinue\n239\t\t\t}\n240\t\t\tif p.Value > grid[band][col].value {\n241\t\t\t\tgrid[band][col] = cell{value: p.Value, agentID: p.AgentID}\n242\t\t\t}\n243\t\t}\n244\t\n245\t\tsizeChars := []string{\" \", \"·\", \"•\", \"●\", \"⬤\"}\n246\t\tsizeFor := func(v int) int {\n247\t\t\tswitch {\n248\t\t\tcase v == 0:\n249\t\t\t\treturn 0\n250\t\t\tcase v <= 2:\n251\t\t\t\treturn 1\n252\t\t\tcase v <= 5:\n253\t\t\t\treturn 2\n254\t\t\tcase v <= 9:\n\n... [519 lines truncated] ..."},"type":"attachment","uuid":"2524b795-0b75-4083-980f-170c1311be16","timestamp":"2026-04-22T14:49:45.307Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"ca23ad5c-2676-470b-99f5-98e30bac81e2","version":"2.1.117","gitBranch":"soph/stats"}
