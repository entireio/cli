{"parentUuid":"70a723bd-f159-4212-93af-8559efba07ab","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/activity_cmd.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"net/url\"\n8\t\t\"os\"\n9\t\t\"sort\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/entireio/cli/cmd/entire/cli/api\"\n14\t\t\"github.com/spf13/cobra\"\n15\t\t\"golang.org/x/sync/errgroup\"\n16\t)\n17\t\n18\tconst (\n19\t\tagentUnknown      = \"unknown\"\n20\t\tdateUnknown       = \"unknown\"\n21\t\tactivityTimeframe = \"last-month\"\n22\t\tactivityLimit     = 1000\n23\t)\n24\t\n25\t// knownAgents maps normalized agent strings from the API to display IDs.\n26\t// Used for the commit list, where per-checkpoint agent strings are free-form.\n27\t// The /me/activity endpoint returns already-normalized canonical IDs.\n28\tvar knownAgents = map[string]string{\n29\t\t\"claude\":     \"claude\",\n30\t\t\"claudecode\": \"claude\",\n31\t\t\"gemini\":     \"gemini\",\n32\t\t\"geminicli\":  \"gemini\",\n33\t\t\"amp\":        \"amp\",\n34\t\t\"codex\":      \"codex\",\n35\t\t\"opencode\":   \"opencode\",\n36\t\t\"copilot\":    \"copilot\",\n37\t\t\"copilotcli\": \"copilot\",\n38\t\t\"pi\":         \"pi\",\n39\t\t\"cursor\":     \"cursor\",\n40\t\t\"droid\":      \"droid\",\n41\t\t\"kiro\":       \"kiro\",\n42\t}\n43\t\n44\tfunc newActivityCmd() *cobra.Command {\n45\t\tcmd := &cobra.Command{\n46\t\t\tUse:   \"activity\",\n47\t\t\tShort: \"Show your activity overview\",\n48\t\t\tLong:  \"Display your activity overview, repository breakdown, and recent commits from entire.io\",\n49\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n50\t\t\t\treturn runActivity(cmd.Context(), cmd.OutOrStdout(), cmd.ErrOrStderr())\n51\t\t\t},\n52\t\t}\n53\t\treturn cmd\n54\t}\n55\t\n56\tfunc runActivity(ctx context.Context, w, errW io.Writer) error {\n57\t\tclient, err := NewAuthenticatedAPIClient(false)\n58\t\tif err != nil {\n59\t\t\tfmt.Fprintln(errW, \"Not logged in. Run 'entire login' to authenticate.\")\n60\t\t\treturn NewSilentError(err)\n61\t\t}\n62\t\n63\t\t// Non-interactive fallback: piped output or accessibility mode\n64\t\tif !isTerminalWriter(w) || IsAccessibleMode() {\n65\t\t\treturn runActivityStatic(ctx, w, client)\n66\t\t}\n67\t\n68\t\treturn runActivityTUI(ctx, client)\n69\t}\n70\t\n71\tfunc runActivityStatic(ctx context.Context, w io.Writer, client *api.Client) error {\n72\t\tactivity, commits, err := fetchActivityData(ctx, client)\n73\t\tif err != nil {\n74\t\t\treturn err\n75\t\t}\n76\t\n77\t\tstats := contributionStats{\n78\t\t\tTasks:         activity.Stats.Tasks,\n79\t\t\tThroughput:    activity.Stats.Throughput,\n80\t\t\tIteration:     activity.Stats.Iteration,\n81\t\t\tOrchestration: activity.Stats.Orchestration,\n82\t\t\tStreak:        activity.Stats.Streak,\n83\t\t\tCurrentStreak: activity.Stats.CurrentStreak,\n84\t\t}\n85\t\tdays := groupCommitsByDay(commits)\n86\t\n87\t\tsty := newActivityStyles(w)\n88\t\trenderActivity(w, sty, stats, activity.Repos, activity.HourlyContributions, days)\n89\t\treturn nil\n90\t}\n91\t\n92\t// fetchActivityData fetches aggregated activity and commits concurrently.\n93\tfunc fetchActivityData(ctx context.Context, client *api.Client) (*userActivityResponse, []userCommit, error) {\n94\t\tvar activity *userActivityResponse\n95\t\tvar commits []userCommit\n96\t\n97\t\tg, gCtx := errgroup.WithContext(ctx)\n98\t\tg.Go(func() error {\n99\t\t\tvar err error\n100\t\t\tactivity, err = fetchActivity(gCtx, client)\n101\t\t\treturn err\n102\t\t})\n103\t\tg.Go(func() error {\n104\t\t\tvar err error\n105\t\t\tcommits, err = fetchCommits(gCtx, client)\n106\t\t\treturn err\n107\t\t})\n108\t\tif err := g.Wait(); err != nil {\n109\t\t\treturn nil, nil, fmt.Errorf(\"fetch activity: %w\", err)\n110\t\t}\n111\t\treturn activity, commits, nil\n112\t}\n113\t\n114\tfunc fetchActivity(ctx context.Context, client *api.Client) (*userActivityResponse, error) {\n115\t\tq := url.Values{}\n116\t\tq.Set(\"timezone\", detectTimezone())\n117\t\tq.Set(\"timeframe\", activityTimeframe)\n118\t\tq.Set(\"limit\", strconv.Itoa(activityLimit))\n119\t\tpath := \"/api/v1/me/activity?\" + q.Encode()\n120\t\n121\t\tresp, err := client.Get(ctx, path)\n122\t\tif err != nil {\n123\t\t\treturn nil, fmt.Errorf(\"GET activity: %w\", err)\n124\t\t}\n125\t\tdefer resp.Body.Close()\n126\t\n127\t\tif err := api.CheckResponse(resp); err != nil {\n128\t\t\treturn nil, fmt.Errorf(\"activity response: %w\", err)\n129\t\t}\n130\t\n131\t\tvar result userActivityResponse\n132\t\tif err := api.DecodeJSON(resp, &result); err != nil {\n133\t\t\treturn nil, fmt.Errorf(\"decode activity: %w\", err)\n134\t\t}\n135\t\treturn &result, nil\n136\t}\n137\t\n138\tfunc fetchCommits(ctx context.Context, client *api.Client) ([]userCommit, error) {\n139\t\tpath := fmt.Sprintf(\"/api/v1/me/commits?timeframe=%s&limit=%d\", activityTimeframe, activityLimit)\n140\t\tresp, err := client.Get(ctx, path)\n141\t\tif err != nil {\n142\t\t\treturn nil, fmt.Errorf(\"GET commits: %w\", err)\n143\t\t}\n144\t\tdefer resp.Body.Close()\n145\t\n146\t\tif err := api.CheckResponse(resp); err != nil {\n147\t\t\treturn nil, fmt.Errorf(\"commits response: %w\", err)\n148\t\t}\n149\t\n150\t\tvar result userCommitsResponse\n151\t\tif err := api.DecodeJSON(resp, &result); err != nil {\n152\t\t\treturn nil, fmt.Errorf(\"decode commits: %w\", err)\n153\t\t}\n154\t\treturn result.Commits, nil\n155\t}\n156\t\n157\t// detectTimezone returns an IANA timezone identifier for the current host.\n158\t// Tries $TZ first, then the /etc/localtime symlink (Unix), falling back to UTC.\n159\tfunc detectTimezone() string {\n160\t\tif tz := os.Getenv(\"TZ\"); tz != \"\" {\n161\t\t\treturn tz\n162\t\t}\n163\t\tif link, err := os.Readlink(\"/etc/localtime\"); err == nil {\n164\t\t\tconst marker = \"/zoneinfo/\"\n165\t\t\tif idx := strings.LastIndex(link, marker); idx >= 0 {\n166\t\t\t\treturn link[idx+len(marker):]\n167\t\t\t}\n168\t\t}\n169\t\tif name := time.Local.String(); name != \"\" && name != \"Local\" {\n170\t\t\treturn name\n171\t\t}\n172\t\treturn \"UTC\"\n173\t}\n174\t\n175\tfunc groupCommitsByDay(commits []userCommit) []commitDay {\n176\t\tbyDate := make(map[string][]userCommit)\n177\t\tvar dateOrder []string\n178\t\n179\t\tfor _, c := range commits {\n180\t\t\tdate := dateUnknown\n181\t\t\tif c.CommitDate != nil {\n182\t\t\t\tif t, err := parseFlexibleTime(*c.CommitDate); err == nil {\n183\t\t\t\t\tdate = t.Local().Format(\"2006-01-02\")\n184\t\t\t\t}\n185\t\t\t}\n186\t\t\tif _, exists := byDate[date]; !exists {\n187\t\t\t\tdateOrder = append(dateOrder, date)\n188\t\t\t}\n189\t\t\tbyDate[date] = append(byDate[date], c)\n190\t\t}\n191\t\n192\t\t// Sort dates newest first, with unknown dates pushed to the end\n193\t\tsort.Slice(dateOrder, func(i, j int) bool {\n194\t\t\tif dateOrder[i] == dateUnknown {\n195\t\t\t\treturn false\n196\t\t\t}\n197\t\t\tif dateOrder[j] == dateUnknown {\n198\t\t\t\treturn true\n199\t\t\t}\n200\t\t\treturn dateOrder[i] > dateOrder[j]\n201\t\t})\n202\t\n203\t\tresult := make([]commitDay, 0, len(dateOrder))\n204\t\tfor _, d := range dateOrder {\n205\t\t\tresult = append(result, commitDay{Date: d, Commits: byDate[d]})\n206\t\t}\n207\t\treturn result\n208\t}\n209\t\n210\tfunc normalizeAgentString(s string) string {\n211\t\tif s == \"\" {\n212\t\t\treturn agentUnknown\n213\t\t}\n214\t\n215\t\tvar sb strings.Builder\n216\t\tfor _, r := range s {\n217\t\t\tif r == ' ' || r == '-' || r == '_' {\n218\t\t\t\tcontinue\n219\t\t\t}\n220\t\t\tif r >= 'A' && r <= 'Z' {\n221\t\t\t\tsb.WriteByte(byte(r + 32))\n222\t\t\t} else {\n223\t\t\t\tsb.WriteRune(r)\n224\t\t\t}\n225\t\t}\n226\t\tlower := sb.String()\n227\t\n228\t\tif id, ok := knownAgents[lower]; ok {\n229\t\t\treturn id\n230\t\t}\n231\t\n232\t\tfor _, suffix := range []string{\"code\", \"cli\"} {\n233\t\t\tif len(lower) > len(suffix) && lower[len(lower)-len(suffix):] == suffix {\n234\t\t\t\tif id, ok := knownAgents[lower[:len(lower)-len(suffix)]]; ok {\n235\t\t\t\t\treturn id\n236\t\t\t\t}\n237\t\t\t}\n238\t\t}\n239\t\n240\t\tif strings.HasPrefix(lower, \"factoryaidroid\") {\n241\t\t\treturn \"droid\"\n242\t\t}\n243\t\n244\t\treturn agentUnknown\n245\t}\n246\t\n247\t// parseFlexibleTime tries RFC3339, then RFC3339Nano.\n248\tfunc parseFlexibleTime(s string) (time.Time, error) {\n249\t\tt, err := time.Parse(time.RFC3339, s)\n250\t\tif err != nil {\n251\t\t\tt, err = time.Parse(time.RFC3339Nano, s)\n252\t\t\tif err != nil {\n253\t\t\t\treturn time.Time{}, fmt.Errorf(\"parse time %q: %w\", s, err)\n254\t\t\t}\n255\t\t}\n256\t\treturn t, nil\n257\t}"},"type":"attachment","uuid":"7b3db832-336e-4604-ac72-32487847cae5","timestamp":"2026-04-22T14:49:14.605Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"ca23ad5c-2676-470b-99f5-98e30bac81e2","version":"2.1.117","gitBranch":"soph/stats"}
