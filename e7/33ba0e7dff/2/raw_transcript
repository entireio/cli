\t\t\t{Agent: \"claude\", Agents: []string{\"Claude Code\"}},\n59\t\t\t},\n60\t\t}\n61\t\tagents := uniqueCommitAgents(c)\n62\t\tif len(agents) != 1 {\n63\t\t\tt.Errorf(\"got %d agents, want 1 (should dedupe)\", len(agents))\n64\t\t}\n65\t}\n66\t\n67\tfunc TestUniqueCommitAgents_Empty(t *testing.T) {\n68\t\tt.Parallel()\n69\t\tc := userCommit{Checkpoints: nil}\n70\t\tagents := uniqueCommitAgents(c)\n71\t\tif len(agents) != 0 {\n72\t\t\tt.Errorf(\"got %v, want empty\", agents)\n73\t\t}\n74\t}\n75\t\n76\tfunc TestRenderStatCards_ContainsAllLabels(t *testing.T) {\n77\t\tt.Parallel()\n78\t\tvar buf bytes.Buffer\n79\t\tsty := activityStyles{width: 80}\n80\t\tstats := contributionStats{\n81\t\t\tThroughput:    23.2,\n82\t\t\tIteration:     1.4,\n83\t\t\tContinuityH:   0.8,\n84\t\t\tStreak:        20,\n85\t\t\tCurrentStreak: 17,\n86\t\t}\n87\t\trenderStatCards(&buf, sty, stats)\n88\t\tout := buf.String()\n89\t\n90\t\tfor _, want := range []string{\"THROUGHPUT\", \"ITERATION\", \"CONTINUITY\", \"STREAK\"} {\n91\t\t\tif !strings.Contains(out, want) {\n92\t\t\t\tt.Errorf(\"output missing label %q\", want)\n93\t\t\t}\n94\t\t}\n95\t\tif !strings.Contains(out, \"23.2\") {\n96\t\t\tt.Errorf(\"output missing throughput value 23.2\")\n97\t\t}\n98\t\tif !strings.Contains(out, \"17 current\") {\n99\t\t\tt.Errorf(\"output missing current streak\")\n100\t\t}\n101\t}\n102\t\n103\tfunc TestRenderStatCards_IterationLabelSaysSession(t *testing.T) {\n104\t\tt.Parallel()\n105\t\t// Use wide terminal so descriptions aren't truncated\n106\t\tvar buf bytes.Buffer\n107\t\tsty := activityStyles{width: 120}\n108\t\trenderStatCards(&buf, sty, contributionStats{})\n109\t\tout := buf.String()\n110\t\n111\t\tif strings.Contains(out, \"steps/checkpoint\") {\n112\t\t\tt.Error(\"ITERATION card should say 'sessions/checkpoint', not 'steps/checkpoint'\")\n113\t\t}\n114\t\tif !strings.Contains(out, \"sessions/checkpoint\") {\n115\t\t\tt.Error(\"ITERATION card missing 'sessions/checkpoint' label\")\n116\t\t}