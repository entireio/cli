err != nil {\n68\t\t\treturn fmt.Errorf(\"activity TUI: %w\", err)\n69\t\t}\n70\t\treturn nil\n71\t}\n72\t\n73\tfunc (m activityModel) fetchData() tea.Msg { //nolint:ireturn // bubbletea Cmd signature requires tea.Msg return\n74\t\tvar checkpoints []userCheckpoint\n75\t\tvar streakDates []string\n76\t\tvar commits []userCommit\n77\t\n78\t\tg, gCtx := errgroup.WithContext(m.ctx)\n79\t\tg.Go(func() error {\n80\t\t\tvar err error\n81\t\t\tcheckpoints, streakDates, err = fetchCheckpoints(gCtx, m.client)\n82\t\t\treturn err\n83\t\t})\n84\t\tg.Go(func() error {\n85\t\t\tvar err error\n86\t\t\tcommits, err = fetchCommits(gCtx, m.client)\n87\t\t\treturn err\n88\t\t})\n89\t\tif err := g.Wait(); err != nil {\n90\t\t\treturn activityErrMsg{err: err}\n91\t\t}\n92\t\n93\t\tstats := computeContributionStats(checkpoints, streakDates)\n94\t\trepos := computeRepoContributions(checkpoints)\n95\t\thourly := computeHourlyData(checkpoints)\n96\t\tdays := groupCommitsByDay(commits)\n97\t\n98\t\treturn activityDataMsg{\n99\t\t\tstats:  stats,\n100\t\t\trepos:  repos,\n101\t\t\thourly: hourly,\n102\t\t\tdays:   days,\n103\t\t}\n104\t}\n105\t\n106\tfunc (m activityModel) Init() tea.Cmd {\n107\t\treturn tea.Batch(m.spinner.Tick, m.fetchData)\n108\t}\n109\t\n110\tfunc (m activityModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) { //nolint:ireturn // bubbletea interface\n111\t\tswitch msg := msg.(type) {\n112\t\tcase activityDataMsg:\n113\t\t\tm.loading = false\n114\t\t\tm.stats = &msg.stats\n115\t\t\tm.repos = msg.repos\n116\t\t\tm.hourly = msg.hourly\n117\t\t\tm.days = msg.days\n118\t\t\tif m.width > 0 {\n119\t\t\t\tm = m.withViewport()\n120\t\t\t}\n121\t\t\treturn m, nil\n122\t\n123\t\tcase activityErrMsg:\n124\t\t\tm.loading = false\n125\t\t\tm.loadErr = msg.err\n126\t\t\treturn m, nil\n127\t\n128\t\tcase tea.KeyMsg:\n129\t\t\tif msg.Type == tea.KeyEscape || msg.Type == tea.KeyCtrlC || msg.String() == \"q\" {\n130\t\t\t\treturn m, tea.Quit\n131\t\t\t}\n132\t\n133\t\tcase tea.WindowSizeMsg:\n134\t\t\tm.width = msg.Width\n135\t\t\tm.height = msg.Height\n136\t\t\tm.sty = newActivityStylesWithWidth(m.width, m.useColor)\n137\t\t\tif m.stats != nil {\n138\t\t\t\tm = m.withViewport()\n139\t\t\t}\n140\t\t\treturn m, nil\n141\t\n142\t\tcase spinner.TickMsg:\n143\t\t\tif m.loading {\n144\t\t\t\tvar cmd tea.Cmd\n145\t\t\t\tm.spinner, cmd = m.spinner.Update(msg)\n146\t\t\t\treturn m, cmd\n147\t\t\t}\n148\t\t}\n149\t\n150\t\tif m.ready {\n151\t\t\tvar cmd tea.Cmd\n152\t\t\tm.viewport, cmd = m.viewport.Update(msg)\n153\t\t\treturn m, cmd\n154\t\t}\n155\t\n156\t\treturn m, nil\n157\t}\n158\t\n159\tfunc (m activityModel) withViewport() activityModel {\n160\t\theaderHeight := m.headerLineCount()\n161\t\tvpHeight := m.height - headerHeight - 1\n162\t\tif vpHeight < 1 {\n163\t\t\tvpHeight = 1\n164\t\t}\n165\t\n166\t\tif !m.ready {\n167\t\t\tm.viewport = viewport.New(m.width, vpHeight)\n168\t\t\tm.ready = true\n169\t\t} else {\n170\t\t\tm.viewport.Width = m.width\n171\t\t\tm.viewport.Height = vpHeight\n172\t\t}\n173\t\tm.viewport.SetContent(m.renderCommits())\n174\t\treturn m\n175\t}\n176\t\n177\tfunc (m activityModel) View() string {\n178\t\tif m.loadErr != nil {\n179\t\t\treturn fmt.Sprintf(\"\\n  Failed to load activity: %s\\n\\n  Press q to quit.\\n\", m.loadErr)\n180\t\t}\n181\t\n182\t\tif m.loading {\n183\t\t\treturn fmt.Sprintf(\"\\n  %s Loading activity...\\n\", m.spinner.View())\n184\t\t}\n185\t\n186\t\tif !m.ready {\n187\t\t\treturn \"\"\n188\t\t}\n189\t\n190\t\tvar b strings.Builder\n191\t\tb.WriteString(m.renderHeader())\n192\t\tb.WriteString(m.viewport.View())\n193\t\tb.WriteString(\"\\n\")\n194\t\tb.WriteString(m.renderFooter())\n195\t\treturn b.String()\n196\t}\n197\t\n198\tfunc (m activityModel) renderHeader() string {\n199\t\tif m.stats == nil {\n200\t\t\treturn \"\"\n201\t\t}\n202\t\tvar buf bytes.Buffer\n203\t\tbuf.WriteString(\"\\n\")\n204\t\trenderStatCards(&buf, m.sty, *m.stats)\n205\t\tbuf.WriteString(\"\\n\")\n206\t\trenderContributionChart(&buf, m.sty, m.hourly, m.repos)\n207\t\tbuf.WriteString(\"\\n\")\n208\t\trenderRepoChart(&buf, m.sty, m.repos)\n209\t\tbuf.WriteString(\"\\n\")\n210\t\treturn buf.String()\n211\t}\n212\t\n213\tfunc (m activityModel) headerLineCount() int {\n214\t\treturn strings.Count(m.renderHeader(), \"\\n\")\n215\t}\n216\t\n217\tfunc (m activityModel) renderCommits() string {\n218\t\tvar buf bytes.Buffer\n219\t\trenderCommitListN(&buf, m.sty, m.days, -1)\n220\t\treturn buf.String()\n221\t}\n222\t\n223\tfunc (m activityModel) renderFooter() string {\n224\t\tif !m.sty.colorEnabled {\n225\t\t\treturn \"\"\n226\t\t}\n227\t\thelpStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(\"241\"))\n228\t\tkeyStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(\"245\")).Bold(true)\n229\t\tsep := helpStyle.Render(\" · \")\n230\t\n231\t\tscrollPct := \"\"\n232\t\tif m.viewport.TotalLineCount() > m.viewport.Height {\n233\t\t\tpct := int(m.viewport.ScrollPercent() * 100)\n234\t\t\tscrollPct = sep + helpStyle.Render(strings.Repeat(\" \", max(0, m.width-40))+padLeft(pct)+\"%\")\n235\t\t}\n236\t\n237\t\treturn keyStyle.Render(\"↑↓\") + helpStyle.Render(\" scroll\") +\n238\t\t\tsep + keyStyle.Render(\"q\") + helpStyle.Render(\" quit\") +\n239\t\t\tscrollPct\n240\t}\n241\t\n242\tfunc newActivityStylesWithWidth(width int, useColor bool) activityStyles {\n243\t\treturn activityStyles{\n244\t\t\tcolorEnabled: useColor,\n245\t\t\twidth:        width,\n246\t\t\tbold:         lipgloss.NewStyle().Bold(true),\n247\t\t\tdim:          lipgloss.NewStyle().Faint(true),\n248\t\t\tlabel:        lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")).Bold(true),\n249\t\t\tvalue:        lipgloss.NewStyle().Bold(true),\n250\t\t\tunit:         lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")),\n251\t\t\tdesc:         lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")),\n252\t\t\trepoNm:       lipgloss.NewStyle().Foreground(lipgloss.Color(\"7\")),\n253\t\t\tcommitH:      lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")),\n254\t\t\tcommitM:      lipgloss.NewStyle().Bold(true),\n255\t\t\tadd:          lipgloss.NewStyle().Foreground(lipgloss.Color(\"2\")),\n256\t\t\tdel:          lipgloss.NewStyle().Foreground(lipgloss.Color(\"1\")),\n257\t\t\tmuted:        lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")),\n258\t\t}\n259\t}\n260\t\n261\tfunc padLeft(n int) string {\n262\t\ts := strings.Builder{}\n263\t\tif n < 10 {\n264\t\t\ts.WriteString(\"  \")\n265\t\t} else if n < 100 {\n266\t\t\ts.WriteString(\" \")\n267\t\t}\n268\t\tfmt.Fprintf(&s, \"%d\", n)\n269\t\treturn s.String()\n270\t}"},"type":"attachment","uuid":"b6adfe12-b9a1-427e-b57b-2e70aefcbee4","timestamp":"2026-04-22T14:49:45.307Z","userType":"external","entrypoint":"cli","cwd":"/Users/soph/Work/entire/devenv/cli_experiments","sessionId":"ca23ad5c-2676-470b-99f5-98e30bac81e2","version":"2.1.117","gitBranch":"soph/stats"}
