 Group checkpoints by date\n  const byDate = new Map<string, AgentContributions>()\n\n  for (const cp of checkpoints) {\n    const date = toLocalDateString(cp.commit_date)\n    if (!byDate.has(date)) {\n      byDate.set(date, {\n        claude: 0,\n        gemini: 0,\n        amp: 0,\n        codex: 0,\n        opencode: 0,\n        copilot: 0,\n        pi: 0,\n        cursor: 0,\n        droid: 0,\n        kiro: 0,\n        unknown: 0,\n      })\n    }\n\n    const agents = byDate.get(date)!\n    // Add steps to the appropriate agent bucket\n    const agentType = getAgentId(cp.agent)\n    const steps = cp.steps || 1\n    agents[agentType] += steps\n  }\n\n  // Convert to array and sort by date\n  const result: DailyContribution[] = []\n  for (const [date, agents] of byDate) {\n    result.push({ date, agents })\n  }\n  result.sort((a, b) => a.date.localeCompare(b.date))\n\n  return result\n}\n\nexport function computeHourlyChartData(checkpoints: UserCheckpoint[]): HourlyContribution[] {\n  // Group checkpoints by date + hour + agent\n  const byKey = new Map<string, HourlyContribution>()\n\n  for (const cp of checkpoints) {\n    const dateTime = new Date(cp.commit_date)\n    const date = toLocalDateString(dateTime)\n    // Use local hours to match the local date (fixes entireio/cli#536)\n    const hour = dateTime.getHours()\n    const agentType = getAgentId(cp.agent)\n    const steps = cp.steps || 1\n\n    const key = `${date}-${hour}-${agentType}`\n    if (!byKey.has(key)) {\n      byKey.set(key, {\n        date,\n        hour,\n        value: 0,\n        agentId: agentType,\n      })\n    }\n\n    byKey.get(key)!.value += steps\n  }\n\n  // Convert to array and sort by date then hour\n  const result = Array.from(byKey.values())\n  result.sort((a, b) => {\n    const dateCompare = a.date.localeCompare(b.date)\n    if (dateCompare !== 0) return dateCompare\n    return a.hour - b.hour\n  })\n\n  return result\n}\n\nfunction computeRepoData(checkpoints: UserCheckpoint[]