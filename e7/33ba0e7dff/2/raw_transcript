: \"#818cf8\", Char: '▓'},       // indigo-400\n109\t\t\"opencode\": {Label: \"OpenCode\", Color: \"#22d3ee\", Char: '▓'},    // cyan-400\n110\t\t\"copilot\":  {Label: \"Copilot\", Color: \"#a78bfa\", Char: '▓'},     // violet-400\n111\t\t\"pi\":       {Label: \"Pi\", Color: \"#fbbf24\", Char: '▓'},          // amber-400\n112\t\t\"cursor\":   {Label: \"Cursor\", Color: \"#38bdf8\", Char: '▓'},      // sky-400\n113\t\t\"droid\":    {Label: \"Droid\", Color: \"#f472b6\", Char: '▓'},       // pink-400\n114\t\t\"kiro\":     {Label: \"Kiro\", Color: \"#c084fc\", Char: '▓'},        // purple-400\n115\t\t\"unknown\":  {Label: \"Unknown\", Color: \"245\", Char: '░'},\n116\t}\n117\t\n118\tvar agentOrder = []string{\n119\t\t\"claude\", \"codex\", \"gemini\", \"amp\", \"opencode\",\n120\t\t\"copilot\", \"pi\", \"cursor\", \"droid\", \"kiro\", \"unknown\",\n121\t}\n122\t\n123\tfunc renderActivity(w io.Writer, sty activityStyles, stats contributionStats, repos []repoContribution, hourly []hourlyPoint, days []commitDay) {\n124\t\tfmt.Fprintln(w)\n125\t\trenderStatCards(w, sty, stats)\n126\t\tfmt.Fprintln(w)\n127\t\trenderContributionChart(w, sty, hourly, repos)\n128\t\tfmt.Fprintln(w)\n129\t\trenderRepoChart(w, sty, repos)\n130\t\tfmt.Fprintln(w)\n131\t\trenderCommitList(w, sty, days)\n132\t}\n133\t\n134\tfunc renderStatCards(w io.Writer, sty activityStyles, stats contributionStats) {\n135\t\tcards := []struct {\n136\t\t\tlabel string\n137\t\t\tvalue string\n138\t\t\tunit  string\n139\t\t\tdesc  string\n140\t\t}{\n141\t\t\t{\"THROUGHPUT\", fmt.Sprintf(\"%.1f\", stats.Throughput), \"k\", \"Avg. tokens/checkpoint\"},\n142\t\t\t{\"ITERATION\", fmt.Sprintf(\"%.1f\", stats.Iteration), \"x\", \"Avg sessions/checkpoint\"},\n143\t\t\t{\"CONTINUITY\", fmt.Sprintf(\"%.1f\", stats.ContinuityH), \"h\", \"Peak session length\"},\n144\t\t\t{\"STREAK\", strconv.Itoa(stats.Streak), \" day\", fmt.Sprintf(\"%d current\", stats.CurrentStreak)},\n145\t\t}\n146\t\n147\t\tcardWidth := (sty.width - 3) / 4 // 3 separators\n148\t\tif cardWidth < 16 {\n149\t\t\tcardWidth = 16\n150\t\t}\n151\t\n152\t\tvar topParts, midParts, botParts []string\n153\t\tfor _, c := range cards {\n154\t\t\tlbl := padOrTruncate(c.label, cardWidth)\n155\t\t\tdsc := padOrTruncate(c.desc, cardWidth)\n156\t\n157\t\t\ttopParts = append(topParts, sty.render(sty.label, lbl))\n158\t\t\tmidParts = append(midParts, sty.render(sty.value, c.value)+sty.render(sty.unit, c.unit)+\n159\t\t\t\tstrings.Repeat(\" \", max(0, cardWidth-len(c.value)-len(c.unit))))\n160\t\t\tbotParts = append(botParts, sty.render(sty.desc, dsc))\n161\t\t}\n162\t\n163\t\tsep := sty.render(sty.dim, \" │ \")\n164\t\tfmt.Fprintln(w, strings.Join(topParts, sep))\n165\t\tfmt.Fprintln(w, strings.Join(midParts, sep))\n166\t\tfmt.Fprintln(w, strings.Join(botParts, sep))\n167\t}\n168\t\n169\tfunc renderContributionChart(w io.Writer, sty activityStyles, hourly []hourlyPoint, repos []repoContribution) {\n170\t\trenderDotChart(w, sty, hourly, repos)\n171\t}\n172\t\n173\tfunc renderDotChart(w io.Writer, sty activityStyles, hourly []hourlyPoint, repos []repoContribution) {\n174\t\tagentTotals := make(map[string]int)\n175\t\ttotal := 0\n176\t\tfor _, r := range repos {\n177\t\t\ttotal += r.Total\n178\t\t\tfor agent, count := range r.Agents {\n179\t\t\t\tagentTotals[agent] += count\n180\t\t\t}\n181\t\t}\n182\t\n183\t\ttotalLabel := \"\"\n184\t\tif total > 0 {\n185\t\t\ttotalLabel = sty.render(sty.muted, fmt.Sprintf(\"  %d checkpoints\", total))\n186\t\t}\n187\t\tfmt.Fprintf(w, \"%s%s\\n\", sty.render(sty.label, \"CONTRIBUTIONS\"), totalLabel)\n188\t\n189\t\tif len(hourly) == 0 {\n190\t\t\tfmt.Fprintln(w, sty.render(sty.muted, \"  No activity data\"))\n191\t\t\treturn\n192\t\t}\n193\t\n194\t\tnow := time.Now().Local()\n195\t\ttoday := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())\n196\t\tnumDays := 30\n197\t\n198\t\t// 4 hour bands: 0-5, 6-11, 12-17, 18-23\n199\t\ttype hourBand struct {\n200\t\t\tlabel  string\n201\t\t\tlo, hi int\n202\t\t}\n203\t\tbands := []hourBand{\n204\t\t\t{\" 0\", 0, 5},\n205\t\t\t{\" 6\", 6, 11},\n206\t\t\t{\"12\", 12, 17},\n207\t\t\t{\"18\", 18, 23},\n208\t\t}\n209\t\n210\t\t// Grid: [band][day] -> best point\n211\t\ttype cell struct {\n212\t\t\tvalue   int\n213\t\t\tagentID string\n214\t\t}\n215\t\tgrid := make([][]cell, len(bands))\n216\t\tfor i := range grid {\n217\t\t\tgrid[i] = make([]cell, numDays)\n218\t\t}\n219\t\n220\t\tfor _, p := range hourly {\n221\t\t\tpt, err := time.ParseInLocation(\"2006-01-02\", p.Date, time.Local)\n222\t\t\tif err != nil {\n223\t\t\t\tcontinue\n224\t\t\t}\n225\t\t\tdayIdx := int(today.Sub(pt).Hours() / 24)\n226\t\t\tcol := numDays - 1 - dayIdx\n227\t\t\tif col < 0 || col >= numDays {\n228\t\t\t\tcontinue\n229\t\t\t}\n230\t\t\tband := -1\n231\t\t\tfor i, hb := range bands {\n232\t\t\t\tif p.Hour >= hb.lo && p.Hour <= hb.hi {\n233\t\t\t\t\tband = i\n234\t\t\t\t\tbreak\n235\t\t\t\t}\n236\t\t\t}\n237\t\t\tif band < 0 {\n238\t\t\t\tcontinue\n239\t\t\t}\n240\t\t\tif p.Value > grid[band][col].value {\n241\t\t\t\tgrid[band][col] = cell{value: p.Value, agentID: p.AgentID}\n242\t\t\t}\n243\t\t}\n244\t\n245\t\tsizeChars := []string{\" \", \"·\", \"•\", \"●\", \"⬤\"}\n246\t\tsizeFor := func(v int) int {\n247\t\t\tswitch {\n248\t\t\tcase v == 0:\n249\t\t\t\treturn 0\n250\t\t\tcase v <= 2:\n251\t\t\t\treturn 1\n252\t\t\tcase v <= 5:\n253\t\t\t\treturn 2\n254\t\t\tcase v <= 9:\n255\t\t\t\treturn 3\n256\t\t\tdefault:\n257\t\t\t\treturn 4\n258\t\t\t}\n259\t\t}\n260\t\n261\t\tlabelWidth := 3\n262\t\tavailCols := sty.width - labelWidth - 2\n263\t\tcolWidth := availCols / numDays\n264\t\tif colWidth < 1 {\n265\t\t\tcolWidth = 1\n266\t\t}\n267\t\n268\t\t// Date axis\n269\t\tfmt.Fprint(w, strings.Repeat(\" \", labelWidth+1))\n270\t\tstartDate := today.AddDate(0, 0, -(numDays - 1))\n271\t\tlastMonth := \"\"\n272\t\tfor d := 0; d < numDays; d++ {\n273\t\t\tdate := startDate.AddDate(0, 0, d)\n274\t\t\tmonth := date.Format(\"Jan\")\n275\t\t\tif month != lastMonth {\n276\t\t\t\tfmt.Fprint(w, sty.render(sty.muted, month))\n277\t\t\t\tlabelCols := int(math.Ceil(float64(len(month)) / float64(max(colWidth, 1))))\n278\t\t\t\tif labelCols < 1 {\n279\t\t\t\t\tlabelCols = 1\n280\t\t\t\t}\n281\t\t\t\td += labelCols - 1\n282\t\t\t\tlastMonth = month\n283\t\t\t} else {\n284\t\t\t\tfmt.Fprint(w, strings.Repeat(\" \", colWidth))\n285\t\t\t}\n286\t\t}\n287\t\tfmt.Fprintln(w)\n288\t\n289\t\t// Grid rows\n290\t\tfor band, hb := range bands {\n291\t\t\tfmt.Fprint(w, sty.render(sty.dim, hb.label)+\" \")\n292\t\t\tfor col := range numDays {\n293\t\t\t\tc := grid[band][col]\n294\t\t\t\tsz := sizeFor(c.value)\n295\t\t\t\tif sz == 0 {\n296\t\t\t\t\tfmt.Fprint(w, strings.Repeat(\" \", colWidth))\n297\t\t\t\t} else {\n298\t\t\t\t\tfmt.Fprint(w, sty.renderAgent(c.agentID, sizeChars[sz])+strings.Repeat(\" \", colWidth-1))\n299\t\t\t\t}\n300\t\t\t}\n301\t\t\tfmt.Fprintln(w)\n302\t\t}\n303\t\n304\t\t// Size legend\n305\t\tfmt.Fprintln(w, sty.render(sty.dim, \"     · 1-2   • 3-5   ● 6-9   ⬤ 10+\"))\n306\t\n307\t\t// Agent legend\n308\t\tif total > 0 {\n309\t\t\tvar parts []string\n310\t\t\tfor _, id := range agentOrder {\n311\t\t\t\tcount, ok := agentTotals[id]\n312\t\t\t\tif !ok || count == 0 {\n313\t\t\t\t\tcontinue\n314\t\t\t\t}\n315\t\t\t\tpct := float64(count) / float64(total) * 100\n316\t\t\t\tdisplay := agentDisplayMap[id]\n317\t\t\t\tparts = append(parts, sty.renderAgent(id, fmt.Sprintf(\"● %s %d%%\", display.Label, int(math.Round(pct)))))\n318\t\t\t}\n319\t\t\tfmt.Fprintln(w, strings.Join(parts, sty.render(sty.dim, \"  \")))\n320\t\t}\n321\t}\n322\t\n323\t// renderBrailleChart is an alternative contribution chart using Unicode braille\n324\t// characters for higher resolution. Swap renderDotChart → renderBrailleChart in\n325\t// renderContributionChart to enable it.\n326\tvar _ = renderBrailleChart // keep compiled while inactive\n327\t\n328\tfunc renderBrailleChart(w io.Writer, sty activityStyles, hourly []hourlyPoint, repos []repoContribution) {\n329\t\t// Agent breakdown header + total\n330\t\tagentTotals := make(map[string]int)\n331\t\ttotal := 0\n332\t\tfor _, r := range repos {\n333\t\t\ttotal += r.Total\n334\t\t\tfor agent, count := range r.Agents {\n335\t\t\t\tagentTotals[agent] += count\n336\t\t\t}\n337\t\t}\n338\t\n339\t\t// Header line: CONTRIBUTIONS  N checkpoints\n340\t\ttotalLabel := \"\"\n341\t\tif total > 0 {\n342\t\t\ttotalLabel = sty.render(sty.muted, fmt.Sprintf(\"  %d checkpoints\", total))\n343\t\t}\n344\t\tfmt.Fprintf(w, \"%s%s\\n\", sty.render(sty.label, \"CONTRIBUTIONS\"), totalLabel)\n345\t\n346\t\tif len(hourly) == 0 {\n347\t\t\tfmt.Fprintln(w, sty.render(sty.muted, \"  No activity data\"))\n348\t\t\treturn\n349\t\t}\n350\t\n351\t\t// Determine date range\n352\t\tnow := time.Now().Local()\n353\t\ttoday := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())\n354\t\tnumDays := 30\n355\t\n356\t\tlabelWidth := 3\n357\t\tchartCols := sty.width - labelWidth - 2\n358\t\tif chartCols < 20 {\n359\t\t\tchartCols = 20\n360\t\t}\n361\t\n362\t\t// 6 braille rows × 4 dots = 24 hours\n363\t\tchartRows := 6\n364\t\tdotsX := chartCols * 2\n365\t\tdotsY := chartRows * 4\n366\t\n367\t\ttype dotInfo struct {\n368\t\t\tset     bool\n369\t\t\tagentID string\n370\t\t\tvalue   int\n371\t\t}\n372\t\tdotGrid := make([][]dotInfo, dotsY)\n373\t\tfor i := range dotGrid {\n374\t\t\tdotGrid[i] = make([]dotInfo, dotsX)\n375\t\t}\n376\t\n377\t\tfor _, p := range hourly {\n378\t\t\tpt, err := time.ParseInLocation(\"2006-01-02\", p.Date, time.Local)\n379\t\t\tif err != nil {\n380\t\t\t\tcontinue\n381\t\t\t}\n382\t\t\tdayIdx := int(today.Sub(pt).Hours() / 24)\n383\t\t\tdayFromStart := numDays - 1 - dayIdx\n384\t\t\tif dayFromStart < 0 || dayFromStart >= numDays {\n385\t\t\t\tcontinue\n386\t\t\t}\n387\t\n388\t\t\tdx := int(float64(dayFromStart) / float64(numDays) * float64(dotsX))\n389\t\t\tif dx >= dotsX {\n390\t\t\t\tdx = dotsX - 1\n391\t\t\t}\n392\t\n393\t\t\tdy := p.Hour\n394\t\t\tif dy >= dotsY {\n395\t\t\t\tdy = dotsY - 1\n396\t\t\t}\n397\t\n398\t\t\t// Bubble radius scales with value\n399\t\t\tradius := 0\n400\t\t\tif p.Value >= 3 {\n401\t\t\t\tradius = 1\n402\t\t\t}\n403\t\t\tif p.Value >= 8 {\n404\t\t\t\tradius = 2\n405\t\t\t}\n406\t\n407\t\t\tfor oy := -radius; oy <= radius; oy++ {\n408\t\t\t\tfor ox := -radius; ox <= radius; ox++ {\n409\t\t\t\t\tif ox*ox+oy*oy > radius*radius+1 {\n410\t\t\t\t\t\tcontinue\n411\t\t\t\t\t}\n412\t\t\t\t\tny, nx := dy+oy, dx+ox\n413\t\t\t\t\tif ny >= 0 && ny < dotsY && nx >= 0 && nx < dotsX {\n414\t\t\t\t\t\tif p.Value > dotGrid[ny][nx].value {\n415\t\t\t\t\t\t\tdotGrid[ny][nx] = dotInfo{set: true, agentID: p.AgentID, value: p.Value}\n416\t\t\t\t\t\t}\n417\t\t\t\t\t}\n418\t\t\t\t}\n419\t\t\t}\n420\t\t}\n421\t\n422\t\t// Date axis labels\n423\t\tfmt.Fprint(w, strings.Repeat(\" \", labelWidth+1))\n424\t\tstartDate := today.AddDate(0, 0, -(numDays - 1))\n425\t\tlastMonth := \"\"\n426\t\tfor col := 0; col < chartCols; col++ {\n427\t\t\tdayFrac := float64(col) / float64(chartCols) * float64(numDays)\n428\t\t\tdate := startDate.AddDate(0, 0, int(dayFrac))\n429\t\t\tmonth := date.Format(\"Jan\")\n430\t\t\tif month != lastMonth {\n431\t\t\t\tfmt.Fprint(w, sty.render(sty.muted, month))\n432\t\t\t\tcol += len(month) - 1\n433\t\t\t\tlastMonth = month\n434\t\t\t} else {\n435\t\t\t\tfmt.Fprint(w, \" \")\n436\t\t\t}\n437\t\t}\n438\t\tfmt.Fprintln(w)\n439\t\n440\t\t// Render braille grid\n441\t\thourLabels := []string{\" 0\", \" 4\", \" 8\", \"12\", \"16\", \"20\"}\n442\t\n443\t\tfor cy := range chartRows {\n444\t\t\tfmt.Fprint(w, sty.render(sty.dim, hourLabels[cy])+\" \")\n445\t\n446\t\t\tfor cx := range chartCols {\n447\t\t\t\tvar brailleCode rune = 0x2800\n448\t\t\t\tdominantAgent := \"\"\n449\t\t\t\tmaxVal := 0\n450\t\n451\t\t\t\t// Braille dot layout: each char is 2 wide × 4 tall\n452\t\t\t\t//   dot1 dot4     bit0 bit3\n453\t\t\t\t//   dot2 dot5     bit1 bit4\n454\t\t\t\t//   dot3 dot6     bit2 bit5\n455\t\t\t\t//   dot7 dot8     bit6 bit7\n456\t\t\t\tdotBits := [8][2]int{\n457\t\t\t\t\t{0, 0}, {1, 0}, {2, 0}, {0, 1},\n458\t\t\t\t\t{1, 1}, {2, 1}, {3, 0}, {3, 1},\n459\t\t\t\t}\n460\t\n461\t\t\t\tfor bit, offset := range dotBits {\n462\t\t\t\t\tdy := cy*4 + offset[0]\n463\t\t\t\t\tdx := cx*2 + offset[1]\n464\t\t\t\t\tif dy < dotsY && dx < dotsX && dotGrid[dy][dx].set {\n465\t\t\t\t\t\tbrailleCode |= 1 << bit\n466\t\t\t\t\t\tif dotGrid[dy][dx].value > maxVal {\n467\t\t\t\t\t\t\tmaxVal = dotGrid[dy][dx].value\n468\t\t\t\t\t\t\tdominantAgent = dotGrid[dy][dx].agentID\n469\t\t\t\t\t\t}\n470\t\t\t\t\t}\n471\t\t\t\t}\n472\t\n473\t\t\t\tif brailleCode == 0x2800 {\n474\t\t\t\t\tfmt.Fprint(w, \" \")\n475\t\t\t\t} else {\n476\t\t\t\t\tfmt.Fprint(w, sty.renderAgent(dominantAgent, string(brailleCode)))\n477\t\t\t\t}\n478\t\t\t}\n479\t\t\tfmt.Fprintln(w)\n480\t\t}\n481\t\n482\t\t// Agent legend\n483\t\tif total > 0 {\n484\t\t\tvar parts []string\n485\t\t\tfor _, id := range agentOrder {\n486\t\t\t\tcount, ok := agentTotals[id]\n487\t\t\t\tif !ok || count == 0 {\n488\t\t\t\t\tcontinue\n489\t\t\t\t}\n490\t\t\t\tpct := float64(count) / float64(total) * 100\n491\t\t\t\tdisplay := agentDisplayMap[id]\n492\t\t\t\tparts = append(parts, sty.renderAgent(id, fmt.Sprintf(\"● %s %d%%\", display.Label, int(math.Round(pct)))))\n493\t\t\t}\n494\t\t\tfmt.Fprintln(w, strings.Join(parts, sty.render(sty.dim, \"  \")))\n495\t\t}\n496\t}\n497\t\n498\tfunc renderRepoChart(w io.Writer, sty activityStyles, repos []repoContribution) {\n499\t\tif len(repos) == 0 {\n500\t\t\treturn\n501\t\t}\n502\t\n503\t\tfmt.Fprintln(w, sty.render(sty.label, \"REPOSITORIES\"))\n504\t\n505\t\tmaxRepos := 5\n506\t\tif len(repos) < maxRepos {\n507\t\t\tmaxRepos = len(repos)\n508\t\t}\n509\t\tdisplay := repos[:maxRepos]\n510\t\n511\t\tmaxCount := display[0].Total\n512\t\n513\t\tmaxNameLen := 0\n514\t\tfor _, r := range display {\n515\t\t\tif len(r.Repo) > maxNameLen {\n516\t\t\t\tmaxNameLen = len(r.Repo)\n517\t\t\t}\n518\t\t}\n519\t\tif maxNameLen > 30 {\n520\t\t\tmaxNameLen = 30\n521\t\t}\n522\t\n523\t\tcountWidth := len(strconv.Itoa(maxCount))\n524\t\tbarWidth := sty.width - maxNameLen - countWidth - 4\n525\t\tif barWidth < 10 {\n526\t\t\tbarWidth = 10\n527\t\t}\n528\t\n529\t\tfor _, r := range display {\n530\t\t\tname := r.Repo\n531\t\t\tif len(name) > maxNameLen {\n532\t\t\t\tname = name[:maxNameLen-1] + \"…\"\n533\t\t\t}\n534\t\t\tname = fmt.Sprintf(\"%-*s\", maxNameLen, name)\n535\t\n536\t\t\tbar := renderAgentBar(sty, r.Agents, maxCount, barWidth)\n537\t\t\tcount := fmt.Sprintf(\"%*d\", countWidth, r.Total)\n538\t\n539\t\t\tfmt.Fprintf(w, \"%s %s %s\\n\",\n540\t\t\t\tsty.render(sty.repoNm, name),\n541\t\t\t\tbar,\n542\t\t\t\tsty.render(sty.muted, count))\n543\t\t}\n544\t}\n545\t\n546\tfunc renderAgentBar(sty activityStyles, agents map[string]int, maxCount, barWidth int) string {\n547\t\tif maxCount == 0 {\n548\t\t\treturn strings.Repeat(\" \", barWidth)\n549\t\t}\n550\t\n551\t\tvar b strings.Builder\n552\t\n553\t\tfilled := 0\n554\t\tfor _, id := range agentOrder {\n555\t\t\tcount, ok := agents[id]\n556\t\t\tif !ok || count == 0 {\n557\t\t\t\tcontinue\n558\t\t\t}\n559\t\t\tsegWidth := int(math.Round(float64(count) / float64(maxCount) * float64(barWidth)))\n560\t\t\tif segWidth < 1 && count > 0 {\n561\t\t\t\tsegWidth = 1\n562\t\t\t}\n563\t\t\tif filled+segWidth > barWidth {\n564\t\t\t\tsegWidth = barWidth - filled\n565\t\t\t}\n566\t\t\tif segWidth <= 0 {\n567\t\t\t\tcontinue\n568\t\t\t}\n569\t\n570\t\t\tdisplay := agentDisplayMap[id]\n571\t\t\tseg := strings.Repeat(string(display.Char), segWidth)\n572\t\t\tb.WriteString(sty.renderAgent(id, seg))\n573\t\t\tfilled += segWidth\n574\t\t}\n575\t\n576\t\tif filled < barWidth {\n577\t\t\tb.WriteString(sty.render(sty.dim, strings.Repeat(\"░\", barWidth-filled)))\n578\t\t}\n579\t\n580\t\treturn b.String()\n581\t}\n582\t\n583\tfunc renderCommitList(w io.Writer, sty activityStyles, days []commitDay) {\n584\t\trenderCommitListN(w, sty, days, 