469\t\t}\n470\t\treturn int(maxNum) + 1, nil\n471\t}\n472\t\n473\t// rotateGeneration archives the current /full/current generation and creates\n474\t// a fresh orphan. This is a 2-phase operation:\n475\t//\n476\t//  1. Archive: determine the next generation number, create a new ref pointing\n477\t//     to the current /full/current commit.\n478\t//  2. Reset: create a fresh orphan commit with an empty tree + seed generation.json,\n479\t//     point /full/current at it.\n480\tfunc (s *V2GitStore) rotateGeneration(ctx context.Context) error {\n481\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n482\t\n483\t\t// Guard against concurrent rotation: re-read /full/current and check if\n484\t\t// it's still above the threshold. If not, another instance already rotated.\n485\t\t_, currentTreeHash, err := s.GetRefState(refName)\n486\t\tif err != nil {\n487\t\t\treturn fmt.Errorf(\"rotation: failed to read /full/current: %w\", err)\n488\t\t}\n489\t\tcheckpointCount, err := s.CountCheckpointsInTree(currentTreeHash)\n490\t\tif err != nil {\n491\t\t\treturn fmt.Errorf(\"rotation: failed to count checkpoints: %w\", err)\n492\t\t}\n493\t\tif checkpointCount < s.maxCheckpoints() {\n494\t\t\treturn nil\n495\t\t}\n496\t\n497\t\tcurrentRef, err := s.repo.Reference(refName, true)\n498\t\tif err != nil {\n499\t\t\treturn fmt.Errorf(\"rotation: failed to read /full/current ref: %w\", err)\n500\t\t}\n501\t\n502\t\tarchiveNumber, err := s.nextGenerationNumber()\n503\t\tif err != nil {\n504\t\t\treturn fmt.Errorf(\"rotation: failed to determine next generation number: %w\", err)\n505\t\t}\n506\t\n507\t\t// Phase 1: Archive — create ref pointing to the current commit.\n508\t\t// If the archive ref already exists, another instance already rotated — skip.\n509\t\tarchiveRefName := plumbing.ReferenceName(fmt.Sprintf(\"%s%0*d\", paths.V2FullRefPrefix, generationRefWidth, archiveNumber))\n510\t\tif _, refErr := s.repo.Reference(archiveRefName, true); refErr == nil {\n511\t\t\tlogging.Info(ctx, \"rotation: archive ref already exists, skipping\",\n512\t\t\t\tslog.String(\"archive_ref\", string(archiveRefName)),\n513\t\t\t)\n514\t\t\treturn nil\n515\t\t}\n516\t\tarchiveRef := plumbing.NewHashReference(archiveRefName, currentRef.Hash())\n517\t\tif err := s.repo.Storer.SetReference(archiveRef); err != nil {\n518\t\t\treturn fmt.Errorf(\"rotation: failed to create archived ref %s: %w\", archiveRefName, err)\n519\t\t}\n520\t\n521\t\t// Verify /full/current hasn't been advanced by another writer since we read it.\n522\t\t// If it changed, abort — the archive ref is harmless (points to a valid commit)\n523\t\t// and the next writer will trigger rotation again.\n524\t\tpostArchiveRef, err := s.repo.Reference(refName, true)\n525\t\tif err != nil {\n526\t\t\treturn fmt.Errorf(\"rotation: failed to re-read /full/current: %w\", err)\n527\t\t}\n528\t\tif postArchiveRef.Hash() != currentRef.Hash() {\n529\t\t\tlogging.Info(ctx, \"rotation: /full/current changed during rotation, aborting reset\")\n530\t\t\treturn nil\n531\t\t}\n532\t\n533\t\t// Write generation.json to the current tree before archiving.\n534\t\tgen := s.computeGenerationTimestamps(currentTreeHash)\n535\t\tarchiveTreeHash, err := s.AddGenerationJSONToTree(currentTreeHash, gen)\n536\t\tif err != nil {\n537\t\t\treturn fmt.Errorf(\"rotation: failed to add generation.json: %w\", err)\n538\t\t}\n539\t\n540\t\tauthorName, authorEmail := GetGitAuthorFromRepo(s.repo)\n541\t\tarchiveCommitHash, err := CreateCommit(ctx, s.repo, archiveTreeHash, currentRef.Hash(), \"Archive generation\", authorName, authorEmail)\n542\t\tif err != nil {\n543\t\t\treturn fmt.Errorf(\"rotation: failed to create archive commit: %w\", err)\n544\t\t}\n545\t\n546\t\t// Update the archive ref to point to the commit with generation.json\n547\t\tarchiveRef = plumbing.NewHashReference(archiveRefName, archiveCommitHash)\n548\t\tif err := s.repo.Storer.SetReference(archiveRef); err != nil {\n549\t\t\treturn fmt.Errorf(\"rotation: failed to update archived ref %s: %w\", archiveRefName, err)\n550\t\t}\n551\t\n552\t\t// Phase 2: Create fresh orphan /full/current (empty tree, no generation.json)\n553\t\temptyTreeHash, err := BuildTreeFromEntries(ctx, s.repo, make(map[string]object.TreeEntry))\n554\t\tif err != nil {\n555\t\t\treturn fmt.Errorf(\"rotation: failed to build empty tree: %w\", err)\n556\t\t}\n557\t\n558\t\torphanCommitHash, err := CreateCommit(ctx, s.repo, emptyTreeHash, plumbing.ZeroHash, \"Start generation\", authorName, authorEmail)\n559\t\tif err != nil {\n560\t\t\treturn fmt.Errorf(\"rotation: failed to create orphan commit: %w\", err)\n561\t\t}\n562\t\n563\t\torphanRef := plumbing.NewHashReference(refName, orphanCommitHash)\n564\t\tif err := s.repo.Storer.SetReference(orphanRef); err != nil {\n565\t\t\treturn fmt.Errorf(\"rotation: failed to reset /full/current: %w\", err)\n566\t\t}\n567\t\n568\t\tlogging.Info(ctx, \"generation rotation complete\",\n569\t\t\tslog.Int(\"archived_generation\", archiveNumber),\n570\t\t\tslog.String(\"archive_ref\", string(archiveRefName)),\n571\t\t)\n572\t\n573\t\treturn nil\n574\t}\n575\t"}]},"uuid":"382a2a3b-28b2-4ee5-aad0-beca404fb1a0","timestamp":"2026-04-30T22:56:53.413Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/pfleidi/entire/cli/.worktrees/fix/entire-migrate-checkpoint-order/cmd/entire/cli/checkpoint/v2_generation.go","content":"package checkpoint\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/jsonutil\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/go-git/go-git/v6/plumbing\"\n\t\"github.com/go-git/go-git/v6/plumbing/filemode\"\n\t\"github.com/go-git/go-git/v6/plumbing/object\"\n)\n\n// DefaultMaxCheckpointsPerGeneration is the rotation threshold.\n// When a generation reaches this many checkpoints, it is archived\n// and a fresh /full/current is created.\nconst DefaultMaxCheckpointsPerGeneration = 100\n\n// GenerationMetadata tracks the state of a /full/* generation.\n// Written to the tree root as generation.json at archive time only — not during\n// normal writes to /full/current. This keeps /full/current free of root-level\n// files, ensuring conflict-free tree merges during push recovery.\n//\n// The generation's sequence number is derived from the ref name, not stored here.\n// Checkpoint membership is determined by walking the tree (shard directories).\ntype GenerationMetadata struct {\n\t// OldestCheckpointAt is the creation time of the earliest checkpoint.\n\tOldestCheckpointAt time.Time `json:\"oldest_checkpoint_at\"`\n\n\t// NewestCheckpointAt is the creation time of the most recent checkpoint.\n\tNewestCheckpointAt time.Time `json:\"newest_checkpoint_at\"`\n}\n\n// ReadGeneration reads generation.json from the given tree hash.\n// Returns a zero-value GenerationMetadata if the file doesn't exist (new/empty generation).\nfunc (s *V2GitStore) ReadGeneration(treeHash plumbing.Hash) (GenerationMetadata, error) {\n\tif treeHash == plumbing.ZeroHash {\n\t\treturn GenerationMetadata{}, nil\n\t}\n\n\ttree, err := s.repo.TreeObject(treeHash)\n\tif err != nil {\n\t\treturn GenerationMetadata{}, fmt.Errorf(\"failed to read tree: %w\", err)\n\t}\n\n\tfile, err := tree.File(paths.GenerationFileName)\n\tif err != nil {\n\t\tif errors.Is(err, object.ErrFileNotFound) || errors.Is(err, object.ErrEntryNotFound) {\n\t\t\treturn GenerationMetadata{}, nil\n\t\t}\n\t\treturn GenerationMetadata{}, fmt.Errorf(\"failed to find %s in tree: %w\", paths.GenerationFileName, err)\n\t}\n\n\tcontent, err := file.Contents()\n\tif err != nil {\n\t\treturn GenerationMetadata{}, fmt.Errorf(\"failed to read %s: %w\", paths.GenerationFileName, err)\n\t}\n\n\tvar gen GenerationMetadata\n\