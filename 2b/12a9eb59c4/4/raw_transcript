n413\t\n414\tfunc nextMigratedGenerationNumber(v2Store *checkpoint.V2GitStore) (int, error) {\n415\t\tarchived, err := v2Store.ListArchivedGenerations()\n416\t\tif err != nil {\n417\t\t\treturn 0, fmt.Errorf(\"list archived v2 generations: %w\", err)\n418\t\t}\n419\t\tnext := 1\n420\t\tfor _, name := range archived {\n421\t\t\tn, parseErr := strconv.Atoi(name)\n422\t\t\tif parseErr != nil {\n423\t\t\t\tcontinue\n424\t\t\t}\n425\t\t\tif n >= next {\n426\t\t\t\tnext = n + 1\n427\t\t\t}\n428\t\t}\n429\t\treturn next, nil\n430\t}\n431\t\n432\tfunc writeMigratedFullGeneration(ctx context.Context, repo *git.Repository, refName plumbing.ReferenceName, checkpoints []migratedFullCheckpoint) error {\n433\t\tentries := make(map[string]object.TreeEntry)\n434\t\tvar gen checkpoint.GenerationMetadata\n435\t\tfoundTime := false\n436\t\n437\t\tfor _, cp := range checkpoints {\n438\t\t\tfor _, session := range cp.sessions {\n439\t\t\t\tif err := writeMigratedFullSessionEntries(ctx, repo, cp, session, entries); err != nil {\n440\t\t\t\t\treturn fmt.Errorf(\"write full session entries for checkpoint %s session %d: %w\", cp.checkpointID, session.sessionIndex, err)\n441\t\t\t\t}\n442\t\t\t\tmergeMigratedGenerationTime(&gen, &foundTime, session.content.Metadata.CreatedAt)\n443\t\t\t}\n444\t\t}\n445\t\n446\t\tif !foundTime {\n447\t\t\tnow := time.Now().UTC()\n448\t\t\tgen = checkpoint.GenerationMetadata{\n449\t\t\t\tOldestCheckpointAt: now,\n450\t\t\t\tNewestCheckpointAt: now,\n451\t\t\t}\n452\t\t}\n453\t\n454\t\ttreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, entries)\n455\t\tif err != nil {\n456\t\t\treturn fmt.Errorf(\"build migrated generation tree: %w\", err)\n457\t\t}\n458\t\n459\t\tv2Store := checkpoint.NewV2GitStore(repo, migrateRemoteName)\n460\t\ttreeHash, err = v2Store.AddGenerationJSONToTree(treeHash, gen)\n461\t\tif err != nil {\n462\t\t\treturn fmt.Errorf(\"add generation metadata: %w\", err)\n463\t\t}\n464\t\n465\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, treeHash, plumbing.ZeroHash,\n466\t\t\tfmt.Sprintf(\"Archive migrated generation: %s\\n\", refName),\n467\t\t\t\"Entire Migration\", \"migration@entire.dev\")\n468\t\tif err != nil {\n469\t\t\treturn fmt.Errorf(\"create migrated generation commit: %w\", err)\n470\t\t}\n471\t\n472\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n473\t\t\treturn fmt.Errorf(\"update migrated generation ref %s: %w\", refName, err)\n474\t\t}\n475\t\treturn nil\n476\t}\n477\t\n478\tfunc writeMigratedFullSessionEntries(ctx context.Context, repo *git.Repository, cp migratedFullCheckpoint, session migratedFullSession, entries map[string]object.TreeEntry) error {\n479\t\tsessionPath := fmt.Sprintf(\"%s/%d/\", cp.checkpointID.Path(), session.sessionIndex)\n480\t\ttranscript := session.content.Transcript\n481\t\n482\t\tchunks, err := agent.ChunkTranscript(ctx, transcript, session.content.Metadata.Agent)\n483\t\tif err != nil {\n484\t\t\treturn fmt.Errorf(\"chunk transcript: %w\", err)\n485\t\t}\n486\t\tfor i, chunk := range chunks {\n487\t\t\tblobHash, blobErr := checkpoint.CreateBlobFromContent(repo, chunk)\n488\t\t\tif blobErr != nil {\n489\t\t\t\treturn fmt.Errorf(\"create transcript blob: %w\", blobErr)\n490\t\t\t}\n491\t\t\tpath := sessionPath + agent.ChunkFileName(paths.V2RawTranscriptFileName, i)\n492\t\t\tentries[path] = object.TreeEntry{\n493\t\t\t\tName: path,\n494\t\t\t\tMode: filemode.Regular,\n495\t\t\t\tHash: blobHash,\n496\t\t\t}\n497\t\t}\n498\t\n499\t\thashPath := sessionPath + paths.V2RawTranscriptHashFileName\n500\t\tcontentHash := fmt.Sprintf(\"sha256:%x\", sha256.Sum256(transcript))\n501\t\thashBlob, err := checkpoint.CreateBlobFromContent(repo, []byte(contentHash))\n502\t\tif err != nil {\n503\t\t\treturn fmt.Errorf(\"create transcript hash blob: %w\", err)\n504\t\t}\n505\t\tentries[hashPath] = object.TreeEntry{\n506\t\t\tName: hashPath,\n507\t\t\tMode: filemode.Regular,\n508\t\t\tHash: hashBlob,\n509\t\t}\n510\t\n511\t\tfor _, taskTreeHash := range cp.taskTrees[session.sessionIndex] {\n512\t\t\ttaskTree, treeErr := repo.TreeObject(taskTreeHash)\n513\t\t\tif treeErr != nil {\n514\t\t\t\treturn fmt.Errorf(\"read task metadata tree: %w\", treeErr)\n515\t\t\t}\n516\t\t\tif flattenErr := checkpoint.FlattenTree(repo, taskTree, sessionPath+\"tasks\", entries); flattenErr != nil {\n517\t\t\t\treturn fmt.Errorf(\"flatten task metadata tree: %w\", flattenErr)\n518\t\t\t}\n519\t\t}\n520\t\n521\t\treturn nil\n522\t}\n523\t\n524\tfunc mergeMigratedGenerationTime(gen *checkpoint.GenerationMetadata, found *bool, ts time.Time) {\n525\t\tif ts.IsZero() {\n526\t\t\treturn\n527\t\t}\n528\t\tts = ts.UTC()\n529\t\tif !*found {\n530\t\t\tgen.OldestCheckpointAt = ts\n531\t\t\tgen.NewestCheckpointAt = ts\n532\t\t\t*found = true\n533\t\t\treturn\n534\t\t}\n535\t\tif ts.Before(gen.OldestCheckpointAt) {\n536\t\t\tgen.OldestCheckpointAt = ts\n537\t\t}\n538\t\tif ts.After(gen.NewestCheckpointAt) {\n539\t\t\tgen.NewestCheckpointAt = ts\n540\t\t}\n541\t}\n542\t\n543\tfunc ensureEmptyV2FullCurrent(ctx context.Context, repo *git.Repository) error {\n544\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n545\t\tif _, err := repo.Reference(refName, true); err == nil {\n546\t\t\treturn nil\n547\t\t}\n548\t\n549\t\temptyTreeHash, err := checkpoint.BuildTreeFromEntries(ctx, repo, map[string]object.TreeEntry{})\n550\t\tif err != nil {\n551\t\t\treturn fmt.Errorf(\"build empty v2 full/current tree: %w\", err)\n552\t\t}\n553\t\n554\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, emptyTreeHash, plumbing.ZeroHash,\n555\t\t\t\"Start generation\\n\",\n556\t\t\t\"Entire Migration\", \"migration@entire.dev\")\n557\t\tif err != nil {\n558\t\t\treturn fmt.Errorf(\"create empty v2 full/current commit: %w\", err)\n559\t\t}\n560\t\n561\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n562\t\t\treturn fmt.Errorf(\"update %s: %w\", refName, err)\n563\t\t}\n564\t\treturn nil\n565\t}\n566\t\n567\tfunc readV1SessionForMigration(ctx context.Context, out io.Writer, prefix string, v1Store *checkpoint.GitStore, checkpointID id.CheckpointID, sessionIdx int) (*checkpoint.SessionContent, bool, error) {\n568\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, checkpointID, sessionIdx)\n569\t\tif readErr != nil {\n570\t\t\tif errors.Is(readErr, checkpoint.ErrNoTranscript) || errors.Is(readErr, checkpoint.ErrCheckpointNotFound) {\n571\t\t\t\twarnMissingV1Session(ctx, out, prefix, checkpointID, sessionIdx, readErr)\n572\t\t\t\treturn nil, true, nil\n573\t\t\t}\n574\t\t\treturn nil, false, fmt.Errorf(\"read v1 session content: %w\", readErr)\n575\t\t}\n576\t\treturn content, false, nil\n577\t}\n578\t\n579\tfunc warnMissingV1Session(ctx context.Context, out io.Writer, prefix string, checkpointID id.CheckpointID, sessionIdx int, err error) {\n580\t\tfmt.Fprintf(out, \"%s warning: skipping v1 session %d because checkpoint metadata lists it, but no transcript/session content exists for that session\\n\", prefix, sessionIdx)\n581\t\tlogging.Warn(ctx, \"skipping v1 session with missing transcript during checkpoint migration\",\n582\t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n583\t\t\tslog.Int(\"session_index\", sessionIdx),\n584\t\t\tslog.String(\"error\", err.Error()),\n585\t\t)\n586\t}\n587\t\n588\tfunc pruneV2CheckpointForForce(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID) error {\n589\t\tfor _, refName := range []plumbing.ReferenceName{\n590\t\t\tplumbing.ReferenceName(paths.V2MainRefName),\n591\t\t\tplumbing.ReferenceName(paths.V2FullCurrentRefName),\n592\t\t} {\n593\t\t\tif err := pruneV2CheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n594\t\t\t\treturn err\n595\t\t\t}\n596\t\t}\n597\t\n598\t\tarchived, err := v2Store.ListArchivedGenerations()\n599\t\tif err != nil {\n600\t\t\treturn fmt.Errorf(\"failed to list archived v2 generations while pruning checkpoint %s: %w\", cpID, err)\n601\t\t}\n602\t\tfor _, generation := range archived {\n603\t\t\trefName := plumbing.ReferenceName(paths.V2FullRefPrefix + generation)\n604\t\t\tif err := pruneV2ArchivedCheckpointRef(ctx, repo, v2Store, refName, cpID); err != nil {\n605\t\t\t\treturn err\n606\t\t\t}\n607\t\t}\n608\t\n609\t\treturn nil\n610\t}\n611\t\n612\tfunc pruneV2CheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n613\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n614\t\tif err != nil {\n615\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n616\t\t\t\treturn nil\n617\t\t\t}\n618\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n619\t\t}\n620\t\n621\t\trootTree, err := repo.TreeObject(rootTreeHash)\n622\t\tif err != nil {\n623\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n624\t\t}\n625\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n626\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n627\t\t}\n628\t\n629\t\tshardPrefix := string(cpID[:2])\n630\t\tshardSuffix := string(cpID[2:])\n631\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n632\t\tif err != nil {\n633\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n634\t\t}\n635\t\tif newRoot == rootTreeHash {\n636\t\t\treturn nil\n637\t\t}\n638\t\n639\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n640\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n641\t\t\t\"Entire Migration\", \"migration@entire.dev\")\n642\t\tif err != nil {\n643\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n644\t\t}\n645\t\n646\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n647\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n648\t\t}\n649\t\treturn nil\n650\t}\n651\t\n652\tfunc pruneV2ArchivedCheckpointRef(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, refName plumbing.ReferenceName, cpID id.CheckpointID) error {\n653\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n654\t\tif err != nil {\n655\t\t\tif errors.Is(err, plumbing.ErrReferenceNotFound) {\n656\t\t\t\treturn nil\n657\t\t\t}\n658\t\t\treturn fmt.Errorf(\"failed to get v2 ref state for %s: %w\", refName, err)\n659\t\t}\n660\t\n661\t\trootTree, err := repo.TreeObject(rootTreeHash)\n662\t\tif err != nil {\n663\t\t\treturn fmt.Errorf(\"failed to read v2 tree for %s: %w\", refName, err)\n664\t\t}\n665\t\tif _, err := rootTree.Tree(cpID.Path()); err != nil {\n666\t\t\treturn nil //nolint:nilerr // Checkpoint is absent from this ref, so there is nothing to prune.\n667\t\t}\n668\t\n669\t\tshardPrefix := string(cpID[:2])\n670\t\tshardSuffix := string(cpID[2:])\n671\t\tnewRoot, err := pruneCheckpointFromRoot(repo, rootTreeHash, shardPrefix, shardSuffix)\n672\t\tif err != nil {\n673\t\t\treturn fmt.Errorf(\"failed to remove checkpoint subtree from %s: %w\", refName, err)\n674\t\t}\n675\t\tif newRoot == rootTreeHash {\n676\t\t\treturn nil\n677\t\t}\n678\t\n679\t\tcount, err := v2Store.CountCheckpointsInTree(newRoot)\n680\t\tif err != nil {\n681\t\t\treturn fmt.Errorf(\"failed to count checkpoints in pruned %s: %w\", refName, err)\n682\t\t}\n683\t\tif count == 0 {\n684\t\t\tif err := repo.Storer.RemoveReference(refName); err != nil {\n685\t\t\t\treturn fmt.Errorf(\"failed to remove empty archived v2 generation %s: %w\", refName, err)\n686\t\t\t}\n687\t\t\treturn nil\n688\t\t}\n689\t\n690\t\tnewRoot, err = addRecomputedGenerationJSON(v2Store, newRoot)\n691\t\tif err != nil {\n692\t\t\treturn fmt.Errorf(\"failed to recompute generation metadata for %s: %w\", refName, err)\n693\t\t}\n694\t\n695\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n696\t\t\tfmt.Sprintf(\"Reset checkpoint before force migration: %s\\n\", cpID),\n697\t\t\t\"Entire Migration\", \"migration@entire.dev\")\n698\t\tif err != nil {\n699\t\t\treturn fmt.Errorf(\"failed to create v2 prune commit for %s: %w\", refName, err)\n700\t\t}\n701\t\n702\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n703\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n704\t\t}\n705\t\treturn nil\n706\t}\n707\t\n708\tfunc addRecomputedGenerationJSON(v2Store *checkpoint.V2GitStore, treeHash plumbing.Hash) (plumbing.Hash, error) {\n709\t\tgen, found, err := v2Store.ComputeGenerationRawTranscriptTimestamps(treeHash)\n710\t\tif err != nil {\n711\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute raw transcript timestamps: %w\", err)\n712\t\t}\n713\t\tif !found {\n714\t\t\tgen, found, err = v2Store.ComputeGenerationCheckpointTimestamps(treeHash)\n715\t\t\tif err != nil {\n716\t\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"compute checkpoint timestamps: %w\", err)\n717\t\t\t}\n718\t\t}\n719\t\tif !found {\n720\t\t\treturn treeHash, nil\n721\t\t}\n722\t\n723\t\tnewTreeHash, err := v2Store.AddGenerationJSONToTree(treeHash, gen)\n724\t\tif err != nil {\n725\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"add generation metadata: %w\", err)\n726\t\t}\n727\t\treturn newTreeHash, nil\n728\t}\n729\t\n730\tfunc pruneCheckpointFromRoot(repo *git.Repository, rootTreeHash plumbing.Hash, shardPrefix, shardSuffix string) (plumbing.Hash, error) {\n731\t\tnewRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n732\t\t\t[]string{shardPrefix},\n733\t\t\tnil,\n734\t\t\tcheckpoint.UpdateSubtreeOptions{\n735\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n736\t\t\t\tDeleteNames: []string{shardSuffix},\n737\t\t\t},\n738\t\t)\n739\t\tif err != nil {\n740\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune checkpoint from shard: %w\", err)\n741\t\t}\n742\t\tif newRoot == rootTreeHash {\n743\t\t\treturn newRoot, nil\n744\t\t}\n745\t\n746\t\tnewRootTree, err := repo.TreeObject(newRoot)\n747\t\tif err != nil {\n748\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to read pruned root tree: %w\", err)\n749\t\t}\n750\t\tshardTree, err := newRootTree.Tree(shardPrefix)\n751\t\tif err != nil {\n752\t\t\treturn newRoot, nil //nolint:nilerr // The shard prefix was already absent after pruning.\n753\t\t}\n754\t\tif len(shardTree.Entries) > 0 {\n755\t\t\treturn newRoot, nil\n756\t\t}\n757\t\n758\t\tprunedRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n759\t\t\tnil,\n760\t\t\tnil,\n761\t\t\tcheckpoint.UpdateSubtreeOptions{\n762\t\t\t\tMergeMode:   checkpoint.MergeKeepExisting,\n763\t\t\t\tDeleteNames: []string{shardPrefix},\n764\t\t\t},\n765\t\t)\n766\t\tif err != nil {\n767\t\t\treturn plumbing.ZeroHash, fmt.Errorf(\"failed to prune empty shard prefix: %w\", err)\n768\t\t}\n769\t\treturn prunedRoot, nil\n770\t}\n771\t\n772\tfunc collectMissingFullCheckpointForPacking(\n773\t\tctx context.Context,\n774\t\trepo *git.Repository,\n775\t\tv1Store *checkpoint.GitStore,\n776\t\tv2Store *checkpoint.V2GitStore,\n777\t\tinfo checkpoint.CommittedInfo,\n778\t\tv2Summary *checkpoint.CheckpointSummary,\n779\t) (*migratedFullCheckpoint, bool, error) {\n780\t\tv1Summary, err := v1Store.ReadCommitted(ctx, info.CheckpointID)\n781\t\tif err != nil {\n782\t\t\treturn nil, false, fmt.Errorf(\"failed to read v1 summary while checking v2 raw artifacts: %w\", err)\n783\t\t}\n784\t\tif v1Summary == nil {\n785\t\t\treturn nil, false, fmt.Errorf(\"v1 checkpoint %s has no summary\", info.CheckpointID)\n786\t\t}\n787\t\n788\t\tv1BySessionID, v1ByIndex, err := collectV1SessionsForPacking(ctx, v1Store, info.CheckpointID, v1Summary)\n789\t\tif err != nil {\n790\t\t\treturn nil, false, err\n791\t\t}\n792\t\n793\t\tfullCheckpoint := &migratedFullCheckpoint{\n794\t\t\tcheckpointID: info.CheckpointID,\n795\t\t}\n796\t\tv1ToV2SessionIdx := make(map[int]int)\n797\t\n798\t\tfor sessionIdx := range len(v2Summary.Sessions) {\n799\t\t\tok, checkErr := hasFullSessionArtifacts(v2Store, info.CheckpointID, sessionIdx)\n800\t\t\tif checkErr != nil {\n801\t\t\t\treturn nil, false, fmt.Errorf(\"failed to check v2 session %d artifacts: %w\", sessionIdx, checkErr)\n802\t\t\t}\n803\t\t\tif ok {\n804\t\t\t\tcontinue\n805\t\t\t}\n806\t\n807\t\t\tv2Content, readErr := v2Store.ReadSessionMetadataAndPrompts(ctx, info.CheckpointID, sessionIdx)\n808\t\t\tif readErr != nil {\n809\t\t\t\treturn nil, false, fmt.Errorf(\"failed to read v2 session %d metadata while checking raw artifacts: %w\", sessionIdx, readErr)\n810\t\t\t}\n811\t\n812\t\t\tv1Session, ok := v1BySessionID[v2Content.Metadata.SessionID]\n813\t\t\tif !ok {\n814\t\t\t\tv1Session, ok = v1ByIndex[sessionIdx]\n815\t\t\t}\n816\t\t\tif !ok {\n817\t\t\t\treturn nil, false, fmt.Errorf(\"failed to find v1 session for v2 session %d while checking raw artifacts\", sessionIdx)\n818\t\t\t}\n819\t\n820\t\t\tfullCheckpoint.sessions = append(fullCheckpoint.sessions, migratedFullSession{\n821\t\t\t\tsessionIndex: sessionIdx,\n822\t\t\t\tcontent:      v1Session.content,\n823\t\t\t})\n824\t\t\tv1ToV2SessionIdx[v1Session.sessionIndex] = sessionIdx\n825\t\t}\n826\t\n827\t\tif len(fullCheckpoint.sessions) == 0 {\n828\t\t\treturn &migratedFullCheckpoint{}, false, nil\n829\t\t}\n830\t\n831\t\ttaskTrees, taskErr := collectTaskMetadataForMigratedFullGeneration(repo, info.CheckpointID, v1Summary, v1ToV2SessionIdx)\n832\t\tif taskErr != nil {\n833\t\t\treturn nil, false, fmt.Errorf(\"failed to collect task metadata while checking raw artifacts: %w\", taskErr)\n834\t\t}\n835\t\tfullCheckpoint.taskTrees = taskTrees\n836\t\n837\t\treturn fullCheckpoint, true, nil\n838\t}\n839\t\n840\ttype v1SessionForPacking struct {\n841\t\tsessionIndex int\n842\t\tcontent      *checkpoint.SessionContent\n843\t}\n844\t\n845\tfunc collectV1SessionsForPacking(\n846\t\tctx context.Context,\n847\t\tv1Store *checkpoint.GitStore,\n848\t\tcheckpointID id.CheckpointID,\n849\t\tsummary *checkpoint.CheckpointSummary,\n850\t) (map[string]v1SessionForPacking, map[int]v1SessionForPacking, error) {\n851\t\tbySessionID := make(map[string]v1SessionForPacking)\n852\t\tbyIndex := make(map[int]v1SessionForPacking)\n853\t\n854\t\tfor sessionIdx := range len(summary.Sessions) {\n855\t\t\tcontent, err := v1Store.ReadSessionContent(ctx, checkpointID, sessionIdx)\n856\t\t\tif err != nil {\n857\t\t\t\tif errors.Is(err, checkpoint.ErrNoTranscript) || errors.Is(err, checkpoint.ErrCheckpointNotFound) {\n858\t\t\t\t\tcontinue\n859\t\t\t\t}\n860\t\t\t\treturn nil, nil, fmt.Errorf(\"failed to read v1 session %d while checking raw artifacts: %w\", sessionIdx, err)\n861\t\t\t}\n862\t\n863\t\t\tsession := v1SessionForPacking{\n864\t\t\t\tsessionIndex: sessionIdx,\n865\t\t\t\tcontent:      content,\n866\t\t\t}\n867\t\t\tbyIndex[sessionIdx] = session\n868\t\t\tif content.Metadata.SessionID != \"\" {\n869\t\t\t\tbySessionID[content.Metadata.SessionID] = session\n870\t\t\t}\n871\t\t}\n872\t\n873\t\treturn bySessionID, byIndex, nil\n874\t}\n875\t\n876\tfunc hasFullSessionArtifacts(v2Store *checkpoint.V2GitStore, cpID id.CheckpointID, sessionIdx int) (bool, error) {\n877\t\tok, err := v2Store.HasFullSessionArtifacts(cpID, sessionIdx)\n878\t\tif err != nil {\n879\t\t\treturn false, fmt.Errorf(\"failed to check v2 full artifacts for session %d: %w\", sessionIdx, err)\n880\t\t}\n881\t\treturn ok, nil\n882\t}\n883\t\n884\t// backfillCompactTranscripts checks sessions in an already-migrated v2 checkpoint\n885\t// for missing transcript.jsonl and attempts to generate + write them from v1 data.\n886\t// Returns errAlreadyMigrated if all sessions already have compact transcripts.\n887\tfunc backfillCompactTranscripts(ctx context.Context, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, info checkpoint.CommittedInfo, v2Summary *checkpoint.CheckpointSummary, out io.Writer, prefix string) error {\n888\t\t// Find sessions missing transcript.jsonl\n889\t\tvar needsBackfill []int\n890\t\tfor i, session := range v2Summary.Sessions {\n891\t\t\tif session.Transcript == \"\" {\n892\t\t\t\tneedsBackfill = append(needsBackfill, i)\n893\t\t\t}\n894\t\t}\n895\t\n896\t\tif len(needsBackfill) == 0 {\n897\t\t\treturn errAlreadyMigrated\n898\t\t}\n899\t\n900\t\tbackfilled := 0\n901\t\tvar lastAgent string\n902\t\n903\t\tfor _, sessionIdx := range needsBackfill {\n904\t\t\tcontent, readErr := v1Store.ReadSessionContent(ctx, info.CheckpointID, sessionIdx)\n905\t\t\tif readErr != nil {\n906\t\t\t\tlogging.Warn(ctx, \"transcript.jsonl backfill: could not read v1 session\",\n907\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n908\t\t\t\t\tslog.Int(\"session_index\", sessionIdx),\n909\t\t\t\t\tslog.String(\"error\", readErr.Error()),\n910\t\t\t\t)\n911\t\t\t\tcontinue\n912\t\t\t}\n913\t\n914\t\t\tif content.Metadata.Agent != \"\" {\n915\t\t\t\tlastAgent = string(content.Metadata.Agent)\n916\t\t\t}\n917\t\n918\t\t\tcompacted := tryCompactTranscript(ctx, content.Transcript, content.Metadata)\n919\t\t\tif compacted == nil {\n920\t\t\t\t// tryCompactTranscript already logs for no-agent and compact-error cases;\n921\t\t\t\t// log the empty-transcript case here.\n922\t\t\t\tif len(content.Transcript) == 0 {\n923\t\t\t\t\tlogging.Warn(ctx, \"transcript.jsonl backfill: empty transcript in v1\",\n924\t\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n925\t\t\t\t\t\tslog.Int(\"session_index\", sessionIdx),\n926\t\t\t\t\t)\n927\t\t\t\t}\n928\t\t\t\tcontinue\n929\t\t\t}\n930\t\n931\t\t\tupdateErr := v2Store.UpdateCommitted(ctx, checkpoint.UpdateCommittedOptions{\n932\t\t\t\tCheckpointID:      info.CheckpointID,\n933\t\t\t\tSessionID:         content.Metadata.SessionID,\n934\t\t\t\tCompactTranscript: compacted,\n935\t\t\t})\n936\t\t\tif updateErr != nil {\n937\t\t\t\tlogging.Warn(ctx, \"transcript.jsonl backfill: failed to write to v2\",\n938\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n939\t\t\t\t\tslog.Int(\"session_index\", sessionIdx),\n940\t\t\t\t\tslog.String(\"error\", updateErr.Error()),\n941\t\t\t\t)\n942\t\t\t\tcontinue\n943\t\t\t}\n944\t\n945\t\t\tbackfilled++\n946\t\t}\n947\t\n948\t\tif backfilled == 0 {\n949\t\t\tif lastAgent != \"\" {\n950\t\t\t\treturn fmt.Errorf(\"%w: agent %q\", errTranscriptNotGeneratable, lastAgent)\n951\t\t\t}\n952\t\t\treturn fmt.Errorf(\"%w: no agent type in metadata\", errTranscriptNotGeneratable)\n953\t\t}\n954\t\n955\t\tfmt.Fprintf(out, \"%s added transcript.jsonl for %d session(s)\\n\", prefix, backfilled)\n956\t\n957\t\treturn nil\n958\t}\n959\t\n960\tfunc buildMigrateWriteOpts(content *checkpoint.SessionContent, info checkpoint.CommittedInfo, combinedAttribution *checkpoint.InitialAttribution) checkpoint.WriteCommittedOptions {\n961\t\tm := content.Metadata\n962\t\n963\t\tprompts := checkpoint.SplitPromptContent(content.Prompts)\n964\t\n965\t\treturn checkpoint.WriteCommittedOptions{\n966\t\t\tCheckpointID: info.CheckpointID,\n967\t\t\tSessionID:    m.SessionID,\n968\t\t\tCreatedAt:    m.CreatedAt,\n969\t\t\tStrategy:     m.Strategy,\n970\t\t\tBranch:       m.Branch,\n971\t\t\t// content.Transcript comes from persisted checkpoint storage and is\n972\t\t\t// already redacted.\n973\t\t\tTranscript:                  redact.AlreadyRedacted(content.Transcript),\n974\t\t\tPrompts:                     prompts,\n975\t\t\tFilesTouched:                m.FilesTouched,\n976\t\t\tCheckpointsCount:            m.CheckpointsCount,\n977\t\t\tAgent:                       m.Agent,\n978\t\t\tModel:                       m.Model,\n979\t\t\tTurnID:                      m.TurnID,\n980\t\t\tTokenUsage:                  m.TokenUsage,\n981\t\t\tSessionMetrics:              m.SessionMetrics,\n982\t\t\tInitialAttribution:          m.InitialAttribution,\n983\t\t\tPromptAttributionsJSON:      m.PromptAttributions,\n984\t\t\tCombinedAttribution:         combinedAttribution,\n985\t\t\tSummary:                     m.Summary,\n986\t\t\tCheckpointTranscriptStart:   m.GetTranscriptStart(),\n987\t\t\tTranscriptIdentifierAtStart: m.TranscriptIdentifierAtStart,\n988\t\t\tIsTask:                      m.IsTask,\n989\t\t\tToolUseID:                   m.ToolUseID,\n990\t\t\tAuthorName:                  \"Entire Migration\",\n991\t\t\tAuthorEmail:                 \"migration@entire.dev\",\n992\t\t}\n993\t}\n994\t\n995\tfunc tryCompactTranscript(ctx context.Context, transcript []byte, m checkpoint.CommittedMetadata) []byte {\n996\t\treturn compactTranscriptForStartLine(ctx, transcript, m, 0)\n997\t}\n998\t\n999\tfunc compactTranscriptForStartLine(ctx context.Context, transcript []byte, m checkpoint.CommittedMetadata, startLine int) []byte {\n1000\t\tif len(transcript) == 0 {\n1001\t\t\treturn nil\n1002\t\t}\n1003\t\tif m.Agent == \"\" {\n1004\t\t\tlogging.Warn(ctx, \"compact transcript skipped: no agent type in checkpoint metadata\",\n1005\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n1006\t\t\t)\n1007\t\t\treturn nil\n1008\t\t}\n1009\t\n1010\t\t// transcript is read from persisted checkpoint storage and already redacted.\n1011\t\tcompacted, err := compact.Compact(redact.AlreadyRedacted(transcript), compact.MetadataFields{\n1012\t\t\tAgent:      string(m.Agent),\n1013\t\t\tCLIVersion: versioninfo.Version,\n1014\t\t\tStartLine:  startLine,\n1015\t\t})\n1016\t\tif err != nil {\n1017\t\t\tlogging.Warn(ctx, \"compact transcript generation failed during migration\",\n1018\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n1019\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n1020\t\t\t\tslog.String(\"error\", err.Error()),\n1021\t\t\t)\n1022\t\t\treturn nil\n1023\t\t}\n1024\t\tif len(compacted) == 0 {\n1025\t\t\tlogging.Warn(ctx, \"transcript.jsonl generation produced no output\",\n1026\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n1027\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n1028\t\t\t\tslog.Int(\"input_bytes\", len(transcript)),\n1029\t\t\t)\n1030\t\t\treturn nil\n1031\t\t}\n1032\t\treturn compacted\n1033\t}\n1034\t\n1035\t// computeCompactOffset determines the transcript.jsonl line offset for a checkpoint\n1036\t// by comparing a full compact (startLine=0) against the scoped compact. The difference\n1037\t// is the number of compact lines before this checkpoint's data.\n1038\tfunc computeCompactOffset(ctx context.Context, fullTranscript, fullCompact []byte, m checkpoint.CommittedMetadata) int {\n1039\t\tstartLine := m.GetTranscriptStart()\n1040\t\tif startLine == 0 || len(fullTranscript) == 0 || m.Agent == \"\" {\n1041\t\t\treturn 0\n1042\t\t}\n1043\t\n1044\t\tif len(fullCompact) == 0 {\n1045\t\t\treturn 0\n1046\t\t}\n1047\t\n1048\t\t// fullTranscript is read from persisted checkpoint storage and already redacted.\n1049\t\tscopedCompact, err := compact.Compact(redact.AlreadyRedacted(fullTranscript), compact.MetadataFields{\n1050\t\t\tAgent:      string(m.Agent),\n1051\t\t\tCLIVersion: versioninfo.Version,\n1052\t\t\tStartLine:  startLine,\n1053\t\t})\n1054\t\tif err != nil {\n1055\t\t\tlogging.Warn(ctx, \"compact transcript offset calculation failed during migration\",\n1056\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n1057\t\t\t\tslog.String(\"agent\", string(m.Agent)),\n1058\t\t\t\tslog.String(\"error\", err.Error()),\n1059\t\t\t)\n1060\t\t\treturn 0\n1061\t\t}\n1062\t\tif len(scopedCompact) == 0 {\n1063\t\t\treturn 0\n1064\t\t}\n1065\t\n1066\t\tfullLines := bytes.Count(fullCompact, []byte{'\\n'})\n1067\t\tscopedLines := bytes.Count(scopedCompact, []byte{'\\n'})\n1068\t\toffset := fullLines - scopedLines\n1069\t\tif offset < 0 {\n1070\t\t\tlogging.Warn(ctx, \"compact transcript offset was negative during migration, defaulting to 0\",\n1071\t\t\t\tslog.String(\"checkpoint_id\", string(m.CheckpointID)),\n1072\t\t\t\tslog.Int(\"full_lines\", fullLines),\n1073\t\t\t\tslog.Int(\"scoped_lines\", scopedLines),\n1074\t\t\t)\n1075\t\t\treturn 0\n1076\t\t}\n1077\t\treturn offset\n1078\t}\n1079\t\n1080\tfunc collectTaskMetadataForMigratedFullGeneration(repo *git.Repository, cpID id.CheckpointID, summary *checkpoint.CheckpointSummary, v1ToV2SessionIdx map[int]int) (map[int][]plumbing.Hash, error) {\n1081\t\tv1Tree, err := resolveV1CheckpointTree(repo, cpID)\n1082\t\tif err != nil {\n1083\t\t\treturn nil, err\n1084\t\t}\n1085\t\n1086\t\ttaskTrees := make(map[int][]plumbing.Hash)\n1087\t\n1088\t\t// Legacy v1 layout stores task metadata at checkpoint root: <cp>/tasks/<tool-use-id>/...\n1089\t\t// Prefer attaching this tree to the latest session in v2.\n1090\t\tif rootTasksTree, rootTasksErr := v1Tree.Tree(\"tasks\"); rootTasksErr == nil {\n1091\t\t\tif latestSessionIdx, ok := latestMigratedV2SessionIndex(v1ToV2SessionIdx); ok {\n1092\t\t\t\ttaskTrees[latestSessionIdx] = append(taskTrees[latestSessionIdx], rootTasksTree.Hash)\n1093\t\t\t}\n1094\t\t}\n1095\t\n1096\t\tfor sessionIdx := range len(summary.Sessions) {\n1097\t\t\tsessionDir := strconv.Itoa(sessionIdx)\n1098\t\t\tsessionTree, sessionErr := v1Tree.Tree(sessionDir)\n1099\t\t\tif sessionErr != nil {\n1100\t\t\t\tcontinue\n1101\t\t\t}\n1102\t\n1103\t\t\ttasksTree, tasksErr := sessionTree.Tree(\"tasks\")\n1104\t\t\tif tasksErr != nil {\n1105\t\t\t\tcontinue\n1106\t\t\t}\n1107\t\n1108\t\t\tv2SessionIdx, ok := v1ToV2SessionIdx[sessionIdx]\n1109\t\t\tif !ok {\n1110\t\t\t\tcontinue\n1111\t\t\t}\n1112\t\t\ttaskTrees[v2SessionIdx] = append(taskTrees[v2SessionIdx], tasksTree.Hash)\n1113\t\t}\n1114\t\n1115\t\treturn taskTrees, nil\n1116\t}\n1117\t\n1118\tfunc latestMigratedV2SessionIndex(v1ToV2SessionIdx map[int]int) (int, bool) {\n1119\t\tlatest := -1\n1120\t\tfor _, v2SessionIdx := range v1ToV2SessionIdx {\n1121\t\t\tif v2SessionIdx > latest {\n1122\t\t\t\tlatest = v2SessionIdx\n1123\t\t\t}\n1124\t\t}\n1125\t\tif latest < 0 {\n1126\t\t\treturn -1, false\n1127\t\t}\n1128\t\treturn latest, true\n1129\t}\n1130\t\n1131\t// resolveV1CheckpointTree reads the checkpoint subtree from the v1 branch.\n1132\tfunc resolveV1CheckpointTree(repo *git.Repository, cpID id.CheckpointID) (*object.Tree, error) {\n1133\t\trefName := plumbing.NewBranchReferenceName(paths.MetadataBranchName)\n1134\t\tref, err := repo.Reference(refName, true)\n1135\t\tif err != nil {\n1136\t\t\t// Try remote tracking branch\n1137\t\t\tremoteRefName := plumbing.NewRemoteReferenceName(migrateRemoteName, paths.MetadataBranchName)\n1138\t\t\tref, err = repo.Reference(remoteRefName, true)\n1139\t\t\tif err != nil {\n1140\t\t\t\treturn nil, fmt.Errorf(\"v1 branch not found: %w\", err)\n1141\t\t\t}\n1142\t\t}\n1143\t\n1144\t\tcommit, err := repo.CommitObject(ref.Hash())\n1145\t\tif err != nil {\n1146\t\t\treturn nil, fmt.Errorf(\"failed to get v1 commit: %w\", err)\n1147\t\t}\n1148\t\n1149\t\trootTree, err := commit.Tree()\n1150\t\tif err != nil {\n1151\t\t\treturn nil, fmt.Errorf(\"failed to get v1 tree: %w\", err)\n1152\t\t}\n1153\t\n1154\t\tcpTree, err := rootTree.Tree(cpID.Path())\n1155\t\tif err != nil {\n1156\t\t\treturn nil, fmt.Errorf(\"checkpoint %s not found in v1 tree: %w\", cpID, err)\n1157\t\t}\n1158\t\n1159\t\treturn cpTree, nil\n1160\t}\n1161\t\n1162\t// cleanupV1TranscriptFiles removes legacy v1-named transcript files (full.jsonl,\n1163\t// full.jsonl.*, content_hash.txt) from /full/current. Older CLI versions wrote\n1164\t// these before the rename to raw_transcript; they are inert but waste space.\n1165\t// Best-effort: failures are logged and do not block migration.\n1166\tfunc cleanupV1TranscriptFiles(ctx context.Context, _ *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID, sessionCount int) {\n1167\t\tif err := v2Store.CleanupV1TranscriptFiles(ctx, cpID, sessionCount); err != nil {\n1168\t\t\tlogging.Warn(ctx, \"v1 transcript cleanup failed\",\n1169\t\t\t\tslog.String(\"checkpoint_id\", string(cpID)),\n1170\t\t\t\tslog.String(\"error\", err.Error()),\n1171\t\t\t)\n1172\t\t}\n1173\t}\n1174\t\n1175\tfunc spliceTasksTreeToV2(ctx context.Context, repo *git.Repository, v2Store *checkpoint.V2GitStore, cpID id.CheckpointID, sessionIdx int, tasksTreeHash plumbing.Hash) error {\n1176\t\trefName := plumbing.ReferenceName(paths.V2FullCurrentRefName)\n1177\t\tparentHash, rootTreeHash, err := v2Store.GetRefState(refName)\n1178\t\tif err != nil {\n1179\t\t\treturn fmt.Errorf(\"failed to get v2 ref state: %w\", err)\n1180\t\t}\n1181\t\tincomingTasksTree, err := repo.TreeObject(tasksTreeHash)\n1182\t\tif err != nil {\n1183\t\t\treturn fmt.Errorf(\"failed to read tasks tree: %w\", err)\n1184\t\t}\n1185\t\n1186\t\tshardPrefix := string(cpID[:2])\n1187\t\tshardSuffix := string(cpID[2:])\n1188\t\tsessionDir := strconv.Itoa(sessionIdx)\n1189\t\n1190\t\tnewRoot, err := checkpoint.UpdateSubtree(repo, rootTreeHash,\n1191\t\t\t[]string{shardPrefix, shardSuffix, sessionDir, \"tasks\"},\n1192\t\t\tincomingTasksTree.Entries,\n1193\t\t\tcheckpoint.UpdateSubtreeOptions{MergeMode: checkpoint.MergeKeepExisting},\n1194\t\t)\n1195\t\tif err != nil {\n1196\t\t\treturn fmt.Errorf(\"tree surgery failed: %w\", err)\n1197\t\t}\n1198\t\n1199\t\tcommitHash, err := checkpoint.CreateCommit(ctx, repo, newRoot, parentHash,\n1200\t\t\tfmt.Sprintf(\"Add task metadata for %s\\n\", cpID),\n1201\t\t\t\"Entire Migration\", \"migration@entire.dev\")\n1202\t\tif err != nil {\n1203\t\t\treturn fmt.Errorf(\"failed to create commit: %w\", err)\n1204\t\t}\n1205\t\n1206\t\tif err := repo.Storer.SetReference(plumbing.NewHashReference(refName, commitHash)); err != nil {\n1207\t\t\treturn fmt.Errorf(\"failed to update ref %s: %w\", refName, err)\n1208\t\t}\n1209\t\treturn nil\n1210\t}\n1211\t"}]},"uuid":"2832babc-29df-487d-8833-a31d2afc3421","timestamp":"2026-04-30T22:57:32.525Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/pfleidi/entire/cli/.worktrees/fix/entire-migrate-checkpoint-order/cmd/entire/cli/migrate.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n\t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n\t\"github.com/entireio/cli/cmd/entire/cli/transcript/compact\"\n\t\"github.com/entireio/cli/cmd/entire/cli/versioninfo\"\n\t\"github.com/entireio/cli/redact\"\n\t\"github.com/go-git/go-git/v6\"\n\t\"github.com/go-git/go-git/v6/plumbing\"\n\t\"github.com/go-git/go-git/v6/plumbing/filemode\"\n\t\"github.com/go-git/go-git/v6/plumbing/object\"\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newMigrateCmd() *cobra.Command {\n\tvar checkpointsFlag string\n\tvar forceFlag bool\n\n\tcmd := &cobra.Command{\n\t\tUse:    \"migrate\",\n\t\tShort:  \"Migrate Entire data to newer formats\",\n\t\tLong:   `Migrate Entire data to newer formats. Currently supports migrating v1 checkpoints to v2.`,\n\t\tHidden: true,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\tif checkpointsFlag == \"\" {\n\t\t\t\treturn cmd.Help()\n\t\t\t}\n\t\t\tif checkpointsFlag != \"v2\" {\n\t\t\t\treturn fmt.Errorf(\"unsupported checkpoints version: %q (only \\\"v2\\\" is supported)\", checkpointsFlag)\n\t\t\t}\n\n\t\t\tctx := cmd.Context()\n\n\t\t\tif _, err := paths.WorktreeRoot(ctx); err != nil {\n\t\t\t\tcmd.SilenceUsage = true\n\t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Please run from within a git repository.\")\n\t\t\t\treturn NewSilentError(errors.New(\"not a git repository\"))\n\t\t\t}\n\n\t\t\tlogging.SetLogLevelGetter(GetLogLevel)\n\t\t\tif initErr := logging.Init(ctx, \"\"); initErr != nil {\n\t\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Warning: could not initialize logging: %v\\n\", initErr)\n\t\t\t} else {\n\t\t\t\tdefer logging.Close()\n\t\t\t}\n\t\t\treturn runMigrateCheckpointsV2(ctx, cmd, forceFlag)\n\t\t},\n\t}\n\n\tcmd.Flags().StringVar(&checkpointsFlag, \"checkpoints\", \"\", \"Target checkpoint format version (e.g., \\\"v2\\\")\")\n\tcmd.Flags().BoolVar(&forceFlag, \"force\", false, \"Force re-migration of all checkpoints, overwriting existing v2 data\")\n\n\treturn cmd\n}\n\ntype migrateResult struct {\n\tmigrated int\n\tskipped  int\n\tfailed   int\n}\n\nfunc runMigrateCheckpointsV2(ctx context.Context, cmd *cobra.Command, force bool) error {\n\trepo, err := strategy.OpenRepository(ctx)\n\tif err != nil {\n\t\tcmd.SilenceUsage = true\n\t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Please run from within a git repository.\")\n\t\treturn NewSilentError(err)\n\t}\n\n\tv1Store := checkpoint.NewGitStore(repo)\n\tv2Store := checkpoint.NewV2GitStore(repo, migrateRemoteName)\n\tout := cmd.OutOrStdout()\n\n\tresult, err := migrateCheckpointsV2(ctx, repo, v1Store, v2Store, out, force)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\trepairResult, repairErr := strategy.RepairV2GenerationMetadata(ctx)\n\tif repairErr != nil {\n\t\treturn fmt.Errorf(\"failed to repair archived v2 generation metadata: %w\", repairErr)\n\t}\n\tprintV2GenerationRepairResult(out, cmd.ErrOrStderr(), repairResult)\n\n\tfmt.Fprintf(out, \"\\nMigration complete: %d migrated, %d skipped, %d failed\\n\",\n\t\tresult.migrated, result.skipped, result.failed)\n\tfmt.Fprintln(out)\n\tfmt.Fprintln(out, \"Note: V2 checkpoints are stored as custom refs under refs/entire/checkpoints/v2/*, not as a branch visible in the GitHub UI.\")\n\tfmt.Fprintf(out, \"To inspect pushed v2 checkpoint refs locally, run: git ls-remote %s \\\"refs/entire/checkpoints/v2/*\\\"\\n\", migrateRemoteName)\n\tfmt.Fprintln(out, `You may also open a checkpoint's details in the Entire web app and click the \"session logs\" link to view the log files and metadata.`)\n\n\tif result.failed > 0 {\n\t\tfmt.Fprintf(out, \"%d checkpoint(s) failed to migrate. Check .entire/logs/ for details.\\n\", result.failed)\n\t\treturn NewSilentError(fmt.Errorf(\"%d checkpoint(s) failed to migrate\", result.failed))\n\t}\n\tif repairResult != nil && len(repairResult.Failed) > 0 {\n\t\tfmt.Fprintf(out, \"%d archived generation(s) failed metadata repair. Check warnings above for details.\\n\", len(repairResult.Failed))\n\t\treturn NewSilentError(fmt.Errorf(\"%d archived generation(s) failed metadata repair\", len(repairResult.Failed)))\n\t}\n\n\treturn nil\n}\n\nfunc printV2GenerationRepairResult(out, errOut io.Writer, result *strategy.RepairV2GenerationMetadataResult) {\n\tif result == nil {\n\t\treturn\n\t}\n\n\tfor _, warning := range result.Warnings {\n\t\tfmt.Fprintf(errOut, \"Warning: %s\\n\", warning)\n\t}\n\n\tif len(result.Repaired) == 0 && len(result.Failed) == 0 {\n\t\treturn\n\t}\n\n\tfmt.Fprintf(out, \"Archived generation metadata repair: %d repaired, %d skipped, %d failed\\n\",\n\t\tlen(result.Repaired), len(result.Skipped), len(result.Failed))\n}\n\nvar (\n\terrAlreadyMigrated          = errors.New(\"already migrated\")\n\terrTranscriptNotGeneratable = errors.New(\"transcript.jsonl could not be generated\")\n\terrNoMigratableSessions     = errors.New(\"no migratable v1 sessions\")\n)\n\nconst migrateRemoteName = \"origin\"\n\nvar migrateMaxCheckpointsPerGeneration = checkpoint.DefaultMaxCheckpointsPerGeneration\n\ntype migratedFullCheckpoint struct {\n\tcheckpointID id.CheckpointID\n\tsessions     []migratedFullSession\n\ttaskTrees    map[int][]plumbing.Hash\n}\n\ntype migratedFullSession struct {\n\tsessionIndex int\n\tcontent      *checkpoint.SessionContent\n}\n\nfunc migrateCheckpointsV2(ctx context.Context, repo *git.Repository, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, out io.Writer, force bool) (*migrateResult, error) {\n\tv1List, err := v1Store.ListCommitted(ctx)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to list v1 checkpoints: %w\", err)\n\t}\n\n\tif len(v1List) == 0 {\n\t\tfmt.Fprintln(out, \"Nothing to migrate: no v1 checkpoints found\")\n\t\treturn &migrateResult{}, nil\n\t}\n\n\tif force {\n\t\tfmt.Fprintln(out, \"Force-migrating v1 checkpoints to v2 (overwriting existing)...\")\n\t} else {\n\t\tfmt.Fprintln(out, \"Migrating v1 checkpoints to v2...\")\n\t}\n\tsortMigratableCheckpoints(v1List)\n\ttotal := len(v1List)\n\tresult := &migrateResult{}\n\tfullCurrentExistsBefore := v2RefExists(repo, plumbing.ReferenceName(paths.V2FullCurrentRefName))\n\tvar migratedFullCheckpoints []migratedFullCheckpoint\n\n\tfor i, info := range v1List {\n\t\tprefix := fmt.Sprintf(\"  [%d/%d] Migrating checkpoint %s...\", i+1, total, info.CheckpointID)\n\n\t\tfullCheckpoint, migrateErr := migrateOneCheckpoint(ctx, repo, v1Store, v2Store, info, out, prefix, force)\n\t\tif migrateErr != nil {\n\t\t\tswitch {\n\t\t\tcase errors.Is(migrateErr, errAlreadyMigrated):\n\t\t\t\tfmt.Fprintf(out, \"%s skipped (already in v2)\\n\", prefix)\n\t\t\t\tresult.skipped++\n\t\t\tcase errors.Is(migrateErr, errTranscriptNotGeneratable):\n\t\t\t\tfmt.Fprintf(out, \"%s in v2, but %s\\n\", prefix, migrateErr.Error())\n\t\t\t\tresult.skipped++\n\t\t\tcase errors.Is(migrateErr, errNoMigratableSessions):\n\t\t\t\tfmt.Fprintf(out, \"%s skipped (%s)\\n\", prefix, migrateErr.Error())\n\t\t\t\tresult.skipped++\n\t\t\tdefault:\n\t\t\t\tfmt.Fprintf(out, \"%s failed\\n\", prefix)\n\t\t\t\tlogging.Error(ctx, \"checkpoint migration failed\",\n\t\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n\t\t\t\t\tslog.String(\"error\", migrateErr.Error()),\n\t\t\t\t)\n\t\t\t\tresult.failed++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tif fullCheckpoint != nil && len(fullCheckpoint.sessions) > 0 {\n\t\t\tmigratedFullCheckpoints = append(migratedFullCheckpoints, *fullCheckpoint)\n\t\t}\n\t\tresult.migrated++\n\t}\n\n\tif len(migratedFullCheckpoints) > 0 {\n\t\tfmt.Fprintf(out, \"Packing raw transcripts into v2 archived generations...\\n\")\n\t\tif packErr := packMigratedFullGenerations(ctx, repo, v2Store, migratedFullCheckpoints, !fullCurrentExistsBefore); packErr != nil {\n\t\t\treturn result, fmt.Errorf(\"failed to pack migrated raw transcripts: %w\", packErr)\n\t\t}\n\t}\n\n\treturn result, nil\n}\n\nfunc sortMigratableCheckpoints(checkpoints []checkpoint.CommittedInfo) {\n\tsort.SliceStable(checkpoints, func(i, j int) bool {\n\t\tleft := checkpoints[i].CreatedAt\n\t\tright := checkpoints[j].CreatedAt\n\t\tswitch {\n\t\tcase left.IsZero() && right.IsZero():\n\t\t\treturn checkpoints[i].CheckpointID.String() < checkpoints[j].CheckpointID.String()\n\t\tcase left.IsZero():\n\t\t\treturn false\n\t\tcase right.IsZero():\n\t\t\treturn true\n\t\tcase left.Equal(right):\n\t\t\treturn checkpoints[i].CheckpointID.String() < checkpoints[j].CheckpointID.String()\n\t\tdefault:\n\t\t\treturn left.Before(right)\n\t\t}\n\t})\n}\n\nfunc v2RefExists(repo *git.Repository, refName plumbing.ReferenceName) bool {\n\t_, err := repo.Reference(refName, true)\n\treturn err == nil\n}\n\nfunc migrateOneCheckpoint(ctx context.Context, repo *git.Repository, v1Store *checkpoint.GitStore, v2Store *checkpoint.V2GitStore, info checkpoint.CommittedInfo, out io.Writer, prefix string, force bool) (*migratedFullCheckpoint, error) {\n\texisting, err := v2Store.ReadCommitted(ctx, info.CheckpointID)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to check v2 for checkpoint %s: %w\", info.CheckpointID, err)\n\t}\n\n\t// Already in v2 — when not forcing, check if any aspect of sessions are missing and backfill\n\tif existing != nil && !force {\n\t\tfullCheckpoint, queuedFullRepair, repairErr := collectMissingFullCheckpointForPacking(ctx, repo, v1Store, v2Store, info, existing)\n\t\tif repairErr != nil {\n\t\t\treturn nil, repairErr\n\t\t}\n\n\t\tcurrentV2, readCurrentErr := v2Store.ReadCommitted(ctx, info.CheckpointID)\n\t\tif readCurrentErr != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to re-read v2 checkpoint %s: %w\", info.CheckpointID, readCurrentErr)\n\t\t}\n\t\tif currentV2 == nil {\n\t\t\treturn nil, fmt.Errorf(\"v2 checkpoint %s disappeared during migration\", info.CheckpointID)\n\t\t}\n\n\t\t// Clean up v1-named transcript files (full.jsonl, content_hash.txt) that older\n\t\t// CLI versions may have written to /full/current before the rename to raw_transcript.\n\t\tcleanupV1TranscriptFiles(ctx, repo, v2Store, info.CheckpointID, len(currentV2.Sessions))\n\n\t\tbackfillErr := backfillCompactTranscripts(ctx, v1Store, v2Store, info, currentV2, out, prefix)\n\t\tif errors.Is(backfillErr, errAlreadyMigrated) && queuedFullRepair {\n\t\t\tfmt.Fprintf(out, \"%s queued missing raw transcript artifacts for generation packing\\n\", prefix)\n\t\t\treturn fullCheckpoint, nil\n\t\t}\n\t\tif errors.Is(backfillErr, errTranscriptNotGeneratable) && queuedFullRepair {\n\t\t\tfmt.Fprintf(out, \"%s queued missing raw transcript artifacts for generation packing (compact transcript not generated)\\n\", prefix)\n\t\t\treturn fullCheckpoint, nil\n\t\t}\n\t\tif backfillErr != nil {\n\t\t\treturn nil, backfillErr\n\t\t}\n\t\tif queuedFullRepair {\n\t\t\tfmt.Fprintf(out, \"%s queued missing raw transcript artifacts for generation packing\\n\", prefix)\n\t\t\treturn fullCheckpoint, nil\n\t\t}\n\t\treturn &migratedFullCheckpoint{}, nil\n\t}\n\n\tif existing != nil && force {\n\t\tif pruneErr := pruneV2CheckpointForForce(ctx, repo, v2Store, info.CheckpointID); pruneErr != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to reset existing v2 checkpoint %s before force migration: %w\", info.CheckpointID, pruneErr)\n\t\t}\n\t}\n\n\tsummary, err := v1Store.ReadCommitted(ctx, info.CheckpointID)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to read v1 summary: %w\", err)\n\t}\n\tif summary == nil {\n\t\treturn nil, fmt.Errorf(\"v1 checkpoint %s has no summary\", info.CheckpointID)\n\t}\n\n\tcompactFailed := false\n\tshouldCopyTaskMetadata := false\n\tskippedMissingSessions := 0\n\tmigratedSessions := 0\n\tv1ToV2SessionIdx := make(map[int]int, len(summary.Sessions))\n\tfullCheckpoint := &migratedFullCheckpoint{\n\t\tcheckpointID: info.CheckpointID,\n\t}\n\n\tfor sessionIdx := range len(summary.Sessions) {\n\t\tcontent, skipped, readErr := readV1SessionForMigration(ctx, out, prefix, v1Store, info.CheckpointID, sessionIdx)\n\t\tif skipped {\n\t\t\tskippedMissingSessions++\n\t\t\tcontinue\n\t\t}\n\t\tif readErr != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to read v1 session %d: %w\", sessionIdx, readErr)\n\t\t}\n\t\tif content.Metadata.IsTask {\n\t\t\tshouldCopyTaskMetadata = true\n\t\t}\n\n\t\topts := buildMigrateWriteOpts(content, info, summary.CombinedAttribution)\n\n\t\tcompacted := tryCompactTranscript(ctx, content.Transcript, content.Metadata)\n\t\tif compacted != nil {\n\t\t\topts.CompactTranscript = compacted\n\t\t\topts.CompactTranscriptStart = computeCompactOffset(ctx, content.Transcript, compacted, content.Metadata)\n\t\t} else if len(content.Transcript) > 0 {\n\t\t\tcompactFailed = true\n\t\t}\n\n\t\tmainOpts := opts\n\t\tmainOpts.Transcript = redact.AlreadyRedacted(nil)\n\t\tv2SessionIdx, writeErr := v2Store.WriteCommittedWithSessionIndex(ctx, mainOpts)\n\t\tif writeErr != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to write v2 session %d: %w\", sessionIdx, writeErr)\n\t\t}\n\t\tv1ToV2SessionIdx[sessionIdx] = v2SessionIdx\n\t\tfullCheckpoint.sessions = append(fullCheckpoint.sessions, migratedFullSession{\n\t\t\tsessionIndex: v2SessionIdx,\n\t\t\tcontent:      content,\n\t\t})\n\t\tmigratedSessions++\n\t}\n\n\tif migratedSessions == 0 {\n\t\treturn nil, fmt.Errorf(\"%w: v1 metadata lists %d session(s), but no transcript/session content exists for any of them\", errNoMigratableSessions, len(summary.Sessions))\n\t}\n\n\tif shouldCopyTaskMetadata {\n\t\ttaskTrees, taskErr := collectTaskMetadataForMigratedFullGeneration(repo, info.CheckpointID, summary, v1ToV2SessionIdx)\n\t\tif taskErr != nil {\n\t\t\tlogging.Warn(ctx, \"failed to copy task metadata to v2\",\n\t\t\t\tslog.String(\"checkpoint_id\", string(info.CheckpointID)),\n\t\t\t\tslog.String(\"error\", taskErr.Error()),\n\t\t\t)\n\t