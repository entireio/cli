ommit: %w\", err)\n296\t\t}\n297\t\ttree, err := commit.Tree()\n298\t\tif err != nil {\n299\t\t\treturn nil, fmt.Errorf(\"failed to read v2 main tree: %w\", err)\n300\t\t}\n301\t\treturn tree, nil\n302\t}\n303\t\n304\tfunc (s *V2GitStore) checkpointTimestampRangeFromMain(mainTree *object.Tree, cpID id.CheckpointID) (GenerationMetadata, bool) {\n305\t\tcpTree, err := mainTree.Tree(cpID.Path())\n306\t\tif err != nil {\n307\t\t\treturn GenerationMetadata{}, false\n308\t\t}\n309\t\n310\t\tvar gen GenerationMetadata\n311\t\tfound := false\n312\t\tfor _, entry := range cpTree.Entries {\n313\t\t\tif entry.Mode != filemode.Dir {\n314\t\t\t\tcontinue\n315\t\t\t}\n316\t\t\tif _, err := strconv.Atoi(entry.Name); err != nil {\n317\t\t\t\tcontinue\n318\t\t\t}\n319\t\t\tsessionTree, err := s.repo.TreeObject(entry.Hash)\n320\t\t\tif err != nil {\n321\t\t\t\tcontinue\n322\t\t\t}\n323\t\t\tmetadataFile, err := sessionTree.File(paths.MetadataFileName)\n324\t\t\tif err != nil {\n325\t\t\t\tcontinue\n326\t\t\t}\n327\t\t\tmetadataContent, err := metadataFile.Contents()\n328\t\t\tif err != nil {\n329\t\t\t\tcontinue\n330\t\t\t}\n331\t\t\tvar metadata CommittedMetadata\n332\t\t\tif err := json.Unmarshal([]byte(metadataContent), &metadata); err != nil || metadata.CreatedAt.IsZero() {\n333\t\t\t\tcontinue\n334\t\t\t}\n335\t\t\tmergeGenerationTime(&gen, &found, metadata.CreatedAt.UTC())\n336\t\t}\n337\t\treturn gen, found\n338\t}\n339\t\n340\tfunc checkpointTimestampRangeFromFullTree(cpTree *object.Tree) (GenerationMetadata, bool) {\n341\t\tvar gen GenerationMetadata\n342\t\tfound := false\n343\t\tfor _, entry := range cpTree.Entries {\n344\t\t\tif entry.Mode != filemode.Dir {\n345\t\t\t\tcontinue\n346\t\t\t}\n347\t\t\tif _, err := strconv.Atoi(entry.Name); err != nil {\n348\t\t\t\tcontinue\n349\t\t\t}\n350\t\t\tsessionTree, err := cpTree.Tree(entry.Name)\n351\t\t\tif err != nil {\n352\t\t\t\tcontinue\n353\t\t\t}\n354\t\t\ttranscript, err := readTranscriptFromObjectTree(sessionTree, \"\")\n355\t\t\tif err != nil || len(transcript) == 0 {\n356\t\t\t\tcontinue\n357\t\t\t}\n358\t\t\tif transcriptGen, ok := timestampRangeFromTranscript(transcript); ok {\n359\t\t\t\tmergeGenerationRange(&gen, &found, transcriptGen)\n360\t\t\t}\n361\t\t}\n362\t\treturn gen, found\n363\t}\n364\t\n365\tfunc timestampRangeFromTranscript(transcript []byte) (GenerationMetadata, bool) {\n366\t\treader := bufio.NewReader(bytes.NewReader(transcript))\n367\t\tvar gen GenerationMetadata\n368\t\tfound := false\n369\t\n370\t\tfor {\n371\t\t\tline, err := reader.ReadBytes('\\n')\n372\t\t\tif trimmed := bytes.TrimSpace(line); len(trimmed) > 0 {\n373\t\t\t\tvar event struct {\n374\t\t\t\t\tTimestamp string `json:\"timestamp\"`\n375\t\t\t\t}\n376\t\t\t\tif jsonErr := json.Unmarshal(trimmed, &event); jsonErr == nil && event.Timestamp != \"\" {\n377\t\t\t\t\tif ts, parseErr := time.Parse(time.RFC3339Nano, event.Timestamp); parseErr == nil {\n378\t\t\t\t\t\tmergeGenerationTime(&gen, &found, ts.UTC())\n379\t\t\t\t\t}\n380\t\t\t\t}\n381\t\t\t}\n382\t\t\tif errors.Is(err, io.EOF) {\n383\t\t\t\tbreak\n384\t\t\t}\n385\t\t\tif err != nil {\n386\t\t\t\tbreak\n387\t\t\t}\n388\t\t}\n389\t\n390\t\treturn gen, found\n391\t}\n392\t\n393\tfunc mergeGenerationRange(dst *GenerationMetadata, found *bool, src GenerationMetadata) {\n394\t\tmergeGenerationTime(dst, found, src.OldestCheckpointAt)\n395\t\tmergeGenerationTime(dst, found, src.NewestCheckpointAt)\n396\t}\n397\t\n398\tfunc mergeGenerationTime(gen *GenerationMetadata, found *bool, ts time.Time) {\n399\t\tif ts.IsZero() {\n400\t\t\treturn\n401\t\t}\n402\t\tts = ts.UTC()\n403\t\tif !*found {\n404\t\t\tgen.OldestCheckpointAt = ts\n405\t\t\tgen.NewestCheckpointAt = ts\n406\t\t\t*found = true\n407\t\t\treturn\n408\t\t}\n409\t\tif ts.Before(gen.OldestCheckpointAt) {\n410\t\t\tgen.OldestCheckpointAt = ts\n411\t\t}\n412\t\tif ts.After(gen.NewestCheckpointAt) {\n413\t\t\tgen.NewestCheckpointAt = ts\n414\t\t}\n415\t}\n416\t\n417\t// generationRefWidth is the zer