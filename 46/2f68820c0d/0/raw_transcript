{"parentUuid":"154a0fb2-855a-4610-b562-a70c6289ed19","isSidechain":false,"promptId":"be2a55ac-7180-4afe-8e1f-07c1f28bd2fe","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QYgMjwaZdjUhvU4zS8TTfN","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"net/http\"\n10\t\t\"sort\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"charm.land/lipgloss/v2\"\n15\t\t\"github.com/entireio/cli/cmd/entire/cli/api\"\n16\t\t\"github.com/entireio/cli/cmd/entire/cli/auth\"\n17\t\t\"github.com/spf13/cobra\"\n18\t)\n19\t\n20\t// authTokenLister lists API tokens for the authenticated user.\n21\ttype authTokenLister func(ctx context.Context, token string) ([]api.Token, error)\n22\t\n23\t// authTokenRevoker revokes a single API token by id.\n24\ttype authTokenRevoker func(ctx context.Context, callerToken, id string) error\n25\t\n26\t// User-visible placeholder strings. Promoted to constants so tests and\n27\t// production share a single source of truth.\n28\tconst (\n29\t\tplaceholderDash = \"-\"\n30\t\tlastUsedNever   = \"never\"\n31\t\tlastUsedJustNow = \"just now\"\n32\t)\n33\t\n34\t// requireSecureBaseURL enforces TLS unless insecureHTTPAuth is set. Every\n35\t// command that sends a bearer token over the network (login, logout,\n36\t// auth status/list/revoke) must call this so credentials don't leak over\n37\t// plaintext HTTP without explicit opt-in.\n38\tfunc requireSecureBaseURL(insecureHTTPAuth bool) error {\n39\t\tif insecureHTTPAuth {\n40\t\t\treturn nil\n41\t\t}\n42\t\tif err := api.RequireSecureURL(api.BaseURL()); err != nil {\n43\t\t\treturn fmt.Errorf(\"base URL check: %w\", err)\n44\t\t}\n45\t\treturn nil\n46\t}\n47\t\n48\t// addInsecureHTTPAuthFlag attaches the hidden --insecure-http-auth flag used\n49\t// by every authenticated command for local development.\n50\tfunc addInsecureHTTPAuthFlag(cmd *cobra.Command, target *bool) {\n51\t\tcmd.Flags().BoolVar(target, \"insecure-http-auth\", false, \"Allow authentication over plain HTTP (insecure, for local development only)\")\n52\t\tif err := cmd.Flags().MarkHidden(\"insecure-http-auth\"); err != nil {\n53\t\t\tpanic(fmt.Sprintf(\"hide insecure-http-auth flag: %v\", err))\n54\t\t}\n55\t}\n56\t\n57\tfunc newAuthCmd() *cobra.Command {\n58\t\tcmd := &cobra.Command{\n59\t\t\tUse:   \"auth\",\n60\t\t\tShort: \"Manage authentication and API tokens\",\n61\t\t\tLong:  \"Authentication subcommands. Includes login, logout, status, listing tokens, and revoking tokens.\",\n62\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n63\t\t\t\treturn cmd.Help()\n64\t\t\t},\n65\t\t}\n66\t\n67\t\tcmd.AddCommand(newLoginCmd())\n68\t\tcmd.AddCommand(newLogoutCmd())\n69\t\tcmd.AddCommand(newAuthStatusCmd())\n70\t\tcmd.AddCommand(newAuthListCmd())\n71\t\tcmd.AddCommand(newAuthRevokeCmd())\n72\t\treturn cmd\n73\t}\n74\t\n75\t// --- status -----------------------------------------------------------------\n76\t\n77\tfunc newAuthStatusCmd() *cobra.Command {\n78\t\tvar insecureHTTPAuth bool\n79\t\tcmd := &cobra.Command{\n80\t\t\tUse:   \"status\",\n81\t\t\tShort: \"Show authentication status\",\n82\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n83\t\t\t\tif err := requireSecureBaseURL(insecureHTTPAuth); err != nil {\n84\t\t\t\t\treturn err\n85\t\t\t\t}\n86\t\t\t\treturn runAuthStatus(cmd.Context(), cmd.OutOrStdout(),\n87\t\t\t\t\tauth.NewStore(), defaultListTokens, api.BaseURL())\n88\t\t\t},\n89\t\t}\n90\t\taddInsecureHTTPAuthFlag(cmd, &insecureHTTPAuth)\n91\t\treturn cmd\n92\t}\n93\t\n94\tfunc defaultListTokens(ctx context.Context, token string) ([]api.Token, error) {\n95\t\treturn api.NewClient(token).ListTokens(ctx) //nolint:wrapcheck // ListTokens already wraps with action context\n96\t}\n97\t\n98\tfunc runAuthStatus(ctx context.Context, w io.Writer, store tokenStore, list authTokenLister, baseURL string) error {\n99\t\tinfo, err := store.GetTokenInfo(baseURL)\n100\t\tif err != nil {\n101\t\t\treturn fmt.Errorf(\"read auth token: %w\", err)\n102\t\t}\n103\t\tif info.Value == \"\" {\n104\t\t\tfmt.Fprintf(w, \"Not logged in to %s\\n\", baseURL)\n105\t\t\tfmt.Fprintln(w, \"Run 'entire login' to authenticate.\")\n106\t\t\treturn nil\n107\t\t}\n108\t\n109\t\ttokens, err := list(ctx, info.Value)\n110\t\tif err != nil {\n111\t\t\tif api.IsHTTPErrorStatus(err, http.StatusUnauthorized) {\n112\t\t\t\tfmt.Fprintf(w, \"Token for %s is no longer valid.\\n\", baseURL)\n113\t\t\t\tif info.Source == auth.TokenSourceEnv {\n114\t\t\t\t\tfmt.Fprintf(w, \"Update or unset %s to re-authenticate.\\n\", auth.AuthTokenEnvVar)\n115\t\t\t\t} else {\n116\t\t\t\t\tfmt.Fprintln(w, \"Run 'entire login' to re-authenticate.\")\n117\t\t\t\t}\n118\t\t\t\treturn nil\n119\t\t\t}\n120\t\t\treturn fmt.Errorf(\"validate token: %w\", err)\n121\t\t}\n122\t\n123\t\tfmt.Fprintf(w, \"Logged in to %s\\n\", baseURL)\n124\t\tfmt.Fprintf(w, \"  Token: %s\\n\", describeTokenSource(info))\n125\t\tfmt.Fprintf(w, \"  Active tokens on this account: %d\\n\", len(tokens))\n126\t\treturn nil\n127\t}\n128\t\n129\tfunc describeTokenSource(info auth.TokenInfo) string {\n130\t\tswitch info.Source {\n131\t\tcase auth.TokenSourceNone:\n132\t\t\treturn \"not configured\"\n133\t\tcase auth.TokenSourceEnv:\n134\t\t\treturn \"supplied by \" + auth.AuthTokenEnvVar\n135\t\tcase auth.TokenSourceFile:\n136\t\t\tif info.Path != \"\" {\n137\t\t\t\treturn \"stored in file \" + info.Path\n138\t\t\t}\n139\t\t\treturn \"stored in file\"\n140\t\tcase auth.TokenSourceKeyring:\n141\t\t\treturn \"stored in OS keychain\"\n142\t\tdefault:\n143\t\t\treturn \"stored\"\n144\t\t}\n145\t}\n146\t\n147\t// --- list -------------------------------------------------------------------\n148\t\n149\tfunc newAuthListCmd() *cobra.Command {\n150\t\tvar jsonOut bool\n151\t\tvar insecureHTTPAuth bool\n152\t\tcmd := &cobra.Command{\n153\t\t\tUse:   \"list\",\n154\t\t\tShort: \"List active API tokens for the authenticated user\",\n155\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n156\t\t\t\tif err := requireSecureBaseURL(insecureHTTPAuth); err != nil {\n157\t\t\t\t\treturn err\n158\t\t\t\t}\n159\t\t\t\treturn runAuthList(cmd.Context(), cmd.OutOrStdout(),\n160\t\t\t\t\tauth.NewStore(), defaultListTokens, api.BaseURL(), jsonOut)\n161\t\t\t},\n162\t\t}\n163\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Print tokens as JSON\")\n164\t\taddInsecureHTTPAuthFlag(cmd, &insecureHTTPAuth)\n165\t\treturn cmd\n166\t}\n167\t\n168\tfunc runAuthList(ctx context.Context, w io.Writer, store tokenStore, list authTokenLister, baseURL string, jsonOut bool) error {\n169\t\ttoken, err := store.GetToken(baseURL)\n170\t\tif err != nil {\n171\t\t\treturn fmt.Errorf(\"read auth token: %w\", err)\n172\t\t}\n173\t\tif token == \"\" {\n174\t\t\treturn fmt.Errorf(\"not logged in to %s; run 'entire login' first\", baseURL)\n175\t\t}\n176\t\n177\t\ttokens, err := list(ctx, token)\n178\t\tif err != nil {\n179\t\t\treturn err\n180\t\t}\n181\t\n182\t\tif jsonOut {\n183\t\t\tenc := json.NewEncoder(w)\n184\t\t\tenc.SetIndent(\"\", \"  \")\n185\t\t\tif err := enc.Encode(tokens); err != nil {\n186\t\t\t\treturn fmt.Errorf(\"encode JSON: %w\", err)\n187\t\t\t}\n188\t\t\treturn nil\n189\t\t}\n190\t\n191\t\tif len(tokens) == 0 {\n192\t\t\tfmt.Fprintln(w, \"No active tokens.\")\n193\t\t\treturn nil\n194\t\t}\n195\t\n196\t\t// Deterministic order: most recently used first, then most recently\n197\t\t// created, then by id as a final tie-breaker so the output is fully\n198\t\t// specified regardless of the server's response order.\n199\t\tsort.Slice(tokens, func(i, j int) bool {\n200\t\t\tli := lastUsedSortKey(tokens[i])\n201\t\t\tlj := lastUsedSortKey(tokens[j])\n202\t\t\tif li != lj {\n203\t\t\t\treturn li > lj\n204\t\t\t}\n205\t\t\tif tokens[i].CreatedAt != tokens[j].CreatedAt {\n206\t\t\t\treturn tokens[i].CreatedAt > tokens[j].CreatedAt\n207\t\t\t}\n208\t\t\treturn tokens[i].ID < tokens[j].ID\n209\t\t})\n210\t\n211\t\tsty := newAuthListStyles(w)\n212\t\trenderAuthListTable(w, sty, tokens, time.Now())\n213\t\treturn nil\n214\t}\n215\t\n216\t// authListStyles holds the lipgloss styles for `entire auth list`. Mirrors the\n217\t// approach in activity_render.go: keep style construction tied to color\n218\t// detection, and render plain text when color is disabled.\n219\ttype authListStyles struct {\n220\t\tcolorEnabled bool\n221\t\n222\t\theader  lipgloss.Style // bold + dim, used for column headers\n223\t\tid      lipgloss.Style // yellow accent\n224\t\tname    lipgloss.Style // bold\n225\t\tvalue   lipgloss.Style // default fg for scope/dates (no color)\n226\t\tdim     lipgloss.Style // \"never\", \"-\"\n227\t\twarning lipgloss.Style // expires-soon\n228\t\texpired lipgloss.Style // already expired\n229\t}\n230\t\n231\tfunc newAuthListStyles(w io.Writer) authListStyles {\n232\t\tuseColor := shouldUseColor(w)\n233\t\ts := authListStyles{colorEnabled: useColor}\n234\t\tif !useColor {\n235\t\t\treturn s\n236\t\t}\n237\t\ts.header = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")).Bold(true)\n238\t\ts.id = lipgloss.NewStyle().Foreground(lipgloss.Color(\"3\")) // yellow\n239\t\ts.name = lipgloss.NewStyle().Bold(true)\n240\t\ts.value = lipgloss.NewStyle() // default fg\n241\t\ts.dim = lipgloss.NewStyle().Faint(true)\n242\t\ts.warning = lipgloss.NewStyle().Foreground(lipgloss.Color(\"3\")) // yellow\n243\t\ts.expired = lipgloss.NewStyle().Foreground(lipgloss.Color(\"1\")) // red\n244\t\treturn s\n245\t}\n246\t\n247\tfunc (s authListStyles) render(style lipgloss.Style, text string) string {\n248\t\tif !s.colorEnabled {\n249\t\t\treturn text\n250\t\t}\n251\t\treturn style.Render(text)\n252\t}\n253\t\n254\t// renderAuthListTable prints a styled, column-aligned table of tokens. Column\n255\t// padding is computed via lipgloss.Width — it strips ANSI escapes, so a styled\n256\t// cell's visible width matches its plain text. tabwriter can't be used here\n257\t// once cells contain ANSI codes.\n258\tfunc renderAuthListTable(w io.Writer, sty authListStyles, tokens []api.Token, now time.Time) {\n259\t\theaderCells := []string{\"ID\", \"NAME\", \"SCOPE\", \"CREATED\", \"LAST USED\", \"EXPIRES\"}\n260\t\theader := make([]string, len(headerCells))\n261\t\tfor i, h := range headerCells {\n262\t\t\theader[i] = sty.render(sty.header, h)\n263\t\t}\n264\t\n265\t\trows := make([][]string, 0, len(tokens))\n266\t\tfor _, t := range tokens {\n267\t\t\trows = append(rows, []string{\n268\t\t\t\tsty.render(sty.id, t.ID),\n269\t\t\t\tstyleName(sty, t.Name),\n270\t\t\t\tsty.render(sty.value, fallback(t.Scope, placeholderDash)),\n271\t\t\t\tsty.render(sty.value, formatAuthDate(t.CreatedAt)),\n272\t\t\t\tstyleLastUsed(sty, t.LastUsedAt, now),\n273\t\t\t\tstyleExpires(sty, t.ExpiresAt, now),\n274\t\t\t})\n275\t\t}\n276\t\n277\t\twidths := make([]int, len(headerCells))\n278\t\tfor i, h := range header {\n279\t\t\twidths[i] = lipgloss.Width(h)\n280\t\t}\n281\t\tfor _, row := range rows {\n282\t\t\tfor i, c := range row {\n283\t\t\t\tif cw := lipgloss.Width(c); cw > widths[i] {\n284\t\t\t\t\twidths[i] = cw\n285\t\t\t\t}\n286\t\t\t}\n287\t\t}\n288\t\n289\t\twriteRow(w, header, widths)\n290\t\tfor _, row := range rows {\n291\t\t\twriteRow(w, row, widths)\n292\t\t}\n293\t}\n294\t\n295\tfunc writeRow(w io.Writer, cells []string, widths []int) {\n296\t\tfor i, c := range cells {\n297\t\t\tfmt.Fprint(w, c)\n298\t\t\tif i < len(cells)-1 {\n299\t\t\t\tfmt.Fprint(w, strings.Repeat(\" \", widths[i]-lipgloss.Width(c)+2))\n300\t\t\t}\n301\t\t}\n302\t\tfmt.Fprintln(w)\n303\t}\n304\t\n305\tfunc styleName(sty authListStyles, name string) string {\n306\t\tif name == \"\" {\n307\t\t\treturn sty.render(sty.dim, placeholderDash)\n308\t\t}\n309\t\treturn sty.render(sty.name, name)\n310\t}\n311\t\n312\tfunc styleLastUsed(sty authListStyles, lastUsed *string, now time.Time) string {\n313\t\tif lastUsed == nil {\n314\t\t\treturn sty.render(sty.dim, lastUsedNever)\n315\t\t}\n316\t\treturn sty.render(sty.value, formatAuthLastUsed(lastUsed, now))\n317\t}\n318\t\n319\tfunc styleExpires(sty authListStyles, expiresAt string, now time.Time) string {\n320\t\tformatted := formatAuthDate(expiresAt)\n321\t\tswitch classifyExpiresAt(expiresAt, now) {\n322\t\tcase expiresExpired:\n323\t\t\treturn sty.render(sty.expired, formatted)\n324\t\tcase expiresSoon:\n325\t\t\treturn sty.render(sty.warning, formatted)\n326\t\tcase expiresNormal:\n327\t\t\treturn sty.render(sty.value, formatted)\n328\t\t}\n329\t\treturn sty.render(sty.value, formatted)\n330\t}\n331\t\n332\tfunc lastUsedSortKey(t api.Token) string {\n333\t\tif t.LastUsedAt == nil {\n334\t\t\treturn \"\"\n335\t\t}\n336\t\treturn *t.LastUsedAt\n337\t}\n338\t\n339\t// formatAuthDate renders an RFC3339 timestamp as YYYY-MM-DD in local time.\n340\tfunc formatAuthDate(s string) string {\n341\t\tif s == \"\" {\n342\t\t\treturn placeholderDash\n343\t\t}\n344\t\tif ts, err := time.Parse(time.RFC3339, s); err == nil {\n345\t\t\treturn ts.Local().Format(\"2006-01-02\")\n346\t\t}\n347\t\treturn s\n348\t}\n349\t\n350\t// formatAuthLastUsed renders a relative \"last used\" timestamp, with \"yesterday\"\n351\t// and absolute-date branches that the shared formatRelativeDuration helper\n352\t// doesn't cover.\n353\tfunc formatAuthLastUsed(s *string, now time.Time) string {\n354\t\tif s == nil || *s == \"\" {\n355\t\t\treturn lastUsedNever\n356\t\t}\n357\t\tts, err := time.Parse(time.RFC3339, *s)\n358\t\tif err != nil {\n359\t\t\treturn *s\n360\t\t}\n361\t\tdelta := now.Sub(ts)\n362\t\tswitch {\n363\t\tcase delta < 0, delta >= 30*24*time.Hour:\n364\t\t\treturn ts.Local().Format(\"2006-01-02\")\n365\t\tcase delta >= 24*time.Hour && delta < 48*time.Hour:\n366\t\t\treturn \"yesterday\"\n367\t\tdefault:\n368\t\t\treturn formatRelativeDuration(delta)\n369\t\t}\n370\t}\n371\t\n372\ttype expiresState int\n373\t\n374\tconst (\n375\t\texpiresNormal expiresState = iota\n376\t\texpiresSoon\n377\t\texpiresExpired\n378\t)\n379\t\n380\t// classifyExpiresAt classifies an RFC3339 expires-at relative to now. Used to\n381\t// color the EXPIRES column so tokens worth rotating stand out.\n382\tfunc classifyExpiresAt(s string, now time.Time) expiresState {\n383\t\tif s == \"\" {\n384\t\t\treturn expiresNormal\n385\t\t}\n386\t\tts, err := time.Parse(time.RFC3339, s)\n387\t\tif err != nil {\n388\t\t\treturn expiresNormal\n389\t\t}\n390\t\tdelta := ts.Sub(now)\n391\t\tswitch {\n392\t\tcase delta <= 0:\n393\t\t\treturn expiresExpired\n394\t\tcase delta < 7*24*time.Hour:\n395\t\t\treturn expiresSoon\n396\t\tdefault:\n397\t\t\treturn expiresNormal\n398\t\t}\n399\t}\n400\t\n401\tfunc fallback(s, alt string) string {\n402\t\tif strings.TrimSpace(s) == \"\" {\n403\t\t\treturn alt\n404\t\t}\n405\t\treturn s\n406\t}\n407\t\n408\t// --- revoke -----------------------------------------------------------------\n409\t\n410\tfunc newAuthRevokeCmd() *cobra.Command {\n411\t\tvar revokeCurrent bool\n412\t\tvar insecureHTTPAuth bool\n413\t\tcmd := &cobra.Command{\n414\t\t\tUse:   \"revoke [id]\",\n415\t\t\tShort: \"Revoke an API token by id\",\n416\t\t\tLong:  \"Revoke a specific API token. Use --current to revoke the token used by this CLI.\",\n417\t\t\tArgs:  cobra.MaximumNArgs(1),\n418\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n419\t\t\t\tid := \"\"\n420\t\t\t\tif len(args) == 1 {\n421\t\t\t\t\tid = args[0]\n422\t\t\t\t}\n423\t\t\t\tif id == \"\" && !revokeCurrent {\n424\t\t\t\t\treturn cmd.Help()\n425\t\t\t\t}\n426\t\t\t\tif id != \"\" && revokeCurrent {\n427\t\t\t\t\treturn errors.New(\"cannot use both <id> and --current\")\n428\t\t\t\t}\n429\t\t\t\tif err := requireSecureBaseURL(insecureHTTPAuth); err != nil {\n430\t\t\t\t\treturn err\n431\t\t\t\t}\n432\t\t\t\treturn runAuthRevoke(cmd.Context(), cmd.OutOrStdout(), cmd.ErrOrStderr(),\n433\t\t\t\t\tauth.NewStore(), defaultListTokens, defaultRevokeTokenByID, defaultRevokeCurrentToken,\n434\t\t\t\t\tapi.BaseURL(), id, revokeCurrent)\n435\t\t\t},\n436\t\t}\n437\t\tcmd.Flags().BoolVar(&revokeCurrent, \"current\", false, \"Revoke the token used by this CLI and remove the local copy when stored locally\")\n438\t\taddInsecureHTTPAuthFlag(cmd, &insecureHTTPAuth)\n439\t\treturn cmd\n440\t}\n441\t\n442\tfunc defaultRevokeTokenByID(ctx context.Context, callerToken, id string) error {\n443\t\treturn api.NewClient(callerToken).RevokeToken(ctx, id) //nolint:wrapcheck // RevokeToken already wraps with action context\n444\t}\n445\t\n446\tfunc runAuthRevoke(\n447\t\tctx context.Context,\n448\t\toutW, errW io.Writer,\n449\t\tstore tokenStore,\n450\t\tlist authTokenLister,\n451\t\trevokeByID authTokenRevoker,\n452\t\trevokeCurrent revokeCurrentFunc,\n453\t\tbaseURL, id string,\n454\t\tcurrent bool,\n455\t) error {\n456\t\tinfo, err := store.GetTokenInfo(baseURL)\n457\t\tif err != nil {\n458\t\t\treturn fmt.Errorf(\"read auth token: %w\", err)\n459\t\t}\n460\t\tif info.Value == \"\" {\n461\t\t\treturn fmt.Errorf(\"not logged in to %s; run 'entire login' first\", baseURL)\n462\t\t}\n463\t\n464\t\tif current {\n465\t\t\treturn revokeCurrentToken(ctx, outW, errW, store, revokeCurrent, baseURL, info)\n466\t\t}\n467\t\n468\t\tif err := revokeByID(ctx, info.Value, id); err != nil {\n469\t\t\treturn err\n470\t\t}\n471\t\n472\t\t// The list endpoint requires bearer auth, so a 401 here means the id we\n473\t\t// just revoked was the same one this CLI is using — the keychain entry is\n474\t\t// now stale and would otherwise produce confusing 401s on every command.\n475\t\tif _, listErr := list(ctx, info.Value); listErr != nil && api.IsHTTPErrorStatus(listErr, http.StatusUnauthorized) {\n476\t\t\tif info.Source == auth.TokenSourceEnv {\n477\t\t\t\tfmt.Fprintf(outW, \"Revoked token %s (this was supplied by %s; unset it to stop using it locally).\\n\", id, auth.AuthTokenEnvVar)\n478\t\t\t\treturn nil\n479\t\t\t}\n480\t\t\tif delErr := store.DeleteToken(baseURL); delErr != nil {\n481\t\t\t\treturn fmt.Errorf(\"revoked token %s but failed to remove local copy: %w\", id, delErr)\n482\t\t\t}\n483\t\t\tfmt.Fprintf(outW, \"Revoked token %s (this was your local token; removed from %s).\\n\", id, localTokenSourceName(info))\n484\t\t\treturn nil\n485\t\t}\n486\t\n487\t\tfmt.Fprintf(outW, \"Revoked token %s.\\n\", id)\n488\t\treturn nil\n489\t}\n490\t\n491\tfunc revokeCurrentToken(\n492\t\tctx context.Context,\n493\t\toutW, errW io.Writer,\n494\t\tstore tokenStore,\n495\t\trevoke revokeCurrentFunc,\n496\t\tbaseURL string,\n497\t\tinfo auth.TokenInfo,\n498\t) error {\n499\t\tif info.Source == auth.TokenSourceEnv {\n500\t\t\tif err := revoke(ctx, info.Value); err != nil {\n501\t\t\t\treturn fmt.Errorf(\"revoke current token: %w\", err)\n502\t\t\t}\n503\t\t\tfmt.Fprintf(outW, \"Revoked current token supplied by %s. Unset it to stop using it locally.\\n\", auth.AuthTokenEnvVar)\n504\t\t\treturn nil\n505\t\t}\n506\t\n507\t\tif err := revoke(ctx, info.Value); err != nil && !api.IsHTTPErrorStatus(err, http.StatusUnauthorized) {\n508\t\t\tfmt.Fprintf(errW, \"Warning: server-side token revocation failed: %v\\n\", err)\n509\t\t}\n510\t\tif err := store.DeleteToken(baseURL); err != nil {\n511\t\t\treturn fmt.Errorf(\"remove auth token: %w\", err)\n512\t\t}\n513\t\n514\t\tfmt.Fprintln(outW, \"Logged out.\")\n515\t\treturn nil\n516\t}\n517\t\n518\tfunc localTokenSourceName(info auth.TokenInfo) string {\n519\t\tswitch info.Source {\n520\t\tcase auth.TokenSourceFile:\n521\t\t\treturn \"file\"\n522\t\tcase auth.TokenSourceKeyring:\n523\t\t\treturn \"keychain\"\n524\t\tcase auth.TokenSourceEnv:\n525\t\t\treturn auth.AuthTokenEnvVar\n526\t\tcase auth.TokenSourceNone:\n527\t\t\treturn \"local storage\"\n528\t\tdefault:\n529\t\t\treturn \"local storage\"\n530\t\t}\n531\t}\n532\t"}]},"uuid":"041866e7-5ea5-4462-aac5-1bb942789a5e","timestamp":"2026-05-06T16:46:58.177Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/issue-1036-auth-storage/cmd/entire/cli/auth.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n\n\t\"charm.land/lipgloss/v2\"\n\t\"github.com/entireio/cli/cmd/entire/cli/api\"\n\t\"github.com/entireio/cli/cmd/entire/cli/auth\"\n\t\"github.com/spf13/cobra\"\n)\n\n// authTokenLister lists API tokens for the authenticated user.\ntype authTokenLister func(ctx context.Context, token string) ([]api.Token, error)\n\n// authTokenRevoker revokes a single API token by id.\ntype authTokenRevoker func(ctx context.Context, callerToken, id string) error\n\n// User-visible placeholder strings. Promoted to constants so tests and\n// production share a single source of truth.\nconst (\n\tplaceholderDash = \"-\"\n\tlastUsedNever   = \"never\"\n\tlastUsedJustNow = \"just now\"\n)\n\n// requireSecureBaseURL enforces TLS unless insecureHTTPAuth is set. Every\n// command that sends a bearer token over the network (login, logout,\n// auth status/list/revoke) must call this so credentials don't leak over\n// plaintext HTTP without explicit opt-in.\nfunc requireSecureBaseURL(insecureHTTPAuth bool) error {\n\tif insecureHTTPAuth {\n\t\treturn nil\n\t}\n\tif err := api.RequireSecureURL(api.BaseURL()); err != nil {\n\t\treturn fmt.Errorf(\"base URL check: %w\", err)\n\t}\n\treturn nil\n}\n\n// addInsecureHTTPAuthFlag attaches the hidden --insecure-http-auth flag used\n// by every authenticated command for local development.\nfunc addInsecureHTTPAuthFlag(cmd *cobra.Command, target *bool) {\n\tcmd.Flags().BoolVar(target, \"insecure-http-auth\", false, \"Allow authentication over plain HTTP (insecure, for local development only)\")\n\tif err := cmd.Flags().MarkHidden(\"insecure-http-auth\"); err != nil {\n\t\tpanic(fmt.Sprintf(\"hide insecure-http-auth flag: %v\", err))\n\t}\n}\n\nfunc newAuthCmd() *cobra.Command {\n\tcmd := &cobra.Command{\n\t\tUse:   \"auth\",\n\t\tShort: \"Manage authentication and API tokens\",\n\t\tLong:  \"Authentication subcommands. Includes login, logout, status, listing tokens, and revoking tokens.\",\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn cmd.Help()\n\t\t},\n\t}\n\n\tcmd.AddCommand(newLoginCmd())\n\tcmd.AddCommand(newLogoutCmd())\n\tcmd.AddCommand(newAuthStatusCmd())\n\tcmd.AddCommand(newAuthListCmd())\n\tcmd.AddCommand(newAuthRevokeCmd())\n\treturn cmd\n}\n\n// --- status -----------------------------------------------------------------\n\nfunc newAuthStatusCmd() *cobra.Command {\n\tvar insecureHTTPAuth bool\n\tcmd := &cobra.Command{\n\t\tUse:   \"status\",\n\t\tShort: \"Show authentication status\",\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\tif err := requireSecureBaseURL(insecureHTTPAuth); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn runAuthStatus(cmd.Context(), cmd.OutOrStdout(),\n\t\t\t\tauth.NewStore(), defaultListTokens, api.BaseURL())\n\t\t},\n\t}\n\taddInsecureHTTPAuthFlag(cmd, &insecureHTTPAuth)\n\treturn cmd\n}\n\nfunc defaultListTokens(ctx context.Context, token string) ([]api.Token, error) {\n\treturn api.NewClient(token).ListTokens(ctx) //nolint:wrapcheck // ListTokens already wraps with action context\n}\n\nfunc runAuthStatus(ctx context.Context, w io.Writer, store tokenStore, list authTokenLister, baseURL string) error {\n\tinfo, err := store.GetTokenInfo(baseURL)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"read auth token: %w\", err)\n\t}\n\tif info.Value == \"\" {\n\t\tfmt.Fprintf(w, \"Not logged in to %s\\n\", baseURL)\n\t\tfmt.Fprintln(w, \"Run 'entire login' to authenticate.\")\n\t\treturn nil\n\t}\n\n\ttokens, err := list(ctx, info.Value)\n\tif err != nil {\n\t\tif api.IsHTTPErrorStatus(err, http.StatusUnauthorized) {\n\t\t\tfmt.Fprintf(w, \"Token for %s is no longer valid.\\n\", baseURL)\n\t\t\tif info.Source == auth.TokenSourceEnv {\n\t\t\t\tfmt.Fprintf(w, \"Update or unset %s to re-authenticate.\\n\", auth.AuthTokenEnvVar)\n\t\t\t} else {\n\t\t\t\tfmt.Fprintln(w, \"Run 'entire login' to re-authenticate.\")\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\t\treturn fmt.Errorf(\"validate token: %w\", err)\n\t}\n\n\tfmt.Fprintf(w, \"Logged in to %s\\n\", baseURL)\n\tfmt.Fprintf(w, \"  Token: %s\\n\", describeTokenSource(info))\n\tfmt.Fprintf(w, \"  Active tokens on this account: %d\\n\", len(tokens))\n\treturn nil\n}\n\nfunc describeTokenSource(info auth.TokenInfo) string {\n\tswitch info.Source {\n\tcase auth.TokenSourceNone:\n\t\treturn \"not configured\"\n\tcase auth.TokenSourceEnv:\n\t\treturn \"supplied by \" + auth.AuthTokenEnvVar\n\tcase auth.TokenSourceFile:\n\t\tif info.Path != \"\" {\n\t\t\treturn \"stored in file \" + info.Path\n\t\t}\n\t\treturn \"stored in file\"\n\tcase auth.TokenSourceKeyring:\n\t\treturn \"stored in OS keychain\"\n\tdefault:\n\t\treturn \"stored\"\n\t}\n}\n\n// --- list -------------------------------------------------------------------\n\nfunc newAuthListCmd() *cobra.Command {\n\tvar jsonOut bool\n\tvar insecureHTTPAuth bool\n\tcmd := &cobra.Command{\n\t\tUse:   \"list\",\n\t\tShort: \"List active API tokens for the authenticated user\",\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\tif err := requireSecureBaseURL(insecureHTTPAuth); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn runAuthList(cmd.Context(), cmd.OutOrStdout(),\n\t\t\t\tauth.NewStore(), defaultListTokens, api.BaseURL(), jsonOut)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Print tokens as JSON\")\n\taddInsecureHTTPAuthFlag(cmd, &insecureHTTPAuth)\n\treturn cmd\n}\n\nfunc runAuthList(ctx context.Context, w io.Writer, store tokenStore, list authTokenLister, baseURL string, jsonOut bool) error {\n\ttoken, err := store.GetToken(baseURL)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"read auth token: %w\", err)\n\t}\n\tif token == \"\" {\n\t\treturn fmt.Errorf(\"not logged in to %s; run 'entire login' first\", baseURL)\n\t}\n\n\ttokens, err := list(ctx, token)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tif jsonOut {\n\t\tenc := json.NewEncoder(w)\n\t\tenc.SetIndent(\"\", \"  \")\n\t\tif err := enc.Encode(tokens); err != nil {\n\t\t\treturn fmt.Errorf(\"encode JSON: %w\", err)\n\t\t}\n\t\treturn nil\n\t}\n\n\tif len(tokens) == 0 {\n\t\tfmt.Fprintln(w, \"No active tokens.\")\n\t\treturn nil\n\t}\n\n\t// Deterministic order: most recently used first, then most recently\n\t// created, then by id as a final tie-breaker so the output is fully\n\t// specified regardless of the server's response order.\n\tsort.Slice(tokens, func(i, j int) bool {\n\t\tli := lastUsedSortKey(tokens[i])\n\t\tlj := lastUsedSortKey(tokens[j])\n\t\tif li != lj {\n\t\t\treturn li > lj\n\t\t}\n\t\tif tokens[i].CreatedAt != tokens[j].CreatedAt {\n\t\t\treturn tokens[i].CreatedAt > tokens[j].CreatedAt\n\t\t}\n\t\treturn tokens[i].ID < tokens[j].ID\n\t})\n\n\tsty := newAuthListStyles(w)\n\trenderAuthListTable(w, sty, tokens, time.Now())\n\treturn nil\n}\n\n// authListStyles holds the lipgloss styles for `entire auth list`. Mirrors the\n// approach in activity_render.go: keep style construction tied to color\n// detection, and render plain text when color is disabled.\ntype authListStyles struct {\n\tcolorEnabled bool\n\n\theader  lipgloss.Style // bold + dim, used for column headers\n\tid      lipgloss.Style // yellow accent\n\tname    lipgloss.Style // bold\n\tvalue   lipgloss.Style // default fg for scope/dates (no color)\n\tdim     lipgloss.Style // \"never\", \"-\"\n\twarning lipgloss.Style // expires-soon\n\texpired lipgloss.Style // already expired\n}\n\nfunc newAuthListStyles(w io.Writer) authListStyles {\n\tuseColor := shouldUseColor(w)\n\ts := authListStyles{colorEnabled: useColor}\n\tif !useColor {\n\t\treturn s\n\t}\n\ts.header = lipgloss.NewStyle().Foreground(lipgloss.Color(\"8\")).Bold(true)\n\ts.id = lipgloss.NewStyle().Foreground(lipgloss.Color(\"3\")) // yellow\n\ts.name = lipgloss.NewStyle().Bold(true)\n\ts.value = lipgloss.NewStyle() // default fg\n\ts.dim = lipgloss.NewStyle().Faint(true)\n\ts.warning = lipgloss.NewStyle().Foreground(lipgloss.Color(\"3\")) // yellow\n\ts.expired = lipgloss.NewStyle().Foreground(lipgloss.Color(\"1\")) // red\n\treturn s\n}\n\nfunc (s authListStyles) render(style lipgloss.Style, text string) string {\n\tif !s.colorEnabled {\n\t\treturn text\n\t}\n\treturn style.Render(text)\n}\n\n// renderAuthListTable prints a styled, column-aligned table of tokens. Column\n// padding is computed via lipgloss.Width — it strips ANSI escapes, so a styled\n// cell's visible width matches its plain text. tabwriter can't be used here\n// once cells contain ANSI codes.\nfunc renderAuthListTable(w io.Writer, sty authListStyles, tokens []api.Token, now time.Time) {\n\theaderCells := []string{\"ID\", \"NAME\", \"SCOPE\", \"CREATED\", \"LAST USED\", \"EXPIRES\"}\n\theader := make([]string, len(headerCells))\n\tfor i, h := range headerCells {\n\t\theader[i] = sty.render(sty.header, h)\n\t}\n\n\trows := make([][]string, 0, len(tokens))\n\tfor _, t := range tokens {\n\t\trows = append(rows, []string{\n\t\t\tsty.render(sty.id, t.ID),\n\t\t\tstyleName(sty, t.Name),\n\t\t\tsty.render(sty.value, fallback(t.Scope, placeholderDash)),\n\t\t\tsty.render(sty.value, formatAuthDate(t.CreatedAt)),\n\t\t\tstyleLastUsed(sty, t.LastUsedAt, now),\n\t\t\tstyleExpires(sty, t.ExpiresAt, now),\n\t\t})\n\t}\n\n\twidths := make([]int, len(headerCells))\n\tfor i, h := range header {\n\t\twidths[i] = lipgloss.Width(h)\n\t}\n\tfor _, row := range rows {\n\t\tfor i, c := range row {\n\t\t\tif cw := lipgloss.Width(c); cw > widths[i] {\n\t\t\t\twidths[i] = cw\n\t\t\t}\n\t\t}\n\t}\n\n\twriteRow(w, header, widths)\n\tfor _, row := range rows {\n\t\twriteRow(w, row, widths)\n\t}\n}\n\nfunc writeRow(w io.Writer, cells []string, widths []int) {\n\tfor i, c := range cells {\n\t\tfmt.Fprint(w, c)\n\t\tif i < len(cells)-1 {\n\t\t\tfmt.Fprint(w, strings.Repeat(\" \", widths[i]-lipgloss.Width(c)+2))\n\t\t}\n\t}\n\tfmt.Fprintln(w)\n}\n\nfunc styleName(sty authListStyles, name string) string {\n\tif name == \"\" {\n\t\treturn sty.render(sty.dim, placeholderDash)\n\t}\n\treturn sty.render(sty.name, name)\n}\n\nfunc styleLastUsed(sty authListStyles, lastUsed *string, now time.Time) string {\n\tif lastUsed == nil {\n\t\treturn sty.render(sty.dim, lastUsedNever)\n\t}\n\treturn sty.render(sty.value, formatAuthLastUsed(lastUsed, now))\n}\n\nfunc styleExpires(sty authListStyles, expiresAt string, now time.Time) string {\n\tformatted := formatAuthDate(expiresAt)\n\tswitch classifyExpiresAt(expiresAt, now) {\n\tcase expiresExpired:\n\t\treturn sty.render(sty.expired, formatted)\n\tcase expiresSoon:\n\t\treturn sty.render(sty.warning, formatted)\n\tcase expiresNormal:\n\t\treturn sty.render(sty.value, formatted)\n\t}\n\treturn sty.render(sty.value, formatted)\n}\n\nfunc lastUsedSortKey(t api.Token) string {\n\tif t.LastUsedAt == nil {\n\t\treturn \"\"\n\t}\n\treturn *t.LastUsedAt\n}\n\n// formatAuthDate renders an RFC3339 timestamp as YYYY-MM-DD in local time.\nfunc formatAuthDate(s string) string {\n\tif s == \"\" {\n\t\treturn placeholderDash\n\t}\n\tif ts, err := time.Parse(time.RFC3339, s); err == nil {\n\t\treturn ts.Local().Format(\"2006-01-02\")\n\t}\n\treturn s\n}\n\n// formatAuthLastUsed renders a relative \"last used\" timestamp, with \"yesterday\"\n// and absolute-date branches that the shared formatRelativeDuration helper\n// doesn't cover.\nfunc formatAuthLastUsed(s *string, now time.Time) string {\n\tif s == nil || *s == \"\" {\n\t\treturn lastUsedNever\n\t}\n\tts, err := time.Parse(time.RFC3339, *s)\n\tif err != nil {\n\t\treturn *s\n\t}\n\tdelta := now.Sub(ts)\n\tswitch {\n\tcase delta < 0, delta >= 30*24*time.Hour:\n\t\treturn ts.Local().Format(\"2006-01-02\")\n\tcase delta >= 24*time.Hour && delta < 48*time.Hour:\n\t\treturn \"yesterday\"\n\tdefault:\n\t\treturn formatRelativeDuration(delta)\n\t}\n}\n\ntype expiresState int\n\nconst (\n\texpiresNormal expiresState = iota\n\texpiresSoon\n\texpiresExpired\n)\n\n// classifyExpiresAt classifies an RFC3339 expires-at relative to now. Used to\n// color the EXPIRES column so tokens worth rotating stand out.\nfunc classifyExpiresAt(s string, now time.Time) expiresState {\n\tif s == \"\" {\n\t\treturn expiresNormal\n\t}\n\tts, err := time.Parse(time.RFC3339, s)\n\tif err != nil {\n\t\treturn expiresNormal\n\t}\n\tdelta := ts.Sub(now)\n\tswitch {\n\tcase delta <= 0:\n\t\treturn expiresExpired\n\tcase delta < 7*24*time.Hour:\n\t\treturn expiresSoon\n\tdefault:\n\t\treturn expiresNormal\n\t}\n}\n\nfunc fallback(s, alt string) string {\n\tif strings.TrimSpace(s) == \"\" {\n\t\treturn alt\n\t}\n\treturn s\n}\n\n// --- revoke -----------------------------------------------------------------\n\nfunc newAuthRevokeCmd() *cobra.Command {\n\tvar revokeCurrent bool\n\tvar insecureHTTPAuth bool\n\tcmd := &cobra.Command{\n\t\tUse:   \"revoke [id]\",\n\t\tShort: \"Revoke an API token by id\",\n\t\tLong:  \"Revoke a specific API token. Use --current to revoke the token used by this CLI.\",\n\t\tArgs:  cobra.MaximumNArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\tid := \"\"\n\t\t\tif len(args) == 1 {\n\t\t\t\tid = args[0]\n\t\t\t}\n\t\t\tif id == \"\" && !revokeCurrent {\n\t\t\t\treturn cmd.Help()\n\t\t\t}\n\t\t\tif id != \"\" && revokeCurrent {\n\t\t\t\treturn errors.New(\"cannot use both <id> and --current\")\n\t\t\t}\n\t\t\tif err := requireSecureBaseURL(insecureHTTPAuth); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn runAuthRevoke(cmd.Context(), cmd.OutOrStdout(), cmd.ErrOrStderr(),\n\t\t\t\tauth.NewStore(), defaultListTokens, defaultRevokeTokenByID, defaultRevokeCurrentToken,\n\t\t\t\tapi.BaseURL(), id, revokeCurrent)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&revokeCurrent, \"current\", false, \"Revoke the token used by this CLI and remove the local copy when stored locally\")\n\taddInsecureHTTPAuthFlag(cmd, &insecureHTTPAuth)\n\treturn cmd\n}\n\nfunc defaultRevokeTokenByID(ctx context.Context, callerToken, id string) error {\n\treturn api.NewClient(callerToken).RevokeToken(ctx, id) //nolint:wrapcheck // RevokeToken already wraps with action context\n}\n\nfunc runAuthRevoke(\n\tctx context.Context,\n\toutW, errW io.Writer,\n\tstore tokenStore,\n\tlist authTokenLister,\n\trevokeByID authTokenRevoker,\n\trevokeCurrent revokeCurrentFunc,\n\tbaseURL, id string,\n\tcurrent bool,\n) error {\n\tinfo, err := store.GetTokenInfo(baseURL)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"read auth token: %w\", err)\n\t}\n\tif info.Value == \"\" {\n\t\treturn fmt.Errorf(\"not logged in to %s; run 'entire login' first\", baseURL)\n\t}\n\n\tif current {\n\t\treturn revokeCurrentToken(ctx, outW, errW, store, revokeCurrent, baseURL, info)\n\t}\n\n\tif err := revokeByID(ctx, info.Value, id); err != nil {\n\t\treturn err\n\t}\n\n\t// The list endpoint requires bearer auth, so a 401 here means the id we\n\t// just revoked was the same one this CLI is using — the keychain entry is\n\t// now stale and would otherwise produce confusing 401s on every command.\n\tif _, listErr := list(ctx, info.Value); listErr != nil && api.IsHTTPErrorStatus(listErr, http.StatusUnauthorized) {\n\t\tif info.Source == auth.TokenSourceEnv {\n\t\t\tfmt.Fprintf(outW, \"Revoked token %s (this was supplied by %s; unset it to stop using it locally).\\n\", id, auth.AuthTokenEnvVar)\n\t\t\treturn nil\n\t\t}\n\t\tif delErr := store.DeleteToken(baseURL); delErr != nil {\n\t\t\treturn fmt.Errorf(\"revoked token %s but failed to remove local copy: %w\", id, delErr)\n\t\t}\n\t\tfmt.Fprintf(outW, \"Revoked token %s (this was your local token; removed from %s).\\n\", id, localTokenSourceName(info))\n\t\treturn nil\n\t}\n\n\tfmt.Fprintf(outW, \"Revoked token %s.\\n\", id)\n\treturn nil\n}\n\nfunc revokeCurrentToken(\n\tctx context.Context,\n\toutW, errW io.Writer,\n\tstore tokenStore,\n\trevoke revokeCurrentFunc,\n\tbaseURL string,\n\tinfo auth.TokenInfo,\n) error {\n\tif info.Source == auth.TokenSourceEnv {\n\t\tif err := revoke(ctx, info.Value); err != nil {\n\t\t\treturn fmt.Errorf(\"revoke current token: %w\", err)\n\t\t}\n\t\tfmt.Fprintf(outW, \"Revoked current token supplied by %s. Unset it to stop using it locally.\\n\", auth.AuthTokenEnvVar)\n\t\treturn nil\n\t}\n\n\tif err := revoke(ctx, info.Value); err != nil && !api.IsHTTPErrorStatus(err, http.StatusUnauthorized) {\n\t\tfmt.Fprintf(errW, \"Warning: server-side token revocation failed: %v\\n\", err)\n\t}\n\tif err := store.DeleteToken(baseURL); err != nil {\n\t\treturn fmt.Errorf(\"remove auth token: %w\", err)\n\t}\n\n\tfmt.Fprintln(outW, \"Logged out.\")\n\treturn nil\n}\n\nfunc localTokenSourceName(info auth.TokenInfo) string {\n\tswitch info.Source {\n\tcase auth.TokenSourceFile:\n\t\treturn \"file\"\n\tcase auth.TokenSourceKeyring:\n\t\treturn \"keychain\"\n\tcase auth.TokenSourceEnv:\n\t\treturn auth.AuthTokenEnvVar\n\tcase auth.TokenSourceNone:\n\t\treturn \"local storage\"\n\tdefault:\n\t\treturn \"local storage\"\n\t}\n}\n","numLines":532,"startLine":1,"totalLines":532}},"sourceToolAssistantUUID":"154a0fb2-855a-4610-b562-a70c6289ed19","userType":"external","entrypoint":"cli","cwd":"/Users/peytonmontei/Documents/entire/devenv/entireio/cli/.worktrees/issue-1036-auth-storage","sessionId":"d10d4bee-66ca-451a-b1a3-c460212b51d0","version":"2.1.129","gitBranch":"fix/issue-1036-auth-storage"}
