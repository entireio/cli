r.SimulatePreTask(sessionID, transcriptPath, toolUseID)\n1218\t}\n1219\t\n1220\t// SimulateFactoryDroidPostTask is a convenience method on TestEnv.\n1221\tfunc (env *TestEnv) SimulateFactoryDroidPostTask(input PostTaskInput) error {\n1222\t\tenv.T.Helper()\n1223\t\trunner := NewFactoryDroidHookRunner(env.RepoDir, env.T)\n1224\t\treturn runner.SimulatePostTask(input)\n1225\t}\n1226\t\n1227\t// --- OpenCode Hook Runner ---\n1228\t\n1229\t// OpenCodeHookRunner executes OpenCode hooks in the test environment.\n1230\ttype OpenCodeHookRunner struct {\n1231\t\tRepoDir            string\n1232\t\tOpenCodeProjectDir string\n1233\t\tT                  interface {\n1234\t\t\tHelper()\n1235\t\t\tFatalf(format string, args ...interface{})\n1236\t\t\tLogf(format string, args ...interface{})\n1237\t\t}\n1238\t}\n1239\t\n1240\t// NewOpenCodeHookRunner creates a new OpenCode hook runner for the given repo directory.\n1241\tfunc NewOpenCodeHookRunner(repoDir, openCodeProjectDir string, t interface {\n1242\t\tHelper()\n1243\t\tFatalf(format string, args ...interface{})\n1244\t\tLogf(format string, args ...interface{})\n1245\t}) *OpenCodeHookRunner {\n1246\t\treturn &OpenCodeHookRunner{\n1247\t\t\tRepoDir:            repoDir,\n1248\t\t\tOpenCodeProjectDir: openCodeProjectDir,\n1249\t\t\tT:                  t,\n1250\t\t}\n1251\t}\n1252\t\n1253\tfunc (r *OpenCodeHookRunner) runOpenCodeHookWithInput(hookName string, input interface{}) error {\n1254\t\tr.T.Helper()\n1255\t\n1256\t\tinputJSON, err := json.Marshal(input)\n1257\t\tif err != nil {\n1258\t\t\treturn fmt.Errorf(\"failed to marshal hook input: %w\", err)\n1259\t\t}\n1260\t\n1261\t\treturn r.runOpenCodeHookInRepoDir(hookName, inputJSON)\n1262\t}\n1263\t\n1264\tfunc (r *OpenCodeHookRunner) runOpenCodeHookInRepoDir(hookName string, inputJSON []byte) error {\n1265\t\t// Command structure: entire hooks opencode <hook-name>\n1266\t\tcmd := exec.Command(getTestBinary(), \"hooks\", \"opencode\", hookName)\n1267\t\tcmd.Dir = r.RepoDir\n1268\t\tcmd.Stdin = bytes.NewReader(inputJSON)\n1269\t\tcmd.Env = append(testutil.GitIsolatedEnv(),\n1270\t\t\t\"ENTIRE_TEST_OPENCODE_PROJECT_DIR=\"+r.OpenCodeProjectDir,\n1271\t\t\t\"ENTIRE_TEST_OPENCODE_MOCK_EXPORT=1\", // Use pre-written mock transcript instead of calling opencode export\n1272\t\t)\n1273\t\n1274\t\toutput, err := cmd.CombinedOutput()\n1275\t\tif err != nil {\n1276\t\t\treturn fmt.Errorf(\"hook %s failed: %w\\nInput: %s\\nOutput: %s\",\n1277\t\t\t\thookName, err, inputJSON, output)\n1278\t\t}\n1279\t\n1280\t\tr.T.Logf(\"OpenCode hook %s output: %s\", hookName, output)\n1281\t\treturn nil\n1282\t}\n1283\t\n1284\t// SimulateOpenCodeSessionStart simulates the session-start hook for OpenCode.\n1285\t// Note: The plugin now sends only session_id, not transcript_path.\n1286\tfunc (r *OpenCodeHookRunner) SimulateOpenCodeSessionStart(sessionID, _ string) error {\n1287\t\tr.T.Helper()\n1288\t\n1289\t\tinput := map[string]string{\n1290\t\t\t\"session_id\": sessionID,\n1291\t\t}\n1292\t\n1293\t\treturn r.runOpenCodeHookWithInput(\"session-start\", input)\n1294\t}\n1295\t\n1296\t// SimulateOpenCodeTurnStart simulates the turn-start hook for OpenCode.\n1297\t// This is equivalent to Claude Code's UserPromptSubmit.\n1298\t// Note: The plugin now sends only session_id and prompt, not transcript_path.\n1299\tfunc (r *OpenCodeHookRunner) SimulateOpenCodeTurnStart(sessionID, _, prompt string) error {\n1300\t\tr.T.Helper()\n1301\t\n1302\t\tinput := map[string]string{\n1303\t\t\t\"session_id\": sessionID,\n1304\t\t\t\"prompt\":     prompt,\n1305\t\t}\n1306\t\n1307\t\treturn r.runOpenCodeHookWithInput(\"turn-start\", input)\n1308\t}\n1309\t\n1310\t// SimulateOpenCodeTurnEnd simulates the turn-end hook for OpenCode.\n1311\t// This is equivalent to Claude Code's Stop hook.\n1312\t// Note: The plugin now sends only session_id. The Go handler calls `opencode export`\n1313\t// to get the transcript. For tests, we write a mock export JSON file first.\n1314\tfunc (r *OpenCodeHookRunner) SimulateOpenCodeTurnEnd(sessionID, transcriptPath string) error {\n1315\t\tr.T.Helper()\n1316\t\n1317\t\t// For integration tests, write the mock transcript to the location where the\n1318\t\t// lifecycle handler expects it (.entire/tmp/<session_id>.json)\n1319\t\tif transcriptPath != \"\" {\n1320\t\t\tsrcData, err := os.ReadFile(transcriptPath)\n1321\t\t\tif err != nil {\n1322\t\t\t\tr.T.Fatalf(\"SimulateOpenCodeTurnEnd: failed to read transcript from %q: %v\", transcriptPath, err)\n1323\t\t\t}\n1324\t\t\tdestDir := filepath.Join(r.RepoDir, \".entire\", \"tmp\")\n1325\t\t\tif err := os.MkdirAll(destDir, 0o755); err != nil {\n1326\t\t\t\tr.T.Fatalf(\"SimulateOpenCodeTurnEnd: failed to create directory %q: %v\", destDir, err)\n1327\t\t\t}\n1328\t\t\tdestPath := filepath.Join(destDir, sessionID+\".json\")\n1329\t\t\tif err := os.WriteFile(destPath, srcData, 0o644); err != nil {\n1330\t\t\t\tr.T.Fatalf(\"SimulateOpenCodeTurnEnd: failed to write transcript to %q: %v\", destPath, err)\n1331\t\t\t}\n1332\t\t}\n1333\t\n1334\t\tinput := map[string]string{\n1335\t\t\t\"session_id\": sessionID,\n1336\t\t}\n1337\t\n1338\t\treturn r.runOpenCodeHookWithInput(\"turn-end\", input)\n1339\t}\n1340\t\n1341\t// SimulateOpenCodeSessionEnd simulates the session-end hook for OpenCode.\n1342\t// Note: The plugin now sends only session_id, not transcript_path.\n1343\tfunc (r *OpenCodeHookRunner) SimulateOpenCodeSessionEnd(sessionID, _ string) error {\n1344\t\tr.T.Helper()\n1345\t\n1346\t\tinput := map[string]string{\n1347\t\t\t\"session_id\": sessionID,\n1348\t\t}\n1349\t\n1350\t\treturn r.runOpenCodeHookWithInput(\"session-end\", input)\n1351\t}\n1352\t\n1353\t// OpenCodeSession represents a simulated OpenCode session.\n1354\ttype OpenCodeSession struct {\n1355\t\tID             string // Raw session ID (e.g., \"opencode-session-1\")\n1356\t\tTranscriptPath string\n1357\t\tenv            *TestEnv\n1358\t\tmsgCounter     int\n1359\t\t// messages accumulates all messages across turns, matching real `opencode export`\n1360\t\t// behavior where each export returns the full session history.\n1361\t\tmessages []map[string]interface{}\n1362\t}\n1363\t\n1364\t// NewOpenCodeSession creates a new simulated OpenCode session.\n1365\tfunc (env *TestEnv) NewOpenCodeSession() *OpenCodeSession {\n1366\t\tenv.T.Helper()\n1367\t\n1368\t\tenv.SessionCounter++\n1369\t\tsessionID := fmt.Sprintf(\"opencode-session-%d\", env.SessionCounter)\n1370\t\ttranscriptPath := filepath.Join(env.OpenCodeProjectDir, sessionID+\".json\")\n1371\t\n1372\t\treturn &OpenCodeSession{\n1373\t\t\tID:             sessionID,\n1374\t\t\tTranscriptPath: transcriptPath,\n1375\t\t\tenv:            env,\n1376\t\t}\n1377\t}\n1378\t\n1379\t// CreateOpenCodeTranscript creates an OpenCode export JSON transcript file for the session.\n1380\t// Each call appends new messages to the accumulated session history, matching real\n1381\t// `opencode export` behavior where each export returns the full session history.\n1382\tfunc (s *OpenCodeSession) CreateOpenCodeTranscript(prompt string, changes []FileChange) string {\n1383\t\t// User message\n1384\t\ts.msgCounter++\n1385\t\ts.messages = append(s.messages, map[string]interface{}{\n1386\t\t\t\"info\": map[string]interface{}{\n1387\t\t\t\t\"id\":   fmt.Sprintf(\"msg-%d\", s.msgCounter),\n1388\t\t\t\t\"role\": \"user\",\n1389\t\t\t\t\"time\": map[string]interface{}{\"created\": 1708300000 + s.msgCounter},\n1390\t\t\t},\n1391\t\t\t\"parts\": []map[string]interface{}{\n1392\t\t\t\t{\"type\": \"text\", \"text\": prompt},\n1393\t\t\t},\n1394\t\t})\n1395\t\n1396\t\t// Assistant message with tool calls for file changes\n1397\t\ts.msgCounter++\n1398\t\tvar parts []map[string]interface{}\n1399\t\tparts = append(parts, map[string]interface{}{\n1400\t\t\t\"type\": \"text\",\n1401\t\t\t\"text\": \"I'll help you with that.\",\n1402\t\t})\n1403\t\tfor i, change := range changes {\n1404\t\t\tparts = append(parts, map[string]interface{}{\n1405\t\t\t\t\"type\":   \"tool\",\n1406\t\t\t\t\"tool\":   \"write\",\n1407\t\t\t\t\"callID\": fmt.Sprintf(\"call-%d\", i+1),\n1408\t\t\t\t\"state\": map[string]interface{}{\n1409\t\t\t\t\t\"status\": \"completed\",\n1410\t\t\t\t\t\"input\":  map[string]string{\"filePath\": change.Path},\n1411\t\t\t\t\t\"output\": \"File written: \" + change.Path,\n1412\t\t\t\t},\n1413\t\t\t})\n1414\t\t}\n1415\t\tparts = append(parts, map[string]interface{}{\n1416\t\t\t\"type\": \"text\",\n1417\t\t\t\"text\": \"Done!\",\n1418\t\t})\n1419\t\n1420\t\ts.messages = append(s.messages, map[string]interface{}{\n1421\t\t\t\"info\": map[string]interface{}{\n1422\t\t\t\t\"id\":   fmt.Sprintf(\"msg-%d\", s.msgCounter),\n1423\t\t\t\t\"role\": \"assistant\",\n1424\t\t\t\t\"time\": map[string]interface{}{\n1425\t\t\t\t\t\"created\":   1708300000 + s.msgCounter,\n1426\t\t\t\t\t\"completed\": 1708300000 + s.msgCounter + 5,\n1427\t\t\t\t},\n1428\t\t\t\t\"tokens\": map[string]interface{}{\n1429\t\t\t\t\t\"input\":     150,\n1430\t\t\t\t\t\"output\":    80,\n1431\t\t\t\t\t\"reasoning\": 10,\n1432\t\t\t\t\t\"cache\":     map[string]int{\"read\": 5, \"write\": 15},\n1433\t\t\t\t},\n1434\t\t\t\t\"cost\": 0.003,\n1435\t\t\t},\n1436\t\t\t\"parts\": parts,\n1437\t\t})\n1438\t\n1439\t\t// Build export session format with accumulated messages\n1440\t\texportSession := map[string]interface{}{\n1441\t\t\t\"info\": map[string]interface{}{\n1442\t\t\t\t\"id\": s.ID,\n1443\t\t\t},\n1444\t\t\t\"messages\": s.messages,\n1445\t\t}\n1446\t\n1447\t\t// Ensure directory exists\n1448\t\tif err := os.MkdirAll(filepath.Dir(s.TranscriptPath), 0o755); err != nil {\n1449\t\t\ts.env.T.Fatalf(\"failed to create transcript dir: %v\", err)\n1450\t\t}\n1451\t\n1452\t\t// Write export JSON transcript\n1453\t\tdata, err := json.MarshalIndent(exportSession, \"\", \"  \")\n1454\t\tif err != nil {\n1455\t\t\ts.env.T.Fatalf(\"failed to marshal transcript: %v\", err)\n1456\t\t}\n1457\t\tif err := os.WriteFile(s.TranscriptPath, data, 0o644); err != nil {\n1458\t\t\ts.env.T.Fatalf(\"failed to write transcript: %v\", err)\n1459\t\t}\n1460\t\n1461\t\treturn s.TranscriptPath\n1462\t}\n1463\t\n1464\t// SimulateOpenCodeSessionStart is a convenience method on TestEnv.\n1465\tfunc (env *TestEnv) SimulateOpenCodeSessionStart(sessionID, transcriptPath string) error {\n1466\t\tenv.T.Helper()\n1467\t\trunner := NewOpenCodeHookRunner(env.RepoDir, env.OpenCodeProjectDir, env.T)\n1468\t\treturn runner.SimulateOpenCodeSessionStart(sessionID, transcriptPath)\n1469\t}\n1470\t\n1471\t// SimulateOpenCodeTurnStart is a convenience method on TestEnv.\n1472\tfunc (env *TestEnv) SimulateOpenCodeTurnStart(sessionID, transcriptPath, prompt string) error {\n1473\t\tenv.T.Helper()\n1474\t\trunner := NewOpenCodeHookRunner(env.RepoDir, env.OpenCodeProjectDir, env.T)\n1475\t\treturn runner.SimulateOpenCodeTurnStart(sessionID, transcriptPath, prompt)\n1476\t}\n1477\t\n1478\t// SimulateOpenCodeTurnEnd is a convenience method on TestEnv.\n1479\tfunc (env *TestEnv) SimulateOpenCodeTurnEnd(sessionID, transcriptPath string) error {\n1480\t\tenv.T.Helper()\n1481\t\trunner := NewOpenCodeHookRunner(env.RepoDir, env.OpenCodeProjectDir, env.T)\n1482\t\treturn runner.SimulateOpenCodeTurnEnd(sessionID, transcriptPath)\n1483\t}\n1484\t\n1485\t// SimulateOpenCodeSessionEnd is a convenience method on TestEnv.\n1486\tfunc (env *TestEnv) SimulateOpenCodeSessionEnd(sessionID, transcriptPath string) error {\n1487\t\tenv.T.Helper()\n1488\t\trunner := NewOpenCodeHookRunner(env.RepoDir, env.OpenCodeProjectDir, env.T)\n1489\t\treturn runner.SimulateOpenCodeSessionEnd(sessionID, transcriptPath)\n1490\t}\n1491\t\n1492\t// CopyTranscriptToEntireTmp copies an OpenCode transcript to .entire/tmp/<sessionID>.json.\n1493\t// This simulates what `opencode export` does in production. Required for mid-turn commits\n1494\t// where PrepareTranscript calls fetchAndCacheExport, which in mock mode expects the file\n1495\t// to already exist at .entire/tmp/<sessionID>.json.\n1496\tfunc (env *TestEnv) CopyTranscriptToEntireTmp(sessionID, transcriptPath string) {\n1497\t\tenv.T.Helper()\n1498\t\n1499\t\tsrcData, err := os.ReadFile(transcriptPath)\n1500\t\tif err != nil {\n1501\t\t\tenv.T.Fatalf(\"CopyTranscriptToEntireTmp: failed to read transcript from %q: %v\", transcriptPath, err)\n1502\t\t}\n1503\t\tdestDir := filepath.Join(env.RepoDir, \".entire\", \"tmp\")\n1504\t\tif err := os.MkdirAll(destDir, 0o755); err != nil {\n1505\t\t\tenv.T.Fatalf(\"CopyTranscriptToEntireTmp: failed to create directory %q: %v\", destDir, err)\n1506\t\t}\n1507\t\tdestPath := filepath.Join(destDir, sessionID+\".json\")\n1508\t\tif err := os.WriteFile(destPath, srcData, 0o644); err != nil {\n1509\t\t\tenv.T.Fatalf(\"CopyTranscriptToEntireTmp: failed to write transcript to %q: %v\", destPath, err)\n1510\t\t}\n1511\t}\n1512\t"}]},"uuid":"c5bfb889-f8dc-428e-a78c-fc82fad26d46","timestamp":"2026-05-08T15:23:27.252Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/integration_test/hooks.go","content":"//go:build integration\n\npackage integration\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n\t\"github.com/entireio/cli/cmd/entire/cli/testutil\"\n)\n\n// HookRunner executes CLI hooks in the test environment.\ntype HookRunner struct {\n\tRepoDir          string\n\tClaudeProjectDir string\n\tT                interface {\n\t\tHelper()\n\t\tFatalf(format string, args ...interface{})\n\t\tLogf(format string, args ...interface{})\n\t}\n}\n\n// NewHookRunner creates a new hook runner for the given repo directory.\nfunc NewHookRunner(repoDir, claudeProjectDir string, t interface {\n\tHelper()\n\tFatalf(format string, args ...interface{})\n\tLogf(format string, args ...interface{})\n}) *HookRunner {\n\treturn &HookRunner{\n\t\tRepoDir:          repoDir,\n\t\tClaudeProjectDir: claudeProjectDir,\n\t\tT:                t,\n\t}\n}\n\n// HookResponse represents the JSON response from Claude Code hooks.\ntype HookResponse struct {\n\tContinue   bool   `json:\"continue\"`\n\tStopReason string `json:\"stopReason,omitempty\"`\n}\n\n// SimulateUserPromptSubmit simulates the UserPromptSubmit hook.\n// This captures pre-prompt state (untracked files).\nfunc (r *HookRunner) SimulateUserPromptSubmit(sessionID string) error {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": \"\", // Not used for user-prompt-submit\n\t}\n\n\treturn r.runHookWithInput(\"user-prompt-submit\", input)\n}\n\n// SimulateUserPromptSubmitWithPrompt simulates the UserPromptSubmit hook\n// with an explicit user prompt. The prompt is passed to the lifecycle handler\n// and appended to the filesystem prompt.txt.\nfunc (r *HookRunner) SimulateUserPromptSubmitWithPrompt(sessionID, prompt string) error {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": \"\",\n\t\t\"prompt\":          prompt,\n\t}\n\n\treturn r.runHookWithInput(\"user-prompt-submit\", input)\n}\n\n// SimulateUserPromptSubmitWithTranscriptPath simulates the UserPromptSubmit hook\n// with an explicit transcript path. This is needed for mid-session commit detection\n// which reads the live transcript to detect ongoing sessions.\nfunc (r *HookRunner) SimulateUserPromptSubmitWithTranscriptPath(sessionID, transcriptPath string) error {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": transcriptPath,\n\t}\n\n\treturn r.runHookWithInput(\"user-prompt-submit\", input)\n}\n\n// SimulateUserPromptSubmitWithPromptAndTranscriptPath simulates the UserPromptSubmit\n// hook with both an explicit prompt and transcript path. This combines the behavior\n// of SimulateUserPromptSubmitWithPrompt and SimulateUserPromptSubmitWithTranscriptPath.\nfunc (r *HookRunner) SimulateUserPromptSubmitWithPromptAndTranscriptPath(sessionID, prompt, transcriptPath string) error {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": transcriptPath,\n\t\t\"prompt\":          prompt,\n\t}\n\n\treturn r.runHookWithInput(\"user-prompt-submit\", input)\n}\n\n// SimulateUserPromptSubmitWithResponse simulates the UserPromptSubmit hook\n// and returns the parsed hook response (for testing blocking behavior).\nfunc (r *HookRunner) SimulateUserPromptSubmitWithResponse(sessionID string) (*HookResponse, error) {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": \"\", // Not used for user-prompt-submit\n\t}\n\n\tinputJSON, err := json.Marshal(input)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to marshal hook input: %w\", err)\n\t}\n\n\toutput := r.runHookWithOutput(\"user-prompt-submit\", inputJSON)\n\n\t// If hook failed with an error, return the error\n\tif output.Err != nil {\n\t\treturn nil, fmt.Errorf(\"hook failed: %w\\nStderr: %s\\nStdout: %s\",\n\t\t\toutput.Err, output.Stderr, output.Stdout)\n\t}\n\n\t// Parse JSON response from stdout\n\tvar resp HookResponse\n\tif len(output.Stdout) > 0 {\n\t\tif err := json.Unmarshal(output.Stdout, &resp); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to parse hook response: %w\\nStdout: %s\",\n\t\t\t\terr, output.Stdout)\n\t\t}\n\t}\n\n\treturn &resp, nil\n}\n\n// SimulateStop simulates the Stop hook with session transcript info.\nfunc (r *HookRunner) SimulateStop(sessionID, transcriptPath string) error {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": transcriptPath,\n\t}\n\n\treturn r.runHookWithInput(\"stop\", input)\n}\n\n// SimulateSessionEnd simulates the Claude Code session-end hook.\n// This transitions a session from IDLE (or ACTIVE) to ENDED phase.\nfunc (r *HookRunner) SimulateSessionEnd(sessionID string) error {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": \"\",\n\t}\n\n\treturn r.runHookWithInput(\"session-end\", input)\n}\n\n// PreTaskInput contains the input for PreToolUse[Task] hook.\ntype PreTaskInput struct {\n\tSessionID      string\n\tTranscriptPath string\n\tToolUseID      string\n\tSubagentType   string // Optional: type of subagent (e.g., \"dev\", \"reviewer\")\n\tDescription    string // Optional: task description\n}\n\n// SimulatePreTask simulates the PreToolUse[Task] hook.\nfunc (r *HookRunner) SimulatePreTask(sessionID, transcriptPath, toolUseID string) error {\n\tr.T.Helper()\n\n\treturn r.SimulatePreTaskWithInput(PreTaskInput{\n\t\tSessionID:      sessionID,\n\t\tTranscriptPath: transcriptPath,\n\t\tToolUseID:      toolUseID,\n\t})\n}\n\n// SimulatePreTaskWithInput simulates the PreToolUse[Task] hook with full input.\nfunc (r *HookRunner) SimulatePreTaskWithInput(input PreTaskInput) error {\n\tr.T.Helper()\n\n\thookInput := map[string]interface{}{\n\t\t\"session_id\":      input.SessionID,\n\t\t\"transcript_path\": input.TranscriptPath,\n\t\t\"tool_use_id\":     input.ToolUseID,\n\t\t\"tool_input\": map[string]string{\n\t\t\t\"subagent_type\": input.SubagentType,\n\t\t\t\"description\":   input.Description,\n\t\t},\n\t}\n\n\treturn r.runHookWithInput(\"pre-task\", hookInput)\n}\n\n// PostTaskInput contains the input for PostToolUse[Task] hook.\ntype PostTaskInput struct {\n\tSessionID      string\n\tTranscriptPath string\n\tToolUseID      string\n\tAgentID        string\n}\n\n// SimulatePostTask simulates the PostToolUse[Task] hook.\nfunc (r *HookRunner) SimulatePostTask(input PostTaskInput) error {\n\tr.T.Helper()\n\n\thookInput := map[string]interface{}{\n\t\t\"session_id\":      input.SessionID,\n\t\t\"transcript_path\": input.TranscriptPath,\n\t\t\"tool_use_id\":     input.ToolUseID,\n\t\t\"tool_input\":      map[string]string{},\n\t\t\"tool_response\": map[string]string{\n\t\t\t\"agentId\": input.AgentID,\n\t\t},\n\t}\n\n\treturn r.runHookWithInput(\"post-task\", hookInput)\n}\n\nfunc (r *HookRunner) runHookWithInput(flag string, input interface{}) error {\n\tr.T.Helper()\n\n\tinputJSON, err := json.Marshal(input)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to marshal hook input: %w\", err)\n\t}\n\n\treturn r.runHookInRepoDir(flag, inputJSON)\n}\n\nfunc (r *HookRunner) runHookInRepoDir(hookName string, inputJSON []byte) error {\n\treturn r.runHookInRepoDirWithExtraEnv(hookName, inputJSON, nil)\n}\n\n// runHookInRepoDirWithExtraEnv is like runHookInRepoDir but appends additional\n// env vars to the subprocess environment. Used by review-env adoption tests that\n// need ENTIRE_REVIEW_* vars present in the hook child process.\nfunc (r *HookRunner) runHookInRepoDirWithExtraEnv(hookName string, inputJSON []byte, extraEnv []string) error {\n\t// Run using the shared test binary\n\t// Command structure: entire hooks claude-code <hook-name>\n\tcmd := exec.Command(getTestBinary(), \"hooks\", \"claude-code\", hookName)\n\tcmd.Dir = r.RepoDir\n\tcmd.Stdin = bytes.NewReader(inputJSON)\n\tcmd.Env = append(testutil.GitIsolatedEnv(),\n\t\t\"ENTIRE_TEST_CLAUDE_PROJECT_DIR=\"+r.ClaudeProjectDir,\n\t)\n\tcmd.Env = append(cmd.Env, extraEnv...)\n\n\toutput, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"hook %s failed: %w\\nInput: %s\\nOutput: %s\",\n\t\t\thookName, err, inputJSON, output)\n\t}\n\n\tr.T.Logf(\"Hook %s output: %s\", hookName, output)\n\treturn nil\n}\n\n// SimulateUserPromptSubmitWithReviewEnvVars simulates the UserPromptSubmit\n// hook with ENTIRE_REVIEW_* env vars set on the subprocess, as `entire review`\n// would set them on the spawned agent process. The hook child process inherits\n// these vars, triggering env-based review adoption in the lifecycle handler.\nfunc (r *HookRunner) SimulateUserPromptSubmitWithReviewEnvVars(sessionID, prompt string, extraEnv []string) error {\n\tr.T.Helper()\n\n\tinput := map[string]string{\n\t\t\"session_id\":      sessionID,\n\t\t\"transcript_path\": \"\",\n\t\t\"prompt\":          prompt,\n\t}\n\n\tinputJSON, err := json.Marshal(input)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to marshal hook input: %w\", err)\n\t}\n\n\treturn r.runHookInRepoDirWithExtraEnv(\"user-prompt-submit\", inputJSON, extraEnv)\n}\n\n// Session represents a simulated Claude Code session.\ntype Session struct {\n\tID                string // Raw model session ID (e.g., \"test-session-1\")\n\tTranscriptPath    string\n\tTranscriptBuilder *TranscriptBuilder\n\tenv               *TestEnv\n}\n\n// FileChange represents a file modification in a session.\ntype FileChange struct {\n\tPath    string\n\tContent string\n}\n\n// NewSession creates a new simulated session.\nfunc (env *TestEnv) NewSession() *Session {\n\tenv.T.Helper()\n\n\tenv.SessionCounter++\n\tsessionID := fmt.Sprintf(\"test-session-%d\", env.SessionCounter)\n\n\ttranscriptPath := filepath.Join(env.RepoDir, \".entire\", \"tmp\", sessionID+\".jsonl\")\n\n\treturn &Session{\n\t\tID:                sessionID,\n\t\tTranscriptPath:    transcriptPath,\n\t\tTranscriptBuilder: NewTranscriptBuilder(),\n\t\tenv:               env,\n\t}\n}\n\n// CreateTranscript builds and writes a transcript for the session.\nfunc (s *Session) CreateTranscript(prompt string, changes []FileChange) string {\n\ts.TranscriptBuilder.AddUserMessage(prompt)\n\ts.TranscriptBuilder.AddAssistantMessage(\"I'll help you with that.\")\n\n\tfor _, change := range changes {\n\t\ttoolID := s.TranscriptBuilder.AddToolUse(\"mcp__acp__Write\", change.Path, change.Content)\n\t\ts.TranscriptBuilder.AddToolResult(toolID)\n\t}\n\n\ts.TranscriptBuilder.AddAssistantMessage(\"Done!\")\n\n\tif err := s.TranscriptBuilder.WriteToFile(s.TranscriptPath); err != nil {\n\t\ts.env.T.Fatalf(\"failed to write transcript: %v\", err)\n\t}\n\n\treturn s.TranscriptPath\n}\n\n// SimulateUserPromptSubmit is a convenience method on TestEnv.\nfunc (env *TestEnv) SimulateUserPromptSubmit(ses