53\t\n54\t// ParseHookEvent translates a Claude Code hook into a normalized lifecycle Event.\n55\t// Returns nil if the hook has no lifecycle significance.\n56\tfunc (c *ClaudeCodeAgent) ParseHookEvent(_ context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n57\t\tswitch hookName {\n58\t\tcase HookNameSessionStart:\n59\t\t\treturn c.parseSessionStart(stdin)\n60\t\tcase HookNameUserPromptSubmit:\n61\t\t\treturn c.parseTurnStart(stdin)\n62\t\tcase HookNameStop:\n63\t\t\treturn c.parseTurnEnd(stdin)\n64\t\tcase HookNameSessionEnd:\n65\t\t\treturn c.parseSessionEnd(stdin)\n66\t\tcase HookNamePreTask:\n67\t\t\treturn c.parseSubagentStart(stdin)\n68\t\tcase HookNamePostTask:\n69\t\t\treturn c.parseSubagentEnd(stdin)\n70\t\tcase HookNamePostTodo:\n71\t\t\t// PostTodo is Claude-specific; handled outside the generic dispatcher.\n72\t\t\treturn nil, nil //nolint:nilnil // nil event = no lifecycle action\n73\t\tdefault:\n74\t\t\treturn nil, nil //nolint:nilnil // Unknown hooks have no lifecycle action\n75\t\t}\n76\t}\n77\t\n78\t// ReadTranscript reads the raw JSONL transcript bytes for a session.\n79\tfunc (c *ClaudeCodeAgent) ReadTranscript(sessionRef string) ([]byte, error) {\n80\t\tdata, err := os.ReadFile(sessionRef) //nolint:gosec // Path comes from agent hook input\n81\t\tif err != nil {\n82\t\t\treturn nil, fmt.Errorf(\"failed to read transcript: %w\", err)\n83\t\t}\n84\t\treturn data, nil\n85\t}\n86\t\n87\t// PrepareTranscript waits for Claude Code's async transcript flush to complete.\n88\t// Claude writes a hook_progress sentinel entry after flushing all pending writes.\n89\tfunc (c *ClaudeCodeAgent) PrepareTranscript(ctx context.Context, sessionRef string) error {\n90\t\twaitForTranscriptFlush(ctx, sessionRef, time.Now())\n91\t\treturn nil\n92\t}\n93\t\n94\t// CalculateTokenUsage computes token usage from the transcript starting at the given line offset.\n95\tfunc (c *ClaudeCodeAgent) CalculateTokenUsage(transcriptData []byte, fromOffset int) (*agent.TokenUsage, error) {\n96\t\treturn c.CalculateTotalTokenUsage(transcriptData, fromOffset, \"\")\n97\t}\n98\t\n99\t// --- Internal hook parsing functions ---\n100\t\n101\tfunc (c *ClaudeCodeAgent) parseSessionStart(stdin io.Reader) (*agent.Event, error) {\n102\t\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n103\t\tif err != nil {\n104\t\t\treturn nil, err\n105\t\t}\n106\t\treturn &agent.Event{\n107\t\t\tType:       agent.SessionStart,\n108\t\t\tSessionID:  raw.SessionID,\n109\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n110\t\t\tModel:      raw.Model,\n111\t\t\tTimestamp:  time.Now(),\n112\t\t}, nil\n113\t}\n114\t\n115\tfunc (c *ClaudeCodeAgent) parseTurnStart(stdin io.Reader) (*agent.Event, error) {\n116\t\traw, err := agent.ReadAndParseHookInput[userPromptSubmitRaw](stdin)\n117\t\tif err != nil {\n118\t\t\treturn nil, err\n119\t\t}\n120\t\treturn &agent.Event{\n121\t\t\tType:       agent.TurnStart,\n122\t\t\tSessionID:  raw.SessionID,\n123\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n124\t\t\tPrompt:     raw.Prompt,\n125\t\t\tTimestamp:  time.Now(),\n126\t\t}, nil\n127\t}\n128\t\n129\tfunc (c *ClaudeCodeAgent) parseTurnEnd(stdin io.Reader) (*agent.Event, error) {\n130\t\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n131\t\tif err != nil {\n132\t\t\treturn nil, err\n133\t\t}\n134\t\treturn &agent.Event{\n135\t\t\tType:       agent.TurnEnd,\n136\t\t\tSessionID:  raw.SessionID,\n137\t\t\tSessionRef: c.resolveTranscriptPath(raw.TranscriptPath, raw.SessionID),\n138\t\t\tModel:      raw.Model,\n139\t\t\tTimestamp:  time.Now(),\n140\t\t}, nil\n141\t}\n142\t\n143\tfunc (c *ClaudeCodeAgent) parseSessionEnd(stdin io.Reader) (*agent.Event, error) {\n144\t\traw, err := agent.ReadAndParseHookInput[sessionInfoRaw](stdin)\n145\t\tif err != nil {\n146\t\t\treturn nil, err\n147\t\t}\n148\t\treturn &agent.Event{\n149\t\t\tType:       agent.SessionEnd,\n150\t\t\tSessionID:  ra