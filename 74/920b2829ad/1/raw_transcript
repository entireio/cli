output.\n548\tfunc (r *HookRunner) SimulateSessionStartWithOutput(sessionID string) HookOutput {\n549\t\tr.T.Helper()\n550\t\n551\t\tinput := map[string]string{\n552\t\t\t\"session_id\":      sessionID,\n553\t\t\t\"transcript_path\": \"\",\n554\t\t}\n555\t\n556\t\tinputJSON, err := json.Marshal(input)\n557\t\tif err != nil {\n558\t\t\treturn HookOutput{Err: fmt.Errorf(\"failed to marshal hook input: %w\", err)}\n559\t\t}\n560\t\n561\t\treturn r.runHookWithOutput(\"session-start\", inputJSON)\n562\t}\n563\t\n564\t// SimulateSessionStartWithOutput is a convenience method on TestEnv.\n565\tfunc (env *TestEnv) SimulateSessionStartWithOutput(sessionID string) HookOutput {\n566\t\tenv.T.Helper()\n567\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n568\t\treturn runner.SimulateSessionStartWithOutput(sessionID)\n569\t}\n570\t\n571\t// GetSessionState reads and returns the session state for the given session ID.\n572\tfunc (env *TestEnv) GetSessionState(sessionID string) (*strategy.SessionState, error) {\n573\t\tenv.T.Helper()\n574\t\n575\t\tstateFile := filepath.Join(env.RepoDir, \".git\", \"entire-sessions\", sessionID+\".json\")\n576\t\n577\t\tdata, err := os.ReadFile(stateFile)\n578\t\tif os.IsNotExist(err) {\n579\t\t\treturn nil, nil\n580\t\t}\n581\t\tif err != nil {\n582\t\t\treturn nil, fmt.Errorf(\"failed to read session state: %w\", err)\n583\t\t}\n584\t\n585\t\tvar state strategy.SessionState\n586\t\tif err := json.Unmarshal(data, &state); err != nil {\n587\t\t\treturn nil, fmt.Errorf(\"failed to parse session state: %w\", err)\n588\t\t}\n589\t\treturn &state, nil\n590\t}\n591\t\n592\t// WriteSessionState writes the session state for the given session ID.\n593\t// This is useful for tests that need to manipulate session state directly.\n594\tfunc (env *TestEnv) WriteSessionState(sessionID string, state *strategy.SessionState) error {\n595\t\tenv.T.Helper()\n596\t\n597\t\tstateDir := filepath.Join(env.RepoDir, \".git\", \"entire-sessions\")\n598\t\tif err := os.MkdirAll(stateDir, 0o755); err != nil {\n599\t\t\treturn fmt.Errorf(\"failed to create session state dir: %w\", err)\n600\t\t}\n601\t\n602\t\tstateFile := filepath.Join(stateDir, sessionID+\".json\")\n603\t\n604\t\tdata, err := json.MarshalIndent(state, \"\", \"  \")\n605\t\tif err != nil {\n606\t\t\treturn fmt.Errorf(\"failed to marshal session state: %w\", err)\n607\t\t}\n608\t\n609\t\tif err := os.WriteFile(stateFile, data, 0o644); err != nil {\n610\t\t\treturn fmt.Errorf(\"failed to write session state: %w\", err)\n611\t\t}\n612\t\treturn nil\n613\t}\n614\t\n615\t// GeminiHookRunner executes Gemini CLI hooks in the test environment.\n616\ttype GeminiHookRunner struct {\n617\t\tRepoDir          string\n618\t\tGeminiProjectDir string\n619\t\tT                interface {\n620\t\t\tHelper()\n621\t\t\tFatalf(format string, args ...interface{})\n622\t\t\tLogf(format string, args ...interface{})\n623\t\t}\n624\t}\n625\t\n626\t// NewGeminiHookRunner creates a new Gemini hook runner for the given repo directory.\n627\tfunc NewGeminiHookRunner(repoDir, geminiProjectDir string, t interface {\n628\t\tHelper()\n629\t\tFatalf(format string, args ...interface{})\n630\t\tLogf(format string, args ...interface{})\n631\t}) *GeminiHookRunner {\n632\t\treturn &GeminiHookRunner{\n633\t\t\tRepoDir:          repoDir,\n634\t\t\tGeminiProjectDir: geminiProjectDir,\n635\t\t\tT:                t,\n636\t\t}\n637\t}\n638\t\n639\t// runGeminiHookWithInput runs a Gemini hook with the given input.\n640\tfunc (r *GeminiHookRunner) runGeminiHookWithInput(hookName string, input interface{}) error {\n641\t\tr.T.Helper()\n642\t\n643\t\tinputJSON, err := json.Marshal(input)\n644\t\tif err != nil {\n645\t\t\treturn fmt.Errorf(\"failed to marshal hook input: %w\", err)\n646\t\t}\n647\t\n648\t\treturn r.runGeminiHookInRepoDir(hookName, inputJSON)\n649\t}\n650\t\n651\tfunc (r *GeminiHookRunner) runGeminiHookInRepoDir(hookName string, inputJSON []byte) error {\n652\t\t// Run using the shared test binary\n653\t\t// Command structure: entire hooks gemini <hook-name>\n654\t\tcmd := exec.Command(getTestBinary(), \"hooks\", \"gemini\", hookName)\n655\t\tcmd.Dir = r.RepoDir\n656\t\tcmd.Stdin = bytes.NewReader(inputJSON)\n657\t\tcmd.Env = append(testutil.GitIsolatedEnv(),\n658\t\t\t\"ENTIRE_TEST_GEMINI_PROJECT_DIR=\"+r.GeminiProjectDir,\n659\t\t)\n660\t\n661\t\toutput, err := cmd.CombinedOutput()\n662\t\tif err != nil {\n663\t\t\treturn fmt.Errorf(\"hook %s failed: %w\\nInput: %s\\nOutput: %s\",\n664\t\t\t\thookName, err, inputJSON, output)\n665\t\t}\n666\t\n667\t\tr.T.Logf(\"Gemini hook %s output: %s\", hookName, output)\n668\t\treturn nil\n669\t}\n670\t\n671\t// runGeminiHookWithOutput runs a Gemini hook and returns both stdout and stderr separately.\n672\tfunc (r *GeminiHookRunner) runGeminiHookWithOutput(hookName string, inputJSON []byte) HookOutput {\n673\t\tcmd := exec.Command(getTestBinary(), \"hooks\", \"gemini\", hookName)\n674\t\tcmd.Dir = r.RepoDir\n675\t\tcmd.Stdin = bytes.NewReader(inputJSON)\n676\t\tcmd.Env = append(testutil.GitIsolatedEnv(),\n677\t\t\t\"ENTIRE_TEST_GEMINI_PROJECT_DIR=\"+r.GeminiProjectDir,\n678\t\t)\n679\t\n680\t\tvar stdout, stderr bytes.Buffer\n681\t\tcmd.Stdout = &stdout\n682\t\tcmd.Stderr = &stderr\n683\t\n684\t\terr := cmd.Run()\n685\t\treturn HookOutput{\n686\t\t\tStdout: stdout.Bytes(),\n687\t\t\tStderr: stderr.Bytes(),\n688\t\t\tErr:    err,\n689\t\t}\n690\t}\n691\t\n692\t// SimulateGeminiBeforeAgent simulates the BeforeAgent hook for Gemini CLI.\n693\t// This is equivalent to Claude Code's UserPromptSubmit.\n694\tfunc (r *GeminiHookRunner) SimulateGeminiBeforeAgent(sessionID string) error {\n695\t\tr.T.Helper()\n696\t\n697\t\tinput := map[string]string{\n698\t\t\t\"session_id\":      sessionID,\n699\t\t\t\"transcript_path\": \"\",\n700\t\t\t\"cwd\":             r.RepoDir,\n701\t\t\t\"hook_event_name\": \"BeforeAgent\",\n702\t\t\t\"timestamp\":       \"2025-01-01T00:00:00Z\",\n703\t\t\t\"prompt\":          \"test prompt\",\n704\t\t}\n705\t\n706\t\treturn r.runGeminiHookWithInput(\"before-agent\", input)\n707\t}\n708\t\n709\t// SimulateGeminiBeforeAgentWithOutput simulates the BeforeAgent hook and returns the output.\n710\tfunc (r *GeminiHookRunner) SimulateGeminiBeforeAgentWithOutput(sessionID string) HookOutput {\n711\t\tr.T.Helper()\n712\t\n713\t\tinput := map[string]string{\n714\t\t\t\"session_id\":      sessionID,\n715\t\t\t\"transcript_path\": \"\",\n716\t\t\t\"cwd\":             r.RepoDir,\n717\t\t\t\"hook_event_name\": \"BeforeAgent\",\n718\t\t\t\"timestamp\":       \"2025-01-01T00:00:00Z\",\n719\t\t\t\"prompt\":          \"test prompt\",\n720\t\t}\n721\t\n722\t\tinputJSON, err := json.Marshal(input)\n723\t\tif err != nil {\n724\t\t\treturn HookOutput{Err: fmt.Errorf(\"failed to marshal hook input: %w\", err)}\n725\t\t}\n726\t\n727\t\treturn r.runGeminiHookWithOutput(\"before-agent\", inputJSON)\n728\t}\n729\t\n730\t// SimulateGeminiAfterAgent simulates the AfterAgent hook for Gemini CLI.\n731\t// This is the primary checkpoint creation hook, equivalent to Claude Code's Stop hook.\n732\tfunc (r *GeminiHookRunner) SimulateGeminiAfterAgent(sessionID, transcriptPath string) error {\n733\t\tr.T.Helper()\n734\t\n735\t\tinput := map[string]string{\n736\t\t\t\"session_id\":      sessionID,\n737\t\t\t\"transcript_path\": transcriptPath,\n738\t\t\t\"cwd\":             r.RepoDir,\n739\t\t\t\"hook_event_name\": \"AfterAgent\",\n740\t\t\t\"timestamp\":       \"2025-01-01T00:00:00Z\",\n741\t\t}\n742\t\n743\t\treturn r.runGeminiHookWithInput(\"after-agent\", input)\n744\t}\n745\t\n746\t// SimulateGeminiSessionEnd simulates the SessionEnd hook for Gemini CLI.\n747\t// This is a cleanup/fallback hook that fires on explicit exit.\n748\tfunc (r *GeminiHookRunner) SimulateGeminiSessionEnd(sessionID, transcriptPath string) error {\n749\t\tr.T.Helper()\n750\t\n751\t\tinput := map[string]string{\n752\t\t\t\"session_id\":      sessionID,\n753\t\t\t\"transcript_path\": transcriptPath,\n754\t\t\t\"cwd\":             r.RepoDir,\n755\t\t\t\"hook_event_name\": \"SessionEnd\",\n756\t\t\t\"timestamp\":       \"2025-01-01T00:00:00Z\",\n757\t\t\t\"reason\":          \"exit\",\n758\t\t}\n759\t\n760\t\treturn r.runGeminiHookWithInput(\"session-end\", input)\n761\t}\n762\t\n763\t// GeminiSession represents a simulated Gemini CLI session.\n764\ttype GeminiSession struct {\n765\t\tID             string // Raw model session ID (e.g., \"gemini-session-1\")\n766\t\tTranscriptPath string\n767\t\tenv            *TestEnv\n768\t}\n769\t\n770\t// NewGeminiSession creates a new simulated Gemini session.\n771\tfunc (env *TestEnv) NewGeminiSession() *GeminiSession {\n772\t\tenv.T.Helper()\n773\t\n774\t\tenv.SessionCounter++\n775\t\tsessionID := fmt.Sprintf(\"gemini-session-%d\", env.SessionCounter)\n776\t\ttranscriptPath := filepath.Join(env.RepoDir, \".entire\", \"tmp\", sessionID+\".json\")\n777\t\n778\t\treturn &GeminiSession{\n779\t\t\tID:             sessionID,\n780\t\t\tTranscriptPath: transcriptPath,\n781\t\t\tenv:            env,\n782\t\t}\n783\t}\n784\t\n785\t// CreateGeminiTranscript creates a Gemini JSON transcript file for the session.\n786\tfunc (s *GeminiSession) CreateGeminiTranscript(prompt string, changes []FileChange) string {\n787\t\t// Build Gemini-format transcript (JSON, not JSONL)\n788\t\tmessages := []map[string]interface{}{\n789\t\t\t{\n790\t\t\t\t\"type\":    \"user\",\n791\t\t\t\t\"content\": prompt,\n792\t\t\t},\n793\t\t\t{\n794\t\t\t\t\"type\":    \"assistant\",\n795\t\t\t\t\"content\": \"I'll help you with that.\",\n796\t\t\t},\n797\t\t}\n798\t\n799\t\tfor _, change := range changes {\n800\t\t\tmessages = append(messages, map[string]interface{}{\n801\t\t\t\t\"type\": \"tool_use\",\n802\t\t\t\t\"name\": \"write_file\",\n803\t\t\t\t\"input\": map[string]string{\n804\t\t\t\t\t\"path\":    change.Path,\n805\t\t\t\t\t\"content\": change.Content,\n806\t\t\t\t},\n807\t\t\t})\n808\t\t\tmessages = append(messages, map[string]interface{}{\n809\t\t\t\t\"type\":   \"tool_result\",\n810\t\t\t\t\"output\": \"File written successfully\",\n811\t\t\t})\n812\t\t}\n813\t\n814\t\tmessages = append(messages, map[string]interface{}{\n815\t\t\t\"type\":    \"assistant\",\n816\t\t\t\"content\": \"Done!\",\n817\t\t})\n818\t\n819\t\ttranscript := map[string]interface{}{\n820\t\t\t\"sessionId\": s.ID,\n821\t\t\t\"messages\":  messages,\n822\t\t}\n823\t\n824\t\t// Ensure directory exists\n825\t\tif err := os.MkdirAll(filepath.Dir(s.TranscriptPath), 0o755); err != nil {\n826\t\t\ts.env.T.Fatalf(\"failed to create transcript dir: %v\", err)\n827\t\t}\n828\t\n829\t\t// Write transcript\n830\t\tdata, err := json.MarshalIndent(transcript, \"\", \"  \")\n831\t\tif err != nil {\n832\t\t\ts.env.T.Fatalf(\"failed to marshal transcript: %v\", err)\n833\t\t}\n834\t\tif err := os.WriteFile(s.TranscriptPath, data, 0o644); err != nil {\n835\t\t\ts.env.T.Fatalf(\"failed to write transcript: %v\", err)\n836\t\t}\n837\t\n838\t\treturn s.TranscriptPath\n839\t}\n840\t\n841\t// SimulateGeminiBeforeAgent is a convenience method on TestEnv.\n842\tfunc (env *TestEnv) SimulateGeminiBeforeAgent(sessionID string) error {\n843\t\tenv.T.Helper()\n844\t\trunner := NewGeminiHookRunner(env.RepoDir, env.GeminiProjectDir, env.T)\n845\t\treturn runner.SimulateGeminiBeforeAgent(sessionID)\n846\t}\n847\t\n848\t// SimulateGeminiBeforeAgentWithOutput is a convenience method on TestEnv.\n849\tfunc (env *TestEnv) SimulateGeminiBeforeAgentWithOutput(sessionID string) HookOutput {\n850\t\tenv.T.Helper()\n851\t\trunner := NewGeminiHookRunner(env.RepoDir, env.GeminiProjectDir, env.T)\n852\t\treturn runner.SimulateGeminiBeforeAgentWithOutput(sessionID)\n853\t}\n854\t\n855\t// SimulateGeminiAfterAgent is a convenience method on TestEnv.\n856\tfunc (env *TestEnv) SimulateGeminiAfterAgent(sessionID, transcriptPath string) error {\n857\t\tenv.T.Helper()\n858\t\trunner := NewGeminiHookRunner(env.RepoDir, env.GeminiProjectDir, env.T)\n859\t\treturn runner.SimulateGeminiAfterAgent(sessio