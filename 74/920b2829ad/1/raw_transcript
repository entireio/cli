ng.Debug(logCtx, \"transcript file is stale, skipping sentinel wait\",\n293\t\t\t\tslog.Duration(\"file_age\", fileAge),\n294\t\t\t)\n295\t\t\treturn\n296\t\t}\n297\t\n298\t\tdeadline := time.Now().Add(maxWait)\n299\t\tfor time.Now().Before(deadline) {\n300\t\t\tif checkStopSentinel(transcriptPath, tailBytes, hookStartTime, maxSkew) {\n301\t\t\t\tlogging.Debug(logCtx, \"transcript flush sentinel found\",\n302\t\t\t\t\tslog.Duration(\"wait\", time.Since(hookStartTime)),\n303\t\t\t\t)\n304\t\t\t\treturn\n305\t\t\t}\n306\t\t\ttime.Sleep(pollInterval)\n307\t\t}\n308\t\tlogging.Warn(logCtx, \"transcript flush sentinel not found within timeout, proceeding\",\n309\t\t\tslog.Duration(\"timeout\", maxWait),\n310\t\t)\n311\t}\n312\t\n313\t// checkStopSentinel reads the tail of the transcript file and looks for the sentinel.\n314\tfunc checkStopSentinel(path string, tailBytes int64, hookStartTime time.Time, maxSkew time.Duration) bool {\n315\t\tf, err := os.Open(path) //nolint:gosec // path comes from agent hook input\n316\t\tif err != nil {\n317\t\t\treturn false\n318\t\t}\n319\t\tdefer f.Close()\n320\t\n321\t\tinfo, err := f.Stat()\n322\t\tif err != nil {\n323\t\t\treturn false\n324\t\t}\n325\t\toffset := info.Size() - tailBytes\n326\t\tif offset < 0 {\n327\t\t\toffset = 0\n328\t\t}\n329\t\tbuf := make([]byte, info.Size()-offset)\n330\t\tif _, err := f.ReadAt(buf, offset); err != nil {\n331\t\t\treturn false\n332\t\t}\n333\t\n334\t\tlines := strings.Split(string(buf), \"\\n\")\n335\t\tfor _, line := range lines {\n336\t\t\tline = strings.TrimSpace(line)\n337\t\t\tif line == \"\" || !strings.Contains(line, stopHookSentinel) {\n338\t\t\t\tcontinue\n339\t\t\t}\n340\t\n341\t\t\tvar entry struct {\n342\t\t\t\tTimestamp string `json:\"timestamp\"`\n343\t\t\t}\n344\t\t\tif json.Unmarshal([]byte(line), &entry) != nil || entry.Timestamp == \"\" {\n345\t\t\t\tcontinue\n346\t\t\t}\n347\t\t\tts, err := time.Parse(time.RFC3339Nano, entry.Timestamp)\n348\t\t\tif err != nil {\n349\t\t\t\tt