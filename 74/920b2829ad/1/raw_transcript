t\t// JSON with extra fields - should ignore them\n477\t\tinput := `{\"session_id\": \"test\", \"transcript_path\": \"/t\", \"extra_field\": \"ignored\", \"another\": 123}`\n478\t\n479\t\tresult, err := agent.ReadAndParseHookInput[sessionInfoRaw](strings.NewReader(input))\n480\t\n481\t\tif err != nil {\n482\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n483\t\t}\n484\t\tif result.SessionID != \"test\" {\n485\t\t\tt.Errorf(\"expected session_id 'test', got %q\", result.SessionID)\n486\t\t}\n487\t}\n488\t\n489\tfunc TestWaitForTranscriptFlush_StaleFile_SkipsWait(t *testing.T) {\n490\t\tt.Parallel()\n491\t\n492\t\t// Create a transcript file and backdate its mtime to make it \"stale\"\n493\t\ttranscriptFile := filepath.Join(t.TempDir(), \"transcript.jsonl\")\n494\t\tif err := os.WriteFile(transcriptFile, []byte(`{\"type\":\"human\"}`+\"\\n\"), 0o644); err != nil {\n495\t\t\tt.Fatalf(\"failed to write transcript: %v\", err)\n496\t\t}\n497\t\tstaleTime := time.Now().Add(-10 * time.Minute)\n498\t\tif err := os.Chtimes(transcriptFile, staleTime, staleTime); err != nil {\n499\t\t\tt.Fatalf(\"failed to set mtime: %v\", err)\n500\t\t}\n501\t\n502\t\t// waitForTranscriptFlush should return almost instantly for stale files\n503\t\t// (not wait the full 3 seconds)\n504\t\tstart := time.Now()\n505\t\twaitForTranscriptFlush(context.Background(), transcriptFile, time.Now())\n506\t\telapsed := time.Since(start)\n507\t\n508\t\tif elapsed > 500*time.Millisecond {\n509\t\t\tt.Errorf(\"expected fast return for stale transcript, but took %v\", elapsed)\n510\t\t}\n511\t}\n512\t\n513\tfunc TestWaitForTranscriptFlush_RecentFile_WaitsForSentinel(t *testing.T) {\n514\t\tt.Parallel()\n515\t\n516\t\t// Create a transcript file with recent mtime (no sentinel present)\n517\t\ttranscriptFile := filepath.Join(t.TempDir(), \"transcript.jsonl\")\n518\t\tif err := os.WriteFile(transcriptFile, []byte(`{\"type\":\"human\"}`+\"\\n\"), 0o644); err != nil {\n519\t\t\tt.Fatalf(\"failed to write transcript: %v\", err)\n520\t\t}\n521\t\t// File was just created, so mtime is now — should NOT skip the wait\n522\t\n523\t\tstart := time.Now()\n524\t\twaitForTranscriptFlush(context.Background(), transcriptFile, time.Now())\n525\t\telapsed := time.Since(start)\n526\t\n527\t\t// Should wait close to maxWait (3s) since no sentinel will be found\n528\t\tif elapsed < 2*time.Second {\n529\t\t\tt.Errorf(\"expected to wait ~3s for recent file without sentinel, but only took %v\", elapsed)\n530\t\t}\n531\t}\n532\t\n533\tfunc TestWaitForTranscriptFlush_NonexistentFile_ReturnsImmediately(t *testing.T) {\n534\t\tt.Parallel()\n535\t\n536\t\t// File doesn't exist — os.Stat fails, return immediately (nothing to poll).\n537\t\tstart := time.Now()\n538\t\twaitForTranscriptFlush(context.Background(), \"/nonexistent/transcript.jsonl\", time.Now())\n539\t\telapsed := time.Since(start)\n540\t\n541\t\tif elapsed > 500*time.Millisecond {\n542\t\t\tt.Errorf(\"expected immediate return for nonexistent file, but took %v\", elapsed)\n543\t\t}\n544\t}\n545\t\n546\tfunc TestFindTranscriptByID(t *testing.T) {\n547\t\tt.Parallel()\n548\t\n549\t\tbase := t.TempDir()\n550\t\t// projects/<encoded-A>/<id>.jsonl is the actual stored location\n551\t\tstoredDir := filepath.Join(base, \"-Users-foo-Development-repo\")\n552\t\twrongDir := filepath.Join(base, \"-Users-foo-Development-repo--claude-worktrees-feature\")\n553\t\tif err := os.MkdirAll(storedDir, 0o755); err != nil {\n554\t\t\tt.Fatalf(\"mkdir stored: %v\", err)\n555\t\t}\n556\t\tif err := os.MkdirAll(wrongDir, 0o755); err != nil {\n557\t\t\tt.Fatalf(\"mkdir wrong: %v\", err)\n558\t\t}\n559\t\tsessionID := \"abc-123-def\"\n560\t\ttranscript := filepath.Join(storedDir, sessionID+\".jsonl\")\n561\t\tif err := os.WriteFile(transcript, []byte(`{\"type\":\"human\"}`+\"\\n\"), 0o600); err != nil {\n562\t\t\tt.Fatalf(\"write transcript: %v\", err)\n563\t\t}\n564\t\n565\t\tgot := findTranscriptByID(base, sessionID)\n566\t\tif got != transcript {\n567\t\t\tt.Errorf(\"findTranscriptByID = %q, want %q\", got, transcript)\n568\t\t}\n569\t}\n570\t\n571\tfunc TestFindTranscriptByID_NoMatch(t *testing.T) {\n572\t\tt.Parallel()\n573\t\n574\t\tbase := t.TempDir()\n575\t\tif err := os.MkdirAll(filepath.Join(base, \"some-project\"), 0o755); err != nil {\n576\t\t\tt.Fatalf(\"mkdir: %v\", err)\n577\t\t}\n578\t\tif got := findTranscriptByID(base, \"missing-id\"); got != \"\" {\n579\t\t\tt.Errorf(\"expected empty result for missing id, got %q\", got)\n580\t\t}\n581\t}\n582\t\n583\tfunc TestFindTranscriptByID_NonexistentBase(t *testing.T) {\n584\t\tt.Parallel()\n585\t\n586\t\tif got := findTranscriptByID(\"/definitely/not/a/real/path\", \"anything\"); got != \"\" {\n587\t\t\tt.Errorf(\"expected empty result for nonexistent base dir, got %q\", got)\n588\t\t}\n589\t}\n590\t\n591\tfunc TestResolveTranscriptPath_PassthroughWhenExists(t *testing.T) {\n592\t\tt.Parallel()\n593\t\n594\t\ttranscript := filepath.Join(t.TempDir(), \"real.jsonl\")\n595\t\tif err := os.WriteFile(transcript, []byte(\"{}\\n\"), 0o600); err != nil {\n596\t\t\tt.Fatalf(\"write: %v\", err)\n597\t\t}\n598\t\tag := &ClaudeCodeAgent{}\n599\t\tgot := ag.resolveTranscriptPath(transcript, \"any-session-id\")\n600\t\tif got != transcript {\n601\t\t\tt.Errorf(\"resolveTranscriptPath returned %q, want passthrough %q\", got, transcript)\n602\t\t}\n603\t}\n604\t\n605\tfunc TestResolveTranscriptPath_EmptyInputs(t *testing.T) {\n606\t\tt.Parallel()\n607\t\n608\t\tag := &ClaudeCodeAgent{}\n609\t\tif got := ag.resolveTranscriptPath(\"\", \"id\"); got != \"\" {\n610\t\t\tt.Errorf(\"empty sessionRef should pass through; got %q\", got)\n611\t\t}\n612\t\tif got := ag.resolveTranscriptPath(\"/some/path\", \"\"); got != \"/some/path\" {\n613\t\t\tt.Errorf(\"empty sessionID should pass through; got %q\", got)\n614\t\t}\n615\t}\n616\t\n617\t// TestResolveTranscriptPath_WorktreeFallback simulates the Claude Code worktree\n618\t// bug: the agent reports a transcript_path under a \"--claude-worktrees-<branch>\"\n619\t// project dir that doesn't exist, while the actual transcript was written under\n620\t// the parent repo's project dir. The resolver should find the real file by\n621\t// scanning the projects base dir for the session ID.\n622\tfunc TestResolveTranscriptPath_WorktreeFallback(t *testing.T) {\n623\t\t// Cannot t.Parallel() — uses t.Setenv on HOME (process-global).\n624\t\ttmpHome := t.TempDir()\n625\t\tt.Setenv(\"HOME\", tmpHome)\n626\t\n627\t\tbase := filepath.Join(tmpHome, \".claude\", \"projects\")\n628\t\tparentDir := filepath.Join(base, \"-Users-foo-Development-repo\")\n629\t\tif err := os.MkdirAll(parentDir, 0o755); err != nil {\n630\t\t\tt.Fatalf(\"mkdir parent project: %v\", err)\n631\t\t}\n632\t\tsessionID := \"wt-session-uuid\"\n633\t\trealPath := filepath.Join(parentDir, sessionID+\".jsonl\")\n634\t\tif err := os.WriteFile(realPath, []byte(\"{}\\n\"), 0o600); err != nil {\n635\t\t\tt.Fatalf(\"write transcript: %v\", err)\n636\t\t}\n637\t\n638\t\t// Reported path encodes the worktree CWD — does not exist on disk.\n639\t\treported := filepath.Join(base, \"-Users-foo-Development-repo--claude-worktrees-feature\", sessionID+\".jsonl\")\n640\t\n641\t\tag := &ClaudeCodeAgent{}\n642\t\tgot := ag.resolveTranscriptPath(reported, sessionID)\n643\t\tif got != realPath {\n644\t\t\tt.Errorf(\"resolveTranscriptPath = %q, want %q (real location)\", got, realPath)\n645\t\t}\n646\t}\n647\t\n648\t// TestResolveTranscriptPath_OutsideBaseDir verifies the resolver does not scan\n649\t// when the reported path is outside the Claude projects base dir — scanning\n650\t// elsewhere couldn't produce a more correct answer and just adds I/O.\n651\tfunc TestResolveTranscriptPath_OutsideBaseDir(t *testing.T) {\n652\t\t// Cannot t.Parallel() — uses t.Setenv on HOME.\n653\t\ttmpHome := t.TempDir()\n654\t\tt.Setenv(\"HOME\", tmpHome)\n655\t\n656\t\t// A real transcript exists under the projects base, but the reported path\n657\t\t// is somewhere else entirely. Resolver should not redirect.\n658\t\tbase := filepath.Join(tmpHome, \".claude\", \"projects\")\n659\t\tdir := filepath.Join(base, \"some-project\")\n660\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n661\t\t\tt.Fatalf(\"mkdir: %v\", err)\n662\t\t}\n663\t\tsessionID := \"outside-session\"\n664\t\tif err := os.WriteFile(filepath.Join(dir, sessionID+\".jsonl\"), []byte(\"{}\\n\"), 0o600); err != nil {\n665\t\t\tt.Fatalf(\"write transcript: %v\", err)\n666\t\t}\n667\t\n668\t\treported := filepath.Join(t.TempDir(), \"elsewhere\", sessionID+\".jsonl\") // not under base\n669\t\tag := &ClaudeCodeAgent{}\n670\t\tgot := ag.resolveTranscriptPath(reported, sessionID)\n671\t\tif got != reported {\n672\t\t\tt.Errorf(\"resolveTranscriptPath = %q, want passthrough %q (path outside base)\", got, reported)\n673\t\t}\n674\t}\n675\t\n676\t// TestResolveTranscriptPath_RejectsTraversalSessionID verifies that a session\n677\t// ID containing path separators is rejected before being used in filepath.Join.\n678\tfunc TestResolveTranscriptPath_RejectsTraversalSessionID(t *testing.T) {\n679\t\t// Cannot t.Parallel() — uses t.Setenv on HOME.\n680\t\ttmpHome := t.TempDir()\n681\t\tt.Setenv(\"HOME\", tmpHome)\n682\t\n683\t\tbase := filepath.Join(tmpHome, \".claude\", \"projects\", \"proj\")\n684\t\tif err := os.MkdirAll(base, 0o755); err != nil {\n685\t\t\tt.Fatalf(\"mkdir: %v\", err)\n686\t\t}\n687\t\t// A file with a traversal-shaped name exists; the resolver must NOT match it.\n688\t\ttraversalID := \"../../etc/passwd\"\n689\t\treported := filepath.Join(tmpHome, \".claude\", \"projects\", \"proj\", \"missing.jsonl\")\n690\t\n691\t\tag := &ClaudeCodeAgent{}\n692\t\tgot := ag.resolveTranscriptPath(reported, traversalID)\n693\t\tif got != reported {\n694\t\t\tt.Errorf(\"resolveTranscriptPath = %q, want passthrough %q (traversal id rejected)\", got, reported)\n695\t\t}\n696\t}\n697\t"}]},"uuid":"f5d5ac71-e08f-4ea9-9900-becc78d4bc95","timestamp":"2026-05-08T15:11:40.106Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/soph/Work/entire/devenv/cli_experiments/cmd/entire/cli/agent/claudecode/lifecycle_test.go","content":"package claudecode\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n\t\"github.com/stretchr/testify/require\"\n)\n\nfunc TestParseHookEvent_SessionStart(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"test-session-123\", \"transcript_path\": \"/tmp/transcript.jsonl\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameSessionStart, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Type != agent.SessionStart {\n\t\tt.Errorf(\"expected event type %v, got %v\", agent.SessionStart, event.Type)\n\t}\n\tif event.SessionID != \"test-session-123\" {\n\t\tt.Errorf(\"expected session_id 'test-session-123', got %q\", event.SessionID)\n\t}\n\tif event.SessionRef != \"/tmp/transcript.jsonl\" {\n\t\tt.Errorf(\"expected session_ref '/tmp/transcript.jsonl', got %q\", event.SessionRef)\n\t}\n\tif event.Timestamp.IsZero() {\n\t\tt.Error(\"expected non-zero timestamp\")\n\t}\n}\n\nfunc TestParseHookEvent_SessionStart_IncludesModel(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"model-session\", \"transcript_path\": \"/tmp/t.jsonl\", \"model\": \"claude-sonnet-4-20250514\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameSessionStart, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Type != agent.SessionStart {\n\t\tt.Errorf(\"expected SessionStart, got %v\", event.Type)\n\t}\n\tif event.Model != \"claude-sonnet-4-20250514\" {\n\t\tt.Errorf(\"expected model 'claude-sonnet-4-20250514', got %q\", event.Model)\n\t}\n}\n\nfunc TestParseHookEvent_SessionStart_EmptyModel(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"no-model-session\", \"transcript_path\": \"/tmp/t.jsonl\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameSessionStart, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Model != \"\" {\n\t\tt.Errorf(\"expected empty model, got %q\", event.Model)\n\t}\n}\n\nfunc TestParseHookEvent_TurnStart(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"sess-456\", \"transcript_path\": \"/tmp/t.jsonl\", \"prompt\": \"Hello world\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameUserPromptSubmit, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Type != agent.TurnStart {\n\t\tt.Errorf(\"expected event type %v, got %v\", agent.TurnStart, event.Type)\n\t}\n\tif event.SessionID != \"sess-456\" {\n\t\tt.Errorf(\"expected session_id 'sess-456', got %q\", event.SessionID)\n\t}\n\tif event.Prompt != \"Hello world\" {\n\t\tt.Errorf(\"expected prompt 'Hello world', got %q\", event.Prompt)\n\t}\n}\n\nfunc TestParseHookEvent_TurnEnd(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"sess-789\", \"transcript_path\": \"/tmp/stop.jsonl\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameStop, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Type != agent.TurnEnd {\n\t\tt.Errorf(\"expected event type %v, got %v\", agent.TurnEnd, event.Type)\n\t}\n\tif event.SessionID != \"sess-789\" {\n\t\tt.Errorf(\"expected session_id 'sess-789', got %q\", event.SessionID)\n\t}\n}\n\nfunc TestParseHookEvent_TurnEnd_IncludesModel(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"sess-stop-model\", \"transcript_path\": \"/tmp/stop.jsonl\", \"model\": \"claude-opus-4-6\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameStop, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Model != \"claude-opus-4-6\" {\n\t\tt.Errorf(\"expected model 'claude-opus-4-6', got %q\", event.Model)\n\t}\n}\n\nfunc TestParseHookEvent_SessionEnd(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"ending-session\", \"transcript_path\": \"/tmp/end.jsonl\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameSessionEnd, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Type != agent.SessionEnd {\n\t\tt.Errorf(\"expected event type %v, got %v\", agent.SessionEnd, event.Type)\n\t}\n\tif event.SessionID != \"ending-session\" {\n\t\tt.Errorf(\"expected session_id 'ending-session', got %q\", event.SessionID)\n\t}\n}\n\nfunc TestParseHookEvent_SessionEnd_IncludesModel(t *testing.T) {\n\tt.Parallel()\n\n\tag := &ClaudeCodeAgent{}\n\tinput := `{\"session_id\": \"end-model\", \"transcript_path\": \"/tmp/end.jsonl\", \"model\": \"claude-sonnet-4-20250514\"}`\n\n\tevent, err := ag.ParseHookEvent(context.Background(), HookNameSessionEnd, strings.NewReader(input))\n\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\trequire.NotNil(t, event, \"expected event, got nil\")\n\tif event.Model != \"claude-sonnet-4-20250514\" {\n\t\tt.Errorf(\"expected model 'claude-sonnet-4-20250514', got %q\", event.Model)\n\t}\n}\n\nfunc TestParseHookEvent_SubagentStart(t *testing.T) {\n\tt.Parallel