\"user-prompt-submit\", input)\n58\t}\n59\t\n60\t// SimulateUserPromptSubmitWithPrompt simulates the UserPromptSubmit hook\n61\t// with an explicit user prompt. The prompt is passed to the lifecycle handler\n62\t// and appended to the filesystem prompt.txt.\n63\tfunc (r *HookRunner) SimulateUserPromptSubmitWithPrompt(sessionID, prompt string) error {\n64\t\tr.T.Helper()\n65\t\n66\t\tinput := map[string]string{\n67\t\t\t\"session_id\":      sessionID,\n68\t\t\t\"transcript_path\": \"\",\n69\t\t\t\"prompt\":          prompt,\n70\t\t}\n71\t\n72\t\treturn r.runHookWithInput(\"user-prompt-submit\", input)\n73\t}\n74\t\n75\t// SimulateUserPromptSubmitWithTranscriptPath simulates the UserPromptSubmit hook\n76\t// with an explicit transcript path. This is needed for mid-session commit detection\n77\t// which reads the live transcript to detect ongoing sessions.\n78\tfunc (r *HookRunner) SimulateUserPromptSubmitWithTranscriptPath(sessionID, transcriptPath string) error {\n79\t\tr.T.Helper()\n80\t\n81\t\tinput := map[string]string{\n82\t\t\t\"session_id\":      sessionID,\n83\t\t\t\"transcript_path\": transcriptPath,\n84\t\t}\n85\t\n86\t\treturn r.runHookWithInput(\"user-prompt-submit\", input)\n87\t}\n88\t\n89\t// SimulateUserPromptSubmitWithPromptAndTranscriptPath simulates the UserPromptSubmit\n90\t// hook with both an explicit prompt and transcript path. This combines the behavior\n91\t// of SimulateUserPromptSubmitWithPrompt and SimulateUserPromptSubmitWithTranscriptPath.\n92\tfunc (r *HookRunner) SimulateUserPromptSubmitWithPromptAndTranscriptPath(sessionID, prompt, transcriptPath string) error {\n93\t\tr.T.Helper()\n94\t\n95\t\tinput := map[string]string{\n96\t\t\t\"session_id\":      sessionID,\n97\t\t\t\"transcript_path\": transcriptPath,\n98\t\t\t\"prompt\":          prompt,\n99\t\t}\n100\t\n101\t\treturn r.runHookWithInput(\"user-prompt-submit\", input)\n102\t}\n103\t\n104\t// SimulateUserPromptSubmitWithResponse simulates the UserPromptSubmit hook\n105\t// and returns the parsed hook response (for testing blocking behavior).\n106\tfunc (r *HookRunner) SimulateUserPromptSubmitWithResponse(sessionID string) (*HookResponse, error) {\n107\t\tr.T.Helper()\n108\t\n109\t\tinput := map[string]string{\n110\t\t\t\"session_id\":      sessionID,\n111\t\t\t\"transcript_path\": \"\", // Not used for user-prompt-submit\n112\t\t}\n113\t\n114\t\tinputJSON, err := json.Marshal(input)\n115\t\tif err != nil {\n116\t\t\treturn nil, fmt.Errorf(\"failed to marshal hook input: %w\", err)\n117\t\t}\n118\t\n119\t\toutput := r.runHookWithOutput(\"user-prompt-submit\", inputJSON)\n120\t\n121\t\t// If hook failed with an error, return the error\n122\t\tif output.Err != nil {\n123\t\t\treturn nil, fmt.Errorf(\"hook failed: %w\\nStderr: %s\\nStdout: %s\",\n124\t\t\t\toutput.Err, output.Stderr, output.Stdout)\n125\t\t}\n126\t\n127\t\t// Parse JSON response from stdout\n128\t\tvar resp HookResponse\n129\t\tif len(output.Stdout) > 0 {\n130\t\t\tif err := json.Unmarshal(output.Stdout, &resp); err != nil {\n131\t\t\t\treturn nil, fmt.Errorf(\"failed to parse hook response: %w\\nStdout: %s\",\n132\t\t\t\t\terr, output.Stdout)\n133\t\t\t}\n134\t\t}\n135\t\n136\t\treturn &resp, nil\n137\t}\n138\t\n139\t// SimulateStop simulates the Stop hook with session transcript info.\n140\tfunc (r *HookRunner) SimulateStop(sessionID, transcriptPath string) error {\n141\t\tr.T.Helper()\n142\t\n143\t\tinput := map[string]string{\n144\t\t\t\"session_id\":      sessionID,\n145\t\t\t\"transcript_path\": transcriptPath,\n146\t\t}\n147\t\n148\t\treturn r.runHookWithInput(\"stop\", input)\n149\t}\n150\t\n151\t// SimulateSessionEnd simulates the Claude Code session-end hook.\n152\t// This transitions a session from IDLE (or ACTIVE) to ENDED phase.\n153\tfunc (r *HookRunner) SimulateSessionEnd(sessionID string) error {\n154\t\tr.T.Helper()\n155\t\n156\t\tinput := map[string]string{\n157\t\t\t\"session_id\":      sessionID,\n158\t\t\t\"transcript_path\": \"\",\n159\t\t}\n160\t\n161\t\treturn r.runHookWithInput(\"session-end\", input)\n162\t}\n163\t\n164\t// PreTaskInput contains the input for PreToolUse[Task] hook.\n165\ttype PreTaskInput struct {\n166\t\tSessionID      string\n167\t\tTranscriptPath string\n168\t\tToolUseID      string\n169\t\tSubagentType   string // Optional: type of subagent (e.g., \"dev\", \"reviewer\")\n170\t\tDescription    string // Optional: task description\n171\t}\n172\t\n173\t// SimulatePreTask simulates the PreToolUse[Task] hook.\n174\tfunc (r *HookRunner) SimulatePreTask(sessionID, transcriptPath, toolUseID string) error {\n175\t\tr.T.Helper()\n176\t\n177\t\treturn r.SimulatePreTaskWithInput(PreTaskInput{\n178\t\t\tSessionID:      sessionID,\n179\t\t\tTranscriptPath: transcriptPath,\n180\t\t\tToolUseID:      toolUseID,\n181\t\t})\n182\t}\n183\t\n184\t// SimulatePreTaskWithInput simulates the PreToolUse[Task] hook with full input.\n185\tfunc (r *HookRunner) SimulatePreTaskWithInput(input PreTaskInput) error {\n186\t\tr.T.Helper()\n187\t\n188\t\thookInput := map[string]interface{}{\n189\t\t\t\"session_id\":      input.SessionID,\n190\t\t\t\"transcript_path\": input.TranscriptPath,\n191\t\t\t\"tool_use_id\":     input.ToolUseID,\n192\t\t\t\"tool_input\": map[string]string{\n193\t\t\t\t\"subagent_type\": input.SubagentType,\n194\t\t\t\t\"description\":   input.Description,\n195\t\t\t},\n196\t\t}\n197\t\n198\t\treturn r.runHookWithInput(\"pre-task\", hookInput)\n199\t}\n200\t\n201\t// PostTaskInput contains the input for PostToolUse[Task] hook.\n202\ttype PostTaskInput struct {\n203\t\tSessionID      string\n204\t\tTranscriptPath string\n205\t\tToolUseID      string\n206\t\tAgentID        string\n207\t}\n208\t\n209\t// SimulatePostTask simulates the PostToolUse[Task] hook.\n210\tfunc (r *HookRunner) SimulatePostTask(input PostTaskInput) error {\n211\t\tr.T.Helper()\n212\t\n213\t\thookInput := map[string]interface{}{\n214\t\t\t\"session_id\":      input.SessionID,\n215\t\t\t\"transcript_path\": input.TranscriptPath,\n216\t\t\t\"tool_use_id\":     input.ToolUseID,\n217\t\t\t\"tool_input\":      map[string]string{},\n218\t\t\t\"tool_response\": map[string]string{\n219\t\t\t\t\"agentId\": input.AgentID,\n220\t\t\t},\n221\t\t}\n222\t\n223\t\treturn r.runHookWithInput(\"post-task\", hookInput)\n224\t}\n225\t\n226\tfunc (r *HookRunner) runHookWithInput(flag string, input interface{}) error {\n227\t\tr.T.Helper()\n228\t\n229\t\tinputJSON, err := json.Marshal(input)\n230\t\tif err != nil {\n231\t\t\treturn fmt.Errorf(\"failed to marshal hook input: %w\", err)\n232\t\t}\n233\t\n234\t\treturn r.runHookInRepoDir(flag, inputJSON)\n235\t}\n236\t\n237\tfunc (r *HookRunner) runHookInRepoDir(hookName string, inputJSON []byte) error {\n238\t\treturn r.runHookInRepoDirWithExtraEnv(hookName, inputJSON, nil)\n239\t}\n240\t\n241\t// runHookInRepoDirWithExtraEnv is like runHookInRepoDir but appends additional\n242\t// env vars to the subprocess environment. Used by review-env adoption tests that\n243\t// need ENTIRE_REVIEW_* vars present in the hook child process.\n244\tfunc (r *HookRunner) runHookInRepoDirWithExtraEnv(hookName string, inputJSON []byte, extraEnv []string) error {\n245\t\t// Run using the shared test binary\n246\t\t// Command structure: entire hooks claude-code <hook-name>\n247\t\tcmd := exec.Command(getTestBinary(), \"hooks\", \"claude-code\", hookName)\n248\t\tcmd.Dir = r.RepoDir\n249\t\tcmd.Stdin = bytes.NewReader(inputJSON)\n250\t\tcmd.Env = append(testutil.GitIsolatedEnv(),\n251\t\t\t\"ENTIRE_TEST_CLAUDE_PROJECT_DIR=\"+r.ClaudeProjectDir,\n252\t\t)\n253\t\tcmd.Env = append(cmd.Env, extraEnv...)\n254\t\n255\t\toutput, err := cmd.CombinedOutput()\n256\t\tif err != nil {\n257\t\t\treturn fmt.Errorf(\"hook %s failed: %w\\nInput: %s\\nOutput: %s\",\n258\t\t\t\thookName, err, inputJSON, output)\n259\t\t}\n260\t\n261\t\tr.T.Logf(\"Hook %s output: %s\", hookName, output)\n262\t\treturn nil\n263\t}\n264\t\n265\t// SimulateUserPromptSubmitWithReviewEnvVars simulates the UserPromptSubmit\n266\t// hook with ENTIRE_REVIEW_* env vars set on the subprocess, as `entire review`\n267\t// would set them on the spawned agent process. The hook child process inherits\n268\t// these vars, triggering env-based review adoption in the lifecycle handler.\n269\tfunc (r *HookRunner) SimulateUserPromptSubmitWithReviewEnvVars(sessionID, prompt string, extraEnv []string) error {\n270\t\tr.T.Helper()\n271\t\n272\t\tinput := map[string]string{\n273\t\t\t\"session_id\":      sessionID,\n274\t\t\t\"transcript_path\": \"\",\n275\t\t\t\"prompt\":          prompt,\n276\t\t}\n277\t\n278\t\tinputJSON, err := json.Marshal(input)\n279\t\tif err != nil {\n280\t\t\treturn fmt.Errorf(\"failed to marshal hook input: %w\", err)\n281\t\t}\n282\t\n283\t\treturn r.runHookInRepoDirWithExtraEnv(\"user-prompt-submit\", inputJSON, extraEnv)\n284\t}\n285\t\n286\t// Session represents a simulated Claude Code session.\n287\ttype Session struct {\n288\t\tID                string // Raw model session ID (e.g., \"test-session-1\")\n289\t\tTranscriptPath    string\n290\t\tTranscriptBuilder *TranscriptBuilder\n291\t\tenv               *TestEnv\n292\t}\n293\t\n294\t// FileChange represents a file modification in a session.\n295\ttype FileChange struct {\n296\t\tPath    string\n297\t\tContent string\n298\t}\n299\t\n300\t// NewSession creates a new simulated session.\n301\tfunc (env *TestEnv) NewSession() *Session {\n302\t\tenv.T.Helper()\n303\t\n304\t\tenv.SessionCounter++\n305\t\tsessionID := fmt.Sprintf(\"test-session-%d\", env.SessionCounter)\n306\t\n307\t\ttranscriptPath := filepath.Join(env.RepoDir, \".entire\", \"tmp\", sessionID+\".jsonl\")\n308\t\n309\t\treturn &Session{\n310\t\t\tID:                sessionID,\n311\t\t\tTranscriptPath:    transcriptPath,\n312\t\t\tTranscriptBuilder: NewTranscriptBuilder(),\n313\t\t\tenv:               env,\n314\t\t}\n315\t}\n316\t\n317\t// CreateTranscript builds and writes a transcript for the session.\n318\tfunc (s *Session) CreateTranscript(prompt string, changes []FileChange) string {\n319\t\ts.TranscriptBuilder.AddUserMessage(prompt)\n320\t\ts.TranscriptBuilder.AddAssistantMessage(\"I'll help you with that.\")\n321\t\n322\t\tfor _, change := range changes {\n323\t\t\ttoolID := s.TranscriptBuilder.AddToolUse(\"mcp__acp__Write\", change.Path, change.Content)\n324\t\t\ts.TranscriptBuilder.AddToolResult(toolID)\n325\t\t}\n326\t\n327\t\ts.TranscriptBuilder.AddAssistantMessage(\"Done!\")\n328\t\n329\t\tif err := s.TranscriptBuilder.WriteToFile(s.TranscriptPath); err != nil {\n330\t\t\ts.env.T.Fatalf(\"failed to write transcript: %v\", err)\n331\t\t}\n332\t\n333\t\treturn s.TranscriptPath\n334\t}\n335\t\n336\t// SimulateUserPromptSubmit is a convenience method on TestEnv.\n337\tfunc (env *TestEnv) SimulateUserPromptSubmit(sessionID string) error {\n338\t\tenv.T.Helper()\n339\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n340\t\treturn runner.SimulateUserPromptSubmit(sessionID)\n341\t}\n342\t\n343\t// SimulateUserPromptSubmitWithPrompt is a convenience method on TestEnv.\n344\tfunc (env *TestEnv) SimulateUserPromptSubmitWithPrompt(sessionID, prompt string) error {\n345\t\tenv.T.Helper()\n346\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n347\t\treturn runner.SimulateUserPromptSubmitWithPrompt(sessionID, prompt)\n348\t}\n349\t\n350\t// SimulateUserPromptSubmitWithReviewEnvVars is a convenience method on TestEnv.\n351\t// It simulates the UserPromptSubmit hook with ENTIRE_REVIEW_* env vars set on\n352\t// the subprocess, reproducing what `entire review` does before spawning the agent.\n353\tfunc (env *TestEnv) SimulateUserPromptSubmitWithReviewEnvVars(sessionID, prompt string, extraEnv []string) error {\n354\t\tenv.T.Helper()\n355\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n356\t\treturn runner.SimulateUserPromptSubmitWithReviewEnvVars(sessionID, prompt, extraEnv)\n357\t}\n358\t\n359\t// SimulateUserPromptSubmitWithTranscriptPath is a convenience method on TestEnv.\n360\t// This is needed for mid-session commit detection which reads the live transcript.\n361\tfunc (env *TestEnv) SimulateUserPromptSubmitWithTranscriptPath(sessionID, transcriptPath string) error {\n362\t\tenv.T.Helper()\n363\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n364\t\treturn runner.SimulateUserPromptSubmitWithTranscriptPath(sessionID, transcriptPath)\n365\t}\n366\t\n367\t// SimulateUserPromptSubmitWithPromptAndTranscriptPath is a convenience method on TestEnv.\n368\tfunc (env *TestEnv) SimulateUserPromptSubmitWithPromptAndTranscriptPath(sessionID, prompt, transcriptPath string) error {\n369\t\tenv.T.Helper()\n370\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n371\t\treturn runner.SimulateUserPromptSubmitWithPromptAndTranscriptPath(sessionID, prompt, transcriptPath)\n372\t}\n373\t\n374\t// SimulateUserPromptSubmitWithResponse is a convenience method on TestEnv.\n375\tfunc (env *TestEnv) SimulateUserPromptSubmitWithResponse(sessionID string) (*HookResponse, error) {\n376\t\tenv.T.Helper()\n377\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n378\t\treturn runner.SimulateUserPromptSubmitWithResponse(sessionID)\n379\t}\n380\t\n381\t// SimulateStop is a convenience method on TestEnv.\n382\tfunc (env *TestEnv) SimulateStop(sessionID, transcriptPath string) error {\n383\t\tenv.T.Helper()\n384\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n385\t\treturn runner.SimulateStop(sessionID, transcriptPath)\n386\t}\n387\t\n388\t// SimulateSessionEnd is a convenience method on TestEnv.\n389\tfunc (env *TestEnv) SimulateSessionEnd(sessionID string) error {\n390\t\tenv.T.Helper()\n391\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n392\t\treturn runner.SimulateSessionEnd(sessionID)\n393\t}\n394\t\n395\t// SimulatePreTask is a convenience method on TestEnv.\n396\tfunc (env *TestEnv) SimulatePreTask(sessionID, transcriptPath, toolUseID string) error {\n397\t\tenv.T.Helper()\n398\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n399\t\treturn runner.SimulatePreTask(sessionID, transcriptPath, toolUseID)\n400\t}\n401\t\n402\t// SimulatePostTask is a convenience method on TestEnv.\n403\tfunc (env *TestEnv) SimulatePostTask(input PostTaskInput) error {\n404\t\tenv.T.Helper()\n405\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n406\t\treturn runner.SimulatePostTask(input)\n407\t}\n408\t\n409\t// Todo represents a single todo item in the PostTodoInput.\n410\ttype Todo struct {\n411\t\tContent    string `json:\"content\"`\n412\t\tStatus     string `json:\"status\"`\n413\t\tActiveForm string `json:\"activeForm\"`\n414\t}\n415\t\n416\t// PostTodoInput contains the input for PostToolUse[TodoWrite] hook.\n417\ttype PostTodoInput struct {\n418\t\tSessionID      string\n419\t\tTranscriptPath string\n420\t\tToolUseID      string // The TodoWrite tool use ID\n421\t\tTodos          []Todo // The todo list\n422\t}\n423\t\n424\t// SimulatePostTodo simulates the PostToolUse[TodoWrite] hook.\n425\tfunc (r *HookRunner) SimulatePostTodo(input PostTodoInput) error {\n426\t\tr.T.Helper()\n427\t\n428\t\thookInput := map[string]interface{}{\n429\t\t\t\"session_id\":      input.SessionID,\n430\t\t\t\"transcript_path\": input.TranscriptPath,\n431\t\t\t\"tool_name\":       \"TodoWrite\",\n432\t\t\t\"tool_use_id\":     input.ToolUseID,\n433\t\t\t\"tool_input\": map[string]interface{}{\n434\t\t\t\t\"todos\": input.Todos,\n435\t\t\t},\n436\t\t\t\"tool_response\": map[string]interface{}{},\n437\t\t}\n438\t\n439\t\treturn r.runHookWithInput(\"post-todo\", hookInput)\n440\t}\n441\t\n442\t// SimulatePostTodo is a convenience method on TestEnv.\n443\tfunc (env *TestEnv) SimulatePostTodo(input PostTodoInput) error {\n444\t\tenv.T.Helper()\n445\t\trunner := NewHookRunner(env.RepoDir, env.ClaudeProjectDir, env.T)\n446\t\treturn runner.SimulatePostTodo(input)\n447\t}\n448\t\n449\t// ClearSessionState removes the session state file for the given session ID.\n450\t// This simulates what happens when a user commits their changes (session is \"completed\").\n451\t// Used in tests to allow sequential sessions to run without triggering concurrent session warnings.\n452\tfunc (env *TestEnv) ClearSessionState(sessionID string) error {\n453\t\tenv.T.Helper()\n454\t\n455\t\t// Session state is stored in .git/entire-sessions/<session-id>.json\n456\t\tstateFile := filepath.Join(env.RepoDir, \".git\", \"entire-sessions\", sessionID+\".json\")\n457\t\n458\t\tif err := os.Remove(stateFile); err != nil && !os.IsNotExist(err) {\n459\t\t\treturn fmt.Errorf(\"failed to clear session state: %w\", err)\n460\t\t}\n461\t\treturn nil\n462\t}\n463\t\n464\t// HookOutput contains the result of running a hook.\n465\ttype HookOutput struct {\n466\t\tStdout []byte\n467\t\tStderr []byte\n468\t\tErr    error\n469\t}\n470\t\n471\t// runAgentHookWithOutput runs a hook for the given agent and returns stdout/stderr separately.\n472\tfunc (r *HookRunner) runAgentHookWithOutput(agentName, hookName string, inputJSON []byte, extraEnv ...string) HookOutput {\n473\t\tcmd := exec.Command(getTestBinary(), \"hooks\", agentName, hookName)\n474\t\tcmd.Dir = r.RepoDir\n475\t\tcmd.Stdin = bytes.NewReader(inputJSON)\n476\t\tcmd.Env = append(testutil.GitIsolatedEnv(),\n477\t\t\t\"ENTIRE_TEST_CLAUDE_PROJECT_DIR=\"+r.ClaudeProjectDir,\n478\t\t\t\"GOCACHE=/tmp/go-build\",\n479\t\t)\n480\t\tcmd.Env = append(cmd.Env, extraEnv...)\n481\t\n482\t\tvar stdout, stderr bytes.Buffer\n483\t\tcmd.Stdout = &stdout\n484\t\tcmd.Stderr = &stderr\n485\t\n486\t\terr := cmd.Run()\n487\t\treturn HookOutput{\n488\t\t\tStdout: stdout.Bytes(),\n489\t\t\tStderr: stderr.Bytes(),\n490\t\t\tErr:    err,\n491\t\t}\n492\t}\n493\t\n494\t// runShellHookCommandWithOutput runs an installed hook shell command exactly as written\n495\t// in the hook file and returns stdout/stderr separately.\n496\tfunc (r *HookRunner) runShellHookCommandWithOutput(command string, input