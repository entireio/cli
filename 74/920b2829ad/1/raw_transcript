oolUse[Task] hook for Factory Droid.\n1025\tfunc (r *FactoryDroidHookRunner) SimulatePreTask(sessionID, transcriptPath, toolUseID string) error {\n1026\t\tr.T.Helper()\n1027\t\n1028\t\tinput := map[string]interface{}{\n1029\t\t\t\"session_id\":      sessionID,\n1030\t\t\t\"transcript_path\": transcriptPath,\n1031\t\t\t\"tool_use_id\":     toolUseID,\n1032\t\t\t\"tool_input\": map[string]string{\n1033\t\t\t\t\"subagent_type\": \"general-purpose\",\n1034\t\t\t\t\"description\":   \"test task\",\n1035\t\t\t},\n1036\t\t}\n1037\t\n1038\t\treturn r.runDroidHookWithInput(\"pre-tool-use\", input)\n1039\t}\n1040\t\n1041\t// SimulatePostTask simulates the PostToolUse[Task] hook for Factory Droid.\n1042\tfunc (r *FactoryDroidHookRunner) SimulatePostTask(input PostTaskInput) error {\n1043\t\tr.T.Helper()\n1044\t\n1045\t\thookInput := map[string]interface{}{\n1046\t\t\t\"session_id\":      input.SessionID,\n1047\t\t\t\"transcript_path\": input.TranscriptPath,\n1048\t\t\t\"tool_use_id\":     input.ToolUseID,\n1049\t\t\t\"tool_input\":      map[string]string{},\n1050\t\t\t\"tool_response\": map[string]string{\n1051\t\t\t\t\"agentId\": input.AgentID,\n1052\t\t\t},\n1053\t\t}\n1054\t\n1055\t\treturn r.runDroidHookWithInput(\"post-tool-use\", hookInput)\n1056\t}\n1057\t\n1058\t// FactoryDroidSession represents a simulated Factory AI Droid session.\n1059\ttype FactoryDroidSession struct {\n1060\t\tID             string\n1061\t\tTranscriptPath string\n1062\t\tenv            *TestEnv\n1063\t}\n1064\t\n1065\t// NewFactoryDroidSession creates a new simulated Factory Droid session.\n1066\tfunc (env *TestEnv) NewFactoryDroidSession() *FactoryDroidSession {\n1067\t\tenv.T.Helper()\n1068\t\n1069\t\tenv.SessionCounter++\n1070\t\tsessionID := fmt.Sprintf(\"droid-session-%d\", env.SessionCounter)\n1071\t\ttranscriptPath := filepath.Join(env.RepoDir, \".entire\", \"tmp\", sessionID+\".jsonl\")\n1072\t\n1073\t\treturn &FactoryDroidSession{\n1074\t\t\tID:             sessionID,\n1075\t\t\tTranscriptPath: transcriptPath,\n1076\t\t\tenv:            env,\n1077\t\t}\n1078\t}\n1079\t\n1080\t// CreateDroidTranscript creates a Droid-envelope JSONL transcript file.\n1081\t// Droid wraps messages as {\"type\":\"message\",\"id\":\"...\",\"message\":{\"role\":\"...\",\"content\":[...]}},\n1082\t// unlike Claude Code which uses {\"type\":\"assistant\",\"uuid\":\"...\",\"message\":{\"content\":[...]}}.\n1083\tfunc (s *FactoryDroidSession) CreateDroidTranscript(prompt string, changes []FileChange) string {\n1084\t\tvar lines []map[string]interface{}\n1085\t\n1086\t\t// User message with prompt\n1087\t\tlines = append(lines, map[string]interface{}{\n1088\t\t\t\"type\": \"message\",\n1089\t\t\t\"id\":   \"m1\",\n1090\t\t\t\"message\": map[string]interface{}{\n1091\t\t\t\t\"role\": \"user\",\n1092\t\t\t\t\"content\": []map[string]interface{}{\n1093\t\t\t\t\t{\"type\": \"text\", \"text\": prompt},\n1094\t\t\t\t},\n1095\t\t\t},\n1096\t\t})\n1097\t\n1098\t\t// Assistant message with tool uses\n1099\t\tassistantContent := []interface{}{\n1100\t\t\tmap[string]interface{}{\"type\": \"text\", \"text\": \"I'll help you with that.\"},\n1101\t\t}\n1102\t\tfor i, change := range changes {\n1103\t\t\tassistantContent = append(assistantContent, map[string]interface{}{\n1104\t\t\t\t\"type\":  \"tool_use\",\n1105\t\t\t\t\"id\":    fmt.Sprintf(\"toolu_%d\", i+1),\n1106\t\t\t\t\"name\":  \"Write\",\n1107\t\t\t\t\"input\": map[string]string{\"file_path\": change.Path, \"content\": change.Content},\n1108\t\t\t})\n1109\t\t}\n1110\t\tlines = append(lines, map[string]interface{}{\n1111\t\t\t\"type\": \"message\",\n1112\t\t\t\"id\":   \"m2\",\n1113\t\t\t\"message\": map[string]interface{}{\n1114\t\t\t\t\"role\":    \"assistant\",\n1115\t\t\t\t\"content\": assistantContent,\n1116\t\t\t},\n1117\t\t})\n1118\t\n1119\t\t// Tool results\n1120\t\ttoolResultContent := make([]map[string]interface{}, 0, len(changes))\n1121\t\tfor i := range changes {\n1122\t\t\ttoolResultContent = append(toolResultContent, map[string]interface{}{\n1123\t\t\t\t\"type\":        \"tool_result\",\n1124\t\t\t\t\"tool_use_id\": fmt.Sprintf(\"toolu_%d\", i+1),\n1125\t\t\t\t\"content\":     \"Success\",\n1126\t\t\t})\n1127\t\t}\n1128\t\tlines = append(lines, map[string]interface{}{\n1129\t\t\t\"type\": \"message\",\n1130\t\t\t\"id\":   \"m3\",\n1131\t\t\t\"message\": map[string]interface{}{\n1132\t\t\t\t\"role\":    \"user\",\n1133\t\t\t\t\"content\": toolResultContent,\n1134\t\t\t},\n1135\t\t})\n1136\t\n1137\t\t// Final assistant message\n1138\t\tlines = append(lines, map[string]interface{}{\n1139\t\t\t\"type\": \"message\",\n1140\t\t\t\"id\":   \"m4\",\n1141\t\t\t\"message\": map[string]interface{}{\n1142\t\t\t\t\"role\": \"assistant\",\n1143\t\t\t\t\"content\": []map[string]interface{}{\n1144\t\t\t\t\t{\"type\": \"text\", \"text\": \"Done!\"},\n1145\t\t\t\t},\n1146\t\t\t},\n1147\t\t})\n1148\t\n1149\t\t// Ensure directory exists\n1150\t\tif err := os.MkdirAll(filepath.Dir(s.TranscriptPath), 0o755); err != nil {\n1151\t\t\ts.env.T.Fatalf(\"failed to create transcript dir: %v\", err)\n1152\t\t}\n1153\t\n1154\t\t// Write as JSONL\n1155\t\tfile, err := os.Create(s.TranscriptPath)\n1156\t\tif err != nil {\n1157\t\t\ts.env.T.Fatalf(\"failed to create transcript file: %v\", err)\n1158\t\t}\n1159\t\tdefer func() { _ = file.Close() }()\n1160\t\n1161\t\tencoder := json.NewEncoder(file)\n1162\t\tfor _, line := range lines {\n1163\t\t\tif err := encoder.Encode(line); err != nil {\n1164\t\t\t\ts.env.T.Fatalf(\"failed to encode transcript line: %v\", err)\n1165\t\t\t}\n1166\t\t}\n1167\t\n1168\t\treturn s.TranscriptPath\n1169\t}\n1170\t\n1171\t// SimulateFactoryDroidUserPromptSubmit is a convenience method on TestEnv.\n1172\tfunc (env *TestEnv) SimulateFactoryDroidUserPromptSubmit(sessionID string) error {\n1173\t\tenv.T.Helper()\n1174\t\trunner := NewFactoryDroidHookRunner(env.RepoDir, env.T)\n1175\t\treturn runner.SimulateUserPromptSubmit(sessionID)\n1176\t}\n1177\t\n1178\t// SimulateFactoryDroidUserProm