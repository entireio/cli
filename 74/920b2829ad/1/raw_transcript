rned as-is so\n199\t//     real problems aren't masked by a scan).\n200\t//   - Only triggers when the reported path is under the Claude projects base\n201\t//     dir; for any other path the scan can't produce a better answer.\n202\t//   - The session ID is validated with validation.ValidateAgentSessionID before\n203\t//     being used in filepath.Join, blocking traversal via hostile hook input.\n204\tfunc (c *ClaudeCodeAgent) resolveTranscriptPath(sessionRef, sessionID string) string {\n205\t\tif sessionRef == \"\" || sessionID == \"\" {\n206\t\t\treturn sessionRef\n207\t\t}\n208\t\tif _, err := os.Stat(sessionRef); err == nil {\n209\t\t\treturn sessionRef\n210\t\t} else if !os.IsNotExist(err) {\n211\t\t\treturn sessionRef\n212\t\t}\n213\t\tif err := validation.ValidateAgentSessionID(sessionID); err != nil {\n214\t\t\treturn sessionRef\n215\t\t}\n216\t\tbase, err := c.GetSessionBaseDir()\n217\t\tif err != nil {\n218\t\t\treturn sessionRef\n219\t\t}\n220\t\tcleanedRef := filepath.Clean(sessionRef)\n221\t\tcleanedBase := filepath.Clean(base)\n222\t\tif !strings.HasPrefix(cleanedRef, cleanedBase+string(os.PathSeparator)) {\n223\t\t\treturn sessionRef\n224\t\t}\n225\t\tfound := findTranscriptByID(cleanedBase, sessionID)\n226\t\tif found == \"\" {\n227\t\t\treturn sessionRef\n228\t\t}\n229\t\tlogging.Info(logging.WithComponent(context.Background(), \"agent.claudecode\"),\n230\t\t\t\"resolved transcript via fallback scan\",\n231\t\t\tslog.String(\"reported\", sessionRef),\n232\t\t\tslog.String(\"found\", found),\n233\t\t\tslog.String(\"session_id\", sessionID),\n234\t\t)\n235\t\treturn found\n236\t}\n237\t\n238\t// findTranscriptByID scans baseDir's immediate child directories for a file\n239\t// named \"<sessionID>.jsonl\" and returns the first match, or \"\" if none.\n240\t// Callers must validate sessionID with validation.ValidateAgentSessionID first\n241\t// — this function trusts the input and uses it verbatim in filepath.Join.\n242\tfunc findTranscriptByID(baseDir